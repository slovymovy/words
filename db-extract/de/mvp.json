                                                "sense_id": "5f52ba6b-a20c-3b63-a1d7-afba27b1bfdc",
                                                "text": "Darryl, you've outdone Willie Mays. You got my vote for MVP."
                                            },
                                            {
                                                "example_id": "28d535fd-ab51-489b-a712-29feda889717",
                                                "sense_id": "5f52ba6b-a20c-3b63-a1d7-afba27b1bfdc",
                                                "text": "Members of a basketball team happily reward the MVP with additional status is she sinks a winning shot at the buzzer."
                                            },
                                            {
                                                "example_id": "b138ec4f-14f7-4950-b46c-9c0d28d57733",
                                                "sense_id": "5f52ba6b-a20c-3b63-a1d7-afba27b1bfdc",
                                                "text": "Jokić is going for a historic three-peat of MVPs and you would be hard pressed to bet against the Serbian winning the trophy for a third successive year."
                                            },
                                            {
                                                "example_id": "52dd64ee-d183-43b4-8756-babb7421d07c",
                                                "sense_id": "5f52ba6b-a20c-3b63-a1d7-afba27b1bfdc",
                                                "text": "Curry has been named NBA regular season MVP twice and is an 11-time All Star."
                                            }
