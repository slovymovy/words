                        ],
                        "examples": [
                            {
                                "example_id": "910d2a41-5278-4c64-b615-f4dd8ada8129",
                                "sense_id": "063bc8f8-68ab-3620-bd7d-c5294bc6489b",
                                "text": "Trois commentaires dithyrambiques sur le pilote d'une émission, les internautes se méfient et flairent la manipulation, trente critiques délirantes d'hostilité et personne ne se pose de question."
                            }
