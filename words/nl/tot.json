{
    "word_family": [
        "totdat",
        "toe"
    ],
    "entries": [
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "2196c833-ef91-3a53-b67e-8934fb930989",
                    "sense_definition": "Geeft een eindpunt in tijd, ruimte of hoeveelheid aan.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "limit_endpoint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De winkel is open van negen <tot> vijf uur.",
                            "target_lang_translations": {
                                "en": "The shop is open from nine <w>to</w> five o'clock.",
                                "ru": "Магазин открыт с девяти <до> пяти часов.",
                                "es": "La tienda está abierta de nueve <w>a</w> cinco."
                            }
                        },
                        {
                            "text": "We liepen <tot> het einde van de straat.",
                            "target_lang_translations": {
                                "en": "We walked <w>to</w> the end of the street.",
                                "ru": "Мы шли <до> конца улицы.",
                                "es": "Caminamos <w>hasta</w> el final de la calle."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tot ziens",
                        "tot morgen",
                        "tot nu toe",
                        "van ... tot ...",
                        "tot en met"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates an endpoint in time, space, or quantity.",
                        "ru": "Указывает на конечную точку во времени, пространстве или количестве.",
                        "es": "Indica un punto final en el tiempo, el espacio o la cantidad."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "until",
                                "target_lang_sense_clarification": "indicating a time limit"
                            },
                            {
                                "target_lang_word": "to",
                                "target_lang_sense_clarification": "indicating a spatial endpoint or range"
                            },
                            {
                                "target_lang_word": "up to",
                                "target_lang_sense_clarification": "indicating a maximum quantity or degree"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "до",
                                "target_lang_sense_clarification": "указывает на предел"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "hasta",
                                "target_lang_sense_clarification": "indicando un límite de tiempo o espacio"
                            },
                            {
                                "target_lang_word": "a",
                                "target_lang_sense_clarification": "en rangos de tiempo o espacio, como 'de ... a ...'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a912d869-4da3-39c1-8480-92266ab04e05",
                    "sense_definition": "Geeft aan waartoe iets leidt, wat het resultaat is of waarin iets verandert.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "result_change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij werd veroordeeld <tot> een gevangenisstraf.",
                            "target_lang_translations": {
                                "en": "He was sentenced <w>to</w> a prison term.",
                                "ru": "Его приговорили <к> тюремному заключению."
                            }
                        },
                        {
                            "text": "Dit misverstand leidde <tot> een grote ruzie.",
                            "target_lang_translations": {
                                "en": "This misunderstanding led <w>to</w> a big fight.",
                                "ru": "Это недоразумение привело <к> крупной ссоре."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tot stand komen",
                        "in staat zijn tot",
                        "behoren tot",
                        "tot tranen toe"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates which function or capacity someone or something acquires.",
                        "ru": "Указывает на результат действия, изменение состояния или приобретение новой функции.",
                        "es": "Indica a qué conduce algo, cuál es el resultado o en qué se transforma algo."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "as",
                                "target_lang_sense_clarification": "indicating a role, capacity, or function"
                            },
                            {
                                "target_lang_word": "to",
                                "target_lang_sense_clarification": "used with specific verbs like 'appointed to'"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "к",
                                "target_lang_sense_clarification": "приводит к результату"
                            },
                            {
                                "target_lang_word": "в",
                                "target_lang_sense_clarification": "превращение или переход в состояние"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "a",
                                "target_lang_sense_clarification": "con verbos de dirección o resultado como 'conducir a'"
                            },
                            {
                                "target_lang_word": "como",
                                "target_lang_sense_clarification": "indicando una función o rol"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a912d869-4da3-39c1-8480-92266ab04e05",
                    "sense_definition": "Geeft aan welke functie of hoedanigheid iemand of iets krijgt.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "function_role",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij werd vorig jaar benoemd <tot> directeur.",
                            "target_lang_translations": {
                                "en": "She was appointed <w>as</w> director last year.",
                                "ru": "В прошлом году её назначили <директором>.",
                                "es": "Ella fue nombrada directora el año pasado."
                            }
                        },
                        {
                            "text": "Dit verhaal dient <tot> voorbeeld voor anderen.",
                            "target_lang_translations": {
                                "en": "This story serves <w>as</w> an example for others.",
                                "ru": "Эта история служит <примером> для других.",
                                "es": "Esta historia sirve <w>como</w> ejemplo para otros."
                            }
                        }
                    ],
                    "common_phrases": [
                        "benoemen tot",
                        "verkiezen tot",
                        "dienen tot"
                    ],
                    "target_lang_definitions": {
                        "en": "Indicates which function or capacity someone or something acquires.",
                        "ru": "Указывает на результат действия, изменение состояния или приобретение новой функции.",
                        "es": "Indica a qué conduce algo, cuál es el resultado o en qué se transforma algo."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "as",
                                "target_lang_sense_clarification": "indicating a role, capacity, or function"
                            },
                            {
                                "target_lang_word": "to",
                                "target_lang_sense_clarification": "used with specific verbs like 'appointed to'"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "к",
                                "target_lang_sense_clarification": "приводит к результату"
                            },
                            {
                                "target_lang_word": "в",
                                "target_lang_sense_clarification": "превращение или переход в состояние"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "a",
                                "target_lang_sense_clarification": "con verbos de dirección o resultado como 'conducir a'"
                            },
                            {
                                "target_lang_word": "como",
                                "target_lang_sense_clarification": "indicando una función o rol"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3786e754-6d28-3b5d-a552-530d4e826858",
                    "sense_definition": "Gebruikt bij het opnemen van de telefoon om de eigen naam te noemen.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "telephone_intro",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hallo, u spreekt <tot> Jan.",
                            "target_lang_translations": {
                                "en": "Hello, you are speaking <w>to</w> Jan.",
                                "ru": "Алло, вы говорите <с> Яном.",
                                "es": "Hola, habla <w>con</w> Jan."
                            }
                        },
                        {
                            "text": "Goedemiddag, <tot> mevrouw De Vries.",
                            "target_lang_translations": {
                                "en": "Good afternoon, <w>this is</w> Mrs. De Vries.",
                                "ru": "Добрый день, <это> госпожа Де Врис.",
                                "es": "Buenas tardes, <w>habla</w> la señora De Vries."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Suriname"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Used when picking up the phone to state one's own name.",
                        "ru": "Используется при ответе на телефонный звонок, чтобы назвать свое имя (региональное: Суринам).",
                        "es": "Se utiliza al contestar el teléfono para indicar el propio nombre (regional de Surinam)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to",
                                "target_lang_sense_clarification": "literal translation used in regional contexts"
                            },
                            {
                                "target_lang_word": "this is",
                                "target_lang_sense_clarification": "functional equivalent for introductions"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "с",
                                "target_lang_sense_clarification": "в значении 'вы говорите с'"
                            },
                            {
                                "target_lang_word": "это",
                                "target_lang_sense_clarification": "представление себя"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "con",
                                "target_lang_sense_clarification": "en la expresión 'habla con'"
                            },
                            {
                                "target_lang_word": "soy",
                                "target_lang_sense_clarification": "para identificarse al teléfono"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "7f1536df-7486-39ff-9025-d95e1cf148c6",
                    "sense_definition": "Tot op het moment dat; geeft de tijdsgrens aan van de handeling in de hoofdzin.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "limit_endpoint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Blijf hier wachten <tot> ik terugkom.",
                            "target_lang_translations": {
                                "en": "Wait here <w>until</w> I come back.",
                                "ru": "Жди здесь, <пока> я не вернусь.",
                                "es": "Espera aquí <w>hasta que</w> vuelva."
                            }
                        },
                        {
                            "text": "We blijven binnen <tot> de regen stopt.",
                            "target_lang_translations": {
                                "en": "We are staying inside <w>until</w> the rain stops.",
                                "ru": "Мы останемся дома, <пока> дождь не прекратится.",
                                "es": "Nos quedamos adentro <w>hasta que</w> pare de llover."
                            }
                        }
                    ],
                    "synonyms": [
                        "totdat"
                    ],
                    "common_phrases": [
                        "wacht tot"
                    ],
                    "target_lang_definitions": {
                        "en": "Up to the moment that; indicates the time limit of the action in the main clause.",
                        "ru": "До того момента, как; обозначает временной предел действия.",
                        "es": "Hasta el momento en que; indica el límite de tiempo de la acción en la oración principal."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "until",
                                "target_lang_sense_clarification": "standard conjunction"
                            },
                            {
                                "target_lang_word": "till",
                                "target_lang_sense_clarification": "informal conjunction"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "пока",
                                "target_lang_sense_clarification": "союз времени"
                            },
                            {
                                "target_lang_word": "пока не",
                                "target_lang_sense_clarification": "до наступления события"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "hasta que",
                                "target_lang_sense_clarification": "conjunción temporal"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}