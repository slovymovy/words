                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6eff05a9-b5ea-4403-af02-4700504b2760",
                                "sense_id": "bf77c247-b193-3e4e-99a8-45892cb54af9",
                                "text": "„Mehrere Fotos hat ein erzürnter Bürger von den Baumresten der Pappelallee gemacht, der nicht verstehen kann, wieso die Bäume gefällt wurden.“"
                            },
                            {
                                "example_id": "7edb08a5-dbf8-4af2-81ac-568b51ef5184",
                                "sense_id": "bf77c247-b193-3e4e-99a8-45892cb54af9",
                                "text": "„Wie die Polizei am Freitag mitteilte, fuhr die Frau gegen 19 Uhr von der Pappelallee zur Röhrichtstraße, als der Unbekannte sie vom Rad stieß und in ein angrenzendes Maisfeld zog.“"
                            }
                        ],
