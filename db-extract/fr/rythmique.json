        "fr-extract.jsonl": [
            {
                "entry_id": "d6849cdc-8887-3356-9792-f6977397a820",
                "word": "rythmique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "eb870738-eb4e-410f-a8d5-3a1eaaa595cc",
                        "entry_id": "d6849cdc-8887-3356-9792-f6977397a820",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "rythmiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7b39fca6-d04e-3a0f-8183-3756d810901a",
                        "entry_id": "d6849cdc-8887-3356-9792-f6977397a820",
                        "glosses": [
                            "Relatif au rythme ; qui observe le rythme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fb3bab1-d80e-4e7b-b47c-dd4fb01c036b",
                                "sense_id": "7b39fca6-d04e-3a0f-8183-3756d810901a",
                                "text": "Depuis deux heures Rabalan travaillait avec acharnement. Son casse-pierres se levait et s’abaissait en un mouvement rythmique, sur les cailloux."
                            },
                            {
                                "example_id": "9a5bbba7-db5c-4ef3-9eb3-fa43cfc14757",
                                "sense_id": "7b39fca6-d04e-3a0f-8183-3756d810901a",
                                "text": "S’accompagnant de son gimbri, il nous chante, d’une voix tantôt gutturale, tantôt nasillarde, d’interminables mélopées, que l’assistance reprend aux refrains avec des battements rythmiques des mains."
                            },
                            {
                                "example_id": "10979c92-d289-43ed-8c02-1c2f510bf46c",
                                "sense_id": "7b39fca6-d04e-3a0f-8183-3756d810901a",
                                "text": "Des clappements, des crissements et d’étranges grincements rythmiques s’éveillaient, aussitôt que l’intrépide pédaleur avait fait quelques tours de roue."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d4f5012a-82de-409d-8d86-d374248af222",
                        "source_entry_id": "d6849cdc-8887-3356-9792-f6977397a820",
                        "source_sense_id": "7b39fca6-d04e-3a0f-8183-3756d810901a",
                        "target_lang_word": "rhythmisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rhythmisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6e0d2862-f4ab-323a-a484-c1dba9506b04",
                                        "entry_id": "121c45b7-417e-3722-a0bc-7166a1a18237",
                                        "glosses": [
                                            "gleichmäßig, regelmäßig beziehungsweise sich gleichmäßig, regelmäßig wiederholend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4330d224-f2db-4639-9267-e32024edad4d",
                                                "sense_id": "6e0d2862-f4ab-323a-a484-c1dba9506b04",
                                                "text": "Rhythmische Ereignisse sind etwa Sonnenaufgang und Sonnenuntergang, Wechsel von Tag und Nacht, Puls- und Herzschlag, alle regelmäßigen Zeiteinteilungen (Abfolge von Sekunden, Minuten, Stunden, Tagen) sowie der Beat, ein sich gleichmäßig wiederholender Grundpuls eines Musikstückes."
                                            },
                                            {
                                                "example_id": "b075569e-f143-4dd6-b3b3-27f2bfac97dd",
                                                "sense_id": "6e0d2862-f4ab-323a-a484-c1dba9506b04",
                                                "text": "„Diese rhythmischen Muster können auf verschiedene Weisen weiter zusammengefasst und kodiert werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "18ccd5bc-05e1-3d70-bdd2-76187f10d0f7",
                                        "entry_id": "121c45b7-417e-3722-a0bc-7166a1a18237",
                                        "glosses": [
                                            "für den Rhythmus besonders geeignet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18ea6c8a-e491-4e96-980e-419bea51766d",
                                                "sense_id": "18ccd5bc-05e1-3d70-bdd2-76187f10d0f7",
                                                "text": "Das Tamburin hat sich in der Physiotherapie als rhythmisches Begleitinstrument sehr bewährt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
