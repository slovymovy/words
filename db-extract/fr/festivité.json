        "fr-extract.jsonl": [
            {
                "entry_id": "1345fbcd-ab69-3b43-87ea-9a1a2d3cf99e",
                "word": "festivité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ddc525d3-2df2-4972-a04b-9f9d592ef49c",
                        "entry_id": "1345fbcd-ab69-3b43-87ea-9a1a2d3cf99e",
                        "tags": [
                            "plural"
                        ],
                        "form": "festivités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "691c6585-deb5-3ba4-bf2a-a724e21fb3da",
                        "entry_id": "1345fbcd-ab69-3b43-87ea-9a1a2d3cf99e",
                        "glosses": [
                            "Réjouissance qui se tient pour célébrer une fête."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d01ebea7-38e7-449e-a076-36c6973bb868",
                                "sense_id": "691c6585-deb5-3ba4-bf2a-a724e21fb3da",
                                "text": "Souvent les familles éprouvent le besoin de marquer néanmoins par des festivités l'existence de leur rejeton, et alors elles organisent ce que l'on appelle ici un baptême civil."
                            },
                            {
                                "example_id": "58b4ff4f-0806-48fa-95e3-ee6a6d900115",
                                "sense_id": "691c6585-deb5-3ba4-bf2a-a724e21fb3da",
                                "text": "On festoyait joyeusement en mangeant beaucoup et en buvant encore plus, comme si l'on n'allait plus manger de tout l'hiver. Ces festivités étaient nommées « Martinales », et tournaient aux Bacchanales, si bien que les évêques s'en offusquèrent vite."
                            },
                            {
                                "example_id": "afae34a6-4c30-4825-b295-b67a78e86a5e",
                                "sense_id": "691c6585-deb5-3ba4-bf2a-a724e21fb3da",
                                "text": "Pas la moindre festivité non plus, le 14 Juillet, à VIRIAT (Ain). Mais il ne faut pas y voir la moindre malveillance à l'égard de la République. On a l'habitude, ici, de célébrer le 14 Juillet... le 1ᵉʳ dimanche d'août !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d3d6280c-40a6-470b-a6e1-91939c2fc012",
                        "source_entry_id": "1345fbcd-ab69-3b43-87ea-9a1a2d3cf99e",
                        "source_sense_id": "691c6585-deb5-3ba4-bf2a-a724e21fb3da",
                        "target_lang_word": "торжество",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "торжество",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "832b8bba-2aaa-37b7-b14a-71dfc93a6e58",
                                        "entry_id": "3f9c5692-e255-36a6-a325-1ca8f7f2a17a",
                                        "glosses": [
                                            "большой праздник"
                                        ],
                                        "tags": [
                                            "часто во мн. ч."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33753f51-620c-446a-8879-d65700e364e3",
                                                "sense_id": "832b8bba-2aaa-37b7-b14a-71dfc93a6e58",
                                                "text": "Сегодня место торжества ― нижний ресторан «Интуриста» ― дорогое, но рядовое, без выдумки."
                                            },
                                            {
                                                "example_id": "3968ecca-b8cd-473a-b5e2-b905ddc8af5c",
                                                "sense_id": "832b8bba-2aaa-37b7-b14a-71dfc93a6e58",
                                                "text": "По случаю торжества всех сотрудников поздравили."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e8fcb65-937b-3153-801e-87361884c04c",
                                        "entry_id": "3f9c5692-e255-36a6-a325-1ca8f7f2a17a",
                                        "glosses": [
                                            "радостное чувство собственной силы, ощущение победы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79e6ba08-b74c-4cbb-ab14-20dd5ed80c6d",
                                                "sense_id": "5e8fcb65-937b-3153-801e-87361884c04c",
                                                "text": "Она едва могла принудить себя не улыбнуться и скрыть своё торжество; ей удалось, однако, довольно скоро принять совершенно равнодушный и даже строгий вид: она небрежно опустила руку на моё плечо, наклонила слегка головку набок, и мы пустились."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05bf494f-a44a-3e4b-aa34-9666e49d3e54",
                                        "entry_id": "3f9c5692-e255-36a6-a325-1ca8f7f2a17a",
                                        "glosses": [
                                            "перен. победа, превосходство"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3312514-e68c-4492-852a-913ca262214a",
                                                "sense_id": "05bf494f-a44a-3e4b-aa34-9666e49d3e54",
                                                "text": "Если этот спор ознаменовал окончательный упадок идей естественного права, то в то же время он привёл к торжеству новой школы права ― исторической."
                                            },
                                            {
                                                "example_id": "ef365011-ac66-4a83-b9f6-c1265171e914",
                                                "sense_id": "05bf494f-a44a-3e4b-aa34-9666e49d3e54",
                                                "text": "Торжество над врагами."
                                            },
                                            {
                                                "example_id": "f2c304d3-ef8c-47c3-a166-60b6962a50aa",
                                                "sense_id": "05bf494f-a44a-3e4b-aa34-9666e49d3e54",
                                                "text": "Торжество добра над злом."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
