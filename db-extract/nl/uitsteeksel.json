                                                "sense_id": "73fe861e-71b6-3d9e-849d-0ea2bfcbf2ab",
                                                "text": "The face of the cliff had many projections that were big enough for birds to nest on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c687d400-3dea-39c1-9eaf-28fb808730a6",
