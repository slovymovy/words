                    {
                        "sense_id": "cd97203d-dd48-3fce-934e-c4ba5f663f63",
                        "entry_id": "ee475d41-0f15-3d51-b947-f06409db9bf9",
                        "glosses": [
                            "The back piece of a chair, used to support the sitter's back."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dd394a1-ef29-4d65-bbf3-cec2992d14bf",
                                "sense_id": "cd97203d-dd48-3fce-934e-c4ba5f663f63",
                                "text": "I can identify the pattern of wood grain on my chair at Mom and Dad's kitchen table, but I don't try to sketch it in my mind. For me, chairness is nonvisual; it's the feel of a seat connected to four legs and a backrest."
                            }
                        ]
                    },
                    {
                        "sense_id": "e03835f0-1685-304c-8a49-d2b6c3fce9c7",
                        "entry_id": "ee475d41-0f15-3d51-b947-f06409db9bf9",
                        "glosses": [
                            "A guide attached to the slide rest of a lathe, and placed in contact with the work to steady it in turning."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
