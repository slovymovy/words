                            {
                                "example_id": "f4112c4e-5de1-47b4-9c6a-6dc6f8ea8fb5",
                                "sense_id": "aeb7388b-d587-3300-9979-49d122466e0d",
                                "text": "„Er wollte der jüngste Flugzeugpilot werden, der die Welt umrundet - und zahlte mit seinem Leben: Der 17-jährige Haris Suleman ist bei seinem Rekordversuch mit seinem Vater an Bord vor Amerikanisch-Samoa ins Meer gestürzt.“"
                            },
                            {
                                "example_id": "62084dc6-bfb3-4507-94be-08bbba58d303",
                                "sense_id": "aeb7388b-d587-3300-9979-49d122466e0d",
                                "text": "„In Witten wurde am Samstagabend ein Flugzeugpilot mit einem Laserstrahl geblendet.“"
                            }
                        ],
