                        "sense_id": "86c2bbe2-a7ca-3b32-add5-d7c9928d7c6d",
                        "entry_id": "c9088b14-6249-33ca-a09e-d2ac4a689dde",
                        "glosses": [
                            "communal cash box at a shop or office, used to buy coffee and other refreshments for the staff"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "0aba0751-1a72-470e-b773-1c90cbd5863a",
                                "sense_id": "86c2bbe2-a7ca-3b32-add5-d7c9928d7c6d",
                                "text": "Hier, der Chef hat mir 20 Euro für unsere Kaffeekasse gegeben.",
                                "translation": "Here, the boss gave me 20 Euros for our coffee fund.",
                                "english": "Here, the boss gave me 20 Euros for our coffee fund."
                            }
                        ]
                    },
                    {
                        "sense_id": "0a59325a-ae06-340b-871c-dbb0168f5fae",
                        "entry_id": "c9088b14-6249-33ca-a09e-d2ac4a689dde",
                        "glosses": [
                            "any extra money given by clients out of thankfulness etc. (in contexts where tips are not usual)"
                        ],
                        "tags": [
                            "broadly",
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "51608f88-874e-4d2d-996e-9a7a1f9cfea9",
                                "sense_id": "0a59325a-ae06-340b-871c-dbb0168f5fae",
                                "text": "„Das waren nur zwei Handgriffe: ist umsonst.“ – „Ach, vielen Dank! Aber dann nehmen Sie doch wenigstens zwei Euro für die Kaffeekasse!“",
                                "translation": "\"That only took two steps; no charge.\" \"Ahh, thank you very much! Then at least take two Euros for the coffee fund!\"",
                                "english": "\"That only took two steps; no charge.\" \"Ahh, thank you very much! Then at least take two Euros for the coffee fund!\""
                            }
                        ]
                    },
                    {
                        "sense_id": "a4b898f1-241b-36f6-b22f-e22abeac46c8",
                        "entry_id": "c9088b14-6249-33ca-a09e-d2ac4a689dde",
                        "glosses": [
                            "change, peanuts, petty cash; any relatively small amount of money"
                        ],
                        "tags": [
                            "feminine",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "79c68e48-6cda-4100-a3fa-ef913e69b125",
                                "sense_id": "a4b898f1-241b-36f6-b22f-e22abeac46c8",
                                "text": "Das zahlen die aus der Kaffeekasse!",
                                "translation": "They'll pay that out of petty cash!",
                                "english": "They'll pay that out of petty cash!"
                            }
                        ]
                    }
