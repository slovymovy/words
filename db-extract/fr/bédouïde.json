                        ],
                        "examples": [
                            {
                                "example_id": "e8b30c20-babb-4e02-b1c8-3630f7fb728b",
                                "sense_id": "858fcf75-0c6b-3520-a63a-32a76f96960e",
                                "text": "L’oiseau était plus gros qu’une grive, il avait un joli plumet sur la tête.\n…\n Il dégagea l'oiseau, et dit :\n« C'est une bédouïde »."
                            },
                            {
                                "example_id": "c5225164-c963-4175-8a41-ed333facb66c",
                                "sense_id": "858fcf75-0c6b-3520-a63a-32a76f96960e",
                                "text": "Mon nouvel ami ramassa plusieurs culs-blancs, que les Français appellent « motteux », encore deux bédouïdes (il m’expliqua que c’était un « genre d’alouette ») et trois « darnagas »."
                            }
                        ]
                    }
