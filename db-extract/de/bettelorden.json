                        "entry_id": "01a9e0b3-14f5-36f1-aa42-95dc172954d5",
                        "glosses": [
                            "klösterliche Gemeinschaft, die sich von persönlichem Eigentum löst und von Almosen lebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c56f102-0815-4ed6-917e-d39295ab4539",
                                "sense_id": "ad3d2be7-0453-3876-80fe-0a579546ec81",
                                "text": "Die Dominikaner und Franziskaner sind die bekanntesten Bettelorden."
                            },
                            {
                                "example_id": "88c11a75-5886-4769-9cf3-5f77696fdfb1",
                                "sense_id": "ad3d2be7-0453-3876-80fe-0a579546ec81",
                                "text": "„Mit dem öffentlichen Auftreten von Mönchen aus den Bettelorden der Dominikaner und Franziskaner entwickelte sich auch die deutsche Predigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
