                "senses": [
                    {
                        "sense_id": "7d5f7d5c-34d6-3ab9-b2be-dedd74e99c54",
                        "entry_id": "10bd23bd-b158-3050-b286-d3fdd46e58de",
                        "glosses": [
                            "Boot, das für den Fang von Fischen und Meeresfrüchten genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28a33428-647a-4545-adcd-4ef4f13e7342",
                                "sense_id": "7d5f7d5c-34d6-3ab9-b2be-dedd74e99c54",
                                "text": "Die Fischerboote liefen heute sehr früh aus."
                            },
                            {
                                "example_id": "ccd73569-2c96-466a-b45f-c7af7d6342d8",
                                "sense_id": "7d5f7d5c-34d6-3ab9-b2be-dedd74e99c54",
                                "text": "„Vor dem Haus lagen Fischerboote im Hafen.“"
                            },
                            {
                                "example_id": "7200d1ab-2736-40e5-9763-bf8d7800276e",
                                "sense_id": "7d5f7d5c-34d6-3ab9-b2be-dedd74e99c54",
                                "text": "„In der Nacht zuvor waren wir mit Freunden in seinem alten, kleinen Fischerboot aus Holz um Mitternacht zum Polarkreis getuckert.“"
                            },
                            {
                                "example_id": "0dbf402d-720b-4e6a-b863-5c4d0ebe192b",
                                "sense_id": "7d5f7d5c-34d6-3ab9-b2be-dedd74e99c54",
                                "text": "„Kurz vor Einbruch der Neuen Morgendämmerung erreichten uns die Fischerboote der Haganah.“"
                            },
                            {
                                "example_id": "6d1340ad-f3e8-4f14-9922-315c08633bde",
                                "sense_id": "7d5f7d5c-34d6-3ab9-b2be-dedd74e99c54",
                                "text": "„Fischerboote verließen die kleine Mole, um zum nächtlichen Fang auszufahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
