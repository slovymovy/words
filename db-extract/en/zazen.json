                                "target_senses": [
                                    {
                                        "sense_id": "c2afaf37-2b62-36e2-b480-c2785ad71f05",
                                        "entry_id": "fedb0f64-fa00-3478-9c8d-05ff883df45b",
                                        "glosses": [
                                            "Forme de méditation assise et silencieuse, à la base de la pratique du bouddhisme zen. Dans le zen soto, elle consiste à laisser passer les pensées sans les entretenir, s’affranchissant ainsi des fabrications mentales pour n’être plus que simple présence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7482bd45-dfa0-441b-b426-9a69793c1919",
                                                "sense_id": "c2afaf37-2b62-36e2-b480-c2785ad71f05",
                                                "text": "Le zazen dont il est question ici se situe au sein de la transmission de l’enseignement du Bouddha dont il constitue la pratique essentielle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad59603e-2999-34d8-b0a0-e7463acdd1af",
                                        "entry_id": "fedb0f64-fa00-3478-9c8d-05ff883df45b",
                                        "glosses": [
                                            "Par extension, posture assise utilisée pour pratiquer ce type de méditation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6019f39-4186-43e7-b1bb-f52f9abebd4e",
                                                "sense_id": "ad59603e-2999-34d8-b0a0-e7463acdd1af",
                                                "text": "La posture de zazen est semblable à un instrument de musique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
