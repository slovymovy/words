                "senses": [
                    {
                        "sense_id": "639ec28d-a10d-3728-8896-feece68c72c8",
                        "entry_id": "abafa72c-345e-3a54-874f-7d4e68e7f793",
                        "glosses": [
                            "vrouw die zich op straat aanbiedt voor betaalde seks"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b15774e-394e-4a4c-b553-44a4038643fa",
                                "sense_id": "639ec28d-a10d-3728-8896-feece68c72c8",
                                "text": "Na de musical Nine, gebaseerd op zijn 8 1/2, wordt nu gewerkt aan een remake van Nights of Cabiria, die in 1958 een Oscar won. Met Juliette Lewis als tragische straatmadelief. In 1969 was er al een remake met Shirley MacLaine."
                            },
                            {
                                "example_id": "3ddbd3a9-c4c9-4769-b2cd-89dc0cfacc63",
                                "sense_id": "639ec28d-a10d-3728-8896-feece68c72c8",
                                "text": "Met de meeste hoeren uit de musicalgeschiedenis gaat het mis. Neem bijvoorbeeld Nancy uit Oliver!, de naar romantiek smachtende straatmadelief in het smerige Londen van de negentiende eeuw. In haar hymne, As long as he needs me, bezingt ze haar hunkering naar een man die zich in feite misdraagt, maar haar toch echt nodig heeft."
                            }
                        ]
                    }
