                                "target_senses": [
                                    {
                                        "sense_id": "5e2db72b-7230-32a9-af09-ceedad9f7e37",
                                        "entry_id": "58540f31-3f03-3573-b82a-4c8bafc0244f",
                                        "glosses": [
                                            "Umgangsform, eine Bezeichnung oder Benennung, mit der man Personen anspricht"
                                        ],
                                        "tags": [
                                            "Grußhandlung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3eeb583-f5c7-401f-a51e-7f52f4cf9b2e",
                                                "sense_id": "5e2db72b-7230-32a9-af09-ceedad9f7e37",
                                                "text": "Wenn jemand mehrere akademische Titel hat, so wird in der Anrede nur der höchste genannt."
                                            },
                                            {
                                                "example_id": "98edbbb7-ac25-41d6-a4de-7e9f164bb7e9",
                                                "sense_id": "5e2db72b-7230-32a9-af09-ceedad9f7e37",
                                                "text": "Die Anrede in Geschäftsbriefen richtet sich in Deutschland nach DIN 5008."
                                            },
                                            {
                                                "example_id": "ac9b1b78-b65c-4e8a-b339-6cfb3e9387b0",
                                                "sense_id": "5e2db72b-7230-32a9-af09-ceedad9f7e37",
                                                "text": "Sekretärinnen sollten unangenehme Fehler bei der Anrede vermeiden."
                                            },
                                            {
                                                "example_id": "9a510324-931f-4e75-8298-f66a27b45a58",
                                                "sense_id": "5e2db72b-7230-32a9-af09-ceedad9f7e37",
                                                "text": "„…; die Anrede Fräulein ist, wie erwähnt, sehr problematisch geworden und außer Gebrauch gekommen.“"
                                            },
                                            {
                                                "example_id": "3055744a-85db-43bc-a246-3fd9117a9d52",
                                                "sense_id": "5e2db72b-7230-32a9-af09-ceedad9f7e37",
                                                "text": "„Anrede und Grußformel werden vom übrigen Text durch jeweils eine Leerzeile abgesetzt.“"
                                            },
                                            {
                                                "example_id": "ab31575e-cd54-438a-b9aa-3280666c843a",
                                                "sense_id": "5e2db72b-7230-32a9-af09-ceedad9f7e37",
                                                "text": "„Sie wünschen sich auch die Anrede mit Nachnamen, wenn sie entsprechend von Gemeindegliedern gefragt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
