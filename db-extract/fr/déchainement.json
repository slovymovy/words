                    },
                    {
                        "translation_id": "b43fd3ca-c7a7-4529-8bdb-a9c7742f9bcc",
                        "source_entry_id": "c7f1766d-b187-3bd1-984e-c8c7327ad0fa",
                        "source_sense_id": "e900ba18-2a62-32ba-8d1d-c4ea8043f2a5",
                        "target_lang_word": "unleashing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unleashing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d165316-94b1-3641-984b-bcb2aa2b711a",
                                        "entry_id": "63f6f6d4-6f45-3fb4-ac55-152f76fee3d6",
                                        "glosses": [
                                            "The act by which something is unleashed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "327eeef8-c8d4-403e-9acc-4b355e9502ca",
                                                "sense_id": "8d165316-94b1-3641-984b-bcb2aa2b711a",
                                                "text": "His great power consists in his building plays not upon the broad basis of general and tested character values, but upon the psychology of our occasional lapses away from the average, our hidden emotional unleashings, sudden angers and momentary caprices."
                                            },
                                            {
                                                "example_id": "42b094d6-472d-4956-8f09-f7fdfc0d978b",
                                                "sense_id": "8d165316-94b1-3641-984b-bcb2aa2b711a",
                                                "text": "We can see in the dozen years between 1517 and the Protestation of the second diet in Speier in 1529 the mighty outwellings of a religious movement comparable only to the unleashings of the dogs of war and the releasing of religious, humanitarian, national and international idealisms, fanaticisms, and new tyrannies in the dozen years or so since 1914."
                                            },
                                            {
                                                "example_id": "61874c31-9752-4c91-bb41-180110083788",
                                                "sense_id": "8d165316-94b1-3641-984b-bcb2aa2b711a",
                                                "text": "How now I can understand the inconceivable before where worlds have been gained or lost in no more than a kiss, if it be a kiss such as this. I feel the overfloodings of our worlds, the unleashings of trapped winds and the release of stormclouded sunshine."
                                            }
                                        ]
                                    }
                                ]
