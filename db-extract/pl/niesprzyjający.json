                                        "entry_id": "886301c6-ccb4-3c47-b3ee-b1c5bc9197e8",
                                        "glosses": [
                                            "Unfavourability ratings, percentage of people in opposition"
                                        ],
                                        "tags": [
                                            "UK",
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
