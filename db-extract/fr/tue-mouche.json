                "translations": [
                    {
                        "translation_id": "2e4880c1-19a0-430b-8a79-21daca535ded",
                        "source_entry_id": "05ffe180-38ec-34fd-bca1-3659d1b78e97",
                        "target_lang_word": "Fliegenklatsche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fliegenklatsche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b03287e-62b5-3f05-bdc5-b2ccdf358333",
                                        "entry_id": "cce29f81-51fd-3dcf-8eda-40297e548fca",
                                        "glosses": [
                                            "Werkzeug zum Totschlagen von Insekten (meist Griff, Stiel und eine elastische, größere Fläche)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cee27f3d-bdc3-4844-b59a-ec25501d26ac",
                                                "sense_id": "3b03287e-62b5-3f05-bdc5-b2ccdf358333",
                                                "text": "Er schlug mit seiner Fliegenklatsche wild um sich."
                                            },
                                            {
                                                "example_id": "b4fcf9ca-ca2b-49bd-9409-0dd3e7549d4f",
                                                "sense_id": "3b03287e-62b5-3f05-bdc5-b2ccdf358333",
                                                "text": "„Als ein Geschwader Wespen über uns herfiel, bewaffnete Mama sich mit der Fliegenklatsche, in der oben noch Flügel, Beine und halbe Köpfe von zerdötschten Fliegen klebten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3b0cafc-35af-4dc2-ad6c-0841a037c07e",
                        "source_entry_id": "05ffe180-38ec-34fd-bca1-3659d1b78e97",
                        "target_lang_word": "Fliegenfänger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fliegenfänger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e940b8e-5747-38f1-a82a-507982f1da4e",
                                        "entry_id": "c203b12e-561d-3cba-8996-d5673c76a45a",
                                        "glosses": [
                                            "mit klebrigem Leim versehener Papierstreifen zur Befestigung an der Zimmerdecke, an dem Fliegen und andere störende Insekten haften bleiben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a01d6dda-04ec-430f-b19e-afac52dd0e57",
                                                "sense_id": "7e940b8e-5747-38f1-a82a-507982f1da4e",
                                                "text": "„Ein Streifen Leimpapier hing als Fliegenfänger von der Decke hinunter, um den die Fliegen lustig herumgaukelten, ahnten sie doch nicht, daß er ihnen Verderben brachte.“"
                                            },
                                            {
                                                "example_id": "c6c2b588-17bf-45c3-972e-310877f41eb0",
                                                "sense_id": "7e940b8e-5747-38f1-a82a-507982f1da4e",
                                                "text": "„Von der Lampe hing ein gelber Fliegenfänger herab.“"
                                            },
                                            {
                                                "example_id": "bf711895-54b6-4cef-8269-900a81853dce",
                                                "sense_id": "7e940b8e-5747-38f1-a82a-507982f1da4e",
                                                "text": "„Aber er deutet gegen die Decke, von der, umsummt und umsurrt von Fliegen, ein Fliegenfänger hängt.“"
                                            },
                                            {
                                                "example_id": "8531437c-e5c0-41fe-a5ac-bd1f32287e89",
                                                "sense_id": "7e940b8e-5747-38f1-a82a-507982f1da4e",
                                                "text": "„Sie ging in ein Zimmer, in dem müde Blattpflanzen standen, alte Magazine herumlagen und Fliegen einen Fliegenfänger umsummten, der von der Decke über den Tisch hing.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "157be4e9-f80d-35bc-a46b-4a2254e42288",
                                        "entry_id": "c203b12e-561d-3cba-8996-d5673c76a45a",
                                        "glosses": [
                                            "schlechter Torwart (einer, der selten Bälle fängt, der oft danebengreift)"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e398ebfa-f794-4451-947b-744b063545de",
                                                "sense_id": "157be4e9-f80d-35bc-a46b-4a2254e42288",
                                                "text": "„Ist ja wieder typisch, dass ausgerechnet dieser Fliegenfänger Lehmann das Theater mit der Schuhwahl anzettelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d18195f-3f73-404d-8354-8788a46cf7e7",
                        "source_entry_id": "05ffe180-38ec-34fd-bca1-3659d1b78e97",
                        "target_lang_word": "Klatsche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
