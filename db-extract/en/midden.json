    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b250e641-fd4a-309d-87c9-f8480f5674bf",
                "word": "midden",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5b779c30-7125-47dd-83cd-f90fca4b0301",
                        "entry_id": "b250e641-fd4a-309d-87c9-f8480f5674bf",
                        "tags": [
                            "plural"
                        ],
                        "form": "middens"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "44e2ec67-16bb-3616-9378-da506d51ca0c",
                        "entry_id": "b250e641-fd4a-309d-87c9-f8480f5674bf",
                        "glosses": [
                            "A dungheap."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "97a3bfaa-f1c3-39b7-a3a6-8f2cf1d0c1b7",
                        "entry_id": "b250e641-fd4a-309d-87c9-f8480f5674bf",
                        "glosses": [
                            "A refuse heap usually near a dwelling."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee66d14e-fee5-4538-8ecc-05425c7a704b",
                                "sense_id": "97a3bfaa-f1c3-39b7-a3a6-8f2cf1d0c1b7",
                                "text": "Untouched by the decaying middens in which they live, they emerge into the sunshine immaculate and serene. The Burmese must be the best-dressed people in the world."
                            },
                            {
                                "example_id": "900deb9c-90a0-4fa0-9c18-1450e06a2baa",
                                "sense_id": "97a3bfaa-f1c3-39b7-a3a6-8f2cf1d0c1b7",
                                "text": "Strange rubbish, not the tins and paper and boxes and other containers you would expect in a town, but a finer kind of waste […] that made the middens look like grey-black mounds of sifted earth."
                            }
                        ]
                    },
                    {
                        "sense_id": "d986b8ae-0407-3bd2-b323-4fe8eb25fcfa",
                        "entry_id": "b250e641-fd4a-309d-87c9-f8480f5674bf",
                        "glosses": [
                            "An accumulation, deposit, or soil derived from occupation debris, rubbish, or other by-products of human activity, such as bone, shell, ash, or decayed organic materials; or a pile or mound of such materials, often prehistoric."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7de2271a-ff24-33ba-9275-4ebb2588953d",
                        "entry_id": "b250e641-fd4a-309d-87c9-f8480f5674bf",
                        "glosses": [
                            "A shelter made of vegetation and other materials by packrats."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "3f3258ba-cab2-370f-99cf-710b00cb9b4b",
                        "entry_id": "b250e641-fd4a-309d-87c9-f8480f5674bf",
                        "glosses": [
                            "An accumulation of dried urine and fecal deposits made by hyraxes."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "280e69e7-8f21-4500-a500-ab315181a859",
                        "source_entry_id": "b250e641-fd4a-309d-87c9-f8480f5674bf",
                        "source_sense_description": "refuse heap",
                        "target_lang_word": "Müllgrube",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Müllgrube",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9867dd98-8132-3e13-b01d-79ac0682b88e",
                                        "entry_id": "fb16f22e-c5f7-34ba-beb0-02bb85ee895a",
                                        "glosses": [
                                            "natürliche oder künstliche Vertiefung im Erdboden, die mit Müll aufgefüllt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72d2488f-710e-4db6-87c1-b8ae7652ba6e",
                                                "sense_id": "9867dd98-8132-3e13-b01d-79ac0682b88e",
                                                "text": "„Die Leute warfen aus Angst vor Ansteckung komplette Wohnungseinrichtungen aus dem Fenster in die Müllgrube.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c9987bd4-f1af-4d51-b25a-b98170d24761",
                        "source_entry_id": "b250e641-fd4a-309d-87c9-f8480f5674bf",
                        "source_sense_description": "refuse heap",
                        "target_lang_word": "Müllhaufen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Müllhaufen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "012e6c3e-818d-3690-b1e7-f9f3ec6a4172",
                                        "entry_id": "1fc6aab8-7f69-3cf2-a1c1-5a5575b40246",
                                        "glosses": [
                                            "ein Haufen aus Unrat"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a61c9d93-3768-4f27-8e39-aadd1abd0325",
                                                "sense_id": "012e6c3e-818d-3690-b1e7-f9f3ec6a4172",
                                                "text": "Machen Sie den Müllhaufen Ihrer Familie von meinem liebevoll gepflegten englischen Rasen weg."
                                            },
                                            {
                                                "example_id": "9d25b437-44a8-4770-aba2-e84b5e5d0fb4",
                                                "sense_id": "012e6c3e-818d-3690-b1e7-f9f3ec6a4172",
                                                "text": "Der Müllhaufen kann leicht zur Müllhalde werden, wenn er nicht regelmäßig entsorgt wird."
                                            },
                                            {
                                                "example_id": "28afb542-d16c-4269-9c7d-e5e1e30d541e",
                                                "sense_id": "012e6c3e-818d-3690-b1e7-f9f3ec6a4172",
                                                "text": "„Ein Müllhaufen liegt vor uns.“"
                                            },
                                            {
                                                "example_id": "74a76b61-fd31-4d23-8ffa-3549606ec22b",
                                                "sense_id": "012e6c3e-818d-3690-b1e7-f9f3ec6a4172",
                                                "text": "„Sie meinte, man hätte ihr Hausgerät und anderes Besitztum hier auf den Müllhaufen geworfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
