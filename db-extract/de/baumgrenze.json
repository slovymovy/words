                        "entry_id": "b61878e7-c167-307e-8252-34814dd43303",
                        "glosses": [
                            "Linie, die den Bereich mit klimatisch möglichem Baumwachstum von dem Bereich ohne abtrennt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "450aa636-213a-4644-947b-2b5051b12e89",
                                "sense_id": "7a81e0f5-ffae-3cbe-bf60-e99e6be7ed7e",
                                "text": "Der Gipfel des Brockens im Harz liegt oberhalb der Baumgrenze."
                            },
                            {
                                "example_id": "7f0868e5-d9f4-4172-8206-2d3fd310319b",
                                "sense_id": "7a81e0f5-ffae-3cbe-bf60-e99e6be7ed7e",
                                "text": "„Gegen 16 Uhr lag die Baumgrenze hinter ihnen, nur noch ein paar windverkrüppelte Fichten hielten sich in dieser Höhe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
