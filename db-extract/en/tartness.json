                                            {
                                                "example_id": "272dd6a8-17ff-4516-b512-24804ce78823",
                                                "sense_id": "83a7871e-15f3-3bdc-8d55-406ebdba3753",
                                                "text": "Die Bitterkeit dieser Schokolade stieß ihn ab."
                                            }
