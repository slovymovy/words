                ],
                "senses": [
                    {
                        "sense_id": "380434fe-380b-3289-812e-6a8add681c02",
                        "entry_id": "bd80b10d-0901-3ad9-b8a9-58829ced1649",
                        "glosses": [
                            "große, einstämmige holzige Pflanze, die noch mit der Menge Licht gedeiht, die durch die Kronen anderer Bäume fällt"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "4e6c7bb7-0887-42ff-92e5-cd4674d733cf",
                                "sense_id": "380434fe-380b-3289-812e-6a8add681c02",
                                "text": "„Man theilt sie nämlich in Lichtbäume und in Schattenbäume: die Kiefer ist […] ein Lichtbaum und verkümmert selbst auf dem ihr zusagendsten Boden, wenn sie im Schatten eines dichten Schlusses steht, […].“"
                            },
                            {
                                "example_id": "26166d6a-6642-47cb-a35f-60dc34794415",
                                "sense_id": "380434fe-380b-3289-812e-6a8add681c02",
                                "text": "„Die Schattenbäume zeichnen sich durch eine dichte Belaubung aus: eben weil die Zweige im Innern der Krone auch bei schwachem Lichtzutritt sich am Leben erhalten und kräftig vegetieren.“"
                            },
                            {
                                "example_id": "5d636289-9e41-47e8-8819-0e37cf5173dd",
                                "sense_id": "380434fe-380b-3289-812e-6a8add681c02",
                                "text": "„Zu guter Letzt noch die beiden kleinsten heimischen Schattenbäume, die ihr gesamtes Leben im Schatten größerer Bäume verbringen können und sich trotzdem zu stattlichen Exemplaren entwickeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4c2e463d-79d7-36a2-a99b-ef548d0491af",
                        "entry_id": "bd80b10d-0901-3ad9-b8a9-58829ced1649",
                        "glosses": [
                            "Pflanze wie [1], deren Schatten Schutz vor zu starker Sonneneinstrahlung bietet, besonders für Kulturpflanzen in Plantagen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5049c82-5df0-4e3c-94dc-0bad6c35697b",
                                "sense_id": "4c2e463d-79d7-36a2-a99b-ef548d0491af",
                                "text": "„Die richtige Zahl der Schattenbäume […] und die richtige Entfernung voneinander ist ungemein wichtig, da von dem richtigen Masse der Beschattung der Ertrag der Pflanzung im hohen Grade abhängig ist.“"
                            },
                            {
                                "example_id": "6ee51f54-e7f0-4394-a2da-bffabb01177d",
                                "sense_id": "4c2e463d-79d7-36a2-a99b-ef548d0491af",
                                "text": "„Sämtliche Straßen mit Ausschluß natürlich der Geschäftsstraßen haben doppelte Reihen von Schattenbäumen, […].“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
