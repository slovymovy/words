                ],
                "senses": [
                    {
                        "sense_id": "a95e11f4-5487-3080-9500-d1868469c188",
                        "entry_id": "3ef31755-f07a-3041-aa77-37458112b2d7",
                        "glosses": [
                            "betagtes, hohes Alter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f92e3e0a-7d54-4058-abe9-192f1bf333ef",
                                "sense_id": "a95e11f4-5487-3080-9500-d1868469c188",
                                "text": "Viele Menschen erreichen heutzutage das Greisenalter."
                            },
                            {
                                "example_id": "0d940296-e5a7-4f40-8c91-d65c9c855bff",
                                "sense_id": "a95e11f4-5487-3080-9500-d1868469c188",
                                "text": "„Unverkennbare Anzeichen des Greisenalters machten sich deutlich bei ihm bemerkbar: plötzliches Einschlafen, Vergesslichkeit für nur kurze Zeit zurückliegende Ereignisse und ein gutes Gedächtnis für längst Vergangenes; und auch die kindliche Eitelkeit gehörte hierher, mit der er die Rolle des Moskauer Oppositionsführers übernommen hatte.“"
                            },
                            {
                                "example_id": "80806235-6280-40a8-94ac-70fc4d07ddf6",
                                "sense_id": "a95e11f4-5487-3080-9500-d1868469c188",
                                "text": "„Aus diesem Grund muß die Natur das Greisenalter verabscheuen, das sich wohl Freuden verschaffen, sie aber niemals schenken kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
