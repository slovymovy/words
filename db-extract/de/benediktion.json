                "senses": [
                    {
                        "sense_id": "42216915-c7aa-3390-85c6-213faeba0aa3",
                        "entry_id": "9efd9563-08be-382b-94bd-d7c8e4a83fcb",
                        "glosses": [
                            "Gebet oder Ritus, um Gottes Gnade/Beistand zu erhalten"
                        ],
                        "tags": [
                            "katholische Kirche"
                        ],
                        "examples": [
                            {
                                "example_id": "91ffda06-b93c-440e-b0bf-44ed71efac1a",
                                "sense_id": "42216915-c7aa-3390-85c6-213faeba0aa3",
                                "text": "„Nach der zweitlegten Benediktion folgt der Priestersegen, über den der Artikel ‚Priestersegen‘ berichtet.“"
                            },
                            {
                                "example_id": "b7616134-abee-4659-a300-1b4d71a95978",
                                "sense_id": "42216915-c7aa-3390-85c6-213faeba0aa3",
                                "text": "„Für die Feier im Mariendom in Linz wurde dieser Vorschlag übernommen und textlich ausgestaltet, und für beide Leitungsaufgaben, die bischöfliche und die priesterliche, im Gottesdienst eine einheitliche Benediktion formuliert.“"
                            },
                            {
                                "example_id": "3c4af265-374f-4a65-96cf-49096ee5f3b9",
                                "sense_id": "42216915-c7aa-3390-85c6-213faeba0aa3",
                                "text": "„Der Schriftbeweis für die vier Benediktionen des Tischgebetes wurde aus Dt 8, 10 geführt.“"
                            },
                            {
                                "example_id": "da173e1c-a288-470e-9351-fe1f9bc71a23",
                                "sense_id": "42216915-c7aa-3390-85c6-213faeba0aa3",
                                "text": "„Während der weltliche Akt der Eheschließung vor der Kirchentür »in jedes Landes oder Ortes Belieben« gestellt wurde, lag der Fokus des Traubüchleins in der Ausgestaltung der Benediktion.“"
                            },
                            {
                                "example_id": "fedb42d8-e428-4bd7-bb1d-2d0c8462ae39",
                                "sense_id": "42216915-c7aa-3390-85c6-213faeba0aa3",
                                "text": "„Jedes Element einer Segensfeier (Benediktion) äußert sich in einem aszendenten und einem deszendenten Aspekt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
