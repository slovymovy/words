                "senses": [
                    {
                        "sense_id": "9b338de5-35fc-3332-94a7-d4d8920a3ff3",
                        "entry_id": "4c12dd21-3519-3806-acb6-2b9f4b98e28f",
                        "glosses": [
                            "устар. женск. к очарователь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed90d80f-4e0f-4f03-b3aa-0befdf221cd0",
                                "sense_id": "9b338de5-35fc-3332-94a7-d4d8920a3ff3",
                                "text": "Сама ль ты любовь или любовница, очарованье или очаровательница?"
                            },
                            {
                                "example_id": "8b5151be-10aa-482e-b46b-d823e82ba417",
                                "sense_id": "9b338de5-35fc-3332-94a7-d4d8920a3ff3",
                                "text": "Все сердца устремились к прелестной очаровательнице, все спешили наперерыв приветствовать её и благодарить за оказанное удовольствие, ― вдруг перед нею очутился господин Голядкин."
                            }
                        ]
                    }
