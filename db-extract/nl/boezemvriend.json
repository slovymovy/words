                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5eb0c70-e3fd-3b16-991a-7d15b18cc351",
                                        "entry_id": "f1ca4cac-8ee3-3d14-88c4-4761143b6e94",
                                        "glosses": [
                                            "To assign a buddy, or partner, to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "106712f6-fc2a-40ff-98a3-3a3519a22c6b",
                                                "sense_id": "b5eb0c70-e3fd-3b16-991a-7d15b18cc351",
                                                "text": "If you are being formally buddied, have a good chat with your buddy and find out their interests -- these should more or less match your own."
                                            }
