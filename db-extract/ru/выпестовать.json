                "senses": [
                    {
                        "sense_id": "dc3619e6-4361-33d5-836d-911a01667b4b",
                        "entry_id": "6649c48e-5b42-34d8-bc52-4036d1a703fa",
                        "glosses": [
                            "выкормить, вы́ходить (животное, растение)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aec319b5-e0b4-4c9b-8cd3-d36b79d51a6c",
                                "sense_id": "dc3619e6-4361-33d5-836d-911a01667b4b",
                                "text": "В поле растет вовсе не тот сорт, который выпестовал селекционер на своих опытных грядках."
                            }
                        ]
                    },
                    {
                        "sense_id": "e520c4a1-ca09-3bba-94b1-16560d7691aa",
                        "entry_id": "6649c48e-5b42-34d8-bc52-4036d1a703fa",
                        "glosses": [
                            "поэт., ритор. заботливо, с любовью вырастить, вынянчить, воспитать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bbb2f86-d6f8-472e-9de7-a8832d86e09c",
                                "sense_id": "e520c4a1-ca09-3bba-94b1-16560d7691aa",
                                "text": "Прекрасный организатор и воспитатель за короткий срок сумел выпестовать целый отряд единомышленников, теперь уже ставших его коллегами."
                            }
                        ]
                    }
