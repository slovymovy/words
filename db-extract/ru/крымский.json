                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20c0f4ef-3ee4-4a77-a034-d0e9ea2a477e",
                                                "sense_id": "64684840-571c-31c7-b076-13de32c8887d",
                                                "text": "Ce prestigieux triangle criméen, objet des convoitises des grands impérialismes […] a été pris à Wrangel par les bolchéviks en un seul jour —le 14 novembre 1920."
                                            },
                                            {
                                                "example_id": "e3fc4551-d785-478e-a7ee-0304a18f51b2",
                                                "sense_id": "64684840-571c-31c7-b076-13de32c8887d",
                                                "text": "La vieille terre criméenne, pleine de résonance turque, a agrandi depuis des siècles la part de l’agriculture."
                                            }
                                        ]
