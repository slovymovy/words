                                    {
                                        "sense_id": "06f1b1a1-0159-3056-bc95-8b0e85170a4c",
                                        "entry_id": "9b3734fe-c2cc-34d0-81a1-44ad11bc4e18",
                                        "glosses": [
                                            "To chuckle; to laugh."
                                        ],
                                        "tags": [
