                    {
                        "sense_id": "96b898af-f672-3bf4-8343-69a9924dfcfb",
                        "entry_id": "bb42ddca-c320-303b-8e7c-1ed439fd0ed0",
                        "glosses": [
                            "A spit, a sharpened rod used for roasting food over a fire."
