    "entries": [
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "0686455e-f465-30f3-b3ba-cbaf89b20c11",
                    "sense_definition": "Faute de quoi ; sans quoi ; dans le cas contraire.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mets ton manteau chaud, <w>sinon</w> tu vas attraper froid dehors."
                        },
                        {
                            "text": "Nous devons partir maintenant, <w>sinon</w> nous allons rater le dernier train."
                        }
                    ],
                    "common_phrases": [
                        "sinon rien",
                        "ou sinon"
                    ]
                },
                {
                    "sense_id": "fc799fb1-f205-3200-abd9-550a79c4732e",
                    "sense_definition": "Excepté ; mis à part ; si ce n'est.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je ne sais rien de cette histoire, <w>sinon</w> qu'il est déjà parti."
                        },
                        {
                            "text": "Il n'avait aucune exigence particulière, <w>sinon</w> d'avoir une chambre calme."
                        }
                    ],
                    "synonyms": [
                        "mis à part",
                        "si ce n'est"
                    ],
                    "common_phrases": [
                        "sinon que"
                    ]
                },
                {
                    "sense_id": "7c9b4fa8-daec-3abd-b3d6-1abe14c9c37f",
                    "sense_definition": "Voire ; si ce n'est, pour marquer une gradation ou une alternative.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette tâche sera difficile, <w>sinon</w> impossible à réaliser dans les temps."
                        },
                        {
                            "text": "Il a perdu une centaine de livres, <w>sinon</w> plus, lors du déménagement."
                        }
                    ],
                    "synonyms": [
                        "voire"
                    ],
                    "common_phrases": [
                        "sinon plus"
                    ]
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "6f993905-ec06-39f9-a5d5-7e07f8c14875",
                    "sense_definition": "D'ailleurs ; par ailleurs ; à part cela.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tout va bien pour moi, et <w>sinon</w>, comment se passent tes vacances ?"
