                "senses": [
                    {
                        "sense_id": "26c41ebb-11ba-375f-ad7a-dd63e6863152",
                        "entry_id": "f0692622-15cb-3988-9c8f-97d155b90748",
                        "glosses": [
                            "Forcé : inévitable, imposé par les circonstances."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c15bfdee-84b6-4a5c-80f4-d73e709167e4",
                                "sense_id": "26c41ebb-11ba-375f-ad7a-dd63e6863152",
                                "text": "Drensteinfurt – Nach dem zwangsweisen Rückgang während der Coronajahre ist die Zahl der VHS-Nutzer [Volkshochschule-Nutzer] wieder deutlich angestiegen.",
                                "translation": "Drensteinfurt – Après la baisse forcée pendant les années [de la crise du] Coronavirus, la fréquentation des universités populaires a de nouveau considérablement augmenté."
                            }
                        ]
                    },
                    {
                        "sense_id": "ffc5036d-924a-32df-b227-aba93e5e89b8",
                        "entry_id": "f0692622-15cb-3988-9c8f-97d155b90748",
                        "glosses": [
                            "Forcé : de force, imposé par la violence ou toute autre forme de contrainte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a77df72e-817b-41ee-bc2d-6bf144c27f40",
                                "sense_id": "ffc5036d-924a-32df-b227-aba93e5e89b8",
                                "text": "Erst als die Kinder volljährig waren und weitere Mietrückstände aufgelaufen waren, beauftragte die Gemeinde Ende des Jahres 2016 einen Gerichtsvollzieher mit der zwangsweisen Räumung der Wohnung.",
                                "translation": "Ce n’est que lorsque les enfants eurent atteint leur majorité et que d’autres arriérés de loyer se furent accumulés que la commune a chargé à la fin de l'année 2016 un huissier de justice de faire évacuer de force l’appartement."
                            }
                        ]
                    }
                ],
