                "senses": [
                    {
                        "sense_id": "162c205c-60d3-3449-a96b-77317771e22e",
                        "entry_id": "af7581ca-35dc-36d7-a25e-afb457453d89",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a88dfde2-35cc-473c-bea3-02383b226806",
                                "sense_id": "162c205c-60d3-3449-a96b-77317771e22e",
                                "text": "Frau Glass ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "74a1cc18-f2b2-430e-918e-844d49392aa9",
                                "sense_id": "162c205c-60d3-3449-a96b-77317771e22e",
                                "text": "Herr Glass wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "8e899545-af87-4c19-8249-36fcf5644f26",
                                "sense_id": "162c205c-60d3-3449-a96b-77317771e22e",
                                "text": "Die Glass fahren heute nach Jena."
                            },
                            {
                                "example_id": "ea896aad-4427-4ac5-ac91-bf66802b95ba",
                                "sense_id": "162c205c-60d3-3449-a96b-77317771e22e",
                                "text": "Der Glass trägt nie die Schals, die die Glass ihm strickt."
                            },
                            {
                                "example_id": "709e5927-4b1f-4617-8f16-5347ce10aa41",
                                "sense_id": "162c205c-60d3-3449-a96b-77317771e22e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Glass kommt, geht der Herr Glass.“"
                            },
                            {
                                "example_id": "79d69436-9937-4071-b837-357e4c5ff61b",
                                "sense_id": "162c205c-60d3-3449-a96b-77317771e22e",
                                "text": "Glass kommt und geht."
                            },
                            {
                                "example_id": "8802af10-31e4-483f-a21f-f0b0add43568",
                                "sense_id": "162c205c-60d3-3449-a96b-77317771e22e",
                                "text": "Glassens kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
