                "translations": [
                    {
                        "translation_id": "7fc06a53-0a0b-4b16-a024-271dea61e2f1",
                        "source_entry_id": "b9203838-857e-3b27-afe1-17099929c99b",
                        "source_sense_id": "08288c47-b505-3258-b424-a61d3b8d9189",
                        "target_lang_word": "aerophobia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aerophobia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10091385-9a5e-34b8-b276-1bfdac28d75a",
                                        "entry_id": "94fdffd0-5475-3e11-9d77-a052c5df482b",
                                        "glosses": [
                                            "A pathological aversion or sensitivity to air or the movement of air, especially as a symptom of rabies."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8cb02f5-2866-4982-b254-7a042fd6b1a7",
                                                "sense_id": "10091385-9a5e-34b8-b276-1bfdac28d75a",
                                                "text": "The patient was diagnosed after displaying both aerophobia and acute hydrophobia."
                                            },
                                            {
                                                "example_id": "0c32f109-19e1-4ada-8b81-10fd4d285f46",
                                                "sense_id": "10091385-9a5e-34b8-b276-1bfdac28d75a",
                                                "text": "Furious rabies, the more common presentation, involves the brainstem, the limbic system,, the hypothalamus, and the autonomic center. It is characterized by hydrophobia, aerophobia, and episodic generalized arousal interrupted by periods of lucidity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bc92d81-c349-39b0-aa4e-0054611b9d92",
                                        "entry_id": "94fdffd0-5475-3e11-9d77-a052c5df482b",
                                        "glosses": [
                                            "An aversion to fresh air, drafts or breezes."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da066e2b-fd82-4387-944b-fc342803b2cc",
                                                "sense_id": "1bc92d81-c349-39b0-aa4e-0054611b9d92",
                                                "text": "I can't understand your aerophobia on days this warm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95d087b7-a34b-3552-9655-82125080359f",
                                        "entry_id": "94fdffd0-5475-3e11-9d77-a052c5df482b",
                                        "glosses": [
                                            "Fear of flying"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "def4243b-6c1b-43cb-960d-62d2aa0678bf",
                                                "sense_id": "95d087b7-a34b-3552-9655-82125080359f",
                                                "text": "Many first-time flyers suffer from aerophobia, though some hide it better than others."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1768a50-c159-3256-9a2d-e8e266dd051f",
                                        "entry_id": "94fdffd0-5475-3e11-9d77-a052c5df482b",
                                        "glosses": [
                                            "Fear of heights"
                                        ],
                                        "tags": [
                                            "broadly",
                                            "possibly",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6795af06-5b65-48c7-9c34-905a9d5cd9f3",
                                                "sense_id": "e1768a50-c159-3256-9a2d-e8e266dd051f",
                                                "text": "Standing on the edge of the cliff made me realise just how much aerophobia affected me."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
