                "senses": [
                    {
                        "sense_id": "3fab140a-9e4e-3e82-aab5-8a2825d4715f",
                        "entry_id": "2def3119-adc9-3960-a40a-1533ada901d4",
                        "glosses": [
                            "Angehörige der Schutzstaffel („SS-Helferinnenkorps“) oder des ihr angegliederten „SS-Gefolges“"
                        ],
                        "tags": [
                            "Nationalsozialismus"
                        ],
                        "examples": [
                            {
                                "example_id": "44edb9f9-f772-426e-b0b5-4316131cd199",
                                "sense_id": "3fab140a-9e4e-3e82-aab5-8a2825d4715f",
                                "text": "„Eine SS-Frau schlägt mit verzerrtem Mund immer wieder auf einen Mann ein, der am Boden liegt.“"
                            },
                            {
                                "example_id": "7c49564c-d72c-4539-b6d5-7fdc632fa2ea",
                                "sense_id": "3fab140a-9e4e-3e82-aab5-8a2825d4715f",
                                "text": "„Zu dieser Zeit waren wir 26 SS-Männer und 17 SS-Frauen; die übrigen sieben SS-Frauen waren nach Hause gegangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
