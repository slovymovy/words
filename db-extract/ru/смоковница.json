                "senses": [
                    {
                        "sense_id": "5cc9412f-ec4c-3352-ae63-3f909d967186",
                        "entry_id": "f4725f2e-d814-3c1c-b390-f5e9aee102ad",
                        "glosses": [
                            "ботан. субтропическое дерево семейства тутовых рода фикусов с твёрдой древесиной и съедобными плодами; сикомор"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95b4a422-9a14-47c5-879b-69fa88ba041f",
                                "sense_id": "5cc9412f-ec4c-3352-ae63-3f909d967186",
                                "text": "Одним окном глядела она в упомянутый дворик, а в другое, противоположное ему, врывались ветви тенистой смоковницы (винной ягоды, инджира), с широколапчатыми листьями, ласкающая прохлада и тонкий аромат цветов с наилучшего в городе консульского сада; .."
                            },
                            {
                                "example_id": "f84bc482-1113-4255-8b86-f2cffd69d58c",
                                "sense_id": "5cc9412f-ec4c-3352-ae63-3f909d967186",
                                "text": "За селением в тени смоковниц струится источник, известный у христиан как Источник Пресвятой Девы Марии."
                            }
                        ]
                    },
                    {
                        "sense_id": "91fc2312-4f7a-3a15-bc33-efc1fba49940",
                        "entry_id": "f4725f2e-d814-3c1c-b390-f5e9aee102ad",
                        "glosses": [
                            "плоды (плод) такого дерева"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "457ee355-909a-43ba-8f06-4fc9f9a3dff7",
                        "source_entry_id": "f4725f2e-d814-3c1c-b390-f5e9aee102ad",
                        "target_lang_word": "figuier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "figuier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7d3628b4-b82e-349a-9919-b2d8aec9cf35",
                                        "entry_id": "105f5f2f-2b68-37f5-b142-e146b24e25af",
                                        "glosses": [
                                            "Arbre de la famille des moracées, qui porte des figues."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee18211d-2e3c-4b1b-8902-2ee736c893df",
                                                "sense_id": "7d3628b4-b82e-349a-9919-b2d8aec9cf35",
                                                "text": "C’est une large dépression herbeuse, avec une mare et un groupe de figuiers au centre."
                                            },
                                            {
                                                "example_id": "64108006-48da-4469-a976-a45016b1cd69",
                                                "sense_id": "7d3628b4-b82e-349a-9919-b2d8aec9cf35",
                                                "text": "Par cette matinée d’automne, on n’entend qu’un bruissement mélancolique, les amandiers et les figuiers laissent tomber leurs feuilles à cette même place où, sur les porphyres et les brèches d’Afrique, s’épandaient les pluies parfumées."
                                            },
                                            {
                                                "example_id": "368fb5fb-f803-43ba-a95b-4b31e3f947b0",
                                                "sense_id": "7d3628b4-b82e-349a-9919-b2d8aec9cf35",
                                                "text": "Et pourtant les figuiers s’obstinent à pousser spontanément parmi les gravats et je me gorge, sans rien payer, de leurs fruits cramoisis."
                                            },
                                            {
                                                "example_id": "cd03db43-acc7-4a73-a1ed-7eaf304d32bd",
                                                "sense_id": "7d3628b4-b82e-349a-9919-b2d8aec9cf35",
                                                "text": "La sève de figuier contient des furocoumarines responsables d’irritation, de phototoxicité voire de photoallergie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86c7ecde-f0e3-372f-9123-2b1a279e45c3",
                                        "entry_id": "105f5f2f-2b68-37f5-b142-e146b24e25af",
                                        "glosses": [
                                            "Bois tiré de cet arbre, dont il n’est fait aucun usage particulier."
                                        ],
                                        "tags": [
                                            "metonymically",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6d70c3c-004f-4978-92c2-73f55d7002fa",
                                                "sense_id": "86c7ecde-f0e3-372f-9123-2b1a279e45c3",
                                                "text": "Le figuier est un bois très particulier : outre une certaine toxicité quand on joue un peu trop avec la sève, il y a de la rétractation dans l’air, rapidement les bûches se retrouvent couvertes de gerçures profondes qui rendent le bois juste bon pour le chauffage !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "figuier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "139ceb41-803e-3909-996b-8104457dfb74",
                                        "entry_id": "38075823-1670-38aa-9ef5-3f086fe4fa6f",
                                        "glosses": [
                                            "Nom vernaculaire de divers oiseaux Passériformes d’Amérique du Nord, nommés généralement fauvette en Europe."
                                        ],
