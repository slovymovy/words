                    }
                ],
                "senses": [
                    {
                        "sense_id": "158932c1-7ba2-3fdf-a06c-91bc2b6b7e68",
                        "entry_id": "34423807-5a86-3ea1-b365-c522d1c091e5",
                        "glosses": [
                            "A clasp consisting of a hook which fastens onto a ring."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07e03abb-4b25-429d-a586-45ce483a3574",
                                "sense_id": "158932c1-7ba2-3fdf-a06c-91bc2b6b7e68",
                                "text": "The feather of an ostrich, fastened in her turban by an agraffe set with brilliants, was another distinction of the beautiful Jewess, scoffed and sneered at by the proud dames who sat above her, but secretly envied by those who affected to deride them."
                            }
                        ]
                    },
                    {
                        "sense_id": "c1c238d3-845e-3327-bfeb-70d212b8be0f",
                        "entry_id": "34423807-5a86-3ea1-b365-c522d1c091e5",
                        "glosses": [
                            "A hook, eyelet, or other device by which a piano wire is held so as to limit the vibration."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d4e17171-fead-35a9-beae-4b70efc855b8",
                        "entry_id": "34423807-5a86-3ea1-b365-c522d1c091e5",
                        "glosses": [
                            "A carved keystone, usually decorated with a mascaron or a corbel, often used in Classical architecture."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "567e90c1-ff08-3325-9a85-1c27cfd05d2d",
                        "entry_id": "34423807-5a86-3ea1-b365-c522d1c091e5",
                        "glosses": [
                            "A brass fitting, screwed into a piano plate, that positions the strings vertically and laterally, and defines one end of the string's speaking length."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "293dfd2f-2f9e-427e-8de2-c9af734c21c3",
                        "source_entry_id": "34423807-5a86-3ea1-b365-c522d1c091e5",
                        "source_sense_description": "a glasp consisting of a hook which fastens onto a ring",
                        "target_lang_word": "Agraffe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Agraffe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "741dc3f1-9278-3323-96be-1c2895e047dd",
                                        "entry_id": "b99c0ecc-a4f6-3d6f-8269-a8e776e679dc",
                                        "glosses": [
                                            "ein besonders gestalteter Schlussstein im Scheitel eines Rundbogens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9dd41e2-0f17-4268-9fbb-0153796e9e9d",
                                                "sense_id": "741dc3f1-9278-3323-96be-1c2895e047dd",
                                                "text": "Die Agraffe ist meist deutlich größer gestaltet als die restlichen Keilsteine."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "939c6aff-124d-30b4-8ee3-2ccbd19b400d",
                                        "entry_id": "b99c0ecc-a4f6-3d6f-8269-a8e776e679dc",
                                        "glosses": [
                                            "eine Schmuckspange, die ein Gewand zusammenhalten soll"
                                        ],
                                        "tags": [
                                            "Schmuck"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bdfa111-c51e-4a3b-b9c5-733bdcfd5802",
                                                "sense_id": "939c6aff-124d-30b4-8ee3-2ccbd19b400d",
                                                "text": "Die Agraffe soll ein Gewand oder einen Mantel zusammenhalten."
                                            },
                                            {
                                                "example_id": "f27639a6-d53a-49e4-9908-7aa2532afed7",
                                                "sense_id": "939c6aff-124d-30b4-8ee3-2ccbd19b400d",
                                                "text": "„Was die Frauen betrifft, so genügt jedem denkenden Mann sein gesunder Menschenverstand, um ihn von der Frage abzuhalten, was es mit einem geschlossenen Medaillon, einer auffällig getragenen Agraffe, einem Porträt am Armband oder an einem Ring für eine Bewandtnis habe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b64521b2-a076-3389-b87d-e521054e95bb",
                                        "entry_id": "b99c0ecc-a4f6-3d6f-8269-a8e776e679dc",
                                        "glosses": [
                                            "das kleine Drahtgeflecht, das den Korken einer verschlossenen Sekt- oder Champagnerflasche fixiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57496482-24b9-43a4-8023-641fd822d661",
                                                "sense_id": "b64521b2-a076-3389-b87d-e521054e95bb",
                                                "text": "„Der Kork wird mit einem Drahtbügel gesichert, der Agraffe oder Muselet (französisch) genannt wird.“"
                                            },
                                            {
                                                "example_id": "f12396e9-a9ae-4a58-a139-68cd79019580",
                                                "sense_id": "b64521b2-a076-3389-b87d-e521054e95bb",
                                                "text": "„Entfernen Sie zuerst die metallene Kapsel, dann die Agraffe, das ist der Draht, der den Korken hält. Von jetzt an ist Vorsicht geboten! […]“"
                                            },
                                            {
                                                "example_id": "549c3018-b9c6-4d30-b161-92e086cb60d4",
                                                "sense_id": "b64521b2-a076-3389-b87d-e521054e95bb",
                                                "text": "„Die Agraffe dient zur Sicherung des Korkens auf der Flasche, so dass dieser sich durch den Innendruck nicht eigenständig lösen kann.“"
                                            },
                                            {
                                                "example_id": "ba3e23a4-891e-4b24-a9df-b31375af4254",
                                                "sense_id": "b64521b2-a076-3389-b87d-e521054e95bb",
                                                "text": "Die Agraffe verhindert, dass durch den großen Überdruck in der Sektflasche der Korken aus dem Flaschenhals hinausgetrieben wird."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "26713cbf-15af-3c3f-b3f9-70bcbc5e3e17",
                                        "entry_id": "b99c0ecc-a4f6-3d6f-8269-a8e776e679dc",
                                        "glosses": [
                                            "ein Gegenstand zum Befestigen des Drahtrahmendrahtes am Pfahl der entsprechenden Reberziehungsmethode"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e227ce11-2a99-47c4-9911-c2997b4c8540",
                                                "sense_id": "26713cbf-15af-3c3f-b3f9-70bcbc5e3e17",
                                                "text": "Um den Drahtrahmendraht am Pfahl zu befestigen, brauchst du eine Agraffe."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "2b5e73af-5217-3ab1-aa80-0970b3a12bc6",
                                        "entry_id": "b99c0ecc-a4f6-3d6f-8269-a8e776e679dc",
                                        "glosses": [
                                            "chirurgisches, zangenförmiges Instrument in der Medizin zum Zusammenhalten der Wundränder"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "caca74b6-bcfd-4a9b-964d-807dcbcbb6f1",
                                                "sense_id": "2b5e73af-5217-3ab1-aa80-0970b3a12bc6",
                                                "text": "Mein Chirurg hat drei Agraffen verwendet, um die Ränder meiner Wunde zusammenzufügen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
