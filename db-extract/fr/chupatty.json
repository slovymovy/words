                        ],
                        "examples": [
                            {
                                "example_id": "6e7f635a-c6d6-4f3c-8fa7-a16974c24976",
                                "sense_id": "c02658ac-1ba1-315a-b1d9-a682474725fe",
                                "text": "Avec des légumes et de la viande de chevreuil, quelques grains de maïs, de riz ou de minces galettes en chupatties et de l’eau pure pour boisson, un indigène passera des jours et des semaines, quand un Anglais tomberait de lassitude et périrait d’inanition."
                            },
                            {
                                "example_id": "405f76fb-d4dc-4b23-9391-4d7cd6a927c3",
                                "sense_id": "c02658ac-1ba1-315a-b1d9-a682474725fe",
                                "text": "En l’espace de vingt respirations elle descend des montagnes sous la forme d’un mur de trois pieds de haut, et je l’ai vue, entre le moment d’allumer le feu et celui où le chupatty est cuit, devenir, de ruisseau, une sœur de la Jumna."
                            }
                        ]
                    }
