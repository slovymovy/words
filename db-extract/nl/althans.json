                "forms": [],
                "senses": [
                    {
                        "sense_id": "638ab25c-4903-3a46-9bf2-b6209e7c9b56",
                        "entry_id": "57347b89-b4d9-3307-a70a-6348407697d6",
                        "glosses": [
                            "geeft in het gedeelte na althans meer specifiek (en tegengesteld) aan wat er bedoeld wordt, in ieder geval"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddccf25f-f02a-443c-86ed-ee4a921f0bf4",
                                "sense_id": "638ab25c-4903-3a46-9bf2-b6209e7c9b56",
                                "text": "Dat is althans het beeld dat ontstaat bij het openslaan van een willekeurige krant."
                            },
                            {
                                "example_id": "6da3a376-5b06-4018-89ea-20588f547311",
                                "sense_id": "638ab25c-4903-3a46-9bf2-b6209e7c9b56",
                                "text": "Ik dronk niet meer, althans, niet meer zoals vroeger."
                            },
                            {
                                "example_id": "1c7c5e09-b43c-47c4-8bac-7e58b2f5d6ed",
                                "sense_id": "638ab25c-4903-3a46-9bf2-b6209e7c9b56",
                                "text": "Hoewel ze niets van heimelijk gedrag moest hebben, voelde ze zich geen voyeur. Althans, dat maakte ze zichzelf wijs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ec8d310-10ee-4d96-9cc6-bad2bdfae8ef",
                        "source_entry_id": "57347b89-b4d9-3307-a70a-6348407697d6",
                        "source_sense_id": "638ab25c-4903-3a46-9bf2-b6209e7c9b56",
                        "source_sense_description": "geeft in het tweede gedeelte meer specifiek aan wat er bedoeld wordt",
                        "target_lang_word": "jedenfalls",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jedenfalls",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "17689238-047e-3463-869e-e3df168a0ef0",
                                        "entry_id": "8f4c80b5-a91b-3ebf-8ea8-0dc0b99ced95",
                                        "glosses": [
                                            "auf alle Fälle, bestimmt"
                                        ],
                                        "tags": [
                                            "an Vorangegangenes anknüpfend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d4c5da7-dd1c-4f78-8764-de3d389e1073",
                                                "sense_id": "17689238-047e-3463-869e-e3df168a0ef0",
                                                "text": "„Erst wenn dies gelingt, kann von einem Mauterfolg gesprochen werden. Das bloße Abkassieren von Streckengebühren ist es jedenfalls noch nicht.“"
                                            },
                                            {
                                                "example_id": "8f6e2657-9017-403e-a6ce-eddcdc914112",
                                                "sense_id": "17689238-047e-3463-869e-e3df168a0ef0",
                                                "text": "„Ich jedenfalls brauche eine Ewigkeit, bis sich Namen und Gesichter in meinem Gehirn zu einer Person verbinden.“"
                                            },
                                            {
                                                "example_id": "39730bca-a947-403e-907e-46433897164c",
                                                "sense_id": "17689238-047e-3463-869e-e3df168a0ef0",
                                                "text": "„Der Schwiegervater jedenfalls wagt 1043 einen Angriff auf das Großreich, scheitert aber damit.“"
                                            },
                                            {
                                                "example_id": "c3c81c90-df0c-488f-ac4b-a5cb678d0cb0",
                                                "sense_id": "17689238-047e-3463-869e-e3df168a0ef0",
                                                "text": "„Das hatte jedenfalls die Vorhut der anonymen Tester aus seinem Munde wenige Tage zuvor erfahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "55156b5b-82a1-3213-b2cc-b4e9ba318735",
                                        "entry_id": "8f4c80b5-a91b-3ebf-8ea8-0dc0b99ced95",
                                        "glosses": [
                                            "nach, trotz dem, was vorher geschehen ist"
                                        ],
                                        "tags": [
                                            "an Vorangegangenes anknüpfend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8a3aa7f-eb17-4e53-9fd1-eb5478ff6718",
                                                "sense_id": "55156b5b-82a1-3213-b2cc-b4e9ba318735",
                                                "text": "Mögen die anderen auch lästern, ich mache jedenfalls auf meine Art weiter."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "46a40cc1-4e19-4950-ae8a-93a1f5cf97b7",
                        "source_entry_id": "57347b89-b4d9-3307-a70a-6348407697d6",
                        "source_sense_id": "638ab25c-4903-3a46-9bf2-b6209e7c9b56",
                        "source_sense_description": "geeft in het tweede gedeelte meer specifiek aan wat er bedoeld wordt",
                        "target_lang_word": "mindestens",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mindestens",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4555393c-e67e-3448-a6a2-d40f9480a6f9",
                                        "entry_id": "34a1143c-9261-336c-9412-1b3dc0e36186",
                                        "glosses": [
                                            "genau so viel (wie angegeben), oder mehr (von Elementen desselben Typs)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7510903b-8110-4273-8fb0-b0193b624265",
                                                "sense_id": "4555393c-e67e-3448-a6a2-d40f9480a6f9",
                                                "text": "Mindestens bezieht sich immer auf eine Anzahl von Elementen desselben Typs; zumindest dagegen bezieht sich immer auf die Qualität der Elemente und wird häufig mit mindestens verwechselt. Zur Abgrenzung von zumindest zu mindestens:",
                                                "translation": "Der Bewerber sollte zumindest mittelmäßige Kenntnisse besitzen: Dies bedeutet, dass Bewerber, die nur schlechte oder keine Kenntnisse haben, ausgeschlossen werden."
                                            },
                                            {
                                                "example_id": "2d13be3c-ad27-4a08-bab8-a86058517258",
                                                "sense_id": "4555393c-e67e-3448-a6a2-d40f9480a6f9",
                                                "text": "Ein LKW hat mindestens zwei Achsen mit je mindestens zwei Rädern."
                                            },
                                            {
                                                "example_id": "ab2c5be7-bbda-47d7-a1de-1ba87dbf920c",
                                                "sense_id": "4555393c-e67e-3448-a6a2-d40f9480a6f9",
                                                "text": "„Es gab mindestens vier Attentäter auf der Strecke des Autokorsos.“"
                                            },
                                            {
                                                "example_id": "8f1f07bc-327a-4b19-b279-ae63e6061d4f",
                                                "sense_id": "4555393c-e67e-3448-a6a2-d40f9480a6f9",
                                                "text": "Bereits vor mindestens 200 Jahren haben Mediziner das Phänomen verhärteter Arterien beschrieben, wie der Medizinalrat Johannes Wetzler in seinen \"Beobachtungen über Krankheiten des Herzens und der Arterien\"."
                                            },
                                            {
                                                "example_id": "7d718905-7f40-4040-80c5-3e35e767ebc0",
                                                "sense_id": "4555393c-e67e-3448-a6a2-d40f9480a6f9",
                                                "text": "„Drachenfliegen ist heute mindestens ebenso sicher wie Segelfliegen – dank enormer technischer Entwicklungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b03f3ed-b009-4abb-bb71-67a2ea9def11",
                        "source_entry_id": "57347b89-b4d9-3307-a70a-6348407697d6",
                        "source_sense_id": "638ab25c-4903-3a46-9bf2-b6209e7c9b56",
                        "source_sense_description": "geeft in het tweede gedeelte meer specifiek aan wat er bedoeld wordt",
                        "target_lang_word": "immerhin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "immerhin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29a3e705-2a94-3414-802f-817beb1ed993",
                                        "entry_id": "56b38e41-248c-35fd-9f50-24a18c15d473",
                                        "glosses": [
                                            "dessen ungeachtet, trotzdem"
                                        ],
                                        "tags": [
                                            "konzessiv",
                                            "weist auf Tatsachen hin",
                                            "die dennoch bestehen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64ff149d-7429-473c-82bd-70dc692510fd",
                                                "sense_id": "29a3e705-2a94-3414-802f-817beb1ed993",
                                                "text": "Klaus macht seine Sache immerhin, die Kritik der anderen kümmert ihn nicht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9cdd3ab6-281d-3b28-a775-e15b35f9087a",
                                        "entry_id": "56b38e41-248c-35fd-9f50-24a18c15d473",
                                        "glosses": [
                                            "zumindest, jedenfalls"
                                        ],
                                        "tags": [
                                            "konzessiv",
                                            "weist auf Tatsachen hin",
                                            "die trotz der Verhältnisse bemerkenswert sind"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37bdea84-d890-424b-bb6a-7c122e72c268",
                                                "sense_id": "9cdd3ab6-281d-3b28-a775-e15b35f9087a",
                                                "text": "„Immerhin fiel inmitten des weltweit verbreiteten Schwachsinns ein kritischer Nebenton auf.“"
                                            },
                                            {
                                                "example_id": "a0b2025a-8549-4bb5-b49b-b6a8d6ad5187",
                                                "sense_id": "9cdd3ab6-281d-3b28-a775-e15b35f9087a",
                                                "text": "Immerhin war der Laden sehr günstig, wenn das Essen schon mittelmäßig war."
                                            },
                                            {
                                                "example_id": "22cb69a1-d5f7-4bba-8427-7aa4b1b9d219",
                                                "sense_id": "9cdd3ab6-281d-3b28-a775-e15b35f9087a",
                                                "text": "Bei neueren Umfragen bestätigen immerhin ein Viertel der Hundehalter, den Hund ins Bett zu lassen bzw. ihn dorthin auch des Nachts mitzunehmen."
                                            },
                                            {
                                                "example_id": "7b26921c-47f0-4540-9c3e-1309df2a3197",
                                                "sense_id": "9cdd3ab6-281d-3b28-a775-e15b35f9087a",
                                                "text": "„Natürlich erhoffe ich mir von meinem Wutausbruch, dass die Vorgesetzten an mögliche Folgen für ihre Laufbahn denken, falls die Berichterstattung allzu negativ ausfällt, aber am Ende ist es wohl mehr Mitleid, warum sich ein Biologe seufzend bereiterklärt, uns immerhin an den Rand des Sperrbezirks zu führen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "720f1aaf-2bb0-3c1f-8a41-b5bec45c9e0a",
                                        "entry_id": "56b38e41-248c-35fd-9f50-24a18c15d473",
                                        "glosses": [
                                            "schließlich, jedenfalls"
                                        ],
                                        "tags": [
                                            "konzessiv",
                                            "erläuternd oder erinnernd"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fd204c8-0ac4-4d5e-ab2d-b9b73642d7ef",
                                                "sense_id": "720f1aaf-2bb0-3c1f-8a41-b5bec45c9e0a",
                                                "text": "Ist er nicht immerhin ganze zehn Jahre in der Firma?"
                                            },
                                            {
                                                "example_id": "7ced1055-6f41-4b23-9281-fe0f5e635e8e",
                                                "sense_id": "720f1aaf-2bb0-3c1f-8a41-b5bec45c9e0a",
                                                "text": "„Durch ein Praktikum hätte ich immerhin schon einmal einen Einblick in den Parlamentsalltag erhalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "7c2e3fab-6508-3945-976e-cc9c4bd244d5",
                                        "entry_id": "56b38e41-248c-35fd-9f50-24a18c15d473",
                                        "glosses": [
                                            "auch"
                                        ],
                                        "tags": [
                                            "im Konzessivsatz"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cdd057c8-6375-4c2f-974a-f404a6313db3",
                                                "sense_id": "7c2e3fab-6508-3945-976e-cc9c4bd244d5",
                                                "text": "Mögen die einzelnen Werke immerhin Fragmente bleiben, wenn sie nur in ihrer Vereinigung ein Ganzes bilden."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79902076-f206-4d63-9e87-db9fbc35f7ce",
