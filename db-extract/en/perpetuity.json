    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "2a9f6178-c569-3181-9602-ca0bc4e45520",
                "word": "perpetuity",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f64adacb-aae6-4b77-b936-41b107b38600",
                        "entry_id": "2a9f6178-c569-3181-9602-ca0bc4e45520",
                        "tags": [
                            "plural"
                        ],
                        "form": "perpetuities"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "60f180a2-b737-3eab-9556-6e23047ae2c3",
                        "entry_id": "2a9f6178-c569-3181-9602-ca0bc4e45520",
                        "glosses": [
                            "The quality or state of being perpetual; endless duration; uninterrupted existence."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "49731d25-0bcf-473a-97b9-f558767fe4a2",
                                "sense_id": "60f180a2-b737-3eab-9556-6e23047ae2c3",
                                "text": "Mr. Waller adds that when the railway was authorised in 1897, one of the clauses of the Act authorising the transfer of the line to the North British Railway provided that that company should work it in perpetuity, and it was this clause that caused the interim interdict to be granted."
                            },
                            {
                                "example_id": "05a390d7-811d-4434-974e-b5880855285e",
                                "sense_id": "60f180a2-b737-3eab-9556-6e23047ae2c3",
                                "text": "The gnomic belief that the world is conditioned by love is no idle apothegm. Love, as the instrument of creative agencies and cosmic perpetuity, is no banausic conception."
                            }
                        ]
                    },
                    {
                        "sense_id": "20968b48-5949-37db-ac95-b24bdbf5ad6f",
                        "entry_id": "2a9f6178-c569-3181-9602-ca0bc4e45520",
                        "glosses": [
                            "Something that is perpetual."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "aaed91d2-bb62-3722-a047-fe80f8d6e371",
                        "entry_id": "2a9f6178-c569-3181-9602-ca0bc4e45520",
                        "glosses": [
                            "A limitation intended to be unalterable and of indefinite duration; a disposition of property which attempts to make it inalienable beyond certain limits fixed or conceived as being fixed by the general law."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "aa592d82-5e0d-3369-a18c-86aac2d542f6",
                        "entry_id": "2a9f6178-c569-3181-9602-ca0bc4e45520",
                        "glosses": [
                            "An annuity in which the periodic payments begin on a fixed date and continue indefinitely."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3941b6fd-88f9-4274-96c9-ccd35243aa4d",
                        "source_entry_id": "2a9f6178-c569-3181-9602-ca0bc4e45520",
                        "source_sense_description": "the quality or state of being perpetual",
                        "target_lang_word": "perpétuité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perpétuité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a44b576a-d88f-331f-a33c-16c1e2ec93c1",
                                        "entry_id": "b7219ae3-18c1-39ac-89cc-b9cc8977d8d4",
                                        "glosses": [
                                            "Durée sans interruption, sans discontinuité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3962fc7-9174-4768-bd07-fb16b57e8f4b",
                                                "sense_id": "a44b576a-d88f-331f-a33c-16c1e2ec93c1",
                                                "text": "Il allègue pour sa défense l’ancienneté et la perpétuité de la possession."
                                            },
                                            {
                                                "example_id": "4c7f7ec5-5d5a-42ad-8616-87dd8fa3c198",
                                                "sense_id": "a44b576a-d88f-331f-a33c-16c1e2ec93c1",
                                                "text": "Une peine de prison à perpétuité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fc91855-1750-3eda-9c55-bd39b9ccdfb9",
                                        "entry_id": "b7219ae3-18c1-39ac-89cc-b9cc8977d8d4",
                                        "glosses": [
                                            "Condamnation à la prison jusqu'à la fin de la vie."
                                        ],
                                        "tags": [
                                            "ellipsis",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24624709-b7d9-477f-a7d9-97fb105ac821",
                                                "sense_id": "7fc91855-1750-3eda-9c55-bd39b9ccdfb9",
                                                "text": "Pour ce crime il a eu la perpétuité."
                                            },
                                            {
                                                "example_id": "1fb5aaac-e774-4afe-9755-db40cc75dab9",
                                                "sense_id": "7fc91855-1750-3eda-9c55-bd39b9ccdfb9",
                                                "text": "L’ennui, c’est que, selon toute vraisemblance, on fit miroiter aux yeux de ce porte-flingue condamné à perpétuité par contumace la perspective d’un allègement du châtiment…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b5b9583-d745-38f5-bc7f-85d6ef0547eb",
                                        "entry_id": "b7219ae3-18c1-39ac-89cc-b9cc8977d8d4",
                                        "glosses": [
                                            "Prisonnier à vie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "82cc79b7-483f-4785-9929-8db264c53d9a",
                                                "sense_id": "0b5b9583-d745-38f5-bc7f-85d6ef0547eb",
                                                "text": "Les « perpétuités » de Clairvaux réclament le rétablissement effectif de la peine de mort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5b55e39-bc80-3be8-bd78-125e37b20584",
                                        "entry_id": "b7219ae3-18c1-39ac-89cc-b9cc8977d8d4",
                                        "glosses": [
                                            "Condamnation à la prison pour une durée d'une dizaine d’années."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7784cef-bb82-4e2f-b311-a6085c4263c7",
                                                "sense_id": "c5b55e39-bc80-3be8-bd78-125e37b20584",
                                                "text": "Il sera bientôt sorti de prison : il n’a été condamné qu’à perpétuité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
