                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d1761c6-99f5-4a36-92cb-4f51bd455005",
                                "sense_id": "aaefc38c-b36a-3608-afca-01def8e0ea20",
                                "text": "„Die kommen dann auf das wunderschöne Mohnfeld, das zwischen unserer Doppelstadt schon in weiter Ferne leuchtet. Nie habe ich ein schöneres und größeres Mohnfeld gesehen.“"
                            },
                            {
                                "example_id": "11b440f1-5544-4e43-98b9-ca0597c9c482",
                                "sense_id": "aaefc38c-b36a-3608-afca-01def8e0ea20",
                                "text": "„Auch jenes neben dem Vulkan-Motiv am häufigsten wiederkehrende Bild ist eines, das von Rausch spricht: das rotblühende Mohnfeld, das mit dem ‚rotglühenden Vesuv‘ korrespondiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
