                "senses": [
                    {
                        "sense_id": "cfd9e2a9-6995-3c16-9739-24526342783d",
                        "entry_id": "144ea53f-941b-35cd-9777-bae954e75930",
                        "glosses": [
                            "Anwendung für Smartphones oder Smartwatches (App), die der Unterstützung, Organisation oder Dokumentation von sportlichen Aktivitäten dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45d192b1-6ac3-4518-8171-d3bf2e05c1ac",
                                "sense_id": "cfd9e2a9-6995-3c16-9739-24526342783d",
                                "text": "„Die Halterung für das Smartphone bietet sich nicht nur für die Nutzung der Sportapp an, sondern ermöglicht zusätzlich weitere Unterhaltung, die vor allem bei einem ruhigeren Training schnell vorgenommen werden kann.“"
                            },
                            {
                                "example_id": "ba4ba861-f010-4782-9e32-e0cf6265abd6",
                                "sense_id": "cfd9e2a9-6995-3c16-9739-24526342783d",
                                "text": "„Es hatte gut getan, den Körper einfach mal ein bisschen in Ruhe zu lassen – doch jetzt zeigte meine Sportapp ‚100 Tage bis Boston‘ an – höchste Zeit um wieder strukturiert loszulegen.“"
                            },
                            {
                                "example_id": "d70fbcc4-5b97-4fec-81f0-7aed37b0d97b",
                                "sense_id": "cfd9e2a9-6995-3c16-9739-24526342783d",
                                "text": "„Sollte jemand noch keine Sportapp nutzen, können wir Strava empfehlen.“"
                            },
                            {
                                "example_id": "26e2fee6-5a58-40dc-bd46-367f235f8600",
                                "sense_id": "cfd9e2a9-6995-3c16-9739-24526342783d",
                                "text": "„Zwift ist die weltweit bekannte und äußerst beliebte Sportapp für das Radtraining und das Lauftraining zu Hause.“"
                            },
                            {
                                "example_id": "e7da9d3b-54cc-4805-a713-50a4eee29b69",
                                "sense_id": "cfd9e2a9-6995-3c16-9739-24526342783d",
                                "text": "„Dank einer Sportapp am Smartphone hab ich den genauen Überblick – und die Statistik besagt, dass ich im März 23 sportliche Aktivitäten hinter mir habe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
