                "senses": [
                    {
                        "sense_id": "299e5bdd-055f-3991-be1b-8d60edfca4dc",
                        "entry_id": "62aebe4b-0efc-3e26-9359-42e4388b29aa",
                        "glosses": [
                            "Konsonant, bei dem der Luftstrom bei geschlossenem Mund durch die Nase entweicht"
                        ],
                        "tags": [
                            "speziell Phonetik"
                        ],
                        "examples": [
                            {
                                "example_id": "a5b53ac2-d23c-4fb3-b1e1-47787dca8ba1",
                                "sense_id": "299e5bdd-055f-3991-be1b-8d60edfca4dc",
                                "text": "Die deutschen Nasalkonsonanten sind: [m], [n] und [ŋ] (wie in \"sang\" [zaŋ])."
                            },
                            {
                                "example_id": "7075be96-d27f-4392-b7aa-5548946a8e74",
                                "sense_id": "299e5bdd-055f-3991-be1b-8d60edfca4dc",
                                "text": "„Nach den Nasalkonsonanten [m], [n] und [ŋ] sowie nach [l], [r] und [j] wird also [ən] gesprochen.“"
                            },
                            {
                                "example_id": "85c8a6af-ef78-418e-8c46-46b2c4f30097",
                                "sense_id": "299e5bdd-055f-3991-be1b-8d60edfca4dc",
                                "text": "„In der Reihe der Nasalkonsonanten unterscheidet sich das [ŋ] wegen seiner Distribution deutlich von [m] und [n].“"
                            },
                            {
                                "example_id": "d6cec2ae-2690-4ea5-bae7-ef6fd82477fc",
                                "sense_id": "299e5bdd-055f-3991-be1b-8d60edfca4dc",
                                "text": "„Im Englischen werden Vokale vor Nasalkonsonanten nasaliert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
