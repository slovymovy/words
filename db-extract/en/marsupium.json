                                    {
                                        "sense_id": "78b19e43-1dea-3c80-8d95-8b76d3acaa15",
                                        "entry_id": "e269dd60-d5e6-3929-a4bf-400d4a0df463",
                                        "glosses": [
                                            "Poche ventrale surtout des marsupiaux dans laquelle le jeune s’abrite et s’allaite pour se développer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50c82296-85c4-4be6-a85b-0907648026f3",
                                                "sense_id": "78b19e43-1dea-3c80-8d95-8b76d3acaa15",
                                                "text": "Dans les salles de restaurant des porcs-épics proposaient leur cure-dents, et les kangourous portaient les dépêches dans leur poche ventrale (ou marsupium)."
                                            },
                                            {
                                                "example_id": "097600ef-26f4-4bd3-aa29-c16411b7b9a6",
                                                "sense_id": "78b19e43-1dea-3c80-8d95-8b76d3acaa15",
                                                "text": "Ordre des Marsupiaux. Présence d’une poche ventrale ou marsupium soutenue par les deux os prépubis ou marsupiaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "037776b4-94c1-4e0c-97be-1a4ce05c9f94",
                        "source_entry_id": "ec98fae5-224b-372b-a858-7fabdd70f830",
                        "source_sense_description": "pouch of a marsupial",
                        "target_lang_word": "Beutel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beutel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f5b0d9ac-b4c4-32de-95ea-f141acc73915",
                                        "entry_id": "a23326ee-6386-3c39-953f-69f2bcb146f4",
                                        "glosses": [
                                            "elastischer Behälter, in den man etwas hineinpacken kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61c29f86-e1aa-4492-af51-e599bd5fb5ce",
                                                "sense_id": "f5b0d9ac-b4c4-32de-95ea-f141acc73915",
                                                "text": "Der Beutel ist ziemlich voll."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dce272cf-77b9-3c86-905c-c372a9aeec52",
                                        "entry_id": "a23326ee-6386-3c39-953f-69f2bcb146f4",
                                        "glosses": [
                                            "Geldbeutel"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bf58918-8ac8-4465-bb17-f36f0fe0d6bc",
                                                "sense_id": "dce272cf-77b9-3c86-905c-c372a9aeec52",
                                                "text": "Wenn ich ihm diese Uhr zum Geburtstag schenke, muss ich aber tief in den Beutel greifen."
                                            },
                                            {
                                                "example_id": "87b30805-8c53-4702-bc25-70f2b5029f9d",
                                                "sense_id": "dce272cf-77b9-3c86-905c-c372a9aeec52",
                                                "text": "„Und die hohlen Köpfe waren stets bereit, die Gettos zu stürmen und Juden totzuschlagen, wenn eine Teuerung den Beutel leerte und der Hunger den Magen knurren ließ.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5dbd923b-bd4f-3743-91d2-122a090c0852",
                                        "entry_id": "a23326ee-6386-3c39-953f-69f2bcb146f4",
                                        "glosses": [
                                            "Hautfalte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5cdc744-740a-49e3-ac0c-10dc893c6695",
                                                "sense_id": "5dbd923b-bd4f-3743-91d2-122a090c0852",
                                                "text": "Das Känguru trägt sein Junges im Beutel."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
