                "translations": [
                    {
                        "translation_id": "8f204653-f122-417d-90a0-db8f236399df",
                        "source_entry_id": "e3614d97-70c4-3084-a70b-33e0de4b6865",
                        "source_sense_id": "2d475a7e-2544-32a5-9998-2cfdd711f3ea",
                        "source_sense_description": "spelwoord voor de letter m",
                        "target_lang_word": "Martha",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f2a7910c-40b7-484b-930b-98b2d42fd375",
                        "source_entry_id": "e3614d97-70c4-3084-a70b-33e0de4b6865",
                        "source_sense_id": "2d475a7e-2544-32a5-9998-2cfdd711f3ea",
                        "source_sense_description": "spelwoord voor de letter m",
                        "target_lang_word": "Mary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52b10ce9-b7af-3edc-88ce-3bc6f6f2a8cc",
                                        "entry_id": "9706b674-7a60-366b-8548-2c60e0662258",
                                        "glosses": [
                                            "A female given name from Aramaic or Hebrew."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a63d0d5-ccdf-436f-a382-3104f7e8d96f",
                                                "sense_id": "52b10ce9-b7af-3edc-88ce-3bc6f6f2a8cc",
                                                "text": "I have a passion for the name of Mary,\nFor once it was a magic sound to me:\nAnd still it half calls up the realm of fairy\nWhere I beheld what never was to be."
                                            },
                                            {
                                                "example_id": "ec661140-2aa4-481e-a28f-c32ec46ab21a",
                                                "sense_id": "52b10ce9-b7af-3edc-88ce-3bc6f6f2a8cc",
                                                "text": "Mary, which is as common as a white violet, and like that has something indestructibly sweet and simple, and fit for all wear, high or low, suits the cottage or the palace, the garden or the field, the pretty and the ugly, the old and the young;"
                                            },
                                            {
                                                "example_id": "90343c74-2df8-4c5b-b291-597fd1bd67cf",
                                                "sense_id": "52b10ce9-b7af-3edc-88ce-3bc6f6f2a8cc",
                                                "text": "For it was Mary; Mary / Plain as any name can be / But with propriety, society / Will say \"Marie\". / But it was Mary; Mary / Long before the fashions came / And there's something there that sounds so square / It's a grand old name."
                                            },
                                            {
                                                "example_id": "9938f671-e687-4134-8c09-945cc9c00087",
                                                "sense_id": "52b10ce9-b7af-3edc-88ce-3bc6f6f2a8cc",
                                                "text": "They had called their children Ann, Mary, and John as a reaction against their own fancy tricksy names. Both mothers thought these names sadly unimaginative and each blamed the child of the other for the lack of vision and style."
                                            },
                                            {
                                                "example_id": "19823f4b-d41d-49bc-b8a0-b40d85badd18",
                                                "sense_id": "52b10ce9-b7af-3edc-88ce-3bc6f6f2a8cc",
                                                "text": "For the last decade at least, the trend seems to be that more untraditional names are being chosen over the Bobs, the Toms, the Sues and the Marys."
                                            },
                                            {
                                                "example_id": "c95f1b9e-dfe6-4d5b-aea3-5f4d852db85e",
                                                "sense_id": "52b10ce9-b7af-3edc-88ce-3bc6f6f2a8cc",
                                                "text": "Life on Martha’s Vineyard has been mostly ideal for 11-year-old Mary Elizabeth Lambert, the protagonist of Ann Clare LeZotte’s historical novel SHOW ME A SIGN (Scholastic, 288 pp., $18.99; ages 8 to 12)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af0d5d86-397d-3c95-9f56-0e6ee1962b49",
                                        "entry_id": "9706b674-7a60-366b-8548-2c60e0662258",
                                        "glosses": [
                                            "The mother of Jesus, believed in Christianity and Islam to have been a virgin at his birth, and believed by some Christians to have been born herself without sin, to have ascended to Heaven without death, and to act as a sympathetic intermediary for believers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa242e98-25a8-4fe8-b0bf-935a8cf582d0",
                                                "sense_id": "af0d5d86-397d-3c95-9f56-0e6ee1962b49",
                                                "text": "Now the birth of Jeſus Chriſt was on this wiſe: When as his mother Mary was eſpouſed to Joſeph (before they came together) ſhee was found with childe of the holy Ghoſt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dde3ab90-5ae9-350c-94a6-352553d5a3c5",
                                        "entry_id": "9706b674-7a60-366b-8548-2c60e0662258",
                                        "glosses": [
                                            "Any of several other women in the New Testament, notably:",
                                            "Mary Magdalene, a disciple of Jesus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0e36b22b-7a57-30dc-bd0d-ae3aeb967980",
                                        "entry_id": "9706b674-7a60-366b-8548-2c60e0662258",
                                        "glosses": [
                                            "Any of several other women in the New Testament, notably:",
                                            "Mary of Bethany, the sister of Lazarus and Martha."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed40f9f9-2a07-41d3-9c6d-63018610ae2b",
                                                "sense_id": "0e36b22b-7a57-30dc-bd0d-ae3aeb967980",
                                                "text": "And Jeſus anſwered, and ſaide vnto her, Martha, Martha, thou art carefull, and troubled about many things: But one thing is needefull, and Mary hath choſen that good part, which ſhall not bee taken away from her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06ab28dc-ca9c-3c98-aa7e-6b16352d2fc1",
                                        "entry_id": "9706b674-7a60-366b-8548-2c60e0662258",
                                        "glosses": [
                                            "The 19th sura (chapter) of the Qur'an, recounting the events leading up to the birth of Jesus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a090af38-e526-3f00-bd76-ebc8898b8005",
                                        "entry_id": "9706b674-7a60-366b-8548-2c60e0662258",
                                        "glosses": [
                                            "A term of address for a male homosexual."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df5332f4-2bf1-409b-b76f-573e11386f57",
                                                "sense_id": "a090af38-e526-3f00-bd76-ebc8898b8005",
                                                "text": "Note also that male homosexuals will call most anyone Bessie or Mary, e.g. ‘Oh, Bessie, you're a camp!’"
                                            },
                                            {
                                                "example_id": "348ad0d0-eea5-49d7-b0fd-eea5608248e0",
                                                "sense_id": "a090af38-e526-3f00-bd76-ebc8898b8005",
                                                "text": "In America in the 1950s,... Mary was often used in the vocative to address any fellow homosexual (‘Well, Mary...’)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5ad946b-e84e-31a1-bd30-43d07c8de1e2",
                                        "entry_id": "9706b674-7a60-366b-8548-2c60e0662258",
                                        "glosses": [
                                            "A male middle name, given in honour of the Virgin Mary."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
