    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ef3c1a89-513d-399e-a8e1-f0a03e6f6465",
                    "sense_definition": "Qui est présent dès la naissance, déterminé par la nature et non acquis par l'expérience ou l'apprentissage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "naturel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle possède un talent <w>inné</w> pour la musique qu'elle pratique depuis son enfance."
                        },
                        {
                            "text": "Son sens <w>inné</w> de la négociation lui a permis de résoudre ce conflit délicat."
                        }
                    ],
                    "synonyms": [
                        "congénital",
                        "héréditaire",
                        "naturel"
                    ],
                    "antonyms": [
                        "acquis"
                    ],
                    "common_phrases": [
                        "talent inné",
                        "sens inné"
                    ]
                },
                {
                    "sense_id": "56a27fee-1bbf-3c19-96cf-c2b6262f913e",
                    "sense_definition": "En philosophie, qui appartient naturellement à l'esprit humain et ne provient pas de l'expérience sensible.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "philosophie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Selon ce penseur, certaines idées <w>innées</w> guident l'esprit indépendamment de toute expérience sensible."
                        },
                        {
                            "text": "Il soutient que la notion de justice est <w>innée</w> et partagée par tous les êtres humains."
                        }
                    ],
                    "antonyms": [
                        "acquis"
                    ],
                    "common_phrases": [
                        "idées innées",
                        "notions innées"
                    ]
                },
                {
                    "sense_id": "ae442441-07a1-3179-9c65-b9a42dc34331",
                    "sense_definition": "En mycologie et botanique, qui fait corps avec le tissu d'un organe sans faire de relief distinct.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce champignon rare se caractérise par des fibrilles <w>innées</w> bien visibles sur son chapeau."
                        },
                        {
                            "text": "Les squames <w>innées</w> de cette espèce ne peuvent pas être séparées de la cuticule."
                        }
                    ],
                    "common_phrases": [
                        "fibrilles innées"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "002d0ebb-1238-33c0-af87-1691073324e3",
                    "sense_definition": "Ce qui appartient à la nature propre d'un être dès sa naissance, par opposition à ce qui résulte de l'expérience.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "naturel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le débat éternel entre l'<w>inné</w> et l'acquis divise encore de nombreux spécialistes."
                        },
                        {
                            "text": "Dans sa théorie, le chercheur accorde une place prépondérante à l'<w>inné</w> dans le développement."
                        }
                    ],
                    "antonyms": [
                        "acquis"
                    ],
                    "common_phrases": [
                        "l'inné et l'acquis"
                    ]
                }
            ]
        }
    ]
