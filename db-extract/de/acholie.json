                ],
                "translations": [
                    {
                        "translation_id": "b375cfb2-7e11-43a3-ab5e-b14271e34857",
                        "source_entry_id": "f6427203-afa3-3d7a-a94c-40af7dc3604b",
                        "source_sense_id": "da48738d-0c83-35ec-bda7-b45c4860f788",
                        "source_sense_description": "Medizin: stark verminderte oder ganz aufgehobene Gallensekretion",
                        "target_lang_word": "acholia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acholia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "65326dcb-80e7-3f93-ab29-ca194c0dce14",
                                        "entry_id": "b8e7737c-d60a-3b22-8447-e54d42aee3f9",
                                        "glosses": [
                                            "Deficiency or absence of bile."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11e7362f-d3c7-41d1-95b7-8ad5f2c31fa5",
                                                "sense_id": "65326dcb-80e7-3f93-ab29-ca194c0dce14",
                                                "text": "The intensely bilious color of the liver shows that the discoloration of the contents of the intestines is not due to arrested production of bile, that is to acholia."
                                            },
                                            {
                                                "example_id": "c2303b02-4347-49d4-bf3f-f3aa3a47d9fd",
                                                "sense_id": "65326dcb-80e7-3f93-ab29-ca194c0dce14",
                                                "text": "This then illustrates acholia in the literal sense of the word, and explains the absence of icterus in spite of the complete obliteration of the ductus communis choledochus."
                                            },
                                            {
                                                "example_id": "4cd504d5-7f98-4517-b03b-ccdb4f3f6ff9",
                                                "sense_id": "65326dcb-80e7-3f93-ab29-ca194c0dce14",
                                                "text": "A 1-month 3-week-old infant with a history of neonatal jaundice, cholestasis, and acholia is admitted to our hospital to rule out biliary atresia and further treatment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67b6e8aa-8c52-482f-8970-3b9e0baa04a1",
                        "source_entry_id": "f6427203-afa3-3d7a-a94c-40af7dc3604b",
                        "source_sense_id": "da48738d-0c83-35ec-bda7-b45c4860f788",
                        "source_sense_description": "Medizin: stark verminderte oder ganz aufgehobene Gallensekretion",
                        "target_lang_word": "acholie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acholie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c1209c78-efda-3600-aed2-aa112d487a72",
                                        "entry_id": "61de123e-c2dd-34c5-a55f-a5092a97cbde",
                                        "glosses": [
                                            "Arrêt ou diminution notable de la sécrétion biliaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf78f4b3-a638-4ed0-8914-e23081cedc41",
                                                "sense_id": "c1209c78-efda-3600-aed2-aa112d487a72",
                                                "text": "Quand la bile est sécrétée en trop grande abondance, cet état se nomme polycholie. Le mot acholie désigne une disposition contraire, mais qui n’est pas moins nuisible à la conservation de la santé."
                                            },
                                            {
                                                "example_id": "83573a7f-5fc7-4dd9-a722-ccdd65e3f3b7",
                                                "sense_id": "c1209c78-efda-3600-aed2-aa112d487a72",
                                                "text": "L’acholie totale peut également survenir en cas d’hépatite, surtout au cours des premiers jours ou lors d’une récidive, et s’observe dans 1/5ème des cas."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "acholie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0438d422-b6a2-3831-8f72-cf7fee6b7275",
                                        "entry_id": "89c15639-56a4-325e-a866-683328b67cab",
                                        "glosses": [
                                            "Féminin de acholi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2e2764e-ab45-4f16-a874-a2ee89f971c4",
                                                "sense_id": "0438d422-b6a2-3831-8f72-cf7fee6b7275",
                                                "text": "Le mouvement, ancré à l’origine au sein de la population acholie, dans le nord de l’Ouganda, et opposé au pouvoir du président Museveni lors de sa création à la fin des années 1980, s’est mué en groupe armé aux objectifs flous, luttant pour sa survie en massacrant les villageois des régions qu’ils traversent, ou en les transformant en esclaves."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
