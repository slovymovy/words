                        "glosses": [
                            "Dans la musique tonale à tempérament égal, équivalence de deux notes appelées différemment mais produisant le même son."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2865975d-3255-427c-98fb-fa5c3fbaa478",
                                "sense_id": "6d5e6a90-a44d-3317-95a5-e2c96dedd6ae",
                                "text": "Ce maître fit un usage fréquent de l’enharmonie dans les récitatifs, afin d'en varier les formes et rompre ainsi leur tendance à la monotonie."
                            }
                        ]
                    }
                ],
