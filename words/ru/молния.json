                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "предметы",
                    "name_type": "brand_or_product_name",
                    "examples": [
                        {
                            "text": "Дед подарил мне карманные часы <w>Молния</w>.",
                            "target_lang_translations": {
                                "en": "My grandfather gave me a <w>Molniya</w> pocket watch."
                            }
