{
    "word_family": [
        "видеть",
        "вид",
        "видение",
        "видавший",
        "видавший"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4fda1adb-c808-3108-9a1c-85f5e3050546",
                    "sense_definition": "Воспринимаемый глазом, доступный зрению.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В ясную погоду отсюда открывается <w>видимый</w> горизонт.",
                            "target_lang_translations": {
                                "en": "In clear weather, the <w>visible</w> horizon opens up from here."
                            }
                        },
                        {
                            "text": "Звезды — это <w>видимый</w> свет далеких миров.",
                            "target_lang_translations": {
                                "en": "Stars are the <w>visible</w> light of distant worlds."
                            }
                        }
                    ],
                    "antonyms": [
                        "невидимый"
                    ],
                    "common_phrases": [
                        "видимый горизонт",
                        "видимый мир"
                    ],
                    "target_lang_definitions": {
                        "en": "Perceptible by the eye; capable of being seen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "visible",
                                "target_lang_sense_clarification": "Able to be seen by the eye."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58aa2d5a-7c8c-397c-ab3c-49754602c666",
                    "sense_definition": "Очевидный, явный, заметный для всех.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "clarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У этого плана нет никакой <w>видимой</w> причины для провала.",
                            "target_lang_translations": {
                                "en": "This plan has no <w>apparent</w> reason for failure."
                            }
                        },
                        {
                            "text": "Мы обсудили все <w>видимые</w> недостатки нового проекта.",
                            "target_lang_translations": {
                                "en": "We discussed all the <w>evident</w> flaws of the new project."
                            }
                        }
                    ],
                    "synonyms": [
                        "очевидный",
                        "явный"
                    ],
                    "common_phrases": [
                        "видимая причина",
                        "видимые недостатки"
                    ],
                    "target_lang_definitions": {
                        "en": "Obvious, clear, or noticeable to everyone."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "evident",
                                "target_lang_sense_clarification": "Clearly seen or understood; obvious."
                            },
                            {
                                "target_lang_word": "apparent",
                                "target_lang_sense_clarification": "Clearly visible or understood; plain."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a4c652d-b75f-3d59-9f22-d7f4398e5417",
                    "sense_definition": "Кажущийся, внешний, не всегда соответствующий действительности.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Его <w>видимая</w> веселость не могла скрыть глубокую печаль.",
                            "target_lang_translations": {
                                "en": "His <w>apparent</w> cheerfulness could not hide his deep sadness."
                            }
                        },
                        {
                            "text": "За <w>видимым</w> спокойствием скрывалась сильная тревога.",
                            "target_lang_translations": {
                                "en": "Behind the <w>apparent</w> calm, a strong anxiety was hidden."
                            }
                        }
                    ],
                    "synonyms": [
                        "кажущийся",
                        "внешний",
                        "обманчивый"
                    ],
                    "common_phrases": [
                        "видимое спокойствие"
                    ],
                    "target_lang_definitions": {
                        "en": "Seeming or external, not necessarily corresponding to reality."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "apparent",
                                "target_lang_sense_clarification": "Seeming real or true, but possibly not so."
                            },
                            {
                                "target_lang_word": "ostensible",
                                "target_lang_sense_clarification": "Stated or appearing to be true, but often hiding a different reality."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e164225b-cf3c-388d-95ea-d1bd38129ebc",
                    "sense_definition": "Страдательное причастие настоящего времени от глагола <w>видеть</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Войска, <w>видимые</w> с вершины холма, казались бесконечными.",
                            "target_lang_translations": {
                                "en": "The troops, <w>seen</w> from the top of the hill, seemed endless."
                            }
                        },
                        {
                            "text": "Его домашняя жизнь была мало кому <w>видима</w>.",
                            "target_lang_translations": {
                                "en": "His home life was <w>seen</w> by very few people."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Passive participle of the verb 'to see'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "seen",
                                "target_lang_sense_clarification": "Past participle of 'see', used to describe something that has been viewed."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "46398fc2-ee33-354a-8bd7-60eb27c74b72",
                    "sense_definition": "Причастие настоящего времени от глагола <w>видеть</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это объект, <w>видимый</w> нами в телескоп.",
                            "target_lang_translations": {
                                "en": "This is an object <w>visible</w> to us through a telescope."
                            }
                        },
                        {
                            "text": "Процесс, <w>видимый</w> невооруженным глазом, очень интересен.",
                            "target_lang_translations": {
                                "en": "The process, <w>visible</w> to the naked eye, is very interesting."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Present participle/adjective form of the verb 'to see'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "visible",
                                "target_lang_sense_clarification": "Capable of being seen in a specific context."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}