                ],
                "translations": [
                    {
                        "translation_id": "d00e248d-8d15-4e26-b738-6c9a0832517e",
                        "source_entry_id": "86b03166-cae5-362d-8f72-b07158dff9ae",
                        "source_sense_id": "971a502c-6807-329b-8846-d3d2e3b7c44e",
                        "target_lang_word": "pelmeni",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pelmeni",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b52b5d3-593f-3474-a84d-a3352f769811",
                                        "entry_id": "14e2b83b-77a0-37e7-8828-264c074d45b9",
                                        "glosses": [
                                            "Russian dumplings resembling ravioli."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3de01775-b31f-4b7f-b954-78301fad5774",
                                                "sense_id": "8b52b5d3-593f-3474-a84d-a3352f769811",
                                                "text": "The dish most closely associated with Siberia is pelmeni, meat-filled dumplings. In Siberia, pelmeni are traditionally filled with horse meat and are served with vinegar."
                                            },
                                            {
                                                "example_id": "295b0efb-60cc-44c6-9597-91488876ac05",
                                                "sense_id": "8b52b5d3-593f-3474-a84d-a3352f769811",
                                                "text": "My favorite dish was a wonderful broth with pelmeni, Siberian dumplings filled with seasoned chopped meat."
                                            },
                                            {
                                                "example_id": "e7566db7-d758-4131-bb55-03732af5c9bf",
                                                "sense_id": "8b52b5d3-593f-3474-a84d-a3352f769811",
                                                "text": "\"This is pelmeni — Siberian dumplings,\" he said, \"And you better get used to it, because you're going to be eating a lot of it while you're here.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55b31c38-fccb-4ee8-b3d2-4a9834e7a493",
                        "source_entry_id": "86b03166-cae5-362d-8f72-b07158dff9ae",
                        "source_sense_id": "971a502c-6807-329b-8846-d3d2e3b7c44e",
                        "target_lang_word": "пельмень",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пельмень",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "eb1fcbd5-61b3-3a7b-9027-c0f73f7ed2c2",
                                        "entry_id": "490cd7f8-2476-3258-ab3c-265d61a897e3",
                                        "glosses": [
                                            "кулин. кулинарное изделие в виде маленького вареника из пресного теста с мясной (иногда рыбной или овощной) начинкой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80a0751e-28c4-4eaf-82ae-dd945ff032fc",
                                                "sense_id": "eb1fcbd5-61b3-3a7b-9027-c0f73f7ed2c2",
                                                "text": "Дошкольник схватил тестяной кружочек, чайной ложкой положил начинки и мигом скрутил залихватский пельмень."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b14bc93-b966-30ef-85a7-c727e4ba61f6",
                                        "entry_id": "490cd7f8-2476-3258-ab3c-265d61a897e3",
                                        "glosses": [
                                            "кушанье из таких изделий, приготовляемое в процессе варки (иногда жарки)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78523d89-1b87-461e-8a32-4dc7081b9a94",
                                                "sense_id": "4b14bc93-b966-30ef-85a7-c727e4ba61f6",
                                                "text": "По возвращении на квартиру мы распорядились отварить пельмени и с большим аппетитом пообедали."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "пельмень",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fdbe208c-f730-3fb3-9eb3-a90700b14ad6",
                                        "entry_id": "2972b8c4-3d19-3fc2-a833-e0fd724ecfd1",
                                        "glosses": [
                                            "мол. толстый, неуклюжий человек"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "18194301-4cbc-3195-a65c-b538f5630be8",
                                        "entry_id": "2972b8c4-3d19-3fc2-a833-e0fd724ecfd1",
                                        "glosses": [
                                            "мол. несимпатичный, неприятный человек"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6b69a454-544a-3dc4-8722-8aeea978e3e4",
                                        "entry_id": "2972b8c4-3d19-3fc2-a833-e0fd724ecfd1",
                                        "glosses": [
                                            "мол., ирон. используется в качестве обращения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5540c51-5c8e-4552-b229-b0cde29d03f5",
                                                "sense_id": "6b69a454-544a-3dc4-8722-8aeea978e3e4",
                                                "text": "— Слышь, пельмень! Пошли сегодня пиво пить."
                                            },
                                            {
                                                "example_id": "220ed183-3c12-4d7f-aff3-d54f314f2aa3",
                                                "sense_id": "6b69a454-544a-3dc4-8722-8aeea978e3e4",
                                                "text": "— Делай отсюда ноги, пельмень!"
                                            }
                                        ]
                                    }
                                ]
