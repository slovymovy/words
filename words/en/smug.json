                    "sense_definition": "The smuggling trade.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many locals in the coastal village were secretly involved in the <w>smug</w>.",
                            "target_lang_translations": {
                                "tr": "Kıyı köyündeki birçok yerli gizlice <w>kaçakçılık</w> işine bulaşmıştı."
