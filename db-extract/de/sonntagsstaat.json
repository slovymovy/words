                ],
                "senses": [
                    {
                        "sense_id": "add8ef70-97fc-3c49-9ca9-f0bed3a877a7",
                        "entry_id": "857f2d77-6022-3f37-acc2-9f178bdf0794",
                        "glosses": [
                            "zu besonderen Anlässen getragene Kleidung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31705bdf-a408-4594-b9a4-29ae4251f2b8",
                                "sense_id": "add8ef70-97fc-3c49-9ca9-f0bed3a877a7",
                                "text": "„Nur wenige Menschen standen herum. Meist Bauern im Sonntagsstaat, die Besuch erwarteten oder ins Nachbardorf zu Verwandten fuhren.“"
                            },
                            {
                                "example_id": "89e0c97b-07bc-495c-9fc7-547667a5959a",
                                "sense_id": "add8ef70-97fc-3c49-9ca9-f0bed3a877a7",
                                "text": "„Die Musik liebt er ganz besonders. Unsicherer Gesang der Gruppe, die sich am Ufer aufgestellt hat, in ihren Sonntagsstaat gekleidet ist und vor Sonntagsfrömmigkeit friedfertig unter den Bäumen steht.“"
                            },
                            {
                                "example_id": "17e98efa-3f72-4964-8792-f52a9664f86e",
                                "sense_id": "add8ef70-97fc-3c49-9ca9-f0bed3a877a7",
                                "text": "„Fünf Betten mit einer Anzahl von Matratzen und Steppdecken, vielleicht noch einem Dutzend anderer Gäste zum Lager dienen zu können, füllten seine Räume, während an den Wänden die Garderobe der Frauen und, in einem ganz besondern Winkel, der Sonntagsstaat des Eheherrn hing.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
