                    },
                    {
                        "translation_id": "0b56b56c-5b38-4edb-9b7b-c8f05bc9475c",
                        "source_entry_id": "882092a8-091d-3121-9f79-908f34782888",
                        "source_sense_id": "81bc36ae-9466-3e69-9536-61d222442f0d",
                        "source_sense_description": "drager van informatie van de erfelijke eigenschappen",
                        "target_lang_word": "gene",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gene",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ccac9d8f-1f7e-3614-b1d2-845442886de7",
                                        "entry_id": "b72b1d9f-287e-3d2c-99c6-7c417aaf419c",
                                        "glosses": [
                                            "A theoretical unit of heredity of living organisms which may take several values and (in principle) predetermines a precise trait of an organism's form (phenotype), such as hair color."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61273c26-08b6-4b34-9261-76cb658fe67c",
                                                "sense_id": "ccac9d8f-1f7e-3614-b1d2-845442886de7",
                                                "text": "Near-synonym: cistron (often synonymous)"
                                            },
                                            {
                                                "example_id": "3da4937c-314b-484b-8bce-b95e894bd0df",
                                                "sense_id": "ccac9d8f-1f7e-3614-b1d2-845442886de7",
                                                "text": "The US supreme court has ruled unanimously that natural human genes cannot be patented, a decision that scientists and civil rights campaigners said removed a major barrier to patient care and medical innovation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1b49d64-dd0a-33aa-a0ad-6f50ac326d77",
                                        "entry_id": "b72b1d9f-287e-3d2c-99c6-7c417aaf419c",
                                        "glosses": [
                                            "A segment of DNA or RNA from a cell's or an organism's genome, that may take several forms and thus parameterizes a phenomenon, such as (often) the structure of a protein."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b3e16c3-6a71-4be8-a728-0c704e6cacb1",
                                                "sense_id": "c1b49d64-dd0a-33aa-a0ad-6f50ac326d77",
                                                "text": "Holonym: locus"
                                            },
                                            {
                                                "example_id": "47e0c2af-bbf1-4bfd-b89c-7f7d9c8b1b38",
                                                "sense_id": "c1b49d64-dd0a-33aa-a0ad-6f50ac326d77",
                                                "text": "A change in a gene is reflected in the protein or RNA molecule that it codes for."
                                            },
                                            {
                                                "example_id": "2bb3e6a6-e532-416d-adb4-42f17ecf11d5",
                                                "sense_id": "c1b49d64-dd0a-33aa-a0ad-6f50ac326d77",
                                                "text": "A length of DNA is divided into segments called chromosomes and shorter individual units called genes."
                                            },
                                            {
                                                "example_id": "3df2089f-ed47-43cd-a969-9106b3c0e283",
                                                "sense_id": "c1b49d64-dd0a-33aa-a0ad-6f50ac326d77",
                                                "text": "One way to define a gene (there are many, and they are not all equivalent) is as the bit of DNA that contains the information needed to make a specific protein or a functional RNA molecule."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aff35d7a-4092-4f8a-bbd0-402254e06897",
                        "source_entry_id": "882092a8-091d-3121-9f79-908f34782888",
                        "source_sense_id": "81bc36ae-9466-3e69-9536-61d222442f0d",
                        "source_sense_description": "drager van informatie van de erfelijke eigenschappen",
                        "target_lang_word": "gène",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dc7bdac6-3ac9-3ba8-9ba5-7c4868cd0fd7",
                                        "entry_id": "2d2bf300-41e0-3ebd-ad99-7e32a139316d",
                                        "glosses": [
                                            "Unité de base de l’information biologique qui se transmet de génération en génération."
                                        ],
                                        "tags": [
                                            "Génétique",
                                            "Biologie moléculaire",
                                            "Sciences de la vie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1684a2d1-faad-4c28-a96c-60df7b03263e",
                                                "sense_id": "dc7bdac6-3ac9-3ba8-9ba5-7c4868cd0fd7",
                                                "text": "Les géniteurs de résistance au froid : « Champagne » et « Austria Winter » renferment le plus grand nombre de gènes récessifs. Les pois d'hiver actuels en possèdent moins et les pois de printemps en sont pratiquement dépourvus."
                                            },
                                            {
                                                "example_id": "348720b9-688c-40d5-bad5-6d5eeace7eed",
                                                "sense_id": "dc7bdac6-3ac9-3ba8-9ba5-7c4868cd0fd7",
                                                "text": "La variation d’un seul acide aminé dans le gène qui code pour l’enzyme COMT, un médiateur qui métabolise la dopamine et la noradrénaline, produit une différence suffisamment importante dans cette enzyme pour modifier la résistance à la douleur et de là influer sur le courage d’une personne."
                                            },
                                            {
                                                "example_id": "9709df1c-d9f8-413f-aca8-7224c82b35dc",
                                                "sense_id": "dc7bdac6-3ac9-3ba8-9ba5-7c4868cd0fd7",
                                                "text": "Des erreurs lors de la réplication de l’ADN (mutations) ou des transferts de gènes s'accumulent à fréquence faible mais constante au cours du temps, ce qui augmente progressivement le polymorphisme au sein de chaque écotype."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gène",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0c1e7950-9729-38a0-850e-c612f9248751",
                                        "entry_id": "e0b22783-161b-3dd0-8817-9fe6a45e3a7f",
                                        "glosses": [
                                            "Marc de raisin."
                                        ],
                                        "tags": [
                                            "Bourgogne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7eb82af9-89e3-4bcf-b2e1-789accd37882",
                                                "sense_id": "0c1e7950-9729-38a0-850e-c612f9248751",
                                                "text": "Du Pays Beaujolais, le saucisson au gêne est, en effet, descendu à Lyon dans les \"bouchons\". Il n'y a pas si longtemps, au moment du vin nouveau, c'était un des plats principaux des \"casse-croûtes\" lyonnais."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
