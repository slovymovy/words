                    {
                        "translation_id": "853b65f2-2d96-4437-90bb-f7be23b73b18",
                        "source_entry_id": "9786f418-6b9f-37fd-bcce-3d8babe7f312",
                        "source_sense_id": "6c3055f3-0033-3039-9cb8-6cb36698e326",
                        "source_sense_description": "act of responding violently to an act of harm or perceived injustice",
                        "target_lang_word": "воздая́ние",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "воздая́ние",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6f30c7c1-8fd9-318f-8b2a-6b9fe421d28d",
                                        "entry_id": "48d0b509-00d8-3204-a364-de06420997fe",
                                        "glosses": [
                                            "действие по значению гл. воздать, воздаться"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20ac49b4-adf3-4e82-b9fb-1b0474e5c95e",
                                                "sense_id": "6f30c7c1-8fd9-318f-8b2a-6b9fe421d28d",
                                                "text": "Понятия кары, воздаяния, награды и справедливости проникли уже по-детски в их душу и отвлекали в сторону их сознание, давая жизни делать с ними то, что она считала нужным, веским и прекрасным."
                                            },
                                            {
                                                "example_id": "231c76d6-db58-493b-ae64-3fa3ff870c96",
                                                "sense_id": "6f30c7c1-8fd9-318f-8b2a-6b9fe421d28d",
                                                "text": "В более поздних религиях эта идея воздаяния за грехи, за неверие и непослушание получила дальнейшее развитие."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a07d471-43ef-3d83-8e4a-8576b28689a1",
                                        "entry_id": "48d0b509-00d8-3204-a364-de06420997fe",
                                        "glosses": [
                                            "то, что воздаётся кому-либо за что-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ec449b3-2b2e-484c-afb2-98a50784e560",
                                                "sense_id": "0a07d471-43ef-3d83-8e4a-8576b28689a1",
                                                "text": "Поутру проснувшись, увидели они пришедший корабль, и начальник оного, пришед к ним в обитание, просил от них помощи и показания дороги. Аскалон обещал ему сделать сию услугу, а в воздаяние за оную просил, чтобы он отвёз его на остров Млакон."
                                            },
                                            {
                                                "example_id": "872c2cf6-587f-4dfe-b6ea-29837954090c",
                                                "sense_id": "0a07d471-43ef-3d83-8e4a-8576b28689a1",
                                                "text": "Ещё бы похвальнее его поступок был, естли бы он не имел собственных своих видов, а делал бы сие для пользы отечества и в воздаяние за то, чем он должен Петру Великому, деду царствующего Государя."
                                            },
                                            {
                                                "example_id": "d21807cc-5d72-4d96-948e-70ecf55da2b3",
                                                "sense_id": "0a07d471-43ef-3d83-8e4a-8576b28689a1",
                                                "text": "Все сии договоры таковы, что заключают в себе взаимность; с одной стороны деяние, с другой воздаяние."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
