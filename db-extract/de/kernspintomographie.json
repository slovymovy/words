                "senses": [
                    {
                        "sense_id": "7568f806-f260-3212-b10c-6622bacd9c84",
                        "entry_id": "7057045c-b7d4-3e8b-86ba-1d9237031484",
                        "glosses": [
                            "Untersuchungsverfahren, mit dem durch Ausnutzung des sogenannten Kernspin Bilder vom Inneren des Körpers entstehen"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "3deb3362-7baf-4b50-ae0f-3468a69622d0",
                                "sense_id": "7568f806-f260-3212-b10c-6622bacd9c84",
                                "text": "„Die Kernspintomographie mißt die Anzahl der Wassermoleküle, die ein Gewebe enthält.“"
                            },
                            {
                                "example_id": "5a9f60e8-faa3-4faa-abc6-716dd4a80ecf",
                                "sense_id": "7568f806-f260-3212-b10c-6622bacd9c84",
                                "text": "„Als sie anschließend gefragt wurden, wie fair ihnen das jeweilige Szenario erschien, wurden die Aktivitäten in unterschiedlichen Gehirnregionen mithilfe der Kernspintomographie gemessen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b87eaed8-1072-3e5f-a0dc-0c58c693e023",
                        "entry_id": "7057045c-b7d4-3e8b-86ba-1d9237031484",
                        "glosses": [
                            "durch [1] angefertigte Aufnahme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad48c0db-08db-45df-a7b4-f69c2270d131",
                                "sense_id": "b87eaed8-1072-3e5f-a0dc-0c58c693e023",
                                "text": "Auf der Kernspintomographie kann man einen Hirntumor erkennen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
