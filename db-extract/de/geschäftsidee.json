                "senses": [
                    {
                        "sense_id": "1e69a81b-65d6-3296-8bad-034c85d8aecb",
                        "entry_id": "ca0815d0-78af-3aae-98b2-642128050476",
                        "glosses": [
                            "Einfall, Vorstellung, wie und womit ein Geschäft betrieben werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91e4da3e-7e45-4ff7-bc8d-f964b9e978d0",
                                "sense_id": "1e69a81b-65d6-3296-8bad-034c85d8aecb",
                                "text": "„Von diesen Erzählungen stark beeindruckt, glaubte ich beinahe, eine neue Geschäftsidee entwickeln zu können.“"
                            },
                            {
                                "example_id": "b0197779-2425-496f-849f-52c12e48542e",
                                "sense_id": "1e69a81b-65d6-3296-8bad-034c85d8aecb",
                                "text": "„Die digitale Verarbeitung von Informationen ermöglicht dem Traditionsunternehmen neue Geschäftsideen – im Kerngeschäft mit Druckmaschinen, aber auch darüber hinaus.“"
                            },
                            {
                                "example_id": "aa108d9b-8255-487d-a62e-c4c55759629e",
                                "sense_id": "1e69a81b-65d6-3296-8bad-034c85d8aecb",
                                "text": "„Neue Geschäftsideen konnten sie oft nicht verwirklichen, weil sich sofort die Angehörigen der Machtelite auf jede lukrative Bereicherungsmöglichkeit stürzten und sie sich mit Hilfe ihrer politischen Verbindungen aneigneten.“"
                            }
                        ],
