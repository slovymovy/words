                        "entry_id": "2c620125-bfa7-3e0a-bff0-d22d8b8bd03a",
                        "glosses": [
                            "The petty officers' mess steward."
                        ],
                        "tags": [
                            "UK",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "c6e27dad-6679-48ba-9c03-6a781859245d",
                                "sense_id": "e61db0fe-32e7-3afa-b341-c50a16e3a9d3",
                                "text": "Against this, her deck staff runs to about a hundred, being made up of some fifty able-seamen, eight or ten 'peggies' […]"
                            },
                            {
                                "example_id": "687fe5f9-175f-47af-9066-c4113af8621f",
                                "sense_id": "e61db0fe-32e7-3afa-b341-c50a16e3a9d3",
                                "text": "The number of \"peggies\" going aft to fetch the meals had been increasing steadily."
                            }
                        ]
                    }
