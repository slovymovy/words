                    {
                        "translation_id": "e50a1cc9-8321-4c63-87b8-a15796ebe006",
                        "source_entry_id": "2122eeb5-fb72-32a2-a4b9-df92c3c712a3",
                        "source_sense_id": "6c3b21ca-0bee-315e-89a8-93ce69844574",
                        "target_lang_word": "Getreide",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Getreide",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7de8e4cd-a7bb-3370-a3be-d6a6279e3ae1",
                                        "entry_id": "f8d5540c-9238-32d4-95e4-3914c50a66e9",
                                        "glosses": [
                                            "Grasart, die wegen ihrer essbaren Samenkörner angebaut wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74cab94c-9603-47e5-bc5c-f4371c0fabfa",
                                                "sense_id": "7de8e4cd-a7bb-3370-a3be-d6a6279e3ae1",
                                                "text": "Auf diesem Boden kann man gut Getreide anbauen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "09839f8f-a5aa-32a4-99a3-c7bbe181792a",
                                        "entry_id": "f8d5540c-9238-32d4-95e4-3914c50a66e9",
                                        "glosses": [
                                            "Samenkörner der unter [1] genannten Grasarten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0ec6564-51fb-41ab-9f93-356152eb9124",
                                                "sense_id": "09839f8f-a5aa-32a4-99a3-c7bbe181792a",
                                                "text": "Jedes Jahr wird weltweit mehr Getreide produziert."
                                            },
                                            {
                                                "example_id": "a3b077f0-322b-4d8a-a0a0-631f6791643a",
                                                "sense_id": "09839f8f-a5aa-32a4-99a3-c7bbe181792a",
                                                "text": "„Selbst der Steinbruch in der Eifel ist bekannt, aus dem der Mühlstein stammt, mit dem Legionäre in Hedemünden ihr Getreide mahlten.“"
                                            },
                                            {
                                                "example_id": "df36de22-5d30-4be9-a941-410b7eea26bb",
                                                "sense_id": "09839f8f-a5aa-32a4-99a3-c7bbe181792a",
                                                "text": "„Andere lassen ihre Tiere stundenlang über das auf einem runden Platz zusammengetragene Getreide trampeln, während sie das Stroh immer wieder mit der aus einer Astgabel geschnitzten Forke in die Luft werfen.“"
                                            },
                                            {
                                                "example_id": "cd7ba261-e2c9-4a56-bc9e-c83f88d16bd6",
                                                "sense_id": "09839f8f-a5aa-32a4-99a3-c7bbe181792a",
                                                "text": "„Die Mühle liegt etwas abseits von anderen Häusern an ihrem Mühlbach; auch sie ist ständig in Betrieb und wird mit Getreide versorgt.“"
                                            },
                                            {
                                                "example_id": "7eb5dca8-4b6c-40e5-adfa-0114d1e00d1c",
                                                "sense_id": "09839f8f-a5aa-32a4-99a3-c7bbe181792a",
                                                "text": "„Reis und Getreide füllten seine Speicher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
