                "senses": [
                    {
                        "sense_id": "13fdcb8d-ef1b-324c-91e1-0906055bf4f9",
                        "entry_id": "24f5846a-a30a-3104-a051-cfc9fc792341",
                        "glosses": [
                            "Veranstaltung zur Würdigung von Personen mit einem Preis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e701e99d-3435-483d-bdc7-d038c69adbb3",
                                "sense_id": "13fdcb8d-ef1b-324c-91e1-0906055bf4f9",
                                "text": "Die Preisverleihung des Oscars findet jährlich in Los Angeles statt."
                            },
                            {
                                "example_id": "bba4876e-0834-486f-8706-3487818eca2d",
                                "sense_id": "13fdcb8d-ef1b-324c-91e1-0906055bf4f9",
                                "text": "„Beide werden sich wohl nicht ohne weiteres auf eine, sagen wir mal, Reform der Preisverleihung einlassen.“"
                            },
                            {
                                "example_id": "8d65eeb2-2f32-45e7-a1d3-daf7a59f4b30",
                                "sense_id": "13fdcb8d-ef1b-324c-91e1-0906055bf4f9",
                                "text": "„Tatsächlich ruft die Preisverleihung an Jünger bedeutende Personen, Daten und Erinnerungsorte der Deutschen auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
