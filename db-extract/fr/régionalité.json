                "senses": [
                    {
                        "sense_id": "eec1abab-25ce-3b81-adcf-659e1e6f657f",
                        "entry_id": "5bb7eee7-58c6-3702-bee3-770023e84d32",
                        "glosses": [
                            "Régionalisme, caractère régional."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ba91a4b-3fd6-4941-af66-c38dc3070823",
                                "sense_id": "eec1abab-25ce-3b81-adcf-659e1e6f657f",
                                "text": "Lorsqu’en 1866 on décréta le cours forcé [des billets de la Banque nationale d’Italie], on fut pris au dépourvu, et malheureusement la pluralité des banques d’émission en Italie entraîna aussitôt la régionalité des billets."
                            },
                            {
                                "example_id": "6ecd0f6c-e7ac-4451-bf4d-d45593628bb5",
                                "sense_id": "eec1abab-25ce-3b81-adcf-659e1e6f657f",
                                "text": "Les consignes étaient de moderniser les villes tout en conservant une certaine régionalité."
                            },
                            {
                                "example_id": "24b2fd05-7aa8-4170-a86b-f66dfb029497",
                                "sense_id": "eec1abab-25ce-3b81-adcf-659e1e6f657f",
                                "text": "Le magasin a signé avec le producteur une charte d'engagement qualité qui garantit la régionalité et la qualité des légumes."
                            }
                        ]
                    },
                    {
                        "sense_id": "1bf7ae7c-10ad-372b-b0d7-44db58543944",
                        "entry_id": "5bb7eee7-58c6-3702-bee3-770023e84d32",
                        "glosses": [
                            "Ensemble de comportements qui dérivent de l'appartenance à une région."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d589eff-7553-4efa-b360-e7c246effb51",
                                "sense_id": "1bf7ae7c-10ad-372b-b0d7-44db58543944",
                                "text": "Plus une personne est intégrée à son milieu, plus elle est susceptible d'être imprégnée par la régionalité de ce milieu."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e940642-ad42-461d-beec-bb5ae029926f",
                        "source_entry_id": "5bb7eee7-58c6-3702-bee3-770023e84d32",
                        "target_lang_word": "Regionalität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
