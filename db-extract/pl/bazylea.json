                    {
                        "translation_id": "7258a4ed-f474-4061-ad48-99c2bc28eeee",
                        "source_entry_id": "e688e62c-3359-3846-af41-824debefba4e",
                        "source_sense_id": "cd9ae7a6-d5d4-31ee-b9a9-83b7945c8d6a",
                        "target_lang_word": "Basel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Basel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1e4d5c82-1eb6-3caa-ab32-95f3e7e00f34",
                                        "entry_id": "1934e2d5-08c9-395f-9d8a-2f7239396394",
                                        "glosses": [
                                            "eine Stadt in der Schweiz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3baaed1-bb9b-45f2-8dc1-b14757c9dcf3",
                                                "sense_id": "1e4d5c82-1eb6-3caa-ab32-95f3e7e00f34",
                                                "text": "Basel ist der grösste Messeplatz der Schweiz."
                                            },
                                            {
                                                "example_id": "f0c19096-f027-4d72-9c59-7cb7ea5ebab8",
                                                "sense_id": "1e4d5c82-1eb6-3caa-ab32-95f3e7e00f34",
                                                "text": "„Die ehemaligen Römerstädte Köln, Mainz, Worms, Speyer, Straßburg und Basel gewannen wirtschaftliche Bedeutung, seit der Warenaustausch mit Italien nicht mehr hauptsächlich über Marseille und Fos auf dem Seeweg, sondern immer mehr über die Alpenpässe abgewickelt wurde.“"
                                            },
                                            {
                                                "example_id": "323b2365-73a9-4e55-ad9e-1029411a394e",
                                                "sense_id": "1e4d5c82-1eb6-3caa-ab32-95f3e7e00f34",
                                                "text": "„Wir erzählen, dass wir in Basel waren und dass es dort eine richtige Badekultur gebe.“"
                                            },
                                            {
                                                "example_id": "144dcb7e-0c6e-4baf-8391-22da7c17d192",
                                                "sense_id": "1e4d5c82-1eb6-3caa-ab32-95f3e7e00f34",
                                                "text": "„Um die weitere Ausbreitung des Japankäfers zu verhindern, setzt die Schweizer Großstadt Basel erstmals Fadenwürmer gegen den Schädling in öffentlichen Parks und Sportanlagen ein.“"
                                            }
                                        ],
