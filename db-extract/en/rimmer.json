                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "e87dfaf7-8dcc-4353-a18d-4ae83a8c0691",
                                "sense_id": "24075c8c-8a5f-3b56-9598-95bf6ed4d9f7",
                                "text": "There were days when I literally didn't feel a dab and there are some days where two rimmers get me higher than a regular dab."
                            },
                            {
                                "example_id": "396cc50f-45c1-4cb4-b9e1-6bbc2053a96d",
                                "sense_id": "24075c8c-8a5f-3b56-9598-95bf6ed4d9f7",
                                "text": "Baccy cones for my breakfast, lunch and dinner, pack a rimmer / Bury me with a pouch, punching baccy cones as it goes"
                            },
                            {
                                "example_id": "913aea47-4603-45ba-8c44-304ceb2c9e0a",
                                "sense_id": "24075c8c-8a5f-3b56-9598-95bf6ed4d9f7",
                                "text": "Unless youre a beast, then pack a rimmer and light it lmao but I cant say it will be terribly pleasant"
                            }
                        ]
                    }
