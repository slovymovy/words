                "senses": [
                    {
                        "sense_id": "6dc390dd-21a4-374d-a2ea-54e4c03e0d45",
                        "entry_id": "1714016a-19bb-3c70-b847-650e454dfb73",
                        "glosses": [
                            "Fidèle du bahaïsme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "579e7fe8-1b4d-4660-8516-5d4a14fb2e44",
                                "sense_id": "6dc390dd-21a4-374d-a2ea-54e4c03e0d45",
                                "text": "En 1920 seulement j’ai appris à connaître à Karlsruhe la religion supraconfessionnelle et mondiale des Bahaïs […] Je suis devenu Bahaï."
                            },
                            {
                                "example_id": "47ede406-184f-47c0-80f9-18b243726ac9",
                                "sense_id": "6dc390dd-21a4-374d-a2ea-54e4c03e0d45",
                                "text": "— On dit que parmi tes serviteurs il y a des babis ou des bahaïs notoires, ce que Fazel m’a confirmé."
                            }
                        ]
                    }
                ],
