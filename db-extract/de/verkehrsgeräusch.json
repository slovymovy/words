                ],
                "senses": [
                    {
                        "sense_id": "e9936a69-0bb5-36a0-8d9e-87f558b1554e",
                        "entry_id": "b17ea533-0e7c-3e11-bb7f-76326d9d5f0c",
                        "glosses": [
                            "auditiv wahrnehmbarer Schallreiz, der beim Verkehren produziert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b779486e-06d0-4a72-9c95-40188a6a09f6",
                                "sense_id": "e9936a69-0bb5-36a0-8d9e-87f558b1554e",
                                "text": "„Er muss auch in der Lage sein, aus dem allgemeinen Verkehrslärm die bedrohlichen und dringlichen Verkehrsgeräusche herauszufiltern.“"
                            },
                            {
                                "example_id": "1e0893e2-f307-4a2a-a7d0-877cd3e88c9f",
                                "sense_id": "e9936a69-0bb5-36a0-8d9e-87f558b1554e",
                                "text": "„Wenn die Säge verstummte, drang schwach das Verkehrsgeräusch der Bahnhofstraße in die Küche.“"
                            },
                            {
                                "example_id": "fad7a1ac-c8e8-48a9-a41f-c9f7b06c6079",
                                "sense_id": "e9936a69-0bb5-36a0-8d9e-87f558b1554e",
                                "text": "„So klagte jeder dritte Befragte über Verkehrsgeräusche, jeder vierte teilte mit, sich über den Krach der Nachbarn zu ärgern.“"
                            },
                            {
                                "example_id": "931f5995-89a2-4df6-9b0c-eadf9b52990b",
                                "sense_id": "e9936a69-0bb5-36a0-8d9e-87f558b1554e",
                                "text": "„Während man Denise auf ihrem Fahrrad sieht durch eine Schweizer Postkartenlandschaft fahren, Berge und Wiesen und Wälder, da hört man zuerst Kuhglocken und Musik, dann aber schieben sich Verkehrsgeräusche in den Ton und Straßenlärm.“"
                            },
                            {
                                "example_id": "f26c5e4e-ff31-4362-a45b-57ba1fbdb10a",
                                "sense_id": "e9936a69-0bb5-36a0-8d9e-87f558b1554e",
                                "text": "„Da es schwierig sein dürfte, die Verkehrsgeräusche in absehbarer Zeit merklich zu senken, sollte man den Verkehr aus den Kurvierteln überhaupt verbannen.“"
                            },
                            {
                                "example_id": "f58c05da-bdb6-4517-a71a-478cdd54e072",
                                "sense_id": "e9936a69-0bb5-36a0-8d9e-87f558b1554e",
                                "text": "„Er hörte Verkehrsgeräusche von der Straße jenseits des Parkplatzes, glaubte aber dennoch, dass das Fenster geschlossen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
