                ],
                "senses": [
                    {
                        "sense_id": "f3b3e7eb-87f4-3a0d-841c-1c36c232dec3",
                        "entry_id": "abef6975-0585-3048-82da-95c74625d065",
                        "glosses": [
                            "de taal van het gewone volk, vaak informeel van aard en soms als minder beschaafd gezien, in tegenstelling tot de standaardtaal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae24d99c-a60a-401a-b18a-7205f413ca3a",
                                "sense_id": "f3b3e7eb-87f4-3a0d-841c-1c36c232dec3",
                                "text": "In de Vroegmoderne Tijd werd de literatuur overal in Europa gekenmerkt door de tweetaligheid van Latijn en volkstaal."
                            }
                        ]
                    },
                    {
                        "sense_id": "8fac9dac-3d1f-3549-87fb-1434978b4331",
                        "entry_id": "abef6975-0585-3048-82da-95c74625d065",
                        "glosses": [
                            "moedertaal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed0a8ba3-b022-4dc9-a49d-4dd907a9aee3",
                                "sense_id": "8fac9dac-3d1f-3549-87fb-1434978b4331",
                                "text": "Mensen die het waagden een bijbel in de volkstaal in bezit te hebben of bijbels te verspreiden, kregen te maken met de woede van de katholieke kerk. Velen van hen werden gearresteerd, op de brandstapel gebracht, levend aan het spit geroosterd, tot levenslange gevangenisstraf veroordeeld of naar de galeien gestuurd. In beslag genomen bijbels werden verbrand. Tot ver in de twintigste eeuw waren er katholieke geestelijken die bijbels in beslag namen en verbrandden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8984f8ea-b2f7-4252-abe0-1ae945ca2bb8",
                        "source_entry_id": "abef6975-0585-3048-82da-95c74625d065",
                        "source_sense_id": "f3b3e7eb-87f4-3a0d-841c-1c36c232dec3",
                        "source_sense_description": "de taal van het gewone volk, vaak informeel van aard en soms als minder beschaafd gezien, in tegenstelling tot de standaardtaal",
                        "target_lang_word": "Alltagssprache",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Alltagssprache",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84856500-7be7-3602-8541-aac6e2eb5490",
                                        "entry_id": "5083d426-c942-396e-ad3a-093136dca371",
                                        "glosses": [
                                            "zwischen Standard- und Umgangssprache stehende Sprachform, die für alltägliche Zwecke verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "072f2b96-7567-49a6-b125-758941b5d106",
                                                "sense_id": "84856500-7be7-3602-8541-aac6e2eb5490",
                                                "text": "Bei alltäglichen Verrichtungen wie Einkaufen, Small Talk oder Unterhaltung mit Bekannten verwendet man meist die Alltagssprache."
                                            },
                                            {
                                                "example_id": "cb05cb75-bc4d-4d0e-9f2b-94b22c6def99",
                                                "sense_id": "84856500-7be7-3602-8541-aac6e2eb5490",
                                                "text": "Die Alltagssprache ist weniger förmlich als zum Beispiel Fach-, Medien- oder Wissenschaftssprachen."
                                            },
                                            {
                                                "example_id": "6b9132dd-7408-46a6-a936-7dfc0ab2fd86",
                                                "sense_id": "84856500-7be7-3602-8541-aac6e2eb5490",
                                                "text": "„Wie bei Alltagssprache und Literatursprache stehen ‚Wissenschafts- und Fachsprachen‘ wiederum als Oberbegriffe für eine Reihe von Varietäten.“"
                                            },
                                            {
                                                "example_id": "427e4489-03f8-4f8d-9319-6ab04785c626",
                                                "sense_id": "84856500-7be7-3602-8541-aac6e2eb5490",
                                                "text": "„Das betrifft nicht allein den terminologischen Bereich und Benennungsstandards, sondern auch viele Wörter der Alltagssprache […]“"
                                            },
                                            {
                                                "example_id": "2f87885d-97bb-4cad-80e6-601a1e81b575",
                                                "sense_id": "84856500-7be7-3602-8541-aac6e2eb5490",
                                                "text": "„An diesen Formulierungen bemerken Sie bereits, daß hier der Prozeß des Verstehens, der Erkenntnis, der Meinungsbildung in der Alltagssprache mit dem Bilde des Sehens geschildert wurde.“"
                                            },
                                            {
                                                "example_id": "9f1ce151-8fad-4c83-b447-136741daa929",
                                                "sense_id": "84856500-7be7-3602-8541-aac6e2eb5490",
                                                "text": "„In den Duden schaffte es das Gesetz nie, weil es in der Alltagssprache nicht vorkommt.“"
                                            },
                                            {
                                                "example_id": "678d9aac-6a37-47f3-9095-1a2ce0b4ab2d",
                                                "sense_id": "84856500-7be7-3602-8541-aac6e2eb5490",
                                                "text": "„Wie kommt es also, dass den Menschen im Rheinland zwar der Mischcharakter ihrer Alltagssprache bewusst ist, die jiddische Komponente dabei aber ausgeklammert bleibt?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ef8b5f3-204e-4168-8ed4-0ce54def7518",
                        "source_entry_id": "abef6975-0585-3048-82da-95c74625d065",
                        "source_sense_id": "f3b3e7eb-87f4-3a0d-841c-1c36c232dec3",
                        "source_sense_description": "de taal van het gewone volk, vaak informeel van aard en soms als minder beschaafd gezien, in tegenstelling tot de standaardtaal",
                        "target_lang_word": "Volkssprache",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Volkssprache",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6fdb5ccf-2063-36e7-808f-6ca8539b157c",
                                        "entry_id": "762620f1-b8ef-36a5-a3e5-f2a23f14af85",
                                        "glosses": [
                                            "Sprache einer bodenständigen Bevölkerung im Gegensatz zu anderen Sprachvarietäten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "487351dd-f2a4-4758-93d4-96939299d1d5",
                                                "sense_id": "6fdb5ccf-2063-36e7-808f-6ca8539b157c",
                                                "text": "„Der vorliegende 5. Band des Thesaurus der slowenischen Volkssprache in Kärnten (I–Ka) ist ein Fortsetzungsband der bisher erschienenen vier Bände (Bd.1 A–B, ÖAW; Bd.2 C–dn, ÖAW; Bd.3 do–F, ÖAW und Bd. 4 G–H).“"
                                            },
                                            {
                                                "example_id": "782352b6-92aa-47c6-85ef-150548fd8679",
                                                "sense_id": "6fdb5ccf-2063-36e7-808f-6ca8539b157c",
                                                "text": "„Brocken (Mons Bructerus, in der Volkssprache auch Blocksberg genannt), höchste Kuppe des Harzes, 1142 m hoch, liegt auf preußischem Gebiet in der Grafschaft Stolberg-Wernigerode, 850–880 m über der nur 8 km entfernten Ebene von Ilsenburg und ca. 500 m über dem südöstlichen Plateau, und ist der Mittelpunkt des nach ihm genannten Brockengebirges, das die Hauptmasse des Oberharzes bildet.“"
                                            },
                                            {
                                                "example_id": "11b25ab5-cfec-492a-b1ec-4aabdc02b2cf",
                                                "sense_id": "6fdb5ccf-2063-36e7-808f-6ca8539b157c",
                                                "text": "„Noch nach 1450 war die Volkssprache in Halle niederdeutsch, während die Gebildeten mitteldeutsch redeten.“"
                                            },
                                            {
                                                "example_id": "36c2a296-bd7d-41a1-bfc7-8766efdbd7fd",
                                                "sense_id": "6fdb5ccf-2063-36e7-808f-6ca8539b157c",
                                                "text": "„Die Volkssprache entfaltet sich für das Kind im Kreis der Familienangehörigen als Familiensprache und besitzt in diesem Milieu seinen eigentlichen Rückhalt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9b98d2d7-2f69-33d8-9bac-5d2cb8d8b88e",
                                        "entry_id": "762620f1-b8ef-36a5-a3e5-f2a23f14af85",
                                        "glosses": [
                                            "Bezeichnung für die einheimischen Sprachen der frühen Neuzeit als Gegenbegriff zur Wissenschaftssprache Latein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21ab979b-c582-433c-94e3-d52332a73030",
                                                "sense_id": "9b98d2d7-2f69-33d8-9bac-5d2cb8d8b88e",
                                                "text": "„Die Mannigfaltigkeit des mündlichen Wortschatzes bleibt für die Volkssprache bestehen.“"
                                            },
                                            {
                                                "example_id": "770bc9c9-4b50-43c2-ac83-8e2cbbcfbb20",
                                                "sense_id": "9b98d2d7-2f69-33d8-9bac-5d2cb8d8b88e",
                                                "text": "„Solche Umsetzungen volkssprachlicher Texte ins Latein erfüllen darüber hinaus eine wichtige Brückenfunktion im internationalen Literaturbetrieb, schon weil sie die ungewohnte Spannweite einer Direktübersetzung zwischen Volkssprachen aufheben…“"
                                            },
                                            {
                                                "example_id": "e040460c-c600-4804-a6f6-7755a12e1116",
                                                "sense_id": "9b98d2d7-2f69-33d8-9bac-5d2cb8d8b88e",
                                                "text": "„Auch in Luthers Tischreden beispielsweise, der wichtigsten Quelle, mischen sich westthüringische und ostmitteldeutsch-niederdeutsche Dialekte mit ganz individuellen Eigenheiten und Wortschöpfungen; sein Bemühen um die Volkssprache, um »eyn mundliche predig und lebendig worrt«, ist zudem theologisch begründet und durchaus nicht auf eine bestimmte Regionalform bezogen.“"
                                            },
                                            {
                                                "example_id": "dcf652c9-b4f0-43a4-acb0-d6871f586080",
                                                "sense_id": "9b98d2d7-2f69-33d8-9bac-5d2cb8d8b88e",
                                                "text": "„Aber die Sprache der Wissenschaft war das Lateinische, und so blieb die Berührung mit der italienischen Volkssprache gering.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "21e260e5-9805-45f6-957a-ba9b2d819603",
