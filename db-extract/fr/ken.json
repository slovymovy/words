                        "examples": [
                            {
                                "example_id": "0f22881b-c8ef-4045-9902-c472b1532ecd",
                                "sense_id": "321f48d4-f3d6-3e08-8ad8-433ebe853966",
                                "text": "Ken Kiefer, un photographe sous-marin de Houston (États-Unis), s’est approché au plus près d’un grand requin blanc, au large du Mexique."
                            },
                            {
                                "example_id": "6a17b27f-2b47-486b-ac39-bd45a2b2915c",
                                "sense_id": "321f48d4-f3d6-3e08-8ad8-433ebe853966",
                                "text": "Ken Loach, Hirokazu Kore-eda, Nuri Bilge Ceylan, Nanni Moretti et Marco Bellochio, habitués du festival, sont très attendus."
                            },
                            {
                                "example_id": "1ecbb392-dc96-424a-9261-628919660212",
                                "sense_id": "321f48d4-f3d6-3e08-8ad8-433ebe853966",
                                "text": "L’animateur reçoit Ken Follett, pour Les Armes de la lumière, Julie Héraclès, pour Vous ne connaissez rien de moi, Cécile Desprairies, pour La Propagandiste et Patrick Boucheron, pour Le Temps qui reste."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
