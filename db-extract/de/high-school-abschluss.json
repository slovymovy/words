                "senses": [
                    {
                        "sense_id": "3fb68336-36a8-3de7-add6-d3d20683d629",
                        "entry_id": "c7f642cc-edb1-3922-8772-e4094f6e01f5",
                        "glosses": [
                            "erfolgreiche Absolvierung einer (australischen/ghanaischen/kanadischen/neuseeländischen/südafrikanischen/US-amerikanischen) High School"
                        ],
                        "tags": [
                            "Bildungswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "0b94f9e3-061c-440e-a720-a4a183fcd05f",
                                "sense_id": "3fb68336-36a8-3de7-add6-d3d20683d629",
                                "text": "„Tanev machte seinen High-School-Abschluss auf dem East York Collegiate Institute.“"
                            },
                            {
                                "example_id": "f1b8788f-875e-47bd-8cae-acc693136e45",
                                "sense_id": "3fb68336-36a8-3de7-add6-d3d20683d629",
                                "text": "„Bristol Palin ist noch dabei, ihren High-School-Abschluss zu machen,“ […]."
                            },
                            {
                                "example_id": "4836f199-4cd4-4664-9645-9ced5dffade1",
                                "sense_id": "3fb68336-36a8-3de7-add6-d3d20683d629",
                                "text": "„1993 erhielt er einen High-School-Abschluss in Dinuba in Kalifornien.“"
                            },
                            {
                                "example_id": "2ea3687d-8b13-4e39-807b-a4de6d0917ea",
                                "sense_id": "3fb68336-36a8-3de7-add6-d3d20683d629",
                                "text": "„Nach ihrem High-School-Abschluss arbeitet Weiss zunächst als Angestellte in einer Rechtsanwaltskanzlei. “"
                            },
                            {
                                "example_id": "dd81043a-08f0-4152-8ff8-a2a52e9c5a59",
                                "sense_id": "3fb68336-36a8-3de7-add6-d3d20683d629",
                                "text": "„Nach seinem High-School-Abschluss in Fort Worth im Jahr 1962 besuchte Michael Andrews die University of Texas in Austin und erwarb dort 1967 den Bachelor of Arts.“"
                            },
                            {
                                "example_id": "3b92eef8-3924-432c-b904-e4a4638bf706",
                                "sense_id": "3fb68336-36a8-3de7-add6-d3d20683d629",
                                "text": "„Der in seiner Geburtsstadt Toronto aufgewachsene Richie Laryea wechselte nach seinem High-School-Abschluss auf die University of Akron im US-Bundesstaat Ohio.“"
                            },
                            {
                                "example_id": "be3fa743-7bf1-47ef-b176-1756640294c3",
                                "sense_id": "3fb68336-36a8-3de7-add6-d3d20683d629",
                                "text": "„Als 18-jähriger Freshman, gerade ein paar Monate erst nach seinem High-School-Abschluss, führte Lawrence Clemson zum dominanten Sieg über Alabama im Championship Game.“"
                            },
                            {
                                "example_id": "86c9b95b-1fba-4baa-8531-24007309bb9b",
                                "sense_id": "3fb68336-36a8-3de7-add6-d3d20683d629",
                                "text": "„Das Seminar verlieh 1887 seine ersten High-School-Abschlüsse und 1901 seine ersten College-Abschlüsse.“"
                            },
                            {
                                "example_id": "35a5cb2c-1d31-48f3-8f30-bb9a2307c311",
                                "sense_id": "3fb68336-36a8-3de7-add6-d3d20683d629",
                                "text": "„Harris erzählt von einem Programm, das sie als Bezirksstaatsanwältin von Kalifornien initiiert hat: Ersttäter holen während der Haftstrafe ihren High-School-Abschluss nach.“"
                            },
                            {
                                "example_id": "c0a0cd68-fb65-413d-98b4-cc3776b52701",
                                "sense_id": "3fb68336-36a8-3de7-add6-d3d20683d629",
                                "text": "„Der Richter weist ihn zurecht, wenn er sich daneben benimmt – und der Richter entscheidet, ob der Angeklagte dem High-School-Abschluss seines Sohnes beiwohnen darf oder nicht.“"
                            },
                            {
                                "example_id": "25cab713-49ff-4f6a-84df-d4cb730cac87",
                                "sense_id": "3fb68336-36a8-3de7-add6-d3d20683d629",
                                "text": "„Die Kinder besuchten öffentliche Schulen, die so miserabel waren, dass sie ein Jahr vor dem High-School-Abschluss noch nicht einmal den Lesestoff der dritten Klasse beherrschten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
