                        "glosses": [
                            "Aufenthalt im Meerwasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "167b4773-2c6e-4064-8ca1-076fcf58d8d1",
                                "sense_id": "c5197081-5fe2-37f3-b2e3-7e598006be83",
                                "text": "Das Seebad bekam uns allen sehr gut."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ef3ba714-cb8a-3404-8821-71791e9ee379",
                        "entry_id": "21383ed8-82ef-3202-adf5-9d56ba2f6a63",
                        "glosses": [
                            "Bade- oder Kurort am Meer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49207b89-ac46-4604-b783-1297367996b2",
                                "sense_id": "ef3ba714-cb8a-3404-8821-71791e9ee379",
                                "text": "Dieses Jahr planen wir einen Ausflug zum einem Seebad an der Nordsee."
                            },
                            {
                                "example_id": "14018756-efb0-43c4-98c8-33ca4216c3c3",
                                "sense_id": "ef3ba714-cb8a-3404-8821-71791e9ee379",
                                "text": "„In den prächtig angelegten Seebädern Ostpreußens, in Cranz und Rauschen, traf sich der europäische Adel.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
