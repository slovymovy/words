                "senses": [
                    {
                        "sense_id": "763875e4-ed2e-353a-8555-782d4f1e3cbc",
                        "entry_id": "a7f86d99-f3fc-3398-8dd6-11cb75fe614d",
                        "glosses": [
                            "Schlägertrupp, der jemanden mit überraschenden Gewaltaktionen unter Druck setzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a25da79d-c3ee-4127-8500-16576c2b3813",
                                "sense_id": "763875e4-ed2e-353a-8555-782d4f1e3cbc",
                                "text": "Ein Rollkommando tauchte auf und zerschlug das gesamte Inventar."
                            },
                            {
                                "example_id": "87ce02fa-b5c7-40f0-89c3-f7011d03166f",
                                "sense_id": "763875e4-ed2e-353a-8555-782d4f1e3cbc",
                                "text": "„Ab 1946 fuhren Rollkommandos übers Land, um Arbeitskräfte anzuheuern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a53007f-0b0f-4a4d-b57f-650209898c82",
                        "source_entry_id": "a7f86d99-f3fc-3398-8dd6-11cb75fe614d",
                        "source_sense_id": "763875e4-ed2e-353a-8555-782d4f1e3cbc",
                        "source_sense_description": "Schlägertrupp, der jemanden mit überraschenden Gewaltaktionen unter Druck setzt",
                        "target_lang_word": "goon squad",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "goon squad",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f85ad1d-65ce-356c-9ca2-2e76f36bb206",
                                        "entry_id": "3d234705-5843-3c64-ba57-9ac8734c4b13",
                                        "glosses": [
                                            "A group of individuals serving as enforcers, bodyguards, assassins, and the like, especially persons hired for such a purpose and using violent, thuggish methods."
                                        ],
                                        "tags": [
                                            "US",
                                            "derogatory",
                                            "idiomatic",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba138935-9f3b-401b-af37-9816f8b228b9",
                                                "sense_id": "1f85ad1d-65ce-356c-9ca2-2e76f36bb206",
                                                "text": "He denied charges that the union was using \"goon squads,\" as strong-arm detachments are called on the West Coast, and asserted that any violence was provoked by the employers."
                                            },
                                            {
                                                "example_id": "2bc33d7e-9cac-4a76-90a5-653910fc7657",
                                                "sense_id": "1f85ad1d-65ce-356c-9ca2-2e76f36bb206",
                                                "text": "No one has ever accused Uganda's mercurial President Idi (\"Big Daddy\") Amin Dada of running a democracy. . . . In Kampala, the capital, much of the terror is committed by Big Daddy's personal goon squad, the 3,000-man Public Safety Unit."
                                            },
                                            {
                                                "example_id": "435acb33-f1c3-4b34-8412-52296bf3d4b1",
                                                "sense_id": "1f85ad1d-65ce-356c-9ca2-2e76f36bb206",
                                                "text": "But becoming the \"Spirit Father\" to a group of cave dwellers threatened by \"bandits, insurgent guerrillas\" and \"goon squads hired by greedy logging companies\" gives him a newfound purpose in life."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
