                        "cross_references": [
                            {
                                "target_word": "brainwashing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11402b5c-f548-3f72-a769-bbff3d59e2e3",
                                        "entry_id": "4d07c624-cda1-3b6d-91f9-b0756451592c",
                                        "glosses": [
                                            "A form of indoctrination that forces people to abandon their beliefs in favour of another set of beliefs by conditioning through various forms of pressure or torture."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abe2be31-9a9e-42a2-a771-97af194983b2",
                                                "sense_id": "11402b5c-f548-3f72-a769-bbff3d59e2e3",
                                                "text": "So it came about, through Pavlov's work, that the Soviets developed and perfected the 'brain-washing' technique seen to be so effective in the state trials of the 1930s. An amazed world witnessed the sight of intelligent and renowned figures genuinely confessing to criminal acts against the state, or voicing ideological dogma in a total reversal of their previously held values."
                                            },
                                            {
                                                "example_id": "ea51265f-8a3c-4193-9ad3-1c32b5031b13",
                                                "sense_id": "11402b5c-f548-3f72-a769-bbff3d59e2e3",
                                                "text": "All new prisoners were assigned to \"study groups\" or \"introductory teams\" that were responsible for applying a variety of brain-washing techniques designed to break down all old beliefs and attitudes and replace them with Communist-Socialist thoughts."
                                            }
                                        ]
                                    }
                                ]
                            },
