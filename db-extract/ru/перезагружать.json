                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a7aee478-ef26-3519-b4ec-9e11b3b8c153",
                                        "entry_id": "5bee7846-2654-3ede-8578-b4f5af247eba",
                                        "glosses": [
                                            "Démarrer à nouveau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3443ceb6-8f19-47b0-94cf-14ecee910be8",
                                                "sense_id": "a7aee478-ef26-3519-b4ec-9e11b3b8c153",
                                                "text": "Persanti était un rat et Nabil avait été infichu de redémarrer la chaudière."
                                            },
                                            {
                                                "example_id": "5741cfa9-5a6d-4ff0-8ce8-1e4781760e0b",
                                                "sense_id": "a7aee478-ef26-3519-b4ec-9e11b3b8c153",
                                                "text": "Il redémarra, augmenta le volume du lecteur de CD."
                                            },
                                            {
                                                "example_id": "268b9d48-a681-4814-9b36-7c662c0a0478",
                                                "sense_id": "a7aee478-ef26-3519-b4ec-9e11b3b8c153",
                                                "text": "Puis il passa devant François, sans un regard, et alla bricoler la voiture pour qu’elle redémarre."
                                            }
                                        ]
                                    }
                                ]
