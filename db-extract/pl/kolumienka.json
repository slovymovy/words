                "senses": [
                    {
                        "sense_id": "f4fab445-1805-34a0-92f5-d086e28f0516",
                        "entry_id": "bab2822b-85ee-3f1e-b59c-126b0611394f",
                        "glosses": [
                            "od: kolumna"
                        ],
                        "tags": [
                            "diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "ad43d9bb-9e90-4299-afc5-6982b5886114",
                                "sense_id": "f4fab445-1805-34a0-92f5-d086e28f0516",
                                "text": "Mensa opierała się na ośmiu spiralnych kolumienkach wykonanych z marmuru."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "b26f7d4f-fc20-3589-a4db-b452785880b3",
                        "entry_id": "bab2822b-85ee-3f1e-b59c-126b0611394f",
                        "glosses": [
                            "mała kolumna"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "419b1b0d-83a9-4116-964e-fc6dea7e7488",
                        "source_entry_id": "bab2822b-85ee-3f1e-b59c-126b0611394f",
                        "source_sense_id": "b26f7d4f-fc20-3589-a4db-b452785880b3",
                        "target_lang_word": "colonnette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "colonnette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "85344c41-4b21-3e82-bcd7-1e4ffe238dee",
                                        "entry_id": "30651986-cb09-3269-b8d0-c91def3702bd",
                                        "glosses": [
                                            "Petite colonne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7eec09e-7c62-4b0f-9530-63d753c6413e",
                                                "sense_id": "85344c41-4b21-3e82-bcd7-1e4ffe238dee",
                                                "text": "Parvenu sur la galerie des colonnettes, il souffla un moment, et jura contre l’interminable escalier par je ne sais combien de millions de charretées de diables."
                                            },
                                            {
                                                "example_id": "154ee4ad-40a7-462a-9fc3-a574dcce394d",
                                                "sense_id": "85344c41-4b21-3e82-bcd7-1e4ffe238dee",
                                                "text": "La salle des Ambassadeurs, dont les magnifiques portes subsistent dans toute leur intégrité, est peut-être plus belle et plus riche que celle de Grenade ; malheureusement l’on a eu l’idée de profiter de l’intervalle des colonnettes qui soutiennent le plafond pour y loger une suite de portraits des rois d’Espagne depuis les temps les plus reculés de la monarchie jusqu’à nos jours."
                                            },
                                            {
                                                "example_id": "f2f062a4-ba2c-41d9-92cd-36abe65b5202",
                                                "sense_id": "85344c41-4b21-3e82-bcd7-1e4ffe238dee",
                                                "text": "À droite, le mur peu élevé qui fermait la cour portait scellés des débris précieux de frises, des fûts rompus de colonnettes."
                                            },
                                            {
                                                "example_id": "3bb7bb87-7a2f-4289-9bc1-6d45c6a3aba4",
                                                "sense_id": "85344c41-4b21-3e82-bcd7-1e4ffe238dee",
                                                "text": "Et c'était là, dans une petite maison blanche à terrasse et à colonnettes, qu'ils l'avaient laissée deux mois après, …."
                                            },
                                            {
                                                "example_id": "b888fc49-d89f-46f9-bdfa-20f3d387ab44",
                                                "sense_id": "85344c41-4b21-3e82-bcd7-1e4ffe238dee",
                                                "text": "À l'intérieur, quatre colonnes corinthiennes et les colonnettes cannelées du chancel supportent le jubé de bois, orné de panneaux en bas-relief polychrome."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
