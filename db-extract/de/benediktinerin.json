                                    {
                                        "sense_id": "0d8374b2-8316-3274-8bd4-5846a748a77d",
                                        "entry_id": "82c2805b-b871-3db5-b1f0-4c88d150bf33",
                                        "glosses": [
                                            "A monk or nun belonging to the order founded by Saint Benedict of Nursia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0337fa29-2e2d-4f5a-bb3d-dc7c9709708e",
                                                "sense_id": "0d8374b2-8316-3274-8bd4-5846a748a77d",
                                                "text": "Some of her most interesting remarks on writing appear in her letters to Sister Mariella Gable, a strong-minded Minnesota Benedictine who admired O'Connor greatly. In the fifties, O'Connor tells a friend, when Sister Mariella's bishop ordered her to stop teaching Catcher in the Rye, she defied him and was banished."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20596099-a5bd-3287-9b17-5e1e88bf54ab",
                                        "entry_id": "82c2805b-b871-3db5-b1f0-4c88d150bf33",
                                        "glosses": [
                                            "A type of liqueur originating from the Benedictine cloister of Fécamp in France, made from cognac together with herb and spice extracts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28327707-3b10-458d-b3a7-822f42cd2f6c",
                                                "sense_id": "20596099-a5bd-3287-9b17-5e1e88bf54ab",
                                                "text": "Many liqueurs, among them chartreuse and benedictine, have long been held in great esteem as aphrodisiac aids."
                                            }
                                        ]
                                    }
                                ]
                            },
