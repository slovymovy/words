                        "entry_id": "fa20680e-fe98-35fc-abb4-356e632d0234",
                        "glosses": [
                            "To inject hirudin into blood to prevent coagulation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9e934f3-5820-4f42-9468-1551af966db4",
                                "sense_id": "f75da978-11be-3646-abdf-63f234bcce37",
                                "text": "In the hirudin experiments to be detailed, equal parts of the same extract were employed in hirudinized and control animals."
                            },
                            {
                                "example_id": "eb1c5d2c-4373-45db-a41e-ea16402b36c7",
                                "sense_id": "f75da978-11be-3646-abdf-63f234bcce37",
                                "text": "The hirudinized blood of a control was divided evenly into four small test tubes."
                            },
                            {
                                "example_id": "c737f848-fc16-4de2-8929-9c7cec54115c",
                                "sense_id": "f75da978-11be-3646-abdf-63f234bcce37",
                                "text": "Suitable precautions are necessary to prevent coagulation in the splenic artery and this may be accomplished either by hirudinizing the animal or, what has proved more satisfactory[…]"
                            },
                            {
                                "example_id": "c1b96de8-cfc6-404b-8d63-0ebac6ba3625",
                                "sense_id": "f75da978-11be-3646-abdf-63f234bcce37",
                                "text": "A 600μL blood sample acquired in hirudinized tubes (Sarstedt) was obtained to perform ADP and TRAP tests in each patient."
                            }
                        ]
                    }
