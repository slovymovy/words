                },
                {
                    "sense_id": "f6ff9ea7-e097-38ec-9e1f-86436240e736",
                    "sense_definition": "The juice extracted from a lemon fruit.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "liquid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The recipe calls for two tablespoons of <w>lemon</w> and some honey.",
                            "target_lang_translations": {
                                "ru": "По рецепту требуется две столовые ложки <w>лимонного сока</w> и немного меда."
                            }
                        },
                        {
                            "text": "Drinking <w>lemon</w> in warm water every morning is a healthy habit.",
                            "target_lang_translations": {
                                "ru": "Пить воду с <w>лимоном</w> каждое утро — полезная привычка."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fresh lemon",
                        "bottled lemon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сок, выжатый из плода лимона."
