                "senses": [
                    {
                        "sense_id": "fa3dfbb1-2a8b-3863-9f37-53c0ff14f65a",
                        "entry_id": "c84b4ded-f52b-3980-891a-bac3ba4c4224",
                        "glosses": [
                            "een ei dat gebruikt wordt voor het produceren van kuikens; bebroed ei"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d236a7e-635f-4ce9-b5e9-06186ab10a50",
                                "sense_id": "fa3dfbb1-2a8b-3863-9f37-53c0ff14f65a",
                                "text": "Met de nieuwe techniek kan aan het begin van het broedproces het geslacht in het ei worden vastgesteld. „Dat gebeurt door op dag negen van het broedproces een heel klein gaatje in de schaal van het broedei te laseren en er een minuscuul druppeltje embryo-urine uit te halen."
                            },
                            {
                                "example_id": "d4ef6309-edf5-4b36-9f4a-77f2b48037b3",
                                "sense_id": "fa3dfbb1-2a8b-3863-9f37-53c0ff14f65a",
                                "text": "Vrachtwagens die de komende tijd met broedeieren of pluimvee terugkomen uit Italië moeten een extra reinigings- en ontsmettingsbeurt ondergaan in een speciale wasplaats. Die maatregel is ingesteld na de uitbraak donderdag van een zeer besmettelijke variant van de vogelgriep in het Italiaanse Ostellato, niet ver van Bologna."
                            },
                            {
                                "example_id": "58817d61-0362-49f7-95f9-817384210b3f",
                                "sense_id": "fa3dfbb1-2a8b-3863-9f37-53c0ff14f65a",
                                "text": "De compensatie moet de broedeieren en eendagskuikens vergoeden, die de boeren tussen 20 en 29 november niet konden verkopen. Ook bedrijven waar dieren zijn afgemaakt, kunnen een schadevergoeding krijgen."
                            }
                        ]
                    }
