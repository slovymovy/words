                                                "example_id": "8be371ce-6d45-4bc2-a2e2-75c663559a85",
                                                "sense_id": "046d1099-0f0a-315e-a46b-7ce140c118bc",
                                                "text": "όταν ολοκληρωθεί η διαδικασία ανάδειξης τακτικών μελών, το συλλογικό όργανο της διοίκησης αποκτά νομική υπόσταση"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4595984-3483-3db1-8bbb-d93d4b274ca6",
                                        "entry_id": "fba80dbc-f326-33f6-bb3c-9306ecc5c38e",
                                        "glosses": [
