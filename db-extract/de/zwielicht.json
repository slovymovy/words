                        ],
                        "form": "dem Zwielichte"
                    },
                    {
                        "form_id": "8c964402-240a-4d6b-a952-a5561b66bec8",
                        "entry_id": "06def71e-e7b1-3979-9a2c-603c44fc7edb",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Zwielicht"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6dd94caf-60ad-313b-901d-6ec09ceeab84",
                        "entry_id": "06def71e-e7b1-3979-9a2c-603c44fc7edb",
                        "glosses": [
                            "Licht, das sich in der Dämmerung einstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dccca7a-c617-4919-af12-2e91a3363b5e",
                                "sense_id": "6dd94caf-60ad-313b-901d-6ec09ceeab84",
                                "text": "Im Zwielicht kann man nicht gut lesen."
                            },
                            {
                                "example_id": "cee5909a-a186-4a85-b08b-4d1f2f3095fd",
                                "sense_id": "6dd94caf-60ad-313b-901d-6ec09ceeab84",
                                "text": "Nachdem sich ihre Augen an das Zwielicht gewöhnt hatten, konnte sie das Scheunetor am anderen Ende des Sattelplatzes ausmachen."
                            },
                            {
                                "example_id": "800d4a15-9221-42c2-b0a8-cb80ef34a75b",
                                "sense_id": "6dd94caf-60ad-313b-901d-6ec09ceeab84",
                                "text": "„Durch ein Zwielicht, das so regungslos, so weit wie eine Nacht auf See ist, fahren sie dahin.“"
                            },
                            {
                                "example_id": "5da47fa4-2f80-4118-9ff2-a535709e8e86",
                                "sense_id": "6dd94caf-60ad-313b-901d-6ec09ceeab84",
                                "text": "„Eiríkur saß im regengrauen Zwielicht der Julinacht im Wohnzimmer, und nach und nach kam ihm der Gedanke, dass er nicht nur seine Mutter umgebracht hatte, sondern auf gewisse Weise auch seinen Vater; zumindest hatte er dessen Lebensfreude getötet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a652b15c-3703-3b85-baec-f55ebc49a80e",
                        "entry_id": "06def71e-e7b1-3979-9a2c-603c44fc7edb",
                        "glosses": [
                            "Licht, das zustande kommt, wenn gleichzeitig unterschiedliche Lichtquellen wahrgenommen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f1013b4-18e4-4a18-ba49-fdb171d4f7a8",
                                "sense_id": "a652b15c-3703-3b85-baec-f55ebc49a80e",
                                "text": "„Ein anderes Mädchen tänzelt im Brooklyner Zwielicht vorüber, und Riesel, dieser Rowdy, stelzt hinter ihr her und bewegt sich wie ein Affe.“"
                            },
                            {
                                "example_id": "4317fb27-38a4-4c49-b304-33f4f6044c06",
                                "sense_id": "a652b15c-3703-3b85-baec-f55ebc49a80e",
                                "text": "„Als Roman Bertinis Augen sich an das Zwielicht gewöhnt hatten, entdeckte er hinten links an der Wand das Loch.“"
                            },
                            {
                                "example_id": "a409e7cd-0cd7-40d3-afb8-8f74db0487ae",
                                "sense_id": "a652b15c-3703-3b85-baec-f55ebc49a80e",
                                "text": "„Hatte man sich an das Zwielicht gewöhnt, verlor sich auch der Schimmer des Unwirklichen, der wie Patina über Menschen und Dingen schwebte.“"
                            },
                            {
                                "example_id": "c039f06e-7762-4bf7-ada8-288a63ca08fe",
                                "sense_id": "a652b15c-3703-3b85-baec-f55ebc49a80e",
                                "text": "„Die Worte wehten im Zwielicht hin und her, sie waren ohne Bedeutung und das, was von Bedeutung war, war ohne Worte, und man konnte nicht darüber sprechen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "3222c9f2-f6aa-3e17-8f78-d146984ffaa1",
                        "entry_id": "06def71e-e7b1-3979-9a2c-603c44fc7edb",
                        "glosses": [
                            "unklarer Zustand, der oftmals Formen der Illegalität andeutet"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "6f098cee-cb92-477e-96d5-ce1938cc23cf",
                                "sense_id": "3222c9f2-f6aa-3e17-8f78-d146984ffaa1",
                                "text": "Manche Banken sind durch ihr Geschäftsgebaren ins Zwielicht geraten."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "561a7aef-f3cd-4a9b-b6f0-5c97e209abdc",
                        "source_entry_id": "06def71e-e7b1-3979-9a2c-603c44fc7edb",
                        "source_sense_id": "6dd94caf-60ad-313b-901d-6ec09ceeab84",
                        "source_sense_description": "Licht, das sich in der Dämmerung einstellt",
                        "target_lang_word": "twilight",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "twilight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a9d76f7c-754c-3722-b9b7-ae38e584a7c1",
                                        "entry_id": "8a288260-972d-324c-bd4f-61f4e79622c3",
                                        "glosses": [
                                            "The soft light in the sky seen before the rising and (especially) after the setting of the sun, occasioned by the illumination of the earth’s atmosphere by the direct rays of the sun and their reflection on the earth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "139c654f-2701-43e8-b196-eb9ecdaefdf8",
                                                "sense_id": "a9d76f7c-754c-3722-b9b7-ae38e584a7c1",
                                                "text": "Near-synonym: half-light"
                                            },
                                            {
                                                "example_id": "9e841ad3-a0d3-4997-8e06-93b3e952020e",
                                                "sense_id": "a9d76f7c-754c-3722-b9b7-ae38e584a7c1",
                                                "text": "I could just make out her face in the twilight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59b56e68-0eb1-3728-a74a-eaaf0d1aaa23",
                                        "entry_id": "8a288260-972d-324c-bd4f-61f4e79622c3",
                                        "glosses": [
                                            "The time when said light is visible; the period between daylight and darkness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a8c779b-0bc2-4e22-8281-dc9676ab6da3",
                                                "sense_id": "59b56e68-0eb1-3728-a74a-eaaf0d1aaa23",
                                                "text": "It was twilight by the time I got back home."
                                            },
                                            {
                                                "example_id": "e99ecff9-5aa3-43d4-b499-f5f9a4fb4378",
                                                "sense_id": "59b56e68-0eb1-3728-a74a-eaaf0d1aaa23",
                                                "text": "At twilight in the summer there is never anybody to fear—man, woman, or cat—in the chambers and at that hour the mice come out. They do not eat parchment or foolscap or red tape, but they eat the luncheon crumbs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3f480d1-670b-3255-8edb-ccc82ad2dabb",
                                        "entry_id": "8a288260-972d-324c-bd4f-61f4e79622c3",
                                        "glosses": [
                                            "Any faint light through which something is seen."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "399a1ac8-1115-4635-bb06-df847497f4f0",
                                                "sense_id": "b3f480d1-670b-3255-8edb-ccc82ad2dabb",
                                                "text": "Two women, Eusabio’s wife and sister, looked on from the deep twilight of the hut."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af7fea1b-4fb8-3ce8-bf7c-201dde43ab51",
                                        "entry_id": "8a288260-972d-324c-bd4f-61f4e79622c3",
                                        "glosses": [
                                            "The time when the sun is less than 18° below the horizon."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1ae92643-6155-35fd-a2d6-552f04e3602d",
                                        "entry_id": "8a288260-972d-324c-bd4f-61f4e79622c3",
                                        "glosses": [
                                            "An in-between or fading condition through which something is perceived."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89174f90-27e3-4411-bce4-b801125cf05f",
                                                "sense_id": "1ae92643-6155-35fd-a2d6-552f04e3602d",
                                                "text": "“They have not enough heart,” said Edith, with a smile. The very twilight of a smile: so singularly were its light and darkness blended."
                                            },
                                            {
                                                "example_id": "65f71247-2743-449d-9f57-000396575ad9",
                                                "sense_id": "1ae92643-6155-35fd-a2d6-552f04e3602d",
                                                "text": "The twilight of one's life"
                                            },
                                            {
                                                "example_id": "20609165-7131-49e6-88a1-0b45937db4a6",
                                                "sense_id": "1ae92643-6155-35fd-a2d6-552f04e3602d",
                                                "text": ", Book IV, Chapter XIV\nThe twilight […] of probability."
                                            }
                                        ]
                                    }
                                ]
                            },
