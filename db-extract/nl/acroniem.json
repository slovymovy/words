                ],
                "senses": [
                    {
                        "sense_id": "53c09ff2-7ee4-3578-948a-ef019a8a7a6f",
                        "entry_id": "2a694324-55e8-3564-97b3-63bf7b557348",
                        "glosses": [
                            "woord bestaande uit de beginletters van andere woorden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "900d91f9-3b78-459d-ad86-02853976ba98",
                                "sense_id": "53c09ff2-7ee4-3578-948a-ef019a8a7a6f",
                                "text": "Laser is een acroniem van 'light amplification by stimulated emission of radiation'."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "244ad567-010f-4c3a-916b-c86fb99867a3",
                        "source_entry_id": "2a694324-55e8-3564-97b3-63bf7b557348",
                        "source_sense_id": "53c09ff2-7ee4-3578-948a-ef019a8a7a6f",
                        "target_lang_word": "Akronym",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Akronym",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db03fb3e-f098-3c58-af56-90e69999a4e8",
                                        "entry_id": "2f3edd6a-c9e2-315d-b649-f1eb2b124dcb",
                                        "glosses": [
                                            "eine Abkürzung, die als eigenes Wort gesprochen wird; bezeichnet ein Kurzwort, das aus den Anfangsbuchstaben oder -silben von mehreren Wörtern oder aus einem Kompositum entstanden ist"
                                        ],
                                        "tags": [
                                            "im weiteren Sinne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d93bc57-7ff9-45d0-b7dd-41d20d4ff89f",
                                                "sense_id": "db03fb3e-f098-3c58-af56-90e69999a4e8",
                                                "text": "„Viele Akronyme – so nennt man die Kunstgebilde aus Anfangsbuchstaben bzw. Silben von Wörtern – sind allerdings inzwischen so geläufig geworden, daß man sie gar nicht mehr als solche erkennt.“"
                                            },
                                            {
                                                "example_id": "f4cc2b17-fde1-4390-9dc5-ef777e84cede",
                                                "sense_id": "db03fb3e-f098-3c58-af56-90e69999a4e8",
                                                "text": "„UNO“, „UNESCO“, „DOPA“, „GNU“ und „EDEKA“ sind Akronyme."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d98dfe2f-8cd0-3cf8-887c-524c6d3375de",
                                        "entry_id": "2f3edd6a-c9e2-315d-b649-f1eb2b124dcb",
                                        "glosses": [
                                            "Kurzwort, das aus den Anfangsbuchstaben mehrerer Wörter gebildet ist"
                                        ],
                                        "tags": [
                                            "im engeren Sinne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7ea34ae-28a3-47e5-ab33-13735e1ae42e",
                                                "sense_id": "d98dfe2f-8cd0-3cf8-887c-524c6d3375de",
                                                "text": "„UNO“, „UNESCO“, „DOPA“, „GNU“ und „EDEKA“ sind Akronyme."
                                            },
                                            {
                                                "example_id": "f1b9ff0c-9cae-4678-88c3-fb79e15b62dd",
                                                "sense_id": "d98dfe2f-8cd0-3cf8-887c-524c6d3375de",
                                                "text": "„Die Versalien des Akronyms zwingen den Leser dazu, nicht den Lautwert eines Buchstabens zu sprechen, sondern seinen Namen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "835c6f92-d35e-4bed-ad0b-61dea2616fa0",
                        "source_entry_id": "2a694324-55e8-3564-97b3-63bf7b557348",
                        "source_sense_id": "53c09ff2-7ee4-3578-948a-ef019a8a7a6f",
                        "target_lang_word": "acronym",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acronym",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2ca2e51-ef4f-353f-924b-9933328d2249",
                                        "entry_id": "3ca80629-6bcd-3484-9950-d885533e3aef",
                                        "glosses": [
                                            "An abbreviation formed by the initial letters of other words.",
                                            "Generally such abbreviations, including those pronounced as individual letters (initialisms such as \\\"TNT\\\")."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "224bf5d4-bcad-468a-b790-293bf3ffe7d7",
                                                "sense_id": "f2ca2e51-ef4f-353f-924b-9933328d2249",
                                                "text": "Pee-gee-enn. It's an acronym, that's what it is. That's what they call words made up of initials."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2cc822d-905d-39cb-b61b-6b13af920dc7",
                                        "entry_id": "3ca80629-6bcd-3484-9950-d885533e3aef",
                                        "glosses": [
                                            "An abbreviation formed by the initial letters of other words.",
                                            "Exclusively such abbreviations when pronounced as a word (as \\\"laser\\\" or \\\"NATO\\\")."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "528dde44-2341-429f-abdc-281f77aa64dd",
                                                "sense_id": "d2cc822d-905d-39cb-b61b-6b13af920dc7",
                                                "text": "Some teachers festoon every spare inch of wall with vocabulary choices or maths techniques to use, which look great at first, but to some children might appear quite daunting. You'll probably see unfamiliar acronyms such as Walt (We Are Learning To). Be sure to ask what they stand for and how they are used in practice."
                                            },
                                            {
                                                "example_id": "d51ee229-a35f-480c-993a-eada4ce53cd0",
                                                "sense_id": "d2cc822d-905d-39cb-b61b-6b13af920dc7",
                                                "text": "Traders have reportedly come up with the acronym TACO, which stands for “Trump always chickens out,” to take advantage of the trade environment created by the president’s habit of threatening to impose tariffs on countries, and then backing off at the last moment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96fb985a-a6ed-3bfd-b18e-3a0712f26d1d",
                                        "entry_id": "3ca80629-6bcd-3484-9950-d885533e3aef",
                                        "glosses": [
                                            "An abbreviation formed by the beginning letters or syllables of other words (as \\\"Benelux\\\")."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e54a5f48-efbf-42ed-950f-55493fd665e2",
                                                "sense_id": "96fb985a-a6ed-3bfd-b18e-3a0712f26d1d",
                                                "text": "Acronyms or telescoped names like nabisco from National Biscuit Company."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "acronym",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3d6d3a1-1a41-37c2-9b6c-3ffbb4936f6c",
                                        "entry_id": "a67936bd-d1d4-37b8-9350-48e1e0c5813f",
                                        "glosses": [
                                            "To form into an acronym."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "30b8d9dc-f0c6-4828-9c4d-73bac3d64f2c",
                        "source_entry_id": "2a694324-55e8-3564-97b3-63bf7b557348",
                        "source_sense_id": "53c09ff2-7ee4-3578-948a-ef019a8a7a6f",
                        "target_lang_word": "acronyme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acronyme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e6ee2415-bbf2-33b0-a544-47e4aacb4252",
                                        "entry_id": "03b98a78-daa4-3db3-b323-4d5a24707c75",
                                        "glosses": [
                                            "Sigle qui se prononce comme un mot ordinaire, sans épeler les lettres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc5f7942-c4ee-4d6a-a35d-379ba2a5bd71",
                                                "sense_id": "e6ee2415-bbf2-33b0-a544-47e4aacb4252",
                                                "text": "Les informations figurant sur la fiche de données de sécurité doivent être exprimées dans des termes simples, clairs et précis, et il convient d’éviter le langage spécialisé, les acronymes et les abréviations."
                                            },
                                            {
                                                "example_id": "ff0ad930-00eb-4b57-a37a-e7cf22890f8e",
                                                "sense_id": "e6ee2415-bbf2-33b0-a544-47e4aacb4252",
                                                "text": "L’École de la transition écologique, Etre de son acronyme, propose des modules pratiques de mise en situation pour découvrir l’agriculture urbaine ou encore l’écoconstruction."
                                            },
                                            {
                                                "example_id": "2f4fe1fc-1838-4d6f-a96f-8af65476a517",
                                                "sense_id": "e6ee2415-bbf2-33b0-a544-47e4aacb4252",
                                                "text": "En général, on écrit un acronyme en majuscules, mais dans certains cas, comme cégep, sida ou radar, les acronymes sont devenus des noms communs ordinaires. Ils s’écrivent en minuscules et prennent l’accord du pluriel."
                                            },
                                            {
                                                "example_id": "ccdefe93-2dc1-41a1-b349-3ebbb349b1ca",
                                                "sense_id": "e6ee2415-bbf2-33b0-a544-47e4aacb4252",
                                                "text": "Laser, radar, ovni sont des acronymes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a79210a-2408-35a4-bb8a-c9c84e26fd48",
                                        "entry_id": "03b98a78-daa4-3db3-b323-4d5a24707c75",
                                        "glosses": [
                                            "Sigle."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "969137b9-cc5a-423a-bd95-af171b914afa",
                                                "sense_id": "1a79210a-2408-35a4-bb8a-c9c84e26fd48",
                                                "text": "Connu pour utiliser la palette de dessin limitée de Microsoft Word afin de créer des illustrations narratives, il est devenu le premier crypto-artiste d’Afrique dont les œuvres sont enregistrées sur la blockchain et vendues en jetons non fongibles (NFT, de son acronyme anglais)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
