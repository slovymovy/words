                "senses": [
                    {
                        "sense_id": "146e6d28-9df2-3860-bb95-ea5a34148294",
                        "entry_id": "bf1f87d8-4c39-382d-81d3-f08a83a80e9e",
                        "glosses": [
                            "ein Vorsitzender oder Präsident einer Partei"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33e10820-697d-40a9-bca5-ac4dd2fe21cc",
                                "sense_id": "146e6d28-9df2-3860-bb95-ea5a34148294",
                                "text": "„Die Schuld für die fehlenden Stimmen verortet Parteichef Westerwelle bei der Union.“"
                            },
                            {
                                "example_id": "7b927cc8-b1bb-4ec1-8106-04073877d01a",
                                "sense_id": "146e6d28-9df2-3860-bb95-ea5a34148294",
                                "text": "„Gerade ist Martin Schulz vom SPD-Vorstand als Parteichef nominiert und zum Kanzlerkandidaten gekürt worden.“"
                            },
                            {
                                "example_id": "2a16b70e-92cc-4d32-b857-c03fa8e7e7e6",
                                "sense_id": "146e6d28-9df2-3860-bb95-ea5a34148294",
                                "text": "„Denn die Rechtsanwaltskanzlei von Leo Specht, Freund und neuerdings auch Geschäftspartner des ehemaligen Kanzlers, befindet sich direkt vis-à-vis des altehrwürdigen Genossen-Hauptquartiers in der Löwelstraße, wo Gusenbauer in seinen acht Jahren als Parteichef im herzeigbaren Eckbüro im zweiten Stock zu residieren pflegte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
