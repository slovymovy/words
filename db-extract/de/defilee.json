                    }
                ],
                "senses": [
                    {
                        "sense_id": "8c4c3ea5-dc5c-36ce-8f8f-ce01bf6cf0e1",
                        "entry_id": "d60efb16-8ba4-3539-bcd1-32efa9c90e1c",
                        "glosses": [
                            "eine festliche, feierliche Aufstellung, Vorbeimarsch, Zurschaustellung, Präsentation; das Vorbeischreiten, Vorbeigehen, Vorbeimarschieren an oder von Personen von besonderem Interesse, Stellung oder Rang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c26c678-b51c-47f1-8765-4b78d967b9bb",
                                "sense_id": "8c4c3ea5-dc5c-36ce-8f8f-ce01bf6cf0e1",
                                "text": "Tausende sahen dem Defilee der Prominenten zu."
                            },
                            {
                                "example_id": "2de0f32c-8ae8-4d2a-81b6-b0c7364970e4",
                                "sense_id": "8c4c3ea5-dc5c-36ce-8f8f-ce01bf6cf0e1",
                                "text": "„Ich sah dieses imposante Defilee zum ersten Mal, doch die anderen Gäste, die es alle schon am Vorabend miterlebt hatten, strahlten vor Freude und brachten ihr erneutes Erstaunen zum Ausdruck.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c05909a6-8d5e-3ab7-9b33-f638ceae9185",
                        "entry_id": "d60efb16-8ba4-3539-bcd1-32efa9c90e1c",
                        "glosses": [
                            "Hohlweg"
                        ],
                        "tags": [
                            "veraltet für"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "64e7f697-1996-4005-8f17-ca2c58db8d1e",
                        "source_entry_id": "d60efb16-8ba4-3539-bcd1-32efa9c90e1c",
                        "source_sense_id": "8c4c3ea5-dc5c-36ce-8f8f-ce01bf6cf0e1",
                        "source_sense_description": "eine festliche, feierliche Aufstellung, Vorbeimarsch, Zurschaustellung, Präsentation",
                        "target_lang_word": "défilé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "défilé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "67632177-aff5-3df3-bbf8-bd052785af50",
                                        "entry_id": "2e03ea35-25e7-30d3-a5ff-827a5b1c640f",
                                        "glosses": [
                                            "Passage étroit où il ne peut passer que peu de personnes de front."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ad643f4-d093-4753-8bd4-7589ee6a8969",
                                                "sense_id": "67632177-aff5-3df3-bbf8-bd052785af50",
                                                "text": "Un agréable sentier, qui se faufile sous bois à travers les blocs éboulés sur les pentes, nous mena jusqu'aux maisons appelées la Malavisée, en face du pont de fer de Tournaveaux, près du promontoire que lèche la Semoy avant de s'engager dans les défilés de Phade."
                                            },
                                            {
                                                "example_id": "76aaa018-72e6-41c0-989e-f5f8bc1dbba8",
                                                "sense_id": "67632177-aff5-3df3-bbf8-bd052785af50",
                                                "text": "Après deux heures de marche nous atteignons le pied des Djebilat, à Souinia, et pénétrons dans un défilé serpentant entre des pentes raides, grises et arides. La piste se rétrécit par moments au point de devenir presque impraticable pour les bêtes chargées."
                                            },
                                            {
                                                "example_id": "117333a4-eb5d-4f36-8c92-ff1ee48d9a2e",
                                                "sense_id": "67632177-aff5-3df3-bbf8-bd052785af50",
                                                "text": "Mademoiselle, vous êtes à l’entrée de la vie, vous n’en connaissez pas les défilés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b52eb99-87d3-3eef-a862-20fc2da2cda6",
                                        "entry_id": "2e03ea35-25e7-30d3-a5ff-827a5b1c640f",
                                        "glosses": [
                                            "Déplacement ordonné d'une troupe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cd813d7-352d-42a2-897d-af10ebff91bf",
                                                "sense_id": "6b52eb99-87d3-3eef-a862-20fc2da2cda6",
                                                "text": "Là, j’assiste à la traversée de la vallée, sous les schrapnells allemands, par un bataillon d’infanterie venant d’Autrèches. Le défilé rapide de petites colonnes minces et nombreuses de fantassins grouillant au pas de gymnastique à travers champs ne manque pas de pittoresque ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43b6e582-c6f0-3b53-b131-283817d4eff2",
                                        "entry_id": "2e03ea35-25e7-30d3-a5ff-827a5b1c640f",
                                        "glosses": [
                                            "Marche d’une troupe qui défile devant un chef ou en parade."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2cf4f73-6f94-46bb-91d3-4975060d388c",
                                                "sense_id": "43b6e582-c6f0-3b53-b131-283817d4eff2",
                                                "text": "Les Syldaves et les Bordures n'ont qu'à bien se tenir. Ici, on ramasse les vieilles pétoires, on met un coup de peinture sur les zincs maculés d'huile et de rouille, histoire de faire bonne figure lors du prévisible défilé de la victoire, puis on s’apprête gaiement au massacre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef7631c2-48e7-3fc1-b170-de61b6063f06",
                                        "entry_id": "2e03ea35-25e7-30d3-a5ff-827a5b1c640f",
                                        "glosses": [
                                            "Ensemble de personnes ou de véhicules qui défilent."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4567668-9aaf-420b-a10c-a144b605135e",
                                                "sense_id": "ef7631c2-48e7-3fc1-b170-de61b6063f06",
                                                "text": "En rêvant de ce temps qui venait de finir, je suivais d’un regard distrait ce défilé cosmopolite."
                                            },
                                            {
                                                "example_id": "f20e8f1e-c296-4cee-a8bb-0cd0e9cc6f44",
                                                "sense_id": "ef7631c2-48e7-3fc1-b170-de61b6063f06",
                                                "text": "Le prêtre Gauchelin, du diocèse de Lisieux, assiste, durant une nuit de janvier 1092, au défilé de la Chevauchée infernale, cortège d’âmes captives entraînées par le démon en punition de leurs péchés ; parmi elles, il en reconnaît quelques-unes avec lesquelles il s’entretient."
                                            },
                                            {
                                                "example_id": "25a0aea9-799e-4597-8d2e-19b9468f6109",
                                                "sense_id": "ef7631c2-48e7-3fc1-b170-de61b6063f06",
                                                "text": "C'est durant près d'une lieue un défilé ininterrompu et très curieux, de voitures et de piétons, de bonnes femmes relevant leurs jupons et secouant les râchas de terre rouge, de bicyclistes, de gens de la montagne, descendus en Plaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2721b359-0921-38b3-bac6-de1548e3e65d",
                                        "entry_id": "2e03ea35-25e7-30d3-a5ff-827a5b1c640f",
                                        "glosses": [
                                            "Parade de mannequins pour la présentation d'attifiaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
