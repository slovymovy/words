                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "ca2cc0c1-bb16-4f07-a78f-d18fec1c0643",
                                "sense_id": "d734b764-c6f1-3bd7-9343-ecb77a173d0c",
                                "text": "15th c., Robert Henryson, The Testament of Cresseid, lines 213-214,\nThe secund steid to name hecht Ethios,\nQuhitlie and paill […]"
                            },
                            {
                                "example_id": "5cca32e3-e367-4028-831b-ad2b7dd9170b",
                                "sense_id": "d734b764-c6f1-3bd7-9343-ecb77a173d0c",
                                "text": "[…] among three to loue the worst of all, / A whitly wanton, with a veluet brow, / With two pitch balles stucke in her face for eyes."
                            },
                            {
                                "example_id": "f02f54af-fc86-4567-87a5-aeb691073ea8",
                                "sense_id": "d734b764-c6f1-3bd7-9343-ecb77a173d0c",
                                "text": "I perceive you know him, and am apt to believe also, That you were related one to another; for you have his whitely Look, a Cast like his with your Eye, and your Speech is much alike."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
