                        "cross_references": [
                            {
                                "target_word": "workstation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30fdf998-02d0-37a8-a353-acc8985aa4d3",
                                        "entry_id": "00b4933a-a7a6-3ae0-a766-9ebd8af353bc",
                                        "glosses": [
                                            "A desktop computer, normally more powerful than a normal PC and often dedicated to a specific task, such as graphics."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9866f788-d14b-4838-8715-cf54d8dee025",
                                                "sense_id": "30fdf998-02d0-37a8-a353-acc8985aa4d3",
                                                "text": "All train movements on the Far North Line have been controlled by a Radio Electronic Token Block workstation at Inverness since 1995, having already been introduced on the Kyle Line some 11 years earlier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16a6df8f-a2c3-3316-8b0b-4395b8defd9d",
                                        "entry_id": "00b4933a-a7a6-3ae0-a766-9ebd8af353bc",
                                        "glosses": [
                                            "An area, at a workplace, for a single worker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bec38d92-5b13-4632-92cb-b14e6d0b753d",
                                                "sense_id": "16a6df8f-a2c3-3316-8b0b-4395b8defd9d",
                                                "text": "Holonyms: workplace, workstead"
                                            },
                                            {
                                                "example_id": "c459d0a7-7674-45b0-93b5-7cbd6ae3e880",
                                                "sense_id": "16a6df8f-a2c3-3316-8b0b-4395b8defd9d",
                                                "text": "Near-synonym: workspace"
                                            },
                                            {
                                                "example_id": "3f8f9ba6-a640-4e48-9347-850a6a3de74f",
                                                "sense_id": "16a6df8f-a2c3-3316-8b0b-4395b8defd9d",
                                                "text": "Lamb ignored her, surveying her team instead, who were at their own or each other's workstations, and engrossed in their current tasks, and studying every move he made."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
