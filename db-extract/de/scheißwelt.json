                    {
                        "sense_id": "39482a59-cf8b-3e58-9cf9-d984a662dd2b",
                        "entry_id": "e17eb0f5-c6e4-38e2-a500-f0da5f8da7db",
                        "glosses": [
                            "schlechte Welt"
                        ],
