                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e05e117-d4e9-46ce-a303-ff9839371940",
                                "sense_id": "d54812ba-3b9f-3359-abe5-31b6768b49de",
                                "text": "Рыбный борщ печерский, бикус, борщ с кормленою уткою… да уже и не вспомню всех названий борщей, какие было подают!.."
                            },
                            {
                                "example_id": "234de309-2915-4e50-873e-f2a8ae88b83a",
                                "sense_id": "d54812ba-3b9f-3359-abe5-31b6768b49de",
                                "text": "В кошелке отвез на базар четыре пары кормленых уток, продал〈…〉"
                            }
                        ]
                    }
