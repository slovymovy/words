        "fr-extract.jsonl": [
            {
                "entry_id": "1ded5f6f-0c90-3371-b62a-95661cdbaa9e",
                "word": "fournaise",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e480354b-e51f-4404-bc54-577566949365",
                        "entry_id": "1ded5f6f-0c90-3371-b62a-95661cdbaa9e",
                        "tags": [
                            "plural"
                        ],
                        "form": "fournaises"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6e952c4e-fdd3-3d80-b310-1cc09ccb0601",
                        "entry_id": "1ded5f6f-0c90-3371-b62a-95661cdbaa9e",
                        "glosses": [
                            "Grand four où brûle un feu violent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "002a40c0-6bd7-45a4-a203-9c7bb4814771",
                                "sense_id": "6e952c4e-fdd3-3d80-b310-1cc09ccb0601",
                                "text": "Pendant que l’un d’eux battait le briquet et faisait de la lumière, l’autre étala le charbon sur le gril rouillé […] et commença de faire jouer le soufflet jusqu’à ce que le combustible fût devenu une fournaise rougeâtre."
                            }
                        ]
                    },
                    {
                        "sense_id": "a5ab12c5-c4d6-37da-987d-aaffd8e7097f",
                        "entry_id": "1ded5f6f-0c90-3371-b62a-95661cdbaa9e",
                        "glosses": [
                            "Calorifère, chaudière (appareil fabricant de la vapeur d’eau)."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "84d47831-048f-35df-bdb1-e6190f9b3c27",
                        "entry_id": "1ded5f6f-0c90-3371-b62a-95661cdbaa9e",
                        "glosses": [
                            "Grand feu ou incendie qui consume tout."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "db0b377c-ec16-4104-a49e-027db6c673f9",
                                "sense_id": "84d47831-048f-35df-bdb1-e6190f9b3c27",
                                "text": "C'est pourtant du sein de cette fournaise, d'où la salamandre elle-même ne sortirait que calcinée, que le lendemain d’héroïques pompiers de Rouen et d’Orléans ont eu le courage et le bonheur d’arracher le double du grand livre de l’État, dont l'autre exemplaire avait, dit-on, péri la veille dans l’incendie du ministère des finances."
                            },
                            {
                                "example_id": "f16d2d3b-050a-4fed-9fad-c249c88757ec",
                                "sense_id": "84d47831-048f-35df-bdb1-e6190f9b3c27",
                                "text": "Les bourreaux se précipitèrent sur eux et les jetèrent à nouveau dans la fournaise."
                            },
                            {
                                "example_id": "fd8cf0f6-df04-42be-bd5b-3186d7e7dbf0",
                                "sense_id": "84d47831-048f-35df-bdb1-e6190f9b3c27",
                                "text": "La partie basse de New York ne fut bientôt plus qu’une fournaise d’où nul n’avait chance d’échapper."
                            }
                        ]
                    },
                    {
                        "sense_id": "a3891a90-0f5d-343c-ae97-48ebc3f6e28c",
                        "entry_id": "1ded5f6f-0c90-3371-b62a-95661cdbaa9e",
                        "glosses": [
                            "Endroit où il fait très chaud."
                        ],
                        "tags": [
                            "familiar",
                            "hyperbole"
                        ],
                        "examples": [
                            {
                                "example_id": "ba74d5a6-b591-4075-b99e-0efac8e54ba7",
                                "sense_id": "a3891a90-0f5d-343c-ae97-48ebc3f6e28c",
                                "text": "Zanetta frissonna. Quelque chose d'ancien, de subtilement vivant se composait et se décomposait dans cette végétation au rythme ralenti par la fournaise de l'été."
                            },
                            {
                                "example_id": "3e958124-1ee5-4c12-ba36-4da68a1953f2",
                                "sense_id": "a3891a90-0f5d-343c-ae97-48ebc3f6e28c",
                                "text": "Après avoir traversé une chambre fraîche et sombre meublée de deux charpoy et préservée de la fournaise caniculaire par la taille minuscule des fenêtres, ils pénétrèrent dans une deuxième pièce, plus lumineuse, où se trouvaient deux lits […]."
                            },
                            {
                                "example_id": "9cf12354-469c-488c-b091-2f90a8c68847",
                                "sense_id": "a3891a90-0f5d-343c-ae97-48ebc3f6e28c",
                                "text": "Comment pouvez-vous tenir dans cette fournaise ? - Cette chambre est une vraie fournaise."
                            }
                        ]
                    },
                    {
                        "sense_id": "d8f10a4d-af67-37b8-8af0-73750172bfd0",
                        "entry_id": "1ded5f6f-0c90-3371-b62a-95661cdbaa9e",
                        "glosses": [
                            "Zone de combat."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "390afa30-6892-4712-ab63-897f4b33f5f9",
                                "sense_id": "d8f10a4d-af67-37b8-8af0-73750172bfd0",
                                "text": "Quatre classes d’individus bien distinctes s’agitent dans cette fournaise politique : les nobles ou gros, le clergé, la bourgeoisie, les paysans ou métayers."
                            },
                            {
                                "example_id": "336b6253-49a1-4be6-8c48-7645a1a58110",
                                "sense_id": "d8f10a4d-af67-37b8-8af0-73750172bfd0",
                                "text": "Bitche n’est plus qu’une vaste fournaise : le sifflement des obus, les craquements de l’incendie, l’effondrement des maisons, […], toutes les terreurs, tous les fracas emplissent l'air."
                            },
                            {
                                "example_id": "4a5fb0f2-f7bd-4981-884e-3ea1ecb690a4",
                                "sense_id": "d8f10a4d-af67-37b8-8af0-73750172bfd0",
                                "text": "L’édifice entier de la civilisation se lézardait, croulait et s’anéantissait dans la fournaise de la guerre."
                            },
                            {
                                "example_id": "fed69724-ab3e-46e0-838f-ac62436fcc24",
                                "sense_id": "d8f10a4d-af67-37b8-8af0-73750172bfd0",
                                "text": "J'ai vu certes ces foules paisibles soulevées par la voix d'un prophète et s'en allant fondre à sa suite dans la fournaise du combat."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "206f5200-7b64-4285-8caf-f98a89be9bea",
                        "source_entry_id": "1ded5f6f-0c90-3371-b62a-95661cdbaa9e",
