                "senses": [
                    {
                        "sense_id": "90cdaebf-b4a6-35ae-8d18-17260637c516",
                        "entry_id": "98905bc4-0327-3c99-9046-d1055278cdad",
                        "glosses": [
                            "лингв. связанный, соотносящийся по значению с существительным энклитика; являющийся энклитикой"
                        ],
                        "tags": [],
