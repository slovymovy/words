                "senses": [
                    {
                        "sense_id": "509c795a-dad3-3b69-a470-4ef5a9354b5b",
                        "entry_id": "7edd2af6-84ff-3dbd-aabb-8eb8f6ccde45",
                        "glosses": [
                            "Faire perdre son caractère lié au monde à."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "728fd25f-4032-360e-8362-6b0d8e2bfb5c",
                        "entry_id": "7edd2af6-84ff-3dbd-aabb-8eb8f6ccde45",
                        "glosses": [
                            "Faire perdre son caractère mondain (lié à la société élégante et fortunée) à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "241a5a38-e8ed-48da-8167-ae5606b49895",
                                "sense_id": "728fd25f-4032-360e-8362-6b0d8e2bfb5c",
                                "text": "Chère amie, M. de Montbrun me juge mal. Je ne demande qu’à me démondaniser."
                            },
                            {
                                "example_id": "dbd4f589-faf7-41ab-95dd-1a297787cf52",
                                "sense_id": "728fd25f-4032-360e-8362-6b0d8e2bfb5c",
                                "text": "Tantôt, il dînait entre deux duchesses endiamantées, tantôt il allait renverser des tables et se démondaniser dans les cafés de Belleville ou des Halles."
                            },
                            {
                                "example_id": "10d75046-df01-4987-8aec-cea476b6231c",
                                "sense_id": "728fd25f-4032-360e-8362-6b0d8e2bfb5c",
                                "text": "J’aurai tant de plaisir à vous démondaniser !"
                            }
                        ]
                    }
                ],
