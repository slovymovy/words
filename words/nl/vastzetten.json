{
    "word_family": [
        "vast",
        "zet",
        "vastzetting"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2b2305d6-4ef6-30a8-a680-8117e7310a67",
                    "sense_definition": "Iets zodanig bevestigen dat het niet meer kan bewegen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bevestigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bij het aanmeren van het schip moest men eerst het schip <w>vastzetten</w> voordat men kon overladen.",
                            "target_lang_translations": {
                                "en": "When docking the ship, one had to <w>fasten</w> the ship first before unloading could begin."
                            }
                        },
                        {
                            "text": "De timmerman moest de losse plank met schroeven <w>vastzetten</w>.",
                            "target_lang_translations": {
                                "en": "The carpenter had to <w>fix</w> the loose board with screws."
                            }
                        }
                    ],
                    "synonyms": [
                        "bevestigen",
                        "vastmaken"
                    ],
                    "antonyms": [
                        "losmaken"
                    ],
                    "common_phrases": [
                        "iets vastzetten"
                    ],
                    "target_lang_definitions": {
                        "en": "To fasten or attach something so that it can no longer move."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fasten",
                                "target_lang_sense_clarification": "To attach or connect in a secure manner."
                            },
                            {
                                "target_lang_word": "fix",
                                "target_lang_sense_clarification": "To attach or hold in place."
                            },
                            {
                                "target_lang_word": "secure",
                                "target_lang_sense_clarification": "To make fast or render incapable of escaping."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0dc7f1ae-d0ea-3eff-9ff2-e4964d09c50e",
                    "sense_definition": "Geld voor een bepaalde periode op een spaarrekening plaatsen waarbij men er niet direct over kan beschikken.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "financien",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij besloot haar spaargeld voor vijf jaar te <w>vastzetten</w> tegen een hogere rente.",
                            "target_lang_translations": {
                                "en": "She decided to <w>lock away</w> her savings for five years at a higher interest rate."
                            }
                        },
                        {
                            "text": "Het is verstandig om een deel van je vermogen te <w>vastzetten</w> voor de toekomst.",
                            "target_lang_translations": {
                                "en": "It is wise to <w>tie up</w> a portion of your assets for the future."
                            }
                        }
                    ],
                    "common_phrases": [
                        "geld vastzetten"
                    ],
                    "target_lang_definitions": {
                        "en": "To place money in a savings account for a fixed period during which it cannot be accessed."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lock away",
                                "target_lang_sense_clarification": "To commit funds to a long-term account."
                            },
                            {
                                "target_lang_word": "tie up",
                                "target_lang_sense_clarification": "To make capital unavailable for immediate use."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2fd29a9f-293d-3086-82a0-f5aea8d3aa40",
                    "sense_definition": "Iemand in een gevangenis opsluiten.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gevangenis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politie moest de gevaarlijke crimineel direct <w>vastzetten</w>.",
                            "target_lang_translations": {
                                "en": "The police had to <w>lock up</w> the dangerous criminal immediately."
                            }
                        },
                        {
                            "text": "Na de overval werd de verdachte voorlopig <w>vastgezet</w> in afwachting van het proces.",
                            "target_lang_translations": {
                                "en": "After the robbery, the suspect was <w>detained</w> pending trial."
                            }
                        }
                    ],
                    "synonyms": [
                        "opsluiten",
                        "arresteren"
                    ],
                    "antonyms": [
                        "vrijlaten"
                    ],
                    "common_phrases": [
                        "iemand vastzetten"
                    ],
                    "target_lang_definitions": {
                        "en": "To lock someone up in a prison."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lock up",
                                "target_lang_sense_clarification": "To imprison someone."
                            },
                            {
                                "target_lang_word": "incarcerate",
                                "target_lang_sense_clarification": "To put or confine in a prison."
                            },
                            {
                                "target_lang_word": "detain",
                                "target_lang_sense_clarification": "To keep someone in official custody."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}