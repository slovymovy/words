                                "target_senses": [
                                    {
                                        "sense_id": "99642dc6-e154-3c73-8fd4-51f20e7a382c",
                                        "entry_id": "b857aca4-c55b-3335-9a24-7daf54c21a94",
                                        "glosses": [
                                            "Weichtier aus der Klasse der Kopffüßer mit zehn Fangarmen und einem chitinösen Schulp, sowie einem Schnabel, der dem von Papageien ähnelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "138ebedb-e4a6-4017-bc77-2ec75a7087a0",
                                                "sense_id": "99642dc6-e154-3c73-8fd4-51f20e7a382c",
                                                "text": "„Ob Tintenfisch, Kalmar, Krake oder Octopus: Alle diese Verwandten der Muscheln und Schnecken pressen bei Gefahr Wasser aus ihrer Mantelhöhle.“"
                                            },
                                            {
                                                "example_id": "4b97d1fd-191a-48ab-845b-a9bafce9b146",
                                                "sense_id": "99642dc6-e154-3c73-8fd4-51f20e7a382c",
                                                "text": "„Kalmare sind große, schnell schwimmende und hochspezialisierte Mollusken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Kalmar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "31956d2a-a250-3a3c-b424-a3702f8b6601",
                                        "entry_id": "0b5a809b-f4d8-3461-83c5-554a6f69d63c",
                                        "glosses": [
                                            "schwedische Hafenstadt; Hauptstadt der Provinz Kalmar län"
                                        ],
