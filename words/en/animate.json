{
    "word_family": [
        "animation",
        "animator",
        "inanimate",
        "reanimate"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8e447227-cba9-33d5-b090-a650d332f908",
                    "sense_definition": "To give the appearance of movement to drawings, models, or digital figures.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The studio used advanced software to <w>animate</w> the cartoon characters.",
                            "target_lang_translations": {
                                "ru": "Студия использовала передовое программное обеспечение, чтобы <w>анимировать</w> персонажей мультфильма."
                            }
                        },
                        {
                            "text": "If we <w>animate</w> the 3D model, we can see how the machine works.",
                            "target_lang_translations": {
                                "ru": "Если мы <w>оживим</w> 3D-модель, то сможем увидеть, как работает эта машина."
                            }
                        }
                    ],
                    "common_phrases": [
                        "animate characters",
                        "animate images"
                    ],
                    "target_lang_definitions": {
                        "ru": "Создавать иллюзию движения у рисунков, моделей или цифровых персонажей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "анимировать",
                                "target_lang_sense_clarification": "создавать анимацию"
                            },
                            {
                                "target_lang_word": "оживлять",
                                "target_lang_sense_clarification": "приводить в движение на экране"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f1a426d1-c0ff-3a97-be2d-f29c48761d8b",
                    "sense_definition": "To give energy, spirit, or enthusiasm to someone or something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "spirit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His passionate speech helped to <w>animate</w> the crowd of supporters.",
                            "target_lang_translations": {
                                "ru": "Его пламенная речь помогла <w>воодушевить</w> толпу сторонников."
                            }
                        },
                        {
                            "text": "A sudden smile seemed to <w>animate</w> her tired face.",
                            "target_lang_translations": {
                                "ru": "Внезапная улыбка словно <w>оживила</w> её усталое лицо."
                            }
                        }
                    ],
                    "synonyms": [
                        "enliven",
                        "energize",
                        "invigorate",
                        "stimulate"
                    ],
                    "common_phrases": [
                        "animate the crowd",
                        "animate the discussion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Придавать энергию, бодрость или энтузиазм кому-либо или чему-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оживлять",
                                "target_lang_sense_clarification": "делать более бодрым, активным"
                            },
                            {
                                "target_lang_word": "воодушевлять",
                                "target_lang_sense_clarification": "вселять энтузиазм"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1f3e4ff6-77cc-3eba-8529-5c0a7b46937c",
                    "sense_definition": "Living; having life rather than being dead or non-living.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "living",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scientists study the difference between <w>animate</w> organisms and non-living matter.",
                            "target_lang_translations": {
                                "ru": "Ученые изучают разницу между <w>живыми</w> организмами и неживой материей."
                            }
                        },
                        {
                            "text": "All <w>animate</w> beings need water and nourishment to survive.",
                            "target_lang_translations": {
                                "ru": "Всем <w>живым</w> существам нужны вода и пища, чтобы выжить."
                            }
                        }
                    ],
                    "synonyms": [
                        "alive",
                        "living"
                    ],
                    "antonyms": [
                        "inanimate",
                        "lifeless"
                    ],
                    "common_phrases": [
                        "animate beings",
                        "animate matter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Живой, обладающий жизнью, в противоположность мертвому или неживому."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "живой",
                                "target_lang_sense_clarification": "обладающий жизнью"
                            },
                            {
                                "target_lang_word": "одушевлённый",
                                "target_lang_sense_clarification": "наделённый жизнью, душой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ddf352cc-1a8f-330b-85c5-5e86514c4c8f",
                    "sense_definition": "Full of life, action, or spirit; lively.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "spirit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was an engaging and <w>animate</w> speaker during the conference.",
                            "target_lang_translations": {
                                "ru": "На конференции она была увлекательным и <w>энергичным</w> оратором."
                            }
                        },
                        {
                            "text": "The room was filled with warm and <w>animate</w> conversation.",
                            "target_lang_translations": {
                                "ru": "Комната была наполнена теплой и <w>оживленной</w> беседой."
                            }
                        }
                    ],
                    "synonyms": [
                        "active",
                        "dynamic",
                        "energetic",
                        "lively",
                        "vivacious"
                    ],
                    "antonyms": [
                        "quiescent",
                        "static"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полный жизни, активности или энтузиазма; оживленный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оживлённый",
                                "target_lang_sense_clarification": "активный, полный энергии"
                            },
                            {
                                "target_lang_word": "живой",
                                "target_lang_sense_clarification": "выразительный, динамичный"
                            },
                            {
                                "target_lang_word": "энергичный",
                                "target_lang_sense_clarification": "полный сил и задора"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0d72a15-61b9-3980-b1cd-2646ff16bce5",
                    "sense_definition": "Belonging to a grammatical class of words referring to living beings.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nouns can be singular or plural, and one of two genders, <w>animate</w> or inanimate.",
                            "target_lang_translations": {
                                "ru": "Существительные могут быть единственного или множественного числа и одного из двух классов: <w>одушевленные</w> или неодушевленные."
                            }
                        },
                        {
                            "text": "In this language, <w>animate</w> subjects require a specific prefix on the verb.",
                            "target_lang_translations": {
                                "ru": "В этом языке <w>одушевленные</w> подлежащие требуют особого префикса у глагола."
                            }
                        }
                    ],
                    "antonyms": [
                        "inanimate"
                    ],
                    "common_phrases": [
                        "animate noun"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к грамматическому классу слов, обозначающих живые существа."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одушевлённый",
                                "target_lang_sense_clarification": "лингвистическая категория"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d31b53ab-9fb2-37d2-a88d-9dde85759ecf",
                    "sense_definition": "Having the ability to move or being in motion.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The camera tracked every <w>animate</w> object across the field.",
                            "target_lang_translations": {
                                "ru": "Камера отслеживала каждый <w>движущийся</w> объект на поле."
                            }
                        },
                        {
                            "text": "Under the microscope, tiny <w>animate</w> creatures moved rapidly.",
                            "target_lang_translations": {
                                "ru": "Под микроскопом быстро перемещались крошечные <w>подвижные</w> существа."
                            }
                        }
                    ],
                    "synonyms": [
                        "dynamic",
                        "kinetic",
                        "mobile",
                        "motile"
                    ],
                    "antonyms": [
                        "sessile",
                        "static"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способный к самостоятельному движению или находящийся в движении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "движущийся",
                                "target_lang_sense_clarification": "находящийся в движении"
                            },
                            {
                                "target_lang_word": "подвижный",
                                "target_lang_sense_clarification": "обладающий способностью двигаться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40fbdf3c-e371-34b1-85e6-9a17ddbd642c",
                    "sense_definition": "Inflected to agree with an <w>animate</w> noun or pronoun.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The adjective takes an <w>animate</w> suffix when it modifies a person.",
                            "target_lang_translations": {
                                "ru": "Прилагательное принимает <w>одушевленный</w> суффикс, когда оно определяет человека."
                            }
                        },
                        {
                            "text": "Learners must distinguish between the <w>animate</w> and inanimate forms of the verb.",
                            "target_lang_translations": {
                                "ru": "Учащиеся должны различать <w>одушевленные</w> и неодушевленные формы глагола."
                            }
                        }
                    ],
                    "antonyms": [
                        "inanimate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изменяющийся для согласования с одушевленным существительным или местоимением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "одушевлённый",
                                "target_lang_sense_clarification": "о грамматической форме согласования"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}