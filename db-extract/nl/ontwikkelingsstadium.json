                        "glosses": [
                            "mate waarin een product tot iets bruikbaars en verkoopbaars is ontwikkeld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55d6f58a-6248-4a90-808e-d35add14ef58",
                                "sense_id": "4362236a-144a-3790-ab06-6f239fb614e5",
                                "text": "Veel ontwerpen sneuvelen al in het ontwikkelingsstadium, als een deel van de kosten dus al gemaakt is. Ontwikkelingskosten kunnen ook omhoog gaan als bijvoorbeeld grondstoffen (tijdelijk) schaars zijn."
                            },
                            {
                                "example_id": "2b9870cf-fe09-495d-830b-994b673dcd46",
                                "sense_id": "4362236a-144a-3790-ab06-6f239fb614e5",
                                "text": "Momenteel bevindt de Manta5 zich in het laatste ontwikkelingsstadium. Begin 2019 wordt de productie opgestart. De prijs ligt waarschijnlijk rond de 6.000 dollar. Geïnteresseerden kunnen zich nu al registreren om er een aan te schaffen."
                            }
                        ]
