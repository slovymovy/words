                "senses": [
                    {
                        "sense_id": "85b1378c-b8a3-3d99-8ed1-2d6b70de852e",
                        "entry_id": "62bd7ccb-3158-3db3-831f-ecb915585e7b",
                        "glosses": [
                            "eine Frau, die wegen ihrer außergewöhnlichen Begabung berühmt ist, zum Beispiel als Sängerin oder Schauspielerin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d62da5e-ecfc-4e05-8fc9-c4ea44abc2bc",
                                "sense_id": "85b1378c-b8a3-3d99-8ed1-2d6b70de852e",
                                "text": "Maria Callas war eine berühmte Sopranistin und wurde oft als Diva bezeichnet."
                            },
                            {
                                "example_id": "9e6dd3bb-a501-4e00-887e-e1f7b68372cc",
                                "sense_id": "85b1378c-b8a3-3d99-8ed1-2d6b70de852e",
                                "text": "„In dieser Atmosphäre vereinbarten sie ein Treffen in der Nacht, in der auch das Konzert der Diva der Eisenbahntrassen stattfand.“"
                            },
                            {
                                "example_id": "015f970e-22f8-4b1f-847a-6110a50496c3",
                                "sense_id": "85b1378c-b8a3-3d99-8ed1-2d6b70de852e",
                                "text": "„Die Welt fordert bald von ihm Interviews, politische Stellungnahmen, später, wenn er an der Seite der großen Divas Hollywoods zu sehen sein wird, füllt sein Name nicht mehr nur die Feuilletons und Literaturzeitschriften, sondern auch die Klatschspalten der Regenbogenpresse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2bd559d5-11fe-30f4-b9da-69bc455c30eb",
                        "entry_id": "62bd7ccb-3158-3db3-831f-ecb915585e7b",
                        "glosses": [
                            "Person (meist eine Frau, aber auch Mann), die durch exzentrische Allüren und Launenhaftigkeit auffällt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4214d485-f1ea-4e5e-a890-65c96e15d422",
                                "sense_id": "2bd559d5-11fe-30f4-b9da-69bc455c30eb",
                                "text": "Sie führt sich mal wieder auf wie eine Diva."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
