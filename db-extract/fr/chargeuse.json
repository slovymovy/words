                        "entry_id": "ef345975-4e34-31d5-8112-b9bd185da529",
                        "glosses": [
                            "Engin automoteur équipé à l’avant d’un godet relevable et servant à soulever, à déplacer des matériaux."
                        ],
                        "tags": [
                            "Engins"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "89c48640-555d-375f-8501-d51a070f65b7",
                        "entry_id": "ef345975-4e34-31d5-8112-b9bd185da529",
                        "glosses": [
                            "Machine servant à charger un camion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9eae43ea-deff-4032-b1e9-8a66d0b1df0d",
                                "sense_id": "89c48640-555d-375f-8501-d51a070f65b7",
                                "text": "Avec les autres candidates, elle a appris à opérer six genres de machineries lourdes comme les niveleuses, les bulldozers, les excavatrices, les chargeuses, les rétrocaveuses et les camions articulés à benne basculante."
                            }
                        ]
                    },
                    {
                        "sense_id": "baafeea2-bf56-3ec1-89e4-5a002c3b4762",
                        "entry_id": "ef345975-4e34-31d5-8112-b9bd185da529",
                        "glosses": [
                            "Véhicule transportant de la marchandise illicite, précédé d’une ouvreuse."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d4f359bc-10f3-36aa-be22-bf0b0ef7c8fc",
                        "entry_id": "ef345975-4e34-31d5-8112-b9bd185da529",
                        "glosses": [
                            "Ouvrière aux tailles qui charge le charbon dans les wagonets qui l’emportent, par les galeries de roulage, vers le puits d’extraction."
                        ],
                        "tags": [
