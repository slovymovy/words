                                "sense_id": "68058aec-11c3-3867-aaf1-5c0681003409",
                                "text": "De werkplek is uitgerust met alle benodigde apparatuur.",
                                "translation": "The workplace is equipped with all the necessary equipment.",
                                "english": "The workplace is equipped with all the necessary equipment."
                            },
                            {
                                "example_id": "55c7ab61-3cc4-4535-96d2-57a309f225a7",
                                "sense_id": "68058aec-11c3-3867-aaf1-5c0681003409",
                                "text": "Ze is erg blij met haar nieuwe werkplek.",
                                "translation": "She is very happy with her new workplace.",
