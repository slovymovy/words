                                        "entry_id": "b62d4ed4-46d9-3888-aff7-e80cadbd9159",
                                        "glosses": [
                                            "zielgerichtete, wirtschaftliche Nutzung und Zucht von domestizierten Tieren (Viehzucht)"
                                        ],
