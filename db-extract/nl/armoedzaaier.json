                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f27361d-a4a1-45ed-ae50-24c61b56c576",
                                "sense_id": "2b288a91-f0db-3270-96fd-fc73cedd093d",
                                "text": "Clara Wieck, dochter van een pianohandelaar en een sopraan, schreef haar eerste pianoconcert toen ze veertien was. Ze werd bewonderd door Goethe en Chopin, maakte concertreizen door heel Europa en gold als een van de grootste pianisten van haar tijd. Geen wonder dat pa Wieck het maar niks vond dat ze wilde trouwen met die armoedzaaier Robert Schumann. Wat verdient zo’n componist nou helemaal?"
                            }
                        ]
                    }
                ],
