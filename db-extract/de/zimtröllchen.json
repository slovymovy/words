                "senses": [
                    {
                        "sense_id": "34643f80-1e9d-30cb-8d1b-529d18262438",
                        "entry_id": "aa76e8c8-d795-3102-b0f6-b08cd3f405b9",
                        "glosses": [
                            "schneckenhausförmiges Gebäck, das nach Zimt schmeckt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac922f35-c192-4a9d-80f5-35ea0081edcc",
                                "sense_id": "34643f80-1e9d-30cb-8d1b-529d18262438",
                                "text": "„So war es auch damals mit den Zimtröllchen, die ich in der Frühstücksbox dabeihatte. Mama hatte vergessen, Brot zu kaufen, und Bargeld hatte sie auch keins, aber von den Zimtröllchen hatten wir gleich mehrere Tüten zu Hause auf Lager.“"
                            },
                            {
                                "example_id": "7b9a27d5-e013-41b1-a047-d428ab983ceb",
                                "sense_id": "34643f80-1e9d-30cb-8d1b-529d18262438",
                                "text": "„Doch als ich sehe, wie meine Mutter die Zimtröllchen mit Zuckerguss bestreicht, werde ich von einem Gefühl der Nostalgie ergriffen.“"
                            },
                            {
                                "example_id": "81d69e02-1609-4079-be32-7f5ae21cbf37",
                                "sense_id": "34643f80-1e9d-30cb-8d1b-529d18262438",
                                "text": "„Wenn sie diese Zimtröllchen sehen, fallen sie wahrscheinlich auf die Knie und fangen an, Hymnen zu singen.“"
                            },
                            {
                                "example_id": "3a4787d1-6e55-4c75-98a4-ee87ed45b3c0",
                                "sense_id": "34643f80-1e9d-30cb-8d1b-529d18262438",
                                "text": "„Sie war es, die ihn in die Lagerhallen begleitete und wissen wollte, wo kommt der Pfeffer her, wie entstehen die Zimtröllchen, wo wächst die Vanille am besten und welche Muskatnüsse sind die schmackhaftesten.“"
                            },
                            {
                                "example_id": "27a678ed-1c09-4844-88f1-450525929fa7",
                                "sense_id": "34643f80-1e9d-30cb-8d1b-529d18262438",
                                "text": "„Wie in ihrer Anzeigenkampagne versprochen, liefert die Happy Time Pizzeria innerhalb von dreißig Minuten, komplett mit einer kostenlosen Limo Large und Zimtröllchen als Nachspeise.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
