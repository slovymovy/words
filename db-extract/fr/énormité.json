                                                "sense_id": "527ee97c-fbd2-33b6-a348-238ab8adb50d",
                                                "text": "blunder a rook"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "458ccc61-f4b1-326d-8f8c-e5c359ffc2a4",
                                        "entry_id": "f16b146d-5d3e-3fff-90ce-cdfdceda1904",
                                        "glosses": [
                                            "To make a big mistake, especially when it is careless or stupid.",
                                            "To overlook the possibility of, or end up in, a specified undesirable situation after making a bad move."
                                        ],
                                        "tags": [
