                    "frequency": "Middle",
                    "semantic_group_id": "intuition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had a sudden <w>premonition</w> that something bad was going to happen at the party."
                        },
                        {
                            "text": "I had a strange <w>premonition</w> of danger before I even entered the dark building."
                        }
                    ],
                    "synonyms": [
                        "bad feeling",
                        "foreboding",
                        "gut feeling",
                        "hunch"
                    ],
                    "common_phrases": [
