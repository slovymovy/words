                ],
                "senses": [
                    {
                        "sense_id": "e76e91b5-161f-3248-b3a8-c030cbb3b1a1",
                        "entry_id": "6b58508d-84a8-39d7-b03d-6aa745f3e054",
                        "glosses": [
                            "Fingerkraut mit langgestielten, gefingerten, handförmigen, grob gesägten fünf Einzelblättern, goldgelben, fünfzähligen Blüten und weitflächig am Boden kriechenden Stängel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "144f18c4-41bc-4612-95e2-a248f23f1c78",
                                "sense_id": "e76e91b5-161f-3248-b3a8-c030cbb3b1a1",
                                "text": "Fünffingerkraut weist eine wundheilende und adstringierende Wirkung auf. Es wird außerdem bei Fieber und Magenbeschwerden eingesetzt."
                            },
                            {
                                "example_id": "6a5a2767-bbfb-49a5-828c-8d7687383545",
                                "sense_id": "e76e91b5-161f-3248-b3a8-c030cbb3b1a1",
                                "text": "Waschungen mit dem Absud von Fünffingerkraut vertreiben Gesichtsflecken, Schuppen und Pickel, heilen rote, entzündete oder triefende Augen."
                            },
                            {
                                "example_id": "7ea575f4-85ee-47e1-9614-685597891752",
                                "sense_id": "e76e91b5-161f-3248-b3a8-c030cbb3b1a1",
                                "text": "Beide Fünffingerkräuter werden bei trägem Blutkreislauf angewandt; sie wirken zusammenziehend, deshalb sehr zu empfehlen gegen Durchfall und Blutung jeder Art."
                            },
                            {
                                "example_id": "e628517a-6d4f-43ef-9543-3fc43b373b78",
                                "sense_id": "e76e91b5-161f-3248-b3a8-c030cbb3b1a1",
                                "text": "…; Fünffingerkraut und Alpenrosen bedeckten in großer Menge das Ufer und streuten ihre gelben und rosigen Blumenblätter auf das klare, stille Wasser; …"
                            },
                            {
                                "example_id": "239f2df4-d0e6-4069-af29-fa91e202840e",
                                "sense_id": "e76e91b5-161f-3248-b3a8-c030cbb3b1a1",
                                "text": "Während des ganzen Sommers beschäftigte ich mich damit, diesen Teil der Erdoberfläche, der bisher nur Fünffingerkraut, Brombeeren, Beifuß und andere wildwachsende, süße Früchte und holde Blumen hervorgebracht hatte, mit Hülsenfrüchten zu befreunden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
