                    {
                        "sense_id": "33f7f7ae-dbcb-3f0c-92f7-7e1a1b446869",
                        "entry_id": "cb10e35a-6c26-3dbe-b4d2-0a8d58edac3a",
                        "glosses": [
                            "gezielte Abgabe, Unterscheidung von Müll an verschiedene Verwertungssysteme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a58a58d1-ff35-4ebe-a623-a0b41da5e380",
                                "sense_id": "33f7f7ae-dbcb-3f0c-92f7-7e1a1b446869",
                                "text": "„Bei der Müllabfuhr (gelber Sack) sowie der Müllsortierung geht eine Gefährdung von Schimmelpilzen und teilweise auf von Spritzen und Nadeln von Drogenabhängigen aus.“"
                            },
                            {
                                "example_id": "29f66125-f3f2-45e2-b3dc-33bed453fdef",
                                "sense_id": "33f7f7ae-dbcb-3f0c-92f7-7e1a1b446869",
                                "text": "„Wenn Sie in Nürnberg oder um Fürth zu Hause sind und einen versierten Dienstleister in Sachen Müllsortierung, sind wir das ideale Hausmeisterservice für alle Fälle.“"
                            },
                            {
                                "example_id": "432285e6-6561-4fee-88ba-18f1be464d82",
                                "sense_id": "33f7f7ae-dbcb-3f0c-92f7-7e1a1b446869",
                                "text": "„Bei Paderborn ist am Mittwoch eine Halle zur Müllsortierung in Brand geraten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
