                        "glosses": [
                            "One who is owed a debt; a creditor."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89dbde95-eaba-4ed3-9e5e-d4bb81be52b8",
                                "sense_id": "7b084798-8537-32d8-86b6-af3b1b7c6568",
                                "text": "If a person indebted to another makes his creditor or debtee his executor , or if such a creditor obtains letters of administration to his debtor ; in these cases the law gives him a remedy for his debt by allowing him to retain so much as will pay himself"
                            },
                            {
                                "example_id": "dd52deda-e32f-4a32-b586-d91a6a15540e",
                                "sense_id": "7b084798-8537-32d8-86b6-af3b1b7c6568",
                                "text": "The debtee also relies on the debtor to be financially successful themselves to pay the instalments of the debt as necessary."
                            }
                        ]
                    }
