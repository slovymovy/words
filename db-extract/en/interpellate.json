                    }
                ],
                "senses": [
                    {
                        "sense_id": "69b5d746-9e25-3aa9-a86f-fa6ccc2a8450",
                        "entry_id": "985820c7-1234-3fd9-a8c5-ba30c8124d1b",
                        "glosses": [
                            "To interrupt (someone) so as to inform or question (that person about something)."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "2b326baf-4158-364a-9b0e-42764cf5780e",
                        "entry_id": "985820c7-1234-3fd9-a8c5-ba30c8124d1b",
                        "glosses": [
                            "To address (a person) in a way that presupposes a particular identification of them; to give (a person) an identity (which may or may not be accurate)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41de09d6-cd33-454a-917e-8e5d775fb817",
                                "sense_id": "2b326baf-4158-364a-9b0e-42764cf5780e",
                                "text": "[…] a Master of Ceremonies' words \"Ladies and gentlemen\" […] interpellates those being addressed as an audience, and one that is differentiated by gender."
                            },
                            {
                                "example_id": "2260a62e-184b-480d-bfa2-1930c91f5554",
                                "sense_id": "2b326baf-4158-364a-9b0e-42764cf5780e",
                                "text": "[…] the question may be whether the individual should let herself be interpellated as a feminist, a Christian or a worker. Perhaps all of these possibilities seem attractive, but they point in different directions […]"
                            },
                            {
                                "example_id": "bc209849-725a-4ab5-9a4b-e7bbda7c4258",
                                "sense_id": "2b326baf-4158-364a-9b0e-42764cf5780e",
                                "text": "[…] whereas the Palestinian subjects are interpellated as: the martyr... a young Palestinian... a Palestinian teenager."
                            }
                        ]
                    },
                    {
                        "sense_id": "883ecc31-1252-35d7-a718-db20ec2ca406",
                        "entry_id": "985820c7-1234-3fd9-a8c5-ba30c8124d1b",
                        "glosses": [
                            "To question (someone) formally concerning official or governmental policy or business."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "7d1509f3-fba9-40f2-9699-214689c5b7e2",
                                "sense_id": "883ecc31-1252-35d7-a718-db20ec2ca406",
                                "text": "After the gentleman and Senator [Mariano Jesús] Cuenco interpellated me, I knew already that my bill was hopeless. That is why I presented that bill on February 4th, but it slept the sleep of the just in the Committee on Education."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f065a404-7ecf-403a-ac85-8685baf06a02",
                        "source_entry_id": "985820c7-1234-3fd9-a8c5-ba30c8124d1b",
                        "source_sense_description": "interrupt so as to inform or question",
                        "target_lang_word": "interpeller",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interpeller",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e683fc1d-9dfd-35fd-b9f7-9790d702e09e",
                                        "entry_id": "39a6171e-6b5c-3d9b-bba0-242c01b2048e",
                                        "glosses": [
                                            "Adresser la parole, d’une façon plus ou moins brusque, à quelqu’un pour lui demander quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01f1a4ac-d128-4f25-a5c9-4b5baf5e3c53",
                                                "sense_id": "e683fc1d-9dfd-35fd-b9f7-9790d702e09e",
                                                "text": "L’un des membres de la Société interpella le président sur la question de savoir si le docteur Fergusson ne serait pas officiellement présenté."
                                            },
                                            {
                                                "example_id": "bcc41087-fdae-4b66-8c87-3d85a62880b4",
                                                "sense_id": "e683fc1d-9dfd-35fd-b9f7-9790d702e09e",
                                                "text": "Comme mon guide me conduit à la buanderie commune, une rougeaude aux manches retroussées l’interpelle, élève la voix, dénonce des injustices."
                                            },
                                            {
                                                "example_id": "55f8819d-d5f3-4d98-9332-3b0feefb84d4",
                                                "sense_id": "e683fc1d-9dfd-35fd-b9f7-9790d702e09e",
                                                "text": "Elle interpelle une femme maigriote et chahuteuse et lui crie avec un accent inimitable :\n— Té, ma petite, si jamais le mistral y souffle à Paris, tu vas t’envoler comme une aéroplane."
                                            },
                                            {
                                                "example_id": "5c75f25b-f815-45ac-8019-c558d1a352dd",
                                                "sense_id": "e683fc1d-9dfd-35fd-b9f7-9790d702e09e",
                                                "text": "Le vent et la sécheresse avaient tout chargé d’électricité. Les hommes sautillaient nerveusement, s’interpellaient, se heurtaient et quelquefois sur la chaussée noire deux autos s’emboutissaient en faisant de grands bruits de ferraille et de klaxon coincé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "079408b6-72cb-32b1-a5cd-1406fe0dae3c",
                                        "entry_id": "39a6171e-6b5c-3d9b-bba0-242c01b2048e",
                                        "glosses": [
                                            "Susciter une réflexion ; provoquer un avis."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "note": "Sens décrit, mais critiqué par l’Académie française qui lui préfère d’autres formulations",
                                        "examples": [
                                            {
                                                "example_id": "a4fd28ff-e8b5-4f3b-8a4f-c2bef7487ebc",
                                                "sense_id": "079408b6-72cb-32b1-a5cd-1406fe0dae3c",
                                                "text": "Monsieur le Président, Mesdames, Messieurs, le titre du rapport nous interpelle avec cette question : « Progrès ou recul dans la lutte de l’Europe contre la criminalité économique et le crime organisé transnational ? »."
                                            },
                                            {
                                                "example_id": "42595bb0-da6a-45e8-8fa9-082fb3ab591b",
                                                "sense_id": "079408b6-72cb-32b1-a5cd-1406fe0dae3c",
                                                "text": "Si la nature des rapports entre le politique et les idées de la religion et du sacré nous interpelle, en tant que politologues, il nous semble essentiel de réfléchir sur leurs théorisations respectives […]"
                                            },
                                            {
                                                "example_id": "6768393a-e644-43cd-9e04-ee6a4193e314",
                                                "sense_id": "079408b6-72cb-32b1-a5cd-1406fe0dae3c",
                                                "text": "Cet état de fait singulier interpella aussitôt le jeune homme : soit Diana était de mèche avec le géant et jouait un rôle pour mieux tromper Germaine de Picou-Sinbrac, soit elle était atteinte d’une double personnalité qui lui permettait de psychosomatiser des maux inexistants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5afc835-c51d-3952-a8ab-4be1261004a5",
                                        "entry_id": "39a6171e-6b5c-3d9b-bba0-242c01b2048e",
                                        "glosses": [
                                            "Sommer un témoin ou une des parties de s’expliquer sur la vérité ou la fausseté d’un fait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "398b6480-8af2-4701-a78e-80f390f661d3",
                                                "sense_id": "c5afc835-c51d-3952-a8ab-4be1261004a5",
                                                "text": "En sa qualité de président du comité départemental et membre du comité d’hygiène départemental, Didier Lassauzay va donc interpeller le préfet de la Marne et les maires de Châlons-sur-Marne et Fagnières."
                                            },
                                            {
                                                "example_id": "c9e2bbde-24a1-424d-a40e-7007e2cb2455",
                                                "sense_id": "c5afc835-c51d-3952-a8ab-4be1261004a5",
                                                "text": "L’huissier l’ayant interpellé de signer, il déclara ne savoir. Il fut sommé et interpellé de répondre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c05c6f30-3887-33b3-b0c4-b5034968088c",
                                        "entry_id": "39a6171e-6b5c-3d9b-bba0-242c01b2048e",
                                        "glosses": [
                                            "Demander à un ministre de s’expliquer sur un acte de son administration, demander au gouvernement de s’expliquer sur sa politique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f76eadf6-e726-4e6b-a4a3-08869d5cba37",
                                                "sense_id": "c05c6f30-3887-33b3-b0c4-b5034968088c",
                                                "text": "Voilà pourquoi j’avais interpellé énergiquement le gouvernement pour réduire de 30 % le nombre de ces « comités Théodule ». L’idée est simple : la France des experts ne doit pas être placée au-dessus de la France des élus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32b3d50d-7c2d-3a40-8dd8-e2f34a4d2cc2",
                                        "entry_id": "39a6171e-6b5c-3d9b-bba0-242c01b2048e",
                                        "glosses": [
                                            "Poser (à un individu) une ou des questions précises au cours d’une enquête, d’un contrôle de police et, éventuellement, mettre en état d’arrestation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "415c06aa-1e5f-4561-b38a-acf462a51ecd",
                                                "sense_id": "32b3d50d-7c2d-3a40-8dd8-e2f34a4d2cc2",
                                                "text": "C'est une grosse interpellation. Une grosse arrestation."
                                            },
                                            {
                                                "example_id": "781774a8-f3b4-4802-b473-dbe270d2da96",
                                                "sense_id": "32b3d50d-7c2d-3a40-8dd8-e2f34a4d2cc2",
                                                "text": "Trois personnes ont été interpellées et mises en examen, ce mercredi, pour omission de porter secours."
                                            },
                                            {
                                                "example_id": "c1d9e76e-4c4b-473a-a34e-d82f02e886b4",
                                                "sense_id": "32b3d50d-7c2d-3a40-8dd8-e2f34a4d2cc2",
                                                "text": "Plusieurs figures de l’assaut ont été interpellées par la police et inculpées, samedi, d’intrusion illégale et de conduite violente, notamment le complotiste Jake Angeli."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d97c7141-3260-4d43-8f72-da3a7e12c818",
                        "source_entry_id": "985820c7-1234-3fd9-a8c5-ba30c8124d1b",
                        "source_sense_description": "address in a way that presupposes a particular identification",
                        "target_lang_word": "interpellieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interpellieren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "33a15cf7-6dfd-3cdf-a7ee-a55d6e6ca053",
                                        "entry_id": "5dc90e48-49aa-33bf-9076-b7a96e684a4d",
                                        "glosses": [
                                            "zu einer Erklärung auffordern; eine Interpellation einbringen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd38a770-cb0c-4fef-9a29-d7fa1417526f",
                                                "sense_id": "33a15cf7-6dfd-3cdf-a7ee-a55d6e6ca053",
                                                "text": "\"Manche Verfassungsurkunden (z. B. die preußische, Art. 81) räumen den Kammern ausdrücklich das Recht ein, die Regierung zu interpellieren.\""
                                            },
                                            {
                                                "example_id": "ba430aa6-31c8-4586-8994-95658d3421f5",
                                                "sense_id": "33a15cf7-6dfd-3cdf-a7ee-a55d6e6ca053",
                                                "text": "Die Abgeordneten haben das Recht, die Regierung und ihre Mitglieder zu interpellieren."
                                            },
                                            {
                                                "example_id": "02ea5021-ab5f-4bc0-82cc-ddb7c5197614",
                                                "sense_id": "33a15cf7-6dfd-3cdf-a7ee-a55d6e6ca053",
                                                "text": "Ein Viertel des gesetzmäßigen Bestandes der Staatsversammlung hat das Recht, die Regierung zu interpellieren, worauf eine Erklärung abgegeben (abzugeben) werden muß."
                                            },
                                            {
                                                "example_id": "30a8f997-fd12-4530-a43e-a5cc1aec13cb",
                                                "sense_id": "33a15cf7-6dfd-3cdf-a7ee-a55d6e6ca053",
                                                "text": "General Electric mobilisiert zwölf Senatoren und Kongreßabgeordnete, die im Kongreß gegen die Briten interpellieren und vor Arbeitslosigkeit und Devisenverlust als Folge eines Rolls-Royce- Auftrags warnen."
                                            },
                                            {
                                                "example_id": "eb3c87a0-0d0b-4fa4-a054-66026763fc56",
                                                "sense_id": "33a15cf7-6dfd-3cdf-a7ee-a55d6e6ca053",
                                                "text": "Minister und Hinterbänkler springen auf und deuten mit fordernd ausgestreckter rechter und theatralisch auf den Kopf gelegter linker Hand ihr Begehren an zu interpellieren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e143bce6-6fe4-3480-886e-594264a22482",
                                        "entry_id": "5dc90e48-49aa-33bf-9076-b7a96e684a4d",
                                        "glosses": [
                                            "jemanden befragen"
                                        ],
                                        "tags": [
                                            "literary",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89dfc5de-caa3-4fb4-befa-8aaa43c5e622",
                                                "sense_id": "e143bce6-6fe4-3480-886e-594264a22482",
                                                "text": "\"Alles ist nach dem Leben gezeichnet. Wenn ich trotzdem, vorsichtigerweise, meinem Buche den Nebentitel eines autobiographischen Romanes gegeben habe, so hat dies darin seinen Grund, daß ich nicht von einzelnen aus jener Zeit her vielleicht noch Lebenden auf die Echtheitsfrage hin interpelliert werden möchte. Für etwaige Zweifler also sei es Roman!"
                                            },
                                            {
                                                "example_id": "f89efbec-9dd6-48c0-b3dc-c3272a76d84e",
                                                "sense_id": "e143bce6-6fe4-3480-886e-594264a22482",
                                                "text": "π \"gehört nicht zu den Dingen, über die Sie Ihren Herrn Gemahl abends beim Schlafengehen zu interpellieren brauchen\"."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c0e860c8-5b05-3461-a64b-0a556e57a340",
                                        "entry_id": "5dc90e48-49aa-33bf-9076-b7a96e684a4d",
                                        "glosses": [
                                            "jemandem ins Wort fallen"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c001c451-d0f8-4f29-b45f-8fa74f9aa515",
                                                "sense_id": "c0e860c8-5b05-3461-a64b-0a556e57a340",
                                                "text": "Von hier aus konnte er erkennen, daß das anfänglich lebhafte Gespräch zwischen Blumenstein und Goethe rasch ins Stocken kam, auf welche Wahrnehmung hin er, nach Aufhebung der Tafel, seinen sonst so redseligen Kameraden interpellierte."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45d3c682-c29f-407f-a7cb-d9b10f021751",
