                        "glosses": [
                            "ein Adverb, das aus da(r), hier und wo(r) + Präposition besteht."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2e41ba8-e829-4bca-a1e4-bb23f134ce5b",
                                "sense_id": "d6a0e4ee-5e85-396f-9cb4-50d66eb5d5d9",
                                "text": "Präpositionaladverbien sind Wörter wie \"dazu\", \"hierzu\", wozu\" und \"darüber\", \"worüber\"."
                            },
                            {
                                "example_id": "6c0b0f09-6ca4-446a-a072-e1d776bcb15d",
                                "sense_id": "d6a0e4ee-5e85-396f-9cb4-50d66eb5d5d9",
                                "text": "Der Begriff Präpositionaladverb bezieht sich auf die Bildung dieser Adverbien mit einer Präposition."
                            }
                        ],
