    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "9a5d6abc-f534-3f49-913f-e5701e67cc5f",
                    "sense_definition": "Exclamation familière employée pour lancer ou relever un défi.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "defi",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu prétends pouvoir courir dix kilomètres sans t'arrêter ? <w>Chiche</w> !"
                        },
                        {
                            "text": "<w>Chiche</w> que tu ne réussiras pas à finir cette assiette tout seul !"
                        }
                    ],
                    "common_phrases": [
                        "chiche que"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "langage familier"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "243b5b7b-86b3-3f8c-9b9b-4aaf01c9358d",
                    "sense_definition": "Qui répugne à dépenser, avare ou excessivement économe.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "avarice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon oncle est très <w>chiche</w> et refuse toujours de laisser un pourboire au restaurant."
                        },
                        {
                            "text": "Les organisateurs ne sont pas <w>chiches</w> de compliments envers les bénévoles."
                        }
                    ],
                    "synonyms": [
                        "radin",
                        "mesquin"
                    ],
                    "common_phrases": [
                        "ne pas être chiche"
                    ]
                },
                {
                    "sense_id": "6835dcaa-469c-3d26-a57e-a591d3f19040",
                    "sense_definition": "Trop peu abondant, maigre ou insuffisant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quantite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après une longue journée de marche, ils ont dû se contenter d'un repas bien <w>chiche</w>."
                        },
                        {
                            "text": "Cette pièce sombre ne recevait qu'une <w>chiche</w> lumière venant d'une minuscule lucarne."
                        }
                    ],
                    "synonyms": [
                        "mesquin"
                    ]
                }
            ]
        }
    ]
