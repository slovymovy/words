{
    "word_family": [
        "gravity",
        "gravely",
        "engrave",
        "engraver",
        "gravestone",
        "graveyard"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "eb4dbefa-de62-3b8b-b9f4-ee896e4c205c",
                    "sense_definition": "Very serious, dangerous, or worrying; giving cause for alarm.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "group_seriousness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor said that her condition was <w>grave</w> and required immediate surgery.",
                            "target_lang_translations": {
                                "ru": "Врач сказал, что её состояние <w>тяжёлое</w> и требует немедленной операции.",
                                "zh": "医生说她的病情很<w>严重</w>，需要立即手术。"
                            }
                        },
                        {
                            "text": "He made a <w>grave</w> mistake by underestimating his opponent.",
                            "target_lang_translations": {
                                "ru": "Он совершил <w>серьёзную</w> ошибку, недооценив своего противника.",
                                "zh": "他低估了对手，犯了一个<w>严重</w>的错误。"
                            }
                        }
                    ],
                    "synonyms": [
                        "critical",
                        "crucial",
                        "serious",
                        "grievous",
                        "weighty",
                        "momentous"
                    ],
                    "common_phrases": [
                        "grave danger",
                        "grave concern",
                        "grave mistake",
                        "grave consequences"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень серьёзный, опасный или вызывающий тревогу.",
                        "zh": "非常严重、危险或令人担忧；引起警觉。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "серьёзный",
                                "target_lang_sense_clarification": "о ситуации, ошибке"
                            },
                            {
                                "target_lang_word": "тяжёлый",
                                "target_lang_sense_clarification": "о состоянии, последствиях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "严重",
                                "target_lang_sense_clarification": "指情况或后果非常糟糕"
                            },
                            {
                                "target_lang_word": "沉重",
                                "target_lang_sense_clarification": "指事态严重，令人忧虑"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74d45f03-445c-314e-a3aa-61449318fa14",
                    "sense_definition": "Solemn, dignified, and not cheerful in manner or appearance.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_seriousness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge looked <w>grave</w> as he delivered the sentence to the defendant.",
                            "target_lang_translations": {
                                "ru": "Судья выглядел <w>серьёзным</w>, когда выносил приговор подсудимому.",
                                "zh": "法官在向被告宣判时神情<w>严肃</w>。"
                            }
                        },
                        {
                            "text": "She maintained a <w>grave</w> expression throughout the funeral service.",
                            "target_lang_translations": {
                                "ru": "Она сохраняла <w>серьёзное</w> выражение лица на протяжении всей похоронной службы.",
                                "zh": "在整个葬礼期间，她一直保持着<w>严肃</w>的表情。"
                            }
                        }
                    ],
                    "synonyms": [
                        "solemn",
                        "sombre",
                        "serious",
                        "earnest",
                        "sedate",
                        "sober",
                        "staid"
                    ],
                    "common_phrases": [
                        "grave face",
                        "grave expression",
                        "look grave"
                    ],
                    "target_lang_definitions": {
                        "ru": "Торжественный, сдержанный и не весёлый по манере или внешнему виду.",
                        "zh": "庄重、严肃，举止或外表不轻浮。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "серьёзный",
                                "target_lang_sense_clarification": "о выражении лица"
                            },
                            {
                                "target_lang_word": "мрачный",
                                "target_lang_sense_clarification": "угрюмый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "严肃",
                                "target_lang_sense_clarification": "指神情或态度庄重"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7fd59d91-3bc6-335d-94bb-a3b25c419366",
                    "sense_definition": "Low in pitch or tone.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cello is known for its rich and <w>grave</w> sound.",
                            "target_lang_translations": {
                                "ru": "Виолончель известна своим богатым и <w>низким</w> звучанием.",
                                "zh": "大提琴以其丰富而<w>低沉</w>的音色而闻名。"
                            }
                        },
                        {
                            "text": "His voice became <w>grave</w> and quiet as he told the story.",
                            "target_lang_translations": {
                                "ru": "Его голос стал <w>низким</w> и тихим, когда он рассказывал эту историю.",
                                "zh": "当他讲述那个故事时，他的声音变得<w>低沉</w>而安静。"
                            }
                        }
                    ],
                    "synonyms": [
                        "deep",
                        "low-pitched"
                    ],
                    "antonyms": [
                        "acute"
                    ],
                    "target_lang_definitions": {
                        "ru": "Низкий по высоте или тону.",
                        "zh": "音调低沉。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "низкий",
                                "target_lang_sense_clarification": "о звуке или голосе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "低沉",
                                "target_lang_sense_clarification": "指声音低而沉闷"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "271f4c90-53a6-3b77-8046-1af27356bd2d",
                    "sense_definition": "A hole dug in the ground to receive a coffin or dead body.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "group_death",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family gathered around the <w>grave</w> to say their final goodbyes.",
                            "target_lang_translations": {
                                "ru": "Семья собралась у <w>могилы</w>, чтобы попрощаться в последний раз.",
                                "zh": "家人们聚集在<w>坟墓</w>旁，做最后的告别。"
                            }
                        },
                        {
                            "text": "Soldiers who died in the battle were buried in a mass <w>grave</w>.",
                            "target_lang_translations": {
                                "ru": "Солдаты, погибшие в битве, были похоронены в братской <w>могиле</w>.",
                                "zh": "在战斗中牺牲的士兵被埋葬在集体<w>坟墓</w>中。"
                            }
                        }
                    ],
                    "synonyms": [
                        "plot",
                        "tomb",
                        "burial site"
                    ],
                    "common_phrases": [
                        "dig a grave",
                        "shallow grave",
                        "mass grave",
                        "unmarked grave",
                        "visit a grave"
                    ],
                    "target_lang_definitions": {
                        "ru": "Яма, вырытая в земле для захоронения гроба или тела умершего.",
                        "zh": "在地上挖的用来安放棺材或尸体的坑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "могила",
                                "target_lang_sense_clarification": "место захоронения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "坟墓",
                                "target_lang_sense_clarification": "埋葬死者的地方"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "181f8537-19f3-3a80-ae9c-032167757b46",
                    "sense_definition": "Death or the end of life, often personified or used metaphorically.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group_death",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His stressful lifestyle is driving him to an early <w>grave</w>.",
                            "target_lang_translations": {
                                "ru": "Его напряжённый образ жизни сводит его в преждевременную <w>могилу</w>.",
                                "zh": "他充满压力的生活方式正在让他走向早逝的<w>坟墓</w>。"
                            }
                        },
                        {
                            "text": "She vowed to take the secret to her <w>grave</w>.",
                            "target_lang_translations": {
                                "ru": "Она поклялась унести эту тайну с собой в <w>могилу</w>.",
                                "zh": "她发誓要把这个秘密带进<w>坟墓</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "early grave",
                        "silent as the grave",
                        "beyond the grave",
                        "turn in one's grave"
                    ],
                    "target_lang_definitions": {
                        "ru": "Смерть или конец жизни, часто используется метафорически.",
                        "zh": "死亡或生命的终结，常用于隐喻。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "могила",
                                "target_lang_sense_clarification": "смерть, гибель"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "坟墓",
                                "target_lang_sense_clarification": "比喻死亡或终结"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9239be5a-6517-3ee6-9d9d-b780f4c3db0a",
                    "sense_definition": "The grave accent (`), a mark used in writing to indicate pronunciation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In French, the letter 'e' often carries a <w>grave</w> accent.",
                            "target_lang_translations": {
                                "ru": "Во французском языке буква 'e' часто имеет знак <w>гравис</w>.",
                                "zh": "在法语中，字母“e”上经常带有<w>重音符</w>。"
                            }
                        },
                        {
                            "text": "You must place a <w>grave</w> over the vowel to change the word's meaning.",
                            "target_lang_translations": {
                                "ru": "Вы должны поставить <w>гравис</w> над гласной, чтобы изменить значение слова.",
                                "zh": "你必须在元音上加上<w>重音符</w>来改变这个词的意思。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "grave accent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Знак гравис (`), используемый на письме для указания произношения.",
                        "zh": "重音符（`），书写时用于指示发音的符号。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гравис",
                                "target_lang_sense_clarification": "диакритический знак"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "重音符",
                                "target_lang_sense_clarification": "一种变音符号"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "12ae7252-0c9c-3d3f-8de3-6cb6953a0699",
                    "sense_definition": "To carve or cut a design or letters into a hard surface.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist <w>graved</w> the image onto the stone tablet.",
                            "target_lang_translations": {
                                "ru": "Художник <w>выгравировал</w> изображение на каменной табличке.",
                                "zh": "艺术家将图像<w>雕刻</w>在石板上。"
                            }
                        },
                        {
                            "text": "His name was <w>graved</w> on the memorial for everyone to see.",
                            "target_lang_translations": {
                                "ru": "Его имя было <w>высечено</w> на мемориале, чтобы все могли его видеть.",
                                "zh": "他的名字被<w>镌刻</w>在纪念碑上，供所有人瞻仰。"
                            }
                        }
