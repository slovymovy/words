                "senses": [
                    {
                        "sense_id": "7222192b-c77e-3623-a175-580b6800b12e",
                        "entry_id": "03d5f84b-0e0b-32ae-91c6-295e0784b640",
                        "glosses": [
                            "Gerichtsverfahren, bei dem eine Person - meist eine Frau - der Hexerei angeklagt wurde"
                        ],
                        "tags": [
                            "Mittelalter bis Ende des 18. Jahrhunderts"
                        ],
                        "examples": [
                            {
                                "example_id": "b74b0b8e-de60-4e9a-824b-03f852918cb1",
                                "sense_id": "7222192b-c77e-3623-a175-580b6800b12e",
                                "text": "„Zu den dunkelsten Kapiteln Eichsfelder Heimatgeschichte gehören zwei Hexenprozesse im ehemaligen Amt Harburg-Worbis.“"
                            },
                            {
                                "example_id": "99306299-4625-4911-9a56-edc30cb81efe",
                                "sense_id": "7222192b-c77e-3623-a175-580b6800b12e",
                                "text": "„Im geistlichen Kurfürstentum Köln hatten inzwischen ebenfalls die Hexenprozesse sich zu häufen begonnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
