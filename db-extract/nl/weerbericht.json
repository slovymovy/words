                "senses": [
                    {
                        "sense_id": "637d0c62-7db5-3daf-a0f4-a74f927b1d06",
                        "entry_id": "68115489-8fad-3cda-9cb0-4e341acda03d",
                        "glosses": [
                            "bericht of mededeling over de toestand van het weer en de te verwachten weersgesteldheid"
                        ],
                        "tags": [],
