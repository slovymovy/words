                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "728cd39d-a911-44cd-8fdc-24add6162ce0",
                                                "sense_id": "267ec5c5-e87b-38b9-8a3e-b1c75dbd0e23",
                                                "text": "Si la participation de l’État hébreu est confirmée, le pays sera représenté par Eden Golan, qui prendra part à la seconde demi-finale, le 9 mai, à Malmö (Suède)."
                                            }
                                        ]
