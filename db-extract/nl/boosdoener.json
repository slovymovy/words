                "senses": [
                    {
                        "sense_id": "d9db0dc7-c015-36ff-9bfd-a3c3b0a5116c",
                        "entry_id": "5d41cd42-0090-31fc-b1a7-6bc08bee5488",
                        "glosses": [
                            "iemand wiens daden een nadelig effect hebben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2a3a238-bdd6-47a3-b722-83019a26faeb",
                                "sense_id": "d9db0dc7-c015-36ff-9bfd-a3c3b0a5116c",
                                "text": "...ik ben van oordeel, dat wie een boosdoener aan justitie overlevert, zijn plicht doet jegens zijne medeburgers!"
                            },
                            {
                                "example_id": "d3445c0e-4a5f-40df-9be4-807785865034",
                                "sense_id": "d9db0dc7-c015-36ff-9bfd-a3c3b0a5116c",
                                "text": "Van Egten wordt niet genoemd als boosdoener."
                            }
                        ]
                    },
                    {
                        "sense_id": "98fbb0a0-0703-3e4b-bb09-ec432bfa4528",
                        "entry_id": "5d41cd42-0090-31fc-b1a7-6bc08bee5488",
                        "glosses": [
                            "iets wat een nadelig effect heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02f0e43a-9242-4c8c-97df-e41512b53e2f",
                                "sense_id": "98fbb0a0-0703-3e4b-bb09-ec432bfa4528",
                                "text": "Wij vroegen wie de grootste milieuvervuilers zijn. In het rijtje grote boosdoeners komt de personenauto pas op de tweede plaats."
                            },
                            {
                                "example_id": "7550d1c5-499b-45b9-83fb-099844daebde",
                                "sense_id": "98fbb0a0-0703-3e4b-bb09-ec432bfa4528",
                                "text": "Niet de medicijnen op zich, maar Jeroens geest was de boosdoener."
                            },
                            {
                                "example_id": "ef17cbfe-248e-4988-bca8-9c074c62e43d",
                                "sense_id": "98fbb0a0-0703-3e4b-bb09-ec432bfa4528",
                                "text": "De belangrijkste boosdoener is de groeidwang die sinds de jaren zeventig van de vorige eeuw eigen is aan onze vrijemarkteconomie."
                            }
                        ]
                    }
                ],
