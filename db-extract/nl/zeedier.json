                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e17604d-5efe-4de3-8102-e62f855edbb5",
                                "sense_id": "7a8f8bcc-c9d6-3e0a-ac4c-55a3ff90cf2b",
                                "text": "Een zeeschildpad is een echt zeedier, behalve dat de eieren op een strand gelegd worden."
                            },
                            {
                                "example_id": "3740de7d-9acd-4bb9-96bf-2e5a85da0bce",
                                "sense_id": "7a8f8bcc-c9d6-3e0a-ac4c-55a3ff90cf2b",
                                "text": "Als ze in het noorden van Canada wil overleven, moet ze haar dieet volgens de onderzoekers wel aanpassen. Daar leven vossen vooral van lemmingen, in Spitsbergen eten ze vooral zeedieren als zeevogels."
                            }
                        ]
                    }
