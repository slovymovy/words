                "senses": [
                    {
                        "sense_id": "2933bc9f-5db7-3e6b-be96-975f88974128",
                        "entry_id": "a90b264d-4af0-310a-a3d0-4569d8e30cdb",
                        "glosses": [
                            "the quality of being strident"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9df40eca-e512-46d6-8630-d0cb802688a6",
                                "sense_id": "2933bc9f-5db7-3e6b-be96-975f88974128",
                                "text": "Mr Urkullu’s ambiguity contrasts with Mr Mas’s growing stridence."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f7b64731-74b2-4570-9483-5bf915937157",
                        "source_entry_id": "a90b264d-4af0-310a-a3d0-4569d8e30cdb",
                        "source_sense_id": "2933bc9f-5db7-3e6b-be96-975f88974128",
                        "source_sense_description": "quality of being strident",
                        "target_lang_word": "stridence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stridence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "20e88db4-600a-3fc8-b640-a887457598b0",
                                        "entry_id": "8d99123f-eca1-351b-ad23-424d1c79ada5",
                                        "glosses": [
                                            "Caractère de ce qui est strident, d’une sonorité stridente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70bd5630-fdb5-43a3-af0c-f3e328db867a",
                                                "sense_id": "20e88db4-600a-3fc8-b640-a887457598b0",
                                                "text": "Il suffisait cependant de s'éloigner de quelques pas pour que la stridence de la meule fut atténuée par sa confusion avec les sons provoqués par les autres outils."
                                            },
                                            {
                                                "example_id": "1f317535-9eed-4d91-bedf-ad15a5f41cee",
                                                "sense_id": "20e88db4-600a-3fc8-b640-a887457598b0",
                                                "text": "… pas le moindre grondement de machines à bielles et à volants, pas le plus mince sifflement de vapeur, mais la stridence continue des sauterelles, l'appel bref d'un roitelet des murs, le chant d'un coq."
                                            },
                                            {
                                                "example_id": "37314e24-2665-4b1a-8141-acdf2aeb2b9a",
                                                "sense_id": "20e88db4-600a-3fc8-b640-a887457598b0",
                                                "text": "Un ululement suraigu retentit et un autre et un autre encore. Ils semblaient venir de tous côtés en même temps et emplir tout l’espace de leur stridence."
                                            },
                                            {
                                                "example_id": "fb14a9a3-8b43-455d-ae24-50bad4643239",
                                                "sense_id": "20e88db4-600a-3fc8-b640-a887457598b0",
                                                "text": "Chaque fois qu'il venait au Palladium, il y restait une heure tandis que les orchestres et les chanteurs se succédaient sur l'estrade – adolescents de la banlieue ou jeunes employés du quartier. Et leur rêve était si fort, si violent leur désir d'échapper par la musique à ce qu'ils pressentaient de leur vie, que Bellune percevait souvent les stridences des guitares et les voix qui s'éraillaient comme des appels au secours."
                                            },
                                            {
                                                "example_id": "29cf0f15-168f-48d5-a7f0-8da4ba9d641f",
                                                "sense_id": "20e88db4-600a-3fc8-b640-a887457598b0",
                                                "text": "On tire vers l’aigu. Les profondeurs cuivrées font place à une stridence conquérante (a-t-on jamais écrit aussi haut pour sax soprano ? Il fallait bien Lacy pour tenir un pupitre aussi difficile)."
                                            },
                                            {
                                                "example_id": "9b02fd8d-c99b-4619-a6bc-f8f7368ece81",
                                                "sense_id": "20e88db4-600a-3fc8-b640-a887457598b0",
                                                "text": "Il étala les journaux et dut fermer sa porte pour s’isoler des stridences entrecroisées des téléphones qui se déclenchaient les uns après les autres dans la grande salle, mobilisant tous les agents de la Brigade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61a9923d-4fca-3ba2-8552-d45ccbf36204",
                                        "entry_id": "8d99123f-eca1-351b-ad23-424d1c79ada5",
                                        "glosses": [
                                            "Son aigu, d’une fréquence de quelques kilohertz, caractérisant une instabilité de combustion, en particulier dans un moteur à ergols liquides."
                                        ],
                                        "tags": [
                                            "Propulsion spatiale"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c94fd726-6db3-313c-9bf2-467e97c0abc5",
                                        "entry_id": "8d99123f-eca1-351b-ad23-424d1c79ada5",
                                        "glosses": [
                                            "Cette instabilité elle-même."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40cf4ad3-d756-4a1b-b034-602546cb2024",
                        "source_entry_id": "a90b264d-4af0-310a-a3d0-4569d8e30cdb",
                        "source_sense_id": "2933bc9f-5db7-3e6b-be96-975f88974128",
                        "source_sense_description": "quality of being strident",
                        "target_lang_word": "ре́зкость",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ре́зкость",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fefcd637-44ad-36c2-9ab6-a3dec83de3da",
                                        "entry_id": "1ff487de-08ac-375c-ac18-b3fc6f98ddb6",
                                        "glosses": [
                                            "отрывистость, внезапная интенсивность"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69a6312f-ad69-4542-9d61-60edd88cdb8e",
                                                "sense_id": "fefcd637-44ad-36c2-9ab6-a3dec83de3da",
                                                "text": "Даже походка у Тани изменилась ― появилась мальчишеская раскачка в плечах, резкость..."
                                            },
                                            {
                                                "example_id": "9a7c3019-eaa1-4d2a-b91a-652eb9d7083d",
                                                "sense_id": "fefcd637-44ad-36c2-9ab6-a3dec83de3da",
                                                "text": "упражнение на резкость удара"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14c16f8d-a849-34b5-8903-e6d2e270b1ae",
                                        "entry_id": "1ff487de-08ac-375c-ac18-b3fc6f98ddb6",
                                        "glosses": [
                                            "отчётливость, выраженность"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b8a5fd4-f43b-4d43-9bf1-23defa1734ae",
                                                "sense_id": "14c16f8d-a849-34b5-8903-e6d2e270b1ae",
                                                "text": "Время смягчило резкость чёрт, сделав лицо женственней."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f01cc52c-d90a-3d9e-9e41-a30d405bee44",
                                        "entry_id": "1ff487de-08ac-375c-ac18-b3fc6f98ddb6",
                                        "glosses": [
                                            "перен. бестактное высказывание или выражение, грубость"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3028bbc-8013-41a5-b3ec-abbb0a1d0ab2",
                                                "sense_id": "f01cc52c-d90a-3d9e-9e41-a30d405bee44",
                                                "text": "Молоденькой мама была своенравной, выражений не выбирала, могла сказать резкость."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0796258b-de9f-349f-b0ae-ee82b19c52dc",
                                        "entry_id": "1ff487de-08ac-375c-ac18-b3fc6f98ddb6",
                                        "glosses": [
                                            "техн. фотогр. точная сфокусированность изображения, позволяющая видеть мелкие детали и чёткие границы между деталями"
                                        ],
                                        "tags": [],
