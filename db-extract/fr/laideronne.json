                ],
                "senses": [
                    {
                        "sense_id": "e7fe10f1-3eda-34bd-8e4f-c62a664da8b2",
                        "entry_id": "10a74ad0-b471-3d1d-abda-f283b84fc9d0",
                        "glosses": [
                            "Jeune fille ou jeune femme laide."
                        ],
                        "tags": [
                            "literary",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "c4b4328d-3ced-45e0-a11f-83206a432b4b",
                                "sense_id": "e7fe10f1-3eda-34bd-8e4f-c62a664da8b2",
                                "text": "Cesse, dit-il, de te rendre semblable à lui. Une laideronne nommée Danaé, ayant un procés, & sollicitant ses Juges pour tâcher de les corrompre."
                            },
                            {
                                "example_id": "80a85ec7-d08d-4a9f-b87b-7aefe3da5d9e",
                                "sense_id": "e7fe10f1-3eda-34bd-8e4f-c62a664da8b2",
                                "text": "Cette escouade de laideronnes avait suffi pour mettre en fuite tous les prétendus, tous les prétendants, et même les prétendus prétendants, jeunes beaux de province qui ont toute espèce de motifs pour n’en pas avoir de bons."
                            },
                            {
                                "example_id": "a281dbda-345c-4295-883c-bd01ce7e4516",
                                "sense_id": "e7fe10f1-3eda-34bd-8e4f-c62a664da8b2",
                                "text": "Je fus laideronne avec délices, la chevelure cordée et des mèches plates sur les joues."
                            },
                            {
                                "example_id": "4b021513-848c-48de-b10b-e8c6af54cb08",
                                "sense_id": "e7fe10f1-3eda-34bd-8e4f-c62a664da8b2",
                                "text": "Moi qui attendais deux universitaires plutôt laideronnes, jargonnantes, pas fardées —surtout pas de concessions avec lui— et de grandes griffes sales, un élevage de comédons sur chaque narine… la langue saburrale !"
                            },
                            {
                                "example_id": "40e71571-a89d-48e1-b2b9-1ee407cf1103",
                                "sense_id": "e7fe10f1-3eda-34bd-8e4f-c62a664da8b2",
                                "text": "Je passe mes jours de vacances chez elle. Je viens de la voir. Elle me dit toujours : « Comment j’ai pu te fabriquer, une laideronne. C’est ton père, ton père est un monstre ! »"
                            },
                            {
                                "example_id": "6e3561d4-187b-4c42-b0ed-446e7ac0cd10",
                                "sense_id": "e7fe10f1-3eda-34bd-8e4f-c62a664da8b2",
                                "text": "Il devait boire un bol de bouillon chaud en se plaignant au vieil homme de la laideronne qui avait tenté de lui dérober sa bourse."
                            }
                        ]
                    }
                ],
