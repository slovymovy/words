                                "target_senses": [
                                    {
                                        "sense_id": "f9abb76a-328d-3e9c-a811-d242313e427d",
                                        "entry_id": "40c9de98-383d-319a-9221-9b4bbe087f0b",
                                        "glosses": [
                                            "A male given name from Ancient Greek of mostly historical use, and a transliteration from modern Greek."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0251b5e4-d09a-31df-8ab6-bbc59bffcef8",
                                        "entry_id": "40c9de98-383d-319a-9221-9b4bbe087f0b",
                                        "glosses": [
                                            "A male given name from Ancient Greek of mostly historical use, and a transliteration from modern Greek.",
                                            "Pythagoras (c. 570 – c. 495 BC), an Ancient Greek mathematician and philosopher."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3224977b-be2f-49f1-b9e2-e84a299c058b",
                                                "sense_id": "0251b5e4-d09a-31df-8ab6-bbc59bffcef8",
                                                "text": "Gratiano:\nO, be thou damn'd, inexecrable dog!\nAnd for thy life let justice be accused.\nThou almost makest me waver in my faith,\nTo hold opinion with Pythagoras,\nThat souls of animals infuse themselves\nInto the trunks of men: thy currish spirit\nGovern'd a wolf, who, hang'd for human slaughter,\nEven from the gallows did his fell soul fleet,\nAnd, whilst thou lay'st in thy unhallow'd dam,\nInfused itself in thee; for thy desires\nAre wolfish, bloody, starved, and ravenous."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92ab9a99-0f89-3c90-9aef-f15bc9f50a57",
                                        "entry_id": "40c9de98-383d-319a-9221-9b4bbe087f0b",
                                        "glosses": [
                                            "Ellipsis of Pythagoras' theorem."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "colloquial",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de3c5ea6-0bef-4481-930a-7edd658e2fdc",
                                                "sense_id": "92ab9a99-0f89-3c90-9aef-f15bc9f50a57",
                                                "text": "Serge Lang and Gene Murrow (1988), Geometry, →ISBN, page 203: “By Pythagoras, we find the length of the third side, |AB|² = (2a)² – a² = 4a² – a² = 3a²”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab554b11-04b8-4736-b157-81ece81f42ac",
                        "source_entry_id": "1869d2d7-c0b2-32a7-95ba-1243af49dd14",
