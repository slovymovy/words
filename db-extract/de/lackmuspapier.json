                    }
                ],
                "senses": [
                    {
                        "sense_id": "5b4b2c47-2b7b-30d0-97d7-27e44c865f88",
                        "entry_id": "1975f6a7-1bc2-396c-a3be-0466d2ef61c0",
                        "glosses": [
                            "ein Indikator"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2923fe90-2094-44d1-b2d6-7a9076ec98b0",
                                "sense_id": "5b4b2c47-2b7b-30d0-97d7-27e44c865f88",
                                "text": "„… der weiße Niederschlag, der sich bei Ansäuern einer 10%igen (Gewicht/Volumen) wäßrigen Lösung der p-Hydroxybenzoesäuremethylester-Natriumverbindung mit Salzsäure (unter Verwendung von Lackmuspapier als Indikator) bildet, muß nach Waschen Init [sic!] Wasser und zweistündiger Trocknung bei 80 Grad C ein Schmelzintervall von 125-128 Grad C aufweisen; …“"
                            },
                            {
                                "example_id": "ac34d682-769c-44ee-9a86-82ab215706f7",
                                "sense_id": "5b4b2c47-2b7b-30d0-97d7-27e44c865f88",
                                "text": "„Wenn wir diesen Test bei Ihnen, bei Ihren Vorschlägen machen, dann färbt sich dieses Lackmuspapier rot.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7acc816d-7b62-3db6-893f-7f848dd473a4",
                        "entry_id": "1975f6a7-1bc2-396c-a3be-0466d2ef61c0",
                        "glosses": [
                            "hartes Kriterium"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e096e671-7ad6-4540-972b-19914a26a46e",
                                "sense_id": "7acc816d-7b62-3db6-893f-7f848dd473a4",
                                "text": "„Wenn wir diesen Test bei Ihnen, bei Ihren Vorschlägen machen, dann färbt sich dieses Lackmuspapier rot.“"
                            },
                            {
                                "example_id": "58b31f13-ff19-4ef5-b04b-5a0b6747dca9",
                                "sense_id": "7acc816d-7b62-3db6-893f-7f848dd473a4",
                                "text": "„Als Lackmuspapier für die neue Ehrlichkeit gilt die Erhöhung der Mehrwertsteuer.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd6f1359-e942-4a88-ab9b-a049887f8319",
                        "source_entry_id": "1975f6a7-1bc2-396c-a3be-0466d2ef61c0",
                        "source_sense_id": "5b4b2c47-2b7b-30d0-97d7-27e44c865f88",
