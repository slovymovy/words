                "senses": [
                    {
                        "sense_id": "6db44c97-7b37-32d3-bfe6-e203a3c185e1",
                        "entry_id": "11eb7bdb-2bbd-3f97-b82c-59fa83e6be8b",
                        "glosses": [
                            "najważniejsza księga liturgiczna w Kościele katolickim obrządku rzymskiego, zawierająca teksty stałych i zmiennych części mszy świętej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da2e1f98-eb96-43ac-8a97-fb6e68d67d24",
                                "sense_id": "6db44c97-7b37-32d3-bfe6-e203a3c185e1",
                                "text": "Ceremoniarz znalazł odpowiedni formularz w mszale i założył go czerwoną wstążką."
                            },
                            {
                                "example_id": "98d5f2ea-ad6c-402c-b8bb-c694a3b79b17",
                                "sense_id": "6db44c97-7b37-32d3-bfe6-e203a3c185e1",
                                "text": "Kościół zaleca wiernym świeckim, by korzystali ze specjalnych wydań mszału połączonego z lekcjonarzem, w mniejszym, wygodnym formacie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
