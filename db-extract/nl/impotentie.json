                                            },
                                            {
                                                "example_id": "ba448c4d-799e-4777-b799-cf1b3c6898c1",
                                                "sense_id": "219a7adb-7b8b-343f-af07-9ad4dec92106",
                                                "text": "O impotence of mind, in body ſtrong!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1afea531-6d9c-37d3-b9b8-b5cc6434b244",
                                        "entry_id": "e5d19ecd-a7c9-3546-81bf-1c3f25a88bb6",
