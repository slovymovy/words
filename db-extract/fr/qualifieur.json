                        "examples": [
                            {
                                "example_id": "997d13cc-8e46-4f40-819a-92ded511056f",
                                "sense_id": "6cee225a-707a-3ec2-bb17-9d268194e641",
                                "text": "La distinction entre modifieur et qualifieur est motivée par le rôle du concept séquence, dans la structure."
                            },
                            {
                                "example_id": "c5b12035-6226-4b82-aea1-e560f0c78bc5",
                                "sense_id": "6cee225a-707a-3ec2-bb17-9d268194e641",
                                "text": "Le qualifieur est une chaîne de caractères qui permet de qualifier ce que l'on veut de l'objet."
                            },
                            {
                                "example_id": "3e4551ad-7781-412c-a029-6b39fc8fcc77",
                                "sense_id": "6cee225a-707a-3ec2-bb17-9d268194e641",
                                "text": "La forme génitive est préférable voire obligatoire si le qualifieur est humain ou animal."
                            }
                        ]
                    }
                ],
