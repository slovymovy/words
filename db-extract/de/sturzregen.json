                "senses": [
                    {
                        "sense_id": "23d7e54d-54ee-3f63-85f0-356a99c80129",
                        "entry_id": "d9b19a0a-7f99-30b3-8969-90fa7d0d559e",
                        "glosses": [
                            "heftiger Regen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c4e3b9d-ada8-4422-b9b0-b202c01ad34d",
                                "sense_id": "23d7e54d-54ee-3f63-85f0-356a99c80129",
                                "text": "„Nach einem Vormittag Sturzregen von oben, Autoduschen von der Seite und Pfützenschlamm von unten war unsere Kleidung durchgesogen und wir bis auf die Außentemperatur heruntergekühlt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8bb7aca4-5793-4ad7-a723-d9c58fd33dcc",
                        "source_entry_id": "d9b19a0a-7f99-30b3-8969-90fa7d0d559e",
                        "source_sense_id": "23d7e54d-54ee-3f63-85f0-356a99c80129",
                        "source_sense_description": "heftiger Regen",
                        "target_lang_word": "downpour",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "downpour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d5db4be-7990-378a-89ae-ea1b83d53826",
                                        "entry_id": "ec5200c8-e9cd-3c86-8ec8-954e09d92f0c",
                                        "glosses": [
                                            "A heavy rain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75af58f8-8d09-405d-9e47-bf50b5a7e750",
                                                "sense_id": "7d5db4be-7990-378a-89ae-ea1b83d53826",
                                                "text": "They got caught in a downpour without an umbrella and came back soaked."
                                            },
                                            {
                                                "example_id": "d5815f23-7541-4881-8c00-2cb063b41a22",
                                                "sense_id": "7d5db4be-7990-378a-89ae-ea1b83d53826",
                                                "text": "I left Inverness on a Saturday afternoon in July in a steady downpour of rain."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "downpour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3dc469b6-5cb4-33f0-8b0f-ea4246a5f0aa",
                                        "entry_id": "1202e03f-54e7-3654-97a3-65b309fc9e33",
                                        "glosses": [
                                            "To pour down; rain heavily."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed8f2804-c6ae-4f28-9011-a09c406d91af",
                                                "sense_id": "3dc469b6-5cb4-33f0-8b0f-ea4246a5f0aa",
                                                "text": "It started to downpour, so Billy and I made our way back to our house, with Scotty following—or so I thought."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81cb61ed-84a7-407a-a246-55861463463f",
                        "source_entry_id": "d9b19a0a-7f99-30b3-8969-90fa7d0d559e",
                        "source_sense_id": "23d7e54d-54ee-3f63-85f0-356a99c80129",
                        "source_sense_description": "heftiger Regen",
                        "target_lang_word": "cloudburst",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cloudburst",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "74ef6594-2bec-3379-bd00-e04de0e0c4ac",
                                        "entry_id": "a6fbaec6-6394-3dec-8fe0-b40c3b52ad51",
                                        "glosses": [
                                            "A sudden heavy rainstorm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "256b1580-53b1-48f5-a5f9-22bdcda61494",
                                                "sense_id": "74ef6594-2bec-3379-bd00-e04de0e0c4ac",
                                                "text": "A cloudburst in the China Creek district followed by continued heavy rains was responsible for the increased water."
                                            },
                                            {
                                                "example_id": "d0a9801d-1db7-47a9-91e1-7a1580b219af",
                                                "sense_id": "74ef6594-2bec-3379-bd00-e04de0e0c4ac",
                                                "text": "[B]ut the sound . . . expressed an utter abandonment to grief; not the cloud-burst of some passing emotion, but the slow down-pour of a whole heaven of sorrow."
                                            },
                                            {
                                                "example_id": "c6ef93fa-5c5e-4e0f-84c5-f6546046eeb0",
                                                "sense_id": "74ef6594-2bec-3379-bd00-e04de0e0c4ac",
                                                "text": "In Uniontown, Pa., John Walchesky & family rushed from their house when lightning set it afire, rushed in again when a cloudburst put out the blaze."
                                            },
                                            {
                                                "example_id": "d84da91d-2bff-40a6-b198-139524b51d60",
                                                "sense_id": "74ef6594-2bec-3379-bd00-e04de0e0c4ac",
                                                "text": "[H]e walked across the lawn, wet from a fleeting late-afternoon cloudburst, the first rain in a month."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "684c51b7-eb10-46bd-a76d-4d3a01cef196",
                        "source_entry_id": "d9b19a0a-7f99-30b3-8969-90fa7d0d559e",
