                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38d24ee7-8760-496d-8830-ed1b88b2c026",
                                "sense_id": "696611d9-6698-3056-839e-4f014408e1a7",
                                "text": "\"Normaal doe ik hem altijd uit, maar ik denk dat ik hem nu aan heb laten staan\", redeneert Jackee. Hun familiefortuin was veranderd in sliertjes. \"Ooit kunnen we hierom lachen\", relativeerde Ben meteen."
                            },
                            {
                                "example_id": "5a238b17-614a-46c2-97be-d7a5b8c8ba3b",
                                "sense_id": "696611d9-6698-3056-839e-4f014408e1a7",
                                "text": "David Rockefeller beheerde het familiefortuin sinds 2004 en was daarmee de oudste miljardair ter wereld. Zijn opa John D. Rockefeller was een van de eerste miljardairs in de Verenigde Staten. Hij maakte zijn familie de rijkste en machtigste van het land."
                            },
                            {
                                "example_id": "5560254f-3948-4d71-9c8d-7c00ee82664f",
                                "sense_id": "696611d9-6698-3056-839e-4f014408e1a7",
                                "text": "Het scheidende stel vocht over de verdeling van het familiefortuin van ruim anderhalf miljard euro. De ex, Jamie Cooper, eiste de helft van het vermogen, maar Hohn wilde niet meer dan een kwart afstaan omdat hij er meer aan zou hebben bijgedragen dan zijn vrouw. De rechter koos voor de gulden middenweg."
                            }
                        ]
