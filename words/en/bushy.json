{
    "word_family": [
        "bush"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c92d2665-ab83-3d57-8659-412acea98669",
                    "sense_definition": "Like a bush in having many branches that spread out densely in all directions.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dense_growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The squirrel has a very <w>bushy</w> tail.",
                            "target_lang_translations": {
                                "ru": "У белки очень <w>пушистый</w> хвост."
                            }
                        },
                        {
                            "text": "The <w>bushy</w> branches of the tree provided shade.",
                            "target_lang_translations": {
                                "ru": "<w>Густые</w> ветви дерева давали тень."
                            }
                        }
                    ],
                    "synonyms": [
                        "dense",
                        "thick"
                    ],
                    "antonyms": [
                        "sparse"
                    ],
                    "common_phrases": [
                        "bushy tail"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий густую, разветвленную структуру, напоминающую куст."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пушистый",
                                "target_lang_sense_clarification": "о хвосте или мехе"
                            },
                            {
                                "target_lang_word": "густой",
                                "target_lang_sense_clarification": "о ветвях или растительности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e482a2b7-bc99-37d1-989f-92a099a53887",
                    "sense_definition": "Growing thickly, often used to describe hair or vegetation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dense_growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has thick and <w>bushy</w> eyebrows.",
                            "target_lang_translations": {
                                "ru": "У него густые и <w>лохматые</w> брови."
                            }
                        },
                        {
                            "text": "The man had a <w>bushy</w> beard that covered his chin.",
                            "target_lang_translations": {
                                "ru": "У мужчины была <w>густая</w> борода, закрывавшая подбородок."
                            }
                        }
                    ],
                    "synonyms": [
                        "thick",
                        "shaggy"
                    ],
                    "antonyms": [
                        "thin"
                    ],
                    "common_phrases": [
                        "bushy eyebrows",
                        "bushy beard"
                    ],
                    "target_lang_definitions": {
                        "ru": "Густо растущий, часто используется для описания волос, бровей или бороды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "густой",
                                "target_lang_sense_clarification": "о волосах, бровях"
                            },
                            {
                                "target_lang_word": "лохматый",
                                "target_lang_sense_clarification": "о бороде или прическе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d1048f3d-8e71-3243-90e0-5a3672b38c2b",
                    "sense_definition": "An alternative form of <w>bushie</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>bushies</w> live in the remote outback.",
                            "target_lang_translations": {
                                "ru": "<w>Жители глубинки</w> живут в отдаленных районах буша."
                            }
                        },
                        {
                            "text": "Many <w>bushies</w> prefer the quiet life.",
                            "target_lang_translations": {
                                "ru": "Многие <w>жители глубинки</w> предпочитают тихую жизнь."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Australian slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Австралийский сленговый термин для обозначения людей, живущих в отдаленных сельских районах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "житель глубинки",
                                "target_lang_sense_clarification": "австралийский сленг"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}