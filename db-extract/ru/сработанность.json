                    },
                    {
                        "translation_id": "f45c6582-4791-4ea2-a633-4311d49ca39a",
                        "source_entry_id": "d00bf3be-9e41-3d7c-b7a0-044beb90faf0",
                        "source_sense_description": "согласие в работе",
                        "target_lang_word": "entente",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entente",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5990a2ee-44bd-3bdb-8775-1cc6772a7df3",
                                        "entry_id": "de14cdc2-00d7-3f7c-b298-97e90e7ec39c",
                                        "glosses": [
                                            "Interprétation qu’on donne à un mot, à une phrase équivoque et susceptible de plusieurs sens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a476146a-e0cd-4f53-acb9-ae63eb9a51dd",
                                                "sense_id": "5990a2ee-44bd-3bdb-8775-1cc6772a7df3",
                                                "text": "Mots, phrases à double entente."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3e9efc8-dbdc-365b-a616-2f94a16dadca",
                                        "entry_id": "de14cdc2-00d7-3f7c-b298-97e90e7ec39c",
                                        "glosses": [
                                            "Intelligence et connaissance approfondie d’une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b8f8024-348a-4323-aafe-ad19fd98e892",
                                                "sense_id": "c3e9efc8-dbdc-365b-a616-2f94a16dadca",
                                                "text": "Il avait l’entente des bibelots et des chiffons. Du premier coup il voyait, réparait dans les toilettes de la jeune fille les désastres causés par le goût triste et voyant de Mme Montessuy."
                                            },
                                            {
                                                "example_id": "ba16fa63-0465-4191-ac82-b7870027267d",
                                                "sense_id": "c3e9efc8-dbdc-365b-a616-2f94a16dadca",
                                                "text": "Cette sagace entente de la vie pratique n’a aucun rapport avec les vésanies et les délires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0ad5e24-0972-37ab-9353-8ad701aa1e8b",
                                        "entry_id": "de14cdc2-00d7-3f7c-b298-97e90e7ec39c",
                                        "glosses": [
                                            "Bonne intelligence entre des parties."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f9b69ad-0546-46d3-8ae6-8eafaf22322e",
                                                "sense_id": "b0ad5e24-0972-37ab-9353-8ad701aa1e8b",
                                                "text": "Cheikh Gaafar avait déjà deux épouses, et cinq filles. […] L'idée de convoler une troisième fois en noces lui plut: certes l'entente serait malaisée à son foyer."
                                            },
                                            {
                                                "example_id": "c40599c8-df63-4f8a-bd93-b07e37d81590",
                                                "sense_id": "b0ad5e24-0972-37ab-9353-8ad701aa1e8b",
                                                "text": "Bien que la forte personnalité de mon père et celle de ma grand-mère se percutassent parfois, l’entente régna, et quand mon oncle Juan, le fils de ma grand-mère, disparut pendant la guerre civile, mon père fut d'un grand soutien pour ma grand-mère."
                                            },
                                            {
                                                "example_id": "b0f42553-80e4-427d-bd98-8c181865ab93",
                                                "sense_id": "b0ad5e24-0972-37ab-9353-8ad701aa1e8b",
                                                "text": "Carteus était un grand technicien qui aurait pu faire une grande carrière internationale malheureusement, l'entente avec Van Himst sur le plan footballistique était loin d'être parfaite!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a07eb68-3f94-3f29-9e18-82a08417c042",
                                        "entry_id": "de14cdc2-00d7-3f7c-b298-97e90e7ec39c",
                                        "glosses": [
                                            "Pacte entre plusieurs parties."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30f80958-e82a-4000-bb60-b2a8a3f709ea",
                                                "sense_id": "5a07eb68-3f94-3f29-9e18-82a08417c042",
                                                "text": "Après les premiers refus, il avait souri, hautain et méprisant ; mais à présent qu’il soupçonnait l’entente secrète et flairait la conspiration, il ne décolérait plus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7986fc71-bf54-3803-be01-4af92e4f1309",
                                        "entry_id": "de14cdc2-00d7-3f7c-b298-97e90e7ec39c",
                                        "glosses": [
                                            "Accord qui existe entre les vues et les desseins de deux ou plusieurs États sur un certain nombre de questions de politique internationale."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9e74622-e377-468f-958e-778a92c3a015",
                                                "sense_id": "7986fc71-bf54-3803-be01-4af92e4f1309",
                                                "text": "J'aimais à relire la vie des flibustiers, […], maîtres de ces parages au XVIIᵉ et au XVIIIᵉ siècle, avant que l'entente franco-anglaise mît fin à cette guerre de pillage et de course."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "082d5b07-6d1a-3475-939c-1b3761e68bc2",
                                        "entry_id": "de14cdc2-00d7-3f7c-b298-97e90e7ec39c",
                                        "glosses": [
                                            "Pratique anticoncurrentielle par laquelle plusieurs acteurs économiques se mettent d’accord pour tenter de contourner les règles de mise en concurrence ou d’augmenter leur marge."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fed3c419-06ed-4229-bbcd-429c3044c141",
                                                "sense_id": "082d5b07-6d1a-3475-939c-1b3761e68bc2",
                                                "text": "L’évolution du droit de la commande publique, d’abord en admettant la possibilité pour un pouvoir adjudicateur de faire compléter une candidature, ensuite en supprimant l’obligation de signature de l’acte d’engagement au stade de la remise des offres, et en autorisant la régularisation des offres irrégulières, contraint à davantage d’ingéniosité les entreprises membres de l’entente pour mener de telles manœuvres frauduleuses, se félicite Jean Dulac."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "603cfa5d-9edc-4167-a4e8-3fe5c28fda7d",
                        "source_entry_id": "d00bf3be-9e41-3d7c-b7a0-044beb90faf0",
                        "source_sense_description": "согласие в работе",
                        "target_lang_word": "cohésion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cohésion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1e6e1ae0-6bca-3ab1-b7f7-644dcde6b0c6",
                                        "entry_id": "87f4e83a-57e6-3e4a-89f2-0ac989e7eb30",
                                        "glosses": [
                                            "Force par laquelle les parties d’un corps adhèrent entre elles."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38d183ad-2652-4ba1-9899-ce6882bf55f6",
                                                "sense_id": "1e6e1ae0-6bca-3ab1-b7f7-644dcde6b0c6",
                                                "text": "La cohésion est plus forte dans les corps solides que dans les corps liquides."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89fe92cd-c556-39e9-9979-05e89d92f75b",
                                        "entry_id": "87f4e83a-57e6-3e4a-89f2-0ac989e7eb30",
                                        "glosses": [
                                            "Fait de rester ensemble, unis."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7792c1d5-3c79-42cf-b936-9564fd620cf8",
                                                "sense_id": "89fe92cd-c556-39e9-9979-05e89d92f75b",
                                                "text": "Mais ce territoire d’un demi-million de kilomètres carrés de surface, dont la population est estimée à une dizaine de millions d’habitants, est loin d’avoir la cohésion d’un État européen, et l’autorité effective des sultans ne s’est jamais étendue qu’à un tiers, tout au plus, du Maroc."
                                            },
                                            {
                                                "example_id": "c515a3bf-a96e-469f-8380-d0a31736caa3",
                                                "sense_id": "89fe92cd-c556-39e9-9979-05e89d92f75b",
                                                "text": "La compréhension des liens entre la cohésion territoriale et la cohésion sociale est un défi majeur pour les politiques publiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
