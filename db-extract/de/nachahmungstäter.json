                "senses": [
                    {
                        "sense_id": "c16836a9-351d-3955-8021-68e23ca59064",
                        "entry_id": "aac08556-c7cd-3022-a87e-c19b053e8add",
                        "glosses": [
                            "Person, die eine begangene Straftat nachahmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf199148-a6cc-49de-9c3c-c1105c72a688",
                                "sense_id": "c16836a9-351d-3955-8021-68e23ca59064",
                                "text": "„Die Schulbehörde hatte Angst vor Nachahmungstätern.“"
                            },
                            {
                                "example_id": "6f3e2069-c12f-462b-99ae-7f4b976fcf7d",
                                "sense_id": "c16836a9-351d-3955-8021-68e23ca59064",
                                "text": "„Die Strafverfolgungsbehörden waren, wie immer, in Sorge, damit Nachahmungstäter zu ermutigen und den Forderungen eines Mörders nachzukommen.“"
                            },
                            {
                                "example_id": "41ed3d05-a39e-4d94-bb5a-d642909257a6",
                                "sense_id": "c16836a9-351d-3955-8021-68e23ca59064",
                                "text": "„Die Polizei glaubt, dass sie es mit einem Nachahmungstäter zu tun hat.“"
                            }
                        ],
