                                "sense_id": "50b7cb6b-33b1-34a5-b4fc-3318ab80e5d0",
                                "text": "Van de takelage stond alleen nog den bezaans- en voorondermast."
                            }
                        ]
                    },
                    {
                        "sense_id": "68d18659-ae02-3643-b98c-210e712c717f",
                        "entry_id": "56e5d8d4-5169-3947-94ea-7e8f95a6edb0",
                        "glosses": [
                            "het ophijsen van lasten met behulp van een takel of kraan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1701f1d-36a0-4e07-a386-59ce4460a864",
                                "sense_id": "68d18659-ae02-3643-b98c-210e712c717f",
