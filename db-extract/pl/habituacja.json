                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f7f4bc7c-66bb-40ef-8fcf-76c8cdb28e03",
                        "source_entry_id": "a4b91d46-6feb-3326-9c50-d8f0e379b258",
                        "source_sense_id": "ba8a0579-4e1e-3bf5-b901-46272ad7745f",
                        "target_lang_word": "habituation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "habituation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f80a57b9-1d0f-327f-bbc2-57b60b9195dc",
                                        "entry_id": "1d9f3a14-63e9-3126-8a0f-e330b07af460",
                                        "glosses": [
                                            "Action d’habituer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dccb4186-e926-4c6e-a9a5-5e8bcb9c3b0a",
                                                "sense_id": "f80a57b9-1d0f-327f-bbc2-57b60b9195dc",
                                                "text": "Je ne suis grammairien dominant, comme Castelvetro ; je suis grammairien valet, comme vous diriez un régent de la cinquième et ne puis vous offrir que mes yeux, ma main et mon habituation à l'imprimerie."
                                            },
                                            {
                                                "example_id": "b886d3a3-fbc0-476a-8690-b5a6811938bc",
                                                "sense_id": "f80a57b9-1d0f-327f-bbc2-57b60b9195dc",
                                                "text": "L’habituation implique ultérieurement que l’action en question peut être reproduite dans le futur de la même manière et avec la même économie d’effort."
                                            },
                                            {
                                                "example_id": "fca8d830-fce6-4092-9170-7ba822d6e135",
                                                "sense_id": "f80a57b9-1d0f-327f-bbc2-57b60b9195dc",
                                                "text": "Il reste les approches psychothérapeutiques d’habituation, l’écoute de sons relaxants, voire… le recours aux bouchons d’oreilles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee0d23df-c365-3bc8-a8d6-02df00f310dd",
                                        "entry_id": "1d9f3a14-63e9-3126-8a0f-e330b07af460",
                                        "glosses": [
                                            "Qualité de prêtre habitué dans une paroisse."
                                        ],
