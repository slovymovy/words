                ],
                "translations": [
                    {
                        "translation_id": "81459ff3-34f5-4e93-9fd1-9fa7fff7f52e",
                        "source_entry_id": "36d59aaf-066b-351c-a76c-508297d840ca",
                        "target_lang_word": "nationality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nationality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "82e0e04c-fb93-3c73-bef3-420187949242",
                                        "entry_id": "79418080-5c4b-3e97-b187-bb6bc614adf3",
                                        "glosses": [
                                            "National, i.e. ethnic and/or cultural, character or identity."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d9d9a6f-e4dc-4448-95bf-c22d02e498b6",
                                                "sense_id": "82e0e04c-fb93-3c73-bef3-420187949242",
                                                "text": "[…]permit me to say that the Harranians were Arabs and that the Arabs in occupying Spain and Andalusia did not lose their nationality; they remained Arabs. […] The fact that they preserved their former religion, Sabaeanism, does not mean they should be considered foreign to the Arab nationality."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d1ece68-9a77-31b9-9a61-0bff954c17d8",
                                        "entry_id": "79418080-5c4b-3e97-b187-bb6bc614adf3",
                                        "glosses": [
                                            "Nationalism or patriotism."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ac84a4d-5332-42a5-ac12-6ec755102e0f",
                                                "sense_id": "3d1ece68-9a77-31b9-9a61-0bff954c17d8",
                                                "text": "‘You are, to be sure, wonderfully free from that nationality: but so it happens, that you employ the only Scotch shoe-black in London.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "858baad8-28e1-3dc7-80a8-8ce48607b2db",
                                        "entry_id": "79418080-5c4b-3e97-b187-bb6bc614adf3",
                                        "glosses": [
                                            "National origin or identity; legal membership of a particular nation or state, by origin, birth, naturalization, ownership, allegiance or otherwise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe2bb1c8-cc27-4bb4-9899-db0c1e40b401",
                                                "sense_id": "858baad8-28e1-3dc7-80a8-8ce48607b2db",
                                                "text": "By living in the country for five years, you are entitled to get nationality."
                                            },
                                            {
                                                "example_id": "63415f4d-d9c8-417e-bd06-e1644025aa3c",
                                                "sense_id": "858baad8-28e1-3dc7-80a8-8ce48607b2db",
                                                "text": "Stefi was born in Spain to a Brazilian father and a Chilean mother, so is eligible for three nationalities."
                                            },
                                            {
                                                "example_id": "97a31539-fc25-477d-8c20-8f3a55617ef8",
                                                "sense_id": "858baad8-28e1-3dc7-80a8-8ce48607b2db",
                                                "text": "Please include your nationality on the form."
                                            },
                                            {
                                                "example_id": "44cf47d8-e0cd-4f89-8849-ad607d785bc5",
                                                "sense_id": "858baad8-28e1-3dc7-80a8-8ce48607b2db",
                                                "text": "One reason why many Asian countries oppose dual nationality is a belief that it can create divided loyalties among citizens, said Jelena Dzankic, co-director of the Global Citizenship Observatory (GLOBALCIT), an international citizenship research network."
                                            },
                                            {
                                                "example_id": "abe1e828-1100-437d-966e-f1b06a4f0060",
                                                "sense_id": "858baad8-28e1-3dc7-80a8-8ce48607b2db",
                                                "text": "Guatemala has pledged a 40% increase in deportation flights carrying Guatemalans and migrants of other nationalities from the United States, President Bernardo Arévalo announced Wednesday during a press conference with US Secretary of State Marco Rubio."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c41f34f0-c244-3392-815e-6c62695f954a",
                                        "entry_id": "79418080-5c4b-3e97-b187-bb6bc614adf3",
                                        "glosses": [
                                            "A people sharing a common origin, culture and/or language, and possibly constituting a nation-state."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0336f6c0-2a83-35c3-98b4-1b25b892b2af",
                                        "entry_id": "79418080-5c4b-3e97-b187-bb6bc614adf3",
                                        "glosses": [
                                            "Political existence, independence or unity as a national entity."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00458398-e73d-4439-87a9-d09e5b9ff82b",
                        "source_entry_id": "36d59aaf-066b-351c-a76c-508297d840ca",
                        "target_lang_word": "nationalité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nationalité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1163f36d-a162-3124-a6be-b2a77d9abf0c",
                                        "entry_id": "ef56d990-5eb7-3c76-b069-fb60949a8649",
                                        "glosses": [
                                            "État d’une personne qui est membre d’une nation particulière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c2d381a-f380-46e0-9b65-7eb373fbc576",
                                                "sense_id": "1163f36d-a162-3124-a6be-b2a77d9abf0c",
                                                "text": "Ne sont éligibles que les personnes de nationalité allemande et qui sont majeures."
                                            },
                                            {
                                                "example_id": "fa8a9c24-49b2-4295-aa9d-0c68e8f448b6",
                                                "sense_id": "1163f36d-a162-3124-a6be-b2a77d9abf0c",
                                                "text": "Au moment de mettre ce livre sous presse, je viens d’apprendre qu’effectivement, la Junte m’a « déchu » de la nationalité chilienne."
                                            },
                                            {
                                                "example_id": "140441e1-5bc5-456b-8e55-e5ab05232694",
                                                "sense_id": "1163f36d-a162-3124-a6be-b2a77d9abf0c",
                                                "text": "Qui plus est, alors que la loi stipulait pour la première fois que les enfants nés de parents ayant résidé huit ans en Allemagne et détenteurs d'un statut de résidence permanent bénéficiaient de la nationalité allemande, elle stipulait également qu’ils devaient abandonner leur deuxième nationalité à leur dix-huitième anniversaire, faute de quoi ils perdraient la nationalité allemande."
                                            },
                                            {
                                                "example_id": "70999116-5a2c-41cf-91e9-379c5bec6bb8",
                                                "sense_id": "1163f36d-a162-3124-a6be-b2a77d9abf0c",
                                                "text": "La nationalité française ou étrangère de la population est enregistrée dans les recensements menés depuis 1851 […]."
                                            },
                                            {
                                                "example_id": "0c304c05-ccc7-4c56-843f-84cd6fa8185b",
                                                "sense_id": "1163f36d-a162-3124-a6be-b2a77d9abf0c",
                                                "text": "Selon son nouveau projet de loi présenté mercredi, le gouvernement va surtout autoriser la double nationalité en permettant aux étrangers devenant allemands de garder leur passeport d'origine, un principe qui était admis pour les ressortissants européens mais pas les autres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fd240b3-cd58-3fef-abce-2bc5bd9f4537",
                                        "entry_id": "ef56d990-5eb7-3c76-b069-fb60949a8649",
                                        "glosses": [
                                            "Caractéristique d’un groupe de personnes unies par une communauté de langue, de culture ou de religion et existant en tant que nation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7581979-0cf7-490a-b22d-d6de1fdc2fe5",
                                                "sense_id": "1fd240b3-cd58-3fef-abce-2bc5bd9f4537",
                                                "text": "Il n’y avait point de nationalités, quoique les nuances de la peau différassent dans les diverses parties de la planète."
                                            },
                                            {
                                                "example_id": "d152a105-3dcb-4963-af80-aacec7130155",
                                                "sense_id": "1fd240b3-cd58-3fef-abce-2bc5bd9f4537",
                                                "text": "C'est au XVIIIᵉ siècle qu’est apparu le principe de nationalité en Europe occidentale et septentrionale, où il s’est solidement implanté grâce à des dynasties et à des élites dirigeantes remontant au Moyen Âge, lesquelles ont assuré une continuité du pouvoir politique. La nationalité devint le fondement déterminant de l’identité et du loyalisme politique."
                                            },
                                            {
                                                "example_id": "7bc0351b-c499-474d-bf7b-d4626109a6ba",
                                                "sense_id": "1fd240b3-cd58-3fef-abce-2bc5bd9f4537",
                                                "text": "Il est intéressant de noter au bénéfice de nos modernes souverainistes que des romantiques comme Mazzini, Michelet, Lamartine ou Hugo ne voyaient aucune contradiction entre nationalité et européanité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a8095c9-e3ea-386a-9598-b7a98db95d84",
                                        "entry_id": "ef56d990-5eb7-3c76-b069-fb60949a8649",
                                        "glosses": [
                                            "Groupe humain qui existe ou qui cherche à exister comme nation ; peuple d’une nation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "922b5ba1-c4d6-4041-8aff-2acc1f36944c",
                                                "sense_id": "3a8095c9-e3ea-386a-9598-b7a98db95d84",
                                                "text": "Par sa position, elle a toujours eu le triste privilège d'être le champ-clos où se débattirent successivement les nationalités Neustrienne et Austrasienne; Franque et Germanique; Allemande et Française ; […]."
                                            },
                                            {
                                                "example_id": "7ec39550-dd8b-496d-8211-19c6746177dd",
                                                "sense_id": "3a8095c9-e3ea-386a-9598-b7a98db95d84",
                                                "text": "Châlette-sur-Loing a été pendant longtemps et reste la ville la plus cosmopolite de France ! Huit mille habitants : trois mille étrangers. Vingt-cinq nationalités recensées en 1927 par Monsieur le Maire et aujourd’hui rien moins que quatre églises orthodoxes et deux mosquées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
