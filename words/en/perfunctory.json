    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8b50b2c9-295f-3997-96fa-cbe920e4e750",
                    "sense_definition": "Done only to meet a minimal requirement or to follow a formal duty.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "minimal_effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager gave a <w>perfunctory</w> nod to the staff before rushing out of the meeting."
                        },
                        {
                            "text": "He offered a <w>perfunctory</w> apology that clearly lacked any real sincerity."
                        }
                    ],
                    "synonyms": [
                        "obligatory",
                        "pro forma",
                        "token"
                    ],
                    "antonyms": [
                        "thorough"
                    ],
                    "common_phrases": [
                        "perfunctory apology",
                        "perfunctory nod"
                    ]
                },
                {
                    "sense_id": "f6904c85-579b-3e30-9731-5bbed011c426",
                    "sense_definition": "Performed in a careless or indifferent way as a matter of routine.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "minimal_effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The guard performed a <w>perfunctory</w> check of the bags before letting us enter the building."
                        },
                        {
                            "text": "His <w>perfunctory</w> cleaning left the kitchen floor still covered in dust and grime."
                        }
                    ],
                    "synonyms": [
                        "automatic",
                        "mechanical",
                        "cursory",
                        "haphazard",
                        "slipshod",
                        "unthinking"
                    ],
                    "antonyms": [
                        "careful",
                        "complete"
                    ],
                    "common_phrases": [
