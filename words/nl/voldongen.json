                    "sense_id": "aef63cf9-3420-3dd9-b6b4-f82212ef26fd",
                    "sense_definition": "Definitief beslist en niet meer te veranderen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is een <w>voldongen</w> feit dat de prijzen volgend jaar gaan stijgen. ",
                            "target_lang_translations": {
                                "en": "It is an <w>accomplished</w> fact that prices will rise next year."
                            }
                        },
                        {
                            "text": "De beslissing is genomen, we staan voor een <w>voldongen</w> feit.",
                            "target_lang_translations": {
                                "en": "The decision has been made; we are faced with a <w>fait accompli</w>."
                            }
                        }
                    ],
                    "synonyms": [
