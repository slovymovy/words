                    },
                    {
                        "translation_id": "13665bb4-c422-4299-ace1-f4392d11e417",
                        "source_entry_id": "d69ad08b-c42e-31e6-923c-41f8240a516a",
                        "target_lang_word": "soužití",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "soužití",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "9bbc5cfb-48f1-30b3-b7f2-fe047fd587f5",
                                        "entry_id": "3b6decc2-145d-398d-8bd6-cea4d1690b2c",
                                        "glosses": [
                                            "společný život zahrnující vzájemné vztahy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0503cb9-dc00-481b-86cb-9d121c670ef4",
                                                "sense_id": "9bbc5cfb-48f1-30b3-b7f2-fe047fd587f5",
                                                "text": "Jenže politici, kteří netouží proměnit zemi, v níž se drží dočasně část moci, v napěchovaný papiňák, se obvykle snaží rasové vášně tlumit, hledat cesty k soužití, podporovat všechny možné cesty k aspoň částečnému zlepšení, podporovat pozitivní příklady."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
