                        "glosses": [
                            "Relatif aux Lagides."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "35e6c7fd-7e90-470e-bb28-373d129e569b",
                                "sense_id": "74e8c6ec-fc4a-3f5c-868a-3df55845ad09",
                                "text": "L’influence réelle de Cléopâtre sur César fait toujours débat. Indépendamment de son caractère romanesque, leur relation marqua une nouvelle étape dans les rapports entre Rome et le royaume lagide. Avec César, l’Égypte semblait obtenir des concessions sans contrepartie apparente pour Rome."
                            }
                        ]
                    }
