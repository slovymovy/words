                        "source_sense_id": "726e7fc0-c10e-34aa-ba52-ede9f3775fb6",
                        "source_sense_description": "de afstand die een rijdend voertuig nodig heeft om tot stilstand te komen",
                        "target_lang_word": "Bremsweg",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bremsweg",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d4a93de5-7e14-36b3-9a4f-55bc4fc178d9",
                                        "entry_id": "1ecdf952-269a-3445-876e-c7d8dcf0ee1e",
                                        "glosses": [
                                            "die Strecke, nach der ein Fahrzeug nach Betätigung der Bremse zum Stehen kommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb62fbc2-900b-44f8-b866-c10c7509fec3",
                                                "sense_id": "d4a93de5-7e14-36b3-9a4f-55bc4fc178d9",
                                                "text": "Der Bremsweg eines Fahrzeugs ist von vielen Umständen abhängig."
                                            },
                                            {
                                                "example_id": "e1b3d9f2-96b3-41f7-ad48-b415df68cb1b",
                                                "sense_id": "d4a93de5-7e14-36b3-9a4f-55bc4fc178d9",
                                                "text": "Im Herbst sollte man wegen eines möglichen Wildunfalls auf Landstraßen mit angepasster Geschwindigkeit fahren, beispielsweise nur mit 80 km/h statt 100 km/h, das verkürzt den Bremsweg um ca. 25 Meter."
                                            },
                                            {
                                                "example_id": "ed173fb8-d0e3-4271-9de6-01c416e473ea",
                                                "sense_id": "d4a93de5-7e14-36b3-9a4f-55bc4fc178d9",
                                                "text": "„In der Folge würden sich die für eine Verzögerung des Fahrzeugs erforderlichen Betätigungskräfte des Pedals erhöhen sowie sich der Bremsweg gegebenenfalls verlängern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9a19b9c-f0a3-4f62-bba1-0500990d8b96",
