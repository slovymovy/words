                "senses": [
                    {
                        "sense_id": "56dadce0-b2fb-3e64-bd57-2b1ff1513df2",
                        "entry_id": "10f3b663-60b7-39e4-9cb8-ce0799f8b798",
                        "glosses": [
                            "устар., рег. то же, что становиться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dcaaeda0-7899-4381-9ca1-076bc6a8d4c3",
                                "sense_id": "56dadce0-b2fb-3e64-bd57-2b1ff1513df2",
                                "text": "Странствует, молится, кается, легче ему не стаёт."
                            }
                        ]
                    },
                    {
                        "sense_id": "efa14b35-848d-3a47-ae5b-b3ef4e1fecbc",
                        "entry_id": "10f3b663-60b7-39e4-9cb8-ce0799f8b798",
                        "glosses": [
                            "устар., рег. несов. к стать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4f71836-b4ec-43a0-9056-3548c316cbaa",
                                "sense_id": "efa14b35-848d-3a47-ae5b-b3ef4e1fecbc",
                                "text": "Юношеских сил его става́ло на всё."
                            },
                            {
                                "example_id": "4b238fb7-7c68-42a4-b8cd-2da50bc9e6c8",
                                "sense_id": "efa14b35-848d-3a47-ae5b-b3ef4e1fecbc",
                                "text": "Должен я служить, пока стаёт терпенья."
                            },
                            {
                                "example_id": "2676438a-1678-43d5-8149-a6df8b587e18",
                                "sense_id": "efa14b35-848d-3a47-ae5b-b3ef4e1fecbc",
                                "text": "Даже у Фиглярина ругательств не стаёт."
                            }
                        ]
                    }
