                    },
                    {
                        "translation_id": "407ee227-078a-4aac-8bef-30f9c1453386",
                        "source_entry_id": "29f192a0-7d5a-3470-b9a6-fa930b611485",
                        "source_sense_id": "78bc7100-6994-32a4-9e6d-c9c9f76abac5",
                        "target_lang_word": "Technokrat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Technokrat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf5faca8-d9aa-324a-b181-77703b87d681",
                                        "entry_id": "322308bf-2054-3905-b3c1-7ced861536e4",
                                        "glosses": [
                                            "Anhänger der Technokratie als Regierungsform"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "085c37cf-9ad6-472b-afa5-e6d6daf3726c",
                                                "sense_id": "cf5faca8-d9aa-324a-b181-77703b87d681",
                                                "text": "„Dieser gebildete, vielsprachige, wendige Technokrat war die ideale Ergänzung zu dem großen Charismatiker Masaryk.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "28772ed7-f0c3-3278-86f7-abf660ce87ee",
                                        "entry_id": "322308bf-2054-3905-b3c1-7ced861536e4",
                                        "glosses": [
                                            "Person, deren Handeln auf Funktionalität ausgerichtet"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40f67c3b-ba01-4e57-9a63-4ee8ab23b69a",
                        "source_entry_id": "29f192a0-7d5a-3470-b9a6-fa930b611485",
                        "source_sense_id": "78bc7100-6994-32a4-9e6d-c9c9f76abac5",
                        "target_lang_word": "technocraat",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "technocraat",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "073a1ec7-a963-3b43-bcd8-c9063d45929d",
                                        "entry_id": "e229e02b-9581-3651-a8d1-a217e99be4e8",
                                        "glosses": [
                                            "iemand die zijn beslissingen maakt op basis van zakelijke en wetenschappelijke inzichten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6795f2f0-441a-4df6-887c-208d395dd25a",
                                                "sense_id": "073a1ec7-a963-3b43-bcd8-c9063d45929d",
                                                "text": "Nadat premier Rutte vorige week de aftrap van zijn derde kabinet heeft gegeven, is deze week de beurt aan minister van Financiën Wopke Hoekstra (CDA). Ontpopt hij zich als technocraat of toch vooral politicus?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d055551-fe66-3837-bf4c-c35dddcdd670",
                                        "entry_id": "e229e02b-9581-3651-a8d1-a217e99be4e8",
                                        "glosses": [
                                            "een ongevoelig iemand die geen rekening houdt met mensen"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b482a4e6-fdb9-4a56-95a4-87ad70895c8c",
                                                "sense_id": "3d055551-fe66-3837-bf4c-c35dddcdd670",
                                                "text": "Er zijn niet veel schrijvers die over de techniek in romans en verhalen vertellen. — Ik ben zo'n barbaarse technocraat dat ik denk dat je ze kunt oplappen, alsof ze een Model T Ford zijn."
                                            },
                                            {
                                                "example_id": "f47669dc-d44d-4f72-99b2-0a18bc16e7f3",
                                                "sense_id": "3d055551-fe66-3837-bf4c-c35dddcdd670",
                                                "text": "Decennia zijn ambtenaren beschimpt, weggezet als technocraten die niets doen óp kosten van mijn belastingcenten'. In werkelijkheid zijn topambtenaren nodig om te remmen dan wel te stimuleren, want de politici zelf zijn al te vaak slaven van de publieke opinie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de8bec47-eda0-454c-ac6d-b5fca9281eb7",
                        "source_entry_id": "29f192a0-7d5a-3470-b9a6-fa930b611485",
