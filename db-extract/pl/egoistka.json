                "translations": [
                    {
                        "translation_id": "452a1207-22e3-4134-b754-8ad5e291029c",
                        "source_entry_id": "28ebd176-a25c-3f8a-b9bd-dcf3ffd5d18a",
                        "source_sense_id": "af3dd883-380e-3b24-bbe5-b758f1ae6a3d",
