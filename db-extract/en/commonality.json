    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "590cd9e5-4fe3-3a2c-98f3-cf278d6ca673",
                "word": "commonality",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f5d650be-cf2f-4e2c-8a9d-ea0efa70c982",
                        "entry_id": "590cd9e5-4fe3-3a2c-98f3-cf278d6ca673",
                        "tags": [
                            "plural"
                        ],
                        "form": "commonalities"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e972b1d7-95f5-3a4c-8309-90eb739921c5",
                        "entry_id": "590cd9e5-4fe3-3a2c-98f3-cf278d6ca673",
                        "glosses": [
                            "The joint possession of a set of attributes or characteristics."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "66875ba2-ec59-4b7f-909b-fa47db85438e",
                                "sense_id": "e972b1d7-95f5-3a4c-8309-90eb739921c5",
                                "text": "Zunin sold the idea to his military superiors in the fearful jargon of his profession: \"In a situation where commonality of loss of the husband is present, the group can be exceedingly supportive.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "667a386c-ebd8-3edc-b77f-c01ad49f8a56",
                        "entry_id": "590cd9e5-4fe3-3a2c-98f3-cf278d6ca673",
                        "glosses": [
                            "Such a shared attribute or characteristic"
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1e166cbe-3803-3ea5-95ff-a8fdffeb0b56",
                        "entry_id": "590cd9e5-4fe3-3a2c-98f3-cf278d6ca673",
                        "glosses": [
                            "A quality that applies to materiel or systems: (a) possessing like and interchangeable parts or characteristics enabling each to be utilized, or operated and maintained in common; (b) having interchangeable repair parts and/or components; (c) applying to consumable items interchangeably equivalent without adjustment."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "52f13300-f2a6-4aa4-beaa-dee2d67549cc",
                                "sense_id": "1e166cbe-3803-3ea5-95ff-a8fdffeb0b56",
                                "text": "2003, NASA, Space Shuttle Columbia Disaster Transcript, transcript of radio communication,\nKLING: FYI I've just lost four separate temperature transducers on the left side of the vehicle, hydraulic return temperatures. (pause) Two of them on system one and one in each of systems 2 and 3.\nCAIN: Four hyd return temps?\nKLING: To the left outboard and left inboard elevons.\nCAIN: OK, is there anything common to them, DSC or MDM or anything? I mean, you're telling me you lost them all at exactly the same time?\nKLING: No, not exactly. They were within probably four or five seconds of each other.\nCAIN: OK, where are those? Where is that instrumentation located?\nKLING: All four of them are located in the aft part of the left wing, right in front of the elevons, elevon actuators. And there is no commonality.\nCAIN: No commonality.\n(long pause)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "000014cc-4195-4ffe-9f6d-c2247a05ab33",
                        "source_entry_id": "590cd9e5-4fe3-3a2c-98f3-cf278d6ca673",
                        "source_sense_description": "joint possession of a set of characteristics",
                        "target_lang_word": "о́бщность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "о́бщность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9d24ceb9-079d-3c03-81dc-02831f89809f",
                                        "entry_id": "b71e1bad-58fd-3a4a-bf8a-8a6ca9acf604",
                                        "glosses": [
                                            "свойство по значению прилагательного общий; схожесть, единство, наличие общих свойств или интересов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92ac87d3-71b7-4d70-93b6-29dec523ac2c",
                                                "sense_id": "9d24ceb9-079d-3c03-81dc-02831f89809f",
                                                "text": "Между ними прослеживается явная общность по многим параметрам."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc6e70a5-12ec-3964-b47b-8535e06df5da",
                                        "entry_id": "b71e1bad-58fd-3a4a-bf8a-8a6ca9acf604",
                                        "glosses": [
                                            "союз, совокупность"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60505c4c-6547-4106-b269-53aa3e2d64e7",
                                                "sense_id": "fc6e70a5-12ec-3964-b47b-8535e06df5da",
                                                "text": "При этом под «человеком» понимается он сам как часть той общности, которая в принципе включает всё общество в той степени, в какой оно оказывается значимым для ребёнка."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
