                                        "entry_id": "0e3a1345-207f-3b0e-b103-5bbea9775e99",
                                        "glosses": [
                                            "teoria educacional, baseada nos trabalhos de Jean Piaget (1896-1980), que defende que a obtenção de conhecimento se dá em relação com o meio em que se está e deve ser construída levando em conta esse meio, além de defender a participação ativa do aluno na resolução de problemas e a aprendizagem por experiências práticas"
                                        ],
                                        "tags": [
                                            "Educação"
                                        ],
                                        "examples": []
                                    }
