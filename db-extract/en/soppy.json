                                            {
                                                "example_id": "23d5e193-e26e-43b5-99eb-bcb0d384849d",
                                                "sense_id": "ae11033a-8f42-3733-9fd7-f329397bb95d",
                                                "text": "Přes všechny limonádové výstřelky své prózy Perón říkal pravdu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4cd4056-cd3e-422b-a503-8dae3264a233",
                        "source_entry_id": "0b015b8e-b55a-3d7a-9d18-2a8cc8781f68",
                        "source_sense_description": "sentimental",
                        "target_lang_word": "mièvre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mièvre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d993e815-a884-3206-89a3-c0e30d2e5b46",
                                        "entry_id": "85c9dad3-15c6-38f4-89af-917357c0c76b",
                                        "glosses": [
                                            "Vif, éveillé, espiègle."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60851d04-5980-440c-b3b2-c88fc86ae70d",
                                                "sense_id": "d993e815-a884-3206-89a3-c0e30d2e5b46",
                                                "text": "La jeune duchesse avait bientôt quatorze ans, elle était jolie comme un ange et mièvre comme un lutin."
                                            },
                                            {
                                                "example_id": "56537679-97fe-4bc5-90b9-ea162ea4406f",
                                                "sense_id": "d993e815-a884-3206-89a3-c0e30d2e5b46",
                                                "text": "Lorsqu’il était petit, il n’a jamais été ce qu’on appelle mièvre et éveillé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "415f67e5-fc3d-32fb-87ae-2903e71b9f3f",
                                        "entry_id": "85c9dad3-15c6-38f4-89af-917357c0c76b",
                                        "glosses": [
                                            "De style exagéré et sans caractère, au point d’en paraître puéril."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88caa335-cbcf-4fa9-9eeb-a8c30c0741ff",
                                                "sense_id": "415f67e5-fc3d-32fb-87ae-2903e71b9f3f",
                                                "text": "[…] elle tapait avec une application timide, toute frêle, toute mièvre dans sa robe de confection simili popeline."
                                            },
                                            {
                                                "example_id": "2d514493-c4a4-48ed-9e74-87ea9e92bc52",
                                                "sense_id": "415f67e5-fc3d-32fb-87ae-2903e71b9f3f",
                                                "text": "Ça nous distrait des réalités mièvres et routinières de la Syrie, de la Libye ou de la Corée du Nord ?"
                                            },
                                            {
                                                "example_id": "a8891cf2-8207-4807-8dca-aa41742bf39a",
                                                "sense_id": "415f67e5-fc3d-32fb-87ae-2903e71b9f3f",
                                                "text": "Avec sa mise à jour de la loi 101, la CAQ a accouché d’une punaise. Les prétendues réformes linguistiques sont tellement mièvres qu’elles ont été, somme toute, bien accueillies par Dominique Anglade, le Quebec Liberal Party et leur maison-mère fédérale. C’est tout dire."
                                            },
                                            {
                                                "example_id": "bafcb1a6-f3f6-41f2-b38e-e4672fca8b38",
                                                "sense_id": "415f67e5-fc3d-32fb-87ae-2903e71b9f3f",
                                                "text": "Ce roman à l’eau de rose déborde de bons sentiments. Je n’ai jamais rien lu de plus mièvre."
                                            },
                                            {
                                                "example_id": "9d5a11e4-6124-4bce-bdc1-7c4155bf66e9",
                                                "sense_id": "415f67e5-fc3d-32fb-87ae-2903e71b9f3f",
                                                "text": "Des façons mièvres. — Une grâce mièvre. — Un style mièvre. — Un pinceau mièvre. — Un talent mièvre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
