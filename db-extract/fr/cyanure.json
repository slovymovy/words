        "fr-extract.jsonl": [
            {
                "entry_id": "aeed3ee9-9567-3c36-aae0-3b670a954310",
                "word": "cyanure",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d9048613-2513-4b59-a06c-0cbb8e4cb657",
                        "entry_id": "aeed3ee9-9567-3c36-aae0-3b670a954310",
                        "tags": [
                            "plural"
                        ],
                        "form": "cyanures"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "54c09c06-3cfc-3696-a282-0da904ecb2e3",
                        "entry_id": "aeed3ee9-9567-3c36-aae0-3b670a954310",
                        "glosses": [
                            "Combinaison du cyanogène avec un corps simple."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "410d618a-1b50-411c-ac0f-e93f160c2cd7",
                                "sense_id": "54c09c06-3cfc-3696-a282-0da904ecb2e3",
                                "text": "Cyanure de potassium, d’or, d’argent, de mercure."
                            },
                            {
                                "example_id": "3398aa2d-1808-4b5f-975a-07f05e634a7d",
                                "sense_id": "54c09c06-3cfc-3696-a282-0da904ecb2e3",
                                "text": "Quelques 700 tonnes de cyanure de sodium étaient stockées dans cet entrepôt alors que la limite autorisée est de 24 tonnes… Un composant qui a été dispersé sur plus d'un kilomètre de rayon et peut dégager au contact de l'eau du cyanure d'hydrogène, un gaz mortel."
                            }
                        ]
                    },
                    {
                        "sense_id": "ba362c16-04c1-3954-87d0-9e590ff28a3c",
                        "entry_id": "aeed3ee9-9567-3c36-aae0-3b670a954310",
                        "glosses": [
                            "Ion CN⁻."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b7d7e27e-539a-37a8-b0d3-685b212b7d02",
                        "entry_id": "aeed3ee9-9567-3c36-aae0-3b670a954310",
                        "glosses": [
                            "Sel de l'acide cyanhydrique et d'une base forte, tel le cyanure de potassium (KCN), et qui constitue l'un des composés simples les plus toxiques connus, entraînant une mort extrêmement rapide par arrêt soudain de la respiration cellulaire."
                        ],
                        "tags": [
                            "specifically"
                        ],
                        "examples": [
                            {
                                "example_id": "3b5bd301-4e30-4964-bab4-6c3286dbc8fd",
                                "sense_id": "b7d7e27e-539a-37a8-b0d3-685b212b7d02",
                                "text": "Souen, pose ta main sur ma poitrine, et prends dès que je la toucherai: je vais vous donner mon cyanure."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "468fc630-513c-4067-93af-71a3abd746f4",
                        "source_entry_id": "aeed3ee9-9567-3c36-aae0-3b670a954310",
                        "target_lang_word": "Cyanid",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c624e322-1711-4a4e-97bf-21a6c71dca65",
                        "source_entry_id": "aeed3ee9-9567-3c36-aae0-3b670a954310",
                        "target_lang_word": "Zyanid",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zyanid",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "57a10a83-a8ba-33a2-bcaa-f8ec1a5c0f8e",
                                        "entry_id": "bbcc501f-a624-3643-8779-79767e890a10",
                                        "glosses": [
                                            "Salz der Blausäure"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f111e4d1-306e-4792-99fb-ebd3191bf378",
                                                "sense_id": "57a10a83-a8ba-33a2-bcaa-f8ec1a5c0f8e",
                                                "text": "Die Großrazzia gegen eine vermutete Bombenwerkstatt in London ist nach Zeitungsangaben durch Hinweise auf einen geplanten Anschlag mit dem Giftstoff Zyanid ausgelöst worden."
                                            },
                                            {
                                                "example_id": "47ac9ed2-890e-4d8c-b34e-5025164acc98",
                                                "sense_id": "57a10a83-a8ba-33a2-bcaa-f8ec1a5c0f8e",
                                                "text": "Flüsse, Bäche und Seen sind mit Blei, Quecksilber, Zyanid und Öl nicht nur vergiftet, sondern regelrecht gesättigt."
                                            },
                                            {
                                                "example_id": "528b9be8-f745-4f05-9543-f318d3354c96",
                                                "sense_id": "57a10a83-a8ba-33a2-bcaa-f8ec1a5c0f8e",
                                                "text": "Die Säure, die in Reaktion mit dem Zyanid das tödliche Gas (Zyklon B) produzieren soll, wird in den Behälter unter dem perforierten Sitz geleitet."
                                            },
                                            {
                                                "example_id": "b7da060e-f25e-4df8-b581-c8d8fadcd6bc",
                                                "sense_id": "57a10a83-a8ba-33a2-bcaa-f8ec1a5c0f8e",
                                                "text": "1954 verspeiste er im Bett liegend einen Apfel, den er selbst mit Zyanid vergiftet hatte."
                                            },
                                            {
                                                "example_id": "d5764ef4-764b-4f06-9fd8-481c9d92dc93",
                                                "sense_id": "57a10a83-a8ba-33a2-bcaa-f8ec1a5c0f8e",
                                                "text": "Die Entdeckungen gingen quer über alle Klassen, Ordnungen, Familien, Gattungen und Arten: ein Tausendfüßler, dem man nicht zu nahe kommen sollte, weil er seine Feinde mit hochgiftigem Zyanid vertreibt; […]"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea2d125a-9bde-4d36-bca5-5334ab9f1b85",
                        "source_entry_id": "aeed3ee9-9567-3c36-aae0-3b670a954310",
                        "target_lang_word": "cyanide",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cyanide",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29f52d49-7a8c-3604-9b3c-742e61b64f14",
                                        "entry_id": "e8bab49b-9739-3c6b-9372-4051ae652bcd",
                                        "glosses": [
                                            "Any compound containing the -C≡N group or the CN⁻ anion."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5414dd78-4360-3ff2-9031-45238a0c3937",
                                        "entry_id": "e8bab49b-9739-3c6b-9372-4051ae652bcd",
                                        "glosses": [
                                            "Sodium or potassium cyanide, used in the extraction of gold and silver or as a poison."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98ed69d8-7b75-45fa-8c46-d5e3a267985f",
                                                "sense_id": "5414dd78-4360-3ff2-9031-45238a0c3937",
                                                "text": "The birdies all try an' hide / But they still go for peanuts / When coated with cyanide"
                                            },
                                            {
                                                "example_id": "2fc2a03d-2c13-4ed7-a46e-321d51a76c45",
                                                "sense_id": "5414dd78-4360-3ff2-9031-45238a0c3937",
                                                "text": "Two doctors and a metallurgist from Scotland patented a process for dissolving gold with cyanide in 1887 and patented the recovery of gold from solution using finely divided zinc (zinc precipitation) the following year. […]\nThe first commercial processing plant to use cyanide in the milling circuit was constructed at the Crown mine at Karangahake, New Zealand in 1889."
                                            },
                                            {
                                                "example_id": "2c7be23f-239f-418b-9d8e-023c9e1b7ffe",
                                                "sense_id": "5414dd78-4360-3ff2-9031-45238a0c3937",
                                                "text": "The vast majority of the victims, on Jones’s orders, had drunk a fruit punch mixture laced with cyanide, a deadly poison. Adults had fed the poisoned liquid to the children, including infants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf324231-9cf7-37ac-b165-4b9466f3359b",
                                        "entry_id": "e8bab49b-9739-3c6b-9372-4051ae652bcd",
                                        "glosses": [
                                            "Hydrogen cyanide, or cyanide gas, a poisonous gas."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
