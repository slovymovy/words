                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deficiency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This is the third time I have caught them <w>shorting</w> us on the order.",
                            "target_lang_translations": {
                                "ru": "Я уже в третий раз ловлю их на том, что они <w>обсчитывают</w> нас при заказе."
                            }
                        },
                        {
                            "text": "Small artists are often the ones getting <w>shorted</w> when budgets are cut.",
                            "target_lang_translations": {
                                "ru": "Начинающих артистов часто <w>обделяют</w>, когда сокращают бюджеты."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in informal business contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять меньшее количество, чем было оговорено; обсчитывать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обсчитывать",
                                "target_lang_sense_clarification": "недодавать товар или деньги"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56abdc61-3f05-382a-b6ec-4d63158094f0",
                    "sense_definition": "To cause a short circuit in something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "electricity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>short</w> the poles of the capacitor to discharge it safely.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>закоротить</w> полюса конденсатора, чтобы безопасно разрядить его."
                            }
                        },
                        {
                            "text": "Spilling water on the motherboard will likely <w>short</w> the entire system.",
                            "target_lang_translations": {
                                "ru": "Если пролить воду на материнскую плату, это, скорее всего, <w>замкнет</w> всю систему."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать короткое замыкание в чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закоротить",
                                "target_lang_sense_clarification": "создать замыкание"
                            },
                            {
                                "target_lang_word": "замкнуть",
                                "target_lang_sense_clarification": "электрику"
                            }
                        ]
                    }
                }
            ]
        },
        {
