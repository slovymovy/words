                ],
                "senses": [
                    {
                        "sense_id": "aab5ceae-db43-362a-a2e1-960ad82f0d93",
                        "entry_id": "427299a5-0163-3bda-af8d-a9d930a91807",
                        "glosses": [
                            "A benefit bequeathed to a beneficiary who inherits the benefit, subject to the obligation of bequeathing it to another."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cadf295-3e9a-443a-87e9-4c49f76e71a8",
                                "sense_id": "aab5ceae-db43-362a-a2e1-960ad82f0d93",
                                "text": "I bequeath my farm to my brother John on condition that he bequeath it to his son Peter. The farm is entailed or burdened by a fideicommissum."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "368383f4-0440-46cb-a865-3fba2134f574",
                        "source_entry_id": "427299a5-0163-3bda-af8d-a9d930a91807",
                        "source_sense_id": "aab5ceae-db43-362a-a2e1-960ad82f0d93",
                        "source_sense_description": "benefit",
                        "target_lang_word": "fidéicommis",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fidéicommis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "78787d74-e31e-3178-8cb6-56d94906d83b",
                                        "entry_id": "6e4caf41-66ed-3926-aef3-55f51f6c04ca",
                                        "glosses": [
                                            "Disposition par laquelle un testateur charge son héritier institué de conserver et de rendre à une personne désignée la totalité ou une partie des biens qu’il lui laisse, soit au bout d’un certain temps, soit dans un certain cas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7892d19a-976c-4ad4-a422-5bbb749f03ae",
                                                "sense_id": "78787d74-e31e-3178-8cb6-56d94906d83b",
                                                "text": "Ici, une mère veut déshériter les enfants de son mari […]. Et c’est alors des combats, des craintes, des actes, des contre-lettres, des ventes simulées, des fidéicommis ; enfin, un gâchis pitoyable, ma parole d’honneur, pitoyable !"
                                            },
                                            {
                                                "example_id": "72d8c136-fa85-4018-9d1a-6e6ae4743a77",
                                                "sense_id": "78787d74-e31e-3178-8cb6-56d94906d83b",
                                                "text": "Hortense, ayant été séparée de biens avec son mari pendant les trois années de brouille, Victorin n’hésita plus à placer au nom de sa sœur les deux cent mille francs du fidéicommis, et il fit à Hortense une pension de douze mille francs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1542bad1-24fd-3d8c-9a67-56782d57b0ba",
                                        "entry_id": "6e4caf41-66ed-3926-aef3-55f51f6c04ca",
                                        "glosses": [
                                            "Liste de biens donnés sous certaines conditions."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9556f43b-f982-4ef9-b55a-23c96480acc1",
                                                "sense_id": "1542bad1-24fd-3d8c-9a67-56782d57b0ba",
                                                "text": "Mais quelques-uns parmi les siens continuent en eux-mêmes à penser que la France appartient d’abord à elle-même, que ses enfants, ses citoyens, ne sont pas là pour donner des royaumes à la clique corse et pour faire de toute l’Europe un fidéicommis des Bonaparte."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
