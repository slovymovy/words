                "senses": [
                    {
                        "sense_id": "2b85ecb2-8057-309c-ac29-3adef8162d15",
                        "entry_id": "c8fc029e-367c-30ff-b446-7939e3095729",
                        "glosses": [
                            "Commencer de nouveau ce qu’on a déjà commencé plusieurs fois, recommencer une énième fois."
                        ],
                        "tags": [
                            "familiar",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "ebfacdc5-76da-43e2-a86a-2906a8c3b79b",
                                "sense_id": "2b85ecb2-8057-309c-ac29-3adef8162d15",
                                "text": "Je crois que je reviendrai vers vous pour rerererererecommencer un régime vers janvier février. (Forum doctissimo http://forum.doctissimo.fr/nutrition/surpoids-obesite/hypocalorique-regime-perdre-sujet_170156_28.htm)"
                            },
                            {
                                "example_id": "bf5b6bfe-4af4-4d13-82d5-45ce89f3b1db",
                                "sense_id": "2b85ecb2-8057-309c-ac29-3adef8162d15",
                                "text": "Tout content de retrouver mon vieux BG2 tout poussiéreux dans le fond de mon tiroir, je décidai de rerererererecommencer une partie."
                            },
                            {
                                "example_id": "70b6ef16-6246-4453-896c-a9a71182cebd",
                                "sense_id": "2b85ecb2-8057-309c-ac29-3adef8162d15",
                                "text": "Après avoir lu cette théorie, je n’ai pus [sic] m’empêcher de me jeter sur Final Fantasy VIII et de rerererererecommencer une partie !"
                            },
                            {
                                "example_id": "6f5459e0-cc36-4556-a8a9-3ae27d52e3b3",
                                "sense_id": "2b85ecb2-8057-309c-ac29-3adef8162d15",
                                "text": "Je suis littéralement découragée de rerererererecommencer un autre cycle alors je crois que je vais tout arrêter."
                            }
                        ]
                    }
