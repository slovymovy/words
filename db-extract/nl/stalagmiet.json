                                "target_senses": [
                                    {
                                        "sense_id": "f791bf3e-7328-31ef-8749-a94190259258",
                                        "entry_id": "ed2939a6-bff0-35ad-a93c-1ef8a1be4265",
                                        "glosses": [
                                            "A secondary mineral deposit of calcium carbonate or other mineral, in shapes similar to icicles, that lies on the ground of a cave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5040d334-0aa2-4118-83ac-6cceddd77624",
                                                "sense_id": "f791bf3e-7328-31ef-8749-a94190259258",
                                                "text": "In one place, near at hand, a stalagmite had been slowly growing up from the ground for ages, builded by the water-drip from a stalactite overhead."
                                            },
                                            {
                                                "example_id": "d699b336-0b37-439c-aaab-b0444d42b515",
                                                "sense_id": "f791bf3e-7328-31ef-8749-a94190259258",
                                                "text": "Molten roofing north, lead dripping down south, stand like those immobilized columns of arctic water west, stalagmites, monked and housed or stamped and dudleyed east, in school texts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb5e696a-f642-4b62-b386-0914e38bc0fe",
                        "source_entry_id": "212d61ab-72ab-31c1-8941-2032b9949713",
                        "source_sense_id": "ae8b6713-b578-3a5b-af1d-023b9fd7b8d0",
                        "target_lang_word": "stalagmite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stalagmite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7df4204c-c924-3236-9cf1-f2932fd8e14f",
                                        "entry_id": "77ef16e8-2e0d-3932-9cd6-545a7a499c77",
                                        "glosses": [
                                            "Concrétion analogue à celle de la stalactite, mais qui se forme sur le sol des cavités souterraines où tombent goutte à goutte les mêmes eaux chargées de sels calcaires, siliceux, etc."
                                        ],
                                        "tags": [
                                            "Spéléologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3399b12d-324a-4aa0-8c8d-047ebd1ab84f",
                                                "sense_id": "7df4204c-c924-3236-9cf1-f2932fd8e14f",
                                                "text": "Don Teodoro ouvre la procession, chaque personne doit contourner une grande stalagmite ruisselant d’eau par la gauche."
                                            },
                                            {
                                                "example_id": "b53ffc3c-1da7-44cf-9e57-045d9389560e",
                                                "sense_id": "7df4204c-c924-3236-9cf1-f2932fd8e14f",
                                                "text": "La grande salle des fêtes du Palais du Trocadéro, hier encore salle du Théâtre Populaire. Lieu funèbre s’il en fut : l’immense vaisseau poussiéreux et glacial, les grandes orgues en stalagmites bêtes du fond de l’estrade, l’écho qui faisait de cet endroit l’un des plus détestables de Paris au point de vue acoustique […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
