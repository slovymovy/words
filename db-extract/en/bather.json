                    {
                        "translation_id": "c9c4fb35-4636-4f64-8506-8cd2f255e157",
                        "source_entry_id": "3a9edf3f-5cb4-35f3-88bc-c31e7742d435",
                        "source_sense_description": "one who bathes",
                        "target_lang_word": "baigneur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baigneur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bc96339f-e5da-38f9-a189-92127e0a7cfc",
                                        "entry_id": "32e43075-5733-381f-9cc6-226db9ea97a8",
                                        "glosses": [
                                            "Celui qui se baigne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c227293-69c0-495b-90df-5cddc4bd2834",
                                                "sense_id": "bc96339f-e5da-38f9-a189-92127e0a7cfc",
                                                "text": "Toute la rivière était pleine de baigneurs."
                                            },
                                            {
                                                "example_id": "60b7f2af-3a12-4e79-94f8-35878add1961",
                                                "sense_id": "bc96339f-e5da-38f9-a189-92127e0a7cfc",
                                                "text": "Cette plage est commode pour les baigneurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4037e61-a376-3d15-ba0d-0fcbccafd7e7",
                                        "entry_id": "32e43075-5733-381f-9cc6-226db9ea97a8",
                                        "glosses": [
                                            "Celui qui tenait des bains publics."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81a580e8-aa81-4af9-a62d-24074891d366",
                                                "sense_id": "d4037e61-a376-3d15-ba0d-0fcbccafd7e7",
                                                "text": "C'était le mercredi 15 novembre de l'an de grâce 1665. Ce soir-là, il y avait petit souper et grande compagnie, rue Vieille-du-Temple, chez La Vienne, le baigneur à la mode, l'étuviste en renom, le barbier du monde élégant."
                                            },
                                            {
                                                "example_id": "51c37de8-4639-4568-81a3-860f5589cb73",
                                                "sense_id": "d4037e61-a376-3d15-ba0d-0fcbccafd7e7",
                                                "text": "Tandis que sous l'empire des anciennes lois, l'état de perruquier et celui de baigneur étuviste étaient assujettis à une réglementation sévère, l'exercice de la profession de sage-femme était abandonné aux premières venues."
                                            },
                                            {
                                                "example_id": "2ab032d8-5b53-42ee-b50c-9a4745bb6b46",
                                                "sense_id": "d4037e61-a376-3d15-ba0d-0fcbccafd7e7",
                                                "text": "L'attelage du Petit Baigneur avait de quoi retenir notre attention. C’était un assez long plateau à quatre roues, avec deux grands supports verticaux terminés par des crochets auxquels était fixée horizontalement une baignoire de zinc. Des seaux de bois se balançaient sous la voiture. Une sorte d’alambic de cuivre trônait derrière le siège du conducteur. Il contenait de l’eau chaude qu'un foyer maintenait à une bonne température.\nIl existait bien un établissement de bains près de la gare du Parc, mais si l'on ne pouvait ou ne voulait pas s'y rendre, le bain vous était porté à domicile. Le conducteur le préparait et pendant que vous le preniez, il fumait sa pipe en parlant à son cheval."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d49ade6-cb66-3379-8b4a-1e85dfa11f45",
                                        "entry_id": "32e43075-5733-381f-9cc6-226db9ea97a8",
                                        "glosses": [
                                            "Celui qui fait le service dans un établissement de bains chauds ou froids, aussi bien que dans un établissement de bains de mer."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e311d3b6-8028-4a51-9bac-b90374dbe144",
                                                "sense_id": "0d49ade6-cb66-3379-8b4a-1e85dfa11f45",
                                                "text": "Quand vous aurez arrosé vostre ieunesse de bons vins vieux de Leucade, de Cos, de Thasos, & de Lesbos, ie vous donneray des huiles de senteur: et pour vous le faire court, ie feray que du lieu mesmes où vous vous serez laué, le baigneur fera vne boutique de parfums exquis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a726ce9-8d86-3ea0-8aac-819c22d94524",
                                        "entry_id": "32e43075-5733-381f-9cc6-226db9ea97a8",
                                        "glosses": [
                                            "Celui qui surveille ou assiste les personnes qui se baignent."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "392c583c-3bac-46ab-9809-b8d84e550816",
                                                "sense_id": "0a726ce9-8d86-3ea0-8aac-819c22d94524",
                                                "text": "Il faillit se noyer, mais le baigneur le sauva."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf32d7fc-ad79-33a2-8b3d-4bce58394a6f",
                                        "entry_id": "32e43075-5733-381f-9cc6-226db9ea97a8",
                                        "glosses": [
                                            "Poupée représentant un bébé masculin."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f80f7400-424d-477e-9f01-8ee96e82920a",
                                                "sense_id": "bf32d7fc-ad79-33a2-8b3d-4bce58394a6f",
                                                "text": "Les baigneurs, c’était différent. Ils ressemblent trop à des bébés, les tortures devenaient visiblement criminelles. Mais eux aussi détournés de leurs fonction, oser dire à quel simulacre il a servi un après-midi d’été, quel partenaire à taille réduite il a figuré, ce poupard que j’avais appelé Michel."
                                            },
                                            {
                                                "example_id": "aebbf2f7-746a-439e-94f8-0e77d2110042",
                                                "sense_id": "bf32d7fc-ad79-33a2-8b3d-4bce58394a6f",
                                                "text": "Pour ceux qui manquaient, il collectionnait dans son atelier, au milieu des boîtes de clous, des pièces récupérées sur des baigneurs trop fatigués – des yeux, des têtes, des bras, des jambes, comme une exposition d’ex-voto."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1c25af5-7042-4058-8b46-2ceadae0c542",
                        "source_entry_id": "3a9edf3f-5cb4-35f3-88bc-c31e7742d435",
                        "source_sense_description": "one who bathes",
                        "target_lang_word": "baigneuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baigneuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5fc5902e-e1cf-31a1-b3ab-69433caf2ba8",
                                        "entry_id": "c2b6b326-e2fd-31fb-8c9b-f575da367794",
                                        "glosses": [
                                            "Celle qui se baigne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f165c56-14f6-4f4b-ad1c-6c139d10cfce",
                                                "sense_id": "5fc5902e-e1cf-31a1-b3ab-69433caf2ba8",
                                                "text": "Assise sur le lit, laissant, comme une baigneuse, pendre ses jambes nues, elle resta longtemps immobile et songeuse."
                                            },
                                            {
                                                "example_id": "a87c0701-9df4-490e-9bc9-19e79847a383",
                                                "sense_id": "5fc5902e-e1cf-31a1-b3ab-69433caf2ba8",
                                                "text": "Ce leurre relève des procédures qui travaillent à artificialiser le texte, dont Proust s’attache à défamiliariser les poncifs, motif de la baigneuse ou travesti mythologique des grands de ce monde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "436889c0-4456-3327-9123-0bd6811a2ae9",
                                        "entry_id": "c2b6b326-e2fd-31fb-8c9b-f575da367794",
                                        "glosses": [
                                            "Celui qui tenait des bains publics."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5abf7e2a-964f-37f4-b16c-e4a01653780a",
                                        "entry_id": "c2b6b326-e2fd-31fb-8c9b-f575da367794",
                                        "glosses": [
                                            "Celle qui fait le service dans un établissement de bains chauds ou froids, aussi bien que dans un établissement de bains de mer."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acad4c38-da5c-460e-b2ab-ee84df2fcd34",
                                                "sense_id": "5abf7e2a-964f-37f4-b16c-e4a01653780a",
                                                "text": "La baigneuse qui avait paré Zariffa pour ses noces était là de nouveau, prête à faire pour elle sa dernière toilette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e2f0ab5-5f2e-3e04-baf4-4906edf9171d",
                                        "entry_id": "c2b6b326-e2fd-31fb-8c9b-f575da367794",
                                        "glosses": [
                                            "Peignoir de bain, sortie de bain."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4e170736-6b02-3078-a04b-be03246cd8ce",
                                        "entry_id": "c2b6b326-e2fd-31fb-8c9b-f575da367794",
                                        "glosses": [
                                            "Bonnet de femme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71da1f3a-e366-4d83-943f-a700ae62c309",
                                                "sense_id": "4e170736-6b02-3078-a04b-be03246cd8ce",
                                                "text": "Quand elle se trouva en face d’une femme maigre, pâle, douce, maladive, enveloppée dans une grande robe de soie violette, coiffée d'une petite baigneuse de dentelle tout unie, elle fut rassurée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61583958-4a5a-3f28-b952-59a9053b1093",
                                        "entry_id": "c2b6b326-e2fd-31fb-8c9b-f575da367794",
                                        "glosses": [
                                            "Sorte de plis fait comme ceux des bonnets nommés baigneuses."
                                        ],
                                        "tags": [],
                                        "examples": []
