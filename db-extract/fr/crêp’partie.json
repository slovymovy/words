                "senses": [
                    {
                        "sense_id": "3163a745-eebd-35c6-8c65-254e79ae101e",
                        "entry_id": "fe85ccdd-8cfa-387e-8bab-540d9f039525",
                        "glosses": [
                            "Réunion festive autour de la dégustation de crêpes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf9ca1ab-38f7-4642-9549-de848874db30",
                                "sense_id": "3163a745-eebd-35c6-8c65-254e79ae101e",
                                "text": "Entre activités à Lesneven en journée, comme le futsal, le VTT, l’escalade, ou en soirée, avec des crêp’partie, Top Chef, du karaoké, à l’extérieur, avec les vendredis du sport à Brest, la Récré des 3 curés à Milizac, ou la bouée tractée à Bertheaume, toutes les places ont été prises d’assaut."
                            },
                            {
                                "example_id": "ce54a795-964d-48ac-a411-5a088bf76314",
                                "sense_id": "3163a745-eebd-35c6-8c65-254e79ae101e",
                                "text": "Crêp’partie chez moi, à la façon auberge espagnole : chacun amène un ingrédient : farine, lait, beurre, œufs, sucre, confiture, crème de marron, pâte à tartiner... ou une boisson chaude ou froide."
                            },
                            {
                                "example_id": "d74ec3ac-2e18-4e12-89d1-56fbe1fcef0d",
                                "sense_id": "3163a745-eebd-35c6-8c65-254e79ae101e",
                                "text": "La semaine a commencé sous de bons auspices à la résidence Saint-Joseph, puisque les aînés ont accueilli les jeunes enfants de la halte-garderie Le Pt’it Fagus, pour une crêp’partie."
                            },
                            {
                                "example_id": "277435ba-3b82-4ca7-928a-8493ebe8e10e",
                                "sense_id": "3163a745-eebd-35c6-8c65-254e79ae101e",
                                "text": "Ambre s'attache à développer la convivialité dans ce lieu en proposant des crêp’parties et des jeux de connaissance pour petits et grands."
                            }
                        ]
                    }
