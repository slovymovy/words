                                "sense_id": "4d7945a3-6a7a-3ed2-9b1d-d3fa5c5fd639",
                                "text": "They took in a lodger to help cover the rent."
                            },
                            {
                                "example_id": "1c256bd0-42d9-4459-ae58-f676c4f9a241",
                                "sense_id": "4d7945a3-6a7a-3ed2-9b1d-d3fa5c5fd639",
                                "text": "The police questioned the lodger after the incident."
                            }
                        ]
