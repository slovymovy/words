                "senses": [
                    {
                        "sense_id": "fb6e2dc6-4d28-3c08-821a-a01cff0167d7",
                        "entry_id": "760b4f62-d06c-3f1c-ba50-ee611ee0d683",
                        "glosses": [
                            "Ruß, der bei der (unvollständigen) Verbrennung von Holz entsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a35a0d0-e21c-4d2c-a82d-d6cf095b7c46",
                                "sense_id": "fb6e2dc6-4d28-3c08-821a-a01cff0167d7",
                                "text": "„Ein Düngmittel, welches faſt ausſchließlich durch ſeinen Stickſtoffgehalt wirkt, iſt der Ruß, namentlich der Steinkohlenruß, welcher reicher an Stickſtoff iſt als der Holzruß.“ [1856]"
                            },
                            {
                                "example_id": "e7150a6b-b664-4cde-9851-a0736ab913dd",
                                "sense_id": "fb6e2dc6-4d28-3c08-821a-a01cff0167d7",
                                "text": "„Bei der Deſtillation der Steinkohle erhält man unter anderen Producten auch kohlenſaures Ammoniak, wodurch es ſich erklärt, warum der Steinkohlenruß reicher iſt an Stikſtoff als der Holzruß.“ [1842]"
                            },
                            {
                                "example_id": "41150c9e-02b4-45a7-8778-2da92efd3825",
                                "sense_id": "fb6e2dc6-4d28-3c08-821a-a01cff0167d7",
                                "text": "„Vom Holzruß bereitet man durch Auſlaugen mit Waſſer oder Harn eine Malerfarbe das Rußbraun […]“ [1791]"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
