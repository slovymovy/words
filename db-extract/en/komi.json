                                "target_senses": [
                                    {
                                        "sense_id": "7b0ac235-159e-302d-88ec-07001e929df7",
                                        "entry_id": "ee075b42-0470-3e4a-81a7-c8258c617bce",
                                        "glosses": [
                                            "народ в Российской Федерации, коренное население Республики Коми"
                                        ],
                                        "tags": [
                                            "согласуется с другими частями речи во мн.ч."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2ea3ac2-9eb2-4a87-a49c-6726b4ae9953",
                                                "sense_id": "7b0ac235-159e-302d-88ec-07001e929df7",
                                                "text": "И между прочим, в Сыктывкаре живёт в основном русское население, а коми живут севернее."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a1a08be-4a7f-32ed-9070-93aede1a5ba2",
                                        "entry_id": "ee075b42-0470-3e4a-81a7-c8258c617bce",
                                        "glosses": [
                                            "представитель этого народа"
                                        ],
                                        "tags": [
                                            "согласуется с другими частями речи в муж.р."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7e73752-39e1-4db6-9ae1-440e46a53ef3",
                                                "sense_id": "6a1a08be-4a7f-32ed-9070-93aede1a5ba2",
                                                "text": "Я коми, и я был в числе последних, кто в 1966 году закончил национальную школу."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be2e0853-5c6f-3364-b7b4-97fe5383bf73",
                                        "entry_id": "ee075b42-0470-3e4a-81a7-c8258c617bce",
                                        "glosses": [
                                            "представительница этого народа"
                                        ],
                                        "tags": [
                                            "согласуется с другими частями речи в жен.р."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc2440dc-e022-4aa6-9742-138054455187",
                                                "sense_id": "be2e0853-5c6f-3364-b7b4-97fe5383bf73",
                                                "text": "Сама я коми по национальности, муж — армянин."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8390beb-d95f-30ef-8051-73955699cdbc",
                                        "entry_id": "ee075b42-0470-3e4a-81a7-c8258c617bce",
                                        "glosses": [
                                            "лингв. язык этого народа, состоящий из двух близкородственных языков финно-угорской группы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "423b8f60-e6b2-45c9-a767-6d32cf7d8b01",
                                                "sense_id": "c8390beb-d95f-30ef-8051-73955699cdbc",
                                                "text": "Автор предлагает запоминать произношение слов коми с помощью похожих по звучанию слов из русского языка."
                                            }
                                        ]
                                    }
                                ]
                            },
