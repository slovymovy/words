    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "06e0c879-7004-3695-925e-432982402962",
                    "sense_definition": "To make someone feel annoyed, frustrated, or worried.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The difficult math problem began to <w>vex</w> the students who could not solve it.",
                            "target_lang_translations": {
                                "ru": "Трудная задача по математике начала <w>раздражать</w> студентов, которые не могли её решить.",
                                "tr": "Bu zor matematik problemi, onu çözemeyen öğrencilerin <w>canını sıkmaya</w> başladı."
                            }
                        },
                        {
                            "text": "He was <w>vexed</w> by the constant delays in the project schedule.",
                            "target_lang_translations": {
                                "ru": "Он был <w>раздражён</w> постоянными задержками в графике проекта.",
                                "tr": "Proje takvimindeki sürekli gecikmeler yüzünden <w>sinirlenmişti</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "annoy",
                        "irritate",
                        "bother",
                        "irk",
                        "exasperate",
                        "provoke",
                        "frustrate",
                        "rile"
                    ],
                    "antonyms": [
                        "comfort"
                    ],
                    "common_phrases": [
                        "vexed by",
                        "vexed at"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять кого-либо чувствовать раздражение, разочарование или беспокойство.",
                        "tr": "Birinin sinirlenmesine, hayal kırıklığına uğramasına veya endişelenmesine neden olmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздражать",
                                "target_lang_sense_clarification": "вызывать недовольство или злость"
                            },
                            {
                                "target_lang_word": "досаждать",
                                "target_lang_sense_clarification": "причинять неприятности, надоедать"
                            },
                            {
                                "target_lang_word": "сердить",
                                "target_lang_sense_clarification": "приводить в состояние гнева"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kızdırmak",
                                "target_lang_sense_clarification": "öfkelendirmek veya canını sıkmak"
                            },
                            {
                                "target_lang_word": "canını sıkmak",
                                "target_lang_sense_clarification": "rahatsızlık veya can sıkıntısı vermek"
                            },
                            {
                                "target_lang_word": "sinirlendirmek",
                                "target_lang_sense_clarification": "öfke veya asabiyet uyandırmak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f82c892-8c99-3f9b-b2f0-e6068f55db25",
                    "sense_definition": "To cause mental suffering or deep distress to someone.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do not <w>vex</w> your heart with sorrows that cannot be changed.",
                            "target_lang_translations": {
                                "ru": "Не <w>терзай</w> своё сердце печалями, которые нельзя изменить.",
                                "tr": "Değiştirilemeyecek kederlerle yüreğini <w>kahretme</w>."
                            }
                        },
                        {
                            "text": "The tragic news continued to <w>vex</w> the community for many years.",
                            "target_lang_translations": {
                                "ru": "Трагические новости продолжали <w>мучить</w> общество на протяжении многих лет.",
                                "tr": "Bu trajik haber toplumu uzun yıllar boyunca <w>üzmeye</w> devam etti."
                            }
