                        "glosses": [
                            "mit einer Hand haltbares, zur Geschwindigkeitsmessung von Fahrzeugen eingesetztes Radargerät"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c086e85-51c1-43ab-84d6-e49e1446b641",
                                "sense_id": "aff29d62-eae8-3192-b5c2-64bfa68e9251",
                                "text": "„Auf der Straße messen dann die Kinder die Geschwindigkeit mittels Radarpistole.“"
                            },
                            {
                                "example_id": "cd39557f-1224-4f78-a7a5-b306b7ea06bd",
                                "sense_id": "aff29d62-eae8-3192-b5c2-64bfa68e9251",
                                "text": "„Aber natürlich gilt auch - oder erst recht - für den Carrera 4 die Erkenntnis, dass das enorme Potenzial des Elfers auf normalen Straßen ohnehin kaum mehr auszuloten ist, zumal im spätherbstlichen Österreich, wo Porsche den Neuen präsentierte und wo hinter jeder Hecke eine Radarpistole lauert.“"
                            },
                            {
                                "example_id": "50722f52-df4e-4e16-9362-96d65fd9b0bf",
                                "sense_id": "aff29d62-eae8-3192-b5c2-64bfa68e9251",
                                "text": "„Die Firma ComSonics aus Virginia, USA, entwickelt gerade ein Gerät, das ähnlich einer Radarpistole oder Laser-Kontrolle funktioniert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
