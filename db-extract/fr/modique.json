                    {
                        "translation_id": "b9a300be-58b3-4601-b3d2-5d8eda2e171f",
                        "source_entry_id": "daedf5c4-05d1-3704-bc1b-844cccf6d66f",
                        "source_sense_id": "e2d4f175-584a-3fa6-9628-9c85a28e01d1",
