                "senses": [
                    {
                        "sense_id": "b05858cf-a3ed-3cc8-8a85-da4cfa64b33f",
                        "entry_id": "bc7bdc8f-6a1d-3f8f-884c-027dbfe471a5",
                        "glosses": [
                            "iemand uit het noorden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b364603-6c39-44b1-90b0-84dc04d2afd8",
                                "sense_id": "b05858cf-a3ed-3cc8-8a85-da4cfa64b33f",
                                "text": "Veel Noordelingen hebben het idee dat er niet naar hen wordt geluisterd: \"Noord wordt verkwanseld.\""
                            },
                            {
                                "example_id": "a5a96a42-3fbd-4335-9766-40dc7d6d9d26",
                                "sense_id": "b05858cf-a3ed-3cc8-8a85-da4cfa64b33f",
                                "text": "Toen 'noordeling' Hanna Bijl werd bedreigd op de pont, schoot niemand te hulp. Parool lezer Hans Al vraagt zich af waarom de kapitein geen initiatief nam."
                            },
                            {
                                "example_id": "1999243b-a39b-47d3-b264-58c476af1dad",
                                "sense_id": "b05858cf-a3ed-3cc8-8a85-da4cfa64b33f",
                                "text": "Volgens RTV Noord heeft de man als dank een fles Beerenburg gekregen van de natte jongen en zijn moeder. En dat is genoeg eer voor de nuchtere Noordeling: Ík lust het wel dus het past wel.'"
                            }
                        ]
                    }
                ],
