                                    },
                                    {
                                        "sense_id": "b4237d4f-e234-3314-bbe8-00ea787dda5e",
                                        "entry_id": "fb74352a-bd70-3642-85e8-85416c8d8876",
                                        "glosses": [
                                            "Related or connected to science:",
                                            "In accord with the procedures, methods, conduct and accepted conventions of modern science."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc0c4605-c01c-498f-946b-52b4811e5375",
                                                "sense_id": "b4237d4f-e234-3314-bbe8-00ea787dda5e",
                                                "text": "“The circumstances in Iran were so mysterious and so bizarre that the Iranian government realized that this cannot happen with mechanical means or cyberattacks. They cannot happen with anything known to the human mind from a scientific point of view,” he explained."
                                            }
                                        ]
