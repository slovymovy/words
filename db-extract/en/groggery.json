                ],
                "senses": [
                    {
                        "sense_id": "f582880f-413b-314e-a7f5-0452ca566825",
                        "entry_id": "35d4c629-e93c-35f1-b329-09a7d063ef37",
                        "glosses": [
                            "An establishment that sells alcoholic beverages."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "eb6be981-325b-41e9-8bf8-0dfb63162738",
                                "sense_id": "f582880f-413b-314e-a7f5-0452ca566825",
                                "text": "I then proceeded to a low groggery in Lincoln Square, and in the space of half an hour drank several glasses of brandy; this in addition to what I had taken before made me very drunk, and I staggered home as well as I could."
                            },
                            {
                                "example_id": "eac50677-69c2-4794-9bb1-db1666397d51",
                                "sense_id": "f582880f-413b-314e-a7f5-0452ca566825",
                                "text": "If women had a voice in the making of the laws, how long would the dram-shop and low groggery send out their liquid poison to pollute civilized lands?"
                            },
                            {
                                "example_id": "2e5e52fc-b99c-48cf-8955-26253089397b",
                                "sense_id": "f582880f-413b-314e-a7f5-0452ca566825",
                                "text": "Dusenheimer, standing in the door of his uninviting groggery, when the trains stopped for water; never received from the traveling public any patronage except facetious remarks upon his personal appearance."
                            },
                            {
                                "example_id": "3d6cb9db-4970-4a00-9473-2d097edb15ce",
                                "sense_id": "f582880f-413b-314e-a7f5-0452ca566825",
                                "text": "The Sharp Corner was a second-class groggery and boarding house, patronized almost entirely by the poorest and most shiftless class of trackmen."
                            },
                            {
                                "example_id": "b261a9be-9696-4094-88fb-39405ba0c56f",
                                "sense_id": "f582880f-413b-314e-a7f5-0452ca566825",
                                "text": "This man Jameson pinches 'em, but his mate follows him up an' has it out with him in a waterfront groggery."
                            },
                            {
                                "example_id": "fdd4d8c5-cd3c-49c6-a640-85c304eeddcc",
                                "sense_id": "f582880f-413b-314e-a7f5-0452ca566825",
                                "text": "An instant later, an empty beer-bottle dropped with a crash in the tonneau, and Donald, turning, beheld in the door of a Darrow groggery one of the Greek fishermen He had dispossessed."
                            }
                        ]
                    }
                ],
