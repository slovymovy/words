                "forms": [],
                "senses": [
                    {
                        "sense_id": "57e78069-f319-30f7-878a-ec9e614b70e4",
                        "entry_id": "ed154789-7ad6-35dc-a213-dfb95e9e7c8a",
                        "glosses": [
                            "w sposób dokładnie określony"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd201e6b-5497-4214-a8a2-555fcafb7d44",
                                "sense_id": "57e78069-f319-30f7-878a-ec9e614b70e4",
                                "text": "Ja to, proszę pana, jadę w sierpniu do Bułgarii. Konkretnie to do Złotych Piasków, wie pan, to taki bardzo ekskluzywny kurort – wyjaśniła z dumą kobieta."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ef3b23a-95ee-4768-a24b-3694bcad8978",
                        "source_entry_id": "ed154789-7ad6-35dc-a213-dfb95e9e7c8a",
                        "source_sense_id": "57e78069-f319-30f7-878a-ec9e614b70e4",
                        "target_lang_word": "strictly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "strictly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8f779f3-042b-3c8c-8a84-f7aa27532555",
                                        "entry_id": "3b1ad299-bb7f-3ae8-9943-2b27a578df99",
                                        "glosses": [
                                            "In a strict manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c3b9127-af51-42e0-acb5-611358fcaab0",
                                                "sense_id": "c8f779f3-042b-3c8c-8a84-f7aa27532555",
                                                "text": "He adhered strictly to the diet his doctor prescribed."
                                            },
                                            {
                                                "example_id": "ae2d1577-fea4-46e7-85f1-7dc8b51a24be",
                                                "sense_id": "c8f779f3-042b-3c8c-8a84-f7aa27532555",
                                                "text": "“If any pupil considers it acceptable to bring a pet into this school, let me tell you it is forbidden. Strictly forbidden!” pronounced the headmaster from the front of the class."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bf9e95a-64b6-3780-8627-b0cd7337bff5",
                                        "entry_id": "3b1ad299-bb7f-3ae8-9943-2b27a578df99",
                                        "glosses": [
                                            "In a limited manner; only"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a601a792-dabd-47f7-995a-cad001a0a2c3",
                                                "sense_id": "9bf9e95a-64b6-3780-8627-b0cd7337bff5",
                                                "text": "This work was strictly voluntary, but any animal who absented himself from it would have his rations reduced by half."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3dd0491-17df-3ec4-90dd-43fd28e1dabc",
                                        "entry_id": "3b1ad299-bb7f-3ae8-9943-2b27a578df99",
                                        "glosses": [
                                            "In a narrow or limited sense."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6d6684a-a654-4fb4-b920-64b4cd16b35c",
                                                "sense_id": "d3dd0491-17df-3ec4-90dd-43fd28e1dabc",
                                                "text": "That term refers strictly to smaller birds."
                                            },
                                            {
                                                "example_id": "8564fea6-411e-48b2-adb1-d308c4dbea1f",
                                                "sense_id": "d3dd0491-17df-3ec4-90dd-43fd28e1dabc",
                                                "text": "Scientific naming conventions are such that technically, ammonites are ammonoidean, ammonitidan, and sometimes strictly ammonitinan cephalopods."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fad483e-cf3d-39fe-b0d4-39c68159c172",
                                        "entry_id": "3b1ad299-bb7f-3ae8-9943-2b27a578df99",
                                        "glosses": [
                                            "In a manner that applies to every member of a set or every interval of a function"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6e9735a-445e-4dc0-abde-4563690d9a52",
                        "source_entry_id": "ed154789-7ad6-35dc-a213-dfb95e9e7c8a",
                        "source_sense_id": "57e78069-f319-30f7-878a-ec9e614b70e4",
                        "target_lang_word": "spécifiquement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spécifiquement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b73727bc-e484-356d-9799-b0fd44770f12",
                                        "entry_id": "491454dd-f8c9-3e57-a49f-6915275cd9b4",
                                        "glosses": [
                                            "D’une manière spécifique, particulièrement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfb3ba7b-f898-4198-81f1-4ffcd58be156",
                                                "sense_id": "b73727bc-e484-356d-9799-b0fd44770f12",
                                                "text": "Le dialogue — chose écrite et parlée — n’appartient pas spécifiquement à la scène, il appartient au livre ; et la preuve, c’est que l’on réserve dans les manuels d’histoire littéraire une place au théâtre considéré comme une branche accessoire de l’histoire du langage articulé."
                                            },
                                            {
                                                "example_id": "10193b5d-22bb-4f2c-aa79-26451a65717d",
                                                "sense_id": "b73727bc-e484-356d-9799-b0fd44770f12",
                                                "text": "Le jaune Lucifer (Lucifer yellow = colorant fluorescent à base de luciférine) et la péroxydase (par exemple, la péroxydase du Raifort ou péroxydase du radis de cheval = la HRP pour horse radish peroxydase) qui est une enzyme pouvant être incorporée non spécifiquement par les cellules."
                                            },
                                            {
                                                "example_id": "4eb0dc8c-ebae-4313-8937-16f23e01f41e",
                                                "sense_id": "b73727bc-e484-356d-9799-b0fd44770f12",
                                                "text": "On peut ainsi être assuré de collecter toute l’information désirée sans perdre de temps considérable à identifier anatomiquement et spécifiquement les innombrables débris divers laissés par le squelette ultra-complexifié des poissons."
                                            },
                                            {
                                                "example_id": "fe76d4e9-3589-4c39-904e-92bcb1d6cc65",
                                                "sense_id": "b73727bc-e484-356d-9799-b0fd44770f12",
                                                "text": "Ces pierres, devenues dures par la longue chaleur qu’elles ont éprouvée, deviennent en même temps spécifiquement plus pesantes."
                                            },
                                            {
                                                "example_id": "36344da4-823f-47d0-94e5-ca45b71fe6ea",
                                                "sense_id": "b73727bc-e484-356d-9799-b0fd44770f12",
                                                "text": "Seules la testostérone et la dihydrotestostérone sont des androgènes actifs qui se lient spécifiquement aux récepteurs des androgènes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "250f38f4-4d45-4c22-b00c-d65989dffc02",
                        "source_entry_id": "ed154789-7ad6-35dc-a213-dfb95e9e7c8a",
                        "source_sense_id": "57e78069-f319-30f7-878a-ec9e614b70e4",
                        "target_lang_word": "concrètement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "concrètement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "84a55769-1389-3598-a69d-075b18cb552e",
                                        "entry_id": "1ab57171-aab9-32b0-9c93-77c87abede78",
                                        "glosses": [
                                            "D'une manière concrète."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97008561-4a31-42b3-8e53-b57e2d0ed7fb",
                                                "sense_id": "84a55769-1389-3598-a69d-075b18cb552e",
                                                "text": "Profitons de l'observation : si l'universel absolu nous échappe, c'est que seule la particularité existe concrètement."
                                            },
                                            {
                                                "example_id": "e790cd69-311c-4b75-8dd9-5e406aca7982",
                                                "sense_id": "84a55769-1389-3598-a69d-075b18cb552e",
                                                "text": "Le 23 juin, le vote d’une majorité de Britanniques en faveur d’une sortie de l’UE consacre la métamorphose de l’UE, en la révélant, conformément aux textes (article 50 du Traité sur l’Union), concrètement susceptible de se « désélargir »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b51ab22-efab-4ef9-a021-a5f4bb35dc9e",
                        "source_entry_id": "ed154789-7ad6-35dc-a213-dfb95e9e7c8a",
                        "source_sense_id": "57e78069-f319-30f7-878a-ec9e614b70e4",
                        "target_lang_word": "konkret",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "konkret",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "628cdb6d-10d3-36ae-a5bc-07b6cf153f11",
                                        "entry_id": "3db5a21f-c5c5-329f-a89a-c57413590b4d",
                                        "glosses": [
                                            "sinnlich erfahrbar, anschaulich; wirklich; gegenständlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f05f906b-b318-49a2-9f5e-8842465ce44c",
                                                "sense_id": "628cdb6d-10d3-36ae-a5bc-07b6cf153f11",
                                                "text": "Kannst du das an einem konkreten Beispiel zeigen?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d4cad10d-5156-3e0e-8a99-ce1be6ea06ff",
                                        "entry_id": "3db5a21f-c5c5-329f-a89a-c57413590b4d",
                                        "glosses": [
                                            "deutlich formuliert, sachlich, bestimmt, genau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d555310-0e59-4f8f-ba27-529997e839ce",
                                                "sense_id": "d4cad10d-5156-3e0e-8a99-ce1be6ea06ff",
                                                "text": "Richard hat seine Idee nur vage umschrieben. Eine konkrete Erklärung hat er uns nicht gegeben."
                                            },
                                            {
                                                "example_id": "2b3e62ec-c963-4595-85c1-1752b7081b60",
                                                "sense_id": "d4cad10d-5156-3e0e-8a99-ce1be6ea06ff",
                                                "text": "„Jetzt liegen der Kommission erstmals konkrete Zahlen vor.“"
                                            },
                                            {
                                                "example_id": "858c2134-31f1-4ce3-a1b1-7f3c041984c6",
                                                "sense_id": "d4cad10d-5156-3e0e-8a99-ce1be6ea06ff",
                                                "text": "„Es gibt ganz konkrete historische Gründe dafür, dass Ostdeutschland bis heute erst gute zwei Drittel der westdeutschen Wirtschaftskraft erreicht.“"
                                            },
                                            {
                                                "example_id": "3ef23f5f-5c69-472d-b349-b6666426a6b0",
                                                "sense_id": "d4cad10d-5156-3e0e-8a99-ce1be6ea06ff",
                                                "text": "„Laut Weltbankreport aus der letzten Woche steigt die Armutsrate in der Türkei im zweiten Jahr in Folge. Konkret stieg die Anzahl armer Menschen in den letzten zwei Jahren um 3,2 Millionen auf nun 10.171.000 Bürger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
