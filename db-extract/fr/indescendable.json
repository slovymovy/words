                    {
                        "sense_id": "cf1d037c-5b90-3a68-8f0b-24cfe729808d",
                        "entry_id": "6dc91d4e-30da-3f69-a2cd-16132cc09e69",
                        "glosses": [
                            "Dont la descente est impossible, en parlant d’une pente, d’un cours d’eau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58e18d96-36e2-4358-abeb-916365951586",
                                "sense_id": "cf1d037c-5b90-3a68-8f0b-24cfe729808d",
                                "text": "La seule réaction familiale dont vous êtes alors capable consiste à maudire votre conjoint qui vous a entraînée sur une piste noire, indescendable, en jurant qu’elle était digne des débutants..."
                            },
                            {
                                "example_id": "15fe7ce6-b6ca-46f9-bce3-7bb4ec595431",
                                "sense_id": "cf1d037c-5b90-3a68-8f0b-24cfe729808d",
                                "text": "On a remonté un couloir en crampons, indescendable à ski ça s’est bien confirmé à la montée, alors on descend par où ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "7e719d37-ca62-3cf6-bb99-06fefa626767",
                        "entry_id": "6dc91d4e-30da-3f69-a2cd-16132cc09e69",
                        "glosses": [
                            "Que l’on ne peut pas faire tomber, mettre à terre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c77f326b-098f-42fc-99e3-303acc40bdef",
                                "sense_id": "7e719d37-ca62-3cf6-bb99-06fefa626767",
                                "text": "Ce qui était certain, c’est qu’on avait l’impression qu’il était indescendable ce sanglier. Il avait été tiré par tous les membres de l’équipe, à l’exception évidemment des seuls qui auraient pu le mettre à mal."
                            },
                            {
                                "example_id": "06cec59e-a677-427a-ab5b-0bb4d7c1b2ae",
                                "sense_id": "7e719d37-ca62-3cf6-bb99-06fefa626767",
                                "text": "C’était le type parfait du boxeur indescendable, une mâchoire de béton armé et une volonté de fer."
                            },
                            {
                                "example_id": "4a1a1761-e3c8-4fab-95ed-c06290fe4352",
                                "sense_id": "7e719d37-ca62-3cf6-bb99-06fefa626767",
                                "text": "On l’appelait « John Bull Beckett » et les augures de Londres le considéraient comme indescendable après le K.O. qu’il avait infligé à Bombardier Wells huit mois plus tôt."
                            }
                        ]
                    }
