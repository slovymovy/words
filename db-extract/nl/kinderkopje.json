                        "entry_id": "df97096f-38df-3e04-ae73-4fa65934ee58",
                        "glosses": [
                            "natuurstenen kei met ronde bovenkant gebruikt voor verharden van wegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8986a58f-f0ab-4232-b442-c025e88f5258",
                                "sense_id": "04d1cb82-6e88-3c65-82c4-934c1f34e509",
                                "text": "Om met dunne, hard opgepompte bandjes van een racefiets over kinderkopjes te moeten fietsen is geen pretje."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "06d276fd-ab19-4116-9dec-fe2efa24dae3",
                        "source_entry_id": "df97096f-38df-3e04-ae73-4fa65934ee58",
                        "source_sense_id": "04d1cb82-6e88-3c65-82c4-934c1f34e509",
                        "source_sense_description": "natuurstenen kei met ronde bovenkant gebruikt voor verharden van wegen",
                        "target_lang_word": "Pflasterstein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pflasterstein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01047261-9ad5-3512-99b4-682d433d49a5",
                                        "entry_id": "b0d0bcf3-49a7-353f-a212-5d76f01aeff9",
                                        "glosses": [
                                            "eines derjenigen runden oder eckigen Teile aus Stein, mit denen man einen zu befahrenden Untergrund befestigt, zum Beispiel eine Straße oder einen Platz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a25f6a7-9090-4c8b-98fa-978e1a373b2f",
                                                "sense_id": "01047261-9ad5-3512-99b4-682d433d49a5",
                                                "text": "Der Marktplatz des Dorfes ist mit Pflastersteinen verziert."
                                            },
                                            {
                                                "example_id": "3d6f1e3c-943a-471e-9752-5616300a72ae",
                                                "sense_id": "01047261-9ad5-3512-99b4-682d433d49a5",
                                                "text": "Bei der Demonstration wurden Pflastersteine gezielt auf die Einsatzfahrzeuge geworfen."
                                            },
                                            {
                                                "example_id": "6743a3c8-86b9-4d7e-86f4-ecc88b8d4297",
                                                "sense_id": "01047261-9ad5-3512-99b4-682d433d49a5",
                                                "text": "„Seine Beine wurden weich, die Pflastersteine des Gehsteigs schaukelten unter seinen Füßen.“"
                                            },
                                            {
                                                "example_id": "11e542c9-321b-4637-9759-158a088dee1a",
                                                "sense_id": "01047261-9ad5-3512-99b4-682d433d49a5",
                                                "text": "„Die Pflastersteine glänzten gefährlich glatt und rundgeschliffen von ungezählten Füßen und Wagenrädern.“"
                                            },
                                            {
                                                "example_id": "9404c78b-a383-4902-b123-368a2e0bf310",
                                                "sense_id": "01047261-9ad5-3512-99b4-682d433d49a5",
                                                "text": "„Und Wilhelm Hopfenstange, der Kutscher, stellte fest, daß die Pflastersteine beider Straßen holprig wären und voller Glassplitter und sonstigem Zeug.“"
                                            },
                                            {
                                                "example_id": "9e4a244b-252a-44f6-a5e0-9c87b15a2479",
                                                "sense_id": "01047261-9ad5-3512-99b4-682d433d49a5",
                                                "text": "„Die krummen Sträßchen des Ortes entlang lief ich im Häuserschatten durch die Mittagshitze, die Straßen leer gefegt unter der Sommersonne, das Tappen meiner Schuhe auf den Pflastersteinen und die Geräusche von Fernsehern oder Gesprächen aus den von Jalousien verdunkelten Häusern, das Klappern von Besteck oder das Bellen eines Hundes meine einzigen Begleiter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
