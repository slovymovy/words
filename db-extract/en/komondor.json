                "senses": [
                    {
                        "sense_id": "34649086-4193-380f-b437-bcb332e778f2",
                        "entry_id": "e0a07a64-71f4-33ce-b2d4-4c934978390f",
                        "glosses": [
                            "A large Hungarian breed of livestock guard dog with a long, corded coat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31f11e1a-9ae9-408d-8868-a1397ed05766",
                                "sense_id": "34649086-4193-380f-b437-bcb332e778f2",
                                "text": "The coat of the Komondor is extraordinarily profuse and generally matted into a veritable fleece of extreme density."
                            },
                            {
                                "example_id": "22ea6d4c-2d92-43bd-abfb-d811c43ccdd8",
                                "sense_id": "34649086-4193-380f-b437-bcb332e778f2",
                                "text": "In 1981 there were 36 known ranchers in North Dakota that had 52 Great Pyrenees (44 working and 8 training) and 2 working Komondor dogs."
                            },
                            {
                                "example_id": "31ad8f20-f334-4321-96f2-600c43fe270d",
                                "sense_id": "34649086-4193-380f-b437-bcb332e778f2",
                                "text": "For example, the Komondor has a naturally long white coat of matted hair while a Labrador Retriever has short hair that can be sand colored, black or brown."
                            }
                        ]
                    }
                ],
