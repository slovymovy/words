                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "872fa7c6-30b9-3ecb-bb02-40b70923d721",
                                        "entry_id": "f51ef9ae-4131-392c-94f3-64e556e99371",
                                        "glosses": [
                                            "Instrument à percussion composé de deux planchettes de bois que l’on claque l’une contre l’autre."
                                        ],
