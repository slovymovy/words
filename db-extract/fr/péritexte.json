                        "glosses": [
                            "Ensemble des éléments textuels d’accompagnement d’une œuvre écrite (titre, préface, dédicace, etc.), destiné à aider le lecteur."
                        ],
                        "tags": [
                            "Imprimerie"
                        ],
                        "note": "Le péritexte fait partie, avec l’épitexte, du paratexte",
                        "examples": [
                            {
                                "example_id": "afc2d00b-3e8b-423a-817e-cd4d179a17d8",
                                "sense_id": "3581dd79-40d5-3e2b-9abb-ae6f0dc3d352",
                                "text": "On découvre quand même, chez Colette, un livre qui s’appelle La Naissance du jour qui a paru en 1928 et qui, à l’origine, portait sur son péritexte le sous-titre roman."
                            }
                        ]
                    }
