                ],
                "senses": [
                    {
                        "sense_id": "e4d83e88-2bd9-3c32-88ae-0666d157a8ab",
                        "entry_id": "e049f539-a926-3c69-bb27-2a69267e3652",
                        "glosses": [
                            "Intoxiquer, en réponse à une intoxication dont on a été victime."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d8af957-a5ff-487a-95f4-af97fc183b06",
                                "sense_id": "e4d83e88-2bd9-3c32-88ae-0666d157a8ab",
                                "text": "Mais sans doute, dit le colonel Dubois, tandis qu’elle croyait l’intoxiquer, la contre-intoxiquait-il sciemment, délibérément, savamment ?"
                            },
                            {
                                "example_id": "18b4f158-02f2-408d-be8e-8d108edf816f",
                                "sense_id": "e4d83e88-2bd9-3c32-88ae-0666d157a8ab",
                                "text": "Peut-être qu'il fait de l'intox aussi! Sachant que c'est illégal, tu peux le contre-intoxiquer en gardant une preuve qu'il a tenté de t'intimider et le menacer de le dénoncer aux flics."
                            }
                        ]
                    }
                ],
