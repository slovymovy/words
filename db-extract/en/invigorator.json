                        "examples": [
                            {
                                "example_id": "efbd9ee3-8bc2-4dd0-91a6-26ca24bd21c6",
                                "sense_id": "99e204dd-b692-3651-8ee4-348e9426983b",
                                "text": "Hail, blessed pipe! the invigorator of the weary, the uncomplaining faithful friend, the consoler of sorrows, and the dispeller of care, the much-prized companion of the solitary wayfarer!"
                            },
                            {
                                "example_id": "5dff71c9-1459-44e9-842b-25e798bc5100",
                                "sense_id": "99e204dd-b692-3651-8ee4-348e9426983b",
                                "text": "There were further details which seemed negligible to the philanthropist, because the pictured hero of the invigorator already suggested Judge Penniman, the ever-ailing father of Winona."
                            }
                        ]
                    }
