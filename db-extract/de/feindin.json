                "senses": [
                    {
                        "sense_id": "b36c4998-ac0f-39e0-9fba-bfc64e69169a",
                        "entry_id": "af213f25-662a-38be-bf0b-8df008af6b3e",
                        "glosses": [
                            "feminine equivalent of Feind m (“enemy”)"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "8f523420-8401-4fc4-93fb-cc8f9da5cea3",
                                "sense_id": "b36c4998-ac0f-39e0-9fba-bfc64e69169a",
                                "text": "Die Trockenheit, die größte Feindin der Kultur, insbesondere der Landwirthschaft, und ihre Bekämpfung.\n(please add an English translation of this quotation)",
                                "translation": "(please add an English translation of this quotation)",
                                "english": "(please add an English translation of this quotation)"
                            },
                            {
                                "example_id": "0f60cfee-399b-4d3f-b376-88396594b929",
                                "sense_id": "b36c4998-ac0f-39e0-9fba-bfc64e69169a",
                                "text": "Den schänen Vers Goethe's:\n Vernunft und Liebe hegen jedes Glück!\n glaube ich richtig zu lesen, wenn ich das Wörtlein „und“ stark betone: diejenige Vernunft, die sich nicht als Gegensatz der Liebe brüstet, und diejenige Liebe, die nicht die Vernunft als ihre Feindin, sondern vielmehr als ihre Stütze empfindet, diese beiden sind es, die ein dauernd Gutes „hegen“ — nenne man es „Glück“ oder wie man sonst will."
                            },
                            {
                                "example_id": "7d6289ce-e2ca-42e0-a2fb-5fe90db81533",
                                "sense_id": "b36c4998-ac0f-39e0-9fba-bfc64e69169a",
                                "text": "1966, Roswitha Leckebusch, Untersuchungen über Gruppen und Verbände. Band 3. Entstehung und Wandlungen der Zielsetzungen, der Struktur und der Wirkungen von Arbeitgeberverbänden, p. 141 (quoting Die Deutsche Arbeitgeberzeitung from March 1910)",
                                "translation": "(please add an English translation of this quotation)",
                                "english": "(please add an English translation of this quotation)"
                            }
                        ]
                    }
