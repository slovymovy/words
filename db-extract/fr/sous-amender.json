                        "sense_id": "ad5cf761-8c84-3754-be9b-62a3aea90274",
                        "entry_id": "71a910de-a70b-3616-a2b6-40bf0931fc1d",
                        "glosses": [
                            "Apporter une modification à un amendement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b96f7616-f456-41bf-94de-ac4b9137a3b0",
                                "sense_id": "ad5cf761-8c84-3754-be9b-62a3aea90274",
                                "text": "M. Mahoux propose de sous-amender l'amendement de M. Monfils en remplaçant les mots « et Israël » par les mots « et l'ensemble des parties concernées »."
                            },
                            {
                                "example_id": "19a075c6-00d9-4852-9383-495498af0ea5",
                                "sense_id": "ad5cf761-8c84-3754-be9b-62a3aea90274",
                                "text": "Lorsque des opinions ayant pour but d’amender ou de sous-amender une disposition ont été émises, le Président met d’abord aux voix les sous-amendemens, puis les amendemens, et enfin la disposition principale qu’on veut amender."
                            }
                        ]
                    }
