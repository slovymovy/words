    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a7a9261c-2b5c-3167-a541-2f79625aa6a7",
                    "sense_definition": "Descendre très rapidement une pente, un escalier ou un relief.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement_descente",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant a entendu la sonnette et a <w>dévalé</w> les escaliers pour ouvrir la porte."
                        },
                        {
                            "text": "Les skieurs adorent <w>dévaler</w> la pente à toute allure dès les premières neiges."
                        }
                    ],
                    "synonyms": [
                        "descendre",
                        "débouler"
                    ],
                    "antonyms": [
                        "gravir",
                        "monter"
                    ],
                    "common_phrases": [
                        "dévaler les escaliers",
                        "dévaler la pente",
                        "dévaler une colline"
                    ]
                },
                {
                    "sense_id": "fac83083-9bc3-31cb-935e-9b478d2ce971",
                    "sense_definition": "Filer ou avancer à toute vitesse sur une voie ou une route.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vitesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La voiture <w>dévalait</w> l'avenue déserte au beau milieu de la nuit."
                        },
                        {
                            "text": "Les cyclistes <w>dévalent</w> le boulevard à un rythme effréné sous les acclamations."
                        }
                    ],
                    "synonyms": [
                        "foncer",
                        "filer"
                    ],
                    "antonyms": [
                        "ralentir"
                    ],
                    "common_phrases": [
                        "dévaler l'avenue",
                        "dévaler les rues"
                    ]
                },
                {
                    "sense_id": "f0899da4-15d9-318f-a021-d50ce3cf2310",
                    "sense_definition": "S'étendre vers le bas en formant une pente inclinée.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "relief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le grand jardin <w>dévale</w> doucement vers le cours d'eau situé au fond du vallon."
                        },
                        {
                            "text": "Les vignobles de la région <w>dévalent</w> jusqu'au bord du fleuve."
                        }
                    ],
                    "synonyms": [
                        "descendre",
                        "s'abaisser"
                    ],
                    "antonyms": [
                        "s'élever",
                        "monter"
                    ],
                    "common_phrases": [
                        "dévaler vers"
                    ]
                },
                {
                    "sense_id": "2006fc5e-9462-3618-8aeb-cefa21dd8956",
                    "sense_definition": "Transporter vers le bas, faire descendre un objet ou une charge.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ouvriers ont dû <w>dévaler</w> de lourds madriers par le passage étroit."
                        },
                        {
                            "text": "Ils ont <w>dévalé</w> les sacs de céréales jusqu'à la cave."
                        }
                    ],
                    "synonyms": [
                        "descendre"
                    ],
                    "antonyms": [
                        "monter",
                        "hisser"
                    ]
                }
            ]
        }
    ]
