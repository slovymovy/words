                        "sense_id": "4089d83b-fcd3-316b-ac3f-c4475481582e",
                        "entry_id": "24a5f536-93b5-3ec8-8fd0-a5633d1ce6b5",
                        "glosses": [
                            "Donner un caractère comparatif à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8aa5118a-b41c-46ee-a4b1-47832ad42fb4",
                                "sense_id": "4089d83b-fcd3-316b-ac3f-c4475481582e",
                                "text": "Mais de là à théologiser et à comparativiser si le droit canon dit de cesser au paillasson de la rue, ou à celui du 2ème étage, ou plus loin... cela sent son pharisaïsme !"
                            },
                            {
                                "example_id": "fded5796-79eb-45b2-806c-33b64012a808",
                                "sense_id": "4089d83b-fcd3-316b-ac3f-c4475481582e",
                                "text": "Pense un peu à ce que tu pourrais écrire et même joue avec les mots, \"métaphorise\" ou \"comparativise\", défoule-toi un peu."
                            }
                        ]
                    }
