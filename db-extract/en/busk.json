            {
                "entry_id": "84be7695-af38-32b5-b2c0-af8b9b87b670",
                "word": "busk",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ca955f76-f5da-4620-8d87-d8aeba68a48e",
                        "entry_id": "84be7695-af38-32b5-b2c0-af8b9b87b670",
                        "tags": [
                            "plural"
                        ],
                        "form": "busks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2df81a68-4ff0-3be8-b6b7-de797686babc",
                        "entry_id": "84be7695-af38-32b5-b2c0-af8b9b87b670",
                        "glosses": [
                            "A strip of metal, whalebone, wood, or other material, worn in the front of a corset to stiffen it."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2847e16f-db3d-4391-8fee-150647e8602a",
                                "sense_id": "2df81a68-4ff0-3be8-b6b7-de797686babc",
                                "text": "Her long slit sleeves, stiffe buske, puffe verdingall, / Is all that makes her thus angelicall."
                            }
                        ]
                    },
                    {
                        "sense_id": "423acab6-58dd-37fb-934e-673f5bc72282",
                        "entry_id": "84be7695-af38-32b5-b2c0-af8b9b87b670",
                        "glosses": [
                            "A corset."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "1443942b-4c9d-47ff-beb0-598d0ba9a3e3",
                                "sense_id": "423acab6-58dd-37fb-934e-673f5bc72282",
                                "text": "Off with that happy busk, which I envie, / That still can be, and still can stand so nigh."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4bfd8400-f954-402e-a9cb-00c415457ee9",
                        "source_entry_id": "84be7695-af38-32b5-b2c0-af8b9b87b670",
                        "source_sense_description": "stiffening strip in the front of a corset",
                        "target_lang_word": "busc",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "busc",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b0c48e62-0f4c-337c-9fcf-0dd029170b0a",
                                        "entry_id": "843d0a84-f382-367e-b440-e781653b01f6",
                                        "glosses": [
                                            "Lame d’acier, plate, étroite et arrondie aux deux bouts (anciennement on utilisait des fanons de baleine), qui servait à maintenir le devant d’un corset. Il se glisse dans la busquière."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b344abcf-8793-4887-9434-ddb3a054e023",
                                                "sense_id": "b0c48e62-0f4c-337c-9fcf-0dd029170b0a",
                                                "text": "Avoir tenu cette lettre entre sa chair et son corset, sous son busc brûlant, pendant toute une journée !"
                                            },
                                            {
                                                "example_id": "52149baf-1a74-4c8f-a719-834cc05fb06c",
                                                "sense_id": "b0c48e62-0f4c-337c-9fcf-0dd029170b0a",
                                                "text": "Un coup de busc sec sur les doigts qui s’émancipent vaut bien un coup de votre rapière."
                                            },
                                            {
                                                "example_id": "97ffcccf-6a3a-4408-bf82-97158f82ec29",
                                                "sense_id": "b0c48e62-0f4c-337c-9fcf-0dd029170b0a",
                                                "text": "Mais le couteau avait rencontré heureusement, nous devrions dire adroitement, le busc de fer qui à cette époque défendait comme une cuirasse la poitrine des femmes ; il avait glissé en déchirant la robe et avait pénétré de biais entre la chair et les côtes."
                                            },
                                            {
                                                "example_id": "cdf75d49-38c6-4413-ab9f-70f9e6976cf6",
                                                "sense_id": "b0c48e62-0f4c-337c-9fcf-0dd029170b0a",
                                                "text": "Elle plante un peigne à bord de perles dans ses cheveux noirs, et tire, sur son busc inflexible, les plis de sa blouse en vichy, chaque fois qu’elle passe devant un miroir."
                                            },
                                            {
                                                "example_id": "76d85f1e-664d-41ec-9abd-f43b675424bc",
                                                "sense_id": "b0c48e62-0f4c-337c-9fcf-0dd029170b0a",
                                                "text": "[…] on porte maintenant des corsages beaucoup plus longs, le devant en pointe, le busc dépassant toute limite, la jupe froncée comme au temps des paniers […]"
                                            },
                                            {
                                                "example_id": "dd8ac2af-b81f-4cb0-9592-6138042cd9f2",
                                                "sense_id": "b0c48e62-0f4c-337c-9fcf-0dd029170b0a",
                                                "text": "Dans les grands uniformes érotiques, il y a aussi pour moi les robes du XVIIIᵉ siècle, avec un long busc."
                                            },
                                            {
                                                "example_id": "dda39aba-82cb-48d2-879b-09b015060b81",
                                                "sense_id": "b0c48e62-0f4c-337c-9fcf-0dd029170b0a",
                                                "text": "Michel est parfois tenté de glisser le bras autour de cette taille fine, au risque d’entendre craquer des buscs. Mais que d’agrafes à défaire ou à arracher !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2738f1c0-5f79-3c27-874b-a5439f984bd4",
                                        "entry_id": "843d0a84-f382-367e-b440-e781653b01f6",
                                        "glosses": [
                                            "Partie supérieure d’une crosse de fusil où la joue vient s’appuyer lors de la visée."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e67b889-b368-4a70-9f1b-72203646722c",
                                                "sense_id": "2738f1c0-5f79-3c27-874b-a5439f984bd4",
                                                "text": "Quand Stranahan appuya sur la détente avant, le busc de la crosse heurta sa pommette et le canon dévia en haut et à droite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e02f2a47-61be-3aed-96c9-64196ce1ebd8",
                                        "entry_id": "843d0a84-f382-367e-b440-e781653b01f6",
                                        "glosses": [
                                            "Saillie dans le radier d’une écluse empêchant le passage de l'eau lorsque les vantaux sont fermés."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
