                                        "entry_id": "86579615-cdf2-3bda-9f90-c3801cad6314",
                                        "glosses": [
                                            "A noun that denotes any member, or all members, of a class; an ordinary noun such as dog or city; contrasted with a proper noun, which refers to a single named entity, such as Socrates or Tokyo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a8b6687-8cb1-4068-b5a0-9c22cb64b387",
                                                "sense_id": "72d685ec-a301-3d72-825f-b3b1580230d9",
                                                "text": "The Butlers had been serving the Fowls for centuries. It had always been that way. Indeed, there were several eminent linguists of the opinion that this was how the common noun had originated."
                                            }
                                        ]
                                    }
                                ]
                            }
