                {
                    "sense_id": "b823871e-7f08-3d80-8d97-155aee4beae3",
                    "sense_definition": "Duidt aan dat een persoon, zaak of situatie identiek is aan een eerder genoemde of bekende entiteit (gebruikt bij de-woorden in het enkelvoud en alle woorden in het meervoud)",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "identity_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb <w>dezelfde</w> jurk als zij.",
                            "target_lang_translations": {
                                "ru": "У меня <w>такое же</w> платье, как у нее.",
                                "en": "I have <w>the same</w> dress as she does.",
                                "pl": "Mam <w>taką samą</w> sukienkę jak ona.",
                                "de": "Ich habe <w>dasselbe</w> Kleid wie sie.",
                                "fr": "J'ai la <w>même</w> robe qu'elle.",
                                "it": "Ho <w>lo stesso</w> vestito che ha lei.",
                                "cs": "Mám <w>stejné</w> šaty jako ona.",
                                "tr": "Onunla <w>aynı</w> elbiseye sahibim.",
                                "es": "Tengo el <w>mismo</w> vestido que ella."
                            }
                        },
                        {
                            "text": "Zij wonen al jaren in <w>dezelfde</w> straat als mijn ouders.",
                            "target_lang_translations": {
                                "ru": "Они уже много лет живут на <w>той же</w> улице, что и мои родители.",
                                "en": "They have lived in <w>the same</w> street as my parents for years.",
                                "pl": "Oni od lat mieszkają na <w>tej samej</w> ulicy, co moi rodzice.",
                                "de": "Sie wohnen schon seit Jahren in <w>derselben</w> Straße wie meine Eltern.",
                                "fr": "Ils habitent dans la <w>même</w> rue que mes parents depuis des années.",
                                "it": "Abitano nella <w>stessa</w> via dei miei genitori da anni.",
                                "cs": "Už roky bydlí ve <w>stejné</w> ulici jako moji rodiče.",
                                "tr": "Yıllardır ailemle <w>aynı</w> sokakta yaşıyorlar.",
                                "es": "Viven en la <w>misma</w> calle que mis padres desde hace años."
                            }
                        },
                        {
                            "text": "Op <w>dezelfde</w> dag dat hij vertrok, begon het hard te regenen.",
                            "target_lang_translations": {
                                "ru": "В <w>тот же</w> день, когда он уехал, начался сильный дождь.",
                                "en": "On <w>the same</w> day he left, it started raining heavily.",
                                "pl": "W <w>ten sam</w> dzień, w którym wyjechał, zaczął mocno padać deszcz.",
                                "de": "Am <w>selben</w> Tag, an dem er abreiste, fing es an, stark zu regnen.",
                                "fr": "Le <w>même</w> jour où il est parti, il a commencé à pleuvoir à verse.",
                                "it": "Lo <w>stesso</w> giorno in cui è partito, ha iniziato a piovere forte.",
                                "cs": "V <w>ten samý</w> den, kdy odjel, začalo silně pršet.",
                                "tr": "Gittiği <w>aynı</w> gün bardaktan boşanırcasına yağmur yağmaya başladı.",
                                "es": "El <w>mismo</w> día que se fue, empezó a llover fuerte."
                            }
                        }
                    ],
                    "synonyms": [
                        "identieke",
                        "diezelfde"
                    ],
                    "antonyms": [
                        "andere",
                        "verschillende"
                    ],
                    "common_phrases": [
                        "op dezelfde manier",
                        "in dezelfde tijd",
                        "dezelfde dag",
                        "dezelfde fout"
                    ],
                    "target_lang_definitions": {
                        "ru": "Указывает на то, что лицо, предмет или ситуация идентичны ранее упомянутым или известным (используется с существительными рода de в единственном числе и всеми существительными во множественном числе)",
                        "en": "Indicates that a person, thing, or situation is identical to a previously mentioned or known entity",
                        "pl": "Wskazuje, że osoba, rzecz lub sytuacja jest identyczna z wcześniej wspomnianą lub znaną (używane z rzeczownikami rodzaju de w liczbie pojedynczej oraz ze wszystkimi rzeczownikami w liczbie mnogiej)",
                        "de": "Weist darauf hin, dass eine Person, Sache oder Situation mit einer zuvor genannten oder bekannten Entität identisch ist (verwendet bei de-Wörtern im Singular und allen Wörtern im Plural)",
                        "fr": "Indique qu'une personne, une chose ou une situation est identique à une entité précédemment mentionnée ou connue.",
                        "it": "Indica che una persona, cosa o situazione è identica a un'entità precedentemente menzionata o nota (usato con i sostantivi singolari con articolo 'de' e con tutti i sostantivi plurali)",
                        "cs": "Označuje, že osoba, věc nebo situace je totožná s dříve zmíněnou nebo známou entitou (používá se u podstatných jmen s členem 'de' v jednotném čísle a u všech podstatných jmen v množném čísle).",
                        "tr": "Bir kişinin, nesnenin veya durumun daha önce bahsedilen veya bilinen bir varlıkla tamamen aynı olduğunu belirtir (tekil 'de' kelimeleri ve tüm çoğul kelimelerle kullanılır)",
                        "es": "Indica que una persona, cosa o situación es idéntica a una entidad previamente mencionada o conocida."
                    },
