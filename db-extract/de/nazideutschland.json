                    }
                ],
                "senses": [
                    {
                        "sense_id": "349ee1f6-77a5-3085-80d4-4c0133b39a97",
                        "entry_id": "7e71c0e4-2577-3de7-b5c7-bf59eb67a4b3",
                        "glosses": [
                            "Deutschland in der besonderen Verfassung, die es in der Zeit der Naziherrschaft 1933 bis 1945 hatte"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "43a4408c-c9d6-490e-9714-4eba9f67c6e1",
                                "sense_id": "349ee1f6-77a5-3085-80d4-4c0133b39a97",
                                "text": "„Am 9. Mai wird in Moskau feierlich des Kriegsendes und des Sieges über Nazideutschland gedacht, wobei aller Voraussicht nach die Veranstalter eine Parallele zwischen diesem und dem Widerstand gegen die \"faschistische Junta\" in Kiew ziehen dürften.“"
                            },
                            {
                                "example_id": "9288b80b-f579-48a9-8517-21a6e1038869",
                                "sense_id": "349ee1f6-77a5-3085-80d4-4c0133b39a97",
                                "text": "„Mit einer großen Militärparade auf dem Roten Platz in Moskau erinnert das Land jedes Jahr an den Sieg über Nazideutschland.“"
                            },
                            {
                                "example_id": "7da199ce-f527-467e-a5f1-68b5a859fde2",
                                "sense_id": "349ee1f6-77a5-3085-80d4-4c0133b39a97",
                                "text": "„Als am 8. Mai 1945 Nazideutschland kapitulierte, kam es auch in Algerien zu Siegesfeiern - hatten doch, wie schon im Ersten Weltkrieg, unzählige algerische Soldaten aufseiten Frankreichs gekämpft.“"
                            },
                            {
                                "example_id": "eb54e1cf-3236-4c43-bedc-809ecedd6853",
                                "sense_id": "349ee1f6-77a5-3085-80d4-4c0133b39a97",
                                "text": "„Erst in Hitlers Nazideutschland wird er zu jemandem, der kein Recht hat, weiterzuleben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
