                        "sense_id": "c11fee3b-19a5-39d2-991b-a5e49c5e9b51",
                        "entry_id": "93690825-f25b-313c-b4dc-d3a2d161fe8b",
                        "glosses": [
                            "Dépouiller de sa fraicheur, ôter son éclat à un légume, une étoffe, un objet, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db08703d-b53a-4b06-b565-c0ff5c38b513",
                                "sense_id": "c11fee3b-19a5-39d2-991b-a5e49c5e9b51",
                                "text": "Fait attention avant d’acheter en fin de marché, avec ce soleil, de nombreux légumes seront défraichis."
                            },
                            {
                                "example_id": "9cf4d15e-8588-437e-9955-a1a65ab97d31",
                                "sense_id": "c11fee3b-19a5-39d2-991b-a5e49c5e9b51",
                                "text": "Le soleil a défraichi la couleur de ces objets."
                            },
                            {
                                "example_id": "207354ea-6426-499f-afc1-cae89f8ecb13",
                                "sense_id": "c11fee3b-19a5-39d2-991b-a5e49c5e9b51",
                                "text": "Une étoffe toute défraichie."
                            }
                        ]
                    },
                    {
                        "sense_id": "d7ec0f29-54d7-3c6c-9774-20fd8df795a5",
                        "entry_id": "93690825-f25b-313c-b4dc-d3a2d161fe8b",
                        "glosses": [
