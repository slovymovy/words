    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8a8566db-78ea-332a-9959-3683d06f24e6",
                    "sense_definition": "To recognize or perceive the difference between two or more things.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "distinguish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is often difficult to <w>discriminate</w> between the two similar shades of blue."
                        },
                        {
                            "text": "The human ear can <w>discriminate</w> between many different frequencies of sound."
                        }
                    ],
                    "synonyms": [
                        "distinguish",
                        "differentiate",
                        "tell apart"
                    ],
                    "common_phrases": [
                        "discriminate between"
                    ]
                },
                {
                    "sense_id": "f1eddcd9-6e9d-335d-a065-78947f7d0bff",
                    "sense_definition": "To treat a person or group unfairly based on prejudice rather than individual merit.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "prejudice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is illegal for employers to <w>discriminate</w> against workers based on their age."
                        },
                        {
                            "text": "Many organizations work hard to ensure they do not <w>discriminate</w> against any minority groups."
                        }
                    ],
                    "synonyms": [
                        "disfavor"
                    ],
                    "antonyms": [
                        "favor"
                    ],
                    "common_phrases": [
                        "discriminate against"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b743ee82-31b0-3743-8eb3-5da991ec87fc",
                    "sense_definition": "Showing good judgment or the ability to perceive subtle differences.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "distinguish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The critic had a <w>discriminate</w> taste for fine art and classical music."
                        },
                        {
                            "text": "She made a <w>discriminate</w> choice after carefully reviewing all the available options."
                        }
                    ],
