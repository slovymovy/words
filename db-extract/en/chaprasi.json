                        "glosses": [
                            "An official of some kind, especially an important attendant or messenger in the household of an Indian landowner."
                        ],
                        "tags": [
                            "India"
                        ],
                        "examples": [
                            {
                                "example_id": "08c20b90-d1c5-4aa9-af87-36c032168fbf",
                                "sense_id": "896aa0e8-0c73-3c90-b7c1-2a42a3e1d511",
                                "text": "A servant in scarlet interrupted him; he was the chuprassy of the Civil Surgeon, and he handed Aziz a note."
                            },
                            {
                                "example_id": "3781550b-c9b3-4f24-9821-b712e7b6ee9e",
                                "sense_id": "896aa0e8-0c73-3c90-b7c1-2a42a3e1d511",
                                "text": "Two clerks who had witnessed the scene, and a chaprassi, were sent along to Mr Macgregor's office to corroborate the story. They lied in perfect unison."
                            },
                            {
                                "example_id": "8c50741e-2843-4c31-9d68-1c920ebcfd1a",
                                "sense_id": "896aa0e8-0c73-3c90-b7c1-2a42a3e1d511",
                                "text": "Liveried chaprasis were bringing in wreaths to be placed on Mattoo's body, from the Governor General, Prime Minister, cabinet ministers, heads of industrial houses."
                            }
                        ]
                    }
