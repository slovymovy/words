                                    },
                                    {
                                        "sense_id": "04344c9e-1645-3018-bf66-b12c38157bfa",
                                        "entry_id": "a7b6fb04-c118-3818-ae54-c18d84c45e81",
                                        "glosses": [
                                            "Coiffeur."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a9b2bfc-febb-40bd-9dc7-9d95a8e10fbb",
                                                "sense_id": "04344c9e-1645-3018-bf66-b12c38157bfa",
                                                "text": "Peut-on voir quelque chose de plus sot que le visage de ces messieurs ! Rozan et Chibray ressemblent à Gustave, mon perruquier."
                                            },
                                            {
                                                "example_id": "3336a14a-64bc-499a-a67c-3b6c920e1dc4",
                                                "sense_id": "04344c9e-1645-3018-bf66-b12c38157bfa",
                                                "text": "Tandis que sous l'empire des anciennes lois, l'état de perruquier et celui de baigneur étuviste étaient assujettis à une réglementation sévère, l'exercice de la profession de sage-femme était abandonné aux premières venues."
                                            },
                                            {
                                                "example_id": "6a861d2b-360f-4f95-bb71-c0629f44e147",
                                                "sense_id": "04344c9e-1645-3018-bf66-b12c38157bfa",
                                                "text": "Le P. Mozier mort, les Balmoral se trouvèrent tout désœuvrés jusqu’à ce que Balmoral, se souvenant qu’il avait été dans son enfance apprenti perruquier, eût décidé d’ouvrir un salon de coiffure dans l’arrière-boutique du Café de France."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
