                            "passive"
                        ],
                        "examples": [
                            {
                                "example_id": "227aaf5b-b709-4b32-975b-3d9e4c074a70",
                                "sense_id": "24becbd7-c921-3d8c-aadb-2175fbe1b185",
                                "text": "Город ещё рос, спешно вколачивались гвозди, мелькали в грязи белые доски, достраивались лавчонки."
                            }
                        ]
                    },
                    {
                        "sense_id": "54cd8d2e-75e8-3f08-86a9-22b010e8cd27",
                        "entry_id": "92954f1c-1ab0-360c-9fd1-ff24a7919533",
                        "glosses": [
                            "прост. внедряться в сознание"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a85c2cd0-ab06-493a-b295-5077ead76007",
                                "sense_id": "54cd8d2e-75e8-3f08-86a9-22b010e8cd27",
                                "text": "Так вколачивалось в солдатские мозги основание воинской службы и становилось крепким, как молитва."
                            }
                        ]
                    }
