                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc62bf7f-ef4d-494e-b4b0-f6a2c41f33fd",
                                "sense_id": "27e0ecd5-8642-3a0f-9312-d19be7e612b9",
                                "text": "Consumption! 't is thou that their life-springs hast wasted!\n'T is thou that hast wither'd the bud in its bloom!"
                            },
                            {
                                "example_id": "886b9a7b-d05a-4631-82b9-e7cc282ea361",
                                "sense_id": "27e0ecd5-8642-3a0f-9312-d19be7e612b9",
                                "text": "Perchance, when ages shall have fled, that land,\nStripped bare-- again unable to withstand\nVolcanic force, that will her life-springs start"
                            }
                        ]
                    }
