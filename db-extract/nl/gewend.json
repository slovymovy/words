                        ],
                        "examples": [
                            {
                                "example_id": "d1b83cfb-6e50-4106-bfbf-92ac96435fed",
                                "sense_id": "a9470f5e-a97b-3827-a3bb-95edc9474e72",
                                "text": "Na de Portugese revolutie van 1974 duurde het even voor de verwachte meesterwerken kwamen. Maar toen ze eenmaal verschenen bleken ze uit te blinken door een vergaand constructivisme, bloedeloosheid, nodeloze ingewikkeldheid, pretentieuze literatuurmakerij. Mij is een keer uitgelegd dat dit te maken had met de langdurige repressie die er aan vooraf ging: om de censor te misleiden, hadden schrijvers zich gewend aan een cryptisch, omschrijvend taalgebruik van hoge complexiteit - een pluspuntje van de censuur, in feite."
                            }
                        ]
                    }
