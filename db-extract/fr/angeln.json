                    },
                    {
                        "translation_id": "56c22a1b-6ecf-4a08-980d-b6b783e928a3",
                        "source_entry_id": "3880422e-f8b9-37bc-9fac-61fdcf008b2f",
                        "source_sense_id": "838e0f18-9cdd-3cff-9f40-82a8c9c49eee",
                        "target_lang_word": "Angler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Angler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5872a934-62a4-3a99-bf33-78c0d1679a9e",
                                        "entry_id": "3f455cb4-1134-3085-9ca9-ddd0aa77c080",
                                        "glosses": [
                                            "jemand, der (normalerweise mit einer Angel) versucht, Fische zu fangen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c1efee9-a6c0-42c4-983b-a1954640daf0",
                                                "sense_id": "5872a934-62a4-3a99-bf33-78c0d1679a9e",
                                                "text": "Der Angler, der am See saß, war beim Angeln eingeschlafen."
                                            },
                                            {
                                                "example_id": "7a4f19cc-19ad-48f9-91c8-89e5d2e39d4d",
                                                "sense_id": "5872a934-62a4-3a99-bf33-78c0d1679a9e",
                                                "text": "„Wie ein schlechter Angler hatte ich überreagiert und einen winzigen Fisch mit aller Kraft aus dem See gerissen.“"
                                            },
                                            {
                                                "example_id": "6bcd8911-b702-4301-9df1-a733ca862901",
                                                "sense_id": "5872a934-62a4-3a99-bf33-78c0d1679a9e",
                                                "text": "„An einem eisig kalten Wintertag sitzt ein Angler mit seiner dicken Backe am Fluss.“"
                                            },
                                            {
                                                "example_id": "7d66d314-28b7-4d84-bd01-066860dc6caf",
                                                "sense_id": "5872a934-62a4-3a99-bf33-78c0d1679a9e",
                                                "text": "„Die Angler hockten am Ufer.“"
                                            },
                                            {
                                                "example_id": "c2d1d612-e905-4fe8-8732-d1c4478ea240",
                                                "sense_id": "5872a934-62a4-3a99-bf33-78c0d1679a9e",
                                                "text": "„Reiseschriftsteller schrieben über die Angler an der Seine, als seien sie verrückt und würden nie etwas fangen; tatsächlich aber war das eine ernsthafte, ergiebige Sache.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "39602473-5caa-3615-9975-c13659aa08c8",
                                        "entry_id": "3f455cb4-1134-3085-9ca9-ddd0aa77c080",
                                        "glosses": [
                                            "Anglerfisch"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2705c07-2c4a-48b8-9c89-3409cb75d9d1",
                                                "sense_id": "39602473-5caa-3615-9975-c13659aa08c8",
                                                "text": "Der Angler lebt tief im Meer."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
