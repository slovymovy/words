                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5df915f0-056f-33ef-a3c4-44355a574c42",
                                        "entry_id": "a2b8ac40-466c-3f5d-af50-c21e135d3a79",
                                        "glosses": [
                                            "Angehöriger einer christlichen Konfession, die durch die Reformation entstanden ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7cd0544-1b96-44f1-8c0a-a0c763531611",
                                                "sense_id": "5df915f0-056f-33ef-a3c4-44355a574c42",
                                                "text": "In Nordirland herrschen Auseinandersetzungen zwischen Protestanten und Katholiken."
                                            },
                                            {
                                                "example_id": "932bd3d4-f48f-4a8c-b930-96913991b152",
                                                "sense_id": "5df915f0-056f-33ef-a3c4-44355a574c42",
                                                "text": "„In Versammlungen wie dem Reichstag nutzten die katholischen Fürsten zudem das Mehrheitswahlrecht, um die Protestanten kaltzustellen.“"
                                            },
                                            {
                                                "example_id": "2f228a0f-387c-4064-8056-d94cafa07ea7",
                                                "sense_id": "5df915f0-056f-33ef-a3c4-44355a574c42",
                                                "text": "„Meine Eltern, strenggläubige Protestanten, huldigten der Nachkriegsmode konfessioneller Versöhnlichkeit und schickten mich auf eine katholische Schule.“"
                                            },
                                            {
                                                "example_id": "0a95af5d-7765-45ca-ba34-39f840a016c0",
                                                "sense_id": "5df915f0-056f-33ef-a3c4-44355a574c42",
                                                "text": "„Der Protestant hat nur eine Kapelle, nüchterne Wände, einfache Fenster, und jetzt steht er neben dem katholischen Gottesmann wie ein armer Verwandter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "85f89fa3-751f-36c4-b56e-10feefc3e9ff",
                                        "entry_id": "a2b8ac40-466c-3f5d-af50-c21e135d3a79",
                                        "glosses": [
                                            "Person, die gegen etwas protestiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "500e2fed-b4ec-402d-8990-a1345e31ae06",
                                                "sense_id": "85f89fa3-751f-36c4-b56e-10feefc3e9ff",
                                                "text": "Die Protestanten verhielten sich gegenüber den Polizisten friedlich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
