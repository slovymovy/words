                        "examples": [
                            {
                                "example_id": "4cbaa2f6-57e5-4ebc-a483-f59b71244696",
                                "sense_id": "a747f164-7c92-3a97-91b7-2f30a0884f2f",
                                "text": "Mais voilà que ce bois déjà grouillant de Ricains, s'était mis à grouillonner de gendarmes français et de poulets allemands !"
                            },
                            {
                                "example_id": "2036c43f-a03c-41da-95e2-42403326bfb2",
                                "sense_id": "a747f164-7c92-3a97-91b7-2f30a0884f2f",
                                "text": "L'équilibre qui par définition est instable va grouillonner sur cette surface sans en sortir, sans partir d'un côté ou de l'autre, donc, le corps est stable !!"
                            }
                        ]
