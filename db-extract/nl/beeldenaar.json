                            {
                                "example_id": "cfac93da-01c7-4904-8738-a2fbb3e5f31e",
                                "sense_id": "524029cb-4b89-3c37-b9f8-95e2b5473f57",
                                "text": "Naast de legende is de beeldenaar vaak het belangrijkste identificatiemiddel voor een munt en stelt vaak een heerser of godheid voor."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9c273eb-6efd-3cda-b49e-37e18ed22ab2",
