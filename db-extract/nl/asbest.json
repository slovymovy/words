                                                "example_id": "aa602597-05fb-45f6-8642-04779b8d0256",
                                                "sense_id": "412994ff-0b48-3d8d-9366-29b489390254",
                                                "text": "Aufgrund seiner gesundheitsschädlichen Eigenschaften wird Asbest heute nicht mehr verwendet und mit oft großem Aufwand entfernt."
                                            }
