                    {
                        "sense_id": "e13014cc-d402-36a8-840f-a5b0db73826b",
                        "entry_id": "cd330950-7f58-3912-acfb-768d174a1b3c",
                        "glosses": [
                            "A pair of cards of the same suit, which are the only cards of that suit in a player's hand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95eba37f-4258-46e9-9bf3-47c38f17445c",
                                "sense_id": "e13014cc-d402-36a8-840f-a5b0db73826b",
                                "text": "If she had had the doubleton ace of diamonds and a low club, she would have made a four-club splinter bid, showing four-card spade support, the values for game and a singleton or void in clubs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d284052a-8855-4bd3-a732-e35fd5fee765",
                        "source_entry_id": "cd330950-7f58-3912-acfb-768d174a1b3c",
