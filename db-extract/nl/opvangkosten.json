                        "examples": [
                            {
                                "example_id": "23856eda-071a-4b7d-9a63-b51580c2d332",
                                "sense_id": "d43869a1-c3ad-3167-8600-9b8e8993cc4d",
                                "text": "Meestal levert een van de ouders wekelijks vijf tot acht uur werktijd in. Tachtig procent van de ouders die minder zijn gaan werken geeft de hoge opvangkosten als reden op."
                            },
                            {
                                "example_id": "f6798af1-4519-4909-8af2-0e99fbd38cdd",
                                "sense_id": "d43869a1-c3ad-3167-8600-9b8e8993cc4d",
                                "text": "De Berlijnse politie gaat proberen om de opvangkosten op de jongen te verhalen. Die zouden zijn opgelopen tot ongeveer 30.000 euro."
                            },
                            {
                                "example_id": "0e157e4a-bc77-4847-96ab-fb1032b27573",
                                "sense_id": "d43869a1-c3ad-3167-8600-9b8e8993cc4d",
                                "text": "Adema wijst erop dat de grote aantallen katten waarvan de eigenaar onbekend is een kleine 5 miljoen euro aan opvangkosten voor gemeenten veroorzaken. In zijn brief aan de Tweede Kamer benadrukt hij verder dat zwerfkatten en loslopende huiskatten voor overlast zorgen, ziekten kunnen veroorzaken en het gevaar lopen zoek te raken. Volgens hem is \"het niveau van welzijn\" van deze katten minder dan dat van \"gehouden katten\"."
                            }
