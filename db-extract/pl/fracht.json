                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5f9f9a4-b0a0-4da0-a860-65c957e0654c",
                                "sense_id": "b482b7c8-8e54-37f3-846b-79ffa95776bd",
                                "text": ", wyd. Wiedza Powszechna, Warszawa 1967.."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
