                                        "entry_id": "f3441ee3-9bbb-3706-917e-bdc0a5c96af2",
                                        "glosses": [
                                            "Organisme gérant des affaires pour le compte d'autrui."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "430ac844-dae8-4365-af39-9fa5c4812b43",
                                                "sense_id": "78c8823d-0a7a-31ff-a612-1177bc0d271c",
                                                "text": "Tout ce monde achète, vend, brocante. Des prélats spéculent sur les terrains et les constructions, des lazaristes sur les agences de recrutement militaire, etc., etc."
                                            },
                                            {
                                                "example_id": "62d44414-67cc-4c09-b55f-f7fa04c434dc",
                                                "sense_id": "78c8823d-0a7a-31ff-a612-1177bc0d271c",
                                                "text": "Agence générale. Agence d’affaires, de travaux. Agence de location."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d26b844-701c-3a54-b8ce-cec4c0233c76",
                                        "entry_id": "f3441ee3-9bbb-3706-917e-bdc0a5c96af2",
                                        "glosses": [
                                            "Organisme ayant pour tâche de centraliser des nouvelles, et de les transmettre à ses clients, à la presse, etc. agence de presse."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35b75fde-8eba-480d-8dfc-158fb5296f09",
                                                "sense_id": "5d26b844-701c-3a54-b8ce-cec4c0233c76",
                                                "text": "Des systèmes lance-roquettes multiples américains HIMARS, capables de lancer des missiles balistiques de longue portée sont arrivés de Jordanie à la base syrienne d'Al-Tanf, a annoncé l’agence Reuters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49436b74-bebf-3419-b6a8-d456fb5ca563",
                                        "entry_id": "f3441ee3-9bbb-3706-917e-bdc0a5c96af2",
                                        "glosses": [
                                            "Succursale, bureau local par rapport à la maison-mère ou à un centre régional."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb7d0234-128c-429a-9c26-7d6db2185cfe",
                                                "sense_id": "49436b74-bebf-3419-b6a8-d456fb5ca563",
                                                "text": "Notre banque dispose de cinquante agences réparties sur tout le territoire."
                                            },
                                            {
                                                "example_id": "9dd75b7f-8961-4281-935e-5eae4ca339d6",
                                                "sense_id": "49436b74-bebf-3419-b6a8-d456fb5ca563",
                                                "text": "L'agence lilloise du Trésor Public."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98d0fa0d-cd54-3fef-9954-4c75a7adccfd",
                                        "entry_id": "f3441ee3-9bbb-3706-917e-bdc0a5c96af2",
                                        "glosses": [
                                            "Endroit où se trouvent les bâtiments affectés à cet établissement."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c8033ad-88fc-4457-9e88-96b9901d6eb3",
                                                "sense_id": "98d0fa0d-cd54-3fef-9954-4c75a7adccfd",
                                                "text": "Se rendre à l’agence. Il a son agence rue de Richelieu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "132fdc7e-f60e-3a48-a267-3e17a73bb357",
                                        "entry_id": "f3441ee3-9bbb-3706-917e-bdc0a5c96af2",
                                        "glosses": [
                                            "Rôle, action d’un agent."
                                        ],
                                        "tags": [
                                            "Extrêmement rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76a25a32-98a0-4561-9ee9-92efb3581000",
                                                "sense_id": "132fdc7e-f60e-3a48-a267-3e17a73bb357",
                                                "text": "Mais on devrait se rappeler que pendant un long temps la coïncidence de la rotation de la Lune avec sa révolution sidérale, […], a été considérée comme un fait positivement miraculeux ; et qu’il y avait, même parmi les astronomes, une singulière disposition à attribuer cette merveille à l’agence directe et continue de Dieu, […]."
                                            }
                                        ]
                                    }
