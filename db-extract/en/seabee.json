                        "examples": [
                            {
                                "example_id": "de2ea78c-aa79-481b-a6a2-e6ed994d267a",
                                "sense_id": "7b118ac2-675f-3136-a6b7-68ca3ed4c765",
                                "text": "The Navy is establishing a new Construction Battalion, or Seabee, unit in Charleston, S. C., Senator Strom Thurmond, Republican of South Carolina, said today."
                            }
                        ]
                    },
                    {
                        "sense_id": "1aeea267-42ca-355b-b80f-6b4f638df02b",
