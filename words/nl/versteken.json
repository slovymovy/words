                            {
                                "target_lang_word": "se dissimuler",
                                "target_lang_sense_clarification": "se mettre à l'abri des regards"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d4aa94b-1ffa-3759-8299-9f5a41560f6a",
                    "sense_definition": "Iemand afwijzen of uit de gemeenschap stoten.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij werd door zijn eigen familie <w>verstoken</w> na het schandaal.",
                            "target_lang_translations": {
