                                        "entry_id": "01d7c451-9e5f-3652-ac7c-b1e25d3ce7b2",
                                        "glosses": [
                                            "Traditional Russian felt boots."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10154a51-8463-43cd-92a2-5ec604f65ac0",
                                                "sense_id": "b5a708d8-6dc5-32ab-aed6-b9600a8f5f75",
                                                "text": "With our feet protected from frostbite in our valenki, we were able to walk outside. The valenki came just in time, since the temperature was falling rapidly and the winter was fierce beyond normal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
