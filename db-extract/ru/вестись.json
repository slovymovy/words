                        "examples": []
                    },
                    {
                        "sense_id": "ca89dc0e-187c-3460-bfdf-89193b376686",
                        "entry_id": "45403159-3ea3-34cc-90a1-f2606d891a23",
                        "glosses": [
                            "to be in progress, to be underway"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1607a106-c260-4d8b-a17a-bd8c6c95e456",
                                "sense_id": "ca89dc0e-187c-3460-bfdf-89193b376686",
                                "text": "Веду́тся иссле́дования с це́лью созда́ния но́вой тео́рии",
                                "translation": "Efforts are underway toward the construction of a new theory",
                                "english": "Efforts are underway toward the construction of a new theory"
                            },
                            {
                                "example_id": "2576e476-1002-43ed-945d-a68ad1f8a0b5",
                                "sense_id": "ca89dc0e-187c-3460-bfdf-89193b376686",
                                "text": "Веду́тся перегово́ры о безви́зовом режи́ме.",
                                "translation": "The visa-free talks are underway.",
                                "english": "The visa-free talks are underway."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a213531-da50-3092-a6e4-36a18badbe76",
                        "entry_id": "45403159-3ea3-34cc-90a1-f2606d891a23",
                        "glosses": [
                            "to be conducted, to be carried on, to be observed"
                        ],
                        "tags": [
                            "impersonal"
                        ],
                        "examples": [
                            {
                                "example_id": "0a020829-a646-4f6a-90c9-f7f96054e6a6",
                                "sense_id": "3a213531-da50-3092-a6e4-36a18badbe76",
                                "text": "Так уж у нас ведётся",
                                "translation": "That's a custom among us",
                                "english": "That's a custom among us"
                            }
                        ]
                    },
                    {
                        "sense_id": "30cb49b3-d6e0-3f5a-94d7-c2c5dfb4a04a",
                        "entry_id": "45403159-3ea3-34cc-90a1-f2606d891a23",
                        "glosses": [
                            "to yield, to succumb, to give in (to someone's) lies, to provocation, etc."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "1075810c-d82f-4767-aeea-6dcaba32de79",
                                "sense_id": "30cb49b3-d6e0-3f5a-94d7-c2c5dfb4a04a",
                                "text": "Не веди́сь на его́ провока́ции.",
                                "translation": "Don't give in to his provocations (i.e. \"Don't be fooled by his provocations\").",
                                "english": "Don't give in to his provocations (i.e. \"Don't be fooled by his provocations\")."
                            }
                        ]
                    }
                ],
