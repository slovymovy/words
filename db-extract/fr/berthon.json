                            {
                                "example_id": "7b631d38-e741-41ae-9bca-7c162e9c6749",
                                "sense_id": "935a60c8-67df-35d8-84a8-3e859118adf6",
                                "text": "Mickaël Berthon s’est habitué à dormir moins d’une heure par édition de l’interminable course."
