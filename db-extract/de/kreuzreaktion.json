                ],
                "senses": [
                    {
                        "sense_id": "755168a1-6f5a-3caf-8997-d8e69b556fec",
                        "entry_id": "c610fdb6-6607-3ac6-9233-3ef8d0d22c63",
                        "glosses": [
                            "Phänomen, bei der die Antikörper eines Menschen auch auf andere allergieauslösende Substanzen reagieren und so eine allergische Reaktion auslösen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ffe2e75-e112-4ac6-8c0e-5a25f4243e40",
                                "sense_id": "755168a1-6f5a-3caf-8997-d8e69b556fec",
                                "text": "„Die Kreuzreaktion ist ein stark ausgeprägtes und sehr bedeutsames Phänomen auf dem Gebiet der Nahrungsmittelallergie.“"
                            },
                            {
                                "example_id": "ed4c8c13-da6b-4c9a-85a7-1402b8e77b7e",
                                "sense_id": "755168a1-6f5a-3caf-8997-d8e69b556fec",
                                "text": "„Somit haben Sie als Pollenallergiker mit einer Kreuzreaktion beispielsweise auf Nüsse eine größere Sicherheit beim täglichen Einkauf .“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0cde6680-914c-3f12-9b71-e4dc02096e76",
                        "entry_id": "c610fdb6-6607-3ac6-9233-3ef8d0d22c63",
                        "glosses": [
                            "Bindung eines Antikörpern an unterschiedliche Antigene mit ähnlicher Bindungsstelle"
                        ],
                        "tags": [
                            "Immunologie"
                        ],
                        "examples": [
                            {
                                "example_id": "6b18e818-4f4c-42c3-95ac-d4322b34ef70",
                                "sense_id": "0cde6680-914c-3f12-9b71-e4dc02096e76",
                                "text": "„Ein großes Problem des Gastrinassays ist die Kreuzreaktion des Antikörpers mit Pankreozymin.“"
                            },
                            {
                                "example_id": "df99dbd4-4bb1-45e1-94cd-87bd8853f9b7",
                                "sense_id": "0cde6680-914c-3f12-9b71-e4dc02096e76",
                                "text": "„Dieser Antikörper geht mit antigenen Strukturen des Herzmuskels Bindungen im Sinne einer Kreuzreaktion ein (Kaplan).“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "e87b401e-29e2-3c62-9d92-546c1295c99d",
                        "entry_id": "c610fdb6-6607-3ac6-9233-3ef8d0d22c63",
                        "glosses": [
                            "Phänomen während der annähernd gleichzeitigen Entstehung zweier Mineralen"
                        ],
                        "tags": [
                            "Geowissenschaften",
                            "Mineralogie"
                        ],
                        "examples": [
                            {
                                "example_id": "e1e0ba17-d9fe-4a60-92c6-0a51f7d75b28",
                                "sense_id": "e87b401e-29e2-3c62-9d92-546c1295c99d",
                                "text": "„Sie [die Paragenese Talk + Disthen] verdrängt mit ansteigendem P,T die in jungen Sedimenten bis zu deren niedriggradiger Metamorphose (Griinschieferfacies) enthaltene Paragenese Chlorit + Quarz. Die zugehorige Kreuzreaktion ist in der Hilfsfigur von Abb. 145 ablesbar.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
