                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "afe08d07-d621-49ec-9ddb-1519c443e009",
                        "source_entry_id": "2e1fead6-d0d1-3a0b-bd75-08b5df0679bc",
                        "source_sense_id": "0ab21b32-7da5-3df6-a3af-e92f1f3b9f41",
                        "target_lang_word": "Kapstadt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kapstadt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4591c237-fcf0-38eb-a9f5-5c49d51f4be5",
                                        "entry_id": "b680804a-9388-30f3-8cc3-95cfc46a72da",
                                        "glosses": [
                                            "Großstadt in Südafrika; Hauptstadt der südafrikanischen Provinz Westkap"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c831abae-f72d-4bf7-9f89-24b87918f254",
                                                "sense_id": "4591c237-fcf0-38eb-a9f5-5c49d51f4be5",
                                                "text": "„Anschließend schaltet sie auf das System unseres Hauses in Kapstadt um.“"
                                            },
                                            {
                                                "example_id": "5229dd82-0a38-415f-b201-d311461a51fb",
                                                "sense_id": "4591c237-fcf0-38eb-a9f5-5c49d51f4be5",
                                                "text": "„›Der andere war ein Polizist in Kapstadt mit zerzaustem Haar.‹“"
                                            },
                                            {
                                                "example_id": "743da690-e40b-4ca3-8c19-5591e5f59e79",
                                                "sense_id": "4591c237-fcf0-38eb-a9f5-5c49d51f4be5",
                                                "text": "„Die NP in der Kapprovinz benötigte etwas mehr Zeit für den Aufbau einer dann allerdings stabileren Parteiorganisation, die in Kapstadt mit der Gründung eines parteinahen Pressekonzerns einherging, was der NP im Kap gemeinsam mit dem eher kollegialen, auf Konsens ausgerichteten Führungsstil des Provinzparteichefs Daniel Malan auf Dauer eine viel stärkere Kohäsion und Schlagkraft verschaffen sollte.“"
                                            },
                                            {
                                                "example_id": "452be87c-9f53-41d0-99b0-890d2c4318dc",
                                                "sense_id": "4591c237-fcf0-38eb-a9f5-5c49d51f4be5",
                                                "text": "„Das Speiselokal Pam Pam warb damit, ›Feinschmeckern in Paris, Nizza, Mailand, Kapstadt, Montreal, Tahiti und überall auf der Welt geläufig‹ zu sein.“"
                                            },
                                            {
                                                "example_id": "00487302-575b-44a7-aa89-316323a330ea",
                                                "sense_id": "4591c237-fcf0-38eb-a9f5-5c49d51f4be5",
                                                "text": "„Bezwingen konnten sie ihn nicht, seine Truppen waren ein starker Trumpf, zudem hatte er sich der Unterstützung des Hochkommissars für das südliche Afrika Sir Hercules Robinson in Kapstadt und des Kolonialministers Lord Derby in London versichert, weshalb er keinen Zollbreit nachgab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec0040b0-39c3-430d-b0f5-8801b73e4492",
                        "source_entry_id": "2e1fead6-d0d1-3a0b-bd75-08b5df0679bc",
