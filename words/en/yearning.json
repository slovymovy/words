    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4392b59f-8ca1-343f-acb4-0d77c12445d0",
                    "sense_definition": "A deep, intense, and often sad desire for something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "desire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt a deep <w>yearning</w> to return to her childhood home.",
                            "target_lang_translations": {
                                "de": "Sie spürte eine tiefe <w>Sehnsucht</w>, in ihr Elternhaus zurückzukehren."
                            }
                        },
                        {
                            "text": "He could not hide his <w>yearning</w> for a simpler life in the country.",
                            "target_lang_translations": {
                                "de": "Er konnte sein <w>Verlangen</w> nach einem einfacheren Leben auf dem Land nicht verbergen."
                            }
                        }
                    ],
                    "synonyms": [
                        "longing",
                        "craving",
                        "desire"
                    ],
                    "common_phrases": [
                        "deep yearning"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein tiefes, intensives und oft melancholisches Verlangen nach etwas."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Sehnsucht",
                                "target_lang_sense_clarification": "tiefes, oft wehmütiges Gefühl des Verlangens"
                            },
                            {
                                "target_lang_word": "Verlangen",
                                "target_lang_sense_clarification": "starker Wunsch oder Drang nach etwas"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "af3b8333-2b16-322d-a74e-bc0d68806aa1",
                    "sense_definition": "An enzyme used to curdle milk for cheese production.",
