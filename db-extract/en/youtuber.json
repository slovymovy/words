                        "glosses": [
                            "A video creator on YouTube."
                        ],
                        "tags": [
                            "Internet"
                        ],
                        "examples": [
                            {
                                "example_id": "d5c88303-8afb-449e-a1d8-4f5fdbf774d1",
                                "sense_id": "63bee397-cb77-36c5-ab2f-1a483fd95d04",
                                "text": "YouTuber and sister traditionalist Lacey Lynn commented on this video, extolling Faucheux and Collett because they had “red pilled me and I owe yall so much."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de187531-1e7f-4e37-9151-1f3b4ccec728",
                        "source_entry_id": "5f944ae6-6ee8-3e86-a86e-3833a63b1567",
                        "source_sense_description": "YouTube user",
                        "target_lang_word": "YouTubegebruiker",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "YouTubegebruiker",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6d1fe317-d6b5-3641-9edc-61f1a3f9da07",
                                        "entry_id": "d17e3553-8b20-37fe-acc3-51f0b7fa68a8",
                                        "glosses": [
                                            "iemand die video's maakt en deze uploadt naar YouTube"
                                        ],
                                        "tags": [
                                            "person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9074f45e-a51c-4c3c-b0b6-fa022b1052c2",
                                                "sense_id": "6d1fe317-d6b5-3641-9edc-61f1a3f9da07",
                                                "text": "YouTubegebruiker Dustmeoff12 stuurde vanaf een strandhuis aan het Californische Pismo Beach zijn nieuwe cameradrone de lucht in. Mooie beelden van wachtende surfers die op de perfecte golf wachten, worden abrupt spannend als een haai wel heel dichtbij zwemt. De drie meter lange haai komt dichter en dichter bij een nietsvermoedende surfer."
                                            },
                                            {
                                                "example_id": "5eb3cca9-e607-49d8-adde-31499369f1de",
                                                "sense_id": "6d1fe317-d6b5-3641-9edc-61f1a3f9da07",
                                                "text": "De overige 3 procent behoort wel tot het neusje van de zalm. Bartl keek bijvoorbeeld naar YouTubegebruikers met meer dan 7 miljoen abonnees. Zij kunnen meer dan € 256.000 opstrijken voor een video partnership."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93666a44-23b7-37da-a144-1d3e38477e9d",
                                        "entry_id": "d17e3553-8b20-37fe-acc3-51f0b7fa68a8",
                                        "glosses": [
                                            "iemand die video's op YouTube bekijkt"
                                        ],
                                        "tags": [
                                            "person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b2fbe78-247b-4886-910b-f3b668b8c81b",
                                                "sense_id": "93666a44-23b7-37da-a144-1d3e38477e9d",
                                                "text": "In een simpel decor bestaande uit onmisbare elementen in een kattenleven – kartonnen doos, kattenbak, gordijnen, bloemenvaas en de onvermijdelijke brokjes – imiteren ze heel precies het absurde gedrag dat miljoenen YouTubegebruikers wereldwijd steeds opnieuw vertedert."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dbd9ef86-7d30-45bb-b836-9e634f686f75",
                        "source_entry_id": "5f944ae6-6ee8-3e86-a86e-3833a63b1567",
