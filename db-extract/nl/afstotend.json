        "nl-extract.jsonl": [
            {
                "entry_id": "f1220c64-9f49-3ecd-a540-543b9dbd127d",
                "word": "afstotend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d811e7a8-f8d7-37c6-bc42-8705573f1f91",
                        "entry_id": "f1220c64-9f49-3ecd-a540-543b9dbd127d",
                        "glosses": [
                            "van iets dat men het liever op afstand houdt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5bcba81-83c0-4093-820d-b9386440eac4",
                                "sense_id": "d811e7a8-f8d7-37c6-bc42-8705573f1f91",
                                "text": "Van bovenaf lijkt het eerder een mens-afstotende olievlek, maar het zijn duizenden, misschien wel miljoenen ansjovissen. Een school die zich als eenheid voortbeweegt door de oceaan, manoeuvrerend om scheepswrakken, medevissen en ook mensen. HP de Tijd 14/07"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "51e64d5e-a995-4eb3-a0a8-dc52cd3cbc8a",
                        "source_entry_id": "f1220c64-9f49-3ecd-a540-543b9dbd127d",
                        "source_sense_id": "d811e7a8-f8d7-37c6-bc42-8705573f1f91",
                        "source_sense_description": "van iets dat men het liever op afstand houdt",
                        "target_lang_word": "abstoßend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abstoßend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "28ffe1e2-b590-30e2-b0a0-941f6ec1aa81",
                                        "entry_id": "449d31d6-37b7-3d36-bea9-d1d33b7eaac8",
                                        "glosses": [
                                            "Abscheu, Widerwillen oder Ekel erregend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ae2bd9d-f094-48ef-974e-e98626938948",
                                                "sense_id": "28ffe1e2-b590-30e2-b0a0-941f6ec1aa81",
                                                "text": "Warum finden wir vergammeltes Fleisch mit Maden, Kot und bestimmte Tiere wie Spinnen oder Kakerlaken abstoßend? Und wieso schüttelt es uns beim Gedanken an manche Speisen, die anderswo als Delikatesse gelten?"
                                            },
                                            {
                                                "example_id": "3b6e2d9b-9a57-4215-aba8-aa1fb2418f0d",
                                                "sense_id": "28ffe1e2-b590-30e2-b0a0-941f6ec1aa81",
                                                "text": "Dieser Geruch [von Schweiß] kann als abstoßend empfunden werden, gilt jedoch auch als potenziell erotisierend, da die Achselschweiß-Substanz Androstenon ein Abbauprodukt des Sexualhormons Testosteron ist."
                                            },
                                            {
                                                "example_id": "07bf031a-9775-470c-afb9-351703b5f567",
                                                "sense_id": "28ffe1e2-b590-30e2-b0a0-941f6ec1aa81",
                                                "text": "Das entstehende Gesamtbild [der indischen Megacity Delhi] ist gleichermaßen faszinierend wie abstoßend. Abstoßend, weil derart extreme gesellschaftliche Gegensätze für das europäische Empfinden nur noch schwer vorstellbar sind."
                                            },
                                            {
                                                "example_id": "417c4b58-3735-428b-834a-2293fa90d6ab",
                                                "sense_id": "28ffe1e2-b590-30e2-b0a0-941f6ec1aa81",
                                                "text": "Im Lebensmittelhandel findet man fast immer nur den Seeteufelschwanz, da der größere Vorderteil des Körpers nicht kulinarisch verwertet wird und traditionell als hässlich und abstoßend galt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f06d04b5-ecc5-313a-87ac-40b110b1e3f1",
                                        "entry_id": "449d31d6-37b7-3d36-bea9-d1d33b7eaac8",
                                        "glosses": [
                                            "für Flüssigkeiten undurchlässig, eine Kraft in entgegengesetzte Richtungen ausübend"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "464d10db-af86-4ece-ae52-22935f4ce24b",
                                                "sense_id": "f06d04b5-ecc5-313a-87ac-40b110b1e3f1",
                                                "text": "Lipophile Substanzen sind oft gleichzeitig hydrophob (wasserunlöslich), d. h. Wasser abstoßend."
                                            },
                                            {
                                                "example_id": "ec20e050-ca42-4d6c-86bc-28b05dd92e30",
                                                "sense_id": "f06d04b5-ecc5-313a-87ac-40b110b1e3f1",
                                                "text": "Repeller (von lateinisch repellere = zurückstoßen) bezeichnet in den Naturwissenschaften eine abstoßend gepolte Elektrode im Vakuum oder in Plasmen"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
