                        "form": "die Plakatwände"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a29d736b-f207-3c36-a7d3-aed388d1f125",
                        "entry_id": "895abac8-55ea-3614-ab38-569c8024fcbf",
                        "glosses": [
                            "Fläche (meist aus Holz und meist im Freien), die immer wieder neu mit Plakaten/Reklame/Parteienwerbung beklebt wird"
                        ],
                        "tags": [
                            "Werbung"
                        ],
                        "examples": [
                            {
                                "example_id": "53bc1375-63b6-4f7d-9396-af2446370502",
                                "sense_id": "a29d736b-f207-3c36-a7d3-aed388d1f125",
                                "text": "„Verbreitet riss der Sturm nicht ausreichend befestigte Plakatwände um und beschädigt Fahrzeuge.“"
                            },
                            {
                                "example_id": "ce69573f-6f5b-4478-8649-80ffcce7c1e3",
                                "sense_id": "a29d736b-f207-3c36-a7d3-aed388d1f125",
                                "text": "„Es dauert nicht lang, und Marilyn prangt im Bikini von allen Plakatwänden und wirbt für Bier.“"
                            },
                            {
                                "example_id": "0c55dedb-2164-46af-b26b-433fa42b400a",
                                "sense_id": "a29d736b-f207-3c36-a7d3-aed388d1f125",
                                "text": "„Auf fast jeder Plakatwand befindet sich ein QR-Code für Smartphones, der zu Videos führt.“"
                            },
                            {
                                "example_id": "cb49ac16-0c8c-475a-ac49-cbbf1ff07748",
                                "sense_id": "a29d736b-f207-3c36-a7d3-aed388d1f125",
                                "text": "„Schilder- und Lichtreklamehersteller […] entwerfen und fertigen Plakatwände und Litfasssäulen […].“"
                            },
                            {
                                "example_id": "962652f5-4172-4071-8e39-6f1c45944bfc",
                                "sense_id": "a29d736b-f207-3c36-a7d3-aed388d1f125",
                                "text": "„Der Film \"Die Frau in Rot\" erzählt die Geschichte des Büroangestellten Teddy, gespielt von Gene Wilder. Der verliebt sich in die hinreißende Charlotte, die ihn von einer Plakatwand anlächelt. […]“"
                            },
                            {
                                "example_id": "b90324e7-166a-4013-b257-436c7c7e1d0c",
                                "sense_id": "a29d736b-f207-3c36-a7d3-aed388d1f125",
                                "text": "„Auf dem ehemaligen Gelände der Weltausstellung in Lissabon von 1998 steht eine Plakatwand mit einer simplen Botschaft in englischer Sprache: \"Das hier ist nicht das neue Silicon Valley. Das hier ist Portugal\".“"
                            },
                            {
                                "example_id": "4037683b-b454-4728-9066-7d3ea9bb6f8d",
                                "sense_id": "a29d736b-f207-3c36-a7d3-aed388d1f125",
                                "text": "„Mein schlimmster Alptraum ist nicht selten der Blick auf die nächste Plakatwand.“"
                            },
                            {
                                "example_id": "283e8728-e3eb-4905-becc-6aab619810b1",
                                "sense_id": "a29d736b-f207-3c36-a7d3-aed388d1f125",
                                "text": "„Eine SVP-Nationalrätin lächelte in Baden bereits von ihrer Plakatwand […].“"
                            },
                            {
                                "example_id": "b4b70067-6dfd-4cfc-9b3b-f09a8a68d084",
                                "sense_id": "a29d736b-f207-3c36-a7d3-aed388d1f125",
                                "text": "„Für den 2. Oktober 2016 hat der Regierungschef ein Referendum zur Flüchtlingsfrage angesetzt; seit Wochen wird von Plakatwänden herab mobilisiert und Beobachter haben keinen Zweifel daran, dass es in Orbáns Sinne ausgehen wird.“"
                            },
                            {
                                "example_id": "f403506d-b32a-4d91-ae86-2d6fa238d0db",
                                "sense_id": "a29d736b-f207-3c36-a7d3-aed388d1f125",
                                "text": "„In der Corona-Zeit bleiben viele Kunstwerke und Gemälde unzugänglich. Die Stadt Würzburg zeigt deswegen im Stadtgebiet Abbildungen und Ausschnitte von Kunstwerken aus dem Museum für Franken und aus dem Martin-von-Wagner-Museum auf Plakatwänden.“"
                            },
                            {
                                "example_id": "31f0e197-f4a3-4746-9683-7ad9d1e1e2b9",
                                "sense_id": "a29d736b-f207-3c36-a7d3-aed388d1f125",
                                "text": "[Coronapandemie:] „In London tauchen seit dem Lockdown Plakate auf, die Freundlichkeit und Fürsorge verströmen. Dahinter stecken Betreiber von Plakatwänden. Ungenutzte Werbeflächen sollen Optimismus verbreiten.“"
                            },
                            {
                                "example_id": "e29f047f-3c8a-4cd8-b00e-8dfd5c45cbf1",
                                "sense_id": "a29d736b-f207-3c36-a7d3-aed388d1f125",
                                "text": "„Als \"Sichtagitation\" bezeichnete man die vielen Plakate und Transparente, die im Stil der heutigen Werbung Litfasssäulen und Plakatwände zierten und die Bürger der DDR zu guten Sozialisten machen sollten.“"
                            },
                            {
                                "example_id": "195a5b03-76a2-42fb-89d7-ad1821b54a8b",
                                "sense_id": "a29d736b-f207-3c36-a7d3-aed388d1f125",
                                "text": "„Wenn erst einmal die letzte aufreizende Unterwäsche-Reklame von den Plakatwänden verschwunden ist, wenn keine Bikini-Schönheit mehr großflächig von einer Hauswand lächeln darf, dann haben die Fanatiker gesiegt, von da an ist es anscheinend nur noch ein kleiner Schritt bis zur Herrschaft des Terrors.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "538a9c6b-103a-4c90-88ec-5293d8ee12ba",
                        "source_entry_id": "895abac8-55ea-3614-ab38-569c8024fcbf",
                        "source_sense_id": "a29d736b-f207-3c36-a7d3-aed388d1f125",
                        "target_lang_word": "billboard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "billboard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6afa6811-9c98-3f45-8d65-e4f41879f36b",
                                        "entry_id": "797c7e38-9259-336f-8dd4-901002ac6f58",
                                        "glosses": [
                                            "A very large outdoor sign, generally used for advertising."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62418480-e5cc-4212-9868-544663b389d9",
                                                "sense_id": "6afa6811-9c98-3f45-8d65-e4f41879f36b",
                                                "text": "He could see it like a printed sentence, fullborn and already dead God loves me too like the faded and weathered letters on last year's billboard God loves me too"
                                            },
                                            {
                                                "example_id": "e73cd494-98e8-4de6-9803-9f7bd53fbaa3",
                                                "sense_id": "6afa6811-9c98-3f45-8d65-e4f41879f36b",
                                                "text": "The land refuses to change. The more he drives the more the region resembles the country around Mt. Judge. The same scruff on the embankments, the same weathered billboards for the same products you wondered anybody would ever want to buy."
                                            },
                                            {
                                                "example_id": "a440bb5f-0cf1-4b48-82df-91f013438e3a",
                                                "sense_id": "6afa6811-9c98-3f45-8d65-e4f41879f36b",
                                                "text": "All America was on the verge of spring and the countryside was coming to glory, what we could see of the countryside through the smoke and billboards."
                                            },
                                            {
                                                "example_id": "22c9a890-7632-428e-bebd-42961d5ade16",
                                                "sense_id": "6afa6811-9c98-3f45-8d65-e4f41879f36b",
                                                "text": "Bleak factory buildings and billboard-cluttered avenues look as beautiful, through the camera’s eye, as churches and pastoral landscapes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50648352-75e5-346d-bd11-061a7e088919",
                                        "entry_id": "797c7e38-9259-336f-8dd4-901002ac6f58",
                                        "glosses": [
                                            "A flat surface, such as a panel or fence, on which bills are posted; a bulletin board."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cb0d088-65af-49f1-b1e2-57b010e49617",
                                                "sense_id": "50648352-75e5-346d-bd11-061a7e088919",
                                                "text": "When a show leaves New York, it carries posters wherewith to embellish each fence and bill board in the land [...]"
                                            },
                                            {
                                                "example_id": "755f8a8a-a282-47c3-91ff-88e082a6064a",
                                                "sense_id": "50648352-75e5-346d-bd11-061a7e088919",
                                                "text": "Toward the end of April, the billboards, which I watched anxiously in those days, bloomed out one morning with gleaming white posters on which two names were impressively printed in blue Gothic letters: the name of an actress of whom I had often heard, and the name “Camille.”"
                                            },
                                            {
                                                "example_id": "739ba317-4ac2-4b39-95a5-241bb6bcfe4d",
                                                "sense_id": "50648352-75e5-346d-bd11-061a7e088919",
                                                "text": "Until the recent rash of North London line maps appeared on station billboards in the London area of BR, the service undoubtedly suffered from meagre and ineffectual publicity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e6e27e0-ec8a-3587-b2ac-f48388260dab",
                                        "entry_id": "797c7e38-9259-336f-8dd4-901002ac6f58",
                                        "glosses": [
                                            "A piece of thick plank, armed with iron plates, and fixed on the bow or fore-channels of a vessel, for the bill or fluke of the anchor to rest on."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "797a6267-2f67-3959-9425-5dc9c25ce7dd",
                                        "entry_id": "797c7e38-9259-336f-8dd4-901002ac6f58",
                                        "glosses": [
                                            "An opening or closing portion of a program, often including credits and sponsors' names."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "639307e4-987d-411c-88c0-dc33133257a7",
                                                "sense_id": "797a6267-2f67-3959-9425-5dc9c25ce7dd",
                                                "text": "The closing billboard features Como as the spokesman."
                                            },
                                            {
                                                "example_id": "35c8bd9f-e4b9-4680-921c-b9c89e6128ec",
                                                "sense_id": "797a6267-2f67-3959-9425-5dc9c25ce7dd",
                                                "text": "[…] the opening billboard identifying Chase as the sponsor […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a583c680-99b2-3e38-9e64-aae86e8c32b1",
                                        "entry_id": "797c7e38-9259-336f-8dd4-901002ac6f58",
                                        "glosses": [
                                            "A sprite that always faces the screen, no matter which direction it is viewed from."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "billboard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53fcbf28-a94a-3de8-9227-50d1730cf35f",
                                        "entry_id": "cf643537-0915-33d1-9c6b-b34e0745a217",
                                        "glosses": [
                                            "To advertise on a billboard."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "367f37c8-4787-440c-a5ec-5c28602534a6",
                                                "sense_id": "53fcbf28-a94a-3de8-9227-50d1730cf35f",
                                                "text": "The upcoming concert was billboarded all over the city."
                                            }
                                        ]
