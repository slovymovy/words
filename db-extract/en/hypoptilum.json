                        "examples": [
                            {
                                "example_id": "fccf7a24-51fc-4098-815e-58d390666c1d",
                                "sense_id": "4ad8ad29-a881-3536-9cae-9738a03f2f66",
                                "text": "This secondary feather is known as the aftershaft or hypoptilum, and its presence or absence constitutes the most important structural difference in the feathers of existing birds."
                            },
                            {
                                "example_id": "a8fd686a-30d8-455f-9860-364606665d23",
                                "sense_id": "4ad8ad29-a881-3536-9cae-9738a03f2f66",
                                "text": "The feathers in some ratites are unusual as they are less reduced than is the norm in birds—each feather has, in addition to the main feather, a large “after-shaft” or hypoptilum."
                            }
                        ]
                    }
