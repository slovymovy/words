                                    {
                                        "sense_id": "677b07d2-e682-3eb0-9e3f-b3b23a999333",
                                        "entry_id": "e614ed76-14c9-31cb-910a-e2db6d77d00f",
                                        "glosses": [
                                            "A colourless organic compound, CH₃CHO, occurring widely in nature and being produced on a large scale in industry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62ceb6eb-ddb2-454d-a23a-8805c8d818d7",
                                                "sense_id": "677b07d2-e682-3eb0-9e3f-b3b23a999333",
                                                "text": "When you have a drink, your body turns the ethanol that’s present in the alcoholic beverage into a “really nasty substance” called acetaldehyde, which can damage your DNA, said Timothy Stockwell, an alcohol researcher at the University of Victoria in Canada."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "afca2e20-1be2-4e81-9604-5442023c0b5a",
                        "source_entry_id": "429c8031-9cc4-3d68-899c-5a666a3a4a73",
                        "source_sense_id": "bd398c8e-15d5-3eaa-afca-5ad53c777f4a",
                        "target_lang_word": "éthanal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éthanal",
