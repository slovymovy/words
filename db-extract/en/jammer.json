                ],
                "senses": [
                    {
                        "sense_id": "b7d70aae-ccb1-3ef9-a226-7f1957ad6b26",
                        "entry_id": "6b68bf70-1a47-354e-8771-cdf484e0049f",
                        "glosses": [
                            "Any device used to jam radio reception."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "385613fb-bea1-4ed5-8a6f-32e7ab13a34d",
                                "sense_id": "b7d70aae-ccb1-3ef9-a226-7f1957ad6b26",
                                "text": "\"But the Civil Aviation Authority is very worried about 'flyaway' - if someone has bought a GPS jammer on eBay because they don't want drones near their house, it can cause drones to get completely lost and shoot off in a random direction until they run out of battery."
                            }
                        ]
                    },
                    {
                        "sense_id": "fb54887c-4ae1-3ab7-8d42-702aabc16727",
                        "entry_id": "6b68bf70-1a47-354e-8771-cdf484e0049f",
                        "glosses": [
                            "A musician who jams."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fbce2b97-510e-3390-bd39-f6da0768f801",
                        "entry_id": "6b68bf70-1a47-354e-8771-cdf484e0049f",
                        "glosses": [
                            "A device (e.g. a jumar) which will slide along a rope in one direction but not the other, used in rock-climbing, caving etc."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
