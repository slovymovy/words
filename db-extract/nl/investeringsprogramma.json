                        "examples": [
                            {
                                "example_id": "aa09bfe6-fc50-4eaf-a37a-b88f3286db87",
                                "sense_id": "83f41120-c6cf-3411-ba92-34fafdd16f66",
                                "text": "Hollande kondigde een groot investeringsprogramma aan. De komende tien jaar worden er miljarden gepompt in de energiesector, de gezondheidszorg, de infrastructuur en in moderne technologieën. Premier Ayrault komt over enkele weken met meer details over dat plan."
                            },
                            {
                                "example_id": "35289b58-07df-4953-9017-f8893e8bcb67",
                                "sense_id": "83f41120-c6cf-3411-ba92-34fafdd16f66",
                                "text": "De 'verketeling' van Holendrecht is onderdeel van een grootschalig investeringsprogramma in de woningen in deze Amsterdamse woonwijk: met veel problemen als werkloosheid, lage inkomens en huiselijk geweld."
                            }
