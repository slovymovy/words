                "senses": [
                    {
                        "sense_id": "5ea6f356-7cd2-3a98-8690-38c13944762b",
                        "entry_id": "821fedac-f123-3b55-b678-7f9e928879d2",
                        "glosses": [
                            "Theologe, der sich in wissenschaftlicher Weise mit dem Verstehen, Gestalten und Analysieren liturgischer Abläufe beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cf23cc7-c0f8-4600-ae99-e03782575ebd",
                                "sense_id": "5ea6f356-7cd2-3a98-8690-38c13944762b",
                                "text": "„Seit der Zeit des Zweiten Vatikanischen Konzils sind Liturgiewissenschaftler mit der Erstellung gemeinsamer ökumenischer liturgischer Texte befasst.“"
                            },
                            {
                                "example_id": "73609118-19a2-48e7-b0b8-8699e5f215e0",
                                "sense_id": "5ea6f356-7cd2-3a98-8690-38c13944762b",
                                "text": "„Veränderungen des Ritus der sonntäglichen Messfeier, wie sie in der konkreten Praxis vorkommen und auch von Liturgiewissenschaftlern als Normabweichungen wahrgenommen werden, wurden zuweilen als sog. ‚Liturgie-Missbrauch‘ gedeutet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
