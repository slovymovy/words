                ],
                "translations": [
                    {
                        "translation_id": "4047a038-13cd-420a-8d34-8ecc0764930f",
                        "source_entry_id": "7cb46ab4-20c1-3c08-8d1d-0ff5eb38e0d2",
                        "source_sense_id": "e8c2d03a-41e8-363a-899f-5cc3812d49b3",
                        "target_lang_word": "Herrscherin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Herrscherin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a38cd4ed-e5c4-3596-9ca4-acfae6b01f43",
                                        "entry_id": "200f2104-a0ec-3561-86b5-0d256b6577bd",
                                        "glosses": [
                                            "das weibliche Oberhaupt eines Stammes, Volkes, Reiches oder Landes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db20d361-7574-47c7-a7a0-42da6aff958c",
                                                "sense_id": "a38cd4ed-e5c4-3596-9ca4-acfae6b01f43",
                                                "text": "Katharina die Große war eine starke Herrscherin."
                                            },
                                            {
                                                "example_id": "de05b666-1756-434a-80f5-da2138c60bc8",
                                                "sense_id": "a38cd4ed-e5c4-3596-9ca4-acfae6b01f43",
                                                "text": "„Die neue Herrscherin will ihre Landsleute wohl erst an die Vorstellung gewöhnen, eine Frau auf dem Thron zu sehen.“"
                                            },
                                            {
                                                "example_id": "b751c98e-6b73-4caa-90f3-f36aee8ad5c6",
                                                "sense_id": "a38cd4ed-e5c4-3596-9ca4-acfae6b01f43",
                                                "text": "„Die genaue Aufgabenverteilung zwischen der obersten Herrscherin und ihrem Ras bleibt diffus, eine Tatsache, die Tafari für sich zu nutzen weiß.“"
                                            },
                                            {
                                                "example_id": "d5f8dc1b-39dd-431c-8e63-ba8b08304d59",
                                                "sense_id": "a38cd4ed-e5c4-3596-9ca4-acfae6b01f43",
                                                "text": "„Er besang eine Frau, die Herrscherin über sein Herz, die ihn allmählich umbringe mit ihrer Koketterie.“"
                                            },
                                            {
                                                "example_id": "7d829565-bb47-4eb6-b123-632fd1806054",
                                                "sense_id": "a38cd4ed-e5c4-3596-9ca4-acfae6b01f43",
                                                "text": "„Die jetzige Herrscherin habe ihm die Abreise befohlen und ihm dabei hunderttausend Rubel geschenkt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
