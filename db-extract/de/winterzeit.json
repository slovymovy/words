                        "translation_id": "d5dac55e-6896-46bd-8f36-c012f5b8f6d6",
                        "source_entry_id": "e94e1a32-8b90-3a94-9ee6-e7c15c9a31c1",
                        "source_sense_id": "af4e92e5-e66f-3b85-9731-9bac384dd78f",
                        "source_sense_description": "Zeit, in der Winter ist",
                        "target_lang_word": "wintertide",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wintertide",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7eeaee10-5ad2-34c0-8361-eafe6c2d8ee2",
                                        "entry_id": "6a5e084f-64fc-315d-8f99-9f1e0a1239f7",
                                        "glosses": [
                                            "wintertime"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6ceb693-5c82-4eba-850e-acb05f7458b1",
                                                "sense_id": "7eeaee10-5ad2-34c0-8361-eafe6c2d8ee2",
                                                "text": "Shut out the flower-time, / Sunbeam and shower-time; / Make way for our time, / The winter-tide."
                                            },
                                            {
                                                "example_id": "b1147002-b72f-4e8b-918c-3d2b60b5ca39",
                                                "sense_id": "7eeaee10-5ad2-34c0-8361-eafe6c2d8ee2",
                                                "text": "O winter tide, O winter tide, / Thy coming brings us sadness; / Afar are those we hold most dear, / Here men are strange, and skies are drear; […]"
                                            },
                                            {
                                                "example_id": "4c8d3787-0d34-47bd-bd64-1b8e451c73a5",
                                                "sense_id": "7eeaee10-5ad2-34c0-8361-eafe6c2d8ee2",
                                                "text": "Thaw follows frost; hard on the heel of spring / Treads summer sure to die, for hard on hers / Comes autumn with his apples scattering; / Then back to wintertide, when nothing stirs."
                                            },
                                            {
                                                "example_id": "0f5229b4-125a-4b01-ae87-0705254a6666",
                                                "sense_id": "7eeaee10-5ad2-34c0-8361-eafe6c2d8ee2",
                                                "text": "[…] Figure Skating was actually the very first winter sport included at the summer Olympic games in London 1908. Its wintertide equivalence was eventually introduced in 1924."
                                            },
                                            {
                                                "example_id": "575d1cb2-5713-46dd-8c53-d9e4fa021728",
                                                "sense_id": "7eeaee10-5ad2-34c0-8361-eafe6c2d8ee2",
                                                "text": "So, grab yourself a spot of tea or a boozy hot chocolate, and celebrate the beginning of winter with these wintertide-inspired quotes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0b7dba3-9d4f-45d2-af70-90c627d063da",
                        "source_entry_id": "e94e1a32-8b90-3a94-9ee6-e7c15c9a31c1",
