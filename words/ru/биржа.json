            "senses": [
                {
                    "sense_id": "64e37a0f-a915-370f-a93d-c41fbf3b36d2",
                    "sense_definition": "Учреждение, в котором осуществляются регулярные торги ценными бумагами, валютой или товарами.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой брат работает брокером на фондовой <w>бирже</w>.",
                            "target_lang_translations": {
                                "en": "My brother works as a broker on the stock <w>exchange</w>.",
                                "pl": "Mój brat pracuje jako makler na <w>giełdzie</w> papierów wartościowych."
                            }
                        },
                        {
                            "text": "Новости о падении цен на <w>бирже</w> встревожили инвесторов.",
                            "target_lang_translations": {
                                "en": "News about falling prices on the <w>exchange</w> alarmed investors.",
                                "pl": "Wiadomości o spadku cen na <w>giełdzie</w> zaniepokoiły inwestorów."
                            }
                        }
                    ],
                    "synonyms": [
                        "торговая площадка"
                    ],
                    "common_phrases": [
                        "фондовая биржа",
                        "валютная биржа",
                        "играть на бирже",
                        "товарная биржа"
                    ],
                    "target_lang_definitions": {
                        "en": "An institution where regular trading of securities, currency, or goods takes place.",
                        "pl": "Instytucja, w której odbywa się regularny handel papierami wartościowymi, walutami lub towarami."
                    },
                    "translations": {
