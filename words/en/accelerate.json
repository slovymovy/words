{
    "word_family": [
        "acceleration",
        "accelerator",
        "accelerant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8fc3c263-541f-3c3f-b9b2-7871fb6d4f6e",
                    "sense_definition": "To become faster; to begin to move more quickly.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "motion_speed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car began to <w>accelerate</w> as soon as the light turned green.",
                            "target_lang_translations": {
                                "ru": "Машина начала <w>ускоряться</w>, как только загорелся зеленый свет.",
                                "zh": "绿灯一亮，汽车就开始<w>加速</w>了。"
                            }
                        },
                        {
                            "text": "You need to <w>accelerate</w> smoothly to merge onto the highway.",
                            "target_lang_translations": {
                                "ru": "Вам нужно плавно <w>разогнаться</w>, чтобы выехать на шоссе.",
                                "zh": "你需要平稳地<w>提速</w>才能汇入高速公路。"
                            }
                        }
                    ],
                    "synonyms": [
                        "speed up"
                    ],
                    "antonyms": [
                        "decelerate"
                    ],
                    "common_phrases": [
                        "accelerate rapidly",
                        "accelerate smoothly",
                        "begin to accelerate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Начинать двигаться быстрее; набирать скорость.",
                        "zh": "指物体或人开始移动得更快，或速度增加。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ускоряться",
                                "target_lang_sense_clarification": "становиться быстрее"
                            },
                            {
                                "target_lang_word": "разгоняться",
                                "target_lang_sense_clarification": "о транспорте или бегущем человеке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "加速",
                                "target_lang_sense_clarification": "指速度变快"
                            },
                            {
                                "target_lang_word": "提速",
                                "target_lang_sense_clarification": "指提高速度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26d195f1-a573-3866-85a8-ae2b691a5f57",
                    "sense_definition": "To cause to move faster; to quicken the motion of.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "motion_speed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The driver pressed the pedal to <w>accelerate</w> the vehicle.",
                            "target_lang_translations": {
                                "ru": "Водитель нажал на педаль, чтобы <w>ускорить</w> автомобиль.",
                                "zh": "司机踩下踏板以<w>加速</w>车辆。"
                            }
                        },
                        {
                            "text": "Gravity will <w>accelerate</w> the object as it falls toward the ground.",
                            "target_lang_translations": {
                                "ru": "Гравитация будет <w>ускорять</w> объект по мере его падения на землю.",
                                "zh": "物体在落向地面时，重力会使其<w>加速</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "speed up",
                        "quicken"
                    ],
                    "antonyms": [
                        "decelerate",
                        "retard"
                    ],
                    "common_phrases": [
                        "accelerate the car",
                        "accelerate the engine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять двигаться быстрее; увеличивать скорость движения.",
                        "zh": "使某物移动得更快；增加某物的运动速度。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ускорять",
                                "target_lang_sense_clarification": "увеличивать скорость"
                            },
                            {
                                "target_lang_word": "разгонять",
                                "target_lang_sense_clarification": "транспортное средство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "加速",
                                "target_lang_sense_clarification": "使速度增加"
                            },
                            {
                                "target_lang_word": "催动",
                                "target_lang_sense_clarification": "促使移动加快"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56b84e66-4db2-312f-b077-2d82d780b506",
                    "sense_definition": "To quicken the natural or ordinary progression or process of something.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "process_speed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company plans to <w>accelerate</w> its growth with new marketing strategies.",
                            "target_lang_translations": {
                                "ru": "Компания планирует <w>ускорить</w> свой рост с помощью новых маркетинговых стратегий.",
                                "zh": "公司计划通过新的营销策略来<w>加快</w>增长。"
                            }
                        },
                        {
                            "text": "We must <w>accelerate</w> the process to finish the project on time.",
                            "target_lang_translations": {
                                "ru": "Мы должны <w>ускорить</w> процесс, чтобы закончить проект вовремя.",
                                "zh": "我们必须<w>加快</w>进度，以便按时完成项目。"
                            }
                        }
                    ],
                    "synonyms": [
                        "expedite",
                        "hasten",
                        "speed up",
                        "further",
                        "advance"
                    ],
                    "antonyms": [
                        "retard"
                    ],
                    "common_phrases": [
                        "accelerate growth",
                        "accelerate the process",
                        "accelerate development",
                        "accelerate change"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ускорять естественный ход или процесс развития чего-либо.",
                        "zh": "使某事物的自然进程或发展过程变得更快。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ускорять",
                                "target_lang_sense_clarification": "процесс, рост, развитие"
                            },
                            {
                                "target_lang_word": "форсировать",
                                "target_lang_sense_clarification": "наращивать темп"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "加快",
                                "target_lang_sense_clarification": "使进程变快"
                            },
                            {
                                "target_lang_word": "促进",
                                "target_lang_sense_clarification": "推动发展"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ccda554b-e672-36a9-87d0-9187ecaa6467",
                    "sense_definition": "To hasten the occurrence of a specific event.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "process_speed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>accelerate</w> their departure to avoid the storm.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>ускорить</w> свой отъезд, чтобы избежать шторма.",
                                "zh": "他们决定<w>提前</w>出发以避开风暴。"
                            }
                        },
                        {
                            "text": "Unexpected news helped <w>accelerate</w> the decision to sell the house.",
                            "target_lang_translations": {
                                "ru": "Неожиданные новости помогли <w>ускорить</w> принятие решения о продаже дома.",
                                "zh": "突如其来的消息促使他们<w>加快</w>了卖房的决定。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hasten",
                        "advance",
                        "forward"
                    ],
                    "common_phrases": [
                        "accelerate departure",
                        "accelerate a decision"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приближать наступление определенного события.",
                        "zh": "使某特定事件提前发生。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ускорять",
                                "target_lang_sense_clarification": "приближать срок"
                            },
                            {
                                "target_lang_word": "приближать",
                                "target_lang_sense_clarification": "дату или событие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "提前",
                                "target_lang_sense_clarification": "使时间靠前"
                            },
                            {
                                "target_lang_word": "催促",
                                "target_lang_sense_clarification": "促使某事尽快发生"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9655edf5-3883-3ad6-b58c-433f800b1b9d",
                    "sense_definition": "To cause a change of velocity.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A constant force is required to <w>accelerate</w> a mass in a vacuum.",
                            "target_lang_translations": {
                                "ru": "Постоянная сила требуется, чтобы <w>ускорить</w> массу в вакууме.",
                                "zh": "在真空中，需要恒定的力才能使物体<w>加速</w>。"
                            }
                        },
                        {
                            "text": "The particles <w>accelerate</w> to high speeds within the collider.",
                            "target_lang_translations": {
                                "ru": "Частицы <w>ускоряются</w> до высоких скоростей внутри коллайдера.",
                                "zh": "粒子在对撞机内<w>加速</w>到极高的速度。"
                            }
                        }
                    ],
                    "antonyms": [
                        "decelerate"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывать изменение скорости тела (физический термин).",
                        "zh": "引起速度的变化（物理学术语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ускорять",
                                "target_lang_sense_clarification": "сообщать ускорение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "加速",
                                "target_lang_sense_clarification": "物理学中产生加速度"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e4a2a218-89e8-3e38-a420-eb42ca0482fe",
                    "sense_definition": "Accelerated; quickened; hastened; hurried.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher spoke of motion as either natural or <w>accelerate</w>.",
                            "target_lang_translations": {
                                "ru": "Философ говорил о движении как о естественном или <w>ускоренном</w>.",
                                "zh": "那位哲学家谈到运动时，将其分为自然运动或<w>加速</w>运动。"
                            }
                        },
                        {
                            "text": "In that ancient text, the <w>accelerate</w> pace of events led to chaos.",
                            "target_lang_translations": {
                                "ru": "В этом древнем тексте <w>ускоренный</w> темп событий привел к хаосу.",
                                "zh": "在那篇古文中，事件<w>加速</w>的节奏导致了混乱。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "modern English uses 'accelerated'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ускоренный; быстрый (устаревшая форма).",
                        "zh": "已加速的；快速的（古语用法）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ускоренный",
                                "target_lang_sense_clarification": "прилагательное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "加速的",
                                "target_lang_sense_clarification": "形容词形式"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}