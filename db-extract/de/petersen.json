                ],
                "senses": [
                    {
                        "sense_id": "61c3abc9-d4e2-39c7-8f7f-163dfb412249",
                        "entry_id": "acfdf20f-527e-3db0-a7cd-e9eb59fed9d9",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9ceb3bd-4e24-4c2c-a9f2-0be23fa5fe48",
                                "sense_id": "61c3abc9-d4e2-39c7-8f7f-163dfb412249",
                                "text": "Frau Petersen ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "79387387-e512-4668-858b-e8a6e420e6fa",
                                "sense_id": "61c3abc9-d4e2-39c7-8f7f-163dfb412249",
                                "text": "Herr Petersen wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "00ab736f-3d41-4be6-81fd-0c9cff8b31f1",
                                "sense_id": "61c3abc9-d4e2-39c7-8f7f-163dfb412249",
                                "text": "Die Petersen fliegen heute nach Paris."
                            },
                            {
                                "example_id": "ebc52569-109c-43ce-8e41-b6dbbeb685dc",
                                "sense_id": "61c3abc9-d4e2-39c7-8f7f-163dfb412249",
                                "text": "Der Petersen trägt nie die Pullover, die die Petersen ihm strickt."
                            },
                            {
                                "example_id": "624fd881-1cd6-484b-bebc-2769d22eb937",
                                "sense_id": "61c3abc9-d4e2-39c7-8f7f-163dfb412249",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Petersen kommt, geht der Herr Petersen.“"
                            },
                            {
                                "example_id": "c4b06385-ec9f-4f0c-b4fb-074a005f3fb4",
                                "sense_id": "61c3abc9-d4e2-39c7-8f7f-163dfb412249",
                                "text": "Petersen kommt und geht."
                            },
                            {
                                "example_id": "8b82a156-677a-4b6b-8c9d-26a35a83c1bd",
                                "sense_id": "61c3abc9-d4e2-39c7-8f7f-163dfb412249",
                                "text": "Petersens kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
