                    "frequency": "Low",
                    "semantic_group_id": "physical_sinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Water collected in the <w>sag</w> of the driveway after the heavy rain.",
                            "target_lang_translations": {
