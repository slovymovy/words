                            {
                                "example_id": "35b9c501-93b2-4d1b-89db-de1c6778d630",
                                "sense_id": "8378ca4b-97ba-3bce-bbb2-7df92217b39f",
                                "text": "Das Einsatzgebiet der Marine zieht sich vom Roten Meer bis zum Indischen Ozean."
                            },
