                                "sense_id": "98a2d17c-8654-3ae2-a345-11ab4938e226",
                                "text": "Act II, Scene I\nForsooth, a blind man at Saint Alban's shrine\nWithin this half hour hath receiv'd his sight"
                            }
                        ]
                    },
                    {
                        "sense_id": "47d83c32-454d-3700-beda-fe3dd200eb00",
                        "entry_id": "4ca8f7b0-7d97-3f6e-a2b9-b6348919aee9",
                        "glosses": [
                            "Saint Alban, a Christian martyr executed in Verulamium (St Albans) in the 3rd or 4th century."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2a51df2-ab9f-470e-8c39-e2755a7036d3",
                                "sense_id": "47d83c32-454d-3700-beda-fe3dd200eb00",
                                "text": "The first Christian martyr in Britain was called Alban."
                            }
                        ]
                    }
                ],
