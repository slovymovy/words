                                    {
                                        "sense_id": "cacaff3c-281f-34ec-9816-fe6013a4e441",
                                        "entry_id": "6fc5f23f-c932-34d2-b81f-410fe2702454",
                                        "glosses": [
                                            "öffentlicher und lautstark geäußerter Appell, der den Beginn einer Schlacht verkündet oder während einer Schlacht zur Anfeuerung der eigenen Soldaten dient"
                                        ],
                                        "tags": [
                                            "historical",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfc21fef-39cf-4890-b13b-6022da7f6503",
                                                "sense_id": "cacaff3c-281f-34ec-9816-fe6013a4e441",
                                                "text": "Die Germanen hatten einen unheimlich klingenden, anschwellenden Schlachtruf."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aaec12c6-f75a-3d4a-801d-580ba0a5ad43",
                                        "entry_id": "6fc5f23f-c932-34d2-b81f-410fe2702454",
                                        "glosses": [
                                            "Losung/Motto einer Personengruppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d278567d-cbb6-4378-ad75-0d4b8ca32e11",
                                                "sense_id": "aaec12c6-f75a-3d4a-801d-580ba0a5ad43",
                                                "text": "„Und so ein neuer Schlachtruf entsteht wirklich mitten im Stadion? Gibt es keine wöchentlichen Sitzungen des Fanclubs, in denen überlegt wird, welche Popsongs zu Schlachtrufen umfunktioniert werden?“"
                                            },
                                            {
                                                "example_id": "121d2128-903d-432a-9cbd-edbcbee9ed28",
                                                "sense_id": "aaec12c6-f75a-3d4a-801d-580ba0a5ad43",
                                                "text": "„Innerhalb kürzester Zeit wurde eine Partei gegründet, deren Namen in Anlehnung an den Schlachtruf der Stadionbesucher entstand: aus \"Forza Milan\" wurde \"Forza Italia\".“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
