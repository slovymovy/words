                "senses": [
                    {
                        "sense_id": "bdc06041-bc73-376b-95c8-9537c9a247e1",
                        "entry_id": "9a09a2fd-10f8-338c-93b2-4f5fe240c19b",
                        "glosses": [
                            "Having white sidewalls (of a tyre/tire)"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "c874ee13-c9cd-444e-b0f5-d6c14bbba991",
                                "sense_id": "bdc06041-bc73-376b-95c8-9537c9a247e1",
                                "text": "Jake had just installed a radar detector and four new whitewall tires."
                            },
                            {
                                "example_id": "c0ab792e-4b0d-4be9-8426-e6160894ffa5",
                                "sense_id": "bdc06041-bc73-376b-95c8-9537c9a247e1",
                                "text": "The UniRoyal Tiger Pay Touring whitewall tire is not a performance tire, but it is totally acceptable for street use."
                            },
                            {
                                "example_id": "bea5fd5e-0827-4a59-9c33-b20bab692168",
                                "sense_id": "bdc06041-bc73-376b-95c8-9537c9a247e1",
                                "text": "I was shocked the other day when I Walmart that I could not find a whitewall tire for sale."
                            }
                        ]
                    },
                    {
                        "sense_id": "0e014e6b-ad24-359e-9610-da97486089fa",
                        "entry_id": "9a09a2fd-10f8-338c-93b2-4f5fe240c19b",
                        "glosses": [
                            "Describing a hair cut with a closely cropped back and sides and the hair on the top of the head left longer."
                        ],
                        "tags": [
                            "US",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "2dc43728-46d2-4137-bb83-a4caa0235930",
                                "sense_id": "0e014e6b-ad24-359e-9610-da97486089fa",
                                "text": "A weird elongated creature with a whitewall haircut who had the big head as well as hands and fat thighs of the acromegalic, he was an uninhibited cross-dresser suffering from Gender Identity Disorder who constantly appeared in frocks."
                            },
                            {
                                "example_id": "db44cddf-3dc4-490e-b19c-569960644834",
                                "sense_id": "0e014e6b-ad24-359e-9610-da97486089fa",
                                "text": "A blond kid with a whitewall haircut and long, thin sideburns came over to stand beside the kid with the wimpy Roman do."
                            },
                            {
                                "example_id": "6fb29a9a-4a5c-42b1-8fde-0c0b2283487b",
                                "sense_id": "0e014e6b-ad24-359e-9610-da97486089fa",
                                "text": "With a whitewall crew cut, high and tight."
                            }
                        ]
                    }
                ],
