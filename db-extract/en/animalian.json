                "senses": [
                    {
                        "sense_id": "3ca20f92-0686-3aa8-a650-32fdb6eab37a",
                        "entry_id": "9eb5fb4c-0640-3a66-b0ba-de31bc9814ec",
                        "glosses": [
                            "Of the kingdom Animalia, which includes humans."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b279d4f-4371-4b94-99ac-73baaeb45695",
                                "sense_id": "3ca20f92-0686-3aa8-a650-32fdb6eab37a",
                                "text": "To give an instance from the animalian side of Linnaeus's efforts, he may have classified the swift (Hirundo apus) and the swallow (Hirundo rustica) together because of general similarity … ."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9f03700-f057-3026-a8ce-a15841e50a87",
                        "entry_id": "9eb5fb4c-0640-3a66-b0ba-de31bc9814ec",
                        "glosses": [
                            "Of an animal or animals, usually including humans but sometimes connoting nonhuman nature."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "c8bf0f78-7c31-4324-bfaa-faf6604a1ee1",
                                "sense_id": "f9f03700-f057-3026-a8ce-a15841e50a87",
                                "text": "We stood before the Lord in the high-backed chair, and I saw that the wood figures of his regal throne were, of course, animalian, feline and diabolical."
                            }
                        ]
                    },
                    {
                        "sense_id": "da377389-0473-38bf-987b-056d945e4ed2",
                        "entry_id": "9eb5fb4c-0640-3a66-b0ba-de31bc9814ec",
                        "glosses": [
                            "Like that of an animal or animals, usually including humans but sometimes connoting nonhuman nature."
                        ],
                        "tags": [
                            "broadly",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "93ddc48e-73f9-4a2c-816f-f45dac0b4d96",
                                "sense_id": "da377389-0473-38bf-987b-056d945e4ed2",
                                "text": "He did not look at her because he did not wish to see that deliciously animalian slit of her mouth, naked and red, beneath the white mask that made her eyes look so feline."
                            },
                            {
                                "example_id": "fbaaddfb-026b-473c-85b7-d4e632e050f7",
                                "sense_id": "da377389-0473-38bf-987b-056d945e4ed2",
                                "text": "His big hands clutched him about the collar of the suit that had once been fine, and he was shaking him with animalian violence, shoving him[…]."
                            }
                        ]
                    }
                ],
