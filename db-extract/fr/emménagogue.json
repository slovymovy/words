                        "form_id": "c2b1a4e0-c362-4b9e-8ad3-06fdccbd6274",
                        "entry_id": "26d5a5ba-82ec-39d3-b52d-3b138d325ccf",
                        "tags": [
                            "plural"
                        ],
                        "form": "emménagogues"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1eba56c4-fb82-3012-a0a5-8c591a238164",
                        "entry_id": "26d5a5ba-82ec-39d3-b52d-3b138d325ccf",
                        "glosses": [
                            "Décoction de plantes qui provoque ou facilite le flux menstruel."
                        ],
                        "tags": [
                            "Gynécologie"
                        ],
                        "examples": [
                            {
                                "example_id": "1cd7fb4c-1d19-452e-bbfd-cdf2ca19255f",
                                "sense_id": "1eba56c4-fb82-3012-a0a5-8c591a238164",
                                "text": "La pratique meurtrière de quelques charlatans, qui cherchent par l'usage des emménagogues à rappeler les règles."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b4cb5ebd-0330-4f07-b969-94bb2b6d83ae",
                        "source_entry_id": "26d5a5ba-82ec-39d3-b52d-3b138d325ccf",
                        "source_sense_id": "1eba56c4-fb82-3012-a0a5-8c591a238164",
                        "target_lang_word": "emmenagogue",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emmenagogue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b75bdd82-6e09-3d7a-8a39-4ed46f7e8a27",
                                        "entry_id": "52c4315f-2906-3bc7-970f-3f1dc8d4be0f",
                                        "glosses": [
                                            "An herb that stimulates blood flow in the pelvic area and uterus, causing menstruation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad7c4725-74f6-4b5c-bf4a-a8542739387e",
                                                "sense_id": "b75bdd82-6e09-3d7a-8a39-4ed46f7e8a27",
                                                "text": "Take of the emmenagogue decoction, six ounces; borax, fifteen grains; troches of myrrh, two scruples; dittany of Crete, finely powdered, ten grains; […]"
                                            },
                                            {
                                                "example_id": "5289308d-d44f-48e5-99e6-35b5cc98b8c0",
                                                "sense_id": "b75bdd82-6e09-3d7a-8a39-4ed46f7e8a27",
                                                "text": "The term emmenagogue is applied to any remedy or indeed any resource whatever which normalizes the menses."
                                            },
                                            {
                                                "example_id": "469003dd-3e7b-4978-82d3-3db27ae6f8d5",
                                                "sense_id": "b75bdd82-6e09-3d7a-8a39-4ed46f7e8a27",
                                                "text": "Because of its phenolic ether content (methyl chavicol), which varies within wide limits, depending on the species, the origin and the time of harvesting, basil is often cited as an emmenagogue."
                                            },
                                            {
                                                "example_id": "8240152b-7606-4501-8a6c-88ca152d67f9",
                                                "sense_id": "b75bdd82-6e09-3d7a-8a39-4ed46f7e8a27",
                                                "text": "DES does not propose an etymology for this word [bunnanaru, 'yellow germander'], but merely notes its similarity to the toponym Bunnánaru. Paulis suggests that this similarity may be due to chance or folk etymology, which is plausible. He proposes an etymology *kunn-án-aru, from Lat. cunnus 'vagina' because of this plant's apparent emmenagogue properties."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
