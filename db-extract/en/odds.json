                                        "entry_id": "ce8633b1-9960-30e0-8d26-e8b55b35993b",
                                        "glosses": [
                                            "Pluriel de chance."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc1c9cf3-c489-4ab6-a29a-21b0259428f7",
                                                "sense_id": "41e335e5-4848-3bb6-a7e3-5d825cb428e3",
                                                "text": "Il y a des chances pour que la gare soit située quelque part le long de la grand’route par laquelle je suis venu; il ne me faut pas longtemps pour réaliser que j’ai vu juste du premier temps."
                                            }
                                        ]
                                    }
                                ]
