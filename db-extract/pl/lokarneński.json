                        "target_lang_word": "locarnien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "locarnien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "12630c49-b2b3-32ed-a080-8578c89e49cf",
                                        "entry_id": "da413ec4-dbf6-38ea-9f7e-1639724001b8",
                                        "glosses": [
                                            "Relatif aux accords de Locarno ; relatif à la S.D.N.."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dae7dfdd-9907-451b-8f42-e45f9ba466da",
                                                "sense_id": "12630c49-b2b3-32ed-a080-8578c89e49cf",
                                                "text": "C'était évidemment une satisfaction de pure forme donnée par Londres aux exigences irritées de la France. Il fallait bien que les puissances locarniennes parussent tomber d'accord."
                                            },
                                            {
                                                "example_id": "eb2e327b-3afa-481e-b78b-3ed0852d5542",
                                                "sense_id": "12630c49-b2b3-32ed-a080-8578c89e49cf",
                                                "text": "Toutes les parties idéologiques des traités locarniens sont tombées l'une après l'autre. Et le résidu constitue l'alliance."
                                            },
                                            {
                                                "example_id": "89e733c2-2344-41d6-8b4a-7260d99d3000",
                                                "sense_id": "12630c49-b2b3-32ed-a080-8578c89e49cf",
                                                "text": "Quant au système locarnien, il est affaibli par la mort de Stresemann en 1929, puis celle de Briand en 1932."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
