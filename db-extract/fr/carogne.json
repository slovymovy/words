                        "examples": []
                    },
                    {
                        "sense_id": "9af76252-4bda-3db3-882d-28d5f66f402b",
                        "entry_id": "c409ef65-462e-3834-b0bc-1691b60ed345",
                        "glosses": [
                            "Mégère, femme débauchée ou méchante."
                        ],
                        "tags": [
                            "dated",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "9e50c643-b0a4-47d1-826b-e569a5dfe8ec",
                                "sense_id": "9af76252-4bda-3db3-882d-28d5f66f402b",
                                "text": "Carogne, à tous les diables ! Est-il possible qu’on laisse comme cela un pauvre malade tout seul ?"
                            },
                            {
                                "example_id": "a5cf1cee-f3d5-482f-8b08-3d75a3fa7110",
                                "sense_id": "9af76252-4bda-3db3-882d-28d5f66f402b",
                                "text": "Épouse-la donc, ta carogne, et que ça finisse !"
                            },
                            {
                                "example_id": "1ce544db-eac0-482c-9283-9d6e5fa63818",
                                "sense_id": "9af76252-4bda-3db3-882d-28d5f66f402b",
                                "text": "\"Il pourrait même, pendant qu'il y est, frapper à coups redoublés sur sa charogne, ou, comme dirait ma vieille bonne, sur sa carogne de mère.\""
                            },
                            {
                                "example_id": "272e92dd-28d7-4d49-8448-4e0b12dba511",
                                "sense_id": "9af76252-4bda-3db3-882d-28d5f66f402b",
                                "text": "Ah ! il y en avait des putois en ce monde et des putasses de putains. Sang de Dieu ! des charognards et des carognes."
                            }
                        ]
                    }
                ],
