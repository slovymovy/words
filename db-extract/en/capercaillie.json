                                "target_word": "глуха́рь",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fa23b119-dbac-3db2-8ff4-b4b282b6a960",
                                        "entry_id": "b92f94ee-64a4-3e7f-ab3d-e098f2bc5b96",
