                "senses": [
                    {
                        "sense_id": "e7e63034-6f8f-3ce6-a57f-a32bed1c0805",
                        "entry_id": "7428f02d-7413-38ca-a516-286938330b01",
                        "glosses": [
                            "isolierter kurzer Abschnitt einer DNA/RNA, Teilsequenz eines Gens, übriggebliebener Schnipsel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8de036f-8fbf-4da2-bf4a-572aa5e007d9",
                                "sense_id": "e7e63034-6f8f-3ce6-a57f-a32bed1c0805",
                                "text": "„Jede einzelne orange gefärbte Bande stammt von dem Erbgut-Fragment einer Bakterienart.“"
                            },
                            {
                                "example_id": "6c1a39e4-c669-4ccb-849e-7318b39f17ca",
                                "sense_id": "e7e63034-6f8f-3ce6-a57f-a32bed1c0805",
                                "text": "„Im Blut von Kamelen wurden Antikörper gegen dieses oder ein sehr ähnliches Virus gefunden; im Kot einer Fledermaus entdeckten Forscher jüngst ein Erbgut-Fragment, das mit der RNA von MERS-CoV übereinstimmt.“ (2013)"
                            },
                            {
                                "example_id": "17ee9218-b5e2-48f0-be85-6bf69558ad46",
                                "sense_id": "e7e63034-6f8f-3ce6-a57f-a32bed1c0805",
                                "text": "„Das Erbgut-Fragment passt an ein hochreguliertes Boten-Gen ‚wie bei einem Reißverschluss‘, so Stölzel.“"
                            },
                            {
                                "example_id": "b5f155f2-5429-4b3d-9070-3fabc7454600",
                                "sense_id": "e7e63034-6f8f-3ce6-a57f-a32bed1c0805",
                                "text": "„Dabei werden Erbgut-Fragmente des Kindes aus dem mütterlichen Blut isoliert und untersucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
