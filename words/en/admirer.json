{
    "word_family": [
        "admire",
        "admiration",
        "admirable",
        "admirably",
        "admiring",
        "admiringly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "741e140d-6781-32c2-89c1-46f801b599f5",
                    "sense_definition": "A person who has a particular regard or respect for someone or something.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "Appreciation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a lifelong <w>admirer</w> of classical music, he attends every concert at the local theater.",
                            "target_lang_translations": {
                                "ru": "Как пожизненный <w>поклонник</w> классической музыки, он посещает каждый концерт в местном театре."
                            }
                        },
                        {
                            "text": "The young artist is a great <w>admirer</w> of Van Gogh and often visits the museum for inspiration.",
                            "target_lang_translations": {
                                "ru": "Молодой художник — большой <w>почитатель</w> Ван Гога и часто посещает музей для вдохновения."
                            }
                        }
                    ],
                    "synonyms": [
                        "fan",
                        "devotee",
                        "supporter",
                        "enthusiast"
                    ],
                    "antonyms": [
                        "critic",
                        "detractor"
                    ],
                    "common_phrases": [
                        "great admirer",
                        "lifelong admirer",
                        "secret admirer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который испытывает особое уважение или восхищение по отношению к кому-либо или чему-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поклонник",
                                "target_lang_sense_clarification": "восторженный почитатель таланта или дела"
                            },
                            {
                                "target_lang_word": "почитатель",
                                "target_lang_sense_clarification": "тот, кто глубоко уважает и ценит кого-либо"
                            },
                            {
                                "target_lang_word": "обожатель",
                                "target_lang_sense_clarification": "страстный любитель чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ea03d86-cdd4-3f84-a27b-7da48bd8e45e",
                    "sense_definition": "A person who is romantically attracted to someone else.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "Romance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She received a beautiful bouquet of red roses from a secret <w>admirer</w> on Valentine's Day.",
                            "target_lang_translations": {
                                "ru": "На День святого Валентина она получила прекрасный букет красных роз от тайного <w>поклонника</w>."
                            }
                        },
                        {
                            "text": "Although he has a number of <w>admirers</w> at the office, he prefers to remain single for now.",
                            "target_lang_translations": {
                                "ru": "Хотя в офисе у него немало <w>поклонниц</w>, он пока предпочитает оставаться один."
                            }
                        }
                    ],
                    "synonyms": [
                        "suitor",
                        "beau",
                        "worshiper"
                    ],
                    "common_phrases": [
                        "secret admirer",
                        "silent admirer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который испытывает романтическую симпатию или влюбленность в другого человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поклонник",
                                "target_lang_sense_clarification": "мужчина, проявляющий интерес к женщине"
                            },
                            {
                                "target_lang_word": "ухажёр",
                                "target_lang_sense_clarification": "тот, кто активно проявляет знаки внимания"
                            },
                            {
                                "target_lang_word": "обожатель",
                                "target_lang_sense_clarification": "человек, который сильно влюблен"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}