                "senses": [
                    {
                        "sense_id": "d6320758-360d-3b2b-bdda-8f5c27a388ec",
                        "entry_id": "1b3e63f6-b5fd-32e6-be30-686af758ae05",
                        "glosses": [
                            "geruchliche Information und deren Verarbeitung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7b208d0-8c11-443b-ac6f-5cf751a67c10",
                                "sense_id": "d6320758-360d-3b2b-bdda-8f5c27a388ec",
                                "text": "„Bochumer Forscher um Dr. Marc Spehr und Prof. Dr. Dr. Dr. Hanns Hatt (Lehrstuhl für Zellphysiologie, Fakultät für Biologie der RUB) fanden bei diesem Nachweis sogar einen blockierenden Duft, der die Geruchsorientierung der Spermien ausschaltet.“"
                            },
                            {
                                "example_id": "9d72438f-def0-40c3-94b6-7c02e7842f86",
                                "sense_id": "d6320758-360d-3b2b-bdda-8f5c27a388ec",
                                "text": "„Konsequenterweise fanden die Bochumer einen blockierenden Duft, der Geruchsorientierung quasi ausschaltet – dies könnte neue Wege der Empfängnisverhütung weisen.“"
                            },
                            {
                                "example_id": "10d844eb-d47b-48a5-bb13-e6b3ef91ce7f",
                                "sense_id": "d6320758-360d-3b2b-bdda-8f5c27a388ec",
                                "text": "„Motten schnüffeln im Windkanal Jenaer Max-Planck-Institut erforscht Geruchsorientierung von Insekten Jena. “"
                            },
                            {
                                "example_id": "dee7b059-cae4-475c-9835-b2af474cc5d1",
                                "sense_id": "d6320758-360d-3b2b-bdda-8f5c27a388ec",
                                "text": "„Das Prinzip, das wir Herrn Finkenrath aus Solingen verdanken, nutzt die Geruchsorientierung der Wachsmotten: Diese fliegen bevorzugt dort an, wo sie das Hummelnest am stärksten wahrnehmen, und das ist aufgrund der vielen Ab- und Anflüge mit Pollen und Nektar direkt am Flugloch – übrigens auch dann, wenn in den Hummelkasten seitliche Lüftungsgitter eingebaut sind.“"
                            },
                            {
                                "example_id": "09d32d8b-5837-4ad7-9ce1-d59944770d8e",
                                "sense_id": "d6320758-360d-3b2b-bdda-8f5c27a388ec",
                                "text": "„Die Tests ergaben aber auch, dass die Vögel aus ihnen durch frühere Flüge bekannten Gebieten auch ohne Geruchsorientierung nach Hause finden können Heimfinden möglich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
