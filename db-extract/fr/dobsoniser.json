                "senses": [
                    {
                        "sense_id": "ef41fb65-93db-30da-b374-38a1d9d6bf75",
                        "entry_id": "deda2198-6d19-355e-9d36-710d136d0d43",
                        "glosses": [
                            "Transformer pour donner des caractéristiques de télescope de Dobson."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cc6a847-57c5-4437-9d4b-0d783778454f",
                                "sense_id": "ef41fb65-93db-30da-b374-38a1d9d6bf75",
                                "text": "Un télescope Newton, (35 114 mm, focale. 900 mm, « dobsonisé » par Francis, et d'utilisation aisée par les enfants."
                            },
                            {
                                "example_id": "07487256-3e91-4232-a73b-ca5930ce1a41",
                                "sense_id": "ef41fb65-93db-30da-b374-38a1d9d6bf75",
                                "text": "C'est ce que j'ai fait sur mon mak qui n'est pas dobsonisé mais \"pied-photo\"isé ou azimutalisé si tu préfère."
                            },
                            {
                                "example_id": "2d79c69e-fe82-4e0d-817e-196400f266fd",
                                "sense_id": "ef41fb65-93db-30da-b374-38a1d9d6bf75",
                                "text": "(le tube on peut le dobsoniser et ne pas l'utiliser ou le transporter au moins non?)"
                            }
                        ]
                    }
