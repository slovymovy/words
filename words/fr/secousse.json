            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fc2c00b7-703b-37ce-827a-ece9ec450e59",
                    "sense_definition": "Mouvement brusque, agitation ou ébranlement physique provoqué par un choc ou un séisme.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avion a traversé une zone de turbulences et les passagers ont ressenti une forte <w>secousse</w>."
                        },
                        {
                            "text": "Une <w>secousse</w> sismique de faible magnitude a fait trembler les vitres du salon."
                        }
                    ],
                    "common_phrases": [
                        "secousse sismique",
                        "ressentir une secousse"
                    ]
                },
                {
                    "sense_id": "7feec133-bdeb-3e90-a8e8-608df0dc55d6",
                    "sense_definition": "Ébranlement moral, crise ou choc affectant profondément la santé, la situation financière ou la stabilité d'une entité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "crise_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'annonce inattendue de cette faillite a provoqué une terrible <w>secousse</w> dans l'économie locale."
                        },
                        {
                            "text": "Le départ brutal de son associé a été une rude <w>secousse</w> pour la jeune entreprise."
                        }
                    ],
                    "synonyms": [
                        "choc"
                    ],
                    "common_phrases": [
                        "rude secousse"
                    ]
                },
                {
                    "sense_id": "78ba53ff-166e-380f-8b4e-9a0dadf437c7",
                    "sense_definition": "Contraction involontaire ou spasme musculaire provoqué par une excitation électrique ou nerveuse.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physiologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le courant électrique a provoqué une violente <w>secousse</w> dans tout son bras."
                        },
                        {
                            "text": "Le patient a été pris d'une brusque <w>secousse</w> musculaire avant de s'endormir."
