                "senses": [
                    {
                        "sense_id": "36d60be7-9877-3e2e-a0da-0342e3ad5d27",
                        "entry_id": "e99e309e-748d-3387-9f73-a7ee93619c43",
                        "glosses": [
                            "eine sternartige Hülle, die nach dem Ableben die Seele umgibt und den Tod des materiellen Körpers überdauert"
                        ],
                        "tags": [
                            "religiös",
                            "okkultisch"
                        ],
                        "examples": [
                            {
                                "example_id": "7db45ac8-4fcf-4427-a3cc-cff961c839c8",
                                "sense_id": "36d60be7-9877-3e2e-a0da-0342e3ad5d27",
                                "text": "Auch der Astralkörper muss zur Ruhe gebracht werden."
                            },
                            {
                                "example_id": "6821b294-a1d4-426f-89d9-fefde3d638e7",
                                "sense_id": "36d60be7-9877-3e2e-a0da-0342e3ad5d27",
                                "text": "Der Astralkörper oder Ätherleib verläßt den Körper und kann den Körper dann sozusagen von außen beobachten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3fb0b9ae-936c-3fe1-8d08-8e67eb45b4e0",
                        "entry_id": "e99e309e-748d-3387-9f73-a7ee93619c43",
                        "glosses": [
                            "schöner, menschlicher Körper"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "ba380e8c-1327-4af0-b389-2d629cc22f91",
                                "sense_id": "3fb0b9ae-936c-3fe1-8d08-8e67eb45b4e0",
                                "text": "Wow, was für ein Astralkörper! Wie lange braucht man als Ottonormalverbraucher dafür?"
                            },
                            {
                                "example_id": "02bc858e-9eb3-4ade-9da0-32e42d376152",
                                "sense_id": "3fb0b9ae-936c-3fe1-8d08-8e67eb45b4e0",
                                "text": "„Und wenn ich Sibylle von einem \"Astralkörper\" schwärmen höre, weiß ich, dass ich an einen Alabasterkörper denken muss.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf00cb5a-9e32-4505-9765-6b740c8edd21",
                        "source_entry_id": "e99e309e-748d-3387-9f73-a7ee93619c43",
                        "source_sense_id": "36d60be7-9877-3e2e-a0da-0342e3ad5d27",
                        "source_sense_description": "sternartige Hülle, die nach dem Ableben die Seele umgibt",
                        "target_lang_word": "astral body",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "astral body",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "975c3a83-a5d9-32f8-94d3-4250c7d1f883",
                                        "entry_id": "e813c60f-a382-314b-abd0-8b1aaf1e2790",
                                        "glosses": [
                                            "A ghost-like replica of one's physical body which supposedly inhabits or is somehow associated with the physical body, conceived as a subtle body composed of some sort of ethereal material or as being non-physical and capable of sometimes separating from the physical body to travel to other places or to other realms of existence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59a0610a-9d62-4840-ba55-238fbf7eedba",
                                                "sense_id": "975c3a83-a5d9-32f8-94d3-4250c7d1f883",
                                                "text": "\"I suppose I am not talking to you at all. You are in Thibet with Shere Ali. This is your astral body, and if I were near enough, I could poke my fingers right through you, as you sit there, telling me you are an Edinburgh doctor, forsooth.\"\n\"Quite right, Mr. Griggs. At the present moment my body is quietly asleep in a lamastery in Thibet, and this is my astral shape."
                                            },
                                            {
                                                "example_id": "b85810e8-0c44-4f9a-b9d6-305c670645e2",
                                                "sense_id": "975c3a83-a5d9-32f8-94d3-4250c7d1f883",
                                                "text": "\"I kept the Jewel within my great safe, whence none could extract it; not even Queen Tera herself with her astral body.\""
                                            },
                                            {
                                                "example_id": "628cf6c3-cafa-4186-8359-5220d39accfe",
                                                "sense_id": "975c3a83-a5d9-32f8-94d3-4250c7d1f883",
                                                "text": "\"You fool, have I no means of searching other than in the physical?\" cried the man wrathfully. \"I have been looking for him from the other side. It is as easy for me to use my astral body as this physical one.\""
                                            },
                                            {
                                                "example_id": "40d8d571-041a-4b04-9b78-4f57f78f99d4",
                                                "sense_id": "975c3a83-a5d9-32f8-94d3-4250c7d1f883",
                                                "text": "I am not ready to ridicule the claim of the Yogi adepts, that they are able to project some kind of astral body, and to communicate with one another from distant places."
                                            },
                                            {
                                                "example_id": "692c8f88-a59b-48b3-ace4-353b8fee49b1",
                                                "sense_id": "975c3a83-a5d9-32f8-94d3-4250c7d1f883",
                                                "text": "The voice in this case belongs to a lovely lady who has been most foully stabbed and while her body remains in a thug-infested old manse her astral body goes to ask Topper's assistance—probably the first instance on record in which the murdered victim was the first to inform the public."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a565d38-d10e-41f3-b127-6d9013d88bc8",
                        "source_entry_id": "e99e309e-748d-3387-9f73-a7ee93619c43",
                        "source_sense_id": "36d60be7-9877-3e2e-a0da-0342e3ad5d27",
