                "senses": [
                    {
                        "sense_id": "5efe4fed-dbeb-3ad4-b349-ae9f1c3b3a5a",
                        "entry_id": "62bb1d00-c99b-3e5b-a2c1-8a054e18cb2d",
                        "glosses": [
                            "Donner un caractère agricole à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a08b27d2-0cfe-4d63-b290-b3c68e760ed9",
                                "sense_id": "5efe4fed-dbeb-3ad4-b349-ae9f1c3b3a5a",
                                "text": "Dès lors, parler d’industrialiser l’agriculture c’est employer des termes vides de sens, comme si on proposait d’«agricoliser l’industrie», puisque l’agriculture est dans une situation qui lui est imposée par la nature."
                            },
                            {
                                "example_id": "ffca0b4f-0400-4b23-a832-a1c8211dfb9f",
                                "sense_id": "5efe4fed-dbeb-3ad4-b349-ae9f1c3b3a5a",
                                "text": "Ce mouvement tend à « agricoliser » les campagnes sur la longue durée."
                            },
                            {
                                "example_id": "0d3d4f20-3a06-423d-828d-b8b29587c7ef",
                                "sense_id": "5efe4fed-dbeb-3ad4-b349-ae9f1c3b3a5a",
                                "text": "Bah, c'est pas la première à s'agricoliser...."
                            }
                        ]
