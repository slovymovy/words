{
    "word_family": [
        "expectation",
        "expectancy",
        "expectant",
        "expectantly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "659bf6eb-f7f7-3eff-ab06-83113e288a32",
                    "sense_definition": "Present participle and gerund of <w>expect</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We are <w>expecting</w> a lot of rain this weekend.",
                            "target_lang_translations": {
                                "ru": "Мы <w>ожидаем</w> много дождей в эти выходные.",
                                "es": "Estamos <w>esperando</w> mucha lluvia este fin de semana."
                            }
                        },
                        {
                            "text": "She is <w>expecting</w> a phone call from her manager.",
                            "target_lang_translations": {
                                "ru": "Она <w>ждет</w> телефонного звонка от своего менеджера.",
                                "es": "Ella está <w>esperando</w> una llamada telefónica de su gerente."
                            }
                        }
                    ],
                    "common_phrases": [
                        "expecting company",
                        "expecting trouble",
                        "expecting a call"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма причастия настоящего времени и герундия от глагола \"expect\" (ожидать).",
                        "es": "Participio presente y gerundio del verbo \"expect\" (esperar, prever)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ожидать",
                                "target_lang_sense_clarification": "рассчитывать на то, что что-то произойдет"
                            },
                            {
                                "target_lang_word": "ждать",
                                "target_lang_sense_clarification": "находиться в состоянии ожидания"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "esperando",
                                "target_lang_sense_clarification": "aguardando que algo suceda"
                            },
                            {
                                "target_lang_word": "previendo",
                                "target_lang_sense_clarification": "anticipando o calculando un suceso futuro"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d17660e4-082f-3093-ac99-d39ff93d83bb",
                    "sense_definition": "Pregnant; waiting for the birth of a child.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>expecting</w> couple is busy preparing the nursery.",
                            "target_lang_translations": {
                                "ru": "<w>Ожидающая ребенка</w> пара занята подготовкой детской.",
                                "es": "La pareja <w>que espera un bebé</w> está ocupada preparando el cuarto del niño."
                            }
                        },
                        {
                            "text": "She is <w>expecting</w> and will go on maternity leave soon.",
                            "target_lang_translations": {
                                "ru": "Она <w>ждет ребенка</w> и скоро уйдет в декретный отпуск.",
                                "es": "Ella está <w>embarazada</w> y pronto se irá de baja por maternidad."
                            }
                        }
                    ],
                    "synonyms": [
                        "pregnant",
                        "in the family way"
                    ],
                    "common_phrases": [
                        "expecting a baby",
                        "expecting mother",
                        "expecting parents"
                    ],
                    "target_lang_definitions": {
                        "ru": "Беременная; ожидающая рождения ребенка.",
                        "es": "Embarazada; que está esperando la llegada de un bebé."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ждать ребенка",
                                "target_lang_sense_clarification": "готовиться к рождению ребенка"
                            },
                            {
                                "target_lang_word": "беременная",
                                "target_lang_sense_clarification": "находящаяся в состоянии беременности"
                            },
                            {
                                "target_lang_word": "в положении",
                                "target_lang_sense_clarification": "разговорное выражение о беременности"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "embarazada",
                                "target_lang_sense_clarification": "en estado de gestación"
                            },
                            {
                                "target_lang_word": "esperando un bebé",
                                "target_lang_sense_clarification": "que va a tener un hijo pronto"
                            },
                            {
                                "target_lang_word": "encinta",
                                "target_lang_sense_clarification": "término formal para embarazada"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88fa84f1-0c17-36df-a0ba-998fbd366f24",
                    "sense_definition": "Showing or feeling anticipation that something is about to happen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He looked at the door with an <w>expecting</w> glance.",
                            "target_lang_translations": {
                                "ru": "Он посмотрел на дверь <w>ожидающим</w> взглядом.",
                                "es": "Miró hacia la puerta con una mirada <w>expectante</w>."
                            }
                        },
                        {
                            "text": "There was an <w>expecting</w> silence before the winner was announced.",
                            "target_lang_translations": {
                                "ru": "Перед объявлением победителя повисла <w>выжидающая</w> тишина.",
                                "es": "Hubo un silencio <w>expectante</w> antes de que se anunciara al ganador."
                            }
                        }
                    ],
                    "common_phrases": [
                        "expecting look",
                        "expecting tone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражающий ожидание или предвкушение того, что что-то должно произойти.",
                        "es": "Que muestra o siente anticipación o expectativa de que algo está a punto de ocurrir."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выжидающий",
                                "target_lang_sense_clarification": "выражающий готовность к чему-то"
                            },
                            {
                                "target_lang_word": "ожидающий",
                                "target_lang_sense_clarification": "исполненный ожидания"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "expectante",
                                "target_lang_sense_clarification": "que muestra anticipación o espera"
                            },
                            {
                                "target_lang_word": "ansioso",
                                "target_lang_sense_clarification": "con ganas o expectativa"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "072fa7f2-7f82-3449-812a-bd61681c4b9b",
                    "sense_definition": "The act or process of looking forward to or anticipating something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His constant <w>expectings</w> of success were not matched by his efforts.",
                            "target_lang_translations": {
                                "ru": "Его постоянные <w>ожидания</w> успеха не соответствовали его усилиям.",
                                "es": "Sus continuas <w>expectativas</w> de éxito no se correspondían con sus esfuerzos."
                            }
                        },
                        {
                            "text": "The philosopher wrote about the <w>expectings</w> of the human mind.",
                            "target_lang_translations": {
                                "ru": "Философ писал об <w>ожиданиях</w> человеческого разума.",
                                "es": "El filósofo escribió sobre las <w>esperas</w> de la mente humana."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс ожидания чего-либо.",
                        "es": "El acto o proceso de esperar o anticipar algo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ожидание",
                                "target_lang_sense_clarification": "состояние или предвкушение"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "expectativa",
                                "target_lang_sense_clarification": "esperanza o posibilidad de conseguir algo"
                            },
                            {
                                "target_lang_word": "espera",
                                "target_lang_sense_clarification": "acto o tiempo de aguardar"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}