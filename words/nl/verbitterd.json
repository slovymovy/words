                    "frequency": "Middle",
                    "semantic_group_id": "emotionele toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het onverwachte ontslag bleef de man jarenlang <w>verbitterd</w> achter.",
                            "target_lang_translations": {
                                "en": "After the unexpected dismissal, the man remained <w>embittered</w> for years."
                            }
                        },
                        {
                            "text": "Zijn <w>verbitterde</w> reactie op het nieuws liet zien hoeveel pijn het hem deed.",
                            "target_lang_translations": {
