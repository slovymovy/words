                        "glosses": [
                            "Composé de formule chimique SrO, oxyde de strontium."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ae48a47-4f12-45b4-8cf9-591f85ac8e38",
                                "sense_id": "53a3d0d8-e0bf-3ca0-bf4d-8857349400d4",
                                "text": "Cinq autres terres ont été annoncées par quelques savans […] La witherite […] La strontiane, ainsi nommée, parce qu’elle se trouve à Strontian, dans le comté d’Argyle en Écosse, se rapproche aussi beaucoup de la base terreuse du carbonate de baryte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54810901-4f99-4aea-9f6e-e85d62306762",
                        "source_entry_id": "fd099418-4195-36f8-9bfe-340d513bd5db",
