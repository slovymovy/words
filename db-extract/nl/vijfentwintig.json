                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8bc7584-6426-45be-bc7f-b8233e1b974e",
                                "sense_id": "157b0302-18c0-3da6-8f97-4e2517c4fb1e",
                                "text": "De vijfentwintig zijn natuurlijk blij, maar laten we ook denken aan het verdriet van de vier die zijn afgewezen."
                            }
                        ]
                    }
