                                        "sense_id": "53acd5b5-2478-38b4-bf9b-4d0d4647b3c9",
                                        "entry_id": "9cf978f9-1a80-3b6e-8d45-5bfeef26ba40",
                                        "glosses": [
                                            "A brief religious service."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03a94552-d597-4041-a880-fc46fd8e454a",
                                                "sense_id": "53acd5b5-2478-38b4-bf9b-4d0d4647b3c9",
                                                "text": "To prepare for leading a devotional, select a theme appropriate to the occasion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3013de8-f58e-3ba5-ae4a-7b9dcbf0b214",
                                        "entry_id": "9cf978f9-1a80-3b6e-8d45-5bfeef26ba40",
                                        "glosses": [
                                            "A text or piece of music or writing to be used for devotion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49ff5620-0e5b-48cb-9be4-3bca0843e0ab",
                                                "sense_id": "a3013de8-f58e-3ba5-ae4a-7b9dcbf0b214",
                                                "text": "Each page of the book offers a short devotional that inspires thought and self-reflection."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "devotional",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "494f5ab3-ae25-367c-a2f7-f7eac9424cba",
                                        "entry_id": "8c198390-0028-3153-b016-06348d51d964",
                                        "glosses": [
                                            "Of or pertaining to devotion or worship."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66afadde-1d28-4731-a349-a6c641cce1b0",
                                                "sense_id": "494f5ab3-ae25-367c-a2f7-f7eac9424cba",
                                                "text": "She spent much time playing devotional music."
                                            },
                                            {
                                                "example_id": "ad9a67c0-466b-43b5-8b4a-03e786b13c7e",
                                                "sense_id": "494f5ab3-ae25-367c-a2f7-f7eac9424cba",
                                                "text": "Because of her love for Robert […] the Resistance leader, Willie undertakes dangerous missions for the anti-fascist groups. She doesn't seem however to have the slightest idea why she is doing it, it is a devotional, not a political action."
                                            },
                                            {
                                                "example_id": "90a87d6a-e7ed-4473-853f-14bfb82ab547",
                                                "sense_id": "494f5ab3-ae25-367c-a2f7-f7eac9424cba",
                                                "text": "The latter [mule] had what Muldoon referred to as 'devotional habits' — which is to say that, occasionally, she would go down on her knees and refuse to budge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
