                ],
                "senses": [
                    {
                        "sense_id": "93a23fba-5993-3fdb-97e5-6cc172d1e5a9",
                        "entry_id": "fbc53334-324e-31b7-9525-e734ba53f344",
                        "glosses": [
                            "Any of parasitic intestinal worms comprising the phylum Acanthocephala."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d81834e-a1db-40f8-952e-0d8d3582eb52",
                                "sense_id": "93a23fba-5993-3fdb-97e5-6cc172d1e5a9",
                                "text": "That discussion of fish intestines is justified because many acanthocephalans have been described from fish."
                            },
                            {
                                "example_id": "f7d2fa2f-edf4-457e-9e7a-24ac8dd52561",
                                "sense_id": "93a23fba-5993-3fdb-97e5-6cc172d1e5a9",
                                "text": "2006, B. B. Nickol, Phylum Acanthocephala, P. T. K. Woo (editor), Fish Diseases and Disorders, Volume 1: Protozoan and Metazoan Infections, 2nd Edition, page 458,\nClearly acanthocephalans contain large amounts of lipid and possess enzyme systems for lipid metabolism (Filipponi et al., 1994; Weber et al., 1995); however, use of these lipid deposits in energy metabolism is yet to be demonstrated."
                            },
                            {
                                "example_id": "775660d9-5a74-4109-b7c2-11c8b29ab8ff",
                                "sense_id": "93a23fba-5993-3fdb-97e5-6cc172d1e5a9",
                                "text": "Acanthocephalans are dioecious pseudocoelomate worms remarkably adapted to a parasitic lifestyle in that there is no mouth or digestive system."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c5d1fb57-a6c6-438d-8854-daaf48e82825",
                        "source_entry_id": "fbc53334-324e-31b7-9525-e734ba53f344",
                        "source_sense_id": "93a23fba-5993-3fdb-97e5-6cc172d1e5a9",
                        "source_sense_description": "any of parasitic intestinal worms of the phylum Acanthocephala",
                        "target_lang_word": "acanthocéphale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acanthocéphale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5b14d1d9-c529-34f3-b9d3-e89dae0e271e",
                                        "entry_id": "264067da-8da8-3492-9d30-d5735969c7a9",
                                        "glosses": [
                                            "Petit animal vermiforme au corps cylindrique, non segmenté, au proboscis rétractable portant des épines courbées en arrière, endoparasite d’arthropodes à l’état juvénile, et d’intestins de vertébrés, à l’état adulte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64b3031f-7583-413c-af9d-6d23436f1934",
                                                "sense_id": "5b14d1d9-c529-34f3-b9d3-e89dae0e271e",
                                                "text": "Les acanthocéphales mesurent quelques millimètres, néanmoins une espèce, Macracanthorhynchus hirudinaceus, parasite du cochon, atteint près d’un mètre."
                                            },
                                            {
                                                "example_id": "32b0b45d-d9b5-4651-b1fe-38c5969be4da",
                                                "sense_id": "5b14d1d9-c529-34f3-b9d3-e89dae0e271e",
                                                "text": "Une seule espèce de vers à trompe épineuse (acanthocéphales ou macracanthocéphales) présente un intérêt vétérinaire : Macracanthorhynchus hirudinaceus, un parasite de l’intestin grêle du porc. L’espèce est de grande taille, puisque les femelles atteignent 65 cm de longueur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
