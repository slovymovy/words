                                                "sense_id": "ff1e1894-0d73-3fea-8f5d-8c026685812c",
                                                "text": "The merchant found gabardines with finer ribs sold better here."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e02b9980-48f1-3697-8d2b-019827ac929c",
                                        "entry_id": "4510f356-9163-3f35-8758-5014db27928b",
                                        "glosses": [
                                            "A similar fabric, made from cotton."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a1ea44d0-8129-33df-89d7-437169bed6f0",
                                        "entry_id": "4510f356-9163-3f35-8758-5014db27928b",
                                        "glosses": [
                                            "A long cloak."
