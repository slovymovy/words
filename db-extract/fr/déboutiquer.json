                "senses": [
                    {
                        "sense_id": "4d50b879-e068-32b1-b187-6e1181ebdb63",
                        "entry_id": "ea623bdb-468f-33f8-8f11-b3fc27d59d10",
                        "glosses": [
                            "Modifier, bouleverser, quelque chose qui avait été prévu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54742eea-e418-48ea-86d8-27a7223ce408",
                                "sense_id": "4d50b879-e068-32b1-b187-6e1181ebdb63",
                                "text": "À force de déboutiquer les trains, ils pourraient bien pousser les voyageurs à se payer une envolée de boutique !"
                            },
                            {
                                "example_id": "c6e0bc5d-daba-4ed9-83cd-1064e9fb97b3",
                                "sense_id": "4d50b879-e068-32b1-b187-6e1181ebdb63",
                                "text": "Question au(x) \"pro(s)\" : Est-ce que la régularité de ces trains était suffisamment correcte pour que ces roulements \"tiennent\" en général bien, ou fallait-il les déboutiquer sans cesse ?"
                            },
                            {
                                "example_id": "75f7bb42-1d2d-4a05-930a-10c501ad2a60",
                                "sense_id": "4d50b879-e068-32b1-b187-6e1181ebdb63",
                                "text": "Mais aucun souci pour la direction: elle déboutique les agents du roulement, des petits décalages de plus de 4h sous prétexte que les agents ont plus de 14h de repos et la modification fonctionne."
                            }
                        ]
                    }
