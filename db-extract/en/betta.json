    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4c73716f-7cae-3858-96dc-83c53eef48d3",
                "word": "betta",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "78ef1601-b75d-39ba-bc15-dde8751913b6",
                        "entry_id": "4c73716f-7cae-3858-96dc-83c53eef48d3",
                        "glosses": [
                            "Pronunciation spelling of better, comparative of good."
                        ],
                        "tags": [
                            "alt-of",
                            "pronunciation-spelling"
                        ],
                        "examples": [
                            {
                                "example_id": "675adf13-6273-4e18-be99-d93d25a07449",
                                "sense_id": "78ef1601-b75d-39ba-bc15-dde8751913b6",
                                "text": "'I think no savvy. This one mo' betta,' he added, pointing to the house where the drunken captain slumbered: 'Take-a-sun all-e-time.'"
                            },
                            {
                                "example_id": "9edb08e9-f010-46af-91a7-df813c125b4a",
                                "sense_id": "78ef1601-b75d-39ba-bc15-dde8751913b6",
                                "text": "I pray dat dey he'p us liv' a betta lif ' den dey had."
                            },
                            {
                                "example_id": "5630d87d-e965-44ff-bee8-c163bec89615",
                                "sense_id": "78ef1601-b75d-39ba-bc15-dde8751913b6",
                                "text": "Joshua shyly looks down at his feet but then glances over at Harriet and says - “Miss Harriet, a beautiful form is betta dan a beautiful face, and a beautiful behavior is betta dan a beautiful form, it gives mo pleasure than statues or pictures.[…]\""
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "68354a12-a1d4-3039-b685-4ed1d306f3f6",
                "word": "betta",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "31aeb2cc-5f3a-3a91-8994-b45d68c8199c",
                        "entry_id": "68354a12-a1d4-3039-b685-4ed1d306f3f6",
                        "glosses": [
                            "Pronunciation spelling of better, comparative of well."
                        ],
                        "tags": [
                            "alt-of",
                            "pronunciation-spelling"
                        ],
                        "examples": [
                            {
                                "example_id": "e27b22cc-ad24-41f1-9148-094202769979",
                                "sense_id": "31aeb2cc-5f3a-3a91-8994-b45d68c8199c",
                                "text": "“Now she be lookin' betta,” one of the women said. “Like she has a chance to make it.”"
                            },
                            {
                                "example_id": "1e33ab03-bc9f-4f33-ac32-e95d2e237b6d",
                                "sense_id": "31aeb2cc-5f3a-3a91-8994-b45d68c8199c",
                                "text": "Now you even know the dope game betta than me, look how much money you save fo me when I went to jail."
                            },
                            {
                                "example_id": "fab032c0-7a11-4825-bbed-f10cd2dc9030",
                                "sense_id": "31aeb2cc-5f3a-3a91-8994-b45d68c8199c",
                                "text": "“I see she's feelin' betta’,” he said in a muffled voice."
                            },
                            {
                                "example_id": "0045b939-b150-4b0d-b01e-32f3cfdd830e",
                                "sense_id": "31aeb2cc-5f3a-3a91-8994-b45d68c8199c",
                                "text": "Other than the omnipotent one, who betta to ask to help us pray for God's mercy and grace than Jesus' mother, the ev'a bless'd Virgin Mary."
                            }
                        ]
                    },
                    {
                        "sense_id": "63c9ae2a-09f6-3a98-9ecc-669cb0322690",
                        "entry_id": "68354a12-a1d4-3039-b685-4ed1d306f3f6",
                        "glosses": [
                            "Pronunciation spelling of better (“had better”)."
                        ],
                        "tags": [
                            "alt-of",
                            "pronunciation-spelling",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "9a388d2b-9007-49f3-a5f7-5169bd223a96",
                                "sense_id": "63c9ae2a-09f6-3a98-9ecc-669cb0322690",
                                "text": "“Boy, if I done told you once, I done told you a thousand times, you betta leave them white girls alone before one of their boyfriends or husbands roll up on you, and put a hurtin on yo lil behind.”"
                            },
                            {
                                "example_id": "358c31bc-3505-46ef-afd2-81c882bcb5c9",
                                "sense_id": "63c9ae2a-09f6-3a98-9ecc-669cb0322690",
                                "text": "You betta praise the Lord that's all I can say."
                            },
                            {
                                "example_id": "17fd825e-0f0c-42c1-9ad1-603b5db412cb",
                                "sense_id": "63c9ae2a-09f6-3a98-9ecc-669cb0322690",
                                "text": "If I had a lil sister, she betta be scared to screw and be about gettin that paper."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "a3f197b3-e1f9-3d02-b183-0a5740c94ee9",
                "word": "betta",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "760d9ff5-b052-4d2b-ad47-0012803ffe5e",
                        "entry_id": "a3f197b3-e1f9-3d02-b183-0a5740c94ee9",
                        "tags": [
                            "plural"
                        ],
                        "form": "bettas"
