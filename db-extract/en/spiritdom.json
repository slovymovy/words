                        "glosses": [
                            "The sphere, realm, or world of the spirit; spirituality; spirits collectively."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "49624385-b876-47c9-a703-1e2041632303",
                                "sense_id": "c87172b9-86a9-3a2f-b405-c6ac1b50030f",
                                "text": "These were acknowledged to be as great marvels as any of those of spiritdom."
                            },
                            {
                                "example_id": "71a70db0-a30f-4538-accc-c6c90ba020ee",
                                "sense_id": "c87172b9-86a9-3a2f-b405-c6ac1b50030f",
                                "text": "Among these varied groups of farmers and menials, there are a chosen few set aside as ambassadors to spiritdom, or shamans, known as bhagats."
                            },
                            {
                                "example_id": "e76321a8-31b0-4904-9fbe-0b34dd4b4ae2",
                                "sense_id": "c87172b9-86a9-3a2f-b405-c6ac1b50030f",
                                "text": "Nietzsche's vacillation over the possibility of female admission to free spiritdom is captured in microcosm in \"Women who master the masters.\""
                            }
                        ]
                    }
