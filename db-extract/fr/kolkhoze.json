                                                "sense_id": "442c17c5-5eb4-34e7-ac9a-27f29ecb6c1a",
                                                "text": "Ciągle ktoś wchodzi lub wychodzi, mam dość siedzenia w tym kołchozie."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "00481612-1ca0-33da-850e-1ecae47a10dd",
