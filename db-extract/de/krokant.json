                "senses": [
                    {
                        "sense_id": "baaa764f-ed3b-34a1-b5b6-b5385ea1783f",
                        "entry_id": "fe0510ec-214a-338b-b8ad-52f04b53dbc2",
                        "glosses": [
                            "knusprige, aus Mandeln, Nüssen und Zucker hergestellte Masse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abe9fb49-03d0-4aab-bc10-7ea1b1f258bc",
                                "sense_id": "baaa764f-ed3b-34a1-b5b6-b5385ea1783f",
                                "text": "„Den Krokant jetzt auf das Blech gießen und mit einer Winkelpalette oder einem Silikon-Teigschaber verstreichen.“"
                            },
                            {
                                "example_id": "0248a762-c52a-4cbb-9693-adc8f3b6de5e",
                                "sense_id": "baaa764f-ed3b-34a1-b5b6-b5385ea1783f",
                                "text": "„Die gehackten Haselnüsse unterheben, Topf vom Herd nehmen und den Krokant abkühlen lassen.“"
                            },
                            {
                                "example_id": "ed30e69c-893b-409a-9a29-78b32a1c8695",
                                "sense_id": "baaa764f-ed3b-34a1-b5b6-b5385ea1783f",
                                "text": "„Für den Krokant die gehackten Haselnüsse in einer beschichteten Pfanne goldbraun rösten.“"
                            },
                            {
                                "example_id": "2126f30b-ef22-4084-8e4f-13d40c6ec159",
                                "sense_id": "baaa764f-ed3b-34a1-b5b6-b5385ea1783f",
                                "text": "„Creme in die Schälchen verteilen, mit dem restlichen Krokant bestreuen.“"
                            },
                            {
                                "example_id": "a647c982-97bb-4020-9a05-46cc78fb5322",
                                "sense_id": "baaa764f-ed3b-34a1-b5b6-b5385ea1783f",
                                "text": "„Wenn ich verlockend süße Schokolade erwarte, will ich auch verlockend süße Schokolade kriegen, gerne mit dazu passenden Ingredienzien wie Nüssen, Karamell, Krokant oder Marzipan, aber doch bitte nicht mit bitterem Schnaps.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a49a6540-f690-47f3-ae3a-0aa69d088080",
