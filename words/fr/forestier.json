                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "foret",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le respect du code <w>forestier</w> est obligatoire pour protéger la faune locale."
