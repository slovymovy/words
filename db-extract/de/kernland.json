                "senses": [
                    {
                        "sense_id": "d61abf94-dad7-330c-8a57-d8d69d32bd23",
                        "entry_id": "8c7b9945-05d3-35ed-877c-f167863d87bf",
                        "glosses": [
                            "zentraler, wesentlicher Bestandteil eines Landes oder eines größeren Bereichs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebbbea56-3318-447c-ae3d-ce51e962b5e4",
                                "sense_id": "d61abf94-dad7-330c-8a57-d8d69d32bd23",
                                "text": "„Sie zählte Hatay zum türkischen Kernland und verlangte Rückgabe.“"
                            },
                            {
                                "example_id": "bc6260d0-f52c-4b48-aa13-5067a724169b",
                                "sense_id": "d61abf94-dad7-330c-8a57-d8d69d32bd23",
                                "text": "„Historisch gesehen, verstand sich das eher ländliche, konservative Amerika stets als das Kernland («heartland»), als der tragende Pfeiler der Nation.“"
                            },
                            {
                                "example_id": "16a3b0cc-2a59-42e0-8e2c-1567eb7d141e",
                                "sense_id": "d61abf94-dad7-330c-8a57-d8d69d32bd23",
                                "text": "„Das ostpreußische Kernland war inzwischen wieder souverän, aber noch regierte der polnische König Polnisch Preußen und hätte einen »König von Preußen« schon wegen dessen Titel als Konkurrenz betrachtet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
