                                                "sense_id": "55e7bde3-4877-320a-96e8-68460f565248",
                                                "text": "Eine Senkung des Magens kann zu Beschwerden wie fehlendem Sättegefühl führen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
