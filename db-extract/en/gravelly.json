                                            {
                                                "example_id": "08f8eda7-e3c7-4cd2-b8d3-d1157a672b19",
                                                "sense_id": "05cbd0fb-2c2a-3ce5-a219-1a541460b0e4",
                                                "text": "Un style rocailleux."
                                            },
                                            {
                                                "example_id": "0d2b4b29-109a-448d-b67d-ca998a162f07",
                                                "sense_id": "05cbd0fb-2c2a-3ce5-a219-1a541460b0e4",
                                                "text": "Autant celle-ci [Victor Marguerite] peut paraître simpliste, rocailleuse malgré sa générosité ..."
                                            },
                                            {
                                                "example_id": "3599f21a-ab17-4e79-bfdf-f6f39621f7f6",
                                                "sense_id": "05cbd0fb-2c2a-3ce5-a219-1a541460b0e4",
                                                "text": "Un accent rocailleux."
                                            },
                                            {
                                                "example_id": "d82c8ad6-12e3-4b52-ae8a-11773a873b9f",
                                                "sense_id": "05cbd0fb-2c2a-3ce5-a219-1a541460b0e4",
                                                "text": "un Tamoul au regard brillant, aux dents éclatantes et à l’accent\nrocailleux,"
                                            }
