                    {
                        "sense_id": "cdf13a94-3c80-3c1f-b454-5ff309c357b3",
                        "entry_id": "d7a3a02e-2cf4-39e0-8c2b-309b90209e6a",
                        "glosses": [
                            "weibliche Person, welche sich mit alkoholischen Getränken, die durch Gärung von Traubensaft hergestellt werden, sehr gut auskennt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2edb126e-6bf2-441c-9431-f20a02b8f61d",
                                "sense_id": "cdf13a94-3c80-3c1f-b454-5ff309c357b3",
                                "text": "„Sie hat sich selbst zu einer richtigen Weinexpertin entwickelt.“"
                            },
                            {
                                "example_id": "30e7caf1-2c7a-4c1b-bbb0-bbfc21b67f6a",
                                "sense_id": "cdf13a94-3c80-3c1f-b454-5ff309c357b3",
                                "text": "„Winzer Markus Wöhrle und Weinexpertin Natalie Lumpp haben bei der BZ-Weinprobe die Burgunderweine des Weinguts präsentiert und auch viel Wissen rund um das Thema vermittelt.“"
                            },
                            {
                                "example_id": "13502685-80e7-4385-aacd-2a410e5a5287",
                                "sense_id": "cdf13a94-3c80-3c1f-b454-5ff309c357b3",
                                "text": "„Die Weinexpertin ist seit Kurzem Präsidentin der Internationalen Organisation für Rebe und Wein in Paris, einer Art Uno der Weinerzeugernationen, mit derzeit 46 Mitgliedsstaaten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
