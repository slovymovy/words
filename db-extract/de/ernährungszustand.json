                ],
                "senses": [
                    {
                        "sense_id": "744f52bb-2c26-3048-ad69-7e95f71c5291",
                        "entry_id": "6ba6bdb5-114d-3b76-9983-c8dc17f2a2ac",
                        "glosses": [
                            "von der Ernährung abhängender Zustand des Körpers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "606f53b1-3a81-424a-bf20-a33b9e0112cf",
                                "sense_id": "744f52bb-2c26-3048-ad69-7e95f71c5291",
                                "text": "„Darüber hinaus sind Ernährung und damit auch der Ernährungszustand älterer Menschen ein zentrales Thema für die Pflege.“"
                            },
                            {
                                "example_id": "a6fada8e-3d12-41af-8dcb-6b17263d6a95",
                                "sense_id": "744f52bb-2c26-3048-ad69-7e95f71c5291",
                                "text": "„Ferner soll geklärt werden, wie sich der Ernährungszustand auf das subjektive Wohlbefinden auswirkt.“"
                            },
                            {
                                "example_id": "27ab4970-a0bc-4698-9c82-5c5cc8f81da0",
                                "sense_id": "744f52bb-2c26-3048-ad69-7e95f71c5291",
                                "text": "„Bei schlechtem Ernährungszustand sind die großen Muskelpartien nur mäßig oder schlecht ausgebildet und alle Skelettanteile, insbesondere die Akren, treten deutlich hervor […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
