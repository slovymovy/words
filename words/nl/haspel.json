    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "93498ae3-4510-36f9-bee8-a5493efda14e",
                    "sense_definition": "Een draaiend werktuig om kabels, slangen of draad op of af te wikkelen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij rolde de lange tuinslang netjes op de <w>haspel</w>.",
                            "target_lang_translations": {
                                "en": "He neatly rolled the long garden hose onto the <w>reel</w>."
                            }
                        },
                        {
                            "text": "Om het verlengsnoer op te bergen gebruiken we een <w>haspel</w> voor de kabel.",
                            "target_lang_translations": {
                                "en": "To store the extension cord, we use a cable <w>reel</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "haspel voor de kabel",
                        "op de haspel opwinden"
                    ],
                    "target_lang_definitions": {
                        "en": "A rotating tool or device used to wind or unwind cables, hoses, or wire."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "reel",
                                "target_lang_sense_clarification": "device for winding cable or hose"
                            },
                            {
                                "target_lang_word": "spool",
                                "target_lang_sense_clarification": "cylindrical device for winding wire or cord"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1c426be5-548a-3140-9b09-a7aea41778fa",
                    "sense_definition": "Een houten of metalen frame voor het op- en afwinden van strengen garen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De wever wond de wol zorgvuldig op de oude <w>haspel</w>.",
                            "target_lang_translations": {
                                "en": "The weaver carefully wound the wool onto the old <w>yarn reel</w>."
                            }
                        },
                        {
                            "text": "In het museum staat een historische <w>haspel</w> voor garen.",
                            "target_lang_translations": {
                                "en": "In the museum, there is a historical <w>yarn swift</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "garenhaspel",
                        "garenwinder"
                    ],
                    "target_lang_definitions": {
                        "en": "A wooden or metal frame for winding and unwinding skeins of yarn."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "swift",
                                "target_lang_sense_clarification": "device used for holding and winding yarn"
                            },
                            {
                                "target_lang_word": "yarn reel",
                                "target_lang_sense_clarification": "tool for winding yarn"
                            }
                        ]
                    }
                }
            ]
        },
        {
