                    },
                    {
                        "translation_id": "c4f03051-6224-413f-ad79-b513f644aae7",
                        "source_entry_id": "0697dcb6-ea09-344d-8315-24f18b6a5323",
                        "source_sense_id": "d88a3a94-ac27-31d9-9b3a-3bbe168a6ec5",
                        "source_sense_description": "member of the Protestant Reformed Church of France during the 16th and 17th century",
                        "target_lang_word": "hugenotka",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e12a4088-1f25-4a88-8750-d29a481f0bb1",
                        "source_entry_id": "0697dcb6-ea09-344d-8315-24f18b6a5323",
                        "source_sense_id": "d88a3a94-ac27-31d9-9b3a-3bbe168a6ec5",
                        "source_sense_description": "member of the Protestant Reformed Church of France during the 16th and 17th century",
                        "target_lang_word": "hugenoot",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hugenoot",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "5a5121f7-dee7-3e1a-8b1a-99e5c19fcbcb",
                                        "entry_id": "d51ff816-fc56-35bb-ab96-9f29a6116417",
                                        "glosses": [
                                            "calvinist uit het Frankrijk van de 16de en 17de eeuw die na 1685 vogelvrij verklaard werden in Frankrijk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66632576-c514-4f66-b6fa-65a560bb5f73",
                                                "sense_id": "5a5121f7-dee7-3e1a-8b1a-99e5c19fcbcb",
                                                "text": "Het centrum van Groede ligt er in een vierkant om de kerk inderdaad nog altijd authentiek bij. De gotische kerk heeft een merkwaardige, achthoekige toren die uit de veertiende eeuw stamt. Het mooie kerkgebouw is in de zeventiende eeuw door een scheidingsmuur gesplitst in een protestantse Nederlandse kerk en een eveneens protestantse Franse kerk, die de vele hugenoten van Groede tot bedehuis diende. Aan het begin van de negentiende eeuw is die muur neergehaald. De kerk is buiten de dienst niet te bezoeken."
                                            },
                                            {
                                                "example_id": "e718c2ae-825b-4a3d-84c4-97f3943978c8",
                                                "sense_id": "5a5121f7-dee7-3e1a-8b1a-99e5c19fcbcb",
                                                "text": "Na een aantal uitstapjes naar Napels en de Vesuvius, Florence en Milaan, trok Arnout over de Alpen naar Genève, waar hij ruim een halfjaar verbleef. Deze calvinistische stad was de ideale locatie voor de jonge reiziger om zijn Frans te verbeteren, paardrijlessen te nemen en kennis te maken met de plaatselijke elite van bankiersfamilies. De laatste etappe van Arnouts reis liep via Grenoble, Marseille, Montpellier, de Hugenotendorpjes in de Loirevallei en de hoofdstad Parijs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a31fdfd-6ec8-4d24-8931-f42422b63054",
                        "source_entry_id": "0697dcb6-ea09-344d-8315-24f18b6a5323",
                        "source_sense_id": "d88a3a94-ac27-31d9-9b3a-3bbe168a6ec5",
                        "source_sense_description": "member of the Protestant Reformed Church of France during the 16th and 17th century",
                        "target_lang_word": "hugenote",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "cba2256d-6a2b-4986-9b85-d786ae98879d",
                        "source_entry_id": "0697dcb6-ea09-344d-8315-24f18b6a5323",
                        "source_sense_id": "d88a3a94-ac27-31d9-9b3a-3bbe168a6ec5",
                        "source_sense_description": "member of the Protestant Reformed Church of France during the 16th and 17th century",
                        "target_lang_word": "huguenot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "huguenot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4c36392f-2b7f-383e-8979-797efe4481be",
                                        "entry_id": "9d999ccf-6954-36d1-89ca-e30e45b0bc66",
                                        "glosses": [
                                            "Qui concerne les protestants calvinistes."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a280d694-efd2-4476-aa40-3c79bdf23409",
                                                "sense_id": "4c36392f-2b7f-383e-8979-797efe4481be",
                                                "text": "Pour le parti huguenot, qui dénonce la tyrannie des Espagnols au nom de la liberté chrétienne, la réponse n'est pas si simple. Lui aussi est pressé par le temps, lui aussi éprouve la hâte qui animait les conquistadors […]."
                                            },
                                            {
                                                "example_id": "9a8ad430-ecb7-4a21-866b-ce09416bc9bd",
                                                "sense_id": "4c36392f-2b7f-383e-8979-797efe4481be",
                                                "text": "Ce sont leurs performances sur le champ de bataille au service de la couronne française pendant les guerres de religion françaises qui en ont témoigné, notamment lors du conflit qui s'est déroulé à Dreux, où l'armée huguenote a été arrêtée par un bloc de piquiers suisses jusqu'à ce que la cavalerie catholique puisse lancer une contre-attaque."
                                            },
                                            {
                                                "example_id": "bc493e31-fec0-4e7d-b832-d8075ee215c8",
                                                "sense_id": "4c36392f-2b7f-383e-8979-797efe4481be",
                                                "text": "C’était une maison de province très modeste, où se sentait l’austérité huguenote, et dont la propreté et l’ordre irréprochables étaient le seul luxe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "huguenot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9f63fab5-5c01-3e99-9318-2fb8ead7f6e4",
                                        "entry_id": "28dcdf65-664a-3fb1-ac55-97e67caa2509",
                                        "glosses": [
                                            "Appellation donnée par leurs ennemis aux protestants calvinistes français pendant les guerres de religion."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f77bcafd-5383-4642-83d2-4edf80fe4ea9",
                                                "sense_id": "9f63fab5-5c01-3e99-9318-2fb8ead7f6e4",
                                                "text": "[…] : le roi Charles, particulièrement, avait mis à ce mariage, qui […] attirait à Paris les principaux huguenots de France, une persistance qui ressemblait à de l’entêtement."
                                            },
                                            {
                                                "example_id": "8ca9078d-b715-444f-b6d1-393c9e60470c",
                                                "sense_id": "9f63fab5-5c01-3e99-9318-2fb8ead7f6e4",
                                                "text": "L'année 1561 vit les exploits des calvinistes de Sedan et l'incendie de l'abbaye d’Hautvillers. De Rethel on envoie à Reims tous les ornements des églises pour les soustraire à la fureur des huguenots ; […]."
                                            },
                                            {
                                                "example_id": "5336b3cd-d341-4e88-86c5-46aa827f7a86",
                                                "sense_id": "9f63fab5-5c01-3e99-9318-2fb8ead7f6e4",
                                                "text": "Messieurs, continua Rohan, pourquoi le duc de Guise prétend-il nous évincer ? C’est qu’il est chef du parti catholique ; et que nous tous, messieurs, convertis ou non, nous sommes encore des huguenots."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42a8f37b-3077-4bcf-8b86-a657df4888a4",
                        "source_entry_id": "0697dcb6-ea09-344d-8315-24f18b6a5323",
                        "source_sense_id": "d88a3a94-ac27-31d9-9b3a-3bbe168a6ec5",
                        "source_sense_description": "member of the Protestant Reformed Church of France during the 16th and 17th century",
                        "target_lang_word": "huguenote",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "huguenote",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ba55c2c-e7a0-3a69-9922-c1ef8275206c",
                                        "entry_id": "c73c4692-63b4-39d5-a375-5b556d837be2",
                                        "glosses": [
                                            "Appellation donnée par leurs ennemis aux protestantes calvinistes françaises pendant les guerres de religion."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d68bf5a0-08c3-4836-bf60-f3fbc4e46ce2",
                                                "sense_id": "9ba55c2c-e7a0-3a69-9922-c1ef8275206c",
                                                "text": "C’est une terre un peu huguenote, et mes ancêtres, qui l’étaient eux aussi, y dorment leur sommeil éternel dans un petit enclos particulier, comme c’était la coutume autrefois pour ces familles hérétiques auxquelles les cimetières autour des églises étaient fermés."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "huguenote",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1d699278-1f12-34c5-a928-07b8aae84f65",
                                        "entry_id": "02e14417-391c-3f02-8a6d-80f63bb64d51",
                                        "glosses": [
                                            "Petit fourneau de terre ou de fer avec une marmite dessus, propre à faire cuire quelque chose à peu de frais."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "617831ae-ed9a-3d62-bff4-b0d513b34c9f",
                                        "entry_id": "02e14417-391c-3f02-8a6d-80f63bb64d51",
                                        "glosses": [
                                            "Récipient de terre sans pieds, propre à être mis sur le fourneau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a108dab-58e0-4bf2-963c-2a69c6caa3e9",
                                                "sense_id": "617831ae-ed9a-3d62-bff4-b0d513b34c9f",
                                                "text": "Œufs à la huguenote : Œufs cuits dans du jus de mouton."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "huguenote",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2637e5f4-8a27-3b65-9a44-a7038c8d3ef7",
                                        "entry_id": "8d5ea8e7-910d-3ec4-bc91-b77c572f77ed",
                                        "glosses": [
                                            "Féminin singulier de huguenot."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad2ffb58-93c8-4313-9106-6aa07de37c25",
                                                "sense_id": "2637e5f4-8a27-3b65-9a44-a7038c8d3ef7",
                                                "text": "Seul au premier rang du temple, il serait seul encore dans quelques instants devant la tombe construite sur un bancel de la propriété familiale, à la mode huguenote."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "681fd61e-c6e5-4f95-98d9-270e2dd5c666",
                        "source_entry_id": "0697dcb6-ea09-344d-8315-24f18b6a5323",
                        "source_sense_id": "d88a3a94-ac27-31d9-9b3a-3bbe168a6ec5",
                        "source_sense_description": "member of the Protestant Reformed Church of France during the 16th and 17th century",
                        "target_lang_word": "Hugenotte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hugenotte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "34e38e7e-8c0d-3771-8ea4-b347e1947e4a",
                                        "entry_id": "df43dbe6-5023-34a2-8c4f-d088f6777970",
                                        "glosses": [
                                            "eine calvinistisch geprägte christliche Glaubensgemeinschaft, die aus Frankreich stammt; sie kennzeichnete in der zweiten Hälfte des 16. Jahrhunderts den französischen Bürgerkrieg gegen die katholische Mehrheit des Landes"
                                        ],
                                        "tags": [
                                            "Historie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cff7d60-4bca-4492-9e28-ac3959fbd052",
                                                "sense_id": "34e38e7e-8c0d-3771-8ea4-b347e1947e4a",
                                                "text": "Einige der aus Frankreich vertriebenen Hugenotten siedelten nach Brandenburg-Preußen um."
                                            },
                                            {
                                                "example_id": "1bdac410-9425-4dc5-926c-ab4fad8585f9",
                                                "sense_id": "34e38e7e-8c0d-3771-8ea4-b347e1947e4a",
                                                "text": "„Der Bürgermeister erzählt mir, dass Strasburg mit der Ankunft der Hugenotten Ende des 17. Jahrhunderts einen enormen Aufschwung erlebte.“"
                                            },
                                            {
                                                "example_id": "6330fd2c-9361-4442-adde-960062c95756",
                                                "sense_id": "34e38e7e-8c0d-3771-8ea4-b347e1947e4a",
                                                "text": "„Es waren Nachkommen von Holländern und französischen Hugenotten, die sich seit Mitte des 17. Jahrhunderts am Kap der Guten Hoffnung niedergelassen hatten.“"
                                            },
                                            {
                                                "example_id": "c5cf599a-d8e1-4556-8e73-e707657e2364",
                                                "sense_id": "34e38e7e-8c0d-3771-8ea4-b347e1947e4a",
                                                "text": "„In dem später „Bartholomäusnacht“ genannten – staatlich angeordneten – Pogrom vom 24. August 1572 starben in Paris etwa 3.000 Hugenotten.“"
                                            },
                                            {
                                                "example_id": "5f35cc2a-9020-41d1-b2e9-14899b4e8756",
                                                "sense_id": "34e38e7e-8c0d-3771-8ea4-b347e1947e4a",
                                                "text": "„Nicht wenige Hugenotten waren zudem als Sprachlehrer tätig und trugen so zusätzlich zur Verbreitung des Französischen in allen Schichten bei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
