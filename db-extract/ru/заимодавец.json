                    },
                    {
                        "translation_id": "ef99d532-209d-444b-a4b3-8bc9bbeabbbb",
                        "source_entry_id": "491e30a4-3456-3436-9e51-79fec9ab22c2",
                        "source_sense_id": "4a2c2c1f-44ed-394a-a5fd-7d7db130b611",
                        "target_lang_word": "Geldgeber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geldgeber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c29ba5c1-66d7-3abb-9113-ab7b32769eec",
                                        "entry_id": "ecf71e54-3549-3080-b391-df61ef3ee44d",
                                        "glosses": [
                                            "jemand, der unter bestimmten Bedingungen Geld zur Verfügung stellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "905855ee-c2c0-4c1a-a4e9-cf963e2e13c5",
                                                "sense_id": "c29ba5c1-66d7-3abb-9113-ab7b32769eec",
                                                "text": "„Die Geldgeber sind unzufrieden.“"
                                            },
                                            {
                                                "example_id": "8b869875-6ea1-47bc-b73c-269db0f6d991",
                                                "sense_id": "c29ba5c1-66d7-3abb-9113-ab7b32769eec",
                                                "text": "„Anatol besass einen Pass, einen Postfahrschein, zehntausend Rubel von seiner Schwester und weitere zehntausend Rubel, die ihm Dolochow von irgendeinem Geldgeber verschafft hatte.“"
                                            },
                                            {
                                                "example_id": "95493269-a7dc-4959-b1c9-773eba17d708",
                                                "sense_id": "c29ba5c1-66d7-3abb-9113-ab7b32769eec",
                                                "text": "„Zu den Geldgebern gehörte auch der Jugendstil-Zeichner Marcus Behmer.“"
                                            },
                                            {
                                                "example_id": "f36505b1-dd3b-462f-b6c3-cc9ed233744b",
                                                "sense_id": "c29ba5c1-66d7-3abb-9113-ab7b32769eec",
                                                "text": "„Einer der Geldgeber der Stolbergs war Hans Luder, der Vater des Reformators.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03ba4ff4-2959-4325-ab8b-c63a4519434a",
                        "source_entry_id": "491e30a4-3456-3436-9e51-79fec9ab22c2",
                        "source_sense_id": "4a2c2c1f-44ed-394a-a5fd-7d7db130b611",
                        "target_lang_word": "Geldverleiher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Geldverleiher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3d2d8fa6-7e31-30d9-a133-630260c05e08",
                                        "entry_id": "c995bf6d-1223-3a04-98e3-25a119280ca9",
                                        "glosses": [
                                            "Person, die (beruflich) Geld an andere gegen Zins verleiht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e62a36cf-2627-44e0-b0f6-887a1f64ebd3",
                                                "sense_id": "3d2d8fa6-7e31-30d9-a133-630260c05e08",
                                                "text": "„Den kleinen jüdischen Geldverleihern blieb die Winkelexistenz als Pfandleiher, die sie sich mit den Lombarden teilten.“"
                                            },
                                            {
                                                "example_id": "b51f2886-e792-4cdd-b314-3fe04fdb6564",
                                                "sense_id": "3d2d8fa6-7e31-30d9-a133-630260c05e08",
                                                "text": "„Bald schon amtierte Thomas denn als Beichtvater, Geldverleiher, Ratgeber in juristischen und medizinischen Fragen und als nimmermüder Zuhörer, wenn sich ihm die innersten Kammern weiblicher Herzen öffneten.“"
                                            },
                                            {
                                                "example_id": "fa18c751-4390-4456-995b-d65841d92c70",
                                                "sense_id": "3d2d8fa6-7e31-30d9-a133-630260c05e08",
                                                "text": "„Während der Kleinstsparer in der Not nach einem Pfennig im Spartopf angelt, fürchten sich Kaufleute und Geldverleiher vor Kapitalvernichtung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "feac8bac-035f-42da-9bd8-56c6e10b2190",
                        "source_entry_id": "491e30a4-3456-3436-9e51-79fec9ab22c2",
                        "source_sense_id": "4a2c2c1f-44ed-394a-a5fd-7d7db130b611",
                        "target_lang_word": "Gläubiger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gläubiger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e470a0b3-8619-3e97-aa4f-7c35048b5fc6",
                                        "entry_id": "2a8945f3-6583-3453-8928-cc63d12ffa35",
                                        "glosses": [
                                            "jemand, der einem Schuldner gegenüber anspruchsberechtigt ist"
                                        ],
                                        "tags": [
                                            "finance"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3198cf88-224b-4037-b802-4e5cdbbd3121",
                                                "sense_id": "e470a0b3-8619-3e97-aa4f-7c35048b5fc6",
                                                "text": "Die Gläubiger haben dem angeschlagenen Unternehmen einen Zahlungsaufschub gewährt."
                                            },
                                            {
                                                "example_id": "f1bb5033-b8fb-4401-b51a-1c04d1de23b1",
                                                "sense_id": "e470a0b3-8619-3e97-aa4f-7c35048b5fc6",
                                                "text": "„Sie beglich auch bei allen anderen Gläubigern die Spielschulden ihres Vaters.“"
                                            },
                                            {
                                                "example_id": "2e9f1ffb-a9a3-4d91-8fd7-9c723284f452",
                                                "sense_id": "e470a0b3-8619-3e97-aa4f-7c35048b5fc6",
                                                "text": "„Und so streiten die Gläubiger.“"
                                            },
                                            {
                                                "example_id": "17d86dbf-6784-4cd6-ab7e-efcd997b2040",
                                                "sense_id": "e470a0b3-8619-3e97-aa4f-7c35048b5fc6",
                                                "text": "„Seine Gläubiger waren so anständig gewesen, ihn im Besitz eines kleinen Restes seines väterlichen Vermögens zu lassen, dessen Zinsen bei äußerster Sparsamkeit zu einem sehr bescheidenen Leben hinreichten, ihm jedoch auch nicht den kleinsten Luxus gestatteten.“"
                                            },
                                            {
                                                "example_id": "c0d886c0-4fff-4d9f-944b-d943d8bffa64",
                                                "sense_id": "e470a0b3-8619-3e97-aa4f-7c35048b5fc6",
                                                "text": "„1523 und 1524 eskalierte er im Eisenacher Wucherstreit zu tumultartigen Auseinandersetzungen zwischen Schuldnern und Gläubigern, von denen die geistlichen Institutionen und Klöster besonderen Hass auf sich zogen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Gläubiger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d99bc313-f426-3358-a239-e78949534870",
                                        "entry_id": "7a2fd369-8c9a-3cd5-9833-6c986a283c6b",
                                        "glosses": [
                                            "Person, die gläubig ist, Ausübender eines Glaubens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17e440ec-4d9b-4c6b-8df0-2b02cf807172",
                                                "sense_id": "d99bc313-f426-3358-a239-e78949534870",
                                                "text": "„Fleisch, das aus Schlachtungen mit Kurzzeitbetäubung stammt, entspricht aus Sicht vieler Gläubiger nicht den religiösen Geboten.“"
                                            },
                                            {
                                                "example_id": "51d59826-114e-49aa-b222-1ca75548ff45",
                                                "sense_id": "d99bc313-f426-3358-a239-e78949534870",
                                                "text": "„Die Sonne bestimmt in großem Maße das Alltagsleben der Gläubigen, richtet sich doch der Zeitpunkt der täglichen fünf Gebete nach dem Auf- und Untergang des Gestirns aus.“"
                                            },
                                            {
                                                "example_id": "a4fa1b29-671d-440e-b839-c3cbc15d114e",
                                                "sense_id": "d99bc313-f426-3358-a239-e78949534870",
                                                "text": "„Herbei, o ihr Gläubigen, / fröhlich triumphierend, / o kommet, o kommet nach Bethlehem!“"
                                            },
                                            {
                                                "example_id": "d3a1da2d-9ae3-4c78-ad4e-6aeac4ca2d17",
                                                "sense_id": "d99bc313-f426-3358-a239-e78949534870",
                                                "text": "„Damals pilgerten immer mehr Gläubige in das geheimnisvolle Tal, um in der unscheinbaren Kapelle vor dem Gnadenbild zu beten.“"
                                            },
                                            {
                                                "example_id": "cb6e2d1e-cbba-4ca8-9916-ee8920ebf574",
                                                "sense_id": "d99bc313-f426-3358-a239-e78949534870",
                                                "text": "Komm, Gläubiger, bete mit mir."
                                            },
                                            {
                                                "example_id": "90b11c1b-e233-415a-9829-4631ee4eaca2",
                                                "sense_id": "d99bc313-f426-3358-a239-e78949534870",
                                                "text": "Gläubiger, was würde dein Gott dazu sagen?."
                                            },
                                            {
                                                "example_id": "988db900-20ea-4e00-b0ac-dfc75763465c",
                                                "sense_id": "d99bc313-f426-3358-a239-e78949534870",
                                                "text": "Ein Gläubiger kam nach dem Gottesdienst mit einer Frage zum Priester."
                                            }
