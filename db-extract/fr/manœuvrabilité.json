                    }
                ],
                "senses": [
                    {
                        "sense_id": "13cfbe37-144c-393f-aaca-a1227ff696ff",
                        "entry_id": "54feba03-0f72-3683-b8da-4f63d6c237a9",
                        "glosses": [
                            "Qualité de ce qui est manœuvrable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "137d9362-d4a8-475a-8eb6-169dd0301db3",
                                "sense_id": "13cfbe37-144c-393f-aaca-a1227ff696ff",
                                "text": "La manœuvrabilité des poissons est également extraordinaire, puisqu’ils sont capables de changer de direction sans ralentir, avec un rayon de giration d’à peine dix à trente pour cent de leur longueur, alors que les navires, par exemple, doivent réduire leur vitesse de moitié pour un rayon de giration qui vaut encore de une à trois fois leur longueur."
                            },
                            {
                                "example_id": "e2d5be9f-3e45-475c-b0d4-bd8e04adb38d",
                                "sense_id": "13cfbe37-144c-393f-aaca-a1227ff696ff",
                                "text": "Des test effectués sur la totalité de l'enveloppe de vol ont confirmé un excellent comportement en vol, une manœuvrabilité qui permet au X³ de rivaliser avec les meilleurs hélicoptères de conception traditionnelle […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "760321b9-4208-43b8-8f1c-4092f023e621",
                        "source_entry_id": "54feba03-0f72-3683-b8da-4f63d6c237a9",
                        "source_sense_id": "13cfbe37-144c-393f-aaca-a1227ff696ff",
                        "target_lang_word": "manoeuvrability",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manoeuvrability",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e2ecd54-b335-3329-9730-2150dd256ea1",
                                        "entry_id": "74b932fe-e789-3e1d-b310-02fb1d32196c",
                                        "glosses": [
                                            "The quality of being manoeuvrable; ability to be manoeuvred."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "148b8c17-e752-47e0-899b-f1094eb134b4",
                                                "sense_id": "1e2ecd54-b335-3329-9730-2150dd256ea1",
                                                "text": "Articulated buses were invented to improve the manoeuvrability of long buses capable of carrying a large number of passengers."
                                            },
                                            {
                                                "example_id": "026d98af-23cd-4905-9d73-8f54725d1e8d",
                                                "sense_id": "1e2ecd54-b335-3329-9730-2150dd256ea1",
                                                "text": "She became disrespectfully referred to locally as the \"Crab\" on account of her extraordinary manoeuvrability."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "754cb6d4-ba24-37af-aade-b31b8f37c53f",
                                        "entry_id": "74b932fe-e789-3e1d-b310-02fb1d32196c",
                                        "glosses": [
                                            "Ability to manoeuvre; ability to carry out a manoeuvre or strategic plan."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec2634cb-6537-41ba-bf9c-022e0160b0d1",
                                                "sense_id": "754cb6d4-ba24-37af-aade-b31b8f37c53f",
                                                "text": "My manoeuvrability is limited. I don't have many options left."
                                            },
                                            {
                                                "example_id": "066c3713-ac3f-4556-9403-93a6739e40e9",
                                                "sense_id": "754cb6d4-ba24-37af-aade-b31b8f37c53f",
                                                "text": "The prohibit[ed] zone cuts across the isthmus about 200 yards north of the runway; the pilot's manoeuvrability, approaching from the has been reduced by about half. The ban was announced 01 April 12, days before the Anglo-Spanish talks on ..."
                                            },
                                            {
                                                "example_id": "1d241a51-e451-42cf-90b8-58817fc3e8ad",
                                                "sense_id": "754cb6d4-ba24-37af-aade-b31b8f37c53f",
                                                "text": "The desire to break away from this, to develop Zambia's economic character and increase Lusaka's manoeuvrability, thus became a guiding light of Zambian foreign policy (Anglin and Shaw, 1979; Shaw, 1976; Burdette, 1984) and has been termed 'the politics of disengagement' (Tordoff, 1977)."
                                            },
                                            {
                                                "example_id": "8c59d190-cfcf-4770-8410-8ad7e5805dd5",
                                                "sense_id": "754cb6d4-ba24-37af-aade-b31b8f37c53f",
                                                "text": "This might be due to the nature of the work done, to the motivation to work or to the total burden that women in the lower socioeconomic group bear in comparison with those who are better off and have greater 'manoeuvrability'."
                                            },
                                            {
                                                "example_id": "97e8ef52-ed85-46fa-b0c3-227f04babea3",
                                                "sense_id": "754cb6d4-ba24-37af-aade-b31b8f37c53f",
                                                "text": "Some hated him for his attitude while others, including Shirmin, fancied his manoeuvrability and stark mannerism."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
