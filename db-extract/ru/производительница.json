                                        "entry_id": "f0cd59f7-f087-3c1e-bac6-03f80c2562c7",
                                        "glosses": [
                                            "An individual or organization that creates goods and services."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "097ae0ba-70ee-4247-bf67-9bac1ae24c7e",
                                                "sense_id": "dd6bfc49-f23c-3687-b2ec-d6009a62f5df",
                                                "text": "But through the oligopoly, charcoal fuel proliferated throughout London's trades and industries. By the 1200s, brewers and bakers, tilemakers, glassblowers, pottery producers, and a range of other craftsmen all became hour-to-hour consumers of charcoal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12a3bb22-16e2-3972-8b29-f23731e12bbe",
                                        "entry_id": "f0cd59f7-f087-3c1e-bac6-03f80c2562c7",
                                        "glosses": [
                                            "One who produces an artistic production, such as an album, a theater production, a film, a TV program, a video game, and so on."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ea6d6996-9629-39b1-aae3-3b0f2540b86c",
                                        "entry_id": "f0cd59f7-f087-3c1e-bac6-03f80c2562c7",
                                        "glosses": [
