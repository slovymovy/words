                    "frequency": "Middle",
                    "semantic_group_id": "wegnehmen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Dieb rannte plötzlich vorbei und <w>entriss</w> der älteren Dame die Handtasche."
                        },
                        {
                            "text": "Mit schnellen Reflexen gelang es der Polizistin, dem Angreifer die Waffe zu <w>entreißen</w>."
                        }
                    ],
                    "synonyms": [
