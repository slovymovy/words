                "senses": [
                    {
                        "sense_id": "3cfd153f-465b-375f-8f96-d36672376a50",
                        "entry_id": "bd1935de-7b3d-3f24-98f5-df37b743afb5",
                        "glosses": [
                            "nicht ständige Streitkräfte als Ergänzung der Kampftruppe; Kampfeinheit, die als Mitglieder Einwohner/Betroffene/Bürger hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28d16db2-6caf-4326-9052-64fb4860c6d2",
                                "sense_id": "3cfd153f-465b-375f-8f96-d36672376a50",
                                "text": "„Der Vorteil einer Bürgermiliz wird von Machiavelli auf die geringeren Kosten sowie die höhere Zuverlässigkeit und Motivation von Wehrdienstleistenden zurückgeführt.“"
                            },
                            {
                                "example_id": "423aa8be-e64b-45f8-883a-5b4378e1bfc6",
                                "sense_id": "3cfd153f-465b-375f-8f96-d36672376a50",
                                "text": "„Die Bürgermiliz stellt Schriftstücke zu, falls die Zustellung im Zusammenhang mit einer Handlung steht, welche der Bürgermiliz vom Gericht oder vom Staatsanwalt aufgetragen worden ist.“"
                            },
                            {
                                "example_id": "c04de436-3406-4a2c-9b6f-cde69bb4e30a",
                                "sense_id": "3cfd153f-465b-375f-8f96-d36672376a50",
                                "text": "„Der Chef berichtete über die Übung der Bürgermiliz und die drei verletzten Männer.“"
                            },
                            {
                                "example_id": "6b8b7121-8d15-478e-a557-a0aa7aa0dc16",
                                "sense_id": "3cfd153f-465b-375f-8f96-d36672376a50",
                                "text": "„Bei unserer Suche nach der Herkunft der Waffen stießen wir auf eine Bürgermiliz in Springfield und auf den Waffenhändler Edgar Mason.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
