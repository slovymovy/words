                "senses": [
                    {
                        "sense_id": "95e350de-2aae-373c-9aec-0b1a2879972c",
                        "entry_id": "a00008ae-49ef-32f8-bc35-7935aaaced6d",
                        "glosses": [
                            "codierendes Segment der DNA bei Eukaryoten"
                        ],
                        "tags": [
                            "Genetik"
                        ],
                        "examples": [
                            {
                                "example_id": "4f5eb494-76a2-4a22-9573-1e59f10b327b",
                                "sense_id": "95e350de-2aae-373c-9aec-0b1a2879972c",
                                "text": "„Doch auch in den Genen selbst ist die Erbinformation für ein Eiweiß auf Pakete verteilt, die Exons.“"
                            },
                            {
                                "example_id": "5db160ef-bec9-4f07-9c3e-fc6d1cc632c2",
                                "sense_id": "95e350de-2aae-373c-9aec-0b1a2879972c",
                                "text": "„Jedes Exon enthält die Bauanweisung für einen bestimmten Bereich eines Eiweißes.“"
                            },
                            {
                                "example_id": "2fc93def-5321-4a6b-a2ce-c4853e45b3db",
                                "sense_id": "95e350de-2aae-373c-9aec-0b1a2879972c",
                                "text": "„Das für das Apo B codierende Gen enthält 18 Exonen bei einer Gesamtlänge von 43 kb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
