{
    "word_family": [
        "squelcher",
        "squelchy"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5293d3b1-9014-3930-b589-0e9c034e75a9",
                    "sense_definition": "To halt, stop, eliminate, or suppress something, often suddenly or by force.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "suppress",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Even the king's official announcement could not <w>squelch</w> the growing rumors of rebellion.",
                            "target_lang_translations": {
                                "ru": "Даже официальное заявление короля не смогло <w>пресечь</w> растущие слухи о восстании."
                            }
                        },
                        {
                            "text": "The company tried to <w>squelch</w> dissent by banning employees from discussing their salaries.",
                            "target_lang_translations": {
                                "ru": "Компания пыталась <w>подавить</w> инакомыслие, запретив сотрудникам обсуждать свои зарплаты."
                            }
                        }
                    ],
                    "synonyms": [
                        "quash"
                    ],
                    "common_phrases": [
                        "squelch the rumors",
                        "squelch dissent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Остановить, подавить, пресечь или устранить что-либо, часто внезапно или силой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подавлять",
                                "target_lang_sense_clarification": "слухи, инакомыслие"
                            },
                            {
                                "target_lang_word": "пресекать",
                                "target_lang_sense_clarification": "попытки, недовольство"
                            },
                            {
                                "target_lang_word": "уничтожать",
                                "target_lang_sense_clarification": "в зародыше"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a75b2a57-a974-39b4-ac04-cf85e8a6020a",
                    "sense_definition": "To make a sucking, splashing noise, such as when walking through wet mud.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mud_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wet mud <w>squelched</w> underfoot as we slowly made our way across the flooded field.",
                            "target_lang_translations": {
                                "ru": "Мокрая грязь <w>хлюпала</w> под ногами, пока мы медленно пробирались по затопленному полю."
                            }
                        },
                        {
                            "text": "Every step they took in their soaked boots would <w>squelch</w> loudly in the quiet forest.",
                            "target_lang_translations": {
                                "ru": "Каждый шаг в промокших сапогах громко <w>чавкал</w> в тихом лесу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "squelch underfoot"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать хлюпающий, всасывающий звук, например, при ходьбе по мокрой грязи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хлюпать",
                                "target_lang_sense_clarification": "издавать звук при ходьбе по грязи"
                            },
                            {
                                "target_lang_word": "чавкать",
                                "target_lang_sense_clarification": "о грязи под ногами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b7e5093-fe1b-33c9-aeab-0b2e80cc2129",
                    "sense_definition": "To walk or step heavily through a wet, muddy, or squishy substance.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mud_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had to <w>squelch</w> through the thick mud for miles before reaching the main road.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось мили напролет <w>шлепать</w> по густой грязи, прежде чем мы добрались до главной дороги."
                            }
                        },
                        {
                            "text": "The children loved to <w>squelch</w> through the wet grass after a heavy summer rain.",
                            "target_lang_translations": {
                                "ru": "Дети обожали <w>бегать</w> по мокрой траве после сильного летнего дождя."
                            }
                        }
                    ],
                    "common_phrases": [
                        "squelch through the mud"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тяжело идти или шагать по мокрой, грязной или вязкой поверхности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шлепать",
                                "target_lang_sense_clarification": "идти по грязи или воде"
                            },
                            {
                                "target_lang_word": "хлюпать",
                                "target_lang_sense_clarification": "идти, издавая хлюпающие звуки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e182e9f0-cb44-3bb2-91eb-78416881d196",
                    "sense_definition": "To suppress unwanted static or hiss between radio transmissions by adjusting a signal threshold.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "radio_squelch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to adjust the receiver to <w>squelch</w> the background static between calls.",
                            "target_lang_translations": {
                                "ru": "Вам нужно настроить приемник, чтобы <w>подавить</w> фоновые статические помехи между вызовами."
                            }
                        },
                        {
                            "text": "The operator managed to <w>squelch</w> the noise so they could hear the weak signal clearly.",
                            "target_lang_translations": {
                                "ru": "Оператору удалось <w>заглушить</w> шум, чтобы отчетливо расслышать слабый сигнал."
                            }
                        }
                    ],
                    "common_phrases": [
                        "squelch the static"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term used in telecommunications"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подавлять нежелательные статические помехи или шипение между радиопередачами путем настройки порога сигнала."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подавлять",
                                "target_lang_sense_clarification": "шумы или помехи в радиоприемнике"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "215dae1d-12c4-3648-b868-f725dbfd886e",
                    "sense_definition": "A wet, sucking, or splashing sound.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mud_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With a loud <w>squelch</w>, his boot sank deep into the marshy ground.",
                            "target_lang_translations": {
                                "ru": "С громким <w>хлюпаньем</w> его сапог глубоко погрузился в болотную почву."
                            }
                        },
                        {
                            "text": "She heard the wet <w>squelch</w> of footsteps approaching through the dark bog.",
                            "target_lang_translations": {
                                "ru": "Она услышала влажное <w>чавканье</w> приближающихся шагов сквозь темное болото."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wet squelch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Влажный, всасывающий или хлюпающий звук."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хлюпанье",
                                "target_lang_sense_clarification": "звук шагов по грязи"
                            },
                            {
                                "target_lang_word": "чавканье",
                                "target_lang_sense_clarification": "звук вязкой грязи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b76568a4-112a-3d9c-b287-57d11790db56",
                    "sense_definition": "The suppression of unwanted static or hiss in a radio receiver, or the control mechanism that does this.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "radio_squelch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Turn up the <w>squelch</w> on the radio to block out that annoying background hiss.",
                            "target_lang_translations": {
                                "ru": "Прибавьте <w>шумоподавитель</w> на радио, чтобы заглушить это раздражающее фоновое шипение."
                            }
                        },
                        {
                            "text": "If the <w>squelch</w> is set too high, you might miss weak incoming transmissions.",
                            "target_lang_translations": {
                                "ru": "Если <w>порог шумоподавления</w> установлен слишком высоко, вы можете пропустить слабые входящие передачи."
                            }
                        }
                    ],
                    "common_phrases": [
                        "adjust the squelch"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term used in telecommunications"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подавление нежелательного статического шума или шипения в радиоприемнике, либо механизм управления, выполняющий эту функцию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шумоподавитель",
                                "target_lang_sense_clarification": "устройство или регулятор в радиоприемнике"
                            },
                            {
                                "target_lang_word": "шумоподавление",
                                "target_lang_sense_clarification": "процесс подавления эфирного шума"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d500b93-3d57-3d45-9ee0-81116d98c227",
                    "sense_definition": "A distinctive electronic synthesizer sound or beat, characteristic of acid house music.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "music_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The track is famous for its heavy bassline and iconic acid <w>squelch</w> sound.",
                            "target_lang_translations": {
                                "ru": "Трек знаменит своей тяжелой басовой линией и культовым кислотным <w>сквелч-звуком</w>."
                            }
                        },
                        {
                            "text": "He tweaked the synthesizer filter to produce a sharp, resonant <w>squelch</w>.",
                            "target_lang_translations": {
                                "ru": "Он подкрутил фильтр синтезатора, чтобы получить резкий, резонирующий <w>хлюпающий звук</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "acid squelch"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "used in electronic music contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Характерный электронный звук синтезатора или бит, типичный для музыки в стиле эйсид-хаус."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сквелч",
                                "target_lang_sense_clarification": "специфический звук синтезатора"
                            },
                            {
                                "target_lang_word": "хлюпающий звук",
                                "target_lang_sense_clarification": "в электронной музыке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b751ebf7-a0c8-332a-9ef9-9ef316ca9db7",
                    "sense_definition": "A heavy blow, impact, or fall.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He fell to the ground with a heavy <w>squelch</w> after slipping on the wet grass.",
                            "target_lang_translations": {
                                "ru": "Он поскользнулся на мокрой траве и с тяжелым <w>шлепком</w> повалился на землю."
                            }
                        },
                        {
                            "text": "The heavy box landed with a dull <w>squelch</w> on the muddy lawn.",
                            "target_lang_translations": {
                                "ru": "Тяжелая коробка с глухим <w>звуком удара</w> приземлилась на грязный газон."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rare or older usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тяжелый удар, столкновение или падение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шлепок",
                                "target_lang_sense_clarification": "звук падения в грязь"
                            },
                            {
                                "target_lang_word": "глухой удар",
                                "target_lang_sense_clarification": "при падении на мягкую поверхность"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}