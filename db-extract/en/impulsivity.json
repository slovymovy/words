                                        "glosses": [
                                            "Caractère impulsif (d’un individu)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f919952-4f85-412f-9000-72023d710dc2",
                                                "sense_id": "c70e8111-ec2a-3b02-bd6f-a083b6eaf384",
                                                "text": "L’impulsivité se définit donc simplement par ses effets : vos comportements sont prématurés, inappropriés et ne tiennent pas compte de conséquences qui s’avèrent souvent, après-coup, désagréables."
                                            },
                                            {
                                                "example_id": "c2f2bb7e-5027-4efc-91b2-1ad2a1669239",
                                                "sense_id": "c70e8111-ec2a-3b02-bd6f-a083b6eaf384",
                                                "text": "Tempérez votre impulsivité."
                                            }
                                        ]
                                    }
