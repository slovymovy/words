{
    "word_family": [
        "namaak",
        "maken"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3aeec1ab-0453-3115-929a-4a92ede0f770",
                    "sense_definition": "een kopie of extra exemplaar van iets vervaardigen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kopiëren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De slotenmaker kon deze speciale sleutel eenvoudig <w>namaken</w> in zijn werkplaats.",
                            "target_lang_translations": {
                                "en": "The locksmith could easily <w>duplicate</w> this special key in his workshop."
                            }
                        },
                        {
                            "text": "Ik <w>maakte</w> het oude houten onderdeel precies <w>na</w> om de kast te repareren.",
                            "target_lang_translations": {
                                "en": "I <w>replicated</w> the old wooden part exactly to repair the cabinet."
                            }
                        }
                    ],
                    "synonyms": [
                        "kopiëren",
                        "dupliceren"
                    ],
                    "common_phrases": [
                        "een sleutel namaken"
                    ],
                    "target_lang_definitions": {
                        "en": "to make a copy, duplicate, or reproduction of something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "copy",
                                "target_lang_sense_clarification": "make a physical duplicate or reproduction"
                            },
                            {
                                "target_lang_word": "duplicate",
                                "target_lang_sense_clarification": "make an identical copy, such as a key or part"
                            },
                            {
                                "target_lang_word": "replicate",
                                "target_lang_sense_clarification": "reproduce an exact version of an object"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "558d8129-3414-3872-8229-e6f018f135ec",
                    "sense_definition": "iets nabootsen of vervalsen naar een bestaand voorbeeld",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "imiteren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De pasjes werden erg professioneel <w>nagemaakt</w> door de fraudeurs.",
                            "target_lang_translations": {
                                "en": "The badges were very professionally <w>forged</w> by the fraudsters."
                            }
                        },
                        {
                            "text": "Criminelen proberen waardevolle schilderijen zo nauwkeurig mogelijk <w>na</w> te <w>maken</w>.",
                            "target_lang_translations": {
                                "en": "Criminals try to <w>forge</w> valuable paintings as accurately as possible."
                            }
                        }
                    ],
                    "synonyms": [
                        "imiteren",
                        "nabootsen",
                        "vervalsen"
                    ],
                    "common_phrases": [
                        "merkkleding namaken",
                        "geld namaken"
                    ],
                    "target_lang_definitions": {
                        "en": "to imitate, fake, or forge based on an existing model"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "forge",
                                "target_lang_sense_clarification": "fraudulently produce a copy of documents or art"
                            },
                            {
                                "target_lang_word": "counterfeit",
                                "target_lang_sense_clarification": "illegally imitate money, goods, or documents"
                            },
                            {
                                "target_lang_word": "imitate",
                                "target_lang_sense_clarification": "mimic or copy the appearance or style of"
                            },
                            {
                                "target_lang_word": "fake",
                                "target_lang_sense_clarification": "produce an illegitimate imitation"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "551be634-ffe9-3471-a896-4ab4ff4d98dd",
                    "sense_definition": "meervoud van <w>namaak</w>",
                    "learner_level": "B2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op die markt vind je veel goedkope <w>namaken</w> van bekende tassen.",
                            "target_lang_translations": {
                                "en": "At that market you will find many cheap <w>knockoffs</w> of well-known bags."
                            }
                        },
                        {
                            "text": "De deskundige kon de echte horloges direct van de <w>namaken</w> onderscheiden.",
                            "target_lang_translations": {
                                "en": "The expert could immediately distinguish the genuine watches from the <w>fakes</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "imitaties",
                        "vervalsingen"
                    ],
                    "antonyms": [
                        "originelen"
                    ],
                    "target_lang_definitions": {
                        "en": "plural of namaak; imitations, fakes, or knockoffs"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fakes",
                                "target_lang_sense_clarification": "counterfeit items or fraudulent copies"
                            },
                            {
                                "target_lang_word": "imitations",
                                "target_lang_sense_clarification": "copies of original goods"
                            },
                            {
                                "target_lang_word": "knockoffs",
                                "target_lang_sense_clarification": "cheap unauthorized copies of branded goods"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}