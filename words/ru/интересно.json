                            },
                            {
                                "target_lang_word": "interested",
                                "target_lang_sense_clarification": "used when describing a person's feeling (e.g., 'I am interested')"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有意思",
