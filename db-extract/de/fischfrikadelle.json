                "senses": [
                    {
                        "sense_id": "76387602-39b4-3bb1-bd2e-a0e576fdf3c8",
                        "entry_id": "418bfa4f-7d56-3420-ab80-a10ab03bb258",
                        "glosses": [
                            "gebratene Scheibe aus Fischfleisch"
                        ],
                        "tags": [
                            "Kulinarik"
                        ],
                        "examples": [
                            {
                                "example_id": "97a7e054-6bf5-4358-a7c7-058105f436f3",
                                "sense_id": "76387602-39b4-3bb1-bd2e-a0e576fdf3c8",
                                "text": "„Das leicht graue Fleisch nimmt beim Garen eine hellere Farbe an und lässt sich gut für Fischfrikadellen verwenden.“"
                            },
                            {
                                "example_id": "64d1f3d7-d608-4c4b-a114-91dacad9f657",
                                "sense_id": "76387602-39b4-3bb1-bd2e-a0e576fdf3c8",
                                "text": "„Der Wiesn-Burger aus Bremen, mit süßem Senf, Krautsalat und Fischfrikadelle.“"
                            },
                            {
                                "example_id": "c1f7bd9c-e6cc-466f-ad4f-bad03542eb4c",
                                "sense_id": "76387602-39b4-3bb1-bd2e-a0e576fdf3c8",
                                "text": "„Zum krönenden Abschluss wurden die Fische frisch zubereitet und landeten als Rheinfisch frittiert mit und ohne Bierteig, Fischfrikadelle oder Fischsuppe auf dem Teller der Teilnehmer.“"
                            },
                            {
                                "example_id": "9f0288aa-4756-400f-86da-8c5dbc67bfda",
                                "sense_id": "76387602-39b4-3bb1-bd2e-a0e576fdf3c8",
                                "text": "„Das Speisenangebot umfasst unter anderem gebackene Fische (Forelle, Karpfenfilet, Hechtfilet, Zanderfilet) mit hausgemachtem Kartoffelsalat, geräucherte Forelle, Fischfrikadellen, gebeizten Lachs, Lachs- und Fischsemmeln.“"
                            },
                            {
                                "example_id": "82bfb71c-da02-4a9a-9d0a-d19250fc320c",
                                "sense_id": "76387602-39b4-3bb1-bd2e-a0e576fdf3c8",
                                "text": "„Auch Fischfrikadellen oder Fischstäbchen werden verwendet; die Variante mit Fischfrikadelle wird auch als Fischburger bezeichnet, in Anlehnung an Hamburger auch Bremer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
