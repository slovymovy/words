                "senses": [
                    {
                        "sense_id": "d30676df-2403-35a0-9f7e-8e19fad81db5",
                        "entry_id": "ce4b4635-9722-327a-abff-8b879b8984af",
                        "glosses": [
                            "grote begraafplaats meestal stammende uit de klassieke oudheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65bb3664-21ac-47f0-8750-66af9f86726b",
                                "sense_id": "d30676df-2403-35a0-9f7e-8e19fad81db5",
                                "text": "Voor de oorlog kwamen er jaarlijks 150.000 toeristen naar Palmyra voor de prachtige standbeelden en indrukwekkende necropolis met meer dan 500 tombes. De ‘Stad van Duizend Zuilen’ roept mooie herinneringen op bij iedereen die er geweest is, maar de laatste foto’s op TripAdvisor dateren van begin 2012. In de eerste jaren leek het Unesco Werelderfgoed te ontsnappen aan de spiraal van geweld, tot Islamitische Staat de stad veroverde."
                            },
                            {
                                "example_id": "3b243735-e8c9-41dd-a4ac-a434a2b5f098",
                                "sense_id": "d30676df-2403-35a0-9f7e-8e19fad81db5",
                                "text": "De naam van de koningin, Chentkaus, stond in een inscriptie op een wand in het necropolis. Volgens de Egyptische minister van Oudheden, Mamdouh el-Damaty, gaat het om Chentkaus III."
                            }
                        ]
                    }
