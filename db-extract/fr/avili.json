                "senses": [
                    {
                        "sense_id": "ae9a9dcc-6412-3f84-8219-f714000c3408",
                        "entry_id": "39559457-cfc7-3ff6-9dae-525acf260b4d",
                        "glosses": [
                            "Qui est devenu vil."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "862c4f9d-6578-4316-8627-c3656ec42887",
                                "sense_id": "ae9a9dcc-6412-3f84-8219-f714000c3408",
                                "text": "Et plus tard, son mariage, qui avait été plus qu’un sacrifice, un marché, un compromis pour sauver la situation embarrassée de son père ! Et ses dégoûts, et ses révoltes de se sentir, morceau de chair avili, la proie, l’instrument passif des plaisirs d’un homme !"
                            }
                        ]
                    },
