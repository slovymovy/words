                        "form": "grismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bf4db337-aed8-3762-b9eb-5fbe59c33315",
                        "entry_id": "82326b18-0628-37ee-9404-052b5ee3416f",
                        "glosses": [
                            "Prisme dont l’une des faces est usinée de façon à former un réseau de diffraction afin de ne laisser passer qu’une seule longueur d’onde du faisceau de lumière incident."
                        ],
                        "tags": [
                            "Optique"
                        ],
                        "examples": [
                            {
                                "example_id": "28e251f1-f6ba-4f97-8894-10549a07b5b4",
                                "sense_id": "bf4db337-aed8-3762-b9eb-5fbe59c33315",
                                "text": "Le dispositif optique de l’imageur proche infrarouge NIRISS du télescope spatial James-Webb comporte un grisme."
                            },
                            {
                                "example_id": "6ccd166f-da01-4cf4-95d1-0a8b6f01c4f2",
                                "sense_id": "bf4db337-aed8-3762-b9eb-5fbe59c33315",
                                "text": "Chaque microlentille, placée dans un plan focal, découpe le champ en éléments dont le spectre est donné par un grisme. L’angle de dispersion doit être judicieusement choisi pour que les spectres ne se chevauchent pas."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0be005c-9b44-4967-a4cb-2413e419c3ef",
                        "source_entry_id": "82326b18-0628-37ee-9404-052b5ee3416f",
                        "source_sense_id": "bf4db337-aed8-3762-b9eb-5fbe59c33315",
                        "target_lang_word": "grism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b44d49c-cb17-3a05-b9fd-34f1add0c8b4",
                                        "entry_id": "ce767003-6ac6-3233-9275-8c83512c286a",
                                        "glosses": [
                                            "A combination of diffraction grating and prism used to obtain spectra from selected parts of an image."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac606534-4d3c-4c2c-988b-77ea9d2791a7",
                                                "sense_id": "8b44d49c-cb17-3a05-b9fd-34f1add0c8b4",
                                                "text": "The advantage of grisms is that the same camera can be used both for imaging (without the grism) and spectroscopy (with the grism) without having to be moved."
                                            },
                                            {
                                                "example_id": "ef67f40b-e3c9-4b1f-959e-7d5b7b4141c0",
                                                "sense_id": "8b44d49c-cb17-3a05-b9fd-34f1add0c8b4",
                                                "text": "If this grism is placed in an ƒ/4 beam at s = 120 mm, the plate factor P ≈ 1100 Å/mm."
                                            },
                                            {
                                                "example_id": "6011821c-46a1-4ec6-ac11-656b0f29f562",
                                                "sense_id": "8b44d49c-cb17-3a05-b9fd-34f1add0c8b4",
                                                "text": "As the name implies, grisms are a combination of a transmission grating and a prism. One common configuration uses the refraction at the grism surface to redirect nonzero diffractive orders along the original optical path."
                                            },
                                            {
                                                "example_id": "c458537b-b218-45bd-a88a-090bd0c016f6",
                                                "sense_id": "8b44d49c-cb17-3a05-b9fd-34f1add0c8b4",
                                                "text": "The grism usually consists of an SR transmission grating mounted on the hypotenuse of a right-angle prism.[…]Volumetric phase holographic grisms, which are capable of relatively high angular dispersions, have begun to appear."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
