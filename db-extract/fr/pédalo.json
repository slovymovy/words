                                "target_senses": [
                                    {
                                        "sense_id": "42765ea7-2808-30cd-9b34-39524a28d067",
                                        "entry_id": "a4437798-86b2-31ec-acec-f94ec8494a1d",
                                        "glosses": [
                                            "kleineres Boot für Vergnügungsfahrten mit einer Tretkurbel als Antriebsquelle"
                                        ],
                                        "tags": [
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8fa8a00-fbe4-4858-9549-25c3cd5335f4",
                                                "sense_id": "42765ea7-2808-30cd-9b34-39524a28d067",
                                                "text": "„Pedalos und Ruderboote, die sich mehr als 300 Meter vom Ufer entfernen, müssen auf dem Bodensee künftig mit Rettungswesten ausgerüstet sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be662434-dedd-4364-98dc-40651c64bcb7",
                        "source_entry_id": "e2e38348-ce14-336f-8a3b-bce7d72f2960",
                        "source_sense_id": "201143a5-04af-3936-9878-10c5c435da7d",
