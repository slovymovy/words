                    {
                        "translation_id": "4fbffdca-20d3-4e79-b965-48750b4b7b9f",
                        "source_entry_id": "26e8bf21-bdcc-38e8-bd37-30d3f0c1efc3",
                        "source_sense_id": "f242d4e8-493a-37db-9b06-b402dac39ed9",
                        "source_sense_description": "met de blauwgroene kleur turkoois.",
                        "target_lang_word": "turquoise",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "turquoise",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9b73b550-685c-3fdf-9f7b-6d47b3aff76f",
                                        "entry_id": "02f53745-f4a1-3ef1-9f23-dba1dc73cbc1",
                                        "glosses": [
                                            "Pierre de couleur bleu clair à bleu-vert qui provient du phosphate hydraté d’aluminium ou de cuivre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd63e132-999e-434b-a37e-15cf923c0ceb",
                                                "sense_id": "9b73b550-685c-3fdf-9f7b-6d47b3aff76f",
                                                "text": "Les Turkomanes riches portent aux bras et aux pieds des bracelets pour la plupart en argent et ornés de turquoises, des ceintures et des colliers enrichis de pierreries et d’énormes boucles d’oreilles, le tout en argent."
                                            },
                                            {
                                                "example_id": "06134830-dc91-4f37-b9b6-2662eb439ce0",
                                                "sense_id": "9b73b550-685c-3fdf-9f7b-6d47b3aff76f",
                                                "text": "Minet-Chéri, ne dis pas à ton frère que j’ai eu trois crises cette nuit. D’abord, je te le défends. Et si tu ne le lui dis pas, je te donnerai le bracelet avec les trois turquoises…"
                                            },
                                            {
                                                "example_id": "443d2ab9-d021-4a86-81ed-5f58957c30e6",
                                                "sense_id": "9b73b550-685c-3fdf-9f7b-6d47b3aff76f",
                                                "text": "Somptueux chapans (manteaux) et accessoires brodés d’or de la cour de l’émir, selles en bois peintes à la main, harnachements de chevaux en argent sertis de turquoises, magnifiques suzanis (grandes pièces de tissu brodées), tapis, ikats de soie, bijoux et costumes de la culture nomade, peintures d’avant-garde orientalistes : l’exposition réunit près de 300 pièces uniques, exposées pour la première fois en dehors des musées de l’Ouzbékistan."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "turquoise",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f9d62853-51c2-3954-b941-8203dbd1d4f7",
                                        "entry_id": "55805bfd-2de2-3c11-a093-56c81e9876a6",
                                        "glosses": [
                                            "La couleur de cette pierre. #25FDE9 #1FFED8"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "turquoise",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "428c1f11-e69a-325d-a43b-22019621306e",
                                        "entry_id": "c13adbc7-b092-380f-a80f-88f43fd8a1fb",
                                        "glosses": [
                                            "De la couleur bleu ciel à bleu-vert de la pierre du même nom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "199e5929-44f5-47b7-9c6d-422a759c3ce8",
                                                "sense_id": "428c1f11-e69a-325d-a43b-22019621306e",
                                                "text": "La couleur de la porcelaine chinoise turquoise et violette."
                                            },
                                            {
                                                "example_id": "f51a2882-3af2-4d31-8f7e-6f1955cf75ae",
                                                "sense_id": "428c1f11-e69a-325d-a43b-22019621306e",
                                                "text": "C’étaient deux colosses noirs de la région de Yaoundé, reconnaissables aux verroteries turquoise de leurs oreilles."
                                            },
                                            {
                                                "example_id": "ab6a9e14-2ddf-4278-8f07-8ac3c2a752c2",
                                                "sense_id": "428c1f11-e69a-325d-a43b-22019621306e",
                                                "text": "Lorsqu’il se retourna, Opale, ses longs cheveux noirs coiffés en nattes, le regardait en souriant. Le diamant turquoise qui ornait son front mat brillait de mille feux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e11e830b-1d98-3780-9fab-839ea05c6adc",
                                        "entry_id": "c13adbc7-b092-380f-a80f-88f43fd8a1fb",
                                        "glosses": [
                                            "De la couleur bleu ciel à bleu-vert de la pierre du même nom.",
                                            "En particulier, plage de couleurs de lumières attribuée aux véhicules autonomes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "654dcb50-8c88-4174-a566-e40e19523eab",
                                                "sense_id": "e11e830b-1d98-3780-9fab-839ea05c6adc",
                                                "text": "Quand la voiture constate que les conditions sont réunies, deux diodes de couleur blanche s’allument de part et d’autre du volant. On active alors du pouce le système … et la machine prend le relais, ce qui se traduit notamment par l’allumage de diodes turquoises sur le volant. D’autres diodes de même teinte s’éclairant alors aussi dans les feux avant et arrière (...), ce qui permet de signifier aux autres conducteurs et aux forces de l’ordre que la voiture circule en mode autonome."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
