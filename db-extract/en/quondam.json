                        "target_lang_word": "einstig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "einstig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "947266e5-fd4f-3031-baba-99221b9f53b2",
                                        "entry_id": "c2523867-fe5a-38c8-be75-2448c9ef0605",
                                        "glosses": [
                                            "zu früheren Zeiten, Ex-"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6d772c7-19b7-4910-b6da-547e14414fe7",
                                                "sense_id": "947266e5-fd4f-3031-baba-99221b9f53b2",
                                                "text": "Über seine Stiftung ließ der einstige Anti-Apartheid-Kämpfer erklären: \"Wir hoffen, dass dieser Preis sein (Obamas) Engagement stärken wird, als Staatschef der mächtigsten Nation der Erde weiter den Frieden und die Ausmerzung der Armut zu propagieren.\""
                                            },
                                            {
                                                "example_id": "ebf4c895-150a-45a0-9e4c-c5d57edba9d9",
                                                "sense_id": "947266e5-fd4f-3031-baba-99221b9f53b2",
                                                "text": "„Auch wenn die Schäden am Interieur einigermassen reparabel wirken, werden die einstigen Besitzer es kaum mehr nutzen mögen; zu tief sitzt der ätzende Geruch von Hass und Verachtung in den usurpierten Räumen und Möbeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a852a0dc-694c-389d-9704-c641ef4c45ad",
                                        "entry_id": "c2523867-fe5a-38c8-be75-2448c9ef0605",
                                        "glosses": [
                                            "künftig"
                                        ],
                                        "tags": [
                                            "archaic",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d68026e-f2be-4ffe-ab6b-1f81aaacea39",
                                                "sense_id": "a852a0dc-694c-389d-9704-c641ef4c45ad",
                                                "text": "Die einstige Königin von Schweden ist heute noch eine ganz normale Mutter und Ehefrau."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02ec2f2e-f88c-4c58-8303-cdcb291e3e16",
                        "source_entry_id": "fc108a29-2911-3013-b8a5-087a7f32f1c9",
                        "source_sense_id": "f56969c0-f86e-398c-9df8-19e874217a09",
                        "source_sense_description": "former",
                        "target_lang_word": "ehemalig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ehemalig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "772015b4-5317-39d8-81d9-c6b720126259",
                                        "entry_id": "0b5f42f5-4e56-302b-9c41-31f1c7b56c34",
                                        "glosses": [
                                            "nicht mehr existent oder nicht mehr bestehend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4df7f26-743d-4ce7-bd5a-e80c9aa4e1af",
                                                "sense_id": "772015b4-5317-39d8-81d9-c6b720126259",
                                                "text": "Ich hab gestern meinen ehemaligen Chef getroffen."
                                            },
                                            {
                                                "example_id": "d739c384-d54e-4e88-bc77-ef01aa5108f6",
                                                "sense_id": "772015b4-5317-39d8-81d9-c6b720126259",
                                                "text": "„Das kann auch nicht jeder behaupten, dass sein ehemaliger Spanischlehrer der Direktor des Phallusmuseums ist, denke ich.“"
                                            },
                                            {
                                                "example_id": "98871611-ea1d-4864-893a-a46f5998ca92",
                                                "sense_id": "772015b4-5317-39d8-81d9-c6b720126259",
                                                "text": "„Die zerklüftete Kraterlandschaft der ehemaligen Braunkohletagebaus ist eine faszinierende, menschengemachte Landschaft.“"
                                            },
                                            {
                                                "example_id": "e3dba4b6-6d2f-48b3-9fd5-904f470b266d",
                                                "sense_id": "772015b4-5317-39d8-81d9-c6b720126259",
                                                "text": "„Gemeinsam mit dem ehemaligen Deutschland-Chef von McKinsey Herbert Henzler und dem Extremkletterer Alexander Huber geht es am 10. und 11. Juli in die Bergregion Wilder Kaiser in Tirol.“"
                                            },
                                            {
                                                "example_id": "5e5c88ed-1f1a-474e-abe8-1ac96b77fc8c",
                                                "sense_id": "772015b4-5317-39d8-81d9-c6b720126259",
                                                "text": "„Der ehemalige US-Präsident Trump hat im Prozess um manipulierte Vermögenswerte die vom Gericht neu festgelegte Kaution über 175 Millionen Dollar hinterlegt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94b21a7a-8fae-48b3-95ec-53a49584dc7e",
