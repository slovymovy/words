                    {
                        "sense_id": "ddf32b13-cba2-3a83-bb1c-2563951ca95d",
                        "entry_id": "30be058c-1bb1-34fb-b943-bdba6424ade1",
                        "glosses": [
                            "Cri de joie exubérant qui exprime le triomphe, toute la satisfaction de la réussite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "518c1c31-1056-4382-b165-7f13782cba05",
                                "sense_id": "ddf32b13-cba2-3a83-bb1c-2563951ca95d",
                                "text": "Youpi, on va pouvoir sortir dehors !"
                            },
                            {
                                "example_id": "f900432d-c01a-431a-894c-bab886386c16",
                                "sense_id": "ddf32b13-cba2-3a83-bb1c-2563951ca95d",
                                "text": "L’accès était libre et il y aurait un pot. Youpi."
                            },
                            {
                                "example_id": "c6652b34-e6fa-4a26-b900-2a63eae83326",
                                "sense_id": "ddf32b13-cba2-3a83-bb1c-2563951ca95d",
                                "text": "Youpi ! Pendant une journée, j’ai senti un poids s’enlever de mes épaules."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34efca3a-efcb-43f6-bf96-e09708de7957",
                        "source_entry_id": "30be058c-1bb1-34fb-b943-bdba6424ade1",
