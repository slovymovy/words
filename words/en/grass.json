                                "zh": "警察因该男子贩卖<w>大麻</w>将其逮捕。"
                            }
                        },
                        {
                            "text": "He smoked <w>grass</w> when he was in college but stopped years ago.",
                            "target_lang_translations": {
                                "ru": "Он курил <w>травку</w> в колледже, но бросил много лет назад.",
                                "zh": "他上大学时抽过<w>大麻</w>，但多年前就戒了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "weed",
                        "pot",
                        "cannabis",
                        "marijuana"
                    ],
                    "common_phrases": [
