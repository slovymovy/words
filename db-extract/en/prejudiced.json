                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c9a529a-e592-4fbd-ab4a-5b438fd4af43",
                                                "sense_id": "5fcbe417-1807-3aa8-b672-80b35a0d01a9",
                                                "text": "„Ähnlich vorurteilsbehaftet waren früher auch verschiedene körperliche Erkrankungen wie beispielsweise AIDS, das verschrien war als die Erkrankung, unter der Homosexuelle und Drogenabhängige leiden.“"
                                            },
                                            {
                                                "example_id": "7ea05b0a-a7de-49a3-af48-2a69ecf5e05a",
                                                "sense_id": "5fcbe417-1807-3aa8-b672-80b35a0d01a9",
                                                "text": "„Auch wenn die unterschiedlichen Nationen insofern gut harmonierten, dass es nicht zu Auseinandersetzungen kam, so war die gegenseitige Wahrnehmung doch deutlich vorurteilsbehaftet.“"
                                            },
                                            {
                                                "example_id": "64f2601d-f244-449b-a737-0fd3e7d3ae78",
                                                "sense_id": "5fcbe417-1807-3aa8-b672-80b35a0d01a9",
                                                "text": "„Diese Dinge sind selbstverständlich unzeitgemäß und vorurteilsbehaftet, wenn nicht sogar beleidigend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
