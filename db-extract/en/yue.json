                "senses": [
                    {
                        "sense_id": "e797ea29-7389-30bc-a6dd-972d8332aca0",
                        "entry_id": "063ee385-077b-3cfb-a553-440c4f055816",
                        "glosses": [
                            "The modern variety of Chinese, which includes Cantonese and Taishanese."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e5b9440-21d8-4483-a7e7-90a61bdb36aa",
                                "sense_id": "e797ea29-7389-30bc-a6dd-972d8332aca0",
                                "text": "The Yue dialects are popularly known as the Cantonese dialects. [...] The speech of Canton City, which is Cantonese in its narrower sense, is the best known and most generally esteemed of the Yue dialects."
                            },
                            {
                                "example_id": "7b5c1da7-ab79-4ad5-890c-fbecc0ce231f",
                                "sense_id": "e797ea29-7389-30bc-a6dd-972d8332aca0",
                                "text": "One form of Yue—that of Canton—has provided an umbrella term for the whole [language] complex—Cantonese."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9e47b4d-3694-3743-9a4f-669fb11c8e73",
                        "entry_id": "063ee385-077b-3cfb-a553-440c4f055816",
                        "glosses": [
                            "People who speak a variety of Yue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04455da5-492f-4505-85e3-4342e928f81f",
                                "sense_id": "f9e47b4d-3694-3743-9a4f-669fb11c8e73",
                                "text": "If there is a well-defined subgroup of the Han Chinese today, it is the Yue."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ed7b1df-e606-3a48-89f9-fbc4c54ee25b",
                        "entry_id": "063ee385-077b-3cfb-a553-440c4f055816",
                        "glosses": [
                            "Any of several ancient Tai peoples of what is now Guangdong province, or their languages."
