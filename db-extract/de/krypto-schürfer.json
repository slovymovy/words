                "senses": [
                    {
                        "sense_id": "ea7547c0-ef0f-3d7b-b105-fb720b75b0de",
                        "entry_id": "55a4f198-954b-3673-a5e4-aa54ef2a81ea",
                        "glosses": [
                            "Person, die Vermögenswerte in einer digitalen Währung schafft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d970b7d1-c837-47f4-ad5f-d9ce016ccb53",
                                "sense_id": "ea7547c0-ef0f-3d7b-b105-fb720b75b0de",
                                "text": "„Krypto-Schürfer schaffen sich mithilfe von Grafikkarten einen Zusatzverdienst und Wissenschaftler basteln mit der Rechenleistung von Grafikchips an der künstlichen Intelligenz der Zukunft – Skynet lässt grüßen.“"
                            },
                            {
                                "example_id": "b39180c3-ae51-40d0-b817-0a772f162811",
                                "sense_id": "ea7547c0-ef0f-3d7b-b105-fb720b75b0de",
                                "text": "„Allein basierend auf den Wachstumszielen von Advania rechnet er dann vor, dass Islands Krypto-Schürfer in diesem Jahr 840 Gigawattstunden (GWh) an Strom verbrauchen könnten.“"
                            },
                            {
                                "example_id": "78d031ad-4c4e-4dec-96a8-5930d2e1be4a",
                                "sense_id": "ea7547c0-ef0f-3d7b-b105-fb720b75b0de",
                                "text": "„Russische Krypto-Schürfer könnten im nächsten Jahr mit höheren Stromrechnungen konfrontiert werden.“"
                            },
                            {
                                "example_id": "895bb160-e8f6-4811-b95e-1c82c8087a0c",
                                "sense_id": "ea7547c0-ef0f-3d7b-b105-fb720b75b0de",
                                "text": "„Doch die Liste zählt nicht nur die reichsten Krypto-Schürfer auf, sie lässt auch noch einige weitere Analysen zu: So finden sich darauf ausschließlich Männer, die sehr früh in Digitalwährungen investiert oder diese sogar gegründet hatten.“"
                            },
                            {
                                "example_id": "f1dc2d6c-3186-4ee5-9ebe-45fbe7eea3ea",
                                "sense_id": "ea7547c0-ef0f-3d7b-b105-fb720b75b0de",
                                "text": "„Krypto-Schürfer müssen sich nach ihrer Verbannung aus China neue Standorte suchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
