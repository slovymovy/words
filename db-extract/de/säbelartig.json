                ],
                "senses": [
                    {
                        "sense_id": "e1ecf314-45d1-36b9-aaf7-fd597ce4ea33",
                        "entry_id": "175d5e46-d656-33a7-9730-de58344611f5",
                        "glosses": [
                            "einem Säbel ähnelnd, an einen Säbel erinnernd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb9132be-f43c-4353-93c0-8d205b9d5457",
                                "sense_id": "e1ecf314-45d1-36b9-aaf7-fd597ce4ea33",
                                "text": "„Sobald der Affe fauchte, zog sich seine breite flache Nase wie die einer großen Katze zusammen, und in seinem riesigen Maul erkannte man die säbelartigen Reißzähne eines Raubtieres.“"
                            },
                            {
                                "example_id": "b3b21267-777d-4dd5-91ba-968d0037959a",
                                "sense_id": "e1ecf314-45d1-36b9-aaf7-fd597ce4ea33",
                                "text": "„Andere schleppten schwere Armbrüste und viele trugen Piken mit langen Schäften und gekrümmten, säbelartigen Klingen, die sich erfahrungsgemäß im Nahkampf gegen die Voormis besonders bewährten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
