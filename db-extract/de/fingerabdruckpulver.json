                    {
                        "sense_id": "a7de4e37-4a71-3a7d-9270-9094e9bb8156",
                        "entry_id": "12fab633-2774-3c84-bd38-a79ccc692816",
                        "glosses": [
                            "Pulver, das zum Abnehmen von Fingerabdrücken dient, mit dessen Hilfe Fingerabdrücke sichtbar gemacht werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6db4e5d-f3a6-4844-a06f-9ae3a83b0ac7",
                                "sense_id": "a7de4e37-4a71-3a7d-9270-9094e9bb8156",
                                "text": "„Cupido reichte ihm das Apple MacBook Pro, auf dessen silberner Oberfläche noch das Fingerabdruckpulver der Spurensicherung zu sehen war.“"
                            },
                            {
                                "example_id": "f069e455-bfc2-45a0-90c2-8a49857c1e23",
                                "sense_id": "a7de4e37-4a71-3a7d-9270-9094e9bb8156",
                                "text": "„Die Techniker machten sich über den Umschlag her, bestäubten ihn mit Fingerabdruckpulver, blätterten durch das Adressbuch, untersuchten die Fotos und leierten ihre Befunde herunter wie Chirurgen an einem Operationstisch:“"
                            },
                            {
                                "example_id": "b9ec237e-34a6-4502-b32e-7d5dcc8412bc",
                                "sense_id": "a7de4e37-4a71-3a7d-9270-9094e9bb8156",
                                "text": "„Inzwischen bevölkern zwei Dutzend Polizeibeamte den Tatort, und mit dem weißen Fingerabdruckpulver auf sämtlichen Oberflächen erinnert die Werkstatt an eine Wall-Street-Party in den 80ern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
