                    "frequency": "Low",
                    "semantic_group_id": "avantage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet hôtel est très <w>heureusement</w> situé entre la mer et les collines verdoyantes."
                        },
                        {
                            "text": "Le village bénéficie d'une plaine agricole très <w>heureusement</w> abritée des vents violents."
