{
    "word_family": [
        "charitable",
        "charitably",
        "uncharitable"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "998ea387-131a-3870-8c5a-11bc7151238d",
                    "sense_definition": "An organization set up to provide help and raise money for those in need.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "organization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The event raised a significant amount of money for local <w>charities</w>.",
                            "target_lang_translations": {
                                "ru": "Мероприятие собрало значительную сумму денег для местных <w>благотворительных организаций</w>.",
                                "zh": "这次活动为当地的<w>慈善机构</w>筹集了大量资金。"
                            }
                        },
                        {
                            "text": "He decided to donate half of his monthly earnings to a registered <w>charity</w>.",
                            "target_lang_translations": {
                                "ru": "Он решил пожертвовать половину своего месячного заработка зарегистрированному <w>благотворительному фонду</w>.",
                                "zh": "他决定将月收入的一半捐给一家注册的<w>慈善机构</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "charitable organization",
                        "non-profit",
                        "fund"
                    ],
                    "common_phrases": [
                        "registered charity",
                        "local charity",
                        "raise money for charity",
                        "give to charity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Организация, созданная для оказания помощи и сбора средств для нуждающихся.",
                        "zh": "为有需要的人提供帮助和筹集资金的组织。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "благотворительная организация",
                                "target_lang_sense_clarification": "общее название"
                            },
                            {
                                "target_lang_word": "благотворительный фонд",
                                "target_lang_sense_clarification": "фонд"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "慈善机构",
                                "target_lang_sense_clarification": "通用名称"
                            },
                            {
                                "target_lang_word": "慈善基金会",
                                "target_lang_sense_clarification": "基金组织"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f9829f82-a540-3bb9-b183-134ba78bc40d",
                    "sense_definition": "The act of giving money, food, or help to people who need it, or the help itself.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "benevolence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The homeless man was too proud to accept their <w>charity</w>.",
                            "target_lang_translations": {
                                "ru": "Бездомный был слишком горд, чтобы принять их <w>милостыню</w>.",
                                "zh": "那个流浪汉很有自尊心，不愿接受他们的<w>施舍</w>。"
                            }
                        },
                        {
                            "text": "She performed a quiet act of <w>charity</w> by paying for the stranger's meal.",
                            "target_lang_translations": {
                                "ru": "Она совершила тихий акт <w>благотворительности</w>, заплатив за еду незнакомца.",
                                "zh": "她为陌生人付了餐费，做了一件默默的<w>慈善</w>之举。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "act of charity",
                        "live on charity",
                        "out of charity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт оказания помощи нуждающимся или сама помощь (деньги, еда).",
                        "zh": "向有需要的人提供金钱、食物或帮助的行为，或指这种帮助本身。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "благотворительность",
                                "target_lang_sense_clarification": "деятельность"
                            },
                            {
                                "target_lang_word": "милостыня",
                                "target_lang_sense_clarification": "подаяние"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "慈善",
                                "target_lang_sense_clarification": "行为或活动"
                            },
                            {
                                "target_lang_word": "施舍",
                                "target_lang_sense_clarification": "给予穷人的财物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9dc036e7-69d7-35f7-9497-9f376a1828c1",
                    "sense_definition": "An attitude of kindness and understanding towards others, especially when judging their faults.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should judge his mistakes with <w>charity</w> rather than harshness.",
                            "target_lang_translations": {
                                "ru": "Тебе следует судить о его ошибках с <w>милосердием</w>, а не с суровостью.",
                                "zh": "你应该以<w>宽容</w>而非严苛的态度去评判他的错误。"
                            }
                        },
                        {
                            "text": "He showed no <w>charity</w> towards his political opponents during the debate.",
                            "target_lang_translations": {
                                "ru": "Он не проявил никакого <w>милосердия</w> к своим политическим оппонентам во время дебатов.",
                                "zh": "在辩论中，他对政敌毫无<w>仁慈</w>可言。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "spirit of charity",
                        "with charity",
                        "lack of charity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отношение доброты и понимания к другим, особенно при оценке их ошибок.",
                        "zh": "对他人的善意和理解，特别是在评判他人过错时。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "милосердие",
                                "target_lang_sense_clarification": "готовность простить"
                            },
                            {
                                "target_lang_word": "снисходительность",
                                "target_lang_sense_clarification": "мягкость в суждениях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "仁慈",
                                "target_lang_sense_clarification": "宽厚的心地"
                            },
                            {
                                "target_lang_word": "宽容",
                                "target_lang_sense_clarification": "对他人过错的包容"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e07ab4b-3777-3e48-af6f-a56f4ca6a231",
                    "sense_definition": "Christian love representing God's love for humans and human love for God and others.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "religious_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The priest explained that faith, hope, and <w>charity</w> are the three theological virtues.",
                            "target_lang_translations": {
                                "ru": "Священник объяснил, что вера, надежда и <w>любовь</w> являются тремя богословскими добродетелями.",
                                "zh": "牧师解释说，信、望、<w>爱</w>是三种神学美德。"
                            }
                        },
                        {
                            "text": "In this biblical context, <w>charity</w> refers to a selfless and divine form of love.",
                            "target_lang_translations": {
                                "ru": "В этом библейском контексте <w>любовь</w> относится к бескорыстной и божественной форме любви.",
                                "zh": "在圣经语境下，<w>仁爱</w>指的是一种无私且神圣的爱。"
                            }
                        }
                    ],
                    "synonyms": [
                        "agape"
                    ],
                    "target_lang_definitions": {
                        "ru": "Христианская любовь, олицетворяющая любовь Бога к людям и людей к Богу и ближним.",
                        "zh": "基督教中代表上帝对人类的爱，以及人类对上帝和他人的爱。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "любовь",
                                "target_lang_sense_clarification": "богословская добродетель"
                            },
                            {
                                "target_lang_word": "милосердие",
                                "target_lang_sense_clarification": "сострадательная любовь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "博爱",
                                "target_lang_sense_clarification": "神学美德"
                            },
                            {
                                "target_lang_word": "仁爱",
                                "target_lang_sense_clarification": "慈爱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d762dd50-7fbf-3d32-ae2c-4072936cbac8",
                    "sense_definition": "A free throw in the game of basketball.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player stepped up to the line to take the <w>charity</w> shot.",
                            "target_lang_translations": {
                                "ru": "Игрок подошел к линии, чтобы выполнить <w>штрафной бросок</w>.",
                                "zh": "球员走上罚球线准备进行<w>罚球</w>。"
                            }
                        },
                        {
                            "text": "Missing that <w>charity</w> cost the team their lead in the final seconds.",
                            "target_lang_translations": {
                                "ru": "Промах на этом <w>штрафном</w> стоил команде лидерства на последних секундах.",
                                "zh": "最后几秒钟错失了那次<w>罚球</w>，导致球队失去了领先优势。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "sports context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Штрафной бросок в баскетболе.",
                        "zh": "篮球比赛中的罚球。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "штрафной бросок",
                                "target_lang_sense_clarification": "спорт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "罚球",
                                "target_lang_sense_clarification": "体育术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "93e332a4-ef99-35c5-9963-989badfdd5cf",
                    "sense_definition": "A female given name.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My aunt <w>Charity</w> is coming to visit us for the holidays.",
                            "target_lang_translations": {
                                "ru": "Моя тетя <w>Чарити</w> приедет навестить нас на праздники.",
                                "zh": "我的姑姑<w>查丽蒂</w>假期要来看我们。"
                            }
                        },
                        {
                            "text": "She was named <w>Charity</w> in hopes that she would grow up to be kind and generous.",
                            "target_lang_translations": {
                                "ru": "Ее назвали <w>Чарити</w> в надежде, что она вырастет доброй и щедрой.",
                                "zh": "她被取名为<w>查丽蒂</w>，希望她长大后能善良慷慨。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское имя.",
                        "zh": "女性名字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Чарити",
                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "查丽蒂",
                                "target_lang_sense_clarification": "人名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9bf53fed-680f-34f8-bfff-4f0156e00c86",
                    "sense_definition": "The 107th sura (chapter) of the Qur'an.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "work_of_art_name",
                    "examples": [
                        {
                            "text": "The student recited the verses from the chapter known as <w>Charity</w>.",
                            "target_lang_translations": {
                                "ru": "Студент прочитал стихи из главы, известной как <w>Подаяние</w>.",
                                "zh": "学生背诵了被称为<w>什一税章</w>中的经文。"
                            }
                        },
                        {
                            "text": "Scholars have written extensively on the interpretation of <w>Charity</w> in the holy text.",
                            "target_lang_translations": {
                                "ru": "Ученые много писали о толковании суры <w>Подаяние</w> в священном тексте.",
                                "zh": "学者们对圣典中<w>什一税章</w>的解读进行了大量论述。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "107-я сура Корана.",
                        "zh": "《古兰经》的第107章。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Подаяние",
                                "target_lang_sense_clarification": "название суры"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "什一税章",
                                "target_lang_sense_clarification": "苏拉名称"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}