{
    "word_family": [
        "glamorous",
        "glamorize",
        "glam"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1c234e52-08e1-33de-96a6-48ec248b47cd",
                    "sense_definition": "An attractive, exciting, or fascinating quality that makes someone or something seem appealing.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many young people are drawn to the <w>glamour</w> of the movie industry.",
                            "target_lang_translations": {
                                "tr": "Birçok genç film sektörünün <w>büyüsüne</w> kapılır.",
                                "zh": "许多年轻人被电影行业的<w>魅力</w>所吸引。"
                            }
                        },
                        {
                            "text": "Behind all the Hollywood <w>glamour</w> lies a lot of hard work and dedication.",
                            "target_lang_translations": {
                                "tr": "Tüm Hollywood <w>ışıltısının</w> arkasında yoğun bir çalışma ve özveri yatmaktadır.",
                                "zh": "在好莱坞所有的<w>光彩</w>背后，是无数的辛勤努力与付出。"
                            }
                        }
                    ],
                    "synonyms": [
                        "charm",
                        "allure",
                        "appeal",
                        "attractiveness",
                        "fascination"
                    ],
                    "antonyms": [
                        "dullness"
                    ],
                    "common_phrases": [
                        "Hollywood glamour",
                        "sense of glamour",
                        "world of glamour"
                    ],
                    "target_lang_definitions": {
                        "tr": "Birini veya bir şeyi cazip kılan, çekici, heyecan verici veya büyüleyici nitelik.",
                        "zh": "让人或事物显得极为诱人、充满兴奋或迷人的魅力与光彩。"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "büyü",
                                "target_lang_sense_clarification": "çekicilik, cazibe"
                            },
                            {
                                "target_lang_word": "cazibe",
                                "target_lang_sense_clarification": "çekim gücü, alım"
                            },
                            {
                                "target_lang_word": "görkem",
                                "target_lang_sense_clarification": "göz alıcılık, ışıltı"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "魅力",
                                "target_lang_sense_clarification": "极具吸引力或诱惑力的特质"
                            },
                            {
                                "target_lang_word": "光彩",
                                "target_lang_sense_clarification": "耀眼夺目、令人向往的色彩或氛围"
                            },
                            {
                                "target_lang_word": "诱惑力",
                                "target_lang_sense_clarification": "吸引人的力量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d7134f5-f05b-3061-a1b3-6ce2dd8fa435",
                    "sense_definition": "Alluring personal beauty or charm, often stylized and associated with high fashion or celebrity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magazine photographer captured the old-fashioned <w>glamour</w> of the movie star.",
                            "target_lang_translations": {
                                "tr": "Dergi fotoğrafçısı, film yıldızının eski tarz <w>şıklığını</w> yakaladı.",
                                "zh": "杂志摄影师捕捉到了这位影星复古的<w>风采</w>。"
                            }
                        },
                        {
                            "text": "She loved the world of high fashion <w>glamour</w> and modeled for top magazines.",
                            "target_lang_translations": {
                                "tr": "Yüksek modanın <w>ışıltılı</w> dünyasını seviyordu ve en iyi dergiler için modellik yaptı.",
                                "zh": "她热爱高级时装界<w>光鲜</w>亮丽的世界，并为顶级杂志担任模特。"
                            }
                        }
                    ],
                    "synonyms": [
                        "allure",
                        "attractiveness",
                        "elegance"
                    ],
                    "common_phrases": [
                        "high fashion glamour",
                        "sheer glamour"
                    ],
                    "target_lang_definitions": {
                        "tr": "Genellikle yüksek moda veya ünlülerle ilişkilendirilen, stillendirilmiş kişisel güzellik veya çekicilik.",
                        "zh": "（尤指与高级时装或名流相关的）艳丽迷人的外表、美貌或风采。"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "şıklık",
                                "target_lang_sense_clarification": "zarafet ve alımlılık"
                            },
                            {
                                "target_lang_word": "albeni",
                                "target_lang_sense_clarification": "kişisel çekicilik, çekim"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "光鲜",
                                "target_lang_sense_clarification": "华丽、时髦的外表"
                            },
                            {
                                "target_lang_word": "美艳",
                                "target_lang_sense_clarification": "艳丽夺目的风采或容貌"
                            },
                            {
                                "target_lang_word": "风采",
                                "target_lang_sense_clarification": "迷人、优雅的个人魅力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "30473fcc-0ad7-3285-9420-800b40369030",
                    "sense_definition": "A magic spell or enchantment that makes someone see things differently from reality.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witch cast a powerful <w>glamour</w> over the prince to hide her true form.",
                            "target_lang_translations": {
                                "tr": "Cadı, gerçek görünümünü gizlemek için prensin üzerine güçlü bir <w>büyü</w> yaptı.",
                                "zh": "女巫在王子身上施展了强大的<w>幻术</w>，以隐瞒自己的真实面貌。"
                            }
                        },
                        {
                            "text": "He fell under a magical <w>glamour</w> that made the dark forest appear bright and welcoming.",
                            "target_lang_translations": {
                                "tr": "Karanlık ormanın parlak ve konuksever görünmesini sağlayan sihirli bir <w>büyünün</w> etkisine girdi.",
                                "zh": "他中了一种神奇的<w>障眼法</w>，使得原本阴暗的森林看起来明亮而宜人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "enchantment",
                        "spell",
                        "witchery",
                        "magic charm"
                    ],
                    "common_phrases": [
                        "magical glamour",
                        "cast a glamour"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in fantasy or historical contexts to refer to magical spells"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Birinin şeyleri gerçekte olduğundan farklı görmesini sağlayan sihirli bir büyü veya efsun.",
                        "zh": "（尤指奇幻或古英语中）让人产生幻觉、颠倒真相的魔法或幻术。"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "büyü",
                                "target_lang_sense_clarification": "sihir, ilüzyon"
                            },
                            {
                                "target_lang_word": "efsun",
                                "target_lang_sense_clarification": "sihir"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "幻术",
                                "target_lang_sense_clarification": "掩盖真实面貌的魔法"
                            },
                            {
                                "target_lang_word": "障眼法",
                                "target_lang_sense_clarification": "遮蔽真相的法术或戏法"
                            },
                            {
                                "target_lang_word": "魔法",
                                "target_lang_sense_clarification": "施加影响的神秘法术"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fd1ff694-3886-3406-a1d2-a4a1f450bfe2",
                    "sense_definition": "To charm, enchant, or bewitch someone, often making them see things differently.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old stories tell of creatures that could <w>glamour</w> travelers into wandering off the path.",
                            "target_lang_translations": {
                                "tr": "Eski hikayeler, yolcuları <w>büyüleyerek</w> yoldan saptırabilen yaratıklardan bahseder.",
                                "zh": "古老的故事讲述了能够施法<w>迷惑</w>过路人、使他们误入歧途的生物。"
                            }
                        },
                        {
                            "text": "She managed to <w>glamour</w> the audience with her enchanting performance.",
                            "target_lang_translations": {
                                "tr": "Büyüleyici performansıyla izleyicileri <w>büyülemeyi</w> başardı.",
                                "zh": "她凭借迷人的表演成功<w>迷住</w>了观众。"
                            }
                        }
                    ],
                    "synonyms": [
                        "enchant",
                        "bewitch",
                        "charm",
                        "beguile"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Literary or archaic usage meaning to enchant"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Birini büyülemek, efsunlamak veya etkilemek, genellikle olayları farklı görmesini sağlamak.",
                        "zh": "施展魔法迷惑某人，或用极大的魅力使人陶醉。"
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "büyülemek",
                                "target_lang_sense_clarification": "sihirle veya hayranlıkla etkilemek"
                            },
                            {
                                "target_lang_word": "efsunlamak",
                                "target_lang_sense_clarification": "sihir yapmak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "迷惑",
                                "target_lang_sense_clarification": "施法或用魅力使人辨不清真相"
                            },
                            {
                                "target_lang_word": "蛊惑",
                                "target_lang_sense_clarification": "用诱惑或法术使人失去判断"
                            },
                            {
                                "target_lang_word": "迷住",
                                "target_lang_sense_clarification": "深深吸引或施法控制"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}