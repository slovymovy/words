                ],
                "senses": [
                    {
                        "sense_id": "a1a06ad8-13e5-390e-a20a-e33f81686413",
                        "entry_id": "37677e8b-5c3d-37c3-bf1f-1ec958341d5f",
                        "glosses": [
                            "Laut, der gesprochen werden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dba3d3a-2d75-4bda-9ab9-299ffbf9ecc8",
                                "sense_id": "a1a06ad8-13e5-390e-a20a-e33f81686413",
                                "text": "„Dies wird deutlich, wenn wir Ziel- und Ersatzlaut nach den Merkmalen Artikulationsstelle, Artikulationsmodus und Stimmbeteiligung beschreiben (…).“"
                            },
                            {
                                "example_id": "1c0322b1-64c3-4da0-bf8e-6cb63b9d1908",
                                "sense_id": "a1a06ad8-13e5-390e-a20a-e33f81686413",
                                "text": "„Bei diesem Spiel zur Lautanalyse geht es darum, den Ziellaut zu den gezeigten Begriffen der richtigen Wortposition zuzuordnen.“"
                            },
                            {
                                "example_id": "a8212c59-6407-47a1-a081-a0518331af4e",
                                "sense_id": "a1a06ad8-13e5-390e-a20a-e33f81686413",
                                "text": "„Einige Realgegenstände, die mit dem Ziellaut beginnen, befinden sich versteckt unter einer Decke oder in Fühlsäckchen.“"
                            },
                            {
                                "example_id": "bd2d8a29-e8e8-47b8-a044-c90465fe9c9f",
                                "sense_id": "a1a06ad8-13e5-390e-a20a-e33f81686413",
                                "text": "„Metaphon (vgl. Jahn 2007): das Kind soll durch die Spiegelfunktion ein Störungsbewusstsein entwickeln und mit Unterstützung von kindgerechtem Material erkennen, wo im Mund der Ziellaut produziert werden soll.“"
                            },
                            {
                                "example_id": "b105ed4f-428e-4b0a-ada1-e2c88ec2c398",
                                "sense_id": "a1a06ad8-13e5-390e-a20a-e33f81686413",
                                "text": "„Die Produktion der Ziellaute wurde an Übungsitems trainiert und deren Genauigkeit anhand von ungeübten Wörtern (Kontrollitems) beobachtet und ausgewertet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e28db27f-bd32-375c-9c53-8961741ffcb6",
                        "entry_id": "37677e8b-5c3d-37c3-bf1f-1ec958341d5f",
                        "glosses": [
                            "Laut, auf den ein Lautwandel hinausläuft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c285ec93-f81d-49bd-909f-c285e38d3ca3",
                                "sense_id": "e28db27f-bd32-375c-9c53-8961741ffcb6",
                                "text": "„Alle Wörter einer bestimmten Wortklasse erleben gleichzeitig eine Veränderung des entsprechenden Lautes; diese springt aber nicht plötzlich von einem Phonem auf ein anderes um, sondern durchläuft eine schrittweise Annäherung an den Ziellaut.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
