                                                "sense_id": "001f70f0-b8d5-307b-bc94-e7783e02b1a9",
                                                "text": "a lost limb; lost honour"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64434578-3dc2-3f9e-aa7b-5670853b7a4d",
                                        "entry_id": "20972da0-bf85-3640-827e-6a4ce93ed3d2",
                                        "glosses": [
                                            "Not employed or enjoyed; thrown away; employed ineffectually; wasted; squandered."
                                        ],
                                        "tags": [],
                                        "examples": [
