                    }
                ],
                "senses": [
                    {
                        "sense_id": "02a2acf0-e725-3acf-b616-9b6de8458b75",
                        "entry_id": "429ee45d-b152-37ca-bfaa-48ccf4d784c5",
                        "glosses": [
                            "собир. титул, присваиваемый в католической и англиканской церкви лицам, занимающим высшие должности"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f32a9690-780b-49c8-bd0d-991fc0ebeff4",
                                "sense_id": "02a2acf0-e725-3acf-b616-9b6de8458b75",
                                "text": "Время ещё не ушло, у меня много добрых знакомых в папской курии, и я могу устроить вас прелатом на доходное место!"
                            }
                        ]
                    },
                    {
                        "sense_id": "e0f6150f-c8ef-3224-9749-39b7d3cc85f7",
                        "entry_id": "429ee45d-b152-37ca-bfaa-48ccf4d784c5",
                        "glosses": [
                            "лицо, имеющее такой титул"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd56e6c2-99d1-489c-b9cf-9ad12f1b7b15",
                                "sense_id": "e0f6150f-c8ef-3224-9749-39b7d3cc85f7",
                                "text": "В празднично нарядной толпе виднелись фиолетовые и чёрные сутаны епископов и прелатов."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68ac1948-729b-40c7-b098-60a3df030792",
                        "source_entry_id": "429ee45d-b152-37ca-bfaa-48ccf4d784c5",
                        "target_lang_word": "prelate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prelate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f62b138-0a0f-3a70-82ac-217290e05cf2",
                                        "entry_id": "4f41048d-fbbd-3f04-a5e6-6c238b3ce332",
                                        "glosses": [
                                            "A clergyman of high rank and authority, having jurisdiction over an area or a group of people; normally a bishop."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "353dd8ee-5adf-4529-978a-a7d54b10f808",
                                                "sense_id": "1f62b138-0a0f-3a70-82ac-217290e05cf2",
                                                "text": "Hear him but reason in divinity, […] / You would desire the king were made a prelate."
                                            },
                                            {
                                                "example_id": "320a7386-22aa-4a4f-9e4a-03027417742d",
                                                "sense_id": "1f62b138-0a0f-3a70-82ac-217290e05cf2",
                                                "text": "’Tis acknowledg’d on all hands, ſays that learned Prelate, that the Authority, either of the Scripture or of Tradition, is founded merely on the Teſtimony of the Apoſtles, who were Eye-witneſſes to thoſe Miracles of our Saviour, by which he prov’d his divine Miſſion."
                                            },
                                            {
                                                "example_id": "a5740876-411a-48a6-bc93-669f470f8763",
                                                "sense_id": "1f62b138-0a0f-3a70-82ac-217290e05cf2",
                                                "text": "Inthronization, in ancient times, immediately succeeded the rite of consecration; the new bishop being honourably placed in his episcopal chair by the prelates assembled for his consecration."
                                            },
                                            {
                                                "example_id": "ccc85b3f-1965-4e8e-9d72-5bab05f79ac6",
                                                "sense_id": "1f62b138-0a0f-3a70-82ac-217290e05cf2",
                                                "text": "The day before, Cardinal Burke and other traditionalist prelates made public an exchange of letters with Francis in which they aired grave doubts about the legitimacy of a major assembly of the world’s bishops and laypeople that will, on Wednesday, begin discussing some of the most sensitive topics in the church."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prelate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab925265-fae3-3adb-a490-3e5d005f15f1",
                                        "entry_id": "f7c37912-fbec-3398-bc8b-7214d23db089",
                                        "glosses": [
                                            "(obsolete) To act as a prelate."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17467643-616c-41e6-bcae-eb9550d515a2",
                                                "sense_id": "ab925265-fae3-3adb-a490-3e5d005f15f1",
                                                "text": "18 January 1549, Hugh Latimer, Sermon of the Plough\nRight prelating is busy labouring, and not lording."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
