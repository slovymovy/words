                        "entry_id": "e933d931-42e3-3822-8729-80445e6754ed",
                        "glosses": [
                            "Turm zur Überwachung eines Areals"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0d6bdf9-d295-4d96-9e17-cd2a915deac0",
                                "sense_id": "f8726389-c646-3d01-b211-f4c8923483a1",
                                "text": "An diesem Wachtturm dort kommt keiner vorbei ohne aufzufallen."
                            },
                            {
                                "example_id": "3cca619d-b8f1-41fc-ad08-5a0810981c95",
                                "sense_id": "f8726389-c646-3d01-b211-f4c8923483a1",
                                "text": "„Vor dem Sandwasser stand früher der alte Wachtturm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c65afbbd-b63d-41ef-809a-c3160a14d48a",
                        "source_entry_id": "e933d931-42e3-3822-8729-80445e6754ed",
                        "source_sense_id": "f8726389-c646-3d01-b211-f4c8923483a1",
                        "source_sense_description": "Turm zur Überwachung eines Areals",
                        "target_lang_word": "watchtower",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "watchtower",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3da3997a-0e70-369f-a3e9-02f99a10c030",
                                        "entry_id": "37aef86b-1367-30b8-9d4c-ae97b6d7ff75",
                                        "glosses": [
                                            "An observation tower in which a lookout keeps watch over prisoners, or looks out for fires, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69596e3e-9d88-4030-8361-d387a301e56f",
                                                "sense_id": "3da3997a-0e70-369f-a3e9-02f99a10c030",
                                                "text": "A \"watchtower\" Website, keeping track of paedophile groups around the world, is expected to be up and running next year. The campaign will also liaise with law enforcement agencies around the world and share information on suspected Internet paedophiles."
                                            },
                                            {
                                                "example_id": "74f8aed0-4b5c-4601-a224-52b5d74dd5c2",
                                                "sense_id": "3da3997a-0e70-369f-a3e9-02f99a10c030",
                                                "text": "Redcap - A malevolent goblin easily distinguishable by their namesake red cap, fiery red eyes, claws and iron boots. They often appear as little old men, but can run very fast despite the boots. They reside in castles and watchtowers along the English-Scottish border, but will move their residence to avoid detection."
                                            },
                                            {
                                                "example_id": "a651f21a-fd57-4e38-b05a-cfd1101c2e6b",
                                                "sense_id": "3da3997a-0e70-369f-a3e9-02f99a10c030",
                                                "text": "Residents of Tungyin, a frontline islet under Taiwan’s Matsu islands cluster, said they spotted an unidentified aircraft flying overhead at 2.45pm on February 5, while video footage from the watchtower monitor showed an aircraft crossing the skies and flying out towards the east.\nThe military commanding centre of Tungyin confirmed that “a fixed-wing twin-propeller aircraft [had] briefly entered the airspace and soon left”."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "106ae8a0-4c1f-468a-b909-bae0e90e9c5b",
                        "source_entry_id": "e933d931-42e3-3822-8729-80445e6754ed",
                        "source_sense_id": "f8726389-c646-3d01-b211-f4c8923483a1",
