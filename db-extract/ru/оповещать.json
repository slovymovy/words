                                        "entry_id": "e3239238-37a5-37e7-b278-421c534a23ab",
                                        "glosses": [
                                            "To give (someone) notice (of some event)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7be8d2c6-4adb-469a-bc1d-6dfccb8fa180",
                                                "sense_id": "e5fe6106-9be9-3a30-9ef7-79b7e2386bae",
                                                "text": "The dispatcher immediately notified the volunteer fire department of the emergency call."
                                            },
                                            {
                                                "example_id": "27722ff7-9802-4ccd-98d7-822f14829c44",
                                                "sense_id": "e5fe6106-9be9-3a30-9ef7-79b7e2386bae",
                                                "text": "Once a decision has been reached and notified to the parties it becomes binding."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "831f312f-f6d8-3547-909c-d700e3b714b5",
