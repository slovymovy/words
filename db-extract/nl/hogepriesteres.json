                "senses": [
                    {
                        "sense_id": "7c0a27c4-db32-3fcb-b9d3-1d631b3c925c",
                        "entry_id": "cbed8f45-05e8-3270-b5df-bffd7be01d79",
                        "glosses": [
                            "leidster van de vrouwelijke geestelijken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cc56380-9e8a-4ec9-9aec-aa04f68d5e24",
                                "sense_id": "7c0a27c4-db32-3fcb-b9d3-1d631b3c925c",
                                "text": "De ceremonie bij de oude tempel van Hera verliep iets anders dan gebruikelijk. Vanwege de regen kon de vlam niet worden ontstoken met zonnestralen die weerkaatsen in een parabolische spiegel. De hogepriesteres moest de reservevlam uit de repetitie van gisteren gebruiken."
                            },
                            {
                                "example_id": "a68c3faf-694e-4412-86f1-f005a8895612",
                                "sense_id": "7c0a27c4-db32-3fcb-b9d3-1d631b3c925c",
                                "text": "De traditie blijft hetzelfde. Een hogepriesteres ontsteekt via de zonnestralen die weerkaatsen in een parabolische spiegel een toorts. Die brandende fakkel begint vervolgens aan een lange estafette die eindigt op 24 juli in het Olympisch Stadion van Tokio."
                            }
                        ]
                    }
                ],
