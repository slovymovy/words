                        "sense_id": "a78ba334-e3b4-3f27-8767-aaf1db315b5a",
                        "entry_id": "2fea571e-a448-35b8-beb5-18991cf5ec60",
                        "glosses": [
                            "auf der Erdoberfläche angenommener Großkreis, auf dessen Ebene (die Äquatorebene) die Erdachse senkrecht steht."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c7af6f1-3331-4403-a482-cb830ffde51c",
                                "sense_id": "a78ba334-e3b4-3f27-8767-aaf1db315b5a",
                                "text": "„Am kürzesten währt die Dämmerung nahe dem Erdäquator zur Tagundnachtgleiche und ist dann bürgerlich 20 Minuten, nautisch 45 Minuten und astronomisch 70 Minuten nach Sonnenuntergang zu Ende.“"
                            },
                            {
                                "example_id": "71410eee-65ca-4605-81af-9c2a94927623",
                                "sense_id": "a78ba334-e3b4-3f27-8767-aaf1db315b5a",
                                "text": "„Die Kreisbahn eines geostationären Satelliten liegt immer über dem Erdäquator.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
