                ],
                "senses": [
                    {
                        "sense_id": "8df2a62e-70f6-34dc-b917-e11fa6c9e16f",
                        "entry_id": "15528ef2-a3d2-3237-a6b0-4d0e1af6fda7",
                        "glosses": [
                            "lufttechnische Rauchschutzvorrichtung zum rauchdichten Verschließen eines Lüftungskanales in F30 bei Rauchdetektion über RM oder BMA"
                        ],
                        "tags": [
                            "Rauchabschnittsbegrenzung"
                        ],
                        "examples": [
                            {
                                "example_id": "b19ae9e9-7788-4463-bad6-03a64db3d243",
                                "sense_id": "8df2a62e-70f6-34dc-b917-e11fa6c9e16f",
                                "text": "„Die Einbaulage der Rauchschutzklappen ist luftstromrichtungsunabhängig.“"
                            },
                            {
                                "example_id": "2bccebc4-b4e8-44d4-a51c-16e14dadbd1c",
                                "sense_id": "8df2a62e-70f6-34dc-b917-e11fa6c9e16f",
                                "text": "„Rauchschutzklappen werden zur Verhinderung von Rauchübertragung in Lüftungszentralen von Zuluftanlagen, die mit Umluft oder nur mit Außenluft betrieben werden, und zur brandschutztechnischen Sanierung von Altanlagen eingesetzt.“"
                            },
                            {
                                "example_id": "3a87830c-7d05-40f5-8cff-457f44935fec",
                                "sense_id": "8df2a62e-70f6-34dc-b917-e11fa6c9e16f",
                                "text": "„Die Brandschutzklappen mit Rauchauslöseeinrichtung sowie die Verwendbarkeit von Rauchschutzklappen müssen durch allgemeine bauaufsichtliche Zulassungen des Deutschen Instituts für Bautechnik in Berlin nachgewiesen sein und entsprechend eingebaut werden; sonst ist eine Zustimmung im Einzelfall der obersten Bauaufsichtsbehörde oder der von ihr bestimmten Stelle erforderlich.“"
                            },
                            {
                                "example_id": "b5d789e2-c6f9-4551-ab62-37e76436c7ef",
                                "sense_id": "8df2a62e-70f6-34dc-b917-e11fa6c9e16f",
                                "text": "„Lüftungsleitungen bestehen aus allen von Luft durch strömten Bauteilen, wie Lüftungsrohren, -formstücken, -schächten und -kanälen, Schalldämpfern, Ventilatoren, Luftaufbereitungseinrichtungen, Absperrvorrichtungen gegen die Übertragung von Feuer und Rauch (Brandschutzklappen) und Absperrvorrichtungen gegen Rauchübertragung (Rauchschutzklappen) sowie aus ihren Verbindungen, Befestigungen, Dämmschichten, brandschutztechnischen Ummantelungen, Dampfsperren, Folien, Beschichtungen und Bekleidungen.“"
                            },
                            {
                                "example_id": "4a0d9d93-7295-4c6c-878e-ce2f5267b5cd",
                                "sense_id": "8df2a62e-70f6-34dc-b917-e11fa6c9e16f",
                                "text": "„Die Rauchschutzklappen innerhalb der RLT-Trassen sind vom Fachingenieur fachlich selbst zu planen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
