                                        "entry_id": "3752a8a7-d96b-3945-848a-177356f5a7b6",
                                        "glosses": [
                                            "An ancient prophet, the author of the Book of Jeremiah, and of the Lamentations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13e27469-ba84-4c0b-b8f6-826ca525dc97",
                                                "sense_id": "c36600e2-d739-3f85-b0a5-ab4a7d033c2a",
                                                "text": "And Ieremiah lamented for Ioſiah, and all the ſinging men and the ſinging women ſpake of Ioſiah in their lamentations to this day, and made them an ordinance in Iſrael; and beholde, they are written in the Lamentations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf09db93-3d47-3425-a9d8-bd1cef930848",
                                        "entry_id": "3752a8a7-d96b-3945-848a-177356f5a7b6",
                                        "glosses": [
                                            "A book of the Old Testament of Bible, and of the Tanakh."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f3260c5a-ceec-3984-a92c-97ff02d52156",
                                        "entry_id": "3752a8a7-d96b-3945-848a-177356f5a7b6",
                                        "glosses": [
                                            "A male given name from Hebrew of biblical origin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a616a442-879f-405f-bb98-692032c73eb6",
                                                "sense_id": "f3260c5a-ceec-3984-a92c-97ff02d52156",
                                                "text": "The man whom you call Diarmaid when you speak Irish, a low, pernicious, un-Irish, detestable custom, begot by slavery, and propagated by cringing, and fostered by flunkeyism, forces you to call Jeremiah when you speak English, or as a concession, Darby."
                                            }
                                        ]
                                    }
                                ]
                            },
