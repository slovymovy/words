                ],
                "senses": [
                    {
                        "sense_id": "dac7409d-83c8-38e2-9ff3-a4687605b6d3",
                        "entry_id": "f8f18062-a9d3-3056-a577-64a689ef0619",
                        "glosses": [
                            "Wortzeichen, das die Form eines Bindestrichs hat und dazu verwendet wird, auf einen Wortteil hinzuweisen, der ausgelassen wurde, um seine Wiederholung zu vermeiden."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cae140df-1313-4896-8b00-9ef5110297a8",
                                "sense_id": "dac7409d-83c8-38e2-9ff3-a4687605b6d3",
                                "text": "Ein Ergänzungsstrich steht stellvertretend für einen Wortteil, der kurz nachher genannt wird."
                            },
                            {
                                "example_id": "48e000ae-8eec-41c9-9962-080a2daecc54",
                                "sense_id": "dac7409d-83c8-38e2-9ff3-a4687605b6d3",
                                "text": "Der Ergänzungsstrich dient der Vermeidung von Wiederholungen in kurzem Abstand."
                            },
                            {
                                "example_id": "773637e2-f803-4551-b6c3-f77393e77aff",
                                "sense_id": "dac7409d-83c8-38e2-9ff3-a4687605b6d3",
                                "text": "In der Wortgruppe „Hals- und Beinbruch“ steht der Ergänzungsstrich in „Hals-“ für „bruch“, das sonst zweimal in kurzem Abstand genannt werden müsste."
                            },
                            {
                                "example_id": "a02b174e-12db-41b3-9818-b3abed687c66",
                                "sense_id": "dac7409d-83c8-38e2-9ff3-a4687605b6d3",
                                "text": "„Einen Ergänzungsstrich (Bindestrich als Ergänzungszeichen) setzt man, um anzuzeigen, dass ein gleicher Bestandteil von Zusammensetzungen oder Ableitungen eingespart wird <§ 98>.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
