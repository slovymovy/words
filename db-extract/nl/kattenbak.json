                                        "entry_id": "ff49b6ef-b4e5-37a7-9041-9b0173ccb9fb",
                                        "glosses": [
                                            "in Innenräumen bereitgestellte Toilette für Katzen, die mit körniger Katzenstreu gefüllt wird"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37a57a72-119c-489c-826c-24ff4a3499e9",
                                                "sense_id": "feb08de0-2bd3-3297-980c-a55687512b5d",
                                                "text": "Bei den Nachbarn steht das Katzenklo in der Küche neben dem Esstisch."
                                            },
                                            {
                                                "example_id": "445c5dc8-bcf8-4ea8-b075-069b68080c3d",
                                                "sense_id": "feb08de0-2bd3-3297-980c-a55687512b5d",
                                                "text": "Seit wir ein Katzenklo mit Dach haben, verrichtet der Kater sein Geschäft nicht mehr in der Zimmerecke."
                                            },
                                            {
                                                "example_id": "23e3fc67-a7f8-4c51-9205-1ae3501df83d",
                                                "sense_id": "feb08de0-2bd3-3297-980c-a55687512b5d",
                                                "text": "Wegen der 14 Katzen, die sie sich hält, finden sich überall im Haus Katzenklos."
                                            },
                                            {
                                                "example_id": "d9a292dc-45ed-444e-8a6b-0ed6b9cb7ac4",
                                                "sense_id": "feb08de0-2bd3-3297-980c-a55687512b5d",
                                                "text": "„Ich habe ihm vorgemacht, wie man das Katzenklo benutzt, und im Gegenzug hat er mir beigebracht, wie man ein Sofa zerkratzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
