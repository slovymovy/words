                        "examples": [
                            {
                                "example_id": "72957c69-7ccc-4155-816e-2b4928aa2fad",
                                "sense_id": "db01000d-ce1a-3fbb-bb5b-1f09534e95f4",
                                "text": "„Die ungeheure Bergkette um sich herum empfand er wie einen dunkleren Saum am Nachthimmel.“"
                            },
                            {
                                "example_id": "b350fa8b-df90-48bf-8973-b2d65a6bafde",
                                "sense_id": "db01000d-ce1a-3fbb-bb5b-1f09534e95f4",
                                "text": "„Durch einen ungeheuren Spalt in der Bergkette sehen wir zur Linken in weiter, weiter Ferne ein anderes Tal mit Dörfern und Hütten und gelben Ackerfeldern an den Bergen hinauf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
