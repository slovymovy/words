                "senses": [
                    {
                        "sense_id": "f1f693e3-aea3-3ce2-8710-ee67bf534847",
                        "entry_id": "54ff7153-d3e1-384c-8fc6-ff0453022edd",
                        "glosses": [
                            "geformte und gefärbte Masse aus gemahlenem Fischfleisch"
                        ],
                        "tags": [
                            "japanische Küche"
                        ],
                        "examples": [
                            {
                                "example_id": "dd0bbe80-b46f-4960-ae97-578a4e5b9e16",
                                "sense_id": "f1f693e3-aea3-3ce2-8710-ee67bf534847",
                                "text": "„Das moderne Surimi ist eine fast völlig geruchs- und geschmacksfreie, dazu blütenweiße Masse – ein Grundprodukt also, das so manipulierbar ist, wie sich's die Industrie nur wünschen kann.“"
                            },
                            {
                                "example_id": "1dff7b2b-c2a1-4f51-b5df-bbf9c3890576",
                                "sense_id": "f1f693e3-aea3-3ce2-8710-ee67bf534847",
                                "text": "„Aus simplem Fischmehl wird das Fleischimitat „Surimi“ in Form von Garnelenschwänzen gepreßt. Es sieht aus wie Krebsfleisch, ist aber keines. Selbst Entenfedern werden chemisch zu Quark umgewandelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "78107882-f448-4ddc-98e6-4f6bdca6e5d1",
                        "source_entry_id": "54ff7153-d3e1-384c-8fc6-ff0453022edd",
                        "source_sense_id": "f1f693e3-aea3-3ce2-8710-ee67bf534847",
                        "source_sense_description": "Gastronomie, japanische Küche: geformte und gefärbte Masse aus gemahlenem Fischfleisch",
                        "target_lang_word": "surimi",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surimi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ecef8511-03fa-300d-8325-a1bbc51a968b",
                                        "entry_id": "7e83b096-7f30-3770-8930-cbcbf30e3610",
                                        "glosses": [
                                            "A white paste, made from ground fish, that is used to make formed and textured food products."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b910a6e-7a2e-4625-83c4-d6db31cefa5d",
                                                "sense_id": "ecef8511-03fa-300d-8325-a1bbc51a968b",
                                                "text": "In Singapore, the most popular surimi-based product is the fish ball, which is used in a local application, Yong Tau Foo."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7774ca1-d4bb-41d4-89de-fb1241195674",
                        "source_entry_id": "54ff7153-d3e1-384c-8fc6-ff0453022edd",
                        "source_sense_id": "f1f693e3-aea3-3ce2-8710-ee67bf534847",
                        "source_sense_description": "Gastronomie, japanische Küche: geformte und gefärbte Masse aus gemahlenem Fischfleisch",
                        "target_lang_word": "surimi",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surimi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ea077e7-2ab8-30fb-9eaf-b1966ad8521b",
                                        "entry_id": "7df130f3-9131-3a91-a1c5-5e845b883e31",
                                        "glosses": [
                                            "Préparation alimentaire industrielle qui se présente sous la forme d’un bâtonnet réalisé à base de chair de poisson blanc reconstitué sous forme de pâte, aromatisé au goût de poisson ou de fruit de mer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c056552-e706-4361-8782-75f6b64ad84b",
                                                "sense_id": "0ea077e7-2ab8-30fb-9eaf-b1966ad8521b",
                                                "text": "Un succès dû, en partie, à un nutritionniste qui a connu son heure de gloire entre 2008 et 2012 : le docteur Pierre Dukan, adepte du régime hyperprotéiné, recommandait alors la consommation de surimi. — (« Surimi : Surestimé », Malbouffe, le dico, Les Dossiers du Canard enchaîné nᵒ 147, avril 2018, page 78)"
                                            },
                                            {
                                                "example_id": "a1f5f2d4-98af-45fc-896a-43979c233c93",
                                                "sense_id": "0ea077e7-2ab8-30fb-9eaf-b1966ad8521b",
                                                "text": "Passe encore pour notre génération qui a vu de ses yeux moudre le grain & tuer le lapin, mais pour les enfants des villes qui croient que les salades poussent dans des sacs en plastique, que le surimi est un poisson des mers du Sud & ignorent que le lait jaillit tiède du pis des vaches ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
