                "senses": [
                    {
                        "sense_id": "752b91c1-2ece-3933-bcd0-7befff6384e9",
                        "entry_id": "dafd732f-b7cb-3133-91e0-d556ebbd953b",
                        "glosses": [
                            "ktoś, kto kogoś popiera; zwolennik, stronnik"
                        ],
                        "tags": [],
