                "senses": [
                    {
                        "sense_id": "e76a7292-75d9-3225-b145-fde6284bd86c",
                        "entry_id": "8e34da50-a83b-397e-895f-1cb4724436b8",
                        "glosses": [
                            "Verletzung der Achillessehne in Folge eines Risses"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6acb6cc-e9d7-4884-af49-27bda4bf3617",
                                "sense_id": "e76a7292-75d9-3225-b145-fde6284bd86c",
                                "text": "Bei einem Achillessehnenriss reißt die Sehne, die die Wadenmuskulatur mit dem Fersenbein verbindet."
                            },
                            {
                                "example_id": "c6613dd6-2aaf-4c12-a439-ac26ca11a7f3",
                                "sense_id": "e76a7292-75d9-3225-b145-fde6284bd86c",
                                "text": "Die Verwendung von Spezialschuhen mit einer Erhöhung im Bereich der Ferse und fester Zunge ist hilfreich für die konservative Therapie des Achillessehnenrisses."
                            },
                            {
                                "example_id": "04130926-737b-41ea-b8cb-ccf70d2ffba2",
                                "sense_id": "e76a7292-75d9-3225-b145-fde6284bd86c",
                                "text": "Ein Achillessehnenriss sollte immer dann operiert werden, wenn die Sehne vollständig gerissen ist und die Sehnenenden sich nicht berühren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
