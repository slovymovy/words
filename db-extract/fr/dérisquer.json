                ],
                "senses": [
                    {
                        "sense_id": "e86be0e5-3b0c-3248-972b-4a3bcab2377d",
                        "entry_id": "72c15606-9a6a-3465-83f5-9ce8153bdf2d",
                        "glosses": [
                            "Supprimer le risque de, rendre sûr."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "55d7a7b0-3565-419c-a091-4a7377f17236",
                                "sense_id": "e86be0e5-3b0c-3248-972b-4a3bcab2377d",
                                "text": "Afin de « dérisquer » un business plan, Santi (2000) a proposé une méthode, le « milestone planning »."
                            },
                            {
                                "example_id": "e93b2a70-cab4-48a1-a272-e51466fff550",
                                "sense_id": "e86be0e5-3b0c-3248-972b-4a3bcab2377d",
                                "text": "Elles peuvent en effet favoriser les approches collaboratives momentanées entre les acteurs concurrents d’un secteur, afin de leur permettre de « dérisquer » ensemble ce secteur avant que le jeu du marché ne reprenne son cours."
                            },
                            {
                                "example_id": "7e803883-e797-4ee5-94c1-5b7a02920eef",
                                "sense_id": "e86be0e5-3b0c-3248-972b-4a3bcab2377d",
                                "text": "Le nouveau record français à 55 milliards d’euros pour 2022 illustre le manque de réciprocité dans l’accès au marché chinois mais aussi désormais la volonté d’exportateurs français de « dérisquer » leur activité en Asie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98a21790-8a23-45d6-bb5f-ddd5fd6d9e25",
                        "source_entry_id": "72c15606-9a6a-3465-83f5-9ce8153bdf2d",
                        "source_sense_id": "e86be0e5-3b0c-3248-972b-4a3bcab2377d",
                        "target_lang_word": "derisk",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "derisk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4752ba70-8c58-3118-b621-301cbbe83894",
                                        "entry_id": "fc4f8a48-7949-39ec-b943-56ff037a2b26",
                                        "glosses": [
                                            "To remove the risk from; to make safe."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f411abb-11db-46a2-bc89-45be39357d75",
                                                "sense_id": "4752ba70-8c58-3118-b621-301cbbe83894",
                                                "text": "Thus, rather than paying for the perceptions (no doubt valid) of higher risk, the challenge is to derisk the situation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
