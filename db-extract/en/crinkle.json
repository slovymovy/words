                    }
                ],
                "senses": [
                    {
                        "sense_id": "7fa8b875-6922-376d-a9a2-8a9b708ff427",
                        "entry_id": "71a2a2a2-f754-3cce-87f7-714236c0dd19",
                        "glosses": [
                            "A wrinkle, fold, crease, or unevenness."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5782749-cf70-4e49-af02-2ce7a1f32c97",
                                "sense_id": "7fa8b875-6922-376d-a9a2-8a9b708ff427",
                                "text": "He observed the crinkles forming around his eyes and suddenly felt old."
                            }
                        ]
                    },
                    {
                        "sense_id": "a1cf26fa-5db6-3ae3-b30d-5c88d6671419",
                        "entry_id": "71a2a2a2-f754-3cce-87f7-714236c0dd19",
                        "glosses": [
                            "The act of crinkling."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f987e5ae-925f-497b-9d06-896299c02140",
                        "source_entry_id": "71a2a2a2-f754-3cce-87f7-714236c0dd19",
                        "source_sense_description": "wrinkle, fold, crease, or unevenness",
                        "target_lang_word": "Falte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Falte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a63b3c8a-9102-30cf-a0cc-3aeeb516133e",
                                        "entry_id": "17e688dd-af9d-3f30-b068-580774b5b0e2",
                                        "glosses": [
                                            "längliche Unebenheit in ebenen, glatten Oberflächen insbesondere bei textilen Stoffen, Papier, Haut und Ähnlichem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b64e9e6-2a44-488a-b7bc-5a4851f3dc6d",
                                                "sense_id": "a63b3c8a-9102-30cf-a0cc-3aeeb516133e",
                                                "text": "Er hat schon viele Falten im Gesicht."
                                            },
                                            {
                                                "example_id": "88978f23-6e0f-4737-b18c-64311eee1d67",
                                                "sense_id": "a63b3c8a-9102-30cf-a0cc-3aeeb516133e",
                                                "text": "Ich muss die Bluse noch einmal bügeln, am Kragen sind noch lauter kleine Falten."
                                            },
                                            {
                                                "example_id": "df79f202-2301-4a60-b581-b4d43b6c9e4e",
                                                "sense_id": "a63b3c8a-9102-30cf-a0cc-3aeeb516133e",
                                                "text": "„Sie trug nichts darunter, und ihre Brustwarzen stießen spitz durch den leichten Stoff und ließen ihn in zwei schmalen, abstehenden Falten bis zum Saum fallen.“"
                                            },
                                            {
                                                "example_id": "ff3a76e6-f3fd-4d43-8603-b418173cbcd6",
                                                "sense_id": "a63b3c8a-9102-30cf-a0cc-3aeeb516133e",
                                                "text": "„Darunter lagen schneeweiße Linnenlaken mit frischen Falten.“"
                                            },
                                            {
                                                "example_id": "08d78647-d0c2-4986-a1d1-11d2b831deed",
                                                "sense_id": "a63b3c8a-9102-30cf-a0cc-3aeeb516133e",
                                                "text": "„Die kleinen Falten um seine funkelnden Augen vertieften sich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7316f3cf-c864-4a4e-b277-db52b8ceba88",
                        "source_entry_id": "71a2a2a2-f754-3cce-87f7-714236c0dd19",
                        "source_sense_description": "wrinkle, fold, crease, or unevenness",
                        "target_lang_word": "Fältchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fältchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4dd8f4d7-baed-3403-a708-34c790532924",
                                        "entry_id": "9a1fe8d5-90b3-3216-8489-d6bcde84ea07",
                                        "glosses": [
                                            "eine leichte, kleine Falte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41d0b66b-8ce6-4716-9ca7-831cea8f2f4c",
                                                "sense_id": "4dd8f4d7-baed-3403-a708-34c790532924",
                                                "text": "„Sie senkte das Glas; ein Wölkchen von getäuschter Erwartung und Trauer lagerte sich unter den blonden Locken, die schönen Bogen der Brau’n zogen sich zusammen und ließen ein kaum merkliches Fältchen des Unmuts sehen.“"
                                            },
                                            {
                                                "example_id": "8351a052-cf8d-48d7-8015-65e6996a9687",
                                                "sense_id": "4dd8f4d7-baed-3403-a708-34c790532924",
                                                "text": "„Feine Fältchen spannten sich über ihren Nasenrücken.“"
                                            },
                                            {
                                                "example_id": "a10a5b8d-79fd-4ef3-b02c-0fa3b2a6a194",
                                                "sense_id": "4dd8f4d7-baed-3403-a708-34c790532924",
                                                "text": "„Durch die Arbeit im Garten hat sie einen frischen Teint, aber an den Augen zeigen sich immer mehr kleine Fältchen.“"
                                            },
                                            {
                                                "example_id": "b67720d3-a4f2-4e42-8e6a-de8ecdbadb7b",
                                                "sense_id": "4dd8f4d7-baed-3403-a708-34c790532924",
                                                "text": "„Als sie an der Zigarette zog, sah ich ein paar Fältchen um ihren Mund, die ich noch nie gesehen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
