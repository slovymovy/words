                    {
                        "sense_id": "1959be0b-9460-3d82-80d1-c87fc5c3220c",
                        "entry_id": "f71802d5-3629-3608-8f43-edfb3ec3c676",
                        "glosses": [
                            "Mitglied der Ordnungstruppe im Tower of London und dort auch Touristenführer; früher: Mitglied der königlichen Leibgarde"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "b85e7ec7-c49f-4190-88fb-c440c07db69d",
                                "sense_id": "1959be0b-9460-3d82-80d1-c87fc5c3220c",
                                "text": "„Diese Dramen kennt aber dort zulande nicht bloß der Gebildete, sondern auch jeder im Volke, und sogar der dicke Beefeater, der mit seinem roten Rock und roten Gesicht im Tower als Wegweiser dient, und dir hinter dem Mitteltor das Verlies zeigt, wo Richard seine Neffen, die jungen Prinzen ermorden lassen, verweist dich an Shakespeare, welcher die nähern Umstände dieser grausamen Geschichte beschrieben habe.“"
                            }
                        ],
