            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a2994bcc-79d3-39af-a07d-4253ae786157",
                    "sense_definition": "Eine Speise oder ein Getränk, das bereits abgekühlt ist, wieder warm oder heiß machen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "temperatur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Heike <w>wärmt</w> das Essen in der Mikrowelle <w>auf</w>."
                        },
                        {
                            "text": "Ich habe die Reste von gestern noch einmal für uns alle <w>aufgewärmt</w>."
                        }
                    ],
                    "synonyms": [
                        "erwärmen",
                        "warm machen"
                    ],
                    "common_phrases": [
                        "das Essen aufwärmen",
                        "die Suppe aufwärmen",
                        "Reste aufwärmen"
                    ]
                },
                {
                    "sense_id": "82de3752-b8d1-3ffd-bf09-0a850f07493d",
                    "sense_definition": "Sich vor einer sportlichen Betätigung durch leichte Übungen körperlich vorbereiten.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vor jedem Training sollte man sich mindestens zehn Minuten lang gründlich <w>aufwärmen</w>."
                        },
                        {
                            "text": "Die Spieler laufen über das Spielfeld und <w>wärmen</w> sich vor dem Match <w>auf</w>."
                        }
                    ],
                    "common_phrases": [
                        "sich gründlich aufwärmen",
                        "sich vor dem Sport aufwärmen"
                    ]
                },
                {
                    "sense_id": "fafc861d-9e72-3c9d-9c7e-703448e64991",
                    "sense_definition": "Seinen durchfrorenen Körper an einer Wärmequelle wieder warm werden lassen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "temperatur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach dem langen Spaziergang im Schnee <w>wärmten</w> wir uns am Kamin <w>auf</w>."
                        },
                        {
                            "text": "Komm schnell ins Haus und trink einen heißen Tee, damit du dich <w>aufwärmst</w>."
                        }
                    ],
                    "common_phrases": [
                        "sich am Kamin aufwärmen",
                        "sich am Ofen aufwärmen"
                    ]
                },
                {
                    "sense_id": "a1e56417-6b5e-3e73-96c3-a3916eb6acbd",
                    "sense_definition": "Vergangene, meist unangenehme Themen oder Konflikte erneut zur Sprache bringen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gespraech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Es bringt doch überhaupt nichts, diese alten Geschichten jetzt wieder <w>aufzuwärmen</w>."
                        },
                        {
                            "text": "Warum musst du bei jedem Treffen den alten Streit von damals erneut <w>aufwärmen</w>?"
                        }
                    ],
                    "common_phrases": [
                        "alte Geschichten aufwärmen",
                        "einen alten Streit aufwärmen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "im übertragenen Sinn"
                        }
                    ]
                }
            ]
        },
        {
