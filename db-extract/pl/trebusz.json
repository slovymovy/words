                                        "entry_id": "1dc5a960-f2de-34d8-b5fe-0184bd1adbd8",
                                        "glosses": [
                                            "Arma de asedio medieval, parecida a la catepulta, empleada para destruir murallas o para lanzar proyectiles sobre los muros."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2b54d0d-f2aa-43b6-a3ba-cf17d75ca51c",
                                                "sense_id": "897c3dfd-0c18-37bd-aee6-161ac5d6fd8e",
                                                "text": "Se levantaron los fundíbulos, se prepararon las hondas, brillaron las espadas, se encresparon las lanzas e incesantemente se lanzaron saetas."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
