                        "form": "félons"
                    },
                    {
                        "form_id": "d05c3e59-b9fe-4488-bd50-f9b223e0f67f",
                        "entry_id": "c702d016-0972-35a9-924b-efff365a63f5",
                        "tags": [
                            "feminine"
                        ],
                        "form": "félonne"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e6fd6171-38a6-38fa-ba32-ece2d12fdd16",
                        "entry_id": "c702d016-0972-35a9-924b-efff365a63f5",
                        "glosses": [
                            "Vassal qui manque à la foi due à son seigneur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f411215e-8c5e-4a33-a981-eb60b704fc21",
                                "sense_id": "e6fd6171-38a6-38fa-ba32-ece2d12fdd16",
                                "text": "Ganelon est le type du félon."
                            }
                        ]
                    },
                    {
                        "sense_id": "64e73fc7-ed72-3137-92a9-a153683e27cb",
                        "entry_id": "c702d016-0972-35a9-924b-efff365a63f5",
                        "glosses": [
                            "Traître."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "7358d75a-b8b8-47ff-9797-3eaa3b182fbf",
                                "sense_id": "64e73fc7-ed72-3137-92a9-a153683e27cb",
                                "text": "« Rien n’est plus avilissant que d’imaginer un félon dans son entourage, pensait Clémence, et de commencer à chercher la trahison sur chaque visage… »"
                            },
                            {
                                "example_id": "a8c49ace-bc74-4f75-9b49-095b81a33a2f",
                                "sense_id": "64e73fc7-ed72-3137-92a9-a153683e27cb",
                                "text": "[…] plusieurs éléments de notre vocabulaire, et non les meilleurs, ont pratiquement disparu de l’usage. Je veux parler de tous ces termes désignant les méchants, les vils et les abjects. […] Exit aussi les ladres, les félons et les renégats."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1cb684b6-807b-4504-9ef0-8505e2fa1bbf",
                        "source_entry_id": "c702d016-0972-35a9-924b-efff365a63f5",
                        "target_lang_word": "felon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "felon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e3397c8-010c-36ec-b7ab-f0b6f829c1ab",
                                        "entry_id": "0aaca485-b90e-3641-8bcf-fc2d3b4a5a6b",
                                        "glosses": [
                                            "Of a person or animal, their actions, thoughts, etc.: brutal, cruel, harsh, heartless; also, evil, wicked."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f43acaad-eb25-4d0c-808d-46aa9191e729",
                                                "sense_id": "6e3397c8-010c-36ec-b7ab-f0b6f829c1ab",
                                                "text": "For Courteſies, tho' undeſerv'd and great, / No gratitude in Fellon-minds beget, / As tribute to his VVit, the churl receives the treat."
                                            },
                                            {
                                                "example_id": "10dc68cb-b644-4841-a052-eac2124b8c75",
                                                "sense_id": "6e3397c8-010c-36ec-b7ab-f0b6f829c1ab",
                                                "text": "And tvventy youths in radiant mail incas'd, / Cloſe ambuſh'd nigh the ſpacious hall he plac'd. / Then bids prepare the hoſpitable treat: / Vain ſhevvs of love to veil his felon hate!"
                                            },
                                            {
                                                "example_id": "b6aab1fe-1b9e-4a1b-9bb5-f488cd0ec348",
                                                "sense_id": "6e3397c8-010c-36ec-b7ab-f0b6f829c1ab",
                                                "text": "Nor outvvard Tempeſt, nor corroſive Time, / Nought but the felon undermining Hand / Of dark Corruption, can it's Frame diſſolve, / And lay the Toil of Ages in the duſt."
                                            },
                                            {
                                                "example_id": "79fd2f28-8c9d-417a-8b4a-ead893602632",
                                                "sense_id": "6e3397c8-010c-36ec-b7ab-f0b6f829c1ab",
                                                "text": "Yes, Leila sleeps beneath the wave, / But his shall be a redder grave; / Her spirit pointed well the steel / Which taught that felon heart to feel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f128cc4-68fe-31d1-9f00-b2d0c23dc0ee",
                                        "entry_id": "0aaca485-b90e-3641-8bcf-fc2d3b4a5a6b",
                                        "glosses": [
                                            "Of a place: harsh, savage, wild; of a thing: deadly; harmful."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ddacb873-65c7-42f7-a847-e966c9e9e60b",
                                                "sense_id": "1f128cc4-68fe-31d1-9f00-b2d0c23dc0ee",
                                                "text": "He ask'd the VVaves, and ask'd the Fellon vvinds, / VVhat hard miſhap hath doom'd this gentle ſvvain?"
                                            },
                                            {
                                                "example_id": "dbea8378-454d-433d-916d-221335c343f5",
                                                "sense_id": "1f128cc4-68fe-31d1-9f00-b2d0c23dc0ee",
                                                "text": "Thus often unbelief grovvn ſick of life, / Flies to the tempting pool or felon knife, / The jury meet, the coroner is ſhort, / And lunacy the verdict of the court: […]"
                                            },
                                            {
                                                "example_id": "75a3c2b4-2fc3-4175-a776-17bf27b7d025",
                                                "sense_id": "1f128cc4-68fe-31d1-9f00-b2d0c23dc0ee",
                                                "text": "The hand that mingled in the meal, / At midnight drew the felon steel, / And gave the host's kind breast to feel / Meed for his hospitality!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ada2464-798b-36ac-b3ad-b1fb86f6ffb7",
                                        "entry_id": "0aaca485-b90e-3641-8bcf-fc2d3b4a5a6b",
                                        "glosses": [
                                            "Obtained through a felony; stolen."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8106ff6d-4010-4ecd-aa69-91abe76a6d30",
                                                "sense_id": "6ada2464-798b-36ac-b3ad-b1fb86f6ffb7",
                                                "text": "Thus hee that conquer’d men, and beaſt moſt cruell, / (VVhoſe greedy pavves, vvith fellon goods vvere found) / Anſvver’d Goliah’s challenge in a duell, / And layd the Giant groveling on the ground: […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "felon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "65cb2fe5-b93e-3b50-b192-c6bd5e2b7e73",
                                        "entry_id": "815cdb64-90fc-3cdb-a86c-80260c573009",
                                        "glosses": [
                                            "A person who has committed a felony (“serious criminal offence”); specifically, one who has been tried and convicted of such a crime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d9d08d4-1c8c-4b07-9877-182aeba9edfd",
                                                "sense_id": "65cb2fe5-b93e-3b50-b192-c6bd5e2b7e73",
                                                "text": "I doe defie thy coniurations: / And doe attach thee as a fellon heere."
                                            },
                                            {
                                                "example_id": "646c4445-daf5-4cd8-94a1-3a0f3a70ad96",
                                                "sense_id": "65cb2fe5-b93e-3b50-b192-c6bd5e2b7e73",
                                                "text": "And therefore they are but like the Fellon that ſtandeth before the Judge, he quakes and trembles, and ſeems to repent most heartily; but the bottom of all is, the fear of the Halter, not of any deteſtation of the offence; as is evident, becauſe, let but this man have his liberty, and he vvill be a Thief, and ſo a Rogue still, vvhereas, if his mind vvas changed, he vvould be othervviſe."
                                            },
                                            {
                                                "example_id": "f8bdaf62-f199-409b-a52f-b618daffbdaf",
                                                "sense_id": "65cb2fe5-b93e-3b50-b192-c6bd5e2b7e73",
                                                "text": "Hovv, vvith leſs reading than makes felons 'ſcape, / Leſs human genius than God gives an ape, / Small thanks to France, and none to Rome or Greece, / A paſt, vamp'd, future, old, reviv'd, novv piece, […]"
                                            },
                                            {
                                                "example_id": "c353e471-03cf-4b90-b71e-4a08a6b02166",
                                                "sense_id": "65cb2fe5-b93e-3b50-b192-c6bd5e2b7e73",
                                                "text": "If the diſguſting detail of the accumulated inſults vve have received, in vvhat vve have very properly called our \"ſolicitation,\" to a gang of felons and murderers, had been produced as a proof of the utter inefficacy of that mode of proceeding vvith that deſcription of perſons, I ſhould have nothing at all to object to it."
                                            },
                                            {
                                                "example_id": "199c4c58-98ef-42a3-970b-208c87957fb8",
                                                "sense_id": "65cb2fe5-b93e-3b50-b192-c6bd5e2b7e73",
                                                "text": "Looking at the Jury and the turbulent audience, he might have thought that the usual order of things was reversed, and that the felons were trying the honest men."
                                            },
                                            {
                                                "example_id": "fc8e65e9-0d62-423b-aeb1-ea2fd6974160",
                                                "sense_id": "65cb2fe5-b93e-3b50-b192-c6bd5e2b7e73",
                                                "text": "The felon is the logical extreme of the epicure and coxcomb. Selfish luxury is the end of both, though in one it is decorated with refinements, and in the other brutal. But my point now is, that this spirit is not American."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8ce5993-ef37-39af-ae62-4d18941006f7",
                                        "entry_id": "815cdb64-90fc-3cdb-a86c-80260c573009",
                                        "glosses": [
                                            "An evil or wicked person; also (by extension) a predatory animal regarded as cruel or wicked."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "680eb94a-de32-4665-96ed-7a478b7613e6",
                                                "sense_id": "c8ce5993-ef37-39af-ae62-4d18941006f7",
                                                "text": "But he, the King of Heav'n, obſcure on high, / Bar'd his red Arm, and launching from the Sky / His vvrithen Bolt, not ſhaking empty Smoak, / Dovvn to the deep Abyſs the flaming Felon ſtrook."
                                            },
                                            {
                                                "example_id": "b7c36095-17f2-4463-b3d7-82b1bd522a5f",
                                                "sense_id": "c8ce5993-ef37-39af-ae62-4d18941006f7",
                                                "text": "The master'd felon press'd the ground, / And gasp'd beneath a mortal wound, / While o'er him stands the Bruce."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "felon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "41bb055b-7652-3b28-9f2e-d3a9e75b03af",
                                        "entry_id": "cf624d8e-9e4e-3044-8b53-709b43958fc5",
                                        "glosses": [
                                            "A small infected sore; an abscess, a boil; specifically, a whitlow (“infection near or under the cuticle of a fingernail or toenail”)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9299191-9b6f-40e8-b2ae-d5635d9860e7",
                                                "sense_id": "41bb055b-7652-3b28-9f2e-d3a9e75b03af",
                                                "text": "He hev been away from home for a few days, since he's had that felon upon his finger; for a' said, since I can't work I'll have a hollerday."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
