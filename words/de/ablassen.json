                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "substantivierung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das <w>Ablassen</w> des Wassers aus dem Becken dauerte fast zwei Stunden."
                        },
                        {
                            "text": "Beim plötzlichen <w>Ablassen</w> der Luft entstand ein sehr lautes Geräusch."
                        }
                    ],
                    "common_phrases": [
