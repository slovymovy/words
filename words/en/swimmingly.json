                            },
                            {
                                "target_lang_word": "успешно",
                                "target_lang_sense_clarification": "с достижением желаемого результата"
                            },
                            {
                                "target_lang_word": "превосходно",
                                "target_lang_sense_clarification": "очень хорошо"
                            }
                        ]
                    }
                },
                {
