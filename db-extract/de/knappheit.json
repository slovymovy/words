                "senses": [
                    {
                        "sense_id": "642e78ff-79e9-39fe-b3a0-75fbd55822ab",
                        "entry_id": "4a8543dd-c8d6-369b-bd1e-81e51d2841a5",
                        "glosses": [
                            "Vorhandensein von etwas in nicht/kaum ausreichender Menge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b0437a0-6e33-438d-8c6c-773ab4944eec",
                                "sense_id": "642e78ff-79e9-39fe-b3a0-75fbd55822ab",
                                "text": "„Wie sich die unterschiedlichen Ebenen der sozialen Matrix Knappheit im gesellschaftlichen und politischen Handeln niederschlagen und auf sie rückwirken können, will ich im Folgenden am Beispiel der indischen Entwicklungspolitik illustrieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8346c1c8-aa3a-333c-a143-4b9d9e2d9cd3",
                        "entry_id": "4a8543dd-c8d6-369b-bd1e-81e51d2841a5",
                        "glosses": [
                            "Eigenschaft/Zustand einer Äußerung, die nicht ohne Weiteres noch mehr verkürzt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d4a0d12-79ce-46a4-a721-bd09f1229af5",
                                "sense_id": "8346c1c8-aa3a-333c-a143-4b9d9e2d9cd3",
                                "text": "Er zeichnete sich durch eine besondere Knappheit der Darstellung aus."
                            },
                            {
                                "example_id": "301422ee-7575-4be4-8814-4a8b8bda7326",
                                "sense_id": "8346c1c8-aa3a-333c-a143-4b9d9e2d9cd3",
                                "text": "„Wichtigstes Bauprinzip eines Witzes ist seine Knappheit und Kürze.“"
                            },
                            {
                                "example_id": "5c5b1efa-83c2-48e3-b404-e8205f34cfdf",
                                "sense_id": "8346c1c8-aa3a-333c-a143-4b9d9e2d9cd3",
                                "text": "„Unser moderner Sprachgebrauch wird durch Grundsätze wie Knappheit und Genauigkeit, Sachlichkeit und Zweckmäßigkeit bestimmt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e3c1a1df-81a4-48ed-8cce-37af43943704",
                        "source_entry_id": "4a8543dd-c8d6-369b-bd1e-81e51d2841a5",
                        "source_sense_id": "642e78ff-79e9-39fe-b3a0-75fbd55822ab",
                        "source_sense_description": "Vorhandensein von etwas in nicht/kaum ausreichender Menge",
                        "target_lang_word": "pénurie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pénurie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "603e2138-8e53-371a-af7a-63ab01e85f20",
                                        "entry_id": "7d7753ec-2525-3458-9125-cba433123112",
                                        "glosses": [
                                            "Extrême disette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e1fd959-9357-43df-a8e2-9b5667ed7b12",
                                                "sense_id": "603e2138-8e53-371a-af7a-63ab01e85f20",
                                                "text": "Les sociétés de pénurie possèdent vraisemblablement une conscience de groupe plus développée que les sociétés d’abondance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8008d3cf-bfc1-3232-9eba-2416fdd4c456",
                                        "entry_id": "7d7753ec-2525-3458-9125-cba433123112",
                                        "glosses": [
                                            "Disette d’argent, pauvreté, misère."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb12c87c-61d1-49a2-884a-c658577d2ed0",
                                                "sense_id": "8008d3cf-bfc1-3232-9eba-2416fdd4c456",
                                                "text": "Cet homme est dans une grande pénurie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "037a4f4b-847d-3867-a77d-3f5223ab0227",
                                        "entry_id": "7d7753ec-2525-3458-9125-cba433123112",
                                        "glosses": [
                                            "Manque ; absence."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8c10a6a-3bf5-420a-9967-543b3777ba8c",
                                                "sense_id": "037a4f4b-847d-3867-a77d-3f5223ab0227",
                                                "text": "Lorsque l'œil était fait à cette pénurie de lumière, il distinguait, placées tout autour, ces pudibondes cloisons en usage dans les restaurants anglais."
                                            },
                                            {
                                                "example_id": "b049056a-5e73-48f7-b58d-f859bbc4b5da",
                                                "sense_id": "037a4f4b-847d-3867-a77d-3f5223ab0227",
                                                "text": "En se mettant en grève dans tout le pays, les pompistes ont rapidement provoqué une pénurie de carburant assez sérieuse."
                                            },
                                            {
                                                "example_id": "30f8b944-45dd-4366-9fb5-8e619e3e4e38",
                                                "sense_id": "037a4f4b-847d-3867-a77d-3f5223ab0227",
                                                "text": "Par ailleurs, le pays souffre d'une grave pénurie de ciment, qui engendre en parallèle une hausse des prix du secteur du bâtiment."
                                            },
                                            {
                                                "example_id": "b5c39ecf-b54a-41ff-acf6-e8e28fabe4d0",
                                                "sense_id": "037a4f4b-847d-3867-a77d-3f5223ab0227",
                                                "text": "L’État se contente d’organiser la pénurie, soupire Cyrille Godfroid, secrétaire général de ce syndicat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0eb7b89-1194-4ffb-bc31-168be448489c",
                        "source_entry_id": "4a8543dd-c8d6-369b-bd1e-81e51d2841a5",
                        "source_sense_id": "642e78ff-79e9-39fe-b3a0-75fbd55822ab",
