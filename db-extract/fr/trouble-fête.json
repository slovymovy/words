        "fr-extract.jsonl": [
            {
                "entry_id": "f2c5edd3-3d6f-37a4-84e1-2c0090213081",
                "word": "trouble-fête",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "04f4d7e1-c42f-4705-b3f6-e22eeb2f2c04",
                        "entry_id": "f2c5edd3-3d6f-37a4-84e1-2c0090213081",
                        "tags": [
                            "plural"
                        ],
                        "form": "trouble-fêtes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5b8868e4-4fe3-3103-b578-c88db51f365e",
                        "entry_id": "f2c5edd3-3d6f-37a4-84e1-2c0090213081",
                        "glosses": [
                            "Importun, indiscret qui vient interrompre la joie, les plaisirs d’une réunion publique ou particulière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bb0d7b2-751a-45c7-b6cc-6aa7b3417929",
                                "sense_id": "5b8868e4-4fe3-3103-b578-c88db51f365e",
                                "text": "Ce petit homme que le patron du bal avait aussitôt classé dans la catégorie des trouble-fête, eût bien été capable de causer un esclandre, pour peu qu’on le contrariât."
                            },
                            {
                                "example_id": "42ebb3c2-7b40-4599-bc14-502cc8bb075c",
                                "sense_id": "5b8868e4-4fe3-3103-b578-c88db51f365e",
                                "text": "Dans ce jardin public, ce réseau de sentiers d'amour, cette garenne de rencontres moites sous des paravents de genêts, on ne pouvait tant soi peu s'écarter de l'allée principale sans passer pour un trouble-fête ou un espincheur mal intentionné."
                            },
                            {
                                "example_id": "83a83b69-9adf-4116-b7b4-34ce9f231d4a",
                                "sense_id": "5b8868e4-4fe3-3103-b578-c88db51f365e",
                                "text": "Et maintenant, nous allons devoir jouer les trouble-fête et mettre Lilah au courant. Crois-moi, ça va chier dans le ventilo."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3650462e-3f77-40dd-a649-b3b355367637",
                        "source_entry_id": "f2c5edd3-3d6f-37a4-84e1-2c0090213081",
                        "source_sense_id": "5b8868e4-4fe3-3103-b578-c88db51f365e",
                        "source_sense_description": "Qui interrompt le plaisir d’une activité de groupe",
                        "target_lang_word": "Störenfried",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Störenfried",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b20920a1-4b45-38d9-994c-dc5bfaf78de9",
                                        "entry_id": "611aa1ce-e74f-37ff-8421-a1b215f1e846",
                                        "glosses": [
                                            "Person, die mit ihren Handlungen etwas/jemanden stört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afb1e6cc-81b0-439e-b57e-54303fbd4bb7",
                                                "sense_id": "b20920a1-4b45-38d9-994c-dc5bfaf78de9",
                                                "text": "Der Lehrer schickte den Störenfried vor die Tür."
                                            },
                                            {
                                                "example_id": "55879b65-cba4-4b7a-a1f2-15de2b578472",
                                                "sense_id": "b20920a1-4b45-38d9-994c-dc5bfaf78de9",
                                                "text": "Ein Störenfried ist häufig unbeliebt."
                                            },
                                            {
                                                "example_id": "3ea9501e-1cca-43da-a786-4a1b37d5b219",
                                                "sense_id": "b20920a1-4b45-38d9-994c-dc5bfaf78de9",
                                                "text": "„Dann putzte er das Monokel und schwieg, ohne den Blick von den Störenfrieden abzuwenden.“"
                                            },
                                            {
                                                "example_id": "1a536f46-fa07-4a91-84bd-03f811c691f3",
                                                "sense_id": "b20920a1-4b45-38d9-994c-dc5bfaf78de9",
                                                "text": "„Dieser Störenfried muss nicht nur ignoriert, sondern aktiv unterdrückt werden.“"
                                            },
                                            {
                                                "example_id": "52679984-2865-4110-b73e-2c55bc35c49e",
                                                "sense_id": "b20920a1-4b45-38d9-994c-dc5bfaf78de9",
                                                "text": "„Die einmütige Wut aber richtete sich gegen den unbekannten Neuling, diesen unerwünschten Eindringling und Störenfried.“"
                                            },
                                            {
                                                "example_id": "8e5d9ca5-1882-41fd-a87b-b9130054d05b",
                                                "sense_id": "b20920a1-4b45-38d9-994c-dc5bfaf78de9",
                                                "text": "[Andrij Melnyk:] „Der Botschafter der Ukraine in Berlin ist für die einen eine hoch geachtete politische Person, für andere ein Störenfried.“"
                                            },
                                            {
                                                "example_id": "a95c8132-2e75-43db-b277-0e452d03fdc3",
                                                "sense_id": "b20920a1-4b45-38d9-994c-dc5bfaf78de9",
                                                "text": "„»Die neue Regierung betrachtet die Umweltschützer nicht mehr als lästige Störenfriede, sondern sieht uns als Partner«, sagt Ali.“"
                                            },
                                            {
                                                "example_id": "1b2cfbaf-5079-4eb8-b7ca-d4240c88ddf4",
                                                "sense_id": "b20920a1-4b45-38d9-994c-dc5bfaf78de9",
                                                "text": "[Matthias Willenbacher:] „»Leute, die mit Kohle- und Atomkraftwerken Geld verdienen, und die Politiker, die diese Unternehmen unterstützen, sehen mich mit Sicherheit als Störenfried.«“"
                                            },
                                            {
                                                "example_id": "79018d6e-3570-426e-82c1-3c99f28ddd55",
                                                "sense_id": "b20920a1-4b45-38d9-994c-dc5bfaf78de9",
                                                "text": "„Vielleicht hätte er sich doch noch zurückhalten können; aber es verging kein Tag, ohne dass beim Fürsten Wassilij, der sonst selten Gäste empfing, eine Soiree stattgefunden hätte, an der Pierre teilnehmen musste, wenn er nicht als Störenfried wirken und die allgemeine Erwartung enttäuschen wollte.“"
                                            },
                                            {
                                                "example_id": "c492245a-2945-4fcd-a4d2-db005b99e849",
                                                "sense_id": "b20920a1-4b45-38d9-994c-dc5bfaf78de9",
                                                "text": "Durchgehend werden in der rechten Presse Polens die Migranten an der Grenze nicht als hilfsbedürftige Menschen, sondern als fremde Störenfriede dargestellt."
                                            },
                                            {
                                                "example_id": "1f8fa8d1-fd0f-41a7-bde3-8e26e97004b0",
                                                "sense_id": "b20920a1-4b45-38d9-994c-dc5bfaf78de9",
                                                "text": "„Für den britischen Philosophen John Stuart Mill sind wir als Gesellschaft auf Pluralismus, auf Störenfriede und Exzentriker angewiesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a6893a8e-7b24-407b-9b47-79e6c147fd20",
                        "source_entry_id": "f2c5edd3-3d6f-37a4-84e1-2c0090213081",
                        "source_sense_id": "5b8868e4-4fe3-3103-b578-c88db51f365e",
                        "source_sense_description": "Qui interrompt le plaisir d’une activité de groupe",
                        "target_lang_word": "party pooper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "party pooper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f7a6528-608f-3d1a-8ae2-94f9f93aaf3d",
                                        "entry_id": "689c5cef-3492-332c-9612-137c305f725b",
                                        "glosses": [
                                            "One who dampens fun; especially, one who declines to participate in or enjoy a party or some other group activity; one who does not agree with the opinions of a group."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80d1e853-207d-4001-b448-b98eacc68754",
                                                "sense_id": "5f7a6528-608f-3d1a-8ae2-94f9f93aaf3d",
                                                "text": "Call me anti-social, call me a holiday-hater, call me Scrooge, call me a party-pooper—call me anything, but please don't call me about a party you're giving because I won't come."
                                            },
                                            {
                                                "example_id": "aa077cd9-f055-43c0-9668-bcb9f83e6d25",
                                                "sense_id": "5f7a6528-608f-3d1a-8ae2-94f9f93aaf3d",
                                                "text": "Still, it's not something that any country can easily walk away from—not even a Bush administration that has made a habit of being the party pooper in international forums."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ef2c02c-6e8b-4a51-b1f7-cc2302423d16",
                        "source_entry_id": "f2c5edd3-3d6f-37a4-84e1-2c0090213081",
                        "source_sense_id": "5b8868e4-4fe3-3103-b578-c88db51f365e",
                        "source_sense_description": "Qui interrompt le plaisir d’une activité de groupe",
                        "target_lang_word": "spoilsport",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spoilsport",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de36dbff-493f-3e61-a143-c36ff5620459",
                                        "entry_id": "e74eeec6-7fc9-35b4-8340-a3abf6ccc16e",
                                        "glosses": [
                                            "Someone who puts an end to others' fun, especially harmless fun."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ff96a45-3c60-42c7-984e-76d918f931de",
                                                "sense_id": "de36dbff-493f-3e61-a143-c36ff5620459",
                                                "text": "I know I am a sad spoilsport, but it would make me wretched."
                                            },
                                            {
                                                "example_id": "1bfd4711-224c-4fa2-9b43-b2d1fc5a3e78",
                                                "sense_id": "de36dbff-493f-3e61-a143-c36ff5620459",
                                                "text": "He looks a spoilsport. There are men in whose presence it is impossible to have any fun: men who are a sort of walking conscience."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "spoilsport",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79922354-9271-35ed-bc2f-f85f2d67a8c3",
                                        "entry_id": "8546e938-6784-36d5-9635-8fdabfb829f3",
                                        "glosses": [
                                            "Like a spoilsport."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ec26bf3-4914-435d-a907-5ceb71439328",
                                                "sense_id": "79922354-9271-35ed-bc2f-f85f2d67a8c3",
                                                "text": "It may seem somewhat spoilsport to focus in on this negative after another important victory but to ignore it would be delusion. Southgate will not be letting it escape his attention."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
