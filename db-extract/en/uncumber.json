                    {
                        "sense_id": "b0a8cb3f-3c6f-33ce-be52-95dce3ffd007",
                        "entry_id": "25004b60-f559-3cfa-bff8-038afc6e2538",
                        "glosses": [
                            "To disencumber."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "9fc12a33-d873-4eb3-b5be-fcbab245805a",
                                "sense_id": "b0a8cb3f-3c6f-33ce-be52-95dce3ffd007",
                                "text": "... St. Wilgeforte (famous for praying for a beard to protect her virtue, and getting one as long as the Persian king's) obtained the name of St. Uncumber in England because, for a peck of oats, she would uncumber any woman who was tired of her husband;..."
                            },
                            {
                                "example_id": "44f7f142-5954-4901-b96e-307b173e464e",
                                "sense_id": "b0a8cb3f-3c6f-33ce-be52-95dce3ffd007",
                                "text": "\"But we call her Saint Uncumber,\" Mrs. Nicholson explained, \"because, if you've got a bad husband, she uncumbers you.\""
                            },
                            {
                                "example_id": "5805e324-7ce4-4c67-879f-b038bd856a1f",
                                "sense_id": "b0a8cb3f-3c6f-33ce-be52-95dce3ffd007",
                                "text": "The subcommittee concludes FDA should become less involved in the early stages of clinical research by streamlining and uncumbering its regulations governing them."
                            },
                            {
                                "example_id": "d43c93e6-94a1-4a67-9828-fd0e532645bd",
                                "sense_id": "b0a8cb3f-3c6f-33ce-be52-95dce3ffd007",
                                "text": "It is our regard for the body that uncumbers us."
                            }
                        ]
                    }
