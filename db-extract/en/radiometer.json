                    {
                        "translation_id": "aa46a3c6-f7e8-42d8-b9a4-e7838cbb20e0",
                        "source_entry_id": "37324531-5173-30b4-83bf-98feb9884d29",
                        "source_sense_id": "bacc192d-a6fd-332a-bef2-16d12139f901",
                        "source_sense_description": "device that measures radiant energy",
                        "target_lang_word": "radiomètre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "radiomètre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb485c04-c8ef-319f-8165-cba9edf9eb36",
                                        "entry_id": "d32e6d6c-853f-3014-ab9d-7854615d1fd3",
                                        "glosses": [
                                            "Instrument de mesure de l'intensité du flux de rayonnement électromagnétique, dans différentes longueurs d'onde telles que l'ultraviolet, la lumière visible ou l'infrarouge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b067a282-7f94-4772-9e2a-f1c95b58d5ad",
                                                "sense_id": "cb485c04-c8ef-319f-8165-cba9edf9eb36",
                                                "text": "Supposons un radiomètre observant un corps plan lambertien isotherme et considérons que θ et θ’ sont dans le même plan. L est la luminance intégrée dans la bande spectrale du radiomètre."
                                            },
                                            {
                                                "example_id": "ed2502e8-32b4-43f8-bc19-d10689668f28",
                                                "sense_id": "cb485c04-c8ef-319f-8165-cba9edf9eb36",
                                                "text": "Ils avaient brûlé ce qu’ils avaient adoré : les miroirs de sorcière, les billots, les stupides petits mobiles, les radiomètres, les cailloutis multicolores, les panneaux de jute agrémentés de paraphes à la Mathieu."
                                            },
                                            {
                                                "example_id": "62c2cb86-f081-4a31-8c00-bb2e9c134adb",
                                                "sense_id": "cb485c04-c8ef-319f-8165-cba9edf9eb36",
                                                "text": "Les radiomètres sont utilisés en météorologie pour mesurer avec précision le contenu en vapeur d'eau et en eau liquide de l'atmosphère."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "226917dc-2851-40aa-8016-50826818a51b",
                        "source_entry_id": "37324531-5173-30b4-83bf-98feb9884d29",
                        "source_sense_id": "bacc192d-a6fd-332a-bef2-16d12139f901",
                        "source_sense_description": "device that measures radiant energy",
                        "target_lang_word": "Strahlungsmesser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "10b31d8c-b9ba-4688-a625-a209e1a5ee6d",
                        "source_entry_id": "37324531-5173-30b4-83bf-98feb9884d29",
                        "source_sense_id": "bacc192d-a6fd-332a-bef2-16d12139f901",
                        "source_sense_description": "device that measures radiant energy",
                        "target_lang_word": "Radiometer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Radiometer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a4fecd3f-9790-36f6-87d9-0e86351ae7e0",
                                        "entry_id": "4613eb5e-2f13-3d42-8ba7-c8b2b351943b",
                                        "glosses": [
                                            "Strahlungsmessgerät, das 1874 von William Crookes erfunden wurde"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b714e2b0-1015-406d-bec9-5f435b4b8355",
                                                "sense_id": "a4fecd3f-9790-36f6-87d9-0e86351ae7e0",
                                                "text": "„Klarheit brachten erst Bilder aus 800 Kilometern Höhe: Der Esa-Satellit Envisat stellte mit Hilfe seines Radiometers, das Schwankungen der Wassertemperatur auf drei Zehntel Grad genau messen kann, eine seltene Wandlung der Strömungsverhältnisse vor der südchilenischen Küste fest.“"
                                            },
                                            {
                                                "example_id": "2116eb6c-1e44-4557-b6ea-666168c5b3ae",
                                                "sense_id": "a4fecd3f-9790-36f6-87d9-0e86351ae7e0",
                                                "text": "„Die 22 Kanäle dieses Radiometers erfassen, wie sein Name ‚Visible/Infrared Imager Radiometer Suite‘ nahelegt, den Bereich des sichtbaren und infraroten Lichtes.“"
                                            },
                                            {
                                                "example_id": "8785e779-c31c-45b6-8b70-e525d0284534",
                                                "sense_id": "a4fecd3f-9790-36f6-87d9-0e86351ae7e0",
                                                "text": "„In der Schweiz werden die Hörfunkreichweiten mittels eines Radiometers, einer speziellen digitalen Armbanduhr, gemessen, welche ausgewählte Probanden eine Woche lang mit sich führen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
