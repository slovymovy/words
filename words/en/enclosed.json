{
    "word_family": [
        "enclose",
        "enclosure",
        "unenclosed"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "626d7edb-2921-35da-ba33-69a47c270d6b",
                    "sense_definition": "Surrounded by a wall, fence, or similar barrier.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to build an <w>enclosed</w> garden to keep the deer out.",
                            "target_lang_translations": {
                                "ru": "Они решили построить <w>огороженный</w> сад, чтобы не пускать оленей.",
                                "zh": "他们决定建一个<w>封闭的</w>花园，以防鹿群进入。"
                            }
                        },
                        {
                            "text": "The children played safely in the <w>enclosed</w> area behind the school.",
                            "target_lang_translations": {
                                "ru": "Дети безопасно играли на <w>огороженной</w> территории за школой.",
                                "zh": "孩子们在学校后面那片<w>围起来的</w>区域里安全地玩耍。"
                            }
                        }
                    ],
                    "synonyms": [
                        "surrounded",
                        "encircled",
                        "bounded",
                        "confined"
                    ],
                    "antonyms": [
                        "open",
                        "exposed"
                    ],
                    "common_phrases": [
                        "enclosed space",
                        "enclosed area",
                        "enclosed garden",
                        "enclosed porch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Окруженный стеной, забором или другим барьером.",
                        "zh": "被墙壁、栅栏或其他屏障所包围。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "огороженный",
                                "target_lang_sense_clarification": "обнесенный забором или оградой"
                            },
                            {
                                "target_lang_word": "замкнутый",
                                "target_lang_sense_clarification": "о пространстве, изолированный"
                            },
                            {
                                "target_lang_word": "закрытый",
                                "target_lang_sense_clarification": "имеющий крышу или стены"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "封闭的",
                                "target_lang_sense_clarification": "指空间被围起来，不与外界直接相通"
                            },
                            {
                                "target_lang_word": "围起来的",
                                "target_lang_sense_clarification": "指被栅栏或墙壁环绕"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "75b0b6cd-1c14-300c-8eeb-caaaf6708e38",
                    "sense_definition": "Contained or held within a container, envelope, or package.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please review the <w>enclosed</w> documents before the meeting tomorrow.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, ознакомьтесь с <w>прилагаемыми</w> документами перед завтрашним собранием.",
                                "zh": "请在明天的会议前审阅<w>随信附上的</w>文件。"
                            }
                        },
                        {
                            "text": "The gas is completely <w>enclosed</w> within the bottle.",
                            "target_lang_translations": {
                                "ru": "Газ полностью <w>заключен</w> в баллоне.",
                                "zh": "气体被完全<w>封闭</w>在瓶子里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "included",
                        "inside",
                        "attached"
                    ],
                    "common_phrases": [
                        "enclosed document",
                        "enclosed copy",
                        "please find enclosed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся внутри контейнера, конверта или упаковки; прилагаемый.",
                        "zh": "包含在容器、信封或包裹内；随信附上的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вложенный",
                                "target_lang_sense_clarification": "находящийся внутри письма или посылки"
                            },
                            {
                                "target_lang_word": "прилагаемый",
                                "target_lang_sense_clarification": "идущий в комплекте с документом"
                            },
                            {
                                "target_lang_word": "заключенный",
                                "target_lang_sense_clarification": "содержащийся внутри чего-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "随信附上的",
                                "target_lang_sense_clarification": "指放在信件或邮件中的文件"
                            },
                            {
                                "target_lang_word": "内含的",
                                "target_lang_sense_clarification": "指被包含在某个容器或包装内"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8703995c-104e-3485-968d-c9f9e3b3bb67",
                    "sense_definition": "Simple past and past participle of <w>enclose</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>enclosed</w> a check with her letter to pay the bill.",
                            "target_lang_translations": {
                                "ru": "Она <w>вложила</w> чек в письмо, чтобы оплатить счет.",
                                "zh": "她在信中<w>附上</w>了一张支票用来支付账单。"
                            }
                        },
                        {
                            "text": "The ancient city was <w>enclosed</w> by high stone walls.",
                            "target_lang_translations": {
                                "ru": "Древний город был <w>окружен</w> высокими каменными стенами.",
                                "zh": "这座古城被高高的石墙<w>包围</w>着。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола enclose.",
                        "zh": "enclose 的过去式和过去分词。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вложил",
                                "target_lang_sense_clarification": "поместил внутрь"
                            },
                            {
                                "target_lang_word": "окружил",
                                "target_lang_sense_clarification": "создал преграду вокруг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "附上",
                                "target_lang_sense_clarification": "将某物放入信件或包裹中"
                            },
                            {
                                "target_lang_word": "包围",
                                "target_lang_sense_clarification": "在周围建立屏障"
                            }
                        ]
                    }
                }
            ]
        }
    ]
