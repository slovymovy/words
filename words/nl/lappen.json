                            {
                                "target_lang_word": "to chip in",
                                "target_lang_sense_clarification": "contributing money to a group fund"
                            },
                            {
                                "target_lang_word": "to cough up",
                                "target_lang_sense_clarification": "slang for paying money"
                            },
