                "senses": [
                    {
                        "sense_id": "05a18beb-71a1-3ed9-9530-1e3a8b6c2670",
                        "entry_id": "21942301-654f-3038-b0b5-7cd39598111b",
                        "glosses": [
                            "Consisting of separate modules; especially where each module performs or fulfills some specified function and could be replaced by a similar module for the same function, independently of the other modules."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "7d3b9f0a-35ce-4ef6-8228-c3ef57dc428a",
                                "sense_id": "05a18beb-71a1-3ed9-9530-1e3a8b6c2670",
                                "text": "It is hoped that a competition to develop small modular reactors (SMRs) will drive billions of pounds of investment into the technology, which the government hopes will be cheaper and quicker to build than traditional large nuclear power plants."
                            }
                        ]
                    },
