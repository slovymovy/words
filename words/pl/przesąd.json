    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b46f5347-2fd6-37fb-81de-f3ae78b0a730",
                    "sense_definition": "wiara w tajemnicze, nadprzyrodzone związki między różnymi zjawiskami, przynoszące szczęście lub nieszczęście",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wierzenia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Znany <w>przesąd</w> głosi, że zbicie lustra przynosi aż siedem lat nieszczęścia.",
                            "target_lang_translations": {
                                "ru": "Известное <w>суеверие</w> гласит, что разбитое зеркало приносит семь лет несчастий."
                            }
                        },
                        {
                            "text": "Wiele osób wciąż wierzy w dawne <w>przesądy</w>, chociaż nauka dawno je odrzuciła.",
                            "target_lang_translations": {
                                "ru": "Многие люди до сих пор верят в старые <w>суеверия</w>, хотя наука давно их отвергла."
                            }
                        }
                    ],
                    "synonyms": [
                        "zabobon"
                    ],
                    "common_phrases": [
                        "stary przesąd",
                        "ludowy przesąd",
                        "wierzyć w przesądy"
                    ],
                    "target_lang_definitions": {
                        "ru": "вера в таинственные, сверхъестественные связи между явлениями, приносящие удачу или неудачу"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "суеверие",
                                "target_lang_sense_clarification": "вера в сверхъестественные связи и приметы"
                            },
                            {
                                "target_lang_word": "предрассудок",
                                "target_lang_sense_clarification": "суеверное убеждение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc563130-97d2-3b66-b9ef-2105da529ae3",
                    "sense_definition": "głęboko zakorzenione, mylne i trudne do wykorzenienia przekonanie na jakiś temat",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "przekonania",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Edukacja jest najlepszym narzędziem, aby walczyć ze społecznymi <w>przesądami</w>.",
                            "target_lang_translations": {
                                "ru": "Образование — лучший инструмент для борьбы с общественными <w>предрассудками</w>."
                            }
                        },
                        {
                            "text": "Jego negatywna opinia na temat nowych technologii to tylko bezpodstawny <w>przesąd</w>.",
                            "target_lang_translations": {
                                "ru": "Его негативное мнение о новых технологиях — всего лишь необоснованный <w>предрассудок</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "społeczny przesąd",
                        "walczyć z przesądami"
                    ],
                    "target_lang_definitions": {
                        "ru": "глубоко укоренившееся, ошибочное и трудноискоренимое мнение о чём-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предрассудок",
                                "target_lang_sense_clarification": "укоренившееся ложное мнение"
                            },
                            {
                                "target_lang_word": "предубеждение",
                                "target_lang_sense_clarification": "предвзятое отношение"
                            },
                            {
                                "target_lang_word": "стереотип",
                                "target_lang_sense_clarification": "шаблонное представление"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d739d1e3-04e6-30d0-89d3-20e7c17590da",
                    "sense_definition": "rytuał lub zachowanie wynikające z wiary w zabobony",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wierzenia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Łapanie się za guzik na widok kominiarza to powszechny <w>przesąd</w> praktykowany przez mieszkańców.",
                            "target_lang_translations": {
                                "ru": "Держаться за пуговицу при виде трубочиста — распространенная <w>примета</w>, которой следуют горожане."
                            }
                        },
                        {
                            "text": "Odpukiwanie w niemalowane drewno stanowi tradycyjny <w>przesąd</w> chroniący rzekomo przed pechem.",
                            "target_lang_translations": {
                                "ru": "Постукивание по некрашеному дереву — традиционное <w>суеверие</w>, якобы защищающее от неудачи."
                            }
                        }
                    ],
                    "synonyms": [
                        "zabobon"
                    ],
                    "target_lang_definitions": {
                        "ru": "ритуал, действие или примета, основанные на суеверии"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "примета",
                                "target_lang_sense_clarification": "суеверное поверье или действие"
                            },
                            {
                                "target_lang_word": "суеверие",
                                "target_lang_sense_clarification": "ритуальное действие от сглаза или неудачи"
                            },
                            {
                                "target_lang_word": "поверье",
                                "target_lang_sense_clarification": "традиционный обряд или предписание"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}