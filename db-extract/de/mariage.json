                "senses": [
                    {
                        "sense_id": "5f0358fc-071a-3124-8652-1161a2e789b0",
                        "entry_id": "0127a4aa-37dd-3caa-93a3-156ea165169a",
                        "glosses": [
                            "Schließung einer Ehe"
                        ],
                        "tags": [
                            "archaic",
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "59259ca1-738a-4f82-a426-2e8f1520c8ed",
                                "sense_id": "5f0358fc-071a-3124-8652-1161a2e789b0",
                                "text": "„Er begründete das leicht und nachdrücklich für die Frau, die nun einmal als Operationsbasis des Mannes bedürfe, und zwar nicht ohne gewisse bürgerliche Auspizien, nicht ohne eine gewisse korrekte Geradlinigkeit als tragende Stütze des bizarr gestalteten Daseinsablaufes, nicht ohne eine formelle Mariage.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f5250580-42b9-3c70-85fe-ade85ece4950",
                        "entry_id": "0127a4aa-37dd-3caa-93a3-156ea165169a",
                        "glosses": [
                            "Kartenspiel für drei oder vier Spieler"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f76e50a-fca0-4556-bce0-6ff68598c436",
                                "sense_id": "f5250580-42b9-3c70-85fe-ade85ece4950",
                                "text": "„Niemand hörte mehr zu, denn Schwejk und Waněk spielten Mariage zu zweit […]“"
                            },
                            {
                                "example_id": "e507a46c-6c3c-4897-9b5e-7d00590d3257",
                                "sense_id": "f5250580-42b9-3c70-85fe-ade85ece4950",
                                "text": "„»Wenn du mir wenigstens die Pfeife anzünden möchtest«, sagte Schwejk freundschaftlich zu Chodounsky, »wenn du schon kiebitzen kommst. Mariage zu zweit is eine ernstere Sache wie der ganze Krieg und wie euer verfluchtes Abenteuer an der serbischen Grenze. – So eine Blödheit zu machen, ich sollt mich ohrfeigen! Daß ich nicht noch eine Weile gewartet hab mitn König, jetzt grad is mir der Ober gekommen. Ich Rindvieh.«“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
