                    {
                        "form_id": "d04e26e0-ec65-4e39-8a98-628a12e62b0e",
                        "entry_id": "006d388f-9817-34de-82ce-c3905e37103a",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Krebserkrankungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "30fb2cb1-21b3-341d-a617-4628c65b7d5f",
                        "entry_id": "006d388f-9817-34de-82ce-c3905e37103a",
                        "glosses": [
                            "durch Krebszellen hervorgerufener, krankhafter Prozess"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6bf53ba-ac37-4bef-a7fd-ce10ae718a46",
                                "sense_id": "30fb2cb1-21b3-341d-a617-4628c65b7d5f",
                                "text": "„Der heilige Hieronymus muß an eine Krebserkrankung gedacht haben, als er schrieb: »Der dort mit seinem geschwollenem Bauch geht schwanger mit seinem eigenen Tode« (»Alius tumenti aqualiculo mortem parturit«).“"
                            },
                            {
                                "example_id": "96cf0616-6ddf-4fbe-9ac1-1187cfa2a37b",
                                "sense_id": "30fb2cb1-21b3-341d-a617-4628c65b7d5f",
                                "text": "„Je früher eine Krebserkrankung entdeckt und behandelt wird, desto größer ist die Chance auf Heilung.“"
                            },
                            {
                                "example_id": "f9e650cc-dc6f-49b5-9ade-6593ae5ca485",
                                "sense_id": "30fb2cb1-21b3-341d-a617-4628c65b7d5f",
                                "text": "„Die häufigste Krebserkrankung ist beim Mann der Prostatakrebs, bei Frauen der Brustkrebs.“"
                            },
                            {
                                "example_id": "45cb6327-ae58-495c-945c-1b326241a8fe",
                                "sense_id": "30fb2cb1-21b3-341d-a617-4628c65b7d5f",
                                "text": "„Später, als ich nach Amalias Tod ihre Krankenakte zu Gesicht bekam und zurückrechnete, stellte ich fest, dass diese Episode mit dem Zeitpunkt ihrer ersten Krebserkrankung zusammenfiel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
