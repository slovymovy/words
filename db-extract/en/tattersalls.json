                        "entry_id": "54970af8-7639-3623-b175-1c5f8d5b842a",
                        "glosses": [
                            "A rendezvous at most British racecourses, provided by a company of auctioneers"
                        ],
                        "tags": [
                            "British"
                        ],
                        "examples": [
                            {
                                "example_id": "9f5ddaa1-26da-4022-8c6c-ff067217423f",
                                "sense_id": "760f0fb3-b762-3034-94b4-b40aa959c06d",
                                "text": "[…] the professional betting-man, who has no other occupation, and never misses a race-meeting, or a Tattersall's […]"
                            },
                            {
                                "example_id": "6d5f3d48-a1d6-4bcc-a56f-b603638bf129",
                                "sense_id": "760f0fb3-b762-3034-94b4-b40aa959c06d",
                                "text": "Tattersalls, adjacent to the County Stand, has no seating but stepped terracing and a large tarmac area down to the rails."
                            },
                            {
                                "example_id": "925a7851-1a87-4801-b437-4ee86c9af295",
                                "sense_id": "760f0fb3-b762-3034-94b4-b40aa959c06d",
                                "text": "In Manchester the Post Office Hotel was its equivalent to Tattersalls, with entry likewise by subscription but a distinct absence of gentry and aristocratic members […]"
                            },
                            {
                                "example_id": "45db2339-dd01-4a1a-905b-9fef3fea9431",
                                "sense_id": "760f0fb3-b762-3034-94b4-b40aa959c06d",
                                "text": "For three pounds you get a badge — a brown, green, yellow and white shield — that admits you to the grand stand, Tattersalls and the paddock, […]"
                            }
                        ]
                    }
