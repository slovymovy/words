{
    "word_family": [
        "verval",
        "vervalling",
        "vervaldatum",
        "vervaldag",
        "vervaltermijn"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cf66969f-dd89-3c6a-8dee-4b6520bbe003",
                    "sense_definition": "niet langer geldig zijn of de kracht van wet verliezen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "geldigheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze oude regeling is op 1 januari officieel komen te <w>vervallen</w>.",
                            "target_lang_translations": {
                                "en": "This old regulation officially <w>expired</w> on January 1st."
                            }
                        },
                        {
                            "text": "Je moet je paspoort vernieuwen voordat de huidige datum zal <w>vervallen</w>.",
                            "target_lang_translations": {
                                "en": "You must renew your passport before the current date <w>expires</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "aflopen"
                    ],
                    "antonyms": [
                        "gelden",
                        "ingaan"
                    ],
                    "common_phrases": [
                        "komen te vervallen"
                    ],
                    "target_lang_definitions": {
                        "en": "To no longer be valid or to lose the force of law."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to expire",
                                "target_lang_sense_clarification": "of a document or period"
                            },
                            {
                                "target_lang_word": "to lapse",
                                "target_lang_sense_clarification": "of a right or agreement"
                            },
                            {
                                "target_lang_word": "to be void",
                                "target_lang_sense_clarification": "no longer legally binding"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22daa9b1-16aa-374a-881f-920c32b9e89c",
                    "sense_definition": "niet doorgaan of uit het programma geschrapt worden",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "annulering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vlucht naar Madrid is wegens de staking helaas <w>vervallen</w>.",
                            "target_lang_translations": {
                                "en": "The flight to Madrid has unfortunately been <w>cancelled</w> due to the strike."
                            }
                        },
                        {
                            "text": "Door het slechte weer zal de geplande training vanavond <w>vervallen</w>.",
                            "target_lang_translations": {
                                "en": "Due to the bad weather, tonight's planned training will be <w>cancelled</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "doorgaan"
                    ],
                    "common_phrases": [
                        "is vervallen"
                    ],
                    "target_lang_definitions": {
                        "en": "To be cancelled or removed from a schedule or program."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to be cancelled",
                                "target_lang_sense_clarification": "of an event or flight"
                            },
                            {
                                "target_lang_word": "to be dropped",
                                "target_lang_sense_clarification": "from a program or agenda"
                            },
                            {
                                "target_lang_word": "to be scrapped",
                                "target_lang_sense_clarification": "informal, of plans"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f32a495-502b-3165-b74e-90824feb0afe",
                    "sense_definition": "in een slechte of verwaarloosde toestand geraken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het oude gebouw <w>verviel</w> tot weinig meer dan een trieste puinhoop.",
                            "target_lang_translations": {
                                "en": "The old building <w>decayed</w> into little more than a sad pile of rubble."
                            }
                        },
                        {
                            "text": "Zonder onderhoud zal dit prachtige kasteel langzaam tot een ruïne <w>vervallen</w>.",
                            "target_lang_translations": {
                                "en": "Without maintenance, this beautiful castle will slowly <w>fall into ruin</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vervallen tot"
                    ],
                    "target_lang_definitions": {
                        "en": "To fall into a state of neglect or disrepair."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to decay",
                                "target_lang_sense_clarification": "gradual deterioration"
                            },
                            {
                                "target_lang_word": "to fall into ruin",
                                "target_lang_sense_clarification": "of buildings"
                            },
                            {
                                "target_lang_word": "to deteriorate",
                                "target_lang_sense_clarification": "general decline in condition"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ea15b78-816d-3b3f-a274-cc41b45703f5",
                    "sense_definition": "terugvallen in een slechtere gewoonte of toestand",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij was bang om na de therapie weer in zijn oude fouten te <w>vervallen</w>.",
                            "target_lang_translations": {
                                "en": "He was afraid of <w>falling back</w> into his old mistakes after the therapy."
                            }
                        },
                        {
                            "text": "Het is makkelijk om in herhaling te <w>vervallen</w> als je niet oplet.",
                            "target_lang_translations": {
                                "en": "It is easy to <w>lapse</w> into repetition if you are not careful."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in herhaling vervallen",
                        "in oude fouten vervallen"
                    ],
                    "target_lang_definitions": {
                        "en": "To relapse or fall back into a worse habit or state."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to lapse into",
                                "target_lang_sense_clarification": "habits or patterns"
                            },
                            {
                                "target_lang_word": "to fall back into",
                                "target_lang_sense_clarification": "old ways or errors"
                            },
                            {
                                "target_lang_word": "to relapse",
                                "target_lang_sense_clarification": "into a previous bad state"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ec6617e-10cb-38ae-9d23-ecb05284be4e",
                    "sense_definition": "voltooid deelwoord van <w>vervallen</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "grammatica",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De afspraak is <w>vervallen</w> omdat er niemand kwam opdagen.",
                            "target_lang_translations": {
                                "en": "The appointment was <w>cancelled</w> because nobody showed up."
                            }
                        },
                        {
                            "text": "Alle eerdere versies van dit document zijn hiermee <w>vervallen</w>.",
                            "target_lang_translations": {
                                "en": "All previous versions of this document are hereby <w>void</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Past participle of 'vervallen', used to indicate something has expired or been cancelled."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "expired",
                                "target_lang_sense_clarification": "no longer valid"
                            },
                            {
                                "target_lang_word": "cancelled",
                                "target_lang_sense_clarification": "no longer taking place"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dae90acb-55c7-3ad5-a070-e535080c7675",
                    "sense_definition": "in een staat van verwaarlozing of verval verkerend",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij wonen in een <w>vervallen</w> huis aan de rand van de stad.",
                            "target_lang_translations": {
                                "en": "They live in a <w>dilapidated</w> house on the outskirts of the city."
                            }
                        },
                        {
                            "text": "De <w>vervallen</w> fabriek werd vorig jaar eindelijk gesloopt door de gemeente.",
                            "target_lang_translations": {
                                "en": "The <w>run-down</w> factory was finally demolished by the municipality last year."
                            }
                        }
                    ],
                    "antonyms": [
                        "onderhouden",
                        "nieuw"
                    ],
                    "common_phrases": [
                        "een vervallen gebouw"
                    ],
                    "target_lang_definitions": {
                        "en": "Being in a state of neglect, decay, or disrepair."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dilapidated",
                                "target_lang_sense_clarification": "of a building or object"
                            },
                            {
                                "target_lang_word": "run-down",
                                "target_lang_sense_clarification": "neglected and in poor condition"
                            },
                            {
                                "target_lang_word": "decaying",
                                "target_lang_sense_clarification": "rotting or falling apart"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fca373be-6b0d-385a-8576-4b142c9999b0",
                    "sense_definition": "niet meer bruikbaar omdat de termijn voorbij is",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geldigheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met een <w>vervallen</w> ticket kun je helaas niet meer reizen.",
                            "target_lang_translations": {
                                "en": "Unfortunately, you can no longer travel with an <w>expired</w> ticket."
                            }
                        },
                        {
                            "text": "De bibliotheek accepteert geen boeken met een <w>vervallen</w> lidmaatschap.",
                            "target_lang_translations": {
                                "en": "The library does not accept books with an <w>invalid</w> membership."
                            }
                        }
                    ],
                    "synonyms": [
                        "aflopen"
                    ],
                    "antonyms": [
                        "geldig"
                    ],
                    "common_phrases": [
                        "een vervallen termijn"
                    ],
                    "target_lang_definitions": {
                        "en": "No longer usable because the validity period has passed."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "expired",
                                "target_lang_sense_clarification": "of tickets or memberships"
                            },
                            {
                                "target_lang_word": "invalid",
                                "target_lang_sense_clarification": "no longer acceptable"
                            },
                            {
                                "target_lang_word": "out of date",
                                "target_lang_sense_clarification": "past its deadline"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
