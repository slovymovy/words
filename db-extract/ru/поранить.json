                        "tags": [],
                        "examples": [
                            {
                                "example_id": "286ae6eb-1516-45f9-92d9-c225867ce29f",
                                "sense_id": "d2581ee1-809e-3fd7-8cde-148b180a82d0",
                                "text": "Очевидно, я выстрелил дробью и только немного поранил бок или ногу."
                            },
                            {
                                "example_id": "209ae7e4-f237-4b29-9c53-44fe1070c474",
                                "sense_id": "d2581ee1-809e-3fd7-8cde-148b180a82d0",
                                "text": "Опуская на скаку меч в ножны, он нечаянно поранил бедро."
                            }
                        ]
                    }
                ],
