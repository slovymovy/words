    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1c7ba8e8-e490-3dbf-bc12-e25978fcdaa6",
                    "sense_definition": "Défaire un appareil, un meuble ou un ensemble pièce par pièce.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mecanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de déménager, il faut <w>démonter</w> cette grande armoire en bois."
                        },
                        {
                            "text": "Le mécanicien a <w>démonté</w> le moteur pour trouver l'origine de la panne."
                        }
                    ],
                    "synonyms": [
                        "désassembler"
                    ],
                    "antonyms": [
                        "monter",
                        "assembler"
                    ],
                    "common_phrases": [
                        "démonter un meuble",
                        "démonter une pièce"
                    ]
                },
                {
                    "sense_id": "e53cbbbe-9982-324c-986c-4d2dd6d8b0a5",
                    "sense_definition": "Déconcerter une personne ou lui faire perdre son assurance et son calme.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "psychologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette remarque inattendue a complètement <w>démonté</w> l'orateur pendant son discours."
                        },
                        {
                            "text": "Malgré les critiques virulentes du jury, elle ne s'est pas <w>démontée</w>."
                        }
                    ],
                    "synonyms": [
                        "déconcerter",
                        "décontenancer",
                        "déstabiliser"
                    ],
                    "antonyms": [
                        "rassurer"
                    ],
                    "common_phrases": [
                        "ne pas se démonter"
                    ]
                },
                {
                    "sense_id": "3e72db18-dd12-3eb6-b321-9e1596e4deb9",
                    "sense_definition": "Faire tomber un cavalier de sa monture.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "equitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cheval a fait une brusque embardée et a <w>démonté</w> son cavalier."
                        },
                        {
                            "text": "Un coup violent de l'adversaire l'a <w>démonté</w> au milieu du champ de bataille."
                        }
                    ],
                    "synonyms": [
                        "désarçonner"
                    ]
                },
                {
                    "sense_id": "453ff1a9-69e6-3f8b-b338-37cef8847e94",
                    "sense_definition": "Désactiver l'accès logique à un disque ou à un système de fichiers.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oublie pas de <w>démonter</w> le disque externe avant de débrancher le câble."
                        },
                        {
                            "text": "Le système refuse de <w>démonter</w> cette partition car un fichier reste ouvert."
                        }
                    ],
                    "synonyms": [
                        "éjecter"
                    ],
                    "antonyms": [
                        "monter"
                    ],
                    "common_phrases": [
                        "démonter un volume",
                        "démonter un disque"
                    ]
                }
            ]
        }
    ]
