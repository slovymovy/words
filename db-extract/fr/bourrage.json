        "fr-extract.jsonl": [
            {
                "entry_id": "e6bb73cb-1525-3475-9ef0-33920a820bc3",
                "word": "bourrage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b62d87dd-a122-42da-a2b0-55f2963e2960",
                        "entry_id": "e6bb73cb-1525-3475-9ef0-33920a820bc3",
                        "tags": [
                            "plural"
                        ],
