                        "form": "den Dolmetsch"
                    },
                    {
                        "form_id": "9d929257-90cb-4594-a142-7c6b03c9f6ed",
                        "entry_id": "aef7214b-0dac-3b4c-bfd4-bb4c5d8dcc54",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Dolmetsche"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ee3bf59c-a420-3321-80a2-d1ef8da3a6fe",
                        "entry_id": "aef7214b-0dac-3b4c-bfd4-bb4c5d8dcc54",
                        "glosses": [
                            "Person, die (gesprochene) Texte in eine andere Sprache übersetzt"
                        ],
                        "tags": [
                            "Austrian German",
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "45964b55-4a95-42dc-a1ec-cb35442883eb",
                                "sense_id": "ee3bf59c-a420-3321-80a2-d1ef8da3a6fe",
                                "text": "„Die Eltern sind heute noch im Iran, der Bruder arbeitet als Dolmetsch in Italien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "960b4e76-3dba-36f4-98ed-b4ffe415ceb5",
                        "entry_id": "aef7214b-0dac-3b4c-bfd4-bb4c5d8dcc54",
                        "glosses": [
                            "Person, die sich für jemanden/etwas nachhaltig einsetzt, Interessen verdeutlicht, vermittelnd tätig ist"
                        ],
                        "tags": [
                            "figurative",
                            "gehoben"
                        ],
                        "examples": [
                            {
                                "example_id": "77b8678e-857a-45ba-b8f9-5d6cbfabce39",
                                "sense_id": "960b4e76-3dba-36f4-98ed-b4ffe415ceb5",
                                "text": "„‚Nur 29 Prozent der Facharbeiter und 20 Prozent der angelernten und ungelernten Arbeiter‘, so macht sich die Zeitung zum entrüsteten Dolmetsch dieser Enttäuschung, ‚vertreten die Meinung, die Unternehmer sollten ruhig verdienen, denn sie leisteten ja auch ungewöhnlich viel und trügen schließlich die Verantwortung für Tausende‘.“"
                            },
                            {
                                "example_id": "da96c14c-c2f7-4dae-b6be-5e89bf0cf7fd",
                                "sense_id": "960b4e76-3dba-36f4-98ed-b4ffe415ceb5",
                                "text": "„Er wünschte mir ebenfalls eine gute Fahrt nach Neapel, aber ich sagte, ich wolle vorher noch den Herzog von Parma aufsuchen und gleichzeitig den beiden Offizieren, die sich nicht verständigen könnten, als Dolmetsch dienen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db24f90c-9c6a-44ca-9afc-dc561db0e59b",
                        "source_entry_id": "aef7214b-0dac-3b4c-bfd4-bb4c5d8dcc54",
                        "source_sense_id": "ee3bf59c-a420-3321-80a2-d1ef8da3a6fe",
                        "source_sense_description": "besonders in Österreich: Person, die (gesprochene) Texte in eine andere Sprache übersetzt",
                        "target_lang_word": "interprète",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interprète",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "be053363-cb73-3b85-9419-e1cffc9d26ab",
                                        "entry_id": "7d8ad6c3-5780-3381-80f1-099fd47de5ce",
                                        "glosses": [
                                            "Personne qui traduit les mots, les phrases d’une langue par les mots, par les phrases d’une autre langue."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72da98ad-9db5-4a67-87aa-f608791aa3d2",
                                                "sense_id": "be053363-cb73-3b85-9419-e1cffc9d26ab",
                                                "text": "Il a traduit ce discours, cette harangue, non pas en simple interprète, mais en orateur."
                                            },
                                            {
                                                "example_id": "31bbe47b-d525-460c-a8b3-35f61d0128fa",
                                                "sense_id": "be053363-cb73-3b85-9419-e1cffc9d26ab",
                                                "text": "Les interprètes grecs de l’Ancien Testament, qu’on appelle les Septante."
                                            },
                                            {
                                                "example_id": "225d5acc-020e-4dbc-b50b-793c453c966e",
                                                "sense_id": "be053363-cb73-3b85-9419-e1cffc9d26ab",
                                                "text": "Cet auteur latin n’a pas encore trouvé de meilleur interprète. Dans ce sens, on dit plutôt aujourd’hui Traducteur."
                                            },
                                            {
                                                "example_id": "5e47b556-be6f-45f5-8b81-b94de7c502fd",
                                                "sense_id": "be053363-cb73-3b85-9419-e1cffc9d26ab",
                                                "text": "L’interprète interpréta."
                                            },
                                            {
                                                "example_id": "22a65cf7-3865-4b88-b79a-82f7997b0c63",
                                                "sense_id": "be053363-cb73-3b85-9419-e1cffc9d26ab",
                                                "text": "Une personne sourde par exemple, doit pouvoir bénéficier d’un interprète en langue des signes à ses rendez-vous médicaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "585224d8-26f7-3bf9-9b7e-ac5af361ea69",
                                        "entry_id": "7d8ad6c3-5780-3381-80f1-099fd47de5ce",
                                        "glosses": [
                                            "Truchement, celui qui traduit à une personne, surtout oralement ou par langue gestuelle, dans la langue qu’elle parle, ce qui a été dit ou écrit par une autre dans une langue différente."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dea2d8a9-5dd0-406a-8156-017a127ffae2",
                                                "sense_id": "585224d8-26f7-3bf9-9b7e-ac5af361ea69",
                                                "text": "Je puis en dire autant d’El-Haj Ahmed Ben-Chekron qui me sert d’interprète dans mes autres visites et qui, lui, ayant vécu en Espagne, s’exprime correctement en castillan."
                                            },
                                            {
                                                "example_id": "ab6698ac-c506-4e8f-9e57-760972cf700b",
                                                "sense_id": "585224d8-26f7-3bf9-9b7e-ac5af361ea69",
                                                "text": "Lorsque l’interprète me traduisit le sens général du discours, je fus émerveillé."
                                            },
                                            {
                                                "example_id": "a9f39bf9-bb75-45c7-a6b3-7d8d80ca4526",
                                                "sense_id": "585224d8-26f7-3bf9-9b7e-ac5af361ea69",
                                                "text": "[…], enfin Moussa, jeune Nigérien, bavard et sympathique. Il fera ma cuisine et me servira d’interprète dans ce pays où l'on parle le haoussa principalement et d'autres dialectes, mais non l’arabe, à part quelques chefs et quelques marabouts."
                                            },
                                            {
                                                "example_id": "1c538b81-d2b3-46a6-85c8-63a791e6e434",
                                                "sense_id": "585224d8-26f7-3bf9-9b7e-ac5af361ea69",
                                                "text": "La partie ou le témoin qui ne peuvent suivre les procédures, soit parce qu’ils ne comprennent pas ou ne parlent pas la langue employée, soit parce qu’ils sont atteints de surdité, ont droit à l’assistance d’un interprète."
                                            },
                                            {
                                                "example_id": "c1fd8d63-bbd4-40d2-8080-5e1f5a3befab",
                                                "sense_id": "585224d8-26f7-3bf9-9b7e-ac5af361ea69",
                                                "text": "Interprète juré, Celui qui est nommé par les cours ou tribunaux pour traduire oralement les débats ou les pièces versées lors de ceux-ci."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa2bbac0-25ef-348c-9841-fdcc260cad64",
                                        "entry_id": "7d8ad6c3-5780-3381-80f1-099fd47de5ce",
                                        "glosses": [
                                            "Celui qui fait connaître, qui éclaircit le sens d’un auteur, d’un discours."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52b73694-4c3c-4486-9550-d7fa7d31eac6",
                                                "sense_id": "aa2bbac0-25ef-348c-9841-fdcc260cad64",
                                                "text": "En vain donc ces dangereux interprètes nous crient que le gros des Pères n’a jamais examiné critiquement, le vrai ou le faux des explications littérales de la Bible ; qu’aussi la Tradition varie fort sur cela ; […]."
                                            },
                                            {
                                                "example_id": "8132dcdb-dac8-4439-922f-10cad6b0e358",
                                                "sense_id": "aa2bbac0-25ef-348c-9841-fdcc260cad64",
                                                "text": "Les interprètes de Platon, d’Aristote, etc."
                                            },
                                            {
                                                "example_id": "7bc73b45-d105-4a18-9244-77b02ed731a5",
                                                "sense_id": "aa2bbac0-25ef-348c-9841-fdcc260cad64",
                                                "text": "Cet interprète a mal expliqué ce passage. Par analogie,"
                                            },
                                            {
                                                "example_id": "abd3c947-98ba-4013-ad10-37d33dc99c4f",
                                                "sense_id": "aa2bbac0-25ef-348c-9841-fdcc260cad64",
                                                "text": "Interprète des songes."
                                            },
                                            {
                                                "example_id": "8bbe3938-33a6-4545-9097-dba7951725ca",
                                                "sense_id": "aa2bbac0-25ef-348c-9841-fdcc260cad64",
                                                "text": "Interprète du vol des oiseaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc5e2b3d-eb44-332a-b541-f0b3ca72fd72",
                                        "entry_id": "7d8ad6c3-5780-3381-80f1-099fd47de5ce",
                                        "glosses": [
                                            "Celui qui a charge de déclarer, de faire connaître les intentions, les volontés d’un autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a0b0042-8dfb-4427-8f4e-ffd23a386684",
                                                "sense_id": "cc5e2b3d-eb44-332a-b541-f0b3ca72fd72",
                                                "text": "Les augures, chez les païens, étaient regardés comme les interprètes de la volonté des dieux."
                                            },
                                            {
                                                "example_id": "fcdcc6eb-431f-4734-982f-b72c4e78c4ac",
                                                "sense_id": "cc5e2b3d-eb44-332a-b541-f0b3ca72fd72",
                                                "text": "Soyez l’interprète de mes sentiments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6b0b4a3-b171-34b2-ba36-391bba0dd1d6",
                                        "entry_id": "7d8ad6c3-5780-3381-80f1-099fd47de5ce",
                                        "glosses": [
                                            "…"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fb627ef-c6a5-428e-9b52-48ee7051da0f",
                                                "sense_id": "b6b0b4a3-b171-34b2-ba36-391bba0dd1d6",
                                                "text": "Les yeux sont les interprètes de l’âme, Les yeux servent à faire connaître les sentiments, les mouvements de l’âme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16b67e0a-a60b-361c-87a5-bd4cd551c168",
                                        "entry_id": "7d8ad6c3-5780-3381-80f1-099fd47de5ce",
                                        "glosses": [
                                            "Un musicien jouant l’œuvre d’un compositeur."
                                        ],
                                        "tags": [],
                                        "note": "pour un chanteur qui chante ses propres compositions, on parlera d’un auteur-compositeur-interprète",
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "98880760-9b56-3c7f-8405-dc809ea2cca6",
                                        "entry_id": "7d8ad6c3-5780-3381-80f1-099fd47de5ce",
                                        "glosses": [
                                            "En termes d’art dramatique, acteur ou actrice qui joue un rôle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77870ac5-cb38-4c76-9cec-b419b13f0c0d",
                                                "sense_id": "98880760-9b56-3c7f-8405-dc809ea2cca6",
                                                "text": "Les actrices d’opéra-comique de ce temps-là ne se bornaient pas à roucouler un air ou une romance : on voulait encore qu'elles jouassent la comédie; et madame Favart représenta avec un rare talent Roxelane des Trois Sultanes, et tous les premiers rôles des ouvrages de son mari ou d'autres auteurs qui se disputaient ce charmant interprète."
