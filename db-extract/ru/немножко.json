                                    {
                                        "sense_id": "5ae4e85e-490c-3d92-916a-6018b570fff9",
                                        "entry_id": "ee278f15-4085-340f-83f1-915ac2bec00f",
                                        "glosses": [
                                            "To a small extent; in a small amount."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a9f68f1-9e06-4116-b58a-324d43b1c6f8",
                                                "sense_id": "5ae4e85e-490c-3d92-916a-6018b570fff9",
                                                "text": "Could you move that up a bit?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "431ffd48-f205-3c2f-a1b3-17d6dfc712cd",
                                        "entry_id": "ee278f15-4085-340f-83f1-915ac2bec00f",
                                        "glosses": [
                                            "Slightly; rather."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ee1f098-d274-4beb-a364-16344a1f1aef",
                                                "sense_id": "431ffd48-f205-3c2f-a1b3-17d6dfc712cd",
                                                "text": "Isn't that hat a bit small for him?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7fcbca4-a659-3bc7-b16f-43b85782d5e9",
                                        "entry_id": "ee278f15-4085-340f-83f1-915ac2bec00f",
                                        "glosses": [
                                            "Very."
                                        ],
                                        "tags": [
                                            "UK",
                                            "especially",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abc2282b-b735-4c5f-a59e-e0fe847084c6",
                                                "sense_id": "d7fcbca4-a659-3bc7-b16f-43b85782d5e9",
                                                "text": "That hat seems a bit small for him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dbc00a0-4ffe-3a3b-9ba4-815f37cbfc58",
                                        "entry_id": "ee278f15-4085-340f-83f1-915ac2bec00f",
                                        "glosses": [
                                            "A lot."
                                        ],
                                        "tags": [
                                            "UK",
                                            "especially",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c11aad9-23d5-4f25-97b4-f9fbd03109a7",
                                                "sense_id": "3dbc00a0-4ffe-3a3b-9ba4-815f37cbfc58",
                                                "text": "It rained a bit last night."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "a bit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ae9c806-60c5-3dde-bc5c-45f235a8b65d",
                                        "entry_id": "3f7b454f-85ff-3705-84ae-69c156834926",
                                        "glosses": [
                                            "A small amount."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93aa43e9-817e-4f64-a7a3-630513f4e763",
                                                "sense_id": "3ae9c806-60c5-3dde-bc5c-45f235a8b65d",
                                                "text": "Q: Care for some cake? A: Argh, you've twisted my arm — I'll have just a bit, thank you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3abe9d29-1bbb-328b-96c8-3caa0fe3c9ca",
                                        "entry_id": "3f7b454f-85ff-3705-84ae-69c156834926",
                                        "glosses": [
                                            "A large amount."
                                        ],
                                        "tags": [
                                            "UK",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31130739-afe3-41b9-a391-00f661daf792",
                                                "sense_id": "3abe9d29-1bbb-328b-96c8-3caa0fe3c9ca",
                                                "text": "Q: How much trouble did you stir up last night? A: Just a bit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa239659-81e0-4003-be04-89646d76e393",
                        "source_entry_id": "75962f1b-c08c-36b8-bc06-76764f548946",
                        "target_lang_word": "a little bit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "a little bit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f99d37ec-e445-3550-a379-43af3bc0342a",
                                        "entry_id": "3c2b77f6-13d5-3e7f-ad2d-5989bf00e9fe",
                                        "glosses": [
                                            "To a very small extent or degree."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb2a5958-e8a3-422b-b267-a0d3f2592321",
                                                "sense_id": "f99d37ec-e445-3550-a379-43af3bc0342a",
                                                "text": "He could read it only a little bit."
                                            },
                                            {
                                                "example_id": "ed529b7c-52aa-438e-a24e-23d346426672",
                                                "sense_id": "f99d37ec-e445-3550-a379-43af3bc0342a",
                                                "text": "Those shoes are a little bit too tight."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "a little bit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c68a6552-cd8b-30a2-8437-a0e534cd4129",
                                        "entry_id": "065b4de5-8629-3297-8a51-d7af2897f307",
                                        "glosses": [
                                            "A very small amount or time."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d8781cb-6c74-4b75-b4ee-f067622e4604",
                                                "sense_id": "c68a6552-cd8b-30a2-8437-a0e534cd4129",
                                                "text": "There's just a little bit left."
                                            },
                                            {
                                                "example_id": "f9afc150-f4da-4fbc-bd7c-9c2cab6a18f7",
                                                "sense_id": "c68a6552-cd8b-30a2-8437-a0e534cd4129",
                                                "text": "Even a little bit can make a difference."
                                            },
                                            {
                                                "example_id": "515ec1da-2084-430f-bf32-1c333d5a6613",
                                                "sense_id": "c68a6552-cd8b-30a2-8437-a0e534cd4129",
                                                "text": "I'll be there in a little bit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7bf3023f-e879-4cfa-a88b-8e00bc24de8a",
                        "source_entry_id": "75962f1b-c08c-36b8-bc06-76764f548946",
                        "target_lang_word": "a trifle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "a trifle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9932cec-d2e9-3a88-8d63-e66faf7dd2c3",
                                        "entry_id": "79aaf4a1-f2c2-36cf-ad11-ab770d3a499d",
                                        "glosses": [
                                            "A little, slightly."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b9f229b-ae91-4480-909e-ec0e991d2b1c",
                                                "sense_id": "b9932cec-d2e9-3a88-8d63-e66faf7dd2c3",
                                                "text": "Could you lend me some money? I'm a trifle short of what I need to pay the rent."
                                            },
                                            {
                                                "example_id": "e18ffe7c-a3db-4184-8fc7-fcec0d30fed1",
                                                "sense_id": "b9932cec-d2e9-3a88-8d63-e66faf7dd2c3",
                                                "text": "He contemplated the large well-proportioned letters and final flourish, with his head a trifle on one side for an instant […]"
                                            },
                                            {
                                                "example_id": "fba698a4-334d-4431-9e6a-297ff323de29",
                                                "sense_id": "b9932cec-d2e9-3a88-8d63-e66faf7dd2c3",
                                                "text": "Commander Birch was a trifle uneasy when he found there was more than a popple on the sea; it was, in fact, distinctly choppy. Strictly speaking, he ought to have been following up the picket–boat, but he was satisfied that the circumstances were sufficiently urgent for him to take risks."
                                            },
                                            {
                                                "example_id": "c3a22456-d19f-4c6e-83cc-2e8cc00ec13b",
                                                "sense_id": "b9932cec-d2e9-3a88-8d63-e66faf7dd2c3",
                                                "text": "He stared at the chart. “Maybe we’ll move away towards the west a trifle, and come down on Fiji from the north.”"
                                            },
                                            {
                                                "example_id": "fa78c3b0-b69d-41e6-b816-ac5988da921d",
                                                "sense_id": "b9932cec-d2e9-3a88-8d63-e66faf7dd2c3",
                                                "text": "2006, Ngũgĩ wa Thiong’o, Wizard of the Crow, New York: Knopf Doubleday, Book 3, p. 411,\n“Let’s get on with it,” Sikiokuu replied, a trifle impatiently."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
