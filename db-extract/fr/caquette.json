                                                "sense_id": "6179f660-272c-3f29-8adc-1fbf94d5deca",
                                                "text": "Ich wette um einen Kasten Bier!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "754b618d-ad9d-3590-a4b4-14a46dc53024",
