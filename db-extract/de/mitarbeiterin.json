                    {
                        "form_id": "f16437ca-e06e-45eb-9b78-51ab09c6df10",
                        "entry_id": "31ccee00-18b2-38a1-a212-2cea3ace0c5e",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Mitarbeiterinnen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "55a85471-d5d8-30f2-8215-3b5cd51d12de",
                        "entry_id": "31ccee00-18b2-38a1-a212-2cea3ace0c5e",
                        "glosses": [
                            "Arbeiterin oder Angestellte in einem Unternehmen oder einer Organisation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1e74a11-9f31-4dff-a1f6-6ae6ebdd6a10",
                                "sense_id": "55a85471-d5d8-30f2-8215-3b5cd51d12de",
                                "text": "Den Erfolg unseres Unternehmens haben wir vor allem unseren Mitarbeiterinnen zu verdanken."
                            },
                            {
                                "example_id": "f050f10e-4a85-4a6c-9f7f-90ea619402bc",
                                "sense_id": "55a85471-d5d8-30f2-8215-3b5cd51d12de",
                                "text": "„Es geht nichts über die sorgfältige Auswahl von Mitarbeiterinnen.“"
                            },
                            {
                                "example_id": "07f4da7e-86b0-42b6-886f-e6fceb06e1d6",
                                "sense_id": "55a85471-d5d8-30f2-8215-3b5cd51d12de",
                                "text": "„Deshalb gibt es Mitarbeiterinnen wie Anna Ottlik.“"
                            },
                            {
                                "example_id": "b2842de5-3961-4e0f-98fa-421d86033497",
                                "sense_id": "55a85471-d5d8-30f2-8215-3b5cd51d12de",
                                "text": "„Bruni, als Mitarbeiterin am MPI für biophysikalische Chemie auf diesem Gebiet praktizierender Weise firm, hat ihr eine Mixtur zusammengebraut, die es in sich hat.“"
                            },
                            {
                                "example_id": "867ab5cd-5a07-46fd-918c-26100d1b997c",
                                "sense_id": "55a85471-d5d8-30f2-8215-3b5cd51d12de",
                                "text": "„Eberhard Kleinschmidt las die Notiz, dankte der tüchtigen Mitarbeiterin und verschwand kurz darauf für einige Zeit aus dem Büro.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "787b898a-2edd-3550-9c39-26d038f2fb2e",
                        "entry_id": "31ccee00-18b2-38a1-a212-2cea3ace0c5e",
                        "glosses": [
                            "Kollegin; Frau mit der gleichen Tätigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a7feb69-8b02-43d4-94fe-b9a8b062627c",
                                "sense_id": "787b898a-2edd-3550-9c39-26d038f2fb2e",
                                "text": "Sie ist eine Mitarbeiterin von mir."
                            },
                            {
                                "example_id": "0fbddba5-f606-4db8-8917-84f355be2ea5",
                                "sense_id": "787b898a-2edd-3550-9c39-26d038f2fb2e",
                                "text": "„Eine Mitarbeiterin will ein paar freie Tage, ihre Nerven liegen blank, ich genehmige sie natürlich.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6f30dca-9511-42ff-9753-c134bb63706d",
                        "source_entry_id": "31ccee00-18b2-38a1-a212-2cea3ace0c5e",
