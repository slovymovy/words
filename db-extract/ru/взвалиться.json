                "senses": [
                    {
                        "sense_id": "8634a21b-de19-3788-bf3a-af7ba6190e82",
                        "entry_id": "ed53ac93-3cc7-3899-a242-af36a13ff7fe",
                        "glosses": [
                            "разг. грузно лечь, сесть на что-либо, взобраться куда-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "deca452e-74be-4c68-9250-46a5c2028929",
                                "sense_id": "8634a21b-de19-3788-bf3a-af7ba6190e82",
                                "text": "Он занёс ногу в стремя, но, не могши попасть в него, взвалился на коня животом, проехал так несколько саженей рысью и наконец уже взобрался на седло."
                            }
                        ]
                    },
                    {
                        "sense_id": "0bf8d91c-ba02-3866-8170-d11db4890b31",
                        "entry_id": "ed53ac93-3cc7-3899-a242-af36a13ff7fe",
                        "glosses": [
                            "страд. к взвалить"
                        ],
                        "tags": [
                            "passive"
                        ],
                        "examples": [
                            {
                                "example_id": "eb135cd6-532b-4ae0-9053-808fb212d431",
                                "sense_id": "0bf8d91c-ba02-3866-8170-d11db4890b31",
                                "text": "Его могучей душе по силам та ноша, которая взвалилась на него."
                            }
                        ]
                    }
                ],
