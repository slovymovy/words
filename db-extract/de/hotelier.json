                "senses": [
                    {
                        "sense_id": "8979c7c5-4849-3312-8b30-de2e7a97dde4",
                        "entry_id": "909e4167-a837-3c0c-a484-c98462c76a0a",
                        "glosses": [
                            "Besitzer oder Leiter eines Hotels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bd76655-4320-43b5-aa4a-959e83bfc965",
                                "sense_id": "8979c7c5-4849-3312-8b30-de2e7a97dde4",
                                "text": "Der Hotelier unseres Hotels legt großen Wert auf die Sauberkeit und Hygiene."
                            },
                            {
                                "example_id": "d6edf1be-e80f-465a-99aa-dda5725bcbbc",
                                "sense_id": "8979c7c5-4849-3312-8b30-de2e7a97dde4",
                                "text": "„Verglichen mit dem Patriarchen, stand der Hotelier gut da.“"
                            },
                            {
                                "example_id": "29786f45-48ab-4efa-9d37-efef99539faf",
                                "sense_id": "8979c7c5-4849-3312-8b30-de2e7a97dde4",
                                "text": "„Der Hotelier stand jetzt hinter mir.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "99feecb9-25c9-4089-a350-8c6165bec509",
                        "source_entry_id": "909e4167-a837-3c0c-a484-c98462c76a0a",
                        "source_sense_id": "8979c7c5-4849-3312-8b30-de2e7a97dde4",
