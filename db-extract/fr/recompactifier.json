                "senses": [
                    {
                        "sense_id": "c1e0c401-9647-35c4-8e39-cd626fdefc1e",
                        "entry_id": "ff89d004-71a0-3a77-99d0-d7d15d1bacc7",
                        "glosses": [
                            "Rendre à nouveau compact."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d17f6552-ce54-4551-b3ad-c94d546e20b8",
                                "sense_id": "c1e0c401-9647-35c4-8e39-cd626fdefc1e",
                                "text": "Dans le premier cas, l'intervention du discours logico-mathématique apparaît comme destiné à « recompactifier » la théorie, par un artifice formel."
                            },
                            {
                                "example_id": "b2765105-562b-476b-965e-639b75dc54a8",
                                "sense_id": "c1e0c401-9647-35c4-8e39-cd626fdefc1e",
                                "text": "En effet, le flux d’ouest, rapide en altitude, fragilise les masses nuageuses au-dessus du massif central qui se déchiquettent avant de se recompactifier sur le nord."
                            }
                        ]
                    }
