                    {
                        "sense_id": "0662261a-85e9-3235-874f-a03cb7b927c8",
                        "entry_id": "b739c524-860f-3896-a173-28737c9b28aa",
                        "glosses": [
                            "Ligne Oder-Neisse, frontière entre l'Allemagne et la Pologne définie en 1945."
                        ],
                        "tags": [
                            "Relations internationales"
                        ],
                        "examples": [
                            {
                                "example_id": "ee4b4750-13a5-47f3-a4ef-8fbb5499ee4c",
                                "sense_id": "0662261a-85e9-3235-874f-a03cb7b927c8",
                                "text": "Eine Bedingung bloß habe er gestellt: dass Deutschlands Grenzen für alle Zeiten festgelegt und die Oder-Neiße-Linie ohne Wenn und Aber akzeptiert werde.",
                                "translation": "Il n'a posé qu'une seule condition : que les frontières de l'Allemagne soient fixées pour toujours et que la ligne Oder-Neisse soit acceptée sans réserve."
                            }
                        ]
                    }
                ],
