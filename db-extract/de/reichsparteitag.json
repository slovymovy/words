                ],
                "senses": [
                    {
                        "sense_id": "4d7bf539-0e87-3383-a0bf-8e064ae2a9c1",
                        "entry_id": "5645a412-447a-335e-b49d-5e839461f2a7",
                        "glosses": [
                            "deutschlandweiter Parteitag der NSDAP ab 1927"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "abb3a11f-e429-4574-92c8-10f2e800f36a",
                                "sense_id": "4d7bf539-0e87-3383-a0bf-8e064ae2a9c1",
                                "text": "Die Reichsparteitage der NSDAP in Nürnberg dauerten eine Woche und hatten bis zu eine Million Besucher aus ganz Deutschland."
                            },
                            {
                                "example_id": "006c6c56-dc87-439e-bb93-54614cff4940",
                                "sense_id": "4d7bf539-0e87-3383-a0bf-8e064ae2a9c1",
                                "text": "Bis etwa zum Reichsparteitag 1929 hatten wir in ganz Thüringen insgesamt 45 bis 50 Mann SS."
                            },
                            {
                                "example_id": "84487830-77e9-4cdd-ae54-32440fec6e01",
                                "sense_id": "4d7bf539-0e87-3383-a0bf-8e064ae2a9c1",
                                "text": "„Daneben lud man zum Reichsparteitag der NSDAP nach Nürnberg ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "65222055-e259-36f6-8c38-0bf4b2ce6427",
                        "entry_id": "5645a412-447a-335e-b49d-5e839461f2a7",
                        "glosses": [
                            "deutschlandweiter Parteitag der NSDAP ab 1927",
                            "Veranstaltung der NSDAP jeweils in Nürnberg im September der Jahre 1933–1938"
                        ],
                        "tags": [
                            "general",
                            "special"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1a\""
                    },
                    {
                        "sense_id": "f82baff4-fe83-332e-a192-db2e750ba806",
                        "entry_id": "5645a412-447a-335e-b49d-5e839461f2a7",
                        "glosses": [
                            "reichsweite Mitgliedervertreterversammlung verschiedener Parteien"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "c984f849-5092-41f6-a312-e40bd3c7915b",
                                "sense_id": "f82baff4-fe83-332e-a192-db2e750ba806",
                                "text": "„Auf dem Reichsparteitag der SPD im Jahre 1921 wurde ein Programm angenommen, in dem die SPD als eine evolutionäre sozialistische Reformpartei bezeichnet wurde, die einen ›freien Volksstaat‹ innerhalb der Weimarer Republik anstrebte.“"
                            },
                            {
                                "example_id": "6bd09881-ea8a-4216-b4a7-2f0591c2d5e5",
                                "sense_id": "f82baff4-fe83-332e-a192-db2e750ba806",
                                "text": "„Der Reichsparteitag der DZP nahm am 10. Dezember 1928 eine Entschließung an, in der gefordert wurde, den Einfluß der preußischen Provinzen im Reichsrat zu stärken.“"
                            },
                            {
                                "example_id": "dfa63cc1-5ba8-4288-98b7-b34f7f9d34e8",
                                "sense_id": "f82baff4-fe83-332e-a192-db2e750ba806",
                                "text": "„Auf dem Reichsparteitag der DVP 1921 in Stuttgart sprach der Reichstagsabgeordnete Beythien über Mittelstandspolitik und die Bedrohung durch den Sozialismus einerseits und das internationale Großkapital andererseits.“"
                            },
                            {
                                "example_id": "0bd4ea11-54f9-405c-a2c1-7848f55cc9bb",
                                "sense_id": "f82baff4-fe83-332e-a192-db2e750ba806",
                                "text": "„Ihr Leiter beklagte jedoch auf dem 2. Reichsparteitag der DDP im Dezember 1920, daß die Organisation im Lande nur sehr unzureichend funktioniere, obwohl doch das Schwergewicht der Parteiarbeit (wenigstens theoretisch) auf die Ortsgruppen verlegt sei.“"
                            },
                            {
                                "example_id": "cd8e6fba-a05b-4b62-9e2e-2501eed5758c",
                                "sense_id": "f82baff4-fe83-332e-a192-db2e750ba806",
                                "text": "„Die Beschlüsse der Konferenz in Hannover im Januar 1946 und des Reichsparteitages im Mai 1946 wurden auch in Düsseldorf befolgt: SPD-Mitglieder, die für die Vereinigung mit der KPD warben, wurden aus der Partei ausgeschlossen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
