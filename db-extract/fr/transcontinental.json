                        "entry_id": "95a2a84f-3d62-3251-8cb4-6186cf7dc557",
                        "glosses": [
                            "Train qui traverse un continent."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "5f6f90e9-f0bf-4e12-a0b5-0217eda53116",
                                "sense_id": "95874b4b-6584-323b-9595-233c836a512e",
                                "text": "Le voyage au Japon, par Montréal et le transcontinental canadien, sera de 1,722 kilomètres plus court que par New-York et le transcontinental américain."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bb79430a-7c8c-499a-a072-fe5f613119c6",
                        "source_entry_id": "95a2a84f-3d62-3251-8cb4-6186cf7dc557",
                        "source_sense_id": "95874b4b-6584-323b-9595-233c836a512e",
                        "target_lang_word": "transcontinental",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transcontinental",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1e27608f-3176-393f-b73c-fe3e4a4707db",
                                        "entry_id": "21514e9b-12a2-365c-85ec-8f05b25be6db",
                                        "glosses": [
                                            "Crossing or spanning a continent."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eee126e6-c810-45d2-9352-8c768a579f9d",
                                                "sense_id": "1e27608f-3176-393f-b73c-fe3e4a4707db",
                                                "text": "In that year [1871] British Columbia decided to become part of the Dominion of Canada, on condition that a transcontinental railway should be completed without delay."
                                            },
                                            {
                                                "example_id": "cbdc80c5-7428-47e4-8e2a-c6919a847575",
                                                "sense_id": "1e27608f-3176-393f-b73c-fe3e4a4707db",
                                                "text": "It is the transcontinental trains which figure most prominently in railway advertising. Both railways run two trains in each direction."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "transcontinental",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d2fa1a66-6b34-3d0a-a10f-54a60702868a",
                                        "entry_id": "20d5b082-c161-30b6-98a5-923a5749a4d8",
                                        "glosses": [
                                            "a transcontinental railroad."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "262edf5f-64d9-4c7b-a5cf-0481dde5cb3e",
                                                "sense_id": "d2fa1a66-6b34-3d0a-a10f-54a60702868a",
                                                "text": "Stretched across the Dominion of Canada are two parallel but dissimilar railways - the continent's only true transcontinentals north of the Rio Grande."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
