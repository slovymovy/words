                ],
                "senses": [
                    {
                        "sense_id": "a4fb7546-d3b6-3ea8-9236-91da23076de3",
                        "entry_id": "8105c998-42f4-33b0-8fed-ae61ae6e61e4",
                        "glosses": [
                            "господин (употребляется при упоминании или вежливом обращении к мужчинам из Германии и присоединяется к их фамилии или званию)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb275850-cf44-4d9e-a3ab-8014b686fef3",
                                "sense_id": "a4fb7546-d3b6-3ea8-9236-91da23076de3",
                                "text": "На следующий день Санин лежал еще в постеле, как уже Эмиль, в праздничном платье, с тросточкой в руке и сильно напомаженный, ворвался к нему в комнату и объявил, что герр Клюбер сейчас прибудет с каретой, что погода обещает быть удивительной, что у них уже всё готово, но что мама не поедет, потому что у неё опять разболелась голова."
                            },
                            {
                                "example_id": "a93a94d8-2546-4bb4-b3e7-c72cba6a96a7",
                                "sense_id": "a4fb7546-d3b6-3ea8-9236-91da23076de3",
                                "text": "Дайте себе волю хоть раз в жизни, влюбитесь поскорее в какого-нибудь водяного по самые уши ― и бултых с головой в омут, чтобы герр профессор и все мы только руками развели!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce55cff8-931d-474d-b474-d0e20719bbb4",
                        "source_entry_id": "8105c998-42f4-33b0-8fed-ae61ae6e61e4",
                        "source_sense_id": "a4fb7546-d3b6-3ea8-9236-91da23076de3",
                        "target_lang_word": "Herr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Herr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b4b597c-c584-3f2c-933f-dc03c5518b08",
                                        "entry_id": "b3a1b542-002a-36e9-83da-350dbf78ea9a",
                                        "glosses": [
                                            "höfliche Bezeichnung für einen Mann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0032872e-75be-4874-a827-a4f7d6a32e85",
                                                "sense_id": "4b4b597c-c584-3f2c-933f-dc03c5518b08",
                                                "text": "Dieser Herr hier wollte mit Ihnen reden."
                                            },
                                            {
                                                "example_id": "97ccc319-5b49-4278-a27e-7ec104eb1165",
                                                "sense_id": "4b4b597c-c584-3f2c-933f-dc03c5518b08",
                                                "text": "Meine Damen und Herren…"
                                            },
                                            {
                                                "example_id": "d4bab5f7-d252-4fdc-b3e6-8dab01ecaa79",
                                                "sense_id": "4b4b597c-c584-3f2c-933f-dc03c5518b08",
                                                "text": "„Ein Radfahrer fährt einen alten Herrn um.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8a619854-e119-30f6-8736-b13f38e80825",
                                        "entry_id": "b3a1b542-002a-36e9-83da-350dbf78ea9a",
                                        "glosses": [
                                            "Anrede für einen Mann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16b7b764-df94-4712-8ca8-0b5ca3573d92",
                                                "sense_id": "8a619854-e119-30f6-8736-b13f38e80825",
                                                "text": "Wie geht es Ihnen heute, Herr Müller?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "de95b1b2-feb3-3c33-8fa0-f8009bb73cc8",
                                        "entry_id": "b3a1b542-002a-36e9-83da-350dbf78ea9a",
                                        "glosses": [
                                            "jemand, der eine fast vollständige Kontrolle über Dinge oder Personen hat (früher insbesondere ein Adliger)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fdd227c-7388-48df-92a7-d82881b7eba9",
                                                "sense_id": "de95b1b2-feb3-3c33-8fa0-f8009bb73cc8",
                                                "text": "Ich werde diesen Auftrag übernehmen, Herr."
                                            },
                                            {
                                                "example_id": "1988d639-fbfb-410d-b706-eaaefe223d84",
                                                "sense_id": "de95b1b2-feb3-3c33-8fa0-f8009bb73cc8",
                                                "text": "Er ist Herr über seine Daten."
                                            },
                                            {
                                                "example_id": "85bf1296-aa46-4594-a3be-906d0d6e179f",
                                                "sense_id": "de95b1b2-feb3-3c33-8fa0-f8009bb73cc8",
                                                "text": "Der Herr der sieben Weltmeere."
                                            },
                                            {
                                                "example_id": "a3e1c123-289c-4130-b7de-8a6c9f581e47",
                                                "sense_id": "de95b1b2-feb3-3c33-8fa0-f8009bb73cc8",
                                                "text": "„Die Männer aber stecken in einer Sackgasse. Für sie gibt es bis auf Weiteres nur das Rollenbild des Herren über Einkommen und Ehre in Gesellschaften, in denen ihnen auch ein Studienabschluss keinen Job mehr bringt, mit dem sie überhaupt eine Familie gründen könnten.“"
                                            },
                                            {
                                                "example_id": "54c43169-bbd0-4a52-a1b3-ce3f9ed6811f",
                                                "sense_id": "de95b1b2-feb3-3c33-8fa0-f8009bb73cc8",
                                                "text": "„Ehe Krist aber die Giebeltür noch erreicht und von außen her zugeschlossen haben konnte, legte sichs schon schwer und bleiern auf seines Herrn überreiztes Gehirn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "89c889e8-f0a7-3b46-9cd0-e1e589d003d8",
                                        "entry_id": "b3a1b542-002a-36e9-83da-350dbf78ea9a",
                                        "glosses": [
                                            "andere Bezeichnung für Gott"
                                        ],
                                        "tags": [
                                            "Monotheismus",
                                            "häufig mit bestimmtem Begleiter"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00f30983-1435-4fa7-9ef0-85241a62e5d6",
                                                "sense_id": "89c889e8-f0a7-3b46-9cd0-e1e589d003d8",
                                                "text": "Mein Herr und mein Gott…"
                                            },
                                            {
                                                "example_id": "31897d02-46a4-4bb7-b367-38700034e041",
                                                "sense_id": "89c889e8-f0a7-3b46-9cd0-e1e589d003d8",
                                                "text": "Gehet hin im Frieden des Herrn!"
                                            },
                                            {
                                                "example_id": "5a5a8bd2-db54-4413-bd2b-14fd55436732",
                                                "sense_id": "89c889e8-f0a7-3b46-9cd0-e1e589d003d8",
                                                "text": "„Sprich: O ihr Leute des Buches, ihr entbehrt jeder Grundlage, bis ihr die Thora und das Evangelium und das, was zu euch von eurem Herrn herabgesandt wurde, einhaltet.“"
                                            },
                                            {
                                                "example_id": "76849961-f32a-453f-91ff-8e12106ef271",
                                                "sense_id": "89c889e8-f0a7-3b46-9cd0-e1e589d003d8",
                                                "text": "„Des Herren Schutz sei mit uns allen, sagte der Bischof. Es ist ein wenig viel, was da auf einmal über uns kommt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Herr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e4e68a5f-783c-30b2-9446-4077c47b56e8",
                                        "entry_id": "54f63427-e1cb-39cd-a7ae-f04b2d146ee6",
                                        "glosses": [
                                            "Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d048eee8-9ab6-412d-8550-aeb495f8413d",
                                                "sense_id": "e4e68a5f-783c-30b2-9446-4077c47b56e8",
                                                "text": "Herr Herr wird sein Haus verkaufen."
                                            },
                                            {
                                                "example_id": "15f90c1f-6ce6-4a8a-8549-671f31b7a364",
                                                "sense_id": "e4e68a5f-783c-30b2-9446-4077c47b56e8",
                                                "text": "Frau Herr hat sich als Freiwillige gemeldet."
                                            },
                                            {
                                                "example_id": "7fb847fc-f56f-42cf-9782-8bf3bd98945a",
                                                "sense_id": "e4e68a5f-783c-30b2-9446-4077c47b56e8",
                                                "text": "Gestern kamen die Herrs aus dem Afrikaurlaub wieder."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
