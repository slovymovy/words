                        "entry_id": "63535bc5-e979-37e4-87bd-9cf87727e3dd",
                        "glosses": [
                            "botsing van een schip met een ander schip of object"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "635eaa5c-475f-4927-9913-9b373cab9cd7",
                                "sense_id": "8e917756-5f9e-303d-aa40-8d99397efeb4",
                                "text": "Als een vrachtschip een aanvaring heeft met een plezierjacht loopt het meestal slecht af met het plezierjacht."
                            }
                        ]
                    },
                    {
                        "sense_id": "fcaa7f29-5cd3-33d4-9463-97662469a7ff",
                        "entry_id": "63535bc5-e979-37e4-87bd-9cf87727e3dd",
                        "glosses": [
                            "conflict"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "aa53ed9f-98ac-4faf-970e-675afee59f73",
                                "sense_id": "fcaa7f29-5cd3-33d4-9463-97662469a7ff",
                                "text": "De leraren hadden vaak een aanvaring met de opstandige student."
                            },
                            {
                                "example_id": "2d920d64-3022-4451-b24e-94fff4c1c11c",
                                "sense_id": "fcaa7f29-5cd3-33d4-9463-97662469a7ff",
                                "text": "Pubers behoren vaak aanvaringen te hebben met hun ouders."
                            },
                            {
                                "example_id": "b81362d8-0025-400f-b694-90d7ee47297d",
                                "sense_id": "fcaa7f29-5cd3-33d4-9463-97662469a7ff",
                                "text": "Voor het eerst tijdens deze aanvaring zie ik iets van oprechtheid in haar blik. Ze lijkt echt te willen weten wat ze niet goed heeft gedaan."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e5e975e-c506-3240-a359-f46270937bd4",
                        "entry_id": "63535bc5-e979-37e4-87bd-9cf87727e3dd",
                        "glosses": [
                            "in aanvaring komen met: botsen tegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a514a553-ec12-4063-b89c-323e06b887b2",
                                "sense_id": "5e5e975e-c506-3240-a359-f46270937bd4",
                                "text": "Herinneringen aan je jeugd of mijmeringen over een oude vriend konden in aanvaring komen met een acht meter hoge afbeelding van A.I. Steak Sauce."
                            }
                        ]
                    }
                ],
