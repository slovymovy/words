                            {
                                "example_id": "b8f85ec0-7843-40c4-a93e-073e106386d0",
                                "sense_id": "03ad6167-f125-3aed-98f9-5f6d38304a1e",
                                "text": "Ik begin een troglodiet te worden, dacht March; een grotbewoner, een zonderling; een schender van papieren graven."
                            },
                            {
                                "example_id": "473c35e2-7ebc-4982-9eac-ccf54fe821fc",
                                "sense_id": "03ad6167-f125-3aed-98f9-5f6d38304a1e",
                                "text": "De 15 grotbewoners hebben hun activiteiten (nog) niet gesynchroniseerd. ,,Als ik moe ben, ga ik slapen. Als ik honger heb dan eet ik iets. Maar iedereen heeft een ander ritme.’’"
                            }
                        ]
                    }
