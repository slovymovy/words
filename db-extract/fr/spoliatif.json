                        "glosses": [
                            "Relatif à une spoliation, qui dépouille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ff1f6c5-77ee-4974-8f8d-b84aaef0a6c7",
                                "sense_id": "4d779fce-7f68-3d65-b94b-a02bf66a6f58",
                                "text": "Il est aisé par là d'apercevoir la différence qu’il y a entre un impôt exorbitant et un impôt spoliatif ; car par la forme de l’imposition, un impôt peut être spoliatif sans être exorbitant, ou peut être exorbitant sans être spoliatif."
                            }
                        ]
                    },
                    {
                        "sense_id": "c2b09daa-df00-385c-aa81-eb9f08e29a23",
                        "entry_id": "d1b6de55-2b63-3504-85f6-88cbd40b8b10",
                        "glosses": [
                            "Qui ôte, enlève (le sang)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "048f2d37-ec75-46c2-9ad3-afc10b296827",
                                "sense_id": "c2b09daa-df00-385c-aa81-eb9f08e29a23",
                                "text": "saignée spoliative, saignée qu'on ne pratique que pour diminuer la masse du sang, par opposition à la saignée dite dérivative."
                            }
                        ]
