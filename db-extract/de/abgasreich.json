                    }
                ],
                "senses": [
                    {
                        "sense_id": "7c513102-0e51-33ab-bc40-d6ef8b829aa7",
                        "entry_id": "07683893-5160-3c74-9c43-c77291fd07a5",
                        "glosses": [
                            "eine große Menge an Abgasen ausstoßend, enthaltend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68e57ef2-2011-4703-a465-008f662ddbc2",
                                "sense_id": "7c513102-0e51-33ab-bc40-d6ef8b829aa7",
                                "text": "„Nach Stunden in der Natur herrscht hier in den engen Straßen wieder das Auto-Chaos, eng, laut, abgasreich.“"
                            },
                            {
                                "example_id": "7740d3aa-61ee-4b6c-94e4-641792a642a6",
                                "sense_id": "7c513102-0e51-33ab-bc40-d6ef8b829aa7",
                                "text": "„Mit dem Taxi fuhren ich und mein Shunt in das abgasreiche Mannheim zurück.“"
                            },
                            {
                                "example_id": "62193a77-79a9-4dcc-b5b6-08cb7a2b4d3e",
                                "sense_id": "7c513102-0e51-33ab-bc40-d6ef8b829aa7",
                                "text": "„Der große Streit der Klimaverhandlungen war stets, ob abgasreiche Schwellenländer wie China und Indien den gleichen CO2-Regeln unterworfen werden sollen wie Industriestaaten, die historisch das meiste CO2 erzeugt haben.“"
                            },
                            {
                                "example_id": "5d465270-b65e-4373-9c7a-184cdd5326db",
                                "sense_id": "7c513102-0e51-33ab-bc40-d6ef8b829aa7",
                                "text": "„Die magere, abgasreiche Verbrennung ist ein technischer Kompromiß, der aus einem für den unteren Leistungsbereich zu groß geratenen Motor erwächst.“"
                            },
                            {
                                "example_id": "a0ac30e2-b487-45f4-ba75-b18f03bf2f7c",
                                "sense_id": "7c513102-0e51-33ab-bc40-d6ef8b829aa7",
                                "text": "„Das Verwaltungsgericht hat am Dienstag Klagen gegen die zum Klimaschutz eingeführten Fahrverbote für abgasreiche Autos abgewiesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [],
