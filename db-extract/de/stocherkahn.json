                ],
                "senses": [
                    {
                        "sense_id": "f3dd73d1-fa5a-3ee2-bd31-b51493ac0e42",
                        "entry_id": "26d648aa-bb90-3d30-8f95-849924bd0735",
                        "glosses": [
                            "ein sechs bis zwölf Meter langes, sehr flaches Boot aus Hartholz, das von einem am Ende stehenden Stocherer mit einer bis zu sieben Meter langen Stange durch Einrammen in den Grund eines flachen Gewässers bewegt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff2cf8aa-fd03-42c7-be94-21bd4500e552",
                                "sense_id": "f3dd73d1-fa5a-3ee2-bd31-b51493ac0e42",
                                "text": "Stocherkähne sind flache Holzboote, die auf dem Neckar in Tübingen mit einer langen Stange bewegt und gesteuert werden."
                            },
                            {
                                "example_id": "32c133a3-2e71-44cc-bf2f-a116fd992673",
                                "sense_id": "f3dd73d1-fa5a-3ee2-bd31-b51493ac0e42",
                                "text": "Ehe Sie Ihre Freundin zu einer Fahrt im Stocherkahn einladen, sollten Sie die Technik kennen und lange, lange üben, sonst dreht sich der Kahn im Kreis, die Stange macht Sie von Kopf bis Fuß nass, entgleitet Ihren Händen und treibt den Fluss hinab, und Sie fallen am Ende auch noch hinterher."
                            },
                            {
                                "example_id": "0e33e9bc-90fa-48fd-8f1b-70979cd842b0",
                                "sense_id": "f3dd73d1-fa5a-3ee2-bd31-b51493ac0e42",
                                "text": "In einer mit Thermalwasser gefüllten Karstgrotte kann man mit einem Stocherkahn die unterirdische Welt erkunden."
                            },
                            {
                                "example_id": "87b0d166-d23e-438b-b04c-b23afe10d657",
                                "sense_id": "f3dd73d1-fa5a-3ee2-bd31-b51493ac0e42",
                                "text": "„Die Fußmärsche dauern jeweils zwischen zwei und sechs Stunden, zuweilen werden die Erkundungen per Kajak oder Stocherkahn fortgesetzt.“"
                            },
                            {
                                "example_id": "acabf126-ddb8-4492-88d8-1c08bffc406a",
                                "sense_id": "f3dd73d1-fa5a-3ee2-bd31-b51493ac0e42",
                                "text": "„Ein Stocherkahn für zwei Personen schlägt pro Tag mit mindestens 3000 Rs zu Buche; für ein Motorboot wird man mindestens 6000 Rs los.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
