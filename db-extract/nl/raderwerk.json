                ],
                "senses": [
                    {
                        "sense_id": "33a87b75-e2da-3de0-bf70-b8e4a4c017cc",
                        "entry_id": "41e313ec-be3f-375a-8683-299043f1a5e5",
                        "glosses": [
                            "een serie van in elkaar grijpende raderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f67cbb8a-d31d-4cd0-a3a3-c481ff446aa3",
                                "sense_id": "33a87b75-e2da-3de0-bf70-b8e4a4c017cc",
                                "text": "Zelf werkt Pegge in de olie- en gaswinning voor de Nederlandse Aardolie Maatschappij (Nam). Hij is onder de indruk van het imposante raderwerk en de machtige assen in de molen."
                            }
                        ]
                    },
                    {
                        "sense_id": "b54bd292-12ad-3265-9615-8ea665d7df0d",
                        "entry_id": "41e313ec-be3f-375a-8683-299043f1a5e5",
                        "glosses": [
                            "een aantal handelingen en zaken die goed op elkaar zijn afgestemd"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "0afcbef7-3101-49f9-a6a8-8adf8c906cf0",
                                "sense_id": "b54bd292-12ad-3265-9615-8ea665d7df0d",
                                "text": "'Heel het raderwerk staat stil, als uw machtige arm het wil' Zinsnede uit een rede van Troelstra tot de arbeiders (ter gelegenheid van de spoorwegstaking van 1903). Troelstra citeerde hiermee het onderschrift bij een politieke prent van Albert Hahn in Het Volk van 8 februari 1903."
                            },
                            {
                                "example_id": "ef1e1940-685c-45bb-b1b7-465f51e10b09",
                                "sense_id": "b54bd292-12ad-3265-9615-8ea665d7df0d",
                                "text": "Er zit erg veel zand in dat aloude raderwerk, van zuilen over partijen en sociale zekerheid. Het is nog heel erg gemodelleerd naar een samenleving die er niet meer is. Om een voorbeeld te geven: veel hoogopgeleide jongeren zitten nu in precaire banen. Ze werken freelance of doen mini-jobs. Sommigen willen dat ook, het is een manier van leven. Maar de vakbond of de sociale zekerheid biedt daar onvoldoende bescherming.’"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d05ff36b-cff0-4b47-b133-34d738adacdf",
                        "source_entry_id": "41e313ec-be3f-375a-8683-299043f1a5e5",
                        "source_sense_id": "33a87b75-e2da-3de0-bf70-b8e4a4c017cc",
                        "source_sense_description": "een serie van in elkaar grijpende raderen",
                        "target_lang_word": "mechanism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mechanism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad2ac18c-302a-3e55-a604-3dab88d40e31",
                                        "entry_id": "c6b20131-4e20-3721-a0f5-e4f1fb81b181",
                                        "glosses": [
                                            "Any mechanical means for the conversion or control of motion, or the transmission or control of power."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6691f726-d7b7-3a58-9386-3627e1bc26dc",
                                        "entry_id": "c6b20131-4e20-3721-a0f5-e4f1fb81b181",
                                        "glosses": [
                                            "Any combination of cams, gears, links, belts, chains and logical mechanical elements."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6912cadf-449b-483a-8ba5-5e35fb6ee929",
                                                "sense_id": "6691f726-d7b7-3a58-9386-3627e1bc26dc",
                                                "text": "A doorknob of whatever roundish shape is effectively a continuum of levers, with the axis of the latching mechanism—known as the spindle—being the fulcrum about which the turning takes place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae8b752e-09bc-3eab-be47-8c8f3d6bc711",
                                        "entry_id": "c6b20131-4e20-3721-a0f5-e4f1fb81b181",
                                        "glosses": [
                                            "A group of entities, such as objects, that interact together."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac725b1e-c8e8-40c4-8fff-567fd5fcc6d1",
                                                "sense_id": "ae8b752e-09bc-3eab-be47-8c8f3d6bc711",
                                                "text": "A very rare polymorphism in the prion protein gene recently has been identified that appears to protect against prion disease; this finding, in addition to providing greater understanding of the prionlike mechanisms of neurodegenerative disorders, might lead to potential treatments."
                                            },
                                            {
                                                "example_id": "38afd166-e150-48e8-9e5f-e379ac891a01",
                                                "sense_id": "ae8b752e-09bc-3eab-be47-8c8f3d6bc711",
                                                "text": "Outside the boundaries of the PTEs [Passenger Transport Executives], there was little mechanism to re-open routes, and despite a growing realisation that the lack of transport connectivity was a big contributor towards social deprivation and poor economic performance, there was little government policy recognition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acd42dd3-3a33-3c57-90cd-5a4b6f8e9a7d",
                                        "entry_id": "c6b20131-4e20-3721-a0f5-e4f1fb81b181",
                                        "glosses": [
                                            "A mental, physical, or chemical process."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba728253-d74a-3b74-a83c-2c0c9a9f3150",
                                        "entry_id": "c6b20131-4e20-3721-a0f5-e4f1fb81b181",
                                        "glosses": [
                                            "Any process of, or system designed to manage useful energy conversion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "97ee36a4-847c-38ce-b718-2193353105d1",
                                        "entry_id": "c6b20131-4e20-3721-a0f5-e4f1fb81b181",
                                        "glosses": [
