                    {
                        "sense_id": "c88d59b0-1f64-3fff-befa-736cb5874441",
                        "entry_id": "624bbf14-57ac-3599-aba0-26463d849d46",
                        "glosses": [
                            "Partie d’une arme servant à viser."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "927cb212-2792-3b4a-9007-67e7ff892993",
                        "entry_id": "624bbf14-57ac-3599-aba0-26463d849d46",
                        "glosses": [
                            "Pièce en cuivre qui sert à diverses vérifications ou rectifications des instruments de réflexion et en particulier du cercle."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ab06e274-e1eb-3f1a-9e76-673bcd2df659",
                        "entry_id": "624bbf14-57ac-3599-aba0-26463d849d46",
                        "glosses": [
                            "Dispositif qui sert à donner à l’appareil la direction voulue."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0571a447-f313-438b-90cc-ae5ee8f4bd42",
                        "source_entry_id": "624bbf14-57ac-3599-aba0-26463d849d46",
                        "target_lang_word": "Visier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Visier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fbce69f3-7791-3980-ad0d-249950c582d1",
                                        "entry_id": "39fd1b6e-544f-3d03-ab96-1555d722e736",
                                        "glosses": [
                                            "bewegliche Vorrichtung an einem Helm zum Schutz des Gesichts"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d5e1a66-3d71-439c-917d-0d3b97100de8",
                                                "sense_id": "fbce69f3-7791-3980-ad0d-249950c582d1",
                                                "text": "„Unter dem aufgeschlagenen Visier sah aus den Kanten des mit Adlerschwingen und Kronreif gezierten Helmes ein blasses, blauäugiges Gesicht heraus, in dem sich Strenge und kränkliche Scheu seltsam mischten mit Gutmütigkeit und schalkhafter Milde […]“"
                                            },
                                            {
                                                "example_id": "85ea1116-68e2-458e-bed0-40d81b4ba82d",
                                                "sense_id": "fbce69f3-7791-3980-ad0d-249950c582d1",
                                                "text": "„Statt ihrer schaut der römische Söldner Mauritius grimmig unter einem hochgeklappten Visier hervor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "927ed750-e1d9-3459-86de-8b41090ad1da",
                                        "entry_id": "39fd1b6e-544f-3d03-ab96-1555d722e736",
                                        "glosses": [
                                            "Zielvorrichtung an Waffen"
                                        ],
                                        "tags": [
                                            "Schießsport"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da8eb253-8d98-4120-9acc-1b9c0ef43f04",
                                                "sense_id": "927ed750-e1d9-3459-86de-8b41090ad1da",
                                                "text": "„Die Umrisse der an den Rudern Stehenden hoben sich vom lichten Hintergrund ab und der Jagdgehilfe konnte mit einiger Genauigkeit das Visier nehmen. Er zielte kurz und feuerte.“"
                                            },
                                            {
                                                "example_id": "ee21844d-8441-4e3d-b7b0-a1fbcfa8b077",
                                                "sense_id": "927ed750-e1d9-3459-86de-8b41090ad1da",
                                                "text": "„Ich bekam sie beide ins Visier, und das Zielfernrohr holte sie ganz nahe heran.“"
                                            },
                                            {
                                                "example_id": "61e48b16-4270-4534-ae14-17793146b540",
                                                "sense_id": "927ed750-e1d9-3459-86de-8b41090ad1da",
                                                "text": "„Das musste sitzen, wenn das Visier nicht falsch war.“"
                                            },
                                            {
                                                "example_id": "b3b2bf26-21b5-4a24-b9d1-8f70af116db4",
                                                "sense_id": "927ed750-e1d9-3459-86de-8b41090ad1da",
                                                "text": "„Heute nehmen sie die Bergsportler ins Visier, bieten Klettersteige nach Katalog oder nehmen die vorhandenen Wege und klassifizieren sie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d05746a0-63d5-39c7-9e2e-080a6e789c5a",
                                        "entry_id": "39fd1b6e-544f-3d03-ab96-1555d722e736",
                                        "glosses": [
                                            "Aussteckung, die ein Bauvorhaben visualisiert"
                                        ],
                                        "tags": [
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7037c760-52ee-456a-b4fd-5e3242d2009b",
                                                "sense_id": "d05746a0-63d5-39c7-9e2e-080a6e789c5a",
                                                "text": "„Was bedeuten Visiere? Visiere kündigen an: Hier will jemand demnächst etwas bauen.“"
                                            },
                                            {
                                                "example_id": "dd96f8d7-c4b1-4449-82e7-87aba0f6e4e7",
                                                "sense_id": "d05746a0-63d5-39c7-9e2e-080a6e789c5a",
                                                "text": "„Die Visiere müssen den Standort und das Ausmass des Vorhabens bezeichnen, d. h. es reicht aus, den Gebäudekubus mit seiner horizontalen und vertikalen Ausdehnung vereinfacht zum Ausdruck zu bringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e423bd2-623b-456b-b7cd-569a941b8e99",
                        "source_entry_id": "624bbf14-57ac-3599-aba0-26463d849d46",
                        "target_lang_word": "Sucher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sucher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "89ac8a09-9ec0-3d90-bcce-4895c9ef69ef",
                                        "entry_id": "d474ba6d-7540-3f70-952c-6ff3919cb1c4",
                                        "glosses": [
                                            "Person, die etwas oder jemanden sucht"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9598bbde-7fe6-4e30-baa9-a270a694ff97",
                                                "sense_id": "89ac8a09-9ec0-3d90-bcce-4895c9ef69ef",
                                                "text": "Der Rufer in der Wüste traf den Sucher in der Wüste."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d14405c8-3084-3e28-a132-475a761cfb2c",
                                        "entry_id": "d474ba6d-7540-3f70-952c-6ff3919cb1c4",
                                        "glosses": [
                                            "Vorrichtung bei einem Fernrohr oder Fotoapparat zur Fixierung/zum Anvisieren eines Objekts oder Motivs"
                                        ],
                                        "tags": [
                                            "Optik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b64e5d9c-076f-430f-9813-0d4c27d7b357",
                                                "sense_id": "d14405c8-3084-3e28-a132-475a761cfb2c",
                                                "text": "Hast du Leni nun endlich im Sucher?"
                                            },
                                            {
                                                "example_id": "6a0bfe89-744f-4b4a-9021-dac92c872277",
                                                "sense_id": "d14405c8-3084-3e28-a132-475a761cfb2c",
                                                "text": "„Mein Blick im Sucher traf sich mit ihrem frechen Lächeln voller Schalk.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
