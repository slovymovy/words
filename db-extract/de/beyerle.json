                ],
                "senses": [
                    {
                        "sense_id": "bfbac35b-34dd-3eaa-8710-0a5d41fe7d8b",
                        "entry_id": "b8abcc97-535e-30d1-8cb0-a1a9d329c76b",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e7295de-8573-4c77-9572-71023cb9acdf",
                                "sense_id": "bfbac35b-34dd-3eaa-8710-0a5d41fe7d8b",
                                "text": "Frau Beyerle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "5e8f6fdd-7172-480e-9701-e30468777dda",
                                "sense_id": "bfbac35b-34dd-3eaa-8710-0a5d41fe7d8b",
                                "text": "Herr Beyerle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c87a7c43-ce11-4537-a66e-6248583e271e",
                                "sense_id": "bfbac35b-34dd-3eaa-8710-0a5d41fe7d8b",
                                "text": "Die Beyerles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "83e6bea6-a16b-4d6b-b7d6-3c6d455aecb1",
                                "sense_id": "bfbac35b-34dd-3eaa-8710-0a5d41fe7d8b",
                                "text": "Der Beyerle trägt nie die Schals, die die Beyerle ihm strickt."
                            },
                            {
                                "example_id": "2dc07248-787b-4c41-a9bc-8ce599fcaceb",
                                "sense_id": "bfbac35b-34dd-3eaa-8710-0a5d41fe7d8b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Beyerle kommt, geht der Herr Beyerle.“"
                            },
                            {
                                "example_id": "dba5dc14-4349-400f-81b6-73694db311ea",
                                "sense_id": "bfbac35b-34dd-3eaa-8710-0a5d41fe7d8b",
                                "text": "Beyerle kommt und geht."
                            },
                            {
                                "example_id": "2703d8a2-09a4-4f61-a7d4-5be02410f201",
                                "sense_id": "bfbac35b-34dd-3eaa-8710-0a5d41fe7d8b",
                                "text": "Beyerles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
