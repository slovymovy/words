                        "sense_id": "0ed061c5-e906-3737-b516-21075faf6812",
                        "entry_id": "73295656-4d10-3dc6-94b8-71494c847dfb",
                        "glosses": [
                            "iemand die toezicht houdt in bijv. een museum of stadion"
