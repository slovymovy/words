                "senses": [
                    {
                        "sense_id": "7277112b-5ad8-354c-8745-e2875614b492",
                        "entry_id": "e05e9b9d-87a5-3c3e-a36b-10956d6f2dfc",
                        "glosses": [
                            "einfacher, platter, aber wirkungsvoller Witz, oft auch ironisch gebraucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65e8eaac-f1ff-49f3-8b8e-ab91bfc71dab",
                                "sense_id": "7277112b-5ad8-354c-8745-e2875614b492",
                                "text": "Der Alleinunterhalter brachte einen Schenkelklopfer nach dem anderen."
                            },
                            {
                                "example_id": "3b102d60-885f-414e-a4c4-bb3bfd8db7fa",
                                "sense_id": "7277112b-5ad8-354c-8745-e2875614b492",
                                "text": "„Wolfgang Murnbergers \"Mein bester Feind\" kappt jeden Bezug zur Historie und setzt auf gepflegtes Ambiente und brachiale Schenkelklopfer.“"
                            },
                            {
                                "example_id": "10ea3916-01a5-41da-a7a4-8a037bc81940",
                                "sense_id": "7277112b-5ad8-354c-8745-e2875614b492",
                                "text": "„Bei der Hauptversammlung lädt er spontan einen der Kleinaktionäre, der ihn über sein Privatleben befragt hat, zu seiner Hochzeit ein, um dann den nächsten Schenkelklopfer zu platzieren: »Aber aufgepasst, ich werde Sie nicht alle einladen.«“"
                            },
                            {
                                "example_id": "e56aa8da-e56d-431a-9fa3-a869afa593f6",
                                "sense_id": "7277112b-5ad8-354c-8745-e2875614b492",
                                "text": "„Den Schenkelklopfer des Abends brachte der Kandidat Garry Johnson, dessen Namen man sich nicht weiter merken muss. Er bemerkte, die beiden Hunde seines Nachbarn hätten mehr Jobs geschaffen als Präsident Obama.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
