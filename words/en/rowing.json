{
    "word_family": [
        "rower"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eb7f90bd-cc6d-3601-8ae6-d4ac54b1d2a9",
                    "sense_definition": "The activity or act of propelling a boat using oars.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "water_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to go <w>rowing</w> on the quiet lake during our vacation. ",
                            "target_lang_translations": {
                                "ru": "Во время отпуска мы решили <w>покататься на лодке</w> по тихому озеру."
                            }
                        },
                        {
                            "text": "He loves <w>rowing</w> a boat early in the morning when the water is calm.",
                            "target_lang_translations": {
                                "ru": "Он любит <w>грести</w> на лодке рано утром, когда вода спокойная."
                            }
                        }
                    ],
                    "synonyms": [
                        "sculling"
                    ],
                    "common_phrases": [
                        "rowing a boat",
                        "go rowing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Занятие или действие по перемещению лодки с помощью вёсел."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гребля",
                                "target_lang_sense_clarification": "перемещение на лодке с помощью вёсел"
                            },
                            {
                                "target_lang_word": "катание на лодке",
                                "target_lang_sense_clarification": "прогулка на вёсельной лодке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "575cc90c-7ca5-3901-9593-4a44ca4cddf9",
                    "sense_definition": "The sport or competitive activity of racing in boats using oars.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "water_activity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She joined the university <w>rowing</w> team and practices every morning.",
                            "target_lang_translations": {
                                "ru": "Она вступила в университетскую команду по <w>гребле</w> и тренируется каждое утро."
                            }
                        },
                        {
                            "text": "The national <w>rowing</w> team won a gold medal at the championship.",
                            "target_lang_translations": {
                                "ru": "Национальная сборная по <w>гребному спорту</w> завоевала золотую медаль на чемпионате."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rowing team",
                        "rowing club"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вид спорта или соревновательная деятельность по гонкам на лодках с использованием вёсел."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гребля",
                                "target_lang_sense_clarification": "гребной спорт"
                            },
                            {
                                "target_lang_word": "гребной спорт",
                                "target_lang_sense_clarification": "соревновательный вид спорта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "85c975cb-6c50-3503-904d-b8a1cad21a70",
                    "sense_definition": "An instance of noisy arguing or quarreling.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "argument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Their constant loud <w>rowing</w> disturbed the neighbors every night.",
                            "target_lang_translations": {
                                "ru": "Их постоянная громкая <w>ругань</w> мешала соседям каждую ночь."
                            }
                        },
                        {
                            "text": "They had another heated <w>rowing</w> about who should clean the kitchen.",
                            "target_lang_translations": {
                                "ru": "У них произошла очередная жаркая <w>ссора</w> о том, кто должен уборку на кухне."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "More common in British English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Случай шумной ссоры или перепалки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ссора",
                                "target_lang_sense_clarification": "шумная перепалка"
                            },
                            {
                                "target_lang_word": "ругань",
                                "target_lang_sense_clarification": "громкий конфликт"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cf60ea07-dd0c-36b2-a6cc-0def5919af3e",
                    "sense_definition": "Present participle and gerund of <w>row</w> (to propel a boat with oars).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "propel_boat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They are <w>rowing</w> across the river to reach the campsite.",
                            "target_lang_translations": {
                                "ru": "Они <w>гребут</w> через реку, чтобы добраться до палаточного лагеря."
                            }
                        },
                        {
                            "text": "He was exhausted after <w>rowing</w> for three consecutive hours.",
                            "target_lang_translations": {
                                "ru": "Он был истощён после того, как <w>греб</w> три часа подряд."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма причастия настоящего времени и герундия от слова «row» (грести, вести лодку вёслами)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гребля",
                                "target_lang_sense_clarification": "действие по значению «грести»"
                            },
                            {
                                "target_lang_word": "грести",
                                "target_lang_sense_clarification": "управлять лодкой с помощью вёсел"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5917ed46-20b0-3492-ae5b-bd54b2b7a59b",
                    "sense_definition": "Present participle and gerund of <w>row</w> (to argue or quarrel noisily).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "quarrel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The couple next door are <w>rowing</w> again about money matters.",
                            "target_lang_translations": {
                                "ru": "Пара по соседству снова <w>ругается</w> из-за денег."
                            }
                        },
                        {
                            "text": "I could hear them <w>rowing</w> through the thin walls of the hotel.",
                            "target_lang_translations": {
                                "ru": "Я слышал, как они <w>ссорились</w> через тонкие стены отеля."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Mainly British usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма причастия настоящего времени и герундия от слова «row» (громко ссориться, ругаться)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ссора",
                                "target_lang_sense_clarification": "процесс ругани"
                            },
                            {
                                "target_lang_word": "ругаться",
                                "target_lang_sense_clarification": "громко спорить"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}