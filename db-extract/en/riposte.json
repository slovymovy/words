                    {
                        "sense_id": "10dc0b7b-a8db-3047-8789-99e4ef6cf7a6",
                        "entry_id": "a2009775-298e-3359-9044-9d806c40c659",
                        "glosses": [
                            "To respond quickly; particularly if the response is humorous."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b03d502f-6bc4-4da3-ba6d-f522a0c0854d",
                                "sense_id": "10dc0b7b-a8db-3047-8789-99e4ef6cf7a6",
                                "text": "I left him and went to a tavern by the quays where the college bucks were drinking and singing hymns. There was Giles who invited old men back to his college apartments for games. Members of the rowing club riposted, for God's sake, man, clean up your life."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ddf9ebde-c555-4b1f-9fae-c802a194dce2",
                        "source_entry_id": "a2009775-298e-3359-9044-9d806c40c659",
                        "source_sense_description": "to respond quickly; particularly if the response is humorous",
                        "target_lang_word": "zurückschießen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zurückschießen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ac2619ce-5f8d-3957-81ab-7fb282075b7e",
                                        "entry_id": "786e387d-0120-3835-b82b-5432a0a9e818",
                                        "glosses": [
                                            "jemandes Waffenfeuer erwidern"
                                        ],
                                        "tags": [
                                            "intransitiv, Hilfsverb haben"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5530660f-b5d6-4629-bada-55f6b1b53118",
                                                "sense_id": "ac2619ce-5f8d-3957-81ab-7fb282075b7e",
                                                "text": "„Als Hitler am 1. September 1939 im Deutschen Reichstag in der Kroll-Oper in Berlin sprach, stellte er die Tatsachen verdrehend den Kriegsbeginn so dar, als sei Deutschland von Polen bedroht und angegriffen worden. Mit Pathos rief der eigentliche Aggressor aus: »Seit 5 Uhr 45 wird jetzt zurückgeschossen. Und von jetzt ab wird Bombe mit Bombe vergolten.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0f9fd636-6981-3ebf-9386-ba8f473829f6",
                                        "entry_id": "786e387d-0120-3835-b82b-5432a0a9e818",
                                        "glosses": [
                                            "eine Anfeindung, Verbalattacke kontern"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41f9471a-17de-4d57-8a0a-2a2fdddc4402",
                                                "sense_id": "0f9fd636-6981-3ebf-9386-ba8f473829f6",
                                                "text": "„[…] Dass Kamala Harris unerschrocken und nicht gerade auf den Mund gefallen ist, ist ein enormer Vorteil für Joe Biden. Nachdem Donald Trump ihr kurz nach ihrer Nominierung [zur Vizepräsidentin] vorgeworfen hatte ‚gelogen‘ zu haben und ‚böse‘ zu sein, schoss sie mit scharfen Worten zurück.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4dd35008-4712-3411-be18-a465ad9eadfe",
                                        "entry_id": "786e387d-0120-3835-b82b-5432a0a9e818",
                                        "glosses": [
                                            "sich schnell wieder an seinen Ausgangspunkt bewegen"
                                        ],
                                        "tags": [
                                            "intransitiv, Hilfsverb sein"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "7e9688d8-1413-3518-98db-7509ba612dcc",
                                        "entry_id": "786e387d-0120-3835-b82b-5432a0a9e818",
                                        "glosses": [
                                            "durch Erzielen eines oder mehrerer Treffer wieder die Möglichkeit auf den Sieg in einem Spiel, das Weiterkommen in einem Wettbewerb und dergleichen verschaffen"
                                        ],
                                        "tags": [
