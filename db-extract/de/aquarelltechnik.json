                "senses": [
                    {
                        "sense_id": "be2064bf-089d-30e4-ad13-9ac743d18f5f",
                        "entry_id": "90fb7829-de73-3675-8371-960b36e6c04e",
                        "glosses": [
                            "das Malen mit Aquarell- oder Wasserfarben"
                        ],
                        "tags": [
                            "Bildende Kunst"
                        ],
                        "examples": [
                            {
                                "example_id": "7e66a606-dfaa-4321-9e3e-9e6c41bba7d5",
                                "sense_id": "be2064bf-089d-30e4-ad13-9ac743d18f5f",
                                "text": "„Freieste Handhabeung der Aquarelltechnik findet sich bei den Engländern des 19. Jahrhunderts.“"
                            },
                            {
                                "example_id": "ff8160d8-b74e-4c96-b90f-2f59aadedd59",
                                "sense_id": "be2064bf-089d-30e4-ad13-9ac743d18f5f",
                                "text": "„Sie wirken bescheiden. Zart fließen die wasserdünnen Farben in Aquarelltechnik ineinander, färben den Himmel blassblau, den Horizont blassrosa, das Laub der Bäume blassgrün. Wenn man Goethes Zeichnungen, auch die bekannteren von seiner Italienreise, betrachtet, könnte man meinen, der Dichter nehme sich als Zeichner sehr zurück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
