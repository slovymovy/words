                "senses": [
                    {
                        "sense_id": "1ebceabb-671c-3c5b-be93-8b8ba0b7ae19",
                        "entry_id": "ca35e6c2-9383-35a4-a17a-88262680373c",
                        "glosses": [
                            "disobedient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27f454af-156a-43b9-8e58-403374b9783e",
                                "sense_id": "1ebceabb-671c-3c5b-be93-8b8ba0b7ae19",
                                "text": "Het ongehoorzame kind weigerde zijn kamer op te ruimen.",
                                "translation": "The disobedient child refused to clean up his room.",
                                "english": "The disobedient child refused to clean up his room."
                            },
                            {
                                "example_id": "fd0bd640-928a-4fa4-89c2-7b28754b786d",
                                "sense_id": "1ebceabb-671c-3c5b-be93-8b8ba0b7ae19",
                                "text": "De ongehoorzamere honden waren moeilijk te trainen.",
                                "translation": "The more disobedient dogs were hard to train.",
                                "english": "The more disobedient dogs were hard to train."
                            },
                            {
                                "example_id": "39a9ade8-4822-44f4-b13c-e5b7a634f8af",
                                "sense_id": "1ebceabb-671c-3c5b-be93-8b8ba0b7ae19",
                                "text": "Van alle studenten was hij het ongehoorzaamst.",
                                "translation": "Of all the students, he was the most disobedient.",
                                "english": "Of all the students, he was the most disobedient."
                            }
                        ]
                    }
