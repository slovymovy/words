                                "target_senses": [
                                    {
                                        "sense_id": "1b9e25b3-25c4-3316-9c3c-5195c76bf398",
                                        "entry_id": "1661cbb9-8aa8-362d-af91-b564617aa850",
                                        "glosses": [
                                            "The act or process of specializing."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "070491d3-a859-48d3-89ab-b0f55103b2fa",
                                                "sense_id": "1b9e25b3-25c4-3316-9c3c-5195c76bf398",
                                                "text": "A human being should be able to change a diaper, plan an invasion, butcher a hog, conn a ship, design a building, write a sonnet, balance accounts, build a wall, set a bone, comfort the dying, take orders, give orders, cooperate, act alone, solve equations, analyze a new problem, pitch manure, program a computer, cook a tasty meal, fight efficiently, die gallantly. Specialization is for insects."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e1667ac-a522-3016-b61f-10451f3c422c",
                                        "entry_id": "1661cbb9-8aa8-362d-af91-b564617aa850",
                                        "glosses": [
                                            "The area in which someone specializes."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1eed4968-e74a-41f6-a666-5fbb15877713",
                                                "sense_id": "8e1667ac-a522-3016-b61f-10451f3c422c",
                                                "text": "Many MBA programs now allow students to obtain a specialization in sport management. This differs from the joint degree programs in that only one degree, an MBA, is awarded (i.e., a separate master's degree in sport management is not awarded). The MBA with a sport management specialization should be considered as a second option in lieu of the joint degree."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94e98bda-af5b-3d32-a28c-fdc85785e9d5",
                                        "entry_id": "1661cbb9-8aa8-362d-af91-b564617aa850",
                                        "glosses": [
                                            "The adaptation of an organism to a specific environment, or adaptation of an organ to a particular function."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b26f520-82a9-4bd2-9825-4fbe93c03e58",
                                                "sense_id": "94e98bda-af5b-3d32-a28c-fdc85785e9d5",
                                                "text": "Specialization is frequently divided into two categories largely based on methods of study: food specialization and specialization with respect to microhabitat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d14069e-19dc-3bd4-9f8c-4fdaf4474eda",
                                        "entry_id": "1661cbb9-8aa8-362d-af91-b564617aa850",
                                        "glosses": [
                                            "A proof, axiom, problem, or definition whose cases are completely covered by another, broader concept."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c10bc46c-1698-4d49-ac86-e7893fb1c34d",
                                                "sense_id": "7d14069e-19dc-3bd4-9f8c-4fdaf4474eda",
                                                "text": "A triangle is a specialization of a polygon to one with exactly three sides."
                                            }
                                        ]
                                    }
