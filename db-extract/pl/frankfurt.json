                                    {
                                        "sense_id": "09da5284-38e2-3e63-985f-bd702ea178e8",
                                        "entry_id": "0ef0803e-2524-34c3-97ea-f470e53e66f0",
                                        "glosses": [
                                            "The largest city in Hesse, in central Germany; in full, Frankfurt am Main."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1573a05-b276-423d-8c00-a40cd4f26751",
                                                "sense_id": "09da5284-38e2-3e63-985f-bd702ea178e8",
                                                "text": "Thomas was born in 1986, at a US military hospital in Frankfurt, Germany, to a mother born in Kenya and a US citizen father who eventually spent more than a decade in the military, where he repaired Army helicopters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e038324e-8f55-3ca8-bdfb-a4893bac0dd7",
                                        "entry_id": "0ef0803e-2524-34c3-97ea-f470e53e66f0",
                                        "glosses": [
                                            "The largest city in Hesse, in central Germany; in full, Frankfurt am Main.",
                                            "The German financial industry."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8122fd27-7ec0-49ed-8624-7bf2f454dc57",
                                                "sense_id": "e038324e-8f55-3ca8-bdfb-a4893bac0dd7",
                                                "text": "The poor third-quarter results from Frankfurt had the broadest impact because they spotlighted the vulnerability of the listed German universal banks to the financial crisis spreading from Asia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1939f55d-c7ea-3f60-be71-0454edb719cf",
                                        "entry_id": "0ef0803e-2524-34c3-97ea-f470e53e66f0",
                                        "glosses": [
                                            "The largest city in Hesse, in central Germany; in full, Frankfurt am Main.",
                                            "The European Central Bank."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f35a516b-5fea-4b5a-b31a-740ec6529219",
                                                "sense_id": "1939f55d-c7ea-3f60-be71-0454edb719cf",
                                                "text": "Despite this risk, little has happened in the six months since Frankfurt cut interest rates causing one to wonder how different Draghi is from his predecessor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d54d4748-360c-3e2a-aef6-4caa201fc3f6",
                                        "entry_id": "0ef0803e-2524-34c3-97ea-f470e53e66f0",
                                        "glosses": [
                                            "A sizable town in Brandenburg, in eastern Germany; in full, Frankfurt an der Oder."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
