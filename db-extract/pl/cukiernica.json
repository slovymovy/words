                                                "example_id": "8d55f17d-3fd6-4bb0-8fa1-e6be81afffc2",
                                                "sense_id": "c01c8cb6-33bd-3c2a-a930-d7e483a6b836",
                                                "text": "Выпив чашки три, он бросил огрызок сахару в сахарницу и перевернул чашку вверх дном."
                                            },
                                            {
                                                "example_id": "4c3b6b55-36fa-41c9-9cdd-b853ad48ac9a",
                                                "sense_id": "c01c8cb6-33bd-3c2a-a930-d7e483a6b836",
                                                "text": "Кипящий самовар стоял на столе, сестра налила Тимофею чашку и придвинула сахар в стеклянной сахарнице, похожей на подойник."
                                            }
                                        ]
