                        "cross_references": []
                    },
                    {
                        "translation_id": "3821e26b-8181-46de-9a8f-2b0863fe61a3",
                        "source_entry_id": "f89deb6c-c13d-3223-b44e-714b1777b6f4",
                        "source_sense_id": "01b97ea8-7cbb-3722-8c4c-52a0aaef4455",
                        "target_lang_word": "taiga",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
