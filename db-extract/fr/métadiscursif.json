                        "glosses": [
                            "Relatif au métadiscours, à des paroles relatives à d’autres paroles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f46f9f8d-0a02-446d-a19b-7af235a7956e",
                                "sense_id": "6230b583-2208-3c79-95ec-60075c651082",
                                "text": "Ces commentaires métadiscursifs à valeur de reproche s’accompagnent généralement d’une révision à la baisse de la formulation de A, que B va s’employer à \"déshyperboliser\"."
                            },
                            {
                                "example_id": "5cdf6dfe-51a5-4b79-ac6a-1bda7f8f614e",
                                "sense_id": "6230b583-2208-3c79-95ec-60075c651082",
                                "text": "L’identification de fonctions métadiscursives serait plutôt du ressort d’une pragmatique de la communication."
                            },
                            {
                                "example_id": "64b3dbdc-022c-43e6-9d09-a3224af95559",
                                "sense_id": "6230b583-2208-3c79-95ec-60075c651082",
                                "text": "Le deuxième type de question de compréhension que j’ai distingué consiste dans la reprise en mention autonymique de l’unité lexicale problématique, accompagnée d’une question métadiscursive."
                            }
                        ]
                    }
