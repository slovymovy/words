                                    {
                                        "sense_id": "3cedc84f-84eb-30a4-9f94-255cca1b2c80",
                                        "entry_id": "f8d7b9a9-512b-312b-82e5-a8666c652369",
                                        "glosses": [
                                            "The player who delivers the ball to the batter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7ebb231-8719-4bec-ad2b-3872c2c54cfc",
                                                "sense_id": "3cedc84f-84eb-30a4-9f94-255cca1b2c80",
                                                "text": "A “pitchometer” was installed on the scoreboard to time the pitchers. According the baseball rules a pitcher had to throw a pitch within 20 seconds after he received the ball from the catcher when there was nobody on base."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8700b312-40ff-3b8e-83f0-6c398f0c74db",
                                        "entry_id": "f8d7b9a9-512b-312b-82e5-a8666c652369",
                                        "glosses": [
                                            "A drug dealer."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d44350bb-4f82-43fc-a809-d0b6151196b5",
                                                "sense_id": "8700b312-40ff-3b8e-83f0-6c398f0c74db",
                                                "text": "To the residents of Spanish Harlem, these pitchers embodied the drug trade at its most sinister; they were the dealers and pushers who were destroying their neighborhood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0638252-b29d-3e3e-b408-0708b6b07206",
                                        "entry_id": "f8d7b9a9-512b-312b-82e5-a8666c652369",
                                        "glosses": [
                                            "One who puts counterfeit money into circulation."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f35383e-6334-494f-835f-934bc947aaf0",
                                                "sense_id": "a0638252-b29d-3e3e-b408-0708b6b07206",
                                                "text": "To discover […] how the honest poor are compelled to hob-and-nob with the “shoful pitcher” and the “gun,” it is necessary to visit the vast nursery-grounds of crime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6357af06-87c0-3ff7-be2d-6599ff8f3993",
                                        "entry_id": "f8d7b9a9-512b-312b-82e5-a8666c652369",
                                        "glosses": [
                                            "The top partner in a homosexual relationship or penetrator in a sexual encounter between two men."
                                        ],
