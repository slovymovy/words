{
    "word_family": [
        "rivet",
        "riveter"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "07220503-967a-39de-9b3e-5445ef7034ee",
                    "sense_definition": "Extremely interesting and holding one's attention completely.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "interesting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The audience watched a <w>riveting</w> performance by the lead actor.",
                            "target_lang_translations": {
                                "it": "Il pubblico ha assistito a una performance <w>avvincente</w> dell'attore protagonista."
                            }
                        },
                        {
                            "text": "She told a <w>riveting</w> story about her travels across the desert.",
                            "target_lang_translations": {
                                "it": "Ha raccontato una storia <w>avvincente</w> sui suoi viaggi attraverso il deserto."
                            }
                        }
                    ],
                    "synonyms": [
                        "captivating",
                        "engrossing",
                        "fascinating",
                        "gripping"
                    ],
                    "antonyms": [
                        "boring",
                        "dull"
                    ],
                    "common_phrases": [
                        "riveting story",
                        "riveting performance"
                    ],
                    "target_lang_definitions": {
                        "it": "Estremamente interessante e capace di catturare completamente l'attenzione."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "avvincente",
                                "target_lang_sense_clarification": "riferito a storie, film o performance che tengono incollati"
                            },
                            {
                                "target_lang_word": "affascinante",
                                "target_lang_sense_clarification": "riferito a qualcosa che attrae fortemente l'interesse"
                            },
                            {
                                "target_lang_word": "coinvolgente",
                                "target_lang_sense_clarification": "riferito a un'esperienza che assorbe totalmente"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4e690555-d6aa-3d30-bfd6-847ed893e40b",
                    "sense_definition": "A collection of rivets used to fasten materials together.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fastening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bridge's <w>riveting</w> was inspected for signs of rust and wear.",
                            "target_lang_translations": {
                                "it": "La <w>rivettatura</w> del ponte è stata ispezionata per cercare segni di ruggine e usura."
                            }
                        },
                        {
                            "text": "Workers checked the <w>riveting</w> on the steel beams to ensure structural safety.",
                            "target_lang_translations": {
                                "it": "Gli operai hanno controllato la <w>rivettatura</w> sulle travi d'acciaio per garantire la sicurezza strutturale."
                            }
                        }
                    ],
                    "common_phrases": [
                        "steel riveting"
                    ],
                    "target_lang_definitions": {
                        "it": "Insieme di rivetti utilizzati per fissare materiali tra loro."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "rivettatura",
                                "target_lang_sense_clarification": "riferito all'insieme dei rivetti o al lavoro di fissaggio"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e54fe02b-9136-3fd6-99ba-449cdf0845ac",
                    "sense_definition": "The process of joining metal parts using rivets.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fastening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>riveting</w> of the ship's hull took several weeks to complete.",
                            "target_lang_translations": {
                                "it": "La <w>rivettatura</w> dello scafo della nave ha richiesto diverse settimane per essere completata."
                            }
                        },
                        {
                            "text": "Modern construction methods have largely replaced traditional <w>riveting</w>.",
                            "target_lang_translations": {
                                "it": "I moderni metodi di costruzione hanno ampiamente sostituito la tradizionale <w>rivettatura</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "fastening"
                    ],
                    "common_phrases": [
                        "metal riveting"
                    ],
                    "target_lang_definitions": {
                        "it": "Il processo di unione di parti metalliche mediante l'uso di rivetti."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "rivettatura",
                                "target_lang_sense_clarification": "riferito all'operazione tecnica di fissaggio"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1722bef9-25c6-3fcd-bf96-03dc66083963",
                    "sense_definition": "Present participle and gerund of <w>rivet</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fastening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the entire afternoon <w>riveting</w> the metal plates together.",
                            "target_lang_translations": {
                                "it": "Ha passato l'intero pomeriggio a <w>rivettare</w> insieme le piastre metalliche."
                            }
                        },
                        {
                            "text": "The sound of <w>riveting</w> echoed through the factory all day long.",
                            "target_lang_translations": {
                                "it": "Il rumore della <w>rivettatura</w> ha riecheggiato in tutta la fabbrica per tutto il giorno."
                            }
                        }
                    ],
                    "common_phrases": [
                        "riveting metal"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb rivet."
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Participio presente e gerundio del verbo rivettare."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "rivettando",
                                "target_lang_sense_clarification": "gerundio del verbo rivettare"
                            },
                            {
                                "target_lang_word": "rivettante",
                                "target_lang_sense_clarification": "participio presente del verbo rivettare"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}