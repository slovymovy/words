                    },
                    {
                        "translation_id": "f79e41ce-41eb-4dc5-88a0-89af9655e303",
                        "source_entry_id": "af1feb9b-8187-3492-9422-e7111eb2f861",
                        "source_sense_description": "to translate into French",
                        "target_lang_word": "franciser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "franciser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7408332b-b1d2-3170-9a3a-1c495606fd62",
                                        "entry_id": "7225432e-c115-30ae-938f-04454094ddfb",
                                        "glosses": [
                                            "Modifier un mot d’une langue étrangère dans sa graphie ou dans sa prononciation, de manière qu’il ait les apparences d’un mot français."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aaca5384-ccec-4711-a43f-c4d4ea14f065",
                                                "sense_id": "7408332b-b1d2-3170-9a3a-1c495606fd62",
                                                "text": "Je ne suis pas ici pour les demi-mesures. Pour ce qui est de la francisation des mots grecs, quelques-uns disent : « On pourrait franciser les mots usuels et conserver grécoïdes les mots savants »."
                                            },
                                            {
                                                "example_id": "180ab7e8-165e-4e2c-b5f5-7f13bca12562",
                                                "sense_id": "7408332b-b1d2-3170-9a3a-1c495606fd62",
                                                "text": "« CD-Rom » peut être francisé en « cédérom »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d9aa9c8-c73d-30d1-bc23-969c08c847b1",
                                        "entry_id": "7225432e-c115-30ae-938f-04454094ddfb",
                                        "glosses": [
                                            "Donner un air, une apparence française aux personnes ou aux objets."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba859054-c581-45e4-bcdf-f1b993233040",
                                                "sense_id": "5d9aa9c8-c73d-30d1-bc23-969c08c847b1",
                                                "text": "On a reproché à Racine d’avoir francisé les héros de l’Antiquité."
                                            },
                                            {
                                                "example_id": "5cb4be32-66e4-47be-acb1-40a577c84a9a",
                                                "sense_id": "5d9aa9c8-c73d-30d1-bc23-969c08c847b1",
                                                "text": "Ce restaurant anglais a francisé son « fish and chips » en l’appelant « poisson-frites »."
                                            },
                                            {
                                                "example_id": "2e6da660-e297-4960-b06d-a3386c00e82f",
                                                "sense_id": "5d9aa9c8-c73d-30d1-bc23-969c08c847b1",
                                                "text": "80 % de dossiers sont ceux de descendants de migrants, avec un ou deux parents nés à l'étranger. Ils entendent franciser leur prénom pour une meilleure intégration."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aba4b328-088d-360c-ae14-7e1083c82131",
                                        "entry_id": "7225432e-c115-30ae-938f-04454094ddfb",
                                        "glosses": [
                                            "Changer (une personne ou un peuple) pour lui donner les caractéristiques du peuple français (langue, religion, culture, comportement)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62bf2e1a-e986-4676-9573-b87493d179c6",
                                                "sense_id": "aba4b328-088d-360c-ae14-7e1083c82131",
                                                "text": "Pour accroître rapidement la population de la colonie, les Jésuites encouragèrent même les mariages entre Amérindiens francisés et les Français."
                                            },
                                            {
                                                "example_id": "77285e5b-7143-4dd7-8439-a559a99488bb",
                                                "sense_id": "aba4b328-088d-360c-ae14-7e1083c82131",
                                                "text": "La condition sociale s'est progressivement améliorée et le métier s’est francisé (pour partie en accordant la nationalité française à des immigrés). L'éboueur n'est plus véritablement un manœuvre de force, même si le métier reste difficile."
                                            },
                                            {
                                                "example_id": "82dcb800-5f1d-467c-aee3-55622a7e48b5",
                                                "sense_id": "aba4b328-088d-360c-ae14-7e1083c82131",
                                                "text": "La formation des Alouettes s’est francisée depuis que le football a gagné en popularité dans les université, les collèges et les écoles secondaires au Québec."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0e5251a-319a-3fb7-aa7c-31616ece2ca4",
                                        "entry_id": "7225432e-c115-30ae-938f-04454094ddfb",
                                        "glosses": [
                                            "Faire adopter la langue française ou la favoriser."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1fdc2376-5149-35f0-950e-9291a7694b82",
                                        "entry_id": "7225432e-c115-30ae-938f-04454094ddfb",
                                        "glosses": [
                                            "Donner la nationalité française."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3336cccb-3672-41e3-96b5-887ebda0eec3",
                                                "sense_id": "1fdc2376-5149-35f0-950e-9291a7694b82",
                                                "text": "Né à Puget-Théniers (Alpes-Maritimes), Blanqui est d'origine italienne, sa famille avait été francisée par l’annexion du comté de Nice en 1792."
                                            },
                                            {
                                                "example_id": "10a7063c-96cd-4747-9991-e39d0d0c3e7e",
                                                "sense_id": "1fdc2376-5149-35f0-950e-9291a7694b82",
                                                "text": "I. - Pour être francisé, un navire armé au commerce ou à la plaisance, […], doit répondre aux conditions suivantes : […]."
                                            }
                                        ]
                                    }
                                ]
                            }
