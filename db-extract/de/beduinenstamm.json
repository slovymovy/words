                        "tags": [],
                        "examples": [
                            {
                                "example_id": "826369fd-0be1-45d6-ad0a-b5e7ff3e5b8e",
                                "sense_id": "bdc0241a-ffdb-36c2-bd6f-c7cc6008c9a4",
                                "text": "„Jizchak Ben Zwi, ein bekannter Zionist, machte einen Beduinenstamm in Galiläa ausfindig, der zum Judentum übertreten wollte, und drängte Oberst Kisch, die Sache in die Hand zu nehmen.“"
                            },
                            {
                                "example_id": "e79237c9-22e3-4a0b-b923-08ed7507b942",
                                "sense_id": "bdc0241a-ffdb-36c2-bd6f-c7cc6008c9a4",
                                "text": "„Nach Danins Bericht waren das die einzigen von ihnen beobachteten Fälle, dass Palästinenser das UN-designierte jüdische Staatsgebiet verlassen hatten, abgesehen von einigen Beduinenstämmen, die aus Angst vor jüdischen Angriffen näher an arabische Ortschaften gezogen waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
