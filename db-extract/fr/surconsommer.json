                ],
                "senses": [
                    {
                        "sense_id": "ac8502e7-4cb0-37d9-9940-857a1e14121a",
                        "entry_id": "37ec3538-68fa-33e8-9710-3aef359a39ff",
                        "glosses": [
                            "Consommer plus que la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f005b26-0dba-417f-aaab-f3073adf3bd1",
                                "sense_id": "ac8502e7-4cb0-37d9-9940-857a1e14121a",
                                "text": "De même qu'on peut nous inciter à surconsommer de l'électricité, on nous incite à surconsommer de l'informatique ou d'autres produits."
                            },
                            {
                                "example_id": "5e62861a-f059-401b-b151-bfccd9bcfbd5",
                                "sense_id": "ac8502e7-4cb0-37d9-9940-857a1e14121a",
                                "text": "Les États-Unis viennent de perdre 10 ans à surconsommer et à faire de leur société comme de leur économie un énorme casino."
                            },
                            {
                                "example_id": "033451e5-40be-4995-8e5b-1a91990bb57f",
                                "sense_id": "ac8502e7-4cb0-37d9-9940-857a1e14121a",
                                "text": "Réduire les déséquilibres fondamentaux de l’économie mondiale entre des pays qui surconsomment et des pays qui surépargnent."
                            }
                        ]
                    }
