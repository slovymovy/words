{
    "word": "chairmanship",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "aad1108a-4e28-3462-abf7-71f8ad9af87a",
                "word": "chairmanship",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8aec0cc4-c80d-4abd-9ea4-f806a8bd4028",
                        "entry_id": "aad1108a-4e28-3462-abf7-71f8ad9af87a",
                        "tags": [
                            "plural"
                        ],
                        "form": "chairmanships"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b735dafd-a721-339e-a5c7-e2a375ba798f",
                        "entry_id": "aad1108a-4e28-3462-abf7-71f8ad9af87a",
                        "glosses": [
                            "The office, or the term, of a chairman."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8abd3325-6464-40dc-b25d-b7e70c940e93",
                                "sense_id": "b735dafd-a721-339e-a5c7-e2a375ba798f",
                                "text": "Afterwards, Sir Eardly Wilmot had been appointed, from whom, on account of his long chairmanship of quarter-sessions, much had reasonably been expected."
                            },
                            {
                                "example_id": "5426d424-3ae5-4b53-be16-45256e0da4e0",
                                "sense_id": "b735dafd-a721-339e-a5c7-e2a375ba798f",
                                "text": "The resignation of Sir Eustace Missenden from the chairmanship of the Railway Executive was announced by the Minister of Transport at Christmas."
                            },
                            {
                                "example_id": "669015c5-7d7b-4e48-a989-f127e15d96f9",
                                "sense_id": "b735dafd-a721-339e-a5c7-e2a375ba798f",
                                "text": "To particularise the railway improvements required by the County of London Plan, 1943, a Committee under the Chairmanship of Professor Sir Charles Inglis was appointed in February, 1944, by the Minister of War Transport."
                            },
                            {
                                "example_id": "22a27210-79d1-4934-83df-411cb3fd9fca",
                                "sense_id": "b735dafd-a721-339e-a5c7-e2a375ba798f",
                                "text": "Nixon proposed the establishment of an Aviation Industry Consultative Council under the chairmanship of the permanent head of his department […]"
                            },
                            {
                                "example_id": "f77789cb-931d-411e-8250-8f40ad110514",
                                "sense_id": "b735dafd-a721-339e-a5c7-e2a375ba798f",
                                "text": "Having put partisan interests to one side, Greenwood set about making teamwork a watchword for her chairmanship, while seeking the broadest possible participation in subsequent inquiries."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5536b14-7db3-426b-8212-8c28e82aeda0",
                        "source_entry_id": "aad1108a-4e28-3462-abf7-71f8ad9af87a",
                        "source_sense_id": "b735dafd-a721-339e-a5c7-e2a375ba798f",
                        "source_sense_description": "office or term of a chairman",
                        "target_lang_word": "předsednictví",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "11dd297c-ce64-48e3-8549-4b6901305b56",
                        "source_entry_id": "aad1108a-4e28-3462-abf7-71f8ad9af87a",
                        "source_sense_id": "b735dafd-a721-339e-a5c7-e2a375ba798f",
                        "source_sense_description": "office or term of a chairman",
                        "target_lang_word": "présidence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "présidence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c0614b6e-7c75-3450-9679-cfb245919da2",
                                        "entry_id": "7ffa1544-e80b-3a4a-b10e-e5c81252bc1c",
                                        "glosses": [
                                            "Fonction de président ou de présidente, droit d’exercer cette fonction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73fa9a6a-0f9f-45ea-87e5-d5a1714bf1ba",
                                                "sense_id": "c0614b6e-7c75-3450-9679-cfb245919da2",
                                                "text": "Il a été nommé à la présidence de cette assemblée."
                                            },
                                            {
                                                "example_id": "8c44f3dc-234f-4f01-a291-bd443ab041bf",
                                                "sense_id": "c0614b6e-7c75-3450-9679-cfb245919da2",
                                                "text": "C’est lui qui a la présidence dans ce conseil d’administration."
                                            },
                                            {
                                                "example_id": "edb54aaf-2ad9-43f9-8596-500a755620ff",
                                                "sense_id": "c0614b6e-7c75-3450-9679-cfb245919da2",
                                                "text": "La présidence du Sénat, de la Chambre des députés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e3e298b-1343-38b4-9f9b-057f2a80cf92",
                                        "entry_id": "7ffa1544-e80b-3a4a-b10e-e5c81252bc1c",
                                        "glosses": [
                                            "Fonction du chef d’État, dans les républiques."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39b01e40-0d23-4d3b-9f99-5d8363aa821e",
                                                "sense_id": "8e3e298b-1343-38b4-9f9b-057f2a80cf92",
                                                "text": "L’expérience a prouvé que la présidence de la République n’était pas une institution mais une complication, ce n’est pas une garantie, mais un péril."
                                            },
                                            {
                                                "example_id": "0d1ed0ea-2f41-47cb-b746-11628c813148",
                                                "sense_id": "8e3e298b-1343-38b4-9f9b-057f2a80cf92",
                                                "text": "Mais ce n’est là qu’une frime. Au fond, Grévy a pris le goût de l’Élysée ; il n’est pas insensible à la gloriole et aux menus avantages matériels de la présidence."
                                            },
                                            {
                                                "example_id": "8d65fa66-c19c-4af2-baed-37c9ad4ab8ac",
                                                "sense_id": "8e3e298b-1343-38b4-9f9b-057f2a80cf92",
                                                "text": "Élu à 48 ans à la présidence de la République, l’ancien maire de Chamalières (Puy-de-Dôme) incarna la modernité, le temps d’un unique mandat. Il est mort ce mercredi du Covid à l’âge de 94 ans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e85c7b2-3d50-34bc-b894-e78946fdb345",
                                        "entry_id": "7ffa1544-e80b-3a4a-b10e-e5c81252bc1c",
                                        "glosses": [
                                            "Place du président."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4779bc16-5485-42b0-a4db-2af30da9fabe",
                                                "sense_id": "7e85c7b2-3d50-34bc-b894-e78946fdb345",
                                                "text": "La première présidence de la cour d’appel est vacante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a8c7107-888c-3154-8396-b08e05136f32",
                                        "entry_id": "7ffa1544-e80b-3a4a-b10e-e5c81252bc1c",
                                        "glosses": [
                                            "Temps pendant lequel une personne exerce les fonctions de président."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e14365f6-9439-4718-9bd6-42531eb6fb57",
                                                "sense_id": "4a8c7107-888c-3154-8396-b08e05136f32",
                                                "text": "Cet arrêt a été rendu sous la présidence d’un tel."
                                            },
                                            {
                                                "example_id": "6114dfd6-cf48-401a-9847-231b157c47e4",
                                                "sense_id": "4a8c7107-888c-3154-8396-b08e05136f32",
                                                "text": "Cet événement est arrivé sous votre présidence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c06f4da3-14ba-3acb-bd23-8835f349bb96",
                                        "entry_id": "7ffa1544-e80b-3a4a-b10e-e5c81252bc1c",
                                        "glosses": [
                                            "Résidence du président."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06420f37-fb99-4d0f-9067-d429684dfa00",
                                                "sense_id": "c06f4da3-14ba-3acb-bd23-8835f349bb96",
                                                "text": "Il s’est rendu à la présidence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
