                                                "sense_id": "26b1eaf6-5b3a-378f-b4e0-ed7964235f0a",
                                                "text": "Oknem v mém pokoji vidím sousedům až do kuchyně."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec949ad8-9150-3363-92a8-2ebc4b4010cc",
                                        "entry_id": "3f196249-060e-3311-a1b5-a419d4670468",
