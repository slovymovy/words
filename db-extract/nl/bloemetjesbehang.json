                        "examples": [
                            {
                                "example_id": "21f9fb11-ba7a-4ef2-b61a-8f7891cae1b6",
                                "sense_id": "a5d135bb-1df1-3f27-b37b-7636afad0678",
                                "text": "Conran richtte zich vooral op jonge Britten, die in tegenstelling tot hun ouders niet meer één bank of kast voor de rest van hun leven wilden hebben en uitgekeken waren op bloemetjesbehang en massief eiken meubilair. Hun verkocht hij strakke ontwerpen in felle kleuren. \"Goed design verbetert de kwaliteit van leven.\""
                            },
                            {
                                "example_id": "a3d281c5-cf1d-4bc7-a931-1d2d307f5641",
                                "sense_id": "a5d135bb-1df1-3f27-b37b-7636afad0678",
                                "text": "In de woonkamer in het verpleeghuis staan donkerbruine houten meubelen. Rode velours gordijnen omlijsten het raam. Aan de muur een koekoeksklok en bloemetjesbehang. Een bewuste keuze, want voor de bewoners draagt het bij aan hun psychische gezondheid."
                            }
                        ]
                    }
