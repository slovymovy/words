                        "glosses": [
                            "зажарить слишком сильно, больше, чем нужно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "513391e1-ce40-4590-b07b-292a5bb5920c",
                                "sense_id": "8d09123c-7631-3d69-a315-c091ecf2ee11",
                                "text": "Пережарить мясо."
                            },
                            {
                                "example_id": "662d3adb-330a-42fd-94e9-c38dcb0d8eab",
                                "sense_id": "8d09123c-7631-3d69-a315-c091ecf2ee11",
                                "text": "Пережарить рыбу."
                            }
                        ]
                    },
                    {
                        "sense_id": "49579add-c11b-3149-813c-716159d2f335",
                        "entry_id": "048a1f45-c309-3b0a-8f51-7ef503784e05",
                        "glosses": [
                            "разг. изжарить всё, многое"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cb91522-d4d5-4d30-9c16-7388e94ccdb0",
                                "sense_id": "49579add-c11b-3149-813c-716159d2f335",
                                "text": "Пережарить все котлеты."
                            }
                        ]
                    },
                    {
                        "sense_id": "fc523c5c-e2c2-3f02-a2a2-57531e229885",
                        "entry_id": "048a1f45-c309-3b0a-8f51-7ef503784e05",
                        "glosses": [
                            "разг. поджарить заново, ещё раз"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17582820-57f2-4ebe-a107-b2702fc16005",
                                "sense_id": "fc523c5c-e2c2-3f02-a2a2-57531e229885",
                                "text": "Иван предложил пережарить оставшееся со вчерашнего обеда жаркое."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1ff6299-9acf-4a2a-a85b-e02a4f2c50af",
                        "source_entry_id": "048a1f45-c309-3b0a-8f51-7ef503784e05",
                        "source_sense_description": "зажарить слишком сильно, больше, чем нужно",
                        "target_lang_word": "overdo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overdo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7b35a9bc-b443-3928-9668-c2640d33a89e",
                                        "entry_id": "218aca71-3db5-32e9-8f2c-233c1da34265",
                                        "glosses": [
                                            "To do too much; to exceed what is proper or true in doing; to carry too far."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f11f240-ddec-4676-a896-22956768b08d",
                                                "sense_id": "7b35a9bc-b443-3928-9668-c2640d33a89e",
                                                "text": "I overdid the sweets during the holidays and put on some weight."
                                            },
                                            {
                                                "example_id": "397e7150-4016-47b7-9cac-d75f71aa33a2",
                                                "sense_id": "7b35a9bc-b443-3928-9668-c2640d33a89e",
                                                "text": "[…] o’erstep not the modesty of nature: for anything so overdone is from the purpose of playing, whose end […] is to hold, as ’twere, the mirror up to nature;"
                                            },
                                            {
                                                "example_id": "1764935e-9a85-41e1-86ce-9311bf1cc2b0",
                                                "sense_id": "7b35a9bc-b443-3928-9668-c2640d33a89e",
                                                "text": "[B]elieve me, / That servant overdoes, that’s too officious; / And in presuming to direct your master, / You argue him of weakness, and your self / Of arrogance and impertinence."
                                            },
                                            {
                                                "example_id": "92906ca4-6abf-4125-a845-5bafdea4d882",
                                                "sense_id": "7b35a9bc-b443-3928-9668-c2640d33a89e",
                                                "text": "The merchant importers […] endeavour, as well as they can, to suit their occasional importations to what, they judge, is likely to be the immediate demand. With all their attention, however, they sometimes over-do the business, and sometimes under-do it."
                                            },
                                            {
                                                "example_id": "29485395-5fac-423b-b25b-b5a1058df23b",
                                                "sense_id": "7b35a9bc-b443-3928-9668-c2640d33a89e",
                                                "text": "Jo helps me with the sewing, and insists on doing all sorts of hard jobs. I should be afraid she might overdo, if I didn’t know her ‘moral fit’ wouldn’t last long."
                                            },
                                            {
                                                "example_id": "11b576f7-0c96-40a1-8bcb-0d2278ad8e32",
                                                "sense_id": "7b35a9bc-b443-3928-9668-c2640d33a89e",
                                                "text": "Carol had overdone the ventilation and the room was cold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aac031c0-55f4-3de1-8889-7d96b6e8aa1e",
                                        "entry_id": "218aca71-3db5-32e9-8f2c-233c1da34265",
                                        "glosses": [
                                            "To cook for too long."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69ebede7-75f2-4942-9b0d-bd75046e3b5b",
                                                "sense_id": "aac031c0-55f4-3de1-8889-7d96b6e8aa1e",
                                                "text": "to overdo the meat"
                                            },
                                            {
                                                "example_id": "87c19ff0-07fe-4f8a-9ea3-1e8afc71b4b1",
                                                "sense_id": "aac031c0-55f4-3de1-8889-7d96b6e8aa1e",
                                                "text": "[He] talked of a feast where he had been the day before, but that the venison was over-done."
                                            },
                                            {
                                                "example_id": "184a6f09-9e96-4e74-893b-7ab46a004cb4",
                                                "sense_id": "aac031c0-55f4-3de1-8889-7d96b6e8aa1e",
                                                "text": "Well, for the future, when you cook another whale-steak for my private table here, the capstan, I’ll tell you what to do so as not to spoil it by overdoing. Hold the steak in one hand, and show a live coal to it with the other; that done, dish it; d’ye hear?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e604450-ae80-3694-923b-d0181fbe2d15",
                                        "entry_id": "218aca71-3db5-32e9-8f2c-233c1da34265",
                                        "glosses": [
                                            "To give (someone or something) too much work; to require too much effort or strength of (someone); to use up too much of (something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbc579c1-8d99-4999-b888-49a6f87e5db2",
                                                "sense_id": "5e604450-ae80-3694-923b-d0181fbe2d15",
                                                "text": "to overdo one’s strength"
                                            },
                                            {
                                                "example_id": "46e3faef-1b94-4387-9a41-dabd798f435a",
                                                "sense_id": "5e604450-ae80-3694-923b-d0181fbe2d15",
                                                "text": "Good God! hovv poore a thing is vvretched man? / So fraile, that let him ſtriue the beſt he can, / VVith euery little blaſt hee’s ouerdon."
                                            },
                                            {
                                                "example_id": "07b59580-303d-4405-bd54-866d8698abba",
                                                "sense_id": "5e604450-ae80-3694-923b-d0181fbe2d15",
                                                "text": "And you’re so weak I’le not pursue you,\nFor fear lest I should overdo you."
                                            },
                                            {
                                                "example_id": "2768f9b3-347e-4573-add6-a0d62e25b01f",
                                                "sense_id": "5e604450-ae80-3694-923b-d0181fbe2d15",
                                                "text": "[…] look abroad and see who are the people that complain of weariness, listlessness, and dejection? You will not find them among such as are overdone with work, but with pleasure."
                                            },
                                            {
                                                "example_id": "b35e2050-cdd0-4f0b-a079-9daa6ce9f0f5",
                                                "sense_id": "5e604450-ae80-3694-923b-d0181fbe2d15",
                                                "text": "“Bern, you’re weak—trembling—you talk wildly,” cried Bess. “You’ve overdone your strength. [...]”"
                                            },
                                            {
                                                "example_id": "45283778-8354-4bf9-8dd3-5dcad439a076",
                                                "sense_id": "5e604450-ae80-3694-923b-d0181fbe2d15",
                                                "text": "“Oh!” said Mrs. Venables, “how tiresome it all is. I’m sure you’ll wear your brains right out with all these problems. You mustn’t overdo yourself. [...]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc7e576e-8d26-3e53-b419-d8453a20a97c",
                                        "entry_id": "218aca71-3db5-32e9-8f2c-233c1da34265",
                                        "glosses": [
                                            "To do more than (someone); to do (something) to a greater extent."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad49e21f-ff5c-474d-af85-f8ffa98056b3",
                                                "sense_id": "fc7e576e-8d26-3e53-b419-d8453a20a97c",
                                                "text": "In a delicate Garden, where Art hath shewed it’s vtmost, yee shall meet with Roses, Gillyflowers, and Fountaines of Alabaster and Iasper; but thou wilt not so much admire this, as if thou shouldst light on these dainties in a Desert, or in some craggie Mountain, where the hand of nature shall ouerdoe that of art and Industrie."
                                            },
                                            {
                                                "example_id": "042c73a6-8fc5-4d70-bddf-fefc8afebce0",
                                                "sense_id": "fc7e576e-8d26-3e53-b419-d8453a20a97c",
                                                "text": "[...] it would be their shame for ever to be overdone in mischiefe, nor were they here exceeded."
                                            },
                                            {
                                                "example_id": "b059d3df-0e08-4145-a429-29c57a346dbd",
                                                "sense_id": "fc7e576e-8d26-3e53-b419-d8453a20a97c",
                                                "text": "the Turks delight but little in the outward Ornament of Houses, nor aspire in the least to overdo each other in the Europaean Custom of Polite and Solid Architecture, yet do they far more exceed us in the rich Ornaments and Contrivances of their Pavilions,"
                                            },
                                            {
                                                "example_id": "ae3c9cb0-0e87-4ece-907d-71897fed7870",
                                                "sense_id": "fc7e576e-8d26-3e53-b419-d8453a20a97c",
                                                "text": "But in the field were Lancelot’s kith and kin, […] / Strong men, and wrathful that a stranger knight / Should do and almost overdo the deeds / Of Lancelot;"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8fa9bb75-e50d-48ed-8095-74e10d685cdb",
                        "source_entry_id": "048a1f45-c309-3b0a-8f51-7ef503784e05",
                        "source_sense_description": "зажарить слишком сильно, больше, чем нужно",
                        "target_lang_word": "overroast",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overroast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30e394bd-a361-344f-a25b-132cfebcaa8d",
                                        "entry_id": "d19df91f-094d-344b-af60-e5f1b23bbf07",
                                        "glosses": [
                                            "To roast too much."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1623db1b-d185-4fd2-8ac2-e1166a2ab981",
                                                "sense_id": "30e394bd-a361-344f-a25b-132cfebcaa8d",
                                                "text": "But now cuppings at independent cafes like Joe attract connoisseurs who wouldn’t be caught dead sipping an overroasted blend and regularly travel to another borough for superior beans."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca2aea0a-6034-45a9-b671-e8ea74b1b429",
                        "source_entry_id": "048a1f45-c309-3b0a-8f51-7ef503784e05",
                        "source_sense_description": "поджарить заново, ещё раз",
                        "target_lang_word": "reroast",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reroast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d0e789a-2e76-36f1-a7e5-a98f845866e3",
                                        "entry_id": "0820da88-cdbb-3cf3-bfee-d0a8e2fb3501",
                                        "glosses": [
                                            "To roast again."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42cc2ad6-a261-4247-b026-1902b4b99be1",
                                                "sense_id": "4d0e789a-2e76-36f1-a7e5-a98f845866e3",
                                                "text": "He spent a year and a half with older survivors as a hooligan and black marketeer in the American occupation zone of Germany, living high for revenge, riding a BMW motorcycle, selling Lucky Strikes and used coffee grounds stolen from the kitchens of the American occupying troops, reroasted and repackaged for the Germans."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
