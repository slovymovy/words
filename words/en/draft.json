                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5890c286-e941-33b4-aa2a-78b0ef8ee0c3",
                    "sense_definition": "To prepare a preliminary version of a document, letter, or plan.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "writing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer will <w>draft</w> a contract for the new business partnership.",
                            "target_lang_translations": {
                                "ru": "Юрист <w>составит проект</w> контракта для нового делового партнерства."
                            }
                        },
                        {
                            "text": "I need to <w>draft</w> an email to my boss explaining the situation.",
                            "target_lang_translations": {
                                "ru": "Мне нужно <w>набросать</w> письмо моему боссу с объяснением ситуации."
                            }
