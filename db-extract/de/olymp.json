                ],
                "translations": [
                    {
                        "translation_id": "7300af38-e712-466e-bb33-9df8a9226757",
                        "source_entry_id": "18fc4ace-1997-3794-97e0-a39efcf3e8f1",
                        "source_sense_id": "554e7ba4-7c49-3af4-a2ae-b7c8c71733b2",
                        "source_sense_description": "Geografie, Griechenland: höchstes Gebirge Griechenlands",
                        "target_lang_word": "Olympus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Olympus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b8cb0c0f-1270-3cda-81b3-bcb3a4b7f482",
                                        "entry_id": "fac61ccd-3e5b-3686-943d-e57334e7e28c",
                                        "glosses": [
                                            "The highest mountain in Greece; in Ancient Greek mythology the home of the gods."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fec39cd9-617f-452b-9e55-3a1a468f4ead",
                                                "sense_id": "b8cb0c0f-1270-3cda-81b3-bcb3a4b7f482",
                                                "text": "Sleeping-car passengers, however, will know little of their entry into Greece until, at 6 a.m. on the third morning after leaving Paris, the short train runs over the Vardar plain, with dawn glimpses of Mount Athos to the east and of cloud-capped Olympus across the gulf to the south, past the rebuilt yard and into the new passenger station at Salonica."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "abab97ed-7436-4533-a3ad-74f828d5cb4e",
                        "source_entry_id": "18fc4ace-1997-3794-97e0-a39efcf3e8f1",
                        "source_sense_id": "554e7ba4-7c49-3af4-a2ae-b7c8c71733b2",
                        "source_sense_description": "Geografie, Griechenland: höchstes Gebirge Griechenlands",
                        "target_lang_word": "Olympe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Olympe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3ff898d9-bcea-35c6-a130-b5c886b6d31c",
                                        "entry_id": "4a1fde57-8654-37b8-922e-050b4de19cbb",
                                        "glosses": [
                                            "Chaîne de montagnes grecque, près de la mer Égée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4df1e069-9381-4441-b452-09c95a35d2d4",
                                                "sense_id": "3ff898d9-bcea-35c6-a130-b5c886b6d31c",
                                                "text": "L’Olympe est située entre la Macédoine et la Thessalie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46dd911d-bf06-34c9-bee2-bb5b4818368b",
                                        "entry_id": "4a1fde57-8654-37b8-922e-050b4de19cbb",
                                        "glosses": [
                                            "Chaîne de montagnes grecque, près de la mer Égée.",
                                            "La plus haute montagne de cette chaîne (2917 mètres)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9cc467be-5f21-3090-bd87-0d7647c95810",
                                        "entry_id": "4a1fde57-8654-37b8-922e-050b4de19cbb",
                                        "glosses": [
                                            "Dans la mythologie grecque, royaume des dieux situé sur cette montagne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd839381-f4df-4235-a076-5d17d6ac8137",
                                                "sense_id": "9cc467be-5f21-3090-bd87-0d7647c95810",
                                                "text": "Il s'avançait, précédé d'un escadron de mousquetaires Louis XIII, montés sur des chevaux de troupe, et suivi par un char monumental qui portait tous les dieux de l’Olympe, y compris le Temps, armé de la faux classique."
                                            },
                                            {
                                                "example_id": "3edfbc47-ddd8-4157-b1db-dbd40a2e390d",
                                                "sense_id": "9cc467be-5f21-3090-bd87-0d7647c95810",
                                                "text": "Les travaux imposés à Hercule tendent soit à le faire échouer, auxquels cas il meurt, et il n’est plus un dieu (puisque n’étant pas immortel et invincible) soit à le faire triompher, auxquels cas il est un véritable dieu et rejoint l’Olympe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40a5225f-8072-3aec-af86-675e500bc496",
                                        "entry_id": "4a1fde57-8654-37b8-922e-050b4de19cbb",
                                        "glosses": [
                                            "Nom de dix-huit autres montagnes de Grèce antique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7e740b8b-6007-325a-919c-50b73ad73a5d",
                                        "entry_id": "4a1fde57-8654-37b8-922e-050b4de19cbb",
                                        "glosses": [
                                            "Nom de montagnes de France (département des Bouches-du-Rhône, 819 mètres), de Chypre (point culminant de l’île, 1952 m), de Turquie (dont le point culminant de Turquie occidentale, 2543 m), de Nouvelle-Zélande (2096 m) et des États-Unis (Utah (2751 m) et État de Washington (2432 m))."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dc47d9d1-2049-3f67-ad42-659cb04168c2",
                                        "entry_id": "4a1fde57-8654-37b8-922e-050b4de19cbb",
                                        "glosses": [
                                            "La plus haute montagne de la planète Mars (21 229 m) et possiblement de tout le système solaire."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8300a900-e9e2-325a-b34c-202113effd36",
                                        "entry_id": "4a1fde57-8654-37b8-922e-050b4de19cbb",
                                        "glosses": [
                                            "Lieu ou position difficilement accessible."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34a2b4f9-442f-466f-8f9d-19318163cc37",
                                                "sense_id": "8300a900-e9e2-325a-b34c-202113effd36",
                                                "text": "En revanche, le déroulement des carrières est substantiellement revu. Il faudra avoir fait ses preuves plusieurs années sur le terrain avant de pouvoir prétendre rejoindre l’Olympe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Olympe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "abe77b97-f8f3-34ac-af6f-cf8cad0ca35f",
                                        "entry_id": "02302e82-08dc-3a2e-8602-1e5ea25a48ba",
                                        "glosses": [
                                            "Prénom mixte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e8eb46f-1557-4a0b-8542-de0feb83ac4f",
                                                "sense_id": "abe77b97-f8f3-34ac-af6f-cf8cad0ca35f",
                                                "text": "Olympe, entrant chez la boulangère-pâtissière, suscita un certain remous parmi les clientes."
                                            },
                                            {
                                                "example_id": "b2c527df-9a41-4897-a542-487e02162665",
                                                "sense_id": "abe77b97-f8f3-34ac-af6f-cf8cad0ca35f",
                                                "text": "L’une d’entre elles émit cette remarque qu’Olympe était faible et avait besoin de prendre des fortifications. Une fille à tout faire lui monta donc un potage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
