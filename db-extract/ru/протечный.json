                    {
                        "form_id": "a0b62f27-50b3-4ecd-8797-2a6dbcd360bd",
                        "entry_id": "f7cc9321-5a8d-31ee-a138-778c83cc1021",
                        "tags": [
                            "comparative"
                        ],
                        "form": "проте́чнее"
                    },
                    {
                        "form_id": "9a7e9adc-68ef-452a-a1c0-e51ded445e2e",
                        "entry_id": "f7cc9321-5a8d-31ee-a138-778c83cc1021",
                        "tags": [
