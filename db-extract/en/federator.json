                "senses": [
                    {
                        "sense_id": "8b68e4d9-a04d-35ba-be61-5f602af0cecf",
                        "entry_id": "9339c2a1-bea5-3722-ad1a-3792c63398e8",
                        "glosses": [
                            "Someone or something that is instrumental in the creation of a federation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1966904-d1da-4020-9d86-abf04c76d30b",
                                "sense_id": "8b68e4d9-a04d-35ba-be61-5f602af0cecf",
                                "text": "Its power as an element of character, as an inspiration in art, as a federator of nations and factor of history, is freely admitted; and no place that it can fairly claim in the genesis of society and the regulation of life is denied to it."
                            },
                            {
                                "example_id": "0ba8786e-7d79-4fcf-b6f6-7c3448a25741",
                                "sense_id": "8b68e4d9-a04d-35ba-be61-5f602af0cecf",
                                "text": "There would perhaps be a federator, but it would not be European."
                            },
                            {
                                "example_id": "5fbc0207-b722-4b1c-a805-e6abb30d7e20",
                                "sense_id": "8b68e4d9-a04d-35ba-be61-5f602af0cecf",
                                "text": "He called the US, “the unwanted federator of an integrated Europe.”"
                            },
                            {
                                "example_id": "d28f8c18-ff2a-4b4f-8e97-d7304d7f3c3c",
                                "sense_id": "8b68e4d9-a04d-35ba-be61-5f602af0cecf",
                                "text": "The following is a synopsis of the appeal to the people which the prince actually prepared for broadcast over Radio Algiers: He came forward as the federator of French energies."
                            }
                        ]
                    },
                    {
                        "sense_id": "bc9ccfb3-4a5b-35c1-b9c0-ae524c9f864e",
                        "entry_id": "9339c2a1-bea5-3722-ad1a-3792c63398e8",
                        "glosses": [
                            "A component that integrates access to various services."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32b02cca-e200-493a-a49e-d00eb71eabee",
                                "sense_id": "bc9ccfb3-4a5b-35c1-b9c0-ae524c9f864e",
                                "text": "Our extended standard GIS web Service components are integrated into the system through a federator, which is actually a WMS that is extended with capability-aggregating and stateful service capabilities to enable high performance support for responsive GIS applications."
                            },
                            {
                                "example_id": "01c21701-3990-4484-b27a-55d1f40986ea",
                                "sense_id": "bc9ccfb3-4a5b-35c1-b9c0-ae524c9f864e",
                                "text": "The results of the crawler, the administrative components, and the federator are stored in a database."
                            },
                            {
                                "example_id": "499fcc53-76d3-48ce-9a6d-f62fd68ee62d",
                                "sense_id": "bc9ccfb3-4a5b-35c1-b9c0-ae524c9f864e",
                                "text": "The federator now can implement logic that determines where the data is placed."
                            }
                        ]
                    }
