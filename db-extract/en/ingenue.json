                    }
                ],
                "senses": [
                    {
                        "sense_id": "b6472635-f345-3445-9def-ab2f4fc1dac7",
                        "entry_id": "c8a26656-c0c7-39a1-a07e-800a1f6a373b",
                        "glosses": [
                            "An innocent, unsophisticated, naïve, wholesome girl or young woman."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d7543dc-2ee2-49cc-b39b-44210dc90888",
                                "sense_id": "b6472635-f345-3445-9def-ab2f4fc1dac7",
                                "text": "She was seen as a gifted pop-country ingenue when, in a now infamous moment, Kanye West interrupted Swift onstage at the 2009 VMAs while she was accepting an award. The incident set in motion a chain of events that would shape the next decade of both artists’ lives."
                            }
                        ]
                    },
                    {
                        "sense_id": "64bed022-fcfe-3b1a-b543-e21bcafaf5ba",
                        "entry_id": "c8a26656-c0c7-39a1-a07e-800a1f6a373b",
                        "glosses": [
                            "A dramatic role of such a woman; an actress playing such a role."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "938e973c-b455-4616-8a3e-1554006649c8",
                                "sense_id": "64bed022-fcfe-3b1a-b543-e21bcafaf5ba",
                                "text": "The intelligent and talented blonde who was fluent in English, French and Spanish was interested in art and joined a local theater group to work on set designs but wound up on stage playing an ingenue in Liliom and was spotted by director Vincente Minnelli."
                            }
                        ]
                    },
                    {
                        "sense_id": "575a7a22-d699-3a19-9e79-2beda55dd8ed",
                        "entry_id": "c8a26656-c0c7-39a1-a07e-800a1f6a373b",
                        "glosses": [
                            "Misspelling of ingenu."
                        ],
                        "tags": [
                            "alt-of",
                            "misspelling",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "ec4fb66f-7370-45c8-9294-7094e4a048eb",
                                "sense_id": "575a7a22-d699-3a19-9e79-2beda55dd8ed",
                                "text": "Mr. Acheson's failure as Secretary of State ... has been an inability to understand people or to be understood by them."
                            },
                            {
                                "example_id": "0f525b85-e422-4f34-a086-150483f92819",
                                "sense_id": "575a7a22-d699-3a19-9e79-2beda55dd8ed",
                                "text": "I cannot resist citing, slightly out of context, another bit of Baudelaire: \"Satan s'est fait ingénu\" (Satan has made himself into an ingenue [Oeuvres Completes 640])"
                            },
                            {
                                "example_id": "7a4ec4ae-8fd7-4e91-bc8e-35d14d0b611d",
                                "sense_id": "575a7a22-d699-3a19-9e79-2beda55dd8ed",
                                "text": "America why callow ingenue bile?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "533268c0-3bee-493d-8968-02b4acef3e9f",
                        "source_entry_id": "c8a26656-c0c7-39a1-a07e-800a1f6a373b",
                        "source_sense_description": "a dramatic role of such a woman; an actress playing such a role",
                        "target_lang_word": "инженю́",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "инженю́",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5edf14b0-17b6-386a-9f68-2ba761630f98",
                                        "entry_id": "316c72e0-43da-33cb-8228-5f6fa492bb31",
                                        "glosses": [
                                            "театр. актёрское амплуа: роли простодушных, наивных, обаятельных молодых девушек, наделённых глубиной чувств (инженю-лирик, инженю-драматик), лукаво озорных, шаловливо кокетливых (инженю-комик)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1f950ce-7144-4d36-adb5-fab2a91f60da",
                                                "sense_id": "5edf14b0-17b6-386a-9f68-2ba761630f98",
                                                "text": "Если стайка сельских инженю, допустим, облепит нас, центровых, мы не ответим негативно."
                                            },
                                            {
                                                "example_id": "c5b36092-7c4e-4135-9bff-64439fb9d054",
                                                "sense_id": "5edf14b0-17b6-386a-9f68-2ba761630f98",
                                                "text": "Серафима Валентиновна, всегда так ловко изображавшая беззащитную инженю, которая погибнет без крепкой мужской руки, впервые в жизни почувствовала себя по-настоящему беспомощной."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
