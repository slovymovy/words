                        "examples": [
                            {
                                "example_id": "428ef07a-3b47-4de0-902e-798b0a10b2e6",
                                "sense_id": "82261e1c-92fb-37b2-a4b3-e357e4f241ec",
                                "text": "Il sortit, et rentra quelques instants après avec un beefsteak cru, saupoudré de sel et de poivre à la mode africaine."
                            },
                            {
                                "example_id": "0a53b21e-0f2c-460e-947b-9776fae113d7",
                                "sense_id": "82261e1c-92fb-37b2-a4b3-e357e4f241ec",
                                "text": "Le beefsteak d’ours vaut le beefsteak de renne, et on a la fourrure en plus."
                            },
                            {
                                "example_id": "5a247abd-e371-46c4-984c-04bb3f73f956",
                                "sense_id": "82261e1c-92fb-37b2-a4b3-e357e4f241ec",
                                "text": "Ils mangèrent un beefsteak aux frites."
                            },
                            {
                                "example_id": "5a61e4b0-af57-4f8f-9034-c8a7c66ff70e",
                                "sense_id": "82261e1c-92fb-37b2-a4b3-e357e4f241ec",
                                "text": "Je vous souhaite un bon samedi dans la paix du riz brisure ndoleh au beefsteak et aux pommes frites fait maison by chef germain."
                            },
                            {
                                "example_id": "6107b089-1635-4181-88b6-6fd6f03dc258",
                                "sense_id": "82261e1c-92fb-37b2-a4b3-e357e4f241ec",
                                "text": "Un baiser sans moustache est comme un beefsteak sans moutarde...\nÇa tombe bien c’est la pénurie..."
                            }
                        ]
                    }
