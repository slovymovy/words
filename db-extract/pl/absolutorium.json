                        "sense_id": "1c7afdf5-307b-31d4-a7c4-5816fbc1ca80",
                        "entry_id": "b2c6659b-5f73-306b-9697-c292dc79c489",
                        "glosses": [
                            "Entlastung, Absolutorium"
                        ],
                        "tags": [
                            "Finanzen"
                        ],
                        "examples": [
                            {
                                "example_id": "409e6ca7-fab2-4610-82e4-56a8c2cc6edf",
                                "sense_id": "1c7afdf5-307b-31d4-a7c4-5816fbc1ca80",
                                "text": "„W lutym tego roku dziennikarze nie zostali wpuszczeni na obrady warszawskiej komisji rewizyjnej dotyczące wykonania budżetu miasta i udzielenia zarządowi absolutorium.“"
                            },
                            {
                                "example_id": "86ba387e-4df8-4cf3-b3f3-e0f39d5b1bc8",
                                "sense_id": "1c7afdf5-307b-31d4-a7c4-5816fbc1ca80",
                                "text": "„Po dokumentach widać, że spółka nie szła – zmieniała siedziby, co i raz ktoś z zarządu albo rady nadzorczej nie dostawał absolutorium od generała, który był większościowym udziałowcem.“"
                            },
                            {
                                "example_id": "7bbfdeca-bd59-4229-b675-9f3ea6627215",
                                "sense_id": "1c7afdf5-307b-31d4-a7c4-5816fbc1ca80",
                                "text": "„Co roku od dziesięciu lat udziela absolutorium szefowi firmy, czyli mężowi.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ff013725-aa83-3517-91df-cf3b51d160b8",
