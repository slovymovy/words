{
    "word_family": [
        "zelfstandigheid",
        "zelfstandige"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d471d1f0-39dd-3b87-91fd-efb3a6bb62e0",
                    "sense_definition": "in staat om voor zichzelf te zorgen zonder hulp van anderen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "autonomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn oma woont nog steeds <w>zelfstandig</w> in haar eigen huis.",
                            "target_lang_translations": {
                                "en": "My grandmother still lives <w>independently</w> in her own home.",
                                "ru": "Моя бабушка до сих пор живет <w>самостоятельно</w> в своем собственном доме."
                            }
                        },
                        {
                            "text": "Kinderen moeten leren om op een dag <w>zelfstandig</w> te wonen.",
                            "target_lang_translations": {
                                "en": "Children must learn to live <w>on their own</w> one day.",
                                "ru": "Дети должны научиться когда-нибудь жить <w>самостоятельно</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "onafhankelijk"
                    ],
                    "antonyms": [
                        "onzelfstandig"
                    ],
                    "common_phrases": [
                        "zelfstandig wonen",
                        "geheel zelfstandig"
                    ],
                    "target_lang_definitions": {
                        "en": "able to take care of oneself without help from others",
                        "ru": "способный заботиться о себе без помощи других"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "independent",
                                "target_lang_sense_clarification": "not needing help from others"
                            },
                            {
                                "target_lang_word": "self-sufficient",
                                "target_lang_sense_clarification": "able to provide for one's own needs"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "самостоятельный",
                                "target_lang_sense_clarification": "способный обходиться без посторонней помощи"
                            },
                            {
                                "target_lang_word": "независимый",
                                "target_lang_sense_clarification": "не нуждающийся в поддержке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28438ab9-1dfe-3b28-b8af-17f6fcbff459",
                    "sense_definition": "werkend voor eigen rekening en risico, niet in loondienst",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "werk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij werkt als <w>zelfstandig</w> ondernemer in de bouwsector.",
                            "target_lang_translations": {
                                "en": "She works as an <w>independent</w> entrepreneur in the construction sector.",
                                "ru": "Она работает как <w>частный</w> предприниматель в строительном секторе."
                            }
                        },
                        {
                            "text": "Na jaren in loondienst besloot hij een <w>zelfstandig</w> beroep te kiezen.",
                            "target_lang_translations": {
                                "en": "After years of being an employee, he decided to choose a <w>self-employed</w> profession.",
                                "ru": "После многих лет работы по найму он решил выбрать <w>самостоятельную</w> деятельность."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zelfstandig ondernemer",
                        "zelfstandig beroep"
                    ],
                    "target_lang_definitions": {
                        "en": "working for one's own account and risk, not as an employee",
                        "ru": "работающий на себя, не по найму"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "self-employed",
                                "target_lang_sense_clarification": "working for oneself"
                            },
                            {
                                "target_lang_word": "independent",
                                "target_lang_sense_clarification": "as in an independent contractor"
                            },
                            {
                                "target_lang_word": "freelance",
                                "target_lang_sense_clarification": "working for different companies rather than being employed by one"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "самозанятый",
                                "target_lang_sense_clarification": "работающий на себя"
                            },
                            {
                                "target_lang_word": "частный",
                                "target_lang_sense_clarification": "как в словосочетании частный предприниматель"
                            },
                            {
                                "target_lang_word": "независимый",
                                "target_lang_sense_clarification": "действующий как свободный агент"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f18c6a60-0b09-30c2-97b2-9c4260f8ec68",
                    "sense_definition": "niet onderworpen aan het gezag van een andere staat of organisatie",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "autonomie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kolonie werd na een lange strijd een <w>zelfstandig</w> land.",
                            "target_lang_translations": {
                                "en": "The colony became an <w>independent</w> country after a long struggle.",
                                "ru": "После долгой борьбы колония стала <w>независимой</w> страной."
                            }
                        },
                        {
                            "text": "Deze regio streeft naar een <w>zelfstandig</w> bestuur binnen Europa.",
                            "target_lang_translations": {
                                "en": "This region strives for <w>autonomous</w> governance within Europe.",
                                "ru": "Этот регион стремится к <w>автономному</w> управлению внутри Европы."
                            }
                        }
                    ],
                    "synonyms": [
                        "onafhankelijk"
                    ],
                    "common_phrases": [
                        "zelfstandig land",
                        "zelfstandig bestuur"
                    ],
                    "target_lang_definitions": {
                        "en": "not subject to the authority of another state or organization",
                        "ru": "не подчиняющийся власти другого государства или организации"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "independent",
                                "target_lang_sense_clarification": "self-governing"
                            },
                            {
                                "target_lang_word": "autonomous",
                                "target_lang_sense_clarification": "having the power of self-government"
                            },
                            {
                                "target_lang_word": "sovereign",
                                "target_lang_sense_clarification": "possessing supreme or ultimate power"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "независимый",
                                "target_lang_sense_clarification": "обладающий суверенитетом"
                            },
                            {
                                "target_lang_word": "автономный",
                                "target_lang_sense_clarification": "имеющий право на самоуправление"
                            },
                            {
                                "target_lang_word": "самостоятельный",
                                "target_lang_sense_clarification": "о государстве или органе управления"
                            }
                        ]
