                        "entry_id": "7b1aeb2c-5dd3-3e5d-aafe-a11876854f39",
                        "glosses": [
                            "compensatie van de bij een ander aangerichte schade of leed meestal ten gevolge van oorlogshandelingen soms in de vorm van geld maar ook in natura of door het verrichten van dwangarbeid"
                        ],
                        "tags": [
                            "geringe"
                        ],
                        "examples": [
                            {
                                "example_id": "aa0a91c2-3fac-40cc-adc3-27515817ccce",
                                "sense_id": "f3f5f863-80f2-32bc-b5d8-b0e47a4519d4",
                                "text": "John Maynard Keynes betoogde dat de herstelbetalingen na de Eerste Wereldoorlog netto een zeer negatief effect op de wereldeconomie hebben gehad"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "32864ec2-b2ff-41b3-9976-be8e8701e7b2",
                        "source_entry_id": "7b1aeb2c-5dd3-3e5d-aafe-a11876854f39",
                        "source_sense_id": "f3f5f863-80f2-32bc-b5d8-b0e47a4519d4",
