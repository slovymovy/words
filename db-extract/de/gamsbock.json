                                "example_id": "ba5da678-4404-4615-a83d-54c55e3b8c08",
                                "sense_id": "abb66d85-30ea-3ea6-b13b-300c60b2abbe",
                                "text": "„Widerrechtlich hat der Wilderer, ein 28-jähriger Mann aus Garmisch-Partenkirchen, einen Gamsbock erlegt.“"
                            },
                            {
                                "example_id": "83b9b1d3-c19f-41d4-ac41-612e08a98fec",
                                "sense_id": "abb66d85-30ea-3ea6-b13b-300c60b2abbe",
                                "text": "„Er hat schwer zu tragen - auf seinen Schultern trägt er einen erlegten Gamsbock.“"
                            }
                        ],
