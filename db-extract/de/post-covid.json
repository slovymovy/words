            {
                "entry_id": "d4e9d1c0-548f-3788-a216-f7b59fb773a7",
                "word": "Post-COVID",
                "pos": "name",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "04e5343c-00e8-3ef2-93fe-9e4cac8eac4a",
                        "entry_id": "d4e9d1c0-548f-3788-a216-f7b59fb773a7",
                        "glosses": [
                            "Beeinträchtigung der Gesundheit und des Wohlbefindens mit mehreren Faktoren/Symptomen, die als Nachwirkungen/Langzeitfolgen von Covid-19 gesehen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9de5d514-81d4-499f-b4ed-8ea732df67a2",
                                "sense_id": "04e5343c-00e8-3ef2-93fe-9e4cac8eac4a",
                                "text": "„Das vermehrte Auftreten neurologischer Erkrankungen im Rahmen von Post-COVID erinnere zu einem gewissen Punkt an das gehäufte Auftreten der Enzephalitis Lethargica im Anschluss an die drei Wellen der Spanischen Grippe von 1917 bis 1920.“"
                            },
                            {
                                "example_id": "ce3e135b-7e9a-4625-9bb6-434acf44f6db",
                                "sense_id": "04e5343c-00e8-3ef2-93fe-9e4cac8eac4a",
                                "text": "„Auf der Basis erster klinischer Erfahrungen zeigt der Beitrag Aspekte der Rehabilitation und Begutachtung nach Long-COVID im Sinne von Post-COVID nach den Versorgungsgesetzen auf und nimmt Stellung zur wehrmedizinischen Relevanz der Erkrankung.“"
                            },
                            {
                                "example_id": "20161112-b456-4f16-a7dc-e090499a8d9c",
                                "sense_id": "04e5343c-00e8-3ef2-93fe-9e4cac8eac4a",
                                "text": "„Die Behandlung erfolgt wegen der vielfältigen Ausgestaltung von Post-COVID am besten auf den einzelnen Patienten ausgerichtet, und zwar mit einem interdisziplinären, ganzheitlichen psychosomatischen Ansatz.“"
                            },
                            {
                                "example_id": "fad3967e-c4a8-4588-aa19-4650d78c0db8",
                                "sense_id": "04e5343c-00e8-3ef2-93fe-9e4cac8eac4a",
                                "text": "„Eine Infektion mit dem Corona-Virus kann auch neurologisch-psychiatrische Beschwerden nach sich ziehen; dauern diese über die akute Erkrankung hinaus an oder treten erst danach auf, spricht man von Post-COVID.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
