                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7882260-55da-404d-8128-98a315ff4b59",
                                                "sense_id": "a09eeadc-4cc0-30a5-9445-f7049d1e8eaf",
                                                "text": "„Das Treffen Seehofers mit dem Unternehmen hatte auch Bayerns Wirtschaftsminister Martin Zeil (FDP) verstimmt und zur Eskalation des Koalitionskrachs von CSU und FDP beigetragen.“"
                                            },
                                            {
                                                "example_id": "267e5ab3-539a-4286-b4f6-9a3153f6fad9",
                                                "sense_id": "a09eeadc-4cc0-30a5-9445-f7049d1e8eaf",
                                                "text": "„Das sicherste Mittel, den Hörer zu verstimmen, gründlich zu verstimmen, wäre eine in der Praxis allzu deutlich zur Schau getragene Absicht, ihn durch die theatralische Vorstellung bilden zu wollen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7b5432e3-3f64-3229-b9b8-d8043bc467f2",
                                        "entry_id": "07634bbc-aab3-37a2-9a1c-d13b337d8936",
                                        "glosses": [
                                            "ein Musikinstrument so einstellen, dass es falsch klingt"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecf6a225-ca2d-47b7-ba5c-6d607b7d268f",
                                                "sense_id": "7b5432e3-3f64-3229-b9b8-d8043bc467f2",
                                                "text": "„Ich habe sofort gehört, daß das Klavier verstimmt war. “"
                                            },
                                            {
                                                "example_id": "0c7a6ca3-730e-44f5-badf-c38971d60be3",
                                                "sense_id": "7b5432e3-3f64-3229-b9b8-d8043bc467f2",
                                                "text": "Die Gitarre ist verstimmt, das liegt bestimmt am Raumklima."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
