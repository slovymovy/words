                    {
                        "translation_id": "b4e13777-3b76-4bc1-98fd-03175dca7354",
                        "source_entry_id": "7c9d0342-9f0a-33ab-b4ad-1f33ae50560d",
                        "source_sense_id": "f4a84580-1266-31a2-b672-083ecc728229",
                        "source_sense_description": "Иноязычные аналоги",
                        "target_lang_word": "Silvia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Silvia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d8dca73-dd36-3c87-9ed4-4b679ff5a60b",
                                        "entry_id": "235a71a8-bcff-3fe1-8fe5-1630fbe3c21d",
                                        "glosses": [
                                            "A female given name from Latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e93bcd7-e280-4d99-b43e-be418dfb9b10",
                                                "sense_id": "9d8dca73-dd36-3c87-9ed4-4b679ff5a60b",
                                                "text": "Who is Silvia? what is she? / That all our swains commend her? / Holy, fair and wise is she; / The heaven such grace did lend her, / That she might admired be."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94327549-0a8f-30d9-8448-51e8df29aa88",
                                        "entry_id": "235a71a8-bcff-3fe1-8fe5-1630fbe3c21d",
                                        "glosses": [
                                            "A surname."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32984ee6-b8cf-49ad-8b30-0db21f784c87",
                        "source_entry_id": "7c9d0342-9f0a-33ab-b4ad-1f33ae50560d",
                        "source_sense_id": "f4a84580-1266-31a2-b672-083ecc728229",
                        "source_sense_description": "Иноязычные аналоги",
