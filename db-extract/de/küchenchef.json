                "senses": [
                    {
                        "sense_id": "f30a247f-33cf-3669-8737-95fbb59def96",
                        "entry_id": "5a07a518-1695-3032-9e8d-ec99ecf499f6",
                        "glosses": [
                            "leitender Koch in einer Küche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72fe8f42-84d8-4f47-8c28-2edc6bf2367e",
                                "sense_id": "f30a247f-33cf-3669-8737-95fbb59def96",
                                "text": "„Obwohl der Laden brummte und sich an der Annonce die Bons türmten, bewahrte der Küchenchef die Contenance und stand mir geduldig Rede und Antwort.“"
                            },
                            {
                                "example_id": "c995107d-49fd-44ff-af24-253a4960f082",
                                "sense_id": "f30a247f-33cf-3669-8737-95fbb59def96",
                                "text": "„Beljambe, der Gastwirt, ehemals Küchenchef in Lisieux, sollte bestimmte Gerichte kochen.“"
                            },
                            {
                                "example_id": "7c8dc9f2-bf5d-4858-b4c1-5f9ff98d8028",
                                "sense_id": "f30a247f-33cf-3669-8737-95fbb59def96",
                                "text": "Küchenchefin Marta und Küchenchef Emil verstanden das Wort „gesundes Essen“ als Kampfbegriff."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ec47a96-9afc-40df-a83e-6c43d61884ae",
                        "source_entry_id": "5a07a518-1695-3032-9e8d-ec99ecf499f6",
                        "source_sense_id": "f30a247f-33cf-3669-8737-95fbb59def96",
                        "source_sense_description": "leitender Koch in einer Küche",
                        "target_lang_word": "chef",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chef",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e220e17c-b922-360d-a145-13055579ced8",
                                        "entry_id": "bb2e0343-cdf9-36ac-9a31-e10b0332b472",
                                        "glosses": [
                                            "The presiding cook in the kitchen of a large household."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a80e31e6-bfe7-4281-bfad-8f00bbc9968a",
                                                "sense_id": "e220e17c-b922-360d-a145-13055579ced8",
                                                "text": "The Chef's peace of mind was restor'd, And in due time a banquet was placed on the board."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26b67363-b417-348e-8796-5f6a8a7e956f",
                                        "entry_id": "bb2e0343-cdf9-36ac-9a31-e10b0332b472",
                                        "glosses": [
                                            "The head cook of a restaurant or other establishment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89999a3b-8fbe-4545-aede-d9d2b0260a9b",
                                                "sense_id": "26b67363-b417-348e-8796-5f6a8a7e956f",
                                                "text": "The cause of the disturbance, it appeared, was the angry little chef of Sir Francis Clavering's culinary establishment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45d92060-7e9f-3973-8630-0dfa30a6ee27",
                                        "entry_id": "bb2e0343-cdf9-36ac-9a31-e10b0332b472",
                                        "glosses": [
                                            "Any cook."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96ff1d61-391c-4da8-8999-0616ceb75fea",
                                                "sense_id": "45d92060-7e9f-3973-8630-0dfa30a6ee27",
                                                "text": "My partner is the chef of the household, while I do most of the cleaning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ed2d5f2-c195-3d77-8752-ceafc7a08372",
                                        "entry_id": "bb2e0343-cdf9-36ac-9a31-e10b0332b472",
                                        "glosses": [
                                            "One who manufactures illegal drugs; a cook."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37110c7e-02de-49f9-b15e-c380860d6855",
                                                "sense_id": "2ed2d5f2-c195-3d77-8752-ceafc7a08372",
                                                "text": "But trying to stop all the nation's meth chefs makes as much sense as building a wall along the Mexican border."
                                            },
                                            {
                                                "example_id": "a7dac94d-217c-4b1b-ae64-2c921b5723c7",
                                                "sense_id": "2ed2d5f2-c195-3d77-8752-ceafc7a08372",
                                                "text": "Owsley Stanley, the world's most exacting and prolific LSD chef who supplied the majority of America's West Coast with LSD in the 1960s, claimed he made so much acid not because he wanted to change the world, but rather because it was almost impossible not to make vast quantities of the drug once the synthesis had been embarked upon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccdfb7c1-b808-3dfd-8503-1b5ccf70999e",
                                        "entry_id": "bb2e0343-cdf9-36ac-9a31-e10b0332b472",
                                        "glosses": [
                                            "A reliquary in the shape of a head."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "chef",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b67907e-f5d2-32c1-8208-9d3d1c85ddbf",
                                        "entry_id": "c35c984d-6c3d-3c07-b0e3-a8eb05dd0862",
                                        "glosses": [
                                            "To work as a chef; to prepare and cook food professionally."
                                        ],
                                        "tags": [
                                            "informal",
                                            "stative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d383d98-7099-42a1-b6ba-cf9952ea55ec",
                                                "sense_id": "5b67907e-f5d2-32c1-8208-9d3d1c85ddbf",
                                                "text": "It was Brick who talked on alumni relations with the active chapters and who cheffed at our steak fry (more of that later) and Mrs. Cowles who took over […]"
                                            },
                                            {
                                                "example_id": "4d3004f4-40f8-4916-8395-79c93ca27688",
                                                "sense_id": "5b67907e-f5d2-32c1-8208-9d3d1c85ddbf",
                                                "text": "I cheffed part-time at a nice restaurant in town."
                                            },
                                            {
                                                "example_id": "e1aed71d-9d9a-4849-bb3f-47cce1753e76",
                                                "sense_id": "5b67907e-f5d2-32c1-8208-9d3d1c85ddbf",
                                                "text": "He opened Oakleys in 2002, having formerly cheffed at the late, much-missed Something Different and, before that, world-renowned kitchens in Chicago […]"
                                            },
                                            {
                                                "example_id": "05a080f3-efa8-40fc-89e8-aaddc78f1f98",
                                                "sense_id": "5b67907e-f5d2-32c1-8208-9d3d1c85ddbf",
                                                "text": "A man called Richard Briggs cheffed at the Globe Tavern on Fleet Street, the White Hart Tavern in Holborn and the Temple Coffee House."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7580f90-7976-37c1-8bab-e68b7c76fcd8",
                                        "entry_id": "c35c984d-6c3d-3c07-b0e3-a8eb05dd0862",
                                        "glosses": [
                                            "To stab with a knife, to shank."
                                        ],
                                        "tags": [
                                            "Multicultural-London-English",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be3b1a3d-7b4f-4fcb-b673-ec68618c1c55",
                                                "sense_id": "e7580f90-7976-37c1-8bab-e68b7c76fcd8",
                                                "text": "Third time he was out of luck\nHe tripped up and got cheffed"
                                            },
                                            {
                                                "example_id": "a0562f72-0fd4-4a0d-ae26-b6d06139b685",
                                                "sense_id": "e7580f90-7976-37c1-8bab-e68b7c76fcd8",
                                                "text": "He got cheffed in the A in the head"
                                            },
                                            {
                                                "example_id": "f489f421-279c-40f9-b177-503006d5d40c",
                                                "sense_id": "e7580f90-7976-37c1-8bab-e68b7c76fcd8",
                                                "text": "He got cheffed up proper."
                                            },
                                            {
                                                "example_id": "336cda8d-01c7-4c85-8605-962a35e68581",
                                                "sense_id": "e7580f90-7976-37c1-8bab-e68b7c76fcd8",
                                                "text": "Still on my knife work chef him up with that rambo"
                                            },
                                            {
                                                "example_id": "14ee1957-1e3b-4c95-a954-02d4836a8dd1",
                                                "sense_id": "e7580f90-7976-37c1-8bab-e68b7c76fcd8",
                                                "text": "Child just said he'd \"chef me up\". I said not hungry, but it restored my faith in young generation, offering to cook for strangers."
                                            },
                                            {
                                                "example_id": "63964064-0113-4489-923c-5c7b643c0b0a",
                                                "sense_id": "e7580f90-7976-37c1-8bab-e68b7c76fcd8",
                                                "text": "Asked how he knew that, he replied: \"Uh? Because I know that ... It was to do with Svenson's op - they cheffed him up a couple of month or something, a couple of months before."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b75d3dc3-63f4-3e2d-a501-f40711bd6f1a",
                                        "entry_id": "c35c984d-6c3d-3c07-b0e3-a8eb05dd0862",
                                        "glosses": [
                                            "To impress others."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "529d3ad8-d984-404e-a8d5-cc32541b92d8",
                                                "sense_id": "b75d3dc3-63f4-3e2d-a501-f40711bd6f1a",
                                                "text": "thinkin' that I be cheffin'.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "afb70a31-41cd-44ce-bf72-74ebfa5103cb",
                        "source_entry_id": "5a07a518-1695-3032-9e8d-ec99ecf499f6",
                        "source_sense_id": "f30a247f-33cf-3669-8737-95fbb59def96",
