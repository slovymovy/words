                "senses": [
                    {
                        "sense_id": "861953fe-0a07-3fc2-a6f0-a2949b4276fe",
                        "entry_id": "5a8d694e-cef7-37bb-af41-1e23cba2d9a1",
                        "glosses": [
                            "Grabstätte eines Königs/von Königen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b656058-2f39-4bda-9b39-cc80c63d91ff",
                                "sense_id": "861953fe-0a07-3fc2-a6f0-a2949b4276fe",
                                "text": "„König Tutanchamun war ein ägyptischer Pharao[,] der um 1300 v. Chr. regierte. […] Weltberühmt wurde er, als 1922 sein fast vollständig erhaltenes Grab in Luxor […] entdeckt wurde. Im Gegensatz zu anderen Königsgräbern, die im Laufe der Jahre geplündert worden sind, konnten rund 3.000 Artefakte aus dem Grab des jungen Königs entnommen werden […]“"
                            },
                            {
                                "example_id": "cfad94e1-10c2-4104-b231-534c7ce34e7e",
                                "sense_id": "861953fe-0a07-3fc2-a6f0-a2949b4276fe",
                                "text": "„Da es weder Paläste noch Königsgräber, wohl aber religiös-rituelle Plätze und Siedlungen einer Elite in den Zitadellen der Städte gab, nimmt man an, dass eine Art Priesterschaft für die Normensetzung und die lange Erhaltung dieser Kultur zuständig war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
