                                "target_senses": [
                                    {
                                        "sense_id": "7a6b4c8f-c205-38e9-b1cb-cd0b3f293ccd",
                                        "entry_id": "df1d42b0-d313-3e57-8c38-99fad79a2c73",
                                        "glosses": [
                                            "Relating to prosecuting of criminal cases."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47f3e432-ef88-40d6-b6f2-1b22d035bb7d",
                                                "sense_id": "7a6b4c8f-c205-38e9-b1cb-cd0b3f293ccd",
                                                "text": "Prosecutorial misconduct can lead to the lawyer's disbarment."
                                            },
                                            {
                                                "example_id": "35e055c3-5744-4b73-80f8-c99b6dfbe380",
                                                "sense_id": "7a6b4c8f-c205-38e9-b1cb-cd0b3f293ccd",
                                                "text": "Chief Justice Lynch owes his current job to the exercise of prosecutorial abuse which followed in the wake of exposés about the \"Sex Ring\" indictments. Lynch's predecessor, Robert Bonin, was driven from the bench after he showed some interest in the gay civil rights aspects of these cases."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f383410-813d-4352-b8ab-9467a703b402",
