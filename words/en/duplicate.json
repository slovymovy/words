{
    "word_family": [
        "duplication",
        "duplicator",
        "duplicative",
        "deduplicate",
        "reduplicate"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a99dc144-eae6-3dec-be60-9b5eadf7455a",
                    "sense_definition": "To create an exact copy or reproduction of something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "copying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The office manager asked me to <w>duplicate</w> these documents for the meeting.",
                            "target_lang_translations": {
                                "ru": "Офис-менеджер попросил меня <w>сделать копии</w> этих документов для встречи.",
                                "zh": "办公室经理让我为会议<w>复印</w>这些文件。"
                            }
                        },
                        {
                            "text": "It is very difficult to <w>duplicate</w> a key without the original one.",
                            "target_lang_translations": {
                                "ru": "Очень сложно <w>сделать дубликат</w> ключа без оригинала.",
                                "zh": "没有原件的话，很难<w>配</w>一把钥匙。"
                            }
                        }
                    ],
                    "synonyms": [
                        "double",
                        "dupe"
                    ],
                    "antonyms": [
                        "deduplicate"
                    ],
                    "common_phrases": [
                        "duplicate a key",
                        "duplicate a file"
                    ],
                    "target_lang_definitions": {
                        "ru": "Создать точную копию или репродукцию чего-либо.",
                        "zh": "制作某物的精确副本或复制品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дублировать",
                                "target_lang_sense_clarification": "изготавливать в двух экземплярах"
                            },
                            {
                                "target_lang_word": "делать копию",
                                "target_lang_sense_clarification": "создавать репродукцию"
                            },
                            {
                                "target_lang_word": "размножить",
                                "target_lang_sense_clarification": "воспроизвести в нескольких экземплярах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "复制",
                                "target_lang_sense_clarification": "制作完全相同的副本"
                            },
                            {
                                "target_lang_word": "复印",
                                "target_lang_sense_clarification": "特指文档的复制"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0e0037e-a043-384a-bb0b-21544d295c1c",
                    "sense_definition": "To perform an action or effort again, often unnecessarily.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "repetition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We should coordinate our tasks so we do not <w>duplicate</w> efforts unnecessarily.",
                            "target_lang_translations": {
                                "ru": "Нам следует координировать задачи, чтобы излишне не <w>дублировать</w> усилия.",
                                "zh": "我们应该协调好任务，以免不必要地<w>重复</w>劳动。"
                            }
                        },
                        {
                            "text": "The scientist tried to <w>duplicate</w> the results of the previous experiment.",
                            "target_lang_translations": {
                                "ru": "Ученый пытался <w>воспроизвести</w> результаты предыдущего эксперимента.",
                                "zh": "科学家试图<w>重现</w>之前实验的结果。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "duplicate efforts",
                        "duplicate results"
                    ],
                    "target_lang_definitions": {
                        "ru": "Повторно совершать действие или прилагать усилия, часто излишне.",
                        "zh": "重复进行某项行动或付出努力，通常是不必要的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дублировать",
                                "target_lang_sense_clarification": "выполнять параллельно ту же работу"
                            },
                            {
                                "target_lang_word": "повторять",
                                "target_lang_sense_clarification": "воспроизводить действия или результаты"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "重复",
                                "target_lang_sense_clarification": "再次进行相同的工作"
                            },
                            {
                                "target_lang_word": "重做",
                                "target_lang_sense_clarification": "再次执行某项任务"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5bb812f-21c6-3a04-8edd-da4fc47c1921",
                    "sense_definition": "To match or equal a specific level of skill, quality, or achievement.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "matching",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young athlete found it hard to <w>duplicate</w> the success of his predecessor.",
                            "target_lang_translations": {
                                "ru": "Молодому атлету было трудно <w>повторить</w> успех своего предшественника.",
                                "zh": "这位年轻运动员发现很难<w>重现</w>他前辈的成功。"
                            }
                        },
                        {
                            "text": "Few chefs can <w>duplicate</w> the complex flavors found in her signature dish.",
                            "target_lang_translations": {
                                "ru": "Немногие шеф-повара могут <w>воссоздать</w> сложные вкусы её фирменного блюда.",
                                "zh": "很少有厨师能<w>复制</w>出她招牌菜中那种复杂的味道。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "duplicate the success",
                        "duplicate the performance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соответствовать или равняться определенному уровню мастерства, качества или достижений.",
                        "zh": "达到或匹配特定的技能、质量或成就水平。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повторить",
                                "target_lang_sense_clarification": "добиться такого же успеха или результата"
                            },
                            {
                                "target_lang_word": "воспроизвести",
                                "target_lang_sense_clarification": "воссоздать сложный вкус или качество"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "重现",
                                "target_lang_sense_clarification": "再次达到某种成就"
                            },
                            {
                                "target_lang_word": "复制",
                                "target_lang_sense_clarification": "重现某种品质或效果"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "352ee26f-da5c-309d-87b1-8287ceb17006",
                    "sense_definition": "An object that is exactly like another; a replica or copy.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "copying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I keep a <w>duplicate</w> of my house keys with a trusted neighbor.",
                            "target_lang_translations": {
                                "ru": "Я храню <w>дубликат</w> ключей от дома у надежного соседа.",
                                "zh": "我把一把家门钥匙的<w>副本</w>放在一位值得信赖的邻居那里。"
                            }
                        },
                        {
                            "text": "This painting is not the original but a very high-quality <w>duplicate</w>.",
                            "target_lang_translations": {
                                "ru": "Эта картина — не оригинал, а очень качественная <w>копия</w>.",
                                "zh": "这幅画不是原作，而是一件高质量的<w>复制品</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reproduction"
                    ],
                    "common_phrases": [
                        "spare duplicate",
                        "exact duplicate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Объект, который в точности похож на другой; реплика или копия.",
                        "zh": "与另一个完全相同的物体；复制品或副本。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дубликат",
                                "target_lang_sense_clarification": "повторно изготовленный экземпляр предмета"
                            },
                            {
                                "target_lang_word": "копия",
                                "target_lang_sense_clarification": "объект, созданный по образцу другого"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "副本",
                                "target_lang_sense_clarification": "与原件完全相同的备份"
                            },
                            {
                                "target_lang_word": "复制品",
                                "target_lang_sense_clarification": "仿造的物品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42e4e839-b987-3119-929b-6a99e2c03fcb",
                    "sense_definition": "A legal document or instrument that is identical to the original and has the same legal validity.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal_documents",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer prepared a <w>duplicate</w> of the contract for each party to sign.",
                            "target_lang_translations": {
                                "ru": "Юрист подготовил <w>дубликат</w> контракта для подписания каждой стороной.",
                                "zh": "律师为每一方准备了一份合同<w>副本</w>以供签署。"
                            }
                        },
                        {
                            "text": "Please ensure that the <w>duplicate</w> contains all the same essential particulars as the original.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, убедитесь, что <w>дубликат</w> содержит все те же основные реквизиты, что и оригинал.",
                                "zh": "请确保该<w>副本</w>包含与原件相同的所有必要细节。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "signed duplicate",
                        "legal duplicate"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Юридический документ, идентичный оригиналу и имеющий ту же юридическую силу.",
                        "zh": "与原件完全一致并具有同等法律效力的法律文件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дубликат",
                                "target_lang_sense_clarification": "второй экземпляр документа с силой оригинала"
                            },
                            {
                                "target_lang_word": "копия",
                                "target_lang_sense_clarification": "точный экземпляр документа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "副本",
                                "target_lang_sense_clarification": "具有法律效力的第二份文件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d70988a-271d-3f7a-ad66-602cb4fb5ad3",
                    "sense_definition": "A version of a game, such as bridge or Scrabble, where players compete using the same sets of cards or tiles.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They spent the entire evening playing <w>duplicate</w> at the local bridge club.",
                            "target_lang_translations": {
                                "ru": "Они провели весь вечер, играя в <w>дубликат</w> в местном бридж-клубе.",
                                "zh": "他们整个晚上都在当地桥牌俱乐部打<w>复式赛</w>。"
                            }
                        },
                        {
                            "text": "In <w>duplicate</w>, the element of luck is reduced because everyone plays the same hand.",
                            "target_lang_translations": {
                                "ru": "В <w>дубликате</w> фактор удачи снижен, так как все разыгрывают один и тот же расклад.",
                                "zh": "在<w>复式赛</w>中，运气成分被降低了，因为每个人拿到的牌都是一样的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "play duplicate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вариант игры (например, бридж), где игроки соревнуются, используя одинаковые наборы карт или фишек.",
                        "zh": "一种游戏形式（如桥牌），玩家使用相同的牌组或棋子进行比赛以减少运气成分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дубликат",
                                "target_lang_sense_clarification": "формат игры в бридж"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "复式赛",
                                "target_lang_sense_clarification": "竞技类游戏比赛形式"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f7fd3060-498f-38b1-a59e-8549e04c016c",
                    "sense_definition": "Exactly the same as another thing; existing in two identical copies.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "copying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The system flagged a <w>duplicate</w> entry in the database that needed to be removed.",
                            "target_lang_translations": {
                                "ru": "Система пометила <w>дублирующуюся</w> запись в базе данных, которую необходимо было удалить.",
                                "zh": "系统标记了数据库中一条需要删除的<w>重复</w>条目。"
                            }
                        },
                        {
                            "text": "I accidentally bought <w>duplicate</w> copies of the same book.",
                            "target_lang_translations": {
                                "ru": "Я случайно купил <w>одинаковые</w> экземпляры одной и той же книги.",
                                "zh": "我不小心买了<w>重复</w>的同一本书。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "duplicate copy",
                        "duplicate entry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Точно такой же, как другой предмет; существующий в двух идентичных экземплярах.",
                        "zh": "与另一事物完全相同；以两个相同副本的形式存在。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дублирующий",
                                "target_lang_sense_clarification": "повторяющийся или запасной"
                            },
                            {
                                "target_lang_word": "повторный",
                                "target_lang_sense_clarification": "идентичный уже существующему"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "重复的",
                                "target_lang_sense_clarification": "多余的或已存在的"
                            },
                            {
                                "target_lang_word": "相同的",
                                "target_lang_sense_clarification": "完全一致的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67f4cd22-036d-3451-936a-02822b17f64e",
                    "sense_definition": "Relating to a card or board game format where the same hands or tiles are played by different sets of players.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "games",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tournament featured <w>duplicate</w> whist to ensure a fair comparison of skill.",
                            "target_lang_translations": {
                                "ru": "На турнире проводился <w>дубликатный</w> вист, чтобы обеспечить честное сравнение мастерства.",
                                "zh": "锦标赛采用了<w>复式</w>惠斯特牌以确保技能比拼的公平性。"
                            }
                        },
                        {
                            "text": "Many serious players prefer <w>duplicate</w> Scrabble because it tests strategy over luck.",
                            "target_lang_translations": {
                                "ru": "Многие серьезные игроки предпочитают <w>дубликатный</w> скрэббл, потому что он проверяет стратегию, а не удачу.",
                                "zh": "许多认真的玩家更喜欢<w>复式</w>拼字游戏，因为它考验的是策略而非运气。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "duplicate bridge",
                        "duplicate whist"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к формату карточных или настольных игр, где одни и те же расклады разыгрываются разными игроками.",
                        "zh": "指一种游戏格式，不同组的玩家使用相同的牌组或棋子进行比赛。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дубликатный",
                                "target_lang_sense_clarification": "относящийся к спортивному формату игры"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "复式的",
                                "target_lang_sense_clarification": "指竞技游戏格式"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}