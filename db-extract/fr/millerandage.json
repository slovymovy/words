                    {
                        "sense_id": "d9df19cd-a6cb-36f7-af9d-66795d97752c",
                        "entry_id": "08c5ac15-40ae-3bc3-8e29-2c8fc2fc98b7",
                        "glosses": [
                            "Avortement plus ou moins complet des grains de raisin causé par la coulure ou par des maladies cryptogamiques."
                        ],
                        "tags": [
                            "Viticulture"
                        ],
                        "examples": [
                            {
                                "example_id": "2135be73-2eb8-46d4-aeb3-2cb1c87dde3d",
                                "sense_id": "d9df19cd-a6cb-36f7-af9d-66795d97752c",
                                "text": "La vigne de Corinthe est un cépage où le millerandage est la règle."
                            },
                            {
                                "example_id": "5dddc4cc-003e-4329-9df9-9a7a643a5fa2",
                                "sense_id": "d9df19cd-a6cb-36f7-af9d-66795d97752c",
                                "text": "Il s’agit de millerandage, qui provient d’une fécondation imparfaite de la vigne. Les raisins dont les fleurs d’origine ont été mal fécondées restent petits et se développent sans pépins. À maturité, ces baies sont plus sucrées. On parle de raisins “millerands”."
                            }
                        ]
                    }
