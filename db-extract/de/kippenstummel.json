                        "tags": [],
                        "examples": [
                            {
                                "example_id": "889c36a1-5564-4a68-814f-3e0912f87bd3",
                                "sense_id": "ceaeddab-13d0-37fa-9a48-a62155aad654",
                                "text": "„Es riecht nach Urin, Kippenstummel liegen herum.“"
                            },
                            {
                                "example_id": "7f3af3a2-ac60-486a-96ed-b5582cc3ceed",
                                "sense_id": "ceaeddab-13d0-37fa-9a48-a62155aad654",
                                "text": "„Kippenstummel auf der Straße sind erkennbar und Gardinen im Fenster: Noch nie hat es ein so facettenreiches Bild von London gegeben.“"
                            },
                            {
                                "example_id": "9e990895-f571-4bdc-8009-8e29e3579164",
                                "sense_id": "ceaeddab-13d0-37fa-9a48-a62155aad654",
                                "text": "„Kippenstummel im Sand würden nicht wirklich als Problem wahrgenommen.“"
                            },
                            {
                                "example_id": "350bf6e7-da8f-4923-aa64-07eece5caf01",
                                "sense_id": "ceaeddab-13d0-37fa-9a48-a62155aad654",
                                "text": "„Der Blick nach innen: dunkle Flure, verschmierte Wände, kaputte Türen, ungesicherte Drähte, Kippenstummel, Müll, Pfützen, Hundescheiße.“"
                            }
                        ],
