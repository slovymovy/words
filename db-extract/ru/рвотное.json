                        "target_lang_word": "Brechmittel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brechmittel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0fe5bbe6-f6ad-3826-9728-c9e224088e1b",
                                        "entry_id": "01692856-65a8-3645-b7af-2148ed6099f2",
                                        "glosses": [
                                            "Medikament, welches Erbrechen auslöst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dec9cdf-ea2f-4891-a2ef-233445fb2e8a",
                                                "sense_id": "0fe5bbe6-f6ad-3826-9728-c9e224088e1b",
                                                "text": "„Die Befragung Scherfs sollte klären, welche politischen Vorgaben es 2004 zum Einsatz von Brechmitteln bei mutmaßlichen Drogendealern gab.“"
                                            },
                                            {
                                                "example_id": "c7c49594-6b5c-4584-8aa5-b40a18393b6a",
                                                "sense_id": "0fe5bbe6-f6ad-3826-9728-c9e224088e1b",
                                                "text": "„Sie lasen die Verordnungen der Ärzte und waren sehr erstaunt, daß Beruhigungsmittel manchmal aufregend, daß Brechmittel zuweilen wie Abführmittel wirken, daß ein und dasselbe Heilmittel bei verschiedenen Krankheiten hilft und daß eine Krankheit durch einander entgegengesetzte Behandlungsmethoden verschwindet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
