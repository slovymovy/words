                        "examples": [
                            {
                                "example_id": "b4981a86-f2c1-4060-a164-03507397f2c8",
                                "sense_id": "6a1469f0-87c4-3f43-aefd-052f0aab7654",
                                "text": "Going a foote, I shall durty my selfe up to my waste; and little men, going alongst our streets, are subject (for want of presentiall apparence) to be justled or elbowed."
                            },
                            {
                                "example_id": "88a787e0-6709-45eb-9b5b-13dcbe54d813",
                                "sense_id": "6a1469f0-87c4-3f43-aefd-052f0aab7654",
                                "text": "The ſunne and all the ſtarres that do appear / She [Psyche] feels them in herſelf, can diſtance all, / For ſhe is at each one purely preſentiall."
                            },
                            {
                                "example_id": "ef325156-da6f-4fe9-8a5f-7c13b8927ea4",
                                "sense_id": "6a1469f0-87c4-3f43-aefd-052f0aab7654",
                                "text": "God's mercies are made presential to us."
                            }
                        ]
