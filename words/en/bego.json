{
    "word_family": [
        "begone"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a95dbe80-9034-35d1-9e81-4ff644ec919e",
                    "sense_definition": "To surround or encompass, often with hostile intent.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "surround",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers <w>bego</w> the fortress from all sides to prevent escape.",
                            "target_lang_translations": {
                                "de": "Die Soldaten <w>umzingeln</w> die Festung von allen Seiten, um eine Flucht zu verhindern."
                            }
                        },
                        {
                            "text": "Dark clouds <w>bego</w> the mountain peak as the storm approaches.",
                            "target_lang_translations": {
                                "de": "Dunkle Wolken <w>umhüllen</w> den Berggipfel, während das Unwetter aufzieht."
                            }
                        }
                    ],
                    "synonyms": [
                        "surround",
                        "encompass",
                        "beset"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This term is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas umgeben oder umschließen, oft mit feindseliger Absicht."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "umzingeln",
                                "target_lang_sense_clarification": "jemanden oder etwas von allen Seiten einschließen"
                            },
                            {
                                "target_lang_word": "belagern",
                                "target_lang_sense_clarification": "einen Ort umstellen, um ihn einzunehmen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96411f67-f864-3640-ad75-987ff902a38a",
                    "sense_definition": "To affect or influence someone, often used in the context of a state of being.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "affect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traveler was woe <w>begone</w> after losing his way in the forest.",
                            "target_lang_translations": {
                                "de": "Der Reisende war <w>von Kummer erfüllt</w>, nachdem er sich im Wald verlaufen hatte."
                            }
                        },
                        {
                            "text": "She felt <w>begone</w> by the sudden news of her friend's departure.",
                            "target_lang_translations": {
                                "de": "Sie fühlte sich <w>betroffen</w> von der plötzlichen Nachricht über die Abreise ihres Freundes."
                            }
                        }
                    ],
                    "synonyms": [
                        "affect",
                        "influence"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Primarily found in older literature."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Jemanden in einen bestimmten Zustand versetzen oder beeinflussen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "erfüllen",
                                "target_lang_sense_clarification": "von einem Gefühl oder Zustand durchdrungen sein"
                            },
                            {
                                "target_lang_word": "betreffen",
                                "target_lang_sense_clarification": "auf jemanden einwirken oder jemanden in Mitleidenschaft ziehen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c8dc9a1-b11c-30d9-b85f-a2638e7eb5e3",
                    "sense_definition": "To leave or disappear.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "leave",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mysterious figure <w>bewent</w> into the shadows before anyone could speak.",
                            "target_lang_translations": {
                                "de": "Die geheimnisvolle Gestalt <w>verschwand</w> im Schatten, bevor jemand sprechen konnte."
                            }
                        },
                        {
                            "text": "He <w>bewent</w> quickly when he realized he was not welcome.",
                            "target_lang_translations": {
                                "de": "Er <w>ging</w> schnell <w>fort</w>, als er merkte, dass er nicht willkommen war."
                            }
                        }
                    ],
                    "synonyms": [
                        "depart",
                        "vanish",
                        "leave"
                    ],
                    "antonyms": [
                        "arrive",
                        "appear"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older texts to describe departure."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Einen Ort verlassen oder verschwinden."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "fortgehen",
                                "target_lang_sense_clarification": "einen Ort verlassen"
                            },
                            {
                                "target_lang_word": "verschwinden",
                                "target_lang_sense_clarification": "sich aus dem Sichtfeld entfernen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a19bbdce-765c-3bf0-9ac9-5de32f9a5ddf",
                    "sense_definition": "To clothe or dress.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "clothe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king was <w>begone</w> in fine silk robes for the ceremony.",
                            "target_lang_translations": {
                                "de": "Der König war für die Zeremonie in feine Seidengewänder <w>gekleidet</w>."
                            }
                        },
                        {
                            "text": "They <w>begone</w> themselves in warm furs for the winter journey.",
                            "target_lang_translations": {
                                "de": "Sie <w>hüllten</w> sich für die Winterreise in warme Pelze."
                            }
                        }
                    ],
                    "synonyms": [
                        "clothe",
                        "dress",
                        "attire"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Extremely rare usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Jemanden bekleiden oder ausstatten."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "bekleiden",
                                "target_lang_sense_clarification": "jemandem Kleidung anlegen"
                            },
                            {
                                "target_lang_word": "einhüllen",
                                "target_lang_sense_clarification": "jemanden in Stoff oder Kleidung einwickeln"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bf3279fe-38a4-304a-b05c-cd51e304da76",
                    "sense_definition": "A difficult situation or circumstance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "situation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He struggled to overcome the many <w>begoes</w> of his difficult life.",
                            "target_lang_translations": {
                                "de": "Er kämpfte darum, die vielen <w>Notlagen</w> seines schwierigen Lebens zu überwinden."
                            }
                        },
                        {
                            "text": "The <w>begoes</w> of the modern world can be overwhelming for many people.",
                            "target_lang_translations": {
                                "de": "Die <w>Bedrängnisse</w> der modernen Welt können für viele Menschen überwältigend sein."
                            }
                        }
                    ],
                    "synonyms": [
                        "circumstance",
                        "situation",
                        "predicament"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in contemporary English."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine schwierige Situation oder Lebenslage."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Notlage",
                                "target_lang_sense_clarification": "eine schwierige, bedrängende Situation"
                            },
                            {
                                "target_lang_word": "Bedrängnis",
                                "target_lang_sense_clarification": "ein Zustand, in dem man sich in Schwierigkeiten befindet"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}