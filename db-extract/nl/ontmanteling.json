                        "examples": [
                            {
                                "example_id": "0e8e30a2-4680-4e23-bec1-b37a58c1d8c0",
                                "sense_id": "af3f1f48-9e05-3a55-b72a-2c58144465f0",
                                "text": "Volgens de burgemeester hebben inwoners tijdens de ontmanteling van het depot waarschijnlijk wel de mogelijkheid om tijdelijk terug te gaan om hun huizen en tuinen te onderhouden."
                            },
                            {
                                "example_id": "4d9b0eae-0aac-472a-8530-23351f987c2b",
                                "sense_id": "af3f1f48-9e05-3a55-b72a-2c58144465f0",
                                "text": "Bouwvakkers in Sint-Petersburg waren bezig met de ontmanteling van het dak toen plots het hele stadion bezweek. Het stadion is een van de grootste arena's van Europa. Zo'n 80% van het gebouw is ingestort. Eén man kwam daarbij om het leven."
                            }
                        ]
                    }
