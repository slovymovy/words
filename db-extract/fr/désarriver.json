                        "entry_id": "84da91a0-b916-39d3-8b6f-06ad616c0265",
                        "glosses": [
                            "Cesser d’être arrivé. Ne pas se produire."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a6d62e11-6de9-405a-9d9c-7c1348638c70",
                                "sense_id": "500282b2-e886-3259-9ab0-d5cff7e2af74",
                                "text": "Moi, il ne m'arrive rien, Milou, il me désarrive..."
                            },
                            {
                                "example_id": "26c014b3-6b7a-41e0-be87-de1a2e3d6eb7",
                                "sense_id": "500282b2-e886-3259-9ab0-d5cff7e2af74",
                                "text": "Je pourrais rester ici toute la nuit. Comme pour prévenir l'événement, pour faire en sorte qu'il désarrive."
                            }
                        ]
                    }
