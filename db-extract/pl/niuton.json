                                "target_senses": [
                                    {
                                        "sense_id": "4d72fe1e-efff-3760-b51f-b6c1f6185d83",
                                        "entry_id": "74bbd12d-cfcd-39be-a734-356fb6a91d42",
                                        "glosses": [
                                            "seit 1948 die im internationalen Einheitensystem (SI) für die physikalische Größe Kraft verwendete Maßeinheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e663d6f-961b-4515-ad33-55a5012a67ca",
                                                "sense_id": "4d72fe1e-efff-3760-b51f-b6c1f6185d83",
                                                "text": "„Ein Newton ist die Größe der Kraft, die aufgebracht werden muss, um einen ruhenden Körper der Masse 1 kg innerhalb einer Sekunde gleichförmig auf die Geschwindigkeit 1 m/s zu beschleunigen.“"
                                            },
                                            {
                                                "example_id": "fa59aecd-3700-4d7e-bb33-46a77c961fe2",
                                                "sense_id": "4d72fe1e-efff-3760-b51f-b6c1f6185d83",
                                                "text": "„Das Kilopond ist per Gesetz seit 1. Januar 1978 in Deutschland für die Angabe der Kraft unzulässig und wurde durch das Newton ersetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Newton",
                                "target_lang_code": "de",
                                "target_senses": [
