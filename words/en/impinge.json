{
    "word_family": [
        "impingement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "14e0bfda-a6e8-31e7-b6a0-3ff1adfb3564",
                    "sense_definition": "To make a physical impact on something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_contact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Loud noise can <w>impinge</w> on the eardrum, causing temporary hearing damage.",
                            "target_lang_translations": {
                                "ru": "Громкий шум может <w>воздействовать</w> на барабанную перепонку, вызывая временное ухудшение слуха."
                            }
                        },
                        {
                            "text": "The laser beam was directed to <w>impinge</w> on the target surface.",
                            "target_lang_translations": {
                                "ru": "Лазерный луч был направлен так, чтобы <w>падать</w> на поверхность мишени."
                            }
                        }
                    ],
                    "synonyms": [
                        "strike",
                        "impact"
                    ],
                    "common_phrases": [
                        "impinge on"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оказывать физическое воздействие, ударяться о поверхность или падать на неё."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "падать",
                                "target_lang_sense_clarification": "о лучах, звуке, волнах на поверхность"
                            },
                            {
                                "target_lang_word": "ударяться",
                                "target_lang_sense_clarification": "сталкиваться с поверхностью"
                            },
                            {
                                "target_lang_word": "воздействовать",
                                "target_lang_sense_clarification": "оказывать физическое воздействие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2be2e2ee-ec32-3920-9ba0-51c37a5cddab",
                    "sense_definition": "To interfere with or restrict someone or something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "interference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new regulations must not <w>impinge</w> on the rights of individual citizens.",
                            "target_lang_translations": {
                                "ru": "Новые правила не должны <w>ущемлять</w> права отдельных граждан."
                            }
                        },
                        {
                            "text": "State sovereignty is a bedrock principle that the federal government cannot <w>impinge</w> upon.",
                            "target_lang_translations": {
                                "ru": "Суверенитет штатов — это основополагающий принцип, на который федеральное правительство не может <w>посягать</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "encroach",
                        "infringe",
                        "limit"
                    ],
                    "common_phrases": [
                        "impinge upon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вмешиваться во что-либо, нарушать чьи-либо границы или ограничивать права и свободы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посягать",
                                "target_lang_sense_clarification": "на права, свободы, суверенитет"
                            },
                            {
                                "target_lang_word": "ущемлять",
                                "target_lang_sense_clarification": "ограничивать права или интересы"
                            },
                            {
                                "target_lang_word": "нарушать",
                                "target_lang_sense_clarification": "вмешиваться, вторгаться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ea60014-3a0b-3946-9818-0360b254bf97",
                    "sense_definition": "To have a noticeable effect on something, often in a negative way.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "interference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Daily stress began to <w>impinge</w> on his ability to focus at work.",
                            "target_lang_translations": {
                                "ru": "Ежедневный стресс начал <w>сказываться</w> на его способности сосредоточиться на работе."
                            }
                        },
                        {
                            "text": "External economic factors <w>impinge</w> on the growth of small businesses.",
                            "target_lang_translations": {
                                "ru": "Внешние экономические факторы негативно <w>влияют</w> на рост малого бизнеса."
                            }
                        }
                    ],
                    "synonyms": [
                        "affect",
                        "influence"
                    ],
                    "common_phrases": [
                        "impinge on"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оказывать заметное, чаще всего негативное влияние на что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сказываться",
                                "target_lang_sense_clarification": "отрицательно влиять на результат или состояние"
                            },
                            {
                                "target_lang_word": "отражаться",
                                "target_lang_sense_clarification": "оказывать заметное влияние"
                            },
                            {
                                "target_lang_word": "влиять",
                                "target_lang_sense_clarification": "производить ощутимый эффект"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}