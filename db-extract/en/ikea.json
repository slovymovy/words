                "senses": [
                    {
                        "sense_id": "f1d392fe-ea10-32c0-86ac-7b1c5bfe1234",
                        "entry_id": "4aed10ae-25e8-35e4-8f41-8b48c6a6a641",
                        "glosses": [
                            "An international, originally Swedish home products retailer that sells modern, utilitarian design furniture, much of which is assembled by the consumer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87a04d92-a052-487f-8ad2-d1c2647ea347",
                                "sense_id": "f1d392fe-ea10-32c0-86ac-7b1c5bfe1234",
                                "text": "Instruct the servant robot to clean the house, landscape the yard, and assemble several major pieces of IKEA furniture. Then, when your robot is power depleted and attempts to recharge, shut off the power to your house."
                            },
                            {
                                "example_id": "9cee154a-5260-4754-a83f-e035c389edff",
                                "sense_id": "f1d392fe-ea10-32c0-86ac-7b1c5bfe1234",
                                "text": "It seems Swedish gangs, apparently no longer satisfied with knocking over their local IKEA’s, have taken to sneaking little people into the cargo holds of the buses by stowing them in suitcases."
                            }
                        ]
                    }
                ],
