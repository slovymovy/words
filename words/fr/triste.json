                    ]
                },
                {
                    "sense_id": "0b06deaa-1888-3ffc-b35d-7cde54a11f0f",
                    "sense_definition": "Qui est sombre, morne, sans éclat ou sans animation réjouissante.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "aspect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avec ce ciel gris et cette pluie continue, le temps est particulièrement <w>triste</w>."
                        },
                        {
                            "text": "Cette pièce sans fenêtres paraît bien <w>triste</w> malgré les quelques lampes allumées."
