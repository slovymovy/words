                        "großzügiges Trinkgeld"
                    ]
                },
                {
                    "sense_id": "afa2813f-0548-3845-81a6-eae3d0aa6bfc",
                    "sense_definition": "Sehr geringer, unzureichender Geldbetrag oder eine spöttisch geringe Bezahlung.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "Geringer Betrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Für dieses lächerliche <w>Trinkgeld</w> werde ich bestimmt keine Überstunden am Wochenende machen."
                        },
                        {
                            "text": "Er weigert sich entschieden, seine qualifizierte Arbeitskraft für ein bloßes <w>Trinkgeld</w> anzubieten."
                        }
                    ],
                    "common_phrases": [
