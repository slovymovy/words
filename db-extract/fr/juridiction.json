                                        "sense_id": "bf4e2002-c494-302e-8b6a-56b6dd749a15",
                                        "entry_id": "8b47f9bc-1eb6-3716-9d76-fc6fe17c1ee3",
                                        "glosses": [
                                            "Poder y autoridad para juzgar y para interpretar y aplicar las leyes."
                                        ],
                                        "tags": [
                                            "Derecho"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8834cc75-fe37-4188-b37a-d0874381110f",
                                                "sense_id": "bf4e2002-c494-302e-8b6a-56b6dd749a15",
                                                "text": "«La jurisdicción es una función pública que se ejerce en nombre de los pueblos y que consiste en conocer y juzgar, por medio de un debido proceso, los conflictos de relevancia jurídica y hacer ejecutar lo resuelto, conforme a la Constitución y las leyes, […]»."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6a4f9fa4-8d6a-393c-8ffa-34f24d1daf41",
                                        "entry_id": "8b47f9bc-1eb6-3716-9d76-fc6fe17c1ee3",
                                        "glosses": [
                                            "Autoridad o poder sobre algo o alguien."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9289253c-b26e-3664-a8b9-b908dded1a4b",
                                        "entry_id": "8b47f9bc-1eb6-3716-9d76-fc6fe17c1ee3",
                                        "glosses": [
                                            "Territorio en el que se ejerce una autoridad para gobernar y hacer ejecutar las leyes."
                                        ],
