        "fr-extract.jsonl": [
            {
                "entry_id": "f0a58340-1d53-358d-94c0-58771d991680",
                "word": "aubade",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0ee56106-8c87-4366-b21c-693fd089264f",
                        "entry_id": "f0a58340-1d53-358d-94c0-58771d991680",
                        "tags": [
                            "plural"
                        ],
                        "form": "aubades"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "13e23b1f-e8d4-3a5e-8648-dae4b50d93d7",
                        "entry_id": "f0a58340-1d53-358d-94c0-58771d991680",
                        "glosses": [
                            "Concert donné en plein air, vers l’aube, à la porte ou sous les fenêtres d’une personne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7aa649a7-29ff-4c14-8da5-9399abb15941",
                                "sense_id": "13e23b1f-e8d4-3a5e-8648-dae4b50d93d7",
                                "text": "Donner une aubade."
                            },
                            {
                                "example_id": "35c1c40b-a12c-4dc5-bfa3-edad18d8b663",
                                "sense_id": "13e23b1f-e8d4-3a5e-8648-dae4b50d93d7",
                                "text": "Après la parade, Lucien fut d’inspection à la caserne ; à peine rentré chez lui, les trente-six trompettes vinrent sous ses fenêtres lui donner une aubade agréable."
                            },
                            {
                                "example_id": "d99b6a3f-68de-4d0c-ac8b-9e2b60f93886",
                                "sense_id": "13e23b1f-e8d4-3a5e-8648-dae4b50d93d7",
                                "text": "Cette coutume s’appelait aubade. Chaque année au 14 juillet, la fanfare municipale se divisait ainsi en petites formations de trois ou quatre musiciens qui allaient, sur le coup de sept heures du matin, réveiller en musique les notabilités de la ville et, quelquefois aussi, une demoiselle auprès de qui l’un de ces messieurs voulait se distinguer."
                            },
                            {
                                "example_id": "2d16d7dc-13c5-448c-8002-3e46bb8cc5d5",
                                "sense_id": "13e23b1f-e8d4-3a5e-8648-dae4b50d93d7",
                                "text": "J’ai graissé la patte au berger\nPour lui faire jouer une aubade"
                            },
                            {
                                "example_id": "8fe4ca6e-ca39-475a-9bf5-3228dfa86344",
                                "sense_id": "13e23b1f-e8d4-3a5e-8648-dae4b50d93d7",
                                "text": "Sûr, faut que je chante\nMon aubade à Lydie :\nÔ ma Lydie tu hantes\nMes rudes rêves au lit\nDis ! Tu me séduis en te\nRiant de mes ridicules\nEt vaines tentatives de conciliations\nAvec tes tantes hâtives à te marier\nAvec un marchand de tapis né à Tunis"
                            }
                        ]
                    },
                    {
                        "sense_id": "26ff3ba4-5420-342b-a1ee-0f1f17659949",
                        "entry_id": "f0a58340-1d53-358d-94c0-58771d991680",
                        "glosses": [
                            "Insulte, avanie, peur faite avec vacarme à quelqu’un."
                        ],
                        "tags": [
                            "familiar",
                            "ironic"
                        ],
                        "examples": [
                            {
                                "example_id": "858695b6-bd4c-4438-be0f-59e0b649214b",
                                "sense_id": "26ff3ba4-5420-342b-a1ee-0f1f17659949",
                                "text": "Il a eu une furieuse aubade."
                            },
                            {
                                "example_id": "5e3b72a7-893a-4e0c-9e5e-dc65743df858",
                                "sense_id": "26ff3ba4-5420-342b-a1ee-0f1f17659949",
                                "text": "Qu'il aille au diable avec sa sérénade,\nJe vais songer à lui donner l’aubade, moi."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "206787e6-44ea-446f-bfcf-69f972b5dce7",
                        "source_entry_id": "f0a58340-1d53-358d-94c0-58771d991680",
                        "target_lang_word": "Ständchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ständchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aa976410-8a9e-3dff-879a-ea9b2b59a99a",
                                        "entry_id": "74c263c8-de04-39b2-9ad8-ba6d09a6d447",
                                        "glosses": [
                                            "kleiner Stand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b26b6d10-939b-4859-985c-17dbc7bfa95e",
                                                "sense_id": "aa976410-8a9e-3dff-879a-ea9b2b59a99a",
                                                "text": "Jeden Samstag verkauft sie an einem Ständchen auf dem Wochenmarkt ihre selbstgemachten Marmeladen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "079dd64f-d4b8-3499-94d6-07cbbe77717d",
                                        "entry_id": "74c263c8-de04-39b2-9ad8-ba6d09a6d447",
                                        "glosses": [
                                            "kleines Musikstück, das jemandem zu Ehren auf einer Feier oder vor seinem Haus gespielt oder gesungen wird"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0faff0f0-95e9-4b5a-8558-f35f7d4fd565",
                                                "sense_id": "079dd64f-d4b8-3499-94d6-07cbbe77717d",
                                                "text": "Zu Opas 80. Geburtstag haben wir ihn im Krankenhaus mit einem Ständchen überrascht."
                                            },
                                            {
                                                "example_id": "88d51d6c-ec6c-4d26-b050-f785feb5d8aa",
                                                "sense_id": "079dd64f-d4b8-3499-94d6-07cbbe77717d",
                                                "text": "„Zwar geschah es an diesem Neujahrstag sozusagen vor der falschen Verwandtschaft, der Verwandtschaft mütterlicherseits, doch ich holte das missglückte Ständchen zum Geburtstag des falschen Großvaters in Rüpprich nun in Dondorf nach.“"
                                            },
                                            {
                                                "example_id": "a5775f18-a09c-49b2-b4c2-108f9e0bc276",
                                                "sense_id": "079dd64f-d4b8-3499-94d6-07cbbe77717d",
                                                "text": "„Sie glaubt, das Ständchen gelte ihr.“"
                                            },
                                            {
                                                "example_id": "d32a935a-a513-4d50-b96a-acd4659dfdc9",
                                                "sense_id": "079dd64f-d4b8-3499-94d6-07cbbe77717d",
                                                "text": "„Ich schlummere süß und werde mit Blockflötentönen geweckt – Heinrike spielt ein Ständchen vor der Tür.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "adc01371-b399-44ac-bcd6-9d01d4efa648",
                        "source_entry_id": "f0a58340-1d53-358d-94c0-58771d991680",
                        "target_lang_word": "Morgenständchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "265ac9ee-a859-47f2-9f3b-ef24a85fcfca",
