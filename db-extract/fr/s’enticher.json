                "senses": [
                    {
                        "sense_id": "cc0149fe-61b9-39b9-9843-400d1b7fa049",
                        "entry_id": "2bc5a93f-2682-3447-9d5d-05bad3d18b65",
                        "glosses": [
                            "Se prendre d'une passion vive et irréfléchie, d'un goût subit, provisoire (voire éphémère) et excessif pour quelqu'un ou pour quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df2accf5-9ceb-470a-ae77-f8751a132609",
                                "sense_id": "cc0149fe-61b9-39b9-9843-400d1b7fa049",
                                "text": "C’est drôle qu’il se fût plutôt entiché de la gamine... Céline Thiébault pourtant était plus en rapport d’âge avec lui. Ce n’eût été ni moins décent, ni moins excusable."
                            },
                            {
                                "example_id": "133a0001-098c-4396-af56-4b4e3e318140",
                                "sense_id": "cc0149fe-61b9-39b9-9843-400d1b7fa049",
                                "text": "Entre l’addictologie et Laurent Karila, c’est une histoire d’affect qui dure. Après un internat de psychiatrie, il s’entiche rapidement de la science des dépendances."
                            }
                        ]
                    }
                ],
