                                        "glosses": [
                                            "riconoscimento di una malattia"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "254ae1eb-bf24-4779-8902-cca09a411d12",
                                                "sense_id": "cab66a29-8b24-3407-b36e-fa896d77ebde",
                                                "text": "la diagnosi genetica e i progressi della medicina hanno cambiato il quadro delle malattie ereditarie"
                                            }
                                        ]
                                    },
