                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b07af170-783c-3e3c-8669-9eaee8f63a60",
                                        "entry_id": "0e5e7646-ee87-3f61-82b1-aa073ad82a5f",
                                        "glosses": [
                                            "medizinisches Gerät: kleines, zweischneidiges Messer oder Nadel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf3e9087-ca2c-463e-817e-40b069baafcd",
                                                "sense_id": "b07af170-783c-3e3c-8669-9eaee8f63a60",
                                                "text": "„Ich weiß nicht, was mich Halbtoten veranlaßte, die Augen zu öffnen; da sah ich den Mann mit der Lanzette, der dabei war, mir die Vene aufzustechen.“"
                                            },
                                            {
                                                "example_id": "e76c384a-28cb-45d0-98e4-7f0cdb7c8b97",
                                                "sense_id": "b07af170-783c-3e3c-8669-9eaee8f63a60",
                                                "text": "„Nun legten sie großen Eifer für die Schutzpockenimpfung an den Tag, lernten an Kohlblättern zur Ader lassen und schafften sich sogar ein paar Lanzetten an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
