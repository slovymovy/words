                                    {
                                        "sense_id": "e7b88515-fc19-324c-b8d6-02f292fc19ff",
                                        "entry_id": "1b5c3250-99a0-3cd3-ba39-502a7f670a40",
                                        "glosses": [
                                            "Qui relève de l’Ordre des chartreux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a5b3c52-b37b-46d9-a1c0-5e9120849067",
                                                "sense_id": "e7b88515-fc19-324c-b8d6-02f292fc19ff",
                                                "text": "Cœur de la vie cartusienne, l’église sert aux liturgies communes, les matines et les laudes de l’office canonial après minuit, la messe du matin, les vêpres de l’office canonial l’après-midi."
                                            },
                                            {
                                                "example_id": "0b763589-62a7-40b5-96f5-ce9d4e4fc631",
                                                "sense_id": "e7b88515-fc19-324c-b8d6-02f292fc19ff",
                                                "text": "On sait, d'ailleurs, que les Chartreux ont été de rudes écrivains. Une bibliothèque exclusivement cartusienne donnerait une liste d'au moins huit cents auteurs et cette liste resterait encore au-dessous de la vérité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3068dba6-2802-336a-bf5a-d3201d8938ca",
                                        "entry_id": "1b5c3250-99a0-3cd3-ba39-502a7f670a40",
                                        "glosses": [
                                            "Relatif à Sainte-Croix-en-Jarez, commune française située dans le département de la Loire."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
