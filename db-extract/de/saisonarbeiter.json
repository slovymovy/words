                    {
                        "translation_id": "758e32a0-3d41-4a57-8302-778fe88d6f73",
                        "source_entry_id": "62b5fcc6-bcaf-316e-9127-9c4600012b68",
                        "source_sense_id": "1af7b1a8-70a0-39a3-a741-e0004cef7a45",
