                "senses": [
                    {
                        "sense_id": "e4d08486-6f12-3fb4-a202-599a2e54ad6b",
                        "entry_id": "f1866e11-de6c-3bac-8827-188e291a1ecf",
                        "glosses": [
                            "kleines tragbares Gerät mit Kopfhörern zum Abspielen von Kassetten"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "ec501713-bbaf-40f0-907f-4d6584c7ff9a",
                                "sense_id": "e4d08486-6f12-3fb4-a202-599a2e54ad6b",
                                "text": "Als junges Mädchen hat sie den ganzen Tag Musik auf ihrem Walkman gehört."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "136b1187-7c73-43e5-af5a-9dd2c035fa38",
                        "source_entry_id": "f1866e11-de6c-3bac-8827-188e291a1ecf",
                        "source_sense_id": "e4d08486-6f12-3fb4-a202-599a2e54ad6b",
                        "source_sense_description": "Technik, Musik: kleines tragbares Gerät mit Kopfhörern zum Abspielen von Kassetten",
                        "target_lang_word": "Walkman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Walkman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d019496a-a22b-319f-b72e-f83c8d8d8be3",
                                        "entry_id": "2588e15f-4083-3fe0-a517-dedb19ba491c",
                                        "glosses": [
                                            "A Sony portable personal compact cassette player product line."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0ef6707-5e01-4f09-b56d-f127fa9fea96",
                                                "sense_id": "d019496a-a22b-319f-b72e-f83c8d8d8be3",
                                                "text": "He places the Walkman in the case alongside a Panasonic wallet-size cordless portable finding Easa-phone (he used to own the NEC 9000 Porta portable) and pulls out today’s newspaper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e99d594d-e665-3b05-acc3-b8c82290ba30",
                                        "entry_id": "2588e15f-4083-3fe0-a517-dedb19ba491c",
                                        "glosses": [
                                            "A Sony brand for personal portable audio media players."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6a6f123-241b-41f3-944b-490b48bda8a7",
                                                "sense_id": "e99d594d-e665-3b05-acc3-b8c82290ba30",
                                                "text": "Outside the toilets school parties from France and Germany stood in stiff groups photographing themselves. They talked loudly without removing their Walkmans. Their headsets sizzled and tished."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "861f2a24-6064-3dac-9b95-fd3524f78eae",
                                        "entry_id": "2588e15f-4083-3fe0-a517-dedb19ba491c",
                                        "glosses": [
                                            "A street urchin."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Walkman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a17202b3-c554-3b7c-b8d9-3659aeded804",
                                        "entry_id": "21c733b3-50df-3ad0-be83-eec3e947e89d",
                                        "glosses": [
                                            "Alternative letter-case form of walkman."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7386b024-b222-4e39-987e-ce18d9d92f77",
                                                "sense_id": "a17202b3-c554-3b7c-b8d9-3659aeded804",
                                                "text": "But it took a decade to make any impression on the mainstream – people stuck with cassettes for recording, and Walkmen and Discmen for portability – and almost as soon as it did, it was killed by the MP3 player."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
