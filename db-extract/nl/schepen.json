                    {
                        "translation_id": "e5374c85-fcc3-4f78-8e96-d49157a2ac84",
                        "source_entry_id": "f73697ec-0dba-3257-a4f8-e3cae8cf41c3",
                        "source_sense_id": "38c63334-ecc1-37d5-b54f-6ef859e2fc33",
