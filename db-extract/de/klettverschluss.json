                                                "example_id": "4821c5f6-09a3-4c35-90eb-9595be8df92a",
                                                "sense_id": "80a07b67-e4e4-38c3-a5f5-31bc2977b9e1",
                                                "text": "Two officers stormed into I-tier, still Velcroing their flak jackets."
