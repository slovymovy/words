                "forms": [],
                "senses": [
                    {
                        "sense_id": "41128155-5b86-3e0e-9cb2-22881dce36fa",
                        "entry_id": "db51404a-d571-3fd5-b081-e19e64863bdc",
                        "glosses": [
                            "Antikörper"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "302a1fa5-e120-4bd3-a05a-c7500d5fed93",
                        "source_entry_id": "db51404a-d571-3fd5-b081-e19e64863bdc",
                        "source_sense_id": "41128155-5b86-3e0e-9cb2-22881dce36fa",
                        "source_sense_description": "Antikörper",
                        "target_lang_word": "Antikörper",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antikörper",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4c9c455b-adb9-3218-9886-da22e634c4fe",
                                        "entry_id": "0fe51076-325e-30cd-9c3e-d64c1bfb2dd4",
                                        "glosses": [
                                            "Abwehrstoff im Blut – zentrale Bestandteile des Immunsystems, die der Körper zur Abwehr fremder Substanzen bildet"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3940e3e9-46ee-4371-a0ed-ca50530a4fea",
                                                "sense_id": "4c9c455b-adb9-3218-9886-da22e634c4fe",
                                                "text": "Antikörper werden in den weißen Blutkörperchen gebildet."
                                            },
                                            {
                                                "example_id": "81a5ae8a-a244-4d2f-bc4d-c80bb2f54d4c",
                                                "sense_id": "4c9c455b-adb9-3218-9886-da22e634c4fe",
                                                "text": "Die Immunzellen produzieren Antikörper, wenn körperfremde Erreger erkannt werden."
                                            },
                                            {
                                                "example_id": "5b1a30b6-2e02-4a22-960a-c11401c7386e",
                                                "sense_id": "4c9c455b-adb9-3218-9886-da22e634c4fe",
                                                "text": "„Beim Eindringen artfremden Eiweißes (Antigene) in das Blut werden in Plasmazellen des Knochenmarks und im lymphatischen Gewebe hochspezifische Abwehrstoffe (Antitoxine, Antikörper) gebildet und in das Blut abgegeben.“"
                                            },
                                            {
                                                "example_id": "8f30644d-040a-4d0c-af74-7221d56a42a3",
                                                "sense_id": "4c9c455b-adb9-3218-9886-da22e634c4fe",
                                                "text": "„Dafür, dass Impfstoffe […] nicht alle Menschen schützen können, gibt es mehrere Gründe: In manchen Fällen reagiert das Immunsystem nicht auf den Impfstoff und bildet keine Antikörper - das kann etwa bei Personen mit einer Immunschwäche der Fall sein […].“"
                                            },
                                            {
                                                "example_id": "45f41b5a-dd1c-4495-a5ef-086236df0934",
                                                "sense_id": "4c9c455b-adb9-3218-9886-da22e634c4fe",
                                                "text": "„Frauen bilden effektiver Antikörper, bei Impfungen fällt ihre Immunantwort daher stärker aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
