                        "form": "молодняке́"
                    },
                    {
                        "form_id": "5a09cb63-b99c-4518-91b2-04f567db1a3e",
                        "entry_id": "86635e1b-deeb-3224-880f-8f2150966b82",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "молодняка́х"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "adbbd06a-7522-3c55-80a2-8c111a69a50a",
                        "entry_id": "86635e1b-deeb-3224-880f-8f2150966b82",
                        "glosses": [
                            "собир. молодые животные"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9226df40-0d82-48b8-9cea-db25eb593833",
                                "sense_id": "adbbd06a-7522-3c55-80a2-8c111a69a50a",
                                "text": "Лисица близ норы со своим молодняком, тоже и барсук, куница. Начинает ходить с молодняком и рысь."
                            },
                            {
                                "example_id": "76f71618-e6a0-41b2-b346-656dd6fcb9c9",
                                "sense_id": "adbbd06a-7522-3c55-80a2-8c111a69a50a",
                                "text": "На скалистом островке держит недойный молодняк, на обильном кормовом ― дойный скот."
                            },
                            {
                                "example_id": "107b657c-235e-41ee-8fdf-4f25a9d506cf",
                                "sense_id": "adbbd06a-7522-3c55-80a2-8c111a69a50a",
                                "text": "Лебеди, гуси, утки, бакланы, шум, гам, стайки молодняка на крыло становятся по-над самой водой."
                            }
                        ]
                    },
                    {
                        "sense_id": "b5fddf4b-c3fe-310b-82fb-b0973eb4cf5d",
                        "entry_id": "86635e1b-deeb-3224-880f-8f2150966b82",
                        "glosses": [
                            "собир. молодой лес, поросль молодого леса"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7d09f6c-6952-4305-9fc9-a8937b3c6fe2",
                                "sense_id": "b5fddf4b-c3fe-310b-82fb-b0973eb4cf5d",
                                "text": "Здесь рос молодняк белой акации, посаженный всего два года тому назад, а потому было гораздо светлее, чем в саду."
                            },
                            {
                                "example_id": "6bb630ff-c16c-472b-b065-e7a2981a6af3",
                                "sense_id": "b5fddf4b-c3fe-310b-82fb-b0973eb4cf5d",
                                "text": "Сочнейший осокорь, молодняк из пеньков, по дороге выгнал такие листья, лопух-лопухом, что и поверить трудно было, что это трясучий осокорь."
                            },
                            {
                                "example_id": "eedbc219-0ecc-4a8b-b212-898e601a0dc1",
                                "sense_id": "b5fddf4b-c3fe-310b-82fb-b0973eb4cf5d",
                                "text": "Вновь появившийся молодняк состоит главным образом из осины, лиственницы и белой берёзы; ближе к морю, в горах, преобладают хвойные породы."
                            }
                        ]
                    },
                    {
                        "sense_id": "8f17a3b1-f795-3f7f-80f3-2968ed4f38c3",
                        "entry_id": "86635e1b-deeb-3224-880f-8f2150966b82",
                        "glosses": [
                            "собир., прост. молодые люди, молодёжь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aae54305-c862-43e5-a10b-c2cd5bbfe6ee",
                                "sense_id": "8f17a3b1-f795-3f7f-80f3-2968ed4f38c3",
                                "text": "Он может дать шанс молодняку и выиграть с ними чемпионат Англии〈…〉"
                            }
                        ]
                    }
                ],
