                "senses": [
                    {
                        "sense_id": "adc3bb60-5124-3384-af6d-18274553ae39",
                        "entry_id": "98ab45d5-ac12-313a-a1f0-fcfd509db53d",
                        "glosses": [
                            "Faire perdre son caractère rappelant la pensée et l’œuvre d’Aimé Césaire à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5d167ac-b737-4f20-8764-dccd896b3a82",
                                "sense_id": "adc3bb60-5124-3384-af6d-18274553ae39",
                                "text": "D’autres, plus distanciées dans le temps, affirmeront leur entière allégeance à cette poésie, refusant de “ \"décésairiser\" les mémoires ”, proposant de “ relire Césaire qui a choisi de s’identifier dangereusement ”."
                            },
                            {
                                "example_id": "c7353f27-70f1-44b7-90b8-cbe6b3011a6f",
                                "sense_id": "adc3bb60-5124-3384-af6d-18274553ae39",
                                "text": "« Il faut décésairiser tout cela », me dit-il après quelques instants de silence."
                            }
                        ]
                    }
                ],
