                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a2497641-b18d-352b-84e5-a19a1fb0d6c3",
                                        "entry_id": "bf0d094e-c19f-360f-94b4-5d5935b509a2",
                                        "glosses": [
                                            "To work (something); often with out."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0dc3d81d-91be-4485-9944-4f9a3d15ac9a",
                                                "sense_id": "a2497641-b18d-352b-84e5-a19a1fb0d6c3",
                                                "text": "places well toiled and husbanded"
                                            },
                                            {
                                                "example_id": "9d5fcecd-b146-4d53-ac8b-3592612d1be4",
                                                "sense_id": "a2497641-b18d-352b-84e5-a19a1fb0d6c3",
                                                "text": "[I] toiled out my uncouth passage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06bc1a5d-cb8c-33a1-a7a0-ded6990ff11c",
                                        "entry_id": "bf0d094e-c19f-360f-94b4-5d5935b509a2",
                                        "glosses": [
