                            "superlative"
                        ],
                        "form": "most terpsichorean"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2ff335aa-7b8a-36a7-8093-448e81c28dca",
                        "entry_id": "bdb413dc-cd90-3f13-9d56-86e91fa817c1",
                        "glosses": [
                            "Of or relating to dancing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dec9b782-f696-455f-9364-a7b4e36affec",
                                "sense_id": "2ff335aa-7b8a-36a7-8093-448e81c28dca",
                                "text": "The pair danced away with great agility and contentment,—first a waltz, then a galop, then a waltz again, until, in the second waltz, they were bumped by another couple who had joined the Terpsichorean choir."
                            },
                            {
                                "example_id": "a82614af-ffe6-4a07-b1d3-dbfa3c36467b",
                                "sense_id": "2ff335aa-7b8a-36a7-8093-448e81c28dca",
                                "text": "This was such an entirely new view of the Terpsichorean art as socially practised, that Mrs Lammle looked at her young friend in some astonishment"
                            },
                            {
                                "example_id": "b69bd2c5-5b2f-4c20-8999-beba955a44dd",
                                "sense_id": "2ff335aa-7b8a-36a7-8093-448e81c28dca",
                                "text": "They're quiet enough in the morning hours,\nThey're quiet enough in the afternoon,\nReserving their terpsichorean powers\nTo dance by the light of the Jellicle Moon."
                            },
                            {
                                "example_id": "2ced1622-7a43-4974-bd29-c7adc1e57cb1",
                                "sense_id": "2ff335aa-7b8a-36a7-8093-448e81c28dca",
                                "text": "Oh, heaven forbid: I am one who delights in all manifestations of the Terpsichorean muse!"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
