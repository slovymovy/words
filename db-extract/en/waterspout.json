                "senses": [
                    {
                        "sense_id": "6b01c47e-244a-37ee-a7b0-f3b28a732e43",
                        "entry_id": "ed48919c-8ca5-395b-b674-9bdc7fe89f41",
                        "glosses": [
                            "A whirlwind that forms over water, not associated with a mesocyclone of a thunderstorm (contrary to a true tornado)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ecea7776-c07c-36a5-91e5-b6c25b019eb8",
                        "entry_id": "ed48919c-8ca5-395b-b674-9bdc7fe89f41",
                        "glosses": [
                            "A true tornado that passes over a body of water."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "dda8a28f-fc09-3bc6-8273-dc0193a1507e",
                        "entry_id": "ed48919c-8ca5-395b-b674-9bdc7fe89f41",
                        "glosses": [
                            "A plume of water rising from the surface of a body of water as the result of an explosion or impact."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a3362eb-6939-491e-bcca-461fcc5bd871",
                                "sense_id": "dda8a28f-fc09-3bc6-8273-dc0193a1507e",
                                "text": "Basically, the problem was actually the British had too many ships! The Grand Fleet wasn't half bad with its gunnery, but there was so many battleships throwing fire at the battlecruisers and battleships of the High Seas Fleet that it was actually very difficult to tell \"Is that splash from us? Is that splash from that ship? Is that splash from a ship in another division? We don't know!\", so a lot of incorrect estimates and measures were taken, which lead to an awful lot of waterspouts going up, but not anywhere near the number of hits that you would otherwise expect[…]"
                            }
                        ]
                    },
                    {
                        "sense_id": "97dba1fe-10a4-3165-aaf2-89f1abf0a79e",
                        "entry_id": "ed48919c-8ca5-395b-b674-9bdc7fe89f41",
                        "glosses": [
                            "A channel through which water is discharged, especially from the gutters of a roof."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f2b3faf-47bf-4890-899d-5a500f67a47c",
                        "source_entry_id": "ed48919c-8ca5-395b-b674-9bdc7fe89f41",
                        "source_sense_description": "tornado that occurs over a body of water",
                        "target_lang_word": "waterhoos",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "waterhoos",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "82825c62-8865-3af7-93be-081c7af3a58c",
                                        "entry_id": "26e00001-04e7-3253-b53b-9c1c0ddf70f4",
                                        "glosses": [
                                            "een verzameling van water"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "234b7859-a24e-4ab9-a51b-eec6e11a7635",
                                                "sense_id": "82825c62-8865-3af7-93be-081c7af3a58c",
                                                "text": "Het zeil schoot los en er kwam een waterhoos naar beneden van het regenwater dat erop lag."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc5eebba-48de-3ec8-adc9-548dde3c8dbc",
                                        "entry_id": "26e00001-04e7-3253-b53b-9c1c0ddf70f4",
                                        "glosses": [
                                            "windhoos die water mee omhoog heeft gezogen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a07d75d7-ecef-4dc2-a57d-ab317f9e5c94",
                                                "sense_id": "cc5eebba-48de-3ec8-adc9-548dde3c8dbc",
                                                "text": "Volgens Weerplaza is een sterke waterhoos vanaf het water het land opgetrokken. Daardoor vlogen onder meer dakpannen in het rond en waaiden bomen om. Ter hoogte van Brouwershaven kwam een schip in de problemen, maar die kon \"op eigen kracht\" naar de haven varen, aldus de veiligheidsregio."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4861ea52-0dd1-4333-8ebc-de185156fb6c",
                        "source_entry_id": "ed48919c-8ca5-395b-b674-9bdc7fe89f41",
                        "source_sense_description": "tornado that occurs over a body of water",
                        "target_lang_word": "trombe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trombe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6cd809d7-43e2-3724-8a32-08b5ba58becc",
                                        "entry_id": "87d7a20f-f9ee-36e0-b825-904e6ab419ee",
                                        "glosses": [
                                            "Tornade, cyclone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a268cdba-7435-4fab-b011-7d18e00b103a",
                                                "sense_id": "6cd809d7-43e2-3724-8a32-08b5ba58becc",
                                                "text": "Des grenouilles, minuscules, vivantes, au moins trente grenouilles apportées à travers les airs par un caprice du Sud, par une trombe chaude, une de ces tornades dont le pied en pas de vis ramasse et porte à cent lieues un panache de sable, de graines, d’insectes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3223bd7-2c17-3546-bc2a-777d7e1f468f",
                                        "entry_id": "87d7a20f-f9ee-36e0-b825-904e6ab419ee",
                                        "glosses": [
                                            "Colonne d’eau qui, poussée par le vent, tourbillonne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5900c980-7f90-4ce8-be98-775acb1ffa03",
                                                "sense_id": "d3223bd7-2c17-3546-bc2a-777d7e1f468f",
                                                "text": "Le 13 décembre, une trombe, phénomène assez fréquent dans ces mers, s’avança vers les navires. Colomb et ses équipages en avaient vu précédemment dans les mers du nouveau monde et peut-être aussi sur les côtes Nord et Ouest d’Espagne."
                                            },
                                            {
                                                "example_id": "9d888c8e-103c-4372-b0f9-22701e142914",
                                                "sense_id": "d3223bd7-2c17-3546-bc2a-777d7e1f468f",
                                                "text": "Comme une trombe, en trombe : Brusquement, soudainement, violemment, à une très grande vitesse."
                                            },
                                            {
                                                "example_id": "416cad13-2cef-4499-875a-7148883e642c",
                                                "sense_id": "d3223bd7-2c17-3546-bc2a-777d7e1f468f",
                                                "text": "La porte s’ouvrait ! Il la poussa d’un effort de tous ses muscles tendus, entra comme une trombe dans le logis et repoussa la porte, tandis que, au dehors, éclataient les imprécations des six qui pesaient de tout leur poids pour ouvrir à leur tour."
                                            },
                                            {
                                                "example_id": "3440b094-3062-4bec-b42a-b6bd7272638e",
                                                "sense_id": "d3223bd7-2c17-3546-bc2a-777d7e1f468f",
                                                "text": "Cependant l’auto, traversant en trombe les hameaux et les bourgs, écrasait sous ses pneus insatiables poules, oies, dindons, canards, pintades, chats, chiens, cochons, enfants, laboureurs et paysannes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb1a0f83-cb1b-3f61-a3f5-030d4e4c747e",
                                        "entry_id": "87d7a20f-f9ee-36e0-b825-904e6ab419ee",
                                        "glosses": [
                                            "Tourbillon d'air."
                                        ],
                                        "tags": [
                                            "Par comparaison"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0096afc0-4463-4d56-8365-1bb271ccbe6a",
                                                "sense_id": "eb1a0f83-cb1b-3f61-a3f5-030d4e4c747e",
                                                "text": "Il y a des journées où l’air se fait si calme, si lourd qu’il en devient irrespirable. On étouffe. Alors, au creux de l’après-midi, en plein calme ensoleillé, on voit se former brusquement sur les dunes de petites trombes, minuscules. La poussière monte en gerbe, un tas d’herbes brusquement vole dans les airs, on ne sait pourquoi. A dix mètres, on ne sent rien. Pas un souffle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b93064e-95ef-3802-bab5-abf7550a4203",
                                        "entry_id": "87d7a20f-f9ee-36e0-b825-904e6ab419ee",
                                        "glosses": [
                                            "Grande quantité (de quelque chose) qui s’abat brutalement, qui se déchaîne ou qui est entraîné violemment et bruyamment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bda10000-63a1-4c0c-9a35-2a35b4d336f9",
                                                "sense_id": "6b93064e-95ef-3802-bab5-abf7550a4203",
                                                "text": "Il se sentit emporté dans une trombe de pitié."
                                            },
                                            {
                                                "example_id": "80b4c011-d3e3-41a3-86a9-204867777501",
                                                "sense_id": "6b93064e-95ef-3802-bab5-abf7550a4203",
                                                "text": "Sur le quai […], se précipite, se bouscule une cohue inouïe, une gigantesque trombe humaine, qui suit son héros, le pousse, l’empêche de monter dans le train en partance."
                                            },
                                            {
                                                "example_id": "e51e99f0-69dd-4bc7-8b8f-f4c372108baa",
                                                "sense_id": "6b93064e-95ef-3802-bab5-abf7550a4203",
                                                "text": "Nous sommes littéralement giflés par les trombes."
                                            },
                                            {
                                                "example_id": "721c9ac3-f9a0-4f36-92d7-d74534f45a17",
                                                "sense_id": "6b93064e-95ef-3802-bab5-abf7550a4203",
                                                "text": "Trombe de grêle, de pluie, de sable, de vent."
                                            },
                                            {
                                                "example_id": "ccfc5b31-6532-493c-b0a7-6f147ffc5012",
                                                "sense_id": "6b93064e-95ef-3802-bab5-abf7550a4203",
                                                "text": "Trombe d’eau : Averse torrentielle, cataracte, déluge."
                                            },
                                            {
                                                "example_id": "a5f3d40b-e868-47db-9ea0-395e40bb7f85",
                                                "sense_id": "6b93064e-95ef-3802-bab5-abf7550a4203",
                                                "text": "Trombe de graviers, de feu, de pierres."
                                            },
                                            {
                                                "example_id": "0ad3f511-f70f-40b7-a6a5-719988a0f937",
                                                "sense_id": "6b93064e-95ef-3802-bab5-abf7550a4203",
                                                "text": "Trombe de paroles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "307fb8e6-bbb2-3b99-a315-e57a7162001e",
                                        "entry_id": "87d7a20f-f9ee-36e0-b825-904e6ab419ee",
                                        "glosses": [
                                            "Personne, animal, chose qui, par son comportement ou ses caractéristiques, fait penser à ce phénomène."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bb98008-e8b6-4fdd-a53a-f973047c274b",
                                                "sense_id": "307fb8e6-bbb2-3b99-a315-e57a7162001e",
                                                "text": "[Chez les Araucaniens, il n’y a] jamais de lutte corps à corps : ce sont des trombes vivantes renversant et détruisant tout sur leur chemin. On n'a pas de peine à comprendre la terreur que de pareils adversaires inspirent aux soldats chiliens."
                                            },
                                            {
                                                "example_id": "04bebee4-de92-4edc-b9dc-e32d6a7729e4",
                                                "sense_id": "307fb8e6-bbb2-3b99-a315-e57a7162001e",
                                                "text": "Une auto semblable a traversé la place tandis qu’il prenait sa bouche, et le rythme de la voiture a rythmé leur baiser : il se souvient que la trombe a passé sous leur fenêtre, tandis que leurs dents se heurtaient."
                                            },
                                            {
                                                "example_id": "6c00d6c8-c4f7-4b4d-8db8-1f5efb795703",
                                                "sense_id": "307fb8e6-bbb2-3b99-a315-e57a7162001e",
                                                "text": "Cette grande bête [le chien …] il ne la craignait pas du tout. La première fois peut-être, lorsque cette trombe velue avait déferlé sur lui."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "trombe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "acd89c5f-8656-34f4-bf77-bc13f554cda6",
                                        "entry_id": "3339b0d1-5d90-369e-aa98-833d368edba5",
                                        "glosses": [
                                            "Pluriel de tromba."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
