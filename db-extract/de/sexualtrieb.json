                "senses": [
                    {
                        "sense_id": "a2b2d345-8102-3922-8d81-f35c3caf7805",
                        "entry_id": "1ed117ad-0aaf-3ee6-8269-6dea748eafd5",
                        "glosses": [
                            "das Bedürfnis nach Sex"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9476bbb0-39bb-484c-9eca-e52e78e1ab36",
                                "sense_id": "a2b2d345-8102-3922-8d81-f35c3caf7805",
                                "text": "Alle Tiere, die sich geschlechtlich fortpflanzen, weisen einen Sexualtrieb auf."
                            },
                            {
                                "example_id": "ae8306e3-ab09-4bdc-b39c-8869ea1afc5e",
                                "sense_id": "a2b2d345-8102-3922-8d81-f35c3caf7805",
                                "text": "Der menschliche Sexualtrieb kann vielgestaltige Formen und Ausprägungen annehmen."
                            },
                            {
                                "example_id": "4c56ba03-9efb-4cd5-bc28-9a6bf763a2c7",
                                "sense_id": "a2b2d345-8102-3922-8d81-f35c3caf7805",
                                "text": "„Seiner Erdhaftigkeit, seiner Offenheit für das Diesseits, das Irdische, für sinnliche Genüsse, hatte sich eine in seiner Lage gefährliche Notdurft hinzugesellt - der Sexualtrieb, die Hinneigung zum andern Geschlecht.“"
                            },
                            {
                                "example_id": "4cd6875c-a1e7-49f3-862b-d173ec0eeaf4",
                                "sense_id": "a2b2d345-8102-3922-8d81-f35c3caf7805",
                                "text": "„Man kann es drehen und wenden, wie man will, der Sexualtrieb ist eindeutig der stärkste und rücksichtsloseste Trieb überhaupt.“"
                            },
                            {
                                "example_id": "bb556683-b3d4-4b03-a679-2193a36146c5",
                                "sense_id": "a2b2d345-8102-3922-8d81-f35c3caf7805",
                                "text": "„Seitdem ich geschlechtsreif geworden bin, früher als nötig, nämlich mit knapp zwölf, hatte ich Probleme mit dem Sexualtrieb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
