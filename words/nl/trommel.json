                {
                    "sense_id": "6f48a127-62bc-3786-808f-06ab60adacb1",
                    "sense_definition": "een cilindervormig slaginstrument dat met een vel is bespannen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "muziekinstrumenten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De muzikant sloeg ritmisch op de <w>trommel</w> tijdens de optocht.",
                            "target_lang_translations": {
                                "en": "The musician beat rhythmically on the <w>drum</w> during the parade."
                            }
                        },
                        {
                            "text": "De een speelde de fluit en de andere de <w>trommel</w>.",
                            "target_lang_translations": {
                                "en": "One played the flute and the other the <w>drum</w>."
                            }
