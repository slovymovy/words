                        "examples": [
                            {
                                "example_id": "0258647b-8202-4312-ad5c-415ef731fbaf",
                                "sense_id": "e14fe8c6-571a-34ae-9c28-f2385442eb66",
                                "text": "„Der erste bedeutende Vertreter der Doxographie ist Theophrást von Eresos, Schüler und Nachfolger des Aristoteles in der Leitung des Peripatos.“"
                            },
                            {
                                "example_id": "ffaeb155-862e-4920-8e34-d931b2fd4a23",
                                "sense_id": "e14fe8c6-571a-34ae-9c28-f2385442eb66",
                                "text": "„Dennoch ist aber der,Didaskalikos' keine typische Doxographie, die nur verschiedene Lehrmeinungen zu bestimmten philosophischen Problemen auflistet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
