                            {
                                "target_word": "syllabification",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c464946e-97b2-3fee-9622-9a1b81a631ec",
                                        "entry_id": "de1cb51a-e561-3db3-85b4-5a10f68915c5",
                                        "glosses": [
                                            "The division of a word into syllables."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5476d68e-e5da-4e6e-b331-df2b4667770c",
                                                "sense_id": "c464946e-97b2-3fee-9622-9a1b81a631ec",
                                                "text": "Our author has eſtabliſhed clear practicable rules for articulation, and conſequently for facilitating to foreigners the pronouncing and ſyllabification of the Engliſh language; and that upon principles which are in common to all languages."
                                            },
                                            {
                                                "example_id": "d2411479-b9e6-44c3-bfc2-29ded1474532",
                                                "sense_id": "c464946e-97b2-3fee-9622-9a1b81a631ec",
                                                "text": "syllabicate 2    syllabication 1\nsyllabify 2      syllabification 1\nsyllabize 1     syllabization 3\nOne first-class verb, two first-class nouns, but neither of those nouns belonging to that verb. It is absurd enough, & any of several ways out would do; that indeed is why none of them is taken. The best thing would be to accept the most recognized verb syllabize, give it the now non-existent noun syllabization, & relegate all the rest to the Superfluous words; but there is no authority both willing & able to issue such decrees."
                                            },
                                            {
                                                "example_id": "19f6f749-b388-4674-a4a6-7c06a2c1d324",
                                                "sense_id": "c464946e-97b2-3fee-9622-9a1b81a631ec",
                                                "text": "Syllábify is a back-formation from syllabification, which in turn seems to be coined directly on the basis of Latin syllabificare."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e833268e-cf69-4299-a7cd-8b23cd842248",
                        "source_entry_id": "7a32a948-6de6-32ad-b44e-7bdf126661f5",
                        "source_sense_id": "75905182-d7b9-3d07-8408-8b21c308eaf6",
                        "target_lang_word": "syllabication",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "syllabication",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0746066b-4cfa-3762-9411-cc7fdda8ebe0",
                                        "entry_id": "6cec474e-04aa-3c30-b056-65632f496a36",
                                        "glosses": [
                                            "The act of syllabifying; syllabification."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57fa6386-bef9-4a4f-aa00-0edc3c83e512",
                                                "sense_id": "0746066b-4cfa-3762-9411-cc7fdda8ebe0",
                                                "text": "I sweare unto thee by the crisse-crosse row, by the whole Alphabet, and Sillabication of the letters."
                                            },
                                            {
                                                "example_id": "5dfc6db1-928b-4d3a-9333-adf542fc96f1",
                                                "sense_id": "0746066b-4cfa-3762-9411-cc7fdda8ebe0",
                                                "text": "Instances both of the unemphatic do and of the distinct syllabication of the final ed are numerous in the present play."
                                            },
                                            {
                                                "example_id": "8b23d2f1-383f-4514-9cb3-a8cc44cd27a5",
                                                "sense_id": "0746066b-4cfa-3762-9411-cc7fdda8ebe0",
                                                "text": "syllabicate 2    syllabication 1\nsyllabify 2      syllabification 1\nsyllabize 1     syllabization 3\nOne first-class verb, two first-class nouns, but neither of those nouns belonging to that verb. It is absurd enough, & any of several ways out would do; that indeed is why none of them is taken. The best thing would be to accept the most recognized verb syllabize, give it the now non-existent noun syllabization, & relegate all the rest to the Superfluous words; but there is no authority both willing & able to issue such decrees."
                                            }
