                                    {
                                        "sense_id": "8fef8121-8a16-3934-bb58-c2c982b55ed3",
                                        "entry_id": "a47ac9b2-cc6b-3c69-b7f9-dd559cdeee10",
                                        "glosses": [
                                            "Someone or something that is sneaky and/or hard to catch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "891e080d-6195-404e-b458-fcddf37364ec",
                                                "sense_id": "8fef8121-8a16-3934-bb58-c2c982b55ed3",
                                                "text": "That Dennis is a right eel, he always seems to slip away from the scene at the right time."
                                            },
                                            {
                                                "example_id": "ac6c8d8e-4d26-4f97-99e9-d79e3803b34e",
                                                "sense_id": "8fef8121-8a16-3934-bb58-c2c982b55ed3",
                                                "text": "His expression when incredulous. \"Why would you think that?\" He was a slippery little eel."
                                            },
                                            {
                                                "example_id": "b40bdd29-6c33-4c6f-9247-4b0712282e16",
                                                "sense_id": "8fef8121-8a16-3934-bb58-c2c982b55ed3",
                                                "text": "Philosophers and literary critics from ancient times, along with social scientists, physicians, theologians, and biblical scholars more recently, have tried to get a tentative handle, if not a firm grasp, on this \"slippery eel\" of humor and laughter."
                                            },
                                            {
                                                "example_id": "5b46ed6d-7349-4a8a-a248-534266d4d027",
                                                "sense_id": "8fef8121-8a16-3934-bb58-c2c982b55ed3",
                                                "text": "John scowled after the dog. \"Never fear, my lady. I shall get the sneaky, slippery eel yet.\""
                                            }
                                        ]
                                    }
