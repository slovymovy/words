                {
                    "sense_id": "ce88117b-2495-3664-abc9-0f2666e5a841",
                    "sense_definition": "zichtbare vlekken of bultjes op de huid als gevolg van een allergie of ziekte",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "medisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na het eten van aardbeien kreeg het kind last van rode <w>uitslag</w> op zijn armen.",
                            "target_lang_translations": {
