                                        "entry_id": "09b3e0d6-8d7b-3d66-8a23-c4dffc99def5",
                                        "glosses": [
                                            "Causing a severe and insurmountable problem; detrimental."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10f82437-041f-4a42-9a8c-462f98a601f1",
                                                "sense_id": "fc0aeea9-209d-3965-a8fd-ceee8ac7c0b8",
                                                "text": "The high cost of capital has a crippling effect on many small firms."
                                            },
                                            {
                                                "example_id": "f3e25fb5-ea4a-4767-9f85-e28139cb1c2c",
                                                "sense_id": "fc0aeea9-209d-3965-a8fd-ceee8ac7c0b8",
                                                "text": "The company, appreciating the crippling affect ^([sic]) that this scheme will have on its activities unless the railway is diverted, has petitioned against the North Wales Hydro-Electric Power Bill at present before the House of Lords."
                                            }
                                        ]
                                    },
