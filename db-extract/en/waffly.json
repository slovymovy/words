                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "57155607-0dd2-41fd-b054-1f11765918fa",
                                "sense_id": "9f019969-bd63-37d5-aed4-97e0da304bb9",
                                "text": "Waffle Houses were great favorites of Amos’s, who, as a Yankee, had grown up deprived of their waffly goodness and six-way hash browns."
                            },
                            {
                                "example_id": "156eae10-b435-47f3-9e8b-3b30e65d8b12",
                                "sense_id": "9f019969-bd63-37d5-aed4-97e0da304bb9",
                                "text": "The syrup will nestle into the pockets of the waffle, resulting in pure waffly goodness."
                            },
                            {
                                "example_id": "dba66b73-6399-4ebe-867d-19966c38f97d",
                                "sense_id": "9f019969-bd63-37d5-aed4-97e0da304bb9",
                                "text": "So if you happen to be exploring the many stores at Mall Bali Galeria and suddenly have that untamed urge for a lick of gelato or slice of waffly goodness, you’ll be glad to know that a Flapjaks is ready to serve your stomach’s every desire."
                            },
                            {
                                "example_id": "0a08ec5b-fa70-4738-8e4d-a41738fee473",
                                "sense_id": "9f019969-bd63-37d5-aed4-97e0da304bb9",
                                "text": "By the time the chip has turned to mush in your mouth, you're left with that traditional chip flavor, but a waffly taste still lingers."
                            },
                            {
                                "example_id": "9a828666-74e8-4787-8499-03bf1f2e0688",
                                "sense_id": "9f019969-bd63-37d5-aed4-97e0da304bb9",
                                "text": "Birmingham street food vendors serve delicious Belgian waffles all over Brum and the UK! They recently served up the waffly goodness at Kings Heath Dining Club in York Road."
                            },
                            {
                                "example_id": "838ff200-7b91-4178-bc38-7556a46fc9d7",
                                "sense_id": "9f019969-bd63-37d5-aed4-97e0da304bb9",
                                "text": "So don’t feel depresso when you finish your espresso because waffly goodness awaits."
                            },
                            {
                                "example_id": "3cab203c-c8c6-41c9-b7c8-d46bc625668d",
                                "sense_id": "9f019969-bd63-37d5-aed4-97e0da304bb9",
                                "text": "Enjoy waffles? Who doesn’t! There’s plenty of waffly goodness out there and we’ve found the Gold Coast’s five best waffles for you to tuck into."
                            }
                        ]
                    }
