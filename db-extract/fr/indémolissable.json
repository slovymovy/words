                "senses": [
                    {
                        "sense_id": "362ef86b-cc4c-33d9-b1ff-7ac8f39b51eb",
                        "entry_id": "45de5b01-2609-3590-a96f-ad6403331f21",
                        "glosses": [
                            "Que rien ne peut démolir, détruire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a0fc96c-27ec-4edf-b79a-f87c319477ca",
                                "sense_id": "362ef86b-cc4c-33d9-b1ff-7ac8f39b51eb",
                                "text": "Marcellus avait déjà renversé le beau temple de Jupiter, à Apamée même, après en avoir chassé, à force d’eau bénite, le diable qui, disait-on, le rendait indémolissable."
                            },
                            {
                                "example_id": "f26d88e5-51d5-48d2-a96d-623d98371629",
                                "sense_id": "362ef86b-cc4c-33d9-b1ff-7ac8f39b51eb",
                                "text": "Aucune avanie ne me jette par terre, aucun écueil ne me fait sombrer, aucun marteau ne m’écrase. Je suis indémolissable."
                            },
                            {
                                "example_id": "b10c8b7d-d899-4da7-bbbc-d46ff7e59ecd",
                                "sense_id": "362ef86b-cc4c-33d9-b1ff-7ac8f39b51eb",
                                "text": "S’il est exact que les livres et les bibliothèques peuvent vous apprendre bien des choses, tout n’y est pas, car la Vie, elle, notre éducatrice par excellence, sait nous enseigner ce qu’aucun texte ne peut nous dire, ce qui n’est au pouvoir d’aucune Université de donner, la valeur indémolissable d’une Vérité vécue."
                            }
                        ]
                    }
