                    {
                        "sense_id": "caba30e4-f523-3404-9e66-d4806896d914",
                        "entry_id": "4df45186-acfb-3881-830b-19abaa0a7a43",
                        "glosses": [
                            "Tänzerin, die in einem Unternehmen arbeitet, in dem sie gegen Entgelt für einen Tanz gemietet werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6429fcdb-ede8-4738-addc-776d8e1e446f",
                                "sense_id": "caba30e4-f523-3404-9e66-d4806896d914",
                                "text": "„Wir werden nur zwei Stunden miteinander haben, und dann wird sie mich verlassen - um in den Tanzpalast zu gehen, wo sie noch immer als Taxigirl arbeitet.“"
                            },
                            {
                                "example_id": "29012e4f-80a3-474a-9d04-53d4b7fd5bfa",
                                "sense_id": "caba30e4-f523-3404-9e66-d4806896d914",
                                "text": "„Sie durften nur nicht ihren Ruf schädigen, indem sie sich als „Taxigirls“ betätigten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
