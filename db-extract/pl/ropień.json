                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f3f1dd9-7939-4c44-861b-2945640359c7",
                                                "sense_id": "9dbf3353-3e89-31e3-9f8c-771413eecc21",
                                                "text": "Les abcès peuvent affecter tous les animaux. Ils se développent généralement sur la peau à la faveur d’une lésion mais ils peuvent être dus à une maladie et se développer sous la peau ou dans les tissus profonds."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63c243a0-3348-4f15-89b3-01104a3094d2",
                        "source_entry_id": "9cf302ff-8abc-331a-af22-b46f1b35e5f2",
                        "source_sense_id": "f56f169b-aff1-376c-89ad-3f1ed5d176b9",
                        "target_lang_word": "absceso",
