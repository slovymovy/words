                                        "entry_id": "cf14564e-b6ca-3bf9-a18b-74aa8f13fe34",
                                        "glosses": [
                                            "The act of dispossessing someone of something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4079745e-b8b8-40c5-a904-cceed0d6a1a2",
                                                "sense_id": "dde82b6d-d76f-3ba7-b956-b206f528fd21",
                                                "text": "At times, the assimilationist paradigm has facilitated the physical dispossession of Native lands and the suppression or eradication of Native institutions, culture, and identity by the political branches of the federal government."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f18caa1-e6a1-3c70-ada1-83dbb0817eac",
                                        "entry_id": "cf14564e-b6ca-3bf9-a18b-74aa8f13fe34",
                                        "glosses": [
                                            "The casting out of an evil spirit that has possessed someone; exorcism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c89f2c4-694c-4d09-8dfc-596199ebddcd",
                                                "sense_id": "5f18caa1-e6a1-3c70-ada1-83dbb0817eac",
                                                "text": "There had been a series of such dispossessions since the beginning of Elizabeth's reign involving many clergy, particularly those of vehement Protestant sympathies."
                                            }
                                        ]
                                    }
                                ]
                            }
