                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd3ed03f-06a7-48f5-9201-32cfbab96b90",
                        "source_entry_id": "9e71d7f7-dc02-3652-b366-f7ccbac7f261",
                        "source_sense_description": "produced by grating",
                        "target_lang_word": "râpé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "râpé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9579ae3f-c0fa-31f4-8399-7ec6942fedb3",
                                        "entry_id": "ab5d61a0-7ab2-3cb2-a262-9c25e84882f2",
                                        "glosses": [
                                            "Qualifie un aliment qui est émincé par une râpe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fcf5445-286d-429c-a59f-a9c6e787a20c",
                                                "sense_id": "9579ae3f-c0fa-31f4-8399-7ec6942fedb3",
                                                "text": "Il fut intéressé par la salade de carottes râpées en longues lamelles. Il en prit une fourchettée, mâcha. Le goût le surprit. Il n'appréciait pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b6b685f-debe-3227-aead-9add9bd11052",
                                        "entry_id": "ab5d61a0-7ab2-3cb2-a262-9c25e84882f2",
                                        "glosses": [
                                            "Très usé."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7781a30-1380-4f29-a27d-65bc0085b5e1",
                                                "sense_id": "6b6b685f-debe-3227-aead-9add9bd11052",
                                                "text": "Je te vois si faible, si menacé, traînant tes cinquante ans, des heures durant, pour subsister un jour de plus, sur le trottoir de quelque épicerie pauvre, grelottant à l'abri précaire d'un manteau râpé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f8226d3-88a2-3f28-bebe-4dda528a92bb",
                                        "entry_id": "ab5d61a0-7ab2-3cb2-a262-9c25e84882f2",
                                        "glosses": [
                                            "Qualifie une personne qui porte des vêtements usés et qui a l’air misérable."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0be11fa-c64c-47ba-9173-70fabde7193c",
                                                "sense_id": "7f8226d3-88a2-3f28-bebe-4dda528a92bb",
                                                "text": "Il est bien râpé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e52ac1e-0eb1-394f-bd0b-c74822287043",
                                        "entry_id": "ab5d61a0-7ab2-3cb2-a262-9c25e84882f2",
                                        "glosses": [
                                            "Raté, fini."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cc2b7c5-eef5-44be-827b-f453b587de1c",
                                                "sense_id": "7e52ac1e-0eb1-394f-bd0b-c74822287043",
                                                "text": "— Vous allez pas nous déballer toutes vos cartes postales, non ? Le couplet sur Paris, voilà deux ans qu’on en croque. Ça revient comme du chou : […]. Et dans cinq minutes, y en aura un qui va sortir un ticket de métro ou des photos de la Foire du Trône. Non, pour moi tout ça c’est râpé. Y’a plus de Paris. Y’a groß Paris. Un point, c’est marre !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "râpé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a7b59f4f-2e67-3957-b181-d070a2c042fb",
                                        "entry_id": "6ff65bdd-26bc-32d4-80f3-68d6d2aca041",
                                        "glosses": [
                                            "Boisson que l’on obtient en faisant passer de l’eau sur le marc de raisin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddc10111-c0c5-480c-81f9-c8406c81dfc3",
                                                "sense_id": "a7b59f4f-2e67-3957-b181-d070a2c042fb",
                                                "text": "Ce n’est pas du vin, c’est du râpé."
                                            },
                                            {
                                                "example_id": "c3f9bafb-f221-4739-9383-ad1b7e943579",
                                                "sense_id": "a7b59f4f-2e67-3957-b181-d070a2c042fb",
                                                "text": "Il ne nous a donné à boire que du râpé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c36c364a-2a54-3c3d-a540-5cb49c2ba3c4",
                                        "entry_id": "6ff65bdd-26bc-32d4-80f3-68d6d2aca041",
                                        "glosses": [
                                            "Raisin nouveau qu’on met dans un tonneau pour améliorer le vin quand il va se gâter, ou vin ainsi traité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cbf6a5f-0429-4893-ac08-8c1c064ee13d",
                                                "sense_id": "c36c364a-2a54-3c3d-a540-5cb49c2ba3c4",
                                                "text": "Râpé de copeaux, Une certaine quantité de copeaux qu’on met dans un tonneau pour éclaircir le vin."
                                            },
                                            {
                                                "example_id": "51dba5ec-b0b2-4f0e-afd5-7e66c99fb1fc",
                                                "sense_id": "c36c364a-2a54-3c3d-a540-5cb49c2ba3c4",
                                                "text": "Passer du vin par le râpé, sur le râpé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00edd100-14cd-347e-be4d-21eeffc93883",
                                        "entry_id": "6ff65bdd-26bc-32d4-80f3-68d6d2aca041",
                                        "glosses": [
                                            "Fromage râpé."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bfd5e2d9-d656-3d3e-be82-d4aa41447a82",
                                        "entry_id": "6ff65bdd-26bc-32d4-80f3-68d6d2aca041",
                                        "glosses": [
                                            "Beignet de pommes de terre râpées et trempées dans une migaine, puis frites"
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e6f5aa1-8a56-495f-9487-3b24c9d0bd99",
                                                "sense_id": "bfd5e2d9-d656-3d3e-be82-d4aa41447a82",
                                                "text": "Faut que je rentre, ma femme a fait des râpés !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "râpé",
                                "target_lang_code": "fr",
                                "target_senses": [
