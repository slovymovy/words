                "senses": [
                    {
                        "sense_id": "e7bcb1a1-1cd0-31d3-a362-f460d15656d1",
                        "entry_id": "8b895853-bbc0-327f-99c3-4c63f73deae7",
                        "glosses": [
                            "Person, die Statusmeilen durch Flüge sammelt, um dadurch einen bestimmten Vielfliegerstatus zu erreichen oder zu behalten, oder, die Prämienmeilen durch Flüge oder sonstige meilenberechtigte Aktivitäten sammelt, um damit im Rahmen eines Vielfliegerprogramms besonders preiswerte Flüge (sogenannte Prämienflüge) buchen zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "781f02e0-2538-46f5-850d-dbb971b33dfb",
                                "sense_id": "e7bcb1a1-1cd0-31d3-a362-f460d15656d1",
                                "text": "„Besonders Etihad und British Airways haben die Bedingungen für Meilensammler im vergangenen Jahr verschlechtert.“"
                            },
                            {
                                "example_id": "76bfe863-f884-48f7-97d8-f1d873019fa1",
                                "sense_id": "e7bcb1a1-1cd0-31d3-a362-f460d15656d1",
                                "text": "„Meilensammler müssen zwischen Status- und Prämienmeilen unterscheiden: Statusmeilen bekommt man nur, wenn man auch wirklich fliegt.“"
                            },
                            {
                                "example_id": "7b0eedbb-88cd-464e-89ca-819c84894723",
                                "sense_id": "e7bcb1a1-1cd0-31d3-a362-f460d15656d1",
                                "text": "„Für den Meilensammler bleibt die Frage: Wo lege ich meine Meilen am besten an?“"
                            },
                            {
                                "example_id": "d5537c84-4360-4593-9616-8242078a6332",
                                "sense_id": "e7bcb1a1-1cd0-31d3-a362-f460d15656d1",
                                "text": "„Allerdings müssen Meilensammler eines beachten: Steuern und Gebühren des Prämienfluges sind extra zu zahlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
