                        ],
                        "form": "die Relativsätze"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "578cf8be-58ce-396a-ab14-e9232c982f40",
                        "entry_id": "5efe7d56-6f7f-3dcf-84a8-9fb6e1ab3be1",
                        "glosses": [
                            "Teilsatz, der durch ein Relativpronomen oder ein Relativadverb eingeleitet wird."
                        ],
                        "tags": [
                            "speziell Syntax"
                        ],
                        "examples": [
                            {
                                "example_id": "68ec899a-f196-42f9-b88a-ddbfb6651473",
                                "sense_id": "578cf8be-58ce-396a-ab14-e9232c982f40",
                                "text": "Der Satz: \"Peter, den ich erst gestern sah, liegt im Krankenhaus\" enthält den Relativsatz \"den ich erst gestern sah\". Dieser Relativsatz dient wie viele andere auch als Attribut."
                            },
                            {
                                "example_id": "4af7965e-5494-4917-bd11-6045f7de81b8",
                                "sense_id": "578cf8be-58ce-396a-ab14-e9232c982f40",
                                "text": "Der Satz: \"Das Loch, worin man die Funde entdeckte, erwies sich zunächst als zu tief\" enthält einen Relativsatz, der mit einem Relativadverb (\"worin\") eingeleitet wird."
                            },
                            {
                                "example_id": "91e88a29-eba1-4604-9304-16e50063f4e2",
                                "sense_id": "578cf8be-58ce-396a-ab14-e9232c982f40",
                                "text": "„Zu den Relativsätzen zählt man auch solche, bei denen es kein direktes Bezugsnomen gibt, sondern wo sich das Einleitewort auf den ganzen Vorsatz bezieht.“"
                            },
                            {
                                "example_id": "b6e26e83-5bd6-487f-a525-4341c994dea1",
                                "sense_id": "578cf8be-58ce-396a-ab14-e9232c982f40",
                                "text": "„Relativsätze konstruieren die Ägypter ganz anders als wir, weswegen sie eines der schwierigsten Kapitel der ägyptischen Grammatik bilden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
