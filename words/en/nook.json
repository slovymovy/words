{
    "word_family": [
        "nooky"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "452a050f-6f49-3225-b889-4e5d0526482b",
                    "sense_definition": "A small corner or recessed area formed by two walls.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She placed a small reading chair in the <w>nook</w> between the fireplace and the wall.",
                            "target_lang_translations": {
                                "cs": "Umístila malé křeslo na čtení do <w>koutku</w> mezi krbem a stěnou."
                            }
                        },
                        {
                            "text": "The kitchen has a breakfast <w>nook</w> that gets plenty of morning sunlight.",
                            "target_lang_translations": {
                                "cs": "Kuchyně má snídaňový <w>koutek</w>, do kterého dopadá spousta ranního slunce."
                            }
                        }
                    ],
                    "synonyms": [
                        "alcove",
                        "recess",
                        "niche"
                    ],
                    "common_phrases": [
                        "breakfast nook"
                    ],
                    "target_lang_definitions": {
                        "cs": "Malý roh nebo výklenek vytvořený dvěma stěnami."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "koutek",
                                "target_lang_sense_clarification": "malý, útulný prostor v rohu místnosti"
                            },
                            {
                                "target_lang_word": "výklenek",
                                "target_lang_sense_clarification": "prostor ustupující ze stěny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67d2fc93-750c-33ff-b5f7-b67d8e104231",
                    "sense_definition": "A hidden, quiet, or secluded spot.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They found a quiet <w>nook</w> in the park to sit and talk away from the crowds.",
                            "target_lang_translations": {
                                "cs": "Našli si v parku klidné <w>zákoutí</w>, kde si mohli sednout a povídat si stranou od davů."
                            }
                        },
                        {
                            "text": "The library has many cozy <w>nooks</w> where students can study in peace.",
                            "target_lang_translations": {
                                "cs": "Knihovna má mnoho útulných <w>zákoutí</w>, kde mohou studenti v klidu studovat."
                            }
                        }
                    ],
                    "synonyms": [
                        "recess"
                    ],
                    "common_phrases": [
                        "cozy nook"
                    ],
                    "target_lang_definitions": {
                        "cs": "Skryté, klidné nebo odlehlé místo."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zákoutí",
                                "target_lang_sense_clarification": "odlehlé, skryté nebo útulné místo"
                            },
                            {
                                "target_lang_word": "koutek",
                                "target_lang_sense_clarification": "klidné, soukromé místo"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1c43a923-824e-3c00-9c23-480f03884b32",
                    "sense_definition": "To place or fit something into a small or sheltered space.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "space",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect <w>nooked</w> the small desk into the space under the stairs.",
                            "target_lang_translations": {
                                "cs": "Architekt <w>vtěsnal</w> malý psací stůl do prostoru pod schody."
                            }
                        },
                        {
                            "text": "Small shops were <w>nooked</w> into the narrow alleyways of the old city.",
                            "target_lang_translations": {
                                "cs": "Malé obchůdky byly <w>zasunuty</w> do úzkých uliček starého města."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Umístit nebo vtěsnat něco do malého či chráněného prostoru."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vtěsnat",
                                "target_lang_sense_clarification": "umístit něco do omezeného prostoru"
                            },
                            {
                                "target_lang_word": "zasunout",
                                "target_lang_sense_clarification": "vložit něco do úzkého místa"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}