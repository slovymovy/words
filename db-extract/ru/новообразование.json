                "senses": [
                    {
                        "sense_id": "a3ba659d-a8da-3934-b19d-84798741f9e3",
                        "entry_id": "40b375b8-3261-3374-9dff-37de31008d11",
                        "glosses": [
                            "появление новых форм или элементов чего-либо"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ea8998d7-06ab-3203-bba4-24f36b906223",
                        "entry_id": "40b375b8-3261-3374-9dff-37de31008d11",
                        "glosses": [
                            "лингв. новое явление в языке, преимущественно в области морфологии, возникшее в данном языке в более позднюю эпоху его развития"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "79e27d93-3b0b-3449-899c-5cf181f7ba6a",
                        "entry_id": "40b375b8-3261-3374-9dff-37de31008d11",
                        "glosses": [
                            "мед. опухоль"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cfc1489-004d-41a6-9e8d-5b90502aeac4",
                                "sense_id": "79e27d93-3b0b-3449-899c-5cf181f7ba6a",
                                "text": "Из доброкачественных новообразований наиболее часто выявляются лейкоплакия, эритроплакия и папилломы, которые, помимо полости рта, бывают в глотке и гортани."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2e91260-b737-4bc5-84fc-ae838ade5a4d",
                        "source_entry_id": "40b375b8-3261-3374-9dff-37de31008d11",
                        "target_lang_word": "Neubildung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Neubildung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5c16e233-5b94-3826-b4ec-168770c36755",
                                        "entry_id": "42b3b847-0144-33f0-a878-370b47805532",
                                        "glosses": [
                                            "Entwicklung/Herstellung von etwas Neuem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "803efecd-1120-4ab7-a931-2b161e3954a9",
                                                "sense_id": "5c16e233-5b94-3826-b4ec-168770c36755",
                                                "text": "Wegen der starken Kritik sahen wir uns gezwungen, uns mit einer Neubildung des Kaders anzufreunden."
                                            },
                                            {
                                                "example_id": "f1c96662-d21f-479c-a519-c9f388e761b1",
                                                "sense_id": "5c16e233-5b94-3826-b4ec-168770c36755",
                                                "text": "[…] „in den vergangenen Jahren ist die Neubildung des Grundwassers in Rheinland-Pfalz wegen des Klimawandels um 25 Prozent zurückgegangen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7dc21f7b-2063-326c-bb8d-6a2530180b25",
                                        "entry_id": "42b3b847-0144-33f0-a878-370b47805532",
                                        "glosses": [
                                            "das durch ^([1]) entstandene Neue"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "272cabe1-5408-4d80-bead-43eb60dc8055",
                                                "sense_id": "7dc21f7b-2063-326c-bb8d-6a2530180b25",
                                                "text": "Die Neubildung des Kaders hat sich leider nicht bewährt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2dbafbe2-7f64-3140-9932-2e5e3135d602",
                                        "entry_id": "42b3b847-0144-33f0-a878-370b47805532",
                                        "glosses": [
                                            "Bildung neuer sprachlicher Einheiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd1766cb-7257-4171-bffe-c842318b7a84",
                                                "sense_id": "2dbafbe2-7f64-3140-9932-2e5e3135d602",
                                                "text": "„Was innerhalb der letzten Jahre ebenfalls konstant geblieben ist, ist die Tendenz zu Neubildungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "41ca13a6-0010-3304-9460-aa3e07581a4c",
                                        "entry_id": "42b3b847-0144-33f0-a878-370b47805532",
                                        "glosses": [
                                            "neu gebildete sprachliche Einheiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22722b21-989e-4912-b36a-ec4988fd21a8",
                                                "sense_id": "41ca13a6-0010-3304-9460-aa3e07581a4c",
                                                "text": "„Was innerhalb der letzten Jahre ebenfalls konstant geblieben ist, ist die Tendenz zu Neubildungen.“"
                                            },
                                            {
                                                "example_id": "7ea9571d-0b98-4dcf-8947-5d261fd4ee29",
                                                "sense_id": "41ca13a6-0010-3304-9460-aa3e07581a4c",
                                                "text": "„Gerade im religiösen Bereich gab es eine große Zahl von Neubildungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
