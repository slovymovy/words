                "word": "kylix",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7732b86f-8e94-36bc-ba83-81ff41e1f01d",
                        "entry_id": "febca6cd-82a5-3d36-9503-792c4b2e2d05",
                        "glosses": [
                            "Coupe large et peu profonde produite en Grèce dans l’antiquité."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "fceae30a-dd60-4770-9b53-d478eb5ea2ee",
                                "sense_id": "7732b86f-8e94-36bc-ba83-81ff41e1f01d",
                                "text": "Citons pour exemple une célèbre kylix attique des années 500-480, attribuée au peintre Onésimos : sur le fond de la coupe, une femme nue – thème rare sur les vases grecs – montre un corps allongé d’un joli ton rosé peu habituel, même pour représenter une peau féminine, souvent plus claire qu’une peau masculine."
                            },
                            {
                                "example_id": "c43eb5d4-95a0-44bb-87ff-a89184861b27",
                                "sense_id": "7732b86f-8e94-36bc-ba83-81ff41e1f01d",
                                "text": "Il se débarbouilla le visage avec de l’eau dans un kylix peint par un maître."
                            },
                            {
                                "example_id": "90da98be-eb1f-44cd-adaa-7ea75816c204",
                                "sense_id": "7732b86f-8e94-36bc-ba83-81ff41e1f01d",
                                "text": "Une kylix de 12 cm de diamètre orné en son centre d’un masque de Gorgonéion barbu."
                            }
                        ]
                    }
                ],
