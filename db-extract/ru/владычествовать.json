                "senses": [
                    {
                        "sense_id": "6999b9c7-54d6-344b-aec4-f337fee50ddb",
                        "entry_id": "00104541-2f4e-3a55-95f4-23aacb41f6b0",
                        "glosses": [
                            "to rule, to reign, to dominate, to prevail"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "85fee9a9-0f70-467d-821e-880bbf873515",
                                "sense_id": "6999b9c7-54d6-344b-aec4-f337fee50ddb",
                                "text": "Неви́нность, цари́ца сей восхити́тельной импе́рии, не име́ет тро́на; она́ влады́чествует над сердца́ми свои́х по́дданных, кото́рые обожа́ют её могу́щество, и ве́рность к преле́стной влады́чице почита́ют пе́рвым свои́м бла́гом.",
                                "translation": "Vasily Zhukovsky",
                                "english": "Vasily Zhukovsky"
                            }
                        ]
                    }
                ],
