{
    "word_family": [
        "ebbtide"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "461b0fb7-872e-39fe-b685-858e3384d907",
                    "sense_definition": "The receding movement of the tide.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tide_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boats will go out on the <w>ebb</w>.",
                            "target_lang_translations": {
                                "cs": "Lodě vyplují během <w>odlivu</w>.",
                                "ru": "Лодки выйдут в море во время <w>отлива</w>."
                            }
                        },
                        {
                            "text": "The water level drops significantly during the <w>ebb</w> of the tide.",
                            "target_lang_translations": {
                                "cs": "Hladina vody během <w>odlivu</w> výrazně klesá.",
                                "ru": "Уровень воды значительно понижается во время <w>отлива</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "reflux"
                    ],
                    "antonyms": [
                        "flood",
                        "flow"
                    ],
                    "target_lang_definitions": {
                        "cs": "Ustupující pohyb mořského přílivu.",
                        "ru": "Фаза понижения уровня моря при приливно-отливном цикле; уход воды от берега."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "odliv",
                                "target_lang_sense_clarification": "přirozený pokles hladiny moře"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "отлив",
                                "target_lang_sense_clarification": "морской отлив"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89408c40-5d68-3a65-8709-aab2728b2129",
                    "sense_definition": "A gradual decline.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "decline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>ebb</w> of his popularity was evident after the scandal.",
                            "target_lang_translations": {
                                "cs": "Po skandálu byl patrný <w>ústup</w> jeho popularity.",
                                "ru": "<w>Спад</w> его популярности стал очевиден после скандала."
                            }
                        },
                        {
                            "text": "We watched the <w>ebb</w> of the empire over several decades.",
                            "target_lang_translations": {
                                "cs": "Sledovali jsme <w>úpadek</w> impéria v průběhu několika desetiletí.",
                                "ru": "Мы наблюдали <w>упадок</w> империи на протяжении нескольких десятилетий."
                            }
                        }
                    ],
                    "synonyms": [
                        "wane"
                    ],
                    "target_lang_definitions": {
                        "cs": "Postupný úpadek nebo slábnutí.",
                        "ru": "Постепенный спад, угасание или уменьшение чего-либо."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "ústup",
                                "target_lang_sense_clarification": "ztráta vlivu nebo popularity"
                            },
                            {
                                "target_lang_word": "slábnutí",
                                "target_lang_sense_clarification": "postupná ztráta síly či významu"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "спад",
                                "target_lang_sense_clarification": "постепенное снижение или ослабление"
                            },
                            {
                                "target_lang_word": "упадок",
                                "target_lang_sense_clarification": "угасание силы, влияния или величия"
                            },
                            {
                                "target_lang_word": "отлив",
                                "target_lang_sense_clarification": "переносное значение: убывание чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "696bc65a-2ae9-3743-bb48-abfcb26f60b2",
                    "sense_definition": "A low state or condition of depression.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "decline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company's profits were at their lowest <w>ebb</w> last year.",
                            "target_lang_translations": {
                                "cs": "Zisky společnosti byly loni na svém <w>dně</w>.",
                                "ru": "В прошлом году доходы компании оказались на самом <w>дне</w>."
                            }
                        },
                        {
                            "text": "Public morale reached a low <w>ebb</w> during the long crisis.",
                            "target_lang_translations": {
                                "cs": "Veřejná morálka během dlouhé krize dosáhla svého <w>útlumu</w>.",
                                "ru": "Боевой дух общества достиг глубокого <w>упадка</w> в период затяжного кризиса."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lowest ebb"
                    ],
                    "target_lang_definitions": {
                        "cs": "Stav hlubokého úpadku nebo deprese.",
                        "ru": "Крайняя степень упадка, кризиса или подавленности."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "dno",
                                "target_lang_sense_clarification": "nejnižší bod v přeneseném smyslu"
                            },
                            {
                                "target_lang_word": "útlum",
                                "target_lang_sense_clarification": "stav nízké aktivity nebo morálky"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "дно",
                                "target_lang_sense_clarification": "низшая точка упадка или кризиса"
                            },
                            {
                                "target_lang_word": "упадок",
                                "target_lang_sense_clarification": "состояние глубокого спада или подавленности"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f035ca67-7830-3c57-aa5d-e4257664da8d",
                    "sense_definition": "To flow back or recede.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tide_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tide began to <w>ebb</w> at noon.",
                            "target_lang_translations": {
                                "cs": "V poledne začala voda <w>ustupovat</w>.",
                                "ru": "В полдень начался <w>отлив</w>."
                            }
                        },
                        {
                            "text": "We waited for the water to <w>ebb</w> before walking across the sand.",
                            "target_lang_translations": {
                                "cs": "Počkali jsme, až voda <w>opadne</w>, než jsme přešli přes písek.",
                                "ru": "Мы подождали, пока вода <w>отступит</w>, прежде чем пойти по песку."
                            }
                        }
                    ],
                    "synonyms": [
                        "go out"
                    ],
                    "antonyms": [
                        "flow"
                    ],
                    "target_lang_definitions": {
                        "cs": "Odtékat nebo ustupovat (o mořské hladině).",
                        "ru": "Отступать, оттекать от берега (о морской воде при отливе)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "ustupovat",
                                "target_lang_sense_clarification": "o vodě či moři: pomalu se stahovat zpět"
                            },
                            {
                                "target_lang_word": "opadat",
                                "target_lang_sense_clarification": "o vodní hladině: klesat"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "отливать",
                                "target_lang_sense_clarification": "отходить от берега (о море)"
                            },
                            {
                                "target_lang_word": "убывать",
                                "target_lang_sense_clarification": "опускаться по уровню (о воде)"
                            },
                            {
                                "target_lang_word": "отступать",
                                "target_lang_sense_clarification": "уходить от береговой линии (о воде)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4002cd69-6dbb-38c1-bff8-f7baf7cf6cb0",
                    "sense_definition": "To fall away or decline.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "decline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dying man's strength <w>ebbed</w> away.",
                            "target_lang_translations": {
                                "cs": "Umírajícímu muži <w>slábla</w> síla.",
                                "ru": "Силы умирающего человека <w>иссякали</w>."
                            }
                        },
                        {
                            "text": "Public interest in the project started to <w>ebb</w> after the initial excitement.",
                            "target_lang_translations": {
                                "cs": "Veřejný zájem o projekt po počátečním nadšení začal <w>slábnout</w>.",
                                "ru": "Общественный интерес к проекту начал <w>ослабевать</w> после первоначального восторга."
                            }
                        }
                    ],
                    "synonyms": [
                        "go down",
                        "wane"
                    ],
                    "common_phrases": [
                        "ebb away"
                    ],
                    "target_lang_definitions": {
                        "cs": "Postupně slábnout nebo mizet.",
                        "ru": "Постепенно ослабевать, угасать или сходить на нет."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "slábnout",
                                "target_lang_sense_clarification": "ztrácet intenzitu"
                            },
                            {
                                "target_lang_word": "vytrácet se",
                                "target_lang_sense_clarification": "postupně mizet"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "ослабевать",
                                "target_lang_sense_clarification": "терять силу, напряженность или интерес"
                            },
                            {
                                "target_lang_word": "угасать",
                                "target_lang_sense_clarification": "постепенно пропадать, исчезать"
                            },
                            {
                                "target_lang_word": "иссякать",
                                "target_lang_sense_clarification": "заканчиваться (о силах, энергии)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}