                        "cross_references": [
                            {
                                "target_word": "Gruß",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "145dd20d-6eda-39a2-9e4b-dcc2e6ac73a4",
                                        "entry_id": "571a3d53-64e6-31c4-b623-dd0ef0e9a82e",
                                        "glosses": [
                                            "das Ansprechen einer Person bei Ankunft, Abschied, zu bestimmten Tageszeiten oder Anlässen als Zeichen freundlicher Gesinnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a69453d-d811-44c5-9f80-f74f8ebf9f81",
                                                "sense_id": "145dd20d-6eda-39a2-9e4b-dcc2e6ac73a4",
                                                "text": "„Guten Tag“ ist ein Gruß."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "53277848-0613-3d71-a402-de38b178e248",
                                        "entry_id": "571a3d53-64e6-31c4-b623-dd0ef0e9a82e",
                                        "glosses": [
                                            "freundliche Wünsche, die eine Person einer anderen ausrichten soll, dies als Zeichen der Verbundenheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a505da22-6d60-4518-ba21-0728583e524b",
                                                "sense_id": "53277848-0613-3d71-a402-de38b178e248",
                                                "text": "Schönen Gruß von Michael!"
                                            },
                                            {
                                                "example_id": "89c9aae6-f96b-4fc0-97af-9980c7541ba5",
                                                "sense_id": "53277848-0613-3d71-a402-de38b178e248",
                                                "text": "Liebe Grüße an deine Schwester!"
                                            },
                                            {
                                                "example_id": "8e92e4d9-e9dd-4cc7-b4e3-7060117e2507",
                                                "sense_id": "53277848-0613-3d71-a402-de38b178e248",
                                                "text": "Bestell ihr schöne Grüße von mir."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70342bb0-cfbf-47be-a968-db367539308d",
                        "source_entry_id": "2bd2a633-f950-3665-9d5c-5d6f5b5cf195",
                        "source_sense_id": "b21a4821-40ca-3bc9-87f4-2d2fdb7c807c",
                        "source_sense_description": "een uiting waarbij men elkaars aanwezigheid erkent wanneer men elkaar ontmoet",
                        "target_lang_word": "Begrüßung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Begrüßung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "084b3405-15b2-39b6-b1a2-f6f18e10e81d",
                                        "entry_id": "174bdb5c-3cbf-3aa6-b346-8b629ef84bbe",
                                        "glosses": [
                                            "Ritual (Wörter und/oder Gesten), um einer Person Respekt zu erweisen und sie willkommen zu heißen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58fff8a3-0d32-4914-9246-e99cb1ff5208",
                                                "sense_id": "084b3405-15b2-39b6-b1a2-f6f18e10e81d",
                                                "text": "Zur Begrüßung wird in manchen Ländern die Hand zum Schütteln gereicht, in einigen anderen Länder hingegen ist die Begrüßung eine Verbeugung."
                                            },
                                            {
                                                "example_id": "4fe5f811-933b-492c-ab06-d398918b8701",
                                                "sense_id": "084b3405-15b2-39b6-b1a2-f6f18e10e81d",
                                                "text": "Zur Begrüßung küsste Eva ihn auf die Wangen."
                                            },
                                            {
                                                "example_id": "dd1b5101-5c6d-4323-bd20-752800e912be",
                                                "sense_id": "084b3405-15b2-39b6-b1a2-f6f18e10e81d",
                                                "text": "Zur Begrüßung erhielt jeder Gast ein Glas Sekt."
                                            },
                                            {
                                                "example_id": "e9823750-53fc-48cc-b4bd-30cca713661d",
                                                "sense_id": "084b3405-15b2-39b6-b1a2-f6f18e10e81d",
                                                "text": "„Danach klopfte er mit seinem Bambusstock, den er bei der Begrüßung wie ein englischer Offizier unter dem Arm hielt, auf sein Pult.“"
                                            },
                                            {
                                                "example_id": "dfff091e-67ca-4565-a795-ea9208f2b259",
                                                "sense_id": "084b3405-15b2-39b6-b1a2-f6f18e10e81d",
                                                "text": "„Elma lächelte instinktiv zurück, als er ihr zur Begrüßung die Hand reichte und sich vorstellte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
