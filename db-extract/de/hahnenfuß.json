                                            "Ellipsis of buttercup squash."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "72018227-782d-3c45-931f-d156a0cb6526",
                                        "entry_id": "dac722fd-9c4d-3341-b46c-5e3f3d55f263",
                                        "glosses": [
                                            "Affectionate or ironic term of address."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "900dfc21-fd7b-46d7-bde1-495d4533b449",
                                                "sense_id": "72018227-782d-3c45-931f-d156a0cb6526",
                                                "text": "When she touched my hand, what a chill I got\nHer lips are like a volcano that's hot\nI'm proud to say that she's my buttercup.\nI'm in love - I'm all shook up."
                                            },
                                            {
                                                "example_id": "f1060911-ceed-4de3-9a16-003d322cf10a",
                                                "sense_id": "72018227-782d-3c45-931f-d156a0cb6526",
                                                "text": "Listen, buttercup, you're damned good in bed. They don't come any better, but I'm really not interested in playing second fiddle to your camera or your young lovers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "140febb7-3ee2-44fb-a8aa-830e9d8d00e1",
                        "source_entry_id": "e0ce67be-98d7-3236-85ff-34dbe3384fe4",
                        "source_sense_id": "dce897d9-c546-30ee-8049-ce869b72bd90",
                        "source_sense_description": "Botanik: gelb oder weiß blühende Pflanze aus der Gattung Ranunculus",
