{
    "word_family": [
        "exclusiviteit",
        "exclusivisme",
        "exclusie",
        "excluderen"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0dc08649-fb3b-35ab-83cc-7978977d83b3",
                    "sense_definition": "bijzonder en duur omdat het maar voor een kleine groep mensen beschikbaar is",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bijzonderheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit <w>exclusieve</w> restaurant is alleen toegankelijk voor leden.",
                            "target_lang_translations": {
                                "en": "This <w>exclusive</w> restaurant is only accessible to members."
                            }
                        },
                        {
                            "text": "Zij dragen altijd <w>exclusieve</w> kleding van bekende ontwerpers.",
                            "target_lang_translations": {
                                "en": "They always wear <w>exclusive</w> clothing from famous designers."
                            }
                        }
                    ],
                    "synonyms": [
                        "bijzonder",
                        "chic",
                        "speciaal",
                        "apart"
                    ],
                    "antonyms": [
                        "alledaags",
                        "gewoon"
                    ],
                    "common_phrases": [
                        "exclusieve kleding",
                        "exclusief restaurant",
                        "exclusief interview"
                    ],
                    "target_lang_definitions": {
                        "en": "special and expensive because it is only available to a small group of people"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "exclusive",
                                "target_lang_sense_clarification": "high-end and restricted to a select group"
                            },
                            {
                                "target_lang_word": "upscale",
                                "target_lang_sense_clarification": "expensive and intended for wealthy people"
                            },
                            {
                                "target_lang_word": "high-end",
                                "target_lang_sense_clarification": "of superior quality and high price"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e12978d-0509-3707-be73-45d34a460bd1",
                    "sense_definition": "wat andere mogelijkheden of personen uitsluit",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uitsluiting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij hebben een <w>exclusief</w> contract getekend met die uitgeverij.",
                            "target_lang_translations": {
                                "en": "They have signed an <w>exclusive</w> contract with that publisher."
                            }
                        },
                        {
                            "text": "Het recht op deze informatie is <w>exclusief</w> voor de directie.",
                            "target_lang_translations": {
                                "en": "The right to this information is <w>exclusive</w> to the management."
                            }
                        }
                    ],
                    "antonyms": [
                        "inclusief"
                    ],
                    "common_phrases": [
                        "exclusief recht",
                        "exclusief contract"
                    ],
                    "target_lang_definitions": {
                        "en": "excluding other possibilities or persons"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "exclusive",
                                "target_lang_sense_clarification": "not shared with others; sole"
                            },
                            {
                                "target_lang_word": "sole",
                                "target_lang_sense_clarification": "being the only one"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "b880c91e-b17b-340f-a2b2-5ba6d2bcad43",
                    "sense_definition": "zonder dat het genoemde erbij geteld is",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "berekening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een overnachting in dit hotel kost 230 euro <w>exclusief</w> ontbijt.",
                            "target_lang_translations": {
                                "en": "An overnight stay in this hotel costs 230 euros <w>excluding</w> breakfast."
                            }
                        },
                        {
                            "text": "De prijs van de auto is <w>exclusief</w> btw.",
                            "target_lang_translations": {
                                "en": "The price of the car is <w>exclusive of</w> VAT."
                            }
                        }
                    ],
                    "antonyms": [
                        "inclusief"
                    ],
                    "common_phrases": [
                        "exclusief btw",
                        "exclusief verzendkosten",
                        "exclusief ontbijt"
                    ],
                    "target_lang_definitions": {
                        "en": "without the mentioned item being included in the count or price"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "excluding",
                                "target_lang_sense_clarification": "not including"
                            },
                            {
                                "target_lang_word": "exclusive of",
                                "target_lang_sense_clarification": "not taking into account"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "bc5378fa-184d-3691-98cc-6036cdd0c861",
                    "sense_definition": "op een manier die alles of iedereen uitsluit behalve het genoemde",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uitsluiting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit product is <w>exclusief</w> verkrijgbaar bij onze speciaalzaken.",
                            "target_lang_translations": {
                                "en": "This product is <w>exclusively</w> available at our specialty stores."
                            }
                        },
                        {
                            "text": "Hij richt zich <w>exclusief</w> op zijn nieuwe project.",
                            "target_lang_translations": {
                                "en": "He is focusing <w>solely</w> on his new project."
                            }
                        }
                    ],
                    "common_phrases": [
                        "exclusief verkrijgbaar"
                    ],
                    "target_lang_definitions": {
                        "en": "in a way that excludes everything or everyone except what is mentioned"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "exclusively",
                                "target_lang_sense_clarification": "only and solely"
                            },
                            {
                                "target_lang_word": "solely",
                                "target_lang_sense_clarification": "not involving anything else"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}