        "fr-extract.jsonl": [
            {
                "entry_id": "9d738dbb-7ef5-32cf-a862-177dae6adb38",
                "word": "explicite",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4f397a1b-836a-4154-87cb-2a8ea18601a9",
                        "entry_id": "9d738dbb-7ef5-32cf-a862-177dae6adb38",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "explicites"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d87160bf-9b08-37f3-8998-1a510851bbe4",
                        "entry_id": "9d738dbb-7ef5-32cf-a862-177dae6adb38",
                        "glosses": [
                            "Qui est exprimé, rédigé ou énoncé par quelque chose de manière directe, d’une façon claire et précise sur laquelle on ne peut se tromper. Dans le cas d’un texte, l’explicite est ce qu’il affirme textuellement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64d9896b-4148-4a2e-9245-7e98a46b80b2",
                                "sense_id": "d87160bf-9b08-37f3-8998-1a510851bbe4",
                                "text": "Monsieur, en arrivant près du carrosse, fut frappé de cet éclat ; il témoigna son admiration en termes assez explicites pour que le chevalier de Lorraine haussât les épaules dans le groupe des courtisans"
                            },
                            {
                                "example_id": "7a66d584-dce3-45df-a506-1294013ef797",
                                "sense_id": "d87160bf-9b08-37f3-8998-1a510851bbe4",
                                "text": "J'ai reçu des nouvelles du front ; lequel, on ne me le dit pas. Le timbre de la poste est mystérieux. Il porte seulement ces mots peu explicites : Trésor et Postes, 20 octobre."
                            },
                            {
                                "example_id": "f8943b0e-81a8-43ed-9fff-0b584263d814",
                                "sense_id": "d87160bf-9b08-37f3-8998-1a510851bbe4",
                                "text": "M. de Grandville aurait dit à Camusot : « Vous resterez pendant toute votre vie juge d’instruction !… » il n’aurait pas été plus explicite que dans cette phrase complimenteuse."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b02ed3c4-8aa1-453b-9ba2-0956531b345e",
                        "source_entry_id": "9d738dbb-7ef5-32cf-a862-177dae6adb38",
                        "source_sense_id": "d87160bf-9b08-37f3-8998-1a510851bbe4",
                        "target_lang_word": "explicit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "explicit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1b7fda10-d683-3f82-8430-da1f7fb7d2de",
                                        "entry_id": "9066de5f-257c-3a07-835e-7d47e4bcb2db",
                                        "glosses": [
                                            "Very specific, clear, or detailed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca141c97-36ff-41d0-b698-886b9fa847ac",
                                                "sense_id": "1b7fda10-d683-3f82-8430-da1f7fb7d2de",
                                                "text": "I gave explicit instructions for him to stay here, but he followed me, anyway."
                                            },
                                            {
                                                "example_id": "fa9c926a-c121-4669-846a-0cacd63aa643",
                                                "sense_id": "1b7fda10-d683-3f82-8430-da1f7fb7d2de",
                                                "text": "If the task is indeed a difficult one, it may be worthwhile to attempt an explicit statement as to those aspects of the endeavor that appear to have the greatest importance for success or failure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c82b05b-b5c2-3642-98b7-a04dc5f2cb5d",
                                        "entry_id": "9066de5f-257c-3a07-835e-7d47e4bcb2db",
                                        "glosses": [
                                            "Containing material (e.g. language or film footage) that might be deemed offensive or graphic through clear and direct expressions."
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcd99caf-d057-4718-a761-1d1015ce7185",
                                                "sense_id": "5c82b05b-b5c2-3642-98b7-a04dc5f2cb5d",
                                                "text": "The film had several scenes including explicit language and sex."
                                            },
                                            {
                                                "example_id": "8641965d-5a34-4ad1-b677-77bf5a519f8d",
                                                "sense_id": "5c82b05b-b5c2-3642-98b7-a04dc5f2cb5d",
                                                "text": "Cerberus Scientist: I'm sorry, sir. None of Normandy's surveillance feeds have been responding since Shepard went rogue.\nIllusive Man: I want it back. Retry the remote lockdown protocols.\nCerberus Scientist: After our last attempt, EDI flooded our server with seven zettabytes of explicit images. I think she was making a joke."
                                            }
                                        ]
                                    }
                                ]
                            },
