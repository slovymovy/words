                    {
                        "translation_id": "769a6524-f706-40db-8fe7-e6b096124efb",
                        "source_entry_id": "a6b32201-bb92-39fc-9685-8b25c252dced",
                        "source_sense_id": "06604e58-3543-36fb-ac6a-16936e171044",
