                                        "glosses": [
                                            "To thrust oneself in; to come or enter without invitation, permission, or welcome; to encroach; to trespass."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8a15294-f59f-4d35-8d56-f04e2ff0301d",
                                                "sense_id": "29c42c01-8047-30d3-9de5-8c82a79b83cb",
                                                "text": "to intrude on families at unseasonable hours; to intrude on the lands of another"
                                            },
                                            {
                                                "example_id": "f2484967-44a6-47bd-b0e9-2ef46c05e1cc",
                                                "sense_id": "29c42c01-8047-30d3-9de5-8c82a79b83cb",
                                                "text": "Some thoughts rise and intrude upon us, while we shun them; others fly from us, when we would hold them."
