                ],
                "senses": [
                    {
                        "sense_id": "a4c9933b-c5a2-3fc0-886c-f983843a8abb",
                        "entry_id": "f9dd558c-3864-3f05-b21f-8d83c693c186",
                        "glosses": [
                            "Strömungsmaschine mit horizontaler Rotation, welche die kinetische Energie des Windes in elektrischen Strom umwandelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "759b7b16-76dd-48fb-91ff-72d9452fdb18",
                                "sense_id": "a4c9933b-c5a2-3fc0-886c-f983843a8abb",
                                "text": "Eine typische Horizontalturbine, die rundum viel Platz braucht, sind die als Windrad oder Windkraftanlage bezeichneten Horizontalrotoren diverser Windparks."
                            },
                            {
                                "example_id": "a49da9f4-82a1-49f4-a1fb-705114f3115e",
                                "sense_id": "a4c9933b-c5a2-3fc0-886c-f983843a8abb",
                                "text": "Die gute, alte Windmühle ist der Vorläufer heutiger Horizontalturbinen."
                            },
                            {
                                "example_id": "2f8ee9f7-51cf-4726-8841-2be5c423976b",
                                "sense_id": "a4c9933b-c5a2-3fc0-886c-f983843a8abb",
                                "text": "„Je nachdem die Welle einer Turbine wagrecht oder senkrecht angeordnet ist, erhält man eine ‚Horizontalturbine’ oder eine ‚Vertikalturbine’ […].“"
                            },
                            {
                                "example_id": "1875c7c4-6554-41ef-9573-207b21702145",
                                "sense_id": "a4c9933b-c5a2-3fc0-886c-f983843a8abb",
                                "text": "„Je nach der Bauart von Pelton-Turbinen unterscheidet man Radiallager für Querkräfte bei Horizontalturbinen und Axiallager für Längskräfte bei Vertikalturbinen.“"
                            },
                            {
                                "example_id": "60ceec2b-3cd7-4ab5-a27f-b406aa76aab4",
                                "sense_id": "a4c9933b-c5a2-3fc0-886c-f983843a8abb",
                                "text": "„Die erstere Anlage umfaßte zwei Dynomamaschinen mit zugehöriger unmittelbar gekuppelter Horizontalturbine, welche in Fig. 434 abgebildet sind.“"
                            },
                            {
                                "example_id": "db1e5da3-ccd1-4c7c-b488-5ad73d93273c",
                                "sense_id": "a4c9933b-c5a2-3fc0-886c-f983843a8abb",
                                "text": "„Sein großer Platzbedarf und die daraus folgenden hohen Kosten, bei Horizontalturbinen auch die notwendige doppelte Umlenkung der Strömung, bringen es mit sich, daß das gerade konische Saugrohr trotz seiner hydraulischen Vorteile für sich allein nur ausnahmsweise verwendet werden kann.“"
                            },
                            {
                                "example_id": "eb99f20c-08c4-4882-ae2e-8e5ce20bcb6b",
                                "sense_id": "a4c9933b-c5a2-3fc0-886c-f983843a8abb",
                                "text": "„Die Energie wird von drei Einphasen-Generatoren erzeugt, die von drei als Horizontalturbinen ausgeführte FranzisSpiralturbinen von je 2700 PS Leistung angetrieben werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
