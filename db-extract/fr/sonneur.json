                                        "entry_id": "8e5e0d14-f6ad-365d-a7be-22968b8a426e",
                                        "glosses": [
                                            "An assignment, done regularly at the beginning of a class, and intended as a warm-up before other classroom activities."
                                        ],
                                        "tags": [],
