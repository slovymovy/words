                "senses": [
                    {
                        "sense_id": "a100e2d6-0ecd-30de-97b6-d535225f52d7",
                        "entry_id": "d90a5441-872d-3408-89a2-c8572c03884f",
                        "glosses": [
                            "een (ongeoorloofde) reclame-uiting die men in een programma mengt zonder duidelijk te maken dat het om reclame gaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc720120-4748-4f89-b962-54fb57cfb32d",
                                "sense_id": "a100e2d6-0ecd-30de-97b6-d535225f52d7",
                                "text": "Eén en dezelfde sluikreclame op alle kanalen."
                            },
                            {
                                "example_id": "4d518541-5163-4634-b3d6-a7b66de92f03",
                                "sense_id": "a100e2d6-0ecd-30de-97b6-d535225f52d7",
                                "text": "‘Ongehoord’, vindt Tim Smits. ‘De Belgian pledge moet beter nageleefd worden.’ Volgens Smits zou ook een duidelijk hashtag, zoals #ad of #spon, ons al meer bewust maken van de sluikreclame. In het buitenland, in Nederland bijvoorbeeld, zijn de regels veel strikter. Daar moeten influencers verplicht deze hashtags gebruiken."
                            },
                            {
                                "example_id": "a4c06350-0e93-496b-943d-ce710e5d811d",
                                "sense_id": "a100e2d6-0ecd-30de-97b6-d535225f52d7",
                                "text": "Vorig jaar stelde het Commissariaat voor de Media samen met een aantal YouTubers een sociale code op om sluikreclame te voorkomen. Die code gaat vooral over transparantie: zeg het wanneer je betaald wordt om reclame te maken voor een bedrijf of product of wanneer je iets gratis hebt gekregen. Maar de code wordt door meer dan de helft van de YouTubers genegeerd."
                            }
                        ]
                    }
                ],
