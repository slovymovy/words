                ],
                "senses": [
                    {
                        "sense_id": "5f0ac23e-48e0-390b-996a-3cd3460bfefc",
                        "entry_id": "341820ec-ae15-3ba7-8cfc-fae6d4c6344c",
                        "glosses": [
                            "Gelegenheit zum Abfahren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdd96c1e-f88d-4dae-9a05-11ece97b5ec7",
                                "sense_id": "5f0ac23e-48e0-390b-996a-3cd3460bfefc",
                                "text": "„Also besser der schmalen Straße Richtung Doss Remit folgen, um von dort aus die Abfahrtsmöglichkeit über die Malga Rigotti nach Loppio zu erreichen.“"
                            },
                            {
                                "example_id": "7b92f8c5-09b3-4bb3-b099-75f1ab132ca2",
                                "sense_id": "5f0ac23e-48e0-390b-996a-3cd3460bfefc",
                                "text": "„Daneben war vor allem eine logistische Hürde zu nehmen: Es gab zur Baustelle nur eine Zu- und Abfahrtsmöglichkeit, zudem musste das komplette Material durch das Wohngebiet transportiert werden.“"
                            },
                            {
                                "example_id": "0c43ebe8-1008-4566-92e4-e133f27ae54b",
                                "sense_id": "5f0ac23e-48e0-390b-996a-3cd3460bfefc",
                                "text": "„Die Anwohner werden gebeten, ihre Fahrzeuge in der betreffenden Zeit außerhalb der Festzone zu parken, da während der Festtage keine Zu- und Abfahrtsmöglichkeit besteht.“"
                            },
                            {
                                "example_id": "5fc4c84c-1dd1-44e5-9727-0ef59d297aaa",
                                "sense_id": "5f0ac23e-48e0-390b-996a-3cd3460bfefc",
                                "text": "„Um die Trauben zu ihrem Weingut zu bringen und den Frischmost jederzeit abholen zu lassen, um ihre vertraglichen Verpflichtungen mit Kellereien erfüllen zu können, sei sie auf die ununterbrochene An- und Abfahrtsmöglichkeit über die Hauptstraße angewiesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
