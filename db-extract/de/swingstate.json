                "senses": [
                    {
                        "sense_id": "ae5fca90-e1b6-30c7-a18c-92d6d6d767ce",
                        "entry_id": "7298d7de-dab5-3019-96dc-06ccd5ec7927",
                        "glosses": [
                            "US-Bundesstaat, bei dem der Wahlausgang der Präsidentschaftswahl unklar ist, da weder die Demokraten noch die Republikaner eine strukturelle Mehrheit besitzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "279ed900-d836-4391-a8b7-c659df6d0ce0",
                                "sense_id": "ae5fca90-e1b6-30c7-a18c-92d6d6d767ce",
                                "text": "„Wisconsin gilt als wichtiger Swingstate im Kampf ums US-Präsidentenamt.“"
                            },
                            {
                                "example_id": "848f8fe0-466f-4825-9029-fe44c4be4b61",
                                "sense_id": "ae5fca90-e1b6-30c7-a18c-92d6d6d767ce",
                                "text": "[…] „Georgia ist ein Swingstate, also ein Bundesstaat, bei dem sich Demokraten und Republikaner abwechselnd den Sieg abringen, den die Demokraten unter Joe Biden 2020 mit nur 0,2 Prozentpunkten Vorsprung gewannen.“"
                            },
                            {
                                "example_id": "a7b27dc1-a210-478f-8d51-7b6b0862e26c",
                                "sense_id": "ae5fca90-e1b6-30c7-a18c-92d6d6d767ce",
                                "text": "„Doch Whitmer gelang es, eine weitere Amtszeit mit einem größeren Vorsprung als erwartet zu gewinnen - und das im wichtigen Swingstate Michigan, wo ein Sieg für die Demokraten sehr viel weniger sicher ist als beispielsweise in Kalifornien oder New York.“"
                            },
                            {
                                "example_id": "7c204c74-c8d9-4a55-a9f8-0f8424f9fc74",
                                "sense_id": "ae5fca90-e1b6-30c7-a18c-92d6d6d767ce",
                                "text": "„Die Demokraten mobilisieren nun im umkämpften Swingstate Florida.“"
                            },
                            {
                                "example_id": "e4f0103e-ed40-45c1-83f3-eb3fccdf8120",
                                "sense_id": "ae5fca90-e1b6-30c7-a18c-92d6d6d767ce",
                                "text": "„Kamala Harris hielt ihr Schlussplädoyer vor dem Weissen Haus, Donald Trump sprach im umkämpften Swingstate Pennsylvania und Noch-Präsident Biden trat wieder mal in ein Fettnäpfchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
