                {
                    "sense_id": "db775887-4371-3107-af1d-d88c3e96885a",
                    "sense_definition": "Een informele groet om afscheid te nemen bij het weggaan.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "farewell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het was erg gezellig, tot morgen, <w>hoi</w>!",
                            "target_lang_translations": {
                                "ru": "Было очень здорово, до завтра, <w>пока</w>!",
                                "en": "It was really fun, see you tomorrow, <w>bye</w>!",
                                "pl": "Było bardzo miło, do jutra, <w>cześć</w>!",
                                "de": "Es war sehr schön, bis morgen, <w>tschüss</w>!",
                                "fr": "C'était très sympa, à demain, <w>salut</w> !",
                                "it": "È stato molto piacevole, a domani, <w>ciao</w>!",
                                "cs": "Bylo to moc příjemné, tak zítra, <w>ahoj</w>!",
                                "tr": "Çok keyifliydi, yarına kadar, <w>hoşça kal</w>!",
                                "es": "Fue muy divertido, hasta mañana, ¡<w>chao</w>!",
                                "zh": "玩得很开心，明天见，<w>拜拜</w>！"
                            }
                        },
                        {
                            "text": "Ik moet nu echt naar huis, <w>hoi</w>.",
                            "target_lang_translations": {
                                "ru": "Мне правда пора домой, <w>пока</w>.",
                                "en": "I really have to go home now, <w>bye</w>.",
                                "pl": "Naprawdę muszę już iść do domu, <w>cześć</w>.",
                                "de": "Ich muss jetzt wirklich nach Hause, <w>tschüss</w>.",
                                "fr": "Je dois vraiment rentrer à la maison maintenant, <w>salut</w>.",
                                "it": "Devo proprio andare a casa ora, <w>ciao</w>.",
                                "cs": "Už musím opravdu domů, <w>ahoj</w>.",
                                "tr": "Artık gerçekten eve gitmem lazım, <w>hoşça kal</w>.",
                                "es": "Realmente tengo que irme a casa ahora, <w>adiós</w>.",
                                "zh": "我真的得回家了，<w>拜拜</w>。"
                            }
                        }
