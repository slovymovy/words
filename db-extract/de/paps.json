                ],
                "translations": [
                    {
                        "translation_id": "462036f4-a5b0-4bd4-8548-b17763609ef2",
                        "source_entry_id": "4d60e672-916b-3c4c-b3b2-c80fd70aceca",
                        "source_sense_id": "61313c06-663e-31ad-acf2-907211c81923",
