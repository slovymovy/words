                        "entry_id": "ce713e78-221d-3b4e-bdf5-2c6dc37df1ae",
                        "glosses": [
                            "The point in the elliptical orbit of a comet, planet, or other astronomical object, where it is farthest from the Sun."
                        ],
                        "tags": [
                            "also",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "9281f624-c1c8-4fd3-9e96-4aa493bf5acb",
                                "sense_id": "47833b35-3d24-3a20-bbf5-7a43da2d4a9b",
                                "text": "[I]t follows from the theory of gravity, that the aphelia of Mercury, Venus, the Earth, and Mars, slightly progress."
                            }
                        ]
                    }
                ],
