                ],
                "translations": [
                    {
                        "translation_id": "9f91ca8f-5894-49f3-acdd-d8a63da1b36b",
                        "source_entry_id": "d54e4f7b-3099-3f0b-a524-39032f5cabe7",
                        "source_sense_id": "97cb1db8-eb85-3360-ae3d-ca47ecb08b84",
                        "target_lang_word": "exubérant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exubérant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "37d3ed8d-f267-339e-943f-903870f65a3c",
                                        "entry_id": "15b33ea0-097e-35c5-b20a-7440b0f72a13",
                                        "glosses": [
                                            "Qui a de l’exubérance, au propre et au figuré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe292dde-2813-45ff-a574-06b2faf10270",
                                                "sense_id": "37d3ed8d-f267-339e-943f-903870f65a3c",
                                                "text": "Avec sa végétation exubérante de tiges et de feuilles, elle épuise fortement le sol: elle exige de bonnes fumures, et parmi les engrais chimiques réclame surtout l’azotate de soude, le chlorure de sodium et la chaux."
                                            },
                                            {
                                                "example_id": "aaa77071-f898-4fc1-a1bf-97b062d4951e",
                                                "sense_id": "37d3ed8d-f267-339e-943f-903870f65a3c",
                                                "text": "On cultive le loganberry comme le framboisier, en lui laissant, toutefois, plus d'espace : le loganberry a une végétation exubérante, et ses rameaux, ont souvent quatre à cinq mètres de longueur."
                                            },
                                            {
                                                "example_id": "4ca5b1e8-cbe6-407f-8fba-3f616c56d134",
                                                "sense_id": "37d3ed8d-f267-339e-943f-903870f65a3c",
                                                "text": "Dans son numéro du 15 janvier 1899, le journal bimensuel parisien le Correspondant médical tirait la sonnette d’alarme en disant : « L'enfant boit ! […]. Les nourrices donnent du vin à leurs nourrissons et s’ébaudissent de leur exubérante gaîté. »"
                                            },
                                            {
                                                "example_id": "b40142ff-6b24-4bb8-90bc-1abd7f9d273f",
                                                "sense_id": "37d3ed8d-f267-339e-943f-903870f65a3c",
                                                "text": "[…] ; sa mère est une cyclothymique avérée passant, sans motifs apparents, d'un sentiment profond d'ennui à celui d'une gaîté plus ou moins exubérante."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "exubérant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "141b4fbb-77dc-3ae3-97a8-96577675a920",
                                        "entry_id": "70b430a2-5ca7-34c5-b7ad-788f42b359f8",
                                        "glosses": [
                                            "Participe présent de exubérer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a2bf424-bc03-468a-8bf9-e9598850dbc7",
                        "source_entry_id": "d54e4f7b-3099-3f0b-a524-39032f5cabe7",
                        "source_sense_id": "97cb1db8-eb85-3360-ae3d-ca47ecb08b84",
                        "target_lang_word": "volcanique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "volcanique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "758fe679-b167-338d-a88c-392efe39c33e",
                                        "entry_id": "38498763-e35c-38dd-9d0a-b6c0500c6735",
                                        "glosses": [
                                            "Relatif aux volcans et à leur activité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9e29e13-d8ea-4588-b757-8c693dccad91",
                                                "sense_id": "758fe679-b167-338d-a88c-392efe39c33e",
                                                "text": "Mais, je vous l'avoue, la composition volcanique de ce sol m'inquiète."
                                            },
                                            {
                                                "example_id": "83f93909-e6bd-4956-9ebf-5f711bc3622e",
                                                "sense_id": "758fe679-b167-338d-a88c-392efe39c33e",
                                                "text": "Les îles Féroë sont entièrement d'origine volcanique : elles ont surgi de toutes pièces du sein d’Amphitrite et sont, comme l’Islande, constituées de trapp de formation sous-marine."
                                            },
                                            {
                                                "example_id": "fc180e8b-c0b2-42cf-8a3f-ba570a4eee2c",
                                                "sense_id": "758fe679-b167-338d-a88c-392efe39c33e",
                                                "text": "Les pentes vertes du mont San Giachinno, au Sud [sic] de l’île, contrastaient étrangement avec la partie Nord [sic], hérissée de petits cônes volcaniques et presque entièrement dépourvue de végétation."
                                            },
                                            {
                                                "example_id": "67261d11-4b25-4aff-9693-7c309a235fa5",
                                                "sense_id": "758fe679-b167-338d-a88c-392efe39c33e",
                                                "text": "Au Maroc Nord oriental, les gisements de bentonites sont, en grande partie, liés au complexe volcanique de Gourougou."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a07caac5-29b0-352e-9eb4-6017cd55ea25",
                                        "entry_id": "38498763-e35c-38dd-9d0a-b6c0500c6735",
                                        "glosses": [
                                            "Qui est creusé de cratères."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89824398-6abf-4684-8dfd-31e83b27da16",
                                                "sense_id": "a07caac5-29b0-352e-9eb4-6017cd55ea25",
                                                "text": "Là-dessus notre équipe eut mission d'aller à Souain […]. Une demi-heure après nous étions sur le terrain volcanique et comme lunaire tant de fois décrit, et réellement indes­criptible. Des coups de pouce d'un sculpteur gigantesque dans la glaise séchée, ou bien cet aspect des nids de guêpes, gris et feuilletés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "849a2e53-d76e-3cb0-b7cc-8acc57cdcbf8",
                                        "entry_id": "38498763-e35c-38dd-9d0a-b6c0500c6735",
                                        "glosses": [
                                            "Qui est ardent, Impétueux, qui est toujours en fermentation."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f255c92-6bab-4f15-bb6a-5f6f810144f4",
                                                "sense_id": "849a2e53-d76e-3cb0-b7cc-8acc57cdcbf8",
                                                "text": "Une imagination volcanique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28cd93bc-5958-3ea7-9f5c-880826267f72",
                                        "entry_id": "38498763-e35c-38dd-9d0a-b6c0500c6735",
                                        "glosses": [
                                            "Qui a un caractère impulsif, explosif."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3389854-92b3-4c62-9f8f-9b2c69c1b9de",
                                                "sense_id": "28cd93bc-5958-3ea7-9f5c-880826267f72",
                                                "text": "Le copain de Jalibert ne sort pas de sa meilleure saison de sa carrière, après son passage mouvementé de l’UBB au Racing 92, sur fond de brouille avec le volcanique Christophe Urios."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
