                "senses": [
                    {
                        "sense_id": "2b98a58c-7d96-3cea-91bc-6e543e7927c8",
                        "entry_id": "97116487-dfa5-30fe-9b93-60611a23e302",
                        "glosses": [
                            "nauka o budowie skorupy ziemskiej oraz o procesach wpływających na nią,"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6ce49f3-fe52-4e20-9ea6-f743133b9da7",
                                "sense_id": "2b98a58c-7d96-3cea-91bc-6e543e7927c8",
                                "text": "Uwzględniając przedmiot i metody badań, tektonikę można podzielić na geotektonikę, mikrotektonikę, tektonofizykę, geodynamikę, geologię strukturalną."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5839307e-f99a-46c1-81c3-2f6d2b43dc77",
