                "senses": [
                    {
                        "sense_id": "68145a48-40e1-3994-9be2-bbfabcfcba4f",
                        "entry_id": "b5531d23-a124-3c5c-ae9c-bc2f1a4bd0e9",
                        "glosses": [
                            "Hotelbetrieb, der besonders komfortabel eingerichtet ist und sehr guten Service bietet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60581418-0748-4cbd-ad04-09fdbab74484",
                                "sense_id": "68145a48-40e1-3994-9be2-bbfabcfcba4f",
                                "text": "„Er saß herum in den Hallen der Luxushotels, in den Bars der Stadt, in den Cafés, wo die Börsianer saßen.“"
                            },
                            {
                                "example_id": "1c749004-6da3-4b71-a04b-c337e7e4b1f1",
                                "sense_id": "68145a48-40e1-3994-9be2-bbfabcfcba4f",
                                "text": "„Am Silvester-Abend ist in Dubai in der Nähe der Feierlichkeiten ein Grossbrand in einem Luxushotel ausgebrochen.“"
                            },
                            {
                                "example_id": "949b7dc6-ae84-4ba6-a930-cc06e63f2f3f",
                                "sense_id": "68145a48-40e1-3994-9be2-bbfabcfcba4f",
                                "text": "„Silvester habe ich übrigens auf Einladung einer Freundin in einem Luxushotel in Antalya verbracht.“"
                            },
                            {
                                "example_id": "cea02e4c-b43d-491c-a108-ab2967f7e468",
                                "sense_id": "68145a48-40e1-3994-9be2-bbfabcfcba4f",
                                "text": "„Nachdem ich an jenem Tag im Luxushotel erwacht war, brach ich zu einem Spaziergang auf.\""
                            },
                            {
                                "example_id": "1a822da9-1dd9-4405-abce-20ed92f8a211",
                                "sense_id": "68145a48-40e1-3994-9be2-bbfabcfcba4f",
                                "text": "„Nkomo nährte den Argwohn dadurch, dass er häufig und lange im Ausland weilte, um dort Kontakte aufzubauen und um Unterstützung zu werben. In diesen Zeiten fehlte die politische Führung im Land selbst, und außerdem verstärkte sein Verhalten den Verdacht, Nkomo genieße das gute Leben in Luxushotels und wolle sich der staatlichen Repression entziehen, während seine Mitstreiter Inhaftierung und Schlimmeres riskierten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
