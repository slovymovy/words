                "senses": [
                    {
                        "sense_id": "aabd6008-a630-3398-a244-67becbecfe00",
                        "entry_id": "bc49c2fc-05b9-3c12-a2e6-cd760751eb94",
                        "glosses": [
                            "Intoxiquer par soi-même, sans intervention extérieure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc73882b-4d70-4274-9194-bee8ea58cec8",
                                "sense_id": "aabd6008-a630-3398-a244-67becbecfe00",
                                "text": "Il est commode d'utiliser comme récipient d'élevage soit des fioles d'Erlenmeyer, soit des tubes de Borel, soit des boîtes de Pétri, de 10 cm de diamètre de préférence, de manière à avoir un volume d'eau suffisant, sinon l'élevage risque de s'autointoxiquer."
                            },
                            {
                                "example_id": "c2de1f97-3f1d-41f3-baf2-9959588ff64a",
                                "sense_id": "aabd6008-a630-3398-a244-67becbecfe00",
                                "text": "Un savant mécanisme d’autorégulation contrebalance en effet la loi de la jungle dans la nature : certaines plantes avides d’espace ne peuvent s’étendre trop loin sans risquer de s’autointoxiquer ; […]"
                            }
                        ]
                    }
