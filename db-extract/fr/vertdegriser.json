                ],
                "senses": [
                    {
                        "sense_id": "611d1583-76d0-30a0-9e39-0e9877a95246",
                        "entry_id": "9d58eed5-3e94-3e41-938c-35b99e0d165a",
                        "glosses": [
                            "Rendre vert de gris."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18e40a1c-8c8f-49c6-b100-04320aaefb18",
                                "sense_id": "611d1583-76d0-30a0-9e39-0e9877a95246",
                                "text": "Nous devons le concéder, c’est à Condillac, non à Locke, que Biran peut reprocher de vertdegriser le sujet en absorbant toutes ses facultés en une seule, car chez Locke, la séparation entre elles, ainsi que leur originarité, sont évidentes."
                            },
                            {
                                "example_id": "6f292e42-dfac-4e6b-8b11-d8b8b96b0b8d",
                                "sense_id": "611d1583-76d0-30a0-9e39-0e9877a95246",
                                "text": "La fièvre faisait claquer leurs dents, et leur teint jaune semblait se vertdegriser à la pluie qui, depuis le matin, tombait d’une façon diluvienne."
                            },
                            {
                                "example_id": "5046ef68-ea8e-463b-a60c-eb2b39e1e28d",
                                "sense_id": "611d1583-76d0-30a0-9e39-0e9877a95246",
                                "text": "Du matin jusqu’au soir, nous attribuant la musculature efficace et la morphologie dynamique du discobole, nous sillonnons l’espace, épiant le globe qui se débleuise, qui se vertdegrise, en décomposition, ivres de notre divin pouvoir, nous esclaffant en passant de la pieuse beauté des icônes de moi."
                            }
                        ]
                    }
                ],
