                        "examples": [
                            {
                                "example_id": "985e7110-85ea-44f1-8137-1162cd4e6c07",
                                "sense_id": "f4361b69-c586-3ff4-af6c-42a15d51710b",
                                "text": "Again, whatever is not here nor there, now nor then, is capable of being nowhen or nowhere; and so all things which consist of parts, though they may exist always (like Time) or everywhere (like the Universe),[…]"
                            },
                            {
                                "example_id": "27deae94-bf13-446f-9d57-1a2dace2bd22",
                                "sense_id": "f4361b69-c586-3ff4-af6c-42a15d51710b",
                                "text": "Do they have continuous existence, nowhere and nowhen, or are they created as needed by categorial reason? On what ground can we postulate them in order to define truth? If they merely copy the world why do we need them and how do we[…]"
                            }
                        ]
                    }
