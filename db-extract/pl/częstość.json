                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65144ed8-88ee-45aa-802f-b829469852f1",
                                                "sense_id": "861fcfca-6d38-3a76-870f-aa540d8772cb",
                                                "text": "Diese Häufigkeit blieb über die Jahre konstant."
                                            },
                                            {
                                                "example_id": "12b89626-6800-42f0-b27c-8681878f81ba",
                                                "sense_id": "861fcfca-6d38-3a76-870f-aa540d8772cb",
                                                "text": "„Bei den Päpsten finden wir die größten Häufigkeiten bei den kürzeren Regierungsdauern.“"
                                            },
                                            {
                                                "example_id": "09407081-f20c-4005-be81-84642c8b29ab",
                                                "sense_id": "861fcfca-6d38-3a76-870f-aa540d8772cb",
                                                "text": "„Im Lauf der Jahre ließ die Häufigkeit von Odeds Besuchen nach.“"
                                            }
