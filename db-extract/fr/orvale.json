                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1af70a7-e6cd-46b7-bd67-7bdec160ff3f",
                                "sense_id": "781c7cc4-a923-3800-9b34-c53d5472e94b",
                                "text": "Quand les fleurs de l’orvale sont en pleine maturité, on peut en faire un très bon vin, en faisant bouillir tiges et fleurs avec une certaine quantité de sucre."
                            },
                            {
                                "example_id": "449667a5-8da6-4e0b-ad8a-42eaae7eebfc",
                                "sense_id": "781c7cc4-a923-3800-9b34-c53d5472e94b",
                                "text": "La sauge sclarée, appelée en France Orvale, ou Toute-bonne et quelquefois Sauge muscat en raison de son odeur de muscat, est connue depuis longtemps pour ses qualités thérapeutiques et culinaires."
                            }
                        ]
                    }
