                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c072f3f-596c-468e-8f73-669bdc8b27c0",
                                                "sense_id": "d60672d1-bdcd-3d9c-9d27-5e75d298bb37",
                                                "text": "Klasyczna retoryka została później dostosowana do potrzeb różnych czasów i krajów, w których się rozwijała"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "13f25a0f-e640-3635-9502-155baa8cdfa4",
                                        "entry_id": "eaa3f086-cc87-3e11-b564-472e27118511",
                                        "glosses": [
                                            "średniowieczny przedmiot wykładany na uniwersytetach jako retoryka (1.1)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
