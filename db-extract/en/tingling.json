                                        "entry_id": "19fbb54b-c882-3ebb-8c9b-e024e9ea115c",
                                        "glosses": [
                                            "Impression incommode et un peu douloureuse de piqûres légères à la surface de la peau ou dans la profondeur des tissus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bf6bdba-fd10-416b-8b1a-14438d1ac41e",
                                                "sense_id": "c8314e2f-70f5-3c2c-a1e2-a6f17e32533f",
                                                "text": "Sentir des picotements par toute la peau, par tout le corps."
                                            },
                                            {
                                                "example_id": "05ce6c64-2c48-4657-bd8d-5db5a83aecba",
                                                "sense_id": "c8314e2f-70f5-3c2c-a1e2-a6f17e32533f",
                                                "text": "Éprouver des picotements dans la gorge."
                                            },
                                            {
                                                "example_id": "afaf545f-bddb-4a31-902e-017950c08e3c",
                                                "sense_id": "c8314e2f-70f5-3c2c-a1e2-a6f17e32533f",
                                                "text": "Le seuil moteur induit une contraction (ou des tremblements) musculaire visible et tangible et provoque une sensation plus forte de picotement."
                                            }
                                        ]
                                    }
