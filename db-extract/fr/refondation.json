                ],
                "senses": [
                    {
                        "sense_id": "ac8a4cbf-9686-3d48-9458-388c9e79331e",
                        "entry_id": "5b3ecaf6-2832-39f8-8c96-35306377f2dd",
                        "glosses": [
                            "Action de fonder de nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4e9752a-2d86-435c-8c77-eeab73b1cd62",
                                "sense_id": "ac8a4cbf-9686-3d48-9458-388c9e79331e",
                                "text": "Depuis la tentative avortée de refondation d’un empire, le pays [Mexique] a pris un certain essor."
                            },
                            {
                                "example_id": "a31e1c58-2d09-425b-a1b4-ab21c91c4da3",
                                "sense_id": "ac8a4cbf-9686-3d48-9458-388c9e79331e",
                                "text": "À ce compte-là, ce n’est pas tant d’une refondation que ce réseau a besoin, mais d’une reconstruction visant à ressusciter sa vocation véritablement universelle, gratuite, accessible et de qualité."
                            },
                            {
                                "example_id": "d6852126-3e8e-4db1-a2b1-3b0ea77b7126",
                                "sense_id": "ac8a4cbf-9686-3d48-9458-388c9e79331e",
                                "text": "François Legault dit que son gouvernement travaillera à une véritable « refondation ».\nSi le mot a un sens, « refondation » veut dire qu’on remet en question des principes fondamentaux."
                            }
                        ]
                    }
                ],
