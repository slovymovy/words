                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6cdb91c-d724-413f-bda6-5e6027fc3fd4",
                                                "sense_id": "25402875-3688-3fd3-974f-de2e4d27ce21",
                                                "text": "Neuer Rekord: Der 140-Fuß-Maxi-Trimaran „Banque Populaire V\" unter Skipper Loïck Peyron kreuzte die Ziellinie in Plymouth gestern um 19:48 Uhr Ortszeit und markierte damit einen neuen Rekord in 1 Tag, 8 Stunden, 48 Minuten mit einer Durchschnittsgeschwindigkeit von 18,5 Knoten."
                                            }
                                        ],
