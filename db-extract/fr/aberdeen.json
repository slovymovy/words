                                    {
                                        "sense_id": "9abcebb8-8574-39f8-aa06-850d02f0adec",
                                        "entry_id": "196cf64b-5462-3d51-8ce8-8e418436876d",
                                        "glosses": [
                                            "An area and town in Southern district, Hong Kong."
                                        ],
                                        "tags": [],
