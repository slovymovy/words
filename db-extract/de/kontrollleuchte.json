                    {
                        "sense_id": "42c40343-0dfa-3280-a7f5-058da7d3104f",
                        "entry_id": "cf02c4ac-54e6-311e-bb59-7da0f56419a6",
                        "glosses": [
                            "Lampe zur Überwachung einer technischen Funktion oder Nichtfunktion; Lichtsignal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0cd0a83-f4d2-4daa-ac82-0ef920d9f13f",
                                "sense_id": "42c40343-0dfa-3280-a7f5-058da7d3104f",
                                "text": "Diverse Kontrollleuchten im Flugzeug signalisieren den Zustand bzw. mögliche Störungen der Motoren usw."
                            },
                            {
                                "example_id": "a7a5e6a2-7e6c-4a00-b260-01ca77c47079",
                                "sense_id": "42c40343-0dfa-3280-a7f5-058da7d3104f",
                                "text": "„Neben ungesunden Geräuschen aus dem Motorraum kann sich ein Fahrzeug bei Wehwehchen aber nur mithilfe von Kontrollleuchten seinem Besitzer mitteilen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
