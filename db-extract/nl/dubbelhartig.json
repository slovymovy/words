                ],
                "senses": [
                    {
                        "sense_id": "2de37397-5985-375d-a9c4-0863f59388fb",
                        "entry_id": "2b8bb62a-427f-3acb-8738-17521b08f764",
                        "glosses": [
                            "met twee tegengestelde karakters"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c7e2f00-2568-44e2-8bca-cc4b2eed987b",
                                "sense_id": "2de37397-5985-375d-a9c4-0863f59388fb",
                                "text": "Was Cicero echt een roddelkont, die met krukjes smeet, niet tegen bloed kon en geneigd was tot tranen toe geroerd te worden? Was hij behalve een scherpzinnig redenaar ook ‘ijdel, dubbelhartig, hebzuchtig, naïef’ en een groot liefhebber van vastgoed?"
                            }
                        ]
                    },
                    {
                        "sense_id": "8ca65a18-a2bb-3ed5-bc55-ae9a35f9f808",
                        "entry_id": "2b8bb62a-427f-3acb-8738-17521b08f764",
                        "glosses": [
                            "zich qua karakter beter voordoend dan in werkelijkheid het geval is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f0f146b-87a5-43d2-904e-69f0bccafcc1",
                                "sense_id": "8ca65a18-a2bb-3ed5-bc55-ae9a35f9f808",
                                "text": "De dubbelhartige man deed alsof hij een vrome aanbidder was van de heilige maagd maar ondertussen deed hij alles wat god en de kerk verboden hebben."
                            }
                        ]
                    }
                ],
