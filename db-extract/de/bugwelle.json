                "senses": [
                    {
                        "sense_id": "792405c0-f8a3-3886-88f4-66197beba5ff",
                        "entry_id": "22fbb88a-b2c7-3dc9-b126-b18ca35e61b5",
                        "glosses": [
                            "Welle, die am Bug eines fahrenden Schiffes entsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "707476fb-fc6f-4192-aa3a-3204ed692a26",
                                "sense_id": "792405c0-f8a3-3886-88f4-66197beba5ff",
                                "text": "„Ein 81-jähriger Rollstuhlfahrer aus Brunsbüttel ist am Mittwoch von der Bugwelle eines aus dem Nord-Ostsee-Kanal auslaufenden Containerfrachters erfasst und um mehrere Meter versetzt worden. Das teilte die Polizei mit.“"
                            },
                            {
                                "example_id": "2474840a-0a89-4aec-ace2-0fd29c30bbd8",
                                "sense_id": "792405c0-f8a3-3886-88f4-66197beba5ff",
                                "text": "„Fahren wir zu schnell, kann es durch die Bugwelle zu Unfällen an den Badestellen entlang der Elbe kommen.“"
                            },
                            {
                                "example_id": "0e16b823-bfb6-4630-8376-11f0e13bf140",
                                "sense_id": "792405c0-f8a3-3886-88f4-66197beba5ff",
                                "text": "„Die Frösche schwammen immer schneller und schneller, bis sie schließlich mit kraftvollen Stößen aus dem Wasser empor schnellten, immer wieder, so dass vor dem kleinen Boot eine gewaltige Bugwelle aufschäumte.“"
                            },
                            {
                                "example_id": "325ac2ce-b29e-4d40-bd07-36d0aafaca9e",
                                "sense_id": "792405c0-f8a3-3886-88f4-66197beba5ff",
                                "text": "„Der Vaterplan war wohl der, das Schiff durch die sicherlich kräftige Bugwelle aus dem Astgefängnis zu befreien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
