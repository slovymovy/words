                    },
                    {
                        "translation_id": "921a7c5d-6824-451e-af27-b330767ae45c",
                        "source_entry_id": "9104fe68-5a71-3b8f-a074-17a88ec0f5e7",
                        "source_sense_id": "69d838c6-d269-3c4a-99ae-3c51206b90f4",
