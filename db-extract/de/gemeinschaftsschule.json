                ],
                "senses": [
                    {
                        "sense_id": "1c1f830f-5603-31d5-ae4c-05c32c7a1e7d",
                        "entry_id": "6423b969-6193-3a51-90b4-486d86b199d5",
                        "glosses": [
                            "Schule, in der die Schüler viele Jahre zusammen verbringen und die mehr Bildungsgerechtigkeit gewährleisten soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95978c7d-4129-45b0-addc-8e000fad3614",
                                "sense_id": "1c1f830f-5603-31d5-ae4c-05c32c7a1e7d",
                                "text": "Drei Gemeinschaftsschulen im Land, einmal in Salem und zweimal in Karlsruhe, gewannen den Wettbewerb \"Starke Schulen\"."
                            },
                            {
                                "example_id": "10f89612-db3b-4c68-9829-c914be86abaf",
                                "sense_id": "1c1f830f-5603-31d5-ae4c-05c32c7a1e7d",
                                "text": "„In den Jahren 1962 bis 1968 diskutierte man im finnischen Reichstag (Parlament) über eine Schulstrukturreform, die schließlich in der Einführung von Gemeinschaftsschulen im ganzen Land mündete.“"
                            },
                            {
                                "example_id": "dfecd1f9-0ccc-478f-b087-b679ccf4bb0c",
                                "sense_id": "1c1f830f-5603-31d5-ae4c-05c32c7a1e7d",
                                "text": "An einer Berliner Gemeinschaftsschule hat ein jüdischer Junge nach einem Angriff gegen ihn die Schule verlassen."
                            },
                            {
                                "example_id": "53bda504-7a22-4b62-9e05-dacf9527533c",
                                "sense_id": "1c1f830f-5603-31d5-ae4c-05c32c7a1e7d",
                                "text": "10 Lehrerinnen und Lehrer plus eine Lehramtsanwärterin unterrichten an der Gemeinschaftsschule [auf der Insel Helgoland] 76 Kinder und Jugendliche der Klassen 1 bis 10."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fdfd7d83-e45e-3af3-8404-d00a1d9c9e13",
                        "entry_id": "6423b969-6193-3a51-90b4-486d86b199d5",
                        "glosses": [
                            "Schule, in der alle Schüler aller Glaubensbekenntnisse gemeinsam unterrichtet werden"
                        ],
