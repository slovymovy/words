                        "tags": [],
                        "examples": [
                            {
                                "example_id": "220c37c3-2266-400b-80d6-3aaa785a1ac3",
                                "sense_id": "3dd238e7-b6e8-392b-947c-311db5965088",
                                "text": "Je devrais prévoir un texte en vue d'un discours pour tenter d'attendrir le jury, de leur prouver que je n’étais pas l’abomiffreux qu’on avait dépeint."
                            }
                        ]
                    }
