                                "target_senses": [
                                    {
                                        "sense_id": "4e34a91b-81c0-3a84-9a76-50dd4c81779f",
                                        "entry_id": "23ecbef8-0a82-3142-8e9a-5994f9dca917",
                                        "glosses": [
                                            "riferito a un elemento linguistico atono che si appoggia per la pronuncia a un'altra parola; nella lingua scritta l'elemento clitico può apparire unito alla parola ospite o separato"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c70897d0-c1d2-4e95-a5b0-a0052e7e470c",
                                                "sense_id": "4e34a91b-81c0-3a84-9a76-50dd4c81779f",
                                                "text": "in italiano le particelle clitiche sono principalmente pronomi come \"me\", \"te\", \"lo\", \"ce\"; possono essere avverbi di luogo come \"ci\" e \"ne\" o avere funzione partitiva come \"ne\""
                                            },
                                            {
                                                "example_id": "8b665191-018d-4716-986b-f2b6df4d37c2",
                                                "sense_id": "4e34a91b-81c0-3a84-9a76-50dd4c81779f",
                                                "text": "in italiano l'elemento clitico appare separato se precede la parola ospite: \"me ne vado\"; appare unito se la segue: \"vattene\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "clitico",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "8c95d68c-e77b-3ea3-a50d-6f04326bb0de",
                                        "entry_id": "b22d287e-09ea-3160-a80c-57e9c38e34f1",
                                        "glosses": [
                                            "elemento clitico"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48a5285e-b796-4622-9eb1-dcd93fb2e136",
                                                "sense_id": "8c95d68c-e77b-3ea3-a50d-6f04326bb0de",
                                                "text": "in italiano i clitici si possono comporre tra di loro: per esempio \"gli\" e \"ne\" diventano \"gliene\""
                                            }
