                "senses": [
                    {
                        "sense_id": "688a819b-c3b2-31ff-b9d3-393df9e8ec26",
                        "entry_id": "2af8e04d-e75d-3b73-9af9-33d20c85bd52",
                        "glosses": [
                            "(militärisches) unbemanntes Fluggerät, das zu den Vereinigten Staaten von Amerika gehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0bfb2a5-4534-4767-ac41-311ece9ec65e",
                                "sense_id": "688a819b-c3b2-31ff-b9d3-393df9e8ec26",
                                "text": "„Mit dem Abschuss der US-Drohne demonstrierte der Iran – der über das russische Raketenabwehrsystem S-300 verfügt – auch seine militärischen Fähigkeiten.“"
                            },
                            {
                                "example_id": "c783075d-b791-4681-94b2-7a8dc7881cee",
                                "sense_id": "688a819b-c3b2-31ff-b9d3-393df9e8ec26",
                                "text": "„Von völkerrechtlich brisanter Bedeutung ist der Einsatz unbemannter US-Drohnen, die über den FATA kreisen und auf verdächtige Ziele Raketen abfeuern.“"
                            },
                            {
                                "example_id": "bdece9b5-613d-4421-8661-026af39f102f",
                                "sense_id": "688a819b-c3b2-31ff-b9d3-393df9e8ec26",
                                "text": "„Seine Nachfolge ging auf Mohammad Mansur (durch eine US-Drohne am 21. Mai 2016 ermordet) und anschließend auf Hibatullah Akhunzada über.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
