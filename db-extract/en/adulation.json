                        "source_sense_id": "d6e9d878-360c-3b6d-b417-b6be820c5d69",
                        "source_sense_description": "niedere Schmeichelei, Lobhudelei, Vergötterung",
                        "target_lang_word": "Schmeichelei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schmeichelei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c9e52b40-1afd-374b-83b7-b56ab46779f2",
                                        "entry_id": "6db07bbf-abe4-3390-a1bd-7317a0d6ee67",
                                        "glosses": [
                                            "schmeichelnde Äußerung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b7698fd-e12d-4a81-a224-cc5f2a9cb712",
                                                "sense_id": "c9e52b40-1afd-374b-83b7-b56ab46779f2",
                                                "text": "Trotz seiner Schmeicheleien wollte sie nicht mit ihm zusammen sein."
                                            },
                                            {
                                                "example_id": "e0358bf3-3495-405f-8e4a-43fb2c8e54a7",
                                                "sense_id": "c9e52b40-1afd-374b-83b7-b56ab46779f2",
                                                "text": "„Falls diese Bemerkung als Schmeichelei gemeint war, verstand Csoma sie nicht so.“"
                                            },
                                            {
                                                "example_id": "7b3b9441-507b-473e-8b4b-59e111dca6fe",
                                                "sense_id": "c9e52b40-1afd-374b-83b7-b56ab46779f2",
                                                "text": "„Hugo war es ernst damit, auch wenn sich in diese Sätze eine elegante Schmeichelei mischt.“"
                                            },
                                            {
                                                "example_id": "2c63ade4-7c71-4730-a9b6-0ba6490e0f90",
                                                "sense_id": "c9e52b40-1afd-374b-83b7-b56ab46779f2",
                                                "text": "„Dies war eine Fortsetzung von Johns Art, sie zu liebenkosen, das Echo seiner Schmeichelei.“"
                                            },
                                            {
                                                "example_id": "9624defa-7b79-4f52-95a7-6609d2f50778",
                                                "sense_id": "c9e52b40-1afd-374b-83b7-b56ab46779f2",
                                                "text": "„Sie erzählte von den Schmeicheleien, die er ihr gesagt hatte; dann habe er geäussert, er wolle ins Ausland reisen, und sie gefragt, wo die Familie Rostow ihren Sommer verbringen würde, und sich dann nach Boris bei ihr erkundigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a24d10ad-7041-4f58-be18-0791cf916456",
                        "source_entry_id": "61e4efef-d211-3aac-b3f8-37e0df990fa6",
                        "source_sense_id": "d6e9d878-360c-3b6d-b417-b6be820c5d69",
                        "source_sense_description": "niedere Schmeichelei, Lobhudelei, Vergötterung",
                        "target_lang_word": "Lobhudelei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lobhudelei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5304ee90-05fa-3934-a868-42dbebe323a9",
                                        "entry_id": "0e7426de-d4bd-3af5-961c-820bf01577ed",
                                        "glosses": [
                                            "überschwängliches Lob in unangemessener oder übertriebener Weise (meist um sich einzuschmeicheln)"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c302084b-1310-4332-84b0-f6a1e273a505",
                                                "sense_id": "5304ee90-05fa-3934-a868-42dbebe323a9",
                                                "text": "Ich wunderte mich über die ganze Lobhudelei in Zeitung und Fernsehen."
                                            },
                                            {
                                                "example_id": "055937f4-f249-4c69-94a8-413fc9c152b1",
                                                "sense_id": "5304ee90-05fa-3934-a868-42dbebe323a9",
                                                "text": "Bei seiner Verabschiedung vom öffentlichen Amt gab es die übliche Lobhudelei."
                                            },
                                            {
                                                "example_id": "91386eb1-6d63-4e7f-b6e6-23ec192f6f38",
                                                "sense_id": "5304ee90-05fa-3934-a868-42dbebe323a9",
                                                "text": "Eine Lobhudelei kann ganz schön schmeicheln."
                                            },
                                            {
                                                "example_id": "aa27878b-a545-4cd9-b9b2-9f46ddac2210",
                                                "sense_id": "5304ee90-05fa-3934-a868-42dbebe323a9",
                                                "text": "[Dem Kosmonauten Siegmund Jähn] selbst war die Lobhudelei eher zuwider, er blieb bescheiden und bodenständig."
                                            },
                                            {
                                                "example_id": "de24a89a-f01e-46f5-ba88-ea5c67545cf8",
                                                "sense_id": "5304ee90-05fa-3934-a868-42dbebe323a9",
                                                "text": "„[Die Medien ud der Hof] haben ihm wirklich immer nur Lobhudeleien ins Ohr geflüstert, so dass der Schah irgendwann von seiner eigenen Größe derart überzeugt war, dass er die tatsächlichen Verhältnisse vollkommen verkannt hat.“"
                                            },
                                            {
                                                "example_id": "0593819d-85d2-4c50-be0d-dbb16642003c",
                                                "sense_id": "5304ee90-05fa-3934-a868-42dbebe323a9",
                                                "text": "„Überschwänglich - und vielleicht ein wenig zu heftig - klopft der gemütliche Inder dabei seinem ivorischen Kollegen auf Schulter. Dem ist die ganze Lobhudelei offensichtlich ein wenig unangenehm.“"
                                            },
                                            {
                                                "example_id": "51b23d06-2e53-40cc-9c3c-3cbe1f2d944c",
                                                "sense_id": "5304ee90-05fa-3934-a868-42dbebe323a9",
                                                "text": "[Im US-Fernsehen] hält Demi Moore eine Rede über ihren Ex-Mann [Bruce Willis]. Von Laudatio oder Lobhudelei keine Spur."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "efcb95e5-bc93-44c2-b88e-c1616f410363",
                        "source_entry_id": "61e4efef-d211-3aac-b3f8-37e0df990fa6",
