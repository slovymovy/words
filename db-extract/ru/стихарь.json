                "senses": [
                    {
                        "sense_id": "460f2b0b-fb38-3bdf-bdc8-fa9f88088035",
                        "entry_id": "734ee62e-e5dc-3cc8-8f6c-536858f59623",
                        "glosses": [
                            "церк. прямая, длинная, с широкими рукавами, обычно парчовая, одежда дьяконов и дьячков, надеваемая при богослужении"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4a913ac-cdb4-4a65-ad2c-163f15bf975d",
                                "sense_id": "460f2b0b-fb38-3bdf-bdc8-fa9f88088035",
                                "text": "Золотое сияние на красном фоне иконостаса, и золочёная резьба икон, и серебро паникадил и подсвечников, и плиты пола, и коврики, и хоругви вверху у клиросов, и ступеньки амвона, и старые почерневшие книги, и подрясники, и стихари — всё было залито светом."
                            }
                        ]
                    },
                    {
                        "sense_id": "dbf3c438-4fa1-374e-ae4a-a518c06949dc",
                        "entry_id": "734ee62e-e5dc-3cc8-8f6c-536858f59623",
                        "glosses": [
                            "церк. нижнее облачение священников и архиереев"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd663f61-7227-437f-932b-a09f6105ff9c",
                        "source_entry_id": "734ee62e-e5dc-3cc8-8f6c-536858f59623",
                        "target_lang_word": "sticharion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sticharion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55dc4d6f-b3f7-35a5-894d-79732bc50cc1",
                                        "entry_id": "e9e6ddea-6c97-39fc-8be4-877208435659",
                                        "glosses": [
                                            "The outer clerical garb worn by clergy in the Greek Orthodox Church, corresponding to the alb in Latin-Rite Catholic Churches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1104f46-32ab-4f3a-b766-cc7e463b288c",
                                                "sense_id": "55dc4d6f-b3f7-35a5-894d-79732bc50cc1",
                                                "text": "a little band of marchers displays Greek Orthodox outfits, the rhason and sticharion, the epitrachelion and the epimanikia, the sakkos, the epigonation, the zone, the omophorion; they brandish icons and enkolpia, dikerotikera and dikanikion."
                                            },
                                            {
                                                "example_id": "e6506558-82d3-4c81-9637-36926aa6be6c",
                                                "sense_id": "55dc4d6f-b3f7-35a5-894d-79732bc50cc1",
                                                "text": "The sticharion, which is held by the zone, or girdle, corresponds to the alb."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
