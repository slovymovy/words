                                "sense_id": "3c716661-35c9-317e-aa26-04fc9387c2d4",
                                "text": "De gevolgde weg was niet de snelste maar wel de mooiste"
                            }
                        ]
                    },
                    {
                        "sense_id": "48c64c00-a844-3d05-9192-20d36ff9d0da",
