                                "example_id": "99ba2791-b1bf-4d34-851f-ec8e8eb14175",
                                "sense_id": "3ffbee55-a1bc-33b5-b713-3da281d04a8d",
                                "text": "Ik heb veel gelezen over de Hummer maar ik heb er nog nooit eentje gezien."
                            }
                        ]
                    },
                    {
                        "sense_id": "d5e7a021-dc38-3e7c-88f1-3b09dce4d7aa",
                        "entry_id": "9283105e-0ef4-36be-8156-1ef9c177013e",
                        "glosses": [
                            "in je eentje: alleen zonder dat er andere mensen bij zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "398caf91-b39c-4e1c-892c-1f620aa5ec56",
                                "sense_id": "d5e7a021-dc38-3e7c-88f1-3b09dce4d7aa",
                                "text": "De eigenwijze man deed alles in zijn eentje."
                            },
                            {
                                "example_id": "4173e7ea-f2ad-42d1-847e-bd4edbb60842",
                                "sense_id": "d5e7a021-dc38-3e7c-88f1-3b09dce4d7aa",
                                "text": "Als je op reis veel contact wil maken met de locals kun je beter in je eentje op vakantie gaan."
                            },
                            {
                                "example_id": "90392bd4-f947-456b-9098-cace467cc916",
                                "sense_id": "d5e7a021-dc38-3e7c-88f1-3b09dce4d7aa",
                                "text": "Die nacht was het volle maan, zó fel dat ik bijna een krant zou kunnen lezen. Hier ging ik vanavond slapen, helemaal in mijn eentje."
                            }
                        ]
