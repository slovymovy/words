                "senses": [
                    {
                        "sense_id": "ad95c8fe-d3fe-3474-bcc2-c4a722fae3d9",
                        "entry_id": "c1d283ea-a945-3ac2-a97f-89fd295b1c74",
                        "glosses": [
                            "Bedürfnis der Repräsentation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd524824-826b-4158-a065-ce44a65b6081",
                                "sense_id": "ad95c8fe-d3fe-3474-bcc2-c4a722fae3d9",
                                "text": "„Die Dokumentarfotos aus Schweizer Büroetagen, die Dogan Firzubay festhielt, bilden nur unreflektiert ab, wie sich das Repräsentationsbedürfnis hochrangiger Entrepeneure im Alltag zeigt.“"
                            },
                            {
                                "example_id": "f57829b2-e86b-46fe-b8fa-af6ab465a38f",
                                "sense_id": "ad95c8fe-d3fe-3474-bcc2-c4a722fae3d9",
                                "text": "„Stereotype sind da manchmal nicht mehr weit: Dem Repräsentationsbedürfnis der Franzosen steht die Sinnlichkeit der Italiener gegenüber, die in Frömmigkeit nur so dahinschmachten.“"
                            },
                            {
                                "example_id": "ac723003-0528-4498-94b0-f50a70d7add2",
                                "sense_id": "ad95c8fe-d3fe-3474-bcc2-c4a722fae3d9",
                                "text": "„die französische Kapitale war damals in zwanzig Arrondissements und ebenso viele Vororte aufgeteilt worden, deren Rathäuser im Repräsentationsbedürfnis miteinander wetteiferten.“"
                            },
                            {
                                "example_id": "e3d0809e-e978-47f9-8d46-5d34ca7321cf",
                                "sense_id": "ad95c8fe-d3fe-3474-bcc2-c4a722fae3d9",
                                "text": "„Das Repräsentationsbedürfnis der neuen Berliner Republik orientierte sich an der alten preußischen Großmannssucht.“"
                            },
                            {
                                "example_id": "c8b3f24e-c3b5-41f9-8821-32375d7463d7",
                                "sense_id": "ad95c8fe-d3fe-3474-bcc2-c4a722fae3d9",
                                "text": "„Und der holzgetäfelte Kasten entsprach genau dem Repräsentationsbedürfnis der Herren Figl und Raab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
