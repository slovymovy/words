                "senses": [
                    {
                        "sense_id": "576d0408-f8c6-3fa8-9d91-bb0e693e347c",
                        "entry_id": "05d09aab-2c2c-3a04-a8b7-f79f1285b056",
                        "glosses": [
                            "(nord-)östlich gelegenes Teilreich des (merowingischen) Frankenreichs (6.–8. Jahrhundert)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47c33509-b8b7-4903-b33d-b23052e11f9d",
                                "sense_id": "576d0408-f8c6-3fa8-9d91-bb0e693e347c",
                                "text": "„Infolge der erblichen Herrschaftsteilungen entstehen zu Ende des sechsten Jahrhunderts die vier fränkischen Teilreiche Austrien (Ostreich), Neustrien (Westreich), Burgund und Aquitanien.“"
                            },
                            {
                                "example_id": "2ae83198-9ce3-4815-be10-c9c946a2a6c8",
                                "sense_id": "576d0408-f8c6-3fa8-9d91-bb0e693e347c",
                                "text": "„Diese Regression hält bis zum Ende des 7. Jahrhunderts an, wobei ich für meinen Teil als Schlußpunkt die Schlacht von Tertry (687) wählen möchte, durch die mit dem Sieg Austriens und der Pippiniden die Herrschaft der merowingischen Schattenkönige, der letzten, ohnmächtigen Vertreter dieser Dynastie, zu Ende geht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ed87adf-42fb-4920-ab20-a6913383ce42",
                        "source_entry_id": "05d09aab-2c2c-3a04-a8b7-f79f1285b056",
                        "source_sense_id": "576d0408-f8c6-3fa8-9d91-bb0e693e347c",
                        "source_sense_description": "(nord-)östlich gelegenes Teilreich des (merowingischen) Frankenreichs (6.–8. Jahrhundert)",
