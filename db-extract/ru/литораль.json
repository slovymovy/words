                                            {
                                                "example_id": "6af44a7a-a771-4393-94a3-d1bedbb80380",
                                                "sense_id": "99bc6416-e4f3-39e3-b243-79bacabe4800",
                                                "text": "Strefa litoralu ma najlepsze warunki życia w wodach."
                                            },
                                            {
                                                "example_id": "5f9654e8-c25e-4f20-8b67-129ad6caa5a8",
                                                "sense_id": "99bc6416-e4f3-39e3-b243-79bacabe4800",
                                                "text": "W odróżnieniu od litoralu (strefa styku morza z lądem), dno sublitoralu jest zawsze zanurzone pod wodą"
                                            }
