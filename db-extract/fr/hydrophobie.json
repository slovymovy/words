                                "target_senses": [
                                    {
                                        "sense_id": "be2e0bfc-6597-37d4-b87a-3a2e919ae082",
                                        "entry_id": "ddb371bc-3de8-3fe9-9ff5-1bd7b18c7f1c",
                                        "glosses": [
                                            "Angst vor oder Abneigung gegen den Kontakt mit Wasser"
