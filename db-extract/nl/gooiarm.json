                        "examples": [
                            {
                                "example_id": "77a100b4-a108-40f2-a953-ad3d6a97f68d",
                                "sense_id": "105e7130-553a-3415-af3c-9430d66a0667",
                                "text": "Neem nou Mike Gregory. De Engelse darter werd in november na zijn finale van het kwalificatietoernooi voor het WK in elkaar geslagen door de teleurgestelde verliezer Billy Edwards. Gregory gaat na een vuistslag tegen de grond en loopt een ernstige blessure aan de pols van zijn gooiarm op als hij de schoppen van de Welshman probeert af te weren. ,,Edwards had waarschijnlijk gesnoven', reageert Van Barneveld. ,,Hij was volledig van het pad af.'"
                            },
                            {
                                "example_id": "18fcd863-769a-49d7-b180-47c75adf8599",
                                "sense_id": "105e7130-553a-3415-af3c-9430d66a0667",
                                "text": "Vorig seizoen haperde de gooiarm van Favre voor het eerst zichtbaar. Amerikaanse media speculeerden meteen over het einde van de carrière van een speler die de eeuwige jeugd leek te hebben."
                            }
                        ]
                    }
