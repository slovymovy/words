                                "target_senses": [
                                    {
                                        "sense_id": "ccc7fa79-1a5f-36c5-b7a8-66bedfc66215",
                                        "entry_id": "31603f1e-44b5-33af-a97d-c7f240ae76ed",
                                        "glosses": [
                                            "Qui provoque l’orgasme."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "97421a33-5172-3db9-8f7b-48d48fcfff2e",
                                        "entry_id": "31603f1e-44b5-33af-a97d-c7f240ae76ed",
                                        "glosses": [
                                            "Qui provoque un plaisir intellectuel intense."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d1ebf0e-0dd9-4339-b150-b1120e9e99c6",
                                                "sense_id": "97421a33-5172-3db9-8f7b-48d48fcfff2e",
                                                "text": "Et c'est d'autre part le caractère subversif et jouissif de l'acte toxicomane."
                                            },
                                            {
                                                "example_id": "3a536214-9dfd-46ab-afd2-522a1730034e",
                                                "sense_id": "97421a33-5172-3db9-8f7b-48d48fcfff2e",
                                                "text": "Il y a quelque chose de profondément jouissif dans le fait d'imaginer les millions de gens en doudoune qui se caillent les miches en France à l'heure où je barbote dans cette eau à trente degrés."
                                            },
                                            {
                                                "example_id": "9d5f9b2e-9d9b-473a-9bfe-059311befe79",
                                                "sense_id": "97421a33-5172-3db9-8f7b-48d48fcfff2e",
                                                "text": "La cessation de la tempête, le comblement d’un manque procurent des voluptés plus précieuses que les plaisirs sophistiqués. Autrement dit : avoir chaud quand on a eu froid est plus jouissif que manger des perles à la truffe dans un jacuzzi de champagne."
                                            },
                                            {
                                                "example_id": "5135b18d-22f6-4773-ad2d-504713ffd825",
                                                "sense_id": "97421a33-5172-3db9-8f7b-48d48fcfff2e",
                                                "text": "Avec Farang, Xavier Gens a gagné le pari d’offrir un film jouissif qui assume son statut de pur divertissement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
