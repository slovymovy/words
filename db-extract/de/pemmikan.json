                                                "sense_id": "9463b75c-740b-352e-b9c1-33ddab22f48d",
                                                "text": "I tried to eat some pemmican, but my mouth was too dry."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ab8a6e9-273e-3b71-8924-8c0ef6ed634c",
