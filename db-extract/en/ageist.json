                        "entry_id": "544b9f9e-f453-3078-8ee8-c59f3ff2d281",
                        "glosses": [
                            "A person who behaves in an ageist manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8aab6f5-a2b2-4300-b087-75df0a159e5d",
                                "sense_id": "9ceec0a4-9169-34d7-9dd3-3ed3e7999ece",
                                "text": "He didn’t like to think of himself as an ageist, but he had to admit that he hadn’t considered the needs of some of the more elderly participants."
                            }
                        ]
                    }
                ],
