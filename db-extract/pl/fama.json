                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ff19e61-b395-4090-889c-c48971051f36",
                                                "sense_id": "6ce7acb7-9d9b-3a90-a6d0-3baa659fad0e",
                                                "text": "John is rumored to be next in line for a promotion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1cf56c7-dbf1-4687-8648-303e60c2a41a",
                        "source_entry_id": "54023d32-6ab9-3a5d-aaa5-c272b9b64497",
                        "source_sense_id": "e2838f41-efc7-34f2-aa81-397b01e474fc",
                        "target_lang_word": "rumour",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rumour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c5ee85a-1e0c-39cc-a3aa-5c63b2a26e6c",
                                        "entry_id": "0512bbfe-96dd-3df3-bd2f-1fd7492fd833",
                                        "glosses": [
                                            "British, Canada, New Zealand, Australia, and Ireland spelling of rumor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6de54ac6-df82-4d38-b6fd-c2508f1997b0",
                                                "sense_id": "2c5ee85a-1e0c-39cc-a3aa-5c63b2a26e6c",
                                                "text": "Rumour had it (though not proved) that she descended from the house of the lords Talbot de Malahide"
                                            },
                                            {
                                                "example_id": "0ec09b58-cdec-4ac8-85c3-2fe5549e640d",
                                                "sense_id": "2c5ee85a-1e0c-39cc-a3aa-5c63b2a26e6c",
                                                "text": "There were rumours, new rumours every morning, delightful and outrageous rumours, so that the lumps in the porridge were swallowed without comment and the fish-cakes were eaten without contumely."
                                            },
                                            {
                                                "example_id": "53135cb9-0247-4289-bd1c-7721f8fdd93f",
                                                "sense_id": "2c5ee85a-1e0c-39cc-a3aa-5c63b2a26e6c",
                                                "text": "\"Keep off Conductor Rails\" said red-painted notices at the platform ends, for third-rails were laid in many places even where electric trains never normally ran, and there had been many rumours of impending electrification of the Wirral, as a natural extension of the Mersey system, a quarter of a century before the change was actually made."
                                            },
                                            {
                                                "example_id": "70cc9cf5-d892-438e-9056-1dab04da7744",
                                                "sense_id": "2c5ee85a-1e0c-39cc-a3aa-5c63b2a26e6c",
                                                "text": "I myself gave support to the summoning of the Estates General ... as merely mistaken . Similarly it might be held that Paradise originated in a rumour invented in hell to make society the more interesting . ' ' We need a saviour ."
                                            },
                                            {
                                                "example_id": "9151e781-9fea-4a35-a4a2-6636a9dbbc71",
                                                "sense_id": "2c5ee85a-1e0c-39cc-a3aa-5c63b2a26e6c",
                                                "text": "Dame Rumour outstrides me yet again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8782240b-5c59-395a-b5db-268cae78e344",
                                        "entry_id": "0512bbfe-96dd-3df3-bd2f-1fd7492fd833",
                                        "glosses": [
                                            "A prolonged, indistinct noise."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20f85254-027f-4fb9-938c-ec1f6496cd0a",
                                                "sense_id": "8782240b-5c59-395a-b5db-268cae78e344",
                                                "text": "Prithee, listen well; / I heard a bustling rumour like a fray, / And the wind brings it from the Capitol."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rumour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f38fcc0b-068b-3eea-9e35-4346dbdb4fb7",
                                        "entry_id": "d40466a5-9152-395a-9c72-c5d78884b6f5",
                                        "glosses": [
                                            "Commonwealth standard spelling of rumor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf68c2ec-9b8f-4587-908b-66364e307581",
                                                "sense_id": "f38fcc0b-068b-3eea-9e35-4346dbdb4fb7",
                                                "text": "Two of the four main routes over the Border were rumoured to be threatened with withdrawal of, or heavy cuts in, passenger services."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "668b8d0a-479b-4909-a0fc-3ae81c0dbea0",
                        "source_entry_id": "54023d32-6ab9-3a5d-aaa5-c272b9b64497",
                        "source_sense_id": "e2838f41-efc7-34f2-aa81-397b01e474fc",
                        "target_lang_word": "fame",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fame",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ef77b289-b7ab-3c89-b889-6aeec9041a03",
                                        "entry_id": "db34156a-a3fc-35d8-84df-8535952f292f",
                                        "glosses": [
                                            "ou Réputation, renommée."
                                        ],
                                        "tags": [
                                            "Anglicism",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca5478cd-4a4b-4c6b-bb7d-09a7fcdd9633",
                                                "sense_id": "ef77b289-b7ab-3c89-b889-6aeec9041a03",
                                                "text": "M. de Bassompierre était-il fondé à prétendre que le comte d’Auvergne n’était pas rétabli dans sa bonne fame et renommée ? Le texte des lettres de commutation de peine, rapporté dans les manuscrits de Dupuy, contredit cette assertion."
                                            },
                                            {
                                                "example_id": "2c15aa5f-fb31-4bfb-9338-d430fb826df1",
                                                "sense_id": "ef77b289-b7ab-3c89-b889-6aeec9041a03",
                                                "text": "Si je rapporte cet Arrêt rend ainſi contre mon Compatriote, je luy dois la Justice de na pas taire en même tems que cette injure fut réparée par un autre Arrêt, qui avec connoiſſance de Cauſe le rétablit dans ſa bonne fame & renommée, dans tous ſes biens, & que les Enfans en ont joui."
                                            },
                                            {
                                                "example_id": "33584e9a-e31f-421b-a3e3-ac0e687556b4",
                                                "sense_id": "ef77b289-b7ab-3c89-b889-6aeec9041a03",
                                                "text": "Ces Lettres n’ôtent point l’infamie encouruë par le Jugement de condamnation, & ne remettent point l’Impétrant dans ſa bonne fame & renommée, & encore moins en ſes bien, à moins encore un coup que les Lettres ne le portent expreſſément ; elles ne font que conſerver la vie, s’il avoit été condamné à mort, & diminuer ſes peines, s’il avoit été condamné à quelque peine, autre que le dernier ſupplice."
                                            },
                                            {
                                                "example_id": "c6a0dd15-f43f-421c-b7cb-99ef7f6afde8",
                                                "sense_id": "ef77b289-b7ab-3c89-b889-6aeec9041a03",
                                                "text": "ÇA Y EST JE SUIS VRAIMENT DANS LA FAME TWITTER CAR ALEXOTIME A VOLÉ MON TWEET 💓"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
