                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hatred",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editorial board chose to <w>execrate</w> the new policy as a violation of human rights."
