                "senses": [
                    {
                        "sense_id": "9b5d1a06-06d6-33bc-a5af-38c79b127d05",
                        "entry_id": "723daa39-c302-344b-b8bd-9cefca30e4e6",
                        "glosses": [
                            "A clenched hand; fist."
                        ],
                        "tags": [
                            "Ireland",
                            "Northern-England",
                            "Scotland"
                        ],
                        "examples": [
                            {
                                "example_id": "50e8509e-91de-4199-ad77-621c68e1611b",
                                "sense_id": "9b5d1a06-06d6-33bc-a5af-38c79b127d05",
                                "text": "Ake thought if ever he was walking alone on a dark-like night and Jimmy came on him, he with his bare nieves and Jimmy with a knife, he'd stand as much chance of getting home safe as a celluloid cat that had strayed into hell[…]."
                            },
                            {
                                "example_id": "fbc3ac44-ebb5-434a-a4ac-6c6ec5d04bd3",
                                "sense_id": "9b5d1a06-06d6-33bc-a5af-38c79b127d05",
                                "text": "Nestorius exploded at that and hit out. He roared and dismissed the class, hitting out with his old mottled gnarled niefs."
                            },
                            {
                                "example_id": "7dfd00db-f96e-43e6-9e24-998077829e78",
                                "sense_id": "9b5d1a06-06d6-33bc-a5af-38c79b127d05",
                                "text": "\"But t' Maister can stop and hit rarely. Happen he'll mak' him joomp when he gets his nief upon him.\""
                            }
                        ]
                    },
