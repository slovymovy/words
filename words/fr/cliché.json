            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a35dbe6c-c92e-332c-a5fb-dcd720d618a6",
                    "sense_definition": "Idée, expression ou formule rebattue qui a perdu toute originalité.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "figurative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce film évite soigneusement chaque <w>cliché</w> habituel des comédies romantiques.",
                            "target_lang_translations": {
                                "en": "This film carefully avoids every usual <w>cliché</w> of romantic comedies.",
                                "ru": "Этот фильм тщательно избегает каждого привычного <w>штампа</w> романтических комедий.",
                                "de": "Dieser Film vermeidet sorgfältig jedes übliche <w>Klischee</w> romantischer Komödien.",
                                "es": "Esta película evita cuidadosamente cada <w>tópico</w> habitual de las comedias románticas.",
                                "zh": "这部电影小心翼翼地避开了浪漫喜剧中每一个常见的<w>陈词滥调</w>。"
                            }
                        },
                        {
                            "text": "L'auteur refuse de tomber dans le <w>cliché</w> du détective solitaire et alcoolique.",
                            "target_lang_translations": {
                                "en": "The author refuses to fall into the <w>cliché</w> of the solitary, alcoholic detective.",
                                "ru": "Автор не желает скатываться в <w>клише</w> об одиноком детективе-алкоголике.",
                                "de": "Der Autor weigert sich, in das <w>Klischee</w> vom einsamen, alkoholabhängigen Detektiv zu verfallen.",
                                "es": "El autor se niega a caer en el <w>tópico</w> del detective solitario y alcohólico.",
                                "zh": "作者不愿落入孤独、嗜酒的侦探这一<w>俗套</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "banalité",
                        "idée reçue",
                        "lieu commun",
                        "stéréotype"
                    ],
                    "common_phrases": [
                        "tomber dans le cliché",
                        "véhiculer un cliché"
                    ],
                    "target_lang_definitions": {
                        "en": "An overused idea, expression or formula that has lost all originality.",
                        "ru": "Избитая идея, выражение или формула, утратившая всякую оригинальность.",
                        "de": "Abgenutzte Redewendung, Idee oder Formel, die jede Originalität verloren hat.",
                        "es": "Idea, expresión o fórmula muy repetida que ha perdido toda originalidad.",
                        "zh": "指已失去独创性、被反复使用的观点、说法或套路。"
                    },
