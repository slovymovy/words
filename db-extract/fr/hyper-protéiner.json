                        "glosses": [
                            "Variante orthographique rare de hyperprotéiner (rendre très riche en protéines)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2e23690-d880-4ae2-8ed0-d56cd5dbb336",
                                "sense_id": "38090361-5c94-3453-944d-884a7b6539d1",
                                "text": "Des vaches mutantes donneront bientôt du lait naturellement médicamenté, hyper-protéiné, « franchement meilleur», capable de traiter l’hémophilie, les thromboses ou le diabète !"
                            },
                            {
                                "example_id": "6522b12f-6134-4e78-aa91-6236a60a38e3",
                                "sense_id": "38090361-5c94-3453-944d-884a7b6539d1",
                                "text": "En hyper-protéinant un peu l'alimentation on perd du gras plus facilement ; mais il faut alors boire plus pour éliminer les « déchets » liés à la dégradation des protéines."
                            }
                        ]
                    }
