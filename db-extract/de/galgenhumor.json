        "de-extract.jsonl": [
            {
                "entry_id": "6b773510-a8b8-3c42-84d6-432a3dd0492c",
                "word": "Galgenhumor",
                "pos": "noun",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "4fd5f7fe-26dc-4744-8c95-3099bd960d46",
                        "entry_id": "6b773510-a8b8-3c42-84d6-432a3dd0492c",
                        "tags": [
