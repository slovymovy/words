                    {
                        "sense_id": "032e6b9a-b9f0-3dba-b519-2a3f8d52275e",
                        "entry_id": "e7a21237-1666-3539-b2be-3a239dc3ac99",
                        "glosses": [
                            "Staatsbürger des Senegal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ab2f610-3f52-4423-83d2-33e14b8b7703",
                                "sense_id": "032e6b9a-b9f0-3dba-b519-2a3f8d52275e",
                                "text": "„Im Weltkrieg haben Senegaler, Berber und Madegassen die Schlachten Frankreichs geschlagen und werden auch später für Paris fechten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
