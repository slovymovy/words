                                "sense_id": "507689d2-fde2-360c-8363-d6130b6b99cf",
                                "text": "Anthony just subscribed to someone on YouTube a day ago."
                            }
                        ]
                    },
                    {
                        "sense_id": "6aec117b-f758-378a-a98e-1554c2d049fa",
                        "entry_id": "20749b5f-f413-3826-82e4-069d5d86049e",
                        "glosses": [
                            "Collectively, the users of YouTube; especially the content creator's viewers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2862a002-ae9e-4d63-b301-f0c53f7032e6",
                                "sense_id": "6aec117b-f758-378a-a98e-1554c2d049fa",
                                "text": "Hi, how's it going YouTube! Sorry I wasn't able to upload a video last week!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "315cdba3-afc7-4345-a80f-c3d33dbadc93",
