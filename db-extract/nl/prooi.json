                "translations": [
                    {
                        "translation_id": "d2aef9b5-e512-4b0d-b1c7-3a99ef6c8cdc",
                        "source_entry_id": "4328ce6d-0778-3178-afb3-574de66ce9a6",
                        "source_sense_id": "6b7ae522-cc0d-3089-8dcb-3af4c6b2afa0",
                        "source_sense_description": "dat wat door een dier wordt buitgemaakt",
                        "target_lang_word": "Beute",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beute",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb8edd1c-a31f-30a3-abcc-46ad6fb58612",
                                        "entry_id": "f3d8cea1-6ecc-35ed-9096-679b9ca5e0b7",
                                        "glosses": [
                                            "durch Diebstahl, Raub oder Plünderung angeeignete Güter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "533c04c7-bf44-4fc4-892b-a6c63ad1e375",
                                                "sense_id": "cb8edd1c-a31f-30a3-abcc-46ad6fb58612",
                                                "text": "Die Täter entkamen mit einer Beute von 500 000 Euro."
                                            },
                                            {
                                                "example_id": "93acf75e-959e-40ff-a662-687328e36a17",
                                                "sense_id": "cb8edd1c-a31f-30a3-abcc-46ad6fb58612",
                                                "text": "„Schließlich hatten sie auch so schon genug Beute gemacht.“"
                                            },
                                            {
                                                "example_id": "0a60eb8d-0cfa-4017-a2af-c63ca2173a1b",
                                                "sense_id": "cb8edd1c-a31f-30a3-abcc-46ad6fb58612",
                                                "text": "„Die Beute der Raubzüge wurde gerecht verteilt und kam auch der Urbevölkerung zugute.“"
                                            },
                                            {
                                                "example_id": "bc9c4087-7c8f-4a56-880f-2fe6a722d208",
                                                "sense_id": "cb8edd1c-a31f-30a3-abcc-46ad6fb58612",
                                                "text": "„Wer Beute machen will, muss schießen lernen, sonst wird er selbst zur Beute.“"
                                            },
                                            {
                                                "example_id": "fdfb8a75-536b-497d-9890-62c2aebe8c63",
                                                "sense_id": "cb8edd1c-a31f-30a3-abcc-46ad6fb58612",
                                                "text": "„Mit unserer reichen Beute wurden wir vom Boot freudig begrüßt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "099454c8-4100-3c32-80fb-b61656aaa039",
                                        "entry_id": "f3d8cea1-6ecc-35ed-9096-679b9ca5e0b7",
                                        "glosses": [
                                            "von Jägern getötete Tiere"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6c6f033-0d95-4212-89ce-f696f2b71efd",
                                                "sense_id": "099454c8-4100-3c32-80fb-b61656aaa039",
                                                "text": "Die Jäger kehrten mit reicher Beute heim."
                                            },
                                            {
                                                "example_id": "6108e442-362e-49d0-a9f8-23769741d1ce",
                                                "sense_id": "099454c8-4100-3c32-80fb-b61656aaa039",
                                                "text": "„Größerer Beute konnte sich doch kein Mann an der ganzen Grenze rühmen.“"
                                            },
                                            {
                                                "example_id": "3ce6156d-04eb-4a9d-8401-5fb6f463de67",
                                                "sense_id": "099454c8-4100-3c32-80fb-b61656aaa039",
                                                "text": "„Die Männer kehrten jetzt, mit ihrer Beute beladen, von der Jagd zurück, und das Gespräch ward wieder allgemein.“"
                                            },
                                            {
                                                "example_id": "b0b4ed72-72f8-4024-a6bf-d0d2004ff746",
                                                "sense_id": "099454c8-4100-3c32-80fb-b61656aaa039",
                                                "text": "„Mit Steinmesser und Speer machte er genügend Beute; seine Kleidung aus grob vernähten Fellen schützte ihn vor der Kälte.“"
                                            },
                                            {
                                                "example_id": "958f72cc-6fba-4bc6-bc75-4a41743d3fa3",
                                                "sense_id": "099454c8-4100-3c32-80fb-b61656aaa039",
                                                "text": "„Pencroff lud sich die Beute auf die Schultern und ließ die Jagdgesellschaft kehrtmachen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "925cc322-7069-3a4a-b197-8db1c2d1e676",
                                        "entry_id": "f3d8cea1-6ecc-35ed-9096-679b9ca5e0b7",
                                        "glosses": [
                                            "von Raubtieren als Nahrung gefangenes oder verfolgtes Tier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d2c64a8-cf3d-49f9-a38b-8104f5c5215e",
                                                "sense_id": "925cc322-7069-3a4a-b197-8db1c2d1e676",
                                                "text": "Mäuse sind eine allseits beliebte Beute."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "1d23d4f8-68fb-36a3-9666-c342a76cf369",
                                        "entry_id": "f3d8cea1-6ecc-35ed-9096-679b9ca5e0b7",
                                        "glosses": [
                                            "Opfer"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "gehoben"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Beute",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e71cb7aa-732e-3976-89bf-6f29c96c80d4",
                                        "entry_id": "79c024eb-f239-3fe3-9731-d354093d306d",
                                        "glosses": [
                                            "künstliche Umhausung der Bienenstöcke beim Imker"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e9e6887-642c-4883-b540-0dc2ccb535a6",
                                                "sense_id": "e71cb7aa-732e-3976-89bf-6f29c96c80d4",
                                                "text": "„Den Bienen ist es egal, in welcher Beute sie wohnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "33e60316-641b-3251-b9db-6b792b13a403",
                                        "entry_id": "79c024eb-f239-3fe3-9731-d354093d306d",
                                        "glosses": [
                                            "Arbeitsplatz in einer Backstube, eigentlich Behälter für Mehl oder Teig, dessen Abdeckplatte als Arbeitsplatz dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "720ad483-e1f2-45db-abc9-ab2561b19b41",
                                                "sense_id": "33e60316-641b-3251-b9db-6b792b13a403",
                                                "text": "„»Aber auf die alte Beute, Mehlbehälter mit Deckel, möchte ich nicht verzichten«, erklärt der Meister.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43b884fb-fad4-410f-a9b2-b7fb7b239f2c",
                        "source_entry_id": "4328ce6d-0778-3178-afb3-574de66ce9a6",
                        "source_sense_id": "6b7ae522-cc0d-3089-8dcb-3af4c6b2afa0",
