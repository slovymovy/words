                        "glosses": [
                            "żona stryja"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "144e9688-11b6-4715-aa77-44d5a702abd4",
                                "sense_id": "62358185-8b37-336c-af21-a4e6b8a91ea2",
                                "text": "Moja stryjenka ma rude włosy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "885617f6-cc93-4782-8d99-df9d5be1c7b1",
                        "source_entry_id": "ee221fd7-3e1a-398d-9b32-1a39a750cb24",
                        "source_sense_id": "62358185-8b37-336c-af21-a4e6b8a91ea2",
                        "target_lang_word": "тётя",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "тётя",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "df38c9fc-8845-3e2c-9669-eb13b69c2e84",
                                        "entry_id": "80852527-fa57-3d7e-983a-69e87a6015ac",
                                        "glosses": [
                                            "сестра отца или матери, либо жена дяди (т. е. брата отца или матери)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cf2aad9-d83e-42ab-b1fc-6f421ac3a40d",
                                                "sense_id": "df38c9fc-8845-3e2c-9669-eb13b69c2e84",
                                                "text": "То есть я думала, что это какое-то деревенское кладбище, а ваша мама, моя тётя, живёт в той самой деревне."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd0d06fc-3a1b-35b2-b298-9c104e199b9f",
                                        "entry_id": "80852527-fa57-3d7e-983a-69e87a6015ac",
                                        "glosses": [
                                            "разг., детск. любая взрослая женщина"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68fefffd-1922-4b85-8485-316838968ed5",
                                                "sense_id": "bd0d06fc-3a1b-35b2-b298-9c104e199b9f",
                                                "text": "Одна тётя потеряла перчатки и зонтик, трое спохватились насчет кошелька, один мужчина обнаружил нехватку золотого кольца и т.д."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e86dd5e9-32ca-375b-ad9c-5c3a94f4b10f",
                                        "entry_id": "80852527-fa57-3d7e-983a-69e87a6015ac",
                                        "glosses": [
                                            "разг. любая знакомая женщина старшая по возрасту"
                                        ],
                                        "tags": [
                                            "обычно в сочет. с краткой формой собственного имени"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2ffa88f-156e-453a-9cd5-32d2b3e1acf6",
                                                "sense_id": "e86dd5e9-32ca-375b-ad9c-5c3a94f4b10f",
                                                "text": "Слышал, как тетя Тоня с приезжим дядей разговаривала."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
