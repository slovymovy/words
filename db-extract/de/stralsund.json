                        "examples": [
                            {
                                "example_id": "590d4a62-b693-4a83-a40d-febec8366563",
                                "sense_id": "35b04a46-7886-3511-93f6-b68a025c3d93",
                                "text": "Die Hansestadt Stralsund liegt am Strelasund."
                            },
                            {
                                "example_id": "b894b8a2-a912-4cda-a6f0-306c192b8699",
                                "sense_id": "35b04a46-7886-3511-93f6-b68a025c3d93",
                                "text": "„Die Innenstadt Stralsunds ist durch einen Reichtum an historischer Bausubstanz gekennzeichnet.“"
                            },
                            {
                                "example_id": "ad052273-8f1a-45e2-9195-2a19cced8022",
                                "sense_id": "35b04a46-7886-3511-93f6-b68a025c3d93",
                                "text": "„In den Küstenstädten Wismar, Rostock und Stralsund sind moderne und leistungsfähige Werften entstanden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
