                "senses": [
                    {
                        "sense_id": "78eb8c96-cd2d-348f-a961-3e6320456855",
                        "entry_id": "45adeef8-c65d-397b-914a-63c03f857179",
                        "glosses": [
                            "Qui glougloute, au sens de faire un bruit de glouglou."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14504574-4ccf-4f69-91f0-0dded7c2c31c",
                                "sense_id": "78eb8c96-cd2d-348f-a961-3e6320456855",
                                "text": "L'action désertait le logis pour vagabonder sous une tonnelle de jardin ombrée de feuilles et de pampres, sur un tapis de mousse abrité de hautes fougères, parmi les molles herbes d’une prairie et à deux pas d'un ruisselet glouglouteur, au fond d’une barque coulant au fil de l’eau, sous un saule mélancolique à la chevelure trempée, sur un roc sourcilleux, en présence de la grande nature."
                            },
                            {
                                "example_id": "4bdc9c39-a268-4196-a68c-7ab7bb652513",
                                "sense_id": "78eb8c96-cd2d-348f-a961-3e6320456855",
                                "text": "À la spirale silencieuse des galaxies en haut, il fait écho en bas par le vortex glouglouteur des lavabos."
                            },
                            {
                                "example_id": "b9a54988-aa74-42f6-b737-e404aa28181d",
                                "sense_id": "78eb8c96-cd2d-348f-a961-3e6320456855",
                                "text": "Sa bruyante expectoration se faisait glouglouteuse lorsqu’il vomit une gerbe de sang et s’écroula"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
