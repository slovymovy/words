                "senses": [
                    {
                        "sense_id": "f532db9e-77f1-30f4-b19a-91d233528ffa",
                        "entry_id": "04902dee-79d2-320e-b5bd-1507bed4a592",
                        "glosses": [
                            "Relatif à l'égo, narcissique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "896115cd-4dd4-4b7b-8325-c632466dd1fe",
                                "sense_id": "f532db9e-77f1-30f4-b19a-91d233528ffa",
                                "text": "La sagesse permet de s'affranchir de l'idée du soi, donc de toute tendance égotique ou narcissique."
                            },
                            {
                                "example_id": "f33e26ec-2182-4bd0-9d09-f6fedf6c86b1",
                                "sense_id": "f532db9e-77f1-30f4-b19a-91d233528ffa",
                                "text": "Ce choix de nom n’est pas égotique."
                            },
                            {
                                "example_id": "b500a0e0-3a98-4e19-8e89-abbbcd6ef4a3",
                                "sense_id": "f532db9e-77f1-30f4-b19a-91d233528ffa",
                                "text": "La raison de cette attaque contre le site fondé par Jimmy Wales est comme souvent, quand il s’agit du milliardaire, d’ordre égotique."
                            }
                        ]
                    },
                    {
                        "sense_id": "c2092a62-f356-3077-9fd4-bd9b1e7c73bd",
                        "entry_id": "04902dee-79d2-320e-b5bd-1507bed4a592",
                        "glosses": [
                            "Égoïste, nombriliste."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "c7716f0b-22f6-40ed-833e-c7a8adb4619e",
                                "sense_id": "c2092a62-f356-3077-9fd4-bd9b1e7c73bd",
                                "text": "Plus rien n’arrête Allègre, dont le moteur égotique semble s’être emballé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6633eb00-59c7-43cf-82e0-a394ae44fdcf",
                        "source_entry_id": "04902dee-79d2-320e-b5bd-1507bed4a592",
