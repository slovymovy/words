                "senses": [
                    {
                        "sense_id": "0efa9493-fe14-31c2-9314-815db8a192bf",
                        "entry_id": "88f71aa4-fa8a-39a3-90bc-bbcd6163d2bd",
                        "glosses": [
                            "Briefmarke als Nachweis bezahlter Postgebühr, die zum Freimachen von Postsendungen dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fbd6814-b2dd-4d30-94b9-7ae7b186e814",
                                "sense_id": "0efa9493-fe14-31c2-9314-815db8a192bf",
                                "text": "„Für die wiederholt hohen Auflagen dieser Freimarken konnten die archivierten Druckzylinder, bei Abnutzung neu verchromt, mehrfach eingesetzt werden.“"
                            },
                            {
                                "example_id": "a0b98f96-2364-4b4e-83da-833c64d83be7",
                                "sense_id": "0efa9493-fe14-31c2-9314-815db8a192bf",
                                "text": "„Auch kaufte er unter anderem 1868 die Restbestände der preußischen Freimarken auf.“"
                            },
                            {
                                "example_id": "932349e3-ae9c-4499-8f87-c4d52310cee5",
                                "sense_id": "0efa9493-fe14-31c2-9314-815db8a192bf",
                                "text": "„Freimarken des Deutschen Reiches wurden ab 1. April 1902 benutzt, wobei auf eigene Freimarken verzichtet wurde, doch erschienen noch Dienstmarken bis das inzwischen zum Freistaat (November 1918 Abdankung des Königs) gewordene Württemberg am 1. April 1920 auf sein Postregal völlig verzichtete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
