                "senses": [
                    {
                        "sense_id": "1f55521f-ac49-3acf-8646-fd5e98c2b837",
                        "entry_id": "1bc24d3b-d015-359a-a63d-a8d3b7060bc0",
                        "glosses": [
                            "Gespräch mit dem Ziel, einen Frieden auszuhandeln"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "85f2ad1d-3ca0-42c8-aaca-468b77196eca",
                                "sense_id": "1f55521f-ac49-3acf-8646-fd5e98c2b837",
                                "text": "„In die Friedensgespräche von Montreux, die am Mittwoch begonnen haben, sind Syriens Regierung und die Opposition mit harten Tönen eingestiegen.“"
                            },
                            {
                                "example_id": "0228ca54-8cd6-4994-a501-97a9d01209e4",
                                "sense_id": "1f55521f-ac49-3acf-8646-fd5e98c2b837",
                                "text": "„Sein Herzensbruder Alexander möge zur Einsicht kommen und sich zu Friedensgesprächen einfinden, rief er.“"
                            },
                            {
                                "example_id": "6e8347f1-103f-4e70-9385-a52c28e5a09f",
                                "sense_id": "1f55521f-ac49-3acf-8646-fd5e98c2b837",
                                "text": "„Nawaz Sharif, wahrlich kein Gegner der ulama, wurde während seiner zweiten Amtszeit stark unter Druck gesetzt, nachdem er Friedensgespräche mit Indien aufgenommen hatte, die 1999 zur Einrichtung eines composite dialogue führten, welcher auch die Kaschmirfrage einschloss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
