                                    {
                                        "sense_id": "458ec02c-42ec-3817-9689-bfc9ae7afdd4",
                                        "entry_id": "85765a64-d509-35e3-a16e-8e177e93b896",
                                        "glosses": [
                                            "The act of deliberating, or of weighing and examining the reasons for and against a choice or measure; careful consideration; mature reflection."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3304f092-bc35-4744-9ace-74165b1330db",
                                                "sense_id": "458ec02c-42ec-3817-9689-bfc9ae7afdd4",
                                                "text": "The oftener the measure is brought under examination, the greater the diversity in the situations of those who are to examine it, the less must be the danger of those errors which flow from want of due deliberation, or of those missteps which proceed from the contagion of some common passion or interest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d075641c-0da4-38f1-a5ad-d969b969be57",
                                        "entry_id": "85765a64-d509-35e3-a16e-8e177e93b896",
                                        "glosses": [
                                            "Careful discussion and examination of the reasons for and against a measure."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "466a0b9d-4737-4563-8d90-7cf3a06c2440",
                                                "sense_id": "d075641c-0da4-38f1-a5ad-d969b969be57",
                                                "text": "the deliberations of a legislative body or council"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
