                    },
                    {
                        "translation_id": "517747bc-844e-481a-af16-deb4c94d1882",
                        "source_entry_id": "09e2c22e-0724-34b7-a976-b2c3e887ad66",
                        "source_sense_id": "0a75a33f-4f04-3161-9172-1bfd64123802",
                        "source_sense_description": "oscillatie",
                        "target_lang_word": "oscillation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oscillation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "014c8fb1-a154-345a-b6cf-4745aaa1b5df",
                                        "entry_id": "9b30f815-ea31-3628-8334-a08e1d0560f4",
                                        "glosses": [
                                            "the act of oscillating or the state of being oscillated"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cde5866c-1a73-499e-bf2b-f35bd7af62e4",
                                                "sense_id": "014c8fb1-a154-345a-b6cf-4745aaa1b5df",
                                                "text": "The trial running tests which were made with the vehicles showed that they ride very steadily laterally, with almost complete absence of oscillation at all speeds."
                                            },
                                            {
                                                "example_id": "9492659c-ba34-414d-8db4-9ee8ec6b1fcc",
                                                "sense_id": "014c8fb1-a154-345a-b6cf-4745aaa1b5df",
                                                "text": "In the early days troubles were experienced with oscillation from the rod drive and with the transformers, but were overcome later, and these machines performed useful service until superseded by more modern locomotives less costly in maintenance."
                                            },
                                            {
                                                "example_id": "b79af995-b888-42de-b47f-fd6c50cc4caf",
                                                "sense_id": "014c8fb1-a154-345a-b6cf-4745aaa1b5df",
                                                "text": "The oscillations were getting so severe that painters on the bridge learned to tie down their tins before a train passed. They found holes and rents in the iron but never reported them as they were never asked, and it wasn't their job. These were deferential times, and few wanted to talk out of turn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c168c45d-9c50-356d-b726-468e70632874",
                                        "entry_id": "9b30f815-ea31-3628-8334-a08e1d0560f4",
                                        "glosses": [
                                            "a regular periodic fluctuation in value about some mean"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "72d567b8-34d5-3147-b936-c2f1b8b08d74",
                                        "entry_id": "9b30f815-ea31-3628-8334-a08e1d0560f4",
                                        "glosses": [
                                            "a single such cycle"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5cf1f1d9-c4c9-3a2a-89d6-668f94adc76e",
                                        "entry_id": "9b30f815-ea31-3628-8334-a08e1d0560f4",
                                        "glosses": [
                                            "(of a function) defined for each point x in the domain of the function by inf diam(f(U))∣Uisaneighborhoodofx, and describes the difference (possibly ∞) between the limit superior and limit inferior of the function near that point."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dda310c7-d4d8-4a5f-a605-c2935c6fe61c",
                        "source_entry_id": "09e2c22e-0724-34b7-a976-b2c3e887ad66",
                        "source_sense_id": "0a75a33f-4f04-3161-9172-1bfd64123802",
                        "source_sense_description": "oscillatie",
                        "target_lang_word": "oscillation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oscillation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d634176e-38d0-3e58-a18d-4480936dbd28",
                                        "entry_id": "06a6d866-ac4c-36e4-a50e-82d89e2d6e90",
                                        "glosses": [
                                            "Mouvement d’un corps qui oscille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a33cc4ca-97f8-4420-bafc-982cac0d9205",
                                                "sense_id": "d634176e-38d0-3e58-a18d-4480936dbd28",
                                                "text": "Plus tard, par une méthode déjà plus délicate, j’inscrivais les phases d’élévation et d’abaissement des ailes d’un oiseau qui vole, la trajectoire décrite dans l’espace par la pointe de l’aile, les changements du plan alaire, les oscillations du corps dans leurs rapports avec les mouvements du vol."
                                            },
                                            {
                                                "example_id": "ba0ca3f5-478a-4253-98e9-062afad8390e",
                                                "sense_id": "d634176e-38d0-3e58-a18d-4480936dbd28",
                                                "text": "[…], tout en se maintenant debout, les jambes écartées, appuyé contre la cloison, pour conserver son équilibre au milieu des oscillations de l’aéronef."
                                            },
                                            {
                                                "example_id": "d3b3b9a7-e0fc-4f8c-81b2-8f5641fa95fe",
                                                "sense_id": "d634176e-38d0-3e58-a18d-4480936dbd28",
                                                "text": "Le séismographe porte d'ailleurs , non pas un seul stylet, mais deux, l'un étant destiné à enregistrer la composante Nord-Sud des oscillations du sol, l'autre la composante Est-Ouest."
                                            },
                                            {
                                                "example_id": "ed4ff443-1b40-44c3-be1c-ac6d362271d2",
                                                "sense_id": "d634176e-38d0-3e58-a18d-4480936dbd28",
                                                "text": "Les oscillations du foliot constituent en quelque sorte une horloge dans l'horloge. Elles rythment le mouvement des aiguilles."
                                            },
                                            {
                                                "example_id": "e4a79bcf-1b5d-4397-8e57-b0e33e682073",
                                                "sense_id": "d634176e-38d0-3e58-a18d-4480936dbd28",
                                                "text": "Il en est de même pour les étoiles. […]. Les infimes oscillations visibles en surface offrent aux astronomes un aperçu de leur structure interne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33e12c2b-a6db-3958-80fe-1e0022231390",
                                        "entry_id": "06a6d866-ac4c-36e4-a50e-82d89e2d6e90",
                                        "glosses": [
                                            "Fluctuation."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31ab0c7e-10d7-4982-b5f3-a1bbfd3e6aa1",
                                                "sense_id": "33e12c2b-a6db-3958-80fe-1e0022231390",
                                                "text": "Les oscillations de l’opinion publique."
                                            },
                                            {
                                                "example_id": "f8602517-da88-43f0-8c64-1808bcc53a3f",
                                                "sense_id": "33e12c2b-a6db-3958-80fe-1e0022231390",
                                                "text": "Les oscillations du crédit public."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54b79cc5-f8a0-324b-ba83-426028701b92",
                                        "entry_id": "06a6d866-ac4c-36e4-a50e-82d89e2d6e90",
                                        "glosses": [
                                            "Décharge oscillante se produisant dans un circuit convenablement constitué, comprenant un condensateur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a89f09cf-b1ef-484c-b364-191fe24d7cde",
                                                "sense_id": "54b79cc5-f8a0-324b-ba83-426028701b92",
                                                "text": "Les oscillations électriques sont soit amorties, soit entretenues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc92e242-7e95-35f5-b9d1-fd6b9ca92e7f",
                                        "entry_id": "06a6d866-ac4c-36e4-a50e-82d89e2d6e90",
                                        "glosses": [
                                            "Phénomène par lequel un neutrino change de saveur."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
