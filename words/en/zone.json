{
    "word_family": [
        "zoning",
        "zonal",
        "subzone",
        "interzone",
        "zoneless"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a5b68feb-4670-3f66-89af-b3d647e7bec0",
                    "sense_definition": "A specific area or region that is distinguished from others by a particular characteristic, use, or restriction.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "geographical_area",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city council decided to create a pedestrian <w>zone</w> in the historic center to reduce traffic.",
                            "target_lang_translations": {
                                "ru": "Городской совет решил создать пешеходную <w>зону</w> в историческом центре, чтобы уменьшить поток машин."
                            }
                        },
                        {
                            "text": "Please remember that the white <w>zone</w> is for loading and unloading only.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, помните, что белая <w>зона</w> предназначена только для погрузки и разгрузки."
                            }
                        }
                    ],
                    "synonyms": [
                        "area",
                        "district",
                        "region",
                        "section",
                        "sector"
                    ],
                    "common_phrases": [
                        "no-smoking zone",
                        "time zone",
                        "comfort zone",
                        "white zone",
                        "danger zone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенная территория или регион, выделяющиеся среди других по какому-либо признаку, использованию или ограничению."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зона",
                                "target_lang_sense_clarification": "территория с особым режимом или назначением"
                            },
                            {
                                "target_lang_word": "район",
                                "target_lang_sense_clarification": "часть города или области"
                            },
                            {
                                "target_lang_word": "участок",
                                "target_lang_sense_clarification": "небольшая выделенная площадь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77599175-ea4c-34fc-9eb0-b92363d63f9d",
                    "sense_definition": "A state of focused attention or high performance where one is performing at their best.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete was really in the <w>zone</w> during the final minutes of the championship game.",
                            "target_lang_translations": {
                                "ru": "Атлет был по-настоящему <w>в ударе</w> в последние минуты финальной игры чемпионата."
                            }
                        },
                        {
                            "text": "I finally got in the <w>zone</w> and finished the entire report in just two hours.",
                            "target_lang_translations": {
                                "ru": "Я наконец-то <w>поймал поток</w> и закончил весь отчет всего за два часа."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in the zone"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in sports or creative work"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние предельной концентрации или высокой продуктивности, когда человек работает на пике своих возможностей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в ударе",
                                "target_lang_sense_clarification": "о состоянии высокой продуктивности"
                            },
                            {
                                "target_lang_word": "в потоке",
                                "target_lang_sense_clarification": "о состоянии полной вовлеченности"
                            },
                            {
                                "target_lang_word": "кураж",
                                "target_lang_sense_clarification": "состояние эмоционального подъема"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0db02745-d952-3c3d-acd5-3b1365c1d520",
                    "sense_definition": "One of the large latitudinal regions of the Earth's surface divided by climate, such as the torrid, temperate, or frigid zones.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geographical_area",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Most of Europe lies within the northern temperate <w>zone</w> where the climate is relatively mild.",
                            "target_lang_translations": {
                                "ru": "Большая часть Европы находится в северном умеренном <w>поясе</w>, где климат относительно мягкий."
                            }
                        },
                        {
                            "text": "The tropical <w>zone</w> is known for its high temperatures and heavy rainfall throughout the year.",
                            "target_lang_translations": {
                                "ru": "Тропическая <w>зона</w> известна своими высокими температурами и обильными осадками в течение всего года."
                            }
                        }
                    ],
                    "synonyms": [
                        "belt",
                        "region"
                    ],
                    "common_phrases": [
                        "temperate zone",
                        "frigid zone",
                        "torrid zone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Один из крупных широтных регионов земной поверхности, разделенных по климату, таких как жаркий, умеренный или холодный пояса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пояс",
                                "target_lang_sense_clarification": "климатический или географический"
                            },
                            {
                                "target_lang_word": "зона",
                                "target_lang_sense_clarification": "природно-климатическая область"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b864dc83-c678-3b74-96e6-796cfe729752",
                    "sense_definition": "A defensive strategy in sports where players guard specific areas of the field rather than individual opponents.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports_terminology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coach switched to a <w>zone</w> defense to stop the opponent's fast strikers.",
                            "target_lang_translations": {
                                "ru": "Тренер перешел на <w>зонную</w> защиту, чтобы остановить быстрых нападающих противника."
                            }
                        },
                        {
                            "text": "It is difficult to score when the other team plays a tight <w>zone</w>.",
                            "target_lang_translations": {
                                "ru": "Трудно забить гол, когда другая команда играет в плотной <w>зоне</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zone defense"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оборонительная стратегия в спорте, при которой игроки защищают определенные участки поля, а не конкретных противников."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зонная защита",
                                "target_lang_sense_clarification": "тактика в командных видах спорта"
                            },
                            {
                                "target_lang_word": "зона",
                                "target_lang_sense_clarification": "вид оборонительного построения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b5c3a8a-98df-333b-91db-6718a2d0180c",
                    "sense_definition": "A belt or girdle worn around the waist.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient statue was depicted wearing a simple embroidered <w>zone</w> around her waist.",
                            "target_lang_translations": {
                                "ru": "Древняя статуя была изображена с простым вышитым <w>поясом</w> на талии."
                            }
                        },
                        {
                            "text": "In the poem, the goddess loosened her <w>zone</w> as a sign of relaxation.",
                            "target_lang_translations": {
                                "ru": "В поэме богиня ослабила свой <w>кушак</w> в знак расслабления."
                            }
                        }
                    ],
                    "synonyms": [
                        "belt"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in historical or poetic contexts"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "literary English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пояс или кушак, носимый на талии."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пояс",
                                "target_lang_sense_clarification": "элемент одежды"
                            },
                            {
                                "target_lang_word": "кушак",
                                "target_lang_sense_clarification": "широкий матерчатый пояс"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1b9cb22d-26e6-3c82-a40d-e4446db4686b",
                    "sense_definition": "To officially designate or divide an area into sections for specific types of use, such as residential or industrial.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "regulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city planners decided to <w>zone</w> the waterfront for recreational use only.",
                            "target_lang_translations": {
                                "ru": "Городские планировщики решили <w>отвести</w> набережную только под рекреационное использование."
                            }
                        },
                        {
                            "text": "This neighborhood is <w>zoned</w> for single-family homes, so you cannot build an apartment complex here.",
                            "target_lang_translations": {
                                "ru": "Этот район <w>предназначен</w> для домов на одну семью, поэтому здесь нельзя строить жилой комплекс."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zoned for industrial use",
                        "residential zoning"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально назначать или разделять территорию на секции для определенных видов использования, например, жилых или промышленных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зонировать",
                                "target_lang_sense_clarification": "разделять на функциональные зоны"
                            },
                            {
                                "target_lang_word": "распределять",
                                "target_lang_sense_clarification": "отводить участки под застройку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14dd516c-0022-38e6-b145-3dfb6ae2c255",
                    "sense_definition": "To lose focus or enter a daydreaming state, often due to tiredness or boredom.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am sorry, I totally <w>zoned</w> out for a minute and didn't hear what you said.",
                            "target_lang_translations": {
                                "ru": "Прости, я на минуту совершенно <w>отключился</w> и не слышал, что ты сказал."
                            }
                        },
                        {
                            "text": "During the long lecture, many students began to <w>zone</w> out and stare out the window.",
                            "target_lang_translations": {
                                "ru": "Во время долгой лекции многие студенты начали <w>витать в облаках</w> и смотреть в окно."
                            }
                        }
                    ],
                    "synonyms": [
                        "zone out",
                        "doze off"
                    ],
                    "common_phrases": [],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "usually used with 'out'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Потерять концентрацию или впасть в состояние мечтательности, часто из-за усталости или скуки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отключиться",
                                "target_lang_sense_clarification": "перестать воспринимать окружающее"
                            },
                            {
                                "target_lang_word": "зависнуть",
                                "target_lang_sense_clarification": "впасть в ступор или глубокую задумчивость"
                            },
                            {
                                "target_lang_word": "витать в облаках",
                                "target_lang_sense_clarification": "отвлечься от реальности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "19d525c9-5122-36fd-813c-587d9710c753",
                    "sense_definition": "To divide something into separate sections or areas.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "regulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technicians had to <w>zone</w> the server network to improve security and performance.",
                            "target_lang_translations": {
                                "ru": "Техникам пришлось <w>разбить на зоны</w> серверную сеть, чтобы повысить безопасность и производительность."
                            }
                        },
                        {
                            "text": "We need to <w>zone</w> off the construction site to keep pedestrians safe.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>оградить</w> строительную площадку, чтобы обеспечить безопасность пешеходов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zone off"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разделять что-либо на отдельные секции или области."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разбивать на зоны",
                                "target_lang_sense_clarification": "делить пространство на части"
                            },
                            {
                                "target_lang_word": "разграничивать",
                                "target_lang_sense_clarification": "устанавливать границы между участками"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}