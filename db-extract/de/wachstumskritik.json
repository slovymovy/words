                ],
                "senses": [
                    {
                        "sense_id": "54bafd92-7c0f-34c1-bbed-6408e768d272",
                        "entry_id": "c78baf83-8db0-3f93-9c98-6188c7913a10",
                        "glosses": [
                            "negative Beurteilung der dauernden Steigerung des Bruttosozialprodukts"
                        ],
                        "tags": [
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "5dd7f951-aa45-4d83-b8d6-ee791ee038e6",
                                "sense_id": "54bafd92-7c0f-34c1-bbed-6408e768d272",
                                "text": "[Niko Paech] „gilt als vehementer Verfechter der Wachstumskritik.“"
                            },
                            {
                                "example_id": "aa0e4459-921a-4bbf-82ab-c0e959734004",
                                "sense_id": "54bafd92-7c0f-34c1-bbed-6408e768d272",
                                "text": "„Wachstumskritik ist nicht neu“"
                            },
                            {
                                "example_id": "3c954d59-a605-4fe2-a2f0-c2e4a73cceab",
                                "sense_id": "54bafd92-7c0f-34c1-bbed-6408e768d272",
                                "text": "„Wachstum um jeden Preis scheint ein Dogma zu sein. Wachstumskritik ist weitgehend tabu.“"
                            },
                            {
                                "example_id": "9ea2ef6a-65c3-443c-9fc1-ad1d14e4c3bf",
                                "sense_id": "54bafd92-7c0f-34c1-bbed-6408e768d272",
                                "text": "„In der politischen Argumentation kennt man Wachstumskritik vor allem von links-grüner Seite. Sehr selten erklingt sie dagegen aus wirtschaftsnahen Kreisen.“"
                            },
                            {
                                "example_id": "33e7eb5f-f95e-4934-99db-4034162c864e",
                                "sense_id": "54bafd92-7c0f-34c1-bbed-6408e768d272",
                                "text": "„Für die Verbreitung ökologischer Wachstumskritik und die Begriffsschöpfung des Nachhaltigen spielte die Studie \"The Limits to Growth\" (\"Die Grenzen des Wachstums\") eine zentrale Rolle.“"
                            },
                            {
                                "example_id": "79a814f1-78cb-494b-a7b4-de77b52cf7a7",
                                "sense_id": "54bafd92-7c0f-34c1-bbed-6408e768d272",
                                "text": "„War die Wachstumskritik noch in früheren Jahrzehnten eher eine Debatte von gesellschaftlichen Randgruppen, die mit einer kapitalismuskritischen oder ökologischen Grundhaltung die herrschende Wirtschaftsweise kritisierten, so hat in den letzten Jahren die Diskussion über die Notwendigkeit weiteren Wirtschaftswachstums in den wohlhabenden westlichen Industrieländern auch in den gesellschaftlichen Eliten starken Anklang gefunden.“"
                            },
                            {
                                "example_id": "89cf0a36-e25f-4405-81cf-377fccb3afb4",
                                "sense_id": "54bafd92-7c0f-34c1-bbed-6408e768d272",
                                "text": "„Es wird auf die „Wachstumslokomotive“ USA Bezug genommen, ökologische und soziale Probleme tauchen im Gutachten nicht auf und von Wachstumskritik sind die sogenannten 5 Wirtschaftsweisen alle nicht angekränkelt.“"
                            },
                            {
                                "example_id": "bb93d10c-9937-432b-848d-d30c4a867e22",
                                "sense_id": "54bafd92-7c0f-34c1-bbed-6408e768d272",
                                "text": "„Die damalige Wachstumskritik ist die Vorgängerin der heutigen \"Degrowth\"-Bewegung (Muraca 2014).“"
                            },
                            {
                                "example_id": "63cf2636-70cc-4403-9e7b-caa0b16cfab7",
                                "sense_id": "54bafd92-7c0f-34c1-bbed-6408e768d272",
                                "text": "[Ohne Wirtschaftswachstum] „nehmen die Verteilungskämpfe zu. Aus diesen gehen meist die Ärmeren als Verlierer hervor. Die Wachstumskritik ist oft sehr elitär und unsozial.“"
                            },
                            {
                                "example_id": "4a55041f-d909-4950-a82d-86dc0aae2622",
                                "sense_id": "54bafd92-7c0f-34c1-bbed-6408e768d272",
                                "text": "[Niko Paech:] „»Wachstumskritik sieht keine Schocktherapie vor, sondern eine sozial verträgliche Transformation.«“"
                            },
                            {
                                "example_id": "b50fb408-531a-4545-9cbb-bd284d1e1225",
                                "sense_id": "54bafd92-7c0f-34c1-bbed-6408e768d272",
                                "text": "„Wachstumskritik von Politikern sei oft nicht mehr als ein Lippenbekenntnis, kritisiert Opitz bei einem Gespräch in seinem Kreuzberger Büro. »Man muss eine Kanzlerin festnageln, die auf dem Klimagipfel das eine sagt und beim Bundesverband der Deutschen Industrie das andere.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
