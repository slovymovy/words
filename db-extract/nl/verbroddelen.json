                                    {
                                        "sense_id": "e284d430-b166-37bd-9cd2-3e9bec05916d",
                                        "entry_id": "56341201-9cab-32cc-9a02-f18d6f86ad50",
                                        "glosses": [
                                            "To ruin unintentionally."
                                        ],
                                        "tags": [
                                            "informal",
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98920bfc-93d4-40cc-932c-314f80f91d03",
                                                "sense_id": "e284d430-b166-37bd-9cd2-3e9bec05916d",
                                                "text": "The terrorists have really mucked up our holiday plans."
                                            },
                                            {
                                                "example_id": "7d4788fd-3fbc-4632-9551-ff77016c1592",
                                                "sense_id": "e284d430-b166-37bd-9cd2-3e9bec05916d",
                                                "text": "That’s why they’re called the Founders? Yes, because it will be their job to repair a world that millennials have mucked up beyond repair."
                                            },
                                            {
                                                "example_id": "1475973d-0a59-40f4-af79-978e987a7794",
                                                "sense_id": "e284d430-b166-37bd-9cd2-3e9bec05916d",
                                                "text": "“Looking at our season so far, we have to be honest and admit that we mucked it up ourselves,” Özil told the German website spox.com. “We did not play to our potential in the games against the so-called smaller teams. You immediately get punished for that in the Premier League."
                                            },
                                            {
                                                "example_id": "d9c7e90c-4738-40d4-98d6-3c721c4b3174",
                                                "sense_id": "e284d430-b166-37bd-9cd2-3e9bec05916d",
                                                "text": "He said that this was simply a “historical fact” and that he could “see no reason why every other country in the world should be prevented from feeling pride in itself because the Germans mucked up twice in a century”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbe0c011-916e-3039-bc90-02e616470e43",
                                        "entry_id": "56341201-9cab-32cc-9a02-f18d6f86ad50",
                                        "glosses": [
                                            "To clown around; to have fun, often at the expense of others."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c74a8d14-d4d2-4d5f-a5ee-b9ece1300f19",
                                                "sense_id": "fbe0c011-916e-3039-bc90-02e616470e43",
                                                "text": "It's the last day of school and everyone is mucking up."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
