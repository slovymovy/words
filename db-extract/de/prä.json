                        "examples": [
                            {
                                "example_id": "466acd38-50ed-44cf-8803-16f90da4a1d8",
                                "sense_id": "2bc95610-2733-3596-869b-3ff56d29bc14",
                                "text": "[…]wenn man zur Natur noch in einem andern Verhältnis steht als bloß dem lyrischen, wollen wir mal sagen; wenn man zum Beispiel im Nebenamt Arzt ist, Physiolog, Anatom und von den Dessous auch noch so seine stillen Kenntnisse hat, – das kann von Vorteil sein, sagen Sie, was Sie wollen, es gibt entschieden ein Prä.",
                                "translation": "The Magic Mountain",
                                "english": "The Magic Mountain"
                            },
                            {
                                "example_id": "0d33cf5d-5673-4590-98e8-500eef726a10",
                                "sense_id": "2bc95610-2733-3596-869b-3ff56d29bc14",
                                "text": "Heute darf Putin die Pipelines dazufügen, ein Prä, das Moskau gnadenlos ausspielt, um seine Nachbarn vom Baltikum bis zum Kaspischen Meer gefügig zu machen."
                            },
                            {
                                "example_id": "86001898-9275-48de-902e-c1fdda1fd155",
                                "sense_id": "2bc95610-2733-3596-869b-3ff56d29bc14",
                                "text": "Auch das Scheitern der Olympiabewerbung wird Berlin als Prä verkaufen, als Bonus der Lässigkeit und Ausweis des Ungerührtseins."
                            }
                        ]
                    }
