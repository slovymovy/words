                ],
                "senses": [
                    {
                        "sense_id": "ef3d9463-47eb-3a08-851a-193b36a0afa5",
                        "entry_id": "973c7daf-99f4-3b81-9f54-27e6282c0f2d",
                        "glosses": [
                            "Qui a la propriété de phagocyter."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "note": "Il se prend au propre et au figuré",
                        "examples": [
                            {
                                "example_id": "09af95ad-d3c0-4120-8b25-8d7d952e407f",
                                "sense_id": "ef3d9463-47eb-3a08-851a-193b36a0afa5",
                                "text": "L’hémolymphe du Doryphore contient des micronucléocytes au grand pouvoir phagocytant, des macronucléocytes, des oenocytoïdes, des cellules à sphérules et des gouttelettes de graisse."
                            },
                            {
                                "example_id": "ee5c6096-675a-4664-a159-cc8347eb8cff",
                                "sense_id": "ef3d9463-47eb-3a08-851a-193b36a0afa5",
                                "text": "Les cellules-hôtes contenant les amas amorphes ont reçu le nom de «cellules phagocytantes». On considère que l'infection intervenant au cours du développement de l'embryon ne provoque pas la mycorhization de la plante adulte."
                            },
                            {
                                "example_id": "eba410c3-b62a-4faa-bcea-4ed6d5815d93",
                                "sense_id": "ef3d9463-47eb-3a08-851a-193b36a0afa5",
                                "text": "Certaines de ces cellules (cellules êpithêliales, phagocytantes) ont un noyau qui s'allonge et devient réniforme ; elles peuvent être confondues avec des monocytes, d'autant plus que certaines d'entre elles sont phagocytantes."
                            },
                            {
                                "example_id": "23140725-200f-445b-a3e3-7aff46244d98",
                                "sense_id": "ef3d9463-47eb-3a08-851a-193b36a0afa5",
                                "text": "— Mais quel type de bilingualité développent-elles face à la toute-puissance de la langue et de la culture françaises qui affichent des ambitions intégratrices, « phagocytantes » ?"
                            }
                        ]
                    }
