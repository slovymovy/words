                        "glosses": [
                            "Relatif à Winston Churchill ; qui semble digne de lui."
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "aed6f683-1a59-4371-997e-c385a22d993c",
                                "sense_id": "46aba095-08cb-37f7-a0fb-d459498ef246",
                                "text": "L’idée de déployer tous les fastes de la République et d’afficher une solennité churchillienne pour annoncer une augmentation de 1,6 point de la TVA ne peut venir que de cerveaux hallucinés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2d29402e-5141-47cf-b93c-3fa970d08e22",
                        "source_entry_id": "3b3d47a4-27c1-35b7-900b-0b0c18c01c9c",
                        "source_sense_id": "46aba095-08cb-37f7-a0fb-d459498ef246",
                        "target_lang_word": "Churchillian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Churchillian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f864d91f-2060-3b80-a073-33a0d589a2c0",
                                        "entry_id": "1f0cd37b-0c30-314b-aad3-5a9a3e308ab8",
                                        "glosses": [
                                            "Of or pertaining to Winston Churchill (1874–1965), English statesman and author, or to his policies, speeches, or writings."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f0709b9-c771-4f51-b8f1-91951570bd4a",
                                                "sense_id": "f864d91f-2060-3b80-a073-33a0d589a2c0",
                                                "text": "Barton was gorillian of build, all of it muscle, and Churchillian of jaw, all of it stubborn, but for all that amazingly good at not trampling over the authority of village elders."
                                            },
                                            {
                                                "example_id": "d6ce1c4a-7631-4e37-a744-b0835c465a54",
                                                "sense_id": "f864d91f-2060-3b80-a073-33a0d589a2c0",
                                                "text": "They are Churchillian theme parks of red pillar boxes, fish and chips and warm beer. But they want the smooth without the rough. When the neighbours cut up nasty, they demand that those whose taxes protect them should send soldiers, diplomats and lawyers to their aid."
                                            },
                                            {
                                                "example_id": "7042980e-35e4-4615-b243-cbd9f4425db8",
                                                "sense_id": "f864d91f-2060-3b80-a073-33a0d589a2c0",
                                                "text": "Why, [Jacob Rees-]Mogg even offers the same shtick: Etonian accent, Latin tags, supposedly lovable Wodehousian eccentricity, sub-Churchillian evocation of the glorious past of this island race."
                                            },
                                            {
                                                "example_id": "86a23d85-6985-4528-aea2-e66b391929c0",
                                                "sense_id": "f864d91f-2060-3b80-a073-33a0d589a2c0",
                                                "text": "Boris Johnson's speech to the nation on Sunday May 10 was rambly, incoherent, and he failed dismally in his attempt to sound Churchillian."
                                            }
                                        ]
                                    }
                                ]
                            },
