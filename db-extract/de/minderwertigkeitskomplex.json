                ],
                "senses": [
                    {
                        "sense_id": "4f93ee1e-aa63-33d2-b52b-abb1beb89e24",
                        "entry_id": "dea508c4-4885-3994-8a7e-f0af2e84c634",
                        "glosses": [
                            "zu einem Komplex gesteigertes Gefühl einer besonders großen Unterlegenheit gegenüber anderen Menschen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78ecfd4c-4da2-4ca3-9bb7-3a34f5029b2f",
                                "sense_id": "4f93ee1e-aa63-33d2-b52b-abb1beb89e24",
                                "text": "Minderwertigkeitskomplexe führen zu viel Leid."
                            },
                            {
                                "example_id": "2e548eea-0f00-4297-9f3d-acf9560536d0",
                                "sense_id": "4f93ee1e-aa63-33d2-b52b-abb1beb89e24",
                                "text": "„Das kommt von den Minderwertigkeitskomplexen den Sternen gegenüber.“"
                            },
                            {
                                "example_id": "f9807187-3c74-47f0-9276-6aab9438867d",
                                "sense_id": "4f93ee1e-aa63-33d2-b52b-abb1beb89e24",
                                "text": "„Mit ihrem Ähnlichkeitskomplex tragen sie dazu bei, daß der Minderwertigkeitskomplex in anderen früh zum Durchbruch kommt.“"
                            },
                            {
                                "example_id": "c4254022-6309-4efc-a07c-aaf8afa8e122",
                                "sense_id": "4f93ee1e-aa63-33d2-b52b-abb1beb89e24",
                                "text": "„Diejenigen, die ihn aus dieser Zeit kennen, meinen, dass er wegen der rigiden moralischen Maßstäbe und der hohen Erwartungen seiner Mutter einen Minderwertigkeitskomplex entwickelte, den er nie ablegte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
