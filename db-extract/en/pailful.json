                        "glosses": [
                            "The amount that fills, or would fill, a pail."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "131cc393-f208-44dc-9054-5935d1c40a5a",
                                "sense_id": "a5c6e813-f98c-3087-b148-e7e0bc3092f4",
                                "text": "Here's neither buſh, nor ſhrub to beare off any weather at all: and another Storme brewing, I heare it ſing ith' winde: yond ſame blacke cloud, yond huge one, lookes like a foule bumbard that would ſhed his licquor: if it ſhould thunder, as it did before, I know not where to hide my head: yond ſame cloud cannot chooſe but fall by paile-fuls."
                            },
                            {
                                "example_id": "6746b027-df9a-49cc-8ed4-a81bc4ee7e27",
                                "sense_id": "a5c6e813-f98c-3087-b148-e7e0bc3092f4",
                                "text": "Some say that instead of a bowl of milk on the table, it was a pailful on the kitchen-floor fresh from the cow."
                            },
                            {
                                "example_id": "c4fd8a04-37f6-4273-816b-cf0138d6c119",
                                "sense_id": "a5c6e813-f98c-3087-b148-e7e0bc3092f4",
                                "text": "McGrath's lounge was a vast brownish room, with a beige ceiling of heavy plaster divided into squares […] and finally swabbed with pailfuls of gilt."
                            }
                        ]
                    }
                ],
