                "translations": [
                    {
                        "translation_id": "c6cc0271-d2c1-4a29-9d48-f793747061cd",
                        "source_entry_id": "e8cac823-9a58-39ae-9fba-b6a338712222",
                        "source_sense_id": "78f82c45-e4e4-3b4e-aa7e-76898d5fa623",
                        "target_lang_word": "proteome",
