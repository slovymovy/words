                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "137ca413-aa99-3d9b-af01-807919936dc6",
                                        "entry_id": "6aec0113-92e8-3cf3-b591-8c6ac51fa681",
                                        "glosses": [
                                            "Something that provides a benefit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
