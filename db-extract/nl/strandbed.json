                        "sense_id": "1357fe49-2ac6-3e07-bc93-fc3f2a5d8a0e",
                        "entry_id": "a99cd5b4-cc01-34c0-a07c-ad383c2e51c5",
                        "glosses": [
                            "ligbank voor bij het strand of zwembad waarmee je in de zon kunt liggen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "432a9eda-f891-4636-b21a-3787fefb1966",
                                "sense_id": "1357fe49-2ac6-3e07-bc93-fc3f2a5d8a0e",
                                "text": "Ze poseren met zongebruinde lijven en een brede grijns op een strandbed en laten zien dat de inwendige mens niet werd overgeslagen."
                            },
                            {
                                "example_id": "5d3e0137-7f48-4015-9c07-58dad7d1a1ca",
                                "sense_id": "1357fe49-2ac6-3e07-bc93-fc3f2a5d8a0e",
                                "text": "Baby's worden afgegeven bij de Baby Club en kinderen tot 10 jaar bij de Mini Club, waar fanatiek wordt geoefend op de musical Frozen. Terwijl de kleintjes met bijbehorende dramatische gebaren Let it go inzetten, laten de ouders zich een eindje verderop op een strandbed zakken."
                            },
                            {
                                "example_id": "1606187a-b1f0-43db-99cb-a71aaee783f0",
                                "sense_id": "1357fe49-2ac6-3e07-bc93-fc3f2a5d8a0e",
                                "text": "Melanie Griffith viert momenteel vakantie op Hawaii. Liggend op een strandbed aldaar nam ze vorige week een foto van haar zongebruinde benen. De foto zette ze op sociale media en vervolgens ging het helemaal los over de wereldberoemde ledematen."
                            }
                        ]
                    }
