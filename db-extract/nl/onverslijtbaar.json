                "senses": [
                    {
                        "sense_id": "6b56d5a9-e201-37d1-8afb-f521fa496647",
                        "entry_id": "489f3fc5-8fba-395a-a04c-16863af0978c",
                        "glosses": [
                            "van iets dat het niet in kwaliteit kan verminderen door het te gebruiken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b5b4b08-b47c-4c3c-aa53-3fb007223f63",
                                "sense_id": "6b56d5a9-e201-37d1-8afb-f521fa496647",
                                "text": "Hij rijdt een Toyota die onverslijtbaar is, al gebruikt hij die alleen als hij Menno een bezoekje brengt."
                            }
                        ]
                    },
                    {
                        "sense_id": "fadfe562-84ef-34b6-8c71-c23d399ac9a2",
                        "entry_id": "489f3fc5-8fba-395a-a04c-16863af0978c",
                        "glosses": [
                            "van iemand dat hij of zijn nog lang niet versleten of verouderd is"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "6d1b82fa-ea96-4579-a70f-bed00def221e",
                                "sense_id": "fadfe562-84ef-34b6-8c71-c23d399ac9a2",
                                "text": "De strijd bij de vrouwen was minder spannend. Ingrid Prigge bewees nog altijd onverslijtbaar te zijn, al lopen de tijden wel iets terug. Met exact 40 minuten over het tien kilometer lange parcours was ze echter nog altijd ruimschoots sneller dan Annemiek Klein, die meer dan vier minuten later finishte (44:20). De Oldenzaalse Susan Siemerink werd derde in 45:06."
                            }
                        ]
                    }
                ],
