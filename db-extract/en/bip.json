                        "entry_id": "8ea4ed3b-67a9-3898-8676-54183146eff5",
                        "glosses": [
                            "To make or cause to make a short beeping or blipping sound."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "1a1db0a8-04c5-4470-83a6-fe88dc442ce6",
                                "sense_id": "d4909cbc-6e38-31d3-b288-2118ea090892",
                                "text": "Jihad Merhi bipped the horn as he pulled up in his Land Cruiser outside chez Lattouf."
                            }
                        ]
                    },
                    {
                        "sense_id": "b21714eb-8c92-35fc-b382-3f5ce7ae6f9f",
                        "entry_id": "8ea4ed3b-67a9-3898-8676-54183146eff5",
                        "glosses": [
                            "To hit lightly."
                        ],
                        "tags": [
                            "informal",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d8febd0c-450f-4d09-abe6-c702aa057a76",
                                "sense_id": "b21714eb-8c92-35fc-b382-3f5ce7ae6f9f",
                                "text": "After the entire table burst into laughter, she playfully bipped the man in the mouth and followed it with a kiss."
                            },
                            {
                                "example_id": "a2f02fea-2c52-4697-a441-12dc7e303f3a",
                                "sense_id": "b21714eb-8c92-35fc-b382-3f5ce7ae6f9f",
                                "text": "I swung the bat, barely bipped the ball, and sent it spinning off into a neighbor's yard. That was the closest I'd come to hitting that thing all day."
                            }
                        ]
                    },
                    {
                        "sense_id": "8cff690f-55ef-347f-88f9-984239d0c174",
                        "entry_id": "8ea4ed3b-67a9-3898-8676-54183146eff5",
                        "glosses": [
                            "To break into a car and steal its contents."
                        ],
                        "tags": [
                            "California",
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "48b4beee-a37e-39f8-8dd2-93e855628f47",
                        "entry_id": "8ea4ed3b-67a9-3898-8676-54183146eff5",
                        "glosses": [
                            "To break into a car and steal its contents.",
                            "To rob; steal."
                        ],
                        "tags": [
                            "California",
                            "broadly",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "4b2cc1b6-4c19-43fd-b19a-0e8e94f4b614",
                                "sense_id": "48b4beee-a37e-39f8-8dd2-93e855628f47",
                                "text": "So many cars get bipped on that street."
                            },
                            {
                                "example_id": "d657d152-8a35-4c90-818d-82b9f2edfbed",
                                "sense_id": "48b4beee-a37e-39f8-8dd2-93e855628f47",
                                "text": "Around Christmas of that year me and a friend was going to go up through Oklahoma bipping — scallybipping [burglarizing a house when they saw the wife out back hanging clothes], you know. We had been doing it around Houston, Dallas, places like that, but now we was going to go up through the States."
                            }
                        ]
                    }
