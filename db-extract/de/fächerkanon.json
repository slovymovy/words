                ],
                "senses": [
                    {
                        "sense_id": "a56588eb-77ed-3d76-ae29-355183d19765",
                        "entry_id": "c62894f4-3fdb-35af-9fb4-5b96e3ee9ba4",
                        "glosses": [
                            "grundlegender Bestand an kodifizierten Lehr-, Lern- oder Forschungsgebieten, etwa im Schulbereich, in der handwerklichen oder universitären Ausbildung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa8655df-c77c-4d69-9c37-28e7fe467071",
                                "sense_id": "a56588eb-77ed-3d76-ae29-355183d19765",
                                "text": "„Im Fächerkanon der Schule haben wir ein brauchbares Instrumentarium, mit dem sich die wesentlichsten der angedeuteten Perspektiven und Probleme erfassen lassen.“"
                            },
                            {
                                "example_id": "9a536938-d848-483b-a147-c5710ec0bbb1",
                                "sense_id": "a56588eb-77ed-3d76-ae29-355183d19765",
                                "text": "„Da die Schüler mit dem bisherigen Fächerkanon voll belastet sind, muß man zugunsten des Informatikunterrichts anderen Fächern etwas wegnehmen.“"
                            },
                            {
                                "example_id": "48e1a225-d8aa-465f-b54c-4decbb863d7a",
                                "sense_id": "a56588eb-77ed-3d76-ae29-355183d19765",
                                "text": "„Bezüglich des Fächerkanons und der Stundentafel unterscheiden sich die Spezialschulen und Spezialklassen durch ihre spezielle Fächerprofilierung.“"
                            },
                            {
                                "example_id": "267a40c3-5256-414f-bcea-f5318a47939a",
                                "sense_id": "a56588eb-77ed-3d76-ae29-355183d19765",
                                "text": "„Neben dem normalen Fächerkanon bietet die Schule musikbetonte Züge, die Instrumentalunterricht, Chor- und Orchsterausbildung umfassen.“"
                            },
                            {
                                "example_id": "5790afae-98ab-4a06-9de9-1e758130bb91",
                                "sense_id": "a56588eb-77ed-3d76-ae29-355183d19765",
                                "text": "„Andere ungarische Hochschulen haben Pharmazie, Zahnmedizin oder Sportwissenschaften auf Deutsch im Fächerkanon.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
