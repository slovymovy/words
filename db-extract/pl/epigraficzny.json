                "senses": [
                    {
                        "sense_id": "60a02cf9-98da-380a-8418-327e09c1943a",
                        "entry_id": "531410d6-984e-327b-b5e0-3fea60be10a2",
                        "glosses": [
                            "związany z epigrafiką, odnoszący się do epigrafiki"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e07f9af-312f-42ec-822f-57b5e376d493",
                                "sense_id": "60a02cf9-98da-380a-8418-327e09c1943a",
                                "text": "Obok źródeł literackich mamy wiadomości o Trakach także ze źródeł epigraficznych i innych zabytków archeologicznych."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e8a38611-9835-4d4c-ae3c-3bc928ce1b73",
                        "source_entry_id": "531410d6-984e-327b-b5e0-3fea60be10a2",
                        "source_sense_id": "60a02cf9-98da-380a-8418-327e09c1943a",
                        "target_lang_word": "epigraphic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "epigraphic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd719a0c-22b1-3937-884d-93968257dc78",
                                        "entry_id": "2ac54f04-d9e9-3af3-9ccb-3b1e8c37ab2a",
                                        "glosses": [
                                            "Of or pertaining to an epigraph or to epigraphy."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f42852b6-bc74-4d39-8a49-e5cf761de8ad",
                                                "sense_id": "fd719a0c-22b1-3937-884d-93968257dc78",
                                                "text": "How well does it work? The team behind Aeneas asked 23 people with epigraphic expertise, ranging from masters students to professors, to try the system out."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8bc6120a-0bdc-476c-84c0-e06d6a735510",
                        "source_entry_id": "531410d6-984e-327b-b5e0-3fea60be10a2",
                        "source_sense_id": "60a02cf9-98da-380a-8418-327e09c1943a",
                        "target_lang_word": "épigraphique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "épigraphique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f580735f-05a8-303c-8b5d-98975fd33a83",
                                        "entry_id": "4bdfea34-3227-30a1-9ff7-3a9431e3a9e5",
                                        "glosses": [
                                            "Relatif aux épigraphes, aux inscriptions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b92a874-673e-4acd-961f-3406f42b6bd8",
                                                "sense_id": "f580735f-05a8-303c-8b5d-98975fd33a83",
                                                "text": "Science épigraphique."
                                            },
                                            {
                                                "example_id": "c9c46064-560f-4aa5-80d0-95024e1d9fd3",
                                                "sense_id": "f580735f-05a8-303c-8b5d-98975fd33a83",
                                                "text": "Indifférent aux phénomènes vulgaires, par lesquels le monde extérieur apparaît au commun des hommes, il dédaigna de voir, tracée à la craie sur le dossier en grandes lettres cursives, l’inscription érotique de Narcisse et d’Ernestine et, s’asseyant avec une quiétude toute spirituelle, il couvrit de son large dos un tiers de ce monument épigraphique."
                                            },
                                            {
                                                "example_id": "c247bffe-6d41-408b-b873-445c185053fe",
                                                "sense_id": "f580735f-05a8-303c-8b5d-98975fd33a83",
                                                "text": "Le père Paneloux s’était déjà distingué par des collaborations fréquentes au bulletin de la Société géographique d’Oran, où ses reconstitutions épigraphiques faisaient autorité. Mais il avait gagné une audience plus étendue que celle d’un spécialiste en faisant une série de conférences sur l’individualisme moderne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
