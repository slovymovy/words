                "senses": [
                    {
                        "sense_id": "8519777a-0e1a-323f-9fe8-cca037da83a0",
                        "entry_id": "46fe7a41-2e75-39c3-884e-8b019fdb3807",
                        "glosses": [
                            "rodzaj statywu składający się z jednej nogi, stabilizujący całkowicie aparat fotograficzny tylko w osi pionowej"
                        ],
                        "tags": [],
                        "examples": [],
