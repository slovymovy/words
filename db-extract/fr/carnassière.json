                        ],
                        "examples": [
                            {
                                "example_id": "cf9cdbc6-7f40-4140-994d-f265a36a2515",
                                "sense_id": "bbd25590-289d-36c8-99a0-cc7c596387c8",
                                "text": "Holà ! J’entends l’abîme impatient crier,\nEt le gouffre t’attire, ô race carnassière\nDe Celui qui ne sut ni fléchir ni prier !"
                            }
                        ]
                    }
                ],
                "translations": [],
