                "senses": [
                    {
                        "sense_id": "2255cf39-9634-3c18-b6ad-b8bfd8933be0",
                        "entry_id": "e8ff99c9-58f2-3ebc-893a-eac1fca6ca68",
                        "glosses": [
                            "in der Reichweite begrenzte, lokale Sendeanstalt"
