                        "examples": [
                            {
                                "example_id": "3f3b3d65-8cc6-4ab6-8906-77b725a7e922",
                                "sense_id": "ce8ea47d-0b8b-357c-9ace-657bdd32908f",
                                "text": "„Die Fischfabrik am Hafen ist der größte Arbeitgeber in dem kleinen Dorf an der Meerenge Sundini im äußersten Nordwesten von Eysturoy.“"
                            },
                            {
                                "example_id": "3cd95caa-3a4a-4dcc-a917-4925d49feb93",
                                "sense_id": "ce8ea47d-0b8b-357c-9ace-657bdd32908f",
                                "text": "„Sie bog nach rechts ab, fuhr an den weißen Fischfabriken vorbei und bog dann auf einen Schotterweg ein.“"
                            }
                        ],
