                "senses": [
                    {
                        "sense_id": "7696fb01-510d-36ca-8773-d763d3bd2b6a",
                        "entry_id": "44dbd946-1495-3a3d-bde3-5b9a879b0188",
                        "glosses": [
                            "Enlever son caractère de bocage à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d9954ad-9f0c-40c8-82fb-f098467c0343",
                                "sense_id": "7696fb01-510d-36ca-8773-d763d3bd2b6a",
                                "text": "L’équipement de l'Ouest, par exemple le Plan routier breton, a constitué une chance pour une région laissée pour compte, mais fallait-il débocagiser à outrance à l’occasion des remembrements, comme on l’a fait ?"
                            },
                            {
                                "example_id": "509fe8f7-3b97-4248-8746-28a3f2860ad9",
                                "sense_id": "7696fb01-510d-36ca-8773-d763d3bd2b6a",
                                "text": "Une campagne peuplée, remembrée et débocagisée dans les années 1970 et 1980."
                            },
                            {
                                "example_id": "c108526e-aebd-45f5-a786-93288fa0adcd",
                                "sense_id": "7696fb01-510d-36ca-8773-d763d3bd2b6a",
                                "text": "Autres dynamiques spatiales, les bouleversements liés à des objectifs de rationalisation et de meilleure gestion rurale introduisent des changements dans l'organisation spatiale : il ne faut pas se laisser piéger par les cartes issues de régions débocagisées par exemple."
                            }
                        ]
                    }
