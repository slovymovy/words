                "senses": [
                    {
                        "sense_id": "d4b814b9-ae10-312f-b1c1-f2a5a4c6c72a",
                        "entry_id": "4dba8444-b9ae-3ae1-8af3-c4f9fd8126dc",
                        "glosses": [
                            "Arbeitgeber (insbesondere der Dienstboten und des Gesindes)"
                        ],
                        "tags": [
                            "veraltend für"
                        ],
                        "examples": [
                            {
                                "example_id": "d55a6aee-98c6-41c6-85fe-29e66de3965b",
                                "sense_id": "d4b814b9-ae10-312f-b1c1-f2a5a4c6c72a",
                                "text": "Er mochte wider seinen Brotherrn nichts Schlechtes sagen."
                            },
                            {
                                "example_id": "09ba47fd-e60e-48c4-862b-f786142099d9",
                                "sense_id": "d4b814b9-ae10-312f-b1c1-f2a5a4c6c72a",
                                "text": "„Auf allen langen Reisen, zum Beispiel nach Vestmanna oder Kollafjødur, nahm er Rikard als seinen Helfer mit, und an den ruhigen Abenden fischten der Brotherr und sein Knecht gewöhnlich vor der Landspitze Steyrur und bei den Láturgjógv-Klippen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
