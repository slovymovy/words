                "senses": [
                    {
                        "sense_id": "f17fe1dc-c170-301e-be1e-0fdf8c0911be",
                        "entry_id": "7687741a-2512-3dbc-b7da-ededc08567b3",
                        "glosses": [
                            "„unterste Gesellschaftsschicht ohne Klassenbewusstsein“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dab3171-069b-443a-a9d3-7d07a5376f1f",
                                "sense_id": "f17fe1dc-c170-301e-be1e-0fdf8c0911be",
                                "text": "„Die Schwienteks, die Choloneks und ihre Nachbarn sind ein grotesk beschriebenes Lumpenproletariat, gerne mit Ambitionen in Richtung Bürgerlichkeit.“"
                            },
                            {
                                "example_id": "6362403e-1d21-40e3-9300-2a3e87ed5bed",
                                "sense_id": "f17fe1dc-c170-301e-be1e-0fdf8c0911be",
                                "text": "„An vielen Orten hielt sich die eingesessene tschechische Bevölkerung – das Lumpenproletariat, das es in allen Städten von einer bestimmten Größe an gibt, vielleicht ausgenommen – bei Brutalitäten gegenüber den eingesessenen Deutschen zurück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
