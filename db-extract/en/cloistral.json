                    {
                        "translation_id": "15c2775f-de20-4832-bcee-7d59cb681f6d",
                        "source_entry_id": "2e5408d9-9eff-3253-a092-ae1114741954",
                        "source_sense_description": "sheltered from the world; monastic",
                        "target_lang_word": "monastique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monastique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d1677944-b208-3e6a-941d-ffae8f01704d",
                                        "entry_id": "86a54c63-76a9-3043-a781-fd2ced1fda97",
                                        "glosses": [
                                            "Relatif aux moines, monacal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfbe8741-7f50-4cc7-a523-72ec1d30dd98",
                                                "sense_id": "d1677944-b208-3e6a-941d-ffae8f01704d",
                                                "text": "Si cependant vous suivez si rigidement les règles monastiques, […], que vous préfériez une boisson de lait aigre à ce vin, ne faites pas violence à votre politesse pour me rendre raison."
                                            },
                                            {
                                                "example_id": "863e9968-fdec-4245-825d-3d2e0119c4c2",
                                                "sense_id": "d1677944-b208-3e6a-941d-ffae8f01704d",
                                                "text": "Cette tranquillité monastique cachait la vie la plus orageuse, la vie par les idées, la vie du Monde Spirituel."
                                            },
                                            {
                                                "example_id": "021d9389-e5d6-4d2d-a24b-d97230aace7f",
                                                "sense_id": "d1677944-b208-3e6a-941d-ffae8f01704d",
                                                "text": "Rien n'arrête le zèle des recruteurs monastiques. Vous les voyez frétiller autour des héritiers, des héritières…"
                                            },
                                            {
                                                "example_id": "3498e398-335f-43d6-ad37-0cac4c59f0c1",
                                                "sense_id": "d1677944-b208-3e6a-941d-ffae8f01704d",
                                                "text": "De plus, un système monastique envahissant endoctrinait des dizaines de milliers d’enfants de moins de dix ans dans des rituels superstitieux, tout en les forçant au célibat dans une vie inutile de prière et d’études religieuses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b2409e5-c13b-4f27-9b96-4db8243394c7",
                        "source_entry_id": "2e5408d9-9eff-3253-a092-ae1114741954",
                        "source_sense_description": "sheltered from the world; monastic",
                        "target_lang_word": "monacal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monacal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f6f8f9ae-2ac4-3e6e-b67c-373d92f41a46",
                                        "entry_id": "91145221-fc5a-3a8a-912f-cb24251fa315",
                                        "glosses": [
                                            "Qui a rapport à l’état de moine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "000ebefd-3741-415c-94ec-f1604ab2ea74",
                                                "sense_id": "f6f8f9ae-2ac4-3e6e-b67c-373d92f41a46",
                                                "text": "[…]; - d'autre part, chez eux la vie de famille était trop forte pour que l'idéal monacal pût devenir important."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7489c10c-938c-3218-a2ce-270f1b374e93",
                                        "entry_id": "91145221-fc5a-3a8a-912f-cb24251fa315",
                                        "glosses": [
                                            "Austère."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2335b0f6-a604-44d0-957f-b26d142f853d",
                                                "sense_id": "7489c10c-938c-3218-a2ce-270f1b374e93",
                                                "text": "Et ils se la figuraient, cette petite chambre, d’une propreté maniaque, avec sa commode de noyer et son lit monacal, garni de rideaux blancs."
                                            },
                                            {
                                                "example_id": "c34d2cd3-8c46-4c0d-901a-20445878042c",
                                                "sense_id": "7489c10c-938c-3218-a2ce-270f1b374e93",
                                                "text": "Cette fois, la déco est monacale. Les murs sont badigeonnés d'un enduit coquille d'œuf à faire chialer une nichée de poussins."
                                            },
                                            {
                                                "example_id": "4c97b193-c58f-4add-8f9a-63060d8926f6",
                                                "sense_id": "7489c10c-938c-3218-a2ce-270f1b374e93",
                                                "text": "J’ignorais qu’elle pouvait vivre de façon si monacale entourée de bouquins, branchée sur Netflix et autres supports techniques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b7d8dce-601f-439d-a184-3e3773fce1b2",
                        "source_entry_id": "2e5408d9-9eff-3253-a092-ae1114741954",
                        "source_sense_description": "sheltered from the world; monastic",
                        "target_lang_word": "klösterlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "klösterlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fec14460-513b-3a33-92ac-637e8a7aa687",
                                        "entry_id": "383df975-eee1-374a-9370-a78baa7ada6c",
                                        "glosses": [
                                            "auf das Leben in einem Kloster bezogen; der Lebensweise von Mönchen/Nonnen entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07c82160-8799-4fc5-8293-26edfddea88d",
                                                "sense_id": "fec14460-513b-3a33-92ac-637e8a7aa687",
                                                "text": "Das unscheinbare Haus war sein [Samuel Becketts] Refugium. Hier schrieb er in klösterlicher Abgeschiedenheit, während er weniger klösterlich zum Whiskey griff …."
                                            },
                                            {
                                                "example_id": "f80a8506-2a98-4a31-b951-8e2da54bcb65",
                                                "sense_id": "fec14460-513b-3a33-92ac-637e8a7aa687",
                                                "text": "In beiden Büchern auch wird das Heil einer klösterlich weltenthobenen Männergemeinschaft gepriesen."
                                            },
                                            {
                                                "example_id": "d967bd3c-2a03-4f43-ba99-968d5419662f",
                                                "sense_id": "fec14460-513b-3a33-92ac-637e8a7aa687",
                                                "text": "Deshalb hat Marie-Therese Cramer das Ensemble in aufwendige historische Kostüme gesteckt, das Bühnenbild aber klösterlich, geradezu spartanisch einfach gehalten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "801ebb79-961f-3af5-bec7-e8bbf97eb0fc",
                                        "entry_id": "383df975-eee1-374a-9370-a78baa7ada6c",
                                        "glosses": [
                                            "zu einem Kloster gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55792b1a-a673-4b90-a210-d9d10b3cd636",
                                                "sense_id": "801ebb79-961f-3af5-bec7-e8bbf97eb0fc",
                                                "text": "Klösterliche Wirtschaftsbetriebe stehen im Wettbewerb wie jedes andere Unternehmen, egal ob wir von Brauereien, Gemüseversorgern oder Zimmervermietungen mit spiritueller Sinnsuche reden."
                                            },
                                            {
                                                "example_id": "0956b1b0-bf6c-453b-9d82-abc9cf6ae57d",
                                                "sense_id": "801ebb79-961f-3af5-bec7-e8bbf97eb0fc",
                                                "text": "Černošice blieb bis zur Auflösung des Klosters im Zuge der Josephinischen Reformen im Jahre 1785 klösterlicher Besitz."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
