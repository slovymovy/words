                        "cas spécifique",
                        "domaine spécifique"
                    ]
                },
                {
                    "sense_id": "10f654ae-9143-3204-9a61-967fbcc9960c",
                    "sense_definition": "En biologie, qui concerne l'espèce ou qui sert à la distinguer au sein d'un genre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le nom <w>spécifique</w> permet aux scientifiques d'identifier précisément l'espèce au sein d'un genre."
                        },
                        {
                            "text": "Certains oiseaux présentent des caractères <w>spécifiques</w> qui les distinguent nettement des espèces voisines vivant dans la même région forestière."
                        }
                    ],
                    "common_phrases": [
                        "nom spécifique",
                        "caractère spécifique"
                    ]
                },
                {
                    "sense_id": "2a07b193-8800-361b-943e-48672d8b3c4b",
                    "sense_definition": "En physique, qualifie une grandeur exprimée par rapport à une unité de masse ou de volume.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La masse <w>spécifique</w> de ce matériau varie considérablement en fonction de la température observée durant l'expérience."
                        },
                        {
                            "text": "Les ingénieurs mesurent avec une grande précision la chaleur <w>spécifique</w> des métaux utilisés pour construire les moteurs."
                        }
                    ],
                    "common_phrases": [
                        "masse spécifique",
                        "poids spécifique",
                        "chaleur spécifique"
                    ]
                }
            ]
        },
