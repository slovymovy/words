                                            {
                                                "example_id": "3c4f2618-316a-48ff-bb57-ce4222859179",
                                                "sense_id": "f0503bb0-aed9-3bd4-9377-fed1b4bf4c00",
                                                "text": "Les premiers blastomères sont des cellules totipotentes, qui restent indifférenciées jusqu'à J4. Ils peuvent se transformer aussi bien en structures embryonnaires qu’en structures annexielles."
                                            },
                                            {
                                                "example_id": "858857ac-ce90-4eb0-a0f9-111275a61ad5",
                                                "sense_id": "f0503bb0-aed9-3bd4-9377-fed1b4bf4c00",
                                                "text": "Elle consiste à microinjecter dans le blastomère une substance de poids moléculaire important qui ne peut pas traverser la membrane plasmique et qui reste donc dans la cellule."
                                            }
                                        ]
