                        ],
                        "examples": [
                            {
                                "example_id": "ba3d328b-654b-4544-8647-6d5dc3a6ef7c",
                                "sense_id": "d699a5b6-884f-3d65-82b9-b3b208fe1ea3",
                                "text": "Donner une beurrée à un enfant."
                            },
                            {
                                "example_id": "d73c13b6-7baf-4d4f-80a4-9be1ec8114f1",
                                "sense_id": "d699a5b6-884f-3d65-82b9-b3b208fe1ea3",
                                "text": "On va manger des beurrées, boire du vin muscat, chasser à la pipée tout le jour et se rouler dans le foin qui sent bon !"
                            },
                            {
                                "example_id": "fa737d58-dc7e-4a5b-a276-16a15bd2a006",
                                "sense_id": "d699a5b6-884f-3d65-82b9-b3b208fe1ea3",
                                "text": "[Bloch] s’octroyait le confortable plaisir de répéter entre chaque gorgée du breuvage bouillant « […] Quelle tartine ! » Et il reprenait une beurrée."
                            }
                        ]
                    }
