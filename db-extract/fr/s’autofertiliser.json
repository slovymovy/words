                "senses": [
                    {
                        "sense_id": "9b85cc25-2309-3fe1-8b76-7b531b4b45c5",
                        "entry_id": "f55164ad-b720-3e56-8f02-320c410b33a3",
                        "glosses": [
                            "Se fertiliser soi-même."
