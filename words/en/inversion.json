{
    "word_family": [
        "invert",
        "inverted",
        "invertible",
        "invertor"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d5b57dfc-8a58-3881-9952-6829cf85ada4",
                    "sense_definition": "A change in the standard word order of a sentence, such as placing the verb before the subject.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher explained that <w>inversion</w> is common in questions like 'Are you ready?'",
                            "target_lang_translations": {
                                "de": "Die Lehrerin erklärte, dass die <w>Inversion</w> in Fragen wie „Bist du bereit?“ üblich ist."
                            }
                        },
                        {
                            "text": "Using <w>inversion</w> in a sentence like 'Never have I seen such beauty' adds emphasis.",
                            "target_lang_translations": {
                                "de": "Die Verwendung einer <w>Inversion</w> in einem Satz wie „Niemals habe ich solche Schönheit gesehen“ sorgt für besondere Betonung."
                            }
                        }
                    ],
                    "synonyms": [
                        "anastrophe",
                        "hyperbaton"
                    ],
                    "common_phrases": [
                        "subject-auxiliary inversion"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Umkehrung der üblichen Wortstellung im Satz, etwa das Voranstellen des Verbs vor das Subjekt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Inversion",
                                "target_lang_sense_clarification": "linguistischer Fachbegriff für Satzumstellung"
                            },
                            {
                                "target_lang_word": "Satzumstellung",
                                "target_lang_sense_clarification": "allgemeine Veränderung der Satzgliedstellung"
                            },
                            {
                                "target_lang_word": "Wortstellungsumkehr",
                                "target_lang_sense_clarification": "Umkehrung der Wortfolge"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "deb14fe7-65dc-3ca6-b64b-2a6abac95a3f",
                    "sense_definition": "A weather condition where air temperature increases with altitude instead of decreasing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "meteorology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city experienced a temperature <w>inversion</w> that trapped smog near the ground.",
                            "target_lang_translations": {
                                "de": "Die Stadt erlebte eine Temperatur<w>inversion</w>, die den Smog in Bodennähe festhielt."
                            }
                        },
                        {
                            "text": "During a strong <w>inversion</w>, the air near the surface remains much colder than the air above.",
                            "target_lang_translations": {
                                "de": "Während einer starken <w>Inversionswetterlage</w> bleibt die Luft in Bodennähe viel kälter als die darüber liegende Luft."
                            }
                        }
                    ],
                    "common_phrases": [
                        "temperature inversion"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Wetterlage, bei der die Lufttemperatur mit zunehmender Höhe steigt statt sinkt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Inversion",
                                "target_lang_sense_clarification": "meteorologische Inversionswetterlage"
                            },
                            {
                                "target_lang_word": "Inversionswetterlage",
                                "target_lang_sense_clarification": "Wetterzustand mit Temperaturumkehr"
                            },
                            {
                                "target_lang_word": "Temperaturumkehr",
                                "target_lang_sense_clarification": "meteorologisches Phänomen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9878f2bf-21d9-3d83-b4c6-2a08b36a4825",
                    "sense_definition": "The state of being upside down or in a reversed sequence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "position",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>inversion</w> of the image on the screen was caused by a faulty lens.",
                            "target_lang_translations": {
                                "de": "Die <w>Umkehrung</w> des Bildes auf dem Bildschirm wurde durch eine fehlerhafte Linse verursacht."
                            }
                        },
                        {
                            "text": "He noticed a complete <w>inversion</w> of the original plan after the meeting.",
                            "target_lang_translations": {
                                "de": "Er bemerkte nach dem Treffen eine völlige <w>Umkehrung</w> des ursprünglichen Plans."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Der Zustand des Auf-dem-Kopf-Stehens oder eine vollkommene Umkehrung einer Reihenfolge oder Situation."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Umkehrung",
                                "target_lang_sense_clarification": "Vorgang oder Zustand des Umkehrens"
                            },
                            {
                                "target_lang_word": "Inversion",
                                "target_lang_sense_clarification": "gehobener Ausdruck für Umkehrung"
                            },
                            {
                                "target_lang_word": "Verdrehung",
                                "target_lang_sense_clarification": "Verkehrung ins Gegenteil"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad6176c8-d007-3b65-8614-2e13ca9efef7",
                    "sense_definition": "A part of a roller coaster ride where passengers are turned upside down.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "amusement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The roller coaster features a thrilling <w>inversion</w> that leaves riders hanging upside down.",
                            "target_lang_translations": {
                                "de": "Die Achterbahn bietet eine aufregende <w>Inversion</w>, bei der die Fahrgäste kopfüber hängen."
                            }
                        },
                        {
                            "text": "She felt dizzy after going through the final <w>inversion</w> on the ride.",
                            "target_lang_translations": {
                                "de": "Ihr wurde schwindelig, nachdem sie das letzte <w>Überkopfelement</w> der Bahn durchfahren hatte."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Fahrabschnitt einer Achterbahn, bei dem die Passagiere kopfüber stehen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Inversion",
                                "target_lang_sense_clarification": "Überkopfelement einer Achterbahn"
                            },
                            {
                                "target_lang_word": "Überkopfelement",
                                "target_lang_sense_clarification": "Fahrelement, bei dem man kopfsteht"
                            }
                        ]
                    }
                }
            ]
        }
    ]
