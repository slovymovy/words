                                            "dříve"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "970ae993-7295-4bd7-80ee-421c58794a94",
                                                "sense_id": "738eae15-7889-3891-aa19-740ec98cce7a",
                                                "text": "Přes všechno úsilí si až do první světové války sufražetky volební právo nevybojovaly. Stejně jako jejich předchůdkyně."
                                            }
