{
    "word_family": [
        "hollowly",
        "hollowness",
        "hollow-eyed",
        "hollow-hearted"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3c5bfab5-5166-34ae-b5e2-68152f81b3d3",
                    "sense_definition": "Having an empty space or cavity inside.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The squirrels decided to hide their winter nuts inside a <w>hollow</w> tree trunk.",
                            "target_lang_translations": {
                                "ru": "Белки решили спрятать свои зимние орехи внутри <w>полого</w> ствола дерева."
                            }
                        },
                        {
                            "text": "The sound of the drum comes from the air vibrating inside its <w>hollow</w> body.",
                            "target_lang_translations": {
                                "ru": "Звук барабана возникает из-за вибрации воздуха внутри его <w>пустого</w> корпуса."
                            }
                        }
                    ],
                    "synonyms": [
                        "empty"
                    ],
                    "antonyms": [
                        "solid"
                    ],
                    "common_phrases": [
                        "hollow tree",
                        "hollow sphere",
                        "hollow tube"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий пустое пространство или полость внутри."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "полый",
                                "target_lang_sense_clarification": "имеющий пустоту внутри"
                            },
                            {
                                "target_lang_word": "пустой",
                                "target_lang_sense_clarification": "не заполненный внутри"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "021b022f-f0de-38ed-9cd4-cce4e5b9cfb0",
                    "sense_definition": "Sunken or concave, often describing facial features due to illness or hunger.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After weeks of illness, his <w>hollow</w> cheeks made him look much older than he was.",
                            "target_lang_translations": {
                                "ru": "После нескольких недель болезни его <w>впалые</w> щеки заставляли его выглядеть гораздо старше, чем он был на самом деле."
                            }
                        },
                        {
                            "text": "She stared into the mirror at her <w>hollow</w> eyes after a long night of studying.",
                            "target_lang_translations": {
                                "ru": "Она смотрела в зеркало на свои <w>запавшие</w> глаза после долгой ночи учебы."
                            }
                        }
                    ],
                    "synonyms": [
                        "empty"
                    ],
                    "antonyms": [
                        "full",
                        "plump"
                    ],
                    "common_phrases": [
                        "hollow cheeks",
                        "hollow eyes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Запавший или вогнутый, часто о чертах лица из-за болезни или голода."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "впалый",
                                "target_lang_sense_clarification": "о щеках или глазах"
                            },
                            {
                                "target_lang_word": "запавший",
                                "target_lang_sense_clarification": "глубоко сидящий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd0d9f20-f02b-3b15-9f6f-4e48b0cde07a",
                    "sense_definition": "Insincere or lacking validity; not backed by real intent or truth.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician made a <w>hollow</w> promise that everyone knew he would never keep.",
                            "target_lang_translations": {
                                "ru": "Политик дал <w>пустое</w> обещание, которое, как все знали, он никогда не сдержит."
                            }
                        },
                        {
                            "text": "His apology felt <w>hollow</w> because he continued to behave in the same rude way.",
                            "target_lang_translations": {
                                "ru": "Его извинение казалось <w>неискренним</w>, потому что он продолжал вести себя так же грубо."
                            }
                        }
                    ],
                    "synonyms": [
                        "empty"
                    ],
                    "antonyms": [
                        "sincere",
                        "genuine"
                    ],
                    "common_phrases": [
                        "hollow promise",
                        "hollow words",
                        "hollow apology"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неискренний или лишенный законной силы; не подкрепленный реальными намерениями или правдой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пустой",
                                "target_lang_sense_clarification": "бессодержательный, неискренний"
                            },
                            {
                                "target_lang_word": "лживый",
                                "target_lang_sense_clarification": "неискренний"
                            },
                            {
                                "target_lang_word": "бессодержательный",
                                "target_lang_sense_clarification": "лишенный смысла"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "984be205-eefd-30cc-b63a-db81e0d5d892",
                    "sense_definition": "Without substance or significant worth; meaningless.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Winning the game felt like a <w>hollow</w> victory since their best player was injured.",
                            "target_lang_translations": {
                                "ru": "Победа в игре казалась <w>бессмысленной</w>, так как их лучший игрок был травмирован."
                            }
                        },
                        {
                            "text": "Without his family to share it with, his professional success seemed <w>hollow</w>.",
                            "target_lang_translations": {
                                "ru": "Без семьи, с которой можно было бы разделить успех, его профессиональные достижения казались <w>пустыми</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "empty"
                    ],
                    "antonyms": [
                        "meaningful",
                        "substantial"
                    ],
                    "common_phrases": [
                        "hollow victory",
                        "hollow triumph"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишенный содержания или значимости; бессмысленный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пустой",
                                "target_lang_sense_clarification": "бессмысленный"
                            },
                            {
                                "target_lang_word": "бессмысленный",
                                "target_lang_sense_clarification": "не имеющий ценности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8028efdf-e8d7-3c14-ab6f-8a24ffa8b9ba",
                    "sense_definition": "Sounding as if echoing in an empty space; muffled, low-pitched, or eerie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>hollow</w> moan echoed through the dark corridors of the abandoned castle.",
                            "target_lang_translations": {
                                "ru": "<w>Глухой</w> стон эхом разнесся по темным коридорам заброшенного замка."
                            }
                        },
                        {
                            "text": "The footsteps made a <w>hollow</w> sound as they walked across the wooden floor.",
                            "target_lang_translations": {
                                "ru": "Шаги издавали <w>гулкий</w> звук, когда они шли по деревянному полу."
                            }
                        }
                    ],
                    "synonyms": [
                        "empty"
                    ],
                    "antonyms": [
                        "resonant"
                    ],
                    "common_phrases": [
                        "hollow sound",
                        "hollow echo",
                        "hollow laugh"
                    ],
                    "target_lang_definitions": {
                        "ru": "Звучащий так, будто он отдается эхом в пустом пространстве; глухой, низкий или жуткий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глухой",
                                "target_lang_sense_clarification": "о звуке"
                            },
                            {
                                "target_lang_word": "гулкий",
                                "target_lang_sense_clarification": "резонирующий"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f67194c3-f691-32bb-9c70-de648bb2ce1d",
                    "sense_definition": "An unfilled space in something solid; a cavity.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cavity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bird built its nest in a small <w>hollow</w> in the old oak tree.",
                            "target_lang_translations": {
                                "ru": "Птица свила гнездо в небольшом <w>дупле</w> старого дуба."
                            }
                        },
                        {
                            "text": "He found a hidden <w>hollow</w> behind the bricks where he kept his secret diary.",
                            "target_lang_translations": {
                                "ru": "Он нашел скрытую <w>полость</w> за кирпичами, где хранил свой секретный дневник."
                            }
                        }
                    ],
                    "synonyms": [
                        "empty"
                    ],
                    "common_phrases": [
                        "hollow in a tree",
                        "tree hollow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Незаполненное пространство в чем-то твердом; полость."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дупло",
                                "target_lang_sense_clarification": "в дереве"
                            },
                            {
                                "target_lang_word": "полость",
                                "target_lang_sense_clarification": "внутри твердого тела"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44072333-227c-334b-ad40-7ec74f88183f",
                    "sense_definition": "A small valley or depression between mountains or hills.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small village was tucked away in a quiet <w>hollow</w> between the rolling hills.",
                            "target_lang_translations": {
                                "ru": "Маленькая деревушка притаилась в тихой <w>лощине</w> между пологими холмами."
                            }
                        },
                        {
                            "text": "They built a small cabin in a <w>hollow</w> high up in the mountains.",
                            "target_lang_translations": {
                                "ru": "Они построили небольшую хижину во <w>впадине</w> высоко в горах."
                            }
                        }
                    ],
                    "synonyms": [
                        "empty"
                    ],
                    "antonyms": [
                        "peak",
                        "summit"
                    ],
                    "common_phrases": [
                        "mountain hollow",
                        "wooded hollow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая долина или впадина между горами или холмами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лощина",
                                "target_lang_sense_clarification": "небольшая долина"
                            },
                            {
                                "target_lang_word": "низина",
                                "target_lang_sense_clarification": "низменное место"
                            },
                            {
                                "target_lang_word": "впадина",
                                "target_lang_sense_clarification": "углубление в рельефе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc6c29a2-9f4b-3b59-9ec4-ea010687ad75",
                    "sense_definition": "A sunken area or depression on a surface.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cavity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He cupped some water from the stream in the <w>hollow</w> of his hand.",
                            "target_lang_translations": {
                                "ru": "Он зачерпнул немного воды из ручья в <w>пригоршню</w> (углубление ладони)."
                            }
                        },
                        {
                            "text": "Rainwater collected in the <w>hollow</w> of the rock after the afternoon storm.",
                            "target_lang_translations": {
                                "ru": "Дождевая вода скопилась в <w>углублении</w> скалы после дневного шторма."
                            }
                        }
                    ],
                    "synonyms": [
                        "empty"
                    ],
                    "antonyms": [
                        "bump",
                        "protrusion"
                    ],
                    "common_phrases": [
                        "hollow of the hand"
                    ],
                    "target_lang_definitions": {
                        "ru": "Углубление или впадина на поверхности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "углубление",
                                "target_lang_sense_clarification": "выемка на поверхности"
                            },
                            {
                                "target_lang_word": "впадина",
                                "target_lang_sense_clarification": "вогнутое место"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "088f3491-e397-31a0-bf43-7b6e4a29d67f",
                    "sense_definition": "To make a hole in something or to excavate a space inside.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist began to <w>hollow</w> out the log to create a traditional canoe.",
                            "target_lang_translations": {
                                "ru": "Художник начал <w>выдалбливать</w> бревно, чтобы создать традиционное каноэ."
                            }
                        },
                        {
                            "text": "Over thousands of years, the river started to <w>hollow</w> the limestone into caves.",
                            "target_lang_translations": {
                                "ru": "За тысячи лет река начала <w>вымывать</w> известняк, превращая его в пещеры."
                            }
                        }
                    ],
                    "synonyms": [
                        "empty"
                    ],
                    "antonyms": [
                        "fill"
                    ],
                    "common_phrases": [
                        "hollow out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать отверстие в чем-либо или выдолбить пространство внутри."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдалбливать",
                                "target_lang_sense_clarification": "делать полость"
                            },
                            {
                                "target_lang_word": "пустошить",
                                "target_lang_sense_clarification": "делать пустым внутри"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "c1fe2f45-867b-326c-be81-9dc4339448f0",
                    "sense_definition": "Completely; used primarily in the phrase beat <w>hollow</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our team was so well-prepared that we beat the opposition <w>hollow</w>.",
                            "target_lang_translations": {
                                "ru": "Наша команда была так хорошо подготовлена, что мы разбили соперников <w>наголову</w>."
                            }
                        },
                        {
                            "text": "The new smartphone model beats the old one <w>hollow</w> in terms of speed.",
                            "target_lang_translations": {
                                "ru": "Новая модель смартфона <w>в пух и прах</w> разбивает старую по скорости работы."
                            }
                        }
                    ],
                    "synonyms": [
                        "empty"
                    ],
                    "common_phrases": [
                        "beat hollow"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used in specific idioms like 'beat hollow'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью; используется в основном в выражении «beat hollow» (разбить наголову)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наголову",
                                "target_lang_sense_clarification": "в значении 'разбить полностью'"
                            },
                            {
                                "target_lang_word": "в пух и прах",
                                "target_lang_sense_clarification": "полностью превзойти"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}