                ],
                "senses": [
                    {
                        "sense_id": "e71fdcf8-82dc-38cf-8620-42a1a27c053d",
                        "entry_id": "3a259ee3-6ca9-33ea-ad4a-79fb844e12a1",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2145e1c0-1f5c-4a22-bb77-67c5dbd35e3a",
                                "sense_id": "e71fdcf8-82dc-38cf-8620-42a1a27c053d",
                                "text": "Frau Gumbel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "95fda9b9-c550-4eb5-8a66-84b70f3b7bbd",
                                "sense_id": "e71fdcf8-82dc-38cf-8620-42a1a27c053d",
                                "text": "Herr Gumbel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "018b7972-c65a-4552-9248-1004af84f044",
                                "sense_id": "e71fdcf8-82dc-38cf-8620-42a1a27c053d",
                                "text": "Die Gumbels fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "582da4b3-573a-4227-bccd-e4f646d13008",
                                "sense_id": "e71fdcf8-82dc-38cf-8620-42a1a27c053d",
                                "text": "Der Gumbel trägt nie die Pullover, die die Gumbel ihm strickt."
                            },
                            {
                                "example_id": "14294086-9043-45ec-80aa-bc44aea70182",
                                "sense_id": "e71fdcf8-82dc-38cf-8620-42a1a27c053d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gumbel kommt, geht der Herr Gumbel.“"
                            },
                            {
                                "example_id": "4fcf4614-9b93-4134-9e4b-a1e726c0b47a",
                                "sense_id": "e71fdcf8-82dc-38cf-8620-42a1a27c053d",
                                "text": "Gumbel kommt und geht."
                            },
                            {
                                "example_id": "5aa2ecf1-631a-44ec-950d-171bc15042b2",
                                "sense_id": "e71fdcf8-82dc-38cf-8620-42a1a27c053d",
                                "text": "Gumbels kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
