                ],
                "senses": [
                    {
                        "sense_id": "f6e3d0c0-2f3f-3416-8b14-06b78ebaee67",
                        "entry_id": "471910dd-dff3-3483-9566-179a938d9e7e",
                        "glosses": [
                            "A person who practices futurology."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c5d8c75-418d-48eb-811a-ccd16aad0e92",
                                "sense_id": "f6e3d0c0-2f3f-3416-8b14-06b78ebaee67",
                                "text": "Although I do not pretend to be a futurologist, I would be embarrassed if my view of the trends and causes of social life in the United States had become invalid in such a short interval. (It is easy to be a success as a futurologist as long as your predictions are about what's going to happen fifty years ahead. No one can prove you wrong until fifty years go by. […])"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f4b42fe8-5fef-4356-9570-963985b11654",
                        "source_entry_id": "471910dd-dff3-3483-9566-179a938d9e7e",
                        "source_sense_id": "f6e3d0c0-2f3f-3416-8b14-06b78ebaee67",
                        "source_sense_description": "person",
                        "target_lang_word": "futurologue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "futurologue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b0a24b92-4c3c-3582-aa91-4bf92c5dff88",
                                        "entry_id": "03fa16e0-8c37-37fe-9b99-498772d7e973",
                                        "glosses": [
                                            "Spécialiste dans l’observation des changements qui s’amorcent et la prédiction des événements à venir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d148d32-cfa1-49c0-a569-99eceb9304c4",
                                                "sense_id": "b0a24b92-4c3c-3582-aa91-4bf92c5dff88",
                                                "text": "Le futurologue est obligé, au moins dans certaines de ses hypothèses, de tenir compte des tendances du passé."
                                            },
                                            {
                                                "example_id": "46870c29-af81-4d91-808b-c5554d6be252",
                                                "sense_id": "b0a24b92-4c3c-3582-aa91-4bf92c5dff88",
                                                "text": "Il y a quelques années, le futurologue et directeur de l’ingénierie chez Google Raymond Kurzweil affirmait par exemple que nos méninges seraient directement connectées à Internet d’ici 2030."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
