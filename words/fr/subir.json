    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b2f41445-62f2-36bf-98fe-e3604033bd15",
                    "sense_definition": "Éprouver un dommage, une épreuve difficile ou les conséquences pénibles d'un événement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "epreuve_dommage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le village a <w>subi</w> des dégâts matériels importants après l'inondation soudaine."
                        },
                        {
                            "text": "L'entreprise doit <w>subir</w> les conséquences financières de cette décision imprudente."
                        }
                    ],
                    "synonyms": [
                        "endurer",
                        "essuyer",
                        "souffrir"
                    ],
                    "common_phrases": [
                        "subir les conséquences",
                        "subir des pertes",
                        "subir des dégâts"
                    ]
                },
                {
                    "sense_id": "9cd6f447-9f82-3636-bc43-59575b177da2",
                    "sense_definition": "Passer par une intervention médicale, un test de santé ou une épreuve d'évaluation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "examen_medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le blessé doit <w>subir</w> une opération chirurgicale en urgence."
                        },
                        {
                            "text": "Les candidats vont <w>subir</w> un examen oral devant plusieurs professeurs."
                        }
                    ],
                    "synonyms": [
                        "passer"
                    ],
                    "common_phrases": [
                        "subir une opération",
                        "subir un examen",
                        "subir des tests"
                    ]
                },
                {
                    "sense_id": "2910b8e8-7e6d-3b26-a9bf-0df8d546ab64",
                    "sense_definition": "Être affecté par une action extérieure, une transformation ou un changement inévitable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "transformation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le projet initial a dû <w>subir</w> des modifications importantes pour respecter le budget."
                        },
                        {
                            "text": "Le trafic ferroviaire risque de <w>subir</w> de lourds retards tout au long de la journée."
                        }
                    ],
                    "synonyms": [
                        "connaître"
                    ],
                    "common_phrases": [
                        "subir des modifications",
                        "subir des retards",
                        "subir des changements"
                    ]
                },
                {
                    "sense_id": "d495e1fe-13d6-36ea-ab66-ecd6defbf210",
                    "sense_definition": "Supporter avec résignation et à contrecœur la présence d'une personne ou une contrainte désagréable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "endurance_passive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les voisins ont dû <w>subir</w> le bruit des travaux pendant plusieurs mois."
                        },
                        {
                            "text": "Il refuse de simplement <w>subir</w> la situation et décide d'agir pour trouver une solution."
                        }
                    ],
                    "synonyms": [
                        "endurer",
                        "supporter",
                        "tolérer"
                    ],
                    "common_phrases": [
                        "subir la situation",
                        "subir en silence"
                    ]
                }
            ]
        }
    ]
