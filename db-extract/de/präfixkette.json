                ],
                "senses": [
                    {
                        "sense_id": "73016e1c-59c5-3936-970c-0076041a3c58",
                        "entry_id": "a7eaaf3f-1fc3-3322-88af-49b3c53a6490",
                        "glosses": [
                            "Reihe von Affixen vor dem Stamm/der Wurzel des Wortes"
                        ],
                        "tags": [
                            "Morphologie"
                        ],
                        "examples": [
                            {
                                "example_id": "7e183116-7b6f-4984-97a6-b4bca5ff83d6",
                                "sense_id": "73016e1c-59c5-3936-970c-0076041a3c58",
                                "text": "„Adverbiale Kasus stellen eine Beziehung zwischen Nomen und Verb her und werden zum Teil in der Präfixkette wieder aufgenommen, z.B. ‚das Wasser in den Krug (hinein-)gießen‘.“"
                            },
                            {
                                "example_id": "b8cf96be-395b-4dae-9cfc-eb091b93656a",
                                "sense_id": "73016e1c-59c5-3936-970c-0076041a3c58",
                                "text": "„Sowohl Z. 17 als auch Z. 18 beginnen mit ‚e₂‘ Haus und enden mit einer finiten Verbalform mit der Präfixkette ‚bi₂-in-B‘.“"
                            },
                            {
                                "example_id": "2f4b66cb-9ffe-4770-859a-a090659ec185",
                                "sense_id": "73016e1c-59c5-3936-970c-0076041a3c58",
                                "text": "„Es wird geprüft, ob die der terminalen Kette vorausgehende Buchstabenfolge die Bedingungen einer Präfixkette erfüllt.“"
                            },
                            {
                                "example_id": "66bbef00-a4ff-49de-bdb0-7e0430d22325",
                                "sense_id": "73016e1c-59c5-3936-970c-0076041a3c58",
                                "text": "„Die Autoren verweisen […] auf typologisch eng verwandte Bantusprachen, deren agglutinierende und über den Satz nominalklassenkongruente Präfixketten in manchen Schreibkonventionen graphisch vereinzelt, in anderen aber zu komplexen Schreibwörtern zusammengezogen werden.“"
                            },
                            {
                                "example_id": "27c06a60-1ba7-4e9a-93bc-13166e633514",
                                "sense_id": "73016e1c-59c5-3936-970c-0076041a3c58",
                                "text": "„Man könnte […] mit einem gewissen Vorbehalt die typologische Erscheinung akzeptieren, daß das System von Präfixketten im Hattischen zu denen der (nord)westlichen Vertretern der Sprachen Kaukasiens […] strukturelle Ähnlichkeiten aufweist, […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
