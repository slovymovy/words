                                "sense_id": "84bb7508-e0bb-3986-91f7-ada97a884c4b",
                                "text": "Herr Bromberg ist als Kaninchenzüchter erfolgreich."
                            },
                            {
                                "example_id": "d14ae1b7-80ac-45e6-a171-11d86f035c03",
                                "sense_id": "84bb7508-e0bb-3986-91f7-ada97a884c4b",
                                "text": "Herr Bromberg heiratet im September auf Hawaii."
                            },
                            {
                                "example_id": "9c530710-43bc-4722-bc7a-a43111e5e04c",
                                "sense_id": "84bb7508-e0bb-3986-91f7-ada97a884c4b",
                                "text": "Frau Bromberg liebt es, an Weihnachten Plätzchen zu backen."
                            },
                            {
                                "example_id": "625c5c85-a3fa-4990-97fe-4aae762b319f",
                                "sense_id": "84bb7508-e0bb-3986-91f7-ada97a884c4b",
                                "text": "Die Brombergs lieben die Natur und die Tiere."
                            }
