                        ],
                        "examples": [
                            {
                                "example_id": "d8a3f2da-101c-471a-9e0d-d9c718fe83f0",
                                "sense_id": "98dffcc1-5f9b-31c5-ab6d-5c24b37ec27c",
                                "text": "Mit den Öffis kommt man auch leicht ins Grüne.",
                                "translation": "With public transport it is also easy to access nature.",
                                "english": "With public transport it is also easy to access nature."
                            },
                            {
                                "example_id": "60d44e9b-42f8-4fa5-8bfa-e911646dbe46",
                                "sense_id": "98dffcc1-5f9b-31c5-ab6d-5c24b37ec27c",
                                "text": "Das 9-Euro-Ticket soll als Öffi-Flatrate, die 29 bis 49 Euro kostet, neu aufgelegt werden.",
                                "translation": "The €9 ticket is to be relaunched as a public transport flat rate costing between €29 and €49.",
                                "english": "The €9 ticket is to be relaunched as a public transport flat rate costing between €29 and €49."
                            },
                            {
                                "example_id": "6b010272-c202-41dc-bf3b-4b4732e570c8",
                                "sense_id": "98dffcc1-5f9b-31c5-ab6d-5c24b37ec27c",
                                "text": "Auf der Homepage darauf hinweisen, wie man am besten mit den Öffis anreisen kann. Oder Fahrradständer anbringen, wobei das wahrscheinlich schon wieder zu dem Bereich gehört, wo man auch etwas Geld in die Hand nehmen müsste.",
                                "translation": "Indicate on the homepage how best to get there by public transport. Or install bicycle racks, although that probably falls into the category of things that would require spending money.",
                                "english": "Indicate on the homepage how best to get there by public transport. Or install bicycle racks, although that probably falls into the category of things that would require spending money."
                            }
                        ]
