                "senses": [
                    {
                        "sense_id": "c433dd3a-3c26-3fe1-975b-9ff35d8390c8",
                        "entry_id": "11fddd35-d71a-3393-a3d2-5f4913c64518",
                        "glosses": [
                            "не очень высоко поднимать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe0620a7-a5f0-4253-acf8-ec6358130499",
                                "sense_id": "c433dd3a-3c26-3fe1-975b-9ff35d8390c8",
                                "text": "Увеличение объёма сформованных кусков теста во время расстойки происходит благодаря тому, что газ, выделяющийся во время брожения, стремится выйти из теста, встречает на своём пути клейковину, приподнимает и раздвигает её."
                            }
                        ]
                    },
                    {
                        "sense_id": "a5f19c2a-743f-32c8-8981-176a108318f0",
                        "entry_id": "11fddd35-d71a-3393-a3d2-5f4913c64518",
                        "glosses": [
                            "перен. возбуждать, оживлять (настроение и т. п.)"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3f722b08-b605-443e-a745-cbe709568137",
