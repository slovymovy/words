                                        "glosses": [
                                            "Qui se rapporte à la planète Jupiter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a77a4d23-57dc-4640-9298-e56ed6f6e27c",
                                                "sense_id": "911f17a9-b3c1-32a6-9115-17f75e3d1fe9",
                                                "text": "La sonde a pénétré l'atmosphère jovienne ce matin."
                                            },
                                            {
                                                "example_id": "b0fbb79f-0fc0-49d2-9414-9d8dcda2d319",
                                                "sense_id": "911f17a9-b3c1-32a6-9115-17f75e3d1fe9",
                                                "text": "« Pendant des siècles les scientifiques ont observé, se sont interrogés et ont théorisé sur la grande tache rouge jovienne », a dit Scott Bolton du Southwest Research Institute à San Antonio, qui est le responsable scientifique de la mission."
                                            },
                                            {
                                                "example_id": "4ffb20e7-5b72-40fb-a8fa-25536e0beda7",
                                                "sense_id": "911f17a9-b3c1-32a6-9115-17f75e3d1fe9",
                                                "text": "JUICE inspectera le système jovien, survolera ses lunes, puis se placera en orbite autour de Ganymède, la plus grosse."
                                            }
                                        ]
                                    }
                                ]
                            },
