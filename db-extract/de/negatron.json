                "senses": [
                    {
                        "sense_id": "411cab17-ea80-3942-907b-800eb04322f7",
                        "entry_id": "d733d813-065b-30ad-befc-8a94f02ffd89",
                        "glosses": [
                            "negativ geladenes Lepton (ein Elementarteilchen); das Antiteilchen des Positrons"
                        ],
                        "tags": [
                            "physics",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "bdb5cdcb-85a0-4787-bbd2-d264857d78e7",
                                "sense_id": "411cab17-ea80-3942-907b-800eb04322f7",
                                "text": "Bis auf seine elektrische Ladung hat ein Negatron dieselben Eigenschaften wie ein Positron."
                            },
                            {
                                "example_id": "4c2b73a2-d7c2-4a46-884b-ad2b9a44b552",
                                "sense_id": "411cab17-ea80-3942-907b-800eb04322f7",
                                "text": "„Zur Bildung eines Positrons muß die doppelte Ruhemasse des Elektrons (2m, c = 1,02 MeV) aufgebracht werden, da ja die Überführung aus dem Zustand negativer in den positiver Energie geschieht und so gleichzeitig ein Negatron gebildet wird (‚Paarbildungsprozeß‘).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ebb6d6a0-0ec5-318e-9b14-5590b79553db",
                        "entry_id": "d733d813-065b-30ad-befc-8a94f02ffd89",
                        "glosses": [
                            "Röhre mit zwei Gittern, die sinkenden Anodenstrom bei steigender Anodenspannung bewirkt"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "4c53055c-7be7-4748-ac2b-e4c74d712fb9",
                                "sense_id": "ebb6d6a0-0ec5-318e-9b14-5590b79553db",
                                "text": "„Das Negatron ist eine Röhre mit zwei Gittern, welche dieselbe Wirkung hervorbringt, also sinkenden Anodenstrom bei steigender Anodenspannung.“"
                            },
                            {
                                "example_id": "5ea27292-8a5f-40db-9cce-d21475450553",
                                "sense_id": "ebb6d6a0-0ec5-318e-9b14-5590b79553db",
                                "text": "„Als andre Anordnungen sind noch zu erwähnen: das Negatron und das Biotron (eine Röhrenschaltung) von J. Scott-Taggart.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
