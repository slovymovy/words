{
    "word_family": [
        "upcome",
        "come"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "964e9df1-4659-3bfa-93fd-5671ccf39ba5",
                    "sense_definition": "Happening or appearing in the relatively near future.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "future_events",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is preparing for the <w>upcoming</w> election next month.",
                            "target_lang_translations": {
                                "ru": "Компания готовится к <w>предстоящим</w> выборам в следующем месяце."
                            }
                        },
                        {
                            "text": "You can find more details about the <w>upcoming</w> event on our official website.",
                            "target_lang_translations": {
                                "ru": "Вы можете найти более подробную информацию о <w>предстоящем</w> мероприятии на нашем официальном сайте."
                            }
                        }
                    ],
                    "synonyms": [
                        "forthcoming",
                        "imminent",
                        "approaching"
                    ],
                    "antonyms": [
                        "past",
                        "previous"
                    ],
                    "common_phrases": [
                        "upcoming event",
                        "upcoming election",
                        "upcoming release",
                        "upcoming season"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий или появляющийся в относительно ближайшем будущем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предстоящий",
                                "target_lang_sense_clarification": "о событии или мероприятии"
                            },
                            {
                                "target_lang_word": "грядущий",
                                "target_lang_sense_clarification": "о важных переменах или событиях"
                            },
                            {
                                "target_lang_word": "наступающий",
                                "target_lang_sense_clarification": "о времени или праздниках"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2acb78f0-d9e3-3cd6-8c18-f3756ee2a2f7",
                    "sense_definition": "A nonstandard or mistaken use of up-and-coming, referring to someone showing potential for future success.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "potential",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The championship saw an old pro face an <w>upcoming</w> young rookie.",
                            "target_lang_translations": {
                                "ru": "На чемпионате старый профи столкнулся с <w>многообещающим</w> молодым новичком."
                            }
                        },
                        {
                            "text": "He is considered an <w>upcoming</w> star in the local music scene.",
                            "target_lang_translations": {
                                "ru": "Его считают <w>перспективной</w> звездой на местной музыкальной сцене."
                            }
                        }
                    ],
                    "synonyms": [
                        "promising",
                        "up-and-coming"
                    ],
                    "common_phrases": [
                        "upcoming artist",
                        "upcoming talent"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often considered an eggcorn or error for 'up-and-coming'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нестандартное или ошибочное использование выражения up-and-coming, относящееся к кому-либо, кто подает надежды на успех в будущем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "многообещающий",
                                "target_lang_sense_clarification": "подающий надежды"
                            },
                            {
                                "target_lang_word": "перспективный",
                                "target_lang_sense_clarification": "имеющий потенциал"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ca08e050-2eaf-3f9d-83ea-377c933c5107",
                    "sense_definition": "The present participle and gerund of <w>upcome</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>upcoming</w> of the sun over the horizon was a beautiful sight.",
                            "target_lang_translations": {
                                "ru": "<w>Восход</w> солнца над горизонтом был прекрасным зрелищем."
                            }
                        },
                        {
                            "text": "We watched the water <w>upcoming</w> through the cracks in the floor.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как вода <w>поднимается</w> через щели в полу."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "participle form"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола upcome (подниматься, всходить)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восходящий",
                                "target_lang_sense_clarification": "о солнце или небесном теле"
                            },
                            {
                                "target_lang_word": "поднимающийся",
                                "target_lang_sense_clarification": "движущийся вверх"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0a637c50-b64b-3cdd-82ef-981ca47f41d8",
                    "sense_definition": "The act or instance of coming up or rising.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rising",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>upcoming</w> of the tide caught the tourists by surprise.",
                            "target_lang_translations": {
                                "ru": "Внезапный <w>прилив</w> застал туристов врасплох."
                            }
                        },
                        {
                            "text": "He documented the <w>upcoming</w> of new sprouts in his garden.",
                            "target_lang_translations": {
                                "ru": "Он задокументировал <w>появление</w> новых ростков в своем саду."
                            }
                        }
                    ],
                    "synonyms": [
                        "ascent",
                        "rising"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт или случай подъема или восхождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подъем",
                                "target_lang_sense_clarification": "движение вверх"
                            },
                            {
                                "target_lang_word": "восход",
                                "target_lang_sense_clarification": "появление светила над горизонтом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "978ef2a3-f2a5-3c63-abcf-3ca6212c302e",
                    "sense_definition": "A deserved punishment or fate; one's deserts.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After years of deceit, he finally met his <w>upcoming</w>.",
                            "target_lang_translations": {
                                "ru": "После многих лет обмана он наконец получил <w>возмездие</w>."
                            }
                        },
                        {
                            "text": "The villain received his <w>upcoming</w> in the final chapter of the book.",
                            "target_lang_translations": {
                                "ru": "Злодей получил по <w>заслугам</w> в последней главе книги."
                            }
                        }
                    ],
                    "synonyms": [
                        "comeuppance",
                        "deserts",
                        "retribution"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Rare variant of comeuppance"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заслуженное наказание или участь; то, что человек заслужил."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возмездие",
                                "target_lang_sense_clarification": "заслуженная кара"
                            },
                            {
                                "target_lang_word": "расплата",
                                "target_lang_sense_clarification": "наказание за содеянное"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}