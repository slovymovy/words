                "senses": [
                    {
                        "sense_id": "40d675b5-8c6c-39d5-86ca-bbaa3b95d4d9",
                        "entry_id": "201bbe99-767b-3ea2-9578-c19c5ca95c45",
                        "glosses": [
                            "Zimmer, in dem Toilette (zum Beispiel: Schminken) gemacht werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b11b531a-d8f0-455b-a4ea-2dc532b9cd4f",
                                "sense_id": "40d675b5-8c6c-39d5-86ca-bbaa3b95d4d9",
                                "text": "„Die Marquise war nicht da; aber zwei oder drei Minuten später kam sie aus ihrem Toilettezimmer mit sehr viel Rouge auf ihren Wangen, einer zarten Spitzenhaube, die Brust, die vierzig Jahre vor dieser Zeit wohl die schönste von Frankreich gewesen war, mit einem Umhang aus Seidenspitzen bedeckt, und in einem altmodischen, aber sehr reich mit Gold und Silber bestickten Kleid.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc37429a-2de6-48cd-b641-29b6cf5e07ef",
                        "source_entry_id": "201bbe99-767b-3ea2-9578-c19c5ca95c45",
                        "source_sense_id": "40d675b5-8c6c-39d5-86ca-bbaa3b95d4d9",
                        "source_sense_description": "Zimmer, in dem Toilette (zum Beispiel: Schminken) gemacht werden kann",
                        "target_lang_word": "cabinet de toilette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cabinet de toilette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8b0e7b23-ec97-3c0e-93cf-b29d35df24f7",
                                        "entry_id": "1d0a0909-86fb-3415-aed1-a98ac9fae102",
                                        "glosses": [
                                            "Petite pièce où l’on fait sa toilette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a16b76f-57fe-4fec-a492-4edf27a08fce",
                                                "sense_id": "8b0e7b23-ec97-3c0e-93cf-b29d35df24f7",
                                                "text": "Au premier étage, l’architecte a ménagé deux grandes chambres accompagnées chacune d’un cabinet de toilette, auxquelles la véranda sert de salon ; […] ."
                                            },
                                            {
                                                "example_id": "9e13bb89-cc1e-483a-9677-56173b323e87",
                                                "sense_id": "8b0e7b23-ec97-3c0e-93cf-b29d35df24f7",
                                                "text": "Les wagons de première classe sont pourvus de cabinets de toilette, ménagés à l’arrière, […]."
                                            },
                                            {
                                                "example_id": "a5537836-adcb-44d3-b542-bf14f8ae527c",
                                                "sense_id": "8b0e7b23-ec97-3c0e-93cf-b29d35df24f7",
                                                "text": "Elle s’habille. Je viens de la voir disparaître par la porte du cabinet de toilette."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
