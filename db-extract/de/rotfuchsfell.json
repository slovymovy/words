                "senses": [
                    {
                        "sense_id": "3412709d-85ee-3609-b58d-874fcd65f874",
                        "entry_id": "a03fb7d9-f158-3157-9aaa-769487d4d468",
                        "glosses": [
                            "(abgezogenes) Fell einer Rotfuchses"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c87eb917-870b-44d2-9ab2-9179f5a7a146",
                                "sense_id": "3412709d-85ee-3609-b58d-874fcd65f874",
                                "text": "„Dann legte er [der Sonnengott] nach einer Weile das Silberfuchsfell ab und das Rotfuchsfell an; so entstand das Morgenrot.“"
                            },
                            {
                                "example_id": "68eac9c5-860c-4a7e-bee5-a67bf4e6e3dc",
                                "sense_id": "3412709d-85ee-3609-b58d-874fcd65f874",
                                "text": "„Unsere Dolmetscher verstanden sie nicht, so daß wir uns nicht mit ihnen unterhalten konnten. In ihrer Baidara hatten sie einige Rotfuchsfelle, Parkas aus dem Fell junger Rentiere und aus Zieselfellen, hölzerne Schalen und aus Walroßzähnen hergestellten Kleinkram; das alles tauschten sie bei den Matrosen gegen Korallenkügelchen, Glasperlen und Knöpfe ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
