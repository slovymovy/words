                "senses": [
                    {
                        "sense_id": "b2c72e28-0bf4-3e43-8c24-9cd1d249016f",
                        "entry_id": "d7ecc32c-1c1b-3cb6-b39f-f4fce1147984",
                        "glosses": [
                            "niepełnoletni syn w szlacheckiej, zamożnej rodzinie"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "0fae0eea-aebd-4f3d-ac48-e9c73ac2a0e7",
                                "sense_id": "b2c72e28-0bf4-3e43-8c24-9cd1d249016f",
                                "text": "Nasz panicz zawsze jada śniadania o godzinie ósmej."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "ca3b403a-da6a-37c7-a2f0-f0ac4908efdb",
                        "entry_id": "d7ecc32c-1c1b-3cb6-b39f-f4fce1147984",
                        "glosses": [
                            "mężczyzna młody, elegancki, żyjący wygodnie"
                        ],
                        "tags": [
                            "ironic"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67d85d7f-d34b-49f4-91a3-ff2a138c2cf5",
                        "source_entry_id": "d7ecc32c-1c1b-3cb6-b39f-f4fce1147984",
                        "source_sense_id": "b2c72e28-0bf4-3e43-8c24-9cd1d249016f",
                        "target_lang_word": "childe",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "childe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2a1614d-48b8-3e8e-8475-f953384c7175",
                                        "entry_id": "67066b23-234e-3cc9-a2fd-8c9e3c8319b9",
                                        "glosses": [
                                            "Obsolete form of child."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "960be9d6-a53d-4f89-8fdd-6fbdece87464",
                                                "sense_id": "f2a1614d-48b8-3e8e-8475-f953384c7175",
                                                "text": "I will that non childe of myne have any childe's parte of my goodes saving thies childer here in my will namyd, […]"
                                            },
                                            {
                                                "example_id": "52b60d2f-9703-4ba9-aa86-8078d2819ff2",
                                                "sense_id": "f2a1614d-48b8-3e8e-8475-f953384c7175",
                                                "text": "It'm I gyue & bequithe vnto my Mr iij childringe my beste coalte […] It'm I bequithe & gyue vnto yt childe yt my wiffe is wth all at this p'sente fortie […]"
                                            },
                                            {
                                                "example_id": "97696d71-508a-4412-9a6c-30a5745f1a36",
                                                "sense_id": "f2a1614d-48b8-3e8e-8475-f953384c7175",
                                                "text": "A good childe is to obey a wicked father as he is a father, [... as] children to their parents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc76cba4-c6f4-3052-932f-dac7bfd4d4ed",
                                        "entry_id": "67066b23-234e-3cc9-a2fd-8c9e3c8319b9",
                                        "glosses": [
                                            "A child of noble birth."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4715e07b-bba7-3a15-80f5-50894294514e",
                                        "entry_id": "67066b23-234e-3cc9-a2fd-8c9e3c8319b9",
                                        "glosses": [
                                            "The cognomen given to the oldest son prior to his taking his father's title."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e80356cc-61e3-4d9e-9d1e-5af43c1d8a28",
                                                "sense_id": "4715e07b-bba7-3a15-80f5-50894294514e",
                                                "text": "Childe Rowland to the dark tower came.\nHis word was still \"Fie, foh, and fum,\nI smell the blood of a British man.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "923657e2-8f09-3683-838f-924841ef1a20",
                                        "entry_id": "67066b23-234e-3cc9-a2fd-8c9e3c8319b9",
                                        "glosses": [
                                            "A vampire who was turned by another vampire (the childe's sire) in a particular way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "515c54a3-471b-4608-8ffb-4c2b4e3c678b",
                                                "sense_id": "923657e2-8f09-3683-838f-924841ef1a20",
                                                "text": "She had waded in blood and reveled in death, she had torn her enemies asunder with shadow and given their childer to the flame."
                                            },
                                            {
                                                "example_id": "4a127a8d-d2c2-4450-95a7-c219886a10b7",
                                                "sense_id": "923657e2-8f09-3683-838f-924841ef1a20",
                                                "text": "Alexander, the ancient vampire who has ruled Paris for many centuries, has been deposed by his own childe, Sir Geoffrey."
                                            },
                                            {
                                                "example_id": "71a28296-79bd-40ed-832d-53b2ccec241c",
                                                "sense_id": "923657e2-8f09-3683-838f-924841ef1a20",
                                                "text": "The blood loss involved in creating a childe takes a lot out of the vampire sire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "761ba89d-0108-4c1c-a695-c24f5c43260d",
                        "source_entry_id": "d7ecc32c-1c1b-3cb6-b39f-f4fce1147984",
                        "source_sense_id": "b2c72e28-0bf4-3e43-8c24-9cd1d249016f",
                        "target_lang_word": "younker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "younker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b4f63b3-ab71-378d-97b7-737ce1c3145a",
                                        "entry_id": "3a048a6d-14cd-3d71-be39-36ba50958849",
                                        "glosses": [
                                            "A young man; a lad, youngster."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92f5f049-8fdb-4774-bfc0-0b5f9fb72d50",
                                                "sense_id": "5b4f63b3-ab71-378d-97b7-737ce1c3145a",
                                                "text": "“Jim,” says he, “I reckon we’re fouled, you and me, and we’ll have to sign articles. I’d have had you but for that there lurch, but I don’t have no luck, not I; and I reckon I’ll have to strike, which comes hard, you see, for a master mariner to a ship’s younker like you, Jim.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ea0504c-b91b-3e34-b7ea-ba9c16f68c10",
                                        "entry_id": "3a048a6d-14cd-3d71-be39-36ba50958849",
                                        "glosses": [
                                            "A young gentleman or knight."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac2c8923-7d31-4074-8d92-9b674ec6d8cd",
                                                "sense_id": "0ea0504c-b91b-3e34-b7ea-ba9c16f68c10",
                                                "text": "So foorth they went, and both together giusted;\nBut that same younker soone was overthrowne"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8dbc43a-bb22-32ef-a29d-e2d4485b400d",
                                        "entry_id": "3a048a6d-14cd-3d71-be39-36ba50958849",
                                        "glosses": [
                                            "A novice; a simpleton; a dupe."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5bd45d7-e759-43dc-bdff-0ad9835646ab",
                                                "sense_id": "e8dbc43a-bb22-32ef-a29d-e2d4485b400d",
                                                "text": "Trimmed like a younker prancing to his love!"
                                            }
                                        ]
