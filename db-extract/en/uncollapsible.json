                                "sense_id": "403c7da9-4940-30ff-8b87-326f63e492dc",
                                "text": "The dining-table, uncollapsible and highly varnished, the piano, the chesterfield, stuffed chairs and a few sofas made a foundation on which to heap lesser articles."
                            },
                            {
                                "example_id": "b1d4db42-ecbf-4eee-9122-6af3e903f807",
                                "sense_id": "403c7da9-4940-30ff-8b87-326f63e492dc",
                                "text": "Alvin’s wheelchair went into the trunk, though as it was the old unwieldy uncollapsible type, the lid of the trunk had to be tied shut with heavy twine to accommodate it."
                            }
                        ]
