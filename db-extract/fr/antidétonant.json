                    {
                        "sense_id": "9418a09a-c92f-3c8b-9693-0520eaa4b4af",
                        "entry_id": "b1e94dd8-2028-3b17-8c90-f37b5436481f",
                        "glosses": [
                            "Qui atténue ou prévient la détonation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d029c0d-fee2-4936-bd73-c80036e76c6e",
                                "sense_id": "9418a09a-c92f-3c8b-9693-0520eaa4b4af",
                                "text": "Le plomb tétraéthyle est un additif antidétonant pour le carburant automobile."
                            },
                            {
                                "example_id": "d8d3126e-0c62-4ace-9a13-9c4efdd35890",
                                "sense_id": "9418a09a-c92f-3c8b-9693-0520eaa4b4af",
                                "text": "En chimie, l'indice d'octane d'un carburant est le rapport entre le pouvoir antidétonant de ce carburant et celui d'un carburant de référence."
                            },
                            {
                                "example_id": "7915c476-e708-47ae-bacf-8aab187cd6d7",
                                "sense_id": "9418a09a-c92f-3c8b-9693-0520eaa4b4af",
                                "text": "On parle assez souvent improprement de capacité antidétonante du carburant pour un carburant d'indice d'octane élevé."
                            }
                        ]
                    }
