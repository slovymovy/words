                "translations": [
                    {
                        "translation_id": "d7989eb6-b4a3-4d02-916e-8d6c6f9e7fc6",
                        "source_entry_id": "16b08a04-b933-38b1-81a7-6c5a7069446f",
                        "source_sense_id": "de14fcb8-1e7f-3392-8e18-43188ace4d19",
                        "target_lang_word": "unsanitary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unsanitary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b92a6c9-96e5-3b5c-b314-7f5bb0b47421",
                                        "entry_id": "b7f850f2-f3a3-3b65-be09-e4059afe00df",
                                        "glosses": [
                                            "Not sanitary; unhealthy; dirty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb0977c8-debe-45f3-b42b-e09fbd893635",
                                                "sense_id": "9b92a6c9-96e5-3b5c-b314-7f5bb0b47421",
                                                "text": "A. The exterior of the premises and all structures thereon shall be kept free of all nuisances, unsanitary conditions and fire or safety hazards in the public areas and any of the foregoing shall be removed and abated promptly by the owner or manager.\nB. Without limiting the generality of Subsection A, the maintenance includes: . . . (3) Keeping the premises free of conditions conducive to infestation by vermin or insects, such as rodent harborages or stagnant water, and other known sources of infestation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b316079e-a754-4ad7-b5f0-fb7d66925c05",
                        "source_entry_id": "16b08a04-b933-38b1-81a7-6c5a7069446f",
                        "source_sense_id": "de14fcb8-1e7f-3392-8e18-43188ace4d19",
                        "target_lang_word": "insanitary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insanitary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1649ecd0-c3a0-3779-ba99-5dfe2defb742",
                                        "entry_id": "bb2c0e05-8a46-3053-959c-abfc1d02f191",
                                        "glosses": [
                                            "Of or pertaining to a lack of sanitation; unsanitary, dirty, unhealthy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a66a821f-aa00-463d-9d90-e656a40175a2",
                                                "sense_id": "1649ecd0-c3a0-3779-ba99-5dfe2defb742",
                                                "text": "The important duty of getting rid of uninhabitable houses or insanitary property devolves on the sanitary authority, and requires to be carried out with discrimination."
                                            },
                                            {
                                                "example_id": "95ab27a8-09c9-43ff-8bab-144c338c96d7",
                                                "sense_id": "1649ecd0-c3a0-3779-ba99-5dfe2defb742",
                                                "text": "The insanitary house displayed poor heating and plumbing, arsenical wallpaper and, in the basement area at the front of the house, 'a large wooden dustbin, placed as is frequently the case, where its malodorous and often dangerous contents must be a constant nuisance on the premises'."
                                            },
                                            {
                                                "example_id": "991837ff-3ef1-4260-8362-4f168d1d086f",
                                                "sense_id": "1649ecd0-c3a0-3779-ba99-5dfe2defb742",
                                                "text": "Within the minority of nuisance fines for which the ward was recorded, however, there was a striking degree of symmetry across the wards, a difference of only eighteen between the ward with the most insanitary nuisances, Monk Ward, and that with the fewest, Micklegate Ward."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e915a41b-e7e2-4469-9320-ed3e9e03a8ee",
                        "source_entry_id": "16b08a04-b933-38b1-81a7-6c5a7069446f",
                        "source_sense_id": "de14fcb8-1e7f-3392-8e18-43188ace4d19",
                        "target_lang_word": "unhygienisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unhygienisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1d4975c9-dbd3-33db-b8b4-be8709fe354b",
                                        "entry_id": "69ca81ed-acda-39ee-8b95-862410dfc8dd",
                                        "glosses": [
                                            "nicht hygienisch, unsauber, dreckig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "110777d1-4247-4f45-ac41-a7cc8e4f3c46",
                                                "sense_id": "1d4975c9-dbd3-33db-b8b4-be8709fe354b",
                                                "text": "Die Reinigungsfachkraft reinigt den unhygienischen Fußboden, damit er wieder sauber ist."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4bf5cc89-1052-4c6d-9f96-3650af9e909e",
                        "source_entry_id": "16b08a04-b933-38b1-81a7-6c5a7069446f",
                        "source_sense_id": "de14fcb8-1e7f-3392-8e18-43188ace4d19",
                        "target_lang_word": "антисанитарный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "антисанитарный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9c650e21-abdb-3a22-95e1-bf36374beffa",
                                        "entry_id": "5e7306d0-7876-3a85-98ca-c8ab14e38814",
                                        "glosses": [
                                            "не соответствующий санитарным нормам, требованиям санитарии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcc4cb54-a1c5-47dd-abaa-cf8538f861e2",
                                                "sense_id": "9c650e21-abdb-3a22-95e1-bf36374beffa",
                                                "text": "Трудно рассчитывать на получение высокой производительности, если животные находятся в антисанитарных условиях, если в хозяйстве пренебрегают элементарными правилами зоогигиены."
                                            },
                                            {
                                                "example_id": "a8d68873-9ef8-45fe-8f9b-ba604d8f4083",
                                                "sense_id": "9c650e21-abdb-3a22-95e1-bf36374beffa",
                                                "text": "При антисанитарном содержании птиц у них часто наблюдается воспаление и опухание лапок."
                                            },
                                            {
                                                "example_id": "a5b6fcc0-1107-4a37-86a1-7dc41b90d7dd",
                                                "sense_id": "9c650e21-abdb-3a22-95e1-bf36374beffa",
                                                "text": "В любой поликлинике и больнице дверь туалета тоже нараспашку, но там другая беда: из-за бедности их клозеты пребывают в откровенно антисанитарном состоянии."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
