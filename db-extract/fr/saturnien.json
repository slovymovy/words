            {
                "entry_id": "07cbc2f8-45ea-3800-8377-0db03493ce89",
                "word": "Saturnien",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6ba25843-c61e-420d-9dc2-eeada6d54829",
                        "entry_id": "07cbc2f8-45ea-3800-8377-0db03493ce89",
                        "tags": [
                            "plural"
                        ],
