                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f0ec1d9e-eef8-3d2c-bafb-15772a728231",
                                        "entry_id": "d6a28b31-5984-35ae-85c7-0b7d92c89f64",
                                        "glosses": [
                                            "met een halve toon verlaagde toon \\\"e\\"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9dbf310-c5f2-4fc7-afc7-9a8c909ac999",
                                                "sense_id": "f0ec1d9e-eef8-3d2c-bafb-15772a728231",
                                                "text": "De toon “es” klinkt in de getempereerde stemming gelijk aan de tonen “dis” en “fes”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee0cc85a-ed14-3035-92ea-0fcc19106f3e",
                                        "entry_id": "d6a28b31-5984-35ae-85c7-0b7d92c89f64",
                                        "glosses": [
                                            "de grondtoon (tonica) van de “es-mineurtoonladder”, tevens een korte aanduiding van die toonladder"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ef3b474-5eae-4fc0-9b9a-95aceb866dec",
                                                "sense_id": "ee0cc85a-ed14-3035-92ea-0fcc19106f3e",
                                                "text": "Op de notenbalk van een etude in es, staan zes mollen als voortekens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cde14aee-2f24-3191-adf2-adf993fde345",
                                        "entry_id": "d6a28b31-5984-35ae-85c7-0b7d92c89f64",
                                        "glosses": [
                                            "de grondtoon van het “es-mineurakkoord”, de kleine drieklank op de eerste trap (tonica-akkoord) van de kleinetertstoonladder op die toon"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d024f37f-da39-4253-a44d-89c4a4e0e628",
                                                "sense_id": "cde14aee-2f24-3191-adf2-adf993fde345",
                                                "text": "De drie tonen van het es-mineurakkoord (symbool: E♭m) in grondligging, zijn: es - ges - bes."
                                            }
                                        ]
