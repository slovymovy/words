                                        "glosses": [
                                            "Saucisse plate, faite de viande de porc hachée et qu’on enveloppe de crépine."
                                        ],
                                        "tags": [
                                            "Charcuterie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fff09ab3-b339-4a60-b080-5d80b0e2a0cb",
                                                "sense_id": "c01af940-1602-3a16-97fe-dfc2b52866e8",
                                                "text": "La crème exquise de Marly, les beaux abricots et les prunes de Luciennes, les crépinettes et les saucisses de Nanterre."
                                            },
                                            {
                                                "example_id": "daa82063-de45-4c05-a297-09ece1ecd6cc",
                                                "sense_id": "c01af940-1602-3a16-97fe-dfc2b52866e8",
                                                "text": "Les garçons enlevaient les assiettes à potage, des crépinettes de lapereaux aux truffes et des niokys au parmesan circulaient."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53012785-f086-4119-a0b0-770c383750eb",
                        "source_entry_id": "3877a9f5-6da8-3f4c-82be-b747c7228937",
