                ],
                "senses": [
                    {
                        "sense_id": "a98363f6-05f6-31f2-babf-d1a4352bc722",
                        "entry_id": "69f85f83-4f78-314f-b4c8-8f6d3ac7e1b0",
                        "glosses": [
                            "Catéchiser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1aee4d34-be65-4bac-ba14-a2933fad8292",
                                "sense_id": "a98363f6-05f6-31f2-babf-d1a4352bc722",
                                "text": "Il me dit que John avait consenti à se faire catholique, ajoutant qu’il fallait envoyer chercher, dès le lendemain, un prêtre pour le catéchismer."
                            },
                            {
                                "example_id": "f28db17d-546f-4cb9-b978-3aa84f51d870",
                                "sense_id": "a98363f6-05f6-31f2-babf-d1a4352bc722",
                                "text": "J’ai eu beau la catéchismer, lui dire d’attendre une heure parce que je pensais toujours que monsieur allait sonner."
                            }
                        ]
                    },
                    {
                        "sense_id": "4064a336-163a-389c-b2ae-c44f6504c07f",
                        "entry_id": "69f85f83-4f78-314f-b4c8-8f6d3ac7e1b0",
                        "glosses": [
                            "Réciter le catéchisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57551404-70aa-426b-804c-c7b6116826de",
                                "sense_id": "4064a336-163a-389c-b2ae-c44f6504c07f",
                                "text": "Allons, mon petit neveu, puisque j’ai été choisi aujourd’hui de la part de Dieu comme votre curateur, il faut que j’aie soin de vous faire apprendre à lire, à écrire et à catéchismer sur les articles de la foi, pour vous préparer à être vrai serviteur de Dieu dans ce monde, et dans le Ciel nous aurons de lui sa récompense."
                            }
                        ]
                    }
                ],
