                                        "sense_id": "c8d3f33b-a6c5-36a0-a30e-4e6959f511f6",
                                        "entry_id": "ac5e5fdc-7266-3a09-a935-683e171f1340",
                                        "glosses": [
                                            "The act of freeing from obscurities; disambiguation."
