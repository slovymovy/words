                                        "sense_id": "6ca2107f-de4f-33dd-b911-ebf7c7187dd7",
                                        "entry_id": "09b3e0d6-8d7b-3d66-8a23-c4dffc99def5",
                                        "glosses": [
                                            "Causing serious injuries, damage, or harm; damaging."
