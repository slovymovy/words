                            {
                                "example_id": "5105a5af-8622-49bb-add2-a5cb20993417",
                                "sense_id": "e1f92488-9fc9-3f57-82f7-1cb523760e4e",
                                "text": "Les plus grandes difficultés que l’algèbre présente dans la composition, viennent des fractions sur fractions, qui exigent un parangonage avec le texte de l’ouvrage où se rencontre l’algèbre."
                            },
                            {
                                "example_id": "320da14c-fcb0-4aeb-a3a2-b67fca3325fd",
                                "sense_id": "e1f92488-9fc9-3f57-82f7-1cb523760e4e",
                                "text": "L’atelier dont tous les caractères ont une identité précise à cet égard, a, je le répète, le double de valeur d’un autre où le moindre rapport de caractère à caractère ne peut se faire qu’à l’aide du parangonage, avec des lames de plomb, de carte ou de papier."
                            }
                        ]
                    },
                    {
                        "sense_id": "582106a1-73be-3791-ae70-13d4310bee57",
                        "entry_id": "55f2b854-37f8-361e-b491-1433a192c770",
