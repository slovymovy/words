                "senses": [
                    {
                        "sense_id": "917d2038-2fc5-337b-bb93-212c4035aad0",
                        "entry_id": "1812396d-98bb-3464-8b72-a26abe96312e",
                        "glosses": [
                            "von Streitkräften verwendete Flagge"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "9f74675a-d899-4f30-8c60-79eebd83f455",
                                "sense_id": "917d2038-2fc5-337b-bb93-212c4035aad0",
                                "text": "Die Kaiserliche Kriegsflagge war bis 1892 die offizielle Kriegsflagge der Kaiserlichen Marine, danach wurde sie unter der Bezeichnung Reichskriegsflagge die Flagge der Streitkräfte des Deutschen Reiches bis 1921."
                            },
                            {
                                "example_id": "db3604ee-b818-4578-92b2-05e7b9357559",
                                "sense_id": "917d2038-2fc5-337b-bb93-212c4035aad0",
                                "text": "„Die Flaggen waren auf Halbmast gesetzt (die schwarz-rot-goldene Reichs- und die schwarz-weiß-rote Reichskriegsflagge, die in der Ecke eine schwarz-rot-goldene Gösch enthielt).“"
                            },
                            {
                                "example_id": "615701af-2f8b-4c30-87d5-37002bf05501",
                                "sense_id": "917d2038-2fc5-337b-bb93-212c4035aad0",
                                "text": "„Am 21. August 1942 hißten deutsche Gebirgsjäger auf dem sturmumbrausten und schneebedeckten Gipfel des 5633 Meter hohen Elbrus sogar die Reichskriegsflagge.“"
                            },
                            {
                                "example_id": "f81ca84e-1cd9-4453-bfe7-3ac3c01207da",
                                "sense_id": "917d2038-2fc5-337b-bb93-212c4035aad0",
                                "text": "„Nach der Verhaftung der letzten Reichsregierung an dem sonnigen Morgen des 23. Mai 1945 wurde in der Marineschule Mürwik die Reichskriegsflagge für immer eingeholt.“"
                            },
                            {
                                "example_id": "d95d694e-8aa6-4bcb-9834-aefd4de26876",
                                "sense_id": "917d2038-2fc5-337b-bb93-212c4035aad0",
                                "text": "Die von 1935 bis 1945 verwendete Reichskriegsflagge des „Dritten Reiches“ ist heute verboten."
                            },
                            {
                                "example_id": "805c2de3-a78d-4a80-a346-890ced9b8850",
                                "sense_id": "917d2038-2fc5-337b-bb93-212c4035aad0",
                                "text": "„Auf seinem Dach wehte seit Stunden die Reichskriegsflagge mit dem Hakenkreuz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
