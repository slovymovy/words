    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "25f45122-32b4-3d28-81f8-b19454e0c853",
                "word": "battleground",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6dd07ae9-b611-42d8-8a88-ebac90733ec4",
                        "entry_id": "25f45122-32b4-3d28-81f8-b19454e0c853",
                        "tags": [
                            "plural"
                        ],
                        "form": "battlegrounds"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "85ba9c96-9222-3761-8d6a-bfad1b8eb42b",
                        "entry_id": "25f45122-32b4-3d28-81f8-b19454e0c853",
                        "glosses": [
                            "A location where a battle may be fought, or has been fought."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24d15acd-e11c-45b8-9259-27fc2e8a7b04",
                                "sense_id": "85ba9c96-9222-3761-8d6a-bfad1b8eb42b",
                                "text": "The farmer's field was a civil war battleground, and relics such a minnie bullets were frequently found while plowing."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8ccfcfb-5eba-3ee3-8494-9fcee6361e6a",
                        "entry_id": "25f45122-32b4-3d28-81f8-b19454e0c853",
                        "glosses": [
                            "Any place or situation of dispute or contention."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "c5968825-2010-4895-b6bd-979594d55107",
                                "sense_id": "c8ccfcfb-5eba-3ee3-8494-9fcee6361e6a",
                                "text": "And now the two of them are lost in a screaming battleground"
                            }
                        ]
                    },
                    {
                        "sense_id": "4efeeb40-09f4-3a89-a8af-a0ac6b015240",
                        "entry_id": "25f45122-32b4-3d28-81f8-b19454e0c853",
                        "glosses": [
                            "Any subject of dispute or contention."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "2aa23103-5b3b-405d-9f2d-d747b39ba1c8",
                                "sense_id": "4efeeb40-09f4-3a89-a8af-a0ac6b015240",
                                "text": "Abortion was becoming the season's big political battleground."
                            }
                        ]
                    },
                    {
                        "sense_id": "c1f69615-2182-3e82-9179-8a898311732a",
                        "entry_id": "25f45122-32b4-3d28-81f8-b19454e0c853",
                        "glosses": [
                            "Ellipsis of battleground state."
                        ],
                        "tags": [
                            "US",
                            "abbreviation",
                            "alt-of",
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "5cb1bbcd-e2de-444e-94b9-70829741ff31",
                                "sense_id": "c1f69615-2182-3e82-9179-8a898311732a",
                                "text": "Mr. Biden, the former vice president, is ahead of Mr. Trump in the Northern battlegrounds of Wisconsin and Pennsylvania, as well as in the Sun Belt states of Florida and Arizona, according to a poll of likely voters conducted by The New York Times and Siena College."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "326a959e-7565-4cb5-bdf8-a1befbe794b6",
                        "source_entry_id": "25f45122-32b4-3d28-81f8-b19454e0c853",
                        "source_sense_description": "subject of dispute",
                        "target_lang_word": "champ de bataille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "champ de bataille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0f7ee195-78a3-3d0d-ab47-642875f7eef3",
                                        "entry_id": "621fcd70-0523-3d49-aa1b-b13b1e04fb92",
                                        "glosses": [
                                            "Lieu d’un combat militaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24d3b1fb-1761-47cb-9e70-32634c2d15a2",
                                                "sense_id": "0f7ee195-78a3-3d0d-ab47-642875f7eef3",
                                                "text": "[…], pour son coup d’essai, il avait fait une telle déconfiture de vilains, que Jean de Luxembourg l’avait nommé chevalier sur le champ de bataille."
                                            },
                                            {
                                                "example_id": "27c857a6-7895-4a8b-a47b-3e332e1f1945",
                                                "sense_id": "0f7ee195-78a3-3d0d-ab47-642875f7eef3",
                                                "text": "[…]; et les premiers cavaliers revenant du champ de bataille racontaient les résultats de la journée. La souga n'avait pas réussi : pour faire bonne figure, on avait razzié deux ou trois douars et coupé autant de têtes ; […]."
                                            },
                                            {
                                                "example_id": "8d2af424-7090-4321-a01c-9a5e5dd351f4",
                                                "sense_id": "0f7ee195-78a3-3d0d-ab47-642875f7eef3",
                                                "text": "[…] ; la guerre avait rendu un jugement irréformable dont les considérants, comme dit Proudhon, avaient été datés de Valmy, de Jemmapes et de cinquante autres champs de bataille, […]."
                                            },
                                            {
                                                "example_id": "cd9692a9-9601-4e33-82e7-23fed4a73e47",
                                                "sense_id": "0f7ee195-78a3-3d0d-ab47-642875f7eef3",
                                                "text": "Décoré trois fois sur le champ de bataille. L’Argonne... Château-Thierry... la Somme... trépané... quatorze mois d’hôpital du côté de Paris […]."
                                            },
                                            {
                                                "example_id": "3ac60df6-1eba-4ad9-ac7b-57c5beab2d29",
                                                "sense_id": "0f7ee195-78a3-3d0d-ab47-642875f7eef3",
                                                "text": "Ce dernier avait décidé de choisir comme champ de bataille le lit asséché de la rivière Minato, mais Kusunoki Masashigé, consulté, aurait été d’avis de ne pas rompre le fer à cet endroit, […]."
                                            },
                                            {
                                                "example_id": "02ab02ed-5cbf-41db-9411-5e3d815391e2",
                                                "sense_id": "0f7ee195-78a3-3d0d-ab47-642875f7eef3",
                                                "text": "Au bout de plusieurs jours de marche, elle avait repéré un ensemble de constructions basses, non loin des champs de bataille : l'hôpital de campagne."
                                            },
                                            {
                                                "example_id": "ea3e95d5-bbc1-4b47-83ec-904bc2e85903",
                                                "sense_id": "0f7ee195-78a3-3d0d-ab47-642875f7eef3",
                                                "text": "Les champs de bataille ont toujours été des terreaux fertiles pour la naissance des nations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3628195c-0d96-3b7b-8c66-4092627b243e",
                                        "entry_id": "621fcd70-0523-3d49-aa1b-b13b1e04fb92",
                                        "glosses": [
                                            "Lieu d’un débat, d’une dispute, d’un conflit."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8d05a7e-d9f5-47a0-b0a4-52b01a31f778",
                                                "sense_id": "3628195c-0d96-3b7b-8c66-4092627b243e",
                                                "text": "Les réseaux sociaux ont été le champ de bataille d'une guerre de désinformation massive, de manipulations en tous genres et de diffamations, en dépit des garde-fous installés par les autorités comme les médias."
                                            },
                                            {
                                                "example_id": "d4511256-d78e-4abb-8328-917f8ee3adb4",
                                                "sense_id": "3628195c-0d96-3b7b-8c66-4092627b243e",
                                                "text": "Les zones à faibles émissions sont également devenues un champ de bataille politique dans certains États membres, où la « liberté personnelle » est confrontée au « bien commun »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87245348-35e4-328b-bb95-865637ab7af1",
                                        "entry_id": "621fcd70-0523-3d49-aa1b-b13b1e04fb92",
                                        "glosses": [
                                            "Lieu d’une entreprise."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "344b2722-0e8b-4781-a9ab-29da00bfac2c",
                                                "sense_id": "87245348-35e4-328b-bb95-865637ab7af1",
                                                "text": "Il n’a pas mal choisi son champ de bataille."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c8e4da5-c290-40ff-9cff-b7906a747f11",
