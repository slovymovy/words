                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6d091437-d597-468d-8815-8ab877363b4b",
                        "entry_id": "03c2f602-9b7a-3a4e-82c8-7d8ab577bd4a",
                        "tags": [
                            "masculine"
                        ],
                        "form": "Henri"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "97b647cc-c6a1-3805-bde1-e998dd981ffc",
                        "entry_id": "03c2f602-9b7a-3a4e-82c8-7d8ab577bd4a",
                        "glosses": [
                            "Prénom féminin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caf79a87-a4be-4ee6-8d6d-4d3495595d23",
                                "sense_id": "97b647cc-c6a1-3805-bde1-e998dd981ffc",
                                "text": "En apprenant que les Signol possédaient pour quelque dix ou douze mille francs de vignes et une petite maison assez logeable, le Parisien se hâta de mettre Henriette dans l’impossibilité d’être la femme d’un autre."
                            },
                            {
                                "example_id": "8bf9cb6d-b064-4566-bbee-af517bdef25e",
                                "sense_id": "97b647cc-c6a1-3805-bde1-e998dd981ffc",
                                "text": "Après trois mois, je commençais à ne plus me contenter de la part qui m’était faite, et je caressais doucement la main d’Henriette en essayant de transborder ainsi les riches voluptés qui m’embrasaient."
                            },
                            {
                                "example_id": "4bd53f85-ccbe-44d3-ad83-2c124a94d7a0",
                                "sense_id": "97b647cc-c6a1-3805-bde1-e998dd981ffc",
                                "text": "Vendredi 29 juillet, Henriette Jean, née Cahut, a fêté ses 95 ans."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ca88252-91c0-46b3-b990-99a95f64f049",
                        "source_entry_id": "03c2f602-9b7a-3a4e-82c8-7d8ab577bd4a",
