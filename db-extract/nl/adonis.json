                                                "sense_id": "88576ed5-8f9a-3293-bbc4-18544c1e058a",
                                                "text": "Our Dandees (or boatmen) boyled their rice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "711ed7a5-55a9-3646-8e20-982ed35f9896",
                                        "entry_id": "11361401-9ec1-322c-b617-ca3434cee1c1",
                                        "glosses": [
