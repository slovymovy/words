                    {
                        "translation_id": "a76af7f4-58e3-4a77-9120-81e03488b55d",
                        "source_entry_id": "369aa553-323e-3d5b-9e84-08a11a6429a7",
                        "source_sense_id": "a2b307e4-7bdf-3998-a9af-14e8ac0aa066",
                        "source_sense_description": "territory ruled by a governor",
                        "target_lang_word": "gouvernorat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gouvernorat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0c20958a-13f1-3b61-9150-f3d0f07cfee9",
                                        "entry_id": "b55cb667-03a6-37de-912a-9318d0761a19",
                                        "glosses": [
                                            "Région dans laquelle s’exerce l’autorité d’un gouverneur, notamment dans certains pays arabes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de2de963-a1c7-44f3-a7e1-cfe352324018",
                                                "sense_id": "0c20958a-13f1-3b61-9150-f3d0f07cfee9",
                                                "text": "Le gouvernorat comptant moins de 90 000 habitants, élit un sénateur, à moins que la loi électorale ne le rattache à un autre gouvernorat."
                                            },
                                            {
                                                "example_id": "e13f190a-e763-43dc-a9b4-8c3977f22ebf",
                                                "sense_id": "0c20958a-13f1-3b61-9150-f3d0f07cfee9",
                                                "text": "Dans le même contexte, le ministre égyptien de l’Agriculture El-Sayed El-Qosseir, a examiné vendredi avec le gouverneur du Sud-Sinaï, Khaled Fouda, les moyens de promouvoir le développement agricole, la richesse animale, avicole et piscicole ainsi que les services vétérinaires dans le gouvernorat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4d0fbe7-5666-39e1-a581-10384cf41b3e",
                                        "entry_id": "b55cb667-03a6-37de-912a-9318d0761a19",
                                        "glosses": [
                                            "Mandat, charge, fonction d’un gouverneur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "723a5ead-c4c9-4bc0-bb8b-c887a529a809",
                                                "sense_id": "f4d0fbe7-5666-39e1-a581-10384cf41b3e",
                                                "text": "Dans la décade qui suit, la colonisation atteint son apogée sous le gouvernorat de Louis Tirman (1881-1891)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2747d099-2984-4890-ad17-ec6c1d527d5d",
                        "source_entry_id": "369aa553-323e-3d5b-9e84-08a11a6429a7",
                        "source_sense_id": "a2b307e4-7bdf-3998-a9af-14e8ac0aa066",
                        "source_sense_description": "territory ruled by a governor",
                        "target_lang_word": "Gouvernement",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gouvernement",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bae18a73-653a-326e-ab2e-505ac8dc6464",
                                        "entry_id": "d84b7dfc-adc4-3b53-bedd-8c8ef41c527d",
                                        "glosses": [
                                            "die Regierung von Gebieten in Übersee"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26c9e9be-343f-4274-bf5e-b6b26f8b5843",
                                                "sense_id": "bae18a73-653a-326e-ab2e-505ac8dc6464",
                                                "text": "Das Gouvernement hat im Auftrag vom Mutterland neue Gesetze durchgeführt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bba95493-2336-3a29-978c-7dc44833eaf3",
                                        "entry_id": "d84b7dfc-adc4-3b53-bedd-8c8ef41c527d",
                                        "glosses": [
                                            "Provinzverwaltung, die Verwaltung einer Provinz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "219cd318-b077-4d0f-8db8-90df8f7814a4",
                                                "sense_id": "bba95493-2336-3a29-978c-7dc44833eaf3",
                                                "text": "Vom Jahre 1708 bis 1815 hießen die russischen Verwaltungsbezirke Gouvernements."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0de80479-045a-32ec-85ce-cf1f6f057a1f",
                                        "entry_id": "d84b7dfc-adc4-3b53-bedd-8c8ef41c527d",
                                        "glosses": [
                                            "Gebiet, von einem Gouverneur verwaltet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef8315b3-2250-40ee-80f0-a0c93d1a2917",
                                                "sense_id": "0de80479-045a-32ec-85ce-cf1f6f057a1f",
                                                "text": "Palästina besteht aus mehrere Gouvernements, die von einem Gouverneur regiert werden."
                                            },
                                            {
                                                "example_id": "9a792ee0-c4eb-4b1b-b004-fb1400d7d069",
                                                "sense_id": "0de80479-045a-32ec-85ce-cf1f6f057a1f",
                                                "text": "„Der Onkel hatte im ganzen Gouvernement den Ruf eines überaus ehrenhaften und uneigennützigen Sonderlings.“"
                                            },
                                            {
                                                "example_id": "8b7cf4ee-93a0-4d2d-a71b-d5e964cb8dee",
                                                "sense_id": "0de80479-045a-32ec-85ce-cf1f6f057a1f",
                                                "text": "„Je näher ich dem Schillerplatz kam, auf dem sich das Gouvernement der Garnison befand, desto dichter wurde das Gedränge: so ging es sonst nur zu, wenn an Fastnacht der Rosenmontagszug erwartet wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7d481e8-4a8d-4db2-b730-3d3bf9eaf87a",
                        "source_entry_id": "369aa553-323e-3d5b-9e84-08a11a6429a7",
