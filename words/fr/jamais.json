                    "frequency": "Low",
                    "semantic_group_id": "duree_infinie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce tragique événement restera à <w>jamais</w> gravé dans nos mémoires."
                        },
                        {
                            "text": "Ils ont décidé de quitter leur pays natal pour <w>jamais</w>."
                        }
                    ],
                    "common_phrases": [
                        "à jamais",
                        "pour jamais"
                    ]
                }
            ]
        },
        {
