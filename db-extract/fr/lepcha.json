                    {
                        "sense_id": "1a503b48-6b74-32b2-bd8f-3d22edb63965",
                        "entry_id": "25b1dfd4-04b2-344e-9585-768742b63d24",
                        "glosses": [
                            "Relatif aux Lepchas, groupe ethnique vivant au Népal, au Bhoutan et en Inde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e18e136d-6171-4231-b552-4b05565dde40",
                                "sense_id": "1a503b48-6b74-32b2-bd8f-3d22edb63965",
                                "text": "Yongden réunit tous les effets d’Alexandra dans pas moins de vingt-huit caisses. Il est décidé à la suivre partout, pas seulement en tant que simple serviteur. C’est un lama instruit ; en plus de son tibétain maternel, il parle l’anglais, l’hindi, le népalais et le dialecte lepcha."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "64a24119-8b0b-372f-ab0d-d3e282eb5118",
                "word": "lepcha",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "de2cc740-ac06-36ec-ac7d-b31b95cc7e36",
                        "entry_id": "64a24119-8b0b-372f-ab0d-d3e282eb5118",
                        "glosses": [
                            "Langue SOV tibéto-birmane, parlée en Inde, au Népal et au Bhoutan."
