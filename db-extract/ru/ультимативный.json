                                        "sense_id": "da198a0a-bd65-3ce4-aae0-54799f9b00ef",
                                        "entry_id": "3d24ab0e-b0e6-32c2-b6c1-50799149110e",
                                        "glosses": [
                                            "A categorical proposition."
                                        ],
