                "senses": [
                    {
                        "sense_id": "06ec4761-32ea-379c-a4a0-58b97d368ea5",
                        "entry_id": "1477f8ab-d9b2-3a75-b0a2-0212b876af75",
                        "glosses": [
                            "größeres kommunales Wohngebäude (vor allem in Wien)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa090cf1-c9d7-4fa3-aafe-787a86dd214e",
                                "sense_id": "06ec4761-32ea-379c-a4a0-58b97d368ea5",
                                "text": "„Als die Gemeinde Wien die angrenzenden Grundstücke erwarb und hier einen Gemeindebau plante, wurden die bereits bestehenden Bauten teilweise abgerissen und teilweise in den Neubau integriert.“"
                            },
                            {
                                "example_id": "8213c974-8508-4178-a05b-026d1ed57afb",
                                "sense_id": "06ec4761-32ea-379c-a4a0-58b97d368ea5",
                                "text": "„Die Stadt Wien hingegen besitzt heute 220 000 Wohnungen in 1749 Gemeindebauten - ein Viertel aller Wiener Wohnungen.“"
                            },
                            {
                                "example_id": "3201c5f7-74a6-45f0-bf4e-c0e51e164944",
                                "sense_id": "06ec4761-32ea-379c-a4a0-58b97d368ea5",
                                "text": "„Kurz vor achtzehn Uhr stiegen die Rosi und der Pauli vor dem Gemeindebau aus der Linie 37.“"
                            },
                            {
                                "example_id": "623b9898-acd3-4005-b4d9-cd2c9e889f18",
                                "sense_id": "06ec4761-32ea-379c-a4a0-58b97d368ea5",
                                "text": "„Auch Kinderfreibäder in Gemeindebauten sind Geschichte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
