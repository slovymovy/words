                        "examples": [
                            {
                                "example_id": "465359e5-8edb-4c21-baee-4ffde24d3746",
                                "sense_id": "569b4885-6b84-3b89-b93c-1ecc53bd313e",
                                "text": "Mon nouvel appart, y avait pas besoin d’y faire des travaux, j’ai eu juste à poser mes valoches.",
