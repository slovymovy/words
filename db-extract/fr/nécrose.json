            {
                "entry_id": "7c2c1cc5-b483-305d-a4d5-8912f56aa675",
                "word": "nécrose",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ed54fdc9-3f7f-48b7-b31c-523489777fc2",
                        "entry_id": "7c2c1cc5-b483-305d-a4d5-8912f56aa675",
                        "tags": [
                            "plural"
                        ],
                        "form": "nécroses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8b62fe94-1ee3-33fa-8e3f-d0376055a71e",
                        "entry_id": "7c2c1cc5-b483-305d-a4d5-8912f56aa675",
                        "glosses": [
                            "Mortification ; altération, dégénérescence de cellules, de tissus qui aboutit à leur mort."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c5c29c0-1c5c-49c7-9393-f7f2eda383a7",
                                "sense_id": "8b62fe94-1ee3-33fa-8e3f-d0376055a71e",
                                "text": "Une nécrose infectieuse."
                            },
                            {
                                "example_id": "089c2259-2957-4226-9213-b704fe571add",
                                "sense_id": "8b62fe94-1ee3-33fa-8e3f-d0376055a71e",
                                "text": "Dès la porte, une odeur de nécrose prenait à la gorge. Les drains suppuraient, laissaient tomber goutte à goutte le pus fétide."
                            },
                            {
                                "example_id": "6699438a-41a9-48f5-83f4-3ba53070ffe2",
                                "sense_id": "8b62fe94-1ee3-33fa-8e3f-d0376055a71e",
                                "text": "L’éthéphon un analogue de l’éthylène, est utilisé pour l’éclaircissage chimique des fleurs ou des très jeunes fruits. Ce produit peut provoquer la nécrose partielle ou totale de l’inflorescence ou de la très jeune grappe."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de8e78c2-b933-4bd7-806a-60870d386bcd",
                        "source_entry_id": "7c2c1cc5-b483-305d-a4d5-8912f56aa675",
                        "source_sense_id": "8b62fe94-1ee3-33fa-8e3f-d0376055a71e",
                        "target_lang_word": "necrosis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "necrosis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a79e7f8-3e33-386b-8b67-b340a81346d4",
                                        "entry_id": "fe668390-2ad3-359d-8541-b6c621c5e4cc",
                                        "glosses": [
                                            "The localized death of cells or tissues through injury, disease, or the interruption of blood supply."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd4cc441-5d68-449b-855d-36cfe321d254",
                                                "sense_id": "3a79e7f8-3e33-386b-8b67-b340a81346d4",
                                                "text": "Usually gangrene will follow necrosis unless the dead tissue is resected."
                                            },
                                            {
                                                "example_id": "3b202ca2-d1f8-4551-b07b-db0a1656db02",
                                                "sense_id": "3a79e7f8-3e33-386b-8b67-b340a81346d4",
                                                "text": "These included multilobular consolidation with histiological lesions of bronchiolitis with epithelial necrosis and syncytia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28bdd8d0-1547-437d-b54b-8bbc0ca81813",
                        "source_entry_id": "7c2c1cc5-b483-305d-a4d5-8912f56aa675",
