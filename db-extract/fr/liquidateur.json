                "senses": [
                    {
                        "sense_id": "48c07b43-2efc-3541-836b-26b956ea0e21",
                        "entry_id": "1346319d-30ff-306f-a1fa-28b871077689",
                        "glosses": [
                            "Qui est chargée de travailler, de présider à une liquidation de comptes, de créances, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0948fe0d-43b7-4685-a6ce-e6b416a0f0c8",
                                "sense_id": "48c07b43-2efc-3541-836b-26b956ea0e21",
                                "text": "Ce Secrétariat réunit les inspections des services nouvellement créés, les services du personnel et les organes liquidateurs de l’armée de l’Air dissoute."
                            },
                            {
                                "example_id": "0afe285b-8fd4-4304-ac65-c39da4c85622",
                                "sense_id": "48c07b43-2efc-3541-836b-26b956ea0e21",
                                "text": "Enfin, le consulat constitue l’organisme liquidateur de l’ancienne municipalité."
                            }
                        ]
                    },
                    {
                        "sense_id": "33b2bb26-ba76-3049-8952-430fe82d960d",
                        "entry_id": "1346319d-30ff-306f-a1fa-28b871077689",
                        "glosses": [
                            "Qui liquide."
                        ],
                        "tags": [
                            "information à préciser ou à vérifier"
                        ],
                        "examples": [
                            {
                                "example_id": "c5c33fa8-3974-4981-b99e-9dba7fc3c3f8",
                                "sense_id": "33b2bb26-ba76-3049-8952-430fe82d960d",
                                "text": "Le camp majoritaire avait des idées, que nous jugions liquidatrices."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "bf12cc3c-3483-3ddb-98e1-cb12020bfc55",
                "word": "liquidateur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8cd21b1b-36a9-474e-b017-affa0e7f5bd1",
                        "entry_id": "bf12cc3c-3483-3ddb-98e1-cb12020bfc55",
                        "tags": [
