                                "example_id": "7769f587-3f67-47eb-971b-c1826b62d538",
                                "sense_id": "03a3fb63-1052-3885-9f56-be131fb364f6",
                                "text": "Using the still unfamiliar term, she declared that the nation was now entering a new “Carolean age”."
                            },
                            {
                                "example_id": "243fb4ce-7fb8-4979-b86d-01bc789105a0",
                                "sense_id": "03a3fb63-1052-3885-9f56-be131fb364f6",
                                "text": "I have every confidence that in this new Carolean era, the United Kingdom will continue to prosper amid lasting peace and stability under Your Majesty’s leadership."
                            }
                        ]
                    }
