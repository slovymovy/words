                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'hésite pas à me téléphoner si tu souhaites que nous restions en <w>contact</w>."
                        },
                        {
                            "text": "Le directeur a décidé d'entrer en <w>contact</w> avec nos partenaires commerciaux dès demain matin."
                        }
                    ],
                    "synonyms": [
                        "communication",
                        "liaison",
                        "relation"
                    ],
                    "antonyms": [
                        "isolement",
                        "rupture"
                    ],
                    "common_phrases": [
