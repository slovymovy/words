                        "glosses": [
                            "zakje waarin men (gesmeerde en belegde) boterhammen kan bewaren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e2356c4-5c82-4788-959d-228b6ee239af",
                                "sense_id": "9400c5d1-72c4-3b80-8c92-e21ee1a6432a",
                                "text": "Dus leerden we ermee te leven en we lachten erom als hij er niet was, dan paradeerde ik door de kamer met twee appels in een boterhamzakje die ik uit mijn korte broek liet hangen, tot mama foeiiep en me vroeg op te houden."
                            },
                            {
                                "example_id": "50075e23-321d-46ee-9a10-3261a7b8b64e",
                                "sense_id": "9400c5d1-72c4-3b80-8c92-e21ee1a6432a",
                                "text": "Zij bleken in het bezit van een boterhamzak met wiet. De mannen gingen voor verhoor mee naar het bureau, maar kwamen snel weer vrij. De wiet werd in beslag genomen."
                            }
                        ]
                    }
