                "senses": [
                    {
                        "sense_id": "a75c4403-f5bb-3c35-bd4e-e4c10160aa76",
                        "entry_id": "6516b3d5-b862-3546-9ce2-1fb507defcde",
                        "glosses": [
                            "Landkarte mit eingezeichneten Straßen für die Fahrt mit dem Auto"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fecdcdb-9dc3-4231-9fc4-7f7e6e4c0e51",
                                "sense_id": "a75c4403-f5bb-3c35-bd4e-e4c10160aa76",
                                "text": "„Ein Mensch, der, aus Gründen seelischer Hygiene, plötzlich nicht einsehen will, daß eine Autokarte sich nicht mehr in die vorgesehenen Falten legen läßt, sondern nur noch in falsche, verkehrte, der sich nicht damit abfinden mag, eine Autokarte doppelten bis dreifachen Volumens wieder in das Ablagefach zurückzulegen, und der also diesen Kampf aufnimmt, der muß in der Niederlage Größe zeigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
