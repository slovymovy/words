                "senses": [
                    {
                        "sense_id": "7d9bd545-f250-339a-b740-04499ea9d651",
                        "entry_id": "36a9391a-fce3-374f-9f2f-28f0386cc9b1",
                        "glosses": [
                            "Inselgruppe im Atlantik nahe Nordamerika, britisches Überseegebiet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9207f88f-d2d5-4efc-8e31-0f6a270fb365",
                                "sense_id": "7d9bd545-f250-339a-b740-04499ea9d651",
                                "text": "Bermuda wurde 1503 von dem Spanier Juan de Bermúdez entdeckt, der aber wegen der gefährlichen Riffe, die die Insel umgeben, nicht an Land ging."
                            },
                            {
                                "example_id": "986b7385-a2ed-4b62-ad6d-af36533adc7a",
                                "sense_id": "7d9bd545-f250-339a-b740-04499ea9d651",
                                "text": "„Auf den Inseln leben eine Reihe glücklicher Engländer, denn zur Zeit gibt es auf den Bermudas keine Einkommen[- ]und keine Erbschaftssteuer.“"
                            },
                            {
                                "example_id": "7723aed7-eaa7-4e44-92d8-fd0584f0437f",
                                "sense_id": "7d9bd545-f250-339a-b740-04499ea9d651",
                                "text": "Über das Bermuda des 19. Jahrhunderts existieren einige Berichte."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
