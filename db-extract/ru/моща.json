                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0046446a-fb9f-4650-93c6-f1648df9e1cf",
                                "sense_id": "46466af3-656c-3d73-9c0f-e67ac1697bc9",
                                "text": "— Ты, моща из святой обители! Будешь на ребят тыриться — и до парохода не доживешь!"
                            }
                        ]
                    },
                    {
                        "sense_id": "03a74f5e-36da-36a3-a767-739f7e121e95",
