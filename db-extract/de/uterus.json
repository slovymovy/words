                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d3a9335-738b-4f1f-aa2b-69e6660077aa",
                                                "sense_id": "2c8f6134-daa7-355b-b967-511b0f18bdd6",
                                                "text": "Оставаясь без нее, чувствовал себя беспомощным, жаловался, как ребенок: «Матка! обшить, обмыть некому»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87958006-aa81-32d9-9074-b13dc2271583",
                                        "entry_id": "f0e17b74-79b9-3229-8c64-98c4b03bfccc",
                                        "glosses": [
                                            "воен. специальный корабль, предназначенный для обслуживания других судов и кораблей на стоянке"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "61c02242-29b8-3573-b7d6-5d27f7154c90",
                                        "entry_id": "f0e17b74-79b9-3229-8c64-98c4b03bfccc",
                                        "glosses": [
                                            "рег. (сев.-русск., касп., вост.-сиб., камч., курильск., алеутск.) компас, особенно самодельный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19bc67e0-d1a0-4c52-9c64-f8416116d854",
                                                "sense_id": "61c02242-29b8-3573-b7d6-5d27f7154c90",
                                                "text": "Как курица водит цыплят, так маткою управляется судно."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
