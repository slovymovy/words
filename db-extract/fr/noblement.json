        "fr-extract.jsonl": [
            {
                "entry_id": "9241bf0d-16db-350f-91bd-bec3b4806807",
                "word": "noblement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b4b4e835-09cd-33fe-bb8a-a7fcf629174a",
                        "entry_id": "9241bf0d-16db-350f-91bd-bec3b4806807",
                        "glosses": [
                            "D’une manière noble ; avec noblesse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8985476-af51-4507-83e0-1cb71c313e69",
                                "sense_id": "b4b4e835-09cd-33fe-bb8a-a7fcf629174a",
                                "text": "L'Allemagne a donné à la Tchéquie des sciences, des beaux-arts et l'industrie, et la Tchéquie a noblement répondu à ce magnifique cadeau, en produisant le hussitisme, cet immortel précurseur de Martin Luther."
                            },
                            {
                                "example_id": "5664a39e-b708-46da-90dc-4e3ab68b35f6",
                                "sense_id": "b4b4e835-09cd-33fe-bb8a-a7fcf629174a",
                                "text": "Les courtisanes, pour embrasser tout le sexe féminin qu’on baptise, qu’on débaptise et rebaptise à chaque quart de siècle, conservent toutes au fond de leur cœur un florissant désir de recouvrer leur liberté, d’aimer purement, saintement et noblement un être auquel elles sacrifient tout."
                            }
                        ]
                    },
                    {
                        "sense_id": "1452dce2-4395-3b75-b4a8-11b3385377ff",
                        "entry_id": "9241bf0d-16db-350f-91bd-bec3b4806807",
                        "glosses": [
                            "Selon la manière de vivre sur sa terre, ou à la ville, sans exercer aucune profession, ou sans en avoir d’autre que celle des armes."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "974ad261-c324-46bf-a19c-2c0cf5346600",
                                "sense_id": "1452dce2-4395-3b75-b4a8-11b3385377ff",
                                "text": "Ses ancêtres n’ont jamais dérogé, ils ont toujours vécu noblement."
                            }
                        ]
                    },
                    {
                        "sense_id": "49f9f285-ea7a-3375-a7ce-09578fe8416b",
                        "entry_id": "9241bf0d-16db-350f-91bd-bec3b4806807",
                        "glosses": [
                            "Avec aisance, comme un rentier."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "628e85dc-a153-421d-8c93-1ae5bb1e5731",
                                "sense_id": "49f9f285-ea7a-3375-a7ce-09578fe8416b",
                                "text": "Il n’est pas noble, mais il vit noblement."
                            }
                        ]
                    },
                    {
                        "sense_id": "830aed04-71b1-383d-94f5-88757b5162be",
                        "entry_id": "9241bf0d-16db-350f-91bd-bec3b4806807",
                        "glosses": [
                            "En fief, en parlant de mode de tenure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cbf44d4-1713-4abe-97a4-2542eac89cbb",
                                "sense_id": "830aed04-71b1-383d-94f5-88757b5162be",
                                "text": "Tenir noblement une terre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "594ca19a-beed-482a-b687-ccd040fe8df6",
                        "source_entry_id": "9241bf0d-16db-350f-91bd-bec3b4806807",
                        "target_lang_word": "edel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "edel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8a02d556-509f-385c-ac22-2132d85b15cc",
                                        "entry_id": "e1f9f0fe-4631-3201-bf2c-18c4f354f1d3",
                                        "glosses": [
                                            "von hochwertiger Qualität"
                                        ],
                                        "tags": [
                                            "Gegenstand"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79bc9cf8-fdd2-4857-84ba-2a6a797707f5",
                                                "sense_id": "8a02d556-509f-385c-ac22-2132d85b15cc",
                                                "text": "Da haben Sie sich aber ein edles Möbelstück gekauft!"
                                            },
                                            {
                                                "example_id": "9f5c246d-6313-4cec-a5cc-65f5c9771955",
                                                "sense_id": "8a02d556-509f-385c-ac22-2132d85b15cc",
                                                "text": "Oh, was für ein edles Teil! Bist du sicher, dass die Uhr echt ist? Wo hast du sie denn her?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f22a1152-f382-31ad-9269-a8738b72119d",
                                        "entry_id": "e1f9f0fe-4631-3201-bf2c-18c4f354f1d3",
                                        "glosses": [
                                            "von besonderer Einstellung, Leistung, Qualität oder auch Stellung"
                                        ],
                                        "tags": [
                                            "Person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25a64a40-dc6c-4985-ab81-1ed3c0aa82b6",
                                                "sense_id": "f22a1152-f382-31ad-9269-a8738b72119d",
                                                "text": "Unter den Wilden des Landes findet sich manch wahrhaft edler Mensch."
                                            },
                                            {
                                                "example_id": "e6787db1-ef9c-4094-a85f-91214734b528",
                                                "sense_id": "f22a1152-f382-31ad-9269-a8738b72119d",
                                                "text": "Das ist sehr edel von dir, aber du musst mich nicht in Schutz nehmen."
                                            },
                                            {
                                                "example_id": "b6a26710-66e0-47ee-9538-ae701ae92349",
                                                "sense_id": "f22a1152-f382-31ad-9269-a8738b72119d",
                                                "text": "Seine edle Abstammung hat ihn dann auch nicht vor dem Gefängnis bewahrt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "968e2648-4ab0-4790-9431-390e88a6bed6",
                        "source_entry_id": "9241bf0d-16db-350f-91bd-bec3b4806807",
