                    {
                        "translation_id": "76517e54-a584-4c70-981a-25a25cc2abcd",
                        "source_entry_id": "d3f35c97-6744-3336-bdc1-314140bd8f1d",
                        "source_sense_id": "dbbb147d-78d9-3605-9fd3-745f9f2af750",
