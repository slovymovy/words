                        "examples": [
                            {
                                "example_id": "13f1b949-ef78-4a8e-816e-61086de73a43",
                                "sense_id": "03fe8ed8-63da-37eb-bd2a-4d2d9797e816",
                                "text": "„1959 hatten wir die erste Zechenstilllegung mit der Schachtanlage Friedrich Thyssen 4/8 in Duisburg-Hamborn mit über dreieinhalbtausend Bergmännern.“"
                            },
                            {
                                "example_id": "482d63eb-a787-4211-b653-5850852f3312",
                                "sense_id": "03fe8ed8-63da-37eb-bd2a-4d2d9797e816",
                                "text": "„Der vorgeschlagenen Verordnung zufolge soll die Gewährung staatlicher Beihilfen für die Steinkohleförderung an die Bedingung geknüpft werden, dass die Mitgliedstaaten einen Stilllegungsplan vorlegen. Auch dürfen sie keine Betriebsbeihilfen mehr gewähren, sondern nur noch Subventionen zur Abfederung sozialer und ökologischer Folgen einer Zechenstilllegung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
