                ],
                "senses": [
                    {
                        "sense_id": "f4a1296d-9cd3-3483-86b5-53eb0f8905cd",
                        "entry_id": "a1d04e2f-f2c5-35b7-9d1d-5a2df7b3e006",
                        "glosses": [
                            "физ. связанный, соотносящийся по значению с существительным нейтрино"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b4fa1ba-3bee-48a3-8c1e-1817b8daf204",
                                "sense_id": "f4a1296d-9cd3-3483-86b5-53eb0f8905cd",
                                "text": "В свою очередь, почти все процессы, вызываемые нейтринной бомбардировкой, представляют собой тоже слабые взаимодействия."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc3585b7-1bf6-434c-a16f-ad4fc27f0f7a",
                        "source_entry_id": "a1d04e2f-f2c5-35b7-9d1d-5a2df7b3e006",
                        "source_sense_id": "f4a1296d-9cd3-3483-86b5-53eb0f8905cd",
                        "target_lang_word": "neutrino",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neutrino",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "532ce265-0ed5-3ec2-aef8-22aa08a85e51",
                                        "entry_id": "70ef5b7c-d600-3b57-a497-297c16e31ac0",
                                        "glosses": [
                                            "An elementary particle that is classified as a lepton, and has an extremely small but nonzero mass and no electric charge. It interacts with the surroundings only via the weak force or gravitation, making it very difficult to detect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "407202ed-a2c5-46be-8cfc-299a0fbb0f4d",
                                                "sense_id": "532ce265-0ed5-3ec2-aef8-22aa08a85e51",
                                                "text": "But researchers at the CERN lab near Geneva claim they have recorded neutrinos, a type of tiny particle, travelling faster than the barrier of 186,282 miles (299,792 kilometres) per second."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
