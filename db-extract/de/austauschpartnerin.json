                        "entry_id": "455c3cef-94de-3f24-ba00-fb1601461025",
                        "glosses": [
                            "diejenige weibliche Person, von der man während eines Austauschprogramms besucht wird und die man im Gegenzug selbst besucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af3888f7-4a3c-4ed6-851b-05bdc8c31845",
                                "sense_id": "f6b16a1d-96ae-3dd1-933b-680ffbcbaf31",
                                "text": "„In nicht mal ganz einer Woche gaben die 15 deutschen Schülerinnen ihren zwölf englischen Austauschpartnerinnen einen Einblick vom Leben im Schwarzwald.“"
                            },
                            {
                                "example_id": "fa21eeb8-57a2-42af-82a7-a5d47bfc1fa9",
                                "sense_id": "f6b16a1d-96ae-3dd1-933b-680ffbcbaf31",
                                "text": "„Allmählich verstehe ich meine Austauschpartnerin besser. Die Chemie zwischen uns stimmt kaum, aber ihre Traurigkeit und ihre Auflehnung sind sehr verständlich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
