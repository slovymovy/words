                        "examples": [
                            {
                                "example_id": "0555a8de-d5cd-483a-a41b-ad77f14b6dfc",
                                "sense_id": "0c258b3d-47c9-3aad-9453-736000e4375e",
                                "text": "„Täglich fahren moderne Schiffe zur Rainbow-Bridge, der mit einer Spannweite von 82 Metern und einer Höhe von 88 Metern größten natürlichen Felsenbrücke der Welt.“"
                            },
                            {
                                "example_id": "af5ba12d-c270-4c39-83c5-1c58471a9b2d",
                                "sense_id": "0c258b3d-47c9-3aad-9453-736000e4375e",
                                "text": "Ein anderes, aber bis jetzt außerhalb Amerika wenig bekannt gewesenes Naturwunder derselben Art befindet sich 35 deutsche Meilen südwestlich von der so eben beschriebenen Felsenbrücke, im südwestlichen Zipfel des Staates, […].“"
                            }
                        ],
