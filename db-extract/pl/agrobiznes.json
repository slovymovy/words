                    {
                        "sense_id": "3b79dbd2-0097-397f-b47c-67df445648c7",
                        "entry_id": "e2c9c610-29c4-3250-bbdf-79934f7c8013",
                        "glosses": [
                            "lekcja geografii"
                        ],
                        "tags": [
                            "środ.",
