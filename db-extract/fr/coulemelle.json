                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c524ad02-263b-49f6-96cf-4b9a9bd0fbe1",
                        "source_entry_id": "765c3885-69f9-352e-a2ac-d4d55f3a1c54",
                        "source_sense_description": "Macrolepiota procera",
                        "target_lang_word": "Parasol",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Parasol",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fd46bd3d-0cdd-39f8-894c-1a9ce6ede83f",
                                        "entry_id": "22abd548-0781-38c9-afff-a8b39bcf7cf4",
                                        "glosses": [
                                            "Pilz aus der Ordnung der Champignonartigen"
                                        ],
                                        "tags": [
                                            "Mykologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f81786a-bd75-4388-9687-60aaa3199cb6",
                                                "sense_id": "fd46bd3d-0cdd-39f8-894c-1a9ce6ede83f",
                                                "text": "Der Parasol ist eine Pilzsorte."
                                            },
                                            {
                                                "example_id": "9a699ab4-327b-4eb5-8265-885c04c7c736",
                                                "sense_id": "fd46bd3d-0cdd-39f8-894c-1a9ce6ede83f",
                                                "text": "„Sämtliche panierte Parasole, die ich essen musste, waren viel zu schnell lätscherte Ungeheuer, die mehr nach Fett und Semmelbrösel denn nach Pilz schmeckten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Parasol",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4acc2315-c5c8-3010-96c5-9f82d38e8ab5",
                                        "entry_id": "cc7e5d3b-abf2-3bfc-9b1b-cfd738cee2e7",
                                        "glosses": [
                                            "Schirm zum Schutz gegen Sonne; Sonnenschirm"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a218f60-ceb4-4008-8b3d-a621ffb6d304",
                                                "sense_id": "4acc2315-c5c8-3010-96c5-9f82d38e8ab5",
                                                "text": "„Die Königin, kaum daß sie aus der Tür des Gartensaals getreten war, stützte sich müde auf ihren Schirm, ihr geliebtes Parasol von grünem Damast, mit goldener Campagne ringsum eingefaßt, mit silbernen Ringen am Stiel, ein modernes, elegantes Stück.“"
                                            },
                                            {
                                                "example_id": "4824970e-9f13-4fd3-9a2d-051aea979afa",
                                                "sense_id": "4acc2315-c5c8-3010-96c5-9f82d38e8ab5",
                                                "text": "„Er demontiert den fetischartigen Parasol gründlich. Als ob der Schirm von den Zugkräften konfliktreichen Freizeitlebens oder vom Hunger nach Sonne, die sich nicht zeigen will, durchgeschüttelt wurde, stellt Martin Boyce das blosse Gerippe eines Sonnenschirmes in den Raum […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
