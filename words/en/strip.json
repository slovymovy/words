                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "places",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We spent the whole night walking along the <w>Strip</w> in Las Vegas.",
                            "target_lang_translations": {
                                "ru": "Мы всю ночь гуляли по <w>Стрипу</w> в Лас-Вегасе."
                            }
                        },
                        {
                            "text": "Most of the famous casinos are located right on the <w>Strip</w>.",
                            "target_lang_translations": {
                                "ru": "Большинство знаменитых казино расположены прямо на <w>Стрипе</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "the Vegas Strip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Знаменитый участок бульвара Лас-Вегас, известный концентрацией отелей-курортов и казино."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Стрип",
                                "target_lang_sense_clarification": "название главной улицы Лас-Вегаса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "309735bf-fa49-3037-bdcc-ce99a77d547f",
                    "sense_definition": "A short name for the Gaza <w>Strip</w>, a territory on the eastern coast of the Mediterranean Sea.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "places",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "News reports focused on the humanitarian situation in the <w>Strip</w>.",
                            "target_lang_translations": {
                                "ru": "Новости были сосредоточены на гуманитарной ситуации в <w>секторе</w>."
                            }
                        },
                        {
                            "text": "Tensions have remained high along the border of the <w>Strip</w>.",
                            "target_lang_translations": {
                                "ru": "Напряженность вдоль границы <w>сектора</w> остается высокой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "the Gaza Strip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Краткое название сектора Газа, территории на восточном побережье Средиземного моря."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сектор",
                                "target_lang_sense_clarification": "краткое название сектора Газа"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}