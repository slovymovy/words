                ],
                "translations": [
                    {
                        "translation_id": "56538fd2-f9a5-4b2e-a58f-d2f4e5f95dff",
                        "source_entry_id": "f97b51b7-9537-35bf-8e08-c2d8b7899cdb",
                        "source_sense_id": "69ca3a86-56b9-33dd-ac80-1ec29a01130b",
                        "target_lang_word": "Stuhlgang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stuhlgang",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "30250bc4-5ee0-366c-a2bd-2174d2eb95ff",
                                        "entry_id": "32fd7b0b-4b4c-31fc-beee-5971101e97d0",
                                        "glosses": [
                                            "das Ausscheiden von Kot aus dem (menschlichen) Verdauungstrakt beziehungsweise aus dem Darm"
                                        ],
                                        "tags": [
                                            "Physiologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0583014-bfa4-4aa8-9e7f-bfad451fb20f",
                                                "sense_id": "30250bc4-5ee0-366c-a2bd-2174d2eb95ff",
                                                "text": "Wegen der Probleme beim Stuhlgang wurde ihm ein Einlauf verabreicht."
                                            },
                                            {
                                                "example_id": "53a7e81e-3526-4843-8e94-fe55aa2872b4",
                                                "sense_id": "30250bc4-5ee0-366c-a2bd-2174d2eb95ff",
                                                "text": "Zu seltener Stuhlgang kann den Darm schädigen."
                                            },
                                            {
                                                "example_id": "266ab5bb-b10a-494c-9fef-c799de2a294d",
                                                "sense_id": "30250bc4-5ee0-366c-a2bd-2174d2eb95ff",
                                                "text": "„Mit Stuhlgang mußte jeder warten, bis Erika Schwarz von der Arbeit zurückgekehrt sein würde.“"
                                            },
                                            {
                                                "example_id": "45973261-95cb-4208-bccf-f7bbc66d8182",
                                                "sense_id": "30250bc4-5ee0-366c-a2bd-2174d2eb95ff",
                                                "text": "„Ich kannte mal einen, der tagelang keinen Stuhlgang hatte.“"
                                            },
                                            {
                                                "example_id": "dfaea872-fa27-4a1a-844c-c0f8afe7dabf",
                                                "sense_id": "30250bc4-5ee0-366c-a2bd-2174d2eb95ff",
                                                "text": "„Die Analbeutel der Hunde dienen der Sekretabsonderung beim Stuhlgang, wodurch Duftmarken gesetzt werden.“"
                                            },
                                            {
                                                "example_id": "a18a5f8f-e719-4147-97ff-8f9debf8ea8f",
                                                "sense_id": "30250bc4-5ee0-366c-a2bd-2174d2eb95ff",
                                                "text": "„Die ersten vierzehn Tage, die ich dort war, hatte ich keinen Stuhlgang gehabt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d956d795-075f-3aaf-a24e-44938003b1cc",
                                        "entry_id": "32fd7b0b-4b4c-31fc-beee-5971101e97d0",
                                        "glosses": [
                                            "Ausscheidung aus dem (menschlichen) Verdauungstrakt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73cbb98f-e5be-4972-bff2-0421d9842a85",
                                                "sense_id": "d956d795-075f-3aaf-a24e-44938003b1cc",
                                                "text": "Der Arzt bat den Patienten, ihm eine Probe von seinem Stuhlgang zu geben."
                                            },
                                            {
                                                "example_id": "5dbba6e0-2ef2-4402-8eb2-2fe710792958",
                                                "sense_id": "d956d795-075f-3aaf-a24e-44938003b1cc",
                                                "text": "„Auch bei Futterumstellung kann es anfangs zu Durchfällen und/oder hellem, weichem Stuhlgang kommen.“"
                                            },
                                            {
                                                "example_id": "0f1130e6-6765-4d19-9d62-2beb7a887316",
                                                "sense_id": "d956d795-075f-3aaf-a24e-44938003b1cc",
                                                "text": "„Daß mit einer Verstopfung des Leibes verbundene Bauchgrimmen erkennet man daran, daß ein solches Pferd voller Unruhe ist, immer auf die Seite sieht, sich hin und her wendet, nicht fressen will, mit den Füssen stampft, sich in seinen Stand hinwirft, oder entweder gar keinen oder einen sehr harten Stuhlgang hat.“"
                                            },
                                            {
                                                "example_id": "fa96dd9e-9e54-4441-9eca-9b54a1c75ae5",
                                                "sense_id": "d956d795-075f-3aaf-a24e-44938003b1cc",
                                                "text": "„Mich überkam die Befürchtung, ich selbst könne womöglich der Verursacher des Stuhlganges gewesen sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b8a42619-c7d2-3a4d-9407-3b7ec100cf8a",
                                        "entry_id": "32fd7b0b-4b4c-31fc-beee-5971101e97d0",
                                        "glosses": [
                                            "die Krankheit Ruhr"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f86a3f65-bc99-43a9-91d7-f3e28bd52f30",
                        "source_entry_id": "f97b51b7-9537-35bf-8e08-c2d8b7899cdb",
                        "source_sense_id": "69ca3a86-56b9-33dd-ac80-1ec29a01130b",
                        "target_lang_word": "стул",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "стул",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "baa2cef6-0cf0-356c-8c8a-d6d948adf79f",
                                        "entry_id": "7f2728a1-32ff-3984-9193-e55903a673d7",
                                        "glosses": [
                                            "предмет мебели, приспособление для сидения со спинкой, реже без спинки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4ebc04e-e0bb-4dd0-a62b-2a0c7d72ffc1",
                                                "sense_id": "baa2cef6-0cf0-356c-8c8a-d6d948adf79f",
                                                "text": "Хотя она все еще была бледна, на щеках у нее выступили розовые пятна, и теперь девушка сидела, откинувшись на стуле, а не присев на краешек, как раньше."
                                            },
                                            {
                                                "example_id": "d962fcaa-6a84-48d2-af9c-743325fdb797",
                                                "sense_id": "baa2cef6-0cf0-356c-8c8a-d6d948adf79f",
                                                "text": "Вращающиеся столы с давних времен используются гончарами и скульпторами, так же как вращающиеся стулья служат пианистам, а в наши дни еще и операторам, проектировщикам и секретаршам."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3da13856-4836-3f08-80dd-a10ac4ce47c6",
                                        "entry_id": "7f2728a1-32ff-3984-9193-e55903a673d7",
                                        "glosses": [
                                            "спец. подставка под что-либо, какой-либо механизм, инструмент, строение и т. п. (раньше чаще — обрубок бревна, чурбан) (затвердеть или перен. прийти в тупик)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d774005-d013-4e2e-9cf2-f587b77b815f",
                                                "sense_id": "3da13856-4836-3f08-80dd-a10ac4ce47c6",
                                                "text": "Изба на стульях."
                                            },
