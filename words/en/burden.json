                                "target_lang_word": "грузоподъёмность",
                                "target_lang_sense_clarification": "вместимость"
                            },
                            {
                                "target_lang_word": "тоннаж",
                                "target_lang_sense_clarification": "объём"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "吨位",
