                    },
                    {
                        "translation_id": "f6498e1a-7a48-42cc-b499-38a697eacc2c",
                        "source_entry_id": "770d1412-76a4-360f-ac9c-1ce0a174e533",
                        "target_lang_word": "Scheidung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Scheidung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2444bf09-0b34-3942-ae56-665e3ebef769",
                                        "entry_id": "536e3d2b-876e-3a91-bfad-263d7ea2696c",
                                        "glosses": [
                                            "formelle, juristische Auflösung einer Ehe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c0b0dba-f307-449a-92e2-1f78cc8237c3",
                                                "sense_id": "2444bf09-0b34-3942-ae56-665e3ebef769",
                                                "text": "Seit ihrer Scheidung redeten Olaf und Martha nicht mehr viel miteinander."
                                            },
                                            {
                                                "example_id": "341fc9a2-39f5-485d-91cb-3c079e9d0efa",
                                                "sense_id": "2444bf09-0b34-3942-ae56-665e3ebef769",
                                                "text": "„Die Scheidung ist eingereicht; sie wird alsbald ausgesprochen werden.“"
                                            },
                                            {
                                                "example_id": "dfaef78f-ce13-4f1f-8e6b-f0c5388d8c1d",
                                                "sense_id": "2444bf09-0b34-3942-ae56-665e3ebef769",
                                                "text": "„Ich hatte wirklich schon viel zu lange mit der Scheidung gewartet.“"
                                            },
                                            {
                                                "example_id": "d4a0588f-98bf-4910-b52e-e5513f9b9fe3",
                                                "sense_id": "2444bf09-0b34-3942-ae56-665e3ebef769",
                                                "text": "„Eine Frau, die in Scheidung lebt, findet allgemeine Beachtung.“"
                                            },
                                            {
                                                "example_id": "ac01c211-0c28-4374-9be3-415aa5729b85",
                                                "sense_id": "2444bf09-0b34-3942-ae56-665e3ebef769",
                                                "text": "„Die Scheidung war sehr teuer, hat sie mir erzählt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b883430e-436d-3760-90c9-ce8f23962eca",
                                        "entry_id": "536e3d2b-876e-3a91-bfad-263d7ea2696c",
                                        "glosses": [
                                            "Auseinandergehen von Personen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "98c66356-55ba-3af6-932d-b3ee0b6dbd15",
                                        "entry_id": "536e3d2b-876e-3a91-bfad-263d7ea2696c",
                                        "glosses": [
                                            "Schlichten einer Streitigkeit (mit einer Entscheidung)"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2232b75d-7ca2-46f6-a651-f4af3dd2d2cb",
                                                "sense_id": "98c66356-55ba-3af6-932d-b3ee0b6dbd15",
                                                "text": "Wir erwarten die Scheidung des Rates in der Angelegenheit zwischen Meier und Hausmann."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "08615ed5-d127-3c42-abbc-676c69cee3b0",
                                        "entry_id": "536e3d2b-876e-3a91-bfad-263d7ea2696c",
