        "fr-extract.jsonl": [
            {
                "entry_id": "ff0fb15a-a263-3f51-b426-f94b76038ec2",
                "word": "glou",
                "pos": "onomatopoeia",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0622461e-f15c-313e-8f44-af71156f3aae",
                        "entry_id": "ff0fb15a-a263-3f51-b426-f94b76038ec2",
                        "glosses": [
                            "Bruit de l'eau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f692a6e0-6626-4465-9b9f-505b864e1cd3",
                                "sense_id": "0622461e-f15c-313e-8f44-af71156f3aae",
                                "text": "Ah ! comme les parois de glace sont glissantes à mes doigts qui cherchent… Nous tournons encore !… Nous enfonçons… Un dernier effort !… Un dernier cri !… Erik !… Christine !… glou, glou, glou !… dans les oreilles !… glou, glou, glou !… au fond de l’eau noire, nos oreilles font glouglou !…"
                            }
                        ]
                    },
                    {
                        "sense_id": "e5a5ac85-3244-36ff-9f96-f014d8fba888",
                        "entry_id": "ff0fb15a-a263-3f51-b426-f94b76038ec2",
                        "glosses": [
                            "Cri du dindon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc5a37f7-fe7e-4f33-a8d2-b570927761d6",
                                "sense_id": "e5a5ac85-3244-36ff-9f96-f014d8fba888",
                                "text": "Pourquoi ne ris-tu pas avec nous ? dit le dindon. Est-ce que ma question ne te semble pas spirituelle ? Peut-être elle est au-dessus de ton intelligence. Hélas ! quel esprit borné ! Allons, laissons-la, et soyons intéressants pour nous-mêmes seulement. » Là-dessus il fit glou, glou, glou, et les canards firent coin, coin"
                            }
                        ]
                    },
                    {
                        "sense_id": "bf0f55ab-b850-3339-b23e-0d623801e2d9",
                        "entry_id": "ff0fb15a-a263-3f51-b426-f94b76038ec2",
                        "glosses": [
                            "Onomatopée exprimant un gloussement de rire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7a4cd4c-2252-403c-95fb-55304af9ae23",
                                "sense_id": "bf0f55ab-b850-3339-b23e-0d623801e2d9",
                                "text": "Glou ! glou ! riaient les Guyanaises. Glou ! glou !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae1cee3a-c39a-4f50-88cf-80feb3bdf662",
                        "source_entry_id": "ff0fb15a-a263-3f51-b426-f94b76038ec2",
                        "source_sense_description": "bruit du liquide qu'on avale",
                        "target_lang_word": "gulp",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gulp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64068841-fefc-3306-a199-ad7902bba4a7",
                                        "entry_id": "a9e67ec4-ca9e-3930-ad2c-7b0ffae2b76b",
                                        "glosses": [
                                            "The usual amount swallowed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f405cfc-cd5a-492e-82b0-b657f0b152d3",
                                                "sense_id": "64068841-fefc-3306-a199-ad7902bba4a7",
                                                "text": "What the liquor was I do not know, but it was not so strong but that I could swallow it in great gulps and found it less burning than my burning throat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8caaab5-3716-3d10-a0d3-3b438e9fed58",
                                        "entry_id": "a9e67ec4-ca9e-3930-ad2c-7b0ffae2b76b",
                                        "glosses": [
                                            "The sound of swallowing, sometimes indicating fear."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c613f005-786f-4dfb-85da-c52c417e4562",
                                                "sense_id": "d8caaab5-3716-3d10-a0d3-3b438e9fed58",
                                                "text": "Little Stanislovas was also trembling, and all but too frightened to speak. \"They — they sent me to tell you — \" he said, with a gulp."
                                            },
                                            {
                                                "example_id": "d513c17a-eaea-4994-96c0-d35b074d4eb6",
                                                "sense_id": "d8caaab5-3716-3d10-a0d3-3b438e9fed58",
                                                "text": "Indeed, the envisioned future should produce a bit of \"the gulp factor\" […], there should be an almost audible \"gulp\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26202ca9-4557-3a4d-a72a-e293fb99bc9d",
                                        "entry_id": "a9e67ec4-ca9e-3930-ad2c-7b0ffae2b76b",
                                        "glosses": [
                                            "An unspecified small number of bytes, often two."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gulp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0523ae4c-dc59-39e0-9c95-ace55bfa1b5c",
                                        "entry_id": "5a20514b-3a45-3db3-9bc3-3f85071c592e",
                                        "glosses": [
                                            "To swallow eagerly, or in large draughts; to swallow up; to take down in one swallow."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e70f64c1-7299-4e06-b2a6-3307f35c77b4",
                                                "sense_id": "0523ae4c-dc59-39e0-9c95-ace55bfa1b5c",
                                                "text": "He does not swallow, but he gulps it down."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11675e07-3cc3-3bf4-8bca-f5bbb4c6a6cd",
                                        "entry_id": "5a20514b-3a45-3db3-9bc3-3f85071c592e",
                                        "glosses": [
                                            "To react nervously by swallowing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f50f5aa-22c8-4a1a-851c-0276b6be31da",
                                                "sense_id": "11675e07-3cc3-3bf4-8bca-f5bbb4c6a6cd",
                                                "text": "The man eyed Percy with a chilly eye. \"Well,\" he said, \"What's troublin you?\" Percy gulped. The man's mere appearance was a sedative. \"Er-nothing! […]\""
                                            },
                                            {
                                                "example_id": "91fadc4c-d878-411f-9cce-c7d5c2c28e2e",
                                                "sense_id": "11675e07-3cc3-3bf4-8bca-f5bbb4c6a6cd",
                                                "text": "I'd always been nervous-excited; this was nervous-terrified. When I finished puking, I sat down gulping air for a while, trying to pull myself together."
                                            },
                                            {
                                                "example_id": "045a5fe5-5047-480b-a52f-884790e939cb",
                                                "sense_id": "11675e07-3cc3-3bf4-8bca-f5bbb4c6a6cd",
                                                "text": "My heart was beating madly and I was gulping nervous energy."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gulp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55d40674-1859-36ea-b4ff-741e6dbbbccd",
                                        "entry_id": "57825afd-8189-3055-8d6f-7ec2bbc21f08",
                                        "glosses": [
                                            "An indication of (the sound of) an involuntary fear reaction in the form of a swallowing motion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbeaf1d5-d88e-470a-ab67-1c286817f58f",
                                                "sense_id": "55d40674-1859-36ea-b4ff-741e6dbbbccd",
                                                "text": "\"Honey, I know you want to go to their home next week, but there's one thing that keeps happening when we're together that really drives me away from social gatherings in general. (Oh, what is it … gulp.) Well, I'm not sure I can really explain it without offending you. (Gulp, gulp.) Do you really want to talk about it? (Yes.) […]\""
                                            },
                                            {
                                                "example_id": "9762408c-ec66-4149-90ba-ed0f545935b2",
                                                "sense_id": "55d40674-1859-36ea-b4ff-741e6dbbbccd",
                                                "text": "I wonder: if it had not been for GCN, would I now be the one who settles for the semi-closeted, factionalized world that Bay Windows and its ilk define as Shangri-la? Perhaps. What is certain, however, is that you have never jettisoned concern fror anybody for the sake of popularity and (gulp) assimilationist marketability."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0dbca129-4204-456f-843b-5396419bf75a",
                        "source_entry_id": "ff0fb15a-a263-3f51-b426-f94b76038ec2",
                        "source_sense_description": "bruit du liquide qu'on avale",
                        "target_lang_word": "glug",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glug",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "68fc9ab2-a5b9-31b5-8191-2a9f2a9cd0bf",
                                        "entry_id": "fb034e4c-a851-3fae-9742-cfd7560f78c4",
                                        "glosses": [
                                            "The sound made when a significant amount of liquid is poured suddenly out of something, such as a jug or bottle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2eeffdcf-cbab-4389-bc30-08f1f5305a94",
                                                "sense_id": "68fc9ab2-a5b9-31b5-8191-2a9f2a9cd0bf",
                                                "text": "The blood did not come out of him in a glug but in a steady silent gush."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c2c3b8d-0a8b-3306-b98b-c486da409cd4",
                                        "entry_id": "fb034e4c-a851-3fae-9742-cfd7560f78c4",
                                        "glosses": [
                                            "The amount of liquid issued when the \\\"glug\\\" sound is heard."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe9c97f9-a231-4b54-a9b4-c11b5fc8f5dd",
                                                "sense_id": "8c2c3b8d-0a8b-3306-b98b-c486da409cd4",
                                                "text": "Pour a glug of bleach into the toilet."
                                            },
                                            {
                                                "example_id": "08454bdf-0dd6-4917-ba9e-5267d8b943b3",
                                                "sense_id": "8c2c3b8d-0a8b-3306-b98b-c486da409cd4",
                                                "text": "Slowly, Khoklov removed a silver flask from within his suit jacket. He had a long contemplative glug, then shuddered violently."
                                            },
                                            {
                                                "example_id": "a9a3be17-3e83-4f90-a4ec-3a629e0734f6",
                                                "sense_id": "8c2c3b8d-0a8b-3306-b98b-c486da409cd4",
                                                "text": "She turned the taps to start the water running, poured in a generous glug of vanilla bubble bath, then moved into the bedroom, to the desk in the corner where her laptop sat open."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "glug",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0285d007-98d1-3cd0-bcab-9636a959e218",
                                        "entry_id": "bc0ced77-4706-3e37-8806-934ef8ab6223",
                                        "glosses": [
                                            "To flow in noisy bursts."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c69fdba-b7e1-4e95-8eab-6c822e5540e6",
                                                "sense_id": "0285d007-98d1-3cd0-bcab-9636a959e218",
                                                "text": "The water glugged down the sink."
                                            },
                                            {
                                                "example_id": "4f9a17f6-6884-49d9-a608-7ffbaed3b16f",
                                                "sense_id": "0285d007-98d1-3cd0-bcab-9636a959e218",
                                                "text": "We’d squat by the creek waiting for the bottle to glug full through its narrow neck and then together we would walk to the church and throw the water on the fire a quart at a time, not so much in hope of putting it out as to be able to say, if asked, that we tried."
                                            },
                                            {
                                                "example_id": "fae845c5-78eb-4129-a214-c94ff09933c2",
                                                "sense_id": "0285d007-98d1-3cd0-bcab-9636a959e218",
                                                "text": "Spasmodically, Bill clutched the handle of the pump, until the attendant hit the flashing button on his console and the petrol began to glug."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b32a8910-e73b-3730-833a-14f415fb3a3f",
                                        "entry_id": "bc0ced77-4706-3e37-8806-934ef8ab6223",
                                        "glosses": [
                                            "To quickly swallow liquid."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6663dd7f-4ab4-470b-8acb-881cab56f2c0",
                                                "sense_id": "b32a8910-e73b-3730-833a-14f415fb3a3f",
                                                "text": "He had glugged that glass of wine before she got a chance to introduce herself."
                                            },
                                            {
                                                "example_id": "86558b2c-47d3-49fd-83cb-d4742e08da55",
                                                "sense_id": "b32a8910-e73b-3730-833a-14f415fb3a3f",
                                                "text": "There is no sugary \"welcome\" drink to glug. Rather, Honey, an elderly, overweight Lab mix, waddles and wags my way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a2b39cc-ca04-302c-ba0a-47097af899d5",
                                        "entry_id": "bc0ced77-4706-3e37-8806-934ef8ab6223",
                                        "glosses": [
                                            "To pour noisily."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5dfbdadb-e2f7-4ca2-84ef-a69a771a5a3c",
                                                "sense_id": "8a2b39cc-ca04-302c-ba0a-47097af899d5",
                                                "text": "The bottle cap rasped as she unscrewed it and glugged some Bailey's into her mug, the spoon tinkling as she stirred."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "glug",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "42b44809-1872-3367-af04-2e88a7ce8fed",
                                        "entry_id": "d4d5ec62-79fe-389e-b193-661a9c8ada2a",
                                        "glosses": [
                                            "The sound made when a significant amount of liquid is poured out of a jug, bottle, etc., or when such an amount is swallowed by a person."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
