                                "target_senses": [
                                    {
                                        "sense_id": "34eae6b7-2aa3-3206-8603-1778169c93c7",
                                        "entry_id": "ad790588-ab48-310c-87cf-e3a8b2dad837",
                                        "glosses": [
                                            "To become sober; to cause to become sober (usually in terms of alcohol or drugs; sometimes figuratively)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8830708f-3956-44c8-8a6e-13cd0f84c67f",
                                                "sense_id": "34eae6b7-2aa3-3206-8603-1778169c93c7",
                                                "text": "She's in no state to go home by herself, so make sure she doesn't drink anything else, and she'll soon sober up."
                                            },
                                            {
                                                "example_id": "dd182c59-3105-45b6-995e-c1a581395069",
                                                "sense_id": "34eae6b7-2aa3-3206-8603-1778169c93c7",
                                                "text": "A pot of black coffee ought to sober him up."
                                            },
                                            {
                                                "example_id": "a639af4d-7226-4d81-bc99-8026789fa634",
                                                "sense_id": "34eae6b7-2aa3-3206-8603-1778169c93c7",
                                                "text": "When the irrational exuberance finally ended and the central bank took away the punch bowl, the business world belatedly sobered up."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
