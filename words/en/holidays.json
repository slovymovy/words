                    "sense_definition": "Plural of <w>holiday</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "How many public <w>holidays</w> are there in your country?",
                            "target_lang_translations": {
