                        "examples": [
                            {
                                "example_id": "22238e24-49d4-4489-9cc0-63ea46972aee",
                                "sense_id": "5ba75f78-f169-3c6c-8452-004ab1212299",
                                "text": "Genius, Poet: do we know what these words mean? […] Nature’s own sacred voice heard once more athwart the dreary boundless element of hearsaying and canting, of twaddle and poltroonery, in which the bewildered Earth, nigh perishing, has lost its way."
                            },
                            {
                                "example_id": "8135c83d-1188-44e8-bb57-208fd65b58e3",
                                "sense_id": "5ba75f78-f169-3c6c-8452-004ab1212299",
                                "text": "“Your Majesty, your Majesty,” he said, “are you going to tolerate this mutiny, this poltroonery? This is a panic, this is a rout.”"
                            }
                        ]
                    }
