                "senses": [
                    {
                        "sense_id": "2ea6c47c-cfd4-3a27-b67a-e8c609dc9b48",
                        "entry_id": "7f7161a6-b530-3dfd-8cff-a3342cdc3e3a",
                        "glosses": [
                            "dotyczący gdańskiej dzielnicy Wrzeszcz lub w niej położony"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1269faed-7cd9-48e5-83d0-0b0af28e60d1",
                                "sense_id": "2ea6c47c-cfd4-3a27-b67a-e8c609dc9b48",
                                "text": "Wiele zapomnianych lub mniej znanych kryminalnych historii rozegrało się na wrzeszczańskich ulicach i we wrzeszczańskich domach w pierwszej połowie XX wieku"
                            },
                            {
                                "example_id": "5bc041af-b7fd-4aba-a827-30a5fc7832ed",
                                "sense_id": "2ea6c47c-cfd4-3a27-b67a-e8c609dc9b48",
                                "text": "Wielu współczesnych gdańszczan nie do końca kojarzy modny dziś wrzeszczański Garnizon właśnie z Czarnymi Huzarami, dla których wybudowano te koszary w II połowie XIX stulecia."
                            }
                        ],
