                "senses": [
                    {
                        "sense_id": "461b3885-3795-3433-9916-b8f5e4c22e14",
                        "entry_id": "19431e6a-bc20-3aca-b298-efd739f5746e",
                        "glosses": [
                            "Wahrnehmung des Geruchs, der von unfertigem oder fertigem Malz stammt; natürlicher und sich verändernder Eigengeruch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3bb9375-9dff-4902-b515-5122dabf3c8e",
                                "sense_id": "461b3885-3795-3433-9916-b8f5e4c22e14",
                                "text": "„Der typische Malzgeruch von Starkbier steigt zuerst in die Nase, im Mund schmeckt man die Hopfenbittere.“"
                            },
                            {
                                "example_id": "f3ccb655-a8fa-49ed-8389-6ca823b32d64",
                                "sense_id": "461b3885-3795-3433-9916-b8f5e4c22e14",
                                "text": "„Soweit die Kläger als Einwand gegen das Gutachten vorbringen, es gebe auch andere Austrittsöffnungen von Malzgeruch aus der Darre, haben sie nicht dargelegt, welche dies sein sollen.“"
                            },
                            {
                                "example_id": "de9b4ef9-95e6-4c2f-98e3-b7fcd8716374",
                                "sense_id": "461b3885-3795-3433-9916-b8f5e4c22e14",
                                "text": "„Die hängen an ihrer Brauerei und haben sich schon an den Malzgeruch gewöhnt.“"
                            },
                            {
                                "example_id": "3ccb6fe6-8d14-460b-a9c1-a11876179fea",
                                "sense_id": "461b3885-3795-3433-9916-b8f5e4c22e14",
                                "text": "„Die Nase verspürt blumigen Malzgeruch mit Alkoholnote im Hintergrund.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
