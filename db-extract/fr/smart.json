                                                "example_id": "3360d02c-f1e7-436e-8ba1-9d381f278d28",
                                                "sense_id": "598b3533-9f94-3669-953f-d81715f46741",
                                                "text": "a smart pain"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebf6a753-3837-3f49-a884-9742cfa4df47",
                                        "entry_id": "98b45cf8-c716-30ea-8858-9106de5e2297",
                                        "glosses": [
                                            "Intense in feeling; painful. Used usually with the adverb intensifier right."
                                        ],
                                        "tags": [
                                            "Southern-US",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2521b1e-2fbb-4710-8358-3fd9f8e4af89",
                                                "sense_id": "ebf6a753-3837-3f49-a884-9742cfa4df47",
                                                "text": "He raised his voice; it hurt her feelings right smart."
                                            },
                                            {
                                                "example_id": "f37af058-d454-4cee-bb69-72812be26af7",
                                                "sense_id": "ebf6a753-3837-3f49-a884-9742cfa4df47",
                                                "text": "That cast on his leg chaffs him right smart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a793cc0-5600-3178-91cf-1b53ea991f44",
                                        "entry_id": "98b45cf8-c716-30ea-8858-9106de5e2297",
                                        "glosses": [
