                        "examples": [
                            {
                                "example_id": "b6fadb6b-e6e2-4a24-8a99-64e1acdbe218",
                                "sense_id": "4f237088-5b2d-3303-acd3-a74d3e6d8969",
                                "text": "The beachcombings – the wood, the metal, the stones – were more than functional, collected and sorted and arranged as things that were lovely in their own right, artefacts."
                            },
                            {
                                "example_id": "6288774d-0199-4a51-a18f-c4b03578f369",
                                "sense_id": "4f237088-5b2d-3303-acd3-a74d3e6d8969",
                                "text": "I wandered along, sifting through the Thames' beachcombings. In a patch of sand lay a section of soft pink roof tile some two inches square or so, and witha peg hole."
                            }
                        ]
                    }
