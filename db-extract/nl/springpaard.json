                    {
                        "translation_id": "3d8432ee-6bd0-467b-a77a-149840caddbc",
                        "source_entry_id": "a7fec038-19b5-3683-acc5-1e1234ccbf48",
                        "source_sense_id": "9e8b19cc-de0d-34aa-a3ff-a337aea335d9",
                        "target_lang_word": "sauteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sauteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b2bd7e9e-6ad1-3010-b429-378e6185d107",
                                        "entry_id": "87448cd8-51c7-3446-ae37-2cb926858fed",
                                        "glosses": [
                                            "Danseur de corde, dont la profession est de faire des sauts et des tours de force. Artiste de cirque, saltimbanque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26be55ec-5833-45b3-8394-5c5e1253e81e",
                                                "sense_id": "b2bd7e9e-6ad1-3010-b429-378e6185d107",
                                                "text": "Quand ce sauteur, ce voltigeur fait un saut entre deux épées prêtes à le percer, si dans la chaleur du mouvement son corps s'écarte d'un point de la ligne qu'il doit décrire, il devient un objet digne de toute notre curiosité."
                                            },
                                            {
                                                "example_id": "112c131f-a930-47e1-b64b-acece6be0ab9",
                                                "sense_id": "b2bd7e9e-6ad1-3010-b429-378e6185d107",
                                                "text": "Il était danseur, sauteur, acrobate et pantomime. Grimaldi, dansant un jour devant l'ambassadeur turc, fit un tel bond en son honneur, qu'il heurta le lustre suspendu au-dessus de la tête du monarque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97776a57-c3c3-3fc1-815c-023d200daca8",
                                        "entry_id": "87448cd8-51c7-3446-ae37-2cb926858fed",
                                        "glosses": [
                                            "Cheval dressé à exécuter les différents sauts."
                                        ],
                                        "tags": [
                                            "Manège"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a348c8bd-5502-4066-a0ff-4ec6b1b503ac",
                                                "sense_id": "97776a57-c3c3-3fc1-815c-023d200daca8",
                                                "text": "Le cheval de troupe irlandais est léger, agile, bon sauteur, résistant à la fatigue ; ses membres sont secs et nerveux, et il sait s'en servir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7eba4ba4-fcc5-316d-af32-637dcd61eefa",
                                        "entry_id": "87448cd8-51c7-3446-ae37-2cb926858fed",
                                        "glosses": [
                                            "Celui qui fait du saut à ski."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4569474-9f9d-4a41-8730-8336f474fb0b",
                                                "sense_id": "7eba4ba4-fcc5-316d-af32-637dcd61eefa",
                                                "text": "Ces trois sauteurs, rejoints de temps à autre par un ou deux juniors, participent donc essentiellement aux épreuves de Coupe continentale, la deuxième division mondiale du saut à ski."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9211ca90-7517-38f1-8806-0a857020b311",
                                        "entry_id": "87448cd8-51c7-3446-ae37-2cb926858fed",
                                        "glosses": [
                                            "Forniqueur ; homme ayant une forte activité sexuelle."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc975bff-e198-47e8-82f0-57f1d4f94632",
                                                "sense_id": "9211ca90-7517-38f1-8806-0a857020b311",
                                                "text": "Une phrase entre toutes retient l'attention : « Nicolas est un sauteur […]. Il y a les nanas qu'il saute et dont il ne se rappelle même plus le prénom. »"
                                            },
                                            {
                                                "example_id": "9e43d194-ab22-47e8-8613-66162998a9b0",
                                                "sense_id": "9211ca90-7517-38f1-8806-0a857020b311",
                                                "text": "Je ne sais pas à combien de lectures tu en es avec lui, continue Zoé, achevant ainsi de me mettre mal à l'aise, mais je te rappelle qu'il a une sacrée réputation de sauteur de tout ce qui bouge sur le campus..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b1a1f96-36bd-3161-b4a2-02db9de9e185",
                                        "entry_id": "87448cd8-51c7-3446-ae37-2cb926858fed",
                                        "glosses": [
                                            "Personne qui change d’opinion quand son intérêt le lui demande."
                                        ],
                                        "tags": [
                                            "dated",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "877ed3bc-3a28-404b-a170-4e4b17109547",
                                                "sense_id": "9b1a1f96-36bd-3161-b4a2-02db9de9e185",
                                                "text": "Or, que pouvez-vous espérer d'un homme, quel que soit d'ailleurs votre mérite, qui, avant de vous avoir entendu prononcer une seule parole, vous a traité dans un à parte énergique d'intrigant, de cuistre et de sauteur ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e170dda3-40f4-34ca-a3c6-6e45979f9ee3",
                                        "entry_id": "87448cd8-51c7-3446-ae37-2cb926858fed",
                                        "glosses": [
                                            "Personne peu sérieuse, qui manque à ses engagements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5781d4a-02ea-4e33-988c-6ece61e5fd54",
                                                "sense_id": "e170dda3-40f4-34ca-a3c6-6e45979f9ee3",
                                                "text": "Le Marquis.– La croix de Mosquitos ? Comme vous y allez !… Je sais bien que ça rapporte cinquante francs à mon gouvernement, dont dix francs pour moi… Tiens ! ça me fait penser que M. Crapote, mon vice-chancelier, que vous m’avez fait décorer le mois dernier… je ne sais pas trop pourquoi… ne m’a pas encore payé ; c’est un petit sauteur !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sauteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9e57420a-bbd9-37be-97a3-410ec61d39ca",
                                        "entry_id": "54d130a2-3e9a-327f-b696-b32cafb0e4ff",
                                        "glosses": [
                                            "Qui fait des sauts, des bonds."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b222585-b084-424e-9f17-3aec36e3289c",
                                                "sense_id": "9e57420a-bbd9-37be-97a3-410ec61d39ca",
                                                "text": "C'est qu’aujourd’hui est le troisième et dernier jour de ce grand pèlerinage au temple de la Tortue Sauteuse dont nous avons vu le début avant-hier, et alors tout Nagasaki s’amuse."
                                            },
                                            {
                                                "example_id": "1229af00-b322-44ed-8107-557c8951d760",
                                                "sense_id": "9e57420a-bbd9-37be-97a3-410ec61d39ca",
                                                "text": "L’oie sauteuse n’est pas un animal, c’est un jouet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
