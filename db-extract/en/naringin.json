                "senses": [
                    {
                        "sense_id": "f9e9e95f-04ce-3337-8988-dd819af3fb45",
                        "entry_id": "200076c1-24b7-3b1f-a81d-d522f175af30",
                        "glosses": [
                            "The major flavonoid glycoside in grapefruit, giving the fruit its bitter taste, which is metabolized to the flavanone naringenin in humans."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "39dc9d9c-daca-42de-9eb1-f21d7e9ee4a9",
                                "sense_id": "f9e9e95f-04ce-3337-8988-dd819af3fb45",
                                "text": "No interaction occurs between naringin and pectin and, therefore, grapefruit peel extract is not very turbid. The high naringin content of grapefruit peel extract often results in precipitation of naringin crystals in the concentrate."
                            },
                            {
                                "example_id": "4ee1a792-a4e0-42f0-bd03-73b455c820d9",
                                "sense_id": "f9e9e95f-04ce-3337-8988-dd819af3fb45",
                                "text": "UV-C irradiation alters the levels of the flavanone naringin and the polymethoxyflavone tangeretin in the peel of Citrus aurantium fruits and this, in turn, reduces the growth of Penicillium digitatum on irradiated fruits."
                            },
                            {
                                "example_id": "9a9c68bc-6e13-457e-a857-db94a8c4337a",
                                "sense_id": "f9e9e95f-04ce-3337-8988-dd819af3fb45",
                                "text": "Naringin is the main cause of bitterness in some citrus fruits and is converted into naringenin in the body."
                            }
                        ]
                    }
