                "senses": [
                    {
                        "sense_id": "4c156e38-a62c-32be-8299-2c391a00b332",
                        "entry_id": "e6736da2-1c10-3c2d-ba54-445224dd02f6",
                        "glosses": [
                            "öffentliche Dienststelle, Behörde, welche für die Abgabe für die Einfuhr/Ausfuhr von Waren in ein abgegrenztes Gebiet zuständig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b170aeeb-fed7-4b53-97c6-c4d1700c26a6",
                                "sense_id": "4c156e38-a62c-32be-8299-2c391a00b332",
                                "text": "Ich fahre am Mittwoch zum Zollamt."
                            },
                            {
                                "example_id": "b1d74e84-0308-4670-a933-8fc561960611",
                                "sense_id": "4c156e38-a62c-32be-8299-2c391a00b332",
                                "text": "„Die Restbestände der Pesa-Wertstufen wurden bei den jeweiligen Zollämtern vor Ort umgewertet und weiterverwendet.“"
                            },
                            {
                                "example_id": "c3166771-80c8-4058-ad44-b39478092f68",
                                "sense_id": "4c156e38-a62c-32be-8299-2c391a00b332",
                                "text": "„Die sah zwar noch etwas mitgenommen aus, erholte sich aber sichtlich, als Miss Runcible detailliert berichtete, wie unverschämt sie auf dem Zollamt behandelt worden war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
