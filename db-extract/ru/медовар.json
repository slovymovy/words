                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "medebrouwer",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ece6a9eb-304f-3474-8345-2cc30fc37203",
                                        "entry_id": "5a2f1854-5b18-3684-944d-1780959e9bce",
                                        "glosses": [
                                            "iemand die uit honing mede bereidt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2257503a-6f73-44dc-b7d3-7ef42f56bcb7",
                                                "sense_id": "ece6a9eb-304f-3474-8345-2cc30fc37203",
                                                "text": "In Bretagne kun je her en der nog een medebrouwer aantreffen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6409a459-db7e-30ef-8b79-de99565c2a4e",
                                        "entry_id": "5a2f1854-5b18-3684-944d-1780959e9bce",
                                        "glosses": [
                                            "iemand anders die ook (bier) brouwt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9515288-aaed-4947-9d84-631a7e764899",
                                                "sense_id": "6409a459-db7e-30ef-8b79-de99565c2a4e",
                                                "text": "De bijeenkomst waar hij een aantal medebrouwers ontmoette, was erg gezellig."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
