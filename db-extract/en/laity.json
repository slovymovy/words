                ],
                "translations": [
                    {
                        "translation_id": "f1871cb0-cdcf-4cba-b0b1-8e64d658299d",
                        "source_entry_id": "a6a73ca1-23e6-33a4-8388-b5ee1a2e0933",
                        "source_sense_description": "people of a church who are not ordained",
                        "target_lang_word": "laïcat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laïcat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7239f002-bc6f-3b9e-a44b-18b4c88c712b",
                                        "entry_id": "c47aa20b-db49-3354-b84f-a8a27da08df8",
                                        "glosses": [
                                            "Ensemble des fidèles des Églises chrétiennes qui n’appartiennent pas au clergé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1639e66e-952c-4db2-9c74-bbddca70a5b2",
                                                "sense_id": "7239f002-bc6f-3b9e-a44b-18b4c88c712b",
                                                "text": "Le concile Vatican II accomplit un grand pas en avant en enseignant que la caractéristique spécifique du laïcat est la sécularité, à savoir qu’en tant que chrétiens qui vivent la vie du Christ dans le monde, leur rôle est de sanctifier la création en l’engageant à devenir plus chrétienne."
                                            },
                                            {
                                                "example_id": "9cd54fdf-1596-423a-87e1-d95dd86f9b8e",
                                                "sense_id": "7239f002-bc6f-3b9e-a44b-18b4c88c712b",
                                                "text": "Le rôle historique et le volontarisme toujours vif du laïcat expliquent en partie le dynamisme de l’Église de Corée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c1c1450-9b4c-4443-91ca-b278e8dafe4b",
                        "source_entry_id": "a6a73ca1-23e6-33a4-8388-b5ee1a2e0933",
                        "source_sense_description": "people of a church who are not ordained",
                        "target_lang_word": "Laie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Laie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84e8a0c4-dc03-37de-89d4-5eced0e9e885",
                                        "entry_id": "d3bac11a-b081-3cdf-943d-2d276904c974",
                                        "glosses": [
                                            "jemand, der auf einem bestimmten Gebiet keine Fachkenntnisse oder keine abgeschlossene Fachausbildung hat"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "565bea01-de90-40b9-8bc6-8804a4b76f0b",
                                                "sense_id": "84e8a0c4-dc03-37de-89d4-5eced0e9e885",
                                                "text": "„Ziel ist nicht, wie Laien oft denken, die vollkommene Heilung von abnormen sexuellen Verlangen wie der Pädophilie, die in der Medizinersprache als Paraphilie zusammengefasst ist.“"
                                            },
                                            {
                                                "example_id": "35f2b180-f322-4395-9d2c-5562fef9b43a",
                                                "sense_id": "84e8a0c4-dc03-37de-89d4-5eced0e9e885",
                                                "text": "„Zu oft werden die Gefahren beim Bergsteigen von Laien unterschätzt, sagt Ernst Vogt, Leiter der Bergsteigerredaktion beim Bayerischen Rundfunk.“"
                                            },
                                            {
                                                "example_id": "519a343c-787b-46db-ac53-a8e92fab9477",
                                                "sense_id": "84e8a0c4-dc03-37de-89d4-5eced0e9e885",
                                                "text": "Soll ich als Laie meine Meinung dazu sagen?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1c93c843-4929-3892-94fa-6dc5a4afd794",
                                        "entry_id": "d3bac11a-b081-3cdf-943d-2d276904c974",
                                        "glosses": [
                                            "jemand, der nicht Geistlicher ist"
                                        ],
                                        "tags": [
                                            "Kirche"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a3e0027-e28f-4fc9-a73e-6e63221c8fa1",
                                                "sense_id": "1c93c843-4929-3892-94fa-6dc5a4afd794",
                                                "text": "„Doch bald kamen schriftkundige Laien hinzu, und schließlich verlangte der wachsende Geschäftsverkehr vom Bürger selbst die Kunst des Lesens und Schreibens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "81e30ffb-e62b-354a-bfd0-7737aad98f62",
                                        "entry_id": "d3bac11a-b081-3cdf-943d-2d276904c974",
                                        "glosses": [
                                            "eine nicht rechtskundige Person, die in einem Gerichtsverfahren als Entscheidungsorgan auftritt"
                                        ],
                                        "tags": [
                                            "Rechtspflege"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dea1cb9a-2fbc-4b18-b1c4-0ad4d12f6ccb",
                                                "sense_id": "81e30ffb-e62b-354a-bfd0-7737aad98f62",
                                                "text": "„Der § 604 ist jedem Laien verständlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
