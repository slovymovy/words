                "senses": [
                    {
                        "sense_id": "319725b3-1fd1-3ca8-86cf-4d1588ab9bcf",
                        "entry_id": "149e2e85-6c28-3cf0-bc23-2a4633fbbca2",
                        "glosses": [
                            "to crack, to burst, to pop"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "073c307e-db30-4cef-9066-4e78bddebc40",
                                "sense_id": "319725b3-1fd1-3ca8-86cf-4d1588ab9bcf",
                                "text": "тре́снуть от сме́ха",
                                "translation": "to split/burst one's sides (laughing)",
                                "english": "to split/burst one's sides (laughing)"
                            },
                            {
                                "example_id": "07e133b6-c138-4e80-8793-99cfe85c1ca9",
                                "sense_id": "319725b3-1fd1-3ca8-86cf-4d1588ab9bcf",
                                "text": "а ро́жа не тре́снет?",
                                "translation": "are you sure it won't bust your chops?",
                                "english": "are you sure it won't bust your chops?"
                            },
                            {
                                "example_id": "9028f76f-1738-474b-a320-c5a1fc260818",
                                "sense_id": "319725b3-1fd1-3ca8-86cf-4d1588ab9bcf",
                                "text": "хоть тре́сни",
                                "translation": "1) no matter what 2) no matter how hard I try; ≈ for the life of me",
                                "english": "1) no matter what 2) no matter how hard I try; ≈ for the life of me"
                            },
                            {
                                "example_id": "b17204ee-5e80-4ea5-9df1-900400677d5b",
                                "sense_id": "319725b3-1fd1-3ca8-86cf-4d1588ab9bcf",
                                "text": "не могу́ найти́, хоть тре́сни",
                                "translation": "I can't find it for the life of me",
                                "english": "I can't find it for the life of me"
                            },
                            {
                                "example_id": "335fc8c3-378f-4041-859c-12fd193379b5",
                                "sense_id": "319725b3-1fd1-3ca8-86cf-4d1588ab9bcf",
                                "text": "чтоб ты тре́снул!, чтоб тебе́ тре́снуть!",
                                "translation": "blast you!, damn you!",
                                "english": "blast you!, damn you!"
                            }
                        ]
                    },
