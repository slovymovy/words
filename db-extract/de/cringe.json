                                    },
                                    {
                                        "sense_id": "7ae5ecaa-888a-37df-a7d6-012c80e92a48",
                                        "entry_id": "3e8e9355-22ba-3e02-8c94-37c2c19a83c5",
                                        "glosses": [
                                            "Things, particularly online content, which would cause an onlooker to cringe from secondhand embarrassment."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3abb0974-e98c-4632-bffc-c5f6e7d66cfc",
                                                "sense_id": "7ae5ecaa-888a-37df-a7d6-012c80e92a48",
                                                "text": "Bro... you just posted cringe"
                                            },
                                            {
                                                "example_id": "b96ff952-70c3-4d26-bd4d-d8f8212e34b7",
                                                "sense_id": "7ae5ecaa-888a-37df-a7d6-012c80e92a48",
                                                "text": "There was so much cringe in that episode!"
                                            },
                                            {
                                                "example_id": "adfad4f7-f921-4ee1-a208-9447b474598c",
                                                "sense_id": "7ae5ecaa-888a-37df-a7d6-012c80e92a48",
                                                "text": "Los Angeles-based writer K. Allado-McDowell's new novel, Amor Cringe, is a love letter to cringe maximalism."
                                            },
                                            {
                                                "example_id": "a7facfb2-b263-40d8-b0ce-75eb8e9cdbb6",
                                                "sense_id": "7ae5ecaa-888a-37df-a7d6-012c80e92a48",
                                                "text": "Soon, there were Instagram compilation accounts dedicated to collecting the worst cringe, with a focus on cringe created by not-quite-random people who were performing, and failing, for thousands of their peers on TikTok."
                                            },
                                            {
                                                "example_id": "a387decf-5fda-4d6b-a2a7-0a3fe25db88e",
                                                "sense_id": "7ae5ecaa-888a-37df-a7d6-012c80e92a48",
                                                "text": "Many young people are also reevaluating what once constituted cringe, attributing use of the term to unacknowledged bigotry more than just a rejection of sincerity. Some niche communities, such as furries, anime fans, and fetish groups, who were once mocked on social media, have since amassed cultural power that has launched them into the mainstream."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cringe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "197432d9-a912-3f12-b829-c87688a9ec83",
                                        "entry_id": "4f5086f9-b415-32ba-8410-5e9638343288",
                                        "glosses": [
                                            "Synonym of cringeworthy or uncool, inducing awkwardness or secondhand embarrassment."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6938d93-73be-4f55-adef-e05e27141ebf",
                                                "sense_id": "197432d9-a912-3f12-b829-c87688a9ec83",
                                                "text": "Brands trying to appeal to young people with memes is the most cringe thing ever."
                                            },
                                            {
                                                "example_id": "2cade43b-4166-49cf-8c8e-e70191102c6a",
                                                "sense_id": "197432d9-a912-3f12-b829-c87688a9ec83",
                                                "text": "Last week, while giving a commencement speech to New York University graduates, pop star Taylor Swift offered a timely bit of advice: “No matter how hard you try to avoid being cringe, you will look back on your life and cringe retrospectively. Cringe is unavoidable over a lifetime.”"
                                            },
                                            {
                                                "example_id": "720a875f-2173-4f57-ad16-606764e927fb",
                                                "sense_id": "197432d9-a912-3f12-b829-c87688a9ec83",
                                                "text": "No matter which side you stand on within a relationship, most people agree that couples participating in baby talk publicly is cringe to say the least."
                                            },
                                            {
                                                "example_id": "2d53023f-ba80-4ad6-9e20-c8c5fa8c600a",
                                                "sense_id": "197432d9-a912-3f12-b829-c87688a9ec83",
                                                "text": "Instagram may not be on its deathbed, but its transformation from cool to cringe is a sea change in the social-media universe."
                                            },
                                            {
                                                "example_id": "9584d1e9-652d-4cb3-b1ec-97b5ec0b355e",
                                                "sense_id": "197432d9-a912-3f12-b829-c87688a9ec83",
                                                "text": "We may have to face the fact that the current state of AI art is cringe because we're cringe. Really, we're no better than the unimaginative and self-obsessed people from the history books that commissioned bad portraiture."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cringe",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e1ad921-231a-33e2-b29c-eca5b515f642",
                                        "entry_id": "7c98a2e5-8778-3190-b2d1-efc6b0fcd698",
                                        "glosses": [
                                            "Stated in response to something cringeworthy."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
