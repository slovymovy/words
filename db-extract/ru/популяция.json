                ],
                "senses": [
                    {
                        "sense_id": "423d6cff-3358-36c4-8434-60479daf221d",
                        "entry_id": "33f16a31-b560-359a-b0b5-38efd53279b0",
                        "glosses": [
                            "биол. совокупность особей одного вида, более или менее длительно занимающая определённое пространство и воспроизводящая себя в течение большого числа поколений"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "598ef4d7-bbd6-43c4-8d2a-4895244d4a1a",
                        "source_entry_id": "33f16a31-b560-359a-b0b5-38efd53279b0",
                        "source_sense_id": "423d6cff-3358-36c4-8434-60479daf221d",
                        "target_lang_word": "population",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "population",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35b51572-78fb-363c-9366-e8e249b68b12",
                                        "entry_id": "f98ed8c8-6609-3383-8bb1-6cc923a9f5aa",
                                        "glosses": [
                                            "The people living within a political or geographical boundary."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d4e1239-1366-4a78-a3c7-810f3cb38469",
                                                "sense_id": "35b51572-78fb-363c-9366-e8e249b68b12",
                                                "text": "The population of New Jersey will not stand for this!"
                                            },
                                            {
                                                "example_id": "1231bdf2-5cf5-48a7-ae83-0a4add0e57a0",
                                                "sense_id": "35b51572-78fb-363c-9366-e8e249b68b12",
                                                "text": "“Panicology” considers the evidence on both sides of a large number of worries that have beset the industrialized world in modern times, including the “population crisis” (now one of underpopulation that threatens the wealth and health of aging populations in countries like Italy and Russia)[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35bd5afd-0b78-3821-bd38-5ce84ac9bc3a",
                                        "entry_id": "f98ed8c8-6609-3383-8bb1-6cc923a9f5aa",
                                        "glosses": [
                                            "The people with a given characteristic."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08b6f900-be34-40fa-891b-efbc4b1f1307",
                                                "sense_id": "35bd5afd-0b78-3821-bd38-5ce84ac9bc3a",
                                                "text": "India has the third-largest population of English-speakers in the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "387faf8a-9b26-3f84-a168-461e4592a6fc",
                                        "entry_id": "f98ed8c8-6609-3383-8bb1-6cc923a9f5aa",
                                        "glosses": [
                                            "A count of the number of residents within a political or geographical boundary such as a town, a nation or the world."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac7eafb6-fd98-4095-9e7d-45dbfb4a8d94",
                                                "sense_id": "387faf8a-9b26-3f84-a168-461e4592a6fc",
                                                "text": "population explosion; population growth"
                                            },
                                            {
                                                "example_id": "96add4db-8510-4cd5-9df7-e64b74b51f08",
                                                "sense_id": "387faf8a-9b26-3f84-a168-461e4592a6fc",
                                                "text": "The town’s population is only 243."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a90fe41-639e-3905-906c-dc5e9aae851d",
                                        "entry_id": "f98ed8c8-6609-3383-8bb1-6cc923a9f5aa",
                                        "glosses": [
                                            "A count of the number of residents within a political or geographical boundary such as a town, a nation or the world.",
                                            "The number of living cells in a pattern."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79105a3e-b900-4be3-9a18-23420ef82052",
                                                "sense_id": "7a90fe41-639e-3905-906c-dc5e9aae851d",
                                                "text": "This is one of several known \"sawtooth\" patterns, in which the population is unbounded but does not tend to infinity."
                                            },
                                            {
                                                "example_id": "9a267e7e-963b-4c40-bd9c-ff4c871c6bdb",
                                                "sense_id": "7a90fe41-639e-3905-906c-dc5e9aae851d",
                                                "text": "Since unoccupied cells never send a message they never access their neighbors and so if the population of the arena is, say, 20% of the total area then 80% of time no neighbor cells need to be accessed at all leading 1/9th as many array accesses and computation speeds up to 9 times faster per generation."
                                            },
                                            {
                                                "example_id": "6cc6dbb6-aaac-4010-8ca6-ecfea5ba3aa4",
                                                "sense_id": "7a90fe41-639e-3905-906c-dc5e9aae851d",
                                                "text": "End population was 101,764 cells, but with some significant spikes and drops along the way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92e07d15-d9d8-3f8f-8e14-1e4a4e71d83e",
                                        "entry_id": "f98ed8c8-6609-3383-8bb1-6cc923a9f5aa",
                                        "glosses": [
                                            "A collection of organisms of a particular species, sharing a particular characteristic of interest, most often that of living in a given area."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e4d231e-bc7a-4572-ae3a-927cb0e2f218",
                                                "sense_id": "92e07d15-d9d8-3f8f-8e14-1e4a4e71d83e",
                                                "text": "A seasonal migration annually changes the populations in two or more biotopes drastically, many twice in opposite senses."
                                            },
                                            {
                                                "example_id": "2fe20a3f-9da5-4b01-8d83-4574e76ab835",
                                                "sense_id": "92e07d15-d9d8-3f8f-8e14-1e4a4e71d83e",
                                                "text": "Within and among populations of grindelias, some morphologic traits appear to vary more from plant to plant than in most genera of composites."
                                            },
                                            {
                                                "example_id": "a95a6782-638a-4fe4-89de-4ccb4da37826",
                                                "sense_id": "92e07d15-d9d8-3f8f-8e14-1e4a4e71d83e",
                                                "text": "Plant breeding is always a numbers game.[…]The wild species we use are rich in genetic variation, […]. In addition, we are looking for rare alleles, so the more plants we try, the better. These rarities may be new mutations, or they can be existing ones that are neutral—or are even selected against—in a wild population. A good example is mutations that disrupt seed dispersal, leaving the seeds on the heads long after they are ripe."
                                            },
                                            {
                                                "example_id": "e2f9de4f-f65c-489c-8a54-f131aa5130d9",
                                                "sense_id": "92e07d15-d9d8-3f8f-8e14-1e4a4e71d83e",
                                                "text": "The tunnel was retired from operational service on September 3 1966. Since then, like many other tunnels, it has been left unused and unloved, apart from by the resident bat population."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ca465a6-5196-38b6-850f-c2f8f643d568",
                                        "entry_id": "f98ed8c8-6609-3383-8bb1-6cc923a9f5aa",
                                        "glosses": [
                                            "A group of units (persons, objects, or other items) enumerated in a census or from which a sample is drawn."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df1cbdb5-387e-4ca1-abc2-ea6c1481f08d",
                                                "sense_id": "9ca465a6-5196-38b6-850f-c2f8f643d568",
                                                "text": "[…]it is possible it [the Anglo-Saxon race] might stand second to the Scandinavian countries [in average height] if a fair sample of their population were obtained."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "196f4a05-fdc7-3f2f-b33c-4941ddb356a1",
                                        "entry_id": "f98ed8c8-6609-3383-8bb1-6cc923a9f5aa",
                                        "glosses": [
                                            "The act of filling initially empty items in a collection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04525115-fc11-459d-b883-eb7756329a09",
                                                "sense_id": "196f4a05-fdc7-3f2f-b33c-4941ddb356a1",
                                                "text": "John clicked the Search button and waited for the population of the list to complete."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d8a5a3b-9651-3e9c-977c-14193e64d6b3",
                                        "entry_id": "f98ed8c8-6609-3383-8bb1-6cc923a9f5aa",
                                        "glosses": [
                                            "General population."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c051e527-6ea6-4d5c-b70d-6b77beca915a",
                                                "sense_id": "3d8a5a3b-9651-3e9c-977c-14193e64d6b3",
                                                "text": "I would like to say something about the place I am doing time at. When I was placed in population, I met another woman and we immediately became good friends."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
