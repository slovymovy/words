                                "sense_id": "5baa567a-062e-3e34-a475-86b8cae168db",
                                "text": "Meiner Mutter Haar ward nimmer weiß.",
                                "translation": "Never did my mother's hair become white.",
                                "english": "Never did my mother's hair become white."
                            }
                        ]
                    },
                    {
                        "sense_id": "90158ef4-d6b1-3561-9f7a-94f625df2894",
                        "entry_id": "8671d24b-5279-32d5-8a59-1133156eac63",
                        "glosses": [
