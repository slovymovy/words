                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "COCA语料库",
                                "target_lang_sense_clarification": "当代美国英语语料库"
                            },
                            {
                                "target_lang_word": "COCA",
                                "target_lang_sense_clarification": "语料库英文缩写"
                            }
                        ]
                    }
                }
            ]
        }
    ]
