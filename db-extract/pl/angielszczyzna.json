                                                "example_id": "5fe9735e-c8f1-4844-aea3-31116a2c4f65",
                                                "sense_id": "70032255-2712-3a97-b751-d34645bb3ea3",
                                                "text": "„Die Sprache der Bienen ist dank der Untersuchungen des deutschen Forschers Karl von Frisch und seiner Mitarbeiter weitgehend entschlüsselt worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"9\""
                                    }
