                "senses": [
                    {
                        "sense_id": "cae75fd9-1e87-3f97-8da1-de5c1ad9166f",
                        "entry_id": "5a0fff41-c9e9-36d9-968d-038075df0624",
                        "glosses": [
                            "Transpercer."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "9279d32a-0690-46b9-92c0-d28c6f624f3e",
                                "sense_id": "cae75fd9-1e87-3f97-8da1-de5c1ad9166f",
                                "text": "Tandis que nous projetons ou conseillons une guerre glorieuse, nous serons lancés et chacun sur un roc transfixés, jouets et proies de tourbillons déchirants."
                            },
                            {
                                "example_id": "20a2eb3b-ab0e-4b42-ab16-f510a7cd3e18",
                                "sense_id": "cae75fd9-1e87-3f97-8da1-de5c1ad9166f",
                                "text": "Je le vis se retourner vers moi […], lorsque enfin la douleur dans ses tripes, sensation d'abord lointaine, eut fini de se frayer un chemin jusqu'à lui, d'où venait cette liquéfaction qui commençait à s'incendier et le transfixer et le river à elle. ."
                            }
                        ]
                    }
