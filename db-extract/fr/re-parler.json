                "senses": [
                    {
                        "sense_id": "e2989b41-0bab-3943-b77d-da6646add923",
                        "entry_id": "c3381078-9108-315c-bc7c-97b8ea83e24b",
                        "glosses": [
                            "Autre orthographe, rare mais parfois rencontrée, de reparler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6b898c9-bc8c-48e1-8939-961b53bdb141",
                                "sense_id": "e2989b41-0bab-3943-b77d-da6646add923",
                                "text": "Tous les médias français parlent et re-parlent de cet ouragan et pourtant il n’est pas encore arrivé."
                            },
                            {
                                "example_id": "5c45d765-e152-4dfc-b404-af589c751513",
                                "sense_id": "e2989b41-0bab-3943-b77d-da6646add923",
                                "text": "Si donc on parle de l’eau de ces fleuves, c'est-à-dire de ce qu’ils sont (y compris celui qu’on est soi-même), on peut et on doit en parler et re-parler sans cesse, en disant d’eux autre chose chaque fois qu’on en parlera ou re-parlera."
                            }
                        ]
                    }
