{
    "word": "toehoren",
    "lang_code": "nl",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [],
        "ru-extract.jsonl": [],
        "nl-extract.jsonl": [
            {
                "entry_id": "eb3c1456-540d-37b9-aea5-841c7b14928f",
                "word": "toehoren",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7a13498d-ea1f-3a2a-acf0-3c9dbd6b3bd0",
                        "entry_id": "eb3c1456-540d-37b9-aea5-841c7b14928f",
                        "glosses": [
                            "met veel aandacht luisteren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd7cf881-3d0e-4f48-aab5-c770d45c7405",
                                "sense_id": "7a13498d-ea1f-3a2a-acf0-3c9dbd6b3bd0",
                                "text": "Ergens op aarde zullen wij luisteren naar het buitenaardse. Of daar iets of iemand een teken van leven geeft, in die reusachtige flaporen van onze telescopen. En misschien even begint te zingen, te seinen of desnoods te spreken. Voortaan leef ik dag en nacht op een luisterende aarde. Naar misschien een andere toehorende aarde. Hopelijk wordt het een dovemansgesprek. Hoe dan ook, voortaan heeft het eenzame heelal een luisterend oor. Dat is al iets.de Standaard 25 JULI 2015 OM 03:00 UUR"
                            },
                            {
                                "example_id": "f6521a27-944b-4ef7-8eb8-cd98aa42076b",
                                "sense_id": "7a13498d-ea1f-3a2a-acf0-3c9dbd6b3bd0",
                                "text": "Hij raadt hem meermaals aan toch een advocaat te nemen, omdat zijn juridische kennis tekortschiet. Maar Karadzic blijft bij zijn plan zichzelf te verdedigen, al wil hij wel een team van raadsmannen achter zich hebben. ‘Ik ga niet passief toehoren hoe andere mensen dingen over mij beslissen."
                            }
                        ]
                    },
                    {
                        "sense_id": "d247887c-e884-3e62-8411-e5699acfb856",
                        "entry_id": "eb3c1456-540d-37b9-aea5-841c7b14928f",
                        "glosses": [
                            "eigendom zijn van iemand"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "62b46410-7b7e-4265-8bc6-dfde4207bf8b",
                        "source_entry_id": "eb3c1456-540d-37b9-aea5-841c7b14928f",
                        "source_sense_id": "7a13498d-ea1f-3a2a-acf0-3c9dbd6b3bd0",
                        "source_sense_description": "luisteren",
                        "target_lang_word": "listen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "listen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "914b55b2-5834-30f9-8bda-1cb99477d7d6",
                                        "entry_id": "b4a13faf-d503-372f-aa8b-6af2f9df0f2e",
                                        "glosses": [
                                            "To use one's sense of hearing and auditory cognition in an intentional way; to make deliberate use of one's ears; to pay attention to or wait for a specific sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21d9a54f-e6be-4682-9c4d-a546ca676ca1",
                                                "sense_id": "914b55b2-5834-30f9-8bda-1cb99477d7d6",
                                                "text": "Please listen carefully as I explain."
                                            },
                                            {
                                                "example_id": "17e674d5-ce38-4ce7-b39e-b287a68b1313",
                                                "sense_id": "914b55b2-5834-30f9-8bda-1cb99477d7d6",
                                                "text": "I could hear you talking upstairs, but I didn’t really listen to your conversation."
                                            },
                                            {
                                                "example_id": "68742335-898a-477a-8494-d471bae356fc",
                                                "sense_id": "914b55b2-5834-30f9-8bda-1cb99477d7d6",
                                                "text": "It was April 22, 1831, and a young man was walking down Whitehall in the direction of Parliament Street.[…]. He halted opposite the Privy Gardens, and, with his face turned skywards, listened until the sound of the Tower guns smote again on the ear and dispelled his doubts."
                                            },
                                            {
                                                "example_id": "e9ca0fb4-ac59-4498-8db4-491bbc95d68f",
                                                "sense_id": "914b55b2-5834-30f9-8bda-1cb99477d7d6",
                                                "text": "He reined Wrangle to a walk, halted now and then to listen, and then proceeded cautiously with shifting and alert gaze."
                                            },
                                            {
                                                "example_id": "08007cd5-ab38-4622-8ff3-cda3d2bdd92f",
                                                "sense_id": "914b55b2-5834-30f9-8bda-1cb99477d7d6",
                                                "text": "He read the letter aloud. Sophia listened with the studied air of one for whom, even in these days, a title possessed some surreptitious allurement."
                                            },
                                            {
                                                "example_id": "68759fa6-4600-4884-a119-896f07455fc8",
                                                "sense_id": "914b55b2-5834-30f9-8bda-1cb99477d7d6",
                                                "text": "(transitive, archaic)\nListen the watchman’s cry upon the wall."
                                            },
                                            {
                                                "example_id": "6e44ae73-78b0-48e9-9dea-f46144694e75",
                                                "sense_id": "914b55b2-5834-30f9-8bda-1cb99477d7d6",
                                                "text": "'But, sir, lyars ye have lystened, and that hath caused grete debate betwyxte you and me.'"
                                            },
                                            {
                                                "example_id": "fab815a9-c2b2-4429-af64-1b293590dc2b",
                                                "sense_id": "914b55b2-5834-30f9-8bda-1cb99477d7d6",
                                                "text": "Lady, vouchsafe to listen what I say."
                                            },
                                            {
                                                "example_id": "184257c7-b1ee-4558-b790-130abed6dddd",
                                                "sense_id": "914b55b2-5834-30f9-8bda-1cb99477d7d6",
                                                "text": "Here laid his Scrip, with wholesome Viands fill'd, / There, listening every Noise, his watchful Dog."
                                            },
                                            {
                                                "example_id": "f9641f67-7f26-47c6-b680-807c0eaa2f18",
                                                "sense_id": "914b55b2-5834-30f9-8bda-1cb99477d7d6",
                                                "text": "[with to]\nI like to listen to music."
                                            },
                                            {
                                                "example_id": "fe309556-fb25-43af-b70d-831679e5583c",
                                                "sense_id": "914b55b2-5834-30f9-8bda-1cb99477d7d6",
                                                "text": "I'm listening to what you say / Even though I look the other way / But you could never understand / The feeling of what I'm needing"
                                            },
                                            {
                                                "example_id": "e0503f71-e68d-411c-9a64-7199bdfc7b1d",
                                                "sense_id": "914b55b2-5834-30f9-8bda-1cb99477d7d6",
                                                "text": "[with for]\nYou should listen for the starting gun."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f392f780-5ef4-31ed-a163-3079fd4f10f5",
                                        "entry_id": "b4a13faf-d503-372f-aa8b-6af2f9df0f2e",
                                        "glosses": [
                                            "To accept advice or obey instruction; to agree or assent."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6afbf81c-ec90-4063-878e-20dbc1d2acc5",
                                                "sense_id": "f392f780-5ef4-31ed-a163-3079fd4f10f5",
                                                "text": "Listen, the only reason I yelled at you was because I was upset, OK?"
                                            },
                                            {
                                                "example_id": "a961626e-52ad-4ff8-b51b-98d9feaec96e",
                                                "sense_id": "f392f780-5ef4-31ed-a163-3079fd4f10f5",
                                                "text": "Good children listen to their parents."
                                            },
                                            {
                                                "example_id": "958d5da8-9b06-45fc-b074-3e59c0b861ce",
                                                "sense_id": "f392f780-5ef4-31ed-a163-3079fd4f10f5",
                                                "text": "Never listen when they tell you that Man and the animals have a common interest[…]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "listen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fcaa12d8-920b-3e8e-b679-6215fa8a6f82",
                                        "entry_id": "8faf019f-fe65-398e-a766-6bf5c465d0f0",
                                        "glosses": [
                                            "An instance of listening."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c86d96f-33d8-4ac6-8f60-4efc51e330a9",
                                                "sense_id": "fcaa12d8-920b-3e8e-b679-6215fa8a6f82",
                                                "text": "Give the motor a listen and tell me if it sounds off."
                                            },
                                            {
                                                "example_id": "7544b95c-f134-4715-b006-880b8609e65e",
                                                "sense_id": "fcaa12d8-920b-3e8e-b679-6215fa8a6f82",
                                                "text": "The diss song, “Back to Back,” now has more than 124 million listens, a sign that the streaming can attract a sizable audience for a single track."
                                            },
                                            {
                                                "example_id": "b222fafa-18fa-4a1a-ab88-6d602c4acc54",
                                                "sense_id": "fcaa12d8-920b-3e8e-b679-6215fa8a6f82",
                                                "text": "I hadn't spoken to her in a year, but she could still see my listens on the music platform we both used."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
