                        "form": "den Hausarzt"
                    },
                    {
                        "form_id": "e1f22520-18ee-4553-8a01-13dee6f60d27",
                        "entry_id": "9bc624e7-e9ac-35a1-b94f-776041c66f01",
                        "tags": [
                            "accusative",
