                    {
                        "translation_id": "be18846a-877d-4924-a17c-cee294d2d057",
                        "source_entry_id": "d64ef9e2-a766-36ff-be9b-23740a755eb4",
                        "source_sense_id": "d4a1a0ce-5b4d-378e-b565-938ec8a1c13a",
                        "source_sense_description": "een wijdverspreide honger als gevolg van voedselschaarste",
                        "target_lang_word": "Hungersnot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hungersnot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a1887d39-28c6-305d-bc38-5c943a6d58f3",
                                        "entry_id": "6510a4c1-693e-321d-ad82-951c152b7330",
                                        "glosses": [
                                            "so großer Mangel an Nahrungsmitteln in einer bestimmten Region, dass viele Menschen dort unterernährt sind oder sogar verhungern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53f6d3ad-add1-4528-9281-084b6243cb24",
                                                "sense_id": "a1887d39-28c6-305d-bc38-5c943a6d58f3",
                                                "text": "Aufgrund der anhaltenden Dürre ist ganz Somalia von einer Hungersnot bedroht."
                                            },
                                            {
                                                "example_id": "569c49b2-3158-4050-8fab-b58fbc0115a1",
                                                "sense_id": "a1887d39-28c6-305d-bc38-5c943a6d58f3",
                                                "text": "„1770/71 kam es in Brandenburg und Sachsen zu einer Hungersnot.“"
                                            },
                                            {
                                                "example_id": "52b65290-d99b-4c08-952e-4383c7c3d034",
                                                "sense_id": "a1887d39-28c6-305d-bc38-5c943a6d58f3",
                                                "text": "„Im Winter und Herbst 1947 erreichte die Hungersnot ihren Höhepunkt und traf sogar die sowjetischen Übersiedler.“"
                                            },
                                            {
                                                "example_id": "6aed1fed-ee52-4b6a-8bb2-b26bc0d98fd5",
                                                "sense_id": "a1887d39-28c6-305d-bc38-5c943a6d58f3",
                                                "text": "Die UN warnen vor einer Hungersnot im Bürgerkriegsland Südsudan. Mehr als eine Million Menschen sind auf der Flucht und konnten ihre Felder nicht bestellen."
                                            },
                                            {
                                                "example_id": "85b8f563-e825-4d70-a00f-d3546058273d",
                                                "sense_id": "a1887d39-28c6-305d-bc38-5c943a6d58f3",
                                                "text": "„Portugal und seine transatlantische Kolonie waren finanziell und personell ausgelaugt; hüben wie drüben kam es zu Hungersnöten.“"
                                            },
                                            {
                                                "example_id": "434b7231-42fc-40bd-8436-4ceed71a6804",
                                                "sense_id": "a1887d39-28c6-305d-bc38-5c943a6d58f3",
                                                "text": "„UN bestätigen erstmals Hungersnot im Gazastreifen – Eine halbe Million Menschen in und um Gaza-Stadt sind von der Hungersnot betroffen.“"
                                            },
                                            {
                                                "example_id": "8768ce50-1a31-4404-b4aa-e3ed1ef26c0c",
                                                "sense_id": "a1887d39-28c6-305d-bc38-5c943a6d58f3",
                                                "text": "„Nach Angaben der Weltgesundheitsorganisation (WHO) ist es das erste Mal, dass in einem Land des Nahen Ostens eine Hungersnot ausgerufen wird.“"
                                            },
                                            {
                                                "example_id": "47e689c5-e43d-46fe-9178-488e31c51210",
                                                "sense_id": "a1887d39-28c6-305d-bc38-5c943a6d58f3",
                                                "text": "„Volker Türk, der UN-Menschenrechtskommissar, macht die israelische Regierung für die Hungersnot verantwortlich.“"
                                            },
                                            {
                                                "example_id": "492595cf-d357-43c4-ba7d-d15066cd868a",
                                                "sense_id": "a1887d39-28c6-305d-bc38-5c943a6d58f3",
                                                "text": "„In den Jahren 1845 bis 1849 verfaulten in Irland die Kartoffeln auf den Äckern und zerstörten damit die Lebensgrundlage vieler Menschen. Eine gewaltige Hungersnot folgte, Hunderttausende Menschen starben.“"
                                            },
                                            {
                                                "example_id": "0ba871e2-8492-4685-b806-fc24fa75dbd3",
                                                "sense_id": "a1887d39-28c6-305d-bc38-5c943a6d58f3",
                                                "text": "„Vergessen haben die Iren das Verhalten der Engländer während der Kartoffelpest nie. Das schon vorher angespannte Verhältnis zwischen Iren und Engländern schlug nach der Hungersnot in offenen Hass gegen alles Englische um.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8ed8e2d-ca34-4e7d-ab8a-aaf0547f90fb",
