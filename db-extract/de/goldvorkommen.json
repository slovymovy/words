                        "examples": [
                            {
                                "example_id": "c3b53266-70ca-4e59-9971-42b35486617d",
                                "sense_id": "afbd2ccd-0519-3d00-adf8-6c7bff41cacb",
                                "text": "Mali verfügt über beachtliche Goldvorkommen."
                            },
                            {
                                "example_id": "e8fdf856-33db-44c7-9e35-5390b1d40d85",
                                "sense_id": "afbd2ccd-0519-3d00-adf8-6c7bff41cacb",
                                "text": "„Ab 1882 werden in Transvaal große Goldvorkommen entdeckt.“"
                            },
                            {
                                "example_id": "e77d4c1a-11f8-4a31-8a2e-156ffa093dd2",
                                "sense_id": "afbd2ccd-0519-3d00-adf8-6c7bff41cacb",
                                "text": "„Einige Jahre darauf fand man am Witwatersrand, einer Hügelkette im Süden des Transvaal, die größten Goldvorkommen der Welt.“"
                            }
                        ],
