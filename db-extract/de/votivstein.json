                "senses": [
                    {
                        "sense_id": "d6eb597f-4d44-3293-969e-fca61c570fa3",
                        "entry_id": "cd317c97-5b82-3dcf-9cbb-5a9a08b86c0f",
                        "glosses": [
                            "gehauener oder bearbeiteter Stein eines Votanten mit Votivinschrift; Votivgabe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04b24223-76b5-4ea8-9c70-5898421bb555",
                                "sense_id": "d6eb597f-4d44-3293-969e-fca61c570fa3",
                                "text": "„Das abgebrochene Stück hat indessen fast unzweifelhaft nur eine der typischen Dedicationsphrasen enthalten, wie „Votum solvit libens merito\", oder „Ex voto posuit l. m. u, oder, wie auf einem ganz analogen Nonsberger Votivsteine, einfach „Dicavit\".“"
                            },
                            {
                                "example_id": "625caffc-b17e-4352-aa9a-17d18df03f61",
                                "sense_id": "d6eb597f-4d44-3293-969e-fca61c570fa3",
                                "text": "„Votivsteine wurden als Erfüllung eines Gelübdes oder als Dank an die Götter aufgestellt und prägten die religiöse Welt der Römer.“"
                            },
                            {
                                "example_id": "3a9df206-486e-4cb3-926d-ed09b6bf0ea7",
                                "sense_id": "d6eb597f-4d44-3293-969e-fca61c570fa3",
                                "text": "„Dieser Votivstein der das Gemeindewappen von Johnsdorf – Brunn ziehrt, wurde 1937 beim Anlegen eines Weingartens auf dem Königsberg in Brunn ausgegraben.“"
                            },
                            {
                                "example_id": "76da2692-788d-4af9-a31f-09af67bf220d",
                                "sense_id": "d6eb597f-4d44-3293-969e-fca61c570fa3",
                                "text": "„Die erste schriftliche Erwähnung der Niers findet sich auf einem Votivstein aus dem 1. - 4. Jahrhundert, der den Matronen gewidmet ist, einer vor allem im Rheinland verehrten weiblichen göttlichen Dreiheit.“"
                            },
                            {
                                "example_id": "07da1314-1076-488e-a4c7-b006209ced6f",
                                "sense_id": "d6eb597f-4d44-3293-969e-fca61c570fa3",
                                "text": "„Im Jahr 1947 entdekte die Lehrerin Frau Berta Runge einen römischen Votivstein, der als Beweis des zumindest zeitweiligen Aufenthalt von Römern im Donnersbachtal anzusehen ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
