                "senses": [
                    {
                        "sense_id": "473bc37c-72ef-3c48-bd41-4994f9169fa5",
                        "entry_id": "d5125c61-8d7e-38d2-afc6-b1ef8c4ba721",
                        "glosses": [
                            "разг. поведение, поступки гаера"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f48aa30-e5b9-4fb4-8d0b-984d7c654f7f",
                                "sense_id": "473bc37c-72ef-3c48-bd41-4994f9169fa5",
                                "text": "Мне всегда бывало как-то безотчётно-жутко смотреть на гаерство этого странного человека."
                            },
                            {
                                "example_id": "7668dd2a-bb45-43d3-852c-1e914b1e3fda",
                                "sense_id": "473bc37c-72ef-3c48-bd41-4994f9169fa5",
                                "text": "Он заблуждался, полагая, что окружающие столь же настырно помнят о его белом билете, смешных кудряшках и нелепой фигуре. Он сам напоминал об этом мучительном своим гаерством."
                            }
                        ]
                    }
