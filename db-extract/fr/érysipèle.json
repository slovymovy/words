                                        "entry_id": "3a61cab2-695a-3070-ade8-6131fc8c5ee7",
                                        "glosses": [
                                            "An acute, sometimes recurrent febrile disease caused by infection of a hemolytic streptococcus, associated with intense edematous local inflammation of the skin and subcutaneous tissues, and marked by large raised red patches on the skin."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6b31d30-8773-40d1-8958-3302024ae81f",
                                                "sense_id": "0645716f-54aa-39e6-8b8d-beda9c4c29a6",
                                                "text": "The symptoms gradually improved until, on the fifth day from her delivery, I was pleased to find the erysipelas rapidly defervescing, the lochia natural, no subinvolution of the uterus, nor abdominal tenderness."
                                            }
                                        ]
