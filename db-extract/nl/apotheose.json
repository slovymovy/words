                ],
                "senses": [
                    {
                        "sense_id": "ecd22f0d-584c-3c98-9174-ca855df0840b",
                        "entry_id": "c6a57d93-6285-37b5-b399-00642b1a3b3e",
                        "glosses": [
                            "slotstuk van een opvoering vertoond met veel pracht en praal"
