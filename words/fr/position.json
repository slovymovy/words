            "senses": [
                {
                    "sense_id": "3f80062f-2dcc-35b2-b0f2-e07202f5e873",
                    "sense_definition": "Lieu précis où une personne ou un objet se trouve par rapport à un repère.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le système GPS indique notre <w>position</w> exacte sur la carte routière."
                        },
                        {
                            "text": "Le marin a vérifié sa <w>position</w> avant de changer de cap en pleine mer."
                        }
                    ],
                    "synonyms": [
                        "emplacement"
                    ],
                    "common_phrases": [
