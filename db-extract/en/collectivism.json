                    {
                        "translation_id": "098340ab-0b67-4cc8-8584-d60f2dae2d42",
                        "source_entry_id": "e59153c3-c06e-3b57-9696-30687ca81c06",
                        "source_sense_description": "A system in which the means are owned and controlled by people collectively",
                        "target_lang_word": "collectivisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "collectivisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "62b6ab96-abb3-30d8-97e3-7e9f69516fa7",
                                        "entry_id": "c3df3f13-e7be-3b89-b7e8-e76f76bbc1af",
                                        "glosses": [
                                            "Théorie sociale qui consiste à supprimer la propriété individuelle des moyens de production, et à remettre à la collectivité des travailleurs tous les produits du travail."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41105e01-44a8-4866-b782-cf0d935d565c",
                                                "sense_id": "62b6ab96-abb3-30d8-97e3-7e9f69516fa7",
                                                "text": "Puis, à propos de Mège et de son discours, prononcé l’après-midi à la Chambre, il fit amèrement le procès du collectivisme, qu’il déclarait être une des formes démocratiques du despotisme."
                                            },
                                            {
                                                "example_id": "8b316d3d-e452-4182-9ab5-19330dff5a70",
                                                "sense_id": "62b6ab96-abb3-30d8-97e3-7e9f69516fa7",
                                                "text": "Il leur faut des électeurs ouvriers assez naïfs pour se laisser duper par des phrases ronflantes sur le collectivisme futur."
                                            },
                                            {
                                                "example_id": "8d7e87fd-2f04-4a10-95f0-052f6bef9b38",
                                                "sense_id": "62b6ab96-abb3-30d8-97e3-7e9f69516fa7",
                                                "text": "Une jolie clameur dans la presse et au Parlement ! Un socialiste au gouvernement et quel socialiste ? Un socialiste identifiant en un discours prononcé quelques années plus tôt à Saint-Mandé socialisme et collectivisme !"
                                            },
                                            {
                                                "example_id": "a1ce358e-043e-48b6-9b47-ed275aaa90db",
                                                "sense_id": "62b6ab96-abb3-30d8-97e3-7e9f69516fa7",
                                                "text": "Il est paradoxal de voir à quel point les grands bourgeois, partisans de l’individualisme théorique, adoptent pour eux-mêmes un collectivisme pratique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
