                                        "sense_id": "a8ef08b3-bc7b-31cf-9ec4-bf165c48146c",
                                        "entry_id": "e6a1af1a-63d0-3ffe-9bf7-162785f39655",
                                        "glosses": [
                                            "спец. пряжа, намотанная на веретено или снятая с веретена"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94a67474-a875-4fec-8e49-34a66a44e664",
                                                "sense_id": "a8ef08b3-bc7b-31cf-9ec4-bf165c48146c",
                                                "text": "Много ль початков напряла?"
                                            },
                                            {
                                                "example_id": "a6aad2e0-0340-46ef-973a-58baed5ed1e4",
                                                "sense_id": "a8ef08b3-bc7b-31cf-9ec4-bf165c48146c",
                                                "text": "Ни ткать, ни прясть, ни початка мотать."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3c09910-17a4-3568-9341-ee83a833b33c",
                                        "entry_id": "e6a1af1a-63d0-3ffe-9bf7-162785f39655",
                                        "glosses": [
                                            "устар. и рег. начало, почин"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e51f5426-1434-4fd8-91bb-1d664e47a646",
                                                "sense_id": "a3c09910-17a4-3568-9341-ee83a833b33c",
                                                "text": "Издавна как ещё Москвы початку не слыхивано."
                                            },
                                            {
                                                "example_id": "51f3ddc8-9f93-4a2d-b313-790c573dc884",
                                                "sense_id": "a3c09910-17a4-3568-9341-ee83a833b33c",
                                                "text": "От початку лет."
                                            }
                                        ]
                                    },
