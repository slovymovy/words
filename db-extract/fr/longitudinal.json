                                    {
                                        "sense_id": "0b05d5f0-ccf9-3702-8f3c-5e886453d1f9",
                                        "entry_id": "ccc0de27-e31d-3f12-97a6-bebc327f4617",
                                        "glosses": [
                                            "in die Längsrichtung verlaufend, längs (gerichtet)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ee857d2-4698-4c24-ae79-325a55dd5da3",
                                                "sense_id": "0b05d5f0-ccf9-3702-8f3c-5e886453d1f9",
                                                "text": "Die Schwingungszeit einer longitudinal schwingenden Saite kann aus dem Elastizitätsmodul und der Dichte berechnet werden."
                                            },
                                            {
                                                "example_id": "88e70dd3-a855-4c97-b1a0-ad739425aecf",
                                                "sense_id": "0b05d5f0-ccf9-3702-8f3c-5e886453d1f9",
                                                "text": "„Es sei zum Beispiel die in die y2-Ebene einfallende Welle eine longitudinale, die die Geschwindigkeit c, haben soll.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
