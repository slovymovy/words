                "senses": [
                    {
                        "sense_id": "6232eab1-8ca4-3900-b4ea-7aeedaffd4ad",
                        "entry_id": "eada9e52-6a43-3863-a5b2-56471d97c2c0",
                        "glosses": [
                            "Instrument mit scharfem, löffelartigem Ende zum Ausschaben von Gewebe (Kürettage)"
                        ],
                        "tags": [
                            "Chirurgie"
                        ],
                        "examples": [
                            {
                                "example_id": "c4d552b8-3243-4d16-b0fa-35faf743a392",
                                "sense_id": "6232eab1-8ca4-3900-b4ea-7aeedaffd4ad",
                                "text": "„Um das möglichst zu verhindern, verwendet der Abtreiber eine Kürette, um die Wand der Gebärmutter auszuschaben.“"
                            },
                            {
                                "example_id": "6dcb17a9-8752-4186-aef0-16d1b9052621",
                                "sense_id": "6232eab1-8ca4-3900-b4ea-7aeedaffd4ad",
                                "text": "„Sie hatte aus einem Instrumentenschrank die Kürette, ein kleines und ein größeres Spekulum und eine Uterussonde geholt.“"
                            },
                            {
                                "example_id": "fae8af20-bce5-403f-8a87-cb487f99a8cf",
                                "sense_id": "6232eab1-8ca4-3900-b4ea-7aeedaffd4ad",
                                "text": "„Damit der Belag abgeht, benutzt sie entweder einen feinen Schaber, die Kürette oder eine durch Ultraschall schwingende Spitze.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "261b7a53-9eb5-4cbe-9f9a-8ef9b47ffbff",
                        "source_entry_id": "eada9e52-6a43-3863-a5b2-56471d97c2c0",
                        "source_sense_id": "6232eab1-8ca4-3900-b4ea-7aeedaffd4ad",
                        "source_sense_description": "Medizin, Chirurgie: Instrument mit scharfem, löffelartigem Ende zum Ausschaben von Gewebe (Kürettage)",
                        "target_lang_word": "curette",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "curette",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2c1a00d-46fe-35ee-a4a6-0a45dd8b2977",
                                        "entry_id": "686fdea0-0bfe-3a63-aed8-1bb43786fc70",
                                        "glosses": [
                                            "A hand-held surgical instrument, often with a scoop or hook at its tip, used for cleaning or debriding biological tissue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2478ca3-b7fc-4431-9f60-a18f7b5d120b",
                                                "sense_id": "e2c1a00d-46fe-35ee-a4a6-0a45dd8b2977",
                                                "text": "Curettes are used for the subgingival removal of dental deposits and for root planing. They can also be used supragingivally. The working tip of a curette is more slender than that of a scaler."
                                            },
                                            {
                                                "example_id": "f58d3db8-7a3a-4acd-9542-32416d354153",
                                                "sense_id": "e2c1a00d-46fe-35ee-a4a6-0a45dd8b2977",
                                                "text": "Beginning in the 1880s, the curette quickly became the popular choice for those doctors on the lookout for instrumental aid in cases of pregnancy loss."
                                            },
                                            {
                                                "example_id": "18d2e566-3152-4a64-9058-b263664710d5",
                                                "sense_id": "e2c1a00d-46fe-35ee-a4a6-0a45dd8b2977",
                                                "text": "2020, Yu Matsumoto, 10: Bone Curette Handle for Improved Bone Removal in Endoscopic Ear Surgery, Seiji Kakehata, Tsukasa Ito, Daisuke Yamauchi (editors), Innovations in Endoscopic Ear Surgery, Springer, page 86,\nCurettes with an octagonal-shaped shaft are readily available and widely distributed in Japan."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "curette",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
