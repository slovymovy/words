                "senses": [
                    {
                        "sense_id": "1ddf7708-4aa5-3005-907d-bf4fe136ac5c",
                        "entry_id": "dadc9881-afe0-360e-860e-20136fad552c",
                        "glosses": [
                            "marijuana, weed"
                        ],
                        "tags": [
                            "feminine",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "5b1b6243-1278-4764-b20d-34031a4cf035",
                                "sense_id": "1ddf7708-4aa5-3005-907d-bf4fe136ac5c",
                                "text": "Najpierw czytaliśmy, potem zapaliliśmy etiopską trawę i mój kolega, Bogdan mówi — Słuchaj, stary, to była najlepsza gandzia jaką paliłem w życiu.",
                                "translation": "First we read, then we smoked some Ethiopian pot and my friend Bogdan says - Listen, man, that was the best ganja I ever smoked in my life.",
                                "english": "First we read, then we smoked some Ethiopian pot and my friend Bogdan says - Listen, man, that was the best ganja I ever smoked in my life."
                            },
                            {
                                "example_id": "15853b83-49f8-41ae-a435-5d1f4bb7048e",
                                "sense_id": "1ddf7708-4aa5-3005-907d-bf4fe136ac5c",
                                "text": "Chociaż gandzia utrzymuje się w organizmie przez trzydzieści dni od jej zażycia, to jej wpływ na świadomość ulega znacznemu osłabieniu już po dwudziestu czterech godzinach.",
                                "translation": "Although marijuana persists in the body for thirty days after use, its effect on consciousness is greatly diminished after only twenty-four hours.",
                                "english": "Although marijuana persists in the body for thirty days after use, its effect on consciousness is greatly diminished after only twenty-four hours."
                            }
                        ]
                    }
                ],
