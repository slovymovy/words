                "senses": [
                    {
                        "sense_id": "4aac515e-a838-38ce-8996-ebeb1f19e9fd",
                        "entry_id": "714bde67-b075-3fbc-8413-8a11cdd9c52d",
                        "glosses": [
                            "vorsätzliche Tötung einer Person, bei der die Kriterien für einen Mord nicht vorliegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9b739bf-4cba-478a-be6d-f2d10abb4da7",
                                "sense_id": "4aac515e-a838-38ce-8996-ebeb1f19e9fd",
                                "text": "Wer einen Menschen tötet, ohne Mörder zu sein, begeht einen Totschlag und wird mit Freiheitsstrafe nicht unter fünf Jahren bestraft."
                            },
                            {
                                "example_id": "84e9d3a2-8aa2-45ad-a36d-69ef072829ca",
                                "sense_id": "4aac515e-a838-38ce-8996-ebeb1f19e9fd",
                                "text": "„Um halb vier wurde Henriette Bernhard des Totschlags an Schwester Angelika schuldig gesprochen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "15c62f74-3e97-3976-8cb8-bae52acc0405",
                        "entry_id": "714bde67-b075-3fbc-8413-8a11cdd9c52d",
                        "glosses": [
                            "Tötung eines Menschen"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "d77f1c09-a705-428e-9994-0b4112528fae",
                                "sense_id": "15c62f74-3e97-3976-8cb8-bae52acc0405",
                                "text": "Die ersten 25 Jahre seines Lebens hatte Simplicissimus nur Plünderungen und Totschlag erlebt."
                            },
                            {
                                "example_id": "7abab2fd-cde0-416f-bca7-4d5a41baa7e8",
                                "sense_id": "15c62f74-3e97-3976-8cb8-bae52acc0405",
                                "text": "„Es kommt mir vor, als ob er in seinem Gebirgstale die letzten tausend Jahre verschlafen hätte, denn daß er sich damals in der Bahn vor uns eines Totschlags rühmte, den er vielleicht auch in der Tat begangen hatte, war ein altertümlicher Zug, der an die Zeiten erinnerte, wo man dergleichen mit einem Wergeld oder durch den Waldgang ehrenhaft ordnete.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f737aa6-3f1d-48ee-a399-dd43beabcde9",
                        "source_entry_id": "714bde67-b075-3fbc-8413-8a11cdd9c52d",
                        "source_sense_id": "4aac515e-a838-38ce-8996-ebeb1f19e9fd",
