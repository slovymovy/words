{
    "word_family": [
        "half",
        "halver"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9cfb5614-e4b7-3590-a375-222d410ff78b",
                    "sense_definition": "To divide something into two equal parts.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "division",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>halve</w> the apple so we can share it.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>разрежь пополам</w> яблоко, чтобы мы могли его разделить."
                            }
                        },
                        {
                            "text": "You can <w>halve</w> the recipe if you are cooking for just one person.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>уменьшить вдвое</w> количество ингредиентов в рецепте, если готовите только для одного человека."
                            }
                        }
                    ],
                    "synonyms": [
                        "bisect",
                        "dichotomize",
                        "dimidiate"
                    ],
                    "common_phrases": [
                        "halve the recipe",
                        "halve an apple"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разделить что-либо на две равные части."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разделить пополам",
                                "target_lang_sense_clarification": "на две части"
                            },
                            {
                                "target_lang_word": "делить пополам",
                                "target_lang_sense_clarification": "процесс деления надвое"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4349e99-ec75-30e5-b23b-7edf116b4645",
                    "sense_definition": "To reduce an amount or amount of something by fifty percent.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "reduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company managed to <w>halve</w> the cost of production over the last two years.",
                            "target_lang_translations": {
                                "ru": "За последние два года компании удалось <w>сократить наполовину</w> затраты на производство."
                            }
                        },
                        {
                            "text": "New safety measures helped to <w>halve</w> the number of accidents.",
                            "target_lang_translations": {
                                "ru": "Новые меры безопасности помогли <w>сократить вдвое</w> количество несчастных случаев."
                            }
                        }
                    ],
                    "common_phrases": [
                        "halve the cost"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уменьшить количество или объем чего-либо на пятьдесят процентов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сократить наполовину",
                                "target_lang_sense_clarification": "уменьшить вдвое"
                            },
                            {
                                "target_lang_word": "уменьшить вдвое",
                                "target_lang_sense_clarification": "снизить на 50%"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c26618f-0560-3dc4-b436-4cad4747f022",
                    "sense_definition": "To form or make up half of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "division",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her passion and dedication <w>halve</w> the responsibility of running the firm.",
                            "target_lang_translations": {
                                "ru": "Её страсть и преданность делу <w>делят пополам</w> ответственность за управление фирмой."
                            }
                        },
                        {
                            "text": "They found a soulmate who could <w>halve</w> their burdens and double their joy.",
                            "target_lang_translations": {
                                "ru": "Они нашли родственную душу, способную <w>разделить</w> их бремя и удвоить радость."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Составлять половину чего-либо или делить поровну (например, бремя, ответственность)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делить пополам",
                                "target_lang_sense_clarification": "разделять ответственность или радость"
                            },
                            {
                                "target_lang_word": "облегчать вдвое",
                                "target_lang_sense_clarification": "уменьшать бремя наполовину"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "775b5be6-93d8-3892-a73e-f8a901e6eb39",
                    "sense_definition": "In sports like golf, to play a hole or match in the same number of strokes as an opponent, resulting in a tie.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Both players performed well and managed to <w>halve</w> the match.",
                            "target_lang_translations": {
                                "ru": "Оба игрока выступили хорошо и сумели <w>сыграть</w> матч <w>вничью</w>."
                            }
                        },
                        {
                            "text": "He sank a long putt on the final green to <w>halve</w> the hole.",
                            "target_lang_translations": {
                                "ru": "Он забил долгий патт на последнем грине, чтобы <w>сыграть</w> лунку <w>вничью</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "halve the match",
                        "halve the hole"
                    ],
                    "target_lang_definitions": {
                        "ru": "В спорте (например, в гольфе) сыграть лунку или матч с тем же количеством ударов, что и соперник, сыграв вничью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сыграть вничью",
                                "target_lang_sense_clarification": "в гольфе (лунку или матч)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b71ee1f6-8c6e-39c6-aa70-f48ac7de30ce",
                    "sense_definition": "To join two pieces of timber by cutting away half the thickness of each at the joint.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "carpentry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter decided to <w>halve</w> the wooden beams before joining them together.",
                            "target_lang_translations": {
                                "ru": "Плотник решил <w>Сделать выборку вполдерева</w> на деревянных брусьях перед их соединением."
                            }
                        },
                        {
                            "text": "To build a strong joint, you need to <w>halve</w> the ends precisely.",
                            "target_lang_translations": {
                                "ru": "Чтобы сделать прочное соединение, нужно точно <w>срезать наполовину</w> концы деталей."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Соединить два куска древесины, срезав половину толщины каждого в месте соединения (соединить вполдерева)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соединять вполдерева",
                                "target_lang_sense_clarification": "в плотницком деле"
                            },
                            {
                                "target_lang_word": "срубать вполдерева",
                                "target_lang_sense_clarification": "делать выборку древесины наполовину"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}