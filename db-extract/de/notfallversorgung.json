                        "entry_id": "7dad6df1-abe2-3b4a-976b-3324de6aac1b",
                        "glosses": [
                            "erste Behandlung (Versorgung) eines akut verletzten oder erkrankten Patienten, der sofortiger Hilfe bedarf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "945dd2ee-d493-45f3-850b-e342783f1752",
                                "sense_id": "60cbd932-88d6-3c68-990c-95d016569e41",
                                "text": "Der Rettungsdienst leistet die Notfallversorgung von Schwerverletzten am Unfall- oder Erkrankungsort sowie den Transport zum Krankenhaus."
                            },
                            {
                                "example_id": "0fe06478-2c26-4312-927a-3b4538810aa3",
                                "sense_id": "60cbd932-88d6-3c68-990c-95d016569e41",
                                "text": "„Das soll bedeuten, daß diese Sehnenverletzungen bei Notfallversorgungen nur unter Idealvoraussetzungen primär rekonstruiert werden sollen wegen hierbei häufiger Wundheilungsstörungen.“"
                            }
                        ],
