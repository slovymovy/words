                        ],
                        "form": "das Lebensalter"
                    },
                    {
                        "form_id": "bfa45284-99e4-4dc4-8a98-9c07927ef695",
                        "entry_id": "fe650b67-efa3-3134-b254-a7cc5dc9722a",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Lebensalter"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "59e3da0d-e23a-37ac-afc6-ed51759ef60b",
                        "entry_id": "fe650b67-efa3-3134-b254-a7cc5dc9722a",
                        "glosses": [
                            "Zeit, die ein Mensch bis zu einem bestimmten Zeitpunkt gelebt hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46ddbfb0-020a-4ebb-8dc2-7b1254513c04",
                                "sense_id": "59e3da0d-e23a-37ac-afc6-ed51759ef60b",
                                "text": "„Infektionskrankheiten treten mit zunehmendem Lebensalter häufiger auf und haben oft schwerwiegende Folgen für den älteren Menschen.“"
                            },
                            {
                                "example_id": "e8820bf7-6455-4c22-b9da-2af9962f7fb5",
                                "sense_id": "59e3da0d-e23a-37ac-afc6-ed51759ef60b",
                                "text": "„Das Lebensalter ist also ein starker unabhängiger Risikofaktor für osteoporotische Frakturen.“"
                            },
                            {
                                "example_id": "c21794bc-29b0-41c4-ae31-b3d9b7c36dbe",
                                "sense_id": "59e3da0d-e23a-37ac-afc6-ed51759ef60b",
                                "text": "„Somit ist im Grunde weder der Zeitpunkt noch das Lebensalter der entscheidende Punkt bei einer Heirat.“"
                            },
                            {
                                "example_id": "45f73b2c-695c-4440-9b68-85028920f0a5",
                                "sense_id": "59e3da0d-e23a-37ac-afc6-ed51759ef60b",
                                "text": "„Das folgende Kapitel widmet sich einer Betrachtung der Lebensalter Kindheit und Jugend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd73be4f-b0ae-4843-b1e3-33462a997101",
                        "source_entry_id": "fe650b67-efa3-3134-b254-a7cc5dc9722a",
                        "source_sense_id": "59e3da0d-e23a-37ac-afc6-ed51759ef60b",
                        "source_sense_description": "Zeit, die ein Mensch bis zu einem bestimmten Zeitpunkt gelebt hat",
                        "target_lang_word": "âge",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "âge",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "00758dc2-724d-3f32-b128-525143f47b80",
                                        "entry_id": "1fc27b2c-af89-3315-814a-2d11529a27d7",
                                        "glosses": [
                                            "Période écoulée depuis la naissance d’un être vivant ou la fabrication ou apparition d’une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69849946-ed49-4925-a34e-99ac9e70fdaf",
                                                "sense_id": "00758dc2-724d-3f32-b128-525143f47b80",
                                                "text": "On connaît l’âge d’un arbre au nombre des cercles concentriques que présente sa tige coupée transversalement."
                                            },
                                            {
                                                "example_id": "b862b3b8-9e71-487b-b04b-6987142a10c5",
                                                "sense_id": "00758dc2-724d-3f32-b128-525143f47b80",
                                                "text": "Ce vin a dix ans d’âge. — L’âge de la Terre."
                                            },
                                            {
                                                "example_id": "a610ba82-730c-4080-b36b-7e37a1b32c42",
                                                "sense_id": "00758dc2-724d-3f32-b128-525143f47b80",
                                                "text": "Je ne suis pas arrivé à l’âge de quatre-vingt ans pour rétracter en rien les convictions de ma vie entière."
                                            },
                                            {
                                                "example_id": "47785787-1c38-4a37-8f43-571cc9d12c70",
                                                "sense_id": "00758dc2-724d-3f32-b128-525143f47b80",
                                                "text": "C’est dommage d’éternuer dans le son à son âge…"
                                            },
                                            {
                                                "example_id": "340fd4f6-49c9-4567-94de-be204415ad37",
                                                "sense_id": "00758dc2-724d-3f32-b128-525143f47b80",
                                                "text": "C’est avec de telles calembredaines que les prêtres s’imaginent piper la confiance des enfants à l’âge où, précisément, ils commencent à discerner qu’ils n’ont pas poussé dans les choux."
                                            },
                                            {
                                                "example_id": "f4d3f4cb-8ece-4c31-98c2-f9056396371a",
                                                "sense_id": "00758dc2-724d-3f32-b128-525143f47b80",
                                                "text": "Par ailleurs, les sondages effectués démontrent que l’âge moyen du campeur adulte est passé de 28 ans en 1954 à 38 ans en 1964."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "600a14bb-6436-3c1b-b93a-2a0f9f67e901",
                                        "entry_id": "1fc27b2c-af89-3315-814a-2d11529a27d7",
                                        "glosses": [
                                            "Chacune des parties de la vie d’une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61e45665-4dce-4a39-985c-d816fcccf25c",
                                                "sense_id": "600a14bb-6436-3c1b-b93a-2a0f9f67e901",
                                                "text": "J’avais vingt ans. Je ne laisserai personne dire que c’est le plus bel âge de la vie."
                                            },
                                            {
                                                "example_id": "520921be-107d-4d0c-b580-e964eef34714",
                                                "sense_id": "600a14bb-6436-3c1b-b93a-2a0f9f67e901",
                                                "text": "— Ça sert à rien de pleurer… On est tous pour y passer un jour ou l’autre.\n— C’était tout de même plus de mon âge que du sien."
                                            },
                                            {
                                                "example_id": "390682b6-b380-4fe4-94ae-7e53805262d3",
                                                "sense_id": "600a14bb-6436-3c1b-b93a-2a0f9f67e901",
                                                "text": "Passionné de mathématiques dès mon plus jeune âge, j’ai toujours voulu comprendre le pourquoi et le comment du monde qui nous entoure."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fdbb53b-006a-3f73-8f46-412563e6b009",
                                        "entry_id": "1fc27b2c-af89-3315-814a-2d11529a27d7",
                                        "glosses": [
                                            "Âge requis par les lois, pour certains actes, pour certaines fonctions de la société civile."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "244dae70-3a36-4dfc-aab4-b6c5852d2534",
                                                "sense_id": "9fdbb53b-006a-3f73-8f46-412563e6b009",
                                                "text": "Elle ne peut se marier, parce qu’elle n’en a pas l’âge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "769cedc3-f9bf-32b8-9e05-712931ce7c41",
                                        "entry_id": "1fc27b2c-af89-3315-814a-2d11529a27d7",
                                        "glosses": [
                                            "Avancement dans la vie, progrès de la vie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35f08423-4c9e-4733-95c8-8ea28d4f0c95",
                                                "sense_id": "769cedc3-f9bf-32b8-9e05-712931ce7c41",
                                                "text": "On se corrige avec l’âge. — La raison vient avec l’âge. — L’âge amène la raison. — L’âge a calmé ses passions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28c80b17-56e7-3965-a590-ff4a02b3e269",
                                        "entry_id": "1fc27b2c-af89-3315-814a-2d11529a27d7",
                                        "glosses": [
                                            "Vieillesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "945b5bc8-336f-4fd4-a66d-78bbe1d9bc65",
                                                "sense_id": "28c80b17-56e7-3965-a590-ff4a02b3e269",
                                                "text": "'Âge relativement avancé. — Les effets, le poids de l’âge. — L’âge ralentit ses pas."
                                            },
                                            {
                                                "example_id": "e6eb84d6-0919-49e3-a20f-81415a776778",
                                                "sense_id": "28c80b17-56e7-3965-a590-ff4a02b3e269",
                                                "text": "D’abord, il avait gagé une femme d’âge, très bonne, très douce pour les petits, mais malpropre et tout à fait incapable de faire marcher la maison."
                                            },
                                            {
                                                "example_id": "4a948f68-b1ec-401d-9f17-0fb584e90ce2",
                                                "sense_id": "28c80b17-56e7-3965-a590-ff4a02b3e269",
                                                "text": "Nous y trouvâmes le petit Bresson et un de ses amis, un quadragénaire. Cet homme d’âge flirta avec Poupette et lui offrit des violettes tandis que je causais avec Riquet qui me fit une ardente apologie de Jacques."
                                            },
                                            {
                                                "example_id": "33e24306-577e-4a49-bc07-383dbadd9971",
                                                "sense_id": "28c80b17-56e7-3965-a590-ff4a02b3e269",
                                                "text": "La logeuse est une personne d'âge secondée par une domestique sans zèle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00ef6891-c630-3342-89c1-3b1c938e0813",
                                        "entry_id": "1fc27b2c-af89-3315-814a-2d11529a27d7",
                                        "glosses": [
                                            "Durée ordinaire de la vie."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d9f0967b-1b0f-4063-9f6e-483889448e04",
                                                "sense_id": "00ef6891-c630-3342-89c1-3b1c938e0813",
                                                "text": "L’âge de l’homme ne passe pas communément quatre-vingts ans."
                                            },
                                            {
                                                "example_id": "46724b79-5e7a-4147-8d8b-7a6f3b802b3e",
                                                "sense_id": "00ef6891-c630-3342-89c1-3b1c938e0813",
                                                "text": "L’âge des chevaux n’est guère que de trente ans."
                                            },
                                            {
                                                "example_id": "e47a9ec8-6fb2-4cff-bc36-357d1ac828e0",
                                                "sense_id": "00ef6891-c630-3342-89c1-3b1c938e0813",
                                                "text": "Il n’a pas duré âge d’homme : il n’a pas atteint la durée commune de la vie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcfb5585-e702-3f33-8220-41dc14a11305",
                                        "entry_id": "1fc27b2c-af89-3315-814a-2d11529a27d7",
                                        "glosses": [
                                            "Un certain nombre de siècles, période de l’Histoire, période de la mythologie gréco-latine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "900e169f-272e-4373-94db-473d27ea20b5",
                                                "sense_id": "bcfb5585-e702-3f33-8220-41dc14a11305",
                                                "text": "Invisible et sans rien troubler de ma présence, comme un Zeus vêtu d’air aux âges d’innocence, que ne puis-je « inspecter » le grand travail des champs !"
                                            },
                                            {
                                                "example_id": "da609365-ffa0-4f3d-b929-12935107ec7a",
                                                "sense_id": "bcfb5585-e702-3f33-8220-41dc14a11305",
                                                "text": "Les textes, quoique confus, laissent pourtant distinguer trois âges, le patriarcal, celui où le prêtre apparaît, enfin l’âge où le magisme médo-caldéen se greffe sur la Perse."
                                            },
                                            {
                                                "example_id": "c7c26513-9804-4262-8560-984275a6983b",
                                                "sense_id": "bcfb5585-e702-3f33-8220-41dc14a11305",
                                                "text": "Je leur souhaite, comme vœu du Jour de l’An, de mener à bien leur entreprise et de ramener sur la terre l’âge évangélique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
