                        "entry_id": "38568ac5-cef3-3f5f-be3c-de96d634fb1c",
                        "glosses": [
                            "Région autonome du nord de la Serbie."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "1c67b64e-eeee-4a01-af73-cf03b0b696ec",
                                "sense_id": "c89a5c5b-aec3-329d-b5bf-3ec988245aea",
                                "text": "Au contraire les milices serbes parviennent à « décroatiser » la Slavonie et une partie de la Dalmatie, et « serbiser » la Voïvodine."
                            },
                            {
                                "example_id": "f44c05f6-600a-4655-8ca9-ad00ee5f2de1",
                                "sense_id": "c89a5c5b-aec3-329d-b5bf-3ec988245aea",
                                "text": "La Voïvodine, l’oasis yougoslave épargnée par la guerre"
                            }
                        ]
                    }
