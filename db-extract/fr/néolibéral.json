                        "form": "néolibéraux"
                    },
                    {
                        "form_id": "ea943db6-bba9-4ea9-a872-3c7116f923f8",
                        "entry_id": "f4148b13-a4ba-3754-9edb-236907fc611e",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "néolibérale"
                    },
                    {
                        "form_id": "935a918f-1012-43b8-bc3e-4db9af85e88f",
                        "entry_id": "f4148b13-a4ba-3754-9edb-236907fc611e",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "néolibérales"
                    },
                    {
                        "form_id": "276f23a0-2b90-40a5-91f1-273d0038ee1a",
                        "entry_id": "f4148b13-a4ba-3754-9edb-236907fc611e",
                        "tags": [
                            "orthographe traditionnelle"
                        ],
                        "form": "néo-libéral"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e3a7991f-5e69-34fb-8b6c-278463525e99",
                        "entry_id": "f4148b13-a4ba-3754-9edb-236907fc611e",
                        "glosses": [
                            "Relatif au néolibéralisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b65c196a-75a0-4e51-aae5-f81182e1db5b",
                                "sense_id": "e3a7991f-5e69-34fb-8b6c-278463525e99",
                                "text": "Ce souci de la justice sociale appartient justement au cours le plus intérieur de l’histoire de la gauche ; or, après trois décennies d’hégémonie idéologique néolibérale et de pari sur la main invisible du marché, les retombées délétères du capitalisme de casino et l’effilochage du lien social qu’il entraine semble redonner, au moins sur une partie de la scène académique, une nouvelle actualité à ce souci."
                            },
                            {
                                "example_id": "ecf50f2d-b987-414b-8b3c-a1f7cffff0ab",
                                "sense_id": "e3a7991f-5e69-34fb-8b6c-278463525e99",
                                "text": "Au cœur du modèle néolibéral, le libre-échange sans précaution a accru le phénomène des délocalisations."
                            },
                            {
                                "example_id": "786a0e76-d1b6-4358-8db3-ca9149840092",
                                "sense_id": "e3a7991f-5e69-34fb-8b6c-278463525e99",
                                "text": "Sans cela, un programme néolibéral ne peut pas remporter ses indispensables victoires sur le marché électoral, ni un gouvernement néolibéral résister longtemps, dans l’hypothèse où il serait dépourvu de toute base sociale autre qu’oligarchique, à des confrontations sociales de grande ampleur."
                            },
                            {
                                "example_id": "969c1ff1-73c9-4527-9722-a8e084201426",
                                "sense_id": "e3a7991f-5e69-34fb-8b6c-278463525e99",
                                "text": "Les politiques néolibérales ont affaibli considérablement les droits sociaux et le gouvernement ne doit pas profiter de cette crise pour aller encore plus loin, ainsi que le fait craindre le texte de loi d’urgence sanitaire."
                            },
                            {
                                "example_id": "982374b5-c7ae-471a-bfd2-f7436b8e44aa",
                                "sense_id": "e3a7991f-5e69-34fb-8b6c-278463525e99",
                                "text": "Mais elle touche à des points sensibles de notre expérience, comme lorsque Byung-Chul Han dénonce le nouvel idéal néolibéral de la performance qui fait que chacun est mis en demeure de s’auto-exploiter lui-même, au risque de la dépression et du burn-out."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d4ccc61a-1016-4403-a63a-fedc64b9ff43",
                        "source_entry_id": "f4148b13-a4ba-3754-9edb-236907fc611e",
                        "source_sense_id": "e3a7991f-5e69-34fb-8b6c-278463525e99",
                        "target_lang_word": "neoliberal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neoliberal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57101d6f-4e58-319f-994a-a51ad60481ce",
                                        "entry_id": "e360e6b8-8083-3cb9-9a5c-db7e3c71a922",
                                        "glosses": [
                                            "In accordance with, or subscribing to, neoliberalism."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92292c7d-75fe-4db2-a552-437f82050f35",
                                                "sense_id": "57101d6f-4e58-319f-994a-a51ad60481ce",
                                                "text": "She showed that homonormativity, within the overarching framework of a heteronormative society, has a class dimension: it reflects the ways that a layer of lesbian/gay people are adapting in order to occupy a secure niche within the neoliberal order."
                                            },
                                            {
                                                "example_id": "6f446f09-2fd4-437c-9d11-0e28818094f1",
                                                "sense_id": "57101d6f-4e58-319f-994a-a51ad60481ce",
                                                "text": "The masculine discourse of the street workout includes a combination of concepts of strong physicality significant for traditional models of masculinity, alongside neoliberal discourses of individual responsibility for bodily self-production."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "neoliberal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87903c3f-a0ea-32a9-92f6-bbb1725fb7a5",
                                        "entry_id": "98d113b9-8c2c-3fd3-a07f-10eaa7e0f9c9",
                                        "glosses": [
                                            "A person who subscribes to neoliberalism."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "372c8272-ddc0-4b68-b5c5-14d2c689e82b",
                                                "sense_id": "87903c3f-a0ea-32a9-92f6-bbb1725fb7a5",
                                                "text": "The neoliberals stand today in somewhat the position neoconservatives occupied a decade ago. Their ambition is to attain the influence in liberal politics that the neoconservatives have attained in conservative politics."
                                            },
                                            {
                                                "example_id": "ab07dda0-cea6-444c-879d-62b0fe1d434f",
                                                "sense_id": "87903c3f-a0ea-32a9-92f6-bbb1725fb7a5",
                                                "text": "Neoliberals readily admit that economic liberalization causes some dislocations, but they view such collateral damage as necessary for the longer term gains of increased productivity and efficiency."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d38b40a4-5af8-41c9-86df-94cfca85d780",
                        "source_entry_id": "f4148b13-a4ba-3754-9edb-236907fc611e",
