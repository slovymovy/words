                            {
                                "example_id": "54b789d0-fb74-4251-a09f-2ff82f5fd9de",
                                "sense_id": "f7146f3e-6a79-3e2a-9273-af85825581a2",
                                "text": "Tijdens zijn ziekte had hij verwarrende koortsdromen.",
                                "translation": "During his illness, he had confusing fever dreams.",
                                "english": "During his illness, he had confusing fever dreams."
                            },
                            {
                                "example_id": "80de89c3-cb97-43b8-bbdc-3f06b27b1b74",
                                "sense_id": "f7146f3e-6a79-3e2a-9273-af85825581a2",
                                "text": "De patiënt ervoer angstaanjagende visioenen tijdens zijn koortsdromen",
                                "translation": "The patient experienced frightening visions during his fever dreams.",
                                "english": "The patient experienced frightening visions during his fever dreams."
                            },
                            {
                                "example_id": "be43f5cb-e68a-45f4-98ff-73b55cce10f3",
                                "sense_id": "f7146f3e-6a79-3e2a-9273-af85825581a2",
                                "text": "Ze had hoge koorts en haar koortsdromen waren intens en surrealistisch.",
                                "translation": "She had a high fever, and her fever dreams were intense and surreal.",
                                "english": "She had a high fever, and her fever dreams were intense and surreal."
                            }
                        ]
                    }
