{
    "word_family": [
        "piracy",
        "piratical",
        "piratically"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "429decd8-b0ac-31ec-86d3-da0cc6c32afa",
                    "sense_definition": "A criminal who attacks and steals from ships at sea.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sea_robbery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>pirate</w> boarded the merchant ship looking for gold and valuable cargo.",
                            "target_lang_translations": {
                                "ru": "<w>Пират</w> поднялся на борт торгового судна в поисках золота и ценного груза.",
                                "zh": "<w>海盗</w>登上了商船，寻找黄金和贵重货物。"
                            }
                        },
                        {
                            "text": "Stories about a famous <w>pirate</w> burying treasure on a desert island are popular with children.",
                            "target_lang_translations": {
                                "ru": "Истории об известном <w>пирате</w>, зарывающем сокровища на необитаемом острове, популярны среди детей.",
                                "zh": "关于一位著名<w>海盗</w>在荒岛上埋藏宝藏的故事在孩子们中间很受欢迎。"
                            }
                        }
                    ],
                    "synonyms": [
                        "buccaneer",
                        "corsair",
                        "freebooter",
                        "sea-robber"
                    ],
                    "common_phrases": [
                        "pirate ship",
                        "pirate treasure",
                        "pirate attack",
                        "pirate flag"
                    ],
                    "target_lang_definitions": {
                        "ru": "Преступник, который нападает на корабли и грабит их в море.",
                        "zh": "在海上袭击并抢劫船只的罪犯。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пират",
                                "target_lang_sense_clarification": "морской разбойник"
                            },
                            {
                                "target_lang_word": "корсар",
                                "target_lang_sense_clarification": "исторический термин"
                            },
                            {
                                "target_lang_word": "флибустьер",
                                "target_lang_sense_clarification": "исторический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "海盗",
                                "target_lang_sense_clarification": "海上抢劫者"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29286524-3f06-34ef-9f5b-e133684bbf65",
                    "sense_definition": "A person who illegally copies and distributes copyrighted works, such as software, music, or movies.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "ip_theft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software company sued the <w>pirate</w> for selling illegal copies of their program.",
                            "target_lang_translations": {
                                "ru": "Компания-разработчик программного обеспечения подала в суд на <w>пирата</w> за продажу нелегальных копий их программы.",
                                "zh": "软件公司起诉了那名<w>盗版者</w>，因为他销售该程序的非法副本。"
                            }
                        },
                        {
                            "text": "He felt like a <w>pirate</w> when he downloaded the movie without paying for it.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя <w>пиратом</w>, когда скачивал фильм, не заплатив за него.",
                                "zh": "当他没付钱就下载电影时，他觉得自己像个<w>盗版者</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bootlegger"
                    ],
                    "common_phrases": [
                        "software pirate",
                        "internet pirate",
                        "music pirate"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common term for copyright infringer"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который незаконно копирует и распространяет защищенные авторским правом произведения, такие как программное обеспечение, музыка или фильмы.",
                        "zh": "非法复制和分发受版权保护的作品（如软件、音乐或电影）的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пират",
                                "target_lang_sense_clarification": "нарушитель авторских прав"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "盗版者",
                                "target_lang_sense_clarification": "侵犯版权的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "310ece7d-2131-3a54-9224-31aa35785c66",
                    "sense_definition": "An armed ship used for attacking and robbing other vessels.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sea_robbery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain spotted a <w>pirate</w> on the horizon and ordered the crew to prepare for battle.",
                            "target_lang_translations": {
                                "ru": "Капитан заметил <w>пиратское судно</w> на горизонте и приказал команде готовиться к бою.",
                                "zh": "船长在海平线上发现了<w>海盗船</w>，并命令船员准备战斗。"
                            }
                        },
                        {
                            "text": "It was a fast <w>pirate</w> that could easily overtake the heavy cargo vessels.",
                            "target_lang_translations": {
                                "ru": "Это был быстроходный <w>пиратский корабль</w>, который мог легко догнать тяжелые грузовые суда.",
                                "zh": "那是一艘快速的<w>海盗船</w>，可以轻易追上笨重的货船。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вооруженный корабль, используемый для нападения и грабежа других судов.",
                        "zh": "用于攻击和抢劫其他船只的武装船只。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пиратское судно",
                                "target_lang_sense_clarification": "корабль"
                            },
                            {
                                "target_lang_word": "пиратский корабль",
                                "target_lang_sense_clarification": "корабль"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "海盗船",
                                "target_lang_sense_clarification": "用于抢劫的船只"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a371b309-6838-3b7a-95c6-ac28f1a960fc",
                    "sense_definition": "To illegally copy, use, or sell copyrighted material without permission.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "ip_theft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many students <w>pirate</w> software because they cannot afford the full price.",
                            "target_lang_translations": {
                                "ru": "Многие студенты <w>пиратят</w> программное обеспечение, потому что не могут позволить себе полную стоимость.",
                                "zh": "许多学生因为买不起全价软件而进行<w>盗版</w>。"
                            }
                        },
                        {
                            "text": "It is illegal to <w>pirate</w> movies and share them on the internet.",
                            "target_lang_translations": {
                                "ru": "Незаконно <w>пиратить</w> фильмы и распространять их в интернете.",
                                "zh": "<w>盗版</w>电影并在互联网上分享是违法的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "counterfeit"
                    ],
                    "common_phrases": [
                        "pirate software",
                        "pirate music",
                        "pirate movies"
                    ],
                    "target_lang_definitions": {
                        "ru": "Незаконно копировать, использовать или продавать защищенные авторским правом материалы без разрешения.",
                        "zh": "未经许可非法复制、使用或销售受版权保护的材料。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пиратить",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "незаконно копировать",
                                "target_lang_sense_clarification": "формальное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "盗版",
                                "target_lang_sense_clarification": "非法复制"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11fcc649-11f7-3f20-a64c-2f8a93bed26c",
                    "sense_definition": "To attack and steal from a ship at sea.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sea_robbery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gang planned to <w>pirate</w> the tanker as it passed through the narrow strait.",
                            "target_lang_translations": {
                                "ru": "Банда планировала <w>захватить</w> танкер, когда он проходил через узкий пролив.",
                                "zh": "该团伙计划在油轮通过狭窄海峡时对其进行<w>劫掠</w>。"
                            }
                        },
                        {
                            "text": "He <w>pirated</w> in the Atlantic for years before being caught by the navy.",
                            "target_lang_translations": {
                                "ru": "Он <w>пиратствовал</w> в Атлантике много лет, прежде чем был пойман флотом.",
                                "zh": "他在大西洋上<w>劫掠</w>多年，最终被海军抓获。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нападать на корабли и грабить их в море.",
                        "zh": "在海上袭击并抢劫船只。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пиратствовать",
                                "target_lang_sense_clarification": "заниматься морским разбоем"
                            },
                            {
                                "target_lang_word": "грабить",
                                "target_lang_sense_clarification": "захватывать суда"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "劫掠",
                                "target_lang_sense_clarification": "海上抢劫"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "261a1eaf-5397-39fe-aa96-5d0a3372cf55",
                    "sense_definition": "Relating to or being an illegally reproduced copy of a copyrighted work.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ip_theft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She unknowingly bought a <w>pirate</w> DVD at the street market.",
                            "target_lang_translations": {
                                "ru": "Она по незнанию купила <w>пиратский</w> DVD на уличном рынке.",
                                "zh": "她在街头市场无意中买到了一张<w>盗版</w>DVD。"
                            }
                        },
                        {
                            "text": "The <w>pirate</w> radio station broadcasted music that was banned on official channels.",
                            "target_lang_translations": {
                                "ru": "<w>Пиратская</w> радиостанция транслировала музыку, запрещенную на официальных каналах.",
                                "zh": "那家<w>非法</w>广播电台播放了官方频道禁止的音乐。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pirated",
                        "counterfeit"
                    ],
                    "common_phrases": [
                        "pirate copy",
                        "pirate radio",
                        "pirate edition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к незаконно воспроизведенной копии произведения, защищенного авторским правом, или являющийся ею.",
                        "zh": "指非法复制的受版权保护的作品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пиратский",
                                "target_lang_sense_clarification": "нелицензионный"
                            },
                            {
                                "target_lang_word": "контрафактный",
                                "target_lang_sense_clarification": "поддельный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "盗版的",
                                "target_lang_sense_clarification": "非法的"
                            },
                            {
                                "target_lang_word": "非法",
                                "target_lang_sense_clarification": "未经授权的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7bd5d4a2-6aa6-35a1-856f-9d7cbf9da2aa",
                    "sense_definition": "A player, coach, or fan connected with a sports team known as the Pirates.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "He has been a loyal <w>Pirate</w> for twenty years and never misses a game.",
                            "target_lang_translations": {
                                "ru": "Он был преданным <w>«Пиратом»</w> в течение двадцати лет и никогда не пропускает игры.",
                                "zh": "他做了二十年的忠实<w>海盗队</w>球迷，从未错过一场比赛。"
                            }
                        },
                        {
                            "text": "The <w>Pirates</w> celebrated their victory on the field after the final whistle.",
                            "target_lang_translations": {
                                "ru": "<w>«Пираты»</w> праздновали свою победу на поле после финального свистка.",
                                "zh": "终场哨响后，<w>海盗队</w>在场上庆祝他们的胜利。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Игрок, тренер или болельщик, связанный со спортивной командой, известной как «Пайрэтс» (Пираты).",
                        "zh": "与被称为“海盗队”的运动队相关的球员、教练或球迷。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "«Пират»",
                                "target_lang_sense_clarification": "член команды"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "海盗队成员",
                                "target_lang_sense_clarification": "球队相关人员"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}