                "senses": [
                    {
                        "sense_id": "2f448e74-9747-3675-9f2f-364926a8a8bc",
                        "entry_id": "ff62a6ff-05e3-3b82-a2bf-c73c5d82a31b",
                        "glosses": [
                            "Essayer de rouler, considérer ceux à qui on s’adresse comme des jobards."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97c1a2f5-9a77-4088-95b6-f97b34ba6a9b",
                                "sense_id": "2f448e74-9747-3675-9f2f-364926a8a8bc",
                                "text": "Bon d’accord, pour l’instant son cours se contente de \"laisser entrevoir de belles perspectives\" comme l’on dit autour de la corbeille pour \"jobardiser\" les investisseurs."
                            },
                            {
                                "example_id": "4b5ab719-7be8-4dc8-8183-7f8773e9cf98",
                                "sense_id": "2f448e74-9747-3675-9f2f-364926a8a8bc",
                                "text": "En tant que Marocain lambda, j’ai retenu mon souffle devant cet événement ostentatoire destiné, sans aucun doute, à jobardiser les petites gens des hameaux d’Aghbal."
                            },
                            {
                                "example_id": "2b76b959-6952-4f3f-86e3-38182e57d7bb",
                                "sense_id": "2f448e74-9747-3675-9f2f-364926a8a8bc",
                                "text": "Toujours à colporter des rumeurs, à jobardiser, toujours là pour le cirque où des clowns dans son genre font le trottoir des espérances."
                            }
                        ]
                    }
                ],
