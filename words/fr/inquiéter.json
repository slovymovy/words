                    "semantic_group_id": "sentiment_anxiete",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne t'<w>inquiète</w> pas pour moi, le train arrive dans quelques minutes.",
                            "target_lang_translations": {
                                "en": "Don't <w>worry</w> about me, the train is arriving in a few minutes.",
                                "ru": "Не <w>волнуйся</w> за меня, поезд прибывает через несколько минут.",
                                "nl": "Maak je geen <w>zorgen</w> om mij, de trein komt over een paar minuten.",
                                "de": "Du musst dir um mich keine <w>Sorgen machen</w>, der Zug kommt in ein paar Minuten.",
                                "pl": "Nie <w>martw się</w> o mnie, pociąg przyjedzie za kilka minut.",
                                "it": "Non <w>preoccuparti</w> per me, il treno arriva tra pochi minuti.",
                                "cs": "<w>Nedělej si starosti</w> o mě, vlak přijede za pár minut.",
                                "tr": "Benim için <w>endişelenme</w>, tren birkaç dakika içinde geliyor.",
                                "es": "No te <w>preocupes</w> por mí, el tren llega en unos minutos.",
                                "zh": "不用为我<w>担心</w>，火车再过几分钟就到了。"
                            }
                        },
                        {
                            "text": "Elle s'<w>inquiète</w> toujours quand ses enfants rentrent tard de l'école.",
                            "target_lang_translations": {
                                "en": "She always <w>worries</w> when her children come home late from school.",
                                "ru": "Она всегда <w>волнуется</w>, когда её дети поздно возвращаются из школы.",
                                "nl": "Ze maakt zich altijd <w>zorgen</w> wanneer haar kinderen laat van school thuiskomen.",
                                "de": "Sie macht sich immer <w>Sorgen</w>, wenn ihre Kinder spät aus der Schule heimkommen.",
                                "pl": "Ona zawsze <w>martwi się</w>, kiedy jej dzieci wracają późno ze szkoły.",
                                "it": "Si <w>preoccupa</w> sempre quando i suoi figli tornano tardi da scuola.",
                                "cs": "Vždycky <w>si dělá starosti</w>, když se její děti vracejí pozdě ze školy.",
                                "tr": "Çocukları okuldan geç eve döndüğünde her zaman <w>endişelenir</w>.",
                                "es": "Siempre se <w>preocupa</w> cuando sus hijos vuelven tarde del colegio.",
                                "zh": "每当孩子们放学晚回家，她总是很<w>担心</w>。"
                            }
                        }
