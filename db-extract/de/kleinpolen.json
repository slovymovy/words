                "senses": [
                    {
                        "sense_id": "49ab22e5-97c8-3ddf-97a2-54a265e61ddf",
                        "entry_id": "31c1cf52-888b-3a26-976b-9e0fb79ee453",
                        "glosses": [
                            "historisches Gebiet im Süden Polens/Westen der Ukraine mit den Metropolen Krakau, Lublin, Zamość und Sandomierz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e96f8e6b-f50b-4320-bd0b-61e505bcb496",
                                "sense_id": "49ab22e5-97c8-3ddf-97a2-54a265e61ddf",
                                "text": "„»Die Armee wartet nur auf das Zeichen!« nahm der Major der Garde Czyz das Wort: »Kleinpolen ist bereit, dreizehntausend konföderierte Truppen harren im Krakauischen ...«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "93251d68-b3f4-38d1-b4a1-a77e46977338",
                        "entry_id": "31c1cf52-888b-3a26-976b-9e0fb79ee453",
                        "glosses": [
                            "Woiwodschaft im Süden Polens an der Grenze zur Slowakei"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2d8c70d-0e14-4f0b-8594-cac6073ebe22",
                                "sense_id": "93251d68-b3f4-38d1-b4a1-a77e46977338",
                                "text": "„Aus Kronpolen hatte indessen der Fürst bessere Nachrichten. Dort übertraf das Vorgehen der Schweden alle Erwartungen. Eine Wojewodschaft nach der anderen ergab sich freiwillig; in Großpolen regierten die Schweden wie im eigenen Vaterlande; in Warschau herrschte Radziejowski, Kleinpolen hatte den Widerstand aufgegeben.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
