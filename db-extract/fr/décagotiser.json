                "senses": [
                    {
                        "sense_id": "bba488e1-76d1-3c60-b531-3d00ae17eafe",
                        "entry_id": "160b372f-0282-3f58-af7e-a6c624c74fb4",
                        "glosses": [
                            "Faire perdre son caractère de cagot à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "150ea7e3-e4a3-45ac-968e-7595f077ce5e",
                                "sense_id": "bba488e1-76d1-3c60-b531-3d00ae17eafe",
                                "text": "Un dicton veut qu’en Béarn, l’époux « décagotise » sa femme."
                            },
                            {
                                "example_id": "98256879-ab7f-44bd-9746-0f3bb98cb5e5",
                                "sense_id": "bba488e1-76d1-3c60-b531-3d00ae17eafe",
                                "text": "En pratique cet usage, si répandu qu’il ait pu être, n’était pas absolu, puisqu’un proverbe béarnais dit que « le mari décagotise sa femme »."
                            }
                        ]
                    }
