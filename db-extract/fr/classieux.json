                    }
                ],
                "senses": [
                    {
                        "sense_id": "0c89f35a-17a5-3deb-8ce5-dc82de6e434c",
                        "entry_id": "c25ef25f-6c76-3e5e-bef1-76c211fb7e3c",
                        "glosses": [
                            "Qui a beaucoup de classe."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "42b267e3-c4e9-4533-badc-aa03fc0303c0",
                                "sense_id": "0c89f35a-17a5-3deb-8ce5-dc82de6e434c",
                                "text": "Une démarche classieuse."
                            },
                            {
                                "example_id": "258d9da0-b757-4c39-be08-38a7823a8797",
                                "sense_id": "0c89f35a-17a5-3deb-8ce5-dc82de6e434c",
                                "text": "Classieux : exclamation gainsboroïde qui qualifie ce qui présente une certaine classe."
                            },
                            {
                                "example_id": "f36441f7-449f-440a-bdd9-14cbc546e9db",
                                "sense_id": "0c89f35a-17a5-3deb-8ce5-dc82de6e434c",
                                "text": "C’est très local, disons, pas du tout le genre d’endroit où on va pour trouver quelque chose de classieux. C’est rempli de nomiya où on consomme debout et de game centers aux couleurs fanées, où contre une librairie indépendante dont la bicoque penche d’un côté on trouve un restaurant de viande grillée long et étroit comme un couloir, lui-même accolé à un club de rencontres clinquant à piquer les yeux ; ensuite on a un restaurant de fugu, sauf que dès la première bouchée tu peux être sûre que celui-là n’a jamais vu de vrai fugu de sa vie ni de près ni de loin, le fond sonore est gracieusement offert par le pachinko d’à côté, il y a des loupiotes qui clignotent, un café très, mais alors très sombre avec des tables de mah-jong intégrées, un graveur de sceaux où personne n’a jamais vu le moindre employé ni le moindre client, et cetera et cetera ; on entend des hurlements de disputes, des rires, il y a des montagnes de bouteilles de bière cassées sur le côté de la rue, c’est un capharnaüm indescriptible."
                            },
                            {
                                "example_id": "bfd2b747-c309-4c82-9b4b-419d8106298e",
                                "sense_id": "0c89f35a-17a5-3deb-8ce5-dc82de6e434c",
                                "text": "À Europe 1, les nouveaux présentateurs ne sont pas encore arrivés, mais le nouveau style, classieux, est déjà là."
                            },
                            {
                                "example_id": "c56378cc-db24-44ac-bfcf-d686027a70b0",
                                "sense_id": "0c89f35a-17a5-3deb-8ce5-dc82de6e434c",
                                "text": "Merde, si j’avais été Freddy, j’aurais certainement su dire des trucs drôlement classieux et elle serait tombée raide dingue de moi aussi sec..."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "7c3e071f-9452-376b-a3ce-d5d06a9d5235",
                "word": "classieux",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "479e4451-3037-39b6-b809-f0ed4b7fc9c9",
                        "entry_id": "7c3e071f-9452-376b-a3ce-d5d06a9d5235",
                        "glosses": [
                            "Ce qui a une apparence chic, classe."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "c0301f59-9328-465f-b974-1e94419e0d70",
                                "sense_id": "479e4451-3037-39b6-b809-f0ed4b7fc9c9",
                                "text": "Ça respire le classieux, le solide, le confort, la banque, l'argent,..."
                            }
                        ]
                    },
                    {
                        "sense_id": "55544496-8005-35f5-aeaa-5e71ba47df53",
                        "entry_id": "7c3e071f-9452-376b-a3ce-d5d06a9d5235",
                        "glosses": [
                            "Personne qui a de la classe, de l'élégance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edd53f2e-7b4b-4a48-95e9-dd0172f9e2d9",
                                "sense_id": "55544496-8005-35f5-aeaa-5e71ba47df53",
                                "text": "On devrait l'appeler Mazeau le classieux."
                            },
                            {
                                "example_id": "85ad3e4e-4719-444b-8e98-f1c1e74a41f1",
                                "sense_id": "55544496-8005-35f5-aeaa-5e71ba47df53",
                                "text": "On termine maintenant avec Driss, le classieux : étant donné que tu es le crack, tu avais droit au problème le plus coriace."
                            },
                            {
                                "example_id": "4ce82b3e-d571-4f84-bd78-5fc1cf383fe3",
                                "sense_id": "55544496-8005-35f5-aeaa-5e71ba47df53",
                                "text": "Le menu fretin regarde passer les classieux même habillés en mode zonard."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7facd089-4113-4403-928c-47a94b1c5d84",
                        "source_entry_id": "7c3e071f-9452-376b-a3ce-d5d06a9d5235",
                        "target_lang_word": "классный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "классный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7aed45f1-6bab-3f22-8709-e30c8f4d87e3",
                                        "entry_id": "d78dd1ef-f2e8-3c0e-838d-36bd4189959d",
                                        "glosses": [
                                            "связанный, соотносящийся по значению с существительным класс"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d011ec7-01fe-4674-8350-a59cc85655be",
                                                "sense_id": "7aed45f1-6bab-3f22-8709-e30c8f4d87e3",
                                                "text": "Исподлобья смотрел он на классный стол, словно упирающийся бык, которого ведут под обух."
                                            },
                                            {
                                                "example_id": "8baf4db3-b06a-4d98-b521-43b29ff7a574",
                                                "sense_id": "7aed45f1-6bab-3f22-8709-e30c8f4d87e3",
                                                "text": "Он встал и покорно пошёл за нею в классную комнату."
                                            },
                                            {
                                                "example_id": "84e87896-3a82-4ff3-b8af-8c0555a6b259",
                                                "sense_id": "7aed45f1-6bab-3f22-8709-e30c8f4d87e3",
                                                "text": "В лагерное время прекращались всякие классные занятия."
                                            },
                                            {
                                                "example_id": "4c0d148a-605d-42c3-bd46-d1514b560094",
                                                "sense_id": "7aed45f1-6bab-3f22-8709-e30c8f4d87e3",
                                                "text": "На правах хозяйки она ходила при гостях в блузе, офицеров величала по фамилии, на Манюсю глядела как на девочку и говорила с нею тоном классной дамы."
                                            },
                                            {
                                                "example_id": "455662fb-d21c-4f5d-9c43-39c4bec7b3f2",
                                                "sense_id": "7aed45f1-6bab-3f22-8709-e30c8f4d87e3",
                                                "text": "Надежда Петровна раскрыла классный журнал и опустилась на стул."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7387018a-8074-3fca-b155-cbe8baf00a14",
                                        "entry_id": "d78dd1ef-f2e8-3c0e-838d-36bd4189959d",
                                        "glosses": [
                                            "спец. имеющий определённый класс, разряд, соответствующий требованиям такого класса, разряда"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a172eec9-a4a4-433c-b658-f1840be65c73",
                                                "sense_id": "7387018a-8074-3fca-b155-cbe8baf00a14",
                                                "text": "Вагон был классный, но ободранный."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78c7d899-30f3-3fff-a41f-57d83c61710a",
                                        "entry_id": "d78dd1ef-f2e8-3c0e-838d-36bd4189959d",
                                        "glosses": [
                                            "имеющий определённый ранг, чин"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ca4b9b0-7286-42b5-ab88-44d24665fe1a",
                                                "sense_id": "78c7d899-30f3-3fff-a41f-57d83c61710a",
                                                "text": "При прослужении такими лицами в должности Члена Управы не менее трёх трёхлетий, они могут быть представляемы Губернатором к производству в первый классный чин."
                                            },
                                            {
                                                "example_id": "0c997c5c-54df-47dd-a908-de9962a78f97",
                                                "sense_id": "78c7d899-30f3-3fff-a41f-57d83c61710a",
                                                "text": "Этот отряд состоял из 9 рот пехоты, 9 сотен казаков, 6 орудий казачьей конной артиллерии, 2 нарезных заряжающихся с дула орудий пешей артиллерии, ракетной батареи (6 станков) и 4 полупудовых мортир; численность всего отряда простиралась до 3474 чел., считая в числе их 107 офицеров и классных чиновников."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8231da2d-ddf7-391a-9ccd-c1b342ea2a67",
                                        "entry_id": "d78dd1ef-f2e8-3c0e-838d-36bd4189959d",
                                        "glosses": [
                                            "принадлежащий к высшему классу, разряду по квалификации, по мастерству в чём-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2be915ed-1556-405e-bb66-3e734f1cc0cb",
                                                "sense_id": "8231da2d-ddf7-391a-9ccd-c1b342ea2a67",
                                                "text": "В 1833 г. получил звание классного художника и был оставлен «для усовершенствования» ещё на 3 года в качестве пенсионера."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "411b9476-c106-3df4-8a81-96aa8dcd2e04",
                                        "entry_id": "d78dd1ef-f2e8-3c0e-838d-36bd4189959d",
                                        "glosses": [
                                            "разг. отличный, превосходный"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a4eec4a-24a5-484e-849d-03e58cea0028",
                                                "sense_id": "411b9476-c106-3df4-8a81-96aa8dcd2e04",
                                                "text": "Это была самая классная зима в моей жизни, мы с друзьями всё время проводили вместе."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
