                        ]
                    },
                    {
                        "translation_id": "56ae618a-c407-4bed-ba8a-d7ad261f62d8",
                        "source_entry_id": "ebdd4877-bf72-3dd9-a375-c860ccd6bbfa",
                        "target_lang_word": "pendule",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pendule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e848d4d9-bd22-32a4-bc51-8aedd94032d4",
                                        "entry_id": "6c0e500c-2dc1-3c30-b1c3-208aa530f004",
                                        "glosses": [
                                            "Tout système constitué d’un corps pesant, un balancier, oscillant autour d’un axe horizontal."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af5642dd-f52b-4660-a0ca-69019434db84",
                                                "sense_id": "e848d4d9-bd22-32a4-bc51-8aedd94032d4",
                                                "text": "Le pendule simple est formé d’un corps pesant suspendu à l’extrémité d’un fil sans masse."
                                            },
                                            {
                                                "example_id": "81111fc2-2440-4158-ae81-30a240b00214",
                                                "sense_id": "e848d4d9-bd22-32a4-bc51-8aedd94032d4",
                                                "text": "L’oscillation du pendule."
                                            },
                                            {
                                                "example_id": "74b7a736-0a52-4a54-842e-bfd3280c16e2",
                                                "sense_id": "e848d4d9-bd22-32a4-bc51-8aedd94032d4",
                                                "text": "L’isochronisme du pendule."
                                            },
                                            {
                                                "example_id": "b5c38b09-f312-4261-a5fe-6e9bbefd2c43",
                                                "sense_id": "e848d4d9-bd22-32a4-bc51-8aedd94032d4",
                                                "text": "Le pendule sert à régler le mouvement d’une horloge."
                                            },
                                            {
                                                "example_id": "8c82c93b-1f62-4342-9f65-04838f122d53",
                                                "sense_id": "e848d4d9-bd22-32a4-bc51-8aedd94032d4",
                                                "text": "Pendule battant la seconde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a2bc7e8-840f-3996-b55e-37122ea1fdb3",
                                        "entry_id": "6c0e500c-2dc1-3c30-b1c3-208aa530f004",
                                        "glosses": [
                                            "Sorte de corps pesant que les radiesthésistes agitent au bout d'un fil pour découvrir ce qui est caché ou perdu."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aabaf567-5f68-4d1c-b262-1a97020434ee",
                                                "sense_id": "1a2bc7e8-840f-3996-b55e-37122ea1fdb3",
                                                "text": "— Mais me regardez pas comme ça ! s'énerva-t-elle. J'suis pas une gogole, je retrouve un disparu sur quatre avec mon pendule !"
                                            },
                                            {
                                                "example_id": "8ab33287-d353-426a-9022-ccd2d23619d6",
                                                "sense_id": "1a2bc7e8-840f-3996-b55e-37122ea1fdb3",
                                                "text": "Voici la question qui semble en perturber certains. Faut-il y répondre avec des études implacables ? Avec le pendule du professeur Tournesol ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pendule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "39faf8ef-10e6-3d74-ac6f-271c8d94fed6",
                                        "entry_id": "9c1d9d66-9356-31da-a912-41c306e7493d",
                                        "glosses": [
                                            "Horloge d’appartement dont le mouvement est régularisé par les oscillations d’un pendule."
                                        ],
                                        "tags": [
                                            "Horlogerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77580034-a3f2-4a69-81f7-f54b54275926",
                                                "sense_id": "39faf8ef-10e6-3d74-ac6f-271c8d94fed6",
                                                "text": "Jetant un coup d’œil sur la pendule de la cheminée (…), j’eus le plaisir de voir que j’avais encore vingt minutes à moi."
                                            },
                                            {
                                                "example_id": "c63615cd-bff7-4de5-a375-f837849c207a",
                                                "sense_id": "39faf8ef-10e6-3d74-ac6f-271c8d94fed6",
                                                "text": "Enfin, la pendule-réclame Guérin-Boutron, fixée près d’une cabine de téléphone, marquait une fois pour toutes la demie de minuit, en cas de contestation."
                                            },
                                            {
                                                "example_id": "40be5cdf-bfd4-4f39-8f55-3fb17de7b97b",
                                                "sense_id": "39faf8ef-10e6-3d74-ac6f-271c8d94fed6",
                                                "text": "En raison du changement d’heure, survenu la même nuit, la déposante hésitait : elle avait, en se mettant au lit, retardé sa pendule pour s’épargner la peine d’y penser le lendemain, […]."
                                            },
                                            {
                                                "example_id": "dee9913e-a749-4125-be58-d761bd375719",
                                                "sense_id": "39faf8ef-10e6-3d74-ac6f-271c8d94fed6",
                                                "text": "Par la fenêtre, à travers la brume légère du matin d’hiver, je regardais la pendule de l’école : sa grande aiguille avançait par saccades, et je voyais tomber les petites minutes comme des fourmis décapitées."
                                            },
                                            {
                                                "example_id": "3465ba51-cd8c-4ca8-9136-de5f26d7419a",
                                                "sense_id": "39faf8ef-10e6-3d74-ac6f-271c8d94fed6",
                                                "text": "Une pendule tyrolienne à balancier, entre les deux fenêtres, un fauteuil au tissu de soie crème et quelques roses dans un vase, sur l'étagère du buffet, égayaient un peu ce décor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df2cff10-ba09-3fdc-8deb-aab88f60d6f2",
                                        "entry_id": "9c1d9d66-9356-31da-a912-41c306e7493d",
                                        "glosses": [
                                            "Ce qui encadre cette horloge."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2d4364c-3581-48b6-b634-ed736b93f7c6",
                                                "sense_id": "df2cff10-ba09-3fdc-8deb-aab88f60d6f2",
                                                "text": "Curieuse pendule en métal patiné représentant satyriquement Ménélik II, empereur d’Éthiopie entre 1889 et 1913. Le mouvement et le cadran inscrit dans son ventre."
                                            }
                                        ]
                                    }
                                ]
                            },
