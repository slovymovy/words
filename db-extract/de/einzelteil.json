                                "target_senses": [
                                    {
                                        "sense_id": "2c73f6c1-9953-3ba9-a98c-176a2970a66e",
                                        "entry_id": "451f107a-3e9b-36a9-af30-a8387e65326b",
                                        "glosses": [
                                            "Élément d'un ensemble plus complexe (ou composite), ou entrant dans la composition d’une autre chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "400e1d08-56a5-4015-bc11-70537e7063a6",
                                                "sense_id": "2c73f6c1-9953-3ba9-a98c-176a2970a66e",
                                                "text": "La chaux […] est le plus souvent combinée avec l’acide carbonique, et forme un corps que les chimistes appellent carbonate de chaux et qui est le principal composant des pierres calcaires."
                                            },
                                            {
                                                "example_id": "d6678bf3-ab07-438c-95e5-e27bf36d03fa",
                                                "sense_id": "2c73f6c1-9953-3ba9-a98c-176a2970a66e",
                                                "text": "J'aimerais que vous sacrifiiez un haut-parleur, et donc les quelques euros qu'il vous aura coûté. De toute façon, ce sacrifice ne sera pas inutile, car pour comprendre comment fonctionne un composant, rien de mieux que de le démonter."
                                            },
                                            {
                                                "example_id": "83ff059b-9a76-402e-acd5-a1d6f5c19ab8",
                                                "sense_id": "2c73f6c1-9953-3ba9-a98c-176a2970a66e",
                                                "text": "L’oxygène, aujourd’hui le principal composant de l’atmosphère avec l’azote, est apparu il y a environ 2,5 milliards d’année, lors de l’épisode de la « grande oxydation » provoqué par l’activité photosynthétique des bactéries dans les océans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8a8ef37-f882-34bc-9b62-d711c7d18fbc",
                                        "entry_id": "451f107a-3e9b-36a9-af30-a8387e65326b",
                                        "glosses": [
                                            "Produit fabriqué comme unité distincte pour une ou plusieurs fonctions spécifiques, destiné à être intégré dans une construction."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "composant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0d94a200-e258-33cf-9d95-8e348a0c2b71",
                                        "entry_id": "85d118d1-e2b2-385c-8765-0ea35defdebe",
                                        "glosses": [
                                            "Qui sert à composer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9d87ecd-d2f9-4c01-8f7d-77311dca207c",
                                                "sense_id": "0d94a200-e258-33cf-9d95-8e348a0c2b71",
                                                "text": "Force composante, force qui produit en se combinant une force unique nommée force résultante."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "composant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d56d7bff-af95-3636-8dc8-d0a7bd2741e3",
                                        "entry_id": "93e848b3-012c-3c85-970b-5961472aa771",
                                        "glosses": [
                                            "Participe présent de composer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b0c1f40-a967-4b6a-9a30-92bc68ddadad",
                                                "sense_id": "d56d7bff-af95-3636-8dc8-d0a7bd2741e3",
                                                "text": "Déjà quand j’étais petit garçon, répond Siméon, j’épatais mes parents en composant des itinéraires dans le jardin pour mes modèles réduits de voitures."
                                            }
                                        ]
                                    }
                                ]
                            }
