                        ],
                        "form": "immorales"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "278809bf-58b5-31bf-bea9-ed72d861eab9",
                        "entry_id": "106900a6-b503-3ce4-a656-606639c6f06c",
                        "glosses": [
                            "Qui est contraire à la morale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "600ab36e-1296-48b2-8779-b4b66dcc9266",
                                "sense_id": "278809bf-58b5-31bf-bea9-ed72d861eab9",
                                "text": "Les œuvres de l’urban fantasy se caractérisent moins par une attention aux aspects déplaisants ou désagréables de la vie urbaine qu’aux aspects immoraux de la vie contemporaine, dans le prolongement des récits du roman noir mettant en scène les personnages du vice."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a041d10-8032-35b9-b2db-69eb40a05405",
                        "entry_id": "106900a6-b503-3ce4-a656-606639c6f06c",
                        "glosses": [
                            "Qui est sans principes de morale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b6bf952-a713-4d1e-9945-7f37d909df09",
                                "sense_id": "6a041d10-8032-35b9-b2db-69eb40a05405",
                                "text": "Le chevalier d’industrie, la fille de joie, le voleur, le brigand, et l’assassin, le joueur, le bohème sont immoraux, et le brave bourgeois éprouve à l’égard de ces « gens sans mœurs » la plus vive répulsion."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d1063516-976b-4b39-b243-d30524363594",
                        "source_entry_id": "106900a6-b503-3ce4-a656-606639c6f06c",
                        "source_sense_description": "Contraire à la morale, sans morale",
                        "target_lang_word": "unmoralisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unmoralisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0a9fec04-1f94-35d1-8576-e9523b7e6ca6",
                                        "entry_id": "56b12df7-87ef-3c4c-be1a-522375c357d1",
                                        "glosses": [
                                            "ethischen Werten und Normen zuwiderlaufend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5ff7083-65ea-4590-8518-d3f56f8c6878",
                                                "sense_id": "0a9fec04-1f94-35d1-8576-e9523b7e6ca6",
                                                "text": "Mit jemandem, der sich so unmoralisch verhält, möchte ich nichts zu tun haben."
                                            },
                                            {
                                                "example_id": "24bd181f-4d07-47d1-bbd5-f97e783a6778",
                                                "sense_id": "0a9fec04-1f94-35d1-8576-e9523b7e6ca6",
                                                "text": "„Renovierungen bringen nicht nur viel Lärm und Schmutz mit sich: Wollen Vermieter ihre Mieter raushaben, setzen sie auch unmoralische Methoden an.“"
                                            },
                                            {
                                                "example_id": "7780879d-9325-41d3-93d0-e9bf21f1bf4e",
                                                "sense_id": "0a9fec04-1f94-35d1-8576-e9523b7e6ca6",
                                                "text": "„Der Hamburger SV hat zwar die Rettung in der Bundesliga erzwungen, aber dies zu einem unmoralisch hohen Preis.“"
                                            },
                                            {
                                                "example_id": "42c6d5fd-05b6-46d6-83d4-1be6ad15e2a0",
                                                "sense_id": "0a9fec04-1f94-35d1-8576-e9523b7e6ca6",
                                                "text": "„Dem Gesindel hatte er damit gleich einmal gezeigt, wer in Tratschen das Sagen hat und dass weder Verbrecher, noch unmoralische Schlampen im Ort willkommen sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1fe1f1c4-de3b-4993-86c5-39eae392b6d2",
                        "source_entry_id": "106900a6-b503-3ce4-a656-606639c6f06c",
                        "source_sense_description": "Contraire à la morale, sans morale",
                        "target_lang_word": "unsittlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unsittlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5e2abd7f-d8ef-3341-b34d-3dacc542ff89",
                                        "entry_id": "ba46b02e-dcbf-37d1-b033-f89101f5cb4a",
                                        "glosses": [
                                            "so, dass es sich nicht sittlich auswirkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "feae368b-7c84-4741-8cb7-cfbd6dae4baa",
                                                "sense_id": "5e2abd7f-d8ef-3341-b34d-3dacc542ff89",
                                                "text": "„Man kann sich also denken, wie erstaunt ich war, als ich erfuhr, daß ich im Verlage von H. G. Münchmeyer »abgrundtief unsittliche« Bücher geschrieben haben solle.“"
                                            },
                                            {
                                                "example_id": "4e95a654-f9f8-4d23-8425-3b600aace1db",
                                                "sense_id": "5e2abd7f-d8ef-3341-b34d-3dacc542ff89",
                                                "text": "„Kein Leuchtfeuer mehr, kein tief in den Boden gerammter Grenzstein, der auch dem Kurzsichtigen zeigt, was gut und böse, schön und häßlich, sittlich und unsittlich ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1a3b449-7bf4-4e1b-8f09-fa2cb13ff671",
                        "source_entry_id": "106900a6-b503-3ce4-a656-606639c6f06c",
