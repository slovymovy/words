                    "sense_id": "822bcc9a-547d-304a-a717-2f1c37c030b4",
                    "sense_definition": "Relating to or produced on the current day.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please check <w>today's</w> date on the calendar before signing.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, проверьте <w>сегодняшнюю</w> дату на календаре перед подписанием.",
                                "fr": "Veuillez vérifier la date <w>d'aujourd'hui</w> sur le calendrier avant de signer."
                            }
                        },
                        {
                            "text": "I want to hear <w>today's</w> news before I go to sleep.",
                            "target_lang_translations": {
                                "ru": "Я хочу послушать <w>сегодняшние</w> новости перед сном.",
                                "fr": "Je veux écouter les informations <w>du jour</w> avant d'aller dormir."
                            }
                        }
                    ],
                    "common_phrases": [
