                            {
                                "target_lang_word": "кита́йская гра́мота",
                                "target_lang_sense_clarification": "идиома: что-то непонятное"
                            },
                            {
                                "target_lang_word": "тараба́рщина",
                                "target_lang_sense_clarification": "бессмыслица"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "天书",
                                "target_lang_sense_clarification": "比喻难以理解的文字"
                            },
                            {
                                "target_lang_word": "胡言乱语",
                                "target_lang_sense_clarification": "比喻难以理解的言语"
                            }
                        ]
                    }
                }
            ]
