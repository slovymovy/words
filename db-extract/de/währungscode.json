                ],
                "senses": [
                    {
                        "sense_id": "0763b23a-ecb2-3fab-a733-3c22bdd8a20c",
                        "entry_id": "e4142ba1-3a40-3e7a-af48-69df925bf1f7",
                        "glosses": [
                            "alphabetische und numerische Währungs-Abkürzung, die von der Internationalen Organisation für Normung in der Norm ISO 4217 publiziert wird"
                        ],
                        "tags": [
                            "Internationaler Zahlungsverkehr"
                        ],
                        "examples": [
                            {
                                "example_id": "cbb7277c-40f1-45db-aa11-fcc0ff00db0d",
                                "sense_id": "0763b23a-ecb2-3fab-a733-3c22bdd8a20c",
                                "text": "Beim alphabetischen Währungscode stehen die ersten beiden Buchstaben in der Regel für das Länderkürzel und der dritte Buchstabe für den Anfangsbuchstaben der Währung (z. B. „US“ für United States und „D“ für Dollar)."
                            },
                            {
                                "example_id": "1ba3f56e-84c8-4013-82a9-98bc376637e1",
                                "sense_id": "0763b23a-ecb2-3fab-a733-3c22bdd8a20c",
                                "text": "Der Währungscode für Euro ist „EUR“ und das Währungssymbol ist ‚€‘."
                            },
                            {
                                "example_id": "18faa478-fdcd-4b11-9b6f-18af45dfb3d9",
                                "sense_id": "0763b23a-ecb2-3fab-a733-3c22bdd8a20c",
                                "text": "Der internationale Währungscode nach der Norm ISO 4217 für Zloty lautet seit dem 1. Januar 1995 PLN."
                            },
                            {
                                "example_id": "195eeccf-50df-49f8-9d1a-ffff73d2315a",
                                "sense_id": "0763b23a-ecb2-3fab-a733-3c22bdd8a20c",
                                "text": "Der Währungscode für Baht ist THB und das Währungssymbol ist ฿."
                            },
                            {
                                "example_id": "3fb84673-c357-467d-ba9f-4ad02fdf3caf",
                                "sense_id": "0763b23a-ecb2-3fab-a733-3c22bdd8a20c",
                                "text": "Der internationale Währungscode ist HRK, aber in Kroatien wird meistens die Abkürzung kn verwendet."
                            },
                            {
                                "example_id": "80b8670e-a405-4596-b16d-468ab6b3c241",
                                "sense_id": "0763b23a-ecb2-3fab-a733-3c22bdd8a20c",
                                "text": "In Weißrussland wird ab dem 1. Juli die Währung umgestellt. Der offizielle Währungscode des Weißrussischen Rubels BYR wird auf die neue Abkürzung BYN umgestellt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
