                "senses": [
                    {
                        "sense_id": "cd0012d1-4544-3316-b2e4-5d9b46c949ca",
                        "entry_id": "c9774f0d-d432-3644-ac1f-48aad2bc44f1",
                        "glosses": [
                            "Bett, in dem ein Kranker/eine Kranke liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db9e5872-c6c5-466d-8b36-4c6f302eb928",
                                "sense_id": "cd0012d1-4544-3316-b2e4-5d9b46c949ca",
                                "text": "„Ein Krankenbett in der Sahara ist wohl einer der unpassendsten Orte, um auf die Idee zu kommen, alleine mit dem Motorrad von London nach Kapstadt zu fahren.“"
                            },
                            {
                                "example_id": "fa8f7f99-4406-4f2c-aafa-702db70c6230",
                                "sense_id": "cd0012d1-4544-3316-b2e4-5d9b46c949ca",
                                "text": "„Als Ása wieder wach wurde, lag sie in einem weißen Krankenbett mit Schläuchen an ihrem Handrücken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
