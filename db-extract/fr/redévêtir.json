                ],
                "senses": [
                    {
                        "sense_id": "3705e172-cab4-3c21-a105-7bce64e0307d",
                        "entry_id": "dcadbe40-ee75-307d-ae29-ef7a57bef19c",
                        "glosses": [
                            "Dévêtir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12fa9ef3-5b61-4417-ac14-51cb88022159",
                                "sense_id": "3705e172-cab4-3c21-a105-7bce64e0307d",
                                "text": "Tu as essayé de mettre l’autre tenue puis de te redévêtir ensuite ?"
                            },
                            {
                                "example_id": "f39ae7e1-ce7b-4ec8-9eba-71bc5ba2e96d",
                                "sense_id": "3705e172-cab4-3c21-a105-7bce64e0307d",
                                "text": "Avant de se redévêtir, elle voulait être sure que le gamin n’allait pas ouvrir la porte et elle était persuadée que c’était ce qu’il allait faire."
                            },
                            {
                                "example_id": "2320b83b-93f6-4254-92e3-83fb5d2e79c5",
                                "sense_id": "3705e172-cab4-3c21-a105-7bce64e0307d",
                                "text": "Le ravissant mannequin et comédienne de 30 ans, qui nous a récemment présenté sa délicieuse sœur sous toutes les coutures, est une habituée des défilés Victoria’s Secret et a souvent posé dans le plus simple appareil, notamment pour les magazines Playboy (pour lequel elle vient de se redévêtir et nous vous proposons à ce titre la couverture du nouveau numéro), Maxim ou Esquire."
                            }
                        ]
                    }
