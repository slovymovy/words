                            {
                                "example_id": "869f6b9a-e539-41d4-9b2a-c0782fce20de",
                                "sense_id": "3c40dee5-e872-3961-a7d6-7db6eaa6f38a",
                                "text": "остерега́йтесь паде́ний",
                                "translation": "mind (that) you don't fall",
