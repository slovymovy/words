                                            {
                                                "example_id": "afa93a7b-6885-46a6-b4da-3443d4dca452",
                                                "sense_id": "7609395a-7029-3ce5-9a14-c566aee03795",
                                                "text": "Daarop moesten medewerkers van een begraafplaats een extra groot graf uitgraven."
                                            }
