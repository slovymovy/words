                "senses": [
                    {
                        "sense_id": "e88f8477-9a00-34d6-93e4-4a279a69c147",
                        "entry_id": "ea2fcad7-b79c-3a69-8708-4f833f9190f3",
                        "glosses": [
                            "eine Bauhilfskonstruktion, die zur Absteckung und der Positionierung der Außenkanten eines zu errichtenden Gebäudes dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9c7fc41-ed3e-409b-b018-a132969d594a",
                                "sense_id": "e88f8477-9a00-34d6-93e4-4a279a69c147",
                                "text": "„Hat man die Absicht, ein Gewächshaus mit Beton zu erbauen, so wird für die Fundamente ein Schnurgerüst geschlagen, d.h. es werden zwei parallele Schnüre gezogen.“"
                            },
                            {
                                "example_id": "54f9c521-072f-44cc-9392-dd8b21c58c50",
                                "sense_id": "e88f8477-9a00-34d6-93e4-4a279a69c147",
                                "text": "„Der Schnurbock oder das Schnurgerüst dient der genauen Festlegung der Abmessungen des Gebäudes auf dem Grundstück.“"
                            },
                            {
                                "example_id": "31ad83f0-8e56-4645-8681-45f0279b8a11",
                                "sense_id": "e88f8477-9a00-34d6-93e4-4a279a69c147",
                                "text": "„Das Schnurgerüst besteht aus straff gespannten Schnüren, deren Lage untereinander, am besten durch rechte Winkel, bekannt und kartiert ist."
                            },
                            {
                                "example_id": "d7d53372-0979-4073-adb8-e5678cd697c3",
                                "sense_id": "e88f8477-9a00-34d6-93e4-4a279a69c147",
                                "text": "„Wir legen bei Baubeginn auf der Baustelle die Höhe der Oberkante (OK) Erdgeschoßfußboden (EG) am Schnurgerüst fest.“"
                            },
                            {
                                "example_id": "ef238fbc-9855-4ee2-a474-6fc1921df147",
                                "sense_id": "e88f8477-9a00-34d6-93e4-4a279a69c147",
                                "text": "Die Anlage eines Schnurgerüstes ist eine der ersten Tätigkeiten auf einer Baustelle."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
