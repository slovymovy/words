                "senses": [
                    {
                        "sense_id": "733249b7-3fa0-3f06-a1e6-243eee55d067",
                        "entry_id": "eef4e178-822b-3a53-ba44-8bdb0fbb0340",
                        "glosses": [
                            "Divertir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fe7043b-553b-409a-ae20-6f99e611d583",
                                "sense_id": "733249b7-3fa0-3f06-a1e6-243eee55d067",
                                "text": "Cet été, j'ai converti de mon mieux toutes mes forces ; à B[agdad], je crains de me redivertir à jamais."
                            },
                            {
                                "example_id": "34f02c09-8cac-42cd-867b-5b1ae6243b57",
                                "sense_id": "733249b7-3fa0-3f06-a1e6-243eee55d067",
                                "text": "Au plaisir de redivertir votre être et vos oreilles."
                            },
                            {
                                "example_id": "68fd1bbf-4012-4691-8aa2-6917637bb768",
                                "sense_id": "733249b7-3fa0-3f06-a1e6-243eee55d067",
                                "text": "J'apprends tout doucement à me redivertir, hier j'ai lu les 9 premiers chapitres de ton ouvrage."
                            }
                        ]
                    }
