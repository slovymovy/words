    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0a152908-d4b6-34db-8648-6552845483f9",
                    "sense_definition": "The egg of a louse, especially one attached to a human hair.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "parasite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The school nurse checked every child's hair for a <w>nit</w> or live louse.",
                            "target_lang_translations": {
                                "ru": "Школьная медсестра проверила волосы каждого ребенка на наличие <w>гнид</w> или живых вшей."
                            }
                        },
                        {
                            "text": "She used a special fine-toothed comb to remove each <w>nit</w> from her daughter's hair.",
                            "target_lang_translations": {
                                "ru": "Она использовала специальный гребень с частыми зубьями, чтобы удалить каждую <w>гниду</w> из волос дочери."
                            }
                        }
                    ],
                    "common_phrases": [
                        "nit comb",
                        "head nit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Яйцо вши, обычно прикрепленное к человеческому волосу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гнида",
                                "target_lang_sense_clarification": "яйцо вши"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7eec5bf8-55cb-3399-a42e-d9bd7481dcfb",
                    "sense_definition": "A minor shortcoming or a small, insignificant detail that is criticized.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "criticism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The report was excellent, though I have one small <w>nit</w> regarding the formatting of the charts.",
                            "target_lang_translations": {
                                "ru": "Отчет был превосходным, хотя у меня есть одна небольшая <w>придирка</w> по поводу форматирования диаграмм."
                            }
                        },
                        {
                            "text": "He spent the whole meeting picking a <w>nit</w> about the font size instead of discussing the strategy.",
                            "target_lang_translations": {
                                "ru": "Он провел всю встречу, <w>придираясь</w> к размеру шрифта вместо того, чтобы обсуждать стратегию."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pick a nit",
                        "small nit"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in professional or technical feedback"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Незначительный недостаток или мелкая, несущественная деталь, подвергаемая критике."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "придирка",
                                "target_lang_sense_clarification": "мелкое замечание"
                            },
                            {
                                "target_lang_word": "мелочь",
                                "target_lang_sense_clarification": "незначительная деталь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e04234ac-882c-3bd8-b548-5f3fdfdadcb7",
                    "sense_definition": "A foolish or stupid person.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "insult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't be such a <w>nit</w>; you know exactly what I meant.",
                            "target_lang_translations": {
                                "ru": "Не будь таким <w>дурачком</w>; ты прекрасно понимаешь, что я имел в виду."
                            }
                        },
                        {
                            "text": "He felt like a total <w>nit</w> after forgetting his own house keys for the third time this week.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя полной <w>бестолочью</w> после того, как в третий раз за неделю забыл ключи от дома."
                            }
                        }
                    ],
                    "common_phrases": [
                        "silly nit"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily British English"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "informal insult"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Глупый или бестолковый человек."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дурачок",
                                "target_lang_sense_clarification": "глупый человек"
                            },
                            {
                                "target_lang_word": "бестолочь",
                                "target_lang_sense_clarification": "несообразительный человек"
                            },
                            {
                                "target_lang_word": "дебил",
                                "target_lang_sense_clarification": "бранное, глупый человек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2dcf22a2-e810-3d6f-bba9-c03863451ee8",
                    "sense_definition": "A unit of measurement for luminance, equivalent to one candela per square metre.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The brightness of this LCD screen is between 900 and 1000 <w>nits</w>.",
                            "target_lang_translations": {
                                "ru": "Яркость этого ЖК-экрана составляет от 900 до 1000 <w>нит</w>."
                            }
                        },
                        {
                            "text": "High-end smartphones often boast a peak brightness of over 2000 <w>nits</w> for better outdoor visibility.",
                            "target_lang_translations": {
                                "ru": "Смартфоны премиум-класса часто могут похвастаться пиковой яркостью более 2000 <w>нит</w> для лучшей видимости на улице."
                            }
                        }
                    ],
                    "common_phrases": [
                        "peak nits",
                        "screen nits"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in optics and display technology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Единица измерения яркости, эквивалентная одной канделе на квадратный метр."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нит",
                                "target_lang_sense_clarification": "единица яркости"
                            },
                            {
                                "target_lang_word": "кд/м²",
                                "target_lang_sense_clarification": "кандела на квадратный метр"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6cb989de-5b16-3a1c-9b21-71ab3edfbcde",
                    "sense_definition": "In poker, a player who is extremely cautious and only plays very strong hands.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "poker",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can easily bluff a <w>nit</w> because they will fold anything but the best possible hand.",
                            "target_lang_translations": {
                                "ru": "Вы можете легко блефовать против <w>нита</w>, потому что он сбросит любую руку, кроме самой лучшей."
                            }
                        },
                        {
                            "text": "He is such a <w>nit</w> that he hasn't played a single pot in over an hour.",
                            "target_lang_translations": {
                                "ru": "Он такой <w>нит</w>, что не разыграл ни одного банка за целый час."
                            }
                        }
                    ],
                    "common_phrases": [
                        "total nit"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "poker terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В покере: крайне осторожный игрок, который вступает в игру только с очень сильными картами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нит",
                                "target_lang_sense_clarification": "осторожный игрок в покере"
                            },
                            {
                                "target_lang_word": "скала",
                                "target_lang_sense_clarification": "сленг, очень тайтовый игрок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "565c2394-31d0-37ca-b248-c50092930df4",
                    "sense_definition": "A logarithmic unit of information or entropy, based on natural logarithms rather than binary.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "information_theory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The information content can be measured in bits or <w>nits</w> depending on the base of the logarithm.",
                            "target_lang_translations": {
                                "ru": "Информационную емкость можно измерять в битах или <w>нитах</w> в зависимости от основания логарифма."
                            }
                        },
                        {
                            "text": "One <w>nit</w> is approximately equal to 1.44 bits of information.",
                            "target_lang_translations": {
                                "ru": "Один <w>нит</w> примерно равен 1,44 бита информации."
                            }
                        }
                    ],
                    "synonyms": [
                        "nat"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific/mathematical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Логарифмическая единица количества информации или энтропии, основанная на натуральных логарифмах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нит",
                                "target_lang_sense_clarification": "единица информации"
                            },
                            {
                                "target_lang_word": "нат",
                                "target_lang_sense_clarification": "синоним в теории информации"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4e30fc47-76a5-3278-bafe-d53e20e96418",
                    "sense_definition": "To live the lifestyle of a drug addict.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "lifestyle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent years on the street, but he claims he was never really <w>nitting</w> like the others.",
                            "target_lang_translations": {
                                "ru": "Он провел годы на улице, но утверждает, что никогда по-настоящему не <w>торчал</w>, как остальные."
                            }
                        },
                        {
                            "text": "The lyrics describe the harsh reality of those who are <w>nitting</w> in the city's abandoned buildings.",
                            "target_lang_translations": {
                                "ru": "Текст песни описывает суровую реальность тех, кто <w>употребляет</w> в заброшенных зданиях города."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "urban/street slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вести образ жизни наркозависимого человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "торчать",
                                "target_lang_sense_clarification": "сленг, употреблять наркотики"
                            }
                        ]
                    }
                }
            ]
        }
    ]
