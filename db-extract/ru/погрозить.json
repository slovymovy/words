                    {
                        "sense_id": "48dbd442-e950-3769-9872-b42b99c76d6e",
                        "entry_id": "207ccb5c-10e1-3a19-88c4-9d78993aabb5",
                        "glosses": [
                            "to threaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e6b315c-a67d-4df9-934f-bdfe13adf2bd",
                                "sense_id": "48dbd442-e950-3769-9872-b42b99c76d6e",
                                "text": "погрози́ть па́льцем",
                                "translation": "to shake/wag one's finger (at)",
                                "english": "to shake/wag one's finger (at)"
                            },
                            {
                                "example_id": "7fe6b926-29f3-4f22-a085-044ef9c4fe95",
                                "sense_id": "48dbd442-e950-3769-9872-b42b99c76d6e",
                                "text": "погрози́ть кулако́м",
                                "translation": "to shake one's fist (at)",
                                "english": "to shake one's fist (at)"
                            },
                            {
                                "example_id": "7a1456c2-547b-403a-b4fb-370735b19cc2",
                                "sense_id": "48dbd442-e950-3769-9872-b42b99c76d6e",
                                "text": "Разуме́ется, он врал и бре́дил, трепеща́, что́бы я не убежа́л от него́; но я вдруг бро́сил его́ среди́ у́лицы, и когда́ он хоте́л бы́ло за мной сле́довать, то я останови́лся и погрози́л ему́ кулако́м.",
                                "translation": "He was lying and talking wildly, of course, trembling for fear I should run away from him; but I suddenly abandoned him in the middle of the street, and when he seemed disposed to follow me I stood still and shook my fist at him.",
                                "english": "He was lying and talking wildly, of course, trembling for fear I should run away from him; but I suddenly abandoned him in the middle of the street, and when he seemed disposed to follow me I stood still and shook my fist at him."
                            }
                        ]
                    }
