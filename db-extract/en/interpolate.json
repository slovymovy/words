                        "entry_id": "8a93b280-8a81-3404-89fd-2ffc805ba926",
                        "glosses": [
                            "To introduce (something) between other things; especially to insert (possibly spurious) words into a text."
                        ],
                        "tags": [
                            "intransitive",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6926c3fa-1411-4811-93da-913307442a7c",
                                "sense_id": "84b678da-3f1f-3e63-949f-69f7b5b08631",
                                "text": "in verse 74, the second line is clearly interpolated, probably by some unknown medieval scribe"
                            },
                            {
                                "example_id": "f67380c4-ab27-4a84-83f4-032f67492191",
                                "sense_id": "84b678da-3f1f-3e63-949f-69f7b5b08631",
                                "text": "When interpolating an explanatory gloss, please enclose it in square brackets to make clear that it is interpolated."
                            }
                        ]
                    },
                    {
                        "sense_id": "a238bed5-aa98-362c-8030-6ebc1a255189",
                        "entry_id": "8a93b280-8a81-3404-89fd-2ffc805ba926",
                        "glosses": [
                            "To estimate the value of a function between two tabulated points."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "8d243e8b-4bd4-331f-88ab-3843f64850c4",
                        "entry_id": "8a93b280-8a81-3404-89fd-2ffc805ba926",
                        "glosses": [
                            "During the course of processing some data, and in response to a directive in that data, to fetch data from a different source and process it in-line along with the original data."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be91e977-eeef-4b11-ac4b-8476856b1331",
                                "sense_id": "8d243e8b-4bd4-331f-88ab-3843f64850c4",
                                "text": "A macro is invoked in the same way as a request; a control line beginning .xx will interpolate the contents of macro xx."
                            }
                        ]
                    }
