                "senses": [
                    {
                        "sense_id": "07c31b5a-1d7c-3721-839f-324fb0307f4d",
                        "entry_id": "341a8961-cce3-31e8-a660-1c01cdcdd9e5",
                        "glosses": [
                            "Befehlsstelle, von der aus Adolf Hitler (= Führer) in seiner Eigenschaft als Oberbefehlshaber der Wehrmacht agierte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af431927-58a2-440d-8ceb-46cba7c10a8c",
                                "sense_id": "07c31b5a-1d7c-3721-839f-324fb0307f4d",
                                "text": "„Zu allem Übel handelt es sich um das Joch des Hitler-Grußes, unter das die Wehrmacht nach dem Attentat im Führerhauptquartier gezwungen wurde.“"
                            },
                            {
                                "example_id": "d23c3349-8401-403f-9e98-d640bdeaef34",
                                "sense_id": "07c31b5a-1d7c-3721-839f-324fb0307f4d",
                                "text": "„Das ostpreußische Führerhauptquartier hatte er Anfang November 1944 geräumt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
