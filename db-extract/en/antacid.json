                        "glosses": [
                            "Counteracting or neutralizing acidity, especially in the stomach."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04229290-21be-4a99-8174-3b5ac9ee50fa",
                        "source_entry_id": "ae849520-c6d9-38a4-a24d-136ae322dea4",
                        "source_sense_id": "1670da57-6176-3bbf-8c83-561c30375f3d",
                        "source_sense_description": "counteracting acidity",
                        "target_lang_word": "antiacide",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antiacide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c05a1019-f370-3754-90d2-24657c5f99ae",
                                        "entry_id": "611ef286-7962-3309-851b-207ac1af8b27",
                                        "glosses": [
                                            "Produit qui s’oppose à l’acidité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c2642c2-58b9-4dfc-8644-be1322987500",
                                                "sense_id": "c05a1019-f370-3754-90d2-24657c5f99ae",
                                                "text": "Récemment, plusieurs équipes on rapporté l’absence de sur-incidence de P.N.A.V.M. lors de l’utilisation d’anti-H² (49, 51, 62, 71) ou d’antiacides (8)."
                                            },
                                            {
                                                "example_id": "ae1b38d5-dcca-467d-b96d-39de96e87fe5",
                                                "sense_id": "c05a1019-f370-3754-90d2-24657c5f99ae",
                                                "text": "Qu’est-ce qu’un antiacide?"
                                            },
                                            {
                                                "example_id": "82d62721-6369-4801-b2cb-7b42f1a2dbba",
                                                "sense_id": "c05a1019-f370-3754-90d2-24657c5f99ae",
                                                "text": "L’hydroxyde de magnésium, est un antiacide d’action rapide et brève ; il peut provoquer une diarrhée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "antiacide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "590e1795-b560-3c76-a803-70c42a30338a",
                                        "entry_id": "6666c444-aed6-364a-b70e-35e44de2e585",
                                        "glosses": [
                                            "Qui s’oppose à l’acidité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "139b8a89-463e-4044-ba3c-af7015b0858e",
                                                "sense_id": "590e1795-b560-3c76-a803-70c42a30338a",
                                                "text": "Les bourgeons de Figuier normalisent les excès de secrétions acides, apaisent l’irritation gastrique, permettant le sevrage aux inhibiteurs de la pompe à protons (IPP) ou de tout autre produit antiacide'."
                                            },
                                            {
                                                "example_id": "4915b084-7df7-4b4f-ae18-e799da99af37",
                                                "sense_id": "590e1795-b560-3c76-a803-70c42a30338a",
                                                "text": "Selon certaines estimations, la valeur des achats de produits antiacides se chiffrerait en milliards de dollars."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "25a0f755-1e15-38e1-9a8a-5b0345ae00c4",
