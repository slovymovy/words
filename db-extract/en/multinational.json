                                "target_senses": [
                                    {
                                        "sense_id": "5a66b01d-7d4f-3ffd-9ed9-dcb5d0de6a97",
                                        "entry_id": "2edcced8-b1c2-3a3a-8f60-29fec239910f",
                                        "glosses": [
                                            "een onderneming die in meerdere landen vestigingen heeft, multinationale onderneming"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "150602aa-2c3d-4e84-81d8-90141fab7975",
                                                "sense_id": "5a66b01d-7d4f-3ffd-9ed9-dcb5d0de6a97",
                                                "text": "De Franse regering is niet van plan om belastingdeals te sluiten met multinationals als Google en McDonalds die mogelijk jarenlang belasting hebben ontweken of ontdoken"
                                            },
                                            {
                                                "example_id": "2d36888d-4a1a-43a6-84f2-03e6560f7964",
                                                "sense_id": "5a66b01d-7d4f-3ffd-9ed9-dcb5d0de6a97",
                                                "text": "Corruptie, smeergeld, ontbossing: Nederland krijgt er met vleesgigant JBS een omstreden multinational bij."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "721961d3-f761-4109-b642-33547e925455",
                        "source_entry_id": "eb9227d3-b17f-37f2-9c81-54ca112f4e92",
                        "source_sense_id": "224a40b6-8bec-3f64-b399-4b7c14f4da20",
                        "source_sense_description": "multinational company",
                        "target_lang_word": "multinationale",
