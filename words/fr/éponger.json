                {
                    "sense_id": "04fe8e65-951e-3869-a173-a47975a90ce3",
                    "sense_definition": "Consommer des aliments consistants dans l'espoir d'atténuer les effets de l'alcool.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
