                "senses": [
                    {
                        "sense_id": "558d0580-999a-30e7-ad91-aa3ab582376e",
                        "entry_id": "86696eee-9bac-35d7-97e6-ac72ec83ebe8",
                        "glosses": [
                            "kleineres hinterstes Segel auf einem Segelboot"
                        ],
                        "tags": [
                            "Seglersprache"
                        ],
                        "examples": [
                            {
                                "example_id": "17177eab-54c5-4cac-b5a5-9a08811eaf89",
                                "sense_id": "558d0580-999a-30e7-ad91-aa3ab582376e",
                                "text": "Ketsch und Yawl haben beide Besanmast und -segel."
                            },
                            {
                                "example_id": "a4b22d4d-95f3-4e88-9cdb-b3147bda5471",
                                "sense_id": "558d0580-999a-30e7-ad91-aa3ab582376e",
                                "text": "Auf einem Segelboot sind mit einem Besansegel die Segelflächen unterteilt. Deshalb gelten diese Yachten bei gleicher Segelfläche als leichter zu handhaben, als eine Slup oder ein Schoner."
                            },
                            {
                                "example_id": "dc12e31d-3b8c-4cc3-aaa2-a86de132d32e",
                                "sense_id": "558d0580-999a-30e7-ad91-aa3ab582376e",
                                "text": "Jetzt läuft der Pater zum Heck, um dem Iren am Besansegel zu helfen."
                            },
                            {
                                "example_id": "faa7ce11-da67-4540-8abc-a69c5592446c",
                                "sense_id": "558d0580-999a-30e7-ad91-aa3ab582376e",
                                "text": "Während der kurzen Überfahrt mußte der Arzt Torsten gefragt haben, warum die >Nausikaa< kein Besansegel führe. Torsten gab die Frage gleich an Herrn Spreckelsen weiter. „Ein Besansegel? Wozu? Die Jacht ist ohnehin luvgierig […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d18e2dab-ea22-4d62-b8bd-fca68ee26e2b",
                        "source_entry_id": "86696eee-9bac-35d7-97e6-ac72ec83ebe8",
                        "source_sense_id": "558d0580-999a-30e7-ad91-aa3ab582376e",
                        "source_sense_description": "Seglersprache: kleineres hinterstes Segel auf einem Segelboot",
