                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4639b471-4f01-4963-9109-601bf7d6b4bc",
                        "source_entry_id": "22d6a5d9-1791-3f25-9b35-955209c1a2f5",
                        "source_sense_id": "e5773498-c300-320b-86d1-4ec7aff5a360",
                        "target_lang_word": "Bauchrednerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bauchrednerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3edbebc8-514b-3d7b-9a6e-1be59714a623",
                                        "entry_id": "93d626fe-b25d-3aac-9023-1e9606ce1cd1",
                                        "glosses": [
                                            "Sprechen ohne sichtliche Mundbewegungen, meist so, dass es aussieht, als spreche eine bewegte Puppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63eaa395-5965-4384-9215-ae4c461a67f7",
                                                "sense_id": "3edbebc8-514b-3d7b-9a6e-1be59714a623",
                                                "text": "„Für seine Mischung aus Bauchrednerei und Comedy wurde Benjamin Tomkins vielfach mit Comedypreisen ausgezeichnet.“"
                                            },
                                            {
                                                "example_id": "c18296bf-3c7c-4d09-a634-ae6f4aca3ed2",
                                                "sense_id": "3edbebc8-514b-3d7b-9a6e-1be59714a623",
                                                "text": "„Diese Stimme kann sich sehr gut verstellen und beherrscht alle Tricks der Bauchrednerei.“"
                                            },
                                            {
                                                "example_id": "f6cbb79a-4ccd-4617-aff6-e65e4d1c1fe0",
                                                "sense_id": "3edbebc8-514b-3d7b-9a6e-1be59714a623",
                                                "text": "„In konzeptueller Hinsicht gefiel mir die Idee der Bauchrednerei sehr, die Vorstellung, durch Stellvertreter des eigenen Ich sprechen zu können, ohne die Verantwortung für ihre Gedanken und Handlungen übernehmen zu müssen.“"
                                            },
                                            {
                                                "example_id": "18443610-e730-4886-b1f2-d1af6d768369",
                                                "sense_id": "3edbebc8-514b-3d7b-9a6e-1be59714a623",
                                                "text": "„Mein Bemühen gipfelte in der (so plakativen wie provokativen) Frage, ob Schlingensiefs Theater uns jenseits seiner Wünschelrutengänge und Bauchrednereien noch etwas zu sagen habe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1d8b231-cef1-4db5-a030-0f0483b34522",
                        "source_entry_id": "22d6a5d9-1791-3f25-9b35-955209c1a2f5",
                        "source_sense_id": "e5773498-c300-320b-86d1-4ec7aff5a360",
                        "target_lang_word": "чревовещание",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "чревовещание",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "76a8cbad-41f3-355c-8db1-318524c26c6b",
                                        "entry_id": "ac98d7bd-726a-3b85-9ef9-acebf2c25697",
                                        "glosses": [
                                            "навык, умение говорить «внутренним голосом»: не шевеля губами и не открывая рта, так что звуки кажутся исходящими из чрева"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "accbb66b-0b49-488c-98e0-db2ddc163efa",
                                                "sense_id": "76a8cbad-41f3-355c-8db1-318524c26c6b",
                                                "text": "Аттракцион этот хорошо известен среди эстрадных иллюзионистов и называется чревовещанием. Так что же такое чревовещание? Чревовещание (научное название — вентрилоквия) — это способность говорить, не шевеля губами, вследствие чего произносимые слова кажутся исходящими от других лиц."
                                            },
                                            {
                                                "example_id": "d3c871a6-0fea-4780-a7ba-1dd1577602e1",
                                                "sense_id": "76a8cbad-41f3-355c-8db1-318524c26c6b",
                                                "text": "Опытным сыщикам стало ясно, что англичанина «обработал» ловкий жулик, обладающий навыками чревовещания: он говорил за себя тенором, а за собаку басом."
                                            },
                                            {
                                                "example_id": "caac3f53-e6a4-4c98-856e-6bb0ed4d7c0c",
                                                "sense_id": "76a8cbad-41f3-355c-8db1-318524c26c6b",
                                                "text": "На арену чревовещание вышло в конце восемнадцатого века, вместе с Чарльзом Эльворти и его знаменитой куклой Мистером Боксом."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8215419-faf5-337f-bf97-cfe0396d2a66",
                                        "entry_id": "ac98d7bd-726a-3b85-9ef9-acebf2c25697",
                                        "glosses": [
                                            "перен. пророчество"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "43654f6c-3c2d-36bf-be99-6d0538f8b469",
                                        "entry_id": "ac98d7bd-726a-3b85-9ef9-acebf2c25697",
                                        "glosses": [
                                            "перен. предчувствие, предощущение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d32e3b7-1e01-4b9a-a564-eff0ff7c8e18",
                                                "sense_id": "43654f6c-3c2d-36bf-be99-6d0538f8b469",
                                                "text": "Вместо мыслей — чревовещания какие-то, от праздных слов — претит, воздух напоён предательством, чувства заменились ощущениями и… глупость, глупость повсюду!.."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
