                    {
                        "sense_id": "bdadab5a-6ce3-34f1-9652-a7eab520996e",
                        "entry_id": "2d082ec0-a815-3b2e-98e9-5dd4c63ba8e6",
                        "glosses": [
                            "innere und damit kürzeste der in ovaler Form um die Mitte des Stadions, der Halle et cetera angeordneten Strecken, auf denen die Sportler bestimmte Distanzen zurücklegen müssen"
                        ],
                        "tags": [
                            "Eisschnelllauf",
                            "Leichtathletik"
                        ],
                        "examples": [
                            {
                                "example_id": "8c2b7dde-61db-4c39-87cb-8102d8bda1d3",
                                "sense_id": "bdadab5a-6ce3-34f1-9652-a7eab520996e",
                                "text": "Nachdem sie in einem Wettkampf auf die steinerne Kante zwischen Rasenfläche und Innenbahn getreten war und eine üble Verstauchung erlitten hatte, stieg Luzie auf Hammerwurf um."
                            },
                            {
                                "example_id": "deb8c175-efb1-44ba-ba56-896ad968456f",
                                "sense_id": "bdadab5a-6ce3-34f1-9652-a7eab520996e",
                                "text": "„Im direkten Duell der Generationen trat Pechstein, 39, mit der weißen Armbinde auf der Innenbahn gegen die Kollegin Jennifer Bay, 19, aus Dresden an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bf453910-f5e2-32b8-9e5e-daae8af16f58",
                        "entry_id": "2d082ec0-a815-3b2e-98e9-5dd4c63ba8e6",
                        "glosses": [
                            "eine der mittigen, weit vom Rand entfernten Wettkampfstrecken im Schwimmbecken"
                        ],
                        "tags": [
                            "Schwimmen"
                        ],
                        "examples": [
                            {
                                "example_id": "309b5af1-dd30-4f10-aa4c-df6bca242dfa",
                                "sense_id": "bf453910-f5e2-32b8-9e5e-daae8af16f58",
                                "text": "Die ersten Plätze belegten die Schwimmer auf den Innenbahnen."
                            }
                        ],
