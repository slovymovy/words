                                        "entry_id": "7eddf2ef-9fa1-3b47-b463-637d41d95c43",
                                        "glosses": [
                                            "SI-basiseenheid voor lichtsterkte, weergegeven met symbool cd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e27c0831-9d64-4fb8-b971-4567291a23a4",
                                                "sense_id": "4a869c9b-215c-301b-9fbe-740c8c415fa9",
                                                "text": "Eén millicandela is 10⁻³ candela."
