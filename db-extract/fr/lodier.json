                        "sense_id": "7afed29d-d530-3221-b335-0b44c76ed73f",
                        "entry_id": "956ae408-853a-3cb5-8c9d-2629d39930ee",
                        "glosses": [
                            "Sorte de grosse couverture faite de bourre piquée entre deux toiles, couette."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e50afa97-1366-4f4b-9a40-4897df401f30",
                                "sense_id": "7afed29d-d530-3221-b335-0b44c76ed73f",
                                "text": "…1 charlit de bois de chêne avec un plafond pareil, avec son tour d'étoffe de beslinge couleur de suye, garni de 2 couettes ensouillées de couetty, et 2 traversiers pareils, avec 1 lodier de toile teinté de rou, rempli de filasse, et une petite mante de meslinge de peu de valeur, et 1 paillasse….(Inventaire 1735)"
                            },
                            {
                                "example_id": "f7906c51-e836-47fd-a43b-7d2bfe3d07ce",
                                "sense_id": "7afed29d-d530-3221-b335-0b44c76ed73f",
                                "text": "Sur ce matelas de famine, nous mîmes un lodier de même espèce, duquel oncques ne pus deviner la couleur."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a528727-3c05-39e8-bd79-33714905557f",
                        "entry_id": "956ae408-853a-3cb5-8c9d-2629d39930ee",
                        "glosses": [
                            "Garniture rembourrée, portée aux XVI^(ème) et XVII^(ème) siècles, au niveau des hanches."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "bb76a0fd-6e25-4807-9881-ca6959609934",
                                "sense_id": "9a528727-3c05-39e8-bd79-33714905557f",
                                "text": "Au milieu du XVe siècle, le haut des chausses fut recouvert par une sorte de bourrelet en étoffe matelassée dite lodier."
                            },
                            {
                                "example_id": "11cbe949-3bfa-497f-bef8-ac71ee412845",
                                "sense_id": "9a528727-3c05-39e8-bd79-33714905557f",
                                "text": "...des chausses où, tant grise qu'écarlate, il entre huit aunes d'étoffe pour le moins, et un bourrelet ou lodier au tour des reins ?"
                            }
                        ]
                    }
