                        "future spouse",
                        "dependent spouse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, состоящий в браке; муж или жена.",
                        "de": "Eine Person, mit der man verheiratet ist; Ehemann oder Ehefrau."
                    },
