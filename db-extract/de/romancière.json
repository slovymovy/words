                "senses": [
                    {
                        "sense_id": "b543b914-97c3-3640-a4db-678a324a756e",
                        "entry_id": "fae969c6-8b99-3364-a215-dfcd23c8259a",
                        "glosses": [
                            "Autorin/Schriftstellerin, die Romane verfasst"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "19f4e7eb-4099-4756-8941-cb6f52de0656",
                                "sense_id": "b543b914-97c3-3640-a4db-678a324a756e",
                                "text": "„Einer Assia Djebar etwa erlaubt man es, sich aufzuspalten, in zwei verschiedene Autorinnen, die Romancière und die Akademikerin, die Schriftstellerin Assia Djebar und die Zivilperson Fatima-Zohra Imalayene, die 1999 in Montpellier unter bürgerlichem Namen über ihr eigenes Werk promoviert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
