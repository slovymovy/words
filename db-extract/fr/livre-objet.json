                        "entry_id": "6ca9e8d5-4296-3e13-8b7f-5f147b86d4c4",
                        "glosses": [
                            "Livre qui inclut des éléments esthétiques particuliers, en faisant une œuvre d’art à part entière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd4b05e6-4d26-4ee4-b946-55b8ba0f1b67",
                                "sense_id": "a7fb082d-010e-3a5b-957f-27da14c797bd",
                                "text": "Retrouvez chaque mardi une chronique, une interview ou un portrait lié à un texte de science-fiction qui fait l’actualité. Aujourd’hui, un livre-objet composé des poèmes en prose d’Antoine Volodine et des compositions musicales de Denis Frajerman."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a4e341a-a677-3854-8791-21c482cffd88",
                        "entry_id": "6ca9e8d5-4296-3e13-8b7f-5f147b86d4c4",
                        "glosses": [
                            "Livre se présentant de manière inhabituelle par rapport aux formes, aux matières, aux reliures traditionnelles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddc72491-bf93-404f-9bcb-86f1952254fc",
                                "sense_id": "3a4e341a-a677-3854-8791-21c482cffd88",
                                "text": "La littérature jeunesse regorge d’imagination pour offrir aux bébés des livres-objets submersibles, lavables, scriptibles, en tissu ou en d’autres matières."
                            },
                            {
                                "example_id": "6c0f17bb-37d1-4d88-b271-21a3cf926592",
                                "sense_id": "3a4e341a-a677-3854-8791-21c482cffd88",
                                "text": "Au seizième siècle la mode était aux livres-objets aux formes variées."
                            }
                        ]
                    }
