                                        "entry_id": "dfab1542-9208-3988-abb8-98d82177911b",
                                        "glosses": [
                                            "A cushion used primarily in churches for kneeling on while praying."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "191aa5d1-1dcc-4f62-90dd-b31ab4f62622",
                                                "sense_id": "51c4e09c-bf14-3816-babb-d6509392d633",
                                                "text": "At the next service he found a flower on his hassock and a highly suggestive Catholic bookmarker tucked into his hymn-book."
                                            }
