                "senses": [
                    {
                        "sense_id": "b6315ec5-ac23-3cf7-8d6f-9e5933a53432",
                        "entry_id": "450aebb7-86e6-3529-bd6e-2d96f0d39a78",
                        "glosses": [
                            "разг. приобрести что-либо нужное для хозяйства, для жизни"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43f389c5-6659-42c9-9c3e-fd21c7d94084",
                                "sense_id": "b6315ec5-ac23-3cf7-8d6f-9e5933a53432",
                                "text": "Остаётся, пожалуй, одно ― обзавестись тряпками и заткнуть ими все щели моей спальни!"
                            }
                        ]
                    },
                    {
                        "sense_id": "01e3738f-1da8-31c2-801d-61b7b5fdf031",
                        "entry_id": "450aebb7-86e6-3529-bd6e-2d96f0d39a78",
                        "glosses": [
                            "завести, приобрести (семью, знакомства и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0a5f879-5a21-4a6f-beb9-820e89957462",
                                "sense_id": "01e3738f-1da8-31c2-801d-61b7b5fdf031",
                                "text": "Злые языки утверждают, что Георгий Александрович так и не обзавёлся семьёй из-за сестры."
                            }
                        ]
                    }
