                    {
                        "sense_id": "0b8d1728-23e3-38a2-bd1d-8b7706040e0f",
                        "entry_id": "9ab55f9b-137c-37b8-8039-e3f8812bb888",
                        "glosses": [
                            "Qui n’a pas de bon sens, qui n’a pas toute sa raison, qui fait preuve de déraison."
                        ],
                        "tags": [
                            "En parlant d’une personne"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1d1f93e0-e3e8-35fa-9556-c5db62a08f9c",
                        "entry_id": "9ab55f9b-137c-37b8-8039-e3f8812bb888",
                        "glosses": [
                            "Qui dépasse ce qui est communément admis par le bon sens."
                        ],
                        "tags": [
                            "En parlant d’une action"
                        ],
                        "examples": [
                            {
                                "example_id": "8a345e1d-7688-4335-acd9-05bd9fac1ef8",
                                "sense_id": "1d1f93e0-e3e8-35fa-9556-c5db62a08f9c",
                                "text": "Ce n’était plus un enfant capable de subir tout d’un coup les atteintes d’une passion déraisonnée ; c’était un homme au vouloir bien trempé, au caractère dominateur, et ce qui se manifestait ainsi chez lui, était un amour vrai, fier, sauvage."
                            },
                            {
                                "example_id": "01355445-bfd8-4e3f-8a65-1923349cc7a3",
                                "sense_id": "1d1f93e0-e3e8-35fa-9556-c5db62a08f9c",
                                "text": "Près de Porto, au Portugal, Milène Matos lutte contre les conséquences d’une exploitation déraisonnée de l’eucalyptus, un arbre venu d’Australie et vecteur d’incendies ravageurs."
                            }
                        ]
                    }
