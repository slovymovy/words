                "senses": [
                    {
                        "sense_id": "505b7b60-6b5c-3108-8838-f7fcf05e32cf",
                        "entry_id": "2ab1eb94-5fe4-3852-8e5c-4d29f476b812",
                        "glosses": [
                            "Accomplir un geste symétrique à celui de son interlocuteur."
                        ],
                        "tags": [
                            "Belgique",
                            "Rwanda"
                        ],
                        "examples": [
                            {
                                "example_id": "f07767a4-6cfe-497d-b44e-35c4aed6351a",
                                "sense_id": "505b7b60-6b5c-3108-8838-f7fcf05e32cf",
                                "text": "Ce qui fait que, lorsque dans ses lettres il se mit à évoquer une certaine Odile, jeune fille blanche qu'il disait aimer et qui apparemment le réciproquait, j'en avais conçu une profonde tristesse."
                            },
                            {
                                "example_id": "e4b4259f-a8f5-406e-818c-da477326fa14",
                                "sense_id": "505b7b60-6b5c-3108-8838-f7fcf05e32cf",
                                "text": "Je m’aperçus qu’il me tutoyait. […] Je décidai de ne pas le lui réciproquer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1d589156-9846-4bb1-8d54-a9b7fec5e663",
                        "source_entry_id": "2ab1eb94-5fe4-3852-8e5c-4d29f476b812",
                        "source_sense_id": "505b7b60-6b5c-3108-8838-f7fcf05e32cf",
                        "target_lang_word": "reciprocate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reciprocate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71b35a51-613e-30db-a35e-16090177a2d3",
                                        "entry_id": "0c6759ff-cc8d-33f6-a991-04ce0625d5d3",
                                        "glosses": [
                                            "To exchange two things, with both parties giving one thing and taking another thing."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1beb6058-51b4-42df-91be-bef5d6817e9b",
                                                "sense_id": "71b35a51-613e-30db-a35e-16090177a2d3",
                                                "text": "The USTR isn't reciprocating actual tariffs. It's just placing the biggest tariffs on the countries running the biggest trade surpluses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef07ee79-cc25-360a-b12e-4ce7053b8d0f",
                                        "entry_id": "0c6759ff-cc8d-33f6-a991-04ce0625d5d3",
                                        "glosses": [
                                            "To give something else in response (where the \\\"thing\\\" may also be abstract, a feeling or action) To make a reciprocal gift."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "843ae919-d2cd-425c-86b7-8cf1ef0c0790",
                                                "sense_id": "ef07ee79-cc25-360a-b12e-4ce7053b8d0f",
                                                "text": "I gave them apples from my tree; they reciprocated with a pie and some apple jelly."
                                            },
                                            {
                                                "example_id": "6b206aa9-fd92-4bf3-9751-417d44710bcf",
                                                "sense_id": "ef07ee79-cc25-360a-b12e-4ce7053b8d0f",
                                                "text": "Nugget appreciates the generosity! Nugget will reciprocate with a Monstermon card!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b464b75-5924-3e7c-a31e-fc15be0a0594",
                                        "entry_id": "0c6759ff-cc8d-33f6-a991-04ce0625d5d3",
                                        "glosses": [
                                            "To move backwards and forwards, like a piston."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f00b4bd-5b54-4733-971b-b9eff3783f6f",
                                                "sense_id": "1b464b75-5924-3e7c-a31e-fc15be0a0594",
                                                "text": "a reciprocating engine"
                                            },
                                            {
                                                "example_id": "7b9e611d-51d3-4b31-9c07-4b5ab6c858fb",
                                                "sense_id": "1b464b75-5924-3e7c-a31e-fc15be0a0594",
                                                "text": "One brawny smith the puffing bellows plies, / And draws and blows reciprocating air."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7e0762e-3fa3-3016-832f-e18f7955054a",
                                        "entry_id": "0c6759ff-cc8d-33f6-a991-04ce0625d5d3",
                                        "glosses": [
                                            "To counter, retort or retaliate."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
