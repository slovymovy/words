                        "entry_id": "78b94058-e203-33d5-a615-73e8d5452082",
                        "glosses": [
                            "Pédagogue qui enseignait à lire et à écrire."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "7474e4db-4f39-4d55-b50d-de9d053a32c3",
                                "sense_id": "d4f00734-b410-336c-8c77-3c44bc6a9f9a",
                                "text": "On est ensuite peu renseigné sur l'éducation des filles à l'époque classique, qui devait être dispensée dans la sphère domestique et non, comme pour les garçons, à l'école du grammatiste et du cithariste en charge de la formation lettrée et musicale."
                            }
                        ]
                    },
                    {
                        "sense_id": "71bc24fb-09f1-34cb-8e42-b0996b0234d5",
                        "entry_id": "78b94058-e203-33d5-a615-73e8d5452082",
                        "glosses": [
                            "Grammairien aux idées étroites qui ne s'en tient qu'à une application stricte des règles."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "97437c94-712f-4f55-814a-aa8e68e2a462",
                                "sense_id": "71bc24fb-09f1-34cb-8e42-b0996b0234d5",
                                "text": "Ce grand artiste\nDéfierait là-dessus [sur l'histoire de la langue]\nle premier grammatiste."
                            }
                        ]
                    }
