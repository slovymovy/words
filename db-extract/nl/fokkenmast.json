                                    {
                                        "sense_id": "d25d60fe-f759-33b3-90dc-72c33f220fdd",
                                        "entry_id": "bc92b6e8-20b7-37bc-ac61-1dd9125e0a8b",
                                        "glosses": [
                                            "erster Mast eines großen Segelschiffes"
                                        ],
