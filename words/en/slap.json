                            {
                                "target_lang_word": "пощёчина",
                                "target_lang_sense_clarification": "удар по щеке"
                            },
                            {
                                "target_lang_word": "оплеуха",
                                "target_lang_sense_clarification": "разг., удар по лицу или голове"
                            },
                            {
                                "target_lang_word": "затрещина",
                                "target_lang_sense_clarification": "сильный удар рукой"
                            }
                        ]
                    }
