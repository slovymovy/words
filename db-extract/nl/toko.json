                "senses": [
                    {
                        "sense_id": "447be506-cfdb-3176-b734-5ef3d57305d7",
                        "entry_id": "4c0af594-232a-3c43-bb12-ce68c03ba90f",
                        "glosses": [
                            "a Dutch, otherwise European or Chinese shop"
                        ],
                        "tags": [
                            "historical",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "b1646286-b121-400d-b763-52ab212df2ac",
                                "sense_id": "447be506-cfdb-3176-b734-5ef3d57305d7",
                                "text": "A shop for excellent DRINKS.",
                                "translation": "A shop where you can buy beautiful GIFTS\nA shop where you can buy strong, beautiful IRON COTS with accessories.\nA shop for all types of BANQUET and SWEETS.",
                                "english": "A shop where you can buy beautiful GIFTS\nA shop where you can buy strong, beautiful IRON COTS with accessories.\nA shop for all types of BANQUET and SWEETS."
                            }
                        ]
                    },
                    {
                        "sense_id": "462dd0e5-c047-3943-abc6-6438f41b355f",
                        "entry_id": "4c0af594-232a-3c43-bb12-ce68c03ba90f",
                        "glosses": [
                            "a grocery store or supermarket specializing in Southeast Asian (especially Indonesian or Chinese Indonesian) products, which are mostly food items"
                        ],
                        "tags": [
                            "Netherlands",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "88efab10-ea81-465e-98f2-0f5b8e0369a0",
                                "sense_id": "462dd0e5-c047-3943-abc6-6438f41b355f",
                                "text": "2007, Peter Gordon, Groente - opnieuw ontdekt, tr. by Aniek Njiokiktjien, Inmerc, 8.\nStruin maar eens over een boerenmarkt om te zien wat er plaatselijk allemaal geteeld en verkocht wordt, of ga naar de dichtstbijzijnde toko of naar een ruim gesorteerde supermarkt om te zien welke onbekende ingrediënten er gewoon bij je om de hoek te koop zijn.",
                                "translation": "(please add an English translation of this quotation)",
                                "english": "(please add an English translation of this quotation)"
                            }
                        ]
                    },
                    {
                        "sense_id": "fe5cdc40-77e4-34f6-8805-daf195b413fc",
                        "entry_id": "4c0af594-232a-3c43-bb12-ce68c03ba90f",
                        "glosses": [
                            "shop, store, stand"
                        ],
                        "tags": [
                            "Netherlands",
                            "colloquial",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "eee88e38-2bb6-473c-a25c-e9003c62b38a",
                                "sense_id": "fe5cdc40-77e4-34f6-8805-daf195b413fc",
                                "text": "Opende de toko, sloot de toko, ik wóónde praktisch in die toko.",
                                "translation": "Opened the store, closed the store, I practically lived in that store.",
                                "english": "Opened the store, closed the store, I practically lived in that store."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9a5e5e5-8f2f-3c9e-9789-39abbf6474c7",
                        "entry_id": "4c0af594-232a-3c43-bb12-ce68c03ba90f",
                        "glosses": [
                            "any company or business"
                        ],
                        "tags": [
                            "Netherlands",
                            "colloquial",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "bdb273e6-b8ae-47d3-bea8-bb110c59e2fa",
                                "sense_id": "f9a5e5e5-8f2f-3c9e-9789-39abbf6474c7",
                                "text": "2010, Aefke ten Hagen, In naam van mijn vader, Mistral/FMB Uitgevers.\n‘Peter!’ doet Wouter enthousiast. ‘Goed om jou hier te treffen!’\n‘Tja,’ lacht Peter. ‘Het is mijn toko.’\n‘Peter!’ says Wouter with enthusiasm. ‘Good to see you here!’",
                                "translation": "‘Well,’ Peter laughs. ‘It is my business.’",
                                "english": "‘Well,’ Peter laughs. ‘It is my business.’"
                            },
                            {
                                "example_id": "2a6e4435-9a48-42b9-b073-d7ac3a0f18b8",
                                "sense_id": "f9a5e5e5-8f2f-3c9e-9789-39abbf6474c7",
                                "text": "De andere Japanse games-toko, Nintendo genaamd, zegt ook een beter ontwikkelklimaat te willen voor indie-ontwikkelaars.",
                                "translation": "The other Japanese games company, called Nintendo, says it also wants a better development environment for indie developers.",
                                "english": "The other Japanese games company, called Nintendo, says it also wants a better development environment for indie developers."
                            },
                            {
                                "example_id": "c80b1fd7-3593-474a-ba8e-8aa1ab4fef38",
                                "sense_id": "f9a5e5e5-8f2f-3c9e-9789-39abbf6474c7",
                                "text": "Ga eens naar de balansen, kijken we wat die toko waard is.",
                                "translation": "Go check the balances, then we'll see what the value of that business is.",
                                "english": "Go check the balances, then we'll see what the value of that business is."
                            }
                        ]
                    }
                ],
