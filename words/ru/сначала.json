                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Артист сбился и начал песню <w>сначала</w>.",
                            "target_lang_translations": {
                                "en": "The artist made a mistake and started the song <w>from the beginning</w>.",
                                "cs": "Umělec se spletl a začal píseň <w>od začátku</w>.",
                                "zh": "歌手唱错了，于是<w>从头</w>开始唱这首歌。",
                                "nl": "De artiest maakte een fout en begon het lied <w>opnieuw</w>.",
                                "pl": "Artysta się pomylił i zaczął piosenkę <w>od początku</w>.",
                                "de": "Der Künstler hat sich versungen und begann das Lied <w>von vorn</w>.",
                                "fr": "L'artiste s'est trompé et a recommencé la chanson <w>depuis le début</w>.",
                                "it": "L'artista ha sbagliato e ha ricominciato la canzone <w>da capo</w>.",
                                "tr": "Sanatçı şaşırdı ve şarkıya <w>baştan</w> başladı.",
                                "es": "El artista se equivocó y empezó la canción <w>desde el principio</w>."
                            }
                        },
                        {
                            "text": "Если у тебя не получится, попробуй всё <w>сначала</w>.",
                            "target_lang_translations": {
                                "en": "If you don't succeed, try everything <w>all over again</w>.",
                                "cs": "Pokud se ti to nepovede, zkus všechno <w>nanovo</w>.",
                                "zh": "如果你没成功，那就<w>重新</w>试一遍。",
                                "nl": "Als het niet lukt, probeer dan alles <w>opnieuw</w>.",
                                "pl": "Jeśli ci się nie uda, spróbuj wszystkiego <w>od nowa</w>.",
                                "de": "Wenn es dir nicht gelingt, versuche alles <w>von Neuem</w>.",
                                "fr": "Si tu n'y arrives pas, essaie de tout refaire <w>à neuf</w>.",
                                "it": "Se non ci riesci, prova tutto <w>da capo</w>.",
                                "tr": "Eğer başaramazsan, her şeyi <w>baştan</w> dene.",
                                "es": "Si no te sale, intenta todo <w>de nuevo</w>."
                            }
                        }
