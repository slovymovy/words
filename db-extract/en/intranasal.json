                "senses": [
                    {
                        "sense_id": "f0d91996-9e4b-35bf-9ecf-9d29577d2a36",
                        "entry_id": "40cf6779-b365-3fe8-935d-6ea39ad36355",
                        "glosses": [
                            "Within the nose."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "9ebc7054-f47b-453a-beac-47e72f1dac7b",
                                "sense_id": "f0d91996-9e4b-35bf-9ecf-9d29577d2a36",
                                "text": "As to the question of hay fever and asthma, intranasal disease is not the cause of every case of these two diseases."
                            },
                            {
                                "example_id": "50342e44-33a2-4042-a8b4-8e9c3215fcbf",
                                "sense_id": "f0d91996-9e4b-35bf-9ecf-9d29577d2a36",
                                "text": "I speak in this manner because, recognizing the greater benefits of intranasal surgery, we can not but admit that there is always the danger of the pendulum swinging too far, of our being impelled by overzeal or ignorance, thus bringing discredit on measure which, if properly considered, would ever remain of inestimable value."
                            },
                            {
                                "example_id": "5ece5c8e-139e-490d-9fbc-41de0068cbbb",
                                "sense_id": "f0d91996-9e4b-35bf-9ecf-9d29577d2a36",
                                "text": "The functioning of these nontaste and nonolfactory sensory systems in oral and intranasal stimulation is the subject of a recent volume."
                            }
                        ]
                    },
                    {
                        "sense_id": "21f4e894-0965-3d87-99bd-7ad5a62ba0e8",
                        "entry_id": "40cf6779-b365-3fe8-935d-6ea39ad36355",
                        "glosses": [
                            "Taken through the nose."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "e823dc4c-2102-4294-b0f7-62e9d58b82e8",
                                "sense_id": "21f4e894-0965-3d87-99bd-7ad5a62ba0e8",
                                "text": "an intranasal vaccine"
                            },
                            {
                                "example_id": "caaad592-19d7-4c98-a5bc-3c80638dfe11",
                                "sense_id": "21f4e894-0965-3d87-99bd-7ad5a62ba0e8",
                                "text": "Puppies are usually immunized with intranasal vaccine before weaning."
                            },
                            {
                                "example_id": "8fc2a318-c48c-4a7d-83f3-edf7945e5666",
                                "sense_id": "21f4e894-0965-3d87-99bd-7ad5a62ba0e8",
                                "text": "A randomized controlled clinical trial (N = 187) using an intranasal morphine-chitosan formulation (Rylomine) postoperatively following bunionectomy in 187 opioid-naïve patients demonstrated that the intranasal analgesic was comparable to IV morphine for both pain relief and systemic adverse effects."
                            },
                            {
                                "example_id": "1a7e8c58-c157-49d3-bda3-8a1323e62402",
                                "sense_id": "21f4e894-0965-3d87-99bd-7ad5a62ba0e8",
                                "text": "In comparative studies, intranasal azelastine was more effective than placebo and at least as effective as oral antihistamines or intranasal corticosteroids in relieving allergic rhinitis."
                            }
                        ]
                    }
