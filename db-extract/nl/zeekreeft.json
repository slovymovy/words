                    {
                        "translation_id": "7c677b7d-b413-4d92-8baf-7be2d0547a23",
                        "source_entry_id": "a5fcda34-72ac-3053-a38b-409c872529ab",
                        "source_sense_id": "29783cfb-cac0-3b73-9ed0-914d7f8c6548",
                        "source_sense_description": "in zee levende kreeft",
                        "target_lang_word": "Hummer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hummer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "602324b0-1fb9-357f-90d5-cbfd3444fb76",
                                        "entry_id": "a559031f-b9b3-3799-a56f-a0d091c1ef73",
                                        "glosses": [
                                            "großer, langgestreckter, gepanzerter, zehnfüßiger Krebs mit gewaltigen Scheren an europäischen und nordamerikanischen Küsten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e440b2b6-8108-4fcc-afe1-eae131813b8f",
                                                "sense_id": "602324b0-1fb9-357f-90d5-cbfd3444fb76",
                                                "text": "Der Europäische Hummer bewohnt Felsgrund bei Helgoland."
                                            },
                                            {
                                                "example_id": "62b96ca6-92a6-4ad2-b737-5c18bf703cbd",
                                                "sense_id": "602324b0-1fb9-357f-90d5-cbfd3444fb76",
                                                "text": "„Auch unter Hummern gibt es Rechts- und Linkshänder.“"
                                            },
                                            {
                                                "example_id": "8e8261f1-d70e-4fed-8c58-42aba0d698ac",
                                                "sense_id": "602324b0-1fb9-357f-90d5-cbfd3444fb76",
                                                "text": "„Da lagen sie in Spankörben mit feuchter Holzwolle, fünf Dutzend Helgoländer Hummer.“"
                                            },
                                            {
                                                "example_id": "51fc76f8-dd3b-41fe-acc1-2059d2fe7022",
                                                "sense_id": "602324b0-1fb9-357f-90d5-cbfd3444fb76",
                                                "text": "„Die toten Fische glitzerten, die gefesselten Hummer bewegten sich frierend auf ihren Eisbetten, die Kellner balancierten Terrinen mit Fischsuppe über ihren Köpfen, das Lokal war voll, aber Hirsch war nicht da.“"
                                            },
                                            {
                                                "example_id": "e4d5887c-f223-4e16-a4f2-9ba0451d8ed7",
                                                "sense_id": "602324b0-1fb9-357f-90d5-cbfd3444fb76",
                                                "text": "„Der Hummer war zu einer schlammigen Flüssigkeit geworden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Hummer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "58a9af5c-8022-38be-a30d-50f42568c7f4",
                                        "entry_id": "201d3375-7a03-361b-acf9-eec558cd5a07",
                                        "glosses": [
                                            "Geländewagen-Marke des US-amerikanischen Herstellers General Motors"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5811462b-07f6-3f67-a3e1-f54a747efe69",
                                        "entry_id": "201d3375-7a03-361b-acf9-eec558cd5a07",
                                        "glosses": [
                                            "Fahrzeug von [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98dd1495-249c-4883-91a5-5f8bcd15eff4",
                                                "sense_id": "5811462b-07f6-3f67-a3e1-f54a747efe69",
                                                "text": "„Am anderen Ende des Spektrums gab es glitzernde Modelle von Mercedes, Lexus, BMW und Geländewagen, darunter die protzigsten und rücksichtslosesten von allen, die Hummer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
