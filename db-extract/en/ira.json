                            "initialism"
                        ],
                        "examples": [
                            {
                                "example_id": "4b7ac061-b3fc-4713-98ed-1403eac36aeb",
                                "sense_id": "a7744173-f760-3309-b1aa-f813df6f6544",
                                "text": "Since you fund a nondeductible IRA with already-taxed dollars, you might figure you wouldn't pay any income taxes on the conversion. But you wouldn't just owe tax on the funds you're converting; you'd also have to take the pretax contributions and gains in all your non-Roth IRAs into account."
                            },
                            {
                                "example_id": "7184d3b4-8e58-41f1-b38e-7741fec22d6a",
                                "sense_id": "a7744173-f760-3309-b1aa-f813df6f6544",
                                "text": "These were the liquefiable assets at hand: a drawerful of family jewelry, a 401(k), an IRA, and a one-bedroom condo purchased with inheritance money after her parents' passing."
                            }
                        ]
                    }
