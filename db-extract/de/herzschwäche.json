                            {
                                "example_id": "16d6bf26-4474-4f20-afc7-36d707cbf38f",
                                "sense_id": "e3c8cb2c-e297-3bbd-a574-6d03ae025687",
                                "text": "„Er sah außerdem, auf dem zweiten Formular, daß Bernhard Kruse an Herzschwäche gestorben sei.“"
                            },
                            {
                                "example_id": "4c31510b-3c27-4dee-ac94-799cbb8f753b",
                                "sense_id": "e3c8cb2c-e297-3bbd-a574-6d03ae025687",
                                "text": "„Am 6. Januar fühlte sich Wilhelm Busch plötzlich sehr schlecht, am siebenten konstatierte der Arzt große Herzschwäche, am 9. Januar 1908 starb er ruhig, ohne leiden zu müssen.“"
                            }
                        ],
