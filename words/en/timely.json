    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b4f6c3f6-32f1-38d0-a6c6-61fdb47c771b",
                    "sense_definition": "Done or occurring within the proper time limits; prompt.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "promptness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please ensure that you submit your application in a <w>timely</w> manner.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, обеспечьте <w>своевременную</w> подачу вашего заявления.",
                                "de": "Bitte stellen Sie sicher, dass Sie Ihre Bewerbung <w>fristgerecht</w> einreichen."
                            }
                        },
                        {
                            "text": "The company failed to provide a <w>timely</w> response to the customer's complaint.",
                            "target_lang_translations": {
                                "ru": "Компания не смогла предоставить <w>своевременный</w> ответ на жалобу клиента.",
                                "de": "Das Unternehmen hat es versäumt, eine <w>zeitnahe</w> Antwort auf die Beschwerde des Kunden zu geben."
                            }
                        }
                    ],
                    "synonyms": [
                        "prompt",
                        "punctual",
                        "on time"
                    ],
                    "antonyms": [
                        "late"
                    ],
                    "common_phrases": [
                        "timely manner",
                        "timely fashion",
                        "timely response",
                        "timely completion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный или происходящий в надлежащие сроки; оперативный.",
                        "de": "Erfolgt oder geschieht innerhalb der angemessenen Zeitvorgaben; prompt."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "своевременный",
                                "target_lang_sense_clarification": "сделанный вовремя"
                            },
                            {
                                "target_lang_word": "оперативный",
                                "target_lang_sense_clarification": "быстрый, незамедлительный"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "rechtzeitig",
                                "target_lang_sense_clarification": "zur rechten Zeit geschehend"
                            },
                            {
                                "target_lang_word": "fristgerecht",
                                "target_lang_sense_clarification": "innerhalb einer gesetzten Frist"
                            },
                            {
                                "target_lang_word": "zeitnah",
                                "target_lang_sense_clarification": "ohne großen zeitlichen Verzug"
                            }
                        ]
