                ],
                "senses": [
                    {
                        "sense_id": "92738229-3b34-3a0b-a7d1-6dd5899ca6f0",
                        "entry_id": "c622a8df-e09e-3dfd-b184-f59b3cb4d2e3",
                        "glosses": [
                            "allgemein: kulturelle Eigenart einer Region"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73b931dd-0416-46d4-ba5b-e9c97c6af78d",
                                "sense_id": "92738229-3b34-3a0b-a7d1-6dd5899ca6f0",
                                "text": "Zu den Regionalismen gehören z. B. die verschiedenen Essgebräuche wie die süddeutsche Bezeichnung Brotzeit."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "87b1539d-8acd-3f06-a654-feb32550b553",
                        "entry_id": "c622a8df-e09e-3dfd-b184-f59b3cb4d2e3",
                        "glosses": [
                            "Bestrebung zur Stärkung einer Region auf Kosten der Zentralmacht in einem Staat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc2e9cea-4771-47ca-948d-ff07526c6468",
                                "sense_id": "87b1539d-8acd-3f06-a654-feb32550b553",
                                "text": "„Als einheitlicher Staat haben wir nur dann eine Zukunft, wenn wir dem Regionalismus und der Spaltung widerstehen.“ (Der russische Metropolit Kyrill in einem Spiegel-Interview, DER SPIEGEL Nr.2/ 2008: S. 106)"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "154433f9-06f9-351f-bfd8-a16047059fd7",
                        "entry_id": "c622a8df-e09e-3dfd-b184-f59b3cb4d2e3",
                        "glosses": [
                            "auffälliges sprachliches Merkmal einer Region"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8024c6e7-5497-4d44-ae81-c47bfb3272f0",
                                "sense_id": "154433f9-06f9-351f-bfd8-a16047059fd7",
                                "text": "Sprachliche Regionalismen lassen erkennen, woher ein Sprecher kommt. Zu den schwäbischen Regionalismen gehört z. B. die Aussprache des Wortes bist als [bɪʃt]; ein rheinischer Regionalismus ist das Kohlsche [gəˈçɪçtlɪç] (\"geschichtlich\") statt [gəˈʃɪçtlɪç]. Regionalismen im Wortschatz sind z. B. die Bezeichnungen für den vorletzten Tag der Woche: süddeutsches Samstag und norddeutsches Sonnabend."
                            },
                            {
                                "example_id": "d058f87f-db2f-445a-a6fb-c142efc96bf1",
                                "sense_id": "154433f9-06f9-351f-bfd8-a16047059fd7",
                                "text": "„In diesem Buch finden diese Verbiegungen keine Aufmerksamkeit, auch nicht die zahlreichen Regionalismen aus Mundart und Dialekt, mit denen sich eigene Lexika beschäftigen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49f48537-d136-406c-a5dc-c3b8d72d28fc",
                        "source_entry_id": "c622a8df-e09e-3dfd-b184-f59b3cb4d2e3",
                        "source_sense_id": "92738229-3b34-3a0b-a7d1-6dd5899ca6f0",
                        "source_sense_description": "allgemein: kulturelle Eigenart einer Region",
                        "target_lang_word": "regionalism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "regionalism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32552406-aa8a-3f8d-9baf-7360c9dff24e",
                                        "entry_id": "715e04ad-d311-3700-86cd-0ce402214499",
                                        "glosses": [
                                            "Affection, often excessive, for one's own region and to everything related to it."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81d2423f-f8bc-409e-8b35-1829f7ee7452",
                                                "sense_id": "32552406-aa8a-3f8d-9baf-7360c9dff24e",
                                                "text": "Whereas organizations such as the WIFA and CU confirmed regional West Indian identifications and represented the connections between transnational West Indian organizations and black diaspora politics, the JPL, as a transnational Jamaican organization, demonstrates that the regionalism that took root among many West Indian expatriates in these years did not negate all expatriates' islandist perspectives and allegiances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be58343b-6ed3-397d-bbad-4179d1fde0bb",
                                        "entry_id": "715e04ad-d311-3700-86cd-0ce402214499",
                                        "glosses": [
                                            "The belief that most or nearly all political power should be decentralized to regional governments."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ead3ec14-1b9d-3c3d-aec0-c186a353c262",
                                        "entry_id": "715e04ad-d311-3700-86cd-0ce402214499",
                                        "glosses": [
                                            "A word or phrase originating in, characteristic of, or limited to a region."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df7f345e-d612-4a34-823f-e918b62496b1",
                                                "sense_id": "ead3ec14-1b9d-3c3d-aec0-c186a353c262",
                                                "text": "... the formal normative variety of the language as it is used today in formal writing by educated native speakers. As a result, we have eschewed dialectisms and regionalisms. The English variety employed in the book is formal British English, ..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "171557bf-40fe-382d-bec5-445e5c9d219b",
                                        "entry_id": "715e04ad-d311-3700-86cd-0ce402214499",
                                        "glosses": [
                                            "Regional character, local color."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c086ee5f-8c2d-4bff-b4b3-2b71c5bf22bd",
                                                "sense_id": "171557bf-40fe-382d-bec5-445e5c9d219b",
                                                "text": "Director Deitch has filled the sountrack with country music classics […] and this adds to the regionalism of the film as well as to the feeling which buoys the movie up from simplistic formula to romantic reverie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ebca9341-691a-4b91-8d80-506a050db066",
                        "source_entry_id": "c622a8df-e09e-3dfd-b184-f59b3cb4d2e3",
                        "source_sense_id": "92738229-3b34-3a0b-a7d1-6dd5899ca6f0",
                        "source_sense_description": "allgemein: kulturelle Eigenart einer Region",
                        "target_lang_word": "régionalisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "régionalisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2291959f-a9ed-373a-a36c-929fd7f1cef1",
                                        "entry_id": "4591ac18-81fd-3c70-911a-396788062080",
                                        "glosses": [
                                            "Mot ou expression particulière à une région, un pays."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb7dfd3b-d549-43c9-96f2-414f9e8391eb",
                                                "sense_id": "2291959f-a9ed-373a-a36c-929fd7f1cef1",
                                                "text": "Les Flamands \"déjoualisent\" : en accédant au statut de \"nation\", au cours des années soixante, les Flamands, jadis dominés par les Wallons francophones, se sont rendus compte que le \"flamand\", cet ensemble de dialectes et de patois du néerlandais, bourré d’archaïsmes, de régionalismes, de gallicismes et de germanismes, ne pourrait leur servir de langue nationale."
                                            },
                                            {
                                                "example_id": "c9ec044d-c0ea-4d40-968e-e4e6281cd276",
                                                "sense_id": "2291959f-a9ed-373a-a36c-929fd7f1cef1",
                                                "text": "Certains régionalismes ressemblent exactement à des faits de l’ancien français."
                                            },
                                            {
                                                "example_id": "7ba3098d-0a79-44a1-8b4c-41bf13a62fa0",
                                                "sense_id": "2291959f-a9ed-373a-a36c-929fd7f1cef1",
                                                "text": "Les régionalismes tombent progressivement dans l’oubli en raison de l’influence des institutions (par ex. l’école, l’armée), de l’influence des médias, de l’éclatement du noyau familial et des modifications fondamentales du mode de vie (cf. Maurel 2017: 113)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "414c5f7d-8eb4-3d7c-abf5-a917dd1909d7",
                                        "entry_id": "4591ac18-81fd-3c70-911a-396788062080",
                                        "glosses": [
                                            "Tendance à favoriser le développement autonome des régions et à en conserver la physionomie, les mœurs, les coutumes, les traditions historiques."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "be175f9e-8cff-3a74-afb5-bdbc4fe1deef",
                                        "entry_id": "4591ac18-81fd-3c70-911a-396788062080",
                                        "glosses": [
                                            "Tendance à ne valoriser qu’une région ou à se limiter à ses réalités."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a73f90c-388d-4212-84d1-100e05ce2dd3",
                                                "sense_id": "be175f9e-8cff-3a74-afb5-bdbc4fe1deef",
                                                "text": "À la fois ouverte sur le monde et enracinée dans son milieu, La Peuplade témoigne manifestement du fait que l’édition en région n’est pas synonyme de régionalisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
