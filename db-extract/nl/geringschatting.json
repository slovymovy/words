                "senses": [
                    {
                        "sense_id": "f1ea9b71-c2a9-32ee-a7ef-f194e108eb0a",
                        "entry_id": "ae97c6a0-9ab0-3b1b-9d44-ecec58555d49",
                        "glosses": [
                            "iets of iemand als minderwaardig beschouwen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "648e96f8-9c66-4aa4-9bb0-d8e3623d360f",
                                "sense_id": "f1ea9b71-c2a9-32ee-a7ef-f194e108eb0a",
                                "text": "Daar geloof ik niets van, zei Levin met een glimlach en als altijd voelde hij zich geroerd door deze geringschatting van zichzelf die bij Ljvov in het geheel niet voortkwam uit de wens bescheiden te schijnen of het te zijn, maar die volkomen oprecht was."
                            },
                            {
                                "example_id": "67ead977-3e26-4802-804e-b49c35e0ada7",
                                "sense_id": "f1ea9b71-c2a9-32ee-a7ef-f194e108eb0a",
                                "text": "De Duitse president laat Der Spiegel weten dat zijn beslissing om de Winterspelen in Sotsji te boycotten zeker niet als een geringschatting naar de atleten opgevat moet worden. Hij zal de Duitse deelnemers op 24 februari bij hun terugkeer in München ontvangen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e43814df-1698-4cb8-b12b-b7c62f463be5",
                        "source_entry_id": "ae97c6a0-9ab0-3b1b-9d44-ecec58555d49",
                        "source_sense_id": "f1ea9b71-c2a9-32ee-a7ef-f194e108eb0a",
                        "target_lang_word": "discredit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "discredit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc1a0bae-2eda-336b-8450-9f7b2507631e",
                                        "entry_id": "177e0d08-d44d-3c9f-827d-0cf2ba1d5bca",
                                        "glosses": [
                                            "To harm the good reputation of (a person)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ced2ab4-c1ea-4869-b69f-a1ae8fb6e6e3",
                                                "sense_id": "cc1a0bae-2eda-336b-8450-9f7b2507631e",
                                                "text": "The candidate tried to discredit his opponent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e57a839f-68b1-3beb-96e8-a85bfe8fa9d6",
                                        "entry_id": "177e0d08-d44d-3c9f-827d-0cf2ba1d5bca",
                                        "glosses": [
                                            "To cause (an idea or piece of evidence) to seem false or unreliable."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8472330-a08b-434a-a879-b7ee04c8bc9c",
                                                "sense_id": "e57a839f-68b1-3beb-96e8-a85bfe8fa9d6",
                                                "text": "The evidence would tend to discredit such a theory."
                                            },
                                            {
                                                "example_id": "c6797147-640c-4ed5-8649-234fe5957b8c",
                                                "sense_id": "e57a839f-68b1-3beb-96e8-a85bfe8fa9d6",
                                                "text": "Many of our correspondents participated in the discussion, and the upshot was that the alleged record was discredited."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "discredit",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "51073ba6-9c17-3283-aadd-04aff9f38531",
                                        "entry_id": "6d452eb6-989b-300e-86b6-504a715f47e4",
                                        "glosses": [
                                            "Discrediting or disbelieving."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24928542-32a4-4444-a49c-3f201a6f2b9a",
                                                "sense_id": "51073ba6-9c17-3283-aadd-04aff9f38531",
                                                "text": "Mr. Burton disbelieves it, and has brought sufficient reasons for his discredit of so improbable a story."
                                            },
                                            {
                                                "example_id": "3503327d-0c33-4079-aa4a-35734aa7b998",
                                                "sense_id": "51073ba6-9c17-3283-aadd-04aff9f38531",
                                                "text": "It would have been too serious a task to verify his numerous citations in our very careful reading for the present notice; but we are bound to say that, observing his discredit of some of the passages which he quotes from a contemporary American writer, and struck ourselves with the apparent inexactness of the statements in teste extracts (pp. 579, 616, 647), we were led to compare his citations, and, to our surprise, we find them incorrect and even garbled, and in one place where he had queried (thus (?)) the fact, we were surprised to find the doubt pertained to one of his own interpolations in the extracts."
                                            },
                                            {
                                                "example_id": "67247b71-e66b-4601-a9ad-85c0ef5b4539",
                                                "sense_id": "51073ba6-9c17-3283-aadd-04aff9f38531",
                                                "text": "Madan encouraged many believers in the supremacy of justice to struggle for human rights within the established systems in order to purify the image of the national institutions against any discredits by biased and unjust people."
                                            },
                                            {
                                                "example_id": "f558c173-ea4d-45f5-9f88-ab1119651602",
                                                "sense_id": "51073ba6-9c17-3283-aadd-04aff9f38531",
                                                "text": "As we find in a number of parts of Cho\\ng's writings his belief in the personified image of Heaven and his discredit of the fundamental and universal nature and the ultimacy of li, we find it difficult to assume that he was not affected by the Jesuit writings he had read."
                                            },
                                            {
                                                "example_id": "35e74d48-8aaa-45da-b978-044bd5796007",
                                                "sense_id": "51073ba6-9c17-3283-aadd-04aff9f38531",
                                                "text": "The detractors of the Christian faith seem to revel in their \"discredit of anything scientific concerning the basis of the belief that God is the causal Creator of man, yet offer no scientific 'proof that their criticisms are valid and their beliefs that there is no God, or first cause in creation, are provable by the evidence they present to the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "517a9c0e-86a2-3078-ba4f-4d062615cabe",
                                        "entry_id": "6d452eb6-989b-300e-86b6-504a715f47e4",
                                        "glosses": [
                                            "A person or thing that causes harm to a reputation, as of a person, family, or institution."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16d35928-9e1d-4df2-bbb3-c020686c9e5c",
                                                "sense_id": "517a9c0e-86a2-3078-ba4f-4d062615cabe",
                                                "text": "[…] that now and then a young man of that profession did actually appear among us, who was not a discredit to his country."
                                            },
                                            {
                                                "example_id": "b2a2603b-abf0-43b3-9c9d-01649bffae6f",
                                                "sense_id": "517a9c0e-86a2-3078-ba4f-4d062615cabe",
                                                "text": "I felt at the time that to pass it so hastily would be a discredit to Parliament, as custodian of the liberties of the people of this country. I felt, too, that it would be a discredit to the colony, and a discredit, a deep discredit, to the Government"
                                            },
                                            {
                                                "example_id": "8328a498-57f5-4803-8936-28437529f23c",
                                                "sense_id": "517a9c0e-86a2-3078-ba4f-4d062615cabe",
                                                "text": "The animal informed me that if it were not for the great game of baseball I would be chopping cotton or pushing a broom. And that I was a discredit to my race. By definition, any black hurts his people if he is other than abjectly, supinely, hand-lickingly grateful for having been allowed to earn a decent living."
                                            },
                                            {
                                                "example_id": "00dcf4e8-8a17-495d-9c48-61742f5501f1",
                                                "sense_id": "517a9c0e-86a2-3078-ba4f-4d062615cabe",
                                                "text": "And for now to have a policy where those fine Americans can only serve if they lie about who they are is a discredit to the American people. It is a discredit to their service and their opportunity. It is a discredit to people who have died in service."
                                            },
                                            {
                                                "example_id": "8d4f2a0d-1eb7-4ee7-a151-e59a26172058",
                                                "sense_id": "517a9c0e-86a2-3078-ba4f-4d062615cabe",
                                                "text": "Inadequate, undisciplined, and nondevoted teachers are discredits to the schools they serve."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dbf36d0-b1ec-3cb7-9086-a500df770317",
                                        "entry_id": "6d452eb6-989b-300e-86b6-504a715f47e4",
                                        "glosses": [
                                            "The state of being discredited or disbelieved."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3b21650-2b58-4773-bb6b-f1421693901d",
                                                "sense_id": "1dbf36d0-b1ec-3cb7-9086-a500df770317",
                                                "text": "Later accounts have brought the story into discredit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30d53576-11a1-3efb-aa92-f3c02c723c67",
                                        "entry_id": "6d452eb6-989b-300e-86b6-504a715f47e4",
                                        "glosses": [
                                            "A degree of dishonour or disesteem; ill repute; reproach."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "373a2da0-166c-4a89-9474-daca9ff6a4fd",
                                                "sense_id": "30d53576-11a1-3efb-aa92-f3c02c723c67",
                                                "text": "It is the duty of every Christian to be concerned for the reputation or discredit his life may bring on his profession."
                                            },
                                            {
                                                "example_id": "f672fe93-abf9-4514-ba34-b58de3ef9eda",
                                                "sense_id": "30d53576-11a1-3efb-aa92-f3c02c723c67",
                                                "text": "It is to David Brill's discredit that he allowed himself — a long-time activist in the gay community and a paid staff writer for a gay liberation newspaper — to use his extensive news sources and a solid standing in the community to participate in what appears to be at this time a well-organized police entrapment of a gay man whom many are eager to indict and imprison."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d98ff74d-6a78-4a9f-b7b1-934ff6c659cf",
                        "source_entry_id": "ae97c6a0-9ab0-3b1b-9d44-ecec58555d49",
                        "source_sense_id": "f1ea9b71-c2a9-32ee-a7ef-f194e108eb0a",
                        "target_lang_word": "floccinaucinihilipilification",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "floccinaucinihilipilification",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8da3b357-b9ba-3508-9085-593c9b3201a3",
                                        "entry_id": "8608f65c-68fd-3370-8750-a3b3e281fea3",
                                        "glosses": [
                                            "The act or habit of describing or regarding something as unimportant, of having no value or being worthless."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fec2112-592e-49ef-ad85-15a6eafad85c",
                                                "sense_id": "8da3b357-b9ba-3508-9085-593c9b3201a3",
                                                "text": "I loved him for nothing so much as his flocci-nauci-nihili-pili-fication of money."
                                            },
                                            {
                                                "example_id": "1984a675-226f-4c05-a30a-0299dcb7d895",
                                                "sense_id": "8da3b357-b9ba-3508-9085-593c9b3201a3",
                                                "text": "There is a systematic flocci-nauci-nihili-pilification of all other aspects of existence that angers me."
                                            },
                                            {
                                                "example_id": "9dddfc19-2464-4ed4-8f6d-c8a8c0ad6969",
                                                "sense_id": "8da3b357-b9ba-3508-9085-593c9b3201a3",
                                                "text": "Floccinaucinihilipilification in accounting - does it matter?"
                                            },
                                            {
                                                "example_id": "8c1f63ef-8db2-4e37-a8f1-e4a780c1f7ea",
                                                "sense_id": "8da3b357-b9ba-3508-9085-593c9b3201a3",
                                                "text": "They must be taken with an air of contempt, a floccinaucinihilipilification of all that can gratify the outward man."
                                            },
                                            {
                                                "example_id": "233d18b8-80f3-4992-8151-197a8ea1ceed",
                                                "sense_id": "8da3b357-b9ba-3508-9085-593c9b3201a3",
                                                "text": "Some people with low self-esteem are prone to floccinaucinihilipilification, the habit of deeming everything worthless."
                                            },
                                            {
                                                "example_id": "48fbad75-24c6-47b5-b851-16bb24101520",
                                                "sense_id": "8da3b357-b9ba-3508-9085-593c9b3201a3",
                                                "text": "The quasi statistician would doubtlessly not know how to check this supposition, thus rendering the interpretation of the mean profit as floccinaucinihilipilification."
                                            },
                                            {
                                                "example_id": "0232be5b-bc93-471b-820d-025bd42f0821",
                                                "sense_id": "8da3b357-b9ba-3508-9085-593c9b3201a3",
                                                "text": "Let me indulge in the floccinaucinihilipilification of EU judges and quote from the book of Amos about them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49110731-f00a-43a2-a05a-15690ffd5557",
                        "source_entry_id": "ae97c6a0-9ab0-3b1b-9d44-ecec58555d49",
                        "source_sense_id": "f1ea9b71-c2a9-32ee-a7ef-f194e108eb0a",
                        "target_lang_word": "disregard",
