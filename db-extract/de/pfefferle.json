                ],
                "senses": [
                    {
                        "sense_id": "736c3692-5960-37d1-9ca1-aa5c3c4e3db3",
                        "entry_id": "abc1279a-2949-30af-a24e-0d781ec1adfc",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abaef83d-23be-43b0-a7de-6eef02896b9e",
                                "sense_id": "736c3692-5960-37d1-9ca1-aa5c3c4e3db3",
                                "text": "Frau Pfefferle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d4b3f245-90c7-4e04-9ada-557502460753",
                                "sense_id": "736c3692-5960-37d1-9ca1-aa5c3c4e3db3",
                                "text": "Herr Pfefferle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ba21cedf-1ee2-4a94-88d8-a350d5858c27",
                                "sense_id": "736c3692-5960-37d1-9ca1-aa5c3c4e3db3",
                                "text": "Die Pfefferles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "f0bc558b-7ee0-41fd-8d98-cf4213dc9696",
                                "sense_id": "736c3692-5960-37d1-9ca1-aa5c3c4e3db3",
                                "text": "Der Pfefferle trägt nie die Pullover, die die Pfefferle ihm strickt."
                            },
                            {
                                "example_id": "e0292324-5694-43d1-9d4d-a3de6888901b",
                                "sense_id": "736c3692-5960-37d1-9ca1-aa5c3c4e3db3",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Pfefferle kommt, geht der Herr Pfefferle.“"
                            },
                            {
                                "example_id": "1ab908bc-c56e-491f-8bfd-f674f0104634",
                                "sense_id": "736c3692-5960-37d1-9ca1-aa5c3c4e3db3",
                                "text": "Pfefferle kommt und geht."
                            },
                            {
                                "example_id": "8da3b624-1bb4-46c8-8f60-8c3583f7267b",
                                "sense_id": "736c3692-5960-37d1-9ca1-aa5c3c4e3db3",
                                "text": "Pfefferles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
