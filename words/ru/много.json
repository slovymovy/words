    "entries": [
        {
            "pos": "numeral",
            "senses": [
                {
                    "sense_id": "524cce95-887c-3137-98d4-07b4edea1014",
                    "sense_definition": "Большое, значительное количество кого-либо или чего-либо.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У нас сегодня очень <много> работы.",
                            "target_lang_translations": {
                                "en": "We have so <much> work today.",
                                "tr": "Bugün yapacak <w>çok</w> işimiz var."
                            }
                        },
                        {
                            "text": "На площади собралось <много> людей.",
                            "target_lang_translations": {
                                "en": "<Many> people gathered in the square.",
                                "tr": "Meydanda <w>birçok</w> insan toplandı."
                            }
                        },
                        {
                            "text": "В этом году в саду выросло <много> яблок.",
                            "target_lang_translations": {
                                "en": "<A lot of> apples grew in the garden this year.",
                                "tr": "Bu yıl bahçede <w>çok</w> elma yetişti."
                            }
                        }
                    ],
                    "synonyms": [
                        "немало",
                        "мо́ре",
                        "куры не клюю́т",
                        "куча",
                        "масса"
                    ],
                    "antonyms": [
                        "ма́ло",
                        "немного"
                    ],
                    "common_phrases": [
                        "много раз",
                        "много лет",
                        "очень много",
                        "так много",
                        "как много"
                    ],
                    "target_lang_definitions": {
                        "en": "A large number or amount of people or things.",
                        "tr": "Bir şeyin veya birilerinin büyük, önemli miktarda olması."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "many",
                                "target_lang_sense_clarification": "used with countable nouns (e.g., people, apples)"
                            },
                            {
                                "target_lang_word": "much",
                                "target_lang_sense_clarification": "used with uncountable nouns (e.g., work, water)"
                            },
                            {
                                "target_lang_word": "a lot of",
                                "target_lang_sense_clarification": "general use, suitable for both countable and uncountable nouns"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "çok",
                                "target_lang_sense_clarification": "hem sayılabilen hem de sayılamayan isimlerle kullanılan genel miktar belirteci"
                            },
                            {
                                "target_lang_word": "birçok",
                                "target_lang_sense_clarification": "sayılabilen çoğul nesneler veya insanlar için"
                            },
                            {
                                "target_lang_word": "pek çok",
                                "target_lang_sense_clarification": "vurgulu bir şekilde oldukça fazla miktarı belirtmek için"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "da99432a-0e4f-3239-b38e-137bbbbfcc19",
                    "sense_definition": "В значительной степени, интенсивно, часто или долго (о действии).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой брат <много> работает и редко отдыхает.",
                            "target_lang_translations": {
                                "en": "My brother works <a lot> and rarely rests.",
                                "tr": "Erkek kardeşim <w>çok</w> çalışıyor ve nadiren dinleniyor."
                            }
                        },
                        {
                            "text": "Ты слишком <много> говоришь, но мало делаешь.",
                            "target_lang_translations": {
                                "en": "You talk too <much>, but do little.",
                                "tr": "Çok <w>fazla</w> konuşuyorsun ama az iş yapıyorsun."
                            }
                        }
                    ],
                    "synonyms": [
                        "о́чень",
                        "часто",
                        "немало`",
                        "немало"
                    ],
                    "antonyms": [
                        "ма́ло"
                    ],
                    "common_phrases": [
                        "много знать",
                        "много думать",
                        "много читать",
                        "много спать"
                    ],
                    "target_lang_definitions": {
                        "en": "To a great extent, frequently, or for a long time.",
                        "tr": "Bir eylemin önemli derecede, yoğun, sık veya uzun süre yapılması."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "a lot",
                                "target_lang_sense_clarification": "common adverb for frequency or intensity"
                            },
                            {
                                "target_lang_word": "much",
                                "target_lang_sense_clarification": "often used in negative sentences, questions, or with 'too/so'"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "çok",
                                "target_lang_sense_clarification": "eylemin yoğunluğunu veya sıklığını belirten genel zarf"
                            },
                            {
                                "target_lang_word": "sık sık",
                                "target_lang_sense_clarification": "eylemin tekrarlanma sıklığını vurgulamak için"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e919206e-b52f-3ee3-8a6e-d0cf5201ed06",
                    "sense_definition": "Больше, чем нужно или желательно; чрезмерно.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "excess",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Пять тысяч рублей за такой обед — это <много>.",
                            "target_lang_translations": {
                                "en": "Five thousand rubles for such a lunch is <a lot>.",
                                "tr": "Böyle bir öğle yemeği için beş bin ruble <w>çok</w>."
                            }
                        },
                        {
                            "text": "Для одного человека целого торта будет <много>.",
                            "target_lang_translations": {
                                "en": "A whole cake will be <too much> for one person.",
                                "tr": "Bir kişi için bütün bir pasta <w>fazla</w> gelecektir."
                            }
                        }
                    ],
                    "synonyms": [
                        "чрезмерно",
                        "в избы́тке"
                    ],
                    "antonyms": [
                        "ма́ло",
                        "недостаточно"
                    ],
                    "common_phrases": [
                        "этого много",
                        "слишком много"
                    ],
                    "target_lang_definitions": {
                        "en": "A large amount; more than is reasonable or required.",
                        "tr": "Gerekenden veya istenenden daha fazla; aşırı miktarda."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "a lot",
                                "target_lang_sense_clarification": "indicating a large quantity"
                            },
                            {
                                "target_lang_word": "too much",
                                "target_lang_sense_clarification": "indicating an excessive amount"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "fazla",
                                "target_lang_sense_clarification": "gereğinden veya alışılmış olandan çok olan"
                            },
                            {
                                "target_lang_word": "çok",
                                "target_lang_sense_clarification": "aşırı veya yüksek miktarı belirtmek için"
                            },
                            {
                                "target_lang_word": "aşırı",
                                "target_lang_sense_clarification": "normal sınırları aşan miktarda"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6cf954d4-1efe-3e95-852f-40268007e1a1",
                    "sense_definition": "Значительно, гораздо (используется для усиления сравнительной степени прилагательных или наречий).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "comparative_modifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот путь оказался <много> длиннее, чем мы ожидали.",
                            "target_lang_translations": {
                                "en": "This path turned out to be <much> longer than we expected.",
                                "tr": "Bu yol beklediğimizden <w>çok</w> daha uzun çıktı."
                            }
                        },
                        {
                            "text": "Его новая книга <много> интереснее предыдущей.",
                            "target_lang_translations": {
                                "en": "His new book is <much> more interesting than the previous one.",
                                "tr": "Onun yeni kitabı öncekinden <w>kat kat</w> daha ilginç."
                            }
                        }
                    ],
                    "synonyms": [
                        "гораздо",
                        "значительно"
                    ],
                    "antonyms": [
                        "незначительно"
                    ],
                    "common_phrases": [
                        "много лучше",
                        "много больше",
                        "много хуже"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often replaced by 'гораздо' in modern speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Significantly; used to emphasize a comparative adjective or adverb.",
                        "tr": "Sıfat veya zarfların karşılaştırma derecesini güçlendirmek için kullanılan 'çok daha', 'kat kat' anlamında pekiştirici sözcük."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "much",
                                "target_lang_sense_clarification": "standard intensifier for comparatives"
                            },
                            {
                                "target_lang_word": "far",
                                "target_lang_sense_clarification": "emphasizes a large difference"
                            },
                            {
                                "target_lang_word": "a lot",
                                "target_lang_sense_clarification": "informal intensifier"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "çok",
                                "target_lang_sense_clarification": "karşılaştırmayı pekiştirmek için (örn. çok daha iyi)"
                            },
                            {
                                "target_lang_word": "kat kat",
                                "target_lang_sense_clarification": "büyük bir farkı vurgulamak için"
                            },
                            {
                                "target_lang_word": "hayli",
                                "target_lang_sense_clarification": "oldukça, epey anlamında pekiştirici"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "783ed440-1f8b-328f-a9a9-5714419c8939",
                    "sense_definition": "Не больше чем; максимум (при указании предельного количества).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "limit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ему сейчас двадцать, <много> двадцать два года.",
                            "target_lang_translations": {
                                "en": "He is twenty, <at most> twenty-two years old now.",
                                "tr": "Şu an yirmi, <w>en fazla</w> yirmi iki yaşındadır."
                            }
                        },
                        {
                            "text": "В комнате поместится один, <много> два стола.",
                            "target_lang_translations": {
                                "en": "The room will fit one, <at most> two tables.",
                                "tr": "Odaya bir, <w>olsa olsa</w> iki masa sığar."
                            }
                        }
                    ],
                    "synonyms": [
                        "максимум",
                        "не больше, чем"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Not more than; at the maximum limit.",
                        "tr": "En fazla, maksimum; belirtilen üst sınırı aşmayacak şekilde."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "at most",
                                "target_lang_sense_clarification": "indicating an upper limit"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "en fazla",
                                "target_lang_sense_clarification": "üst sınırı belirtmek için"
                            },
                            {
                                "target_lang_word": "olsa olsa",
                                "target_lang_sense_clarification": "tahmini bir üst sınırı vurgulayan konuşma dili ifadesi"
                            },
                            {
                                "target_lang_word": "en çok",
                                "target_lang_sense_clarification": "maksimum miktarı belirtmek için"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}