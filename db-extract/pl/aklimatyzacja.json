                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "39360e25-2eb3-3bfa-8b9a-95e08dc0a7c4",
                        "entry_id": "2d8832cc-4554-3c0d-94a9-4c3785a1be7e",
                        "glosses": [
                            "Anpassung an eine neue Lebenssituation; Akklimatisation"
