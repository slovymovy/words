                "senses": [
                    {
                        "sense_id": "ed7644cf-ec7d-33db-876d-8abbc5b30a43",
                        "entry_id": "8bd3763a-c959-3eb7-ab82-c2a419ec5306",
                        "glosses": [
                            "Messer zum Tranchieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ec1083f-1d7b-4c2f-91cf-3656193763f8",
                                "sense_id": "ed7644cf-ec7d-33db-876d-8abbc5b30a43",
                                "text": "„Daneben legte er außerdem zwei andere Haushaltsgeräte: einen langen Teppichklopfer aus geflochtenem Rohr und ein Tranchiermesser.“"
                            },
                            {
                                "example_id": "ea20e0f0-867a-4e2b-ab8a-24238ff9331e",
                                "sense_id": "ed7644cf-ec7d-33db-876d-8abbc5b30a43",
                                "text": "„Das Weibchen benutzt Tranchiermesser, um den Zombies die Hände abzuschneiden.“"
                            },
                            {
                                "example_id": "ec51a4b6-b83d-43e9-b6eb-f843b95d824a",
                                "sense_id": "ed7644cf-ec7d-33db-876d-8abbc5b30a43",
                                "text": "„Und da sieht er so einiges. Leichen von mit Kanthölzern, Baseballschlägern, Wagenhebern und Ziegelsteinen Erschlagenen. Leichen mit klaffenden Wunden von Tranchiermessern oder von so dicht aufgesetzten Waffen, dass der Pfropfen der Patrone, welcher das Pulver vom Projektil trennt, tief ins Fleisch eingedrungen ist.“"
                            },
                            {
                                "example_id": "023480f6-583b-4fe8-90c8-8a163a425d73",
                                "sense_id": "ed7644cf-ec7d-33db-876d-8abbc5b30a43",
                                "text": "„Der Mann taumelte schockiert zurück und griff dabei nach einem Tranchiermesser, das auf dem Tisch lag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
