                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f40970a0-fe51-487c-8095-bffde98c8951",
                                                "sense_id": "006463c6-515a-32dd-82e1-3a739a088787",
                                                "text": "With eyes like carbuncles, the hellish Pyrrhus […]"
                                            },
                                            {
                                                "example_id": "69ce4e3e-8954-4807-b0af-6089966857dc",
                                                "sense_id": "006463c6-515a-32dd-82e1-3a739a088787",
                                                "text": "And I will make thy windows of agates, and thy gates of carbuncles, and all thy borders of pleasant stones."
                                            },
                                            {
                                                "example_id": "811a9f14-66c1-4d4e-8074-6afc6ad5723a",
                                                "sense_id": "006463c6-515a-32dd-82e1-3a739a088787",
                                                "text": "His turban, or mandil [mandīl], was of finest white silk interwoven with gold, bestudded with pearl[s] and carbuncles; […]"
                                            },
                                            {
                                                "example_id": "4ce25388-4ee8-443d-9faa-cc48f87a3f7b",
                                                "sense_id": "006463c6-515a-32dd-82e1-3a739a088787",
                                                "text": "A piece of marigold or bay leaf was imbedded in the metal, and over it a carbuncle or chrysolite was placed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52aec426-78b2-3677-a6b6-4b4739830dd4",
                                        "entry_id": "e2f9727a-2de2-3761-b429-6e5edc6555a9",
                                        "glosses": [
                                            "A charge or bearing supposed to represent the precious stone, with eight sceptres or staves radiating from a common centre; an escarbuncle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d25045c8-bce7-3dd1-9328-88e02afc131f",
                                        "entry_id": "e2f9727a-2de2-3761-b429-6e5edc6555a9",
                                        "glosses": [
                                            "An abscess larger than a boil, usually with one or more openings draining pus onto the skin. It is usually caused by staphylococcal infection."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9ce63526-7272-3c66-b28e-189d34de7a68",
                                        "entry_id": "e2f9727a-2de2-3761-b429-6e5edc6555a9",
                                        "glosses": [
                                            "An unpopular or ugly building; an eyesore."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
