                ],
                "senses": [
                    {
                        "sense_id": "7374de87-d77e-3e32-9c0f-edff619ee294",
                        "entry_id": "4fa971c0-f0da-32d2-9e09-dd699bbb5b02",
                        "glosses": [
                            "Raum in einem Gastlokal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "339250c7-0653-4491-a7db-4dbd059bb07d",
                                "sense_id": "7374de87-d77e-3e32-9c0f-edff619ee294",
                                "text": "„Blaß und still ist am nächsten Abend auf einen Wink von Meck der kleine Lüders aus dem Lokal gekommen, und sie sind ins Gastzimmer gegangen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3a90a840-0097-398e-bc9f-cc8361caaf8b",
                        "entry_id": "4fa971c0-f0da-32d2-9e09-dd699bbb5b02",
                        "glosses": [
                            "Zimmer für Privatgäste in einer Wohnung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9871c50-cddf-4146-8057-d6bae6b141be",
                                "sense_id": "3a90a840-0097-398e-bc9f-cc8361caaf8b",
                                "text": "„Hinter dem Portale zum zweiten Hofe befanden sich beiderseits dreiräumige Nebenhäuser, die ein kleines einräumiges Gastzimmer enthielten.“"
                            },
                            {
                                "example_id": "045e55bc-7061-4b5b-8660-9b0195f20dd6",
                                "sense_id": "3a90a840-0097-398e-bc9f-cc8361caaf8b",
                                "text": "„Er brach mit einer vielsagenden Geste ab, mit der er den unfertigen Zustand der Gastzimmer andeuten mochte, die eher der Aufnahme von Geräten als von Personen dienten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "ef6a3de7-67ed-3437-aed6-a109d18d2634",
                        "entry_id": "4fa971c0-f0da-32d2-9e09-dd699bbb5b02",
                        "glosses": [
                            "gegen Bezahlung vermietetes Zimmer"
