                                "target_senses": [
                                    {
                                        "sense_id": "c8703167-914f-37c9-b030-c6f4e909c308",
                                        "entry_id": "3573ba1e-47eb-39c0-9a14-9000fce7e66f",
                                        "glosses": [
                                            "als horend of passend bij een prins of prinses, bestaand uit prinsen of prinsessen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6430a81e-8fd5-424b-94c9-f3984b411220",
                                                "sense_id": "c8703167-914f-37c9-b030-c6f4e909c308",
                                                "text": "De Stichting Prins Laurent heeft zaterdag twintig kaarsjes uitgeblazen in Terhulpen. Prinses Claire en de kinderen van het prinselijk koppel waren aanwezig, maar de prins kon er om gezondheidsredenen niet bij zijn."
                                            },
                                            {
                                                "example_id": "3d957214-1a0a-4dea-a793-c9c820e13ce8",
                                                "sense_id": "c8703167-914f-37c9-b030-c6f4e909c308",
                                                "text": "Pas in 2013 besluit het dan nog prinselijke paar om nogmaals een interview te geven voor de televisie. Deze keer zijn het Rick Nieman en Marielle Tweebeeke die samen het gesprek mogen leiden. Hier is een wat lossere bijna-koning te zien dan die van bijna 9 jaar geleden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6b2b521-5b4e-33d9-928a-17edbd60c45a",
                                        "entry_id": "3573ba1e-47eb-39c0-9a14-9000fce7e66f",
                                        "glosses": [
                                            "zeer luxe in het algemeen"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9e62d8f-61bb-400e-8f38-c65f64b6469e",
