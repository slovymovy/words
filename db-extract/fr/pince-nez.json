                                    {
                                        "sense_id": "932fc7ac-f7eb-3ed6-943d-27cd60cf8174",
                                        "entry_id": "60a963ad-2e3d-3165-99b6-8e6c446166d7",
                                        "glosses": [
                                            "Templeless eyeglasses that clip to the bridge of the nose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04c5d7c0-e56f-470f-9e07-ad8c44c03303",
                                                "sense_id": "932fc7ac-f7eb-3ed6-943d-27cd60cf8174",
                                                "text": "Lord Belpher, leaning against the wall and trying to decide whether his right or left foot hurt him the more excruciatingly, became aware that a curate was standing before him, regarding him through a pair of gold-rimmed pince-nez with a disapproving and hostile expression."
                                            },
                                            {
                                                "example_id": "531f94b1-94b5-45f2-9d96-d510948e9ce8",
                                                "sense_id": "932fc7ac-f7eb-3ed6-943d-27cd60cf8174",
                                                "text": "Shabet took a pince-nez from his breast pocket and settled it on the bridge of his nose."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
