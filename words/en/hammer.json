{
    "word_family": [
        "hammered",
        "hammering",
        "hammerer",
        "hammerhead"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1db8650b-ea7c-34a1-9d93-a31a3cebd993",
                    "sense_definition": "A tool with a heavy metal head mounted at right angles to the handle, used for breaking things and driving in nails.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "tool_instrument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bobby used a <w>hammer</w> and nails to fix the two planks together.",
                            "target_lang_translations": {
                                "ru": "Бобби использовал <w>молоток</w> и гвозди, чтобы скрепить две доски.",
                                "zh": "博比用<w>锤子</w>和钉子把两块木板钉在一起。"
                            }
                        },
                        {
                            "text": "She bought a new <w>hammer</w> at the hardware store to hang her pictures.",
                            "target_lang_translations": {
                                "ru": "Она купила новый <w>молоток</w> в хозяйственном магазине, чтобы повесить картины.",
                                "zh": "她在五金店买了一把新的<w>锤子</w>来挂画。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "claw hammer",
                        "sledge hammer",
                        "hammer and nails"
                    ],
                    "target_lang_definitions": {
                        "ru": "Инструмент с тяжелой металлической головкой, насаженной под прямым углом на рукоятку, используемый для разбивания предметов и забивания гвоздей.",
                        "zh": "一种工具，金属重头与手柄成直角连接，用来砸东西或钉钉子。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молоток",
                                "target_lang_sense_clarification": "инструмент"
                            },
                            {
                                "target_lang_word": "молот",
                                "target_lang_sense_clarification": "тяжелый инструмент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "锤子",
                                "target_lang_sense_clarification": "敲打东西、钉钉子用的工具"
                            },
                            {
                                "target_lang_word": "榔头",
                                "target_lang_sense_clarification": "口语常用说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0874804e-1270-3e89-965b-be5dde9d7307",
                    "sense_definition": "A moving part of a firearm that strikes the firing pin to discharge the gun.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tool_instrument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He pulled back the <w>hammer</w> of the revolver before taking aim.",
                            "target_lang_translations": {
                                "ru": "Он взвел <w>курок</w> револьвера перед тем, как прицелиться.",
                                "zh": "他瞄准前先扳起了左轮手枪的<w>击锤</w>。"
                            }
                        },
                        {
                            "text": "The gun fired instantly when the <w>hammer</w> struck the pin.",
                            "target_lang_translations": {
                                "ru": "Пистолет выстрелил мгновенно, когда <w>курок</w> ударил по бойку.",
                                "zh": "当<w>击锤</w>撞上撞针时，枪立刻就响了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cock the hammer"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подвижная часть огнестрельного оружия, которая ударяет по бойку для выстрела.",
                        "zh": "枪械中的一个活动部件，通过击打撞针使枪发射。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "курок",
                                "target_lang_sense_clarification": "часть оружия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "击锤",
                                "target_lang_sense_clarification": "枪械中击打撞针的部件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83f09e90-26e6-3a61-bbea-277cb8f33acc",
                    "sense_definition": "A small felt-covered part inside a piano that strikes the strings to produce sound.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tool_instrument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sound the piano makes comes from the <w>hammers</w> striking the strings.",
                            "target_lang_translations": {
                                "ru": "Звук пианино возникает от ударов <w>молоточков</w> по струнам.",
                                "zh": "钢琴发出的声音来自<w>琴槌</w>对琴弦的敲击。"
                            }
                        },
                        {
                            "text": "The piano tuner had to replace a broken <w>hammer</w> in the upper register.",
                            "target_lang_translations": {
                                "ru": "Настройщику пианино пришлось заменить сломанный <w>молоточек</w> в верхнем регистре.",
                                "zh": "钢琴调音师不得不更换高音区一个坏掉的<w>琴槌</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая деталь внутри пианино, покрытая войлоком, которая ударяет по струнам для извлечения звука.",
                        "zh": "钢琴内部一个小的、包有毛毡的部件，用来击打琴弦发声。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молоточек",
                                "target_lang_sense_clarification": "деталь пианино"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "琴槌",
                                "target_lang_sense_clarification": "钢琴内部击弦的部件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "390145f7-88fc-3599-ba65-40b331974af1",
                    "sense_definition": "A heavy metal ball attached to a wire handle, thrown for distance in athletic competitions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sport_equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The athlete spun around three times before releasing the <w>hammer</w>.",
                            "target_lang_translations": {
                                "ru": "Спортсмен раскрутился три раза, прежде чем выпустить <w>молот</w>.",
                                "zh": "那名运动员旋转三圈后才把<w>链球</w>掷出。"
                            }
                        },
                        {
                            "text": "He won a gold medal in the <w>hammer</w> throw at the championship.",
                            "target_lang_translations": {
                                "ru": "Он выиграл золотую медаль в метании <w>молота</w> на чемпионате.",
                                "zh": "他在锦标赛的<w>链球</w>项目中夺得了金牌。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hammer throw"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тяжелый металлический шар, прикрепленный к проволочной ручке, который метают на дальность в спортивных соревнованиях.",
                        "zh": "田径比赛中用于掷远的器械，由连接钢丝手柄的金属重球组成。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молот",
                                "target_lang_sense_clarification": "спортивный снаряд"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "链球",
                                "target_lang_sense_clarification": "田径投掷项目使用的器械"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9545118-8dcc-3633-bbed-8ec949065dbe",
                    "sense_definition": "The act of hitting something with a tool.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nail is too loose, so give it a <w>hammer</w> to secure it.",
                            "target_lang_translations": {
                                "ru": "Гвоздь болтается, так что сделай еще один <w>удар</w>, чтобы закрепить его.",
                                "zh": "这颗钉子太松了，再给它来一下<w>锤击</w>把它固定住。"
                            }
                        },
                        {
                            "text": "With one final <w>hammer</w>, the lid was tightly closed.",
                            "target_lang_translations": {
                                "ru": "С одним последним <w>ударом</w> крышка плотно закрылась.",
                                "zh": "最后再来一次<w>锤击</w>后，盖子就被严严实实地封上了。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие удара по чему-либо инструментом.",
                        "zh": "用工具敲打某物的一次动作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удар",
                                "target_lang_sense_clarification": "действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "锤击",
                                "target_lang_sense_clarification": "用锤等工具敲打一击"
                            },
                            {
                                "target_lang_word": "敲击",
                                "target_lang_sense_clarification": "一般说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5746dfe-180a-3bbe-b88c-ec7a34a4883b",
                    "sense_definition": "A small bone in the middle ear that transmits sound vibrations; the malleus.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>hammer</w> transmits sound vibrations from the eardrum to the anvil.",
                            "target_lang_translations": {
                                "ru": "<w>Молоточек</w> передает звуковые колебания от барабанной перепонки к наковальне.",
                                "zh": "<w>锤骨</w>把声音振动从鼓膜传到砧骨。"
                            }
                        },
                        {
                            "text": "An ear infection can sometimes damage the delicate <w>hammer</w> bone.",
                            "target_lang_translations": {
                                "ru": "Ушная инфекция иногда может повредить хрупкую косточку <w>молоточек</w>.",
                                "zh": "耳部感染有时会损伤脆弱的<w>锤骨</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая косточка в среднем ухе, передающая звуковые колебания.",
                        "zh": "中耳中的一块小骨，负责传递声音振动，也叫槌骨。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молоточек",
                                "target_lang_sense_clarification": "анатомия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "锤骨",
                                "target_lang_sense_clarification": "中耳听小骨之一，即 malleus"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f964da3-713d-37af-9429-3fb305b2b370",
                    "sense_definition": "A supporter, player, or coach of West Ham United Football Club.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "person_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has been a loyal <w>Hammer</w> all his life and attends every match.",
                            "target_lang_translations": {
                                "ru": "Он был преданным <w>молотобойцем</w> всю свою жизнь и посещает каждый матч.",
                                "zh": "他一辈子都是忠实的<w>西汉姆联球迷</w>，每场比赛都去看。"
                            }
                        },
                        {
                            "text": "The <w>Hammers</w> celebrated their victory in the final minutes of the game.",
                            "target_lang_translations": {
                                "ru": "<w>Молотобойцы</w> отпраздновали свою победу на последних минутах игры.",
                                "zh": "比赛最后几分钟，<w>铁锤帮</w>庆祝了他们的胜利。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "British football"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Болельщик, игрок или тренер футбольного клуба «Вест Хэм Юнайтед».",
                        "zh": "西汉姆联足球俱乐部的球迷、球员或教练。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "молотобоец",
                                "target_lang_sense_clarification": "болельщик"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "西汉姆联球迷",
                                "target_lang_sense_clarification": "指西汉姆联的支持者，也可泛指其球员或教练"
                            },
                            {
                                "target_lang_word": "铁锤帮",
                                "target_lang_sense_clarification": "球队昵称相关称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec8ed5ae-1ce9-311f-91fe-4d197d7af065",
                    "sense_definition": "The accelerator pedal in a vehicle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tool_instrument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We are running late, so put the <w>hammer</w> down and drive faster.",
                            "target_lang_translations": {
                                "ru": "Мы опаздываем, так что жми на <w>газ</w> и поезжай быстрее.",
                                "zh": "我们快迟到了，踩下<w>油门</w>开快点。"
                            }
                        },
                        {
                            "text": "He eased off the <w>hammer</w> as the truck approached the sharp curve.",
                            "target_lang_translations": {
                                "ru": "Он сбросил <w>газ</w>, когда грузовик приблизился к крутому повороту.",
                                "zh": "卡车快到急弯时，他松了松<w>油门</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "put the hammer down"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Педаль газа в автомобиле.",
                        "zh": "汽车等车辆上的加速踏板。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "газ",
                                "target_lang_sense_clarification": "педаль"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "油门",
                                "target_lang_sense_clarification": "车辆的加速踏板，俚语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cbda8dfa-a28a-3a5e-86e5-c487e451912c",
                    "sense_definition": "A handgun or firearm.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tool_instrument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police arrested the suspect for carrying a hidden <w>hammer</w>.",
                            "target_lang_translations": {
                                "ru": "Полиция арестовала подозреваемого за ношение скрытой <w>пушки</w>.",
                                "zh": "警方以他暗藏<w>枪</w>支为由逮捕了这名嫌疑人。"
                            }
                        },
                        {
                            "text": "He kept a <w>hammer</w> in the glove compartment for protection.",
                            "target_lang_translations": {
                                "ru": "Он держал <w>ствол</w> в бардачке для защиты.",
                                "zh": "他在手套箱里放着一把<w>枪</w>防身。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пистолет или огнестрельное оружие.",
                        "zh": "手枪或其他枪支的俚语说法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пушка",
                                "target_lang_sense_clarification": "сленг"
                            },
                            {
                                "target_lang_word": "ствол",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "枪",
                                "target_lang_sense_clarification": "手枪或枪支的俚语说法"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "109f71a1-4f25-323b-a196-ed81ca02f5b5",
                    "sense_definition": "To hit or strike something repeatedly with force, often using a tool.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action_hit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tony <w>hammered</w> on the door to try to get him to open.",
                            "target_lang_translations": {
                                "ru": "Тони <w>колотил</w> в дверь, пытаясь заставить его открыть.",
                                "zh": "托尼拼命<w>猛敲</w>门，想让他开门。"
                            }
                        },
                        {
                            "text": "The carpenter <w>hammered</w> the nails into the wooden frame.",
                            "target_lang_translations": {
                                "ru": "Плотник <w>забивал</w> гвозди в деревянную раму.",
                                "zh": "木匠把钉子<w>钉进</w>了木框里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pound",
                        "beat",
                        "strike"
                    ],
                    "common_phrases": [
                        "hammer on",
                        "hammer away"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бить или ударять по чему-либо многократно с силой, часто используя инструмент.",
                        "zh": "反复而用力地击打某物，通常可指使用工具敲打。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колотить",
                                "target_lang_sense_clarification": "сильно бить"
                            },
                            {
                                "target_lang_word": "забивать",
                                "target_lang_sense_clarification": "гвозди"
                            },
                            {
                                "target_lang_word": "стучать",
                                "target_lang_sense_clarification": "издавать звук ударами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "猛敲",
                                "target_lang_sense_clarification": "反复用力敲打"
                            },
                            {
                                "target_lang_word": "锤打",
                                "target_lang_sense_clarification": "一般指用锤等反复敲打"
                            },
                            {
                                "target_lang_word": "钉进",
                                "target_lang_sense_clarification": "把钉子等打进去时常用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4682ac48-d97d-3ef9-8f43-c27dbff3afee",
                    "sense_definition": "To hit or kick something, such as a ball, with great force.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action_hit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The striker <w>hammered</w> the ball into the bottom corner of the net.",
                            "target_lang_translations": {
                                "ru": "Нападающий <w>вколотил</w> мяч в нижний угол ворот.",
                                "zh": "前锋一脚<w>猛射</w>，把球打进了球门下角。"
                            }
                        },
                        {
                            "text": "She <w>hammered</w> a forehand down the line to win the point.",
                            "target_lang_translations": {
                                "ru": "Она мощно <w>пробила</w> форхенд по линии, чтобы выиграть очко.",
                                "zh": "她沿边线一记<w>重击</w>正手，拿下了这一分。"
                            }
                        }
                    ],
                    "synonyms": [
                        "smash"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бить по чему-либо (например, по мячу) с большой силой.",
                        "zh": "用很大的力量击打或踢某物，比如球。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бить",
                                "target_lang_sense_clarification": "наносить удар"
                            },
                            {
                                "target_lang_word": "вколачивать",
                                "target_lang_sense_clarification": "сильно забивать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "猛射",
                                "target_lang_sense_clarification": "对球等用很大力量击打或踢出"
