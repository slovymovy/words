                "senses": [
                    {
                        "sense_id": "532c84e2-f5f5-352b-b7f5-66a06c14dfef",
                        "entry_id": "22edde90-d3fa-398f-9655-ded54326b8ed",
                        "glosses": [
                            "Genre de plantes ombellifères ne comptant qu’une seule espèce, méditerranéenne et montagnarde, consommée dans le Roussillon sous le nom catalan de coscoll, souvent francisé en couscouil. Elle est aussi appelée improprement angélique sauvage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa6f4cce-e782-44f9-8078-fbd9b2139300",
                                "sense_id": "532c84e2-f5f5-352b-b7f5-66a06c14dfef",
                                "text": "Le Moloposperme du Péloponèse ou Fausse Ciguë ou encore Couscouil, est une grande plante vivace pouvant atteindre 2 mètres de haut."
                            },
                            {
                                "example_id": "fdc9fae6-7a6d-4600-9299-c4cb13b8e8e8",
                                "sense_id": "532c84e2-f5f5-352b-b7f5-66a06c14dfef",
                                "text": "Il s’agit du Molopospermum peloponnesiacum, le Moloposperme du Péloponnèse, de la famille des Apiacées. On l’appelle aussi angélique sauvage."
                            },
                            {
                                "example_id": "48486670-a957-4a0f-96cd-b4aa06aef643",
                                "sense_id": "532c84e2-f5f5-352b-b7f5-66a06c14dfef",
                                "text": "Trop communément appelé à tort “Angélique sauvage”, le “coscoll” est en réalité le moloposperme à feuilles de ciguë."
                            }
                        ]
                    }
                ],
