                                "target_senses": [
                                    {
                                        "sense_id": "f97ddfa3-631f-3008-ae30-32d88278c77d",
                                        "entry_id": "c834c714-27ca-3e04-a853-64117f227f5b",
                                        "glosses": [
                                            "Pertaining to conspiracy or conspirators."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "146ddc22-d00e-4e22-b29a-e441ea6a7778",
                                                "sense_id": "f97ddfa3-631f-3008-ae30-32d88278c77d",
                                                "text": "His conspiratorial whispers were soft, but that just attracted more attention."
                                            },
                                            {
                                                "example_id": "f973d1be-632f-49a4-9805-5fcf0c0bb430",
                                                "sense_id": "f97ddfa3-631f-3008-ae30-32d88278c77d",
                                                "text": "I pressed the button and he appeared, giving me, as he entered, the sort of conspiratorial glance the acting secretary of a secret society would have given a friend on the membership roll. “Oh, Swordfish,” I said, having given him a conspiratorial glance in return, for one always likes to do the civil thing, “this is Mr Herring, who has come to join our little group.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06c6fec4-e5cd-3323-a200-0ffbab3c127c",
                                        "entry_id": "c834c714-27ca-3e04-a853-64117f227f5b",
                                        "glosses": [
                                            "Believing in conspiracy theories."
                                        ],
                                        "tags": [
                                            "proscribed",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1793e7fb-5bd5-411d-9f64-b2676cce0dc1",
                                                "sense_id": "06c6fec4-e5cd-3323-a200-0ffbab3c127c",
                                                "text": "Conspiratorial thinking is another predictor of vaccine hesitancy, according to the 2018 study."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
