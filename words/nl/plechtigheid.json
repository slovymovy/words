                {
                    "sense_id": "1b15da7e-96dd-36ea-957d-2c0d7729bb51",
                    "sense_definition": "Een officiële of ceremoniële gebeurtenis die met ernst gepaard gaat.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>plechtigheid</w> werd ruw verstoord door een stel dronken motorrijders.",
                            "target_lang_translations": {
                                "en": "The <w>ceremony</w> was rudely disrupted by a group of drunk bikers."
                            }
                        },
                        {
                            "text": "Tijdens de officiële <w>plechtigheid</w> hield de burgemeester een korte toespraak.",
                            "target_lang_translations": {
                                "en": "During the official <w>ceremony</w>, the mayor gave a short speech."
                            }
                        }
                    ],
                    "synonyms": [
                        "ceremonie",
                        "ritueel"
                    ],
                    "common_phrases": [
                        "officiële plechtigheid"
                    ],
                    "target_lang_definitions": {
