                    "frequency": "Middle",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré ses excuses sincères, il gardait une profonde <w>rancœur</w> envers son ancien associé."
                        },
                        {
                            "text": "Elle a finalement réussi à parler de cette rupture sans la moindre <w>rancœur</w>."
                        }
                    ],
