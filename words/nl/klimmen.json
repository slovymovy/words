                    "sense_definition": "Zich omhoog of over een obstakel bewegen, vaak met gebruik van handen en voeten.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement_upwards",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kat <w>klom</w> snel in de hoge boom.",
                            "target_lang_translations": {
                                "ru": "Кот быстро <w>залез</w> на высокое дерево.",
                                "en": "The cat quickly <w>climbed</w> the tall tree.",
                                "pl": "Kot szybko <w>wszedł</w> na wysokie drzewo.",
                                "de": "Die Katze <w>kletterte</w> schnell auf den hohen Baum.",
                                "fr": "Le chat a rapidement <w>grimpé</w> dans le grand arbre.",
                                "it": "Il gatto si <w>arrampicò</w> rapidamente sull'albero alto.",
                                "cs": "Kočka rychle <w>vylezla</w> na vysoký strom.",
                                "tr": "Kedi hızlıca yüksek ağaca <w>tırmandı</w>.",
                                "es": "El gato <w>trepó</w> rápidamente al árbol alto."
                            }
                        },
                        {
                            "text": "Wij <w>klommen</w> over het hek om de bal te pakken.",
                            "target_lang_translations": {
                                "ru": "Мы <w>перелезли</w> через забор, чтобы достать мяч.",
                                "en": "We <w>climbed</w> over the fence to get the ball.",
                                "pl": "My <w>przeszliśmy</w> przez płot, żeby zabrać piłkę.",
                                "de": "Wir <w>kletterten</w> über den Zaun, um den Ball zu holen.",
                                "fr": "Nous avons <w>enjambé</w> la barrière pour attraper le ballon.",
                                "it": "Abbiamo <w>scavalcato</w> la recinzione per prendere la palla.",
                                "cs": "My jsme <w>přelezli</w> plot, abychom vzali ten míč.",
                                "tr": "Topu almak için çitin üzerinden <w>atladık</w>.",
                                "es": "Nosotros <w>trepamos</w> la valla para agarrar la pelota."
                            }
                        },
                        {
                            "text": "Hij kan heel goed in touwen <w>klimmen</w>.",
                            "target_lang_translations": {
                                "ru": "Он умеет очень хорошо <w>лазить</w> по канатам.",
                                "en": "He is very good at <w>climbing</w> ropes.",
                                "pl": "On potrafi bardzo dobrze <w>wspinać się</w> po linach.",
                                "de": "Er kann sehr gut an Seilen <w>klettern</w>.",
                                "fr": "Il sait très bien <w>grimper</w> aux cordes.",
                                "it": "Sa <w>arrampicarsi</w> molto bene sulle corde.",
                                "cs": "Umí velmi dobře <w>šplhat</w> po lanech.",
                                "tr": "İplere <w>tırmanmayı</w> çok iyi beceriyor.",
                                "es": "Él sabe <w>trepar</w> muy bien por las cuerdas."
                            }
                        }
                    ],
