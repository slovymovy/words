                        ]
                    },
                    {
                        "translation_id": "d7e16a20-8905-4b01-8465-fa896a67ea07",
                        "source_entry_id": "b7b39a84-a2a4-337f-aea1-45f1bf57af5f",
                        "source_sense_id": "f4223686-f7a3-301d-a8f9-b48fae04d3f5",
                        "source_sense_description": "fine cloth",
                        "target_lang_word": "Batist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Batist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81a6d1d1-8eda-376c-9571-f953c981921c",
                                        "entry_id": "a2f4cc51-14af-3de1-ba22-bf41596c1b65",
                                        "glosses": [
                                            "sehr feinfädiges Gewebe, meist aus Baumwolle oder Leinen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c15a94e9-f3b2-47c6-b3bb-dc8418be8270",
                                                "sense_id": "81a6d1d1-8eda-376c-9571-f953c981921c",
                                                "text": "Sie trug ein Nachthemd aus Batist."
                                            },
                                            {
                                                "example_id": "af896e69-b716-44b0-9b2d-6a79fcbc36ca",
                                                "sense_id": "81a6d1d1-8eda-376c-9571-f953c981921c",
                                                "text": "„Seine Gattin Väsele Li trug – es war Sommer – ihr Haar aufgebunden und mit silbernen Fäden durchflochten und Ohrringe aus Rosenquarz in Goldfassung, dazu ein taubenfarbenes ungefüttertes Jäckchen und ein Röckchen aus weißem Batist, das mit einer längs gestreiften Borte eingefaßt war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7f7b241-472b-4396-a9ee-83914876732c",
                        "source_entry_id": "b7b39a84-a2a4-337f-aea1-45f1bf57af5f",
                        "source_sense_id": "f4223686-f7a3-301d-a8f9-b48fae04d3f5",
                        "source_sense_description": "fine cloth",
                        "target_lang_word": "batista",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "batista",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "0ee8ef8c-ec35-3112-8d50-900afd57a71e",
                                        "entry_id": "fa67fe79-e06f-3d14-bc66-3072b8ea6b55",
                                        "glosses": [
                                            "tipo di tessuto molto fine, trasparente e leggero di mano morbida, realizzato in lino ad armatura tela"
                                        ],
