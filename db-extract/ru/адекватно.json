                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "87cf3544-e612-4476-8863-a90e0d752d68",
                                "sense_id": "79f56c72-746f-3163-9542-9fb67625e657",
                                "text": "Мы считаем, что мировое сообщество должно адекватно подойти к событиям в Тегеране и предпринять более эффективные действия"
                            }
