                "senses": [
                    {
                        "sense_id": "b96c6e80-160b-3ec0-b1d4-e16dfa9899d4",
                        "entry_id": "01cb9526-8b02-3d69-bcb4-cc13af5aefcb",
                        "glosses": [
                            "Berechtigung, an den Start gehen zu dürfen; einen Start durchzuführen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b91da098-1f8a-4bc2-90a4-40516c229b93",
                                "sense_id": "b96c6e80-160b-3ec0-b1d4-e16dfa9899d4",
                                "text": "„Der Gewinner des Gesamtweltcups und Technikspezialist tritt dort am Donnerstag zu einem Training und gleich zwei Rennen an, um die nötigen 80 FIS- Punkte für eine Starterlaubnis im Weltcup zu erobern.“"
                            },
                            {
                                "example_id": "1fea8e27-2bab-4282-945b-d5add23904a8",
                                "sense_id": "b96c6e80-160b-3ec0-b1d4-e16dfa9899d4",
                                "text": "„Dort warteten die Passagiere, bis die Behörden mit der gründlichen Kontrolle der Maschine fertig waren, diese wieder die Starterlaubnis erhielt und abermals abhob.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
