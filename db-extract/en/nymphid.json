                "senses": [
                    {
                        "sense_id": "d305b894-3d82-3c57-b69c-2d1ff3884b69",
                        "entry_id": "65ca72e8-72cc-3e1a-a196-97ef3f85ee9f",
                        "glosses": [
                            "Any winged insect of the family Nymphidae, a split-footed lacewing."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d01dc0e1-d86e-4129-8740-89fef57420fd",
                                "sense_id": "d305b894-3d82-3c57-b69c-2d1ff3884b69",
                                "text": "M. nebulosus, the only nymphid so far described from New Guinea, is considerably larger than others of this genus, and is distinct on wing markings and (from those known) on male genitalic features."
                            },
                            {
                                "example_id": "dcd50b77-2007-4973-aba2-8c58944f1255",
                                "sense_id": "d305b894-3d82-3c57-b69c-2d1ff3884b69",
                                "text": "Trichosors are probably plesiomorphic, being retained only by nymphids."
                            },
                            {
                                "example_id": "abd465ad-4b5b-4408-8fd6-03d96970c6af",
                                "sense_id": "d305b894-3d82-3c57-b69c-2d1ff3884b69",
                                "text": "This rarity seems to be a general feature of most nymphid species, only two of which - Nymphes myrmeleonides and Myiodactylus osmyloides - appear to be encountered with any regularity."
                            },
                            {
                                "example_id": "d8028b23-aaa8-435b-b906-69d280cb7138",
                                "sense_id": "d305b894-3d82-3c57-b69c-2d1ff3884b69",
                                "text": "Characteristically, the larvae hold their jaws open at very wide angles; some New World species resemble nymphids in being able to open their jaws beyond 270°."
                            }
                        ]
                    }
                ],
