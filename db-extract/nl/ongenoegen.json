                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "108eb5f2-0d59-40c1-bb6b-7adf2d852eee",
                                "sense_id": "13782f3c-c1f0-3846-8a00-88ca6408561d",
                                "text": "Ondanks alle rijkdom is er toch nog een hoop ongenoegen in de samenleving."
                            }
                        ]
                    },
                    {
                        "sense_id": "3cf17708-1612-3114-82eb-43badc868399",
                        "entry_id": "6e1e5edb-b236-3a08-91d4-16a637d1a064",
                        "glosses": [
                            "ruzie, onenigheid, boosheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86786344-d1da-40d9-ae1c-48675565bec0",
                                "sense_id": "3cf17708-1612-3114-82eb-43badc868399",
                                "text": "Er was altijd ongenoegen tussen de kinderen die het nooit mel elkaar eens waren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d99e14a-d543-4eee-b09b-bd01bae675fe",
                        "source_entry_id": "6e1e5edb-b236-3a08-91d4-16a637d1a064",
                        "target_lang_word": "Unmut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unmut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a3f5d136-c9c0-39aa-90e8-ee6bdfde55b0",
                                        "entry_id": "e7ed7704-e4c1-374e-b5de-9238c2416d4e",
                                        "glosses": [
                                            "negative Einstellung zu etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19222fad-c271-4fe2-a626-e2595510e9f8",
                                                "sense_id": "a3f5d136-c9c0-39aa-90e8-ee6bdfde55b0",
                                                "text": "„Nein, er steigt tiefer in die seelischen Abgründe des Idealnörglers hinab und fahndet nach den Quellen des Unmuts.“"
                                            },
                                            {
                                                "example_id": "41966e1b-dc02-4c83-ad43-f1d4de608998",
                                                "sense_id": "a3f5d136-c9c0-39aa-90e8-ee6bdfde55b0",
                                                "text": "„Bisher beschränkt sich der Unmut zwar auf die deutschen Politiker.“"
                                            },
                                            {
                                                "example_id": "0905d769-656a-4108-8b27-784845a14289",
                                                "sense_id": "a3f5d136-c9c0-39aa-90e8-ee6bdfde55b0",
                                                "text": "„Die üppigen Ansprüche vieler Konzernchefs heizen den allgemeinen Unmut und die Rufe nach staatlicher Deckelung weiter an.“"
                                            },
                                            {
                                                "example_id": "8dac6c17-fd14-463f-922b-4d5f8a065573",
                                                "sense_id": "a3f5d136-c9c0-39aa-90e8-ee6bdfde55b0",
                                                "text": "„Mit der Zeit wächst sich Annettes Unmut zu Wut aus.“"
                                            },
                                            {
                                                "example_id": "54adf914-3800-4bc3-b6f3-ba0144729102",
                                                "sense_id": "a3f5d136-c9c0-39aa-90e8-ee6bdfde55b0",
                                                "text": "„Die Jahre 1947/48 waren zudem davon geprägt, dass in vielen Regionen die territoriale Zugehörigkeit ungeklärt war: So fand nach der Durchführung eines stark umstrittenen Referendums 1947 der Anschluss der North West Frontier Province (NWFP) an Pakistan nur unter großem Unmut der Paschtunen statt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26ccc490-03d9-4eb0-bbb7-ee0ef7bc802d",
                        "source_entry_id": "6e1e5edb-b236-3a08-91d4-16a637d1a064",
                        "target_lang_word": "Verdruss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verdruss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29a8e325-61ea-382e-bc60-57964c62fcc7",
                                        "entry_id": "e7222bd5-b9fe-3de4-ac0a-49ee3c79a21d",
                                        "glosses": [
                                            "(andauernder) Ärger"
                                        ],
                                        "tags": [
                                            "literary",
                                            "plural",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edf747d9-4005-4ba7-a5af-3ef88eaa4a3a",
                                                "sense_id": "29a8e325-61ea-382e-bc60-57964c62fcc7",
                                                "text": "Sein Verdruss war groß, als er auch diesmal nicht gewählt wurde."
                                            },
                                            {
                                                "example_id": "ea8d7cf2-5f80-4683-bceb-9cf78dd48be3",
                                                "sense_id": "29a8e325-61ea-382e-bc60-57964c62fcc7",
                                                "text": "Er ließ keinen Verdruss erkennen."
                                            },
                                            {
                                                "example_id": "f6209935-d665-495b-95e6-ee803ec0db09",
                                                "sense_id": "29a8e325-61ea-382e-bc60-57964c62fcc7",
                                                "text": "„Es ist eine Kultur des Verdrusses, die sich über das Land gelegt hat, findet der Prediger.“"
                                            },
                                            {
                                                "example_id": "cc97100c-d752-4130-8385-bd22ef5e1298",
                                                "sense_id": "29a8e325-61ea-382e-bc60-57964c62fcc7",
                                                "text": "„Vor allem die nach dem Börsenkrach vom Herbst 1873 einsetzende, lang anhaltende Wirtschaftsflaute sorgte für Verdruss.“"
                                            },
                                            {
                                                "example_id": "286ca306-2942-4d4c-bee2-d45dbcb2715d",
                                                "sense_id": "29a8e325-61ea-382e-bc60-57964c62fcc7",
                                                "text": "„Offenbar gibt es nach elf Jahren Merkel doch einen stärkeren Verdruss an der Kanzlerin als angenommen und von den Umfragen suggeriert.“"
                                            },
                                            {
                                                "example_id": "cfaab7b3-12cb-4fec-97a9-2c0930cbef3e",
                                                "sense_id": "29a8e325-61ea-382e-bc60-57964c62fcc7",
                                                "text": "„Er fühlte ihm den Puls und nahm zu seiner Verwunderung und zu seinem Verdruss wahr, dass der Puls ruhiger war.“"
                                            },
                                            {
                                                "example_id": "aa214dbd-38b8-469a-a8f3-ae01b1d59d19",
                                                "sense_id": "29a8e325-61ea-382e-bc60-57964c62fcc7",
                                                "text": "„Ledermüller kam nun nach Nürnberg zurück, wurde aber zu Hause mit so harten Vorwürfen und Verdrussen gequält, daß er fortlief, und sich zu einem Freund nach Römhild begab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00618eca-0eb0-4576-a497-74400a785b80",
                        "source_entry_id": "6e1e5edb-b236-3a08-91d4-16a637d1a064",
