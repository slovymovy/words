                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7f21ea9a-70a3-39e1-8c78-dd289a31b88f",
                        "entry_id": "97be7ae9-3069-3205-9743-70f535bc6ab5",
                        "glosses": [
                            "simple past of sing"
                        ],
                        "tags": [
                            "archaic",
                            "dialectal",
                            "form-of",
                            "past"
                        ],
                        "examples": [
                            {
                                "example_id": "6f40ddf3-1d26-4067-9d65-e949d6f4e632",
                                "sense_id": "7f21ea9a-70a3-39e1-8c78-dd289a31b88f",
                                "text": "Lulled by the Syren-song that my own heart sung to me, with eyes shut to all sight, and ears closed to all sound of danger, I drifted nearer and nearer to the fatal rocks."
                            },
                            {
                                "example_id": "f562927d-33aa-4235-ac32-77939e406fd1",
                                "sense_id": "7f21ea9a-70a3-39e1-8c78-dd289a31b88f",
                                "text": "The August Prince's First Officer […] sung a song; although it was unaccompanied by dancing it was very delightful."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
