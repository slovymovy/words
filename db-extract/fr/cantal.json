                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60964c1e-b819-49c7-b252-ed03766b142b",
                                "sense_id": "c93c31b9-4a02-3531-aac1-cd99f1d05cde",
                                "text": "Au Maroc, Cantal Bakker initie des ateliers sur la façon de réparer un vélo et enseigne aux filles comment utiliser une bicyclette de manière sûre dans la circulation."
                            }
                        ]
                    }
                ],
