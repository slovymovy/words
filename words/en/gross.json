                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "earning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The summer blockbuster is expected to <w>gross</w> over a billion dollars worldwide.",
                            "target_lang_translations": {
                                "ru": "Ожидается, что летний блокбастер <w>соберет</w> более миллиарда долларов по всему миру.",
                                "zh": "这部暑期大片预计在全球将<w>获得</w>超过十亿美元的票房。"
                            }
