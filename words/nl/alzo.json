{
    "word_family": [],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "e9211339-1c14-36c6-bc42-320155d95b80",
                    "sense_definition": "Op die manier; in deze vorm.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "manier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij hoopte <w>alzo</w> het conflict vreedzaam op te lossen.",
                            "target_lang_translations": {
                                "en": "He hoped to <w>thus</w> resolve the conflict peacefully."
                            }
                        },
                        {
                            "text": "Zij handelden snel en wisten <w>alzo</w> erger te voorkomen.",
                            "target_lang_translations": {
                                "en": "They acted quickly and were <w>thereby</w> able to prevent worse."
                            }
                        }
                    ],
                    "synonyms": [
                        "zodanig"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Formeel en verouderd taalgebruik."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "In that manner; thus or in this way."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "thus",
                                "target_lang_sense_clarification": "in this way"
                            },
                            {
                                "target_lang_word": "in such a manner",
                                "target_lang_sense_clarification": "in this way"
                            },
                            {
                                "target_lang_word": "thereby",
                                "target_lang_sense_clarification": "by that means"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "025aeea5-70b3-323c-93f4-80bb0dce0523",
                    "sense_definition": "Om deze reden; derhalve.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gevolg",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er ontstond <w>alzo</w> een gevaarlijke situatie voor de omstanders.",
                            "target_lang_translations": {
                                "en": "A dangerous situation <w>therefore</w> arose for the bystanders."
                            }
                        },
                        {
                            "text": "Men kan <w>alzo</w> concluderen dat het plan niet haalbaar is.",
                            "target_lang_translations": {
                                "en": "One can <w>thus</w> conclude that the plan is not feasible."
                            }
                        }
                    ],
                    "synonyms": [
                        "dus",
                        "derhalve"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Formeel en verouderd taalgebruik."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "For this reason; therefore, consequently."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "therefore",
                                "target_lang_sense_clarification": "for that reason"
                            },
                            {
                                "target_lang_word": "consequently",
                                "target_lang_sense_clarification": "as a result"
                            },
                            {
                                "target_lang_word": "thus",
                                "target_lang_sense_clarification": "as a result"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "37b6b0d1-d92a-3351-bc04-7a42e36b9cf9",
                    "sense_definition": "Geeft een gevolgtrekking aan; dus, bijgevolg.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gevolg",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De plannen zijn gewijzigd, <w>alzo</w> moeten wij opnieuw beginnen.",
                            "target_lang_translations": {
                                "en": "The plans have changed, <w>and so</w> we must start anew."
                            }
                        },
                        {
                            "text": "Het bestuur stemde unaniem in, <w>alzo</w> werd het besluit bekrachtigd.",
                            "target_lang_translations": {
                                "en": "The board voted unanimously, <w>hence</w> the decision was ratified."
                            }
                        }
                    ],
                    "synonyms": [
                        "dus",
                        "derhalve"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Voornamelijk formeel of verouderd voegwoord."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Introduces a consequence; so, hence, accordingly."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "and so",
                                "target_lang_sense_clarification": "consequently"
                            },
                            {
                                "target_lang_word": "hence",
                                "target_lang_sense_clarification": "therefore"
                            },
                            {
                                "target_lang_word": "wherefore",
                                "target_lang_sense_clarification": "archaic, for which reason"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eed19018-e392-3fa6-8c5d-ab8a9e17b7aa",
                    "sense_definition": "Aangezien; omdat.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "reden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Alzo</w> de vergadering geen besluit nam, werd het voorstel uitgesteld.",
                            "target_lang_translations": {
                                "en": "<w>Since</w> the meeting took no decision, the proposal was postponed."
                            }
                        },
                        {
                            "text": "<w>Alzo</w> men geen overeenstemming bereikte, ging de fusie niet door.",
                            "target_lang_translations": {
                                "en": "<w>Inasmuch as</w> no agreement was reached, the merger did not proceed."
                            }
                        }
                    ],
                    "synonyms": [
                        "omdat"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Uitsluitend in zeer formele of historische teksten."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Given that; since, because."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "since",
                                "target_lang_sense_clarification": "because"
                            },
                            {
                                "target_lang_word": "inasmuch as",
                                "target_lang_sense_clarification": "since, because"
                            },
                            {
                                "target_lang_word": "as",
                                "target_lang_sense_clarification": "because, considering that"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07a8a624-4a27-310e-9702-3e1a4f9bf629",
                    "sense_definition": "Op dezelfde wijze als; zoals.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vergelijking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het geschiedde precies <w>alzo</w> de oude geschriften hadden voorspeld.",
                            "target_lang_translations": {
                                "en": "It occurred precisely <w>as</w> the ancient scriptures had foretold."
                            }
                        },
                        {
                            "text": "Men handelde nauwgezet, <w>alzo</w> de traditie dat voorschreef.",
                            "target_lang_translations": {
                                "en": "They acted conscientiously, <w>just as</w> tradition prescribed."
                            }
                        }
                    ],
                    "synonyms": [
                        "zoals"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Verouderd voegwoord."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "In the same manner that; just as, like."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "as",
                                "target_lang_sense_clarification": "in the manner that"
                            },
                            {
                                "target_lang_word": "just as",
                                "target_lang_sense_clarification": "in the exact manner that"
                            },
                            {
                                "target_lang_word": "even as",
                                "target_lang_sense_clarification": "just as"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a73b2db-1cd8-381b-8dd4-13479e329d43",
                    "sense_definition": "Op het ogenblik dat; toen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "tijd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Alzo</w> hij de stad verliet, begon het hevig te sneeuwen.",
                            "target_lang_translations": {
                                "en": "<w>As</w> he left the city, it began to snow heavily."
                            }
                        },
                        {
                            "text": "<w>Alzo</w> de avond viel, keerden de reizigers terug naar het dorp.",
                            "target_lang_translations": {
                                "en": "<w>When</w> evening fell, the travellers returned to the village."
                            }
                        }
                    ],
                    "synonyms": [
                        "toen"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Historisch en niet meer in hedendaags gebruik."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "At the moment that; when, as."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "as",
                                "target_lang_sense_clarification": "at the moment that"
                            },
                            {
                                "target_lang_word": "when",
                                "target_lang_sense_clarification": "at the time that"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}