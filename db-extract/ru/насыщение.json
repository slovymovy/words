                ],
                "senses": [
                    {
                        "sense_id": "a97d7b46-63d9-3445-8e04-b5ecba1fcf3e",
                        "entry_id": "60bdb6df-c429-35eb-9c5a-257d594f98a2",
                        "glosses": [
                            "действие по значению гл. насыщать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d1dc6bb-59c7-4d70-b3e6-0c34e5ef4ab7",
                                "sense_id": "a97d7b46-63d9-3445-8e04-b5ecba1fcf3e",
                                "text": "Битумное насыщение производится при низких температурах, что предотвращает термические повреждения."
                            }
                        ]
                    },
                    {
                        "sense_id": "0c310b96-6251-3b42-8455-c04e33284d4e",
                        "entry_id": "60bdb6df-c429-35eb-9c5a-257d594f98a2",
                        "glosses": [
                            "состояние, являющееся результатом такого действия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45b8a3d5-1b6e-4381-bafb-0368e7baa400",
                                "sense_id": "0c310b96-6251-3b42-8455-c04e33284d4e",
                                "text": "Большинству женщин требуется около 1,5 килограмма пищи в день, чтобы почувствовать насыщение."
                            },
                            {
                                "example_id": "26b4ed91-dd9f-40d1-8737-686daf11c480",
                                "sense_id": "0c310b96-6251-3b42-8455-c04e33284d4e",
                                "text": "Насыщение раствора при концентрации озона в озон-кислородной смеси 400-2000 мкг\\л достигается в среднем за 15 минут."
                            }
                        ]
                    }
                ],
