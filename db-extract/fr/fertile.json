        "fr-extract.jsonl": [
            {
                "entry_id": "4b89c103-08bd-3246-b523-7f1e2ee29b05",
                "word": "fertile",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5de78512-b0f5-41c5-9331-e68f8b8b0233",
                        "entry_id": "4b89c103-08bd-3246-b523-7f1e2ee29b05",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "fertiles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a8134bb0-546a-370d-9cee-d3986d396256",
                        "entry_id": "4b89c103-08bd-3246-b523-7f1e2ee29b05",
                        "glosses": [
                            "Qui produit beaucoup, en parlant principalement d’un sol cultivé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d02011b-b6e6-4ebb-9c46-83eb8a162996",
                                "sense_id": "a8134bb0-546a-370d-9cee-d3986d396256",
                                "text": "La route parcourt une campagne fertile et variée par des jardins, par des plantations de noyers, et par des coteaux plantés de vignes: à gauche, ou suit presque constamment le cours de l’Yonne; […]."
                            },
                            {
                                "example_id": "fded896b-1309-42da-8719-bd6ae7fb591b",
                                "sense_id": "a8134bb0-546a-370d-9cee-d3986d396256",
                                "text": "Nous parcourons la vaste plaine fertile des Doukkala, sans pierres et sans arbres, où s’étalent à perte de vue d’immenses champs de blé, d’orge, de maïs, de fèves et de pois chiches."
                            },
                            {
                                "example_id": "e59fb716-2154-48dd-85ff-0ca28b388698",
                                "sense_id": "a8134bb0-546a-370d-9cee-d3986d396256",
                                "text": "Si les engrais verts donnent de fort bons résultats dans les sols infertiles et épuisés, à plus forte raison sont-ils avantageux dans les sols fertiles et riches."
                            },
                            {
                                "example_id": "a770d909-0612-40a6-ae01-c2fcc2c8432b",
                                "sense_id": "a8134bb0-546a-370d-9cee-d3986d396256",
                                "text": "Le Bacchus, qui provient d’un semis de Clinton, est un cépage d’avenir pour la culture en treillages dans les sols profonds. […]. Il est très vigoureux, très fertile, très résistant au phylloxéra, à l’oïdium et au mildew."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a72b7a4-a303-3eb5-b187-6cc0fb1ca4e3",
                        "entry_id": "4b89c103-08bd-3246-b523-7f1e2ee29b05",
                        "glosses": [
                            "Qui peut féconder ou être fécondé"
                        ],
                        "tags": [
                            "Reproduction"
                        ],
                        "examples": [
                            {
                                "example_id": "28059546-e591-4725-88fc-5ee3fb6b1039",
                                "sense_id": "3a72b7a4-a303-3eb5-b187-6cc0fb1ca4e3",
                                "text": "Les nonnes fertiles lui offrent, aux périodes lunaires, une goutte symbolique de leur dégoulinure."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8bb6599-33dd-3942-9ee5-84a150a42fee",
                        "entry_id": "4b89c103-08bd-3246-b523-7f1e2ee29b05",
                        "glosses": [
                            "Qualifie une personne, ou son activité, qui produit beaucoup et facilement."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "6b1a383b-517b-48ec-8b23-66d74aaf8756",
                                "sense_id": "c8bb6599-33dd-3942-9ee5-84a150a42fee",
                                "text": "Après une semaine fertile en péripéties et en catastrophes, Hervé, depuis la résurrection d'Alain Kernoul, venait de passer bien des heures paisibles."
                            },
                            {
                                "example_id": "69b9c8ac-f487-456a-87d9-e1011a7d8bc8",
                                "sense_id": "c8bb6599-33dd-3942-9ee5-84a150a42fee",
                                "text": "La période qui s’étend entre le débarquement japonais à l’embouchure du Wang-poo et le bombardement de Nagasaki fut pour la Chine particulièrement fertile en catastrophes."
                            },
                            {
                                "example_id": "b5d034d9-7bfa-4baf-a26f-bcb31962e549",
                                "sense_id": "c8bb6599-33dd-3942-9ee5-84a150a42fee",
                                "text": "Cet homme est fertile en expédients, en inventions. — Esprit, imagination fertile."
                            },
                            {
                                "example_id": "a3f323e2-1d5f-4853-a429-b3a70d0353b1",
                                "sense_id": "c8bb6599-33dd-3942-9ee5-84a150a42fee",
                                "text": "Fertile en buts, le derby Hollande-Belgique aura convaincu chacun que notre équipe nationale connaît une éclipse sévère et que du sang nouveau doit lui être infiltré, spécialement dans les compartiments arrière et médian."
                            }
                        ]
                    },
                    {
                        "sense_id": "012fedc5-ad71-3644-9fb0-04dde2f4c03c",
                        "entry_id": "4b89c103-08bd-3246-b523-7f1e2ee29b05",
                        "glosses": [
                            "Qualifie un sujet sur lequel il y a beaucoup de choses à dire, ou une matière qui fournit abondamment des idées."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "38dc2e11-50cc-3194-a174-4b2b4acdfa49",
                        "entry_id": "4b89c103-08bd-3246-b523-7f1e2ee29b05",
                        "glosses": [
                            "Se dit d’un nucléide susceptible d’être transformé, directement ou indirectement, en un nucléide fissile par capture de neutrons."
                        ],
                        "tags": [
                            "Physique des réacteurs nucléaires"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c713c4c8-a7dd-451b-a8ad-ee2b5d4e5be7",
                        "source_entry_id": "4b89c103-08bd-3246-b523-7f1e2ee29b05",
                        "target_lang_word": "fruchtbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fruchtbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1329459b-1223-3f4d-afff-defb619bc371",
                                        "entry_id": "eb72305b-e30f-3ec7-9177-30f86a909810",
                                        "glosses": [
                                            "zur (starken) Vermehrung fähig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "277a14f2-1208-4b3c-81dc-f274219cdf3f",
                                                "sense_id": "1329459b-1223-3f4d-afff-defb619bc371",
                                                "text": "Die Fische in meinem Aquarium sind sehr fruchtbar."
                                            },
                                            {
                                                "example_id": "0db649a2-42d2-4b6d-9d08-b628eed98c93",
                                                "sense_id": "1329459b-1223-3f4d-afff-defb619bc371",
                                                "text": "Von Kaninchen sagt man, sie seien sehr fruchtbar."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bce82216-68bc-36f5-a18f-46062711a9d9",
                                        "entry_id": "eb72305b-e30f-3ec7-9177-30f86a909810",
                                        "glosses": [
                                            "so, dass es viele Früchte hervorbringt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab20edcf-2a9f-485c-9470-b7a2ccdf8b43",
                                                "sense_id": "bce82216-68bc-36f5-a18f-46062711a9d9",
                                                "text": "Carls Großvater kaufte sich vor 60 Jahren ein fruchtbares Stück Land, von dessen Erträgen nun die ganze Familie leben kann."
                                            },
                                            {
                                                "example_id": "be46f601-3f8e-451c-a1ce-90378526faf4",
                                                "sense_id": "bce82216-68bc-36f5-a18f-46062711a9d9",
                                                "text": "„Pro Sekunde gehen weltweit vier Fußballfelder fruchtbarer Boden verloren – durch Dürre, Erosion und Bodenversiegelung.“"
                                            },
                                            {
                                                "example_id": "360395ca-0d3e-4c9b-8894-2ceea8e647a2",
                                                "sense_id": "bce82216-68bc-36f5-a18f-46062711a9d9",
                                                "text": "„Dadurch bildeten sich breite, von fruchtbarem Schwemmland bedeckte Flussterrassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0bab440c-fe40-3292-a45c-e735dae308da",
                                        "entry_id": "eb72305b-e30f-3ec7-9177-30f86a909810",
                                        "glosses": [
                                            "mit Erfolg"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb7fdf59-f03d-406d-b281-0db9d8d76dc0",
                                                "sense_id": "0bab440c-fe40-3292-a45c-e735dae308da",
                                                "text": "Ich freue mich auf eine fruchtbare Zusammenarbeit mit den neuen Kollegen."
                                            },
                                            {
                                                "example_id": "0448519c-9f83-43d7-995d-a4c0894c8d7b",
                                                "sense_id": "0bab440c-fe40-3292-a45c-e735dae308da",
                                                "text": "„Eine Sinnkrise im Alltag oder Berufsleben kann für den dynamischen Menschen und Sinnsucher ein fruchtbarer Moment, ein Auslöser sein, auf Entdeckungsreise nach Alternativen zu gehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
