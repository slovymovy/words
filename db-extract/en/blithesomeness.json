                        "glosses": [
                            "The quality of being blithesome."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8be3a8f2-ebf1-4a9b-bac5-aea319dd134e",
                                "sense_id": "9ded7d3c-23a2-3a34-b8c9-ad475b7d2773",
                                "text": "If I had loved earthly thing,\nOf earthly blithesomeness,\nI might have been beloved again,\nAnd bathed in earthly bliss."
                            }
                        ]
                    }
