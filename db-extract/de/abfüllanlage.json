                "senses": [
                    {
                        "sense_id": "b3232946-e6a0-3363-a05a-8192e08626fe",
                        "entry_id": "92551064-7f32-33c4-9d8e-95644f2fd7d0",
                        "glosses": [
                            "Anlage, die Flüssigkeiten oder andere Stoffe in Behälter einfüllt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e63dd15c-7d98-4cde-8cc9-36b7a105e905",
                                "sense_id": "b3232946-e6a0-3363-a05a-8192e08626fe",
                                "text": "„Eine Abfüllanlage kann etwa 400 Fläschchen pro Minute befüllen, etwa 126 Millionen Fläschchen pro Jahr.“"
                            },
                            {
                                "example_id": "b070f3cf-343b-41ab-ab00-a83622f18200",
                                "sense_id": "b3232946-e6a0-3363-a05a-8192e08626fe",
                                "text": "„Die Bewertung von Gerste, Weizen oder Hopfen gehört ebenso dazu wie die Bereitung von Malz, der Einsatz von Hilfsstoffen oder die Wartung und Bedienung von Brau- und Abfüllanlagen.“"
                            },
                            {
                                "example_id": "98229f4e-5fab-4856-9da3-5d9429001cd9",
                                "sense_id": "b3232946-e6a0-3363-a05a-8192e08626fe",
                                "text": "„Neben TNT selbst sind daher auch die Vor-, Zwischen- und Nebenprodukte in der Umgebung der Produktions- und Abfüllanlagen sowie der Abwasseranlagen und Schlammhalden zu finden.“"
                            },
                            {
                                "example_id": "39b256ed-ba57-4cde-ba15-20da48cd9780",
                                "sense_id": "b3232946-e6a0-3363-a05a-8192e08626fe",
                                "text": "„Er mahnte deshalb zahlreiche Sicherheitsmaßnahmen an, wie intensivere Pasteurisierung, geschützte Abfüllanlagen und routinemaßige Tests der Milch auf die Toxine.“"
                            },
                            {
                                "example_id": "a4c835b9-8995-4cc3-af7b-4ba857e363b2",
                                "sense_id": "b3232946-e6a0-3363-a05a-8192e08626fe",
                                "text": "„12.000 Menschen sind in den 80 Abfüllanlagen von Coca-Cola in Deutschland beschäftigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
