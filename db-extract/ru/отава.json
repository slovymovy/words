                    {
                        "translation_id": "7614b659-bcb8-4d4a-aad5-ef74af098807",
                        "source_entry_id": "afa77201-3e0c-36d3-9a92-ab0436f900f8",
                        "source_sense_id": "b3a8c920-984d-3bfc-9f03-40d2b3dd5d08",
                        "target_lang_word": "aftergrass",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aftergrass",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef8c680d-96d3-3b09-a7f2-d534b6126cb3",
                                        "entry_id": "7bebd338-5068-32bf-b5e6-4016d4cb38ca",
                                        "glosses": [
                                            "The grass that grows after the first crop has been mown."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb89334c-c9d9-4f6b-b217-e16c31904cd4",
                                                "sense_id": "ef8c680d-96d3-3b09-a7f2-d534b6126cb3",
                                                "text": "For the ordinarie times of foddring your fat cattell […] if they féede abroad, and take the benefit of Foggs and after-grasse, then to fodder them Morning, Euening, and high-noone is fully sufficient."
                                            },
                                            {
                                                "example_id": "71eda9e5-288c-4c3f-8a25-153ab78f8d3a",
                                                "sense_id": "ef8c680d-96d3-3b09-a7f2-d534b6126cb3",
                                                "text": "This recess, towards the close of September, when the after-grass of the meadows is still of a fresh green, with the leaves of many of the trees faded, but perhaps none fallen, is truly enchanting."
                                            },
                                            {
                                                "example_id": "984ce46a-b048-492b-924d-99b521abfdb6",
                                                "sense_id": "ef8c680d-96d3-3b09-a7f2-d534b6126cb3",
                                                "text": "The cool silk of aftergrass under her bare feet"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b81c140-38de-4ae5-8bcc-f24d3ff555fd",
                        "source_entry_id": "afa77201-3e0c-36d3-9a92-ab0436f900f8",
                        "source_sense_id": "b3a8c920-984d-3bfc-9f03-40d2b3dd5d08",
                        "target_lang_word": "regrowth",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "regrowth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "758032c1-cf30-3e05-ada6-de795128668a",
                                        "entry_id": "c08b71c5-0f8f-3692-952c-3bebc6569701",
                                        "glosses": [
                                            "That which has been regrown after removal."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a301b38c-4860-4927-96bf-7f7ac94bd385",
                                                "sense_id": "758032c1-cf30-3e05-ada6-de795128668a",
                                                "text": "After the forest fire, much of the regrowth consisted of invasive non-native plant species."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40646743-29b4-3d16-b686-928cdabf6be6",
                                        "entry_id": "c08b71c5-0f8f-3692-952c-3bebc6569701",
                                        "glosses": [
                                            "The process of regrowing."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e57f035-e4a5-4d89-985f-002c672de077",
                                                "sense_id": "40646743-29b4-3d16-b686-928cdabf6be6",
                                                "text": "The eventual regrowth of the forest to its primeval state will take centuries, if not millennia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "257b59da-fc2d-4553-9073-b9ff987a31bd",
                        "source_entry_id": "afa77201-3e0c-36d3-9a92-ab0436f900f8",
                        "source_sense_id": "b3a8c920-984d-3bfc-9f03-40d2b3dd5d08",
