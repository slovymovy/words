                "senses": [
                    {
                        "sense_id": "df2ef64e-1c8d-32a6-a20a-f685b231380b",
                        "entry_id": "c76612d8-932f-319d-9176-409dec9bd9c7",
                        "glosses": [
                            "A nose."
                        ],
                        "tags": [
                            "childish"
                        ],
                        "examples": [
                            {
                                "example_id": "7dc7fa40-5aed-46b0-912f-20f284b62e9a",
                                "sense_id": "df2ef64e-1c8d-32a6-a20a-f685b231380b",
                                "text": "Oh! how his little nosie / Is wet with morning dew, / From yonder garden posey / Of pansy blossoms blue."
                            },
                            {
                                "example_id": "da548dd2-b831-42fc-bf6f-1d59108d5a6a",
                                "sense_id": "df2ef64e-1c8d-32a6-a20a-f685b231380b",
                                "text": "You are my little honey Rosie, / Though freckled be your little nosie."
                            },
                            {
                                "example_id": "f876efee-e304-48a8-b1e3-ac7f45ee6af7",
                                "sense_id": "df2ef64e-1c8d-32a6-a20a-f685b231380b",
                                "text": "Say, every time that little Jane daubed some whitewash on her little nosie, she gave that grandstand the squints."
                            },
                            {
                                "example_id": "c9745c41-5e53-4d1b-95d3-e51dc16a20c1",
                                "sense_id": "df2ef64e-1c8d-32a6-a20a-f685b231380b",
                                "text": "I think I will do as much for my friends as almost anyone you can find, but I won’t wipe their little nosies, take them to the little room where one goes all alone, or kiss them lovingly before [they go to bed(?)]"
                            },
                            {
                                "example_id": "a8ab6a6f-4eae-46f6-8c2f-4c20fc24a7be",
                                "sense_id": "df2ef64e-1c8d-32a6-a20a-f685b231380b",
                                "text": "“And we don’t like little kiddywinks poking their little nosies in, disturbing us.”"
                            },
                            {
                                "example_id": "fae87b8d-8412-4bfc-b0e7-6b865125978c",
                                "sense_id": "df2ef64e-1c8d-32a6-a20a-f685b231380b",
                                "text": "Look how dry their poor little nosies are."
                            }
                        ]
                    }
                ],
