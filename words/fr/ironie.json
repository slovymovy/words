{
    "word_family": [
        "ironique",
        "ironiquement",
        "ironiser",
        "ironiste"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "40f25253-6d1e-3b67-ae7d-fcfc7a572f7f",
                    "sense_definition": "Figure de style ou manière de s'exprimer consistant à dire le contraire de ce que l'on pense, pour railler ou faire sourire.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "rhetorique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a répondu avec une pointe d'<w>ironie</w> que tout allait pour le mieux dans l'entreprise. "
                        },
                        {
                            "text": "Cet éloge maladroit n'était en réalité qu'une subtile <w>ironie</w> destinée à amuser l'assemblée."
                        }
                    ],
                    "synonyms": [
                        "sarcasme",
                        "raillerie"
                    ],
                    "common_phrases": [
                        "pointe d'ironie",
                        "manier l'ironie"
                    ]
                },
                {
                    "sense_id": "4cf9596e-7fa0-3887-b878-ac0add525bf1",
                    "sense_definition": "Tournure paradoxale ou moqueuse des événements qui semble se rire des prévisions ou des volontés humaines.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "destin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Par une cruelle <w>ironie</w> du sort, le pompier a vu sa propre maison détruite par les flammes."
                        },
                        {
                            "text": "Le comble de l'<w>ironie</w> fut de perdre ses clés après avoir changé toutes les serrures."
                        }
                    ],
                    "common_phrases": [
                        "ironie du sort",
                        "comble de l'ironie"
                    ]
                },
                {
                    "sense_id": "ac952259-dddc-3784-97b4-0aa9272a7046",
                    "sense_definition": "Attitude méprisante ou sarcastique qui consiste à regarder les autres avec supériorité.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son <w>ironie</w> mordante et permanente finit par blesser ses camarades les plus fidèles."
                        },
                        {
                            "text": "Elle observait les déboires de son rival avec une froide <w>ironie</w> non dissimulée."
                        }
                    ],
                    "synonyms": [
                        "dédain",
                        "morgue",
                        "sarcasme"
                    ],
                    "antonyms": [
                        "bienveillance",
                        "empathie"
                    ],
                    "common_phrases": [
                        "froide ironie",
                        "teinté d'ironie"
                    ]
                }
            ]
        }
    ]
}