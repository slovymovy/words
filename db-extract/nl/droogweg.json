                                "example_id": "3bb63cd3-803b-417d-a16f-e29abee91bb2",
                                "sense_id": "8dd05e30-f76d-3388-8b40-03a8aa92ce61",
                                "text": "Hij zei droogweg dat hij naar Amerika ging emigreren."
