                    {
                        "sense_id": "4b2fe9fe-d6dd-38f2-b7d3-473145738113",
                        "entry_id": "23ff9a60-3848-376d-9a5d-0ee86bc910c3",
                        "glosses": [
                            "A superheavy thing.",
                            "A superheavy tank or artillery piece."
