                        "translation_id": "56ea46e7-d387-44ff-b6a2-6f2e17266d21",
                        "source_entry_id": "310736bf-6058-3c4d-bfee-5b9d26a96c2e",
                        "source_sense_id": "671e5cec-8a06-3b4f-abd5-8bf2c871183f",
                        "source_sense_description": "een ringvormig DNA-molecuul dat voornamelijk voorkomt voor bij bacteriën",
                        "target_lang_word": "Plasmid",
                        "target_lang_code": "de",
