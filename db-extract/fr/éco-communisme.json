                "senses": [
                    {
                        "sense_id": "80f3ba4c-f8a4-33fb-9358-4d33b4f27107",
                        "entry_id": "0881d701-958b-3d4e-b2d5-d75ce3beae51",
                        "glosses": [
                            "Idéologie politique cherchant à concilier les revendications de l’écologisme et du communisme, et qui considère que la protection de l’environnement est inconciliable avec le capitalisme."
                        ],
                        "tags": [
                            "Communisme"
                        ],
                        "examples": [
                            {
                                "example_id": "b087218a-d26d-4a9d-bd33-6b065079ae5b",
                                "sense_id": "80f3ba4c-f8a4-33fb-9358-4d33b4f27107",
                                "text": "L’éco-communisme du 21ème siècle est le chemin vers l’Humanité, c’est-à-dire un monde sans discrimination par le sexe, la race ou la condition sociale, un monde sans frontières et en paix."
                            },
                            {
                                "example_id": "0cb61d24-6d41-4352-be64-3c8da02724d3",
                                "sense_id": "80f3ba4c-f8a4-33fb-9358-4d33b4f27107",
                                "text": "Bien entendu, le communisme dont parle Gorz n’est pas celui des pays du prétendu « socialisme réel », mais une sorte d’éco-communisme d’un type nouveau."
                            }
                        ]
                    }
                ],
