                "senses": [
                    {
                        "sense_id": "179a700e-826e-391a-87c5-5d61a2ce17bb",
                        "entry_id": "e22868e5-0ff9-3768-9113-54f24abf60f0",
                        "glosses": [
                            "mündliche oder schriftliche Aufforderung/Anweisung, eine bestimmte Aufgabe zu erledigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "109ae383-b070-4a26-b56e-df72a2b8667a",
                                "sense_id": "179a700e-826e-391a-87c5-5d61a2ce17bb",
                                "text": "„Der Arbeitsauftrag fordert dazu auf, die Briefmarke, das Gemälde Dürers sowie die Reiterstatue von Karl dem Großen daraufhin zu untersuchen, welche der drei Darstellungen der Beschreibung von Einhard am nächsten kommt.“"
                            },
                            {
                                "example_id": "bb012eff-41be-4aa7-98b3-5e607b98fb05",
                                "sense_id": "179a700e-826e-391a-87c5-5d61a2ce17bb",
                                "text": "„Der Arbeitsauftrag muss dabei zum einen die Kooperation der SchülerInnen [sic] erfordern und zum anderen ohne substantielle Hilfe der Lehrperson zu bewerkstelligen sein.“"
                            },
                            {
                                "example_id": "df7d4185-9d8e-4994-9b11-d090865ef9f1",
                                "sense_id": "179a700e-826e-391a-87c5-5d61a2ce17bb",
                                "text": "„Die Lehrerin bittet die Kinder, sich einen Arbeitsauftrag auszusuchen, um ihr Psalmwort zu gestalten.“"
                            },
                            {
                                "example_id": "f072e921-87d8-460f-ad3f-de10da49e961",
                                "sense_id": "179a700e-826e-391a-87c5-5d61a2ce17bb",
                                "text": "„Als die Lehrerin uns mit einem Arbeitsauftrag bis zum nächsten Tag entließ, waren es noch zwei Stunden, bis zum Termin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
