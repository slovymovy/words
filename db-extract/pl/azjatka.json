                    {
                        "translation_id": "f79de7e5-ad9f-4d38-9785-bfe831ef2a1e",
                        "source_entry_id": "9e0b3451-4e8c-3f40-8715-c8184432029f",
                        "source_sense_id": "66e9acbf-3e2e-3b82-b6db-eded29245685",
                        "target_lang_word": "Asiatin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Asiatin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c8cf1cad-f9f3-338b-a8e6-a3c31059e837",
                                        "entry_id": "2dd9b297-ef8f-359c-bd58-17714de32876",
                                        "glosses": [
                                            "Bewohnerin von Asien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "281daebc-ec0a-43a4-b9fc-4d473993084e",
                                                "sense_id": "c8cf1cad-f9f3-338b-a8e6-a3c31059e837",
                                                "text": "Die schönsten Frauen der Welt sind Asiatinnen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37260543-6844-4a18-bc52-3ff176457983",
                        "source_entry_id": "9e0b3451-4e8c-3f40-8715-c8184432029f",
                        "source_sense_id": "66e9acbf-3e2e-3b82-b6db-eded29245685",
                        "target_lang_word": "азиа́тка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "азиа́тка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "da2018ba-fa79-3ecb-94e1-6012372cbad6",
                                        "entry_id": "2ea8f5c2-774c-3ba7-9282-985c388ddb6d",
                                        "glosses": [
                                            "женск. к азиат; представительница одного из народов Азии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9efc4d6f-bff4-40de-bf1d-b459b6e0d175",
                                                "sense_id": "da2018ba-fa79-3ecb-94e1-6012372cbad6",
                                                "text": "Азиатки смуглые, за исключением китаянок, настоящих, конечно, не маньчжурок из северных провинций."
                                            },
                                            {
                                                "example_id": "a764963a-9ccc-44be-8c90-06173e6b8471",
                                                "sense_id": "da2018ba-fa79-3ecb-94e1-6012372cbad6",
                                                "text": "Я убирать, готовить, Александр Григорьевич, два раза неделя, – объясняет мне на ломаном русском эта азиатка, подняв руки, на случай, если я в неё ещё что-нибудь соберусь запустить."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df81dbf3-64bb-322f-9196-73463766b89c",
                                        "entry_id": "2ea8f5c2-774c-3ba7-9282-985c388ddb6d",
                                        "glosses": [
                                            "жительница или уроженка Азии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10600c4d-14aa-4725-a968-7ec49e0aab45",
                                                "sense_id": "df81dbf3-64bb-322f-9196-73463766b89c",
                                                "text": ".. Жанна Нгуэн-Гок, единственная дочь нового Шолонского Фу, — странное и таинственное маленькое существо; не знаешь, что она такое: европейка или азиатка."
                                            },
                                            {
                                                "example_id": "a6d9059e-00d7-40a8-bbbd-e9bd8421a8fa",
                                                "sense_id": "df81dbf3-64bb-322f-9196-73463766b89c",
                                                "text": "Происхождения моего ни я сам, ни подданные мои не знают, .. женщина же по платью казалась азиатка."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
