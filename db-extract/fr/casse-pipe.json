                                            {
                                                "example_id": "245c117e-e56f-4ced-8d49-b44d3c606753",
                                                "sense_id": "b693c070-4598-3532-bf50-58b9f32d0145",
                                                "text": "Der Messer hat alle Daten korrekt aufgenommen."
                                            }
