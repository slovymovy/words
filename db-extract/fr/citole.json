                "senses": [
                    {
                        "sense_id": "ddbeb095-cac9-3d1a-a4b6-f4d9671a9aea",
                        "entry_id": "8ff63f86-fdcc-32b0-a04f-d146c05cce07",
                        "glosses": [
                            "Instrument à cordes pincées ancêtre du cistre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b4638fe-9ab6-4899-803b-fdd7e8903b0b",
                                "sense_id": "ddbeb095-cac9-3d1a-a4b6-f4d9671a9aea",
                                "text": "La citole possède quatre cordes en métal ou en boyaux."
                            },
                            {
                                "example_id": "6f50992a-1d61-434f-957c-1103cfd0f12b",
                                "sense_id": "ddbeb095-cac9-3d1a-a4b6-f4d9671a9aea",
                                "text": "La tapisserie parviflore des murs disparaissait sous une multitude de trésors à quatre sous : une citole aux cordes éclatées, des fleurs séchées sous verre, fixés à la bassorine, des fétiches des Iles, des cartes postales allemandes encadrées, des coquillages marins."
                            },
                            {
                                "example_id": "c45f35a5-a0e7-43fd-8385-4e151178226a",
                                "sense_id": "ddbeb095-cac9-3d1a-a4b6-f4d9671a9aea",
                                "text": "Par contre, le chapitre qui traite du monde chrétien médiéval est très intéressant car Rey réussit à présenter clairement les quatre types d’instruments les plus cités dans les sources médiévales : le luth, la bandurria, la citole ou cithare et la guitare."
                            }
                        ]
                    }
