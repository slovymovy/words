                                "target_senses": [
                                    {
                                        "sense_id": "6bc90928-0f3b-35f3-a27c-55bd3dd0fb5f",
                                        "entry_id": "4d77a7ef-f1ae-35fc-86fc-864fd5ce41a0",
                                        "glosses": [
                                            "One of the short straps tied between the legs of unfenced horses, allowing them to wander short distances but preventing them from running off."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e3d567c8-b863-3545-a38b-6591e77cb80e",
                                        "entry_id": "4d77a7ef-f1ae-35fc-86fc-864fd5ce41a0",
                                        "glosses": [
                                            "An unsteady, off-balance step."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcb34c54-e7dd-4271-a49f-1bc2780e7ce0",
                                                "sense_id": "e3d567c8-b863-3545-a38b-6591e77cb80e",
                                                "text": "We made it and we hobbled up the stairs. Or I hobbled. My sons didn't hobble, I hobbled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c31d02da-d1af-313f-840e-6ea9db2ad706",
                                        "entry_id": "4d77a7ef-f1ae-35fc-86fc-864fd5ce41a0",
                                        "glosses": [
                                            "A difficult situation; a scrape."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a77524e8-d324-4ecc-afd0-58be1de0f9a5",
                                                "sense_id": "c31d02da-d1af-313f-840e-6ea9db2ad706",
                                                "text": "\"Saddle a horse—any horse—only let him be sure and fleet,\" cried Ashwoode, \"and I'll pay you his price thrice over!\"\n\"Well, it's a bargain,\" replied the groom, promptly; \"I don't like to see a gentleman caught in a hobble, if I can help him out of it. […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f50f3f35-585a-3df0-b7c0-ef0b8fd694d7",
                                        "entry_id": "4d77a7ef-f1ae-35fc-86fc-864fd5ce41a0",
                                        "glosses": [
                                            "An odd job; a piece of casual work."
                                        ],
                                        "tags": [
                                            "Newfoundland",
                                            "UK",
                                            "dialectal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hobble",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a109e6fd-6266-3b3c-9b3b-9c6d8acef168",
                                        "entry_id": "2ddbecf6-f1c6-3299-aab2-cbbb7fa95d8d",
                                        "glosses": [
                                            "To fetter by tying the legs; to restrict (a horse) with hobbles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef75aff4-1a05-45c2-8bd6-5bde6e42d88e",
                                                "sense_id": "a109e6fd-6266-3b3c-9b3b-9c6d8acef168",
                                                "text": "Near-synonyms: shackle, enshackle"
                                            },
                                            {
                                                "example_id": "cefd950b-e41d-40b4-923a-699df2c1fa10",
                                                "sense_id": "a109e6fd-6266-3b3c-9b3b-9c6d8acef168",
                                                "text": "you hobble your old horse and turn him grazing"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e98b2e7-5d01-3135-ae5b-b0dc92058a80",
                                        "entry_id": "2ddbecf6-f1c6-3299-aab2-cbbb7fa95d8d",
                                        "glosses": [
                                            "To walk lame, or unevenly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e94c25e-ca53-4192-a731-ccb6b0e88ed4",
                                                "sense_id": "5e98b2e7-5d01-3135-ae5b-b0dc92058a80",
                                                "text": "The friar was hobbling the same way too."
                                            },
                                            {
                                                "example_id": "184e08f8-f7e4-4df0-ae92-3fb2cf627d8b",
                                                "sense_id": "5e98b2e7-5d01-3135-ae5b-b0dc92058a80",
                                                "text": "Pepa runs all over Madrid in high heels and tube skirts that make her hobble and give the impression of restraining a naturally energetic woman."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11d71633-94d2-3a3a-b023-3f7eff825598",
                                        "entry_id": "2ddbecf6-f1c6-3299-aab2-cbbb7fa95d8d",
                                        "glosses": [
                                            "To move or proceed roughly or irregularly."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f8882cc-aa9c-4e06-a41d-a911175a5265",
                                                "sense_id": "11d71633-94d2-3a3a-b023-3f7eff825598",
                                                "text": "The hobbling versification, the mean diction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f270efc-2737-312f-aacf-1198b3c03208",
                                        "entry_id": "2ddbecf6-f1c6-3299-aab2-cbbb7fa95d8d",
                                        "glosses": [
                                            "To disable; to impede."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d644348-c1ab-407e-bc80-c5fb19850d12",
                                                "sense_id": "3f270efc-2737-312f-aacf-1198b3c03208",
                                                "text": "Near-synonyms: nobble, hamper, hinder, embarrass"
                                            }
