                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4a20aad-0119-4729-b306-8cf0d82488aa",
                                                "sense_id": "dfe75a96-988c-3e6c-9f2e-c0cd89516b0d",
                                                "text": "σοβαρέψου και μη γίνεσαι παιδί!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a55c5c3c-5d82-3604-b429-89847da60c3e",
                                        "entry_id": "67ab2423-a7a4-3eb9-b6fe-7469fb9a1b16",
                                        "glosses": [
                                            "ο ενήλικας που εμφανίζει θετικά χαρακτηριστικά (αθωότητα, ευαισθησία, τρυφερότητα κ.λπ.) της παιδικής ηλικίας"
                                        ],
                                        "tags": [
                                            "diminutive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e45e871-aae8-4bca-9ef2-cabf58b4db56",
                                                "sense_id": "a55c5c3c-5d82-3604-b429-89847da60c3e",
                                                "text": "είναι ένα παιδί, μην την πληγώσεις"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5ae5ec78-b7cc-45bf-b3e5-c3b4929c5565",
