                "senses": [
                    {
                        "sense_id": "3b80f379-06ba-30a2-94ed-fa763a116d4a",
                        "entry_id": "8e889042-ce7d-35ad-a9ea-e0c384abed70",
                        "glosses": [
                            "een wielerwedstrijd die al vele jaren wordt georganiseerd; een wielerwedstrijd die die titel heeft gekregen van de sporters, de pers en het publiek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02e02cea-a14d-4d72-8606-12400a9a03d0",
                                "sense_id": "3b80f379-06ba-30a2-94ed-fa763a116d4a",
                                "text": "Het vuurwerk zit niet alleen in de staart. Tijdens de elfde etappe rijden de renners zo'n 35 kilometer over onverharde grindwegen in de Toscaanse wijnstreek rondom Montalcino. Hiermee wordt de wielerklassieker Strade Bianche verwerkt in een Giro-etappe."
                            },
                            {
                                "example_id": "79fa568c-9bd6-4b8b-8537-a67f57daa73d",
                                "sense_id": "3b80f379-06ba-30a2-94ed-fa763a116d4a",
                                "text": "Goedemorgen! Vandaag vindt een demonstratie tegen het coronabeleid plaats in het centrum van Amsterdam, en onder anderen Mathieu van der Poel komt in actie tijdens de wielerklassieker Parijs-Roubaix."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
