                                        "sense_id": "279cc03f-0123-31d6-bed5-60de09cf0a96",
                                        "entry_id": "8db3a41a-b399-38cb-b273-cf682aa387b8",
                                        "glosses": [
                                            "форма настоящего времени третьего лица множественного числа изъявительного наклонения глагола бурить"
                                        ],
