                                "target_senses": [
                                    {
                                        "sense_id": "939a3667-9ee9-3785-a106-7d494bba8eb3",
                                        "entry_id": "513f0d7f-8f0e-3134-afbd-ae9b94a6f564",
                                        "glosses": [
                                            "A person suffering from pulmonary tuberculosis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8598910a-b4ef-49c6-97bb-926012cfb849",
                                                "sense_id": "939a3667-9ee9-3785-a106-7d494bba8eb3",
                                                "text": "The consumptive has managed to shake the servant from her side and walks alone, striving to make it look easy."
