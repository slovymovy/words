                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onde gravitationnelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd92ac95-d3ca-357b-9d7c-aa824cac58b2",
                                        "entry_id": "53b5344b-25f0-37e7-9837-676b4e63d20b",
                                        "glosses": [
                                            "Onde affectant les distances et le temps qui, selon la théorie de la relativité générale, est produite par toute masse en mouvement accéléré et qui se propage à la vitesse de la lumière."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7d70464-1990-4528-a1e5-6934d765fa3d",
                                                "sense_id": "fd92ac95-d3ca-357b-9d7c-aa824cac58b2",
                                                "text": "Lorsque les deux trous noirs se rapprochent, des ondes gravitationnelles sont créées, affolant périodiquement les détecteurs de LIGO."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
