                "senses": [
                    {
                        "sense_id": "6d893a7e-f5f5-354e-8600-5669f7b10569",
                        "entry_id": "7d092138-e075-3122-9123-b6d3d0ed097c",
                        "glosses": [
                            "A small out-pouching of an organ wall such as the large intestine or urinary bladder."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5be4b96-accd-4390-88cf-8b29d17310aa",
                                "sense_id": "6d893a7e-f5f5-354e-8600-5669f7b10569",
                                "text": "Diverticula are small, light-bulb-shaped pouches in the bowel wall, resulting from the tissue in the gut bulging outwards under pressure."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17b6c2e4-800c-44d3-9968-16a8957f7e6d",
                        "source_entry_id": "7d092138-e075-3122-9123-b6d3d0ed097c",
                        "source_sense_id": "6d893a7e-f5f5-354e-8600-5669f7b10569",
                        "source_sense_description": "small growth off an organ",
                        "target_lang_word": "diverticule",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diverticule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "61b4b596-6c70-3431-a005-331607e058fe",
                                        "entry_id": "c57ac4c5-197d-3bf8-9901-29083452e229",
                                        "glosses": [
                                            "Petite poche en cul-de-sac, petite cavité naturelle ou pathologique située dans la paroi d’un organe creux, principalement le tube digestif et en particulier le côlon, ou dans le mésoderme (allantoïde), et plus rarement l’appareil urinaire ou le cœur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd1c76de-286d-43b7-8ba8-bc6275e6078c",
                                                "sense_id": "61b4b596-6c70-3431-a005-331607e058fe",
                                                "text": "On parle de vrai diverticule lorsqu’il concerne toutes les membranes de la paroi organique. Un faux diverticule ne se forme au contraire que dans une des membranes de la paroi organique."
                                            },
                                            {
                                                "example_id": "0256aceb-1e81-4b38-893a-b7fa96f87f5c",
                                                "sense_id": "61b4b596-6c70-3431-a005-331607e058fe",
                                                "text": "A quoi peut donc servir l’appendice, cet étrange diverticule suspendu à l’entrée du gros intestin ? La question intrigue de longue date."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53ad8653-be1a-3f9e-b5f4-bf69c3e923d1",
                                        "entry_id": "c57ac4c5-197d-3bf8-9901-29083452e229",
                                        "glosses": [
                                            "Chemin se détachant d’un sentier de grande randonnée pour conduire à un point donné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70902c9d-a19e-4dc2-8469-1cb52cef1317",
                                                "sense_id": "53ad8653-be1a-3f9e-b5f4-bf69c3e923d1",
                                                "text": "Atteindre Faouria (possible diverticule jusqu’à la chapelle N. D. de Maravals) et poursuivre jusqu’à Naugé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33ea20ed-7954-3183-ac55-f513b6c2efd4",
                                        "entry_id": "c57ac4c5-197d-3bf8-9901-29083452e229",
                                        "glosses": [
                                            "Dans un réseau souterrain, couloir séparant deux salles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba316299-7bb1-4719-a85f-37db1adf64ca",
                                                "sense_id": "33ea20ed-7954-3183-ac55-f513b6c2efd4",
                                                "text": "Par le diverticule antichambre, on pourrait pénétrer dans le lieu à tout faire où la moquette cède place à un de ces faux carrelages en gerflex, qui, le lieu, contient le frigidaire, la douche, le bidet, le réchaud à gaz, l’armoire de Barbe-Bleue, la glace en pied, la table à maquillage"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a64f0630-2a33-4321-a7b1-3996adfccd50",
                        "source_entry_id": "7d092138-e075-3122-9123-b6d3d0ed097c",
