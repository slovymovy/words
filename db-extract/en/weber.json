                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname; fünfthäufigster Nachname in Deutschland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e41766b-868c-4763-a46c-d7fb775a5e40",
                                                "sense_id": "571ad582-4ed0-34b0-97ed-d91b038895f0",
                                                "text": "Das Übergewicht des Herrn Weber nimmt rasant zu."
                                            },
                                            {
                                                "example_id": "8285dac0-ac8b-467d-bb02-6d69b2a10742",
                                                "sense_id": "571ad582-4ed0-34b0-97ed-d91b038895f0",
                                                "text": "Der Kollegin Weber ist ein unschlagbar gutes Angebot gemacht worden."
                                            },
                                            {
                                                "example_id": "21e00ab8-691e-4173-8e85-a3b75d5040a3",
                                                "sense_id": "571ad582-4ed0-34b0-97ed-d91b038895f0",
                                                "text": "Webers sind zum Wandern im Fichtelgebirge."
                                            },
                                            {
                                                "example_id": "607a0e99-4874-44d1-ada4-9da6ea4cc7ae",
                                                "sense_id": "571ad582-4ed0-34b0-97ed-d91b038895f0",
                                                "text": "Des jungen Webers Erkrankung lähmt sein ganzes Umfeld."
                                            },
                                            {
                                                "example_id": "e1af2d29-92a3-48f2-8d74-536f06b62c27",
                                                "sense_id": "571ad582-4ed0-34b0-97ed-d91b038895f0",
                                                "text": "Irgendjemand muss mit Weber sprechen und ihr die Nachricht überbringen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
