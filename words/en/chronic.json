{
    "word_family": [
        "chronicle",
        "chronology",
        "chronological",
        "chronometer",
        "anachronism",
        "synchronize"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6ebab9ce-c89d-33ff-b256-8d72bbe242c5",
                    "sense_definition": "Persisting for a long time or constantly recurring, especially of an illness or medical condition.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "medical_condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient has been suffering from <w>chronic</w> back pain for over ten years.",
                            "target_lang_translations": {
                                "ru": "Пациент страдает от <w>хронической</w> боли в спине уже более десяти лет.",
                                "zh": "这位病人患有<w>慢性</w>背痛已经超过十年了。"
                            }
                        },
                        {
                            "text": "Doctors are looking for new ways to treat <w>chronic</w> cough in elderly patients.",
                            "target_lang_translations": {
                                "ru": "Врачи ищут новые способы лечения <w>хронического</w> кашля у пожилых пациентов.",
                                "zh": "医生们正在寻找治疗老年患者<w>慢性</w>咳嗽的新方法。"
                            }
                        }
                    ],
                    "synonyms": [
                        "prolonged",
                        "lasting"
                    ],
                    "antonyms": [
                        "acute",
                        "transient"
                    ],
                    "common_phrases": [
                        "chronic pain",
                        "chronic illness",
                        "chronic cough"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сохраняющийся в течение длительного времени или постоянно повторяющийся, особенно в отношении болезни или медицинского состояния.",
                        "zh": "指长期持续或反复发作的，尤指疾病或医疗状况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хронический",
                                "target_lang_sense_clarification": "о болезни или состоянии"
                            },
                            {
                                "target_lang_word": "затяжной",
                                "target_lang_sense_clarification": "длящийся долгое время"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "慢性",
                                "target_lang_sense_clarification": "指疾病或病症长期存在"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d9ce9a1-395f-34dd-b9a2-8f272a27e814",
                    "sense_definition": "Of a problem or negative situation, continuing over an extended period of time.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "persistent_problem",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The region has faced <w>chronic</w> unemployment since the local factory closed down.",
                            "target_lang_translations": {
                                "ru": "Регион столкнулся с <w>хронической</w> безработицей с тех пор, как закрылся местный завод.",
                                "zh": "自从当地工厂倒闭后，该地区一直面临着<w>长期</w>失业的问题。"
                            }
                        },
                        {
                            "text": "There is a <w>chronic</w> shortage of affordable housing in the city center.",
                            "target_lang_translations": {
                                "ru": "В центре города наблюдается <w>хроническая</w> нехватка доступного жилья.",
                                "zh": "市中心一直存在着<w>长期</w>经济适用房短缺的问题。"
                            }
                        }
                    ],
                    "synonyms": [
                        "persistent",
                        "long-standing"
                    ],
                    "common_phrases": [
                        "chronic shortage",
                        "chronic unemployment",
                        "chronic poverty"
                    ],
                    "target_lang_definitions": {
                        "ru": "О проблеме или негативной ситуации: продолжающийся в течение длительного периода времени.",
                        "zh": "指问题或负面情况长期存在，难以解决。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хронический",
                                "target_lang_sense_clarification": "о дефиците, безработице и т.д."
                            },
                            {
                                "target_lang_word": "постоянный",
                                "target_lang_sense_clarification": "непрекращающийся"
                            },
                            {
                                "target_lang_word": "застарелый",
                                "target_lang_sense_clarification": "давно существующий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "长期",
                                "target_lang_sense_clarification": "指问题持续时间长"
                            },
                            {
                                "target_lang_word": "积重难返",
                                "target_lang_sense_clarification": "形容问题长期积累难以改变"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff2e76be-2afa-3b74-857f-eb6cf582623e",
                    "sense_definition": "Doing something habitually or being characterized by a habit that is difficult to break.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "habitual_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a <w>chronic</w> liar who cannot be trusted even with simple matters.",
                            "target_lang_translations": {
                                "ru": "Он <w>неисправимый</w> лжец, которому нельзя доверять даже в простых вопросах.",
                                "zh": "他是个<w>惯性</w>说谎者，即使在简单的事情上也无法信任他。"
                            }
                        },
                        {
                            "text": "As a <w>chronic</w> smoker, he found it nearly impossible to quit without professional help.",
                            "target_lang_translations": {
                                "ru": "Как <w>заядлый</w> курильщик, он обнаружил, что бросить курить без профессиональной помощи почти невозможно.",
                                "zh": "作为一个<w>长期</w>吸烟者，他发现没有专业帮助几乎不可能戒烟。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inveterate",
                        "habitual"
                    ],
                    "common_phrases": [
                        "chronic liar",
                        "chronic smoker"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делающий что-либо по привычке или характеризующийся привычкой, от которой трудно избавиться.",
                        "zh": "指习惯性地做某事，或具有某种难以改掉的习惯。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заядлый",
                                "target_lang_sense_clarification": "о курильщике или игроке"
                            },
                            {
                                "target_lang_word": "неисправимый",
                                "target_lang_sense_clarification": "о лжеце или поведении"
                            },
                            {
                                "target_lang_word": "хронический",
                                "target_lang_sense_clarification": "о привычке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "惯性",
                                "target_lang_sense_clarification": "指行为习惯化"
                            },
                            {
                                "target_lang_word": "积习难改",
                                "target_lang_sense_clarification": "形容习惯难以纠正"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8013d21-e965-31a7-bcc5-012d06251062",
                    "sense_definition": "Extremely bad, unpleasant, or of very poor quality.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "quality_judgment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The service at that restaurant was absolutely <w>chronic</w> last night.",
                            "target_lang_translations": {
                                "ru": "Обслуживание в том ресторане вчера вечером было просто <w>ужасным</w>.",
                                "zh": "那家餐厅昨晚的服务简直<w>糟糕</w>透了。"
                            }
                        },
                        {
                            "text": "I had to leave early because the music was <w>chronic</w> and way too loud.",
                            "target_lang_translations": {
                                "ru": "Мне пришлось уйти пораньше, потому что музыка была <w>отвратительной</w> и слишком громкой.",
                                "zh": "我不得不早点离开，因为音乐实在太<w>糟糕</w>且声音太大了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "terrible",
                        "abysmal",
                        "awful"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "mainly British usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно плохой, неприятный или очень низкого качества.",
                        "zh": "极差的、令人不快的或质量非常低劣的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ужасный",
                                "target_lang_sense_clarification": "о качестве или опыте"
                            },
                            {
                                "target_lang_word": "отвратительный",
                                "target_lang_sense_clarification": "крайне неприятный"
                            },
                            {
                                "target_lang_word": "никудышный",
                                "target_lang_sense_clarification": "очень плохого качества"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "糟糕",
                                "target_lang_sense_clarification": "形容质量极差"
                            },
                            {
                                "target_lang_word": "恶劣",
                                "target_lang_sense_clarification": "形容情况或服务非常不好"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53a01a20-3435-306d-8ff8-088892d9b532",
                    "sense_definition": "Excellent, great, or very impressive.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slang_approval",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That new skateboard trick you did was <w>chronic</w>.",
                            "target_lang_translations": {
                                "ru": "Тот новый трюк на скейтборде, который ты сделал, был <w>крутым</w>.",
                                "zh": "你刚才做的那个新滑板动作真是<w>超棒</w>。"
                            }
                        },
                        {
                            "text": "The party last night was <w>chronic</w> and everyone had a great time.",
                            "target_lang_translations": {
                                "ru": "Вечеринка вчера была <w>классной</w>, и все отлично провели время.",
                                "zh": "昨晚的派对真是<w>超棒</w>，每个人都玩得很开心。"
                            }
                        }
                    ],
                    "synonyms": [
                        "excellent",
                        "splendid",
                        "wicked"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "dated usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отличный, великолепный или очень впечатляющий.",
                        "zh": "极好的、伟大的或令人印象深刻的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "классный",
                                "target_lang_sense_clarification": "сленг, превосходный"
                            },
                            {
                                "target_lang_word": "крутой",
                                "target_lang_sense_clarification": "сленг, впечатляющий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "超棒",
                                "target_lang_sense_clarification": "口语，形容事物极好"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b7d9a244-18d9-3aaf-928e-4ddd94abee00",
                    "sense_definition": "A person who suffers from a long-term illness or a persistent, habitual condition.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person_type",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hospital ward was specifically designed to accommodate the needs of <w>chronics</w>.",
                            "target_lang_translations": {
                                "ru": "Больничная палата была специально спроектирована для нужд <w>хроников</w>.",
                                "zh": "这个病房是专门为满足<w>慢性病患者</w>的需求而设计的。"
                            }
                        },
                        {
                            "text": "Social workers often deal with <w>chronics</w> who have been in and out of the system for years.",
                            "target_lang_translations": {
                                "ru": "Социальные работники часто имеют дело с <w>хрониками</w>, которые годами то попадают в систему, то выходят из неё.",
                                "zh": "社会工作者经常要处理那些多年来反复进出医疗系统的<w>慢性病患者</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, страдающий длительным заболеванием или постоянным, привычным состоянием.",
                        "zh": "患有长期疾病或有持续性习惯性病症的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хроник",
                                "target_lang_sense_clarification": "больной с затяжной болезнью"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "慢性病患者",
                                "target_lang_sense_clarification": "指长期患病的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "692435d5-98c3-3e9d-b08c-d9807392e030",
                    "sense_definition": "High-quality marijuana.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They spent the evening on the roof smoking some <w>chronic</w>.",
                            "target_lang_translations": {
                                "ru": "Они провели вечер на крыше, покуривая <w>убойную траву</w>.",
                                "zh": "他们晚上在屋顶上抽了一些<w>优质大麻</w>。"
                            }
                        },
                        {
                            "text": "He was arrested for possession of <w>chronic</w> and other illegal substances.",
                            "target_lang_translations": {
                                "ru": "Он был арестован за хранение <w>марихуаны</w> и других запрещенных веществ.",
                                "zh": "他因持有<w>优质大麻</w>和其他非法物质而被捕。"
                            }
                        }
                    ],
                    "synonyms": [
