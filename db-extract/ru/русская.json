                    {
                        "translation_id": "92da3142-f5cc-4375-9287-df47fd198a2c",
                        "source_entry_id": "790cca83-a803-370d-bdd9-f6ddc4da83cc",
                        "source_sense_id": "28cb89b1-708c-36f5-8784-dd605975f22b",
