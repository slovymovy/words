                                    {
                                        "sense_id": "bdf62d47-92f2-35c9-8eaa-13afedb5970c",
                                        "entry_id": "c09367ac-4b45-3c9b-9438-e7eefc1b341a",
                                        "glosses": [
                                            "An inflamed (raised and colored) spot on the surface of the skin that is usually painful and fills with pus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "688e97e8-a2fe-4068-a8ac-67c57378c187",
                                                "sense_id": "bdf62d47-92f2-35c9-8eaa-13afedb5970c",
                                                "text": "I had to pop that embarrassing pimple, it was huge and red and on the tip of my nose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff157f1c-45ca-3ba6-98f9-9b998e3230e1",
                                        "entry_id": "c09367ac-4b45-3c9b-9438-e7eefc1b341a",
                                        "glosses": [
                                            "An annoying person."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32bd24ff-056f-4cf6-b9f8-8ef5ed60c93d",
                                                "sense_id": "ff157f1c-45ca-3ba6-98f9-9b998e3230e1",
                                                "text": "He's such a pimple! I wish he'd stop being so irritating!"
                                            }
                                        ]
                                    },
