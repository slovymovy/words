    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "d00f7306-ae24-32a8-accd-36b5eb13856a",
                    "sense_definition": "Принадлежащий самому себе или относящийся к подлежащему (субъекту) в предложении; собственный.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я положил <свою> сумку на верхнюю полку в поезде.",
                            "target_lang_translations": {
                                "en": "I put <my> bag on the top bunk in the train.",
                                "zh": "我把<自己的>包放在了火车的上铺。"
                            }
                        },
                        {
                            "text": "Она всегда отстаивает <своё> мнение в спорах с коллегами.",
                            "target_lang_translations": {
                                "en": "She always defends <her> opinion in arguments with colleagues.",
                                "zh": "在与同事争论时，她总是坚持<自己的>观点。"
                            }
                        }
                    ],
                    "synonyms": [
                        "собственный"
                    ],
                    "antonyms": [
                        "чужой"
                    ],
                    "common_phrases": [
                        "в своё время",
                        "на своём месте",
                        "мастер своего дела",
                        "стоять на своём"
                    ],
                    "target_lang_definitions": {
                        "en": "Belonging to oneself or referring to the subject of the sentence; one's own.",
                        "zh": "指代句子的主语，表示属于主语本身或与主语相关；自己的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "one's own",
                                "target_lang_sense_clarification": "Reflexive possessive indicating ownership by the subject"
                            },
                            {
                                "target_lang_word": "own",
                                "target_lang_sense_clarification": "Used with possessive determiners to emphasize individual ownership"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "自己的",
                                "target_lang_sense_clarification": "反身领属代词，表示主语所拥有的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1552074-3986-3a73-8c01-b83c31637e8d",
                    "sense_definition": "Близкий, родной, входящий в круг друзей, родственников или единомышленников.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он сразу почувствовал, что в этом доме он <свой>.",
                            "target_lang_translations": {
                                "en": "He immediately felt that in this house he was <one of the family>.",
                                "zh": "他立刻感觉到在这个家里他就是<自己人>。"
                            }
                        },
                        {
                            "text": "На вечеринке были только <свои>, поэтому атмосфера была расслабленной.",
                            "target_lang_translations": {
                                "en": "There were only <close friends> at the party, so the atmosphere was relaxed.",
                                "zh": "聚会上都是<自己人>，所以气氛很轻松。"
                            }
                        }
                    ],
                    "synonyms": [
                        "наш"
                    ],
                    "antonyms": [
                        "чужой"
                    ],
                    "common_phrases": [
                        "свой человек",
                        "свои люди",
                        "среди своих"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used as a noun to refer to friends or relatives"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Close, related, belonging to a circle of friends, relatives, or like-minded people.",
                        "zh": "亲近的、熟悉的，属于朋友、亲戚或志同道合者的圈子。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "one of us",
                                "target_lang_sense_clarification": "Referring to someone accepted as a member of a group"
                            },
                            {
                                "target_lang_word": "insider",
                                "target_lang_sense_clarification": "Someone within a specific circle or group"
                            },
                            {
                                "target_lang_word": "one's own",
                                "target_lang_sense_clarification": "Referring to one's family, kin, or people"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "自己人",
                                "target_lang_sense_clarification": "指被接纳为群体成员的人"
                            },
                            {
                                "target_lang_word": "内部人",
                                "target_lang_sense_clarification": "指特定圈子或群体内的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e52c8da2-1bb0-3f5b-8965-6af2c6e49529",
                    "sense_definition": "Особенный, специфический, присущий только данному предмету, лицу или ситуации.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В каждом времени года есть <своя> особенная красота.",
                            "target_lang_translations": {
                                "en": "Every season has <its own> special beauty.",
                                "zh": "每个季节都有<其特有的>美。"
                            }
                        },
                        {
                            "text": "В этом странном и неожиданном решении был <свой> смысл.",
                            "target_lang_translations": {
                                "en": "There was <its own> meaning in this strange and unexpected decision.",
                                "zh": "这个奇怪且出人意料的决定有<其特定的>意义。"
                            }
                        }
                    ],
                    "synonyms": [
                        "определённый",
                        "некий"
                    ],
                    "common_phrases": [
                        "свой взгляд",
                        "свой мир",
                        "свой интерес"
                    ],
                    "target_lang_definitions": {
                        "en": "Special, specific, inherent only to a particular object, person, or situation.",
                        "zh": "特殊的、特定的，仅属于某个特定事物、个人或情况的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "its own",
                                "target_lang_sense_clarification": "Unique or inherent to something"
                            },
                            {
                                "target_lang_word": "specific",
                                "target_lang_sense_clarification": "Particular to a certain case or individual"
                            },
                            {
                                "target_lang_word": "peculiar",
                                "target_lang_sense_clarification": "Distinctive or characteristic"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "特有的",
                                "target_lang_sense_clarification": "某事物所独有的或固有的"
                            },
                            {
                                "target_lang_word": "特定的",
                                "target_lang_sense_clarification": "针对特定情况或个人的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}