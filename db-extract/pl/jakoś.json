                                                "sense_id": "043446e6-7c11-3216-84f8-4949af752485",
                                                "text": "Möchtest du etwa jetzt schon gehen?"
                                            },
                                            {
                                                "example_id": "4abe2f7e-7533-4cfc-9a12-098845315656",
                                                "sense_id": "043446e6-7c11-3216-84f8-4949af752485",
                                                "text": "Hast etwa du die Presse informiert?"
