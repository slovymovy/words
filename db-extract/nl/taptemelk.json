                "senses": [
                    {
                        "sense_id": "37a2711e-e270-3b04-ba15-1168b9d0fb42",
                        "entry_id": "f123e23f-7ac4-3073-892f-ffb005396f94",
                        "glosses": [
                            "melk waarvan de room is afgehaald, magere melk, afgeroomde melk, koemelk waarvan het merendeel van het melkvet verwijderd is, tot maximaal 0,3% vet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c0b5842-204c-4721-b65d-2a136fe9bed1",
                                "sense_id": "37a2711e-e270-3b04-ba15-1168b9d0fb42",
                                "text": "Ik werd gevoed met taptemelk. Dat zag blauwig, volgens mijn moeder."
                            },
                            {
                                "example_id": "e6e0c46e-7e7f-4ad9-9bdd-88a304037c6a",
                                "sense_id": "37a2711e-e270-3b04-ba15-1168b9d0fb42",
                                "text": "Het recept voor het nagerecht Niemendal (slechts 123 calorieën per portie) met taptemelk en puddingmix, heb ik terzijde gelegd, maar zijn koffie-roomdressing voor salade intrigeerde me: een nagerecht op basis van room, koffie, noten, sinaasappel en munt. Een gloednieuwe manier om uw salade te versieren', schreef Jans."
                            }
                        ]
                    }
