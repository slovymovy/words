                "senses": [
                    {
                        "sense_id": "657f8399-f895-3a19-a419-7561452a8dc9",
                        "entry_id": "80bde993-3638-38c9-85b0-5618955bd06e",
                        "glosses": [
                            "auf der Rückenmitte von vorn nach hinten verlaufender dunkler Strich/Streifen im Fell von Säugetieren, etwa Pferden, Rindern, Ziegen, Katze oder Eseln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2a53c0c-3603-428a-89f3-1915e325a4b9",
                                "sense_id": "657f8399-f895-3a19-a419-7561452a8dc9",
                                "text": "Die Katze Tiffy hat einen Aalstrich."
                            },
                            {
                                "example_id": "f7585506-0a71-4bf4-93aa-0d1294efff15",
                                "sense_id": "657f8399-f895-3a19-a419-7561452a8dc9",
                                "text": "„Neben vier dunklen Streifen im Nacken und einem Aalstrich am hinteren Rücken bietet am ehesten ihr Schwanz Hinweise: Er hat ein stumpfes Ende und weist zwei bis drei schwarze Ringe auf, die im Unterschied zur Hauskatze nicht miteinander verbunden sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
