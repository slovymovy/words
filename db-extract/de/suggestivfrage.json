                                        "entry_id": "b4f12ba2-6981-3e54-8de9-6184df9c5a13",
                                        "glosses": [
                                            "A question that suggests the answer or that contains the information for which the examiner is looking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60d42ac4-94ab-4000-ad50-6cb17b46d342",
                                                "sense_id": "28aee206-3278-325f-aef8-9f8a1563b5f0",
                                                "text": "He alluded constantly to Europe, to the people I was supposed to know there - putting leading questions as to my acquaintances in the sepulchral city, and so on."
                                            }
                                        ]
                                    }
                                ]
