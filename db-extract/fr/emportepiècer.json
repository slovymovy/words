                        "sense_id": "89ae0fb7-e9fa-38a3-ab98-c5e7260cde69",
                        "entry_id": "40e9bb8e-98c7-33f8-b080-a0992410a55d",
                        "glosses": [
                            "Créer des formes dans une pâte avec un emporte-pièce."
                        ],
                        "tags": [
                            "Pâtisserie"
                        ],
                        "examples": [
                            {
                                "example_id": "073e4afe-665a-4471-ba3b-c7cfc552c61e",
                                "sense_id": "89ae0fb7-e9fa-38a3-ab98-c5e7260cde69",
                                "text": "Porter l’eau et le sucre à ébullition. Ajouter le jasmin, laisser infuser 7 minutes, filtrer et ajouter la gélatine. Couler dans une plaque filmée avec rebords et emportepiècer à l’aide d’un cercle de 4 cm."
                            },
                            {
                                "example_id": "ca97b33e-d7cf-4d4f-afb7-f1b1414f190a",
                                "sense_id": "89ae0fb7-e9fa-38a3-ab98-c5e7260cde69",
                                "text": "Mettre la pâte au frigo pendant 1h30 minimum. Étaler la pâte et emportepiècer-la en forme de citrouille, chapeau de sorcière, et de fantôme."
                            }
                        ]
                    }
