                    }
                ],
                "translations": [
                    {
                        "translation_id": "d304af49-7cb1-415a-a3c2-36dc0619320e",
                        "source_entry_id": "769363c9-c749-3969-9632-3d6a42c4487c",
                        "source_sense_id": "95495331-dfd2-32d6-99e7-de1525b88531",
                        "source_sense_description": "Meteorologie: Monsun",
                        "target_lang_word": "Monsun",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Monsun",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2e180676-e797-3da6-8b96-251e70ad8088",
                                        "entry_id": "357430a6-1448-3fd3-8810-872f6a14243d",
                                        "glosses": [
                                            "immer wiederkehrendes, feuchtes (im Sommer) bzw. trockenes (im Winter) Windsystem, das starken Einfluss auf das Klima der Subtropen (Rossbreiten) hat, weniger in den Tropen (am Äquator), weil hier der jahreszeitliche Temperaturunterschied zu gering ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "871e9740-d0f3-4bdb-899e-a3444f1bece4",
                                                "sense_id": "2e180676-e797-3da6-8b96-251e70ad8088",
                                                "text": "Viele Monsune haben eine starke wirtschaftliche Bedeutung für einzelne Länder."
                                            },
                                            {
                                                "example_id": "5cf8b5ab-de76-4a47-8e1d-f1361026fe7f",
                                                "sense_id": "2e180676-e797-3da6-8b96-251e70ad8088",
                                                "text": "Monsune ändern nur alle halben Jahre ihre Richtung."
                                            },
                                            {
                                                "example_id": "89837fc7-1cfd-47ea-a4c1-d2be83a7748e",
                                                "sense_id": "2e180676-e797-3da6-8b96-251e70ad8088",
                                                "text": "„Nachdem der Monsun immer wieder Flutwellen in die Bucht getrieben hatte, musste ein Teil Victorias versetzt werden.“"
                                            },
                                            {
                                                "example_id": "bdd6f029-2db7-4d34-b83d-d7786339b18e",
                                                "sense_id": "2e180676-e797-3da6-8b96-251e70ad8088",
                                                "text": "„Er musste dabei den Stand der Ernte unter den Bedingungen des Monsuns beurteilen, die einmal besser, einmal schlechter sein konnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f21d0e6e-3e12-4f30-b3f9-efa371d1d07e",
                        "source_entry_id": "769363c9-c749-3969-9632-3d6a42c4487c",
                        "source_sense_id": "b839119c-3ee6-3e1c-ada0-9c1611bc866c",
                        "source_sense_description": "Meteorologie, speziell: Sommermonsun",
                        "target_lang_word": "Sommermonsun",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8425c82a-d144-48c6-971e-10b18d6f59fd",
                        "source_entry_id": "769363c9-c749-3969-9632-3d6a42c4487c",
                        "source_sense_id": "4d920f36-76ba-3e2d-b873-1df8500d036c",
                        "source_sense_description": "Meteorologie: Regenzeit",
                        "target_lang_word": "Regenzeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Regenzeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3f565443-332a-321f-a9bf-a27ed01722cf",
                                        "entry_id": "4521a4f9-666b-3b61-b5d7-1c5bb302b237",
                                        "glosses": [
                                            "Zeitraum (in den Tropen), in dem besonders viel Regen fällt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02833667-7cae-4466-ad81-3cef81982397",
                                                "sense_id": "3f565443-332a-321f-a9bf-a27ed01722cf",
                                                "text": "Die Regenzeit ist wichtig, um die Wasserreservoire zu füllen."
                                            },
                                            {
                                                "example_id": "ada6c7ef-5534-4ed3-92c6-217f245d3e76",
                                                "sense_id": "3f565443-332a-321f-a9bf-a27ed01722cf",
                                                "text": "„Während der kurzen Regenzeit wird das Tal von mitreißenden Regenfluten überschwemmt, die sich donnernd in den Atlantik ergießen.“"
                                            },
                                            {
                                                "example_id": "0c8a0f9e-d237-4a34-a704-6506b6a22aee",
                                                "sense_id": "3f565443-332a-321f-a9bf-a27ed01722cf",
                                                "text": "„Denn auch in jenem Januar 1890 war die Regenzeit in Samoa gekennzeichnet durch lähmende Hitze und sintflutartige Regenfälle sowie häufige Sturmwinde und extrem hohe Luftfeuchtigkeit.“"
                                            },
                                            {
                                                "example_id": "bd652e4d-6b70-47c2-baeb-1443b6695ac9",
                                                "sense_id": "3f565443-332a-321f-a9bf-a27ed01722cf",
                                                "text": "„Das Wasser, das in den Seen gespeichert wurde, fließt weiter Jahr für Jahr zur Regenzeit ins Tal - inzwischen wird es jedoch unter die Stadt geleitet.“"
                                            },
                                            {
                                                "example_id": "cfadfaac-c5fb-4414-a312-c6ec5d5c099a",
                                                "sense_id": "3f565443-332a-321f-a9bf-a27ed01722cf",
                                                "text": "„Während der Regenzeit zerren Sturmböen an Reitern und Zelten.“"
                                            },
                                            {
                                                "example_id": "aec3be53-e975-40db-b528-a0b2e703ee69",
                                                "sense_id": "3f565443-332a-321f-a9bf-a27ed01722cf",
                                                "text": "„Doch die Regenzeit stand kurz bevor, und wenn die Straße unasphaltiert blieb, würde die ganze Arbeit im Nu weggespült werden.“"
                                            },
                                            {
                                                "example_id": "258a24ac-e6e5-48cd-b67c-63bad7b5de50",
                                                "sense_id": "3f565443-332a-321f-a9bf-a27ed01722cf",
                                                "text": "„Die Ebene wird von Flüssen durchzogen, die in der Regenzeit oft über die Ufer treten und dieses Gebiet unpassierbar machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
