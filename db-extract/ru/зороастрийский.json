                                        "glosses": [
                                            "met betrekking tot of volgens het geloof dat door de profeet Zoroaster werd verkondigd of de aanhangers daarvan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edacbab1-5b47-47a9-807b-f2181e130c6b",
                                                "sense_id": "1977c916-9d1f-391b-80eb-5b7a38256816",
                                                "text": "Ook met zijn Parsi-achtergond heeft hij zich verzoend. Zijn uitvaart was in de zoroastrische traditie van zijn ouders."
                                            },
                                            {
                                                "example_id": "0fa4b5a6-c8da-4390-99c8-38def54dd50a",
                                                "sense_id": "1977c916-9d1f-391b-80eb-5b7a38256816",
                                                "text": "Zo verbleven we in een traditionele herberg bij Tina en Ramtin, een vriendelijk, jong zoroastrisch echtpaar dat samen met familie de tent runt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
