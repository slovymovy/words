                        "entry_id": "ade05621-4a74-3d94-8617-b6d8e4b1984f",
                        "glosses": [
                            "Destruction de la myéline qui protège un organe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3457c89c-7cdb-4e9f-a2a4-16f8033a4fb6",
                                "sense_id": "8ec3ee83-c66a-37e7-b693-9c6dab261500",
                                "text": "La sclérose en plaques (SEP) est une maladie autoinflammatoire du système nerveux central caractérisée par des lésions de démyélinisation."
                            },
                            {
                                "example_id": "70cc3fa6-d094-4c6b-85b5-a713e0345c65",
                                "sense_id": "8ec3ee83-c66a-37e7-b693-9c6dab261500",
                                "text": "Des affections peuvent affecter le tronc cérébral, telles que les accidents vasculaires cérébraux (AVC), les tumeurs malignes et les processus de démyélinisation."
                            }
                        ]
                    }
