                "senses": [
                    {
                        "sense_id": "b526cab3-5a3a-3f4a-a108-c1cf6e28e6c9",
                        "entry_id": "773b5f48-88e3-3bab-823b-46df9744cb6a",
                        "glosses": [
                            "osoba płci żeńskiej, która oszukuje"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "840a58ed-4ff5-4bd6-8560-0a26e7ef0f69",
                                "sense_id": "b526cab3-5a3a-3f4a-a108-c1cf6e28e6c9",
                                "text": "Sprytna oszustka zamiast kości dinozaura sprzedała turystom fragmenty szkieletu krowy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49bf1fed-6529-4767-907c-38819353b937",
                        "source_entry_id": "773b5f48-88e3-3bab-823b-46df9744cb6a",
                        "source_sense_id": "b526cab3-5a3a-3f4a-a108-c1cf6e28e6c9",
                        "target_lang_word": "podvodnice",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8eca1b62-f1f5-4054-adcf-3485a29d8f49",
                        "source_entry_id": "773b5f48-88e3-3bab-823b-46df9744cb6a",
                        "source_sense_id": "b526cab3-5a3a-3f4a-a108-c1cf6e28e6c9",
                        "target_lang_word": "trompeuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trompeuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fe386afe-c1db-38ff-a8bc-7fda96f3641e",
                                        "entry_id": "397c823e-32cd-346e-bb64-275cb4471f6c",
                                        "glosses": [
                                            "Celle qui trompe."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "trompeuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6cf466ee-03bf-3e34-a07b-de6ad49d106d",
                                        "entry_id": "d3c03402-7649-30d9-b969-6c6d77194c1f",
                                        "glosses": [
                                            "Féminin singulier de trompeur."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e93ff30-72f1-4780-a710-b71c0cd129e7",
                                                "sense_id": "6cf466ee-03bf-3e34-a07b-de6ad49d106d",
                                                "text": "Encore étonné et ravi d’avoir si facilement déjoué les contrôles à l’entrée, Jo Manco s’enfonce dans la forêt privée d’Edrize, d’une trompeuse majesté : un réseau souterrain d’analyse des hyphes et des capteurs aériens de substances volatiles saturent ces dix hectares."
                                            },
                                            {
                                                "example_id": "3e890def-c4ea-49e8-ac0a-9de8ac568920",
                                                "sense_id": "6cf466ee-03bf-3e34-a07b-de6ad49d106d",
                                                "text": "Elle demanda de quoi écrire, et comme elle écrivait, c’était encore une folie de fille publique et de femme trompeuse. Elle l’appelait « mon cher petit homme », disait : « Je pleure en t’écrivant ces mots » et riait d’écrire cela. Elle était câline à la façon de Paris où l’on met son sourire aux rencontres des rues et où toute chose se passe avec une ironie française."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a82075b7-3f8c-4f4d-b922-d2fcb5a322b7",
                        "source_entry_id": "773b5f48-88e3-3bab-823b-46df9744cb6a",
                        "source_sense_id": "b526cab3-5a3a-3f4a-a108-c1cf6e28e6c9",
                        "target_lang_word": "Betrügerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Betrügerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50478878-9fdd-33a9-988e-d136ec4ec3ce",
                                        "entry_id": "6bffc13e-7bfe-35fe-a997-9686ebde0f97",
                                        "glosses": [
                                            "weiblicher Betrüger"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e1cad21-e02e-4758-baea-b6b55a61d4df",
                                                "sense_id": "50478878-9fdd-33a9-988e-d136ec4ec3ce",
                                                "text": "Du solltest ihr nicht trauen, dieser Betrügerin!"
                                            },
                                            {
                                                "example_id": "e1fa5fc4-e952-4eaa-82b2-627007b32f9d",
                                                "sense_id": "50478878-9fdd-33a9-988e-d136ec4ec3ce",
                                                "text": "„Am 5. April 2001 erhob der Bezirksanwalt Anklage, nannte Christina Maria Kurmann aus Adliswil eine Urkundenfälscherin und Betrügerin.“"
                                            },
                                            {
                                                "example_id": "684aae1f-6f34-48fd-a58e-4bfcef887d35",
                                                "sense_id": "50478878-9fdd-33a9-988e-d136ec4ec3ce",
                                                "text": "„Da ich etwas unternehmen mußte, um die Absichten der beiden Betrügerinnen zu vereiteln, verließ ich sie wortlos und schloß mich mit Madame d'Urfé ein, um das Orakel über die Operation zu befragen, die zu ihrem Glück führen sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c66ee77c-080a-404d-83b6-8250dc03c5e2",
                        "source_entry_id": "773b5f48-88e3-3bab-823b-46df9744cb6a",
                        "source_sense_id": "b526cab3-5a3a-3f4a-a108-c1cf6e28e6c9",
                        "target_lang_word": "обманщица",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "обманщица",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0fd0ae78-a739-3821-aa5a-785132787265",
                                        "entry_id": "5a4e5939-d07d-3c14-ac13-b42cdd239cbe",
                                        "glosses": [
                                            "женск. к обманщик; женщина, которая обманула или обманывает кого-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1aa0c038-4510-46ed-b39e-9e2fd8f8db57",
                                                "sense_id": "0fd0ae78-a739-3821-aa5a-785132787265",
                                                "text": "Вспомнила и горько заплакала. ― Обманщица! Лгунья!"
                                            },
                                            {
                                                "example_id": "b5c58063-3dc3-49f3-8f3f-66af58a6e973",
                                                "sense_id": "0fd0ae78-a739-3821-aa5a-785132787265",
                                                "text": "Хххххх, милая, здравствуй! Ну и обманщица же ты. Обещала позвонить и не позвонила."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5ad946ca-8d59-4444-9a52-ecd410e11174",
                        "source_entry_id": "773b5f48-88e3-3bab-823b-46df9744cb6a",
                        "source_sense_id": "b526cab3-5a3a-3f4a-a108-c1cf6e28e6c9",
