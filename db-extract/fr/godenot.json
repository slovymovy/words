                        "glosses": [
                            "Petite figurine de bois ou d'ivoire représentant un homme dont se servaient les escamoteurs pour amuser leur public."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "499dd11e-d844-4151-b21c-93267c458918",
                                "sense_id": "b4740e3b-fab8-3e78-82f9-e88c1411beee",
                                "text": "Jeu d'escamoteur qui s'appelle ainsi a cause des mots passe, passe, disparais, que le farceur adresse continuellement à son godenot."
                            }
                        ]
                    },
                    {
                        "sense_id": "8a3c44a4-8416-32cc-84fc-61812e6b60d3",
                        "entry_id": "94a98d80-abd9-366d-99fa-cedf640c33d6",
                        "glosses": [
                            "Petit homme mal fait et grotesque."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "bc058065-51fb-4eec-bf4b-81ecbfbbd8e2",
                                "sense_id": "8a3c44a4-8416-32cc-84fc-61812e6b60d3",
                                "text": "Et il disait au moyen de quelles vexations on acquérait cet esprit spécial qui fait le soldat, c'est-à-dire le godenot, se levant, marchant, s'arrêtant, se couchant, mangeant au son du clairon ou au roulement du tambour."
                            }
                        ]
