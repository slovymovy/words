        "fr-extract.jsonl": [
            {
                "entry_id": "f3585066-5760-349e-acd9-d46ecf2715ef",
                "word": "vitrification",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "aa91e6d8-62d5-4ce9-8e30-6ce8a6c73719",
                        "entry_id": "f3585066-5760-349e-acd9-d46ecf2715ef",
                        "tags": [
                            "plural"
                        ],
                        "form": "vitrifications"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "075011b8-8fc7-34ff-a009-482f35007f94",
                        "entry_id": "f3585066-5760-349e-acd9-d46ecf2715ef",
                        "glosses": [
                            "Action de vitrifier ou de se vitrifier ; état de ce qui est vitrifié."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "54ab5a2d-e488-4e37-81bf-edbcfc7309a5",
                                "sense_id": "075011b8-8fc7-34ff-a009-482f35007f94",
                                "text": "La vitrification du sable et de l’oxyde de plomb est facile à opérer."
                            }
                        ]
                    },
                    {
                        "sense_id": "b05135cd-7279-357c-850a-f4bc346320e6",
                        "entry_id": "f3585066-5760-349e-acd9-d46ecf2715ef",
                        "glosses": [
                            "Opération consistant à recouvrir un parquet d’une fine couche de plastique pour le rendre imperméable."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5e55724e-4eb8-3c19-9d28-0b2f1b38bc7e",
                        "entry_id": "f3585066-5760-349e-acd9-d46ecf2715ef",
                        "glosses": [
                            "Passage de l'état caoutchoutique à l'état vitreux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbcc57fd-9146-4274-b826-d0012743ecea",
                                "sense_id": "5e55724e-4eb8-3c19-9d28-0b2f1b38bc7e",
                                "text": "À la vitrification, la température de réaction égale la température de transition vitreuse."
                            }
                        ]
                    },
                    {
                        "sense_id": "8a89bcba-d20c-357b-a80e-06d08900e809",
                        "entry_id": "f3585066-5760-349e-acd9-d46ecf2715ef",
                        "glosses": [
                            "Processus de solidification de cellules vivantes au cours duquel celles-ci sont traitées avec des substances cryoprotectrices et sont immergées dans de l’azote liquide à une température de −,196 °C."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f07f2d20-64f9-41a4-bbce-1f3482d00f28",
                                "sense_id": "8a89bcba-d20c-357b-a80e-06d08900e809",
                                "text": "La vitrification est une congélation ultrarapide en présence de substances cryoprotectrices pour éviter la formation de microcristaux de glace dans l’ovocyte."
                            },
                            {
                                "example_id": "52d83c07-e36d-49dc-a493-32faf14c902e",
                                "sense_id": "8a89bcba-d20c-357b-a80e-06d08900e809",
                                "text": "Autorisée depuis 2011 en France dans des cas précis, de cancer par exemple, la vitrification des ovocytes présente d'indéniables atouts, mais aussi des contraintes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6fb5f7c9-f257-484f-9f8d-2a27700eccfa",
                        "source_entry_id": "f3585066-5760-349e-acd9-d46ecf2715ef",
                        "target_lang_word": "vitrification",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vitrification",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cdc29ba9-6e6f-3d3b-810e-b25abed03d65",
                                        "entry_id": "20ae2544-74f2-358a-9c2a-9e1c2b3b2c95",
                                        "glosses": [
                                            "Turning to glass or glasslike material: the action or process of vitrifying a material: conversion into an amorphous solid free of any crystalline structure by addition or removal of heat or by mixture with an additive."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1a2222e-ad76-4104-892f-aecb6cb394b7",
                                                "sense_id": "cdc29ba9-6e6f-3d3b-810e-b25abed03d65",
                                                "text": "At this point overfiring begins, as is shown particularly by the volume curve, which indicates decided bloating, so that at 1450°C the clay has about the same volume it had at 1050°C before vitrification took place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a61f507-cf2d-3a0c-b2e4-f5980b19226c",
                                        "entry_id": "20ae2544-74f2-358a-9c2a-9e1c2b3b2c95",
                                        "glosses": [
                                            "An instance of such conversion."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bacdffb4-aa69-3837-be5b-159f375b40f4",
                                        "entry_id": "20ae2544-74f2-358a-9c2a-9e1c2b3b2c95",
                                        "glosses": [
                                            "The result of such conversion: a vitrified substance or object."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
