                                "sense_id": "c6ee85f5-9007-32fc-bc66-4584e43a323a",
                                "text": "Wir sind froh, Herrn Dr. Müller als Korreferenten gewonnen zu haben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f80bd1da-107d-32a9-b2ab-3c0ba8e4c481",
