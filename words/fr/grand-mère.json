            "senses": [
                {
                    "sense_id": "e0548921-b6bc-3bdd-81c1-ef4253fb7393",
                    "sense_definition": "Mère du père ou de la mère d'une personne.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "famille",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ma <w>grand-mère</w> prépare toujours un délicieux gâteau au chocolat quand nous venons la voir."
                        },
                        {
                            "text": "Le dimanche midi, toute la famille se réunit chez ma <w>grand-mère</w> maternelle."
                        }
                    ],
                    "synonyms": [
                        "aïeule",
                        "grand-maman",
                        "mamie",
                        "mémé"
                    ],
                    "common_phrases": [
                        "grand-mère maternelle",
                        "grand-mère paternelle",
                        "recette de grand-mère",
                        "remède de grand-mère"
                    ]
                },
                {
                    "sense_id": "b353ead8-229e-3188-97bf-94596437c5db",
                    "sense_definition": "Femmes des générations précédentes qui ont précédé l'époque actuelle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ancêtres",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nos <w>grands-mères</w> connaissaient les vertus de nombreuses plantes médicinales pour soigner les maux du quotidien."
                        },
                        {
                            "text": "Les conditions de vie de nos <w>grands-mères</w> étaient souvent bien plus rudes que les nôtres."
                        }
                    ],
                    "synonyms": [
                        "aïeule"
                    ],
                    "common_phrases": [
                        "nos grands-mères"
                    ]
                },
                {
                    "sense_id": "b9073680-9907-3f35-8f01-664cee416456",
                    "sense_definition": "Femme d'un âge très avancé.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vieillesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une gentille <w>grand-mère</w> aux cheveux blancs nourrissait les oiseaux sur le banc du parc."
                        },
                        {
                            "text": "Le temps a passé et elle est devenue une <w>grand-mère</w> pleine de sagesse."
                        }
                    ]
                },
                {
                    "sense_id": "404f28fd-7aac-35cc-943e-ac52acbc3313",
                    "sense_definition": "Aïeule porteuse d'une mémoire ou d'une tradition collective.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "memoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle était considérée comme la <w>grand-mère</w> protectrice et la gardienne des coutumes de tout le village."
                        },
                        {
                            "text": "Cette conteuse respectée reste la <w>grand-mère</w> des légendes transmises depuis des générations."
                        }
                    ],
                    "synonyms": [
                        "aïeule"
                    ],
                    "traits": [
