                ],
                "senses": [
                    {
                        "sense_id": "a8ac6417-f534-3ca2-b87a-cc40cfdae3f3",
                        "entry_id": "32ce6ae8-c7fe-3bb8-8ef3-0536c134da78",
                        "glosses": [
                            "Haltestelle einer Bahn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "680aee1b-64b6-4b28-9641-bd9199c7872d",
                                "sense_id": "a8ac6417-f534-3ca2-b87a-cc40cfdae3f3",
                                "text": "„Als er eines Tages aus dem gerade wieder beginnenden Gymnasium den Weg zur Bahnstation ging, blieb er vor einer Litfaßsäule stehen.“"
                            },
                            {
                                "example_id": "db3df133-fbcd-4238-97a2-20e7ab866a74",
                                "sense_id": "a8ac6417-f534-3ca2-b87a-cc40cfdae3f3",
                                "text": "„Von einer Bahnstation sind wir zurückgeschickt worden.“"
                            },
                            {
                                "example_id": "55a4d179-d6c2-4874-bd89-2ec493c5ff92",
                                "sense_id": "a8ac6417-f534-3ca2-b87a-cc40cfdae3f3",
                                "text": "„Gustav würde sie bis zur Bahnstation bringen, von wo sie mit dem Zug zum Flughafen fahren konnten.“"
                            },
                            {
                                "example_id": "e2f14c79-d538-454d-8e23-184b052eae18",
                                "sense_id": "a8ac6417-f534-3ca2-b87a-cc40cfdae3f3",
                                "text": "„Dann gingen beide den Weg zur Bahnstation hinunter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
