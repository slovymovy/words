        "fr-extract.jsonl": [
            {
                "entry_id": "42caa8f4-3da4-33de-80a4-29dc2c0f7556",
                "word": "jardinage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dbdd3f68-0ca9-4e2c-bcc5-8d076fcfbf1b",
                        "entry_id": "42caa8f4-3da4-33de-80a4-29dc2c0f7556",
                        "tags": [
                            "plural"
                        ],
                        "form": "jardinages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0b6c7a00-7cdd-3073-ab62-4683933f76ef",
                        "entry_id": "42caa8f4-3da4-33de-80a4-29dc2c0f7556",
                        "glosses": [
                            "Art de cultiver les jardins, ou travail que l’on fait aux jardins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af49bf90-285d-4c16-b118-e6f70213468e",
                                "sense_id": "0b6c7a00-7cdd-3073-ab62-4683933f76ef",
                                "text": "Il ne prenait ni café ni liqueurs, et le seul exercice auquel il se livrât, était celui qu’exige le jardinage."
                            },
                            {
                                "example_id": "5473dc4c-e336-45b5-bed5-b67be6c31064",
                                "sense_id": "0b6c7a00-7cdd-3073-ab62-4683933f76ef",
                                "text": "Ainsi l’engagement dans le jardinage ne procéderait ni d’un penchant naturel, ni d’une contrainte surnaturelle, mais bien d’une obligation sociale."
                            },
                            {
                                "example_id": "5b206a93-15d1-4b4d-9bef-fe1ea4f7ccdc",
                                "sense_id": "0b6c7a00-7cdd-3073-ab62-4683933f76ef",
                                "text": "Jeudi 30 juin, les élèves de grande section et CP ont expliqué aux délégués de l’Éducation nationale (DDEN) leur projet de jardinage mené depuis la rentrée de septembre, sur deux espaces, l’un dans les bacs de la cour d’école, l’autre à la sortie du village sur un terrain attribué par la municipalité."
                            }
                        ]
                    },
                    {
                        "sense_id": "b2f8fe3e-dfba-3c42-82a0-4a48e84f97c3",
                        "entry_id": "42caa8f4-3da4-33de-80a4-29dc2c0f7556",
                        "glosses": [
                            "État d’un terrain qui est cultivé en jardins."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "a193db6b-0e53-4bf4-9ba2-5c8c77d763ea",
                                "sense_id": "b2f8fe3e-dfba-3c42-82a0-4a48e84f97c3",
                                "text": "Une partie de cette plaine est en grande culture, l’autre en jardinage."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4056644-fb58-4331-a64b-02427ee0e3a1",
                        "source_entry_id": "42caa8f4-3da4-33de-80a4-29dc2c0f7556",
                        "target_lang_word": "gardening",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gardening",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "32f14d10-75c9-3a29-800f-46cff7eff49d",
                                        "entry_id": "1acca92b-6848-35df-bd88-185a0ec6c1ab",
                                        "glosses": [
                                            "The process or action of cultivating the soil, particularly in a garden; the care of a garden; horticulture."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8f7451d-cf07-4b9f-9f1c-eb19f19450fb",
                                                "sense_id": "32f14d10-75c9-3a29-800f-46cff7eff49d",
                                                "text": "His hobby was gardening."
                                            },
                                            {
                                                "example_id": "c53eb914-ed53-4df3-a4df-184844341e19",
                                                "sense_id": "32f14d10-75c9-3a29-800f-46cff7eff49d",
                                                "text": "Gardening, then, is a sort of refined farming upon a limited scale."
                                            },
                                            {
                                                "example_id": "88539c15-887f-4752-8c2a-23f4cda4a0e4",
                                                "sense_id": "32f14d10-75c9-3a29-800f-46cff7eff49d",
                                                "text": "Warm ambient air, loiterings abroad, gardenings, flowers to take about, and preserves to make, soothed the wicked imp to slumber in the parish of Hollingford in summer-time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aae06d63-3c34-3c67-854e-6508e176627f",
                                        "entry_id": "1acca92b-6848-35df-bd88-185a0ec6c1ab",
                                        "glosses": [
                                            "Any process of care, maintenance, or curation, especially digitally."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d4941ad-5c0f-47bc-826d-e94aea1b6058",
