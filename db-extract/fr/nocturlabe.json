                                        "entry_id": "da445faf-93d9-36ba-ad61-f624d74e3de6",
                                        "glosses": [
                                            "A person or creature that is active at night."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1bf99da1-691f-3d13-87d0-1d93051443ff",
                                        "entry_id": "da445faf-93d9-36ba-ad61-f624d74e3de6",
                                        "glosses": [
                                            "A device for telling the time at night, rather like a sundial but read according to the stars."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "277f552e-8276-4d05-837d-440aaf07256c",
                                                "sense_id": "1bf99da1-691f-3d13-87d0-1d93051443ff",
                                                "text": "A rather different instrument was the nocturnal: it enabled you to tell the time at night, provided you knew the date, from the position of the stars in the constellation of the Great Bear, which rotate around the Pole Star."
                                            }
                                        ]
                                    }
                                ]
