                "senses": [
                    {
                        "sense_id": "29d3fc60-3e5d-32b1-a33c-8bbaaf44f58a",
                        "entry_id": "efae9e14-269e-3ae2-9a85-37f7faa44d10",
                        "glosses": [
                            "Variante orthographique de épaufrer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bc9ce1d-324e-4853-87bb-ddb6bd13d581",
                                "sense_id": "29d3fc60-3e5d-32b1-a33c-8bbaaf44f58a",
                                "text": "Si nous bandons des arcs […] venant pénétrer dans les murs, […] il y a lieu de croire que nous exercerons une telle poussée […] que le mur bouclera en dehors, car la résistance de frottement du lit […] ne sera pas suffisante pour empêcher un glissement ; s’il n’y a pas de glissement, la longueur […] n’est pas telle que le lit ne puisse s’ouvrir en dehors et s’épauffrer en dedans, […] effet qui produira le bouclement du mur et, par suite, la chute des arcs."
                            },
                            {
                                "example_id": "1ce995cb-6036-4793-ba1b-f19ce5359c16",
                                "sense_id": "29d3fc60-3e5d-32b1-a33c-8bbaaf44f58a",
                                "text": "Si les pierres vieilles sont épauffrées par le temps sur leurs arêtes, les joints en mortier ne devront pas couvrir ces épauffrures, mais les laisser visibles et ne remplir que l’intervalle entre les pierres."
                            }
                        ]
                    }
