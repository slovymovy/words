                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Espresso",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d117ead2-fe0a-3b44-bd43-6ba06d4b3d14",
                                        "entry_id": "9f94edc2-c707-3f18-90ea-2de96cd75f71",
                                        "glosses": [
                                            "starker Kaffee, der mit hohem Wasserdruck und fein gemahlenen, dunkel gerösteten Kaffeebohnen gebraut wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89d7e851-5090-49f5-b94b-1ea7bf18b878",
                                                "sense_id": "d117ead2-fe0a-3b44-bd43-6ba06d4b3d14",
                                                "text": "Ich liebe es, nach der Arbeit mit meiner besten Freundin einen guten Espresso zu trinken und zu quatschen."
                                            },
                                            {
                                                "example_id": "10a71842-2fbb-4886-8938-f90f184bf729",
                                                "sense_id": "d117ead2-fe0a-3b44-bd43-6ba06d4b3d14",
                                                "text": "Espresso wird meist in kleinen Tassen serviert."
                                            },
                                            {
                                                "example_id": "365a8887-c7aa-4fef-90de-4d4d3c25c045",
                                                "sense_id": "d117ead2-fe0a-3b44-bd43-6ba06d4b3d14",
                                                "text": "„Ich ziehe die Schuhe erst gar nicht aus, mache mir einen Espresso und fahre den Computer hoch.“"
                                            },
                                            {
                                                "example_id": "5dd3f6f5-39b2-4006-a706-297641939145",
                                                "sense_id": "d117ead2-fe0a-3b44-bd43-6ba06d4b3d14",
                                                "text": "„Wir sind schwer beeindruckt und bestellen zwei Espressi, setzen uns vor den Laden und sehen einzelne Touristen, Pärchen und Familien vorüberziehen.“"
                                            },
                                            {
                                                "example_id": "abeeccfc-ae66-407a-99e5-73b1881f401f",
                                                "sense_id": "d117ead2-fe0a-3b44-bd43-6ba06d4b3d14",
                                                "text": "„Beinah jeden Tag hatten wir in dem Café beim Pantheon unseren Espresso getrunken und dort einen Händler mit seinem Bauchladen kennengelernt.“"
                                            },
                                            {
                                                "example_id": "5422eaaf-e4bd-4ad8-ba05-65740cd9e9a0",
                                                "sense_id": "d117ead2-fe0a-3b44-bd43-6ba06d4b3d14",
                                                "text": "„Der Ober brachte den Espresso mit einem großen Glas Wasser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
