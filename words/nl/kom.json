                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "come",
                                "target_lang_sense_clarification": "imperative command"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "приходи",
                                "target_lang_sense_clarification": "повелительная форма"
                            },
                            {
                                "target_lang_word": "иди",
                                "target_lang_sense_clarification": "призыв к движению"
                            },
                            {
                                "target_lang_word": "давай",
                                "target_lang_sense_clarification": "в побудительных фразах типа 'kom op'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81be6b2f-6016-323c-ab03-3c340282435c",
                    "sense_definition": "tweede persoon enkelvoud tegenwoordige tijd van <w>komen</w> bij inversie",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Kom</w> je vanavond ook naar het feestje van Sarah?",
                            "target_lang_translations": {
                                "en": "Are you <w>coming</w> to Sarah's party tonight too?",
                                "ru": "Ты тоже <w>придешь</w> сегодня вечером на вечеринку к Саре?"
                            }
                        },
                        {
                            "text": "Waar <w>kom</w> je vandaan als ik vragen mag?",
                            "target_lang_translations": {
                                "en": "Where do you <w>come</w> from, if I may ask?",
                                "ru": "Откуда ты <w>родом</w>, если можно спросить?"
                            }
                        }
                    ],
                    "common_phrases": [
