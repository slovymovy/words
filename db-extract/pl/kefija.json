                    {
                        "sense_id": "a984ef64-607c-3d53-8846-30f46be39595",
                        "entry_id": "6f597194-4763-3177-9a29-016e82b9d3ac",
                        "glosses": [
                            "tradycyjne arabska chusta noszona jako nakrycie głowy"
                        ],
