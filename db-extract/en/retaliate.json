                                    {
                                        "sense_id": "b33e6c10-7381-39c1-8f78-65ddc1b38c84",
                                        "entry_id": "55b7dd93-4fb1-3e49-b232-08d9f93dda35",
                                        "glosses": [
                                            "Répondre, repartir vivement et sur-le-champ pour repousser quelque raillerie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f61d11da-755f-4922-b5f5-a5931b9ad732",
                                                "sense_id": "b33e6c10-7381-39c1-8f78-65ddc1b38c84",
                                                "text": "À qui prendrait à son compte le mot de M de Boureuille je riposterais que le talent, pour un chef, c'est de modérer les impétuosités des jeunes hommes en les admonestant doucement, sans les décourager par des paroles de glace."
                                            },
                                            {
                                                "example_id": "d1e45f65-a6cb-4540-8257-2448e63dd281",
                                                "sense_id": "b33e6c10-7381-39c1-8f78-65ddc1b38c84",
                                                "text": "Il lui riposta quelque chose qui le fit taire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb50e7f2-bcf6-3e1c-872d-cf7ce678e56d",
                                        "entry_id": "55b7dd93-4fb1-3e49-b232-08d9f93dda35",
                                        "glosses": [
                                            "Répondre vivement à une injure, à un coup, à un acte quelconque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f78965ed-5d7f-49ae-aebf-aa82c5b1b7e9",
                                                "sense_id": "fb50e7f2-bcf6-3e1c-872d-cf7ce678e56d",
                                                "text": "Si on me tire dessus, je riposte."
                                            },
                                            {
                                                "example_id": "0a33f8c9-bff7-4239-a8a7-993fa50d1963",
                                                "sense_id": "fb50e7f2-bcf6-3e1c-872d-cf7ce678e56d",
                                                "text": "Les torgnoles aplatissent au mur tout ce qui ne peut pas se défendre et riposter: enfants, chiens ou chats."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3493295c-aebe-3cf4-8a38-a715b903dc7a",
                                        "entry_id": "55b7dd93-4fb1-3e49-b232-08d9f93dda35",
                                        "glosses": [
                                            "Parer et porter la botte du même mouvement."
                                        ],
