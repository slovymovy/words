                        "source_entry_id": "95e35949-181a-382f-b282-196c72784474",
                        "source_sense_id": "5a45fa4e-11b0-3c24-ae87-b4cd16bd0f78",
                        "source_sense_description": "in a dismissive manner",
                        "target_lang_word": "herablassend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "herablassend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "42eff82c-ef1d-36be-8905-635581d850aa",
                                        "entry_id": "ac2cf83d-d941-3023-833f-01c4d32c538c",
                                        "glosses": [
                                            "betont gnädig, seinen vermeintlich oder tatsächlich höheren Rang herausstellend"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "328b2bb6-61c5-42d0-816e-3b822c2d8b81",
                                                "sense_id": "42eff82c-ef1d-36be-8905-635581d850aa",
                                                "text": "Mit seiner herablassenden Art machte sich Klaus bei allen Mitschülern äußerst unbeliebt."
                                            },
                                            {
                                                "example_id": "a6fb4cc5-230c-4ca9-af28-5e5a9ed85dbf",
                                                "sense_id": "42eff82c-ef1d-36be-8905-635581d850aa",
                                                "text": "„Als Anna im edlen Restaurant und in der Patisserie im 1. Bezirk arbeitete, da fühlte sie, wie es ist, wenn die feinen Damen der Gesellschaft einen herablassend behandeln – ‚sie wussten ja nicht, dass ich eine Gymnasiastin bin‘.“"
                                            },
                                            {
                                                "example_id": "3006e44c-07bc-4c4b-9d89-8c9a8631bc2b",
                                                "sense_id": "42eff82c-ef1d-36be-8905-635581d850aa",
                                                "text": "„Gegenseitige Toleranz ist die Basis des Zusammenlebens, unabhängig davon, ob diese Toleranz sich als gegenseitiger Respekt, als herablassende Duldung oder gar als Ignoranz der Anderen ausdrückt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fea83bd8-4e43-3e51-b0ae-feb5508bdaec",
                                        "entry_id": "ac2cf83d-d941-3023-833f-01c4d32c538c",
                                        "glosses": [
                                            "sich respektvoll auf jemanden von geringerem Stand einlassend"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da0e9de7-95e0-48c5-87c7-facda4375279",
                                                "sense_id": "fea83bd8-4e43-3e51-b0ae-feb5508bdaec",
                                                "text": "„Ludwig Viktor ist den Salzburgern auch seines herablassenden Wesens halber eine beliebte Persönlichkeit.“"
                                            },
                                            {
                                                "example_id": "2696ccc4-60e8-447a-8a7c-c4dbe4774c42",
                                                "sense_id": "fea83bd8-4e43-3e51-b0ae-feb5508bdaec",
                                                "text": "„Der Baron Siegmund von Auffenberg war von München zurückgekehrt, wo er eine Konferenz mit dem Minister gehabt hatte. Er hatte außerdem mit vielen andern Leuten gesprochen und sich beständig herablassend, jovial und witzig gezeigt, denn seine Liebenswürdigkeit im Umgang war beinahe sprichwörtlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
