{
    "word_family": [],
    "entries": [
        {
            "pos": "determiner",
            "senses": [
                {
                    "sense_id": "3f8150e3-8bbb-32ea-aaea-d0483a3749d1",
                    "sense_definition": "Every one of two or more people or things, considered separately.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "distribution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please make sure you wash <w>each</w> bowl well before putting it away.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, убедитесь, что вы хорошо вымыли <w>каждую</w> миску, прежде чем убрать её."
                            }
                        },
                        {
                            "text": "The sun comes up <w>each</w> morning and sets <w>each</w> night without fail.",
                            "target_lang_translations": {
                                "ru": "Солнце встает <w>каждое</w> утро и заходит <w>каждую</w> ночь без исключения."
                            }
                        }
                    ],
                    "synonyms": [
                        "every"
                    ],
                    "common_phrases": [
                        "each morning",
                        "each night",
                        "each time"
                    ],
                    "target_lang_definitions": {
                        "ru": "Каждый из двух или более людей или предметов, рассматриваемый по отдельности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "каждый",
                                "target_lang_sense_clarification": "любой из группы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "19e12767-85bf-3f9c-a80a-789040e1cf37",
                    "sense_definition": "Every person or thing in a group, used to refer to them individually.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "distribution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am going to give <w>each</w> of you a chance to win the prize.",
                            "target_lang_translations": {
                                "ru": "Я собираюсь дать <w>каждому</w> из вас шанс выиграть приз."
                            }
                        },
                        {
                            "text": "There were five students and <w>each</w> of them received a certificate.",
                            "target_lang_translations": {
                                "ru": "Было пять студентов, и <w>каждый</w> из них получил сертификат."
                            }
                        }
                    ],
                    "synonyms": [
                        "everyone",
                        "each one"
                    ],
                    "common_phrases": [
                        "each of us",
                        "each of them",
                        "to each his own"
                    ],
                    "target_lang_definitions": {
                        "ru": "Каждый человек или предмет в группе, используемый для индивидуального обращения к ним."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "каждый",
                                "target_lang_sense_clarification": "каждый в отдельности"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ee69d198-1429-38f2-84ee-823558737f36",
                    "sense_definition": "For every one; for each person or thing; apiece.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "distribution_adv",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fresh red apples cost fifty cents <w>each</w> at the market.",
                            "target_lang_translations": {
                                "ru": "Свежие красные яблоки на рынке стоят по пятьдесят центов <w>за штуку</w>."
                            }
                        },
                        {
                            "text": "We have five dollars <w>each</w> so we can afford the tickets.",
                            "target_lang_translations": {
                                "ru": "У нас есть по пять долларов <w>на каждого</w>, так что мы можем позволить себе билеты."
                            }
                        }
                    ],
                    "synonyms": [
                        "apiece",
                        "per",
                        "individually"
                    ],
                    "common_phrases": [
                        "five dollars each",
                        "one each"
                    ],
                    "target_lang_definitions": {
                        "ru": "За каждого; за каждого человека или предмет; поштучно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "за штуку",
                                "target_lang_sense_clarification": "цена за единицу"
                            },
                            {
                                "target_lang_word": "на каждого",
                                "target_lang_sense_clarification": "на человека"
                            },
                            {
                                "target_lang_word": "каждый",
                                "target_lang_sense_clarification": "по отдельности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26586dd7-1538-38a8-a7c9-57cee694d739",
                    "sense_definition": "Used with a plural subject to show that an action applies to every member of a group individually.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "distribution_adv",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You are <w>each</w> right in a different way regarding this situation.",
                            "target_lang_translations": {
                                "ru": "Вы <w>каждый</w> по-своему правы в этой ситуации."
                            }
                        },
                        {
                            "text": "The luxury apartments <w>each</w> boast central heating and private balconies.",
                            "target_lang_translations": {
                                "ru": "Роскошные апартаменты <w>каждые</w> в отдельности могут похвастаться центральным отоплением и частными балконами."
                            }
                        }
                    ],
                    "synonyms": [
                        "separately",
                        "individually"
                    ],
                    "antonyms": [
                        "collectively",
                        "together"
                    ],
                    "common_phrases": [
                        "we each have",
                        "they each want"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется с подлежащим во множественном числе, чтобы показать, что действие относится к каждому члену группы индивидуально."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "каждый",
                                "target_lang_sense_clarification": "индивидуально в группе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5053d4e5-836c-3b5e-8269-3d3e5816744e",
                    "sense_definition": "A single individual item; the smallest unit in a group or shipment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "unit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is an additional charge when ordering products as an <w>each</w>.",
                            "target_lang_translations": {
                                "ru": "При заказе товаров поштучно как отдельную <w>единицу</w> взимается дополнительная плата."
                            }
                        },
                        {
                            "text": "The warehouse worker counted every <w>each</w> to ensure the inventory was correct.",
                            "target_lang_translations": {
                                "ru": "Работник склада пересчитал каждую <w>штуку</w>, чтобы убедиться в правильности инвентаризации."
                            }
                        }
                    ],
                    "synonyms": [
                        "unit",
                        "item",
                        "piece"
                    ],
                    "antonyms": [
                        "case",
                        "batch",
                        "lot"
                    ],
                    "common_phrases": [
                        "as an each",
                        "price per each"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used primarily in logistics and retail contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельный предмет; наименьшая единица в группе или партии товара."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "единица товара",
                                "target_lang_sense_clarification": "в логистике"
                            },
                            {
                                "target_lang_word": "штука",
                                "target_lang_sense_clarification": "отдельный предмет"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}