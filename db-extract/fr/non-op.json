        "fr-extract.jsonl": [
            {
                "entry_id": "65eb6a3d-1d0d-3811-bf91-6538ec7619d1",
                "word": "non-op",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1f7123f4-8fc6-34b4-99dd-7e174ef0586c",
                        "entry_id": "65eb6a3d-1d0d-3811-bf91-6538ec7619d1",
                        "glosses": [
                            "Personne trans qui n’a pas subi d’opération de réattribution sexuelle."
                        ],
                        "tags": [
                            "Transitude"
                        ],
                        "examples": [
                            {
                                "example_id": "9474b5ef-1051-45f6-9479-fb683a299ebf",
                                "sense_id": "1f7123f4-8fc6-34b4-99dd-7e174ef0586c",
                                "text": "Parmi les points qui ont alimenté la discussion, celui du statut de cette trans non op’ qui n’est rien de moins qu’une tueuse à gage."
                            },
                            {
                                "example_id": "a4e40e11-a425-4125-88bb-bde53c079728",
                                "sense_id": "1f7123f4-8fc6-34b4-99dd-7e174ef0586c",
                                "text": "Je suis encore plus surprise que des MtF (non-op) fétichisent l'opération vaginale !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13635a3a-0dd1-4e1e-a0be-f5c6543bf73a",
                        "source_entry_id": "65eb6a3d-1d0d-3811-bf91-6538ec7619d1",
                        "source_sense_id": "1f7123f4-8fc6-34b4-99dd-7e174ef0586c",
                        "target_lang_word": "non-op",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "non-op",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40be8496-d4f8-38b4-ba56-825fef1edf78",
                                        "entry_id": "bda4a786-f6aa-3220-88bb-00d3ca8c91b8",
                                        "glosses": [
                                            "Nonoperational; not functioning."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91703621-8320-48fb-adec-d0053b88e73d",
                                                "sense_id": "40be8496-d4f8-38b4-ba56-825fef1edf78",
                                                "text": "Why he had taken refuge in the chapel, he didn't know. His mind had been non-op for a long time now and he just let the impulses flow."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39cfb1c0-61a2-35e2-899a-f4a0722e4872",
                                        "entry_id": "bda4a786-f6aa-3220-88bb-00d3ca8c91b8",
                                        "glosses": [
                                            "Nonoperative; not using or requiring surgical treatment."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03ed3ccc-1946-4fa7-aff0-5770aeb1131d",
                                                "sense_id": "39cfb1c0-61a2-35e2-899a-f4a0722e4872",
                                                "text": "Richt says the surgery should help speed Samuel's recovery.\n\"It was debatable on whether it could have been non-op or not, but this will absolutely stabilize it immediately and allow him to get stronger quicker,\" Richt said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6657f2f-db1b-3c0b-a31b-0297beb87fde",
                                        "entry_id": "bda4a786-f6aa-3220-88bb-00d3ca8c91b8",
                                        "glosses": [
                                            "Having chosen not to undergo sex reassignment surgery."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad0d5b76-0916-4734-bccb-37fb6f6b8e79",
                                                "sense_id": "c6657f2f-db1b-3c0b-a31b-0297beb87fde",
                                                "text": "\"Just so you know, Vincent, I was a pre-op transsexual. But after my breasts grew and my hips got wider, I was happy with what I had and decided to go non-op.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad47a44d-d360-353d-a175-c08223bcb3ff",
                                        "entry_id": "bda4a786-f6aa-3220-88bb-00d3ca8c91b8",
                                        "glosses": [
                                            "Nonoperating; not directly involved in the mechanical operation of trains."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39571007-2459-4b14-83a7-da15c2129941",
                                                "sense_id": "ad47a44d-d360-353d-a175-c08223bcb3ff",
                                                "text": "About 200000 \"non-op\" workers - clerks, telegraphers, machinists, and others not actually involved in operation of the roads - are not union members."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "non-op",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27d5c148-2c2f-3d56-a642-ac9bbc634d38",
                                        "entry_id": "13aa0b4f-8292-3997-865b-72d9a0eb73e9",
                                        "glosses": [
                                            "A transsexual or transgender person who has chosen not to undergo sex reassignment surgery."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb815ab0-2d7e-4f96-89a9-6bb6d4ce23bc",
                                                "sense_id": "27d5c148-2c2f-3d56-a642-ac9bbc634d38",
                                                "text": "It is interesting that Galatea makes reference to some encouragement from \"post-op\" transsexuals, though other \"non-ops\" advise surgical candidates to reconsider their decision."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be9a8181-bc2e-3ca3-b2dc-09cb1759365d",
                                        "entry_id": "13aa0b4f-8292-3997-865b-72d9a0eb73e9",
                                        "glosses": [
                                            "A nonoperator; a rail worker not directly involved in the mechanical operation of trains."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e01a75c9-e528-457b-88a9-aca806199f6e",
                                                "sense_id": "be9a8181-bc2e-3ca3-b2dc-09cb1759365d",
                                                "text": "For example, in the fall of 1973, when we had a rail strike, the government brought in legislation putting the non-ops back to work at an increase of only 30 cents an hour […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
                        "linkage_id": "6eca6a62-3c9d-4594-9854-0b3b1114c75a",
