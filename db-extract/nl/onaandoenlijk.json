                                        "sense_id": "eb1ab15a-b3c5-3a30-9905-a6262f78c951",
                                        "entry_id": "84e974f6-87d3-3536-b5e8-1c13d3081488",
                                        "glosses": [
                                            "Having, or revealing, no emotion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d6176f9-6ac3-4934-9da6-ea0487cc60df",
                                                "sense_id": "eb1ab15a-b3c5-3a30-9905-a6262f78c951",
                                                "text": "It was a victory that clearly meant so much to Van Gaal as the normally impassive manager raced from his seat in the technical area to celebrate Lingard's winner."
                                            }
                                        ]
