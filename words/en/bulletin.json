{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c6b4ad78-823e-3d65-938c-16f4a0f408be",
                    "sense_definition": "A short news report on radio or television, often about important or breaking events.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We interrupted the music for a special news <w>bulletin</w>.",
                            "target_lang_translations": {
                                "ru": "Мы прервали музыку ради экстренного <w>выпуска новостей</w>.",
                                "zh": "我们中断了音乐，插播了一条特别<w>新闻简报</w>。",
                                "es": "Interrumpimos la música para un <w>boletín</w> informativo especial."
                            }
                        },
                        {
                            "text": "The latest <w>bulletin</w> says the storm is moving north.",
                            "target_lang_translations": {
                                "ru": "В последней <w>сводке</w> говорится, что шторм движется на север.",
                                "zh": "最新的<w>快讯</w>称风暴正在向北移动。",
                                "es": "El último <w>boletín</w> indica que la tormenta se desplaza hacia el norte."
                            }
                        }
                    ],
                    "synonyms": [
                        "newsflash",
                        "breaking news",
                        "update",
                        "report",
                        "announcement"
                    ],
                    "common_phrases": [
                        "news bulletin",
                        "weather bulletin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Краткое новостное сообщение по радио или телевидению, часто о важных или срочных событиях.",
                        "zh": "广播或电视上的简短新闻报道，通常关于重要或突发事件。",
                        "es": "Un breve informe de noticias en radio o televisión, a menudo sobre eventos importantes o de última hora."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сводка новостей",
                                "target_lang_sense_clarification": "краткий обзор событий"
                            },
                            {
                                "target_lang_word": "информационное сообщение",
                                "target_lang_sense_clarification": "новостной отчет"
                            },
                            {
                                "target_lang_word": "бюллетень",
                                "target_lang_sense_clarification": "официальное сообщение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "新闻简报",
                                "target_lang_sense_clarification": "广播或电视上的简短新闻"
                            },
                            {
                                "target_lang_word": "快讯",
                                "target_lang_sense_clarification": "突发新闻报道"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "boletín informativo",
                                "target_lang_sense_clarification": "informe breve de noticias"
                            },
                            {
                                "target_lang_word": "noticiero",
                                "target_lang_sense_clarification": "programa de radio o televisión con noticias"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b53b141a-f585-3f36-b20f-076d2bde0f94",
                    "sense_definition": "An official statement or report issued by an organization to inform the public or members about something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctors released a <w>bulletin</w> regarding the president's health.",
                            "target_lang_translations": {
                                "ru": "Врачи выпустили <w>бюллетень</w> о состоянии здоровья президента.",
                                "zh": "医生们发布了一份关于总统健康的<w>公报</w>。",
                                "es": "Los médicos emitieron un <w>boletín</w> sobre la salud del presidente."
                            }
                        },
                        {
                            "text": "Please read the company <w>bulletin</w> for details on the new policy.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, прочитайте корпоративный <w>бюллетень</w>, чтобы узнать подробности о новой политике.",
                                "zh": "请阅读公司<w>公告</w>以了解新政策的详情。",
                                "es": "Por favor, lea el <w>boletín</w> de la empresa para conocer los detalles de la nueva política."
                            }
                        }
                    ],
                    "synonyms": [
                        "alert"
                    ],
                    "common_phrases": [
                        "official bulletin",
                        "medical bulletin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное заявление или отчет, выпущенный организацией для информирования общественности или сотрудников.",
                        "zh": "组织机构为通知公众或成员而发布的正式声明或报告。",
                        "es": "Una declaración o informe oficial emitido por una organización para informar al público o a sus miembros sobre algo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бюллетень",
                                "target_lang_sense_clarification": "официальный документ"
                            },
                            {
                                "target_lang_word": "официальное сообщение",
                                "target_lang_sense_clarification": "заявление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "公告",
                                "target_lang_sense_clarification": "正式发布的通知"
                            },
                            {
                                "target_lang_word": "公报",
                                "target_lang_sense_clarification": "正式的官方报告"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "boletín",
                                "target_lang_sense_clarification": "comunicado oficial"
                            },
                            {
                                "target_lang_word": "comunicado",
                                "target_lang_sense_clarification": "declaración pública oficial"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28253c1f-fa2f-394e-83e7-a9d834092583",
                    "sense_definition": "A small magazine or newsletter published regularly by a club, society, or organization.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The society publishes a monthly <w>bulletin</w> for its members.",
                            "target_lang_translations": {
                                "ru": "Общество издает ежемесячный <w>бюллетень</w> для своих членов.",
                                "zh": "该协会每月为会员出版一份<w>通讯</w>。",
                                "es": "La sociedad publica un <w>boletín</w> mensual para sus miembros."
                            }
                        },
                        {
                            "text": "I saw the announcement in the church <w>bulletin</w>.",
                            "target_lang_translations": {
                                "ru": "Я видел объявление в церковном <w>вестнике</w>.",
                                "zh": "我在教堂的<w>简报</w>里看到了那个通知。",
                                "es": "Vi el anuncio en el <w>boletín</w> de la iglesia."
                            }
                        }
                    ],
                    "synonyms": [
                        "newsletter",
                        "periodical",
                        "organ"
                    ],
                    "common_phrases": [
                        "monthly bulletin",
                        "church bulletin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой журнал или информационный листок, регулярно издаваемый клубом, обществом или организацией.",
                        "zh": "俱乐部、协会或组织定期出版的小型杂志或通讯。",
                        "es": "Una pequeña revista o boletín informativo publicado regularmente por un club, sociedad u organización."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бюллетень",
                                "target_lang_sense_clarification": "периодическое издание"
                            },
                            {
                                "target_lang_word": "вестник",
                                "target_lang_sense_clarification": "журнал или газета организации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "通讯",
                                "target_lang_sense_clarification": "组织内部的定期刊物"
                            },
                            {
                                "target_lang_word": "简报",
                                "target_lang_sense_clarification": "定期发布的信息小册子"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "boletín",
                                "target_lang_sense_clarification": "publicación periódica de una organización"
                            },
                            {
                                "target_lang_word": "revista informativa",
                                "target_lang_sense_clarification": "publicación periódica pequeña"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "04d1afd2-c987-3b7f-831c-1559f1841df1",
                    "sense_definition": "To announce or publicize something using a short official report.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The agency <w>bulletined</w> the job opening to all departments.",
                            "target_lang_translations": {
                                "ru": "Агентство <w>разослало сообщение</w> об открытой вакансии во все отделы.",
                                "zh": "该机构向所有部门<w>通报</w>了职位空缺信息。",
                                "es": "La agencia <w>difundió</w> la oferta de trabajo a todos los departamentos."
                            }
                        },
                        {
                            "text": "They <w>bulletined</w> the results of the competition immediately.",
                            "target_lang_translations": {
                                "ru": "Они немедленно <w>объявили</w> результаты соревнований.",
                                "zh": "他们立即<w>发布</w>了比赛结果。",
                                "es": "Ellos <w>publicaron</w> los resultados de la competencia de inmediato."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Объявлять или публиковать что-либо с помощью краткого официального отчета.",
                        "zh": "通过简短的正式报告来宣布或发布某事。",
                        "es": "Anunciar o publicar algo mediante un informe oficial breve."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "официально сообщать",
                                "target_lang_sense_clarification": "объявлять"
                            },
                            {
                                "target_lang_word": "публиковать",
                                "target_lang_sense_clarification": "обнародовать информацию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发布",
                                "target_lang_sense_clarification": "正式公布信息"
                            },
                            {
                                "target_lang_word": "通报",
                                "target_lang_sense_clarification": "以书面形式告知"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "publicar",
                                "target_lang_sense_clarification": "hacer público un informe"
                            },
                            {
                                "target_lang_word": "difundir",
                                "target_lang_sense_clarification": "dar a conocer información"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "622a19b1-0515-38ad-acff-6da94ab23403",
                    "sense_definition": "Used sarcastically to tell someone that they have just noticed something that is already obvious to everyone else.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You just realized he likes her? Well, <w>bulletin</w>: everyone else knew weeks ago!",
                            "target_lang_translations": {
                                "ru": "Ты только понял, что она ему нравится? Ну, <w>новость</w>: все остальные знали об этом еще несколько недель назад!",
                                "zh": "你才发现他喜欢她？真是大<w>新闻</w>：其他人几周前就知道了！",
                                "es": "¿Te acabas de dar cuenta de que ella le gusta? Bueno, <w>vaya novedad</w>: ¡todos los demás lo sabían hace semanas!"
                            }
                        },
                        {
                            "text": "Hey, <w>bulletin</w>: we are already late for the meeting.",
                            "target_lang_translations": {
                                "ru": "Эй, <w>для справки</w>: мы уже опаздываем на собрание.",
                                "zh": "嘿，给你个<w>新闻</w>：我们开会已经迟到了。",
                                "es": "Oye, <w>para tu información</w>: ya llegamos tarde a la reunión."
                            }
                        }
                    ],
                    "synonyms": [
                        "hello",
                        "newsflash"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "sarcastic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется саркастически, чтобы сказать кому-то, что он только что заметил то, что уже очевидно для всех остальных.",
                        "zh": "讽刺性用语，用于告诉某人他们刚刚才注意到别人早已知道的显而易见的事实。",
                        "es": "Se usa sarcásticamente para decirle a alguien que acaba de notar algo que ya es obvio para todos los demás."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "новость",
                                "target_lang_sense_clarification": "сарказм"
                            },
                            {
                                "target_lang_word": "для справки",
                                "target_lang_sense_clarification": "сарказм"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "新闻",
                                "target_lang_sense_clarification": "讽刺性用法，意为“这还用你说”"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "¡vaya novedad!",
                                "target_lang_sense_clarification": "expresión sarcástica"
                            },
                            {
                                "target_lang_word": "para tu información",
                                "target_lang_sense_clarification": "usado con tono irónico"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}