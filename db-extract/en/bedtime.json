                        "source_entry_id": "e615136b-bff8-3a51-9d2d-902ceaa09b3e",
                        "source_sense_id": "6253461a-3a44-30da-a4ba-5469b412d63f",
                        "source_sense_description": "time when one goes to bed to sleep",
                        "target_lang_word": "dodo",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dodo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d17a38ca-3c85-38c9-85fa-6cddda298681",
                                        "entry_id": "00d35982-cbcb-3b17-bd19-f0d63af174ef",
                                        "glosses": [
                                            "S'emploie pour demander à un enfant de dormir."
                                        ],
                                        "tags": [
                                            "childish"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c340edad-2f86-4bf2-8465-75cf9d008733",
                                                "sense_id": "d17a38ca-3c85-38c9-85fa-6cddda298681",
                                                "text": "Dodo, l’enfant do, l’enfant dormira bientôt"
                                            },
                                            {
                                                "example_id": "ced05987-4d33-4c9e-a3fe-1800a86419c5",
                                                "sense_id": "d17a38ca-3c85-38c9-85fa-6cddda298681",
                                                "text": "— Dodo, Spy, dodo, mon petit loulou !…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dodo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0cf5a185-9530-34f0-8843-9efb5ce05e5f",
                                        "entry_id": "bce2dbe5-ecc0-3ae3-993d-1a896e488de3",
                                        "glosses": [
                                            "Sommeil."
                                        ],
                                        "tags": [
                                            "childish"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fda97469-0ba0-4995-93ba-8f1f9b72c065",
                                                "sense_id": "0cf5a185-9530-34f0-8843-9efb5ce05e5f",
                                                "text": "Allez, c’est l’heure du dodo !"
                                            },
                                            {
                                                "example_id": "eddd3fc8-994e-401f-92ae-c0bd8b503e55",
                                                "sense_id": "0cf5a185-9530-34f0-8843-9efb5ce05e5f",
                                                "text": "Maintenant, il faut faire dodo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3252ae31-e377-3016-a34c-d8ed2943eee8",
                                        "entry_id": "bce2dbe5-ecc0-3ae3-993d-1a896e488de3",
                                        "glosses": [
                                            "Lit."
                                        ],
                                        "tags": [
                                            "childish"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b71989a-4221-4ae0-8340-3738646a63e5",
                                                "sense_id": "3252ae31-e377-3016-a34c-d8ed2943eee8",
                                                "text": "Il est l’heure d’aller au dodo."
                                            },
                                            {
                                                "example_id": "58aa9ffb-77be-4e1a-b8b2-150e19a491e1",
                                                "sense_id": "3252ae31-e377-3016-a34c-d8ed2943eee8",
                                                "text": "Qu’on est bien dans son dodo !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41fb109f-11cd-3b02-a1ef-0e8576ab6ff3",
                                        "entry_id": "bce2dbe5-ecc0-3ae3-993d-1a896e488de3",
                                        "glosses": [
                                            "Vêtement chaud couvrant les épaules et le buste que les femmes portaient quand elles restaient assises au lit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff51db04-7dea-42ce-af75-91a46be41f8d",
                                                "sense_id": "41fb109f-11cd-3b02-a1ef-0e8576ab6ff3",
                                                "text": "Telcide a revêtu sa toilette de malade. […] Elle a mis son « dodo » gris."
                                            },
                                            {
                                                "example_id": "cfd1997f-46f3-4213-bcc0-409acd024101",
                                                "sense_id": "41fb109f-11cd-3b02-a1ef-0e8576ab6ff3",
                                                "text": "Vous nous verrez empaqueter nos jupons de laine et de molleton, nos dodos de pilou et nos châles."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dodo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c6608942-a9b6-37c4-b5a1-92b3e9149c86",
                                        "entry_id": "d077b33f-b463-310d-9073-76f3d14ca8db",
                                        "glosses": [
                                            "Espèce d’oiseaux disparus à la fin du XVIIᵉ siècle, qui vivaient sur l’île Maurice et l’île de la Réunion dans l’océan Indien. Le dodo, victime de la surchasse et des espèces invasives introduites par les humains dans son écosystème, est emblématique des extinctions anthropogéniques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c5f5d6f-af20-422b-9a8b-967ecdd62553",
                                                "sense_id": "c6608942-a9b6-37c4-b5a1-92b3e9149c86",
                                                "text": "Lewis Carroll a fait revivre le dodo dans « Les Aventures d’Alice au pays des merveilles »."
                                            },
                                            {
                                                "example_id": "df69e698-435d-462a-83c8-be81767df648",
                                                "sense_id": "c6608942-a9b6-37c4-b5a1-92b3e9149c86",
                                                "text": "Tout le monde connaît le dodo : ce gros oiseau de la famille des pigeons est un symbole des espèces disparues dans le sillage de l’homme."
                                            },
                                            {
                                                "example_id": "f3d972c9-d717-4d74-969f-5465c0664036",
                                                "sense_id": "c6608942-a9b6-37c4-b5a1-92b3e9149c86",
                                                "text": "– Tu sais ce qu’est un dronte de Maurice ?\n– Non.\n– Plus connu sous le nom de dodo ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dodo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b6f788f5-ca39-3d63-9101-9fe08bd77f4b",
                                        "entry_id": "d22c1283-f20f-3aef-9d58-1f66f405891c",
                                        "glosses": [
                                            "Bière de la Réunion."
                                        ],
                                        "tags": [
                                            "La Réunion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0017c333-157e-4e85-8b36-289482874f4b",
                                                "sense_id": "b6f788f5-ca39-3d63-9101-9fe08bd77f4b",
                                                "text": "A la Réunion, la dodo fêtera ses 50 ans en 2012."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fcad8713-f683-4b5b-a445-9e6200aaea66",
                        "source_entry_id": "e615136b-bff8-3a51-9d2d-902ceaa09b3e",
