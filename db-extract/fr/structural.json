                "senses": [
                    {
                        "sense_id": "0d796943-5389-3a0b-8006-ed1c2113abac",
                        "entry_id": "ac23a09e-952a-35f2-b53a-e164083c1b2b",
                        "glosses": [
                            "Structurel, qui touche à la structure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "554de50e-0c09-4b8e-81d9-87557bc488b4",
                                "sense_id": "0d796943-5389-3a0b-8006-ed1c2113abac",
                                "text": "La Scolastique […] a accrédité une mentalité qui n'a pas prise sur le réel, qui tient pour légitimes certaines illusions structurales de notre esprit : notre tendance à réaliser nos concepts et à réifier toutes choses."
                            },
                            {
                                "example_id": "ec839f7b-0f67-427d-add5-8f62a6e933f8",
                                "sense_id": "0d796943-5389-3a0b-8006-ed1c2113abac",
                                "text": "Si on dispose orthogonalement entre elles deux voûtes en berceau et que l'on élimine les parties qui se trouvent en dessous de l'intersection, on obtient une nouvelle figure structurale appelée voûte d'arêtes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "623c70ee-7db5-4196-b3fc-161c2454a77a",
                        "source_entry_id": "ac23a09e-952a-35f2-b53a-e164083c1b2b",
                        "source_sense_id": "0d796943-5389-3a0b-8006-ed1c2113abac",
                        "target_lang_word": "structural",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "structural",
