                "senses": [
                    {
                        "sense_id": "ead39a03-50f1-3aa7-83d6-20de0f5777d4",
                        "entry_id": "16fd8d7a-0e3f-39ea-add6-e12d4b6d6d23",
                        "glosses": [
                            "En dessous de la vitesse du son."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ddbd041-16d7-45ce-8499-fe09b5351b37",
                                "sense_id": "ead39a03-50f1-3aa7-83d6-20de0f5777d4",
                                "text": "Le Concorde peut effectuer un aller-retour transatlantique en un peu plus de six heures. Actuellement, les caractéristiques de bruyance de cet appareil, volant à des vitesses subsoniques, sont comparables à celles d’un DC-8."
                            },
                            {
                                "example_id": "f6a040a7-8407-426c-a337-aa02ca01c265",
                                "sense_id": "ead39a03-50f1-3aa7-83d6-20de0f5777d4",
                                "text": "L’effort industriel se concentre sur l’achèvement de la configuration d’étape 2 qui implique la mise au point définitive de l’architecture des sous-systèmes spationiques, propulsion et réservoirs de stockage, l’optimisation de la disposition des volumes pressurisés et non pressurisés, l’amélioration de la forme aérodynamique pour remédier aux défauts d’équilibre hypersonique, de stabilité latérale subsonique et à certains problèmes locaux."
                            }
                        ]
                    }
                ],
