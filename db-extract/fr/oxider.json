                "senses": [
                    {
                        "sense_id": "6857ce5f-a572-3daf-96f6-2f4472d6e366",
                        "entry_id": "a3490d11-56a5-3d05-9cd8-954252f0eba4",
                        "glosses": [
                            "Ancienne orthographe de oxyder."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "1f27f7b7-d7b7-40b0-9792-8865986b96ef",
                                "sense_id": "6857ce5f-a572-3daf-96f6-2f4472d6e366",
                                "text": "Fourneaux destinés à oxider les métaux ;"
                            },
                            {
                                "example_id": "af7dedfb-8b04-4818-bc59-22d50ce52914",
                                "sense_id": "6857ce5f-a572-3daf-96f6-2f4472d6e366",
                                "text": "L’huile, en s'oxidant, se cérifie d'autant plus facilement que sa combinaison avec l'oxigène est plus grande et plus intime."
                            },
                            {
                                "example_id": "90f5071a-b5c0-4041-bd44-2f26df287674",
                                "sense_id": "6857ce5f-a572-3daf-96f6-2f4472d6e366",
                                "text": "Ces corps continuent à s’oxider, sans produire de feu, en se maintenant seulement chauds; mais lorsqu’ils viennent à être mis en contact avec de l'air plus pur, le phénomène du feu éclate sur-le-champ."
                            }
                        ]
                    }
