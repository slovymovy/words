        "ru-extract.jsonl": [
            {
                "entry_id": "0c9befde-588d-32eb-a1d4-dbcababd9aa2",
                "word": "ничего",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "599d5c8a-b438-3db8-bd53-2650a7ce78c9",
                        "entry_id": "0c9befde-588d-32eb-a1d4-dbcababd9aa2",
                        "glosses": [
                            "более-менее, сносно, довольно хорошо"
                        ],
                        "tags": [
                            "выражает умеренно положительную оценку чего-либо"
                        ],
                        "examples": [
                            {
                                "example_id": "10fd36e4-ea80-47e9-a340-f67b2ab20b65",
                                "sense_id": "599d5c8a-b438-3db8-bd53-2650a7ce78c9",
                                "text": "Жену его он видел однажды, встретил в выходной на проспекте всю семейку с маленькой дочуркой — жена так себе, ничего, не красавица, но довольно миловидная особа."
                            }
                        ]
                    },
                    {
                        "sense_id": "07c7043d-1f00-34bc-b996-2d7a660fa659",
                        "entry_id": "0c9befde-588d-32eb-a1d4-dbcababd9aa2",
                        "glosses": [
                            "предик."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f665777c-1d77-48d9-9ebe-bd7c08a32881",
                                "sense_id": "07c7043d-1f00-34bc-b996-2d7a660fa659",
                                "text": "― Здоровье-то как? ― Здоровье ничего."
                            }
                        ]
                    },
                    {
                        "sense_id": "a18020eb-47df-3d99-9891-64f5240e2e0b",
                        "entry_id": "0c9befde-588d-32eb-a1d4-dbcababd9aa2",
                        "glosses": [
                            "разг. : ладно, пускай"
                        ],
                        "tags": [
                            "частица",
                            "выражает согласие, принятие, допущение, а также оценку чего-либо как несущественного"
                        ],
                        "examples": [
                            {
                                "example_id": "0efb2531-17f8-462c-ab46-59a120473c0e",
                                "sense_id": "a18020eb-47df-3d99-9891-64f5240e2e0b",
                                "text": "Утешали его довольно своеобразно: «Ничего, Игорь, вон тебе какой свитер мама связала, его уж не украдут»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83e0dce6-754f-49de-bd52-7b693f1131b2",
                        "source_entry_id": "0c9befde-588d-32eb-a1d4-dbcababd9aa2",
                        "target_lang_word": "so-so",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "so-so",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fec88451-371f-3149-9abf-7a5ce691eb47",
                                        "entry_id": "7f46757b-2d86-339c-9426-ee7c7abd60cf",
                                        "glosses": [
                                            "Neither good nor bad; tolerable, passable, indifferent."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27d3caa4-805f-4043-a75e-2a8f8bb87d5a",
                                                "sense_id": "fec88451-371f-3149-9abf-7a5ce691eb47",
                                                "text": "The dessert was pretty good, but the meal was so-so."
                                            },
                                            {
                                                "example_id": "4ced0565-54f7-4e94-bd11-46ad16217547",
                                                "sense_id": "fec88451-371f-3149-9abf-7a5ce691eb47",
                                                "text": "[I]n ſome Iriſh Houſes, vvhere things are ſo-ſo, / One Gammon of Bacon hangs up for a ſhow; […]"
                                            },
                                            {
                                                "example_id": "e29c5847-d166-4a77-b795-593fd5d0be47",
                                                "sense_id": "fec88451-371f-3149-9abf-7a5ce691eb47",
                                                "text": "He [Robert Burns] certainly wrote some so-so verses to the Tree of Liberty."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "so-so",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5b65a422-8b43-3ebb-b89e-4fc3cf5142ae",
                                        "entry_id": "3785b25e-ca0f-3da5-922a-02556ec768a5",
                                        "glosses": [
                                            "Neither very well nor very poorly."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b3389f5-66d9-48c8-b7d3-6ad30c8281bf",
                                                "sense_id": "5b65a422-8b43-3ebb-b89e-4fc3cf5142ae",
                                                "text": "He performed so-so during the tryouts, and the coach was undecided whether to add him to the team or not."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
