                ],
                "senses": [
                    {
                        "sense_id": "d348a5ee-c825-3c9d-be70-31880e956414",
                        "entry_id": "a0e62897-148e-32f5-9184-b946dce4f1c5",
                        "glosses": [
                            "Ouvrir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9711c94-e416-4181-b1ea-0dca08b068ad",
                                "sense_id": "d348a5ee-c825-3c9d-be70-31880e956414",
                                "text": "Le souci récent de ré-ouvrir la réflexion paradigmatique ne doit pas toutefois se réduire à nouveau à une simple controverse de doctrines antagonistes de politique criminelle."
                            },
                            {
                                "example_id": "075c33ae-9cb7-4e78-9b2b-84789250e980",
                                "sense_id": "d348a5ee-c825-3c9d-be70-31880e956414",
                                "text": "La pratique psychanalytique excède ce débat, vient l’ouvrir et le ré-ouvrir en le maintenant en crise."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3549a0b8-e86e-4203-b295-9d06129140e1",
                        "source_entry_id": "a0e62897-148e-32f5-9184-b946dce4f1c5",
                        "source_sense_id": "d348a5ee-c825-3c9d-be70-31880e956414",
                        "target_lang_word": "reopen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reopen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9da070c-aa66-3815-bacb-2a29ddc260c7",
                                        "entry_id": "35c2b052-462a-378a-8d98-7293feaf4dbb",
                                        "glosses": [
                                            "To open (something) again."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee16f685-8e86-43dc-aa54-059b9c7db454",
                                                "sense_id": "f9da070c-aa66-3815-bacb-2a29ddc260c7",
                                                "text": "1920, Breckinridge Long, US Ambassador to Italy, a speech titled America's Accomplishments\nFrom the moment of the declaration by Germany, she would reopen her inhuman warfare by the indiscriminate use of submarines."
                                            },
                                            {
                                                "example_id": "266aa7df-e575-4fed-b7d6-9902744338e6",
                                                "sense_id": "f9da070c-aa66-3815-bacb-2a29ddc260c7",
                                                "text": "Says Barnes: \"The next priority [for Devon County Council] is reopening the line from Tavistock to Plymouth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02cd4463-581a-3388-b4d9-69cbf2867eb9",
                                        "entry_id": "35c2b052-462a-378a-8d98-7293feaf4dbb",
                                        "glosses": [
                                            "To open again."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89a2de87-6cd3-4b9b-a9b9-06753dc424e7",
                                                "sense_id": "02cd4463-581a-3388-b4d9-69cbf2867eb9",
                                                "text": "The new law allows the twelve Federal Reserve Banks to issue additional currency on good assets and thus the banks which reopen will be able to meet every legitimate call."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
