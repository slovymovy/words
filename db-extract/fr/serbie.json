                        "translation_id": "bbe108e4-0c76-40e4-a8e5-2da965b4c835",
                        "source_entry_id": "00690988-4eba-33de-a5fb-bbbdec99c425",
                        "source_sense_id": "2c8330d4-94e9-3e04-8a1a-d48f57769d8e",
