                ],
                "senses": [
                    {
                        "sense_id": "ca8885e3-b85c-35db-8b3c-ab27158adb84",
                        "entry_id": "be5e1990-7dd4-3ba3-8344-17f0d90e6cef",
                        "glosses": [
                            "Rendre moins souple."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76b06d03-b502-4c57-b7c0-55c4d32e6c75",
                                "sense_id": "ca8885e3-b85c-35db-8b3c-ab27158adb84",
                                "text": "L’huile empêche l’eau du sol de pénétrer, comme elle le fait, dans les cuirs les meilleurs, et de désassouplir les chaussures (ce qui paralyse, on le sait, entièrement la marche)…"
                            },
                            {
                                "example_id": "ffcbb44e-64a2-49f3-b16d-ecd2045c8397",
                                "sense_id": "ca8885e3-b85c-35db-8b3c-ab27158adb84",
                                "text": "Une fois de plus, je comprenais parfaitement qu’une espèce d’hommes voulût vivre autrement que selon les groupes et les plans, autrement que selon la multitude terne et désassouplie."
                            },
                            {
                                "example_id": "f1b3670f-ae15-4ca7-91ae-3a2c93257902",
                                "sense_id": "ca8885e3-b85c-35db-8b3c-ab27158adb84",
                                "text": "Il se désassouplit rapidement et facilement."
                            }
                        ]
                    }
                ],
