                    }
                ],
                "senses": [
                    {
                        "sense_id": "94132751-214c-3317-9a24-c7933d44ecf9",
                        "entry_id": "a511902b-f65c-398e-b056-cbf964215a0a",
                        "glosses": [
                            "Activated, as with electric power."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d7ee6f0-138c-4cdc-a619-437bcf71b343",
                                "sense_id": "94132751-214c-3317-9a24-c7933d44ecf9",
                                "text": "All four motors should be amped to check the loading on the motors before new motors are installed. The amp checks might reveal that a smaller size motor could be use"
                            },
                            {
                                "example_id": "13288c94-805f-45de-ac1f-d11de0a9f93d",
                                "sense_id": "94132751-214c-3317-9a24-c7933d44ecf9",
                                "text": "Two guitars were amped and miked, while a third space was empty and waiting for Kellan's guitar."
                            }
                        ]
                    },
                    {
                        "sense_id": "aeb3a86e-6be3-344c-9a3a-c20b44a8b047",
                        "entry_id": "a511902b-f65c-398e-b056-cbf964215a0a",
                        "glosses": [
                            "Excited or full of energy, especially to excess."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "23c59afa-a66d-49aa-a6b7-78ab1be0efd0",
                                "sense_id": "aeb3a86e-6be3-344c-9a3a-c20b44a8b047",
                                "text": "If I listen to fast music before I go out in a heat, it gets me too amped out and then I can't concentrate on my surfing."
                            },
                            {
                                "example_id": "b2c390e6-3fe3-449f-a48b-1e6502710f28",
                                "sense_id": "aeb3a86e-6be3-344c-9a3a-c20b44a8b047",
                                "text": "But I didn't care. I was twenty-two years old. I was invincible. “Keep it going,” Sparky said at one point. He was too amped to sleep, so he turned on the radio and cranked the volume."
                            },
                            {
                                "example_id": "9146df9b-c4b3-470e-83d4-0b8e26e33a1d",
                                "sense_id": "aeb3a86e-6be3-344c-9a3a-c20b44a8b047",
                                "text": "But whether the guy was fiddling too intently with the XM radio tuner or was simply too amped on NoDoz and cheap cigarettes, speeding along to a New Year's Eve party, he keeps driving."
                            },
                            {
                                "example_id": "f6d71372-b5a3-4602-a254-7bf0c793b51a",
                                "sense_id": "aeb3a86e-6be3-344c-9a3a-c20b44a8b047",
                                "text": "Hawk ate it, and ate it again and again, and failed four times before regulation time ran out. But Hawk kept going; the crowd was amped to see history made, and Tony was amped to make it"
                            }
                        ]
                    }
                ],
