                                            {
                                                "example_id": "f407fc7d-0f20-429a-89a5-4bea4be78f3f",
                                                "sense_id": "7f3670e6-ce28-3978-924a-2b4bfdf997e7",
                                                "text": "O curioso é que ñoño , uma das poucas palavras em espanhol que começam com ñ (enhe)"
                                            },
                                            {
                                                "example_id": "7aabd85a-ff92-45e5-8286-33262a764394",
                                                "sense_id": "7f3670e6-ce28-3978-924a-2b4bfdf997e7",
                                                "text": "como também é o caso dos países escandinavos, da Eslovénia, de Espanha, com o enhe (ñ)"
                                            },
                                            {
                                                "example_id": "0da823e5-b2de-4f98-9ac6-3c0973d47e21",
                                                "sense_id": "7f3670e6-ce28-3978-924a-2b4bfdf997e7",
                                                "text": "em vez de Mañara , para evitar a \"enhe\" espanhola"
                                            }
