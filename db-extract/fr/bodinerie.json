                        ]
                    },
                    {
                        "translation_id": "a63cbd05-3f22-44a5-9d8c-9f68d5e9f40c",
                        "source_entry_id": "3cd90a6e-a459-345a-928a-84da9c70a990",
                        "source_sense_id": "5bc721af-dca9-3f34-a2a4-34cb4aa5b868",
                        "target_lang_word": "bottomry",
