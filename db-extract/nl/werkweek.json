                                    {
                                        "sense_id": "bcdabbba-f97c-3e59-847f-3b7f7aa60bb3",
                                        "entry_id": "4ac81d74-abae-3ea4-8bc4-46dc1a448964",
                                        "glosses": [
                                            "derjenige Teil der Woche, an dem gearbeitet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b6b9156-fddd-4f01-bbbc-63a5d6a365bb",
                                                "sense_id": "bcdabbba-f97c-3e59-847f-3b7f7aa60bb3",
                                                "text": "„Es war ein kühler Montagmorgen und meine Arbeitswoche in Barcelona begann mit Kaffeetrinken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "396e0af0-89e4-3225-ada5-9a1265a3b5a8",
                                        "entry_id": "4ac81d74-abae-3ea4-8bc4-46dc1a448964",
                                        "glosses": [
                                            "Woche, in der gearbeitet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7f1ccf9-d3bb-4387-b2de-e321ba6a3422",
                                                "sense_id": "396e0af0-89e4-3225-ada5-9a1265a3b5a8",
                                                "text": "Ich habe zwei aufeinanderfolgende Arbeitswochen und dann eine Woche mit Zeitausgleich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f9e14d00-8340-4349-9ac4-7a9b8c3882ca",
                        "source_entry_id": "d347fa90-982f-304c-a603-a79fd4e74ce4",
                        "source_sense_id": "20a915a8-47af-3c21-b03f-6598c7880561",
                        "source_sense_description": "dagen per week waarop er gewerkt wordt",
                        "target_lang_word": "working week",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "working week",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4cb13dba-0a65-3ce8-874d-a1f4e6a32b27",
                                        "entry_id": "47d8ced2-1d45-39dd-8b20-c0fc6b097666",
                                        "glosses": [
                                            "The days of the week that are usually worked on, i.e. Monday to Friday."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42fdd7f3-941c-47e5-83dc-756cccd31dc3",
                                                "sense_id": "4cb13dba-0a65-3ce8-874d-a1f4e6a32b27",
                                                "text": "He was my North, my South, my East and West, / My working week and my Sunday rest"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f9143605-2e3c-40e1-a55b-87fc160a40f2",
                        "source_entry_id": "d347fa90-982f-304c-a603-a79fd4e74ce4",
                        "source_sense_id": "20a915a8-47af-3c21-b03f-6598c7880561",
                        "source_sense_description": "dagen per week waarop er gewerkt wordt",
                        "target_lang_word": "workweek",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "workweek",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5fc0f22-db24-301e-b113-155c59b073fe",
                                        "entry_id": "2fca5a2f-cf48-3f7d-adab-91e2cdb530ed",
                                        "glosses": [
                                            "The range of days of the week that are normally worked."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a56bb8c3-bf79-4efc-9416-73470194009b",
                                                "sense_id": "b5fc0f22-db24-301e-b113-155c59b073fe",
                                                "text": "Mrs. Lienemann, the French Housing Minister, sees socialist and ecological forces proposing what she calls “a new culture”—perhaps named “Ecosocialism”—that might, she believes, work for innovations like a 32-hour workweek, more democracy at the workplace, and “a greater stress on quality than quantity in everyday life.”"
                                            },
                                            {
                                                "example_id": "6ebd0f00-f54d-4a95-a2c4-750c9c1a45a4",
                                                "sense_id": "b5fc0f22-db24-301e-b113-155c59b073fe",
                                                "text": "That trial, which began the same week as the elections that brought Margaret Thatcher to power, remains a symbol, to a certain sort of Englishman, of the societywide breakdown of the 1970s, which was a decade of currency devaluations, crippling strikes, uncollected garbage and shortened workweeks."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
