                                        "entry_id": "2338ffcc-4a9f-3db3-9aba-393f80a651de",
                                        "glosses": [
                                            "To spontaneously roll suddenly and rapidly to one side or the other upon entering a stall (due to one wing stalling slightly before the other does, combined with the reduced effectiveness of ailerons for roll control at high angles of attack)."
                                        ],
                                        "tags": [
                                            "of an aircraft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17f2c70a-490a-481a-8855-98c3a3eaa044",
                                                "sense_id": "f6668edc-8612-318a-8ae2-4303c89c004e",
                                                "text": "In addition to the large decrease in lift caused by the stall itself, further performance degradation can be expected as the airplane rolls off, as the spoilers on the high wing deploy in an attempt to fight the plane's sudden rolling motion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af1681ef-877e-3fe1-8098-e5abd16a9e82",
                                        "entry_id": "2338ffcc-4a9f-3db3-9aba-393f80a651de",
                                        "glosses": [
                                            "To come off (something) with a rolling motion."
