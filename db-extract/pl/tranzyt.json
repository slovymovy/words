                                        "entry_id": "dff477c1-b80a-3cc1-a5a3-4f88e00c3c54",
                                        "glosses": [
                                            "The act of passing over, across, or through something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c10a848f-ee89-4300-a1e7-f16628d3eb48",
                                                "sense_id": "e782aafc-2494-32d9-83a1-4e59996d2015",
                                                "text": "In France you are now […] in the transit from one form of government to another."
                                            },
                                            {
                                                "example_id": "0257652a-e034-45b9-ac3c-28752d355edf",
                                                "sense_id": "e782aafc-2494-32d9-83a1-4e59996d2015",
                                                "text": "In the hollow by the park wall it appeared again, distinctly; and here it was plain the transit of the wall had been made, for the traces of the mud were evident enough upon its surface, and the mortar at top was displaced, and a little tuft of grass in the mud, left by the clodded shoesole."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1c13248-a103-300a-aa4b-9bc13570225c",
                                        "entry_id": "dff477c1-b80a-3cc1-a5a3-4f88e00c3c54",
                                        "glosses": [
                                            "The conveyance of people or goods from one place to another, especially on a public transportation system; the vehicles used for such conveyance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55ce099b-68f3-4fd5-92fe-1459e4019413",
                                                "sense_id": "d1c13248-a103-300a-aa4b-9bc13570225c",
                                                "text": "the transit of goods through a country"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a03fccd-c777-3fd6-aaf2-d20895777b82",
                                        "entry_id": "dff477c1-b80a-3cc1-a5a3-4f88e00c3c54",
                                        "glosses": [
                                            "Any form of transport that can be used by a member of public (who usually pays a fare), as opposed to private ownership of e.g. cars; short form of public transit or mass transit"
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80349e10-afed-4206-9135-ea6f68ce8321",
                                                "sense_id": "4a03fccd-c777-3fd6-aaf2-d20895777b82",
                                                "text": "I always take transit to work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee4a9714-852a-3391-8762-53abaffa3817",
                                        "entry_id": "dff477c1-b80a-3cc1-a5a3-4f88e00c3c54",
                                        "glosses": [
                                            "The passage of a celestial body or other object across the observer's meridian, or across the disk of a larger celestial body."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "713a8065-ffb5-3d6f-ac14-51d8930e3511",
                                        "entry_id": "dff477c1-b80a-3cc1-a5a3-4f88e00c3c54",
                                        "glosses": [
                                            "The passage of a celestial body in the horoscope, e.g. through a section or in relation to a specific important point in someone's birth chart."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
