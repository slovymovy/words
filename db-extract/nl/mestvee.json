                    {
                        "translation_id": "3ec4ea5e-a18a-4491-8102-7bfa1eb492b0",
                        "source_entry_id": "757185ed-7c11-3b45-8ce3-1059c4c5e0c1",
                        "source_sense_id": "c800fe84-184f-302d-8a72-2eff82434917",
                        "source_sense_description": "dieren die vetgemest worden om als slachtvee voor voedsel te dienen",
                        "target_lang_word": "Mastvieh",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mastvieh",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bc948b76-0faf-367a-92b9-dc85ce69045a",
                                        "entry_id": "642dff83-0e0a-35b8-bed0-4100fc6222b4",
                                        "glosses": [
                                            "Tiere (beispielsweise Mastrinder, Mastschweine, Masthühner), die zum Zweck der Fleischgewinnung gemästet werden, also so gefüttert werden, dass sie vor dem Schlachten schnell Fleisch und Fett angesetzt haben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9637d937-39ae-43e8-9c49-13c8bc0db439",
                                                "sense_id": "bc948b76-0faf-367a-92b9-dc85ce69045a",
                                                "text": "„Diese [resistenten] Bakterien fanden sich in 67 Prozent der Ställe für Milch- und Mastvieh, in 88 Prozent der Schweineställe und in allen Hähnchenmastanlagen.“"
                                            },
                                            {
                                                "example_id": "83dd2503-1adf-4026-b535-fc27e37c52e7",
                                                "sense_id": "bc948b76-0faf-367a-92b9-dc85ce69045a",
                                                "text": "„Wenn man Milchvieh hält, lässt sich der Ertrag verdoppeln oder verdreifachen im Vergleich zu Mastvieh.“"
                                            },
                                            {
                                                "example_id": "e7eafe6e-8dde-453a-991d-1cca665deef1",
                                                "sense_id": "bc948b76-0faf-367a-92b9-dc85ce69045a",
                                                "text": "„Es fehlen [in China] wichtige moderne Technologien, wie etwa zur Bewässerung von Pflanzen oder der Überwachung von Mastvieh.“"
                                            },
                                            {
                                                "example_id": "86160140-91f8-4692-ad0c-0426215b2b1f",
                                                "sense_id": "bc948b76-0faf-367a-92b9-dc85ce69045a",
                                                "text": "„[Claus Posewang und seine Familie] arbeiten anders als die meisten Bauern, erzählt er: Jedes Kalb, das bei ihnen zur Welt kommt, bleibt auf dem Hof. So haben sie sowohl Milchkühe als auch Mastvieh.“"
                                            },
                                            {
                                                "example_id": "569effa1-370f-41a8-a1fc-ed2004385981",
                                                "sense_id": "bc948b76-0faf-367a-92b9-dc85ce69045a",
                                                "text": "„Soja aus Südamerika macht unser Mastvieh satt, nicht aber die Menschen weltweit: Die Produktion eines Rindersteaks erfordert etwa so viel Soja wie die Herstellung eines ganzen Blechs Sojakuchen. Der würde nicht nur einen, sondern gleich zehn Menschen satt machen.“"
                                            },
                                            {
                                                "example_id": "835b9319-1e27-49b3-9122-1df01fec76ab",
                                                "sense_id": "bc948b76-0faf-367a-92b9-dc85ce69045a",
                                                "text": "„[…] Luther [war] ein genialer Sprachschöpfer, vor allem, was die Wortzusammensetzung angeht. Die Liste seiner Einfälle ist schier endlos. Hier einige Beispiele unter dem Gesichtspunkt, dass man bei ihnen kaum auf den Reformator als Schöpfer tippen würde: Blutgeld, Feuereifer, Gegenbild, Herzenslust, Kleingläubiger, Kriegsknecht, Mastvieh, […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
