                                        "sense_id": "0b809ba3-e9b7-3056-a147-ca388e4d5c70",
                                        "entry_id": "7cdaab22-19cc-3ab6-b32c-529917a700f3",
                                        "glosses": [
                                            "A typically black formal jacket worn by men."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7f55a89-b9a9-4620-9d99-1c4f8a3345e3",
                                                "sense_id": "0b809ba3-e9b7-3056-a147-ca388e4d5c70",
                                                "text": "He wore a tuxedo for his sister's wedding."
                                            },
                                            {
                                                "example_id": "5ba0fd2b-2f46-40a2-bbe6-0df462f2b707",
                                                "sense_id": "0b809ba3-e9b7-3056-a147-ca388e4d5c70",
                                                "text": "His mom bought a tuxedo for him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "935a22b0-eea4-3e21-909e-2b9afb9fad33",
                                        "entry_id": "7cdaab22-19cc-3ab6-b32c-529917a700f3",
                                        "glosses": [
