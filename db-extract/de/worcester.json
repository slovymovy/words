                        "sense_id": "1d8d0006-f899-3c25-9525-d158aefdfaeb",
                        "entry_id": "ecdd5f4d-f4b6-3867-89c3-cf912038dd44",
                        "glosses": [
                            "Stadt in England, Hauptstadt der Grafschaft Worcestershire"
                        ],
                        "tags": [],
