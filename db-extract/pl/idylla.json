                        ]
                    },
                    {
                        "translation_id": "8a72bdda-72b6-4e01-9864-7ece4d053a24",
                        "source_entry_id": "82919526-5ba8-3fca-b40b-74b803614a03",
                        "source_sense_id": "7b68e85f-e414-3af4-b392-e577f7de2823",
                        "target_lang_word": "идиллия",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "идиллия",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "514c997a-481b-301a-b42f-98eb4b2f85f8",
                                        "entry_id": "ed523fee-b3a2-3bd9-9ea8-34c9f4f7e031",
                                        "glosses": [
                                            "филол. поэтическое произведение, изображающее идеализированную безмятежную жизнь на лоне природы, жанровая разновидность буколики"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba52ee12-2451-4dda-82d2-98db1f1089ee",
                                                "sense_id": "514c997a-481b-301a-b42f-98eb4b2f85f8",
                                                "text": "Теокрит в своей идиллии пишет, что безумен тот, который прячет в свои сундуки богатства, о том не разсуждая, что оныя когда нибудь будут отворены его наследникам .."
                                            },
                                            {
                                                "example_id": "0bd83255-e479-47a8-b58d-a8c5c1c9d22b",
                                                "sense_id": "514c997a-481b-301a-b42f-98eb4b2f85f8",
                                                "text": "Давно уже, читая идиллии и эклоги, желал он полюбоваться золотым веком, царствующим в деревнях; давно желал быть свидетелем нежности пастушков и пастушек."
                                            },
                                            {
                                                "example_id": "51ef9d93-529a-476e-a838-5bbfe2d7c537",
                                                "sense_id": "514c997a-481b-301a-b42f-98eb4b2f85f8",
                                                "text": "Вслед за тем явился и «Миргород», где с жадностию все прочли и «Старосветских помещиков», эту шутливую, трогательную идиллию, которая заставляет вас смеяться сквозь слёзы грусти и умиления, и «Тараса Бульбу», коего начало достойно Вальтер-Скотта."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "570360c1-cdfc-3938-890b-3ad13b54a0cc",
                                        "entry_id": "ed523fee-b3a2-3bd9-9ea8-34c9f4f7e031",
                                        "glosses": [
                                            "перен., книжн., безмятежное, счастливое существование"
                                        ],
                                        "tags": [
                                            "часто ирон."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6713118b-69c3-47d2-ba7b-af55438ac294",
                                                "sense_id": "570360c1-cdfc-3938-890b-3ad13b54a0cc",
                                                "text": "По соседству живут две сестрицы, шитьём занимаются; я их и пригласил, объяснив предварительно, что я их приглашаю единственно для идиллии, а не для чего иного."
                                            },
                                            {
                                                "example_id": "6bad9244-c23e-44ac-a268-dbc365ce1986",
                                                "sense_id": "570360c1-cdfc-3938-890b-3ad13b54a0cc",
                                                "text": "Хочу насладиться тишиной, видом лесо-горных зон и хочу погулять и послушать шум гор и леса и голоса пернатых, хочу посидеть в лачужке и насладиться деревенской идиллией."
                                            },
                                            {
                                                "example_id": "dbd2eb07-9894-4092-a1b5-786bcdfd1109",
                                                "sense_id": "570360c1-cdfc-3938-890b-3ad13b54a0cc",
                                                "text": "Она играла мне на пианино, а потом — о, идиллия! — я аккомпанировал ей, как умел — мы музицировали в четыре руки!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
