                    "frequency": "Middle",
                    "semantic_group_id": "character",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I tried to be the <w>bigger</w> person and just let the argument go.",
                            "target_lang_translations": {
                                "ru": "Я постарался быть <w>выше</w> этого и просто прекратил спор."
                            }
                        },
                        {
                            "text": "It was very <w>big</w> of you to admit that you were wrong.",
                            "target_lang_translations": {
                                "ru": "С твоей стороны было очень <w>благородно</w> признать свою ошибку."
                            }
