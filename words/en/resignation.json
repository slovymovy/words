{
    "word_family": [
        "resign",
        "resigned",
        "resignedly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a24799ba-d715-3146-9506-990ced0f7fae",
                    "sense_definition": "The act of officially giving up a job or position.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "job_leaving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prime minister announced his <w>resignation</w> after the scandal.",
                            "target_lang_translations": {
                                "ru": "Премьер-министр объявил о своей <w>отставке</w> после скандала.",
                                "zh": "丑闻发生后，首相宣布<w>辞职</w>。"
                            }
                        },
                        {
                            "text": "She offered her <w>resignation</w> to the board of directors yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера она подала совету директоров прошение об <w>отставке</w>.",
                                "zh": "她昨天向董事会递交了<w>辞职</w>申请。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tender one's resignation",
                        "demand resignation",
                        "announce resignation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие, заключающееся в официальном оставлении должности или поста.",
                        "zh": "正式放弃职位或职务的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отставка",
                                "target_lang_sense_clarification": "официальное сложение полномочий"
                            },
                            {
                                "target_lang_word": "уход",
                                "target_lang_sense_clarification": "оставление места работы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "辞职",
                                "target_lang_sense_clarification": "主动放弃工作或职位"
                            },
                            {
                                "target_lang_word": "引咎辞职",
                                "target_lang_sense_clarification": "因过失而辞去公职"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "469d1c88-d6ac-31e8-bec4-2174ca5e87c8",
                    "sense_definition": "A formal written or spoken statement stating that one is leaving a job.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "job_leaving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He handed in his <w>resignation</w> to the manager this morning.",
                            "target_lang_translations": {
                                "ru": "Сегодня утром он подал менеджеру <w>заявление об уходе</w>.",
                                "zh": "他今天早上向经理递交了<w>辞职信</w>。"
                            }
                        },
                        {
                            "text": "Please sign your <w>resignation</w> and leave it on the desk.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, подпишите <w>заявление об уходе</w> и оставьте его на столе.",
                                "zh": "请在你的<w>辞职报告</w>上签字，然后放在桌子上。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hand in resignation",
                        "letter of resignation",
                        "submit resignation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное письменное или устное заявление об уходе с работы.",
                        "zh": "说明某人将要离职的正式书面或口头声明。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заявление об уходе",
                                "target_lang_sense_clarification": "документ о расторжении трудового договора"
                            },
                            {
                                "target_lang_word": "заявление об отставке",
                                "target_lang_sense_clarification": "официальное прошение об увольнении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "辞职信",
                                "target_lang_sense_clarification": "书面的辞职申请"
                            },
                            {
                                "target_lang_word": "辞职报告",
                                "target_lang_sense_clarification": "正式的离职申请文件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5121fe56-6c5e-311c-b07e-d5cd1c010aad",
                    "sense_definition": "The feeling of accepting something unpleasant because it cannot be changed.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "acceptance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She sighed with <w>resignation</w> and accepted the difficult task.",
                            "target_lang_translations": {
                                "ru": "Она вздохнула со <w>смирением</w> и взялась за трудную задачу.",
                                "zh": "她<w>无奈</w>地叹了口气，接受了这项艰巨的任务。"
                            }
                        },
                        {
                            "text": "There was a look of <w>resignation</w> on his face when he heard the news.",
                            "target_lang_translations": {
                                "ru": "Когда он услышал новости, на его лице появилось выражение <w>смирения</w>.",
                                "zh": "听到这个消息时，他脸上露出了<w>顺从</w>的神情。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "with resignation",
                        "sigh of resignation",
                        "sense of resignation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство принятия чего-то неприятного из-за невозможности это изменить.",
                        "zh": "因无法改变现状而接受不愉快事实的心态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смирение",
                                "target_lang_sense_clarification": "спокойное принятие неизбежного"
                            },
                            {
                                "target_lang_word": "покорность",
                                "target_lang_sense_clarification": "отсутствие сопротивления обстоятельствам"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无奈",
                                "target_lang_sense_clarification": "对无法改变的情况感到无能为力"
                            },
                            {
                                "target_lang_word": "顺从",
                                "target_lang_sense_clarification": "听从命运或环境的安排"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f755ada-1ab9-3a60-83fa-7dadbd347f98",
                    "sense_definition": "The formal return of property or land to a superior in feudal law.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "feudal_law",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The vassal completed the <w>resignation</w> of his lands to the lord.",
                            "target_lang_translations": {
                                "ru": "Вассал оформил <w>возврат</w> своих земель сеньору.",
                                "zh": "封臣完成了将土地<w>归还</w>给领主的手续。"
                            }
                        },
                        {
                            "text": "Historical records describe the <w>resignation</w> of the feu by the tenant.",
                            "target_lang_translations": {
                                "ru": "Исторические документы описывают <w>отказ</w> арендатора от феодального владения.",
                                "zh": "历史记录描述了佃户对封地的<w>归还</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in the context of feudal law."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальный возврат собственности или земли вышестоящему лицу в феодальном праве.",
                        "zh": "在封建法中，将财产或土地正式归还给上级领主。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возврат лена",
                                "target_lang_sense_clarification": "феод. право: возврат имущества сеньору"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "归还",
                                "target_lang_sense_clarification": "将土地或权利交还给领主"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}