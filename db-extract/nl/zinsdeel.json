                        "glosses": [
                            "syntactische eenheid binnen een zin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb0af58d-62f3-499c-9ac2-7e668b3b8248",
                                "sense_id": "71d50e53-79ae-354b-a010-1664c43675de",
                                "text": "'Het' als persoonlijk voornaamwoord is altijd een zinsdeel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa72d7e9-6583-4722-b979-ee8241f5ad20",
                        "source_entry_id": "07970ae7-3e03-3e33-9238-f1311af5913e",
                        "source_sense_id": "71d50e53-79ae-354b-a010-1664c43675de",
                        "source_sense_description": "syntactische eenheid binnen een zin",
                        "target_lang_word": "Satzteil",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Satzteil",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5067cdb3-92d2-3fa7-bb4d-16081a7443c3",
                                        "entry_id": "b2ccccb5-7cff-314a-abb2-e38e7543e7b3",
                                        "glosses": [
                                            "gleichbedeutend mit Satzglied: Wortgruppe im Satz, die zusammengehört, gemeinsam umgestellt und ersetzt werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f3ca215-8b9d-4ada-bf42-ff896a543981",
                                                "sense_id": "5067cdb3-92d2-3fa7-bb4d-16081a7443c3",
                                                "text": "In dem Satz „Der kleine Junge ist sehr krank“ gibt es drei Satzteile: „der kleine Junge“, „ist“ und „sehr krank“."
                                            },
                                            {
                                                "example_id": "a9707140-d4ba-4b5d-a90d-06499e120e6b",
                                                "sense_id": "5067cdb3-92d2-3fa7-bb4d-16081a7443c3",
                                                "text": "„Die Grammatik ist reduziert, der innere Zusammenhalt der Satzteile gelockert, viele Regeln sind vereinfacht oder lösen sich ganz auf, die Sprache wird einfacher (und wird hier vom Englischen unterstützt).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bc749a6b-6f40-3694-8671-69b240d6f4ba",
                                        "entry_id": "b2ccccb5-7cff-314a-abb2-e38e7543e7b3",
                                        "glosses": [
                                            "beliebiger Teil eines Satzes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "557c7cab-5a70-413c-8dfb-3d22f1c83e38",
                                                "sense_id": "bc749a6b-6f40-3694-8671-69b240d6f4ba",
                                                "text": "„Die Bezeichnung Satzteil wird meist … benutzt, um beliebige Konstituenten (…, ‚Bestandteile‘) des Satzes zu bezeichnen, und zwar unabhängig davon, ob es sich dabei um selbständige oder unselbständige Teile des Satzes handelt.“"
                                            },
                                            {
                                                "example_id": "ec8c5900-0efc-4428-a327-a72a2a6584f6",
                                                "sense_id": "bc749a6b-6f40-3694-8671-69b240d6f4ba",
                                                "text": "Die Duden-Grammatik setzt Konstituente mit Satzteil gleich: “„Auch der deutsche Ausdruck Satzteil hat die gleiche allgemeine Bedeutung; er darf nicht mit den spezifischeren Begriffen des Satzglieds und des Gliedteils verwechselt werden.“"
                                            },
                                            {
                                                "example_id": "19f6ce57-f6f9-4a83-aa6d-c792fad486a8",
                                                "sense_id": "bc749a6b-6f40-3694-8671-69b240d6f4ba",
                                                "text": "Jede Einheit und jede Kombination von Einheiten eines Satzes kann als Satzteil aufgefasst werden."
                                            },
                                            {
                                                "example_id": "0b4977ca-50c4-41e6-90c4-c8775e4433af",
                                                "sense_id": "bc749a6b-6f40-3694-8671-69b240d6f4ba",
                                                "text": "Auch ein Teilsatz kann ein Satzteil sein."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a44bf1a-4dec-44d1-a27d-550e4d2c53d2",
                        "source_entry_id": "07970ae7-3e03-3e33-9238-f1311af5913e",
