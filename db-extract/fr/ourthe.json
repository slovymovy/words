                        "translation_id": "26d40e63-213f-43bf-a2de-f22fd440ebc2",
                        "source_entry_id": "a0c442e5-2ece-3b54-98b8-f46649caedf9",
                        "source_sense_id": "8efd44f1-12f0-3c3d-bfc4-8043bab07a50",
