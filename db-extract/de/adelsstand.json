                ],
                "senses": [
                    {
                        "sense_id": "52d5dafe-4fa0-33f4-b88d-89b46f76ae91",
                        "entry_id": "fc1a3636-6acf-3b9d-abf5-a0e4f49cc762",
                        "glosses": [
                            "eine soziale Gesellschaftsschicht (Stand), die der Adel bildet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "faa46452-435f-4799-98c3-1d7364bee84e",
                                "sense_id": "52d5dafe-4fa0-33f4-b88d-89b46f76ae91",
                                "text": "„Von der Royal Geographical Society und anderen wissenschaftlichen Gesellschaften für ihre Forschungsberichte preisgekrönt, wurde sie 1972 in den Adelsstand erhoben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f7ba9711-2273-4a61-94a9-75a99cd731ab",
                        "source_entry_id": "fc1a3636-6acf-3b9d-abf5-a0e4f49cc762",
                        "source_sense_id": "52d5dafe-4fa0-33f4-b88d-89b46f76ae91",
                        "source_sense_description": "Politik: eine soziale Gesellschaftsschicht (Stand), die der Adel bildet",
                        "target_lang_word": "nobility",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nobility",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f018c59-4b16-3e23-a45c-3b85d69782ad",
                                        "entry_id": "b9bd262f-3d45-3505-8451-e8ce3097460f",
                                        "glosses": [
                                            "A noble or privileged social class, historically accompanied by a hereditary title; aristocracy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17b9a44c-145d-4075-8532-b59780decf65",
                                                "sense_id": "5f018c59-4b16-3e23-a45c-3b85d69782ad",
                                                "text": "The castle was once home to the Scottish nobility."
                                            },
                                            {
                                                "example_id": "c1ece07d-2996-4320-922a-bc7d8daa804a",
                                                "sense_id": "5f018c59-4b16-3e23-a45c-3b85d69782ad",
                                                "text": "Titles of nobility were passed down through generations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9747154-0ed6-3bf2-b4c4-2514ec3aa905",
                                        "entry_id": "b9bd262f-3d45-3505-8451-e8ce3097460f",
                                        "glosses": [
                                            "The quality of being noble."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c29d5fa-4096-4ab7-8c85-2a4547afb5b2",
                                                "sense_id": "b9747154-0ed6-3bf2-b4c4-2514ec3aa905",
                                                "text": "He displayed nobility of character when helping his rivals."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3377f849-8cc4-4d8e-86b9-8e9626e15e33",
                        "source_entry_id": "fc1a3636-6acf-3b9d-abf5-a0e4f49cc762",
                        "source_sense_id": "52d5dafe-4fa0-33f4-b88d-89b46f76ae91",
                        "source_sense_description": "Politik: eine soziale Gesellschaftsschicht (Stand), die der Adel bildet",
                        "target_lang_word": "noblesse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "noblesse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "67e91ff9-fbd1-37b3-bd68-9600f7a977d4",
                                        "entry_id": "f05457a6-d10f-3ae2-a366-226548296f44",
                                        "glosses": [
                                            "Qualité de celui qui est noble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a369e7b-f048-4758-803b-ea47107a1b87",
                                                "sense_id": "67e91ff9-fbd1-37b3-bd68-9600f7a977d4",
                                                "text": "Bonne, haute, ancienne, nouvelle noblesse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1816f10-7fd6-31e9-ae09-b72a22891cf9",
                                        "entry_id": "f05457a6-d10f-3ae2-a366-226548296f44",
                                        "glosses": [
                                            "Tout le corps des hommes qualifiés nobles, ou une partie de ce corps."
                                        ],
                                        "tags": [
                                            "collectively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aed118b3-da32-4d78-b1fb-a6d84dfc6cd0",
                                                "sense_id": "a1816f10-7fd6-31e9-ae09-b72a22891cf9",
                                                "text": "Il a toujours méprisé les vanteries ridicules dont il arrive assez ordinairement que la noblesse étourdit le monde."
                                            },
                                            {
                                                "example_id": "7598c6b5-9141-42bd-acda-3adfdfacd9ef",
                                                "sense_id": "a1816f10-7fd6-31e9-ae09-b72a22891cf9",
                                                "text": "\"La noblesse, disent les nobles, est un intermédiaire entre le roi et le peuple…\" Oui, comme le chien de chasse est un intermédiaire entre le chasseur et les lièvres."
                                            },
                                            {
                                                "example_id": "556c9645-3ae5-4ebf-90db-350b26be7ff8",
                                                "sense_id": "a1816f10-7fd6-31e9-ae09-b72a22891cf9",
                                                "text": "La noblesse est entièrement opposée à tout système constitutionnel; son influence est à peu près nulle sur la bourgeoisie, mais elle est immense sur les métayers, qui sont presque tous à ses gages."
                                            },
                                            {
                                                "example_id": "184aa550-8ef1-427d-9803-b54164106efe",
                                                "sense_id": "a1816f10-7fd6-31e9-ae09-b72a22891cf9",
                                                "text": "Ils furent réduits à répéter entre eux, d’un air tristement satisfait : « Après tout, ce n’est qu’un bourgeois, né on ne sait où, et qui ne peut jouir que de la noblesse personnelle que lui confère son épaulette de sous-lieutenant. »"
                                            },
                                            {
                                                "example_id": "90a76e04-cb53-4ea2-b4bc-f05866de70ba",
                                                "sense_id": "a1816f10-7fd6-31e9-ae09-b72a22891cf9",
                                                "text": "Après avoir harcelé la révolution dans l’Assemblée, elles l’attaquèrent plus tard à force ouverte, le clergé par des soulèvements intérieurs, la noblesse en armant l’Europe contre elle."
                                            },
                                            {
                                                "example_id": "d8228f83-64ca-4af1-a729-045127e23dd3",
                                                "sense_id": "a1816f10-7fd6-31e9-ae09-b72a22891cf9",
                                                "text": "Comme les chorfa descendent du Prophète, ils appartiennent à la plus pure noblesse musulmane, et leur illustre ascendance, par un usage spécial au Maghreb, leur vaut les plus extraordinaires avantages."
                                            },
                                            {
                                                "example_id": "85d61585-dedc-4f09-8cb4-ed355f1005c2",
                                                "sense_id": "a1816f10-7fd6-31e9-ae09-b72a22891cf9",
                                                "text": "Cette association du politique et du religieux perpétua, jusqu’au milieu du XXᵉ siècle, un système féodal abusif entretenu par la noblesse et les moines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6ce069e-6327-3616-a779-de34c7c6ccb4",
                                        "entry_id": "f05457a6-d10f-3ae2-a366-226548296f44",
                                        "glosses": [
                                            "Groupe social qui s'arroge des privilèges et accapare le pouvoir dans une société."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f79c8cd7-cfd5-460b-b8fb-4dc15bb79b53",
                                                "sense_id": "a6ce069e-6327-3616-a779-de34c7c6ccb4",
                                                "text": "En France, les grands patrons qui ne sont pas issus de la noblesse d’État sont des parias du monde des affaires."
                                            },
                                            {
                                                "example_id": "9c8dfeed-bbbf-4ae7-a3a0-ba74669d5182",
                                                "sense_id": "a6ce069e-6327-3616-a779-de34c7c6ccb4",
                                                "text": "Lorsque la constitution française reconnaissait un ordre de noblesse privilégiée, la femme noble qui épousait un roturier dérogeait à la noblesse et devenait roturière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c38edd99-443f-3262-85b1-5bf41dffa9ae",
                                        "entry_id": "f05457a6-d10f-3ae2-a366-226548296f44",
                                        "glosses": [
                                            "Grandeur ; élévation ; dignité."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "428ad7fe-77ff-4ecf-bc0b-cfbac7eeeb0c",
                                                "sense_id": "c38edd99-443f-3262-85b1-5bf41dffa9ae",
                                                "text": "Vous reconnaissez bien mal la noblesse de mes procédés envers vous, dit-il lentement."
                                            },
                                            {
                                                "example_id": "b3b187a7-d77b-41e3-ad9b-9d6a679727d5",
                                                "sense_id": "c38edd99-443f-3262-85b1-5bf41dffa9ae",
                                                "text": "Et, vivement impressionné par la noblesse réelle du spectacle, je ne pus m’empêcher de mêler ma voix aux acclamations enthousiastes des croyants prosternés."
                                            },
                                            {
                                                "example_id": "af2384e6-5b1f-46ab-857f-0251e0a6dae4",
                                                "sense_id": "c38edd99-443f-3262-85b1-5bf41dffa9ae",
                                                "text": "La noblesse est d’affronter les dangers que l’on a reconnu, non pas de fermer les yeux à ceux que l’on court."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd624e93-ed36-38b7-8011-75388260d382",
                                        "entry_id": "f05457a6-d10f-3ae2-a366-226548296f44",
                                        "glosses": [
                                            "Caractère élevé de la composition, de l’expression, de la forme."
                                        ],
                                        "tags": [
                                            "Peinture",
                                            "Sculpture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36273bfb-f307-4e35-bd09-79815d9d35c7",
                                                "sense_id": "bd624e93-ed36-38b7-8011-75388260d382",
                                                "text": "Cette figure a de la noblesse, manque de noblesse, est sans noblesse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
