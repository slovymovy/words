                                                "sense_id": "487e0df1-4ccf-3045-acb8-ba6342d138d1",
                                                "text": "Przed wyjazdem nie opróżniłam lodówki i teraz w środku potwornie śmierdzi."
                                            },
                                            {
                                                "example_id": "151386df-8b0f-4d60-926a-971497cbe364",
                                                "sense_id": "487e0df1-4ccf-3045-acb8-ba6342d138d1",
                                                "text": "Pod blokiem jest śmierdząca kupa śmieci."
                                            },
