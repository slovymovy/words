                "senses": [
                    {
                        "sense_id": "88db12e1-67bc-3b20-ab5a-2ee5eefe8ce5",
                        "entry_id": "243a6ef1-4afa-383a-aa49-824f5dd1b0ad",
                        "glosses": [
                            "Kraftwerk, das generell nachts mithilfe von Pumpen Wasser in höher gelegene Speicherbecken befördert, um tagsüber bei höherem Strombedarf aus der Bewegung des dann herunterströmenden Wassers Energie zu gewinnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddf6f698-6283-461d-bd4a-7aadf3fef455",
                                "sense_id": "88db12e1-67bc-3b20-ab5a-2ee5eefe8ce5",
                                "text": "„Die Schluchseewerk AG will im Hotzenwald ein neues Pumpspeicherwerk bauen.“"
                            },
                            {
                                "example_id": "5e52ecba-fcbf-4e0b-b349-46491bead84e",
                                "sense_id": "88db12e1-67bc-3b20-ab5a-2ee5eefe8ce5",
                                "text": "„Als der Energiekonzern Vattenfall Ende vorigen Monats sein Pumpspeicherwerk im sachsen-anhaltischen Wendefurth nach zweijähriger Modernisierung wieder in Betrieb nahm, kam Ministerpräsident Reiner Haseloff (CDU) eigens in den Harz, um für die 40-Millionen-Euro-Investition zu danken.“"
                            },
                            {
                                "example_id": "9d252518-4ce3-467b-9078-041104473df5",
                                "sense_id": "88db12e1-67bc-3b20-ab5a-2ee5eefe8ce5",
                                "text": "„Für den Bau des 600 Millionen Euro teuren Pumpspeicherwerkes über dem Walchensee müsste eine Alm weichen.“"
                            },
                            {
                                "example_id": "d098014a-3a5d-41c6-815a-aff1425a44f1",
                                "sense_id": "88db12e1-67bc-3b20-ab5a-2ee5eefe8ce5",
                                "text": "„Pumpspeicherwerke können überschüssige Energie aus Wind- und Sonnenkraft aufnehmen und in wind- und sonnenschwachen Zeiten wieder abgeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
