                "senses": [
                    {
                        "sense_id": "48693e1d-342a-35f1-a26c-4e864c523c6e",
                        "entry_id": "ad96dba0-d89b-3362-9502-295ff70b29c3",
                        "glosses": [
                            "Augmenter, à l'aide d'un logiciel ou en effectuant une manipulation matérielle, la fréquence d’horloge d’un microprocesseur d’un ordinateur ou d’une carte graphique, au delà de celle définie en usine par le constructeur."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "4fd09c7f-a462-4543-b2ca-4655065b63c2",
                                "sense_id": "48693e1d-342a-35f1-a26c-4e864c523c6e",
                                "text": "Overclocker son processeur, cela se passe dans le BIOS pour les puristes."
                            },
                            {
                                "example_id": "13a97f1a-0fed-4eac-b341-4f727142792a",
                                "sense_id": "48693e1d-342a-35f1-a26c-4e864c523c6e",
                                "text": "Overclocker un processeur consiste à faire fonctionner le CPU à une vitesse supérieure."
                            },
                            {
                                "example_id": "8e79a8dc-850a-41a7-8d79-82fb6299d08a",
                                "sense_id": "48693e1d-342a-35f1-a26c-4e864c523c6e",
                                "text": "Overclocker sa carte graphique"
                            }
                        ]
                    }
