                        "glosses": [
                            "Spaarpot in de vorm van een varken."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d2c793a-383b-45e0-a18f-32f5b6c5a31c",
                                "sense_id": "de61334d-ad6b-39fc-9f79-1798e2fcc6da",
                                "text": "Een spaarpot of spaarvarken is een hol voorwerp dat gebruikt wordt om geld in huiselijke kring te bewaren, zonder het op een spaarrekening te zetten."
                            },
                            {
                                "example_id": "ac4ac359-eec2-470a-a1eb-d1cb83213402",
                                "sense_id": "de61334d-ad6b-39fc-9f79-1798e2fcc6da",
                                "text": "'Sjef zat in de spaarvarkens. In die tijd, moet u weten. Spaarvarkens waren er niet veel, net na de oorlog.'"
                            }
                        ]
                    }
