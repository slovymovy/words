                ],
                "senses": [
                    {
                        "sense_id": "6aed3894-8ce0-3ba0-82ea-e4291b9a4a27",
                        "entry_id": "56afe5f7-9965-341e-8530-d9670baed4b9",
                        "glosses": [
                            "Artilleriegeschoss, Fliegerbombe oder Marschflugkörper, das/der in seinem Inneren viele kleine Sprengkörper enthält und diese bei der Erreichung des Zielgebietes freisetzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac24f33a-cda3-43c1-a845-4e7757eabfd4",
                                "sense_id": "6aed3894-8ce0-3ba0-82ea-e4291b9a4a27",
                                "text": "Streumunition wurde im Osloer Abkommen von 2007 geächtet."
                            },
                            {
                                "example_id": "b9ab6f52-2b78-4c92-b3aa-f43477054303",
                                "sense_id": "6aed3894-8ce0-3ba0-82ea-e4291b9a4a27",
                                "text": "„Im ostukrainischen Charkiw wurde laut AI-Recherchen international geächtete Streumunition eingesetzt.“"
                            },
                            {
                                "example_id": "419d34ee-3012-4707-ab71-a5bdac9f2737",
                                "sense_id": "6aed3894-8ce0-3ba0-82ea-e4291b9a4a27",
                                "text": "„Der Nachweis ist relativ leicht, aufgrund der charakteristischen Einschlagsmuster – und vor allem weil zahlreiche sogenannte „Sub-Munitionen“, in die sich ein Geschoß mit Streumunition aufspaltet, als corpora delicti gefunden wurden.“"
                            },
                            {
                                "example_id": "cdc496aa-da26-410d-b217-5ab250aaf5e8",
                                "sense_id": "6aed3894-8ce0-3ba0-82ea-e4291b9a4a27",
                                "text": "„Die Herstellung von Atomwaffen, biologischen und chemischen Waffen ist in Deutschland grundsätzlich verboten, ebenso die Produktion von Antipersonenminen und Streumunition.“"
                            },
                            {
                                "example_id": "fa05135d-c772-49cc-ae53-3d78c3072649",
                                "sense_id": "6aed3894-8ce0-3ba0-82ea-e4291b9a4a27",
                                "text": "„Litauen tritt als erster Staat weltweit aus dem Abkommen zum Verbot von Streumunition aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
