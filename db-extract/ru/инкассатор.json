                                        "sense_id": "5639275e-4f55-30a0-b91c-e6251d6b4cec",
                                        "entry_id": "57139b02-7447-3a7a-b5e2-cb2027992cb7",
                                        "glosses": [
                                            "Garde, chauffeur ou messager assurant le chargement et le transport d’argent liquide, de bijoux, de métaux précieux ou de documents permettant d’effectuer un paiement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b056c67-88be-4173-822b-4cc238d2b23f",
                                                "sense_id": "5639275e-4f55-30a0-b91c-e6251d6b4cec",
                                                "text": "On ne va pas loin de nos jours avec un milliard de francs, surtout si l’on est convoyeur de fonds."
                                            },
                                            {
                                                "example_id": "658bc9cb-5432-4291-9fdc-60daca22685f",
                                                "sense_id": "5639275e-4f55-30a0-b91c-e6251d6b4cec",
                                                "text": "Pendant 25 ans j’ai exercé le métier de convoyeur de fonds, j’étais chargé de transporter toutes sortes de valeurs,billets de banque,lingots d’or ou autre métal précieux, des chéquiers, des tickets restaurants,des cartes bleues ,sans oublier la monnaie qui se portait à bout de bras par dizaines de kilo"
                                            },
                                            {
                                                "example_id": "aa02f644-5eee-4538-9c42-7198190f7329",
                                                "sense_id": "5639275e-4f55-30a0-b91c-e6251d6b4cec",
                                                "text": "Deux extraordinaires casses ont fait les titres des journaux cette semaine : un convoyeur de fonds, à Lyon, part avec 11 millions d’euros après dix ans de bons et loyaux services; un postier marseillais s’ en va tranquillement avec 1 millions d’euros."
                                            }
                                        ]
                                    }
