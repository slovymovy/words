                        "examples": [
                            {
                                "example_id": "92e7ea36-dd3e-4646-8546-f8c877a26c3a",
                                "sense_id": "a7683b53-d195-34a2-ad62-13d0219bc4a4",
                                "text": "„Die meterdicken Stahlbetonmauern aus Hitlers Großmachtfantasie sollen die Handlungsfähigkeit im Fall einer Natur- oder Nuklearkatastrophe ebenso garantieren wie im Falle von Kriegshandlungen, Revolten und Ähnlichem.“"
                            },
                            {
                                "example_id": "75b37049-8153-4a82-b9e3-b0f1ad269c00",
                                "sense_id": "a7683b53-d195-34a2-ad62-13d0219bc4a4",
                                "text": "„Eindringlich wies Lennart Meri auf die Gefahr der russischen Großmachtfantasien hin – und verurteilte die vorherrschende westliche Appeasement-Politik.“"
                            }
                        ],
