                    {
                        "sense_id": "56975181-83b4-3fec-94b8-6b50850c8ed5",
                        "entry_id": "260fd493-0958-30e5-967e-612ef6dcb7f2",
                        "glosses": [
                            "École communale."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "2b827ece-ee0d-49b8-80e5-f9d0e685bb83",
                                "sense_id": "56975181-83b4-3fec-94b8-6b50850c8ed5",
                                "text": "J’entrai en amitié dans les jours qui suivirent avec des garçons dont certains avaient usé quelques culottes en ma compagnie sur les bancs de la communale mais que je ne fréquentais plus, bien qu’ils fussent mes voisins."
                            },
                            {
                                "example_id": "069ff92e-da86-46be-ac47-7214f76dade6",
                                "sense_id": "56975181-83b4-3fec-94b8-6b50850c8ed5",
                                "text": "Mais nos pères n'avaient pas connu les « grandes écoles » comme ils disaient en parlant des lycées et collèges. Seulement la communale, pas toujours et pas longtemps."
                            }
                        ]
                    }
                ],
