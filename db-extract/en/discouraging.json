                                        "examples": [
                                            {
                                                "example_id": "e0d0fa24-3ff6-4208-958c-9489aab84663",
                                                "sense_id": "1518bccc-a114-3b62-8c05-a23644c5ea32",
                                                "text": "Op de website van de Duitse voetbalbond stonden de ontmoedigende woorden ‘Bedankt voor de veel succesvolle en bijzondere jaren.’"
                                            },
                                            {
                                                "example_id": "fb06ea02-36bf-4fe1-a42e-6a20ecbcd8fc",
                                                "sense_id": "1518bccc-a114-3b62-8c05-a23644c5ea32",
                                                "text": "Een zonnige ontwikkeling, maar toch is er nog lang geen reden om hoera te roepen. Van enige secularisatie, die in westerse landen altijd parallel liep aan modernisering, is nog geen sprake. Integendeel, zodra er iets moderns in aanvaring komt met de traditionele islam, moet de moderniteit wijken. Beekmans geeft daarvan een ontmoedigende reeks voorbeelden. HP de Tijd 29/10"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a65327f1-6aee-310f-a2b7-320a843f168a",
                                        "entry_id": "94cda73b-3e28-3426-a3d7-8d12f439d5fc",
                                        "glosses": [
                                            "van iets dat het afgeraden wordt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa69f890-dec9-4801-b576-73af0237f09b",
                                                "sense_id": "a65327f1-6aee-310f-a2b7-320a843f168a",
                                                "text": "Het spotje was een reactie van Lubach op de ontmoedigende advertenties die Denemarken in kranten in het Midden-Oosten heeft geplaatst."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
