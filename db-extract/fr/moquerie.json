        "fr-extract.jsonl": [
            {
                "entry_id": "7664ac53-1526-3d4e-814b-d13a74dbc5fb",
                "word": "moquerie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "36a160ba-0fd8-4ced-b61f-6476e54ce2f0",
                        "entry_id": "7664ac53-1526-3d4e-814b-d13a74dbc5fb",
                        "tags": [
