                ],
                "senses": [
                    {
                        "sense_id": "7714d25b-e84a-3c38-bee8-3fe8c73523bb",
                        "entry_id": "627a9207-31b3-312e-94b7-5147c5bfcbc0",
                        "glosses": [
                            "Scheibe aus Metall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a898a7d-2de2-48db-ac6b-729b40f8a1ab",
                                "sense_id": "7714d25b-e84a-3c38-bee8-3fe8c73523bb",
                                "text": "„Die Präger arbeiteten in Dreierteams: Die Signatores hielten den Stempel für die Rückseite der Münze (das Vorderseiten-Gegenstück war im Amboss eingelassen), die Suppostores legten die noch ungeprägte Metallscheibe, den Schrötling, in Position, und die Malliatores schlugen mit dem Hammer zu.“"
                            },
                            {
                                "example_id": "d2360a8f-ffcb-4d92-a643-1a27c807a5d3",
                                "sense_id": "7714d25b-e84a-3c38-bee8-3fe8c73523bb",
                                "text": "„Unter ihrem Arm klemmte ihre Kelle, ein polierter Holzstab, an dessen Ende eine runde Metallscheibe befestigt war, weiß lackiert mit orangenem Kern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
