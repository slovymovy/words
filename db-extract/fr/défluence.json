        "fr-extract.jsonl": [
            {
                "entry_id": "413768c6-5ca3-33ee-a9eb-295f505cafcb",
                "word": "défluence",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a50d2db3-8663-40c3-894c-a23113dd1188",
                        "entry_id": "413768c6-5ca3-33ee-a9eb-295f505cafcb",
                        "tags": [
                            "plural"
                        ],
                        "form": "défluences"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a3de752d-1d66-38d6-a9a5-354e71187242",
                        "entry_id": "413768c6-5ca3-33ee-a9eb-295f505cafcb",
                        "glosses": [
                            "Point de disjonction d'un flux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "456e7b6a-2bfc-4ac6-9be8-2b27fe53b2fd",
                                "sense_id": "a3de752d-1d66-38d6-a9a5-354e71187242",
                                "text": "Une défluence (on dit parfois un défluent) est un point particulier d’un réseau d’où partent plusieurs branches"
                            },
                            {
                                "example_id": "01a1a055-96d8-4510-b335-6ee1370310e1",
                                "sense_id": "a3de752d-1d66-38d6-a9a5-354e71187242",
                                "text": "L’eau arrivant à un tel point peut donc emprunter différents itinéraires pour continuer son cheminement. La distinction entre une défluence et une confluence n’est pertinente que si l’on considère le sens d'écoulement de l’eau. On parle parfois de bifurcation dans le cas d'une défluence avec deux branches aval. Une défluence peut ou non être intégrée dans une maille selon que les cheminements vont ou non se rejoindre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0adba077-db73-43da-8ce4-4d69b6722512",
                        "source_entry_id": "413768c6-5ca3-33ee-a9eb-295f505cafcb",
                        "source_sense_id": "a3de752d-1d66-38d6-a9a5-354e71187242",
                        "target_lang_word": "diffluence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diffluence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9bd445e5-7749-3cdb-a6e2-1395ec1b757c",
                                        "entry_id": "2996c794-0933-3b9a-8c2e-46018b59a1b1",
                                        "glosses": [
                                            "A flowing off on all sides; fluidity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47c175ad-d376-4ffc-8f4e-5faafa892372",
                                                "sense_id": "9bd445e5-7749-3cdb-a6e2-1395ec1b757c",
                                                "text": "The characteristics of the soils, vegetation, desert varnish, slope of the stream channel, and drainage texture are used to confirm the location of the primary diffluence."
                                            },
                                            {
                                                "example_id": "e194a574-5e0a-4f80-883b-e00e3ab3cbc6",
                                                "sense_id": "9bd445e5-7749-3cdb-a6e2-1395ec1b757c",
                                                "text": "Some of the sediment transported during runoff is deposited locally, and a lobe of deposited sediment is formed downstream from the diffluence."
                                            },
                                            {
                                                "example_id": "3da8e74e-0774-460f-894d-c6264689d33d",
                                                "sense_id": "9bd445e5-7749-3cdb-a6e2-1395ec1b757c",
                                                "text": "Usually, however, confluence is associated with an increase in air velocity and diffluence with a decrease. In the intermediate case, confluence is balanced by an increase in wind velocity and diffluence by a decrease in velocity."
                                            },
                                            {
                                                "example_id": "513420f6-dcee-4dd5-918e-c710e2b41462",
                                                "sense_id": "9bd445e5-7749-3cdb-a6e2-1395ec1b757c",
                                                "text": "This flow exhibits diffluence and stretching and hence divergence, but no curvature or shear and hence no vorticity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
