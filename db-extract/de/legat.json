                    {
                        "form_id": "310f5a71-8a99-4065-ae0d-29f7541bbb1f",
                        "entry_id": "0d0db4b9-02da-3ba2-8ab6-9de42db784f7",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Legaten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d7473740-a948-36cf-a870-c4d8cc76e7b7",
                        "entry_id": "0d0db4b9-02da-3ba2-8ab6-9de42db784f7",
                        "glosses": [
                            "römischer Gesandter im Range eines Unterfeldherrn"
                        ],
                        "tags": [
                            "Militärgeschichte",
                            "Römisches Reich"
                        ],
                        "examples": [
                            {
                                "example_id": "f1d72611-d4fa-43ef-a54e-4dbba75d7956",
                                "sense_id": "d7473740-a948-36cf-a870-c4d8cc76e7b7",
                                "text": "„Das Kommando führte ein oft aus politischen Gründen bestimmter Legat, dem sechs (zumeist sehr junge) Militärtribunen als Legionsstabsoffiziere beigegeben wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c695d59b-2a8f-3639-b54c-32ee6988729f",
                        "entry_id": "0d0db4b9-02da-3ba2-8ab6-9de42db784f7",
                        "glosses": [
                            "päpstlicher Gesandter (oft ein Kardinal mit einem päpstlichen Sonderauftrag)"
                        ],
                        "tags": [
                            "katholische Kirche"
                        ],
                        "examples": [
                            {
                                "example_id": "b894ff1e-f64a-4c3b-ba0f-17b7b4faf77f",
                                "sense_id": "c695d59b-2a8f-3639-b54c-32ee6988729f",
                                "text": "„Unter den Führern dieser Schar befanden sich Markgraf Albrecht und Bischof Anselm von Havelberg als päpstlicher Legat.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "26df2e98-ac5e-427b-8288-700b87a063da",
                        "source_entry_id": "0d0db4b9-02da-3ba2-8ab6-9de42db784f7",
                        "source_sense_id": "d7473740-a948-36cf-a870-c4d8cc76e7b7",
                        "source_sense_description": "Militärgeschichte, Römisches Reich: römischer Gesandter im Range eines Unterfeldherrn",
                        "target_lang_word": "legate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "legate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d582e00e-6934-3a4d-8532-48baa69bc5b0",
                                        "entry_id": "924f8a92-8692-335b-a17f-cd0809033059",
                                        "glosses": [
                                            "A deputy representing the pope, specifically a papal ambassador sent on special ecclesiastical missions."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1988ad6a-d8e4-3834-a951-997cf5e3500c",
                                        "entry_id": "924f8a92-8692-335b-a17f-cd0809033059",
                                        "glosses": [
                                            "An ambassador or messenger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68d10df5-9375-44d3-af20-672f725f2c2e",
                                                "sense_id": "1988ad6a-d8e4-3834-a951-997cf5e3500c",
                                                "text": "The dark figure on the raised white terrace; legate of the sun facing the sun; the most ancient royal power."
                                            },
                                            {
                                                "example_id": "8ab7f9bf-f96d-4bd4-8c03-3422445e82e4",
                                                "sense_id": "1988ad6a-d8e4-3834-a951-997cf5e3500c",
                                                "text": "Moſt great and puiſant Monarke of the earth,\nYour Baſſoe wil accompliſh your beheſt:\nAnd ſhew your pleaſure to the Perſean,\nAs fits the Legate of the ſtately Turke."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7e12c98-371c-3cb0-8614-0cb1d07d8cbe",
                                        "entry_id": "924f8a92-8692-335b-a17f-cd0809033059",
                                        "glosses": [
                                            "The deputy of a provincial governor or general in ancient Rome."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05b9b2ba-5b7d-4fd2-81a0-02347c4fe6f6",
                                                "sense_id": "d7e12c98-371c-3cb0-8614-0cb1d07d8cbe",
                                                "text": "Legate, I had the news last night—my cohort ordered home\nBy ships to Portus Itius and thence by road to Rome."
                                            }
                                        ]
                                    }
                                ]
                            },
