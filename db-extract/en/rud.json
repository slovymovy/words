                "senses": [
                    {
                        "sense_id": "478f765b-0fc6-3052-b2f0-5d11b03d5e14",
                        "entry_id": "d5e8d176-86f1-3217-aab0-58fe5e0ac3c1",
                        "glosses": [
                            "(engineering, euphemistic) Synonym of rapid unplanned disassembly: An unexpected explosion or breakup"
                        ],
                        "tags": [
                            "abbreviation",
                            "acronym",
                            "initialism"
                        ],
                        "examples": [
                            {
                                "example_id": "4715cdd4-e58e-4495-92fd-8c063803bf88",
                                "sense_id": "478f765b-0fc6-3052-b2f0-5d11b03d5e14",
                                "text": "Private spaceflight company SpaceX has released new pictures of its Falcon 9 rocket attempting to land on a floating platform in the Atlantic Ocean before undergoing what its chief executive, Elon Musk, euphemistically referred to as \"RUD\" – that’s \"Rapid Unscheduled Disassembly\". In other words, it blew up."
                            },
                            {
                                "example_id": "542a91ed-1c22-44c3-8855-b94b730812e1",
                                "sense_id": "478f765b-0fc6-3052-b2f0-5d11b03d5e14",
                                "text": "“Fuel header tank pressure was low during landing burn, causing touchdown velocity to be high & RUD, but we got all the data we needed!” he said in a tweet."
                            }
                        ]
                    }
                ],
