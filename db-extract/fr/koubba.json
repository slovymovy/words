                    {
                        "sense_id": "9faffd05-fbdc-3799-bba6-529109e83cb6",
                        "entry_id": "55649b8e-4a9a-3fef-b1ba-6ae8a8d0eaf0",
                        "glosses": [
                            "Au Maghreb, petit monument signalant l’emplacement de la tombe d’un personnage honoré."
                        ],
                        "tags": [
                            "Funéraire"
                        ],
                        "examples": [
                            {
                                "example_id": "0402077a-36e9-491d-a932-6cc504585f92",
                                "sense_id": "9faffd05-fbdc-3799-bba6-529109e83cb6",
                                "text": "Nous nous dirigeons vers l’interstice qui sépare les deux montagnes coniques vaguement entrevues hier. Celle de droite porte le nom d’un marabout, Sidi Nader, dont la koubba blanche se dresse à son sommet."
                            },
                            {
                                "example_id": "ddfaf804-f426-42db-9990-80962878dd43",
                                "sense_id": "9faffd05-fbdc-3799-bba6-529109e83cb6",
                                "text": "La koubba où le peintre a installé sa sépulture, de l’autre côté de l’oasis, était soigneusement entretenue et régulièrement visitée."
                            }
                        ]
                    }
