                                        "glosses": [
                                            "die historischen Umstände und Entwicklungen nicht beachtend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76bda61a-44ac-4fe2-af8d-36f5ea48a136",
                                                "sense_id": "0cdd4891-1d48-326e-9041-4ff3823e164c",
                                                "text": "„Die Szene ist frei erfunden. Ihre Aussage ist unhistorisch. Dass innenpolitische Rivalitäten bis zum Landesverrat gehen konnten, ist eine groteske Verdrehung der Realität.“"
