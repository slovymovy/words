                "senses": [
                    {
                        "sense_id": "449f642d-5a92-375c-8c9c-f44c3f749c8e",
                        "entry_id": "e9ad4a00-59a6-3a0e-a65d-66656356034b",
                        "glosses": [
                            "Relatif à l'étymologie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f02de163-e9e3-42ea-87b9-39e018eed653",
                                "sense_id": "449f642d-5a92-375c-8c9c-f44c3f749c8e",
                                "text": "Il existe en Bretagne plus d'un Pen ar pont, qui ne signifie pas autre chose que « Bout du Pont » […]. La suppression de l’article ar ne serait pas pour effrayer mon audace étymologiste, pas plus dans Paimpont que dans Paimpol ou Penpoul."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "6bbcee3f-76bd-45f7-872e-c147982df0ed",
                        "source_entry_id": "e9ad4a00-59a6-3a0e-a65d-66656356034b",
                        "source_sense_ids": [
                            "449f642d-5a92-375c-8c9c-f44c3f749c8e"
