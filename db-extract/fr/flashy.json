                    {
                        "translation_id": "932d83b8-8243-44e8-963e-a803c55ea6fc",
                        "source_entry_id": "b40c904f-a4ab-3491-8c36-9fe6e84afc67",
                        "source_sense_id": "e1ad3916-358b-3692-b901-1e06422ef5e6",
                        "source_sense_description": "von Farben: ins Auge fallend; grell, knallig, schrill",
                        "target_lang_word": "schrill",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schrill",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "521145ad-6736-35bb-8265-6741fbaca60c",
                                        "entry_id": "b76efef5-c325-3ca9-8c86-1c522445d5b7",
                                        "glosses": [
                                            "optisch oder akustisch hell, grell, durchdringend; unangenehm für Auge oder Ohr"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2e2ac77-f2d9-4f02-941b-60a60016fec6",
                                                "sense_id": "521145ad-6736-35bb-8265-6741fbaca60c",
                                                "text": "„Im Hochsommer sind die geselligen Vögel im Luftraum über den Städten mit ihren schrillen Rufen sehr auffällig.“"
                                            },
                                            {
                                                "example_id": "6ee509da-67f0-448f-956c-4ac651d6421e",
                                                "sense_id": "521145ad-6736-35bb-8265-6741fbaca60c",
                                                "text": "„Vegetabile Formen, Fabelwesen, große Tiere und kleine Menschen bevölkern einen Kosmos in schrillen Leuchtfarben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5986561a-a16d-37c8-af54-56e9ff63ee72",
                                        "entry_id": "b76efef5-c325-3ca9-8c86-1c522445d5b7",
                                        "glosses": [
                                            "in Aussehen oder Verhalten auffallend, exzentrisch, ungewöhnlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "630d9dd5-d71e-4706-b2c5-d1b30098e5f8",
                                                "sense_id": "5986561a-a16d-37c8-af54-56e9ff63ee72",
                                                "text": "„In seinen Stücken entwarf er eine desillusionierende bis pessimistische Weltsicht mit teilweise schrillen Szenen.“"
                                            },
                                            {
                                                "example_id": "3120959f-74e7-41ca-b953-e7eb7e752a9a",
                                                "sense_id": "5986561a-a16d-37c8-af54-56e9ff63ee72",
                                                "text": "„Die Band fiel insbesondere durch schrilles Outfit auf den Plattencovern auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
