                "senses": [
                    {
                        "sense_id": "32ce5a00-6588-3517-aef9-80ce73029506",
                        "entry_id": "8cb113c9-eee9-319e-9567-bf15a8250acb",
                        "glosses": [
                            "gebratenes Fleisch, das von einem Huhn stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a63fd251-247c-4f23-9932-3a3f9223ce79",
                                "sense_id": "32ce5a00-6588-3517-aef9-80ce73029506",
                                "text": "„Auch hier kommt der Wirt mit einem lebenden Huhn zu uns, das er uns zum Mittagessen anbietet, und wir stimmen ihm mit Kopfnicken bei, daß Hühnerbraten etwas Gutes sei.“"
                            },
                            {
                                "example_id": "361ce4c6-a907-4e85-9262-4d8cd669a9b8",
                                "sense_id": "32ce5a00-6588-3517-aef9-80ce73029506",
                                "text": "„Ein Mann versteckt den Hühnerbraten, als sein Vater vorbeikommt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
