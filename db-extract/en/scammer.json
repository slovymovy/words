                                                "example_id": "1ef02153-03ad-4b28-b4db-dbcba3efe741",
                                                "sense_id": "091da3fb-d8f3-304a-9457-17904b9fb7a3",
                                                "text": "Beim Kartenspiel achte vor allem auf die Schwindler."
                                            }
