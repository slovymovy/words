                "senses": [
                    {
                        "sense_id": "1dac0532-8539-34fa-8bd2-557f18dc8819",
                        "entry_id": "9e8fdcfd-d663-3942-9966-a04df296a177",
                        "glosses": [
                            "Instrument qui mesure la quantité d’eau de pluie tombée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "834ee782-1093-4612-ba7e-cc9be42da04c",
                                "sense_id": "1dac0532-8539-34fa-8bd2-557f18dc8819",
                                "text": "Le pluviomètre est généralement relevé une fois par jour (en Suisse, tous les matins à 7h30)."
                            }
                        ]
                    },
                    {
                        "sense_id": "525a25db-876e-31e3-9463-5fc5128d8ad7",
                        "entry_id": "9e8fdcfd-d663-3942-9966-a04df296a177",
                        "glosses": [
                            "Ce qui enregistre les précipitations."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "16800bae-d4bb-4e53-9449-277b1de8f26c",
                                "sense_id": "525a25db-876e-31e3-9463-5fc5128d8ad7",
                                "text": "À deux reprises, coïncidant justement avec les deux extensions glaciaires, la hauteur des lacs, véritables pluviomètres de l’époque, a passé par un maximum."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f0d85588-f98d-47be-b868-54dbba0b816a",
                        "source_entry_id": "9e8fdcfd-d663-3942-9966-a04df296a177",
                        "source_sense_description": "Instrument qui mesure la quantité d’eau de pluie",
                        "target_lang_word": "Regenmesser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Regenmesser",
