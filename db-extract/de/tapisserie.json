                        "examples": [
                            {
                                "example_id": "bb37d546-8737-4e10-b5d6-a598e5fbbeaf",
                                "sense_id": "ad86e1bb-66d1-3864-9396-d19b4e417a06",
                                "text": "Die Tapisserie zeigt auf 70 Metern die Eroberung Englands."
                            },
                            {
                                "example_id": "088247b7-136d-4a29-848d-5bb3b2556415",
                                "sense_id": "ad86e1bb-66d1-3864-9396-d19b4e417a06",
                                "text": "„Sie war verblaßt zu einer Figur in der Tapisserie des Freundeskreises.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "19c7dd6c-dacc-3b73-ac20-61b1d75858ce",
                        "entry_id": "6e9b63b8-34ba-35c3-992a-2ff67b46127b",
                        "glosses": [
                            "Buntstickerei auf gitterartigem Grundgewebe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e67e3d1f-ccae-4534-ae8c-276f7b4dd454",
                                "sense_id": "19c7dd6c-dacc-3b73-ac20-61b1d75858ce",
                                "text": "Bei dieser Tapisserie wird ein Blumenmotiv mit farbigen Garnen ausgestickt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "3a09ccae-72be-3643-aa50-a3ae99dd5926",
