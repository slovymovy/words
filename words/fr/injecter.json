                },
                {
                    "sense_id": "e243b695-079a-3d60-9ba5-5ba84b909436",
                    "sense_definition": "Introduire une matière colorante ou un liquide conservateur dans les vaisseaux d'un cadavre pour l'embaumement ou la dissection anatomique.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'anatomiste a commencé par <w>injecter</w> une résine colorée dans les artères du spécimen."
                        },
                        {
                            "text": "Avant de procéder à la dissection, il faut <w>injecter</w> les tissus pour les préserver."
