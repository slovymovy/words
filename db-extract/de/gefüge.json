                ],
                "senses": [
                    {
                        "sense_id": "e04b50e8-856e-3934-ad91-e9938e58acac",
                        "entry_id": "2dd22d9b-e20b-38eb-9a91-ac468162c71f",
                        "glosses": [
                            "Gebilde und die Art und Weise, wie es zusammenhängt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef299ea5-43e3-493a-b7c3-c5537cb62735",
                                "sense_id": "e04b50e8-856e-3934-ad91-e9938e58acac",
                                "text": "Das Verhalten des Menschen im sozialen Gefüge wird als Sozialverhalten bezeichnet."
                            },
                            {
                                "example_id": "3c224b13-2cc4-4b31-a5ed-b5a782c8acee",
                                "sense_id": "e04b50e8-856e-3934-ad91-e9938e58acac",
                                "text": "Nach der Abkühlung wird das Gefüge sehr spröde und somit anfällig gegen mechanische Beanspruchung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a485d331-8fba-4c2e-a31b-e7a55590d6cc",
                        "source_entry_id": "2dd22d9b-e20b-38eb-9a91-ac468162c71f",
                        "source_sense_id": "e04b50e8-856e-3934-ad91-e9938e58acac",
                        "source_sense_description": "Gebilde und die Art und Weise, wie es zusammenhängt",
                        "target_lang_word": "structure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "structure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3ad572f2-1121-31a3-a7f5-93f0435b208d",
                                        "entry_id": "8e8c682b-d765-367e-a2f9-c4dd3ea9f1a3",
                                        "glosses": [
                                            "Ossature porteuse d’un édifice bâti, d'une construction mécanique."
                                        ],
                                        "tags": [
                                            "Génie civil"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6dee152-3793-47e6-a22e-d44ca84494f6",
                                                "sense_id": "3ad572f2-1121-31a3-a7f5-93f0435b208d",
                                                "text": "Posée sur douze vérins en appui sur la structure de la tour, la plate-forme de déconstruction permet à des engins de petite taille pourvus de pince de grignotage d’intervenir, avec un faible impact environnemental."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c908d02-6412-32a0-803a-b9db26aff6f3",
                                        "entry_id": "8e8c682b-d765-367e-a2f9-c4dd3ea9f1a3",
                                        "glosses": [
                                            "Organisation des constituants d’un système, architecture."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef780f2e-8f2b-4927-b80f-38b038c6f45f",
                                                "sense_id": "0c908d02-6412-32a0-803a-b9db26aff6f3",
                                                "text": "L’humus qui, lié aux argiles, contribue à la qualité de la structure des sols et à leur fertilité, résulte de la transformation de la matière organique."
                                            },
                                            {
                                                "example_id": "0f20acc6-87a1-451e-b78b-ef8a854d867a",
                                                "sense_id": "0c908d02-6412-32a0-803a-b9db26aff6f3",
                                                "text": "On peut en conclure que les perméants hydrophiles utilisés ne donnent pas lieu à une adsorption sensible sur les structures musculaires (auquel cas R aurait une tendance à augmenter dans le domaine des concentrations faibles)."
                                            },
                                            {
                                                "example_id": "002dec7d-6f93-4dbd-a44c-9cc7c18fb9d0",
                                                "sense_id": "0c908d02-6412-32a0-803a-b9db26aff6f3",
                                                "text": "La structure d’un discours, d’un poème."
                                            },
                                            {
                                                "example_id": "f3abb316-6222-4004-817a-08e3ca56f9c2",
                                                "sense_id": "0c908d02-6412-32a0-803a-b9db26aff6f3",
                                                "text": "La structure du parti communiste tchécoslovaque est fondée sur des cellules locales, fédérées au niveau cantonal puis régional."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9f302e0-0534-3c21-b6c6-4ded5ff4e940",
                                        "entry_id": "8e8c682b-d765-367e-a2f9-c4dd3ea9f1a3",
                                        "glosses": [
                                            "Ensemble combiné avec un ou plusieurs objets relatifs à cet ensemble (comme des lois de composition), satisfaisant un certain nombre de propriétés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53f366ae-cb6d-48c6-934b-fffd433726f6",
                                                "sense_id": "a9f302e0-0534-3c21-b6c6-4ded5ff4e940",
                                                "text": "Une structure algébrique."
                                            },
                                            {
                                                "example_id": "8ec91b34-a2bb-490e-b46f-ee597d775c2d",
                                                "sense_id": "a9f302e0-0534-3c21-b6c6-4ded5ff4e940",
                                                "text": "La structure de groupe."
                                            },
                                            {
                                                "example_id": "03ea2de8-f96d-48ff-abbd-6cfeeb22888c",
                                                "sense_id": "a9f302e0-0534-3c21-b6c6-4ded5ff4e940",
                                                "text": "structure différentielle"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f792957b-f6ae-316a-9b63-bf1ea84032a9",
                                        "entry_id": "8e8c682b-d765-367e-a2f9-c4dd3ea9f1a3",
                                        "glosses": [
                                            "Organisation du réseau régulier de maillons élémentaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5461c401-c6c2-4502-9264-4fbc819d2140",
                                                "sense_id": "f792957b-f6ae-316a-9b63-bf1ea84032a9",
                                                "text": "La structure d'un cristal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a435ddeb-980f-3e7c-89b7-8aac5178134f",
                                        "entry_id": "8e8c682b-d765-367e-a2f9-c4dd3ea9f1a3",
                                        "glosses": [
                                            "Arrangement, agencement, organisation entre différents éléments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77714f6b-61e0-4cff-a02a-6611a9215684",
                                                "sense_id": "a435ddeb-980f-3e7c-89b7-8aac5178134f",
                                                "text": "La structure d'une entreprise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "433c3675-7730-36e2-a2c9-bc76290154fb",
                                        "entry_id": "8e8c682b-d765-367e-a2f9-c4dd3ea9f1a3",
                                        "glosses": [
                                            "Ensemble formel de relations, idée centrale du paradigme épistémologique structuraliste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f8ce411-6389-4133-8789-89cb4775ab9f",
                                                "sense_id": "433c3675-7730-36e2-a2c9-bc76290154fb",
                                                "text": "La structure de l'ensemble ne sort jamais indemne de la modification d'une de ses parties."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64d319ca-855c-3099-b805-fe7d5a609f7f",
                                        "entry_id": "8e8c682b-d765-367e-a2f9-c4dd3ea9f1a3",
                                        "glosses": [
                                            "Harmonie globale."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c257c10e-6c1c-497d-87c1-6f075fe47c7a",
                                                "sense_id": "64d319ca-855c-3099-b805-fe7d5a609f7f",
                                                "text": "La structure d'un vin est son aptitude, en bouche, à solliciter harmonieusement l'ensemble des récepteurs sensoriels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08747817-5c42-3e31-8801-3253ed4c96f4",
                                        "entry_id": "8e8c682b-d765-367e-a2f9-c4dd3ea9f1a3",
                                        "glosses": [
                                            "Proportions des différents âges, diamètres ou catégories des arbres dans une forêt traitée en futaie irrégulière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba16c0f5-c88a-4492-88c1-deb35d32bc35",
                                                "sense_id": "08747817-5c42-3e31-8801-3253ed4c96f4",
                                                "text": "Leur application est toutefois modulée en fonction de la structure et du capital des peuplements en place qui peuvent être assez éloignés de l’équilibre que sous-entend la mise en œuvre de ce traitement."
                                            }
                                        ]
                                    }
                                ]
                            },
