                        "examples": [
                            {
                                "example_id": "e88e0d51-482e-4e10-95e9-88d718c72e9d",
                                "sense_id": "83cf852f-512b-3ead-8261-1562b6955694",
                                "text": "En cas de fissure, par exemple, il a une capacité à s’autocicatriser », précise Jacques-Henri Losfelt, ingénieur du projet."
                            },
                            {
                                "example_id": "7032dc06-3c75-4085-b79a-63507db2e0d4",
                                "sense_id": "83cf852f-512b-3ead-8261-1562b6955694",
                                "text": "Il faut donc inventer dès maintenant, des instruments de sécurité, opérés par des instances légales comme un dispositif réticulaire robuste qui s’autocicatrise en rétrécissant ses tuyaux automatiquement afin de ne véhiculer que les messages urgents, et qui se protège en ripostant de manière graduée par des contre-attaques."
                            }
                        ]
                    }
