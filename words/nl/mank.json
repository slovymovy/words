                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Waarom <w>mank</w> je zo erg vandaag?",
                            "target_lang_translations": {
                                "en": "Why are you <w>limping</w> so badly today?",
                                "ru": "Почему ты сегодня так сильно <w>хромаешь</w>?",
                                "de": "Warum <w>hinkst</w> du heute so sehr?"
                            }
                        },
                        {
                            "text": "<w>Mank</w> je nog steeds na die val van gisteren?",
                            "target_lang_translations": {
                                "en": "Are you still <w>limping</w> after that fall yesterday?",
                                "ru": "Ты все еще <w>хромаешь</w> после вчерашнего падения?",
                                "de": "<w>Hinkst</w> du nach dem Sturz gestern immer noch?"
                            }
                        }
