                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verbaliser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4b122547-38d8-310f-95eb-498c100acc56",
                                        "entry_id": "dc23edee-ffa6-3b18-bf63-923d97c8d6d0",
                                        "glosses": [
                                            "Énoncer des raisons ou des faits pour les faire mettre dans un procès-verbal."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3bcb355e-5b11-36a9-a512-8e66d35f41d4",
                                        "entry_id": "dc23edee-ffa6-3b18-bf63-923d97c8d6d0",
                                        "glosses": [
                                            "Dresser un procès-verbal (constat d'infraction)."
                                        ],
                                        "tags": [
                                            "France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfa490b2-8ae0-4a33-9988-9bdcbd6f6a7b",
                                                "sense_id": "3bcb355e-5b11-36a9-a512-8e66d35f41d4",
                                                "text": "En prison le bal et les violons ; un maire verbalise ; un procureur du roi voit là dedans des complots"
                                            },
                                            {
                                                "example_id": "d56b4258-b9fe-441d-8cf5-d9125bcbbf73",
                                                "sense_id": "3bcb355e-5b11-36a9-a512-8e66d35f41d4",
                                                "text": "D’autres voix s’élevèrent, on tombait d’accord sur l’idée d’un suicide, pendant que le sergent de ville verbalisait."
                                            },
                                            {
                                                "example_id": "98db27f2-84bd-4a71-8b92-679f9927b3df",
                                                "sense_id": "3bcb355e-5b11-36a9-a512-8e66d35f41d4",
                                                "text": "Les gendarmes du Lot racontent sur Facebook que leur brigade a verbalisé la conductrice d’une Twingo pour non-validité du contrôle technique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6802e4b-a175-33bf-8079-9cc1682c4cce",
                                        "entry_id": "dc23edee-ffa6-3b18-bf63-923d97c8d6d0",
                                        "glosses": [
                                            "Faire de grands discours inutiles et qui n’aboutissent à rien."
                                        ],
                                        "tags": [
                                            "dated",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1568262-7008-4512-b635-15c3a1e8dda4",
                                                "sense_id": "b6802e4b-a175-33bf-8079-9cc1682c4cce",
                                                "text": "Il y a longtemps qu’il ne fait que verbaliser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c71f0204-3c6e-3d4a-8f7e-7e44e80c2235",
                                        "entry_id": "dc23edee-ffa6-3b18-bf63-923d97c8d6d0",
                                        "glosses": [
                                            "Exprimer sous forme de mots."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3586c114-549a-4336-b07e-44ff94538eb2",
                                                "sense_id": "c71f0204-3c6e-3d4a-8f7e-7e44e80c2235",
                                                "text": "Prendre conscience des faits qui t'ont marqué, et de leurs conséquences sensibles, est donc une première étape. Verbaliser ce que tu as vécu, le couler dans des mots, en est une deuxième très importante."
                                            },
                                            {
                                                "example_id": "6b4c0fb5-6665-46be-91ef-8f0e10df7494",
                                                "sense_id": "c71f0204-3c6e-3d4a-8f7e-7e44e80c2235",
                                                "text": "Au bout d'un moment je la vis commencer à grelotter, mais incapable de verbaliser sa sensation de froid et incapable de me demander de fermer la fenêtre."
                                            },
                                            {
                                                "example_id": "b05bf469-bece-4891-8c8b-10a8002cad7b",
                                                "sense_id": "c71f0204-3c6e-3d4a-8f7e-7e44e80c2235",
                                                "text": "Il doit savoir que vous l'aimez. Alors, n'hésitez pas à le verbaliser, et répétez-lui souvent que vous serez toujours là pour le soutenir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91b27744-cb6e-381b-9a48-d522787627f5",
                                        "entry_id": "dc23edee-ffa6-3b18-bf63-923d97c8d6d0",
                                        "glosses": [
                                            "Créer un verbe par dérivation à partir d'un autre mot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95d676d7-5126-44bd-8ad8-6a842556c2b8",
                                                "sense_id": "91b27744-cb6e-381b-9a48-d522787627f5",
                                                "text": "En verbalisant l'acronyme PACS, on obtient le verbe pacser."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
