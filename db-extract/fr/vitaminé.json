                    {
                        "sense_id": "9acbc667-6956-3afa-b565-23ba1c52bba7",
                        "entry_id": "f4b6f7f6-6999-310a-be09-8c7a32875a8e",
                        "glosses": [
                            "Qui contient des vitamines, soit naturellement, soir parce qu’elles ont été rajoutées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "762e3d9a-ef3e-42a0-9224-91904bb4b155",
                                "sense_id": "9acbc667-6956-3afa-b565-23ba1c52bba7",
                                "text": "Le Secours national livrait aux écoles des gâteaux vitaminés et une pastille rose que les gosses avalaient et qui était censés donner les vitamines nécessaires à la croissance."
                            }
                        ]
                    },
                    {
                        "sense_id": "c3b4bc8f-e0c3-3f13-b9f5-f125f9550ffb",
                        "entry_id": "f4b6f7f6-6999-310a-be09-8c7a32875a8e",
                        "glosses": [
                            "Qui donne une impression de dynamisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3bb7bfd-0909-419f-8c64-bada24d2a7f1",
                                "sense_id": "c3b4bc8f-e0c3-3f13-b9f5-f125f9550ffb",
                                "text": "Cet amoureux de la pop culture offre une reconstitution soignée des bas-fonds parisiens, mais n’hésite pas à jouer la carte de l’anachronisme, notamment pour la bande-son, où l’on reconnaît, par exemple, Johnny Hallyday, Patrick Coutin ou une partition vitaminée signée Yves Gourmeur."
                            }
                        ]
                    }
