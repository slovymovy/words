                "senses": [
                    {
                        "sense_id": "8c896283-e02f-34e9-859c-633ff3ac0ad1",
                        "entry_id": "3afcce1c-f918-3dd9-b069-cb617b375bf9",
                        "glosses": [
                            "Donner un caractère shakespearien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e155d0c-f256-4259-9f81-d6acaf9e7c74",
                                "sense_id": "8c896283-e02f-34e9-859c-633ff3ac0ad1",
                                "text": "Or « virgilianiser » Shakespeare ou « shakespearianiser » Virgile pose le problème de fonder un style uni."
                            },
                            {
                                "example_id": "a861f539-c5b8-45cc-acee-d9253e814f53",
                                "sense_id": "8c896283-e02f-34e9-859c-633ff3ac0ad1",
                                "text": "Après avoir évoqué Shakespeare à Orange, avec Gunsbourg, elle a voulu cette fois shakespearianiser Versailles en y faisant représenter à sa manière Un Songe d’une nuit d’été."
                            }
                        ]
                    }
