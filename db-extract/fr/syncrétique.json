        "fr-extract.jsonl": [
            {
                "entry_id": "ee44ab7c-f013-3212-adf3-7210c80575a1",
                "word": "syncrétique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "52764b7a-2478-41f5-84fd-6d0d9dc64063",
                        "entry_id": "ee44ab7c-f013-3212-adf3-7210c80575a1",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "syncrétiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e34cc69c-640a-36e3-a647-9b2a5a8dde5b",
                        "entry_id": "ee44ab7c-f013-3212-adf3-7210c80575a1",
                        "glosses": [
                            "Relatif au syncrétisme, issu de la fusion de différents cultes, religions ou doctrines philosophiques, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1dfd893-9260-411b-8094-0dc6205f8921",
                                "sense_id": "e34cc69c-640a-36e3-a647-9b2a5a8dde5b",
                                "text": "Cette religion est un mélange syncrétique de chamanisme animiste et de polythéisme."
                            },
                            {
                                "example_id": "e88f7c9d-c3c6-4314-ac52-fc9701b01549",
                                "sense_id": "e34cc69c-640a-36e3-a647-9b2a5a8dde5b",
                                "text": "Quand on parle du Vaudou comme culte syncrétique, on évoque généralement un assemblage d’éléments du catholicisme mal compris, et d’éléments de religions africaines qui persisteraient ici et là dans les campagnes haïtiennes."
                            }
                        ]
                    },
                    {
                        "sense_id": "c376cc57-fdf6-3f4d-a903-edd1cc4d7a3c",
                        "entry_id": "ee44ab7c-f013-3212-adf3-7210c80575a1",
                        "glosses": [
                            "Qui fusionne plusieurs genres, plusieurs cultures."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "629489a7-aad8-4b95-9c49-2fa40be9fb0c",
                                "sense_id": "c376cc57-fdf6-3f4d-a903-edd1cc4d7a3c",
                                "text": "L'Asie mineure était alors [au Iᵉʳsiècle] le théâtre d'un étrange mouvement de philosophie syncrétique. — (Renan, Vie Jésus, 1863, p. LXXI)"
                            },
                            {
                                "example_id": "27dbb438-b31a-46ca-bdc6-827649edda3a",
                                "sense_id": "c376cc57-fdf6-3f4d-a903-edd1cc4d7a3c",
                                "text": "[…] Les deux sœurs distillent une musique syncrétique et s’appuient sur une formation classique, commencée dès l’âge de 7 ans dans les conservatoires de Paris : piano pour Lisa, percussions classiques pour Naomi – qui s’est ensuite passionnée pour le cajon, caisse sud-américaine, et le bata, tambour traditionnel yoruba."
                            }
                        ]
                    },
                    {
                        "sense_id": "f1855247-5878-37b5-aafd-38bf8b4699b6",
                        "entry_id": "ee44ab7c-f013-3212-adf3-7210c80575a1",
                        "glosses": [
                            "Global, indifférencié."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "749c97b1-0e65-4136-bfd6-1d412d811058",
                                "sense_id": "f1855247-5878-37b5-aafd-38bf8b4699b6",
                                "text": "Une vision syncrétique du monde."
                            }
                        ]
                    },
                    {
                        "sense_id": "d29d080a-92ac-33b6-b7f2-77c2ee8be32d",
                        "entry_id": "ee44ab7c-f013-3212-adf3-7210c80575a1",
                        "glosses": [
                            "Qui fusionne plusieurs idéologies, généralement qui mélange celles de gauche et de droite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ff9f32f-88fb-4530-b02d-03b0d456d98a",
                                "sense_id": "d29d080a-92ac-33b6-b7f2-77c2ee8be32d",
                                "text": "Le national-bolchévisme est parfois considéré comme une idéologie syncrétique du nationalisme et du bolchévisme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "49e0bf08-a9c5-4bc4-bcd9-1934ce570bf3",
                        "source_entry_id": "ee44ab7c-f013-3212-adf3-7210c80575a1",
                        "target_lang_word": "syncretic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "syncretic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49b5624e-63d9-3a17-930c-f462ce88b840",
                                        "entry_id": "2bd1c16a-ab6d-377d-8165-e4747acc4ac4",
                                        "glosses": [
                                            "Combining disparate elements in one system, especially as in forms of religious observance, philosophical systems, or artistic creations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32e5b54d-34d9-468e-a2a5-824e89abc0c3",
                                                "sense_id": "49b5624e-63d9-3a17-930c-f462ce88b840",
                                                "text": "In Islamic villages below Tengger, however, more syncretic communities still celebrate annual village ritual festivals (slametan desa, slametan tuyo) designed to give homage to the spirits of the mountains and insure the flow of their waters."
                                            },
                                            {
                                                "example_id": "210ec59c-fa0e-4818-b5b0-a38938d8bc1a",
                                                "sense_id": "49b5624e-63d9-3a17-930c-f462ce88b840",
                                                "text": "1999, John B. Henderson, Imagining Boundaries: Changing Confucian Doctrines, Texts, and Hermeneutics, Kai-wing Chow, On Cho Ng, John B. Henderson (editors), Imagining Boundaries: Changing Confucian Doctrines, Texts, and Hermeneutics, State University of New York Press, page 112,\nFrom the point of view of many late Ming and Ch'ing scholars, the most syncretic, as well as the most threatening heretic of all was a nominal Confucian, Wang Yang-ming (1472-1528)."
                                            },
                                            {
                                                "example_id": "e001dcbf-517a-43f5-8b62-f3b15673a922",
                                                "sense_id": "49b5624e-63d9-3a17-930c-f462ce88b840",
                                                "text": "To cite another obvious case, there can be few things more syncretic than Roman Catholic canon law, where the doctrine of a Galilean peasant was built into Roman imperial legality."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c07b9c27-ab90-42b7-8672-12ea2b8c7421",
