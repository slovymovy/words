                                        "entry_id": "e0394ac7-8b8a-3f75-8264-3500f262b0f9",
                                        "glosses": [
                                            "varkensachtig hoefdier uit het geslacht Babyrousa, dat op Celebes en naburige eilanden voorkomt"
                                        ],
                                        "tags": [
                                            "evenhoevigen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b22ac6a-b131-48eb-b448-faa4ba86476c",
                                                "sense_id": "e0ae60cb-d185-3e27-9b3b-5f765281c7da",
                                                "text": "Toen Piso de boeken van Bontius over de tropische geneeskunst uitgaf en daarbij de schedel van een babiroesa of hertzwijn nodig had (het dier kwam alleen voor op Celebes of het eiland Buru), leende hij zo'n schedel van Swammerdam."
                                            }
                                        ]
