                                        "sense_id": "34abad5c-bcb7-3296-8965-223b0fece148",
                                        "entry_id": "21822c08-a006-36b9-a615-9de110686a80",
                                        "glosses": [
                                            "Zeitpunkt der letzten spontanen Regelblutung in den Wechseljahren der Frau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc396170-7761-4899-a9c9-edc8947670a5",
                                                "sense_id": "34abad5c-bcb7-3296-8965-223b0fece148",
                                                "text": "Der Zeitpunkt der Menopause lag zwischen 6 und 36 Monaten zurück."
                                            },
                                            {
                                                "example_id": "2edd2bd3-e00b-4457-b396-ae6dc1c6a7c7",
                                                "sense_id": "34abad5c-bcb7-3296-8965-223b0fece148",
                                                "text": "Als letzte Regel = Menopause ist diejenige Blutung anzusehen, nach der, retrospektiv betrachtet, ein Jahr lang keine Blutung mehr auftrat."
                                            },
                                            {
                                                "example_id": "df180cd5-af9e-46aa-be3f-be828e588068",
                                                "sense_id": "34abad5c-bcb7-3296-8965-223b0fece148",
                                                "text": "Durch die Menopause wird das Klimakterium in einen prä- und einen postmenopausalen Abschnitt untergliedert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
