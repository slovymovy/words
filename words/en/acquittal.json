{
    "word_family": [
        "acquit",
        "acquittance"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8e1dc5db-aa05-3a7d-94fc-43c3f7ce356c",
                    "sense_definition": "A legal decision in a court of law stating that someone is not guilty of a crime.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jury returned a full <w>acquittal</w> after reviewing all the evidence presented by the defense. ",
                            "target_lang_translations": {
                                "tr": "Jüri, savunma tarafından sunulan tüm kanıtları inceledikten sonra tam bir <w>beraat</w> kararı verdi."
                            }
                        },
                        {
                            "text": "His lawyer fought hard to win an <w>acquittal</w> for the client in the trial.",
                            "target_lang_translations": {
                                "tr": "Avukatı, duruşmada müvekkili için bir <w>beraat</w> kararı almak adına çok çabaladı."
                            }
                        }
                    ],
                    "synonyms": [
                        "exoneration",
                        "absolution",
                        "discharge"
                    ],
                    "antonyms": [
                        "conviction",
                        "condemnation"
                    ],
                    "common_phrases": [
                        "win an acquittal",
                        "full acquittal",
                        "court acquittal"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir mahkemede bir kişinin suçsuz olduğuna dair verilen hukuki karar."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "beraat",
                                "target_lang_sense_clarification": "mahkeme kararıyla suçsuz bulunma"
                            },
                            {
                                "target_lang_word": "aklanma",
                                "target_lang_sense_clarification": "suçlamalardan temize çıkma"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0041695-9f09-39f0-bde9-2fcfce16110e",
                    "sense_definition": "The performance or fulfillment of a duty, responsibility, or obligation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her successful <w>acquittal</w> of her duties earned her great respect among her colleagues.",
                            "target_lang_translations": {
                                "tr": "Görevlerini başarıyla <w>yerine getirmesi</w>, meslektaşları arasında büyük saygı kazanmasını sağladı."
                            }
                        },
                        {
                            "text": "He demonstrated an admirable <w>acquittal</w> of his responsibilities during the crisis.",
                            "target_lang_translations": {
                                "tr": "Kriz sırasında sorumluluklarını takdire şayan bir şekilde <w>ifa etti</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "discharge",
                        "performance",
                        "fulfillment"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir görevin, sorumluluğun veya yükümlülüğün yerine getirilmesi."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yerine getirme",
                                "target_lang_sense_clarification": "görevi veya sorumluluğu ifa etme"
                            },
                            {
                                "target_lang_word": "ifa",
                                "target_lang_sense_clarification": "bir yükümlülüğü tamamlama"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f37fd746-eb73-382a-8604-57a3c68105b0",
                    "sense_definition": "The clearance or settlement of a financial debt or obligation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The document provided official proof of the <w>acquittal</w> of the outstanding debt.",
                            "target_lang_translations": {
                                "tr": "Belge, ödenmemiş borcun <w>kapatıldığının</w> resmi kanıtını sağladı."
                            }
                        },
                        {
                            "text": "They demanded immediate <w>acquittal</w> of the loan before releasing the property.",
                            "target_lang_translations": {
                                "tr": "Mülkü serbest bırakmadan önce kredinin derhal <w>ödenmesini</w> talep ettiler."
                            }
                        }
                    ],
                    "synonyms": [
                        "acquittance",
                        "settlement",
                        "clearance"
                    ],
                    "target_lang_definitions": {
                        "tr": "Mali bir borcun veya yükümlülüğün ödenmesi veya kapatılması."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "borç kapatma",
                                "target_lang_sense_clarification": "finansal borcun tamamen ödenmesi"
                            },
                            {
                                "target_lang_word": "ibra",
                                "target_lang_sense_clarification": "borçtan kurtulma veya borcun silinmesi"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}