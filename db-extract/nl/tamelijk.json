                    {
                        "translation_id": "2a723486-4513-4370-b7ae-ef19da3c275c",
                        "source_entry_id": "ed9071da-17bd-395b-a206-f235a0302a06",
                        "source_sense_id": "e8ba0a4f-b340-367f-9ed1-a11f18e986c5",
                        "source_sense_description": "nogal, in relatief grote mate",
                        "target_lang_word": "assez",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assez",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "01674903-14e0-3a0d-a6ca-30e54741962e",
                                        "entry_id": "35ccdbc9-2cf6-3424-b4f3-454cdf9ddcfd",
                                        "glosses": [
                                            "Suffisamment, d'une quantité adéquate, suffisante ou tolérable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20d0f059-a8cd-4941-a248-450a30924cfb",
                                                "sense_id": "01674903-14e0-3a0d-a6ca-30e54741962e",
                                                "text": "Bert se hâta de les suivre, mais il lui fut impossible d’avancer assez vite et assez subrepticement pour surprendre en quel endroit ils avaient caché les vivres."
                                            },
                                            {
                                                "example_id": "87426089-8353-4b15-8dae-4c910e68d70d",
                                                "sense_id": "01674903-14e0-3a0d-a6ca-30e54741962e",
                                                "text": "C’est assez, cela suffit ! — Vous n’en avez jamais assez, vous êtes insatiables !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b2560b8-a19f-33a4-945a-94926493e578",
                                        "entry_id": "35ccdbc9-2cf6-3424-b4f3-454cdf9ddcfd",
                                        "glosses": [
                                            "Suffisamment nombreux. Une quantité suffisante de."
                                        ],
                                        "tags": [
                                            "Avec de"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "026f84b3-32ed-4250-ab02-91675b143408",
                                                "sense_id": "6b2560b8-a19f-33a4-945a-94926493e578",
                                                "text": "Il y a assez de lumière pour ceux qui ne désirent que de voir, et assez d’obscurité pour ceux qui ont une disposition contraire."
                                            },
                                            {
                                                "example_id": "d26d3b4d-8e61-4a24-817e-767e2f2c71fd",
                                                "sense_id": "6b2560b8-a19f-33a4-945a-94926493e578",
                                                "text": "Non ! Assez de malheur, de meurtre et de ravages !\nAssez d’égorgement ! Assez de deuil ! Assez\nDe fantômes sans tête et d’affreux trépassés !\nAssez de visions funèbres dans la brume !\nAssez de doigts hideux, montrant le sang qui fume,\nNoirs, et comptant les trous des linceuls dans la nuit !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8670070-660a-3b68-bd74-e0cb70e4e2da",
                                        "entry_id": "35ccdbc9-2cf6-3424-b4f3-454cdf9ddcfd",
                                        "glosses": [
                                            "Particulièrement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "197d73ab-6741-4e3c-bfac-a84517bbc7e5",
                                                "sense_id": "d8670070-660a-3b68-bd74-e0cb70e4e2da",
                                                "text": "J’aime assez son culot, même si parfois, elle va trop loin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65aaed4f-13b9-3089-b145-0c6153615e58",
                                        "entry_id": "35ccdbc9-2cf6-3424-b4f3-454cdf9ddcfd",
                                        "glosses": [
                                            "Relativement, passablement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "215519ba-c409-4e84-b1f0-1e43d0ee4e4f",
                                                "sense_id": "65aaed4f-13b9-3089-b145-0c6153615e58",
                                                "text": "Assez bien. (Appréciation scolaire assez vague ; une chose est sûre, c’est moins que bien !)"
                                            },
                                            {
                                                "example_id": "fb5141b3-702a-4b1f-a728-0ca25c4e8f1f",
                                                "sense_id": "65aaed4f-13b9-3089-b145-0c6153615e58",
                                                "text": "C’est assez facile à réaliser mais il faut du temps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a27356c5-65b3-3886-ac9b-49d18c899881",
                                        "entry_id": "35ccdbc9-2cf6-3424-b4f3-454cdf9ddcfd",
                                        "glosses": [
                                            "Considérant le contexte et l’intonation, souvent sous forme d’exclamation : qui frappe l’imagination, tellement, excessivement."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28f5801b-4e1c-4c0b-a76e-b6f2d9013734",
                                                "sense_id": "a27356c5-65b3-3886-ac9b-49d18c899881",
                                                "text": "Ch’t’assez content, là ! (Je suis assez…)"
                                            },
                                            {
                                                "example_id": "3db73b06-b6fe-4724-a6bd-7a9f1e15d7d4",
                                                "sense_id": "a27356c5-65b3-3886-ac9b-49d18c899881",
                                                "text": "Y’é’t’assez l’fun ! (Il est assez…)"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "assez",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "88fdb08f-c8ca-3faf-8e79-8a0278c97df8",
                                        "entry_id": "4d6573d9-ecde-3895-a332-f093faeef1d9",
                                        "glosses": [
                                            "S’emploie pour demander avec exaspération à son interlocuteur de s’arrêter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36df740c-2259-470d-89dc-f1684b36f4d1",
                                                "sense_id": "88fdb08f-c8ca-3faf-8e79-8a0278c97df8",
                                                "text": "— … Nous avons, monsieur l’Observateur, assez avalé de couleuvres, vous en êtes témoin. Mais assez, c’est assez."
                                            },
                                            {
                                                "example_id": "9e40e25a-df3f-4287-ba0d-144856c5a615",
                                                "sense_id": "88fdb08f-c8ca-3faf-8e79-8a0278c97df8",
                                                "text": "Alors aujourd’hui, je dépose ma voix à côté de ceux et celles qui ont eu la force et le courage de dire : « Assez c’est assez » !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
