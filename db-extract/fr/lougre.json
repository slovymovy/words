                    {
                        "sense_id": "00f1bd95-f021-331b-bf0c-7d6e692a6734",
                        "entry_id": "94f110ba-0657-3c2d-ae8a-42d57f985474",
                        "glosses": [
                            "Sorte de bâtiment marchand destiné au cabotage avec deux ou trois mâts qui portent des voiles au tiers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5cafa7d-bbda-46f5-8942-41021d76e555",
                                "sense_id": "00f1bd95-f021-331b-bf0c-7d6e692a6734",
                                "text": "Avec le temps, il devint capitaine d’un lougre corsaire de trois canons et de soixante hommes d’équipage."
                            },
                            {
                                "example_id": "96665ad8-0d1f-4bbf-aded-5a3fcab113b0",
                                "sense_id": "00f1bd95-f021-331b-bf0c-7d6e692a6734",
                                "text": "Une large chaloupe, gréée en lougre, se tenait sous l’écoute de la goélette, et on y empilait l’étrange ménagerie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
