                "senses": [
                    {
                        "sense_id": "ebcad2e3-2239-397c-81d4-4205e675b58d",
                        "entry_id": "294b99c7-6caa-3c56-9a80-0e4637da1347",
                        "glosses": [
                            "Groupe de langues polynésiennes parlée par les Maori. Désigne en général le maori de Nouvelle-Zélande."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1568e4a0-0176-4d1d-acd5-bc47ef48bbc7",
                        "source_entry_id": "294b99c7-6caa-3c56-9a80-0e4637da1347",
                        "source_sense_id": "ebcad2e3-2239-397c-81d4-4205e675b58d",
                        "target_lang_word": "Maori",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Maori",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb38d427-4b33-3cba-a04f-d94eba56e45e",
                                        "entry_id": "d3271e80-59c0-3c86-b51c-c9c246e40cb4",
                                        "glosses": [
                                            "Angehöriger des indigenen Volk Neuseelands"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3cc823a1-c2a7-4149-9727-a5645501ed7c",
                                                "sense_id": "fb38d427-4b33-3cba-a04f-d94eba56e45e",
                                                "text": "Etwa eine halbe Million Maori leben heute noch auf Neuseeland."
                                            },
                                            {
                                                "example_id": "688d799f-6ec2-44ae-83a1-f5616eabe8e2",
                                                "sense_id": "fb38d427-4b33-3cba-a04f-d94eba56e45e",
                                                "text": "„Seit den 1960er Jahren erlebte die Kultur der Maori dann einen umfassenden Aufschwung. Die Regierung erkannte endgültig die Maori als politische Kraft an.“"
                                            },
                                            {
                                                "example_id": "73a02137-0d1e-4e77-915b-35d9e8fa83d9",
                                                "sense_id": "fb38d427-4b33-3cba-a04f-d94eba56e45e",
                                                "text": "„Wie sich herausstellte, war der Anrufer Weißer oder Pakeha, wie er sich selbst mit dem Wort der Maori für Europäer bezeichnete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Maori",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7a6ae74f-a758-3cb2-9a4f-b24c8c291163",
                                        "entry_id": "71bbde5c-cb2f-3b67-83a2-438ca2cfce20",
                                        "glosses": [
                                            "Sprache, die vom gleichnamigen, indigenen Volk Neuseelands gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbf2c34f-d7f8-4d4c-aa59-31a51aed0600",
                                                "sense_id": "7a6ae74f-a758-3cb2-9a4f-b24c8c291163",
                                                "text": "Sprichst Du Maori?"
                                            },
                                            {
                                                "example_id": "7f9433ba-7993-430f-979d-c21f1c25bc7c",
                                                "sense_id": "7a6ae74f-a758-3cb2-9a4f-b24c8c291163",
                                                "text": "Vor der Ankunft der Europäer war Maori eine rein orale Sprache, heute wird sie in lateinischer Schrift geschrieben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
