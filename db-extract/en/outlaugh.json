                        "entry_id": "850f6e5a-15cb-3b25-afff-cd8838e744b5",
                        "glosses": [
                            "To ridicule or laugh someone out of a purpose, principle, etc.; laugh down; discourage or put out of countenance by laughing."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "21296be1-95a0-4cc5-91ce-b413402c8b1a",
                                "sense_id": "70fa301b-653f-36c3-b068-4e5715a92822",
                                "text": "His apprehensions of being outlaughed will force him to continue in a restless obscurity. - Franklin"
                            }
                        ]
                    },
                    {
                        "sense_id": "4876955a-5a3f-3b88-ab19-bdc56f7e2378",
                        "entry_id": "850f6e5a-15cb-3b25-afff-cd8838e744b5",
                        "glosses": [
                            "To laugh louder than, surpass in laughing."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c7b1039c-d524-46e5-b17c-8a40f44eb04b",
                                "sense_id": "4876955a-5a3f-3b88-ab19-bdc56f7e2378",
                                "text": "At his father's quick guffaw he jumped back, trying to outlaugh him. \"Mamma, did you hear what I said, Mamma?\" Boardman felt his side. \"My boy, that's a good one.\""
                            }
