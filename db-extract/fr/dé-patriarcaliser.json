                ],
                "senses": [
                    {
                        "sense_id": "c5629302-88be-3638-8dc9-ead478b8c9a3",
                        "entry_id": "356ef3fb-4e3d-385b-84d5-d57eaaf6e872",
                        "glosses": [
                            "Faire perdre son caractère patriarcal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c70f597a-b59f-41fa-bac1-c4324c835d70",
                                "sense_id": "c5629302-88be-3638-8dc9-ead478b8c9a3",
                                "text": "Ou si, à l'inverse, elles décident, tout à coup, de se dé-patriarcaliser."
                            },
                            {
                                "example_id": "cae5c7c0-ceca-4242-ad18-932d93c6f2d3",
                                "sense_id": "c5629302-88be-3638-8dc9-ead478b8c9a3",
                                "text": "Décoloniser pour dé-patriarcaliser."
                            },
                            {
                                "example_id": "01c03bef-5fdb-45e4-b5fe-0970ca647cad",
                                "sense_id": "c5629302-88be-3638-8dc9-ead478b8c9a3",
                                "text": "Alors oui, si des féministes musulmanes aident, de par leur production de connaissance, à dépasser les clivages anciens qui répètent depuis plus de 20 ans qu’il y a là double trahison, il me semble au contraire que nous avons là une double chance de à la fois dé-patriarcaliser l'islam et de dé-coloniser le féminisme."
                            }
                        ]
                    }
