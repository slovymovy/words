                    "sense_id": "18478359-511d-3c15-9f8e-a4b67a2b297c",
                    "sense_definition": "met losse draden of beschadigde randen; voorzien van rafels",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij droeg een oude broek met <w>gerafelde</w> pijpen naar het strand.",
                            "target_lang_translations": {
                                "pl": "Na plażę założył stare spodnie z <w>postrzępionymi</w> nogawkami."
                            }
                        },
                        {
                            "text": "De bladzijden van het antieke boek hadden <w>gerafelde</w> randen.",
                            "target_lang_translations": {
                                "pl": "Kartki zabytkowej księgi miały <w>poszarpane</w> brzegi."
                            }
                        }
                    ],
                    "synonyms": [
