                    {
                        "translation_id": "a2697ed0-e22f-485a-8faa-34e3ea3c3426",
                        "source_entry_id": "979ef9ba-2ca3-399d-a210-340e5ff261fe",
                        "source_sense_id": "cff3b1f1-e01f-3519-9ca0-200d952608cd",
                        "target_lang_word": "ducat",
