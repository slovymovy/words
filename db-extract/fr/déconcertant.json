                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b33754e1-8a3f-4670-862a-1370c296b565",
                                                "sense_id": "4e437a38-c4de-3ea4-af73-f7344f362184",
                                                "text": "„Jedoch an Händen und Füßen wie ein Braten mit dicken, groben Stricken verschnürt zu sein, fand ich wirklich beunruhigend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
