                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e7e7459c-471c-35e6-9a43-2eb0ef19e615",
                    "sense_definition": "A pattern formed of grooves, ruts, or deep wrinkles.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The natural <w>furrowing</w> of the tree bark provided shelter for tiny insects.",
                            "target_lang_translations": {
                                "es": "Los <w>surcos</w> naturales de la corteza del árbol proporcionaban refugio a pequeños insectos."
                            }
                        },
                        {
                            "text": "Deep <w>furrowing</w> on the ancient stone showed where water once flowed.",
                            "target_lang_translations": {
                                "es": "El profundo <w>estriado</w> en la piedra antigua mostraba por dónde había fluido alguna vez el agua."
                            }
                        }
                    ],
                    "synonyms": [
                        "grooving",
                        "wrinkling"
                    ],
                    "target_lang_definitions": {
                        "es": "Patrón o conjunto formado por surcos, hendiduras o arrugas profundas."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "surcos",
                                "target_lang_sense_clarification": "patrón de hendiduras o canales"
                            },
                            {
                                "target_lang_word": "estriado",
                                "target_lang_sense_clarification": "conjunto de estrías o ranuras"
                            },
                            {
                                "target_lang_word": "agrietamiento",
                                "target_lang_sense_clarification": "conjunto de grietas o hendiduras profundas"
                            }
                        ]
                    }
                }
            ]
        }
    ]
