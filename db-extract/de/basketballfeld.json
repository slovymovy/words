                ],
                "senses": [
                    {
                        "sense_id": "5f70fdd7-3b8c-3946-b5c6-20a5daab2f10",
                        "entry_id": "11cacbbc-4b1f-3fcc-ba4d-ccec0f0299b3",
                        "glosses": [
                            "Spielfeld für Basketball"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30f84847-320b-411f-bdb2-9aad3f466207",
                                "sense_id": "5f70fdd7-3b8c-3946-b5c6-20a5daab2f10",
                                "text": "„In diesem Raum, der etwa so groß war wie ein Basketballfeld, arbeiteten mehrere Dutzend Menschen konzentriert an Schreibtischen und in abgetrennten Arbeitskabinen.“"
                            },
                            {
                                "example_id": "2c4f52d2-69d1-4e07-9d83-f0763e5a87db",
                                "sense_id": "5f70fdd7-3b8c-3946-b5c6-20a5daab2f10",
                                "text": "„Grauer benutzte den Laserpointer und ließ den roten Punkt um das größte Gebäude kreisen. Mit einer Höhe von zwei Stockwerken nahm es in etwa die Fläche eines Basketballfelds ein.“"
                            },
                            {
                                "example_id": "4ccb8fc7-99b6-42f7-8cb9-0268e252babd",
                                "sense_id": "5f70fdd7-3b8c-3946-b5c6-20a5daab2f10",
                                "text": "„Er steht vor einem Basketballfeld, hinter ihm sieht man vorpubertäre Kinder beim Spiel.“"
                            },
                            {
                                "example_id": "ca625d2b-980c-4341-9a76-2cd8b9df864e",
                                "sense_id": "5f70fdd7-3b8c-3946-b5c6-20a5daab2f10",
                                "text": "„Am großen Platz in der Mitte des Camps, der so quadratisch war wie zwei aneinandergefügte Basketballfelder, blieb sie stehen und begutachtete lächelnd nickend ihren Maibaum, eine junge, aber hochgeschossene und beinahe kerzengerade australische Kiefer.“"
                            },
                            {
                                "example_id": "2ccb9873-5577-4938-8628-28dcb10b0893",
                                "sense_id": "5f70fdd7-3b8c-3946-b5c6-20a5daab2f10",
                                "text": "„In der Nähe des Basketballfeldes ging ein älterer Mann mit schnellen Schritten zum Parkplatz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
