                        ],
                        "examples": [
                            {
                                "example_id": "749c81cb-8352-4347-be6c-ca6f289d5efb",
                                "sense_id": "3a1c1e7f-124f-3feb-a650-19ed8a0bcb02",
                                "text": "Twygges or boughes of trees cut of[f], or shragged, […] Shragge vnder so that the sunne maye come to the ground, […]"
                            },
                            {
                                "example_id": "3e82bee0-94c3-4def-be23-c7eac2abd43a",
                                "sense_id": "3a1c1e7f-124f-3feb-a650-19ed8a0bcb02",
                                "text": "About 350 loads of excellent beech timber, with the felling fagots, 1,500 shragging fagots, 5 lots of small ash, 15 large ash, and 22 large elm trees, [...] will be sold by auction."
                            },
                            {
                                "example_id": "8bd10dc5-b9b8-4e27-b934-4e1ab1579f90",
                                "sense_id": "3a1c1e7f-124f-3feb-a650-19ed8a0bcb02",
                                "text": "It is raining today in Steubenville. / Blessed be the dead whom the rain rains upon. / And damned the living who have their few days. / And blessed your thorned face, Your shragged November, / Your leaf, / Lost."
                            }
                        ]
                    }
