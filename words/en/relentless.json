            "senses": [
                {
                    "sense_id": "24d26953-ae84-3a09-b10a-b77d1ca96909",
                    "sense_definition": "Continuing without stopping or losing intensity; steady and persistent.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "persistence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>relentless</w> rain caused the river to overflow its banks after three days.",
                            "target_lang_translations": {
                                "ru": "<w>Непрекращающийся</w> дождь привел к тому, что через три дня река вышла из берегов.",
                                "tr": "<w>Aralıksız</w> yağmur üç gün sonra nehrin taşmasına neden oldu.",
                                "de": "Der <w>unablässige</w> Regen führte dazu, dass der Fluss nach drei Tagen über die Ufer trat.",
                                "fr": "La pluie <w>incessante</w> a provoqué le débordement de la rivière après trois jours.",
                                "cs": "<w>Neustálý</w> déšť způsobil, že se řeka po třech dnech vylila z břehů."
                            }
                        },
                        {
                            "text": "The team's <w>relentless</w> pursuit of excellence led them to win the championship.",
                            "target_lang_translations": {
                                "ru": "<w>Неустанное</w> стремление команды к совершенству привело их к победе в чемпионате.",
                                "tr": "Takımın mükemmellik yolundaki <w>yılmak bilmeyen</w> çabası şampiyonluğu kazanmalarını sağladı.",
                                "de": "Das <w>unermüdliche</w> Streben des Teams nach Exzellenz führte zum Gewinn der Meisterschaft.",
                                "fr": "La quête <w>acharnée</w> de l'excellence par l'équipe les a menés à remporter le championnat.",
                                "cs": "<w>Vytrvalá</w> snaha týmu o dokonalost je dovedla k vítězství v šampionátu."
                            }
                        }
                    ],
                    "synonyms": [
                        "persistent",
                        "unremitting",
                        "unstoppable"
                    ],
                    "antonyms": [
                        "stoppable",
                        "remitting"
                    ],
                    "common_phrases": [
                        "relentless pursuit",
                        "relentless pressure",
                        "relentless rain"
                    ],
                    "target_lang_definitions": {
                        "ru": "Продолжающийся без остановок или потери интенсивности; устойчивый и настойчивый.",
                        "tr": "Durmaksızın veya şiddetini kaybetmeden devam eden; kararlı ve sürekli.",
                        "de": "Etwas, das ohne Unterbrechung oder Nachlassen der Intensität andauert; stetig und beharrlich.",
                        "fr": "Qui continue sans s'arrêter ou sans perdre en intensité ; constant et persistant.",
                        "cs": "Pokračující bez přestání nebo bez ztráty intenzity; stálý a vytrvalý."
                    },
