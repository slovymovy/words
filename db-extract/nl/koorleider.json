                    {
                        "sense_id": "a4e2a5f8-247c-3b81-82f3-86c28705c726",
                        "entry_id": "ac769385-3d38-3428-bea5-4e777fdbce4e",
                        "glosses": [
                            "dirigent van een van een groep mensen die samen zingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0401ef0-591d-4698-9020-504b19bd904e",
                                "sense_id": "a4e2a5f8-247c-3b81-82f3-86c28705c726",
                                "text": "Weber identificeerde 49 priesters en leraren die schuldig waren aan mishandeling en misbruik. In het rapport krijgen de huidige kardinaal en voormalig bisschop van Regensburg Gerhard Ludwig Müller en de voormalig koorleider Georg Ratzinger (broer van emeritus paus Benedictus) felle kritiek."
                            },
                            {
                                "example_id": "0e355122-c24f-46a7-a436-d732798eeb75",
                                "sense_id": "a4e2a5f8-247c-3b81-82f3-86c28705c726",
                                "text": "De Concertgebouw Prijs gaat dit keer naar Sir John Eliot Gardiner. De Engelse dirigent en koorleider krijgt de onderscheiding half januari aangeboden tijdens een galadiner. Gardiner verdient de prijs wegens de belangrijke bijdrage die hij lange tijd heeft geleverd aan het artistieke profiel van de Amsterdamse concertzaal, meldt het Concertgebouw."
                            }
                        ]
                    },
                    {
                        "sense_id": "40198f86-7e3c-3ba7-9a8d-c287c4c6d75c",
                        "entry_id": "ac769385-3d38-3428-bea5-4e777fdbce4e",
                        "glosses": [
                            "voornaamste woordvoerder binnen de groep spelers die in een klassiek drama vooral commentaar uitspreken op de gebeurtenissen in het stuk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "777f64c8-2997-42fd-816f-a5f05da576f0",
                                "sense_id": "40198f86-7e3c-3ba7-9a8d-c287c4c6d75c",
                                "text": "We weten wel dat de Griekse tragedie naar alle waarschijnlijkheid ontstaan is doordat in de zesde eeuw de koorleider los van zijn koor begon op te treden en er zich een dialoog tussen hem en de groep kon ontwikkelen, waarna langzamerhand een tweede acteur erbij begon te komen zodat de rol van het koor werd teruggedrongen."
                            }
                        ]
                    }
