                "senses": [
                    {
                        "sense_id": "6cb77971-82cf-395b-8019-2ba522c231c4",
                        "entry_id": "5f9a7065-fb15-3ce8-9865-b99f18653fd1",
                        "glosses": [
                            "Concentrer la lumière au travers d’une lentille gravitationnelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61c59049-a810-435a-9574-f9d6ddaa15a1",
                                "sense_id": "6cb77971-82cf-395b-8019-2ba522c231c4",
                                "text": "Une des difficultés de l’interprétation de la profondeur optique est l’effet de la confusion d’étoiles qui intervient dans les champs encombrés. Il engendre des erreurs systématiques dues à une mauvaise détermination du flux de l’étoile “lentillée”."
                            },
                            {
                                "example_id": "3a2dc926-2d87-48b3-a60b-a9af8c0a90ba",
                                "sense_id": "6cb77971-82cf-395b-8019-2ba522c231c4",
                                "text": "À droite est ajouté la reconstruction du spectre lentillé par Planck et les données des oscillations acoustiques [156]."
                            }
                        ]
                    },
                    {
                        "sense_id": "919d8a03-b2f3-32eb-89e4-4345accf8388",
                        "entry_id": "5f9a7065-fb15-3ce8-9865-b99f18653fd1",
                        "glosses": [
                            "Réduire le débit d’une canalisation d’eau desservant un client en y posant une pastille (ou lentille)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e223d64d-12c0-47bb-9f24-6eaf415577fc",
                                "sense_id": "919d8a03-b2f3-32eb-89e4-4345accf8388",
                                "text": "Pour ce qui concerne par exemple le Grand Lyon, en 2004, l’eau a été coupée à 550 abonnés et 1610 ont été \"lentillés\"."
                            }
                        ]
                    }
                ],
