{
    "word_family": [
        "dienst",
        "rooster",
        "roosteren",
        "dienstregeling"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1ac528a7-ef41-320a-8f3a-4bd90bebf023",
                    "sense_definition": "Een schema waarin staat wie, wat, waar en wanneer werkt.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "werkplanning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De manager heeft het nieuwe <w>dienstrooster</w> voor volgende week op het bord gehangen.",
                            "target_lang_translations": {
                                "en": "The manager hung the new <w>work schedule</w> for next week on the board."
                            }
                        },
                        {
                            "text": "Als je een dag vrij wilt, moet je dat doorgeven voordat we het <w>dienstrooster</w> maken.",
                            "target_lang_translations": {
                                "en": "If you want a day off, you have to let us know before we make the <w>duty roster</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "werkrooster",
                        "werkschema"
                    ],
                    "common_phrases": [
                        "het dienstrooster maken",
                        "nieuw dienstrooster"
                    ],
                    "target_lang_definitions": {
                        "en": "A schedule showing who works, what they do, where, and when."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "work schedule",
                                "target_lang_sense_clarification": "for employees"
                            },
                            {
                                "target_lang_word": "duty roster",
                                "target_lang_sense_clarification": "for shifts or duties"
                            },
                            {
                                "target_lang_word": "shift schedule",
                                "target_lang_sense_clarification": "for shift work"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8220dfe-34a5-36f4-acac-c4a6aaf719dc",
                    "sense_definition": "Een schema waarin staat wanneer treinen, bussen en ander openbaar vervoer rijden.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoersplanning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de hevige sneeuwval rijden de treinen vandaag volgens een aangepast <w>dienstrooster</w>.",
                            "target_lang_translations": {
                                "en": "Due to the heavy snowfall, the trains are running according to an adjusted <w>timetable</w> today."
                            }
                        },
                        {
                            "text": "De NS probeert morgen weer volgens het normale <w>dienstrooster</w> te rijden.",
                            "target_lang_translations": {
                                "en": "The NS is trying to run according to the normal <w>timetable</w> again tomorrow."
                            }
                        }
                    ],
                    "synonyms": [
                        "dienstregeling"
                    ],
                    "common_phrases": [
                        "aangepast dienstrooster",
                        "normaal dienstrooster"
                    ],
                    "target_lang_definitions": {
                        "en": "A schedule showing when trains, buses, and other public transport run."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "timetable",
                                "target_lang_sense_clarification": "for public transport"
                            },
                            {
                                "target_lang_word": "schedule",
                                "target_lang_sense_clarification": "for public transport"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}