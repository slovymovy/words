                        "tags": [],
                        "examples": [
                            {
                                "example_id": "168789ca-6fd4-47ec-b16a-982040e75120",
                                "sense_id": "31763e09-6951-31bf-8da6-e1d557e692eb",
                                "text": "„Im Jahr 468 gelang es Geiserich, Militäraktionen beider Römischer Reiche, Ost und West, gegen ihn erfolgreich zurückzuschlagen.“"
                            },
                            {
                                "example_id": "19bf1ef9-4ebf-4773-9b12-e56820bc5a7e",
                                "sense_id": "31763e09-6951-31bf-8da6-e1d557e692eb",
                                "text": "„Die erste Militäraktion gegen ein Regime im Namen der Schutzverantwortung ist zu Ende. Unterm Strich war sie erfolgreich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
