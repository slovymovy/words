                ],
                "senses": [
                    {
                        "sense_id": "cec27964-2e60-339e-9b3f-6613c5daa1e8",
                        "entry_id": "ff59f91f-df26-30a6-a3b0-631e52a63e28",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63a35acc-a44f-4d02-af1a-e57bb7e67644",
                                "sense_id": "cec27964-2e60-339e-9b3f-6613c5daa1e8",
                                "text": "Frau Meierle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "dbff4202-ddf3-4632-a77e-8274cf30b940",
                                "sense_id": "cec27964-2e60-339e-9b3f-6613c5daa1e8",
                                "text": "Herr Meierle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "57b040c5-a73e-4a07-8884-f694b626df80",
                                "sense_id": "cec27964-2e60-339e-9b3f-6613c5daa1e8",
                                "text": "Die Meierles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "42b9fd23-0217-4f5a-a12d-d940bcec753a",
                                "sense_id": "cec27964-2e60-339e-9b3f-6613c5daa1e8",
                                "text": "Der Meierle trägt nie die Pullover, die die Meierle ihm strickt."
                            },
                            {
                                "example_id": "790c7d2c-dadb-43bb-bab8-f15c4d62abf3",
                                "sense_id": "cec27964-2e60-339e-9b3f-6613c5daa1e8",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Meierle kommt, geht der Herr Meierle.“"
                            },
                            {
                                "example_id": "cb50e88b-d8a5-4f69-9ae3-64e148472aa1",
                                "sense_id": "cec27964-2e60-339e-9b3f-6613c5daa1e8",
                                "text": "Meierle kommt und geht."
                            },
                            {
                                "example_id": "fbcd93c3-41e3-47c7-acbe-12ec6ce0c35e",
                                "sense_id": "cec27964-2e60-339e-9b3f-6613c5daa1e8",
                                "text": "Meierles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
