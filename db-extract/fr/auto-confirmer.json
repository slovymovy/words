                        "glosses": [
                            "Se confirmer par soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f542966-6c1d-48b0-87e9-f2985a2f7026",
                                "sense_id": "0a158e13-0b42-3c31-af6d-b5d658ce729d",
                                "text": "Le modèle systémique, une fois opacifié par une pseudo-logique, tend à s'auto-confirmer et s'auto-légitimer en prédisant ce qu'il contribue à faire exister."
                            },
                            {
                                "example_id": "19cf8f5f-cd29-4589-98a5-69b33fea9f05",
                                "sense_id": "0a158e13-0b42-3c31-af6d-b5d658ce729d",
                                "text": "De fait, Descartes déjà le savait, l'ordre des intérêts et des motivations propres à cette vie «naturelle» ne peut que s'auto-confirmer, et s'auto-motiver dans le sens d'une auto-perpétuation indéfinie."
                            }
                        ]
                    }
