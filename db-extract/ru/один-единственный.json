                "senses": [
                    {
                        "sense_id": "8e9b917e-ce05-32b0-9fa2-5f2d462ba150",
                        "entry_id": "20addb2a-d67a-361f-b13d-a717242d9c50",
                        "glosses": [
                            "one and only, sole"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "9bf80e37-9a44-47a7-a791-fb21d4c855f4",
                                "sense_id": "8e9b917e-ce05-32b0-9fa2-5f2d462ba150",
                                "text": "Сквозь паути́ну хме́ля ста́ло ви́дно, что вся у́лица освещена́ одни́м-еди́нственным зда́нием – двухэта́жным до́мом с кирпи́чным бело-кра́сным цо́колем, похо́жим на фа́ртук бабу́ли На́ты, и деревя́нным ве́рхом."
                            }
                        ]
                    }
