                "senses": [
                    {
                        "sense_id": "537d1528-dda4-3ce4-b276-cedb11f0a706",
                        "entry_id": "d999759f-9055-342c-9fde-afa7b4ec1bd2",
                        "glosses": [
                            "Kuppel aus Marmor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da0f93ed-3c73-4395-830b-8c628fb9620d",
                                "sense_id": "537d1528-dda4-3ce4-b276-cedb11f0a706",
                                "text": "„Die gewaltige Marmorkuppel des Parlamentshauses stach mit ihrer massiven Silhouette hervor, und die das Gebäude krönende Statue war dank einer Lücke in einer der farbigen Stratuswolken, die den Flammenhimmel bedeckten, von einem fantastischen Heiligenschein umgeben.“"
                            },
                            {
                                "example_id": "921f5f54-e889-49d4-b2a6-b5dfde8480e1",
                                "sense_id": "537d1528-dda4-3ce4-b276-cedb11f0a706",
                                "text": "„Die aufgeblähte, nutzlose Form der Marmorkuppel war eine Zitadelle, die eingenommen werden musste.“"
                            },
                            {
                                "example_id": "b9bd7a6a-8d1c-467a-b52d-b84b4b178936",
                                "sense_id": "537d1528-dda4-3ce4-b276-cedb11f0a706",
                                "text": "„Noch während wir mit einer Begeisterung, die uns die lange Reise vergessen ließ, darüber parlierten, welche Kostbarkeiten wir aus all den fantastischen Schätzen von Commoriom zuerst als Beute wählen würden, erspähten wir im Mondschein den Schimmer von Marmorkuppeln über den Baumwipfeln, und kurz darauf zwischen den Ästen und Stämmen die fahlen Pfeiler schattendunkler Säulengänge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
