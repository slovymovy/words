                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4843fd46-5825-41e4-ae5b-39e47d8ca0d3",
                                                "sense_id": "a9d2ca3b-782f-30e7-ae50-45396954b21c",
                                                "text": "„Die Gruppierung gliedert sich in zwei Hauptzweige, in das Eskimo und in das Aleutische.“"
                                            },
                                            {
                                                "example_id": "caee1020-1975-4cc1-ae53-d57a70c53350",
                                                "sense_id": "a9d2ca3b-782f-30e7-ae50-45396954b21c",
                                                "text": "„Die wichtigste Sprache ist das Eskimo, das in zahlreichen Dialekten von etwa 90000 Menschen gesprochen wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
