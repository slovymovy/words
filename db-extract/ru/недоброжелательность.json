                                        "entry_id": "a1a6adc5-6ced-3455-b5e6-fddfa57d1c65",
                                        "glosses": [
                                            "Alternative spelling of ill will."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3436e1fc-b3b7-404f-b7dd-46a0a7528434",
                                                "sense_id": "0182fea7-73a2-390b-a281-c11a8b51ac9e",
                                                "text": "His heart was softened in seeing mine suffer; and so much of his ill-will was done away, that when we parted, he almost shook me by the hand while he reminded me of an old promise about a pointer puppy."
                                            }
                                        ]
                                    }
                                ]
