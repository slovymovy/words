                "senses": [
                    {
                        "sense_id": "6659cd1a-40c3-3c35-be2b-6d0ad3b59b49",
                        "entry_id": "34e27bab-1247-3401-8dc9-ca0c8e9072e2",
                        "glosses": [
                            "Verlagerung von Arbeitsplätzen in den Niedriglohnsektor"
                        ],
                        "tags": [
                            "Euphemismus"
                        ],
                        "examples": [
                            {
                                "example_id": "0ba87327-980b-418b-a893-a38d4d71e115",
                                "sense_id": "6659cd1a-40c3-3c35-be2b-6d0ad3b59b49",
                                "text": "„Wir betrachten diese Schlüsselfunktion deshalb auch unter dem Begriff \"Smartsourcing\" – also die intelligente, clevere und betriebswirtschaftliche Teilausgliederung von sportfunktionellen HumanRessourcen, die aber dabei gleichzeitig in den sportoperativen Leistungseinheiten der Anwender erhalten bleiben.“"
                            },
                            {
                                "example_id": "0e0a5cdb-8927-448b-9a6c-352e29633f79",
                                "sense_id": "6659cd1a-40c3-3c35-be2b-6d0ad3b59b49",
                                "text": "„Vor dem Hintergrund des größten Gewinns seit dem Iahr 2000 und der angekündigten Verlagerung von 6400 Arbeitsplätzen in Niedriglohnländer kann „Smartsourcing“ sicherlich als Angriff auf bisherige Werte des deutschen Managements verstanden werden.“"
                            },
                            {
                                "example_id": "b051b437-5abf-4dd1-983c-f93d27578dd8",
                                "sense_id": "6659cd1a-40c3-3c35-be2b-6d0ad3b59b49",
                                "text": "„Der Begriff »Smartsourcing«, der die Beschäftigung von Niedriglohnarbeitern bei gleichzeitig hohen Gewinnen und Entlassungen wie eine vernünftige Handlung wirken lassen will, erscheint bei den fünf Millionen Arbeitslosen zynisch.“"
                            },
                            {
                                "example_id": "f963c322-ded2-4c45-ad24-04257dfd1d4f",
                                "sense_id": "6659cd1a-40c3-3c35-be2b-6d0ad3b59b49",
                                "text": "„Einige Manager sprechen bis zu 80% der gesamten Antwortzeit, auch Ackermann verteidigt den ›Personalabbau‹ ganz alleine, um sich dann zu wundern, wenn er mit zynischen Begriffen wie ›Smartsourcing‹ zitiert und verantwortlich gemacht wird.“"
                            },
                            {
                                "example_id": "15c03708-c1ef-4109-997d-918fc769364f",
                                "sense_id": "6659cd1a-40c3-3c35-be2b-6d0ad3b59b49",
                                "text": "„Typische (D)englischbegriffe in diesem Zusammenhang: Downsizing, Rightsizing, Outplacement, Smartsourcing“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
