{
    "word_family": [
        "abstractie",
        "abstraheren",
        "abstractheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fd917d18-0155-35df-8108-633165067af9",
                    "sense_definition": "niet tastbaar of concreet, maar alleen bestaand als een idee of door redenering verkregen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "conceptueel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vrijheid is een <w>abstract</w> begrip dat voor iedereen iets anders kan betekenen.",
                            "target_lang_translations": {
                                "en": "Freedom is an <w>abstract</w> concept that can mean something different to everyone."
                            }
                        },
                        {
                            "text": "De professor hield een nogal <w>abstract</w> betoog over de theoretische natuurkunde.",
                            "target_lang_translations": {
                                "en": "The professor gave a rather <w>abstract</w> argument about theoretical physics."
                            }
                        }
                    ],
                    "antonyms": [
                        "concreet"
                    ],
                    "common_phrases": [
                        "abstract begrip",
                        "abstract concept",
                        "abstract betoog"
                    ],
                    "target_lang_definitions": {
                        "en": "not tangible or concrete, but existing only as an idea or obtained through reasoning"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "abstract",
                                "target_lang_sense_clarification": "conceptual and not concrete"
                            },
                            {
                                "target_lang_word": "theoretical",
                                "target_lang_sense_clarification": "based on theory rather than practice"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69ab012c-8d90-35da-a01a-2a023090e431",
                    "sense_definition": "geen herkenbare voorstelling gevend van de werkelijkheid, vooral in de kunst",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "kunst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de woonkamer hangt een groot schilderij met <w>abstracte</w> vormen en felle kleuren.",
                            "target_lang_translations": {
                                "en": "In the living room hangs a large painting with <w>abstract</w> shapes and bright colors."
                            }
                        },
                        {
                            "text": "Zij houdt meer van <w>abstracte</w> kunst dan van realistische portretten.",
                            "target_lang_translations": {
                                "en": "She likes <w>abstract</w> art more than realistic portraits."
                            }
                        }
                    ],
                    "synonyms": [
                        "non-figuratief"
                    ],
                    "antonyms": [
                        "figuratief"
                    ],
                    "common_phrases": [
                        "abstracte kunst",
                        "abstracte vormen",
                        "abstract schilderij"
                    ],
                    "target_lang_definitions": {
                        "en": "giving no recognizable representation of reality, especially in art"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "abstract",
                                "target_lang_sense_clarification": "non-representational art"
                            },
                            {
                                "target_lang_word": "non-figurative",
                                "target_lang_sense_clarification": "not representing natural forms"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "563af444-b398-32bf-a8bd-988a51a09a1f",
                    "sense_definition": "een korte samenvatting van de inhoud van een wetenschappelijk artikel of verslag",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tekst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voordat ik het hele artikel lees, bekijk ik eerst de <w>abstract</w> op de eerste pagina.",
                            "target_lang_translations": {
                                "en": "Before I read the whole article, I first look at the <w>abstract</w> on the first page."
                            }
                        },
                        {
                            "text": "De student moest een korte <w>abstract</w> schrijven voor zijn afstudeerscriptie.",
                            "target_lang_translations": {
                                "en": "The student had to write a short <w>abstract</w> for his graduation thesis."
                            }
                        }
                    ],
                    "common_phrases": [
                        "korte abstract",
                        "abstract schrijven"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak gebruikt in academische context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a short summary of the contents of a scientific article or report"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "abstract",
                                "target_lang_sense_clarification": "summary of a research paper"
                            },
                            {
                                "target_lang_word": "summary",
                                "target_lang_sense_clarification": "brief statement of main points"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b7b699bb-ea0b-32c5-aa58-de6e72370302",
                    "sense_definition": "een houten of metalen trekstang in een orgel die de verbinding vormt tussen de toets en de klep",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "muziekinstrument",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De orgelbouwer verving een gebroken <w>abstract</w> om het instrument weer speelbaar te maken.",
                            "target_lang_translations": {
                                "en": "The organ builder replaced a broken <w>tracker</w> to make the instrument playable again."
                            }
                        },
                        {
                            "text": "Door de mechanische tractuur zijn de <w>abstracten</w> direct verbonden met de windlade.",
                            "target_lang_translations": {
                                "en": "Due to the mechanical action, the <w>trackers</w> are directly connected to the wind chest."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technische term in de orgelbouw"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a wooden or metal pull rod in an organ that forms the connection between the key and the valve"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "tracker",
                                "target_lang_sense_clarification": "mechanical link in a pipe organ"
                            },
                            {
                                "target_lang_word": "abstract",
                                "target_lang_sense_clarification": "technical term for an organ tracker"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}