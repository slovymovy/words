                        "entry_id": "da585baf-334f-3d44-8fd1-0f4e2c086bca",
                        "glosses": [
                            "An act of begging or pleading earnestly or urgently; an entreaty, an imploration or imploring, a plea."
                        ],
                        "tags": [
                            "obsolete",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "b6edad50-5ec8-4a51-bb68-421e2dfa5adf",
                                "sense_id": "52b27185-8232-316d-8bc9-280d7280ad05",
                                "text": "Suddenly out of his delightfull dreame / The man avvoke, and vvould haue queſtiond more; / But he vvould not endure that vvofull theame / For to dilate at large, but vrged ſore / VVith percing vvordes, and pittifull implore, / Him haſty to ariſe."
                            }
                        ]
                    }
