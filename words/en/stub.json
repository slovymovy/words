    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3fe6db93-d505-3c64-b1c8-348eef6bd5ed",
                    "sense_definition": "A piece of certain paper items, designed to be torn off and kept for record or identification purposes.",
