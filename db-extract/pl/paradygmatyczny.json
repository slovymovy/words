                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39e634d1-e3d9-4660-ba80-bdaebd3b2074",
                                "sense_id": "0d11b713-9990-32c0-b893-17b51e557aa7",
                                "text": "Wszelkie błędy w deklinacji czy koniugacji wskazują na eksponowanie przez Białoszewskiego relacji paradygmatycznych, konsekwencji w stosowaniu zasad językowych"
                            }
