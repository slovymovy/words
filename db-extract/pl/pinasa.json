                        "source_sense_id": "d4a73e1f-a308-33ea-b951-79401638d058",
                        "target_lang_word": "pinnace",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pinnace",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f3ebb299-b130-3511-953c-90328e70d246",
                                        "entry_id": "f8d2ae35-9f82-3930-a525-f13c4376d67b",
                                        "glosses": [
                                            "A light boat, traditionally propelled by sails, but sometimes a rowboat, and usually serving to carry messages among the larger ships of a fleet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16f59140-c873-4148-a299-d197ae308391",
                                                "sense_id": "f3ebb299-b130-3511-953c-90328e70d246",
                                                "text": "I cast my eyes to the ship, and there she rode, within little more than half a mile of the shore; for they had weighed her anchor as soon as they were masters of her, and, the weather being fair, had brought her to an anchor just against the mouth of the little creek; and the tide being up, the captain had brought the pinnace in ..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf6be9c0-5cc8-4b12-a6f1-3c410a3cffa3",
                        "source_entry_id": "5d5e8c98-727a-3c6f-a7a0-5eff8af8833a",
                        "source_sense_id": "d4a73e1f-a308-33ea-b951-79401638d058",
                        "target_lang_word": "pinasse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pinasse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9f5b41b6-bbd8-3c94-97de-d96717995a76",
                                        "entry_id": "36a2c644-2402-3cdd-ac66-63b16e4f7a96",
                                        "glosses": [
                                            "Bâtiment de charge, à poupe carrée, à voiles et à rames, et maintenant muni le plus souvent d’un moteur."
                                        ],
                                        "tags": [
                                            "Navigation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37909d5a-c2f2-4d94-ac21-fc2320097262",
                                                "sense_id": "9f5b41b6-bbd8-3c94-97de-d96717995a76",
                                                "text": "Deux avisos de petit tonnage et d’un aspect vétuste étaient ancrés le long de la jetée, trois ou quatre pinasses à moteur basculaient à marée basse sur les vasières."
                                            },
                                            {
                                                "example_id": "09d273d3-df8d-41ec-bd74-9d511e4ff5e5",
                                                "sense_id": "9f5b41b6-bbd8-3c94-97de-d96717995a76",
                                                "text": "On prenait la navette au quai de la Fosse — une pinasse à moteur —, on passait sous le pont transbordeur, on longeait les chantiers de constructions navales."
                                            },
                                            {
                                                "example_id": "f063c524-7882-43fd-89f8-77db0d396113",
                                                "sense_id": "9f5b41b6-bbd8-3c94-97de-d96717995a76",
                                                "text": "C’était comme ça, dit Maudez, sauf que ça vivait, ça travaillait, il ne se passait pas de semaine sans qu’on lance un canot, une pinasse, un langoustier…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68e9a555-9f92-32c2-8083-23d4798d9c01",
                                        "entry_id": "36a2c644-2402-3cdd-ac66-63b16e4f7a96",
                                        "glosses": [
                                            "Embarcation légère, longue, armée de huit ou dix avirons, et destinée, comme les chaloupes, au service des vaisseaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e71efc5b-1fef-4b55-9c4f-6ae11775b08c",
                                                "sense_id": "68e9a555-9f92-32c2-8083-23d4798d9c01",
                                                "text": "J’avais aperçu la pinasse du yacht, pilotée par un matelot vêtu de blanc, et qui se dirigeait vers la terre."
                                            },
                                            {
                                                "example_id": "c55001f2-07d8-43e8-bcda-0606502cfbd1",
                                                "sense_id": "68e9a555-9f92-32c2-8083-23d4798d9c01",
                                                "text": "La pinasse arrive à Ostie au début de l’automne 1583."
                                            },
                                            {
                                                "example_id": "deed867f-db92-40f0-be12-ab9f0b76dd78",
                                                "sense_id": "68e9a555-9f92-32c2-8083-23d4798d9c01",
                                                "text": "Les deux navires de Frobisher naviguèrent sans encombre jusqu'au 8 juillet, jour où la pinasse accompagnant le Gabriel disparut dans la brume, quelque part au sud de l'Islande, avec à son bord les quatre hommes envoyés pour pêcher du poisson frais."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pinasse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "81a849e5-6104-36c5-bb53-a1935049d47e",
                                        "entry_id": "29c3a450-623f-367d-87c9-d2a9c8ca3930",
                                        "glosses": [
                                            "Pin sylvestre."
                                        ],
                                        "tags": [
                                            "Vosges"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c7a8b30-329f-4ec5-98c9-9468d5120d52",
                                                "sense_id": "81a849e5-6104-36c5-bb53-a1935049d47e",
                                                "text": "Cependant je garde un œil sur ce petit bois de pinasses."
                                            }
                                        ]
                                    }
                                ]
                            },
