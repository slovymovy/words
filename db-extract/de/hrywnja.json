                "senses": [
                    {
                        "sense_id": "fc398d27-2932-3d86-90e3-e534e5e27dc3",
                        "entry_id": "3479e29f-e1cd-360a-b35c-6ee316f013b6",
                        "glosses": [
                            "Landeswährung der Ukraine"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f7267ca-0511-4f4f-a35a-fcbee59ad6ef",
                                "sense_id": "fc398d27-2932-3d86-90e3-e534e5e27dc3",
                                "text": "„Wenige Tage vor meinem Abflug verlor die ukrainische Landeswährung Hrywnja an einem Tag die Hälfte ihres Wertes.“"
                            },
                            {
                                "example_id": "97578b2b-340f-4f6a-b3e4-3bc9e8b38788",
                                "sense_id": "fc398d27-2932-3d86-90e3-e534e5e27dc3",
                                "text": "„Wenn ein Kinder-T-Shirt eines ukrainischen Herstellers 7 bis 20 Hrywnja kostet, so ist ein ähnliches Shirt eines türkischen Herstellers bereits für 3–4 Hrywnja zu erwerben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
