                        "glosses": [
                            "koets waarin het bruidspaar zit als deel van de trouwstoet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8349ead7-9160-4c59-bb04-9255589f666f",
                                "sense_id": "12b0f0ef-cd42-38a1-8be5-9d5635e65f18",
                                "text": "Ter gelegenheid van de gouden bruiloft is de trouwkoets uit 1967 nog tot en juni te bezichtigen in het Koetshuis van Paleis Het Loo in Apeldoorn."
                            },
                            {
                                "example_id": "732f950c-0f38-46a9-9a12-fc25e0a00963",
                                "sense_id": "12b0f0ef-cd42-38a1-8be5-9d5635e65f18",
                                "text": "Via de webcam op het Ei van Ko is inderdaad om klokslag 13.00 uur een prachtige witte trouwkoets te zien, waar een bruid in een even witte jurk uitstapt om te gaan trouwen met haar bruidegom. \"Een huwelijk neemt ongeveer een half uur in beslag, het is druk vandaag. Het aantal van 22 is dan ook het maximale wat we aankunnen.\""
                            }
                        ]
                    }
