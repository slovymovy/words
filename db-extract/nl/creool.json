                                    {
                                        "sense_id": "2e1552f1-e34c-34ac-98b1-587e1f0d41d5",
                                        "entry_id": "417b72d2-8149-3eee-899c-aecc1686e5f9",
                                        "glosses": [
                                            "Nachkomme der aus den romanischen Ländern stammenden Einwanderer/Eroberer in Mittel- und Südamerika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fc9d612-ada8-429c-a6bc-4ebfb0f76271",
                                                "sense_id": "2e1552f1-e34c-34ac-98b1-587e1f0d41d5",
                                                "text": "„Bolivar war ein charismatischer Anführer, der zur weißen Oberschicht, den Kreolen, genauso sprechen konnte wie zu seinen Soldaten.“"
                                            },
                                            {
                                                "example_id": "f88e93e9-aeb0-49b7-9c11-18a29165a91b",
                                                "sense_id": "2e1552f1-e34c-34ac-98b1-587e1f0d41d5",
                                                "text": "„Der Ire war in seiner Anrede an den Kreolen natürlich im parlez-vous français steckengeblieben und hatte auf sein weiteres im rauhen irischen Dialekte vorgebrachtes Kauderwelsch ein »je n'entends pas« zur Antwort erhalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a43f6fff-0a92-300b-b356-7fc58d788341",
                                        "entry_id": "417b72d2-8149-3eee-899c-aecc1686e5f9",
                                        "glosses": [
                                            "Nachkomme von aus den afrikanischen Ländern verschleppten Sklaven in Brasilien"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Kreole",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f71259cc-2e55-32a4-9a0f-9ef71868c34a",
                                        "entry_id": "b81c37f3-e1d6-31c2-b26f-1c0b6e6886a0",
                                        "glosses": [
                                            "großer, ringförmiger Ohrschmuck, in den ein kleiner Schmuckstein eingehängt werden kann"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb1f315a-fb2f-4f87-8dea-98350e82e3de",
                                                "sense_id": "f71259cc-2e55-32a4-9a0f-9ef71868c34a",
                                                "text": "Sie trug 20 mm großen Kreolen aus Silber."
                                            },
                                            {
                                                "example_id": "60290982-ffea-49fb-8e2a-a04ff89e0165",
                                                "sense_id": "f71259cc-2e55-32a4-9a0f-9ef71868c34a",
                                                "text": "„Bevor wir ihren Anweisungen folgen konnten, kam eine junge Frau in bunter Kleidung in den Flur, ihre Haare ein stolzer Afro, in ihren Ohrläppchen klimperten Kreolen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5fd27ea7-a361-4a84-b852-6cb3b61e1ebf",
                        "source_entry_id": "499a7328-40be-3420-84a2-dd81e84ee65e",
                        "source_sense_id": "e8d86be0-b4d6-362f-8dd4-02e8a0d1e892",
