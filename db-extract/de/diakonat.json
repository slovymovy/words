                "senses": [
                    {
                        "sense_id": "8154eeb5-3476-35bd-90ee-ec167eba17f4",
                        "entry_id": "ef24d0e1-09fc-3c12-b6d3-3dae2293cbb3",
                        "glosses": [
                            "nachgeordnetes kirchliches Amt (Amt des Diakons)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e0e9557-b8fc-4315-9042-c56431a81403",
                                "sense_id": "8154eeb5-3476-35bd-90ee-ec167eba17f4",
                                "text": "„In jedem Fall lässt sich feststellen, dass neuere Veröffentlichungen über den Diakonat das Thema ‚Diakonat der Frau‘ frei von Verdächtigungen und Angst wieder aufgreifen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1ee1b2a3-3a12-3ba1-b76a-8b41b6979f1e",
                        "entry_id": "ef24d0e1-09fc-3c12-b6d3-3dae2293cbb3",
                        "glosses": [
                            "einzelne Stelle eines Diakons"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f407f26-dee9-4857-921d-d484b241d21e",
                                "sense_id": "1ee1b2a3-3a12-3ba1-b76a-8b41b6979f1e",
                                "text": "„ Bisher nämlich war mit der Lehrerstelle ein Diakonat verbunden, wodurch sie, obgleich immer noch gering ausgestattet, doch annehmbar gemacht wurde.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "4b391264-1eb1-3b07-abdb-5e61826b2744",
                        "entry_id": "ef24d0e1-09fc-3c12-b6d3-3dae2293cbb3",
                        "glosses": [
                            "Wohnung eines Diakons"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7c77868-aa4e-4dc0-bb49-bb7bd3f6bbee",
                                "sense_id": "4b391264-1eb1-3b07-abdb-5e61826b2744",
                                "text": "„Bis z. J. 1865 hat das Diakonat als Wohnung für den zweiten Geistlichen gedient.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "413a9d1d-4751-32ff-acf1-0e321d682e0d",
                        "entry_id": "ef24d0e1-09fc-3c12-b6d3-3dae2293cbb3",
                        "glosses": [
                            "kirchlicher Dienst an Hilfsbedürftigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a887f3b-4ec2-43b6-8eec-d3ba25741c89",
                                "sense_id": "413a9d1d-4751-32ff-acf1-0e321d682e0d",
                                "text": "„Seit seiner Entstehung war das Hospital zugleich das öffentliche Krankenhaus der Gemeinde gewesen. Hierher überwies das Diakonat diejenigen unbemittelten Kranken, deren Aufnahme der Krankheit oder der häuslichen Verhältnisse wegen vom Arzte für notwendig erkannt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
