                        ],
                        "form": "die Reifenabriebe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ce86ff52-ca55-3cc3-9e7a-05bbb0739275",
                        "entry_id": "488d2193-ded9-3dc5-a10d-9e4dbdf37791",
                        "glosses": [
                            "durch Fahren eines PKWs oder LKWs verursachter Materialverlust von Fahrzeugreifen; Reifenabrieb entsteht durch Reibung der Reifen auf der Fahrbahn"
                        ],
                        "tags": [
                            "Umwelt",
                            "Plural selten"
                        ],
                        "examples": [
                            {
                                "example_id": "bd4e8c7c-4b68-493b-a1d7-169e33da1ed0",
                                "sense_id": "ce86ff52-ca55-3cc3-9e7a-05bbb0739275",
                                "text": "[2025:] Bis heute fehlen Grenzwerte in der EU und auch in Deutschland für Reifenabrieb."
                            },
                            {
                                "example_id": "dc2e1fc6-d131-4a90-9fda-eebca767f754",
                                "sense_id": "ce86ff52-ca55-3cc3-9e7a-05bbb0739275",
                                "text": "Reifenabrieb ist eine relevante Quelle für Mikroplastik in der Umwelt und steht zunehmend im Fokus von Umwelt-, Verkehrs- und Gesundheitsdiskussionen."
                            },
                            {
                                "example_id": "e2e5abf8-18c6-4822-b5af-f7357ff03e7f",
                                "sense_id": "ce86ff52-ca55-3cc3-9e7a-05bbb0739275",
                                "text": "„Durch Reifenabrieb werden jedes Jahr tausende Tonnen Mikroplastik freigesetzt.“"
                            },
                            {
                                "example_id": "91df0d1e-15a5-4e45-8065-c2a46ffff18c",
                                "sense_id": "ce86ff52-ca55-3cc3-9e7a-05bbb0739275",
                                "text": "„Reifenabrieb ist eine der Hauptquellen von Mikroplastik in der Umwelt.“"
                            },
                            {
                                "example_id": "c003dd5e-c5a6-43e0-8e39-51a7b2201bf0",
                                "sense_id": "ce86ff52-ca55-3cc3-9e7a-05bbb0739275",
                                "text": "„Reifenabrieb entsteht nicht nur bei einer Vollbremsung oder bei einem schnellen Start, wenn die Räder durchdrehen. Auch bei ganz normalem Fahren, bei gleichbleibender Geschwindigkeit reibt sich der Reifen der Autos an der Strasse ab.“"
                            },
                            {
                                "example_id": "53653299-4b6e-4bb2-8a7f-4d177471d30d",
                                "sense_id": "ce86ff52-ca55-3cc3-9e7a-05bbb0739275",
                                "text": "„Auch wenn immer mehr elektrisch betriebene Autos dazu kommen […] wird das Problem des Reifenabriebs dadurch nicht kleiner. Da E-Autos meist schwerer sind, produzieren sie auch mehr Abrieb.“"
                            },
                            {
                                "example_id": "7991a65e-e185-444e-95b5-1a5a54f2d967",
                                "sense_id": "ce86ff52-ca55-3cc3-9e7a-05bbb0739275",
                                "text": "„Der Reifenabrieb steigt mit dem zulässigen Gesamtgewicht der Fahrzeuge und mit der Motorleistung (je nach Datenquelle:) 53–200 mg/km Fahrleistung bei PKWs, 105–1.700 mg/km bei LKWs, 1.000–1.500 mg/km bei Sattelzügen.“"
                            },
                            {
                                "example_id": "8d18fda5-c56b-4086-a858-d511cf35865c",
                                "sense_id": "ce86ff52-ca55-3cc3-9e7a-05bbb0739275",
                                "text": "[In Europa gelangen] „500.000 Tonnen Mikroplastik jedes Jahr durch Reifenabrieb in die Umwelt, weltweit wird die Zahl auf 6,1 Millionen Tonnen geschätzt.“"
                            },
                            {
                                "example_id": "cb11239e-4a84-42dd-9e00-48838071be9a",
                                "sense_id": "ce86ff52-ca55-3cc3-9e7a-05bbb0739275",
                                "text": "[Flugverkehr:] „Das Portal Aero.de zitiert aus einem internen Lufthansa-Memo: »Es kommt zu massivem Reifenabrieb bei Landung und einer Häufung von Reifen, die nach der Landung nicht mehr nutzbar sind.«“"
                            },
                            {
                                "example_id": "2d327392-1acc-4d8e-aa97-0ad23b30f094",
                                "sense_id": "ce86ff52-ca55-3cc3-9e7a-05bbb0739275",
                                "text": "„Mikroplastik aus Reifenabrieb belastet die Luft an Hamburgs Hauptstraßen.“"
                            },
                            {
                                "example_id": "5ac04b64-c47d-4bd2-af2a-861f2156e095",
                                "sense_id": "ce86ff52-ca55-3cc3-9e7a-05bbb0739275",
                                "text": "„Besonders hohe Feinstaubkonzentrationen werden unter anderem wegen der starken verkehrsbedingten Emissionen wie (Diesel-)Ruß, Reifenabrieb sowie aufgewirbeltem Staub an verkehrsnahen Messstationen registriert.“"
                            },
                            {
                                "example_id": "a96ab5dc-a284-4736-bd4e-d430a2a292ec",
                                "sense_id": "ce86ff52-ca55-3cc3-9e7a-05bbb0739275",
                                "text": "[Schlagzeile:] „Mikroplastik auf dem Teller: Wie Reifenabrieb uns krank machen kann“"
                            },
                            {
                                "example_id": "8ce1c88a-515a-4fea-b20e-1e2ce5f51442",
                                "sense_id": "ce86ff52-ca55-3cc3-9e7a-05bbb0739275",
                                "text": "[Schlagzeile:] „Reifenabrieb im Gemüse - Umweltbelastung Mikroplastik – Die tägliche Portion Reifenabrieb“"
                            },
                            {
                                "example_id": "6551b9e5-2676-4d31-b858-434c411612f2",
                                "sense_id": "ce86ff52-ca55-3cc3-9e7a-05bbb0739275",
                                "text": "„Mikroplastik und Feinstaub stellen bekannte Gesundheitsrisiken dar, der Reifenabrieb wurde bisher oft vernachlässigt.“"
                            },
                            {
                                "example_id": "8dfbac1c-c4ac-4550-a607-71a1e75c9c05",
                                "sense_id": "ce86ff52-ca55-3cc3-9e7a-05bbb0739275",
                                "text": "„Was nicht viele wissen: Reifenabrieb ist die größte Quelle für Mikroplastik - und eine Gesundheitsgefahr.“"
                            },
                            {
                                "example_id": "46b7d873-c34a-4a72-a515-ac0f3dafaf6c",
                                "sense_id": "ce86ff52-ca55-3cc3-9e7a-05bbb0739275",
                                "text": "„Wird der Reifenabrieb in die Flüsse gespült, oxidiert er und ist für Silberlachse hochgiftig.“"
                            },
                            {
                                "example_id": "dc63b5c0-c951-4b92-a7ea-802a9013fd09",
                                "sense_id": "ce86ff52-ca55-3cc3-9e7a-05bbb0739275",
                                "text": "„Ein Viertel des Mikroplastiks im Meer stammt vom Reifenabrieb.“"
                            },
                            {
                                "example_id": "df4b373d-3720-4855-be5b-6caafc6b9417",
                                "sense_id": "ce86ff52-ca55-3cc3-9e7a-05bbb0739275",
                                "text": "[2023:] „Die Europäische Union will mit der Euro 7 Norm erstmals Grenzwerte für den Reifenabrieb festlegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
