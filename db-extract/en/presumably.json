                "senses": [
                    {
                        "sense_id": "02ec4e5d-cd1f-36cd-bc44-49ee8da1f7d2",
                        "entry_id": "1bb75cc1-9b52-327a-bd0e-e4ee37e715d4",
                        "glosses": [
                            "Able to be sensibly presumed."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23034cc9-a118-4026-87f7-b3efe813ec71",
                                "sense_id": "02ec4e5d-cd1f-36cd-bc44-49ee8da1f7d2",
                                "text": "Presumably, he will attend the opening."
                            },
                            {
                                "example_id": "f79a587f-2470-4e2f-8862-e412d8464e52",
                                "sense_id": "02ec4e5d-cd1f-36cd-bc44-49ee8da1f7d2",
                                "text": "Capello made a change on the hour which was presumably enforced by injury as the excellent Young was replaced by Stewart Downing."
                            },
                            {
                                "example_id": "0d4b3de0-e829-4e17-84ca-a3182b0fef30",
                                "sense_id": "02ec4e5d-cd1f-36cd-bc44-49ee8da1f7d2",
                                "text": "Yet this is the level of [neural] organisation that does the actual thinking—and is, presumably, the seat of consciousness."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f3afa2c3-5465-485c-824b-20fa59baeec7",
                        "source_entry_id": "1bb75cc1-9b52-327a-bd0e-e4ee37e715d4",
                        "source_sense_id": "02ec4e5d-cd1f-36cd-bc44-49ee8da1f7d2",
                        "source_sense_description": "able to be sensibly presumed",
                        "target_lang_word": "vermoedelijk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vermoedelijk",
