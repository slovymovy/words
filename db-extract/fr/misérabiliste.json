                                "text": "Belles photos, mais parfois trop misérabilistes."
                            }
                        ]
                    },
                    {
                        "sense_id": "39afac49-eaca-32d1-b5a0-0939de8c3d32",
                        "entry_id": "f37d3585-427a-329c-b9ab-f7b1ecc1517a",
                        "glosses": [
                            "Qui dépeint la misère de façon crue, pesante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1532ec6c-5f6d-4219-ac73-210a71d08535",
                                "sense_id": "39afac49-eaca-32d1-b5a0-0939de8c3d32",
                                "text": "Trop souvent, l’immigration fait l’objet de discours misérabilistes ou mystificateurs : les immigré-e-s sont des éternelles victimes ou des héros mythiques."
                            },
                            {
                                "example_id": "05b41fb4-afaa-40a1-b546-f4620e212489",
                                "sense_id": "39afac49-eaca-32d1-b5a0-0939de8c3d32",
                                "text": "Pourtant, Kate Tempest n’est pas misérabiliste, elle aime ses personnages, leur vulnérabilité, leur sincérité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "625de8dd-2683-4fd1-9c0b-a22bc7dcdbb1",
                        "source_entry_id": "f37d3585-427a-329c-b9ab-f7b1ecc1517a",
                        "target_lang_word": "miserabilist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "miserabilist",
