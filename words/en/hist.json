                    "frequency": "VeryLow",
                    "semantic_group_id": "attention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He whispered a soft <w>hist</w> to get his friend's attention without alerting the teacher.",
                            "target_lang_translations": {
