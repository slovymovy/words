                        "form": "die Parzelle"
                    },
                    {
                        "form_id": "58f15df4-ae8d-47e7-baca-5a20b3eea380",
                        "entry_id": "28757d54-7967-329b-a3d3-7f0675bcdeb6",
                        "tags": [
                            "accusative",
