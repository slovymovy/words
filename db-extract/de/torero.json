                    },
                    {
                        "sense_id": "76da8b62-77d4-3d00-9722-9596abd0fcb9",
                        "entry_id": "93b7c84c-2224-3c44-9ca4-4ec3507abc95",
                        "glosses": [
                            "Person, die (beruflich) unberitten einen Stierkampf bestreitet"
