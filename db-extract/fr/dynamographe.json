                        "glosses": [
                            "Instrument qui sert à mesurer la force musculaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c525d21-60a8-412d-8f82-7b5908c49d47",
                                "sense_id": "78de94eb-4610-3105-a382-58c9a96432d6",
                                "text": "Lʼappareil utilisé est le dynamographe de Bettendorff ; il permet lʼappréciation de la traction développée par chaque main séparément pour des forces égales ou inférieures à 70 kg."
                            }
                        ]
                    }
