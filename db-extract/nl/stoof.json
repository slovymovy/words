                    {
                        "translation_id": "38ec3ab2-e586-4fa8-9f25-48b0d635b738",
                        "source_entry_id": "cc0bf5eb-c0e0-3803-86a5-a5cb0998a658",
                        "source_sense_id": "bd9a39db-d45e-3234-9f33-5300627cba32",
                        "source_sense_description": "toestel waarin een vuur brandt om een ruimte te verwarmen",
                        "target_lang_word": "footwarmer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "footwarmer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3def1959-d8bc-3be8-a8e8-eeea61ac2a1f",
                                        "entry_id": "740255fd-f358-3506-9cc2-2176c0edf0dc",
                                        "glosses": [
                                            "Something used to keep the feet warm, especially during a journey."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7a85133-4c8f-4f34-938c-c16ef4dc8e20",
                                                "sense_id": "3def1959-d8bc-3be8-a8e8-eeea61ac2a1f",
                                                "text": "Sturrock records that he found hot-water footwarmers in use on the Northern Railway of France in about 1857, and that he was so impressed with the extra comfort obtained from this simple device that he obtained permission from the French authorities to bring one to England. A dozen similar, but smaller footwarmers were made at Doncaster, without official sanction, and placed in the coaches of a train conveying some of the directors to London. Sturrock was taken to task by the chairman for having incurred this unauthorised expenditure, but before he left the meeting, the directors had ordered 200 footwarmers for public use."
                                            },
                                            {
                                                "example_id": "bbe28c07-424c-497d-97cb-975ec9bbbc38",
                                                "sense_id": "3def1959-d8bc-3be8-a8e8-eeea61ac2a1f",
                                                "text": "There was no steam heating, but footwarmers were provided in winter to alleviate the long and rigorous journey to Burtonport."
                                            },
                                            {
                                                "example_id": "468d414f-e907-458e-8e4d-90e3689c0987",
                                                "sense_id": "3def1959-d8bc-3be8-a8e8-eeea61ac2a1f",
                                                "text": "stoves warmed and clarified the air, and there were always hotwater bottles and footwarmers for cold nights."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
