    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "332e9177-245b-3ada-b5fc-4aabf64bd4e2",
                    "sense_definition": "Triompher d'une épreuve, d'une difficulté ou maîtriser une émotion.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "vaincre_obstacle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a réussi à <w>surmonter</w> sa peur de parler en public grâce à des entraînements réguliers."
                        },
                        {
                            "text": "L'équipe a dû <w>surmonter</w> un obstacle imprévu pour remporter la victoire."
                        }
                    ],
                    "synonyms": [
                        "vaincre"
                    ],
                    "common_phrases": [
                        "surmonter un obstacle",
                        "surmonter sa peur",
                        "surmonter une épreuve"
                    ]
                },
                {
                    "sense_id": "89b9de4f-0cd4-3a9f-8fa3-4c27604d2bc2",
                    "sense_definition": "Être placé au-dessus ou au sommet de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "position_sommet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le clocher du village est <w>surmonté</w> d'une croix en fer forgé visible de loin."
                        },
                        {
                            "text": "Ce meuble ancien est <w>surmonté</w> d'un magnifique miroir doré."
                        }
                    ],
                    "common_phrases": [
                        "surmonté d'une croix",
                        "surmonté d'une coupole"
                    ]
                },
                {
                    "sense_id": "366c5765-ccb3-33e6-bb87-025876080a42",
                    "sense_definition": "L'emporter sur quelqu'un par des qualités ou dans une compétition.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "surpasser",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune athlète a <w>surmonté</w> tous ses concurrents lors de la finale."
                        },
                        {
                            "text": "Il a su <w>surmonter</w> ses rivaux grâce à une stratégie particulièrement brillante."
                        }
                    ],
                    "common_phrases": [
                        "surmonter ses concurrents",
                        "surmonter ses rivaux"
                    ]
                },
                {
                    "sense_id": "274f2ab4-b4d6-3ad9-a7b9-6d359e3b81ed",
                    "sense_definition": "Monter au-delà d'un niveau physique déterminé ou franchir en s'élevant.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "monter_au_dessus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs jours de pluie torrentielle, le fleuve a <w>surmonté</w> la digue de protection."
                        },
                        {
                            "text": "La marée a rapidement <w>surmonté</w> les rochers qui protégeaient la côte."
                        }
                    ],
                    "common_phrases": [
                        "surmonter la digue"
                    ]
                }
            ]
        }
    ]
}