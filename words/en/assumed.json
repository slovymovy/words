{
    "word_family": [
        "assume",
        "assumption",
        "assumable",
        "assumptive",
        "unassumed"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5f069cb2-4baf-38dd-9793-3018a6ef004d",
                    "sense_definition": "Supposed or presumed to be true without proof.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "presumed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>assumed</w> risk of the investment made many potential buyers hesitate.",
                            "target_lang_translations": {
                                "ru": "<w>Предполагаемый</w> риск инвестиций заставил многих потенциальных покупателей колебаться."
                            }
                        },
                        {
                            "text": "Under the <w>assumed</w> premise that the weather would remain clear, they planned an outdoor event.",
                            "target_lang_translations": {
                                "ru": "Исходя из <w>предполагаемой</w> предпосылки, что погода останется ясной, они запланировали мероприятие на открытом воздухе."
                            }
                        }
                    ],
                    "synonyms": [
                        "understood"
                    ],
                    "antonyms": [
                        "proven",
                        "known"
                    ],
                    "common_phrases": [
                        "assumed risk",
                        "assumed premise"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предполагаемый или принимаемый за истину без доказательств."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предполагаемый",
                                "target_lang_sense_clarification": "допускаемый, гипотетический"
                            },
                            {
                                "target_lang_word": "допускаемый",
                                "target_lang_sense_clarification": "принимаемый по умолчанию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54a2b609-acaa-3ce3-9a59-348f505c8d90",
                    "sense_definition": "Used in a manner intended to deceive; pretended or simulated.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pretended",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He traveled under an <w>assumed</w> identity to avoid being recognized by the press.",
                            "target_lang_translations": {
                                "ru": "Он путешествовал под <w>вымышленным</w> именем, чтобы избежать опознания прессой."
                            }
                        },
                        {
                            "text": "Her expression of concern was entirely <w>assumed</w> to gain their sympathy.",
                            "target_lang_translations": {
                                "ru": "Ее выражение беспокойства было полностью <w>наигранным</w>, чтобы завоевать их сочувствие."
                            }
                        }
                    ],
                    "antonyms": [
                        "genuine",
                        "real"
                    ],
                    "common_phrases": [
                        "assumed identity",
                        "assumed name"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используемый с целью обмана; вымышленный, притворный или симулированный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вымышленный",
                                "target_lang_sense_clarification": "особенно об имени или личности"
                            },
                            {
                                "target_lang_word": "притворный",
                                "target_lang_sense_clarification": "наигранный, симулированный"
                            },
                            {
                                "target_lang_word": "чужой",
                                "target_lang_sense_clarification": "о принятом имени или личности"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5cb82492-64c1-3ecd-8d85-375e2ccc30fc",
                    "sense_definition": "Simple past tense and past participle of <w>assume</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>assumed</w> control of the company after the president resigned.",
                            "target_lang_translations": {
                                "ru": "Она <w>приняла</w> руководство компанией после того, как президент ушел в отставку."
                            }
                        },
                        {
                            "text": "I <w>assumed</w> you were coming to the party since you didn't decline the invite.",
                            "target_lang_translations": {
                                "ru": "Я <w>предположил</w>, что ты придешь на вечеринку, так как ты не отклонил приглашение."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола assume (предполагать, принимать на себя)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предположил",
                                "target_lang_sense_clarification": "подумал, что это так"
                            },
                            {
                                "target_lang_word": "принял",
                                "target_lang_sense_clarification": "взял на себя (обязанности, руководство)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}