                                        "glosses": [
                                            "To fasten or secure with a leash."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0d4676df-ab17-3a4f-8525-902304dd71c4",
                                        "entry_id": "c618628c-0dc5-3021-920a-badbed3e3e32",
                                        "glosses": [
                                            "to curb, restrain"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0681c4b9-54d4-4dd0-b469-15386bc4e6cc",
                                                "sense_id": "0d4676df-ab17-3a4f-8525-902304dd71c4",
                                                "text": "Man is brow-beaten, leashed, muzzled, masked, and lashed by boards and councils, by leagues and societies, by church and state."
                                            }
                                        ]
                                    }
