        "nl-extract.jsonl": [
            {
                "entry_id": "61f3d17a-f36f-3e0a-8302-79d25d7fb659",
                "word": "verhouten",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "368aa7e6-1898-3825-933d-6f140e6b979b",
                        "entry_id": "61f3d17a-f36f-3e0a-8302-79d25d7fb659",
                        "glosses": [
                            "een houtachtige structuur krijgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c449c4be-2036-4015-8cb1-a734bfba3f93",
                                "sense_id": "368aa7e6-1898-3825-933d-6f140e6b979b",
                                "text": "„Bamboe is een alternatief voor hout. Doordat de grasplant verhout, kun je er allerlei interessante en decoratieve producten van maken”, zegt René Zaal, directeur van Moso."
                            },
                            {
                                "example_id": "16f8035c-1393-4560-a721-56271281f090",
                                "sense_id": "368aa7e6-1898-3825-933d-6f140e6b979b",
                                "text": "Natuurwetenschapper Charles Darwin hield zich daar ook al mee bezig: hij ontdekte dat planten onder bepaalde omstandigheden kunnen 'verhouten'. Zo groeien er bijvoorbeeld op de Canarische eilanden grote, houtachtige madeliefjes en paardenbloemen, die geen stengel hebben maar een houten stam."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39c66f21-8df8-4f29-902e-c7382374d355",
                        "source_entry_id": "61f3d17a-f36f-3e0a-8302-79d25d7fb659",
                        "source_sense_id": "368aa7e6-1898-3825-933d-6f140e6b979b",
                        "source_sense_description": "een houtachtige structuur krijgen",
                        "target_lang_word": "verholzen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verholzen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2ee4d26f-e723-3612-8f22-b41d1b2851a7",
                                        "entry_id": "f29fec08-128e-3571-af7d-7a0397dd68da",
                                        "glosses": [
                                            "statt weich und biegsam zu bleiben, mit der Zeit holzartiger/holzig werden, als Pflanze einen Stamm entwickeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8deba389-d76c-4e88-bea4-4c2fd438a3c3",
                                                "sense_id": "2ee4d26f-e723-3612-8f22-b41d1b2851a7",
                                                "text": "„Manche Kräuter verholzen mit den Jahren. Das heißt, ihre Triebe entstehen nicht jedes Jahr aus dem Wurzelstock neu wie bei den Stauden, sondern sie entwickeln einen festen Stamm, aus dem sie im Frühling frisch austreiben.“"
                                            },
                                            {
                                                "example_id": "28c658f3-e520-496b-85a6-67b5a034fd4d",
                                                "sense_id": "2ee4d26f-e723-3612-8f22-b41d1b2851a7",
                                                "text": "„Ein Verstummter läßt nicht mit sich reden. Ich verlor die Freundlichkeit. Ich verholzte. Und ein Stück Holz bin ich geblieben, das Verstummen habe ich gründlich gelernt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
