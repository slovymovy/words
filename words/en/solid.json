                                "target_lang_word": "цельный",
                                "target_lang_sense_clarification": "без пустот"
                            },
                            {
                                "target_lang_word": "сплошной",
                                "target_lang_sense_clarification": "однородный"
                            },
                            {
                                "target_lang_word": "массивный",
                                "target_lang_sense_clarification": "о материале"
                            },
                            {
                                "target_lang_word": "чистый",
                                "target_lang_sense_clarification": "о драгоценных металлах"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "som",
                                "target_lang_sense_clarification": "altın veya gümüş gibi saf maddeler için"
                            },
                            {
                                "target_lang_word": "masif",
                                "target_lang_sense_clarification": "ahşap ve mobilya için"
                            },
                            {
                                "target_lang_word": "dolu",
                                "target_lang_sense_clarification": "içi boş olmayan"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "实心",
                                "target_lang_sense_clarification": "无空隙"
                            },
                            {
                                "target_lang_word": "纯",
                                "target_lang_sense_clarification": "指贵金属"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2cc5f936-bac5-3b2d-91de-62e658b11eea",
                    "sense_definition": "Of good quality and reliable; something you can trust or depend on.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team has a <w>solid</w> plan to finish the project on time.",
                            "target_lang_translations": {
                                "ru": "У команды есть <w>надёжный</w> план, чтобы завершить проект вовремя.",
                                "tr": "Takımın projeyi zamanında bitirmek için <w>sağlam</w> bir planı var.",
                                "zh": "团队有一个<w>扎实</w>的计划来按时完成项目。"
                            }
                        },
                        {
                            "text": "He is a <w>solid</w> worker who never misses a day of work.",
                            "target_lang_translations": {
                                "ru": "Он <w>добросовестный</w> работник, который не пропускает ни одного рабочего дня.",
                                "tr": "O, bir gün bile işi aksatmayan <w>güvenilir</w> bir çalışandır.",
                                "zh": "他是一位<w>可靠</w>的员工，从不缺勤。"
                            }
                        }
                    ],
                    "synonyms": [
                        "substantial"
                    ],
                    "antonyms": [
                        "unreliable",
                        "weak"
