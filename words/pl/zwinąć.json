                    "sense_definition": "ukraść coś komuś",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kradzież",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ktoś <w>zwinął</w> mi mój nowy plecak na przystanku.",
                            "target_lang_translations": {
                                "ru": "Кто-то <w>стащил</w> у меня мой новый рюкзак на остановке."
                            }
                        },
                        {
                            "text": "Ktoś <w>zwinął</w> portfel z otwartej torebki.",
                            "target_lang_translations": {
