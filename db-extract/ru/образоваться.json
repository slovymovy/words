                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c5a408c-7c36-447f-aea9-1fc26576aac1",
                                "sense_id": "10ada06f-81f2-35a3-8a2d-1654209edd12",
                                "text": "Из-за длительного воздействия волн в борту корабля образовалась течь.",
                                "translation": "By long-time waves effection a leak has appeared in the ship's board.",
                                "english": "By long-time waves effection a leak has appeared in the ship's board."
                            },
                            {
                                "example_id": "38e4cac1-807e-415a-8ab7-d5caa097c953",
                                "sense_id": "10ada06f-81f2-35a3-8a2d-1654209edd12",
                                "text": "Солнечная система образовалась из протопланетного облака более четырёх миллиардов лет назад.",
                                "translation": "The Solar System appeared from a proto-planet cloud more than four milliards years ago.",
                                "english": "The Solar System appeared from a proto-planet cloud more than four milliards years ago."
                            }
                        ]
                    },
