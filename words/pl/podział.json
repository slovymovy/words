                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "klasyfikacja",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tradycyjny <w>podział</w> na literaturę piękną i literaturę faktu bywa we współczesnym świecie mylący.",
                            "target_lang_translations": {
                                "ru": "Традиционное <w>деление</w> на художественную литературу и нон-фикшн в современном мире бывает обманчивым."
                            }
                        },
                        {
                            "text": "W biologii stosuje się ścisły <w>podział</w> organizmów żywych na królestwa i gatunki.",
                            "target_lang_translations": {
                                "ru": "В биологии применяется строгая <w>классификация</w> живых организмов по царствам и видам."
                            }
                        }
                    ],
                    "synonyms": [
