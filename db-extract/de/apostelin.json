                "senses": [
                    {
                        "sense_id": "7d83452c-439e-31c1-823e-bcee7bf06876",
                        "entry_id": "cd11aa4f-de3f-3638-8c79-4f086714e419",
                        "glosses": [
                            "herausragende Glaubensverkünderin der Urkirche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a20f46f-19c5-453f-bae2-4951502b6710",
                                "sense_id": "7d83452c-439e-31c1-823e-bcee7bf06876",
                                "text": "„Wie wirksam die Ausschließung von Frauen ist, zeigt sich am Beispiel der Apostelin Junia.“"
                            },
                            {
                                "example_id": "f455a301-f7c1-4f92-83ac-f34e11ec431b",
                                "sense_id": "7d83452c-439e-31c1-823e-bcee7bf06876",
                                "text": "„Bei solchen Texten lassen sich fließende Übergänge in die hagiographische Literatur sehen, besonders reichhaltig bei jenen Texten, in denen die Mutter Maria bzw. die Apostelin Thekla im Mittelpunkt stehen..“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0957d112-f8a8-3a54-8165-8d40d6790d49",
                        "entry_id": "cd11aa4f-de3f-3638-8c79-4f086714e419",
                        "glosses": [
                            "engagierte Vertreterin einer bestimmten Lehre"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "297a32b1-fb73-4dd2-b423-0aa6b9a6ef84",
                                "sense_id": "0957d112-f8a8-3a54-8165-8d40d6790d49",
                                "text": "Da schwingt sich eine zur Apostelin auf."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
