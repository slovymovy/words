                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "językoznawstwo",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "2c6333fc-2145-3e94-a669-59227ed040bf",
                                        "entry_id": "f495faac-a0e1-3140-9c8f-da830714884e",
                                        "glosses": [
                                            "nauka o języku"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "858fa67a-eaa5-42d0-ad4b-5ee51b809666",
                                                "sense_id": "2c6333fc-2145-3e94-a669-59227ed040bf",
                                                "text": "Głównymi dyscyplinami wchodzącymi w skład kognitywistyki są: neurobiologia, neuropsychologia, neurokognitywistyka, społeczna nauka poznawcza, psychologia poznawcza, informatyka, sztuczna inteligencja, robotyka kognitywna, językoznawstwo kognitywne, teoria obliczeń i teoria informacji, antropologia kulturowa, filozofia umysłu oraz wybrane działy logiki (zwłaszcza logika epistemiczna, doksastyczna, semantyka logiczna i teoria systemów dedukcyjnych z jej twierdzeniami limitacyjnymi)."
                                            },
                                            {
                                                "example_id": "d8c182c1-5bfa-4d8e-9be1-791510263fbc",
                                                "sense_id": "2c6333fc-2145-3e94-a669-59227ed040bf",
                                                "text": "Językoznawstwo teoretyczne próbuje budować modele służące opisywaniu poszczególnych języków oraz teorie dotyczące uniwersalnych aspektów języka."
                                            },
                                            {
                                                "example_id": "0714e0bd-e0cd-49bd-af17-5b168a5212bb",
                                                "sense_id": "2c6333fc-2145-3e94-a669-59227ed040bf",
                                                "text": "Zbigniew Herbert mówił ponoć, że gdy chce się zdrowo pośmiać, sięga po pracę Stalina o językoznawstwie i nigdy nie doznaje zawodu"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
