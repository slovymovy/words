                    {
                        "sense_id": "b1d9d1c8-92ca-3fa6-a708-91201de899fc",
                        "entry_id": "898bc274-09ed-3c7a-9ee5-8f47f2c8cafe",
                        "glosses": [
                            "cecha tego, kto lub co jest beznamiętne; obojętność, apatia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b15b7507-0e52-498a-ae89-c02eb038f75d",
                                "sense_id": "b1d9d1c8-92ca-3fa6-a708-91201de899fc",
                                "text": "Beznamiętność, z jaką lekarz mówił o pacjencie i jego cierpieniu, zadziwiła słuchających go studentów medycyny."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61220a73-26ed-41a8-943d-f601d24334e5",
