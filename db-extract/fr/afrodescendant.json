                "senses": [
                    {
                        "sense_id": "79352426-ab7a-39c0-a20f-1e923013e0e0",
                        "entry_id": "6de57b43-a351-39ab-a493-e16555448057",
                        "glosses": [
                            "Être humain d’ascendance africaine, affilié à la diaspora africaine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "967c17cc-65fc-4082-9e29-44eb0b19d64f",
                                "sense_id": "79352426-ab7a-39c0-a20f-1e923013e0e0",
                                "text": "Le cliché le plus choquant était celui d'un Afrodescendant dépouillé de ses dents, mais arborant un large sourire et la fameuse carte de crédit entre ses mains."
                            },
                            {
                                "example_id": "b2a1cf68-9ea5-41b5-a06f-9323ed509e58",
                                "sense_id": "79352426-ab7a-39c0-a20f-1e923013e0e0",
                                "text": "Vous citez trois livres sur l'esclavage, dont aucun n'a été écrit par un Afrodescendant."
                            }
                        ]
                    }
                ],
