                "senses": [
                    {
                        "sense_id": "8c73eca6-b20a-3c76-93dc-8d1f341400b7",
                        "entry_id": "65e2a83f-c0d5-322c-b557-9c1fbbb4ee49",
                        "glosses": [
                            "Behauptung, etwas verletze moralische Prinzipien, mit dem Ziel, unerwünschte Handlungen oder Werke zu verhindern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1660812-3b3d-4f76-9672-9db6e9d07496",
                                "sense_id": "8c73eca6-b20a-3c76-93dc-8d1f341400b7",
                                "text": "„Beispielsweise gelang es Ende der sechziger Jahre einem an sich völlig unverdächtigen Werk, so einen Rundumschlag mit der Moralkeule auszulösen.“"
                            },
                            {
                                "example_id": "62930547-fd0b-4bd5-92ee-5abe21e822db",
                                "sense_id": "8c73eca6-b20a-3c76-93dc-8d1f341400b7",
                                "text": "„Um das auszuhalten – den Verrat, das Ducken, das Sicheinrichten in der Normalität –, holen sie mit der Moralkeule aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
