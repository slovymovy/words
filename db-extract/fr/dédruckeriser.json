                "senses": [
                    {
                        "sense_id": "745bd6ef-a762-3838-8405-4f76b780c16f",
                        "entry_id": "aad66ccd-7286-38b4-afce-20abe8545019",
                        "glosses": [
                            "Se défaire d’un ton rappelant les émissions de Michel Drucker à la télévision."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58936aff-b28b-4dcc-91b3-69585ef4fd54",
                                "sense_id": "745bd6ef-a762-3838-8405-4f76b780c16f",
                                "text": "L’expérience Loft story aura, en fin de compte, permis au gentil chroniqueur de Studio Gabriel de se « dédruckeriser », d’affirmer une image moins consensuelle, plus sulfureuse."
                            },
                            {
                                "example_id": "f0c7d3fc-fb5e-4685-8be5-2699deef5c12",
                                "sense_id": "745bd6ef-a762-3838-8405-4f76b780c16f",
                                "text": "C’est alors Matthieu Delormeau qui monte au créneau : \"Non mais à un moment, Cyril, faut vous dédruckeriser... Genre, vous adorez ça ? Menteur ! Vous parlez de la fille...\""
                            },
                            {
                                "example_id": "337e2f50-3354-4ac6-825c-98667856628b",
                                "sense_id": "745bd6ef-a762-3838-8405-4f76b780c16f",
                                "text": "Dédruckerisez-vous, déboujenahisez-vous, débruelisez-vous, délumbrosoïsiez-vous, défoucaultisez-vous, déguettaïsez-vous, dégainsbourguisez-vous (…)"
                            }
                        ]
                    }
                ],
