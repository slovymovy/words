                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "seksualność",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po kilku randkach niespodziewanie postanowiła, że mu <w>da</w>.",
                            "target_lang_translations": {
                                "en": "After a few dates, she unexpectedly decided to <w>sleep with</w> him."
                            }
