                "senses": [
                    {
                        "sense_id": "e16fad38-83c0-3d5d-9399-2732c2e31ea0",
                        "entry_id": "836a04d7-c6a0-34d5-b8fc-5ac0944608c6",
                        "glosses": [
                            "Qui se compose de grains issus de l’érosion d’autres roches."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "055d1b55-f24a-4862-ba6d-6e66e7e2f1f5",
                                "sense_id": "e16fad38-83c0-3d5d-9399-2732c2e31ea0",
                                "text": "Un rapide examen au microscope polarisant montre la dualité de la composition minéralogique, des grains de quartz détritiques (indiquant une érosion continentale) et des oxydes de fer comme l'hématite et la magnétite."
                            },
                            {
                                "example_id": "5d6b83a3-1ca4-4a53-9be9-9c8f905e1aaa",
                                "sense_id": "e16fad38-83c0-3d5d-9399-2732c2e31ea0",
                                "text": "Dans ces régions de massifs anciens, à faible manteau détritique, les nappes phréatiques sont généralement peu importantes et limitées au seul talweg."
                            }
                        ]
                    }
                ],
