                    {
                        "translation_id": "8df7905e-584d-4f4b-ba88-22f0c803e8c4",
                        "source_entry_id": "5fb70a31-3e32-3bae-af96-54dd29cd5a0d",
                        "source_sense_id": "4db4e604-33a1-36fe-ac6e-e11d389fa099",
                        "target_lang_word": "bioéthique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bioéthique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e2a7ddfa-2b85-336f-9ff3-33b7126e01b9",
                                        "entry_id": "0185fe0a-5a77-3176-8e9e-6cf0a0f61dc5",
                                        "glosses": [
                                            "Étude des préceptes moraux qui doivent présider aux pratiques médicales et biologiques concernant l’être humain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc122d4a-e0e0-484e-b548-8086b1727df5",
                                                "sense_id": "e2a7ddfa-2b85-336f-9ff3-33b7126e01b9",
                                                "text": "Les enjeux de la bioéthique relèvent désormais de problèmes complexes, interreliés, qui ne concernent plus uniquement l’individu, mais qui touchent des populations entières et de nombreuses institutions sociales."
                                            },
                                            {
                                                "example_id": "d85695ed-cd9f-4154-84f5-e69d2018fafe",
                                                "sense_id": "e2a7ddfa-2b85-336f-9ff3-33b7126e01b9",
                                                "text": "À l’occasion des États généraux de la bioéthique, partis pour durer jusqu’au 7 juillet, opposants et partisans de la gestation pour autrui (GPA) échangent moult arguments, dont certains ne sont pas piqués des vers."
                                            },
                                            {
                                                "example_id": "497dbc00-8ad1-4824-8554-d9dd6b4855bc",
                                                "sense_id": "e2a7ddfa-2b85-336f-9ff3-33b7126e01b9",
                                                "text": "Avant sa révision en novembre, le protocole de priorisation aux soins intensifs incluait encore \"des critères extrêmement controversés comme le handicap et la déficience intellectuelle\", explique la professeure en bioéthique au département de médecine sociale et préventive de l'École de santé publique de l'Université de Montréal, Vardit Ravitsky."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84220f99-216d-3e57-8923-00fdc86feb06",
                                        "entry_id": "0185fe0a-5a77-3176-8e9e-6cf0a0f61dc5",
                                        "glosses": [
                                            "éthique appliquée à la biologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a32edba-1746-419b-969a-24fb5c4b244c",
                                                "sense_id": "84220f99-216d-3e57-8923-00fdc86feb06",
                                                "text": "L’émergence de la bioéthique est liée à l’apparition des connaissances et techniques modernes en biologie."
                                            },
                                            {
                                                "example_id": "2db3b19e-b0df-4efa-b2e4-cc4d48fd9224",
                                                "sense_id": "84220f99-216d-3e57-8923-00fdc86feb06",
                                                "text": "La bioéthique est une discipline interdisciplinaire qui se présente comme un champ d’étude spécifique, avec ses propres objets, son histoire et sa méthodologie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82d0da6f-a1ba-3053-b064-f5a0629ba71b",
                                        "entry_id": "0185fe0a-5a77-3176-8e9e-6cf0a0f61dc5",
                                        "glosses": [
                                            "science morale qui traite des questions relatives aux rapports entre les sciences du vivant (biologie, médecine, etc.) et les êtres humains."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
