                "forms": [],
                "senses": [
                    {
                        "sense_id": "ba487945-0b48-3657-bdfa-5f0ad22fffa7",
                        "entry_id": "f8dc91bc-de4b-3aa8-998b-b5acf0c05c56",
                        "glosses": [
                            "smoke; smother"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "3b3be689-ae76-4f2d-89c0-00f75ab0fb8b",
                                "sense_id": "ba487945-0b48-3657-bdfa-5f0ad22fffa7",
                                "text": "The smoulder stops our nose with stench."
                            }
                        ]
                    },
                    {
                        "sense_id": "ada44c62-fcfa-35fd-bdc8-f981a2ff1761",
                        "entry_id": "f8dc91bc-de4b-3aa8-998b-b5acf0c05c56",
                        "glosses": [
                            "Alternative form of smolder."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "a315d169-7210-4754-9a5b-9826950bc588",
                                "sense_id": "ada44c62-fcfa-35fd-bdc8-f981a2ff1761",
                                "text": "Dry and wormeaten, a spark upon them became a smoulder, and a smoulder a blaze."
                            },
                            {
                                "example_id": "95cae00f-4f29-4117-839d-5bf2b62c2cee",
                                "sense_id": "ada44c62-fcfa-35fd-bdc8-f981a2ff1761",
                                "text": "The smoulder in his eyes dimmed, and he winced, half bending in agony."
                            }
                        ]
                    },
                    {
                        "sense_id": "36162a05-e6dc-3226-9a22-c40469ac5b80",
                        "entry_id": "f8dc91bc-de4b-3aa8-998b-b5acf0c05c56",
                        "glosses": [
                            "A disease of narcissus and related flowers caused by the fungus Botrytis narcissicola, and characterized by dark brown lesions on the leaves."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f054165a-b0f1-4866-9737-4c863d45af6f",
                                "sense_id": "36162a05-e6dc-3226-9a22-c40469ac5b80",
                                "text": "When grown as ornamentals it is important to inspect crops and physically remove rogue cultivars and other off-types, but whatever narcissus are grown for they should be inspected for signs of stem nematod lesions ('spickels'), disease 'primaries' (such as smoulder) and virus symptoms."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
