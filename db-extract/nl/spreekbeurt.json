                "senses": [
                    {
                        "sense_id": "e1f3aeba-f7b5-36c5-94ac-b350eaccbc2d",
                        "entry_id": "f3588e40-ded1-3942-a993-2f52589a5147",
                        "glosses": [
                            "een voordracht voor een publiek over een bepaald onderwerp"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc19af1b-3cd8-4a54-9f24-dcc830aec52e",
                                "sense_id": "e1f3aeba-f7b5-36c5-94ac-b350eaccbc2d",
                                "text": "De leerling kreeg een 9 voor zijn spreekbeurt over olifanten."
                            },
                            {
                                "example_id": "eac91c5b-0a43-4319-8427-69de78688e95",
                                "sense_id": "e1f3aeba-f7b5-36c5-94ac-b350eaccbc2d",
                                "text": "Op de zandplaat liet Iris Beekman uit Groningen ze vrij in de Waddenzee. \"Mijn vriend gaf me dit cadeau met kerst. Hij weet hoe gek ik ben op zeehonden. Vroeger deed ik mijn spreekbeurten erover. Dit is echt iets wat ik al mijn hele leven wilde doen\", zei ze. \"En nu ben ik degene die de laatste zeehond uit Pieterburen mag terugbrengen naar zee. Heel bijzonder.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e4a6d4b1-c238-43b6-8200-9c806bbf9df0",
                        "source_entry_id": "f3588e40-ded1-3942-a993-2f52589a5147",
                        "source_sense_id": "e1f3aeba-f7b5-36c5-94ac-b350eaccbc2d",
                        "source_sense_description": "een voordracht voor een publiek over een bepaald onderwerp",
                        "target_lang_word": "Vortrag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vortrag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95cde817-04aa-3dcb-a677-3dc687482fd4",
                                        "entry_id": "4c233df8-8513-32d4-8f66-4707c6d8d0d6",
                                        "glosses": [
                                            "Rede vor einem Publikum über ein bestimmtes Thema"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de3e41c8-442d-4448-9afe-e869f9c17374",
                                                "sense_id": "95cde817-04aa-3dcb-a677-3dc687482fd4",
                                                "text": "Der Schüler hielt einen Vortrag über die Klimaerwärmung."
                                            },
                                            {
                                                "example_id": "8f73b381-526d-4b31-9e8b-f14726db1db2",
                                                "sense_id": "95cde817-04aa-3dcb-a677-3dc687482fd4",
                                                "text": "„Während Block redete, vergaß Markus die Anwesenheit Rowes völlig; erst als sein Partner seinen Vortrag beendete, fiel ihm der Vorstandsvorsitzende und Investor wieder ein.“"
                                            },
                                            {
                                                "example_id": "0aa8751b-fd7a-4e74-bcf9-b7a5bc4cb6f3",
                                                "sense_id": "95cde817-04aa-3dcb-a677-3dc687482fd4",
                                                "text": "„Ich selbst habe zu den kleinen Vorträgen wenig oder nichts zu sagen.“"
                                            },
                                            {
                                                "example_id": "8b8b4b2c-5d12-4570-8791-a41625c2bd22",
                                                "sense_id": "95cde817-04aa-3dcb-a677-3dc687482fd4",
                                                "text": "„Aber wenn der letzte Vortrag der Nachmittagssitzung endlich aufhörte, war es bereits höchste Zeit für die Cocktailstunde.“"
                                            },
                                            {
                                                "example_id": "e2a9f55e-8b6a-48cd-b03f-e641903aa4b4",
                                                "sense_id": "95cde817-04aa-3dcb-a677-3dc687482fd4",
                                                "text": "„Nach dem kleinen Vortrag seiner Kollegin konnte sich der Standesbeamte als eine Art Hebamme für den schwanger gehenden Prenzlauer Berg verstehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cfa5f1bc-5add-319c-bda9-f106bc46f56f",
                                        "entry_id": "4c233df8-8513-32d4-8f66-4707c6d8d0d6",
                                        "glosses": [
                                            "öffentliche Darbietung eines Musikstückes oder literarischen Kunstwerkes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c3a63a0-74f5-4f2b-a920-f995d906300a",
                                                "sense_id": "cfa5f1bc-5add-319c-bda9-f106bc46f56f",
                                                "text": "Beim Preisträgerkonzert faszinierte der Cellist das anwesende Publikum mit seinen musikalischen Vorträgen auf dem Violoncello."
                                            },
                                            {
                                                "example_id": "ce30494d-2b56-42de-b036-ecfef78bcaaf",
                                                "sense_id": "cfa5f1bc-5add-319c-bda9-f106bc46f56f",
                                                "text": "„Sie liest nur bei Kerzenlicht und untermalt ihren Vortrag mit Glockengeklingel oder spielt auf der Blockflöte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c88a1049-b346-4e01-a17c-b857a9282192",
                        "source_entry_id": "f3588e40-ded1-3942-a993-2f52589a5147",
                        "source_sense_id": "e1f3aeba-f7b5-36c5-94ac-b350eaccbc2d",
                        "source_sense_description": "een voordracht voor een publiek over een bepaald onderwerp",
                        "target_lang_word": "Referat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Referat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "06d7435c-015b-3875-a3e4-de3696b607ca",
                                        "entry_id": "337c20e0-8a0a-39ef-8713-ebd8e47bb35e",
                                        "glosses": [
                                            "Weitergabe von zuvor ermittelten Informationen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a24021df-ba8d-31fd-88f6-5109abd8e946",
                                        "entry_id": "337c20e0-8a0a-39ef-8713-ebd8e47bb35e",
                                        "glosses": [
                                            "Weitergabe von zuvor ermittelten Informationen",
                                            "schriftlicher oder mündlicher Bericht"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4873a3ac-bb5d-4fc2-9e0d-258c81903af8",
                                                "sense_id": "a24021df-ba8d-31fd-88f6-5109abd8e946",
                                                "text": "Beim Schreiben des Referates fielen ihm wieder alle Kritikpunkte ein."
                                            },
                                            {
                                                "example_id": "88b92076-a47f-4d7c-887b-a58117932955",
                                                "sense_id": "a24021df-ba8d-31fd-88f6-5109abd8e946",
                                                "text": "Spätestens ab der Hälfte des etwa 200 Seiten langen Buchs hat der Leser das Anliegen des Verfassers begriffen – kurz nachdem das unvermeidliche Referat über die früheste positive Darstellung der Melancholie überstanden ist."
                                            },
                                            {
                                                "example_id": "7a96bd97-da2a-472d-b10b-74fb824e4f20",
                                                "sense_id": "a24021df-ba8d-31fd-88f6-5109abd8e946",
                                                "text": "„Ein richtiges Referat hatte er gehalten und auf all meine kritischen Fragen die Antwort gewusst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "e7419cc7-ad0e-3deb-ae41-3fa8cf1070f7",
                                        "entry_id": "337c20e0-8a0a-39ef-8713-ebd8e47bb35e",
                                        "glosses": [
                                            "Weitergabe von zuvor ermittelten Informationen",
                                            "ein Vortrag vor einem Publikum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cb7895d-db19-4544-9c96-d66dc5d65dc4",
                                                "sense_id": "e7419cc7-ad0e-3deb-ae41-3fa8cf1070f7",
                                                "text": "So traurig das war, man sah doch viele Zuhörer lächeln, als das Referat des bekennenden Ironikers verlesen wurde – der übrigens, ein kleiner Tribut an den Feminismus, stets von „der Ironikerin“ sprach."
                                            }
                                        ],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "9a7d5bda-ffdb-323e-9ac3-4759b2886417",
                                        "entry_id": "337c20e0-8a0a-39ef-8713-ebd8e47bb35e",
                                        "glosses": [
                                            "Weitergabe von zuvor ermittelten Informationen",
                                            "Abhandlung eines Themas in einem Seminar oder in der Schule"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75d784b2-9e5b-4cf4-9650-5a9a7cedb1e2",
                                                "sense_id": "9a7d5bda-ffdb-323e-9ac3-4759b2886417",
                                                "text": "Dann schnell zur Uni, von 16 bis 18 Uhr Seminar, hier war es richtig hart, bei den langatmigen Referaten nicht als Erster einzuschlafen."
                                            }
                                        ],
                                        "sense_index_json": "\"1c\""
                                    },
                                    {
                                        "sense_id": "c57ca6ed-a4ed-384b-ad5e-cce10250e2eb",
                                        "entry_id": "337c20e0-8a0a-39ef-8713-ebd8e47bb35e",
                                        "glosses": [
                                            "Strukturelement einer formalen Organisation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0326461b-cb0e-4d2d-bd85-69153a904891",
                                                "sense_id": "c57ca6ed-a4ed-384b-ad5e-cce10250e2eb",
                                                "text": "\"Wir fühlen uns von den Providern getäuscht\", erklärte Heinrich Sievers, Leiter des Referats Glücksspiel im Hessischen Innenministerium im April auf dem Kölner Forum Medienrecht – schließlich hätten dieselben Provider ja nun der Sperre von Kinderporno-Seiten zugestimmt."
                                            },
                                            {
                                                "example_id": "75e2d711-1404-4396-b1eb-906c536f698f",
                                                "sense_id": "c57ca6ed-a4ed-384b-ad5e-cce10250e2eb",
                                                "text": "Im Referat für Naturschutz kann man alle gefährdeten Tierarten erfragen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
