                "senses": [
                    {
                        "sense_id": "4f62ec35-b885-3e24-89a3-86bf4f51751e",
                        "entry_id": "396f303f-e436-31ab-bcfe-f36525d3c91e",
                        "glosses": [
                            "eindrücklich wirkende Szene, effektvolle Gruppierung von Akteuren"
                        ],
                        "tags": [
                            "Film, Theater"
                        ],
                        "examples": [
                            {
                                "example_id": "6ae47ebc-e9d9-480e-a6c9-b1f6b84412d8",
                                "sense_id": "4f62ec35-b885-3e24-89a3-86bf4f51751e",
                                "text": "„Der Anblick der Kinder, wie sie dort inmitten dieses Tableaus von Unschuld und Verfall saßen, machte ihn traurig.“"
                            },
                            {
                                "example_id": "ed61b4f9-52ec-4a1a-9a6a-e497a28c403f",
                                "sense_id": "4f62ec35-b885-3e24-89a3-86bf4f51751e",
                                "text": "„Wir hatten dieses Tableau einmal inszeniert, und so war es ebenso sehr Erinnerung wie Vorstellung.“"
                            }
                        ],
