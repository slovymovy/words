                        "glosses": [
                            "Qui suit une fête."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c107e0fb-9d04-4d9c-8235-490effe24236",
                                "sense_id": "396cbfbe-4a6f-3754-93ac-40f2263e85f5",
                                "text": "À cette heure matinale, un ballet de machines sur roues lave et frotte, à grand renfort de décibels, les résidus de vomi, d’urine, des mégots, des verres cassés et autres détritus post-festifs »…"
                            },
                            {
                                "example_id": "5190bdfb-8e66-4dd3-a05e-2a1544960e27",
                                "sense_id": "396cbfbe-4a6f-3754-93ac-40f2263e85f5",
                                "text": "Il n’y a pas un endroit un peu plus… (coup d’œil circulaire sur béton fissuré, hangars vides, désolation post-festive) intime ?"
                            },
                            {
                                "example_id": "7bb3f107-5a01-4d43-a476-74055540bf3b",
                                "sense_id": "396cbfbe-4a6f-3754-93ac-40f2263e85f5",
                                "text": "Je suis même plutôt poétique dans certaines circonstances conjugales post-festives mais là, je le dis comme je le pense."
                            }
                        ]
                    }
