                    "sense_id": "2b8b9295-62e7-35ab-a97e-69baf21d5fcd",
                    "sense_definition": "odzywać się do kogoś w sposób zuchwały, niegrzeczny lub ordynarny, zwłaszcza odpowiadając na polecenia lub uwagi",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kłótnia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przestań wreszcie <w>pyskować</w> i posłuchaj tego, co mówi nauczyciel.",
                            "target_lang_translations": {
                                "ru": "Перестань наконец <w>огрызаться</w> и послушай то, что говорит учитель."
                            }
                        },
                        {
                            "text": "Kiedy ojciec zwrócił mu uwagę, ten bezczelnie zaczął <w>pyskować</w>.",
                            "target_lang_translations": {
                                "ru": "Когда отец сделал ему замечание, тот нагло начал <w>дерзить</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "pyszczyć"
                    ],
                    "common_phrases": [
                        "przestań pyskować",
                        "nie pyskuj do matki"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potoczne, nacechowane negatywnie"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "дерзить, грубо или вызывающе отвечать кому-либо, огрызаться"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "огрызаться",
