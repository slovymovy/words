                                        "sense_id": "eaf27d1c-6e4c-3907-a9e0-733e43ec0a04",
                                        "entry_id": "a5bc6a1b-ee75-38e4-ac8e-91e2e1f11c36",
                                        "glosses": [
                                            "členka řádu svatého Benedikta"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e37ac26c-d9c6-4c92-adff-6562ea3956b2",
                                                "sense_id": "eaf27d1c-6e4c-3907-a9e0-733e43ec0a04",
                                                "text": "Ale po brzké smrti manžela svého přijala [Kunhuta] opět roucho klášterní a vstoupila r. 1302 do řádu benediktinek u sv. Jiří v Praze, kteréhož kláštera se brzy potom abatyší stala a důchody jeho značně rozmnožila."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
