                        "examples": [
                            {
                                "example_id": "d8a1eb8d-bd88-42b5-8e2c-d14b387b0a54",
                                "sense_id": "a731b56f-20d9-3e09-a9df-6f942f564194",
                                "text": "De oude eik symboliseerde een altijddurende liefde.",
                                "translation": "The old oak symbolized an everlasting love.",
                                "english": "The old oak symbolized an everlasting love."
                            },
                            {
                                "example_id": "859c6b39-f9ad-4cc5-a3a7-3c2556e39788",
                                "sense_id": "a731b56f-20d9-3e09-a9df-6f942f564194",
                                "text": "De legende vertelt over een altijddurende vriendschap tussen twee koningen.",
                                "translation": "The legend tells of an everlasting friendship between two kings.",
                                "english": "The legend tells of an everlasting friendship between two kings."
                            },
                            {
                                "example_id": "ded3b498-dbc5-44bc-9046-0a7d5ca100d0",
                                "sense_id": "a731b56f-20d9-3e09-a9df-6f942f564194",
                                "text": "De kunstenaar wilde met zijn schilderij een altijddurende boodschap overbrengen.",
                                "translation": "The artist wanted to convey an everlasting message with his painting.",
                                "english": "The artist wanted to convey an everlasting message with his painting."
                            }
                        ]
                    }
