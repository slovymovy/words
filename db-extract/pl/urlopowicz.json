                                    {
                                        "sense_id": "afc6024f-7b5f-3159-8b27-5f56d3336a4b",
                                        "entry_id": "1e61e5b9-5bb7-3bfa-b4b5-e51f54e80cb4",
                                        "glosses": [
                                            "someone who is on holiday"
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52acb34a-27ac-4c29-bec3-0c10eb0acbba",
                                                "sense_id": "afc6024f-7b5f-3159-8b27-5f56d3336a4b",
                                                "text": "The beaches were crowded with holidaymakers."
                                            },
                                            {
                                                "example_id": "549f3af1-31ed-4679-b4c5-46255d6b1945",
                                                "sense_id": "afc6024f-7b5f-3159-8b27-5f56d3336a4b",
                                                "text": "The Northern coastal districts of Kent, from Whitstable to Ramsgate, are one of the distressed areas of England. Their main industry – in fact almost the only one – is the summer holidaymakers, both day-trippers and fortnightly boarders. In these changing times, the habits of holidaymakers are altering also."
                                            },
                                            {
                                                "example_id": "e7d16149-68be-4304-ae84-2d4731c27f22",
                                                "sense_id": "afc6024f-7b5f-3159-8b27-5f56d3336a4b",
                                                "text": "\"With the number of holidaymakers back on the rise, upgrading critical infrastructure like Gatwick Airport station is key to improving the passenger experience,\" said Rail Minister Wendy Morton."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "359855b6-26e7-42ab-9467-9e1e6b6a08d5",
                        "source_entry_id": "109f23e0-bcf9-3fc4-bea8-999845db267e",
