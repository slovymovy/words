                                            {
                                                "example_id": "ba46e988-94f8-40f6-aeac-00f2a313e6d6",
                                                "sense_id": "efd152e1-8c29-3900-89e0-cfb366e398b5",
                                                "text": "Vyřiďte, prosím, uctivé pozdravy vaší paní."
