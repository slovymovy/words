                                            {
                                                "example_id": "8ed7355d-c408-40c2-a6c9-8631a50494dd",
                                                "sense_id": "a056a1c0-580e-3e87-b37d-ba5e24d602fa",
                                                "text": "Als der Gast die Zeche prellte, rief der Wirt die Polizei."
