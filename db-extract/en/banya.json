                    },
                    {
                        "translation_id": "1ea4ad7f-4452-465f-be8d-c33a0a948b0f",
                        "source_entry_id": "5e26c593-2ae3-3b93-aadb-c556aba7aa1e",
                        "source_sense_id": "d8fd4287-acac-32d4-93ff-03bf60644795",
                        "source_sense_description": "a Russian steam bath",
                        "target_lang_word": "bania",
