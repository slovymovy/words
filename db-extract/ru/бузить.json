                    },
                    {
                        "translation_id": "27644766-5cff-45ab-9487-23680adac1fe",
                        "source_entry_id": "ebf5cea0-37c3-36d0-afd8-cc68d68f5a8d",
                        "source_sense_id": "d3023448-24fb-3c97-918b-58c154413a2c",
                        "target_lang_word": "brawl",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brawl",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f723d93-0eca-3f26-bbd1-004bcc002d96",
                                        "entry_id": "48879ad3-7b47-345a-a518-97e0c5e6ff2f",
                                        "glosses": [
                                            "A disorderly argument or fight, usually with a large number of people involved."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "944baab9-fc0e-4a6c-bbb2-b533bca325f5",
                                                "sense_id": "7f723d93-0eca-3f26-bbd1-004bcc002d96",
                                                "text": "Three Ciuell brawles bred of an airie word, / By the old Capulet and Mountague, / Haue thrice diſturbd the quiet of our ſtreets."
                                            },
                                            {
                                                "example_id": "c66d1648-2c42-47ea-96e7-69004a9c40ba",
                                                "sense_id": "7f723d93-0eca-3f26-bbd1-004bcc002d96",
                                                "text": "The complaint charged that the defendants, on, etc., at, etc., \"in a certain public place, to wit, in a certain school-house in which a singing-school was then and there being held, did make a great brawl and tumult, and stamped their feet on the floor, hissed, used loud and saucy language, and were guilty of rude, indecent, and disorderly conduct.\""
                                            },
                                            {
                                                "example_id": "104e334f-91a0-4778-b3b6-04bdb8777549",
                                                "sense_id": "7f723d93-0eca-3f26-bbd1-004bcc002d96",
                                                "text": "It has been reported that an entertainment took place not long ago in a certain \"hot spot\" in New York City, and it has been charged that members of the Federal Communications Commission were present; that they got into a drunken brawl; and in the brawl some woman was hurt, her arm twisted."
                                            },
                                            {
                                                "example_id": "087b83ae-80a6-4315-9d8e-8765899da143",
                                                "sense_id": "7f723d93-0eca-3f26-bbd1-004bcc002d96",
                                                "text": "Robert Carlyle appears as Begbie, who starts brawls with almost anyone who crosses his path; [...]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "brawl",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3db50858-8f46-3d78-9776-9906ed324041",
                                        "entry_id": "1b6f814a-dec0-3c81-a172-c2d3e1612f0c",
                                        "glosses": [
                                            "To engage in a brawl; to fight or quarrel."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12af2865-46db-402c-a36e-0a75eb5c4b24",
                                                "sense_id": "3db50858-8f46-3d78-9776-9906ed324041",
                                                "text": "I doe the wrong, and firſt began to braule / The ſecret miſchiefes that I ſet abroach, / I lay vnto the grieuous charge of others: [...]",
                                                "translation": "I do the wrong, and am the first to begin to quarrel. / The secret mischiefs that I set afoot, / I blame on others: …",
                                                "english": "I do the wrong, and am the first to begin to quarrel. / The secret mischiefs that I set afoot, / I blame on others: …"
                                            },
                                            {
                                                "example_id": "1780f2b8-8867-4c41-817b-f8be2accaa35",
                                                "sense_id": "3db50858-8f46-3d78-9776-9906ed324041",
                                                "text": "Theſe are the deep and profound Myſteries of Artificial Logick, invented with ſo much care by theſe fallacious Doctors, [...] Theſe are the Nets, and theſe are the Hounds with which they hunt the Truth of all things, whether natural, as in Phyſicks; or ſupernatural, as in Metaphyſicks: but according to the Proverb of Clodius and Varro, can never overtake, by reaſon of their bawling and brawling one with another."
                                            },
                                            {
                                                "example_id": "88a6a25b-3e34-4d08-8190-36bb3306718c",
                                                "sense_id": "3db50858-8f46-3d78-9776-9906ed324041",
                                                "text": "As long as they [Xanthippe and Myrto, Socrates' wives] diſagreed, they were continually ſcolding, brawling, or fighting, with each other; and whenever they agreed, they both joined in brawling [verb sense 2] at him, and often fell on him with their fiſts as well as with their tongues, and beat him ſoundly."
                                            },
                                            {
                                                "example_id": "8cdd2670-16fa-4ce9-8a37-62a45470e000",
                                                "sense_id": "3db50858-8f46-3d78-9776-9906ed324041",
                                                "text": "[U]pon every trifle, the vitiated faculties of thy ſoul are inflamed with immoderate and moſt irregular paſſion, ſo that thou often brawleſt, and art made thereby to roar like a wild bull caught in a thicket: [...]"
                                            },
                                            {
                                                "example_id": "10751095-16ff-4333-a52a-f4f6a7751a08",
                                                "sense_id": "3db50858-8f46-3d78-9776-9906ed324041",
                                                "text": "One who rides at all hazards of limb and life in the chase of a fox, will prefer to ride recklessly at most times. So it was with these gentlemen. He was the greatest patriot, in their eyes, who brawled the loudest, and who cared the least for decency."
                                            },
                                            {
                                                "example_id": "cf1d7357-075b-4522-b1d5-e4196218d845",
                                                "sense_id": "3db50858-8f46-3d78-9776-9906ed324041",
                                                "text": "Brilly and Flintlock brawled in potions class, then they brawled on the soccer field, and finally they brawled sitting in the principal's office."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efe1e517-078f-325d-ba9b-d479fb9a3515",
                                        "entry_id": "1b6f814a-dec0-3c81-a172-c2d3e1612f0c",
                                        "glosses": [
                                            "To create a disturbance; to complain loudly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d6ce411-bd77-470a-bc98-84c74b0d2ae6",
                                                "sense_id": "efe1e517-078f-325d-ba9b-d479fb9a3515",
                                                "text": "Say beggar, why brawlest þou? go boune þe to þe barre."
                                            },
                                            {
                                                "example_id": "9000f02b-d5cf-46d7-bb66-6c296fe50bfa",
                                                "sense_id": "efe1e517-078f-325d-ba9b-d479fb9a3515",
                                                "text": "She [the son's wife] is one that is euermore full of ſtryfe / And of all Scolders beareth the Bell. / When ſhe ſpeaketh beſt, ſhe brawleth her tonge / When ſhe is ſtyll ſhe fyghteth apace: / She is an olde Witch thoughe ſhe be yonge, / No mirth with her, no ioye or ſolace."
                                            },
                                            {
                                                "example_id": "12bb1d80-3151-4610-8a20-836c2533314a",
                                                "sense_id": "efe1e517-078f-325d-ba9b-d479fb9a3515",
                                                "text": "How now ſir Iohn, what are you brawling here? / Doth this become your place, your time, and buſineſſe?",
                                                "translation": "Hello, what's this, Sir John [Falstaff], what, are you creating a disturbance here? / Is this becoming of a person of your position, your age, and duties?",
                                                "english": "Hello, what's this, Sir John [Falstaff], what, are you creating a disturbance here? / Is this becoming of a person of your position, your age, and duties?"
                                            },
                                            {
                                                "example_id": "bc05869a-5654-4f95-9525-74bf62bafd20",
                                                "sense_id": "efe1e517-078f-325d-ba9b-d479fb9a3515",
                                                "text": "[I]f a king will not remain at home and slay his own game, methinks he should not brawl too loud if he finds it killed to his hand."
                                            },
                                            {
                                                "example_id": "d71ead2c-fb69-4d09-a61e-78c838b0b10a",
                                                "sense_id": "efe1e517-078f-325d-ba9b-d479fb9a3515",
                                                "text": "He [one Samuel Tuke] blasphemeth God's Holy Word, preacheth sedition and rebellion, telleth in the pulpit many foolish lies and ridiculous tales, brawleth against the reverend and learned ministers of the country, and raileth upon the worshipful gentry; [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98af87a2-dbbf-3adf-b101-8df68f5027a8",
                                        "entry_id": "1b6f814a-dec0-3c81-a172-c2d3e1612f0c",
                                        "glosses": [
                                            "Especially of a rapid stream running over stones: to make a loud, confused noise."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6aa0dea-567c-4b60-8b5c-28768e83e065",
                                                "sense_id": "98af87a2-dbbf-3adf-b101-8df68f5027a8",
                                                "text": "To day my Lord of Amiens, and my ſelfe, / Did ſteale behinde him as he lay along / Vnder an oake, whoſe anticke roote peepes out / Vpon the brooke that brawles along this wood, [...]"
                                            },
                                            {
                                                "example_id": "fcab8811-7e95-4e2c-96e1-bb719bd1f4eb",
                                                "sense_id": "98af87a2-dbbf-3adf-b101-8df68f5027a8",
                                                "text": "―When low-hung clouds each ſtar of ſummer hide, / And fireleſs are the valleys far and wide, / Where the brook brawls along the painful road, / Dark with bat haunted aſhes ſtretching broad, [...]"
                                            },
                                            {
                                                "example_id": "c94ea4a7-14c5-45e7-a50c-15e86b9e9af6",
                                                "sense_id": "98af87a2-dbbf-3adf-b101-8df68f5027a8",
                                                "text": "What seek we here / Amid this waste where desolation scowls, / And the red torrent, brawling down the linn, / Sings everlasting discord?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3130582-440c-343c-addd-b88abcb4b75a",
                                        "entry_id": "1b6f814a-dec0-3c81-a172-c2d3e1612f0c",
                                        "glosses": [
                                            "To pour abuse on; to scold."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "brawl",
