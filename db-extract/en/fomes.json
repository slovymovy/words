                                "sense_id": "f0057539-80da-3660-a6ef-838a95589dd3",
                                "text": "Toys are common fomites."
                            },
                            {
                                "example_id": "78d72ed5-970a-44f9-9e9e-0063ef36adb4",
                                "sense_id": "f0057539-80da-3660-a6ef-838a95589dd3",
                                "text": "I cannot say that I have known it spread from fomites."
