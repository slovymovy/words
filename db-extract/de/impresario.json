                "senses": [
                    {
                        "sense_id": "eb87b625-559a-37d1-a2c8-8daa99ff9be6",
                        "entry_id": "71c46602-0ba5-31b6-a3bc-b3e7a8e0c96d",
                        "glosses": [
                            "Leiter einer Oper/eines Theaters et cetera"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a434ebf-416a-4f4a-80b7-2b5595c0f136",
                                "sense_id": "eb87b625-559a-37d1-a2c8-8daa99ff9be6",
                                "text": "„Im Falle von Völkerschauen fängt die Werbung mit dem Renommee des Impresarios an.“"
                            },
                            {
                                "example_id": "1dc587b3-5ab5-4a68-8c44-aae4c97bfb48",
                                "sense_id": "eb87b625-559a-37d1-a2c8-8daa99ff9be6",
                                "text": "„Seit mehr als elf Jahren ist der 53-Jährige der Impresario der Show.“"
                            },
                            {
                                "example_id": "78d375fc-b093-4d44-b419-42cf2c5da55a",
                                "sense_id": "eb87b625-559a-37d1-a2c8-8daa99ff9be6",
                                "text": "„Teresa führte mich in ihr Zimmer und erzählte mir, daß sie noch vor ihrer Ankunft in Rimini den Impresario der Oper getroffen habe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1ae709b0-56b2-3000-8eff-0bddec9e4ad1",
                        "entry_id": "71c46602-0ba5-31b6-a3bc-b3e7a8e0c96d",
                        "glosses": [
                            "Agent für Musiker oder Schauspieler"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce630914-3efc-4fa7-891c-3b514aa44f8e",
                                "sense_id": "1ae709b0-56b2-3000-8eff-0bddec9e4ad1",
                                "text": "„Als ein zugereister Impresario ihn ahnungslos engagieren wollte, drohten die anderen bei Alfs Erscheinen mit Kündigung.“"
                            },
                            {
                                "example_id": "d9d03ad6-0616-482c-bcc8-94b30a6803cc",
                                "sense_id": "1ae709b0-56b2-3000-8eff-0bddec9e4ad1",
                                "text": "„Man hat das Gefühl, daß es noch jemanden gibt, einen Impresario, einen unsichtbaren Mann, dem alle gehorchen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
