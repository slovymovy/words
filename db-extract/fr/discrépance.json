                                "target_senses": [
                                    {
                                        "sense_id": "368525f8-875c-34e7-9d6a-a70748b67908",
                                        "entry_id": "1ba8ed28-0a60-30cb-bb68-b0a4701c176f",
                                        "glosses": [
                                            "Uneinigkeit oder Nichtübereinstimmung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c52cc45b-8671-4473-82e5-91072ec466c5",
                                                "sense_id": "368525f8-875c-34e7-9d6a-a70748b67908",
                                                "text": "Hier zeigt sich aber die Diskrepanz zwischen Wunsch und Wirklichkeit."
                                            },
                                            {
                                                "example_id": "5fb32555-3b32-46b9-b047-86e6ffa0ceda",
                                                "sense_id": "368525f8-875c-34e7-9d6a-a70748b67908",
                                                "text": "„Der durchs Teleskop gerichtete Blick kennt eine ähnliche Diskrepanz von Dabeisein und Entfernung wie die Höhensicht vom Berggipfel.“"
                                            },
                                            {
                                                "example_id": "f13f4ee8-7dc6-4f05-9346-dd7b71ae5e22",
                                                "sense_id": "368525f8-875c-34e7-9d6a-a70748b67908",
                                                "text": "„Für die Diskrepanz von wissenschaftlicher Rationalität und lebensweltlicher Hartnäckigkeit gibt es einen an Charme nicht zu überbietenden Beleg.“"
                                            },
                                            {
                                                "example_id": "0b12d33b-f2a2-471e-aff8-28d2f4999a36",
                                                "sense_id": "368525f8-875c-34e7-9d6a-a70748b67908",
                                                "text": "„Mendele und Tewje beschreiben eine Diskrepanz von Ideal und Wirklichkeit, die sich in ihren Erzählungen enthüllt.“"
                                            },
                                            {
                                                "example_id": "695f04ae-cadf-40d2-b820-445bf574a318",
                                                "sense_id": "368525f8-875c-34e7-9d6a-a70748b67908",
                                                "text": "„Die wirtschaftliche Entwicklung hat sektorale und regionale Diskrepanzen hervorgebracht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f36e0f5-58e6-40f3-84e6-f247a0293a22",
