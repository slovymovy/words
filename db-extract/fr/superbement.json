        "fr-extract.jsonl": [
            {
                "entry_id": "a3288a35-8ff8-303a-bb4c-a75936fa61ca",
                "word": "superbement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3a230626-8911-3e02-9a61-8d19b20812e4",
                        "entry_id": "a3288a35-8ff8-303a-bb4c-a75936fa61ca",
                        "glosses": [
                            "D’une manière superbe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ca4f44a-9283-43e8-8028-9e2cb11f675b",
                                "sense_id": "3a230626-8911-3e02-9a61-8d19b20812e4",
                                "text": "Gurth, superbement paré, accompagnait comme écuyer le jeune maître qu’il avait si fidèlement servi ; […]."
                            },
                            {
                                "example_id": "d0cd4b1a-70d4-49c6-a7f1-1b9ced44c1cb",
                                "sense_id": "3a230626-8911-3e02-9a61-8d19b20812e4",
                                "text": "Cette simplicité [de Frédéric, dans le récit d’une de ses victoires] est bien plus héroïque que ces inscriptions fastueuses qui ornaient autrefois trop superbement la galerie de Versailles,"
                            },
                            {
                                "example_id": "4cde5bcd-abd6-4f4f-a4cf-788556e2f233",
                                "sense_id": "3a230626-8911-3e02-9a61-8d19b20812e4",
                                "text": "Elle savait qu'il avait mis un orgueil masochiste (ça existe !) à abaisser son talent, à mirlitonner des vers politiques et à briser la cadence autrefois superbement oratoire de son style."
                            }
                        ]
                    },
                    {
                        "sense_id": "6074ee4b-4fea-35ba-b1bc-eb487d35c87a",
                        "entry_id": "a3288a35-8ff8-303a-bb4c-a75936fa61ca",
                        "glosses": [
                            "Orgueilleusement ; avec arrogance."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "4a79aac7-5bf6-4812-9dd4-0fafccdd09ef",
                                "sense_id": "6074ee4b-4fea-35ba-b1bc-eb487d35c87a",
                                "text": "Ils avaient retiré leur tunique, posé leur épée à terre, et ils s’acharnaient superbement à la besogne, […]."
                            },
                            {
                                "example_id": "90ae9299-93f6-40b1-b2d4-d88eb6984e32",
                                "sense_id": "6074ee4b-4fea-35ba-b1bc-eb487d35c87a",
                                "text": "Un malentendu existe entre lui et les simples mortels. […]. Il arbore superbement un scepticisme, un snobisme de décadence qui leur reste inaccessible et fermé. Son ironie naturelle les gêne et les déconcerte. Il est ennuyé, blasé ; […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "0fe59d51-c565-3fc0-969b-eb8e59641399",
                        "entry_id": "a3288a35-8ff8-303a-bb4c-a75936fa61ca",
                        "glosses": [
                            "Avec magnificence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2f868ac-ec97-4e0b-b462-99a7babdd4ee",
                                "sense_id": "0fe59d51-c565-3fc0-969b-eb8e59641399",
                                "text": "La porte du pullman de queue, fermée à clef, s'ouvrit : superbement, admirablement vide, la voiture offrait à ses visiteurs impromptus le plus admirable décor de marqueterie en bois de rose — jaune citron et carmin pâle — qui se pût imaginer."
                            },
                            {
                                "example_id": "84f992ef-dd03-4351-bf3b-e8cb6c564e17",
                                "sense_id": "0fe59d51-c565-3fc0-969b-eb8e59641399",
                                "text": "Ce riche était vêtu superbement, il aimait la splendeur et la magnificence,"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e1320e24-f699-439d-becd-350705f4973d",
                        "source_entry_id": "a3288a35-8ff8-303a-bb4c-a75936fa61ca",
                        "source_sense_description": "1",
                        "target_lang_word": "brilliantly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brilliantly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aac7dc36-9fc4-338f-a146-326b5164105a",
                                        "entry_id": "e587e353-83d4-35d0-ab64-68b37ecae0d4",
                                        "glosses": [
                                            "In a brilliant manner; with brilliance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "032945e1-f486-453c-9622-5a2c11658e6f",
                                                "sense_id": "aac7dc36-9fc4-338f-a146-326b5164105a",
                                                "text": "Another Karadeniz cross led to Cudicini's first save of the night, with the Spurs keeper making up for a weak punch by brilliantly pushing away Christian Noboa's snap-shot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2b45915-5397-4314-b092-8e9a6ab875c0",
                        "source_entry_id": "a3288a35-8ff8-303a-bb4c-a75936fa61ca",
                        "source_sense_description": "1",
                        "target_lang_word": "superbly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
