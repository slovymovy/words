                                        "entry_id": "c6b72636-3d90-320e-8456-33d1ee50cda5",
                                        "glosses": [
                                            "Feeling great anger; raging; violent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ed588b1-1a87-4d02-9762-88b8e339e486",
                                                "sense_id": "d326d21a-0c05-3b23-892d-4eb9727fbd4a",
                                                "text": "a furious animal; parent furious at their child's behaviour"
                                            },
                                            {
                                                "example_id": "d1185b31-0dca-4da1-a861-68eedc57793b",
                                                "sense_id": "d326d21a-0c05-3b23-892d-4eb9727fbd4a",
                                                "text": "Not unnaturally, “Auntie” took this communication in bad part. Thus outraged, she showed herself to be a bold as well as a furious virago. Next day she found her way to their lodgings and tried to recover her ward by the hair of the head."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a21e86cf-cb88-3ed5-8f87-d2884410d2aa",
                                        "entry_id": "c6b72636-3d90-320e-8456-33d1ee50cda5",
                                        "glosses": [
                                            "Rushing with impetuosity; moving with violence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f33e0556-e19b-434f-b538-623472acfc07",
                                                "sense_id": "a21e86cf-cb88-3ed5-8f87-d2884410d2aa",
                                                "text": "a furious stream; a furious wind or storm"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
