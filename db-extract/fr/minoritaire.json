                ],
                "translations": [
                    {
                        "translation_id": "cf773167-73bf-4fa9-9819-62aeef75d344",
                        "source_entry_id": "0e8329ca-1e4d-3ce3-a3d5-bcf818646457",
                        "target_lang_word": "minority",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "minority",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "988fd51f-d1f3-36a1-b2f7-ac59fb958a64",
                                        "entry_id": "3e7adbb5-325e-3a67-817f-21ff6f954ec9",
                                        "glosses": [
                                            "The state of being a minor; youth, the period of a person's life prior to reaching adulthood."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e444b94e-c7b1-4af7-a826-2f26434f015c",
                                                "sense_id": "988fd51f-d1f3-36a1-b2f7-ac59fb958a64",
                                                "text": "And lest any man should think her intent was to unnestle ill neighbours, and not to aid good neighbours, or that she was readier to restore what was invaded by others than to render what was in her own hands; see if the time provided not a new occasion afterwards, when through their own division, without the intermise of strangers, her forces were again sought and required; she forsook them not, prevailed so far as to be possessed of the castle of Edinburgh, the principal strength of that kingdom, with peace, incontinently, without cunctations or cavillations, the preambles of a wavering faith, she rendered with all honour and security; and his person to safe and faithful hands; and so ever after during his minority continued his principal guardian and protector."
                                            },
                                            {
                                                "example_id": "c0739453-5e90-4948-8341-5bb381f2bb94",
                                                "sense_id": "988fd51f-d1f3-36a1-b2f7-ac59fb958a64",
                                                "text": "She also played a key role as dowager-regent during the minority of her son."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43455ed6-5736-31d8-a690-23e2f0c8b138",
                                        "entry_id": "3e7adbb5-325e-3a67-817f-21ff6f954ec9",
                                        "glosses": [
                                            "Any subgroup that does not form a numerical majority."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1731e39-c63e-42b3-bb1c-e03425843397",
                                                "sense_id": "43455ed6-5736-31d8-a690-23e2f0c8b138",
                                                "text": "Most people agreed, but a sizable minority were upset by the decision."
                                            },
                                            {
                                                "example_id": "e0c0420d-0c0c-4cec-9b42-330d1aefbda9",
                                                "sense_id": "43455ed6-5736-31d8-a690-23e2f0c8b138",
                                                "text": "The case is the latest chapter in a decade-long struggle by the nation's elite minority to crush the powerful political machine founded by Yingluck's brother, Thaksin Shinawatra, who was toppled in another coup in 2006."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1eca855e-826d-386b-943c-1c5db8d166fb",
                                        "entry_id": "3e7adbb5-325e-3a67-817f-21ff6f954ec9",
                                        "glosses": [
                                            "A member of an ethnic minority."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd1b8cba-0632-42fb-97ea-f389c2e4f12b",
                                                "sense_id": "1eca855e-826d-386b-943c-1c5db8d166fb",
                                                "text": "The company claims it has hired several minorities since the complaint was lodged."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb030188-e9b7-375f-9e03-c59ca68e6719",
                                        "entry_id": "3e7adbb5-325e-3a67-817f-21ff6f954ec9",
                                        "glosses": [
                                            "A group of people seen as distinct who are subordinated and discriminated against in a society."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98a453d5-abd9-4335-9d07-7b7b92b53ceb",
                                                "sense_id": "fb030188-e9b7-375f-9e03-c59ca68e6719",
                                                "text": "But we have seen that one important difference between women and other minorities is that women's attitudes and self-conceptions are conditioned more largely by interaction with both minority and dominant group members"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a68032bb-f9f2-3e94-ade1-40f6af2de4a4",
                                        "entry_id": "3e7adbb5-325e-3a67-817f-21ff6f954ec9",
                                        "glosses": [
                                            "A Muslim."
                                        ],
                                        "tags": [
                                            "India",
                                            "countable",
                                            "euphemistic",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
