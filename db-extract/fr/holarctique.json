                        "entry_id": "fef7a084-ce6a-3340-8917-777e5b6df1f6",
                        "glosses": [
                            "Plante de l’hémisphère nord, qui croît au nord de la zone méditerranéenne."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "d7939fd1-861c-4b26-9af7-96170000f298",
                                "sense_id": "0e65bcd3-f631-39ac-97e9-9890aa632ec5",
                                "text": "C’est une holarctique, surtout montagnarde, peut-être adventice assez récente, amenée par les plantations (enrésinements)."
                            },
                            {
                                "example_id": "d8c33883-ca0b-4918-84d8-10a81fe9ee59",
                                "sense_id": "0e65bcd3-f631-39ac-97e9-9890aa632ec5",
                                "text": "Le long des rivières, des colonies ont pourtant pu descendre des montagnes et, quand le sol est humide, des holarctiques peuvent braver la faible pluviosité du climat méditerranéen."
                            }
                        ]
                    }
