                "senses": [
                    {
                        "sense_id": "07be449e-36eb-311e-840d-4bca8a92668e",
                        "entry_id": "9a6fe73e-df44-3e09-962e-d9626229bc67",
                        "glosses": [
                            "Hinweis auf eine gewisse Bedrohung/Gefahr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "432b8367-06cc-4c41-a237-8f3e7a5d5bdf",
                                "sense_id": "07be449e-36eb-311e-840d-4bca8a92668e",
                                "text": "„Der Schmerz, diese Einsicht muss hier vorausgesetzt werden, ist ja nicht dazu da, um uns quälbar zu machen, sondern als Gefahrenmeldung für unsere Gesundheit und unsere Existenz.“"
                            },
                            {
                                "example_id": "707c38c9-7ffa-4a20-bc5c-e8631c335a94",
                                "sense_id": "07be449e-36eb-311e-840d-4bca8a92668e",
                                "text": "„Die Computerstimme der Warnanlage meldete sich wieder, diesmal jedoch mit einer eindeutigen Gefahrenmeldung statt einer Manövrieranweisung.“"
                            },
                            {
                                "example_id": "f7e4032d-a683-4e6b-bdeb-fa9cba0f3341",
                                "sense_id": "07be449e-36eb-311e-840d-4bca8a92668e",
                                "text": "„Eine Gefahrenmeldung ist das Signal an alle verfügbaren Wagen, so schnell wie möglich zum Einsatzort zu kommen, weil Lebensgefahr für Polizisten besteht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
