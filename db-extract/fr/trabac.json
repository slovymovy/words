                "senses": [
                    {
                        "sense_id": "6c81797d-1d62-3b38-8f89-ac6859be005c",
                        "entry_id": "290d0ba4-3e40-3ca5-be62-e87fb806b118",
                        "glosses": [
                            "Filet fixe pour la pêche, utilisé dans la quartier de Sète."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1c4bdab-6612-41dd-b0e7-55378fef54a8",
                                "sense_id": "6c81797d-1d62-3b38-8f89-ac6859be005c",
                                "text": "Toute l'année, on utilise la « traîne », les « casiers » pour les crustacés. […] dans les étangs, toute l'année, mais surtout en hiver, on utilisait le gangui fixe, les entremeaux, les trabacs, les palangres, etc..., […]."
                            },
                            {
                                "example_id": "784f7045-8064-44eb-9c36-8f6a94075418",
                                "sense_id": "6c81797d-1d62-3b38-8f89-ac6859be005c",
                                "text": "Admirer au détour des rues son panorama à vous couper le souffle, ses barques colorées à fond plat, ses filets de pêches à petites mailles (trabacs) qui sèchent sur le vieux port réaménagé à l'entrée du village."
                            },
                            {
                                "example_id": "ff84b3ad-e155-48b2-a983-d895bbde3e54",
                                "sense_id": "6c81797d-1d62-3b38-8f89-ac6859be005c",
                                "text": "Les alignements des trabacs ou andanes varient en fonction de leur situation et du nombre de filets autorisés, jusqu'à onze, nombre imposé par la commission qui siège à la prud’homie de Martigues."
                            }
                        ]
                    }
