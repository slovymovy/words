                                        "entry_id": "c0261c82-b3d7-3ad6-a39c-00db9947ed4c",
                                        "glosses": [
                                            "Qui se situe à l'arrière de quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d958aa58-7204-44e2-960a-41fcf00e8cf2",
                                                "sense_id": "7b425368-f220-30a2-a421-932539569bdf",
                                                "text": "Les roues arrière d'une voiture."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "arrière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2f7c5f75-0399-3487-a488-34a10df9a3f4",
                                        "entry_id": "534ac5fe-5dd2-3429-b94c-2b31d458a0ff",
                                        "glosses": [
                                            "Partie postérieure d’une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "584015b8-7ee1-4942-bbcc-3a563caac437",
                                                "sense_id": "2f7c5f75-0399-3487-a488-34a10df9a3f4",
                                                "text": "C'est un vieil homme debout à l'arrière d'un bateau."
                                            },
                                            {
                                                "example_id": "0f2784e2-32b5-421d-80f0-1df542a75697",
                                                "sense_id": "2f7c5f75-0399-3487-a488-34a10df9a3f4",
                                                "text": "Il aimait rire, Veerapen. Il lissait ses moustaches quand il riait. Et puis, un jour, il avait craché du sang partout et il était mort comme ça, à l’arrière du rickshaw."
                                            },
                                            {
                                                "example_id": "770ad718-09b0-4f9e-a90d-ad22085997dd",
                                                "sense_id": "2f7c5f75-0399-3487-a488-34a10df9a3f4",
                                                "text": "L’arrière d’une voiture."
                                            },
                                            {
                                                "example_id": "5266ae3c-24d1-4655-999d-d57e5ff3f6a0",
                                                "sense_id": "2f7c5f75-0399-3487-a488-34a10df9a3f4",
                                                "text": "Cette photo, prise du quartier de Vaucelles, nous montre les arrières de la caserne Hamelin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9084cc5-032a-3378-8deb-974fde06840f",
                                        "entry_id": "534ac5fe-5dd2-3429-b94c-2b31d458a0ff",
                                        "glosses": [
                                            "Partie du navire où se trouve le gouvernail; poupe ; moitié de la longueur d’un bâtiment, depuis le grand mât jusqu’à la poupe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38fcd6fc-2946-4cdd-8f4f-518c3270fa69",
                                                "sense_id": "f9084cc5-032a-3378-8deb-974fde06840f",
                                                "text": "Aller, avoir vent arrière."
                                            }
                                        ]
                                    },
