                    {
                        "translation_id": "a1685314-31cf-4d4a-af8b-97fe91efa09c",
                        "source_entry_id": "4adc2406-d48b-3a27-8004-4fafda6969ae",
                        "source_sense_id": "1497e4ab-bd91-39c6-bc58-3cdec47968f1",
                        "source_sense_description": "to convert back to plain text",
                        "target_lang_word": "déchiffrer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déchiffrer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d0446a14-03b1-3785-b83e-00d299cec2d6",
                                        "entry_id": "b243d8ee-11a0-3d99-a6cd-a6c160261aa5",
                                        "glosses": [
                                            "Décoder ce qui est écrit en chiffres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0f7791b-d0cb-4cb9-901c-b5fa32decf26",
                                                "sense_id": "d0446a14-03b1-3785-b83e-00d299cec2d6",
                                                "text": "Déchiffrer une dépêche."
                                            },
                                            {
                                                "example_id": "0b06f2aa-2289-4bd4-9e4c-468b3615db8a",
                                                "sense_id": "d0446a14-03b1-3785-b83e-00d299cec2d6",
                                                "text": "Un chiffre malaisé à déchiffrer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ac596b8-10a0-34e0-a4b0-04077159f60f",
                                        "entry_id": "b243d8ee-11a0-3d99-a6cd-a6c160261aa5",
                                        "glosses": [
                                            "Décrypter ce qui est mal écrit ou difficile à lire."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "215d493e-0121-44c5-9c73-daf8e37c9d14",
                                                "sense_id": "3ac596b8-10a0-34e0-a4b0-04077159f60f",
                                                "text": "Il trouvait aux Archives, non pas seulement les papiers administratifs des derniers siècles, mais les chartes du moyen âge. Il les fallait lire, il en fallait déchiffrer l’écriture, distinguer les formules, déterminer les dates, […]."
                                            },
                                            {
                                                "example_id": "e5458f97-eee7-4018-9c68-e7858edd51fa",
                                                "sense_id": "3ac596b8-10a0-34e0-a4b0-04077159f60f",
                                                "text": "Un papyrologue est de ce rythme-là. Pouvant passer des années à déchiffrer un papyrus, accumulant patiemment le savoir comme on collecte la rosée dans le désert, il est le contrepoids indispensable à notre société productiviste dopée à l’Internet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3d7fbab-c02e-3f56-ad71-97475253550b",
                                        "entry_id": "b243d8ee-11a0-3d99-a6cd-a6c160261aa5",
                                        "glosses": [
                                            "Parvenir à établir la valeur de signes que l’on ne connaît pas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08f0de77-abbc-4230-95d0-8d410d00ca36",
                                                "sense_id": "b3d7fbab-c02e-3f56-ad71-97475253550b",
                                                "text": "Cette jeune fille déchiffre bien."
                                            },
                                            {
                                                "example_id": "ae0f5ff5-09d3-4c90-a05a-7ec975630a18",
                                                "sense_id": "b3d7fbab-c02e-3f56-ad71-97475253550b",
                                                "text": "Déchiffrer de la musique à livre ouvert."
                                            },
                                            {
                                                "example_id": "a2bea471-ff52-4d48-ab9e-0c8b574b594e",
                                                "sense_id": "b3d7fbab-c02e-3f56-ad71-97475253550b",
                                                "text": "L’écriture cunéiforme hittite, une langue indo-européenne, fut déchiffrée en 1915 par Bartel Hrozny à partir des très nombreuses tablettes découvertes par Hugo Winkler […]."
                                            },
                                            {
                                                "example_id": "a7fdd202-6063-4c16-9776-aff2f5b6f235",
                                                "sense_id": "b3d7fbab-c02e-3f56-ad71-97475253550b",
                                                "text": "Déchiffrer de la musique, la lire à première vue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ea11287-2e0f-3f30-baa4-d9dc83444259",
                                        "entry_id": "b243d8ee-11a0-3d99-a6cd-a6c160261aa5",
                                        "glosses": [
                                            "Démêler ce qui est compliqué, découvrir ce qui est secret."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "998f7e3c-c4e5-4078-acb5-c52f782427a8",
                                                "sense_id": "8ea11287-2e0f-3f30-baa4-d9dc83444259",
                                                "text": "Dans les tranchées, si l'on pouvait dormir la nuit, c'est que les copains en sentinelle s’arrachaient les yeux à déchiffrer le no man’s land obscur..."
                                            },
                                            {
                                                "example_id": "38b8c130-666f-47f3-a0c9-a96558db6c8f",
                                                "sense_id": "8ea11287-2e0f-3f30-baa4-d9dc83444259",
                                                "text": "Déchiffrer une affaire, une intrigue."
                                            },
                                            {
                                                "example_id": "ef5b4e1d-d54a-45df-a2ce-bf484ed77024",
                                                "sense_id": "8ea11287-2e0f-3f30-baa4-d9dc83444259",
                                                "text": "De fait, chaque décret de la Maison Blanche sur le sujet reste une énigme, difficile à déchiffrer. C’est le cas de la taxe à 40 % visant les produits dits de « transbordement », qui transitent par des pays tiers pour échapper à des droits de douane élevés : ceux, par exemple, importés de Chine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38b05d2e-6971-3372-8485-65ae2aaa3abe",
                                        "entry_id": "b243d8ee-11a0-3d99-a6cd-a6c160261aa5",
                                        "glosses": [
                                            "Pénétrer, révéler la nature intime, les mouvements secrets de quelque chose."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60fba899-a4f9-4f04-8b41-28678e8cc02f",
                                                "sense_id": "38b05d2e-6971-3372-8485-65ae2aaa3abe",
                                                "text": "Déchiffrer un caractère."
                                            },
                                            {
                                                "example_id": "0788c926-f5ec-4699-9b5c-937f87c4286d",
                                                "sense_id": "38b05d2e-6971-3372-8485-65ae2aaa3abe",
                                                "text": "C’est un caractère bien difficile à déchiffrer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9db7f9da-a0f6-3566-907c-ba36b4b6c486",
                                        "entry_id": "b243d8ee-11a0-3d99-a6cd-a6c160261aa5",
                                        "glosses": [
                                            "Deviner les motivations profondes et cachées."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ee7b79e-ec30-4d70-ab6c-4a4999671af6",
                                                "sense_id": "9db7f9da-a0f6-3566-907c-ba36b4b6c486",
                                                "text": "Déchiffrer quelqu’un, découvrir, révéler ses inclinations, ses desseins, ce qu’il fait ou ce qui lui est arrivé de plus secret."
                                            },
                                            {
                                                "example_id": "97178f6c-51ba-40a4-8a79-48ceadd40c22",
                                                "sense_id": "9db7f9da-a0f6-3566-907c-ba36b4b6c486",
                                                "text": "Elle avait appris à connaître son mari, qui, d’heure en heure, se sentait déchiffré, percé à jour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
