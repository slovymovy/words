                                "target_senses": [
                                    {
                                        "sense_id": "e34b2b30-a98b-3ed9-9ec4-12b1e4303612",
                                        "entry_id": "1a625607-f4d4-370f-ba8c-480756df4f4a",
                                        "glosses": [
                                            "The quality of being possible."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2360fe4-de9a-4571-8f92-60e0dec0fa82",
                                                "sense_id": "e34b2b30-a98b-3ed9-9ec4-12b1e4303612",
                                                "text": "'There is little possibility of that happening' 'I'd say there's rather a strongish possibility that it won't."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "313a99ab-5283-3b93-b451-43ec3673f201",
                                        "entry_id": "1a625607-f4d4-370f-ba8c-480756df4f4a",
                                        "glosses": [
                                            "A thing possible; that which may take place or come into being."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5e26774-fa97-483e-9fe6-6fe7e96bfba7",
                                                "sense_id": "313a99ab-5283-3b93-b451-43ec3673f201",
                                                "text": "Since the launch early last year of […] two Silicon Valley start-ups offering free education through MOOCs, massive open online courses, the ivory towers of academia have been shaken to their foundations. University brands built in some cases over centuries have been forced to contemplate the possibility that information technology will rapidly make their existing business model obsolete."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cde4a0e-0f5d-3189-963e-843dfa2e7ee2",
                                        "entry_id": "1a625607-f4d4-370f-ba8c-480756df4f4a",
                                        "glosses": [
                                            "An option or choice, usually used in context with future events."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ab4e261-36d4-4cb3-bb31-1b207f4f38af",
                                                "sense_id": "5cde4a0e-0f5d-3189-963e-843dfa2e7ee2",
                                                "text": "Mycelial lives are so other, their possibilities so strange."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4a06583-097d-314f-9d73-3cc797c69f6b",
                                        "entry_id": "1a625607-f4d4-370f-ba8c-480756df4f4a",
                                        "glosses": [
                                            "Capability, power or capacity to act."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a67f68b-b3c2-4ca2-acb3-6070e30c800d",
                                                "sense_id": "d4a06583-097d-314f-9d73-3cc797c69f6b",
                                                "text": "VVere Iacke Strawe a liue againe,\nAnd I in as good poſſibility as euer I was,\nI would lay a ſurer trumpe,\nEre I would loſe ſo faire a tricke."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4791302-0d15-40ba-a7fb-ff438229a3b7",
                        "source_entry_id": "e8830df5-8f24-3148-b64d-6bbf52a1a79c",
                        "source_sense_id": "ac790bfd-7b9c-3491-b135-c5cd54f1f0f9",
                        "source_sense_description": "iets wat gedaan kan worden of kan gebeuren",
                        "target_lang_word": "possibilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "possibilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e9d9d49e-ea80-398e-8c43-6aee694ca64f",
                                        "entry_id": "1a022b86-a6fa-368d-be8f-2253bc190cb4",
                                        "glosses": [
                                            "Caractère de ce qui est possible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1273a397-129c-443d-9813-78487796ac2b",
                                                "sense_id": "e9d9d49e-ea80-398e-8c43-6aee694ca64f",
                                                "text": "Son guiderope traîna de nouveau sur le sol et il envisagea la possibilité de tenter un atterrissage."
                                            },
                                            {
                                                "example_id": "563d870e-1b5c-4229-8ae6-bee8769a147a",
                                                "sense_id": "e9d9d49e-ea80-398e-8c43-6aee694ca64f",
                                                "text": "On étudiera également les possibilités d’épelation du malade pour des mots en rapport avec son niveau scolaire."
                                            },
                                            {
                                                "example_id": "1542f8d1-a82a-4c85-9bed-991c81ac7b82",
                                                "sense_id": "e9d9d49e-ea80-398e-8c43-6aee694ca64f",
                                                "text": "Une doctrine claire c’est d’abord le rejet de ce qui créé la confusion, parce que « le plus difficile c’est de voir ce que l’on voit ». C’est le rejet des « bonnes planques », ces lieux de pensée dont les résidents triés sur le volet accèderaient à un niveau logique supérieur, dont l’attirance est irrésistible : la nuance, la complexité, le doute, l’ambivalence des sentiments, la réduction au cas (concernant les victimes), l’irréductibilité à l’acte (concernant les agresseurs), la possibilité de changer, les principes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bfb2f70d-d789-3f06-8367-4185502e5464",
                                        "entry_id": "1a022b86-a6fa-368d-be8f-2253bc190cb4",
                                        "glosses": [
                                            "Chose possible"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b98997a-351a-4d74-9262-20de802241df",
                                                "sense_id": "bfb2f70d-d789-3f06-8367-4185502e5464",
                                                "text": "Après le diner M. B., le ministre plénipotentiaire honoraire, me pris à part pour me consulter sur la possibilité de faire un détour pour éviter « cette Moulouya ». — (Frédéric Weisgerber, Au seuil du Maroc Moderne, Institut des Hautes Études Marocaines, Rabat : Les éditions de la porte, 1947, page 268)"
                                            },
                                            {
                                                "example_id": "15e167f3-ddbc-48cb-95d6-2875b7526651",
                                                "sense_id": "bfb2f70d-d789-3f06-8367-4185502e5464",
                                                "text": "Nous insistons sur les possibilités multi-plateformes de Python et présentons les bases pour étendre Python et l'intégrer dans d'autres applications en utilisant C ou Java."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4f03095-2abb-38a6-88a5-fe9b7d1c3a88",
                                        "entry_id": "1a022b86-a6fa-368d-be8f-2253bc190cb4",
                                        "glosses": [
                                            "Un des cas d’un choix"
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f463cc3b-bee0-4d65-979d-5cfdad78bf18",
                                                "sense_id": "b4f03095-2abb-38a6-88a5-fe9b7d1c3a88",
                                                "text": "Il fallait choisir entre ces trois possibilités: poursuivre, rester ou revenir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
