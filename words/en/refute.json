{
    "word_family": [
        "refutation",
        "refutable",
        "irrefutable",
        "refuter"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4ed0da85-92fc-380e-a4cc-1a59a8e56089",
                    "sense_definition": "To prove that a statement, theory, or argument is false or incorrect using evidence.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "disprove",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist published a new study to <w>refute</w> the previous claims about the drug's safety.",
                            "target_lang_translations": {
                                "ru": "Ученый опубликовал новое исследование, чтобы <w>опровергнуть</w> предыдущие заявления о безопасности препарата."
                            }
                        },
                        {
                            "text": "It is difficult to <w>refute</w> evidence when it is presented so clearly in court.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>опровергнуть</w> доказательства, когда они так четко представлены в суде."
                            }
                        }
                    ],
                    "synonyms": [
                        "disprove",
                        "rebut",
                        "debunk"
                    ],
                    "antonyms": [
                        "prove",
                        "demonstrate",
                        "confirm"
                    ],
                    "common_phrases": [
                        "refute evidence",
                        "refute a theory",
                        "refute a claim"
                    ],
                    "target_lang_definitions": {
                        "ru": "Доказать ложность или ошибочность утверждения, теории или аргумента с помощью доказательств."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опровергать",
                                "target_lang_sense_clarification": "доказывать ложность утверждения или теории"
                            },
                            {
                                "target_lang_word": "развенчивать",
                                "target_lang_sense_clarification": "показывать несостоятельность мифа или идеи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a276af2-9c19-3791-9359-f2070d41e1d3",
                    "sense_definition": "To strongly deny the truth or accuracy of something, often without providing absolute proof.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "deny",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician chose to <w>refute</w> allegations of corruption during the press conference.",
                            "target_lang_translations": {
                                "ru": "Политик решил <w>отвергнуть</w> обвинения в коррупции во время пресс-конференции."
                            }
                        },
                        {
                            "text": "She tried to <w>refute</w> accusations made by her former business partner.",
                            "target_lang_translations": {
                                "ru": "Она пыталась <w>опровергнуть</w> обвинения, выдвинутые ее бывшим деловым партнером."
                            }
                        }
                    ],
                    "synonyms": [
                        "deny",
                        "repudiate",
                        "dispute",
                        "gainsay",
                        "reject"
                    ],
                    "antonyms": [
                        "affirm",
                        "accept",
                        "profess"
                    ],
                    "common_phrases": [
                        "refute allegations",
                        "refute accusations"
                    ],
                    "target_lang_definitions": {
                        "ru": "Решительно отрицать истинность или точность чего-либо, часто без предоставления абсолютных доказательств."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отрицать",
                                "target_lang_sense_clarification": "не соглашаться с истинностью обвинений или фактов"
                            },
                            {
                                "target_lang_word": "оспаривать",
                                "target_lang_sense_clarification": "подвергать сомнению правильность чего-либо"
                            },
                            {
                                "target_lang_word": "отвергать",
                                "target_lang_sense_clarification": "не принимать обвинения или доводы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}