                                    {
                                        "sense_id": "22a85211-ff1c-37c7-bfdd-a0a950670827",
                                        "entry_id": "2a4cb6e4-1fa1-3643-a31a-93fd98811d8d",
                                        "glosses": [
                                            "Impulsion courte de l’alphabet morse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b455361-dc88-4d30-8a91-d7652e853fd5",
                                                "sense_id": "22a85211-ff1c-37c7-bfdd-a0a950670827",
                                                "text": "Un ta est conventionnellement trois fois plus long qu’un ti. L’espace entre deux lettres égale trois ti."
                                            },
                                            {
                                                "example_id": "2daf3206-d64d-4b42-b0b9-82c2ac781bed",
                                                "sense_id": "22a85211-ff1c-37c7-bfdd-a0a950670827",
                                                "text": "Un instant plus tard, dans la nuit calme d’Aubenas, le son aigu de la sonnerie se répercuta de mur en mur : « Ti, ti, ti, ta, ta, ta, ti, ti, ti » Misouo s’appliqua, il ne devait pas se tromper : trois points, trois traits, trois points, […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ti",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "45921fc5-5a60-375f-a4c9-07bc93e9b577",
                                        "entry_id": "632c5817-aa82-3dda-9b67-f721acf9570b",
                                        "glosses": [
                                            "ou Tu."
                                        ],
                                        "tags": [
                                            "Par plaisanterie",
                                            "Régionalisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7df21bbe-f4c4-433b-b77c-7ca8368d0a4f",
                                                "sense_id": "45921fc5-5a60-375f-a4c9-07bc93e9b577",
                                                "text": "Si ti cherches, ti trouves."
                                            },
                                            {
                                                "example_id": "a3a4d18b-7540-4776-b598-25e004caeaaf",
                                                "sense_id": "45921fc5-5a60-375f-a4c9-07bc93e9b577",
                                                "text": "Ti es fada !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ti",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fa622a36-76be-36fc-84a4-f476c8d65d44",
                                        "entry_id": "68bf3b9e-6dfc-3fd2-bab3-3b0079c95473",
                                        "glosses": [
                                            "Marqueur interrogatif ajouté après un verbe. Est-ce que."
                                        ],
                                        "tags": [
                                            "dated",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d29a18e6-44b3-4f81-bed6-9945047eedd6",
                                                "sense_id": "fa622a36-76be-36fc-84a4-f476c8d65d44",
                                                "text": "T’avais-ti perdu le sens ? — Est-ce que tu avais perdu le sens ?"
                                            },
                                            {
                                                "example_id": "16363c55-6b3d-4586-85d7-3d1f8a065a4b",
                                                "sense_id": "fa622a36-76be-36fc-84a4-f476c8d65d44",
                                                "text": "À qui elle téléphone-ti ? — À qui est-ce qu’elle téléphone ?"
                                            },
                                            {
                                                "example_id": "1feba27d-97de-49b3-85e9-839da6256cef",
                                                "sense_id": "fa622a36-76be-36fc-84a4-f476c8d65d44",
                                                "text": "Où j’ai ti vu ce nom-là ? — Où est-ce que j’ai vu ce nom-là ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
