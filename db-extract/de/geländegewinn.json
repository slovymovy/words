                        ],
                        "examples": [
                            {
                                "example_id": "bc878339-4e24-4371-bf08-2e02fa41af01",
                                "sense_id": "38c12231-80de-35f0-99fd-23a5e52d6b17",
                                "text": "[26. März 2022:] „Seit einem Monat verteidigt sich die Ukraine gegen den großen russischen Angriffskrieg. Während viele im Westen – auch aus Überheblichkeit und Ignoranz – von einer Einnahme der Hauptstadt Kiew binnen weniger Tage ausgingen, bleiben die Geländegewinne Russlands überschaubar.“"
                            },
                            {
                                "example_id": "5da6e301-483a-4e09-b6c3-7d9200db408d",
                                "sense_id": "38c12231-80de-35f0-99fd-23a5e52d6b17",
                                "text": "übertragen: „Putin wollte die Vereinigten Staaten aus Europa vertreiben. Stattdessen verankert er sie wieder so stark auf dem Kontinent wie nie seit dem Ende des Kalten Kriegs. All die strategischen Geländegewinne, die Russland in den vergangenen Jahrzehnten erzielt hatte, von der Energie bis zu RT, hat er mit seinem unüberlegten Angriffskrieg [auf die Ukraine] verspielt.“"
                            },
                            {
                                "example_id": "d2e99a9d-f159-4e75-bab9-0c4344be55a0",
                                "sense_id": "38c12231-80de-35f0-99fd-23a5e52d6b17",
                                "text": "„Die ZANLA hatte weiterhin keine Erfolge in Form von Geländegewinnen zu verzeichnen.“"
                            }
                        ],
