                        ],
                        "examples": [
                            {
                                "example_id": "13e86aaf-e758-42bc-bef2-334c631e1a42",
                                "sense_id": "20632cea-f9d8-3ba3-9603-3f52a64d1246",
                                "text": "Ik vroeg me af of die man in de trein gewoon een binnenpretje had, of dat ik het was die hij zat uit te lachen.",
                                "translation": "I wondered wether that man on the train just made himself laugh, or it was me who he was laughing at.",
                                "english": "I wondered wether that man on the train just made himself laugh, or it was me who he was laughing at."
                            },
                            {
                                "example_id": "bee1ef18-09aa-46e1-b453-b168241466d8",
                                "sense_id": "20632cea-f9d8-3ba3-9603-3f52a64d1246",
                                "text": "Hij heeft vast een binnenpretje over een nieuw idee waarmee hij zijn fans weer op het verkeerde been kan zetten."
                            },
                            {
                                "example_id": "f75edc4f-9cc9-42f6-af27-34e6b69a86a4",
                                "sense_id": "20632cea-f9d8-3ba3-9603-3f52a64d1246",
                                "text": "Een gekrulde mondhoek verraadt een binnenpretje."
                            },
                            {
                                "example_id": "23212858-e6b8-4a3e-935b-f33f32ad0d53",
                                "sense_id": "20632cea-f9d8-3ba3-9603-3f52a64d1246",
                                "text": "Had de architect tijdens het tekenen van het ontwerp gewoon een binnenpretje of is er meer aan de hand?"
