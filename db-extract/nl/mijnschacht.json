                "senses": [
                    {
                        "sense_id": "919ae15b-1b28-37f5-a0a9-3a7b1c6fac3a",
                        "entry_id": "30a7b97b-f11a-32cf-811c-ebdcb0b05777",
                        "glosses": [
                            "een verticale, meestal cilindervormige toegangsweg tussen het aardoppervlak en plaatsen in de ondergrond waar delfstoffen in vaste vorm worden ontgonnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a2270fa-c9f2-4c92-b3e4-b1d3bccadf22",
                                "sense_id": "919ae15b-1b28-37f5-a0a9-3a7b1c6fac3a",
                                "text": "Het hulpgeroep kwam van beneden, flarden van stemmen door een opening van minder dan een meter bij een meter. Zo ontdekte een Zuid-Afrikaanse politiepatrouille die afgelopen zondagochtend de ronde deed bij een verlaten mijnschacht van het Chinese Gold One ten oosten van Johannesburg bij toeval dat onder de grond ten minste dertig mijnwerkers vastzaten in een ventilatieschacht. Zamazama’s, heten ze in de volksmond. Kompels zonder officieel emplooi, gelukzoekers zonder papieren."
                            },
                            {
                                "example_id": "d5b493dc-03be-4460-a45d-29a4b2567ede",
                                "sense_id": "919ae15b-1b28-37f5-a0a9-3a7b1c6fac3a",
                                "text": "Onderzoekers hebben in een verlaten mijn in het Engelse graafschap Wales op 60 meter diepte een mysterieus autokerkhof gevonden. Volgens Britse media lagen op de bodem van één van de mijnschachten circa 100 oude wagens in wisselende staat. De roestige voertuigen zijn van allerlei bouwjaren maar vooral uit de jaren '60 en '70."
                            }
                        ]
                    }
