                    {
                        "translation_id": "ce1ee759-8c8e-49d8-89f6-d51a9e72749d",
                        "source_entry_id": "4a430d19-58e9-3c11-8b11-812e240bc1f1",
                        "source_sense_id": "368f1496-a0c5-3382-a56a-9b8b7bfa3fbf",
                        "target_lang_word": "évangéliaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "évangéliaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "427c70d6-c009-3782-b055-95627b57aa2a",
                                        "entry_id": "5f3282ba-3b9c-36b3-9b0f-92f8e3cfcf06",
                                        "glosses": [
                                            "Volume qui contient les évangiles que les chrétiens lisent ou chantent à la messe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4afbd83-df25-4455-9c92-a82386fd1631",
                                                "sense_id": "427c70d6-c009-3782-b055-95627b57aa2a",
                                                "text": "Henno Gui convint qu’en effet, malgré ces fines rides et cette peau blafarde, la face allongée et les pommettes creusées de cet homme avaient une familiarité étonnante avec cette représentation sacrée que les icônes et les évangéliaires répandaient à travers le monde."
                                            },
                                            {
                                                "example_id": "93043fe2-8f8a-43a7-b377-eaa4ffdc2630",
                                                "sense_id": "427c70d6-c009-3782-b055-95627b57aa2a",
                                                "text": "Deux plaque de cuivre émaillées et relevées de figures de cuivre proviennent sans doute d’un évangéliaire. Les plaques ont été exécutées à Limoges au début du XIIIᵉ siècle avec le Christ en croix et les anges, alors que les figures centrales ont été remplacées au XVᵉ siècle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a9704ef-bca2-484d-95f7-5366ffe21a03",
                        "source_entry_id": "4a430d19-58e9-3c11-8b11-812e240bc1f1",
                        "source_sense_id": "368f1496-a0c5-3382-a56a-9b8b7bfa3fbf",
                        "target_lang_word": "evangeliario",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "62616782-5488-4198-a936-96f204cd8c42",
                        "source_entry_id": "4a430d19-58e9-3c11-8b11-812e240bc1f1",
                        "source_sense_id": "368f1496-a0c5-3382-a56a-9b8b7bfa3fbf",
                        "target_lang_word": "Evangeliar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Evangeliar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8b4eccb4-50e8-3ff7-8518-4fc67f717547",
                                        "entry_id": "1803b6e6-3e65-304b-9a22-5fd985c56396",
                                        "glosses": [
                                            "ein liturgisches Buch mit dem vollständigen Text der vier Evangelien"
                                        ],
                                        "tags": [
                                            "christliche Religion"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f4994b2-2ecf-42a8-be38-5eab4a1770c3",
                                                "sense_id": "8b4eccb4-50e8-3ff7-8518-4fc67f717547",
                                                "text": "„Bei den seit frühmittelalterlicher Zeit erhaltenen Evangeliaren handelt es sich um Codices, in denen dem Evangelientext in der Regel weitere Begleittexte … beigefügt sind.“"
                                            },
                                            {
                                                "example_id": "2f6d964d-1dbd-4271-b745-8c4f1beac0cd",
                                                "sense_id": "8b4eccb4-50e8-3ff7-8518-4fc67f717547",
                                                "text": "„Zudem gibt es Seiten von Evangeliaren, auf denen nur Ornamente, meist mit einem Kreuz im Zentrum, dargestellt sind.“"
                                            },
                                            {
                                                "example_id": "41b3c1ef-a065-4b9c-adea-46bb8530e92c",
                                                "sense_id": "8b4eccb4-50e8-3ff7-8518-4fc67f717547",
                                                "text": "„Die Bücher, die für die Liturgie gebraucht wurden, die Evangeliare, Sakramente, Perikopenbücher, Graduale, Antiphonare und Epistolare, gehörten nicht so sehr dem Bereich der Bibliothek und der Studierstube als der Sphäre der Kirche an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c676d50-f238-40b3-862c-c0273e529042",
                        "source_entry_id": "4a430d19-58e9-3c11-8b11-812e240bc1f1",
                        "source_sense_id": "368f1496-a0c5-3382-a56a-9b8b7bfa3fbf",
                        "target_lang_word": "Evangelienbuch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Evangelienbuch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7748f4f7-8d10-3fbb-ad88-aff9f5e2c13b",
                                        "entry_id": "7456f39c-e4c9-3122-b6ac-5acc503499c5",
                                        "glosses": [
                                            "ein liturgisches Buch mit dem vollständigen Text der vier Evangelien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b7a9ef0-9538-477b-b917-a613bbf44cce",
                                                "sense_id": "7748f4f7-8d10-3fbb-ad88-aff9f5e2c13b",
                                                "text": "„In der Tasche das kleine Evangelienbuch mit der Hand umschließend, das ihm die um sein Seelenheil besorgte Pflegemutter geschenkt hatte, kam es ihm vor, als wanderten zwei Gestalten aus diesem Buche vor ihm her, ja als wäre er selbst nur eine Gestalt aus der heiligen Darstellung, die ihn nun schon seit Wochen beschäftigte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
