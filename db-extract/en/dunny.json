                        "examples": []
                    },
                    {
                        "sense_id": "54f1a8fb-56d6-39c8-845c-f5a205d6ae3b",
                        "entry_id": "503c50bb-c36b-375a-a396-61cf4d60506e",
                        "glosses": [
                            "An outhouse: an outbuilding used as a lavatory."
                        ],
                        "tags": [
                            "Australia",
                            "New-Zealand",
                            "Northern-England",
                            "Scotland",
                            "also",
                            "dated",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "77cc1b13-f986-4898-a226-07b88007c89d",
                                "sense_id": "54f1a8fb-56d6-39c8-845c-f5a205d6ae3b",
                                "text": "\"I've got one of those outside dunnies here, hasn't been emptied for six months and I ran out of sawdust three months ago.\""
                            },
                            {
                                "example_id": "ffc80dfd-d998-4351-aa12-a3b9db6473eb",
                                "sense_id": "54f1a8fb-56d6-39c8-845c-f5a205d6ae3b",
                                "text": "There was one leaning dunny down the back and, if you stayed very quiet, on a very still day you could hear the white ants as they chewed the wood.The bottom boards were already eaten through, and I avoided using the dunny at all costs."
                            },
                            {
                                "example_id": "8fee7c84-a962-4a72-9587-1a72b16a7d9f",
                                "sense_id": "54f1a8fb-56d6-39c8-845c-f5a205d6ae3b",
                                "text": "‘Until you wake up to yourself, you can live in the old dunny for all I care.’\n‘All right, I will,’ said Tony."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b33b2a7-d1e9-3eda-b7d2-2468bfa724e1",
                        "entry_id": "503c50bb-c36b-375a-a396-61cf4d60506e",
                        "glosses": [
                            "Any other place or fixture used for urination and defecation: a latrine; a lavatory; a toilet."
                        ],
                        "tags": [
                            "Australia",
                            "New-Zealand",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "12af2d3b-2f88-4e11-93f7-23543df8a9e7",
                                "sense_id": "4b33b2a7-d1e9-3eda-b7d2-2468bfa724e1",
                                "text": "The dunny was another place to go to get out of class. You got to go there by raising your hand in class and asking Miss if you could go to the lav."
                            }
                        ]
                    },
                    {
                        "sense_id": "5ef510cb-ab31-3d5a-92b0-edac66a676b3",
                        "entry_id": "503c50bb-c36b-375a-a396-61cf4d60506e",
                        "glosses": [
                            "A passageway, particularly those connecting an outhouse to the main building."
                        ],
                        "tags": [
                            "Northern-England",
                            "Scotland",
                            "dated",
                            "slang"
                        ],
                        "examples": []
                    }
