                        "sense_id": "6646fc25-939e-3195-aceb-c0e317f28c13",
                        "entry_id": "c29cfa6f-771b-396a-b0b9-4bd3d7506549",
                        "glosses": [
                            "het zaken die verkeerd zijn zo beschrijven dat ze goed lijken; het recht praten wat krom is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7b8e2b8-c2db-4ecb-9588-2dafd7d26e1e",
                                "sense_id": "6646fc25-939e-3195-aceb-c0e317f28c13",
                                "text": "'Toch verdien ik met één klant per week meer dan met mijn werk als boekhouder op kantoor,'zegt ze, ter vergoelijking."
                            },
                            {
                                "example_id": "442f7538-3bf2-45a4-9597-e43db9168fb9",
                                "sense_id": "6646fc25-939e-3195-aceb-c0e317f28c13",
                                "text": "Maar in 1986 werd Jörg Haider partijleider en trok de partij weer ver naar rechts. Haider maakte de FPÖ populair met leuzen tegen buitenlanders en vergoelijking van het nazi-verleden, maar kon toch samen met de christen-democraten regeren. Die regering, van 2000 tot 2002, leverde Oostenrijk zelfs sancties van de andere EU-landen op."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f8ed740-34f6-48b5-bbfe-52abe73a5ba5",
                        "source_entry_id": "c29cfa6f-771b-396a-b0b9-4bd3d7506549",
                        "source_sense_id": "6646fc25-939e-3195-aceb-c0e317f28c13",
