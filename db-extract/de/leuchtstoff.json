                "translations": [
                    {
                        "translation_id": "640539ce-5ced-4e6b-8a24-ad6ece5997b5",
                        "source_entry_id": "461fbc47-0c0a-3641-8d5e-d6077ab0ebc2",
                        "source_sense_id": "3c2e5a8a-6460-39c9-a1a3-407e845810ce",
                        "target_lang_word": "luminophore",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "luminophore",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f4ad4da6-4c4b-3360-bfb3-fe5c294f3e6a",
                                        "entry_id": "59814934-c805-31b1-94e2-92568c2fd057",
                                        "glosses": [
                                            "Composé qui émet de la lumière lorsqu'il subit une excitation."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f15d24ad-c5c9-433b-826e-08dcbe770d8d",
                                                "sense_id": "f4ad4da6-4c4b-3360-bfb3-fe5c294f3e6a",
                                                "text": "Un luminophore de fluorohalogénure de baryum."
                                            },
                                            {
                                                "example_id": "efcfcf95-2b5c-481c-8a50-c302d8893079",
                                                "sense_id": "f4ad4da6-4c4b-3360-bfb3-fe5c294f3e6a",
                                                "text": "Le luminophore est une substance qui, lorsqu’elle subit une excitation, émet de la lumière."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eaa8a6e3-458e-4a7e-b5bc-8d07ac55e42e",
                        "source_entry_id": "461fbc47-0c0a-3641-8d5e-d6077ab0ebc2",
                        "source_sense_id": "3c2e5a8a-6460-39c9-a1a3-407e845810ce",
                        "target_lang_word": "phosphore",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phosphore",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "98b33cf0-74c4-3932-a3c9-72139069ef02",
                                        "entry_id": "081016a9-44b4-3b49-a6b0-92a8694b1ce7",
                                        "glosses": [
                                            "Élément chimique de numéro atomique 15 et de symbole P qui fait partie des non-métaux, mais aussi des pnictogènes."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfc0cbc8-556c-40c4-a4f0-dea8dda0b0d0",
                                                "sense_id": "98b33cf0-74c4-3932-a3c9-72139069ef02",
                                                "text": "Je m’apprête à allumer la lampe. Je frotte une allumette. Elle ne prend pas, le phosphore s’écaille, elle se casse. Je la jette, et, un peu las, j’attends…"
                                            },
                                            {
                                                "example_id": "31477b77-5d16-49bc-8cc6-5381154c639c",
                                                "sense_id": "98b33cf0-74c4-3932-a3c9-72139069ef02",
                                                "text": "[…]; mais le professeur A. Riva (2) donne, comme signe pour le diagnostic de l’empoisonnement par le phosphore, l'absence de la biline et du bilinogène dans les urines et dans les matières fécales."
                                            },
                                            {
                                                "example_id": "43c9fa58-2163-45c1-ad21-c524222a40b5",
                                                "sense_id": "98b33cf0-74c4-3932-a3c9-72139069ef02",
                                                "text": "Le phosphore, ce vieil ennemi du sidérurgiste, devient un ami et un allié dans le procédé Bessemer-Thomas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0dc4d6a-e56d-3954-963d-efff28a81aee",
                                        "entry_id": "081016a9-44b4-3b49-a6b0-92a8694b1ce7",
                                        "glosses": [
                                            "Corps simple de l’élément, représenté par plusieurs formes allotropiques dont le phosphore blanc, blanc ivoire, malléable et avec une légère odeur d’ail, et les phosphores rouge et noir, sous forme de cristaux ou de poudre."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93934d45-09b6-4810-a2b5-ed19c2cf053b",
                                                "sense_id": "c0dc4d6a-e56d-3954-963d-efff28a81aee",
                                                "text": "Le soir était venu. Nicole frotta plusieurs allumettes sur le plancher ; mais l'humidité s'opposait à leur inflammation, et elles laissaient sur le bois les lueurs bleuâtres du phosphore..."
                                            },
                                            {
                                                "example_id": "2a47ae00-5a3a-4377-b1b4-1e60b48edf1e",
                                                "sense_id": "c0dc4d6a-e56d-3954-963d-efff28a81aee",
                                                "text": "Les éclairs ont pu procurer suffisamment de phosphore en frappant la Terre pour contribuer à l'émergence de la vie, selon une étude, publiée mardi, qui offre un scénario alternatif à celui couramment admis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7d40898-4d9c-33c8-ada4-5dae9b3f4281",
                                        "entry_id": "081016a9-44b4-3b49-a6b0-92a8694b1ce7",
                                        "glosses": [
                                            "Atome (ou, par ellipse, noyau) de phosphore."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ae2342f-18fd-4e4a-8aeb-dda9792e6643",
                                                "sense_id": "c7d40898-4d9c-33c8-ada4-5dae9b3f4281",
                                                "text": "Dans le cas de la diphosphite, nous avons incorporé des substituants chiraux sur les deux phosphores afin d’obtenir un ligand chiral possédant une symétrie C-2."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de655c37-62ec-3485-aa8e-88f8663eb821",
                                        "entry_id": "081016a9-44b4-3b49-a6b0-92a8694b1ce7",
                                        "glosses": [
                                            "Allotrope du phosphore."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc26c7b4-c898-48b1-8d1d-14067fbce2a7",
                                                "sense_id": "de655c37-62ec-3485-aa8e-88f8663eb821",
                                                "text": "Les phosphores sont au nombre de trois : blanc, rouge, et noir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44022ebe-2137-31ed-9774-1ff8aa217a82",
                                        "entry_id": "081016a9-44b4-3b49-a6b0-92a8694b1ce7",
                                        "glosses": [
                                            "Luminophore, élément fluorescent d’un écran qui brille sous l’effet d’une excitation électrique ou électronique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18acbcc6-ba09-431c-a20e-cdb54db3a91b",
                                                "sense_id": "44022ebe-2137-31ed-9774-1ff8aa217a82",
                                                "text": "Le rendu des couleurs d’un téléviseur à plasma est remarquablement supérieur dans la plupart des scènes parce que des phosphores rouges, verts et bleus individuels sont utilisés pour créer les couleurs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "phosphore",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "749d5664-ca2f-3a98-9235-0ccd43a7d777",
