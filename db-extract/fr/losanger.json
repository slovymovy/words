                ],
                "senses": [
                    {
                        "sense_id": "d56ee2e3-b04e-3778-bd6d-3abb96746630",
                        "entry_id": "8349ecb5-c6c0-3132-b353-f7183a9e407c",
                        "glosses": [
                            "Distribuer en forme de losanges."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "543e4a3c-f682-420f-bb5e-88eb3cd35df6",
                                "sense_id": "d56ee2e3-b04e-3778-bd6d-3abb96746630",
                                "text": "Ce coin où se réfugiait Durtal était à peine éclairé par des verrières en ogive, losangées de mailles noires."
                            },
                            {
                                "example_id": "5312f9bf-7261-4d75-9aee-41667aa321c2",
                                "sense_id": "d56ee2e3-b04e-3778-bd6d-3abb96746630",
                                "text": "Vitré dont l’accent aigu losangeait de bois noir le vitrage ancien."
                            },
                            {
                                "example_id": "cd88201a-a244-4edf-aca7-bf36183af417",
                                "sense_id": "d56ee2e3-b04e-3778-bd6d-3abb96746630",
                                "text": "À travers son voile, qui moule et losange son baiser comme un caillé délicieux, à travers ses lèvres qu’elle ferme rageusement, sans paraître y songer, sans sourire, la duchesse Martin m’embrasse."
                            },
                            {
                                "example_id": "be47bb5d-9437-43a0-bc28-7edee3eae3d5",
                                "sense_id": "d56ee2e3-b04e-3778-bd6d-3abb96746630",
                                "text": "Ce sont de ces immémoriaux verres à moutarde à paroi losangée."
                            }
                        ]
                    }
                ],
