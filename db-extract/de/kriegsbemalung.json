                        ],
                        "form": "die Kriegsbemalungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5ce70a31-c2fc-3e0e-980d-8ec290895ed8",
                        "entry_id": "7593f339-4dcf-3ad9-9dfa-03207acd8c4f",
                        "glosses": [
                            "Bemalung am Gesicht oder am ganzen Körper, die von indigenen Völkern vor oder in kriegerischen Auseinandersetzungen getragen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "862b8a81-350b-46d8-907b-b5214901cf4f",
                                "sense_id": "5ce70a31-c2fc-3e0e-980d-8ec290895ed8",
                                "text": "„Indianer in Kriegsbemalung folgten den Reitern in einer Reihe, schrien und machten drohende Gebärden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e8a40c2b-a05c-34ec-958d-b74ba55a695e",
                        "entry_id": "7593f339-4dcf-3ad9-9dfa-03207acd8c4f",
                        "glosses": [
                            "Make-up"
                        ],
                        "tags": [
                            "colloquial",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "63720bd0-4d61-4bb6-a7c4-f9a2b1294a10",
                                "sense_id": "e8a40c2b-a05c-34ec-958d-b74ba55a695e",
                                "text": "„In der Tür des Berliner Zimmers taucht das Antlitz ihrer Schwiegermutter auf, schon halb in Kriegsbemalung.“"
                            },
                            {
                                "example_id": "9fc65036-7a25-4ebb-a767-c60208f755df",
                                "sense_id": "e8a40c2b-a05c-34ec-958d-b74ba55a695e",
                                "text": "„Heide und Gilli kommen, sie haben die Kriegsbemalung abgelegt, die Haare beide zu einem dicken Zopf geflochten und tragen lockere Kleidung.“"
                            },
                            {
                                "example_id": "502158e4-d0ef-44cc-8ba9-aa6e82b5179f",
                                "sense_id": "e8a40c2b-a05c-34ec-958d-b74ba55a695e",
                                "text": "„Indessen hatte Miss Runcible ein leeres Badezimmer entdeckt und kam eine halbe Stunde später in Rock statt Hose und in voller Kriegsbemalung herunter, wieder ganz sie selbst und zu allen Schandtaten bereit.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
