                "senses": [
                    {
                        "sense_id": "a636fa8e-d969-3300-8be6-9bb557a0a0bc",
                        "entry_id": "a4ccaa68-ab0c-359f-87d1-48093c74e4ac",
                        "glosses": [
                            "speziell Aufeinanderfolge von aufeinander bezogenen Kommunikationsbeiträgen"
                        ],
                        "tags": [
                            "Pragmatik"
                        ],
                        "examples": [
                            {
                                "example_id": "d9589e16-3252-41d9-85b6-ccc751c793d1",
                                "sense_id": "a636fa8e-d969-3300-8be6-9bb557a0a0bc",
                                "text": "„Hypothese ist dabei, dass die gesamte menschliche sprachliche Kommunikation einer Gesellschaft aus Kommunikationsreihen, oder kurz: aus Reihen besteht.“"
                            },
                            {
                                "example_id": "976e617c-cd07-4006-9677-d48c5d75a13f",
                                "sense_id": "a636fa8e-d969-3300-8be6-9bb557a0a0bc",
                                "text": "„Fachinterne wie fachexterne Kommunikationsreihen sind jeweils geprägt von spezifischen Regularitäten.“"
                            },
                            {
                                "example_id": "4962fb5e-77b8-4917-8d9b-bd2b9837ee3c",
                                "sense_id": "a636fa8e-d969-3300-8be6-9bb557a0a0bc",
                                "text": "„Er ist einer der wenigen, die in theoretischer Absicht Gespräche und Texte (und auch innere Sprache) in einem einheitlichen Format behandeln, d. h. nicht als unterschiedliche Großkomplexe, sondern in ihrem Miteinander, als Bestandteile von umfassenderen Kommunikationsreihen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
