                "senses": [
                    {
                        "sense_id": "22b359ef-b35d-35bf-9a61-482d3d550935",
                        "entry_id": "75745e1d-ac79-3bf6-b922-3a07d9cb69c4",
                        "glosses": [
                            "Adjoint de substances artificielles, pollué."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07c468c6-9e27-4774-8718-8e66dfc3a6fb",
                                "sense_id": "22b359ef-b35d-35bf-9a61-482d3d550935",
                                "text": "Les animaux sauvages profitent, eux aussi, des pollutions industrielles, quand ils « broutent » sur des sols pollués à la dioxine, au furane et aux PCB, ou se désaltèrent dans des cours d’eau chimiqués."
                            },
                            {
                                "example_id": "87f4b3cb-b752-4d95-a799-47796bad3aab",
                                "sense_id": "22b359ef-b35d-35bf-9a61-482d3d550935",
                                "text": "Il s’agit maintenant de survivre au milieu des attaques que nous subissons de toutes parts, de ne pas mourir de faim sur un sac de riz empoisonné, mourir de soif à côté d’un seau d’eau chimiquée, mourir des vaccins que l’on nous impose, des médicaments qu’on nous rembourse."
                            },
                            {
                                "example_id": "5b3b9839-0bdc-41d4-9c60-fb848614230c",
                                "sense_id": "22b359ef-b35d-35bf-9a61-482d3d550935",
                                "text": "Sachant que ces travers permettront peut-être aux archéologues du quatrième millénaire de mettre à jour en lieu et place de squelettes riant de toutes leurs dents, dentisterie moderne oblige, des cohortes de momies chimiquées, en forme de pains de sucres chlorés parfaitement imputrescibles, un désespoir de ténias diabétiques."
                            }
                        ]
                    }
