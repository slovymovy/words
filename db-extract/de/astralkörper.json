                        ]
                    },
                    {
                        "translation_id": "da38340b-1f9c-47da-b7b4-3d1f99d5c24f",
                        "source_entry_id": "e99e309e-748d-3387-9f73-a7ee93619c43",
                        "source_sense_id": "36d60be7-9877-3e2e-a0da-0342e3ad5d27",
                        "source_sense_description": "sternartige Hülle, die nach dem Ableben die Seele umgibt",
                        "target_lang_word": "corpo astral",
                        "target_lang_code": "pt",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corpo astral",
                                "target_lang_code": "pt",
                                "target_senses": [
                                    {
                                        "sense_id": "ef2272e7-1a1d-3cb8-bd8c-fa5bcabced08",
                                        "entry_id": "99118c1d-d2f9-3269-af2b-ab29974447c1",
                                        "glosses": [
                                            "em doutrinas como o platonismo, esoterismo ou teosofia, corpo que serve de ligação imediata entre o corpo físico e a alma como um envoltório desta última, presente apenas em seres vivos e que após a morte tende a desaparecer; é concebido como um corpo sutil composto de algum tipo de material etéreo ou como sendo não físico e capaz de às vezes se separar do corpo físico para viajar para outros lugares ou para outros reinos de existência"
                                        ],
                                        "tags": [
                                            "Parapsiquismo"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93127fa1-fb6e-4a08-893e-3e723e0efb5a",
                                                "sense_id": "ef2272e7-1a1d-3cb8-bd8c-fa5bcabced08",
                                                "text": "O Linga-sharira, ou corpo astral, “aura” ambiente, que circula, em auréola, em torno da cabeça é o último princípio que abandona o corpo e a lua cabeça é feminina. Será o coração viril?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
