{
    "word_family": [
        "effect",
        "effective",
        "effectual",
        "effectuate"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "aab1c67c-bde0-327c-9254-7e8b2b0977b4",
                    "sense_definition": "Not producing the desired result or outcome.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ineffective",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new policy proved <w>ineffective</w> at reducing traffic congestion in the city center.",
                            "target_lang_translations": {
                                "zh": "事实证明，这项新政策在缓解市中心交通拥堵方面是<w>无效</w>的。"
                            }
                        },
                        {
                            "text": "They tried several <w>ineffective</w> methods before finally finding a solution that worked.",
                            "target_lang_translations": {
                                "zh": "他们尝试了几种<w>不起作用</w>的方法，才最终找到了一个可行的解决方案。"
                            }
                        }
                    ],
                    "synonyms": [
                        "useless",
                        "futile",
                        "inefficacious"
                    ],
                    "antonyms": [
                        "effective",
                        "successful"
                    ],
                    "common_phrases": [
                        "largely ineffective",
                        "completely ineffective"
                    ],
                    "target_lang_definitions": {
                        "zh": "指未能达到预期效果或目的的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "无效",
                                "target_lang_sense_clarification": "指方法、政策或措施没有产生预期的结果。"
                            },
                            {
                                "target_lang_word": "不起作用",
                                "target_lang_sense_clarification": "指某事物在解决问题时没有发挥应有的效力。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34612349-f7c9-36af-8b46-f0a4f2d6b678",
                    "sense_definition": "Lacking the necessary skills or ability to perform a task well.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ineffective",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager was considered <w>ineffective</w> because he could not motivate his team to meet deadlines.",
                            "target_lang_translations": {
                                "zh": "这位经理被认为很<w>无能</w>，因为他无法激励团队按时完成任务。"
                            }
                        },
                        {
                            "text": "An <w>ineffective</w> leader often struggles to communicate clear goals to their employees.",
                            "target_lang_translations": {
                                "zh": "一个<w>不称职</w>的领导者往往难以向员工传达明确的目标。"
                            }
                        }
                    ],
                    "synonyms": [
                        "incompetent",
                        "inadequate",
                        "inept"
                    ],
                    "antonyms": [
                        "competent",
                        "capable"
                    ],
                    "target_lang_definitions": {
                        "zh": "指缺乏完成任务所需的技能或能力，表现不佳的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "无能",
                                "target_lang_sense_clarification": "指人缺乏胜任工作的能力或才干。"
                            },
                            {
                                "target_lang_word": "不称职",
                                "target_lang_sense_clarification": "指人在职位上表现不佳，无法达到岗位要求。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}