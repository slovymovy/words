            "pos": "verb",
            "senses": [
                {
                    "sense_id": "72390e8b-333c-3239-a5b6-f6a5c144c145",
                    "sense_definition": "Brouter l'herbe sur pied ou manger des végétaux sur place, en parlant du bétail et des animaux sauvages.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "nourriture_animale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans la vallée verdoyante, les vaches <w>paissent</w> paisiblement tout l'après-midi."
                        },
                        {
                            "text": "Le fermier laisse ses chevaux <w>paître</w> dans le grand champ derrière l'étable."
                        }
                    ],
                    "synonyms": [
                        "brouter"
                    ],
                    "common_phrases": [
                        "laisser paître"
                    ]
                },
                {
                    "sense_id": "263329c4-44f6-3f5f-977a-d3a69bd36a39",
                    "sense_definition": "Mener des animaux au pâturage, les nourrir en les faisant brouter.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "nourriture_animale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tôt le matin, le vieux berger s'en va <w>paître</w> ses moutons sur les hauteurs."
                        },
                        {
                            "text": "Le paysan <w>paissait</w> son troupeau près de la rivière pour profiter de l'herbe fraîche."
                        }
                    ],
                    "common_phrases": [
                        "mener paître",
                        "paître un troupeau"
                    ]
                },
                {
                    "sense_id": "e5689e45-2725-36fd-8479-2bff7c452420",
                    "sense_definition": "Guider spirituellement des fidèles ou diriger une communauté religieuse.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le curé du village <w>paissait</w> ses paroissiens avec une grande bienveillance."
                        },
                        {
                            "text": "Selon la tradition chrétienne, les évêques sont appelés à <w>paître</w> le peuple de Dieu."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "usage religieux ou métaphorique"
                        }
                    ]
                },
                {
                    "sense_id": "df30d446-7b60-3494-83eb-908d592308f3",
                    "sense_definition": "Donner à manger à un oiseau, particulièrement en fauconnerie.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le fauconnier <w>paissait</w> son oiseau de proie avant de commencer l'entraînement."
                        },
                        {
                            "text": "Il convient de <w>paître</w> le rapace avec de petits morceaux de viande fraîche."
                        }
                    ],
                    "traits": [
