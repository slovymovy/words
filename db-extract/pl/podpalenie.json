                "senses": [
                    {
                        "sense_id": "d7597c39-4a04-399b-a0bc-207d614f86dc",
                        "entry_id": "ff5aa5cc-0810-3c71-a084-483ca181ddd3",
                        "glosses": [
                            "umyślne podłożenie ognia mające na celu wywołanie pożaru"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "846aa8ee-d933-4eb6-a0a1-c1ecd3b68393",
                                "sense_id": "d7597c39-4a04-399b-a0bc-207d614f86dc",
                                "text": "Strażacy stwierdzili, że pożar lasu nie był efektem uderzenia pioruna, lecz celowego podpalenia."
                            },
                            {
                                "example_id": "1035c914-0f95-45ff-b622-a6839d782f1e",
                                "sense_id": "d7597c39-4a04-399b-a0bc-207d614f86dc",
                                "text": "Ubezpieczenia nieobejmujące podpaleń są nielegalne."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af6efe6b-7468-492e-8eed-c2c17c8ff340",
                        "source_entry_id": "ff5aa5cc-0810-3c71-a084-483ca181ddd3",
                        "source_sense_id": "d7597c39-4a04-399b-a0bc-207d614f86dc",
                        "target_lang_word": "arson",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arson",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ebcb2f9-c767-3489-a596-72ff7a7e02d5",
                                        "entry_id": "d9e71e55-8dd7-3502-9c12-1ddbfb323ca7",
                                        "glosses": [
                                            "The crime of deliberately starting a fire with intent to cause damage."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72423184-2558-4399-89c4-4a8d22707646",
                                                "sense_id": "5ebcb2f9-c767-3489-a596-72ff7a7e02d5",
                                                "text": "Arson, like we thought. three punks doused a car, lit it, and took off."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "arson",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "418b7798-1961-31a8-850f-a63bb97412c0",
                                        "entry_id": "9db13fc2-f8c3-3beb-9059-0376626a2f44",
                                        "glosses": [
                                            "To illegally set fire to; to burn down in a criminal manner."
                                        ],
                                        "tags": [
                                            "India",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "arson",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b260361b-477c-36d0-b4a2-666d95274fa3",
                                        "entry_id": "c6c54735-d317-3ca9-a7ab-750f31d11331",
                                        "glosses": [
                                            "A saddlebow."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82b12fa3-03b7-494c-84b6-f2a83600500d",
                                                "sense_id": "b260361b-477c-36d0-b4a2-666d95274fa3",
                                                "text": "The kyng of Englande mounted on a freſhe courſer, the trapper of clothe of golde, of Tiſſue, the Arſon mantell wiſe[…]"
                                            },
                                            {
                                                "example_id": "96cf1d5f-c77c-46c9-88df-8edef1342766",
                                                "sense_id": "b260361b-477c-36d0-b4a2-666d95274fa3",
                                                "text": "Arcione, the arſon or ſaddle bowe."
                                            },
                                            {
                                                "example_id": "4cc256a9-0b16-4395-a99e-65a70ee73263",
                                                "sense_id": "b260361b-477c-36d0-b4a2-666d95274fa3",
                                                "text": "[…]And putting vp good ſtore of gold and Iewels for that iourney, and taking with him a good horſe, that was browne Bay, with a Petronell hanging at the arſon of his Saddle[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40173838-6624-4700-a560-21b9caac90d8",
                        "source_entry_id": "ff5aa5cc-0810-3c71-a084-483ca181ddd3",
                        "source_sense_id": "d7597c39-4a04-399b-a0bc-207d614f86dc",
                        "target_lang_word": "incendio provocado",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "625c4699-048a-4afa-a557-87605336b991",
                        "source_entry_id": "ff5aa5cc-0810-3c71-a084-483ca181ddd3",
                        "source_sense_id": "d7597c39-4a04-399b-a0bc-207d614f86dc",
                        "target_lang_word": "Brandstiftung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brandstiftung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "342e8690-abfc-3e06-9fd3-acef9fef7624",
                                        "entry_id": "e8745533-8555-3403-84f4-05adab643cea",
                                        "glosses": [
                                            "vorsätzliches oder fahrlässiges Inbrandsetzen einer fremden Sache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d601f758-73d7-4d22-83ba-4bb527c8bb03",
                                                "sense_id": "342e8690-abfc-3e06-9fd3-acef9fef7624",
                                                "text": "Das Gebäude fiel einer Brandstiftung zum Opfer."
                                            },
                                            {
                                                "example_id": "0fd6a0cb-ad6d-4350-9eee-cd4c797df4b0",
                                                "sense_id": "342e8690-abfc-3e06-9fd3-acef9fef7624",
                                                "text": "Als Ursache für den Scheunenbrand wird Brandstiftung vermutet."
                                            },
                                            {
                                                "example_id": "c6900936-9956-4df3-8d58-f5abb8b44d2c",
                                                "sense_id": "342e8690-abfc-3e06-9fd3-acef9fef7624",
                                                "text": "„Den Vorwurf der Brandstiftung lässt er fallen, aber Hennis Drohung gegen Schwester Angelika kurz vor der Tat, die Zeugenaussage der Frau und vor allem ihr Schweigen führt er wieder und wieder an.“"
                                            },
                                            {
                                                "example_id": "3f57d60e-7d0d-40e1-9c0f-8ecf2cdffcb1",
                                                "sense_id": "342e8690-abfc-3e06-9fd3-acef9fef7624",
                                                "text": "„Wenn auch Brandstiftungen vorgekommen sein sollten – was aber durchaus zweifelhaft ist, weil niemand einen Grund zu Brandstiftungen hatte, sondern sich damit nur selbst Scherereien und Gefahren ausgesetzt hätte – so kann man doch in diesen Brandstiftungen niemals den Grund für den Brand Moskaus suchen, der auch ohne sie genau so hätte vor sich gehen müssen.“"
                                            },
                                            {
                                                "example_id": "fb40f731-e9ed-4e14-8e4a-950732da0c2a",
                                                "sense_id": "342e8690-abfc-3e06-9fd3-acef9fef7624",
                                                "text": "„Aber entweder gab es in Eyrarbakki kein Feuer aufzutreiben, oder der Junker verstand sich nicht auf Brandstiftung, denn das Haus blieb stehen.“"
                                            },
                                            {
                                                "example_id": "fe97c95e-af1b-4bd3-b801-12863e045ec2",
                                                "sense_id": "342e8690-abfc-3e06-9fd3-acef9fef7624",
                                                "text": "„Die Plünderungen und die Brandstiftungen, das gezielte und viel zu oft beiläufige Morden, die Massenvergewaltigungen, all das erlebte der Arzt aus nächster Nähe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
