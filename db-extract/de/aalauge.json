                        "examples": [
                            {
                                "example_id": "a3a3f269-a64d-4643-a24a-a1fa1d429e9c",
                                "sense_id": "aa8e5cd3-5197-3b93-ae43-6f0d457b0ca6",
                                "text": "„Aschfarbene Kinder, durch die Düsternis hüpfend. Winter, graue Jahreszeit im rußig wogenden Nebel, der wie ein biblischer Fluch über der Stadt hängt, ein freudloses Element, in dem die Landschaft verschleiert daliegt wie Atlantis auf dem lichtlosen Meeresgrund, trübe durch Aalaugen gesehen.“"
                            }
                        ],
