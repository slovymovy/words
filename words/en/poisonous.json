{
    "word_family": [
        "poison",
        "poisoner",
        "poisoning",
        "poisonously",
        "poisonousness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "878557e2-7373-3511-8a8b-56cfa1f28b38",
                    "sense_definition": "Containing substances that are harmful or life-threatening if touched or swallowed.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "toxic_substances",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many people do not realize that some common garden plants are actually <w>poisonous</w> to pets.",
                            "target_lang_translations": {
                                "ru": "Многие люди не осознают, что некоторые обычные садовые растения на самом деле <w>ядовиты</w> для домашних животных."
                            }
                        },
                        {
                            "text": "You must be careful when foraging because a <w>poisonous</w> mushroom can look very similar to an edible one.",
                            "target_lang_translations": {
                                "ru": "Нужно быть осторожным при сборе грибов, потому что <w>ядовитый</w> гриб может выглядеть очень похоже на съедобный."
                            }
                        }
                    ],
                    "synonyms": [
                        "toxic"
                    ],
                    "antonyms": [
                        "nonpoisonous",
                        "unpoisonous"
                    ],
                    "common_phrases": [
                        "poisonous mushroom",
                        "highly poisonous",
                        "poisonous plant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Содержащий вещества, которые вредны или опасны для жизни при прикосновении или проглатывании."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ядовитый",
                                "target_lang_sense_clarification": "содержащий яд"
                            },
                            {
                                "target_lang_word": "токсичный",
                                "target_lang_sense_clarification": "вредный для организма"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58055e40-2594-3e7f-a57a-2189fc5926d2",
                    "sense_definition": "Describing animals that produce toxins, or the bites and stings used to inject them.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "toxic_substances",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hikers were warned to watch out for <w>poisonous</w> snakes hiding under the rocks.",
                            "target_lang_translations": {
                                "ru": "Туристов предупредили, чтобы они остерегались <w>ядовитых</w> змей, прячущихся под камнями."
                            }
                        },
                        {
                            "text": "A <w>poisonous</w> bite from that specific spider requires immediate medical attention at a hospital.",
                            "target_lang_translations": {
                                "ru": "<w>Ядовитый</w> укус этого конкретного паука требует немедленной медицинской помощи в больнице."
                            }
                        }
                    ],
                    "synonyms": [
                        "venomous"
                    ],
                    "antonyms": [
                        "nonpoisonous"
                    ],
                    "common_phrases": [
                        "poisonous snake",
                        "poisonous spider",
                        "poisonous bite"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывает животных, вырабатывающих токсины, а также укусы и жала, используемые для их введения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ядовитый",
                                "target_lang_sense_clarification": "о животных или их укусах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54bb90bd-2215-3067-94ca-41aca55ad6fb",
                    "sense_definition": "Extremely unpleasant, harmful, or destructive to a person's feelings or a situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "harmful_influence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The office became a difficult place to work due to the <w>poisonous</w> atmosphere created by the management.",
                            "target_lang_translations": {
                                "ru": "Офис стал тяжелым местом для работы из-за <w>токсичной</w> атмосферы, созданной руководством."
                            }
                        },
                        {
                            "text": "He realized that his <w>poisonous</w> attitude was pushing away his closest friends and family.",
                            "target_lang_translations": {
                                "ru": "Он понял, что его <w>ядовитое</w> отношение отталкивает его самых близких друзей и семью."
                            }
                        }
                    ],
                    "synonyms": [
                        "toxic"
                    ],
                    "common_phrases": [
                        "poisonous atmosphere",
                        "poisonous attitude",
                        "poisonous relationship"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крайне неприятный, вредный или разрушительный для чувств человека или ситуации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "токсичный",
                                "target_lang_sense_clarification": "об атмосфере или отношениях"
                            },
                            {
                                "target_lang_word": "ядовитый",
                                "target_lang_sense_clarification": "о словах или отношении"
                            },
                            {
                                "target_lang_word": "пагубный",
                                "target_lang_sense_clarification": "разрушительный"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}