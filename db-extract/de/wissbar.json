                    }
                ],
                "senses": [
                    {
                        "sense_id": "9e7001be-e531-39e3-84ae-379af60497ac",
                        "entry_id": "3ed7f0c2-db07-3345-9610-f2f92e05c5bb",
                        "glosses": [
                            "so, dass es gekannt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e90e88c-774c-4742-8be2-3524bcf4619b",
                                "sense_id": "9e7001be-e531-39e3-84ae-379af60497ac",
                                "text": "„»Stets habe ich alles, was in der Welt wissbar ist, zu wissen begehrt«, schrieb Trithemius über sich selbst.“"
                            },
                            {
                                "example_id": "82207210-a9db-4479-ad9f-190e0ad4e5f1",
                                "sense_id": "9e7001be-e531-39e3-84ae-379af60497ac",
                                "text": "„Das Abstellen auf das »Wissen« – sei es nun subjektiv gewusst oder objektiv wissbar etc. – hantiert mit falschen Begriffen.“"
                            },
                            {
                                "example_id": "a1f3d379-dd42-4ff6-939d-a4a5ab8cd2ed",
                                "sense_id": "9e7001be-e531-39e3-84ae-379af60497ac",
                                "text": "„An einer anderen Stelle seines Interviews offenbart Precht Widersprüchlichkeit; als er sich aus der Unwissenheit über die Existenz eines Gottes zum Agnostiker bekennt, übersieht er, dass Gott definitionsgemäß nie wissbar, sondern nur glaubbar sein kann.“"
                            },
                            {
                                "example_id": "4d12f391-be2b-4aab-964b-4e42cb741427",
                                "sense_id": "9e7001be-e531-39e3-84ae-379af60497ac",
                                "text": "„Nicht nur kritische und emanzipierende Forschung soll dadurch angeregt, sondern auch herausgestellt werden, wie vielfältige Lebensweisen erfahrbar, sagbar, wissbar und vermittelbar gestaltet werden können.“"
                            },
                            {
                                "example_id": "024ece24-331d-4373-90e2-9a9ad24328a3",
                                "sense_id": "9e7001be-e531-39e3-84ae-379af60497ac",
                                "text": "„Wir sind davon überzeugt, dass künftige makroökonomische Entwicklungen – um Buffetts Terminologie zu verwenden – nicht wissbar sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
