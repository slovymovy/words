                        "entry_id": "ffeb45e1-67d2-33f1-b600-33cbaeafeeb6",
                        "glosses": [
                            "Form des Theaters, bei der eine Geschichte erzählt wird, indem Schatten auf eine beleuchtete Fläche geworfen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f64a3bd3-c4ee-431a-8ace-772f42195fd4",
                                "sense_id": "36de6905-ad7d-31b1-8fff-023baa8f5c4e",
                                "text": "„Das hier war nicht die eigentliche Bühne, sondern nur ein Schattentheater.“"
                            },
                            {
                                "example_id": "471a95b3-d697-4f65-8f05-06630151fa12",
                                "sense_id": "36de6905-ad7d-31b1-8fff-023baa8f5c4e",
                                "text": "„Erneut gleichen sich die Lebensläufte Locatellis und Pannunzis wie in einem Spiel mit Spiegeln oder einem chinesischen Schattentheater.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
