                                        "sense_id": "4458e6ac-216f-39cd-9e89-57604b878aa0",
                                        "entry_id": "8bc93d1b-1588-3a57-9c67-327b931f73e1",
                                        "glosses": [
                                            "Thinking beforehand or in advance, planning; prior or previous consideration; premeditation."
                                        ],
                                        "tags": [
