{
    "word_family": [
        "spuriously",
        "spuriousness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8e5a77a0-d111-3655-9a65-f7eb4e8764f7",
                    "sense_definition": "Not being what it purports to be; false or fake.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "authenticity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician's argument was <w>spurious</w> and had no logical validity during the debate.",
                            "target_lang_translations": {
                                "ru": "Аргумент политика был <w>ложным</w> и не имел логической обоснованности в ходе дебатов."
                            }
                        },
                        {
                            "text": "She was forced to defend herself against <w>spurious</w> claims that were clearly intended to damage her reputation.",
                            "target_lang_translations": {
                                "ru": "Она была вынуждена защищаться от <w>надуманных</w> обвинений, которые явно имели целью нанести ущерб ее репутации."
                            }
                        }
                    ],
                    "synonyms": [
                        "counterfeit",
                        "fake",
                        "false",
                        "bogus"
                    ],
                    "antonyms": [
                        "genuine"
                    ],
                    "common_phrases": [
                        "spurious claims",
                        "spurious argument",
                        "spurious correlation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не являющийся тем, за что себя выдает; ложный, поддельный или фиктивный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ложный",
                                "target_lang_sense_clarification": "не соответствующий истине"
                            },
                            {
                                "target_lang_word": "поддельный",
                                "target_lang_sense_clarification": "имитирующий подлинность"
                            },
                            {
                                "target_lang_word": "фальшивый",
                                "target_lang_sense_clarification": "неискренний или искусственный"
                            },
                            {
                                "target_lang_word": "надуманный",
                                "target_lang_sense_clarification": "лишенный логических оснований"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21b86f87-b604-3b6c-a3aa-6e2e131f00aa",
                    "sense_definition": "Occurring accidentally or without intent; extraneous or stray.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "relevance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer worked to eliminate <w>spurious</w> emissions from the wireless mast that were causing interference.",
                            "target_lang_translations": {
                                "ru": "Инженер работал над устранением <w>паразитных</w> излучений от беспроводной мачты, которые вызывали помехи."
                            }
                        },
                        {
                            "text": "I tried to concentrate on the task, but <w>spurious</w> thoughts kept intruding on my focus.",
                            "target_lang_translations": {
                                "ru": "Я пытался сосредоточиться на задаче, но <w>посторонние</w> мысли постоянно отвлекали меня."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spurious emissions",
                        "spurious signals"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возникающий случайно или без намерения; посторонний, побочный или паразитный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "паразитный",
                                "target_lang_sense_clarification": "о сигналах или излучениях"
                            },
                            {
                                "target_lang_word": "посторонний",
                                "target_lang_sense_clarification": "мешающий или лишний"
                            },
                            {
                                "target_lang_word": "побочный",
                                "target_lang_sense_clarification": "второстепенный и нежелательный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9568d034-fe28-34bf-8945-79151d1f37b6",
                    "sense_definition": "Born out of wedlock; illegitimate.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "birth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old novel, the protagonist discovers he is the <w>spurious</w> son of a local nobleman.",
                            "target_lang_translations": {
                                "ru": "В старом романе главный герой узнает, что он — <w>незаконнорожденный</w> сын местного дворянина."
                            }
                        },
                        {
                            "text": "The historical document mentions a <w>spurious</w> heir who was denied his inheritance by the court.",
                            "target_lang_translations": {
                                "ru": "В историческом документе упоминается <w>внебрачный</w> наследник, которому суд отказал в наследстве."
                            }
                        }
                    ],
                    "common_phrases": [
                        "spurious offspring"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in historical or literary contexts regarding birth"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Рожденный вне брака; незаконнорожденный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "незаконнорожденный",
                                "target_lang_sense_clarification": "устаревший термин о происхождении"
                            },
                            {
                                "target_lang_word": "внебрачный",
                                "target_lang_sense_clarification": "о ребенке, рожденном вне брака"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}