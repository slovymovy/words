{
    "word_family": [
        "meagerness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3793c3e8-5934-3a1a-97bc-6920c57c926b",
                    "sense_definition": "Deficient or inferior in amount, quality, or extent.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "small_amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nothing will grow in this <w>meagre</w> soil.",
                            "target_lang_translations": {
                                "nl": "Niets zal groeien in deze <w>schamele</w> bodem."
                            }
                        },
                        {
                            "text": "He was given a <w>meagre</w> piece of cake that he swallowed in one bite.",
                            "target_lang_translations": {
                                "nl": "Hij kreeg een <w>karig</w> stukje taart dat hij in één hap doorslikte."
                            }
                        }
                    ],
                    "synonyms": [
                        "paltry",
                        "scanty",
                        "inadequate"
                    ],
                    "common_phrases": [
                        "meagre amount",
                        "meagre supply"
                    ],
                    "target_lang_definitions": {
                        "nl": "Tekortschietend of ondermaats in hoeveelheid, kwaliteit of omvang."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "schamel",
                                "target_lang_sense_clarification": "vaak gebruikt voor een gebrek aan middelen of een kleine hoeveelheid"
                            },
                            {
                                "target_lang_word": "karig",
                                "target_lang_sense_clarification": "duidt op een onvoldoende of zuinige hoeveelheid"
                            },
                            {
                                "target_lang_word": "beperkt",
                                "target_lang_sense_clarification": "algemene term voor een kleine omvang of hoeveelheid"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed3f4cf3-ef5a-3cb6-b7a2-3396c65dd2a9",
                    "sense_definition": "Having little flesh; lean or thin.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>meagre</w> man looked as if he had not eaten for days.",
                            "target_lang_translations": {
                                "nl": "De <w>magere</w> man zag eruit alsof hij dagenlang niet had gegeten."
                            }
                        },
                        {
                            "text": "His <w>meagre</w> frame could barely support the heavy winter coat.",
                            "target_lang_translations": {
                                "nl": "Zijn <w>tengere</w> gestalte kon de zware winterjas nauwelijks dragen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Weinig vlees aan het lichaam hebbend; mager of dun."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "mager",
                                "target_lang_sense_clarification": "algemene term voor iemand met weinig lichaamsvet"
                            },
                            {
                                "target_lang_word": "tenger",
                                "target_lang_sense_clarification": "duidt op een slank en fragiel postuur"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "63bbf0e0-f39c-35a4-b271-ac15602998b7",
                    "sense_definition": "An edible fish of the species Argyrosomus regius.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>meagre</w> is a large fish found in the eastern Atlantic.",
                            "target_lang_translations": {
                                "nl": "De <w>ombervis</w> is een grote vis die in de oostelijke Atlantische Oceaan voorkomt."
                            }
                        },
                        {
                            "text": "Local fishermen caught several large <w>meagres</w> near the coast.",
                            "target_lang_translations": {
                                "nl": "Lokale vissers vingen verschillende grote <w>ombervissen</w> bij de kust."
                            }
                        }
                    ],
                    "synonyms": [
                        "salmon-basse",
                        "shadefish",
                        "stone basse"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een eetbare vis van de soort Argyrosomus regius."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "ombervis",
                                "target_lang_sense_clarification": "de specifieke Nederlandse naam voor de vissoort Argyrosomus regius"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b701978e-d1dd-328c-af8e-1d7420f55057",
                    "sense_definition": "To make lean or thin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The long illness began to <w>meagre</w> his once strong body.",
                            "target_lang_translations": {
                                "nl": "De langdurige ziekte begon zijn eens zo sterke lichaam te <w>doen vermageren</w>."
                            }
                        },
                        {
                            "text": "Hard labor and lack of food <w>meagred</w> the prisoners.",
                            "target_lang_translations": {
                                "nl": "Zware arbeid en gebrek aan voedsel <w>mergelden</w> de gevangenen <w>uit</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This verb is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Mager of dun maken."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "doen vermageren",
                                "target_lang_sense_clarification": "iemand gewicht laten verliezen"
                            },
                            {
                                "target_lang_word": "uitmergelen",
                                "target_lang_sense_clarification": "iemand extreem mager of zwak maken door ontbering"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}