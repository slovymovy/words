                        "glosses": [
                            "Activité d’élaboration, de fabrication et de commercialisation de ce type de produits."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9f1eb9c-7fef-43fc-9fac-d5a33cf37c50",
                                "sense_id": "0c96a8f1-a1fc-34ae-ba46-d2ff4b1cdb5b",
                                "text": "Aujourd’hui, 55 % de l’activité du groupe Pierre Fabre est générée par la dermo-cosmétique contre 45 % dans le médicament."
                            },
                            {
                                "example_id": "258dd588-79cc-49ed-be5a-449335da503f",
                                "sense_id": "0c96a8f1-a1fc-34ae-ba46-d2ff4b1cdb5b",
                                "text": "Dans son livre « Hold-up sur la terre » (éditions Seuil), la journaliste Lucile Leclair a enquêté sur le rachat des terres par de grandes firmes, principalement du secteur agroalimentaire et de la dermo-cosmétique."
                            },
                            {
                                "example_id": "2e64603f-b8a1-4e40-999b-112b0f511467",
                                "sense_id": "0c96a8f1-a1fc-34ae-ba46-d2ff4b1cdb5b",
                                "text": "Vous pouvez donc obtenir un CQP conseiller en dermo-cosmétique qui concerne principalement les conseils en soins et en beauté."
                            }
                        ]
                    }
