                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "c27081ca-e894-434e-b384-4f2091a90c96",
                                "sense_id": "1187f910-e6a0-316e-8553-6a23fff344d4",
                                "text": "The community is Southernly polite to newcomers. They'll engage a new face in conversation in the synagogue, which doesn't usually happen elsewhere."
                            },
                            {
                                "example_id": "cbf3221c-38c4-4ec4-be4e-c3c8fe3fecea",
                                "sense_id": "1187f910-e6a0-316e-8553-6a23fff344d4",
                                "text": "[…] and the imposing images of her pioneer, but now diabetic and near-blind father, Furman Temple (Ralph Waite) and her Southernly genteel theatrical mother, […]"
                            },
                            {
                                "example_id": "208133be-b4c2-4885-84e1-0254160d6204",
                                "sense_id": "1187f910-e6a0-316e-8553-6a23fff344d4",
                                "text": "The Southerners later convened in Birmingham to organize the States' Rights party, selecting Senator Strom Thurmond […] It wasn't a Southernly reception."
                            }
                        ]
                    }
