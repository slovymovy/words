                        "avoir l'air contrarié"
                    ]
                },
                {
                    "sense_id": "23da1904-0890-3d89-b0e6-5f28c28976be",
                    "sense_definition": "Gêner, entraver ou empêcher le bon déroulement d'une action ou d'un projet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obstacle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les intempéries sont venues <w>contrarier</w> les travaux prévus sur le pont."
                        },
                        {
                            "text": "Une blessure soudaine a fini par <w>contrarier</w> ses projets pour la saison sportive."
                        }
                    ],
                    "common_phrases": [
                        "contrarier les plans",
                        "contrarier des projets"
                    ]
                },
                {
                    "sense_id": "b0e35115-f1cc-3597-8b24-7e686ffe57c9",
                    "sense_definition": "S'opposer volontairement à quelqu'un par des paroles contradictoires ou des actes contraires.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il passe son temps à <w>contrarier</w> sa sœur sur chaque sujet abordé."
                        },
                        {
                            "text": "Pourquoi cherches-tu toujours à me <w>contrarier</w> quand nous sommes en public ?"
                        }
                    ],
                    "common_phrases": [
                        "aimer contrarier",
                        "chercher à contrarier"
                    ]
                },
                {
                    "sense_id": "6a4be702-ec6b-3322-a502-d1ee0e1f0df7",
                    "sense_definition": "En art ou en décoration, marier des couleurs ou des motifs en les opposant pour créer un contraste.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "opposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le peintre a choisi de <w>contrarier</w> les teintes chaudes avec un bleu profond."
                        },
                        {
                            "text": "Il faut savoir <w>contrarier</w> les motifs pour dynamiser l'espace d'une pièce."
                        }
                    ],
                    "common_phrases": [
