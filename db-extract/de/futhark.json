                ],
                "senses": [
                    {
                        "sense_id": "11e7ba78-4947-3bc6-b912-0a0aa0eef88a",
                        "entry_id": "56271655-d1e7-309e-8bf6-d745222c5be7",
                        "glosses": [
                            "Bezeichnung für das Alphabet, das aus den germanischen Runen besteht. Die ersten Schriftzeichen des Runenalphabets stehen für \\\"f\\\", \\\"u\\\", \\\"th\\\", \\\"a\\\", \\\"r\\\" und \\\"k\\\"; daher heißen diese Runenalphabete auch Futhark."
                        ],
                        "tags": [
                            "Germanistik"
                        ],
                        "examples": [
                            {
                                "example_id": "2a2ce4b2-4d0b-46a6-af5c-c5639cd0ae16",
                                "sense_id": "11e7ba78-4947-3bc6-b912-0a0aa0eef88a",
                                "text": "Es gab mehrere verschiedene Futharke."
                            },
                            {
                                "example_id": "dbea21b4-d1e8-416e-889c-f06a50f981a9",
                                "sense_id": "11e7ba78-4947-3bc6-b912-0a0aa0eef88a",
                                "text": "Auf Runensteinen findet man Inschriften, die mit den Schriftzeichen des Futharks geschrieben sind."
                            },
                            {
                                "example_id": "0640fc23-4f91-4ed5-9171-8c8012e5dba5",
                                "sense_id": "11e7ba78-4947-3bc6-b912-0a0aa0eef88a",
                                "text": "„Das ältere Futhark ist uns authentisch auf einigen Runendenkmälern des 5. und 6. Jahrhunderts überliefert.“"
                            },
                            {
                                "example_id": "1d588bfd-be71-40f9-966b-7bad9b1d92a2",
                                "sense_id": "11e7ba78-4947-3bc6-b912-0a0aa0eef88a",
                                "text": "„Die eingangs wiedergegebenen Runenzeichen des älteren Futhark stellen eine Idealform dar.“"
                            },
                            {
                                "example_id": "515d2f5d-f072-40e7-be1e-4c02795c4361",
                                "sense_id": "11e7ba78-4947-3bc6-b912-0a0aa0eef88a",
                                "text": "„Auf einigen Medaillons ist das gesamte Futhark eingeprägt, das Runen-Alphabet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
