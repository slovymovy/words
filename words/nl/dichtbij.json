                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet het schilderij van <w>dichtbij</w> bekijken om de details te zien.",
                            "target_lang_translations": {
                                "en": "You have to look at the painting from <w>up close</w> to see the details.",
                                "ru": "Тебе нужно рассмотреть картину <w>вблизи</w>, чтобы увидеть детали.",
                                "pl": "Musisz przyjrzeć się obrazowi <w>z bliska</w>, aby zobaczyć szczegóły.",
                                "de": "Man muss das Gemälde aus der <w>Nähe</w> betrachten, um die Details zu sehen.",
                                "fr": "Il faut regarder le tableau <w>de près</w> pour voir les détails.",
                                "it": "Devi guardare il quadro <w>da vicino</w> per vederne i dettagli.",
                                "cs": "Musíš se na ten obraz podívat <w>zblízka</w>, abys viděl detaily.",
                                "tr": "Detayları görmek için tabloya <w>yakından</w> bakmalısın.",
                                "es": "Tienes que mirar el cuadro <w>de cerca</w> para ver los detalles."
                            }
                        },
                        {
                            "text": "Toen we <w>dichtbij</w> kwamen, zagen we pas hoe groot het huis was.",
                            "target_lang_translations": {
                                "en": "Only when we got <w>close</w> did we see how big the house was.",
                                "ru": "Когда мы подошли <w>близко</w>, мы увидели, какой большой этот дом.",
                                "pl": "Dopiero gdy podeszliśmy <w>blisko</w>, zobaczyliśmy, jak duży był ten dom.",
                                "de": "Erst als wir <w>näher</w> kamen, sahen wir, wie groß das Haus war.",
                                "fr": "Ce n'est que lorsque nous nous sommes <w>approchés</w> que nous avons vu à quel point la maison était grande.",
                                "it": "Solo quando ci siamo avvicinati <w>vicino</w>, abbiamo visto quanto fosse grande la casa.",
                                "cs": "Teprve když jsme přišli <w>blízko</w>, uviděli jsme, jak velký ten dům byl.",
                                "tr": "Ancak <w>yaklaştığımızda</w> evin ne kadar büyük olduğunu gördük.",
                                "es": "Solo cuando nos acercamos <w>mucho</w> vimos lo grande que era la casa."
                            }
                        }
