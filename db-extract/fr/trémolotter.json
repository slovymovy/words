                "senses": [
                    {
                        "sense_id": "411503d9-3803-32f1-ae00-fa4d5da2ff3b",
                        "entry_id": "77194a72-e14d-305e-96a0-65ce38d3ffef",
                        "glosses": [
                            "Exprimer avec des trémolos dans la voix."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d1d6bbb-7386-4bea-92e9-d3bb38ecc591",
                                "sense_id": "411503d9-3803-32f1-ae00-fa4d5da2ff3b",
                                "text": "Je trémolotte, inquiet cette fois : — Elle… enfin… l’autre ? elle n’est pas Marinette ?"
                            },
                            {
                                "example_id": "3cd2fc75-8a3e-41ce-b159-c374ebf84b96",
                                "sense_id": "411503d9-3803-32f1-ae00-fa4d5da2ff3b",
                                "text": "Il enclenche le Cl 8 du juke-box : Do’nt cry Baby, trémolotte Elvis."
                            },
                            {
                                "example_id": "5d15508b-d263-46b1-8a41-a17f62e75782",
                                "sense_id": "411503d9-3803-32f1-ae00-fa4d5da2ff3b",
                                "text": "Un an avant, tandis que la France métissée de Zidane gagnait la Coupe du monde », trémolottait Jeune Afrique lors de son élection en février 2016, « elle embrassait les couleurs tricolores en devenant française. »"
                            },
                            {
                                "example_id": "9966f5c6-4272-41a8-9936-a236c4702f9c",
                                "sense_id": "411503d9-3803-32f1-ae00-fa4d5da2ff3b",
                                "text": "J'en ai la rétine en guirlande de Noël et l'âme qui trémolotte “Freude Schöner Götterfunken”."
                            }
                        ]
                    }
