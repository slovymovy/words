                "senses": [
                    {
                        "sense_id": "9dbe9e63-0d9a-33ff-a25e-2395f6578740",
                        "entry_id": "5c5d3c3d-ce50-3d6d-8c93-9587e066c6fb",
                        "glosses": [
                            "Bahnhof, der im Süden von etwas (einer Stadt, Land oder dergleichen) liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f18a7b4f-73f4-4c7d-b4da-ad7f73d80974",
                                "sense_id": "9dbe9e63-0d9a-33ff-a25e-2395f6578740",
                                "text": "„Ich musste also quer durch Paris zum Südbahnhof.“"
                            },
                            {
                                "example_id": "0861dd49-1a58-40f7-92ee-94ee88f02510",
                                "sense_id": "9dbe9e63-0d9a-33ff-a25e-2395f6578740",
                                "text": "„Der einst prächtige alte Wiener Südbahnhof wurde nach dem Krieg durch einen gesichtslosen Neubau ersetzt.“"
                            },
                            {
                                "example_id": "77173e1c-f14a-46e8-9e4a-e9eecaa4e60b",
                                "sense_id": "9dbe9e63-0d9a-33ff-a25e-2395f6578740",
                                "text": "„Als 1915 die Verbindung zwischen dem Südbahnhof und dem Nord/Ost-Bahnhof in Westerland fertiggestellt wurde, bestand nun eine Verbindung zwischen dem im Süden gelegene Hörnum und dem im Norden gelegene List.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
