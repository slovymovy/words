{
    "word_family": [
        "fail",
        "failing",
        "unfailing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a7629cfe-1cfb-3559-9594-d8294d2d9bec",
                    "sense_definition": "The state or condition of not meeting a desirable or intended objective.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project was doomed to <w>failure</w> from the very beginning due to poor planning.",
                            "target_lang_translations": {
                                "ru": "Проект был обречен на <w>провал</w> с самого начала из-за плохого планирования.",
                                "zh": "由于规划不善，该项目从一开始就注定要<w>失败</w>。"
                            }
                        },
                        {
                            "text": "Her <w>failure</w> to win the gold medal was a huge disappointment to the team.",
                            "target_lang_translations": {
                                "ru": "Ее <w>неудача</w> в завоевании золотой медали стала огромным разочарованием для команды.",
                                "zh": "她没能赢得金牌，这让整个团队感到非常失望。"
                            }
                        }
                    ],
                    "antonyms": [
                        "success",
                        "triumph"
                    ],
                    "common_phrases": [
                        "fear of failure",
                        "doomed to failure",
                        "sense of failure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние или условие недостижения желаемой или намеченной цели.",
                        "zh": "未能达到预期或理想目标的状况。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неуда́ча",
                                "target_lang_sense_clarification": "отсутствие успеха, неблагоприятный исход дела"
                            },
                            {
                                "target_lang_word": "прова́л",
                                "target_lang_sense_clarification": "полная неудача, крушение планов или надежд"
                            },
                            {
                                "target_lang_word": "крах",
                                "target_lang_sense_clarification": "катастрофическая неудача, гибель начинания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "失败",
                                "target_lang_sense_clarification": "未能成功，未达到目的"
                            },
                            {
                                "target_lang_word": "挫败",
                                "target_lang_sense_clarification": "遭遇失败或受挫"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d0a0533-2b6a-3108-b571-cca7c9cc369e",
                    "sense_definition": "The termination of the ability of an item, system, or business to perform its required function.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot made an emergency landing due to sudden engine <w>failure</w>.",
                            "target_lang_translations": {
                                "ru": "Пилот совершил аварийную посадку из-за внезапного <w>отказа</w> двигателя.",
                                "zh": "由于发动机突然<w>故障</w>，飞行员进行了紧急迫降。"
                            }
                        },
                        {
                            "text": "A massive power <w>failure</w> left the entire city in darkness for several hours.",
                            "target_lang_translations": {
                                "ru": "Масштабный <w>сбой</w> в электросети оставил весь город в темноте на несколько часов.",
                                "zh": "大规模的电力<w>故障</w>导致整座城市陷入了数小时的黑暗。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "power failure",
                        "engine failure",
                        "system failure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прекращение способности предмета, системы или предприятия выполнять свою требуемую функцию.",
                        "zh": "物品、系统或业务无法执行其所需功能的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отка́з",
                                "target_lang_sense_clarification": "прекращение работы механизма или устройства"
                            },
                            {
                                "target_lang_word": "сбой",
                                "target_lang_sense_clarification": "нарушение нормального хода работы системы"
                            },
                            {
                                "target_lang_word": "поло́мка",
                                "target_lang_sense_clarification": "повреждение механизма, делающее его неработоспособным"
                            },
                            {
                                "target_lang_word": "вы́ход из стро́я",
                                "target_lang_sense_clarification": "потеря работоспособности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "故障",
                                "target_lang_sense_clarification": "机器或系统运行不正常"
                            },
                            {
                                "target_lang_word": "失效",
                                "target_lang_sense_clarification": "失去效用或停止工作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5816cc6e-7eb4-3740-8f73-050f812c789e",
                    "sense_definition": "A person or thing that has failed to achieve success.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After losing his job, he started to feel like a complete <w>failure</w>.",
                            "target_lang_translations": {
                                "ru": "Потеряв работу, он начал чувствовать себя полным <w>неудачником</w>.",
                                "zh": "失业后，他开始觉得自己是个彻底的<w>失败者</w>。"
                            }
                        },
                        {
                            "text": "The new restaurant was a <w>failure</w> and had to close within three months.",
                            "target_lang_translations": {
                                "ru": "Новый ресторан оказался <w>провалом</w> и был вынужден закрыться через три месяца.",
                                "zh": "这家新餐馆经营<w>失败</w>，不到三个月就不得不关门了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "loser"
                    ],
                    "antonyms": [
                        "success"
                    ],
                    "common_phrases": [
                        "complete failure",
                        "total failure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или вещь, которые не смогли добиться успеха.",
                        "zh": "未能取得成功的人或事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неуда́чник",
                                "target_lang_sense_clarification": "о человеке, которого преследуют неудачи"
                            },
                            {
                                "target_lang_word": "прова́л",
                                "target_lang_sense_clarification": "о мероприятии, произведении или деле, закончившемся полной неудачей"
                            },
                            {
                                "target_lang_word": "фиа́ско",
                                "target_lang_sense_clarification": "полная неудача (обычно о выступлениях или планах)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "失败者",
                                "target_lang_sense_clarification": "指在竞争或生活中未获成功的人"
                            },
                            {
                                "target_lang_word": "失败之作",
                                "target_lang_sense_clarification": "指未获成功的事物或作品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ccd806ed-855f-354d-a89c-c30acb1d2c67",
                    "sense_definition": "The omission to do something that is expected or required.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>failure</w> to pay the fine resulted in a court summons.",
                            "target_lang_translations": {
                                "ru": "Его <w>неуплата</w> штрафа привела к вызову в суд.",
                                "zh": "他<w>未缴纳</w>罚款，导致收到了法院传票。"
                            }
                        },
                        {
                            "text": "The company was penalized for its <w>failure</w> to meet the new safety standards.",
                            "target_lang_translations": {
                                "ru": "Компания была оштрафована за <w>несоблюдение</w> новых стандартов безопасности.",
                                "zh": "该公司因<w>未达到</w>新的安全标准而受到处罚。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "failure to comply",
                        "failure to appear"
                    ],
                    "target_lang_definitions": {
                        "ru": "Невыполнение того, что ожидается или требуется.",
                        "zh": "未做预期或要求之事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "невыполне́ние",
                                "target_lang_sense_clarification": "упущение, отсутствие требуемого действия"
                            },
                            {
                                "target_lang_word": "несоблюде́ние",
                                "target_lang_sense_clarification": "игнорирование правил, стандартов или обязательств"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "未履行",
                                "target_lang_sense_clarification": "没有完成应尽的义务或责任"
                            },
                            {
                                "target_lang_word": "不遵守",
                                "target_lang_sense_clarification": "未能按照规定或标准执行"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49070ad2-0599-3b05-b8fe-ca964a9bbf3a",
                    "sense_definition": "A condition in which a specified organ does not function well enough to support life.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient was diagnosed with chronic heart <w>failure</w> and needed immediate care.",
                            "target_lang_translations": {
                                "ru": "У пациента была диагностирована хроническая сердечная <w>недостаточность</w>, и он нуждался в немедленной помощи.",
                                "zh": "病人被诊断出患有慢性心力<w>衰竭</w>，需要立即接受治疗。"
                            }
                        },
                        {
                            "text": "Excessive alcohol consumption can eventually lead to liver <w>failure</w>.",
                            "target_lang_translations": {
                                "ru": "Чрезмерное употребление алкоголя может в конечном итоге привести к <w>отказу</w> печени.",
                                "zh": "长期过量饮酒最终可能导致肝<w>衰竭</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "heart failure",
                        "kidney failure",
                        "liver failure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние, при котором определенный орган функционирует недостаточно хорошо для поддержания жизни.",
                        "zh": "特定器官功能不足以维持生命的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "недоста́точность",
                                "target_lang_sense_clarification": "медицинский термин, обозначающий нарушение функции органа"
                            },
                            {
                                "target_lang_word": "отка́з",
                                "target_lang_sense_clarification": "полное прекращение работы органа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "衰竭",
                                "target_lang_sense_clarification": "器官功能严重减退或丧失"
                            },
                            {
                                "target_lang_word": "功能不全",
                                "target_lang_sense_clarification": "器官无法正常发挥其生理功能"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "85a6d2b5-d68b-3cc4-8678-43be2f65ef6f",
                    "sense_definition": "The state of being unable to pay debts; bankruptcy.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The economic recession caused the <w>failure</w> of many small businesses in the area.",
                            "target_lang_translations": {
                                "ru": "Экономический спад стал причиной <w>банкротства</w> многих малых предприятий в этом районе.",
                                "zh": "经济衰退导致该地区许多小企业<w>破产</w>。"
                            }
                        },
                        {
                            "text": "They faced financial <w>failure</w> after investing all their savings in the risky scheme.",
                            "target_lang_translations": {
                                "ru": "Они столкнулись с финансовым <w>крахом</w> после того, как вложили все свои сбережения в рискованную схему.",
                                "zh": "在将所有积蓄投入那个高风险项目后，他们面临<w>破产</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние неспособности платить долги; банкротство.",
                        "zh": "无力偿还债务的状态；破产。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "банкро́тство",
                                "target_lang_sense_clarification": "официально признанная финансовая несостоятельность"
                            },
                            {
                                "target_lang_word": "крах",
                                "target_lang_sense_clarification": "полное разорение, финансовая катастрофа"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "破产",
                                "target_lang_sense_clarification": "因无力偿债而倒闭"
                            },
                            {
                                "target_lang_word": "倒闭",
                                "target_lang_sense_clarification": "企业因经营不善而停止营业"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}