                "senses": [
                    {
                        "sense_id": "c91065bd-21d9-367e-bafc-aae193f8b2eb",
                        "entry_id": "3cacc9fa-ffb4-38dc-b004-7b6cee885c0c",
                        "glosses": [
                            "Any of several species of perennial herbs of the genus Symphytum, often specifically common comfrey (Symphytum officinale)."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "827a7bd3-4200-407e-a2ec-20d63b9c9f69",
                                "sense_id": "c91065bd-21d9-367e-bafc-aae193f8b2eb",
                                "text": "It thrives on compost and natural fertilizers brewed from comfrey or seaweed and uses only rain, natural groundwater or wastewater purified through a system of reed beds."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7adc979-d89a-48bf-b4f7-1f0c67cd61cd",
                        "source_entry_id": "3cacc9fa-ffb4-38dc-b004-7b6cee885c0c",
                        "source_sense_id": "c91065bd-21d9-367e-bafc-aae193f8b2eb",
                        "source_sense_description": "perennial herb",
                        "target_lang_word": "smeerwortel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "smeerwortel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0f50a40e-1c3d-3653-9c82-456470372b7d",
                                        "entry_id": "bf0be7cd-9018-3b17-9499-d257f4b45df5",
                                        "glosses": [
                                            "een geslacht Symphytum van planten uit de ruwbladigenfamilie (Boraginaceae). Het geslacht bevat overblijvende planten, meestal kruiden, geen struiken of bomen. De kelk is tot een kwart of geheel ingesneden. De bladeren zijn langwerpig tot lancetvormig en verspreid geplaatst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89fd74e7-611e-45c9-a15e-be311afc7d17",
                                                "sense_id": "0f50a40e-1c3d-3653-9c82-456470372b7d",
                                                "text": "Hij stond handenvol jonge munt en smeerwortel uit de overwoekerde grond te rukken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd4ad098-7c35-495c-a51d-c1eb845a3741",
                        "source_entry_id": "3cacc9fa-ffb4-38dc-b004-7b6cee885c0c",
                        "source_sense_id": "c91065bd-21d9-367e-bafc-aae193f8b2eb",
