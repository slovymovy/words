                "senses": [
                    {
                        "sense_id": "b4a05a77-5fd6-38df-a78f-e46760cce5d4",
                        "entry_id": "1e8687e7-774e-369a-9288-673e1dbaf91e",
                        "glosses": [
                            "een jongen die veel langs de straten zwerft en brutaal en baldadig is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e9861bf-7378-48b7-94f6-4e395b9dc15a",
                                "sense_id": "b4a05a77-5fd6-38df-a78f-e46760cce5d4",
                                "text": "In dit authentiek aandoende drama wil de straatjongen zich bewijzen als man des huizes. Dus steelt hij een auto, of koffers uit treinen. Want dat doe je nu eenmaal als je groot bent."
                            },
                            {
                                "example_id": "48ede29c-98b5-4989-8dc8-30a4a7956918",
                                "sense_id": "b4a05a77-5fd6-38df-a78f-e46760cce5d4",
                                "text": "Een celstraf ontlopen kost veel geld, dus schiet intussen ook haar vader te hulp, door te gokken op de duikkunsten van een eenzaam straatjongetje. Een derde verhaallijn lijkt luchtiger, maar ook daar ligt onheil op de loer: de twee geliefden komen niet uit dezelfde kaste."
                            }
                        ]
                    }
                ],
