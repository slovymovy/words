                "senses": [
                    {
                        "sense_id": "46cdc1cf-8a8a-3198-876d-91c19508f024",
                        "entry_id": "dcf3d652-0347-3e03-9611-cc0ea52e981b",
                        "glosses": [
                            "A master or teacher in the context of martial arts, especially kung fu and tai chi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da4744fc-7883-4261-9a7c-6f672b17a493",
                                "sense_id": "46cdc1cf-8a8a-3198-876d-91c19508f024",
                                "text": "Who is -- don't get cute with me, you dumb bastard, I'm your sifu."
                            }
                        ]
                    },
                    {
                        "sense_id": "f66447a7-728b-31ae-aa2b-978fb49cf8f6",
                        "entry_id": "dcf3d652-0347-3e03-9611-cc0ea52e981b",
                        "glosses": [
                            "A spiritual father in esoteric contexts."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
