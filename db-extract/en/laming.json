                        "entry_id": "2a88a021-2bbc-3fe0-99e6-7a43768773ef",
                        "glosses": [
                            "The act or process of rendering lame"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e56ad827-f507-4be0-955b-11b5ab097783",
                                "sense_id": "e8fb2db2-098f-3c66-872c-288599610b7a",
                                "text": "One young driver had been the subject of seven lamings, and had thriven in spite of them all. Any boy who had escaped with but one or two slight injuries was considered as particularly favoured."
                            },
                            {
                                "example_id": "f86e06e4-6572-4a31-b696-f78f3158515d",
                                "sense_id": "e8fb2db2-098f-3c66-872c-288599610b7a",
                                "text": "In contrast, the laming of a body part doesn't incapacitate one's ability to make spiritual progress. Lameness places rigorous constraints on the soul and body, but the believer is still able to go deep in God and grow in Christlikeness."
                            }
                        ]
                    }
