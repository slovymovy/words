                        "glosses": [
                            "Relatif à l'hypotaxe, propre à l'hypotaxe."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6d48e1a-1367-4ccd-b0d0-23c1391ad0f5",
                                "sense_id": "f7225dc6-34f0-3b9f-8a2a-44528797972d",
                                "text": "Si l'on approche néanmoins à juste titre la juxtaposition et la coordination pour les opposer à la subordination, c'est qu'indépendamment de la présence ou de l'absence d'un terme de liaison, les deux premières opèrent sur le mode de l'enchaînement parataxique (qui joue également entre des mots et des syntagmes), alors que la troisième opère par emboîtement hypotaxique de propositions (à l'exclusion de tout autre constituant). — (Martin Riegel et alii, Grammaire méthodique du français, PUF,2009, p. 783.)"
                            },
                            {
                                "example_id": "2756ddfe-4767-4d1a-bca6-f2f6ad5966be",
                                "sense_id": "f7225dc6-34f0-3b9f-8a2a-44528797972d",
                                "text": "Alors, une exclamation complétement hypotaxique, c'est-à-dire ancrée uniquement dans le pré-asserté, est-elle possible ?"
                            }
                        ]
                    }
