                "senses": [
                    {
                        "sense_id": "b793dd28-66d0-3ba3-9a1e-0426e058bcd2",
                        "entry_id": "6aee135a-25be-38c8-9dfa-bb43ab2f4f40",
                        "glosses": [
                            "een tekening die vervaardigd wordt met pen en inkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95fa1cbb-ed7e-4854-aa00-f96434693848",
                                "sense_id": "b793dd28-66d0-3ba3-9a1e-0426e058bcd2",
                                "text": "Hij deed zijn suggestie, nadat hij een week eerder Josta voor de grap gevraagd had om de pentekening van Georg Grosz die in zijn werkkamer hing na te maken, waarna ze een Georg Grosz-kenner uit Potsdam zouden vragen welke van de twee de echte was."
                            },
                            {
                                "example_id": "6192e866-bdfa-4bca-8133-0db3f039da0f",
                                "sense_id": "b793dd28-66d0-3ba3-9a1e-0426e058bcd2",
                                "text": "Bij de receptie van het Amsterdamse Stadsarchief is vanmiddag een gestolen tekening van G.H. Breitner afgegeven. Het werk, een pentekening van de Dam, zat in een bruine envelop."
                            },
                            {
                                "example_id": "c21bc0af-21fe-4994-b30f-0f6628e57e36",
                                "sense_id": "b793dd28-66d0-3ba3-9a1e-0426e058bcd2",
                                "text": "\"Van pentekening en geschilderd werk tot aan digitale collage. Met afwisselend in de hoofdrol: lijn, vorm, of juist kleur. Van eenvoudig en gestileerd tot aan barok. Humoristisch, poëtisch, of een tikkeltje surrealistisch. Weve kan het en doet het. Ze kiest niet alleen waar het verhaal om vraagt, maar ook waar ze zelf zin in heeft.\""
                            }
                        ]
                    }
