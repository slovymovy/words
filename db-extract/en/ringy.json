                "senses": [
                    {
                        "sense_id": "812ab9cd-0ab5-340c-999c-ef4650ea2df0",
                        "entry_id": "cda49c06-e92a-3c18-bb6e-7fd51fa472d0",
                        "glosses": [
                            "Alternative form of ringie (“ring”)."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative"
                        ],
                        "examples": [
                            {
                                "example_id": "b8b140c8-8b91-44aa-b305-445efd771dea",
                                "sense_id": "812ab9cd-0ab5-340c-999c-ef4650ea2df0",
                                "text": "I had a similar thing happen to me. Just called the guy who did the well test and he helped me diagnose it right over the phone. It was something to do with a filter and not the bladder. Cheap to fix in my case. If you have a local well/pump person, give them a ringy."
                            },
                            {
                                "example_id": "73c94781-c658-436b-bd4b-15b01a0215e2",
                                "sense_id": "812ab9cd-0ab5-340c-999c-ef4650ea2df0",
                                "text": "All you Canadian hosers, let's get some tradin' going on, eh. I hope I'm not being too much of a hoser, eh, cause my setlist is pretty short. I'm ready to do some beauty exchanges though, so give me a ringy, O.K., beauty."
                            },
                            {
                                "example_id": "a2828ede-a91c-415e-8922-f533b2313bb3",
                                "sense_id": "812ab9cd-0ab5-340c-999c-ef4650ea2df0",
                                "text": "Gets, give me a ringy when you can. Unsure what number you're at."
                            },
                            {
                                "example_id": "8710696c-9e3b-49f9-b4b0-be198d98a82a",
                                "sense_id": "812ab9cd-0ab5-340c-999c-ef4650ea2df0",
                                "text": "The Irish love nicknaming landmarks; Billy [Scott] refers to sculptures as 'the thingy with the ringy' (The Beacon Of Hope) and 'the balls on the Falls' (Rise)."
                            }
                        ]
                    }
