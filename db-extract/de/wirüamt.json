                            {
                                "example_id": "d6861c70-8133-4110-989d-d88e2b051915",
                                "sense_id": "8c00775b-1811-3233-a4b0-1042d3bfc620",
                                "text": "„Dieser unterstand zwar letztlich Göring, aber faktisch wurde er von General Georg Thomas geleitet, dem Chef des Wehrwirtschafts- und Rüstungsamt (WiRüAmt), das die Funktion erfüllen sollte, sowjetische Rüstungsbetriebe und Rohstoffe zu beschlagnahmen und auszubeuten.“"
                            },
                            {
                                "example_id": "b96ba752-aef6-4e25-8351-48ada594c757",
                                "sense_id": "8c00775b-1811-3233-a4b0-1042d3bfc620",
                                "text": "„Dabei ging das Wirtschafts- und Rüstungsamt (WiRüAmt) von einem längeren Krieg aus, für den man die wirtschaftlichen Kräfte des besetzten Landes mobilisieren musste.“"
                            },
                            {
                                "example_id": "6db23d1e-940d-4667-96ad-5f17060937f9",
                                "sense_id": "8c00775b-1811-3233-a4b0-1042d3bfc620",
                                "text": "„Bereits bei der Vorbereitung des Überfalls auf die Sowjetunion wurde ungeachtet der Konkurrenz von Vierjahresplanamt und OKW/WiRüAmt mit dem Wirtschaftsführungsstab Ost eine von beiden getragene Wirtschaftsorganisation geschaffen.“"
                            }
                        ],
