                        ],
                        "form": "sneller"
                    },
                    {
                        "form_id": "3286fbc0-8b09-4204-93b8-dad8fa7c8260",
                        "entry_id": "5be163f3-5499-3f58-ab24-bf92aef14841",
                        "tags": [
                            "superlative"
                        ],
                        "form": "snellest"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "45c8002e-6424-360c-ac01-b03c4a56254b",
                        "entry_id": "5be163f3-5499-3f58-ab24-bf92aef14841",
                        "glosses": [
                            "Quick, smart; sharp, active, brisk or nimble; lively."
                        ],
                        "tags": [
                            "Scotland"
                        ],
                        "examples": [
                            {
                                "example_id": "9fbce913-9433-4172-ac94-45401084d8e6",
                                "sense_id": "45c8002e-6424-360c-ac01-b03c4a56254b",
                                "text": "That in ilk action, wise and snell / You may shaw Manly fire."
                            },
                            {
                                "example_id": "796b8203-4800-4d7c-a54e-543970d7e1cd",
                                "sense_id": "45c8002e-6424-360c-ac01-b03c4a56254b",
                                "text": "That horny-handed, snell, peremptory little man."
                            },
                            {
                                "example_id": "69bbc24e-eef0-4a81-8f40-d029fbb43bd3",
                                "sense_id": "45c8002e-6424-360c-ac01-b03c4a56254b",
                                "text": "Amos is a lithe, keen, snell man."
                            }
                        ]
                    },
                    {
                        "sense_id": "e5b1342c-b7de-3d9e-a89d-0252950a66da",
                        "entry_id": "5be163f3-5499-3f58-ab24-bf92aef14841",
                        "glosses": [
                            "Quick-witted; clever."
                        ],
                        "tags": [
                            "Scotland"
                        ],
                        "examples": [
                            {
                                "example_id": "bcdc1be7-2101-47c1-a15d-cb1703832fa8",
                                "sense_id": "e5b1342c-b7de-3d9e-a89d-0252950a66da",
                                "text": "With all this heavy artillery, somewhat slow and cumbrous, on great questions, he had no want, when he was speaking off-hand, of quick, snell remark, often witty and full of spirit, and often too unexpected, like lightning—flashing, smiting, and gone."
                            }
                        ]
                    },
                    {
                        "sense_id": "0bc9d0a4-0ddd-31f1-91c8-91c552a51c3b",
                        "entry_id": "5be163f3-5499-3f58-ab24-bf92aef14841",
                        "glosses": [
                            "Harsh, severe, or stinging."
                        ],
                        "tags": [
                            "Scotland"
                        ],
                        "examples": [
                            {
                                "example_id": "830c39e1-e58d-48d4-bc24-c291f997c838",
                                "sense_id": "0bc9d0a4-0ddd-31f1-91c8-91c552a51c3b",
                                "text": "Conscience is a rough lad, I grant you, and I am keen and snell also; but never mind, take his advice, and you’ll be some credit to your freens yet, ye scoonrel."
                            },
                            {
                                "example_id": "3b19d03b-e55e-40c0-895f-e9656539e71c",
                                "sense_id": "0bc9d0a4-0ddd-31f1-91c8-91c552a51c3b",
                                "text": "Fortunately, we were well prepared for such an emergency, and being sheltered in a safe creek, we roofed the ship with canvas against the snow; and so, with land on every side of us, plenty of moss fuel ashore, a good stock of provisions, and firearms for hunting, we held our trouble, and passed the snell season without the loss of a single soul aboard."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
