                                        "entry_id": "4e3f525e-c47d-3c34-a610-a0d9dec4216a",
                                        "glosses": [
                                            "A cap that fits the head closely, usually knitted from wool."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "740e0bdc-d095-4a37-a801-6a029bcf7a6a",
                                                "sense_id": "79cf6686-a551-30f6-9d4d-f7bd3b254475",
                                                "text": "Enrique Iglesias is often seen wearing a beanie."
                                            },
                                            {
                                                "example_id": "b8f81ee9-bca2-40a8-b099-ce215564c70e",
                                                "sense_id": "79cf6686-a551-30f6-9d4d-f7bd3b254475",
                                                "text": "The sensation was curious. The bullet passed through her thigh, cleanly, severing the dust-bones and making the second self stumble for a moment before knitting the injury back together. It didn't hurt — she'd have needed an entire quarry's worth of sand for nociception — but she still felt the hole appear, still felt the tiny slug passing through, still felt the quivering impact and the explosive exit. She felt the next three as well, and then she was standing over a cowering woman in a black leather jacket and beanie with a look of complete and total bafflement on her face."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e12bf9d8-36d4-37c7-a692-8d271be9fd5c",
                                        "entry_id": "4e3f525e-c47d-3c34-a610-a0d9dec4216a",
                                        "glosses": [
                                            "A head-hugging brimless cap, with or without a visor, made from triangular sections of cloth, leather, or silk joined by a button at the crown and seamed together around the sides."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": []
                                    },
