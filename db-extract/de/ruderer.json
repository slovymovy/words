                    },
                    {
                        "translation_id": "ea59d796-f145-4289-bc36-a4cbbb796632",
                        "source_entry_id": "f62180b1-ae08-34a6-abca-4f8b819bd5f3",
                        "source_sense_id": "f7cb72b5-e30a-3219-9298-f99868cafb6a",
                        "source_sense_description": "Person, die ein Boot rudert",
                        "target_lang_word": "rower",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rower",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85cfdc4b-0f26-3dfa-9a96-29e7ca968194",
                                        "entry_id": "8fe1d129-f945-3487-be79-0356c90e0700",
                                        "glosses": [
                                            "One who rows."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e236a5ce-42ff-494d-9aca-afed1fe5cc53",
                                                "sense_id": "85cfdc4b-0f26-3dfa-9a96-29e7ca968194",
                                                "text": "It had been a sort of race hitherto, and the rowers, with set teeth and compressed lips, had pulled stroke for stroke."
                                            },
                                            {
                                                "example_id": "f4486bff-0cc8-4d16-b775-beda6f4e1062",
                                                "sense_id": "85cfdc4b-0f26-3dfa-9a96-29e7ca968194",
                                                "text": "Upon her deck were rowers with dream-made oars, and the rowers were the people of men’s fancies, and princes of old story and people who had died, and people who had never been."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f319e00-ea4d-34c7-9eb4-b5e6aaffeaaf",
                                        "entry_id": "8fe1d129-f945-3487-be79-0356c90e0700",
                                        "glosses": [
                                            "A rowing machine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e284bf7-990f-4792-8b04-429960c0afe4",
                                                "sense_id": "4f319e00-ea4d-34c7-9eb4-b5e6aaffeaaf",
                                                "text": "Aerobic and weight training sessions should also complement each other. For example, on a day you work your upper body with weights, you can use a rower for aerobics."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
