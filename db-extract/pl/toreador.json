                        "glosses": [
                            "każdy uczestnik korridy (pikador, matador, banderillero lub kapeador)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "814aeba0-da4e-45f0-b2c6-57b3cbf6807c",
                                "sense_id": "6081d6ef-9128-366e-ade1-d6ddbe6efe29",
                                "text": "Przywodziły na myśl zmarszczoną powiewem taflę olbrzymiego jeziora lub poukładane tu i ówdzie najrozmaitsze rodzaje fałd, jakie toreadorzy z niezwykłym kunsztem potrafią wyczarować z płachty tkaniny zwanej muletą"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
