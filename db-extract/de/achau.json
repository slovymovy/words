                ],
                "senses": [
                    {
                        "sense_id": "a60c4b48-7977-3e34-b408-7cd6e5b792b0",
                        "entry_id": "2dc9c784-99ff-3ae6-9122-51415c2f52ba",
                        "glosses": [
                            "niederösterreichische Gemeinde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ef320ba-d7f5-4d83-8bcf-e1d8993538f6",
                                "sense_id": "a60c4b48-7977-3e34-b408-7cd6e5b792b0",
                                "text": "Närrisches Treiben auf der Hauptstraße herrschte am Faschingsamstag in Achau."
                            },
                            {
                                "example_id": "5ade0715-3f36-4a70-9fc8-96b773336c3f",
                                "sense_id": "a60c4b48-7977-3e34-b408-7cd6e5b792b0",
                                "text": "Gespräche zwischen Gemeinde und Land haben stattgefunden. Ob Achau zukünftig umfahren wird, bleibt offen."
                            },
                            {
                                "example_id": "77ba44fb-dc20-447a-a1a6-f8a3c7caaf9d",
                                "sense_id": "a60c4b48-7977-3e34-b408-7cd6e5b792b0",
                                "text": "„Es war eine sehr nette Frau, die spontan angerufen hat und vom Flughafen mit dem Chauffeur zu unserem Ausstellungsraum nach Achau gekommen ist.\""
                            },
                            {
                                "example_id": "e2d31a7c-277e-4255-a2aa-da242aeef787",
                                "sense_id": "a60c4b48-7977-3e34-b408-7cd6e5b792b0",
                                "text": "Gumpoldskirchen (Bezirk Mödling) war laut Resperger vorübergehend ohne Strom. Zudem war die Pottendorfer Linie zwischen Achau und Münchendorf unterbrochen."
                            },
                            {
                                "example_id": "0f9349f4-b1bd-4b45-8e27-255d11e3ef95",
                                "sense_id": "a60c4b48-7977-3e34-b408-7cd6e5b792b0",
                                "text": "Und eigentlich wollte Evelyn Popp den Riedenhof in Achau zu einem Mensch-Tier-Therapiezentrum ausbauen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
