                        "glosses": [
                            "verhaal over mensen die zich buitengewoon moedig hebben gedragen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "584fbc86-a7b0-4ab0-8eef-6f075f0af01a",
                                "sense_id": "e28f6d2d-459f-37db-afc0-ba3aa04d4942",
                                "text": "Maar er komen nu ook andere verhalen over de scheepsramp naar boven. Het heldenverhaal van bemanningslid Park Jee Young (22). Meerdere overlevenden zeggen dat zij hun leven aan haar te danken hebben."
                            },
                            {
                                "example_id": "669d03e9-7e59-44a8-af00-e96c45f97016",
                                "sense_id": "e28f6d2d-459f-37db-afc0-ba3aa04d4942",
                                "text": "De onderzoekers stellen dat de mythe rond Palatucci in de jaren 50 is verzonnen, omdat zijn ouders dan geld van de overheid zouden krijgen. Het heldenverhaal werd maar al te graag geloofd in Italië, omdat men zich schaamde voor de collaboratie met de Duitsers."
                            }
                        ]
                    }
