            "senses": [
                {
                    "sense_id": "0180827a-2d29-394a-b2bb-303f14f5cd9d",
                    "sense_definition": "The physiological process of stopping bleeding from a damaged blood vessel.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeon worked quickly to ensure proper <w>hemostasis</w> after the incision was made.",
                            "target_lang_translations": {
                                "zh": "切口切开后，外科医生迅速操作以确保达到良好的<w>止血</w>效果。"
                            }
                        },
                        {
                            "text": "The patient's body naturally initiated <w>hemostasis</w> to prevent excessive blood loss from the wound.",
                            "target_lang_translations": {
                                "zh": "患者的身体自然启动了<w>凝血</w>机制，以防止伤口失血过多。"
                            }
                        }
                    ],
                    "synonyms": [
                        "clotting",
                        "coagulation"
                    ],
                    "common_phrases": [
                        "achieve hemostasis"
                    ],
                    "target_lang_definitions": {
                        "zh": "指机体在血管受损后，通过生理机制停止出血的过程。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "止血",
                                "target_lang_sense_clarification": "指停止出血的生理过程或医疗操作。"
                            },
                            {
                                "target_lang_word": "凝血",
                                "target_lang_sense_clarification": "指血液由液体变为凝胶状的过程，是止血的核心机制。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
