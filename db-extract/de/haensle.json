                ],
                "senses": [
                    {
                        "sense_id": "2cbcae0e-eea5-39ca-bfdc-05d18747b3f0",
                        "entry_id": "f7066b51-99b7-39fe-b11c-37e793caab7c",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c09a2a6-0079-4d63-9a87-f3bce1455302",
                                "sense_id": "2cbcae0e-eea5-39ca-bfdc-05d18747b3f0",
                                "text": "Frau Haensle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a410c798-20af-4874-ab3b-c878f90ed7a8",
                                "sense_id": "2cbcae0e-eea5-39ca-bfdc-05d18747b3f0",
                                "text": "Herr Haensle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "742b5b61-54be-466b-85a0-7d24e393cca8",
                                "sense_id": "2cbcae0e-eea5-39ca-bfdc-05d18747b3f0",
                                "text": "Die Haensles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "3d177527-2b26-447e-9429-7919ee508658",
                                "sense_id": "2cbcae0e-eea5-39ca-bfdc-05d18747b3f0",
                                "text": "Der Haensle trägt nie die Schals, die die Haensle ihm strickt."
                            },
                            {
                                "example_id": "2db2b016-2e1b-4fe7-b779-3d509c5e570f",
                                "sense_id": "2cbcae0e-eea5-39ca-bfdc-05d18747b3f0",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Haensle kommt, geht der Herr Haensle.“"
                            },
                            {
                                "example_id": "45cadaed-b9f6-4305-85a3-3a3929c68491",
                                "sense_id": "2cbcae0e-eea5-39ca-bfdc-05d18747b3f0",
                                "text": "Haensle kommt und geht."
                            },
                            {
                                "example_id": "fd35abd7-0ff1-45e7-8949-f52744d1bd89",
                                "sense_id": "2cbcae0e-eea5-39ca-bfdc-05d18747b3f0",
                                "text": "Haensles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
