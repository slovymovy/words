                "senses": [
                    {
                        "sense_id": "ed8d8fa0-27bd-399a-99ca-4f61d131e82b",
                        "entry_id": "9cb9912c-569d-3be8-8f19-06995bf40303",
                        "glosses": [
                            "jemand, der (vorwiegend) Programmcode für Software schreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74218ed5-6acc-42db-90f5-a0c0c8a59d9a",
                                "sense_id": "ed8d8fa0-27bd-399a-99ca-4f61d131e82b",
                                "text": "„Wenn Sie ein Softwareprogrammierer sind, versuchen Sie, ein wenig Code schneller zu schreiben, anstatt Hühnchen-Curry früher zu kochen.“"
                            },
                            {
                                "example_id": "3c1796f1-0f06-41d6-8cf2-16a34d929c2d",
                                "sense_id": "ed8d8fa0-27bd-399a-99ca-4f61d131e82b",
                                "text": "„Bloß, dass ein Softwareprogrammierer mit Bits und Bytes kodierte, während ein Genetiker die vier Basen A, T, G und C zum Programmieren nahm.“"
                            },
                            {
                                "example_id": "0e949e6a-2cfd-451b-8932-b934dcfcfa43",
                                "sense_id": "ed8d8fa0-27bd-399a-99ca-4f61d131e82b",
                                "text": "„Falcao gab nicht viel Privates über sich preis, sprach aber mit Begeisterung von seiner Arbeit als Softwareprogrammierer.“"
                            },
                            {
                                "example_id": "89863610-f4e5-47a0-a3b7-13315e9f7b95",
                                "sense_id": "ed8d8fa0-27bd-399a-99ca-4f61d131e82b",
                                "text": "„Die App als Computerprogramm wird vom Softwareprogrammierer konzipiert und programmiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
