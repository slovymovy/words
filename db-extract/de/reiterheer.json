                                "example_id": "e5e7d287-5cda-435e-b2fd-225a47f5c76e",
                                "sense_id": "e02cdd54-eecb-3df7-8c71-109aecdb16bb",
                                "text": "„Gegen Ende des 7. Jahrhunderts nach Christus erobern arabische Reiterheere die Region und bringen eine neue Religion nach Afrika: den Islam.“"
                            },
                            {
                                "example_id": "81f8b9c7-d779-467b-b1ed-1fafa3cb5a44",
                                "sense_id": "e02cdd54-eecb-3df7-8c71-109aecdb16bb",
                                "text": "„Dabei hatte Sultan Süleyman mit dem Feldzug nach Westen, der sein Reiterheer bis vor die Stadtmauer Wiens führen sollte, noch gar nicht begonnen.“"
                            }
