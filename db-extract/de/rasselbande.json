                "senses": [
                    {
                        "sense_id": "632b914b-0ad4-3d2f-92fd-5d6f08223166",
                        "entry_id": "65b02884-c58b-386b-a55c-8a77750bb47d",
                        "glosses": [
                            "Gruppe lärmender und Streiche spielender Kinder"
                        ],
                        "tags": [
                            "umgangssprachlich,",
                            "meist scherzhaft"
                        ],
                        "examples": [
                            {
                                "example_id": "b287d3dc-36ce-4612-9de3-20bac22f6ea6",
                                "sense_id": "632b914b-0ad4-3d2f-92fd-5d6f08223166",
                                "text": "Na wartet, ihr Rasselbande, euch sollte man den Hintern versohlen!"
                            },
                            {
                                "example_id": "d3e50a8a-9220-4a0c-80e8-0553d69411ac",
                                "sense_id": "632b914b-0ad4-3d2f-92fd-5d6f08223166",
                                "text": "Na, ihr Rasselbande, jetzt geht’s erst mal unter die Dusche und dann gibt’s Abendbrot."
                            },
                            {
                                "example_id": "53ef5a5e-e9ee-4277-8b8d-194f1336f793",
                                "sense_id": "632b914b-0ad4-3d2f-92fd-5d6f08223166",
                                "text": "Es ist Mittag - Sylvia Horvathova kocht für ihre achtköpfige Rasselbande Gulasch."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
