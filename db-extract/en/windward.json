                                        "entry_id": "d0c9761e-4f5d-308e-9b58-5d3caba1d6d8",
                                        "glosses": [
                                            "Situé du côté du navire d'où vient le vent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b879e8e-10b4-4dd0-a572-f643354cfec5",
                                                "sense_id": "ead8c1ef-79f2-3b3d-9a07-c43fbe0971df",
                                                "text": "Quand un objet se trouve plus près de l’origine du vent que la perpendiculaire à la direction de l’aire de vent qui passe par un autre objet, le premier de ces objets est au vent de l’autre ; s’il est plus loin de l’origine du vent par rapport à cette perpendiculaire, il est sous le vent de l’autre objet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f0de54e-e317-3afb-aeea-79f0b3b49cb9",
                                        "entry_id": "d0c9761e-4f5d-308e-9b58-5d3caba1d6d8",
                                        "glosses": [
                                            "Côte située du côté d'où vient le vent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c29469a1-18f9-4587-9d36-952ea51de782",
                                                "sense_id": "7f0de54e-e317-3afb-aeea-79f0b3b49cb9",
                                                "text": "Côte-au-vent ou à l'inverse côte-sous-le-vent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5305796f-c026-4c05-9e8c-8c0314755827",
