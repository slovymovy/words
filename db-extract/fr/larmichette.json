            {
                "entry_id": "8d6efc52-762f-3606-bc84-dafd3976ef7e",
                "word": "larmichette",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8a8fea9d-ebe3-4626-9e24-02913953d179",
                        "entry_id": "8d6efc52-762f-3606-bc84-dafd3976ef7e",
                        "tags": [
