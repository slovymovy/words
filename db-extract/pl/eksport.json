                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3817b81e-2848-34d3-bece-209051452d57",
                                        "entry_id": "78f6b6d6-3bd5-37aa-ba90-70cc3992b6f4",
                                        "glosses": [
                                            "Verkauf oder Transport von Gütern ins Ausland"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a21e7c2-e378-4e0d-ab35-bd547a8e3065",
                                                "sense_id": "3817b81e-2848-34d3-bece-209051452d57",
                                                "text": "„Vor allem versuchte Vaca die im ganzen Lande arg zerrütteten Geldverhältnisse zu ordnen und zu stärken, sowie auf einen regelmäßigen Export von Landeserzeugnissen hinzuwirken.“"
                                            },
                                            {
                                                "example_id": "4949ba3a-5783-48b8-93a8-d601213ce599",
                                                "sense_id": "3817b81e-2848-34d3-bece-209051452d57",
                                                "text": "„Eine wichtige Rolle im Handel spielt der Export. Export ist, wenn die anderen kaufen sollen, was wir nicht kaufen können; auch ist es unpatriotisch, fremde Waren zu kaufen, daher muß das Ausland einheimische, als deutsche Waren konsumieren, weil wir sonst nicht konkurrenzfähig sind. Wenn der Export andersrum geht, heißt er Import […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "79d0fa24-4eac-393e-9cd4-dc34a6ecf014",
                                        "entry_id": "78f6b6d6-3bd5-37aa-ba90-70cc3992b6f4",
                                        "glosses": [
                                            "die ausgeführten Güter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49a9fa6b-39a6-4c15-893f-4936045f89a0",
                                                "sense_id": "79d0fa24-4eac-393e-9cd4-dc34a6ecf014",
                                                "text": "Die Exporte nach China sollen verstärkt werden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Export",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "367b731d-3e57-3b11-b456-3166aa7f4c64",
                                        "entry_id": "1fcbeeb3-093c-34a5-8797-35e2d1bffa9f",
                                        "glosses": [
                                            "Kurzform von Exportbier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93448200-9486-4952-92f9-aa798e0f2372",
                                                "sense_id": "367b731d-3e57-3b11-b456-3166aa7f4c64",
                                                "text": "„Export gibt es in den traditionellen Dortmunder, Münchener und Wiener Brauarten.“"
                                            },
                                            {
                                                "example_id": "7b64dcf1-0caf-4d7d-b82c-23f11ffa127a",
                                                "sense_id": "367b731d-3e57-3b11-b456-3166aa7f4c64",
                                                "text": "„Das Erstgericht verbot mit einstweiliger Verfügung dem Beklagten, Bier jugoslawischen Ursprungs unter der Markenbezeichnung »Marcus Bräu«, insbesondere mit den zusätzlichen Ankündigungen »Export Bier,« »Brauhausfüllung« und »Hopfen und Malz – Gott erhalt's«, in Verkehr zu bringen, ohne zugleich darauf hinzuweisen, daß es sich um ein aus Jugoslawien importiertes Erzeugnis handelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
