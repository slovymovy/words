                        "ru": [
                            {
                                "target_lang_word": "прийтись по вкусу",
                                "target_lang_sense_clarification": "понравиться, подойти"
                            },
                            {
                                "target_lang_word": "нравиться",
                                "target_lang_sense_clarification": "быть по душе"
                            }
                        ]
