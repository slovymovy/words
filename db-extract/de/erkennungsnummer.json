                "senses": [
                    {
                        "sense_id": "404549e9-c12f-3b7d-b476-ab86c7ddef51",
                        "entry_id": "6ae138f5-3e18-341f-b593-ab2d1a765aeb",
                        "glosses": [
                            "Buchstaben-/Ziffernkombination, die einen Gegenstand oder eine Person eindeutig identifizierbar machen soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a74e089a-18f9-4bfe-b69d-cafd39c285f5",
                                "sense_id": "404549e9-c12f-3b7d-b476-ab86c7ddef51",
                                "text": "[Saisonkennzeichen für Wohnmobile:] „Erkennbar sind Saisonkennzeichen daran, dass hinter der Erkennungsnummer übereinander angeordnet der erste und letzte Monat des Gültigkeitszeitraums angegeben ist und die Ziffern durch einen waagerechten Strich voneinander getrennt sind.“"
                            },
                            {
                                "example_id": "2662a5c5-600d-46e2-aa74-b49c3067d807",
                                "sense_id": "404549e9-c12f-3b7d-b476-ab86c7ddef51",
                                "text": "„Das US-amerikanische FBI wurde eingeschaltet, Facebook gab die Erkennungsnummer von Nicolás Computer, seine sogenannte IP-Adresse heraus, und die Staatsanwaltschaft scannte seine Festplatte.“"
                            },
                            {
                                "example_id": "6bf8d1bc-f06e-4b78-86d8-dd41e3e6e4d4",
                                "sense_id": "404549e9-c12f-3b7d-b476-ab86c7ddef51",
                                "text": "[Computermaus:] „Damit ein Empfänger weiß, welche Maus zu ihm gehört, haben die meisten Mäuse eine Erkennungsnummer, die sie von ihren baugleichen Brüdern unterscheidet.“"
                            },
                            {
                                "example_id": "224966e0-d497-4b3b-ab58-7d545891bc88",
                                "sense_id": "404549e9-c12f-3b7d-b476-ab86c7ddef51",
                                "text": "„Chip-Implantate sind bereits millionenfach im Einsatz – allerdings nur bei Hunden, Katzen und anderen Tieren. Für diesen Zweck werden bisher nur sehr simple Chips verwendet, die nicht mehr können, als eine Erkennungsnummer zu senden.“"
                            },
                            {
                                "example_id": "6f2ccbe2-4b02-445e-844f-2c005256d6f2",
                                "sense_id": "404549e9-c12f-3b7d-b476-ab86c7ddef51",
                                "text": "„In Birkenau angekommen, wurde allen Häftlingen eine Erkennungsnummer auf den Unterarm tätowiert.“"
                            },
                            {
                                "example_id": "92559ffc-f6d9-408f-92cc-3b0db409883a",
                                "sense_id": "404549e9-c12f-3b7d-b476-ab86c7ddef51",
                                "text": "„Sämtliche Häftlinge hatten eine Erkennungsnummer“ […]."
                            },
                            {
                                "example_id": "59dd80b9-6e8a-48f3-94a5-1398693371af",
                                "sense_id": "404549e9-c12f-3b7d-b476-ab86c7ddef51",
                                "text": "„Die Gefangenen trugen eine Metallmarke mit ihrer Erkennungsnummer um den Hals;“ […]."
                            },
                            {
                                "example_id": "c3e4e5e2-ec50-493b-ba24-34b135a854ca",
                                "sense_id": "404549e9-c12f-3b7d-b476-ab86c7ddef51",
                                "text": "[Bundesarchiv:] „Diese Dienststelle pflegt die Daten und Erkennungsnummern der im Zweiten Weltkrieg eingesetzten Soldaten.“"
                            },
                            {
                                "example_id": "5c39b16f-105f-493b-8280-76b08acee718",
                                "sense_id": "404549e9-c12f-3b7d-b476-ab86c7ddef51",
                                "text": "„Videos zeigten ein gewaltsamen Vorgehen der Bundespolizisten, die weder eine Erkennungsnummer noch ein Namensschild trugen.“"
                            },
                            {
                                "example_id": "e7a31879-ce11-49d4-9b99-549a496cba06",
                                "sense_id": "404549e9-c12f-3b7d-b476-ab86c7ddef51",
                                "text": "„Hardwick kritisierte, mehrere Polizisten hätten während des Einsatzes gegen die G20-Proteste absichtlich ihre Erkennungsnummern verborgen und damit gegen eine Anweisung von Scotland-Yard-Chef Paul Stephenson verstoßen.“"
                            },
                            {
                                "example_id": "75dbdc7c-d64c-4126-9823-9e149c564d1a",
                                "sense_id": "404549e9-c12f-3b7d-b476-ab86c7ddef51",
                                "text": "[Zwangstätowierungen:] „Angehörige der Eliteeinheiten der SS wiederum mussten sich ihre Blutgruppe und Erkennungsnummer unter die Achsel stechen lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
