        "fr-extract.jsonl": [
            {
                "entry_id": "79c6af4a-e80f-3ed9-9835-39445b24afb3",
                "word": "sapiosexualité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ac5d8824-1328-47c9-b203-3c76f185e68f",
                        "entry_id": "79c6af4a-e80f-3ed9-9835-39445b24afb3",
                        "tags": [
                            "plural"
                        ],
                        "form": "sapiosexualités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "aef7dc4c-8a80-3b4d-84b4-ca2fa9615ffe",
                        "entry_id": "79c6af4a-e80f-3ed9-9835-39445b24afb3",
                        "glosses": [
                            "Attirance sexuelle pour les personnes intelligentes."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "0f92a822-3a01-4d29-a3a6-b2eb1657c36d",
                                "sense_id": "aef7dc4c-8a80-3b4d-84b4-ca2fa9615ffe",
                                "text": "La sapiosexualité est donc un concept qui place l’intelligence d’une personne comme le critère déterminant de l’excitation sexuelle."
                            },
                            {
                                "example_id": "4bf00687-b49a-4a22-a11f-a4c080757346",
                                "sense_id": "aef7dc4c-8a80-3b4d-84b4-ca2fa9615ffe",
                                "text": "Comme son nom ne l’indique pas forcément, la sapiosexualité n’a rien à voir avec une maladie mentale. Néologisme forgé de « sapiens », l’intelligence en latin (comme dans homo sapiens), ce mot désigne les personnes attirées sexuellement par les athlètes des neurones."
                            },
                            {
                                "example_id": "ffb9851d-6243-4b8d-a08f-c04a328e6b0d",
                                "sense_id": "aef7dc4c-8a80-3b4d-84b4-ca2fa9615ffe",
                                "text": "Mot-valise de l’adjectif latin « sapio » signifiant « intelligent, sage, raisonnable » et de « sexualité », la sapiosexualité consacre l’idée que l’intelligence est plus importante que la beauté physique pour de nombreuses personnes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf706890-373e-4c30-96ee-b3a61ce7ca13",
                        "source_entry_id": "79c6af4a-e80f-3ed9-9835-39445b24afb3",
                        "source_sense_id": "aef7dc4c-8a80-3b4d-84b4-ca2fa9615ffe",
                        "target_lang_word": "sapiosexuality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sapiosexuality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8b164e5-9bf9-321c-907f-d44f4a817289",
                                        "entry_id": "dc5a344c-0064-3bac-abae-55d1fa5c4df0",
                                        "glosses": [
                                            "The state of being sexually attracted to intelligence or the human mind."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebf88dce-2b31-41ce-b3fe-646a5637855a",
                                                "sense_id": "f8b164e5-9bf9-321c-907f-d44f4a817289",
                                                "text": "So a self-confessed culture vulture is a member of communities on authors, sudoku, films, chocolates and sapiosexuality (sapiosexuals are people who are apparently turned on by intelligence)."
                                            },
                                            {
                                                "example_id": "d584f46c-a0f9-42f5-a6d9-2c4b3ce068ec",
                                                "sense_id": "f8b164e5-9bf9-321c-907f-d44f4a817289",
                                                "text": "I went to friend and psychologist Alejandro Spicker — who's both attractive and smart — and asked him what he thought of sapiosexuality."
                                            },
                                            {
                                                "example_id": "5b5c65b7-c013-458a-b381-65fe41aed18e",
                                                "sense_id": "f8b164e5-9bf9-321c-907f-d44f4a817289",
                                                "text": "Sapiosexuality is getting aroused not by the physical appearance of a person, but through his or her intelligence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
