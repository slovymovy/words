                "senses": [
                    {
                        "sense_id": "2e07c111-e181-36b9-aa56-28b8633248ab",
                        "entry_id": "6b8881c5-5ff9-3809-a5c5-08c09b7f42fd",
                        "glosses": [
                            "специалист по политической экономии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da78d5ed-ecdc-4042-a8fb-82970f02e1be",
                                "sense_id": "2e07c111-e181-36b9-aa56-28b8633248ab",
                                "text": "Маркс-политэконом парализует здесь Маркса-философа, и уж еще в большей степени следует это сказать про его последователей."
                            },
                            {
                                "example_id": "36000aac-4843-4427-9fde-2c868fb2bea1",
                                "sense_id": "2e07c111-e181-36b9-aa56-28b8633248ab",
                                "text": "У них (институт (иностранных) языков) арестованы три профессора (ком (м) унисты) — историки, политэкономы и тому подобное."
                            }
                        ]
                    }
