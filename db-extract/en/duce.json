                ],
                "translations": [
                    {
                        "translation_id": "e5e6c78c-a45b-49d7-a5a7-9ed69ed8f26c",
                        "source_entry_id": "cbe1752c-e45a-3ed8-b18a-0336df66575c",
                        "source_sense_id": "95c8231c-c071-37bb-98e7-1b1c33ac27a7",
                        "source_sense_description": "(fascism) an authoritarian leader, especially Benito Mussolini",
                        "target_lang_word": "duce",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "duce",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "475f2de3-8834-3b14-92a9-3a7f62ff0d34",
                                        "entry_id": "ca886016-cba3-3e9a-8f26-9911e2cc7141",
                                        "glosses": [
                                            "Titre porté par Mussolini."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e98bb087-e006-4296-9a2c-821b67f423ef",
                                                "sense_id": "475f2de3-8834-3b14-92a9-3a7f62ff0d34",
                                                "text": "Mais, bien sûr, contrairement à des écrits pédagogiques qui éduquent chez l’enfant, le libre arbitre, l’autonomie et l’engagement individuel, dans les textes destinés aux enfants fascistes tout converge vers la sacralisation du duce et de ses objectifs de conquêtes bellicistes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c53e032-6b33-380c-9c06-6f8db2d6959d",
                                        "entry_id": "ca886016-cba3-3e9a-8f26-9911e2cc7141",
                                        "glosses": [
                                            "Titre prêté à quelqu’un et faisant référence à la personnalité de Benito Mussolini."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively",
                                            "ironic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7b83680-1d9a-46f8-adcd-76422f0d91ee",
                                                "sense_id": "7c53e032-6b33-380c-9c06-6f8db2d6959d",
                                                "text": "Pour les autres, une défaite serait la fin de la démocratie, le début du fascisme aux États-Unis par le Duce Trump."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "duce",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c7cfa913-6aeb-39f3-a7ea-78f8bf84b902",
                                        "entry_id": "cb8658cb-5a1d-3791-a7af-3b70426bf93f",
                                        "glosses": [
                                            "Signal destiné à prévenir ou à informer."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3a7043d-ab24-4002-8ddf-a81ce56e03d4",
                                                "sense_id": "c7cfa913-6aeb-39f3-a7ea-78f8bf84b902",
                                                "text": "Il avait le duce depuis vingt minutes et deux bons tiers de ses habitués s’étaient déjà volatilisés."
                                            },
                                            {
                                                "example_id": "703b5cc6-cc65-4c23-bd9d-f4a327f04c1a",
                                                "sense_id": "c7cfa913-6aeb-39f3-a7ea-78f8bf84b902",
                                                "text": "Le barbillon, qui n’avait pas compris le duce de Colette, partait à l’attaque. Tourné franchement vers Brigitte, il détaillait le lot, plus accroché par l’anatomie que par la pelure."
                                            },
                                            {
                                                "example_id": "5e8c42d6-5973-4334-8c3d-db93a58f85b4",
                                                "sense_id": "c7cfa913-6aeb-39f3-a7ea-78f8bf84b902",
                                                "text": "Quelqu’un m’a envoyé le duce comme quoi la môme Belinda serait venue crécher dans le coin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a1cb16ce-db8c-46d4-bdcd-e572dfc96081",
                        "source_entry_id": "cbe1752c-e45a-3ed8-b18a-0336df66575c",
                        "source_sense_id": "95c8231c-c071-37bb-98e7-1b1c33ac27a7",
