                    {
                        "translation_id": "3becc3e7-d2ca-4816-b601-2172a2232283",
                        "source_entry_id": "5dd29f93-dab3-33dd-aa55-0bf0d0d8b95d",
                        "source_sense_description": "относящийся к Молдавии",
                        "target_lang_word": "moldauisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moldauisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9229f193-769f-3aee-ac41-5fbae61b6a2e",
                                        "entry_id": "4afd19d4-b28f-3658-95cb-d74bd72c515b",
                                        "glosses": [
                                            "das Land Republik Moldau ( Moldawien) betreffend, aus Moldau kommend"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a55ba449-2f51-49f8-b1db-b8b0b3776e7c",
                                                "sense_id": "9229f193-769f-3aee-ac41-5fbae61b6a2e",
                                                "text": "„Die aktuellen Schwierigkeiten der Republik Moldau nahmen mit dem Zusammenbruch der Sowjetunion ihren Ausgang, als die kleine moldauische Wirtschaft abrupt vom traditionellen, vor allem russischen Absatzmarkt abgeschnitten wurde.“"
                                            },
                                            {
                                                "example_id": "a2850ceb-98b5-4bc7-8976-9e3344d47988",
                                                "sense_id": "9229f193-769f-3aee-ac41-5fbae61b6a2e",
                                                "text": "„Weil ein moldauisches Gefängnis jenseits des Flusses liegt, müssen die Wärter jeden Morgen Tarnmäntel überziehen, um ihre Uniformen zu verbergen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c45d8a4a-b5b6-3f0d-b972-fef87d90a8e3",
                                        "entry_id": "4afd19d4-b28f-3658-95cb-d74bd72c515b",
                                        "glosses": [
                                            "Sprache, die in Transnistrien gesprochen wird die Amtssprache Moldawiens"
                                        ],
                                        "tags": [
                                            "und früher Bezeichnung für"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffcc645f-b4f7-4767-bfb8-1bc07c9be950",
                                                "sense_id": "c45d8a4a-b5b6-3f0d-b972-fef87d90a8e3",
                                                "text": "Die Moldauer in der Bukowina haben in ihre walachische Sprache wieder viele slawische Wörter aufgenommen, und so eine eigene moldauische Abart gebildet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
