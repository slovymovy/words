                "senses": [
                    {
                        "sense_id": "3b37d0a3-a7a3-3a9c-82dd-8de550f1e5b1",
                        "entry_id": "a4eb2970-3307-32ab-a388-2e812490387c",
                        "glosses": [
                            "Zerteilung bestimmter Größen in kleine Teile; diese Größen können also nur diskrete Werte aus einem gestuften Wertvorrat annehmen, statt kontinuierlich veränderbar zu sein"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "df3d3a8b-972e-4c63-a7d8-abc2a99ce92b",
                                "sense_id": "3b37d0a3-a7a3-3a9c-82dd-8de550f1e5b1",
                                "text": "„Bislang ist Quantelung bei den folgenden physikalischen Objekten und Größen bekannt: Materie, Licht, Energie, Ladung, Impuls, Drehimpuls, elektrischer Widerstand.“"
                            },
                            {
                                "example_id": "c310fa08-b5a2-42a9-8299-f58c78da0f07",
                                "sense_id": "3b37d0a3-a7a3-3a9c-82dd-8de550f1e5b1",
                                "text": "„Nach der Entdeckung der Quantelung des Lichts durch Albert Einstein bei der Untersuchung des Photoeffekts entstand das Dilemma, ob Licht als Welle oder als Teilchenstrom beschrieben werden soll.“"
                            },
                            {
                                "example_id": "c536b231-2c22-44ea-9621-803ee2996893",
                                "sense_id": "3b37d0a3-a7a3-3a9c-82dd-8de550f1e5b1",
                                "text": "„Quanten können immer nur in bestimmten Portionen dieser physikalischen Größe auftreten, sie sind mithin die Quantelung dieser Größen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
