                "entry_id": "6d6c482f-f573-3154-a784-963f7e9e70a0",
                "word": "galeriste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "46d3c9e0-f091-4a63-b9ed-2067b7408563",
                        "entry_id": "6d6c482f-f573-3154-a784-963f7e9e70a0",
                        "tags": [
