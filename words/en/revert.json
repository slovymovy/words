                {
                    "sense_id": "834a1f23-9338-3904-80bf-f9b8f6e32d2f",
                    "sense_definition": "A skateboarding trick involving a 180-degree rotation of the board while the wheels remain on the ground.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He landed the jump and smoothly transitioned into a <w>revert</w>.",
                            "target_lang_translations": {
                                "ru": "Он приземлил прыжок и плавно перешел в <w>риверт</w>."
