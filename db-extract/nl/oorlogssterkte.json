                        "tags": [],
                        "examples": [
                            {
                                "example_id": "052f5a2a-ec5e-4e2d-9872-04ab5bcaad18",
                                "sense_id": "9e1e3474-0473-3fbf-a5ee-988985669d3d",
                                "text": "De Britten zitten momenteel met 1.600 man in de Jordaanse woestijn voor de ‘Shamal Storm’, waar voor het eerst in tien jaar een grootscheepse invasie geoefend wordt, om op oorlogssterkte te blijven. De trainingsmissie komt een jaar nadat het Amerikaanse leger zorgen uitte over de slagkracht van de Britten."
                            }
                        ]
