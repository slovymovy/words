                ],
                "senses": [
                    {
                        "sense_id": "db8427b0-5981-35ca-9cac-58b09953deb2",
                        "entry_id": "caeabfd5-a1df-3ca8-8f25-85dcb66c4109",
                        "glosses": [
                            "Gebäude, das der Unterbringung von Männern, die keine Möglichkeit zu einer Übernachtung haben (also auf der Straße schlafen müssten), dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "762cbf33-af9b-4f7b-9d4c-fcf057b2986f",
                                "sense_id": "db8427b0-5981-35ca-9cac-58b09953deb2",
                                "text": "Im Februar 1910 zieht der arbeitslose Kunstmaler Adolf Hitler aus Linz ins Wiener Männerwohnheim Meldemannstraße 27."
                            },
                            {
                                "example_id": "50bbd93d-daa4-49f0-8d4d-5f0787089365",
                                "sense_id": "db8427b0-5981-35ca-9cac-58b09953deb2",
                                "text": "„Stalin geht durch den Park, denkt nach, es dämmert schon. Da kommt ihm ein anderer Spaziergänger entgegen, 23 Jahre alt, ein gescheiterter Maler, dem die Akademie die Aufnahme verweigerte und der nun die Zeit totschlägt im Männerwohnheim in der Meldemannstraße.“"
                            },
                            {
                                "example_id": "5d958822-7c9a-4529-8ee7-9ba9fe686e42",
                                "sense_id": "db8427b0-5981-35ca-9cac-58b09953deb2",
                                "text": "„Klaus G. wird am 1. März aus dem Gefängnis entlassen und in einem Männerwohnheim untergebracht.“"
                            },
                            {
                                "example_id": "101026a5-8225-4aa5-acbf-eb25ff2193c1",
                                "sense_id": "db8427b0-5981-35ca-9cac-58b09953deb2",
                                "text": "„Sein Bewährungshelfer konnte ihn in einem Männerwohnheim unterbringen.“"
                            },
                            {
                                "example_id": "8f88c116-2ed5-4d23-aaf0-fd8e5ec30ce0",
                                "sense_id": "db8427b0-5981-35ca-9cac-58b09953deb2",
                                "text": "„Im Herbst setzte ich mich in einen klapprigen Buick und fuhr nach Chicago. Ich fand ein Zimmer für 400 Dollar im Monat in einem Männerwohnheim in der Near Northside. Meine Mitbewohner waren frisch entlassene Strafgefangene, unheilbar Kranke, aber auch ein versoffener ehemaliger Radiosportreporter.“"
                            },
                            {
                                "example_id": "29009b0b-8ebc-42c4-ba07-c74b0f1ba26f",
                                "sense_id": "db8427b0-5981-35ca-9cac-58b09953deb2",
                                "text": "43 weitere Männer wohnen derzeit wie Gerhard Aigner im Männerwohnheim William-Booth-Zentrum der Heilsarmee der christlichen Freikirche in München."
                            },
                            {
                                "example_id": "684bef55-3cb8-4b0e-9b04-0c5b209e265b",
                                "sense_id": "db8427b0-5981-35ca-9cac-58b09953deb2",
                                "text": "„Die Heilsarmee betreibt ein Männerwohnheim für Obdachlose in der Stadt.“"
                            },
                            {
                                "example_id": "15cfca4a-0143-47f1-8856-966418c83ec5",
                                "sense_id": "db8427b0-5981-35ca-9cac-58b09953deb2",
                                "text": "Am 1. Juli 2005 wird am Rheinischen Platz in Essen ein 44-Jähriger Mann von zwei Skinheads zusammengeschlagen. Zwei Tage später wird er tot in seinem Zimmer in einem Männerwohnheim gefunden. Die Obduktion stellt \"stumpfe Gewalt\" gegen seinen Kopf als Todesursache fest."
                            },
                            {
                                "example_id": "8e001011-76a0-4711-8a6f-6747da531fd0",
                                "sense_id": "db8427b0-5981-35ca-9cac-58b09953deb2",
                                "text": "„Nach einer Kindheit im Waisenhaus und bei Pflegeeltern zieht Klaus Born in ein katholisches Männerwohnheim.“"
                            },
                            {
                                "example_id": "a8009d23-7c43-4d90-8c62-658f557a94a7",
                                "sense_id": "db8427b0-5981-35ca-9cac-58b09953deb2",
                                "text": "„Thomas ist Deutscher und arbeitet tagsüber als Altenpfleger. Nachts schläft er seit drei Monaten gegen eine geringe Bezahlung im Münchner Männerwohnheim in der Pilgersheimer Straße.“"
                            },
                            {
                                "example_id": "02fb1398-348b-457d-940d-e0866bceea5c",
                                "sense_id": "db8427b0-5981-35ca-9cac-58b09953deb2",
                                "text": "„Thomas hat jahrelang auf der Straße gelebt. Schließlich kommt er in einem Männerwohnheim unter: »Irgendwann hab' ich da einen Platz bekommen.«“"
                            },
                            {
                                "example_id": "789e6aaf-fa92-4659-8d6d-ea105ec88ed5",
                                "sense_id": "db8427b0-5981-35ca-9cac-58b09953deb2",
                                "text": "„Die Pension Volta in Luzern erhält einen Anerkennungspreis der Albert Koechlin Stiftung AKS. Ausgezeichnet werden das Männerwohnheim und seine Trägerschaft für ihr soziales Engagement.“"
                            },
                            {
                                "example_id": "cabca150-102e-481f-bad8-f15192aa0eae",
                                "sense_id": "db8427b0-5981-35ca-9cac-58b09953deb2",
                                "text": "„Nach Ende des Krieges diente der Bunker als Männerwohnheim und bot in 51 Räumen 135 Personen Platz.“"
                            },
                            {
                                "example_id": "1e002ad6-f4e7-4e2a-9197-a4037278c11d",
                                "sense_id": "db8427b0-5981-35ca-9cac-58b09953deb2",
                                "text": "„Doch viele Versuche scheiterten zunächst: »Insgesamt wurden zehn Bauplätze geprüft, doch es gab immer viel Widerstand von den Nachbarn gegen ein Männerwohnheim«, sagt die Pressesprecherin der Inneren Mission, Anke Mirsch.“"
                            },
                            {
                                "example_id": "82b6636c-ade9-4b08-8a7b-adcabdfe0456",
                                "sense_id": "db8427b0-5981-35ca-9cac-58b09953deb2",
                                "text": "„Ende des Jahres wird das Männerwohnheim geschlossen, nur teilweise wird ein neues Haus die Bewohner aufnehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
