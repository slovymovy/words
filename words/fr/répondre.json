{
    "word_family": [
        "réponse",
        "répondeur",
        "répondant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "676a24dc-31b9-372c-80c6-05b038e87a21",
                    "sense_definition": "Donner une réponse verbale ou écrite à une demande, une interrogation ou une sollicitation.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur pose une question et l'élève <w>répond</w> avec enthousiasme."
                        },
                        {
                            "text": "Pourquoi ne veux-tu pas <w>répondre</w> quand je te parle ?"
                        }
                    ],
                    "synonyms": [
                        "répliquer"
                    ],
                    "antonyms": [
                        "demander",
                        "interroger"
                    ],
                    "common_phrases": [
                        "répondre à une question",
                        "répondre oui",
                        "répondre non"
                    ]
                },
                {
                    "sense_id": "f612c292-5eff-3ed8-b934-d538b68d7514",
                    "sense_definition": "Donner suite à une lettre, un courriel ou un appel téléphonique reçu.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je dois absolument <w>répondre</w> à ce message important avant midi."
                        },
                        {
                            "text": "Son téléphone sonne sans cesse mais elle refuse de <w>répondre</w>."
                        }
                    ],
                    "common_phrases": [
                        "répondre au téléphone",
                        "répondre à un courriel",
                        "répondre à une lettre"
                    ]
                },
                {
                    "sense_id": "99ea06ab-abc8-3a13-8d16-59bec8d7c92a",
                    "sense_definition": "Être en accord avec quelque chose, satisfaire à une attente, un besoin ou des exigences.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "adequation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce nouveau projet vise à <w>répondre</w> aux besoins des familles du quartier."
                        },
                        {
                            "text": "La qualité de ce produit ne <w>répond</w> pas du tout à nos attentes."
                        }
                    ],
                    "synonyms": [
                        "correspondre",
                        "satisfaire"
                    ],
                    "common_phrases": [
                        "répondre aux besoins",
                        "répondre aux attentes",
                        "répondre aux critères"
                    ]
                },
                {
                    "sense_id": "007da104-308e-3bf1-8696-6300f6f9e3fa",
                    "sense_definition": "Répliquer avec insolence ou contester des remarques ou des ordres.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est mal élevé de <w>répondre</w> à ses parents sur ce ton agressif."
                        },
                        {
                            "text": "L'élève a été puni car il n'arrêtait pas de <w>répondre</w> en classe."
                        }
                    ],
                    "synonyms": [
                        "rétorquer"
                    ],
                    "common_phrases": [
                        "répondre à ses parents"
                    ]
                },
                {
                    "sense_id": "ceed255b-d7d6-3129-9914-9b68727ff69e",
                    "sense_definition": "Se rendre quelque part à la suite d'un appel ou d'une invitation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "reaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nombreux bénévoles ont décidé de <w>répondre</w> à l'appel de solidarité."
                        },
                        {
                            "text": "Nous serons ravis de <w>répondre</w> à votre invitation pour la fête."
                        }
                    ],
                    "common_phrases": [
                        "répondre à l'appel",
                        "répondre à une invitation"
                    ]
                },
                {
                    "sense_id": "3d2c4d74-9254-3185-917b-462f84520388",
                    "sense_definition": "Fonctionner et réagir aux ordres d'un utilisateur ou à une action extérieure.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "reaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon écran d'ordinateur est figé et le programme ne <w>répond</w> plus du tout."
                        },
                        {
                            "text": "Après la chute, les freins du vélo ne <w>répondaient</w> plus correctement."
                        }
                    ],
                    "synonyms": [
                        "réagir"
                    ],
                    "common_phrases": [
                        "ne plus répondre"
                    ]
                },
                {
                    "sense_id": "847022ff-9c79-3810-80b1-e56f49e80d51",
                    "sense_definition": "Assumer la responsabilité de quelqu'un ou de quelque chose, en garantir l'issue ou la sécurité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "garantie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque citoyen majeur doit être prêt à <w>répondre</w> de ses actes."
                        },
                        {
                            "text": "Je connais bien mon collègue et je peux personnellement <w>répondre</w> de lui."
                        }
                    ],
                    "synonyms": [
                        "garantir"
                    ],
                    "common_phrases": [
                        "répondre de ses actes",
                        "répondre de tout"
                    ]
                },
                {
                    "sense_id": "fe411bff-9015-3029-a296-aadbe7bb8e8f",
                    "sense_definition": "Porter un nom ou réagir à une dénomination particulière.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "identification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chien égaré dans le parc du château <w>répond</w> au nom de Caramel."
                        },
                        {
                            "text": "L'individu recherché par la police <w>répondait</w> au nom de Gérard."
                        }
                    ],
                    "synonyms": [
                        "s'appeler"
                    ],
                    "common_phrases": [
                        "répondre au nom de"
                    ]
                }
            ]
        }
    ]
}