                "senses": [
                    {
                        "sense_id": "0157d665-b061-3da2-8adc-0e0f3273cca2",
                        "entry_id": "5621910e-9630-3515-a3a9-c806afb2f3a2",
                        "glosses": [
                            "Publikationsform, die Daten in Echtzeit darstellt oder überträgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ab86240-cd64-48db-a5d6-98af7bfd54de",
                                "sense_id": "0157d665-b061-3da2-8adc-0e0f3273cca2",
                                "text": "„Auch wenn - im Vergleich zu den Echtzeitmedien Radio und Fernsehen - die Berichterstattung von Tageszeitungen regelmäßig um einen Tag hinterherhinkt, bleibt sie doch neben ihrer lokal und national geprägten Ausrichtung an zeitlicher Aktualität orientiert.“"
                            },
                            {
                                "example_id": "fd1a3c77-f854-4cc8-b6d4-e5d5f67cb45d",
                                "sense_id": "0157d665-b061-3da2-8adc-0e0f3273cca2",
                                "text": "„Der Ticker kommt einem Echtzeitmedium nahe, da es die Informationen aus dem Börsengebäude mit nur wenigen Sekunden Verspätung an eine beliebige Anzahl von Empfangsstationen übermittelt.“"
                            },
                            {
                                "example_id": "8aec78ec-7d95-43fe-a732-4d9661eb846c",
                                "sense_id": "0157d665-b061-3da2-8adc-0e0f3273cca2",
                                "text": "„Als weiteres Echtzeitmedium erhöhte der Börsenticker die Geschwindigkeit der Finanzkommunikation und verband die Echtzeitkommunikation mit einem kontinuierlichen Kommunikationsmodus während der Börsenöffnungszeiten.“"
                            },
                            {
                                "example_id": "6a84ca17-f8f0-4f21-bb16-d838ee5b8f2f",
                                "sense_id": "0157d665-b061-3da2-8adc-0e0f3273cca2",
                                "text": "„Dagegen steht die aufgeblasene Verdachtsberichterstattung, in der sich Echtzeitmedien wie soziale Netzwerke durch horrende Fehlerquoten als Fluch erweisen und nicht als Segen.“"
                            },
                            {
                                "example_id": "0c4b87a6-9c53-4fd8-9dcd-52c03ce0ad5f",
                                "sense_id": "0157d665-b061-3da2-8adc-0e0f3273cca2",
                                "text": "„Zwar steht außer Frage, dass in Zeiten des Internet und der Echtzeitmedien dieser Verständnishorizont nicht mehr einfach als gegeben hingenommen und stattdessen zunehmend in seiner kulturellen Konstruiertheit und […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
