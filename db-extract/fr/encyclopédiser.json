                "senses": [
                    {
                        "sense_id": "acbfd899-95d4-3a16-866d-a283f98bc96b",
                        "entry_id": "275a6d1d-db21-38e1-a847-fbdaaccd5cc0",
                        "glosses": [
                            "Donner un caractère encyclopédique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ceb9c21-e243-43f6-af67-1d314b32debc",
                                "sense_id": "acbfd899-95d4-3a16-866d-a283f98bc96b",
                                "text": "Les Larousse ont tendance à encyclopédiser leur dictionnaire de français."
                            },
                            {
                                "example_id": "c9ad5b78-276e-436a-8f51-3b01d7e75c24",
                                "sense_id": "acbfd899-95d4-3a16-866d-a283f98bc96b",
                                "text": "Avec l'encyclopédie, la civilisation se livre à la tentation d'embrasser le « monde univers » et le cycle entier du savoir pour l'« encyclopédiser » ;"
                            },
                            {
                                "example_id": "60e9ab54-7e89-4af6-ad6d-9ac8861a4b5f",
                                "sense_id": "acbfd899-95d4-3a16-866d-a283f98bc96b",
                                "text": "Les écrits sont peut-être trop \"lyriques\", mais je suis ouvert à toutes propositions pour les encyclopédiser."
                            }
                        ]
                    }
