                "senses": [
                    {
                        "sense_id": "ddfd1be0-7508-3061-b0e8-ce1dda1b7306",
                        "entry_id": "ab709432-cd23-3490-8376-40020d475d6e",
                        "glosses": [
                            "speziell ausgebildeter Haushund, der Rettungshilfskräfte bei der Suche nach Vermissten und Verunglückten in der Fläche, in Trümmern, in Lawinen, in Gewässern oder in anderen kritischen Lagen unterstützt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c725822f-4134-4eda-b38e-f8186ae30392",
                                "sense_id": "ddfd1be0-7508-3061-b0e8-ce1dda1b7306",
                                "text": "„Obwohl der Hund bereits seit Jahrtausenden Haus- und Arbeitstier des Menschen ist, sind Rettungshunde eine recht moderne Erscheinung.“"
                            },
                            {
                                "example_id": "bcfe2e9a-d6ed-499b-bdf2-fbec2dce5599",
                                "sense_id": "ddfd1be0-7508-3061-b0e8-ce1dda1b7306",
                                "text": "„Die Mannschaft bestehe aus 41 überwiegend ehrenamtlichen Helfern und drei Rettungshunden.“"
                            },
                            {
                                "example_id": "18759c45-6ae5-4a06-a8c0-06d74c2c9597",
                                "sense_id": "ddfd1be0-7508-3061-b0e8-ce1dda1b7306",
                                "text": "„Ein Rettungshund und sein Herrchen suchen nach dem Unwetter in Trümmern nach Überlebenden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
