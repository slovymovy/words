                    },
                    {
                        "form_id": "b4130831-86b9-40b4-be8f-59246fa55156",
                        "entry_id": "740443e5-3db8-3772-b115-183cec1f338d",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kriegsgerichte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b104a464-eb69-3b2e-82ce-fd842b67088c",
                        "entry_id": "740443e5-3db8-3772-b115-183cec1f338d",
                        "glosses": [
                            "Gericht des Militärs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2d2d2b0-3235-494b-8b32-2c00bb32cf43",
                                "sense_id": "b104a464-eb69-3b2e-82ce-fd842b67088c",
                                "text": "„Die Drohung mit dem Kriegsgericht würde ihn kalt lassen.“"
                            },
                            {
                                "example_id": "916e6d81-a9da-40c1-a68c-c1d7d3087206",
                                "sense_id": "b104a464-eb69-3b2e-82ce-fd842b67088c",
                                "text": "„Womöglich ließ er diesen Gedanken nicht zu oder verdrängte ihn, um nicht in Gewissenskonflikte zu geraten – und in Gefahr, denn alleine der Verdacht, dass ein deutscher Soldat mit jemandem aus der Résistance befreundet war, reichte, um vors Kriegsgericht gestellt und zum Tode verurteilt zu werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fbc5e1d6-cbd2-4e3f-9f5b-133dbf831d54",
                        "source_entry_id": "740443e5-3db8-3772-b115-183cec1f338d",
                        "source_sense_id": "b104a464-eb69-3b2e-82ce-fd842b67088c",
                        "source_sense_description": "Gericht des Militärs",
                        "target_lang_word": "cour martiale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cour martiale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b182f5a3-c316-34b7-bf71-0fe3df179ebb",
                                        "entry_id": "969d7ee5-5598-3698-bff7-f510ba17e8ca",
                                        "glosses": [
                                            "Tribunal d’exception qui exerce la justice militaire (principalement en temps de guerre)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "057328f5-9d54-4791-8131-dda481a69307",
                                                "sense_id": "b182f5a3-c316-34b7-bf71-0fe3df179ebb",
                                                "text": "Maintenant c'était la cour martiale, terrifiante à force de simplicité. Une grange vide, une table, les cinq juges sur des chaises de paille ; en face, debout, l'accusé."
                                            },
                                            {
                                                "example_id": "844aab0c-fff4-4cca-bc78-0e82473b2bc2",
                                                "sense_id": "b182f5a3-c316-34b7-bf71-0fe3df179ebb",
                                                "text": "Le 16, la Cour martiale se réunit. Elle refuse à entendre les officiers qui ont demandé à déposer. Ceux qui cherchent à défendre les accusés sont injuriés. Trente-deux hommes sont acquittés, mais les quatre caporaux sont condamnés à mort."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
