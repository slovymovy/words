        "fr-extract.jsonl": [
            {
                "entry_id": "cf5fa578-2357-31ac-9d31-8e1f2bc899f5",
                "word": "gueuleton",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c63481e4-1865-4b97-afda-41e7af88091c",
                        "entry_id": "cf5fa578-2357-31ac-9d31-8e1f2bc899f5",
                        "tags": [
                            "plural"
                        ],
                        "form": "gueuletons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c1d43bdb-9e20-3540-ba1f-50bd78c9c9ce",
                        "entry_id": "cf5fa578-2357-31ac-9d31-8e1f2bc899f5",
                        "glosses": [
                            "Repas gai et copieux ; partie de table."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "92bba3a2-7414-46e8-a9cd-18df020dbf22",
                                "sense_id": "c1d43bdb-9e20-3540-ba1f-50bd78c9c9ce",
                                "text": "Le salaud ! Il se payait d’un autre côté… sur la bête, comme on dit là-bas, sans compter les repas, les petits gueuletons intimes où lui, le vieux, n’était sûrement pas convié."
                            },
                            {
                                "example_id": "d2826f70-ec47-4a1c-8582-a4381ab8aa13",
                                "sense_id": "c1d43bdb-9e20-3540-ba1f-50bd78c9c9ce",
                                "text": "À table, au château, le curé se plaint d’avoir dû faire dissoudre la rustique confrérie de Notre-Dame-de-la-Chandelle, dont les revenus, dépensés tout entiers en gueuletons, n’amenaient plus que débauche et scandale, et Monsieur et Madame s'accordent à déplorer avec lui la goinfrerie villageoise."
                            },
                            {
                                "example_id": "08de80cd-678f-46ba-a871-dcf63c585fd7",
                                "sense_id": "c1d43bdb-9e20-3540-ba1f-50bd78c9c9ce",
                                "text": "Et à l'été de la Saint-Martin, l'oie est à point. Et l'oie, on s'en fourrait jusque-là, même les morceaux honteux. Et pas que l'oie, d'ailleurs. Du potage gras, et des huîtres aux saucisses truffées, et du rôti à la ficelle, et des crèmes fines ! Et des petits choux ! Quel gueuleton !"
                            },
                            {
                                "example_id": "aae5510d-1179-457c-b904-5caeffd42592",
                                "sense_id": "c1d43bdb-9e20-3540-ba1f-50bd78c9c9ce",
                                "text": "Dit autrement, le gueuleton bien arrosé du bon vivant, amateur de viande et de cigare, n'a pas son équivalent chez l'adepte de la graine germée et du tofu mariné à la sauce soja."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55f3b3e7-bde3-4c35-97e6-9a0d606648bf",
                        "source_entry_id": "cf5fa578-2357-31ac-9d31-8e1f2bc899f5",
                        "source_sense_id": "c1d43bdb-9e20-3540-ba1f-50bd78c9c9ce",
                        "target_lang_word": "Festessen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Festessen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ec1d065d-b716-3d60-b5fb-dc12c5bf8cf2",
                                        "entry_id": "12712ca6-c24f-3f08-b79f-ffadbda9c2a5",
                                        "glosses": [
                                            "besonders gutes, aufwendiges, festliches Essen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f991a53-2817-4cb3-8515-dc90d2974aa3",
                                                "sense_id": "ec1d065d-b716-3d60-b5fb-dc12c5bf8cf2",
                                                "text": "Die Mutter des Hauses hat ein Festessen gekocht."
                                            },
                                            {
                                                "example_id": "041b25e6-027c-4d27-9919-24834fe9cb6c",
                                                "sense_id": "ec1d065d-b716-3d60-b5fb-dc12c5bf8cf2",
                                                "text": "„Einige Tage nach dem Festessen bei den Arkesdens kehrten Lucas und Barbara nach einer Fahrt durch das Marschland zum Haus ihrer Eltern zurück.“"
                                            },
                                            {
                                                "example_id": "ee155fcf-28b5-4f0b-9143-f29658698fe6",
                                                "sense_id": "ec1d065d-b716-3d60-b5fb-dc12c5bf8cf2",
                                                "text": "„Das Festessen war Vals Idee gewesen, als Dankeschön für Barons Gastfreundschaft.“"
                                            },
                                            {
                                                "example_id": "bea2228d-6610-4332-b5a0-478f4b4ee87c",
                                                "sense_id": "ec1d065d-b716-3d60-b5fb-dc12c5bf8cf2",
                                                "text": "„Ein Fest ohne Festessen verdient seinen Namen nicht, es ist zum Scheitern verurteilt.“"
                                            },
                                            {
                                                "example_id": "81f68588-92b6-4bad-bab4-7ce3febb06ec",
                                                "sense_id": "ec1d065d-b716-3d60-b5fb-dc12c5bf8cf2",
                                                "text": "Das Ehepaar lädt zum Festessen."
                                            },
                                            {
                                                "example_id": "157bc23e-b12a-4476-a1f4-ce56cf0936f4",
                                                "sense_id": "ec1d065d-b716-3d60-b5fb-dc12c5bf8cf2",
                                                "text": "Das ist ja ein wahres Festessen!"
                                            },
                                            {
                                                "example_id": "56716240-cfb6-4775-8f75-154e20c18a2b",
                                                "sense_id": "ec1d065d-b716-3d60-b5fb-dc12c5bf8cf2",
                                                "text": "„Sie hatten die meisten Esswaren herausgeholt und diese, da sie anscheinend ein Festessen vorbereiten wollten, auf einem glatten Stein ausgebreitet.“"
                                            },
                                            {
                                                "example_id": "83f1f15c-95fb-41a2-be3a-2c0df497b6de",
                                                "sense_id": "ec1d065d-b716-3d60-b5fb-dc12c5bf8cf2",
                                                "text": "„Alles war für das Festessen vorbereitet, das Tier getötet, ausgenommen und bratfertig, als wir feststellten, dass der Backofen zu klein war für den imposanten Fisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1bd03673-8f1d-4cbc-a712-725f647c610d",
                        "source_entry_id": "cf5fa578-2357-31ac-9d31-8e1f2bc899f5",
