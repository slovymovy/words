                "senses": [
                    {
                        "sense_id": "fdc652ea-3b45-337a-b7e6-fa3d8a4d15c6",
                        "entry_id": "92c598fb-b07e-3c77-b375-f935c2b20509",
                        "glosses": [
                            "de manier waarop iemand een andere persoon behandelt bij een ontmoeting; de manier waarop je met een ander omgaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e251066c-8f71-4976-84d8-04e938c95892",
                                "sense_id": "fdc652ea-3b45-337a-b7e6-fa3d8a4d15c6",
                                "text": "De bejegening van onze veteranen vraagt om (h)erkenning, waardering en zorg, stelde Bijleveld woensdag voor een internationaal gehoor van organisaties en hulpverleners. „Maar de juiste vorm van erkenning is goede zorg.”"
                            },
                            {
                                "example_id": "e4fb8a30-f5f5-4f8e-b0c0-4705f46b8dc1",
                                "sense_id": "fdc652ea-3b45-337a-b7e6-fa3d8a4d15c6",
                                "text": "In 2001 trok Venus zich enkele minuten voor de halve finale tegen haar zus terug met knieklachten. Het leidde tot fikse kritiek en een vijandige bejegening van Serena in de finale, terwijl ook vader Richard Williams en Venus werden uitgejouwd."
                            },
                            {
                                "example_id": "b5570478-8aa5-4c28-b3bd-c27029637c64",
                                "sense_id": "fdc652ea-3b45-337a-b7e6-fa3d8a4d15c6",
                                "text": "Van der Veer deelt ook uit: ,,Het helpt niet als men maar blijft napapegaaien hoe erg die bankiers zijn.” In zijn slotwoord noemt Van der Veer de bejegening door het parlement ‘tamelijk agressief’, wat tot rollende ogen aan de andere kant van de tafel leidt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
