                        "examples": [
                            {
                                "example_id": "8535bac9-d35f-43a8-a341-7338c0554410",
                                "sense_id": "459c6955-162e-3fb2-b9ad-614f6db7fa3a",
                                "text": "Dans les marais salants de Guérande, le paludier cueille la fleur de sel, le salicornier la salicorne."
                            },
                            {
                                "example_id": "98d396bc-9eef-4432-b597-1e78db5b1b73",
                                "sense_id": "459c6955-162e-3fb2-b9ad-614f6db7fa3a",
                                "text": "On peut ainsi observer les oiseaux qui vivent dans les marais, découvrir les plantes qui s'y développent ou rencontrer un salicornier."
                            },
                            {
                                "example_id": "a14e77f6-9a1c-483a-bf70-f10c3c1e054e",
                                "sense_id": "459c6955-162e-3fb2-b9ad-614f6db7fa3a",
                                "text": "Propriétaire de la boutique Les Salicorniers, il produit son gros sel et sa fleur de sel sur ses deux hectares et demi."
                            }
                        ]
