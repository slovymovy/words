{
    "word_family": [
        "négligence",
        "négligent",
        "négligeable",
        "négligemment"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "12c15994-d19b-319d-9dd3-55dc0bade2b9",
                    "sense_definition": "Ne pas prendre soin de quelqu'un ou de quelque chose dont on a la charge ou la responsabilité.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "soin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À force de trop travailler, il <w>néglige</w> complètement sa santé et son sommeil."
                        },
                        {
                            "text": "Elle ne doit pas <w>négliger</w> ses études si elle veut réussir son examen de fin d'année."
                        }
                    ],
                    "synonyms": [
                        "délaisser"
                    ],
                    "antonyms": [
                        "soigner"
                    ],
                    "common_phrases": [
                        "négliger sa santé",
                        "négliger ses devoirs",
                        "négliger ses études"
                    ]
                },
                {
                    "sense_id": "d8ad82be-4364-353b-b26b-1e706908022c",
                    "sense_definition": "Laisser de côté, omettre ou ne pas tenir compte d'un élément important.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "omission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans un projet aussi complexe, nous ne pouvons pas <w>négliger</w> un détail crucial."
                        },
                        {
                            "text": "L'architecte a <w>négligé</w> certains aspects de sécurité lors de la conception du bâtiment."
                        }
                    ],
                    "synonyms": [
                        "omettre",
                        "ignorer"
                    ],
                    "antonyms": [
                        "considérer"
                    ],
                    "common_phrases": [
                        "négliger un détail",
                        "négliger un aspect"
                    ]
                },
                {
                    "sense_id": "d2dfd5fa-39ec-300c-a6fc-979bc8f9c784",
                    "sense_definition": "Cesser de prendre soin de son corps, de sa propreté ou de sa tenue vestimentaire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "apparence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis qu'il vit seul dans son appartement, il a tendance à se <w>négliger</w>."
                        },
                        {
                            "text": "Épuisée par son quotidien difficile, elle a fini par se <w>négliger</w> pendant plusieurs semaines."
                        }
                    ],
                    "synonyms": [
                        "se laisser aller"
                    ],
                    "antonyms": [
                        "se soigner"
                    ],
                    "common_phrases": [
                        "se négliger"
                    ]
                },
                {
                    "sense_id": "22af204d-962f-309b-aec8-fbf730146344",
                    "sense_definition": "Faire preuve de moins d'exactitude ou de rigueur dans son travail ou ses devoirs habituels.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "travail",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet artisan autrefois très minutieux se <w>néglige</w> depuis quelque temps dans ses finitions."
                        },
                        {
                            "text": "Si vous vous <w>négligez</w> dans la rédaction de ces rapports, la direction le remarquera rapidement."
                        }
                    ],
                    "synonyms": [
                        "se relâcher"
                    ],
                    "antonyms": [
                        "s'appliquer"
                    ]
                },
                {
                    "sense_id": "7f4a4f6f-4f32-32d7-bf2e-c3e88ada7bba",
                    "sense_definition": "Omettre une quantité minime dans un calcul d'approximation car elle n'altère pas le résultat.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "calcul",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cette formule de physique élémentaire, on peut <w>négliger</w> la résistance de l'air."
                        },
                        {
                            "text": "Le professeur a expliqué pourquoi il était acceptable de <w>négliger</w> ces faibles variations."
                        }
                    ],
                    "synonyms": [
                        "omettre"
                    ]
                }
            ]
        }
    ]
}