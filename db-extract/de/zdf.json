                        "examples": [
                            {
                                "example_id": "c397055a-b8ad-4343-959d-f494d3ee4ff1",
                                "sense_id": "96375019-c836-3eab-b609-bc070eaae23c",
                                "text": "Das ZDF hat seinen Hauptsitz in Mainz."
                            },
                            {
                                "example_id": "acdf92ce-e130-48ca-86b5-9347a61c1e8b",
                                "sense_id": "96375019-c836-3eab-b609-bc070eaae23c",
                                "text": "Im ZDF läuft eine neue Krimiserie."
                            },
                            {
                                "example_id": "dd7344da-c46c-4e52-a3e2-a0166b9b5aa2",
                                "sense_id": "96375019-c836-3eab-b609-bc070eaae23c",
                                "text": "„Sie dürfen auch nicht in die Programmautonomie von ARD und ZDF eingreifen.“"
                            },
                            {
                                "example_id": "e840f84a-a1e4-4838-afbd-8f99bf422dbd",
                                "sense_id": "96375019-c836-3eab-b609-bc070eaae23c",
                                "text": "„1988, zum 90. Geburtstag des Autors, produzierte jedoch das ZDF eine Fernsehversion.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
