                ],
                "senses": [
                    {
                        "sense_id": "2b07f5aa-df8c-34c0-8151-15b17b732b20",
                        "entry_id": "b83eb5ea-8a34-3d3c-9c2f-05188c135093",
                        "glosses": [
                            "een geluidstechnisch apparaat dat een of meer frequentiegebieden (banden) van het signaal versterkt of verzwakt, opdat de balans tussen de banden, en dus het timbre, naar wens kan worden aangepast"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e499e5c-5231-4983-8069-210a103179b2",
                                "sense_id": "2b07f5aa-df8c-34c0-8151-15b17b732b20",
                                "text": "SteelSeries heeft ook nog even software waarmee je de geluidskwaliteit kunt aanpassen via een equalizer. Het is niet verplicht, maar het biedt wel wat meer opties, wat natuurlijk een pré is."
                            },
                            {
                                "example_id": "2d2797a7-920d-44c5-a8dd-a7ceac66e9b8",
                                "sense_id": "2b07f5aa-df8c-34c0-8151-15b17b732b20",
                                "text": "Hij is dan al bijzonder rijk uitgerust met onder meer led-koplampen, het Canton audiosysteem (met 10 luidsprekers, digitale equalizer en subwoofer), vermoeidheidswaarschuwing, radiografische contactsleutel (voor portieren en startsysteem), 17 inch lichtmetalen wielen, twee jaar abonnement voor de smartphone-app (Skoda Connected Car Module), mistlampen vóór, het centrale 9,2 inch scherm voor het infotainment met navigatie en smarthone-koppeling, een jaar online entertainment, wifi-hotspot, parkeersensoren voor en achter en verwarmbare voorstoelen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c4fefdc-bbea-464c-b4e0-db55c3daf434",
                        "source_entry_id": "b83eb5ea-8a34-3d3c-9c2f-05188c135093",
                        "source_sense_id": "2b07f5aa-df8c-34c0-8151-15b17b732b20",
                        "target_lang_word": "equalizer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "equalizer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d7904e9-ae80-3fd2-8816-89a4e13cbbf5",
                                        "entry_id": "5a022867-9417-314c-ab8a-bda4af0737cc",
                                        "glosses": [
                                            "One who makes equal; a balancer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47621ae1-1824-4860-8540-d9506c5b308a",
                                                "sense_id": "9d7904e9-ae80-3fd2-8816-89a4e13cbbf5",
                                                "text": "Death is the great equalizer."
                                            },
                                            {
                                                "example_id": "e039b03b-f0a4-44ed-80b4-99e6f5df2df2",
                                                "sense_id": "9d7904e9-ae80-3fd2-8816-89a4e13cbbf5",
                                                "text": "The Internet serves as an equalizer of sorts against common discriminations based on race, gender and age. You have to^([sic]) the opportunity to assess someone based on what they are saying, not WHO is saying it. I think this can provide for some very worthwhile exchanges and allow people who might not do so otherwise, to come to know each other. The downside is that as they say, on the Internet, nobody knows you're a dog. You can lie or say whatever you want and hide behind anonymity."
                                            },
                                            {
                                                "example_id": "3aabdec5-8f09-4bf4-a8ff-a4549880563d",
                                                "sense_id": "9d7904e9-ae80-3fd2-8816-89a4e13cbbf5",
                                                "text": "Practically, it can be seen clearly that weeder courses are not equalizers. In fact, they exacerbate inequality and continue to push wealthy and privileged students to the top while putting down minority and low-income students."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c53f3a92-3965-3c47-aa11-fe2707234396",
                                        "entry_id": "5a022867-9417-314c-ab8a-bda4af0737cc",
                                        "glosses": [
                                            "A device that balances various quantities."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d9d7310f-c207-314b-b2b9-63e512483c20",
                                        "entry_id": "5a022867-9417-314c-ab8a-bda4af0737cc",
                                        "glosses": [
                                            "A goal, run, point, etc. that equalizes the score."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d3835cd-3140-4eaa-ba2a-51d696f0a8e5",
                                                "sense_id": "d9d7310f-c207-314b-b2b9-63e512483c20",
                                                "text": "[Bendtner was central to it at all, firstly firing home, via a deflection off Gareth McAuley, after being teed up by Sebastien Larsson's neat backheel, and then a minute later crossing for Elmohamady to head in an equaliser."
                                            },
                                            {
                                                "example_id": "85f20d25-e461-4f6c-b7e3-0d24ea3a149b",
                                                "sense_id": "d9d7310f-c207-314b-b2b9-63e512483c20",
                                                "text": "Mariners scored a run in the seventh inning and the equaliser in the top of the ninth, after Braves’ starting pitcher Ashley Crump had dominated—throwing six scoreless innings for just two hits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47d2f4e7-d49f-3e69-8e00-1f42afefa211",
                                        "entry_id": "5a022867-9417-314c-ab8a-bda4af0737cc",
                                        "glosses": [
                                            "An electronic audio device for altering the frequencies of sound recordings."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d33d8611-51ec-44cb-9142-c12ed612b90d",
                                                "sense_id": "47d2f4e7-d49f-3e69-8e00-1f42afefa211",
                                                "text": "Several digital effects are supported by Deck, ranging from a digital equalizer, which lets you accentuate or attenuate certain frequencies, to a stereoizer, which processes a mono- phonic recording to simulate stereo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32c37b34-5b44-396f-a08c-5df13678ca42",
                                        "entry_id": "5a022867-9417-314c-ab8a-bda4af0737cc",
                                        "glosses": [
                                            "A device, such as a bar, for operating two brakes, especially a pair of hub brakes for an automobile, with equal force."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3163c9c8-ea00-3788-afd6-e95ea9c41eca",
                                        "entry_id": "5a022867-9417-314c-ab8a-bda4af0737cc",
                                        "glosses": [
                                            "Any device for equalizing the pull of electromagnets."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "25cde6cb-0dc7-37dc-b89c-916661298ee5",
                                        "entry_id": "5a022867-9417-314c-ab8a-bda4af0737cc",
                                        "glosses": [
                                            "A conductor of low resistance joining the armature ends of the series field coils of dynamos connected in parallel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac2f9539-d62a-3382-b70b-af9212373468",
                                        "entry_id": "5a022867-9417-314c-ab8a-bda4af0737cc",
                                        "glosses": [
                                            "A sliding panel to preserve the lateral stability of an aeroplane."
