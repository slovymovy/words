                "senses": [
                    {
                        "sense_id": "e735c1c2-b71a-3902-a4fb-949c5f11d131",
                        "entry_id": "9bec7283-0db6-3c64-a38d-dbc8bb1c1c09",
                        "glosses": [
                            "Wort, das in einer Sprache gebildet ist, aber so geformt ist, als wäre es ein Wort einer anderen Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "721a2729-5a57-4cae-8850-00996c7895be",
                                "sense_id": "e735c1c2-b71a-3902-a4fb-949c5f11d131",
                                "text": "„Scheinentlehnungen werden im Rahmen der Anglizismenforschung auch Sekundärentlehnungen (…), Falschentlehnungen (…), Pseudoanglizismen (…), Pseudoentlehnungen (…) oder Geisterwörter (…) genannt.“"
                            },
                            {
                                "example_id": "8f1e47b1-4869-421a-8d18-07e29a720397",
                                "sense_id": "e735c1c2-b71a-3902-a4fb-949c5f11d131",
                                "text": "„Die Pseudoentlehnung oder auch Scheinentlehnung führt den Menschen hinters Licht.“"
                            },
                            {
                                "example_id": "a5649728-8671-4377-a3a4-37747b669049",
                                "sense_id": "e735c1c2-b71a-3902-a4fb-949c5f11d131",
                                "text": "„Auch die Pseudoentlehnung Twen wird statt mit der englischen mit der deutschen Aussprache [tven] ausgesprochen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
