                "senses": [
                    {
                        "sense_id": "05803095-c36b-3ad4-b8db-464fe5d761be",
                        "entry_id": "dca81af3-898d-3389-b58b-e397f1cf2794",
                        "glosses": [
                            "Façon de vivre propre aux otakus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9c87bee-5eb1-4e9a-afe6-0fa68f9f0532",
                                "sense_id": "05803095-c36b-3ad4-b8db-464fe5d761be",
                                "text": "Phénomène paradoxal, l’« otakisme » exprime autant un rejet de la société japonaise, dominée par l’information et l’image, qu’une dépendance maladive à l’égard de celle-ci."
                            },
                            {
                                "example_id": "798f44e9-3163-4d98-8633-a272e66a15bf",
                                "sense_id": "05803095-c36b-3ad4-b8db-464fe5d761be",
                                "text": "L’otakisme à la française se révèle fondamentalement différent de l’otakisme japonais, puisqu’il n’inclut pas de phénomène de cyberdépendance."
                            },
                            {
                                "example_id": "16b4a2a2-d7f9-4c0e-a4ad-ff0ed37ee478",
                                "sense_id": "05803095-c36b-3ad4-b8db-464fe5d761be",
                                "text": "Les otakus célèbrent ce 15 décembre leur journée mondiale. L’occasion de s’interroger sur la véritable nature des adorateurs de l’otakisme."
                            }
                        ]
                    }
                ],
