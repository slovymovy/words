                "translations": [
                    {
                        "translation_id": "df49e804-0391-4d01-9e45-49343d1c3ec9",
                        "source_entry_id": "bfc59828-1dfa-38f6-9d2c-16ee3c1ec6ba",
                        "source_sense_id": "343f07a2-421f-3c2b-ac07-a3839690247f",
                        "source_sense_description": "sierlijk bewerkte staf, symbool voor het gezag van een regerende vorst",
                        "target_lang_word": "Zepter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zepter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bb87384c-1b7b-3813-b507-398f03384022",
                                        "entry_id": "4478e575-04c8-313f-bcb6-7c901d0522e9",
                                        "glosses": [
                                            "eines der Reichsinsignien eines Herrschers (Kaiser, König, später Fürst), das er zu seiner Krönung erhält, die Form eines Stabes hat und meist reich mit Edelsteinen verziert ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67535ccd-b5a5-424c-b025-ff19ccc7ae33",
                                                "sense_id": "bb87384c-1b7b-3813-b507-398f03384022",
                                                "text": "„Die Insignien des Königreichs Norwegen, auch Krönungsinsignien genannt, bestehen aus drei Kronen, zwei Zeptern, zwei Reichsäpfeln, dem Reichsschwert und einem Salbungshorn.“"
                                            },
                                            {
                                                "example_id": "18fdd50e-44fb-4246-8561-07cc17e7c5a6",
                                                "sense_id": "bb87384c-1b7b-3813-b507-398f03384022",
                                                "text": "Eine Hand hielt den Schaft des Zepters fest umschlossen, die andere langte nach der zu Boden gefallenen Krone."
                                            },
                                            {
                                                "example_id": "6d77dc8f-3338-46fb-8381-f0a45629df74",
                                                "sense_id": "bb87384c-1b7b-3813-b507-398f03384022",
                                                "text": "„Man hat also Macht, wenn man das Zepter so zu handhaben versteht wie der Pharao oder die Würdenträger des Staates.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "85bf3617-1252-47c7-8583-e46e5f4ebbb7",
                        "source_entry_id": "bfc59828-1dfa-38f6-9d2c-16ee3c1ec6ba",
                        "source_sense_id": "343f07a2-421f-3c2b-ac07-a3839690247f",
                        "source_sense_description": "sierlijk bewerkte staf, symbool voor het gezag van een regerende vorst",
                        "target_lang_word": "sceptre",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sceptre",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "74cd3d37-3c90-36e1-b4b0-9e99a08fa8f9",
                                        "entry_id": "d188cc9a-84e3-39bf-aea3-1e06f2cc516d",
                                        "glosses": [
                                            "An ornamental staff held by a ruling monarch as a symbol of power."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c7cea85-2098-498b-8901-267e2cd2ead5",
                                                "sense_id": "74cd3d37-3c90-36e1-b4b0-9e99a08fa8f9",
                                                "text": "“Divine receptacle of excellence, let it not be deemed impertinent, or deviating from the rules of propriety, if I propound one queſtion which now labours in my breaſt; aſſuring me firſt, you will not let the ſceptre of true judgment depart from your right hand.”"
                                            },
                                            {
                                                "example_id": "92d9dfbf-eedc-48bd-beb2-912a634e87fb",
                                                "sense_id": "74cd3d37-3c90-36e1-b4b0-9e99a08fa8f9",
                                                "text": "To the fleet he came / Bearing rich ranſom glorious to redeem / His daughter, and his hands charged with the wreath / And golden ſceptre of the God shaft-arm’d."
                                            },
                                            {
                                                "example_id": "16c0ecff-4e82-4cad-9793-148db9ab397b",
                                                "sense_id": "74cd3d37-3c90-36e1-b4b0-9e99a08fa8f9",
                                                "text": "But what had occupied him most was the robe he was to wear at his coronation, the robe of tissued gold, and the ruby-studded crown, and the sceptre with its rows and rings of pearls."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sceptre",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ec5faa1-be16-3ae1-a82a-708ac320377d",
                                        "entry_id": "406fbcc1-7c36-3d42-a120-12fbbcf84792",
                                        "glosses": [
                                            "To give a sceptre to."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cd982d9-ee90-4870-9ab7-c81efb9dc902",
                                                "sense_id": "4ec5faa1-be16-3ae1-a82a-708ac320377d",
                                                "text": "To Britain's queen the sceptred suppliant bends."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23da19bc-e4db-3e03-b40a-5f0ef0fa9f2f",
                                        "entry_id": "406fbcc1-7c36-3d42-a120-12fbbcf84792",
                                        "glosses": [
                                            "To invest with royal power."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "93c41a15-c4e3-42e4-bd56-6dd4683ec24e",
