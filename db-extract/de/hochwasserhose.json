                ],
                "senses": [
                    {
                        "sense_id": "016ffaff-7a37-34c6-b0c9-df494015e00d",
                        "entry_id": "3ecb9a2b-91fe-307a-8d5a-e6812aa37f71",
                        "glosses": [
                            "Hose, die deutlich über dem Knöchel endet und deshalb als zu kurz angesehen wird"
                        ],
                        "tags": [
                            "colloquial",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "8f9d43f2-47c0-4255-a915-ba69cea7d12a",
                                "sense_id": "016ffaff-7a37-34c6-b0c9-df494015e00d",
                                "text": "Mutter zum Sohn: »Du läufst in Hochwasserhosen herum, du musst schon wieder gewachsen sein. Heute nachmittag kaufen wir dir neue Hosen!«"
                            },
                            {
                                "example_id": "72abc3cf-0a78-4fd3-b912-2dfbe2e8989a",
                                "sense_id": "016ffaff-7a37-34c6-b0c9-df494015e00d",
                                "text": "„„Norman“ trug stets einen schlecht sitzenden Anzug mit Hochwasserhosen, zerknittertem Kragen, schiefer Krawatte und grauer Tweed-Schirmmütze.“"
                            },
                            {
                                "example_id": "65f3a630-c83e-4e9b-be31-592f48834022",
                                "sense_id": "016ffaff-7a37-34c6-b0c9-df494015e00d",
                                "text": "„Getragen wurden jene Hochwasserhosen von frechen kleinen Stöpseln, Typus Michel aus Lönneberga […]“"
                            },
                            {
                                "example_id": "57694ad7-0be0-45ef-9728-f107a5bad4fa",
                                "sense_id": "016ffaff-7a37-34c6-b0c9-df494015e00d",
                                "text": "[Schlagzeile:] „Hochwasserhosen sind nun auch an kalten Tagen im Trend“"
                            },
                            {
                                "example_id": "1f8c57eb-4031-43bf-910a-cb058625b4a9",
                                "sense_id": "016ffaff-7a37-34c6-b0c9-df494015e00d",
                                "text": "„Hulot, stets mit zu kurz geschnittenem Mantel, Hochwasserhosen, einem albernen Hütchen und Regenschirm ausgestattet, wurde zu einer ikonografischen Figur des französischen Kinos.“"
                            },
                            {
                                "example_id": "e2bc8027-4065-4330-9188-0b58c31aca3a",
                                "sense_id": "016ffaff-7a37-34c6-b0c9-df494015e00d",
                                "text": "„Ihre in einem helleren Blauton gehaltenen Hochwasserhosen werden von gelben Hosenträgern gestützt.“"
                            },
                            {
                                "example_id": "6a60fdc4-1b59-42b6-9b90-96a2b526e964",
                                "sense_id": "016ffaff-7a37-34c6-b0c9-df494015e00d",
                                "text": "„»Diese Weiber laufen heutzutage rum wie die Kasperl,« musste sie [Anmerkung: Eva-Maria Hagen] sich als junges Mädchen wegen der damals in Mode gekommenen Ringelsocken und den Hochwasserhosen hinterherrufen lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
