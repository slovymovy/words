                                "target_senses": [
                                    {
                                        "sense_id": "2e70df63-350a-3917-88e4-480e235ea209",
                                        "entry_id": "99926fd4-6be3-35c8-9d11-901014e3f16e",
                                        "glosses": [
                                            "Gartengerät zum Auflockern der Erde"
                                        ],
                                        "tags": [
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a39bd1eb-ed4f-4f0f-b780-47f95fa2c902",
                                                "sense_id": "2e70df63-350a-3917-88e4-480e235ea209",
                                                "text": "Wir bekämpfen das Unkraut noch mit der Hacke."
                                            },
                                            {
                                                "example_id": "62ef5546-f0db-4350-a713-b4f90e3ff45a",
                                                "sense_id": "2e70df63-350a-3917-88e4-480e235ea209",
                                                "text": "„Bertram zog eine Hacke aus dem Rucksack.“"
                                            },
                                            {
                                                "example_id": "1fe89595-8101-42b2-8bbd-bbd3b60a0ba4",
                                                "sense_id": "2e70df63-350a-3917-88e4-480e235ea209",
                                                "text": "„Die Frau stellt ihre Hacke beiseite, das Unkraut im Salat bleibt einstweilen von der Ausrottung verschont, und auf einem Pfad hinter den Hausgärten entlang werde ich bis dicht vor mein Ziel geleitet.“"
                                            },
                                            {
                                                "example_id": "316b2907-060b-4900-bc7e-4bbf11006573",
                                                "sense_id": "2e70df63-350a-3917-88e4-480e235ea209",
                                                "text": "„Denn selber Frühaufsteher, sah er, so früh er auch aufstand, seinen Pächter schon immer ungewaschen und ungekämmt mit Hacke und Spaten und Sichel emsig bei der Arbeit.“"
                                            },
                                            {
                                                "example_id": "6c83d964-931a-46fd-b466-2b369c0e3043",
                                                "sense_id": "2e70df63-350a-3917-88e4-480e235ea209",
                                                "text": "„Der Bauer wiederum öffnet mit der Hacke die Erde, um sie fruchtbar zu machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "db89bfc2-b6fe-3d5c-9796-da18fa20dd20",
                                        "entry_id": "99926fd4-6be3-35c8-9d11-901014e3f16e",
