{
    "word_family": [
        "gentle",
        "gentility",
        "gentleman"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "91b8dc7d-9762-3c05-8be0-6dd28efb5c11",
                    "sense_definition": "People of high social standing, wealth, or good breeding, especially landowners just below the nobility.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "social_class",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>gentry</w> often gathered at the country estate for seasonal hunts and dinners.",
                            "target_lang_translations": {
                                "ru": "Местное <w>дворянство</w> часто собиралось в загородном поместье на сезонные охоты и обеды."
                            }
                        },
                        {
                            "text": "Historically, the landed <w>gentry</w> held significant political influence in rural areas.",
                            "target_lang_translations": {
                                "ru": "Исторически класс поместного <w>джентри</w> обладал значительным политическим влиянием в сельских районах."
                            }
                        }
                    ],
                    "synonyms": [
                        "the quality"
                    ],
                    "common_phrases": [
                        "landed gentry",
                        "rural gentry",
                        "local gentry"
                    ],
                    "target_lang_definitions": {
                        "ru": "Люди высокого социального положения, богатые землевладельцы (особенно нетитулованное дворянство в Англии)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "джентри",
                                "target_lang_sense_clarification": "нетитулованное мелкопоместное дворянство в Англии"
                            },
                            {
                                "target_lang_word": "мелкопоместное дворянство",
                                "target_lang_sense_clarification": "дворяне-землевладельцы"
                            },
                            {
                                "target_lang_word": "знать",
                                "target_lang_sense_clarification": "высший слой общества, аристократия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "125938b0-1bca-36b1-9f61-86776e223d63",
                    "sense_definition": "Noble birth, high social condition, or rank inherited by birth.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "social_class",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His undeniable <w>gentry</w> was recognized immediately despite his simple attire.",
                            "target_lang_translations": {
                                "ru": "Его неоспоримое <w>благородное происхождение</w> признавалось сразу, несмотря на простую одежду."
                            }
                        },
                        {
                            "text": "Old records spoke of the knight's ancient <w>gentry</w> and proud lineage.",
                            "target_lang_translations": {
                                "ru": "Старинные записи говорили о древней <w>знатности</w> рыцаря и его гордой родословной."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English to describe rank of birth"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Благородное происхождение, знатность рода (устаревшее значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "благородное происхождение",
                                "target_lang_sense_clarification": "знатность, принадлежность к дворянскому роду"
                            },
                            {
                                "target_lang_word": "знатность",
                                "target_lang_sense_clarification": "высокий социальный статус по рождению"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb9e6ef0-0611-3251-a76f-8bb498d79e78",
                    "sense_definition": "Courteous or civil behavior; polite and well-mannered conduct.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He thanked his gracious hosts with extraordinary modesty and <w>gentry</w>.",
                            "target_lang_translations": {
                                "ru": "Он поблагодарил радушных хозяев с необычайной скромностью и <w>учтивостью</w>."
                            }
                        },
                        {
                            "text": "Such rare display of <w>gentry</w> won the respect of everyone present at court.",
                            "target_lang_translations": {
                                "ru": "Такое редкое проявление <w>благовоспитанности</w> снискало уважение всех присутствовавших при дворе."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Used historically to describe courtesy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Учтивость, вежливость, благовоспитанность (устаревшее значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "учтивость",
                                "target_lang_sense_clarification": "вежливость, благородство манер"
                            },
                            {
                                "target_lang_word": "благовоспитанность",
                                "target_lang_sense_clarification": "хорошие манеры"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "d9f776ef-5744-3fae-b04e-2aaa68517321",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "proper_names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Gentry</w> will be leading the architecture workshop tomorrow morning.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Джентри</w> проведёт архитектурный мастер-класс завтра утром."
                            }
                        },
                        {
                            "text": "We read a historical study written by Professor <w>Gentry</w>.",
                            "target_lang_translations": {
                                "ru": "Мы прочитали историческое исследование, написанное профессором <w>Джентри</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английская фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Джентри",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "394a7c88-5791-3f23-b1ea-1b1beb6d874a",
                    "sense_definition": "A city in Benton County, Arkansas, United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "proper_names",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They decided to settle down and purchase a farm in <w>Gentry</w>, Arkansas.",
                            "target_lang_translations": {
                                "ru": "Они решили обосноваться и купить ферму в <w>Джентри</w>, штат Арканзас."
                            }
                        },
                        {
                            "text": "We drove through the scenic downtown area of <w>Gentry</w> during our trip.",
                            "target_lang_translations": {
                                "ru": "Во время нашей поездки мы проехали через живописный центр города <w>Джентри</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Город в округе Бентон, штат Арканзас, США."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Джентри",
                                "target_lang_sense_clarification": "город в США"
                            }
                        ]
                    }
                }
            ]
        }
    ]
