                        "entry_id": "8b97e43a-3319-3be4-a278-bacd302ad383",
                        "glosses": [
                            "Anwendung eines Heilverfahrens bei einer kranken Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "335a3c3a-95b5-41e9-99e2-5029dac044fb",
                                "sense_id": "fe124a90-edb9-30ed-90bd-fcd1d39d4eea",
                                "text": "„Durch die beiden Weltkriege und die Nachkriegszeiten wurde die Krankenbehandlung zusätzlich stark beeinträchtigt.“"
                            },
                            {
                                "example_id": "34e7278b-42da-4e7f-9fef-137d2c14e815",
                                "sense_id": "fe124a90-edb9-30ed-90bd-fcd1d39d4eea",
                                "text": "„Hardekopf ging mit ihr nach dem Zweiten Weltkrieg nach Zürich, übersetzte die Werke der französischen Moderne, finanzierte mit dem kargen Übersetzungshonorar die Krankenbehandlung seiner Frau.“"
                            }
                        ],
