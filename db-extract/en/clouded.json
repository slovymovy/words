                                "target_senses": [
                                    {
                                        "sense_id": "6704d792-a5fb-3be5-86eb-cdfef6929811",
                                        "entry_id": "72a87501-61ab-3af3-93bf-9bcd202c4c0f",
                                        "glosses": [
                                            "met wolken bedekt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa90e97a-83ad-4035-bb74-78ecedc65268",
                                                "sense_id": "6704d792-a5fb-3be5-86eb-cdfef6929811",
                                                "text": "Toen we het huis verlieten, kwam er ineens een bewolkte lucht boven ons."
                                            },
                                            {
                                                "example_id": "2b7b50cb-e017-4662-af6a-f7b552676941",
                                                "sense_id": "6704d792-a5fb-3be5-86eb-cdfef6929811",
                                                "text": "„Het was een bewolkte, zwoele namiddag; de matrozen hingen lui op het dek rond of staarden wezenloos over het loodkleurige water. Queequeg en ik waren rustig een zogenaamde zwaardmat aan het weven als extra sjorring voor onze sloep. Om ons heen was alles zo stil en gedempt en toch ook vervuld van wat ging komen en in de lucht hing zo’n mijmerachtige betovering dat die zwijgende mannen stuk voor stuk in hun eigen onzichtbare ik leken op te gaan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43c3b3d7-9ea6-3181-80fe-3f09f88a609e",
                                        "entry_id": "72a87501-61ab-3af3-93bf-9bcd202c4c0f",
                                        "glosses": [
                                            "een slechte stemming uitdrukkend"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e09ad15e-9c25-4390-be5b-a56e077fd3c7",
                                                "sense_id": "43c3b3d7-9ea6-3181-80fe-3f09f88a609e",
                                                "text": "Haar gezichtsuitdrukking veranderde van bewolkt naar onweer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
