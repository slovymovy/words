                "forms": [],
                "senses": [
                    {
                        "sense_id": "4d7b5707-5f6c-37a6-b834-6408fbb0cad4",
                        "entry_id": "8c55473d-2a10-3dfc-9f17-113c8f4f6b8f",
                        "glosses": [
                            "…wyrażający zaskoczenie"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "782c7cd9-4ad5-4e9d-8833-ad618d8aef7c",
                                "sense_id": "4d7b5707-5f6c-37a6-b834-6408fbb0cad4",
                                "text": "Olaboga! aż trzy ruble?… – krzyknął chłop. - Ady ja tego przez cały tydzień nie zarobię"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "a72d5957-372b-3900-8a35-03c6a4f02983",
                        "entry_id": "8c55473d-2a10-3dfc-9f17-113c8f4f6b8f",
                        "glosses": [
                            "…wyrażający strach"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "21d02610-6326-4d4c-ae92-f919ae3ad639",
                                "sense_id": "a72d5957-372b-3900-8a35-03c6a4f02983",
                                "text": "I sam nie wiesz, jak się to stało, ale wrzeszczysz na całe gardło: \"Olaboga! ratujcie!…\""
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "5e10108e-c989-37b5-94a6-70b92fdfcafb",
                        "entry_id": "8c55473d-2a10-3dfc-9f17-113c8f4f6b8f",
                        "glosses": [
                            "…wyrażający bezradność"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "dde6d51f-b112-4702-9731-4af6302072eb",
                                "sense_id": "5e10108e-c989-37b5-94a6-70b92fdfcafb",
                                "text": "Ale wnet bezradność swoją uczuwał i jak stał, tak wylatywał z izby, a wsparłszy się czołem o węgieł chaty szlochał z gwałtownym niepohamowanym żalem, drżąc cały i powtarzając tylko: Tatusiu! tatusiu! Olaboga rety! Tatusiu!"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "e381563f-e2a0-3cb5-b892-b6742ce4d866",
                        "entry_id": "8c55473d-2a10-3dfc-9f17-113c8f4f6b8f",
                        "glosses": [
                            "…wyrażający niechęć"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "7097e5e7-fa35-4430-8054-ac75124bc234",
                                "sense_id": "e381563f-e2a0-3cb5-b892-b6742ce4d866",
                                "text": "Olaboga! Niby to dla niego nowalia ładna dziewczyna… miewa on ich takich samych mendlami po folwarkach."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    }
