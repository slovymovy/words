                            "target_lang_translations": {
                                "en": "My mother was <w>hit</w> by the bus yesterday."
                            }
                        },
                        {
                            "text": "De fietser werd door een snelle auto <w>aangereden</w> op het kruispunt.",
                            "target_lang_translations": {
                                "en": "The cyclist was <w>hit</w> by a fast car at the intersection."
                            }
                        }
                    ],
                    "synonyms": [
