    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "dea6e0df-a6f9-32fc-a175-fa4eef3a1e80",
                "word": "wantonness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e1c214f1-9954-44bc-b181-12f27dca74dc",
                        "entry_id": "dea6e0df-a6f9-32fc-a175-fa4eef3a1e80",
                        "tags": [
                            "plural"
                        ],
                        "form": "wantonnesses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "44475b97-2c82-3276-929a-54b7a85d48d1",
                        "entry_id": "dea6e0df-a6f9-32fc-a175-fa4eef3a1e80",
                        "glosses": [
                            "The state or characteristic of being wanton; recklessness, especially as represented in lascivious or other excessive behavior."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "79198094-f31c-4dca-8d6a-9d8e11c5b38c",
                                "sense_id": "44475b97-2c82-3276-929a-54b7a85d48d1",
                                "text": "The ſpirit of vvantonness is, ſure, ſcared out of him: if the devil have him not in fee-ſimple, vvith fine and recovery, he vvill never, I think, in the vvay of vvaſte, attempt us again."
                            },
                            {
                                "example_id": "15a3cd27-5809-4464-a11c-74c5062aad94",
                                "sense_id": "44475b97-2c82-3276-929a-54b7a85d48d1",
                                "text": "A vvantonneſſe in vvealth, methinks I agree not vvith, / Tis ſuch a trouble to be married too, / And have a thouſand things of great importance, / Jevvells and plates, and fooleries moleſt mee, / To have a mans brains vvhimſied with his vvealth: […]"
                            },
                            {
                                "example_id": "f1e3f667-c32b-4346-8c3d-42dbacfbdd94",
                                "sense_id": "44475b97-2c82-3276-929a-54b7a85d48d1",
                                "text": "A Svveet diſorder in the dreſſe / Kindles in cloathes a vvantonneſſe: […]"
                            },
                            {
                                "example_id": "6c5f428f-f1f8-4e93-95ec-41a075a9ab8d",
                                "sense_id": "44475b97-2c82-3276-929a-54b7a85d48d1",
                                "text": "The desert Pelican had built her nest / In that deep solitude. / And now returned from distant flight / Fraught with the river stream, / Her load of water had disburthened there. / Her young in the refreshing bath / Sported all wantonness; […]"
                            },
                            {
                                "example_id": "9258dd70-db37-45f8-8589-3b675bbf793b",
                                "sense_id": "44475b97-2c82-3276-929a-54b7a85d48d1",
                                "text": "The sweetness was turned to adamantine, heartless cruelty, and the purity to voluptuous wantonness."
                            }
                        ]
                    },
                    {
                        "sense_id": "2e2ca359-529c-3083-bd0b-453f3ba4767c",
                        "entry_id": "dea6e0df-a6f9-32fc-a175-fa4eef3a1e80",
                        "glosses": [
                            "A particular wanton act."
                        ],
                        "tags": [
                            "countable",
                            "dated",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "ed9f4135-c132-45f7-9b21-318647cafe35",
                                "sense_id": "2e2ca359-529c-3083-bd0b-453f3ba4767c",
                                "text": "These were simply the wantonnesses of a dishonest man."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bad62380-b4ef-433c-9519-67e4a3f10d0b",
                        "source_entry_id": "dea6e0df-a6f9-32fc-a175-fa4eef3a1e80",
                        "source_sense_description": "characteristic of being wanton",
                        "target_lang_word": "Ausgelassenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ausgelassenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b3186be0-8aaf-3150-9e04-c0eaba2629a8",
                                        "entry_id": "cea9ac67-3bbd-3771-9ac8-6088e0df078d",
                                        "glosses": [
                                            "unbekümmerte Fröhlichkeit"
                                        ],
                                        "tags": [
                                            "meist Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "049e83f6-7cf8-4891-9f76-453f72456e20",
                                                "sense_id": "b3186be0-8aaf-3150-9e04-c0eaba2629a8",
                                                "text": "In großer Ausgelassenheit feierten sie das Ende der Prüfungen."
                                            },
                                            {
                                                "example_id": "92e21852-a926-404b-b328-f8115b7d045d",
                                                "sense_id": "b3186be0-8aaf-3150-9e04-c0eaba2629a8",
                                                "text": "„Es leuchtete in einer solchen Heiterkeit und Jugendfrische, einer so unschuldsvollen Jugendfrische, dass es an die kindliche Ausgelassenheit eines vierzehnjährigen Knaben erinnerte, und war doch das Anlitz des erhabenen Kaisers.“"
                                            },
                                            {
                                                "example_id": "3d8db2cb-8ddb-4806-bb29-04ef3cc1eadd",
                                                "sense_id": "b3186be0-8aaf-3150-9e04-c0eaba2629a8",
                                                "text": "„P. C. sparte in seiner Ausgelassenheit nicht mit abgeschmackten Witzen, über die nur seine Dame lachte; meine schlechte Laune machte mich ernst, und C. C., die nichts davon begriff, blieb still.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7303b422-3ebc-40e8-957a-f0f286a778b4",
                        "source_entry_id": "dea6e0df-a6f9-32fc-a175-fa4eef3a1e80",
                        "source_sense_description": "characteristic of being wanton",
                        "target_lang_word": "Unbeherrschtheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unbeherrschtheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9c6b771a-e7e7-3637-a79d-8814e77dfc67",
                                        "entry_id": "4f6d7d13-eb0d-30d5-817b-caf04342110d",
                                        "glosses": [
                                            "ohne Plural: mangelnde Kontrolle des eigenen Handelns"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1386bf12-3c8e-4d8a-b52e-c7a1e672cd08",
                                                "sense_id": "9c6b771a-e7e7-3637-a79d-8814e77dfc67",
                                                "text": "„Aber dann war's auch schon wieder vorbei mit der Unbeherrschtheit des Chefdiplomaten.“"
                                            },
                                            {
                                                "example_id": "ead2f43d-79bc-4da1-804a-c6f0db63e125",
                                                "sense_id": "9c6b771a-e7e7-3637-a79d-8814e77dfc67",
                                                "text": "„Paul faszinierte diese besondere Form von Unbeherrschtheit, mit der Lindsay ihre Empfindungen akustisch hervorbrachte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
