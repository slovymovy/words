        "nl-extract.jsonl": [
            {
                "entry_id": "a16613b2-21db-380c-964c-f3474cfd7d31",
                "word": "onderhoudend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b68f5296-67c3-3f93-9fc7-cbf8dc9a57ab",
                        "entry_id": "a16613b2-21db-380c-964c-f3474cfd7d31",
                        "glosses": [
                            "aangenaam vermaak gevend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e531970-a9d0-437c-b37e-b4b9554f5c1d",
                                "sense_id": "b68f5296-67c3-3f93-9fc7-cbf8dc9a57ab",
                                "text": "Wel kan gemeld worden dat President vermist een van de meest onderhoudende thrillers van 2018 is."
                            },
                            {
                                "example_id": "4cae7eb8-73a5-4f61-b6aa-37262af58961",
                                "sense_id": "b68f5296-67c3-3f93-9fc7-cbf8dc9a57ab",
                                "text": "De als zesde geplaatste Kroaat rekende in de vierde ronde af met de Spanjaard Pablo Carreño Busta na een onderhoudende partij in vier sets: 6-7 (2) 6-3 7-6 (0) 7-6 (3)."
                            },
                            {
                                "example_id": "0999687f-51a1-421c-acf3-7669b51569b7",
                                "sense_id": "b68f5296-67c3-3f93-9fc7-cbf8dc9a57ab",
                                "text": ",,Ik ben blij dat we het contract met BBC Worldwide opnieuw hebben weten te verlengen’’, zegt directeur video Frans Klein namens de NPO. ,,Het zijn educatieve en zeer onderhoudende programma’s waar we een breed publiek een groot plezier mee doen. Natuurbeleving- en behoud is voor ons als publieke omroep een heel belangrijk onderwerp.’’"
                            },
                            {
                                "example_id": "7d8aca61-e729-45d9-979e-fbf72f9d7e0b",
                                "sense_id": "b68f5296-67c3-3f93-9fc7-cbf8dc9a57ab",
                                "text": "En zoals hij had verwacht, kwam ze direct overeind, kuste hem op zijn voorhoofd, bedankte voor de onderhoudende avond en trok zich terug naar de slaapkamerverdieping."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "edb1a5f8-9359-46ee-bb8c-198f410b0c2b",
                        "source_entry_id": "a16613b2-21db-380c-964c-f3474cfd7d31",
                        "source_sense_id": "b68f5296-67c3-3f93-9fc7-cbf8dc9a57ab",
                        "source_sense_description": "aangenaam vermaak gevend",
                        "target_lang_word": "amusing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amusing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d578877-ecef-3472-8b48-819b6b3d2de5",
                                        "entry_id": "0d01d279-10b7-3c8c-952a-10aa4dc07953",
                                        "glosses": [
                                            "present participle and gerund of amuse"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "amusing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ce2728a-7d21-3554-b262-fb73ea8347a8",
                                        "entry_id": "0e7befe2-b24e-3a14-8035-5b3972567b8b",
                                        "glosses": [
                                            "Entertaining."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7d53639-14d7-4c02-9f38-356a22bcab6f",
                                                "sense_id": "2ce2728a-7d21-3554-b262-fb73ea8347a8",
                                                "text": "The film has some amusing moments, but it is unlikely to make you laugh out loud."
                                            },
                                            {
                                                "example_id": "2faea8de-1561-413a-a52a-91e9257a8205",
                                                "sense_id": "2ce2728a-7d21-3554-b262-fb73ea8347a8",
                                                "text": "We don’t get amusinger as we get older, we grow prosy and repeat ourselves and talk about our complaints and selfish grievances: but our old friends bear up with our dullness for old times’ sake; […]"
                                            },
                                            {
                                                "example_id": "e11d9d9e-d0cc-4964-b2d8-3a23db37a84c",
                                                "sense_id": "2ce2728a-7d21-3554-b262-fb73ea8347a8",
                                                "text": "Never borrow money for my amusements. Now paying Mrs. McCrowder just at this present period would be an amusement. In fact when we consider the quality of the article she gives, I think that paying her on the nail would be about the amusingest little thing I could do."
                                            },
                                            {
                                                "example_id": "733c2dce-8524-4185-afae-05cebec78f3a",
                                                "sense_id": "2ce2728a-7d21-3554-b262-fb73ea8347a8",
                                                "text": "‘It's rather like a beautiful Inverness cloak one has inherited. Much too good to hide away, so one wears it instead of an overcoat and pretends it's an amusing new fashion.’"
                                            },
                                            {
                                                "example_id": "ff189bc1-ec96-468e-ba10-68036398783a",
                                                "sense_id": "2ce2728a-7d21-3554-b262-fb73ea8347a8",
                                                "text": "They seem amusing on the first day of Christmas, daft on the second, embarrassing on the third. By the twelfth they're in landfill. For 30 seconds of dubious entertainment, or a hedonic stimulus that lasts no longer than a nicotine hit, we commission the use of materials whose impacts will ramify for generations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbd842e1-90dd-3bf8-bbd2-7d6e8d3def25",
                                        "entry_id": "0e7befe2-b24e-3a14-8035-5b3972567b8b",
                                        "glosses": [
                                            "Funny, hilarious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fd99026-da52-42c1-8520-99ffea3f0c05",
                                                "sense_id": "cbd842e1-90dd-3bf8-bbd2-7d6e8d3def25",
                                                "text": "An amusing incident on the first of these journeys was the checking by signal of the flyer about 3 miles out of Paris, with the result that it was overhauled by the 6.25 p.m. semi-fast from Paris to Montargis, to the unconcealed delight of passengers in the latter."
                                            },
                                            {
                                                "example_id": "a57d7f71-8f80-49b0-97c0-6b7e16ad6718",
                                                "sense_id": "cbd842e1-90dd-3bf8-bbd2-7d6e8d3def25",
                                                "text": "[T]hey’d had to call it something – i.e. something that differentiated this occasion from others where they might just go for a pint or a curry. So beer & sausages had somehow happily invented itself, […] The best thing, of course, the amusingest thing, was that no one ever brought beer and Jas had only actually done sausages once."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
