                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1069b29d-b691-4082-8636-104f44f607a9",
                                                "sense_id": "22e169a1-9009-3425-9906-d2e64a9f076a",
                                                "text": "Приятно ли бы нам было проехаться с каким-нибудь новейшим туристом по стране удавителей в Индии или ассасинов в Сирии, выискивая ужасных впечатлений и напрашиваясь на встречи с убийцами-фанатиками?"
                                            }
                                        ]
                                    }
                                ]
