                                "sense_id": "2c12dfb7-7f66-3d0c-a3e6-74f172c02669",
                                "text": "Met het oog op een systemische werking kan een geneesmiddel via een intraveneuze toediening direct in de circulatie worden gebracht."
                            }
                        ]
                    },
                    {
                        "sense_id": "c90f2587-5514-3b18-9b28-18544f6444c6",
                        "entry_id": "57a86446-9464-3718-929a-f03e6729b9f0",
                        "glosses": [
                            "kringloop, omloop"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a3d32f4-1731-4f9c-9250-647e134159ca",
                                "sense_id": "c90f2587-5514-3b18-9b28-18544f6444c6",
                                "text": "[..] de allergevaarlijkste truc van een Amerikaanse magiër was jammerlijk mislukt, maar tot lering en vermaak van de kijker zijn de opnamen in de circulatie gebracht."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0ccc3383-4558-4eae-964e-63c60090a790",
                        "source_entry_id": "57a86446-9464-3718-929a-f03e6729b9f0",
                        "target_lang_word": "circulation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "circulation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fdb245fe-ba2c-33c4-8d5e-fae68c7ef42c",
                                        "entry_id": "d7fb9118-4030-3254-ab4d-4ffc6e637db6",
                                        "glosses": [
                                            "The act of moving in a circle, or in a course which brings the moving body to the place where its motion began."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a14cb3cd-9044-3ebc-b3b7-f7b74dfb9fcd",
                                        "entry_id": "d7fb9118-4030-3254-ab4d-4ffc6e637db6",
                                        "glosses": [
                                            "The act of passing from place to place or person to person; free diffusion; transmission."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30061589-025c-4894-b07b-8acb91ec5bb6",
                                                "sense_id": "a14cb3cd-9044-3ebc-b3b7-f7b74dfb9fcd",
                                                "text": "For example, by changing the use of existing rooms, removing or replacing unsightly features, clearing obstacles to easy circulation, rearranging direction signs and generally introducing as much order as possible, most outdated station buildings can be made reasonably efficient and attractive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d46a0d8a-5b1d-38a5-a11e-7b76ebd07aaf",
                                        "entry_id": "d7fb9118-4030-3254-ab4d-4ffc6e637db6",
                                        "glosses": [
                                            "Currency; circulating coins; notes, bills, etc., current for coin."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d06f5f7-f2c7-4caf-b6b9-2d6e8250dfa5",
                                                "sense_id": "d46a0d8a-5b1d-38a5-a11e-7b76ebd07aaf",
                                                "text": "The new bills will come into circulation next Friday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "802dfb18-f9b6-305a-824d-b66225a8a0f6",
                                        "entry_id": "d7fb9118-4030-3254-ab4d-4ffc6e637db6",
                                        "glosses": [
                                            "The extent to which anything circulates or is circulated; the measurement of diffusion"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2473491d-fbc3-44cf-a142-45c761f6a41f",
                                                "sense_id": "802dfb18-f9b6-305a-824d-b66225a8a0f6",
                                                "text": "June 1 2016, Karen Roberts in the Evening Express, Aberdeen Journals - The Broad Street Years\nThe reputation and circulation of the paper continued to grow, and the board decided a new custom-built base was required for both the Press and Journal and Evening Express to replace the crumbling, but much loved, Broad Street offices."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a4d4322-560a-3325-8289-dc2318ef7f8b",
                                        "entry_id": "d7fb9118-4030-3254-ab4d-4ffc6e637db6",
                                        "glosses": [
                                            "The movement of the blood in the circulatory system, by which it is brought into close relations with the cells and tissues of the body; (loosely) the circulatory system."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8467ac8c-9e0e-4680-b9da-f50de01fe782",
                                                "sense_id": "5a4d4322-560a-3325-8289-dc2318ef7f8b",
                                                "text": "In the dead state all is apparently without motion. No agent within indicates design, intelligence, or foresight: there is no respiration; no digestion, circulation, or nutrition; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd704dbb-a85c-3e9e-b200-a47fbcd61f20",
                                        "entry_id": "d7fb9118-4030-3254-ab4d-4ffc6e637db6",
                                        "glosses": [
                                            "The movement of the sap in the vessels and tissues of plants."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e456587-73cb-420e-af69-15b38f4f0a81",
                        "source_entry_id": "57a86446-9464-3718-929a-f03e6729b9f0",
                        "target_lang_word": "circulation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "circulation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "684a613e-baf4-3355-a85c-14917ab6bc7a",
                                        "entry_id": "ecf354e9-24d7-3e64-80df-7885c7ced998",
                                        "glosses": [
                                            "Mouvement circulaire, en se référant aux planètes."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df1c82aa-def8-4699-b6ff-bef5dc8dc75c",
                                                "sense_id": "684a613e-baf4-3355-a85c-14917ab6bc7a",
                                                "text": "La circulation des astres et des planètes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f9c2545-9ff6-3499-869c-6ea1991da318",
                                        "entry_id": "ecf354e9-24d7-3e64-80df-7885c7ced998",
                                        "glosses": [
                                            "Mouvement du sang qui part du cœur vers toutes les parties du corps au moyen des vaisseaux et revient vers le cœur après s’être oxygéné au niveau des poumons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec7c6abc-950c-4f84-92dc-61d9cc41199e",
                                                "sense_id": "9f9c2545-9ff6-3499-869c-6ea1991da318",
                                                "text": "Les Naïs ont quelque analogie avec les Lombrics ; leur sang est rouge et leur circulation très-facile à observer."
                                            },
                                            {
                                                "example_id": "bae0575d-8fb8-4819-aaaa-62a8ba9d4336",
                                                "sense_id": "9f9c2545-9ff6-3499-869c-6ea1991da318",
                                                "text": "Ces lotions, que l’on nomme encore lotions révulsives, ont pour but d’activer la circulation du sang dans le cuir chevelu et de ranimer la pousse des cheveux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13db039d-5cb0-35f5-86f0-63fdd1a56cbb",
                                        "entry_id": "ecf354e9-24d7-3e64-80df-7885c7ced998",
                                        "glosses": [
                                            "Mouvement de la sève dans les plantes."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c7b6713-5974-4a40-ae6d-916f4b5fdc20",
                                                "sense_id": "13db039d-5cb0-35f5-86f0-63fdd1a56cbb",
                                                "text": "La circulation de la sève dans les arbres."
                                            },
                                            {
                                                "example_id": "1b9800cc-26f0-442c-b0a7-250aa7759ff6",
                                                "sense_id": "13db039d-5cb0-35f5-86f0-63fdd1a56cbb",
                                                "text": "La sève brute a une circulation ascendante et la sève élaborée a une circulation descendante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfb2d8b4-ad2c-3263-be81-d027a0387139",
                                        "entry_id": "ecf354e9-24d7-3e64-80df-7885c7ced998",
                                        "glosses": [
                                            "Mouvement des fluides (eau, gaz, etc.) et, par extension également, les conduites dans lesquelles ils circulent."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "009715ee-0493-4070-9dad-666d4daabceb",
                                                "sense_id": "dfb2d8b4-ad2c-3263-be81-d027a0387139",
                                                "text": "La circulation de l’air."
                                            },
                                            {
                                                "example_id": "22c75702-33be-4735-9349-c11100bc7f34",
                                                "sense_id": "dfb2d8b4-ad2c-3263-be81-d027a0387139",
                                                "text": "Une fuite sur le circuit de circulation d’eau chaude."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0af00356-be23-3be0-9c09-b37fae8100ce",
                                        "entry_id": "ecf354e9-24d7-3e64-80df-7885c7ced998",
                                        "glosses": [
                                            "Modifications subies par les molécules constitutives de la cellule vivante."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7252db0b-3386-387f-b322-b1545418ece5",
                                        "entry_id": "ecf354e9-24d7-3e64-80df-7885c7ced998",
                                        "glosses": [
                                            "Action d’aller et de venir en utilisant les voies de communication."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef2c3c3d-952c-4614-815b-6a389c6ea700",
                                                "sense_id": "7252db0b-3386-387f-b322-b1545418ece5",
                                                "text": "Le Courrier français, qui n'y allait pas par quatre chemins, demanda énergiquement que la circulation fût interdite sur le chemin de fer du Nord tant que la sécurité des voyageurs n'y serait pas assurée."
                                            },
                                            {
                                                "example_id": "a5b089d3-8596-4ff8-8b67-7828eea6925c",
                                                "sense_id": "7252db0b-3386-387f-b322-b1545418ece5",
                                                "text": "Le Transcaspien, ouvert à la circulation des voyageurs et des marchandises, est, par excellence, la voie commerciale qui rattache l’Europe au Turkestan."
                                            },
                                            {
                                                "example_id": "b68f2497-d6b1-4b8c-8705-983840926e07",
                                                "sense_id": "7252db0b-3386-387f-b322-b1545418ece5",
                                                "text": "[…]; les Sarrazins qui s'étaient assurés de la maîtrise de la Méditerranée, avaient provoqué la ruine du commerce français et il faudra attendre jusqu'aux Croisades pour voir la marine française reconquérir la libre circulation sur la mer."
                                            },
                                            {
                                                "example_id": "8c28606c-a1e0-452f-b85e-5285b362d64a",
                                                "sense_id": "7252db0b-3386-387f-b322-b1545418ece5",
                                                "text": "Dans le quartier étudié dans le centre d'Aix-en-Provence, la circulation est rendue compliquée par le sens obligatoire de la rocade et l'étroitesse des rues ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46f6e54c-0172-3090-af00-329ba68072c8",
                                        "entry_id": "ecf354e9-24d7-3e64-80df-7885c7ced998",
                                        "glosses": [
                                            "Flux des véhicules automobiles sur les routes et dans les rues."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69f87d29-0715-4118-a1f1-46665c771cfa",
                                                "sense_id": "46f6e54c-0172-3090-af00-329ba68072c8",
                                                "text": "La circulation à Paris lui avait paru exécrable, dangereuse, des maniaques au volant qui avaient l'œil fixé sur le bout du capot comme des gosses dans des autos-tamponnantes."
                                            },
                                            {
                                                "example_id": "9fc66014-f9ee-41ab-8a22-88519f0226ef",
                                                "sense_id": "46f6e54c-0172-3090-af00-329ba68072c8",
                                                "text": "La circulation et le stationnement restent interdits sur les pistes forestières, chemins ruraux, pistes cyclables et sentiers."
                                            },
                                            {
                                                "example_id": "c617f4f8-8261-48f0-bcc8-31c9af563c2a",
                                                "sense_id": "46f6e54c-0172-3090-af00-329ba68072c8",
                                                "text": "Le terme « contrôle dynamique » désigne l’exécution de toutes les fonctions opérationnelles et tactiques en temps réel nécessaires au déplacement du véhicule. Il s’agit notamment du contrôle du déplacement latéral et longitudinal du véhicule, de la surveillance de la route, des réactions aux événements survenant dans la circulation routière, ainsi que de la préparation et du signalement des manœuvres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b51ac32-a71f-374a-b7e0-dcdaab41a9e8",
                                        "entry_id": "ecf354e9-24d7-3e64-80df-7885c7ced998",
                                        "glosses": [
                                            "Ensemble des véhicules qui circulent."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8c4c37a-c0e6-4c3d-9941-e27e3bce1856",
                                                "sense_id": "2b51ac32-a71f-374a-b7e0-dcdaab41a9e8",
                                                "text": "Les accidents de la circulation."
                                            },
                                            {
                                                "example_id": "55e66db0-078b-4931-8bb4-f557a543806b",
                                                "sense_id": "2b51ac32-a71f-374a-b7e0-dcdaab41a9e8",
                                                "text": "La circulation s’accroît sur cette ligne de chemin de fer."
                                            },
                                            {
                                                "example_id": "61db5249-11c4-477f-b213-d3ea97bef4b8",
                                                "sense_id": "2b51ac32-a71f-374a-b7e0-dcdaab41a9e8",
                                                "text": "Chaque jour il y a un peu plus d’encombrements de la circulation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33eb28be-4c74-386c-8527-533098aac81c",
                                        "entry_id": "ecf354e9-24d7-3e64-80df-7885c7ced998",
                                        "glosses": [
                                            "Voie de communication."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "note": "Ce terme est généralement utilisé au pluriel",
                                        "examples": [
                                            {
                                                "example_id": "f12b7dfb-5b31-4545-be0f-a34eaa04861e",
                                                "sense_id": "33eb28be-4c74-386c-8527-533098aac81c",
                                                "text": "Une allée, un chemin, une route, etc., sont des circulations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "339964ca-adc6-32cb-971e-c879e71ccc2f",
                                        "entry_id": "ecf354e9-24d7-3e64-80df-7885c7ced998",
                                        "glosses": [
                                            "Ensemble des échanges économiques et des transactions indispensables pour fournir des biens aux producteurs et pour livrer les produits aux consommateurs."
                                        ],
                                        "tags": [
                                            "Économie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4492c807-3d94-433c-bd11-8b21dcb2f594",
                                                "sense_id": "339964ca-adc6-32cb-971e-c879e71ccc2f",
                                                "text": "La vitesse de circulation de la monnaie croissait ainsi de jour en jour et sa répudiation définitive semblait devoir être prochaine."
                                            },
                                            {
                                                "example_id": "ec5b0274-2aa0-4fd3-8868-dd983d178705",
                                                "sense_id": "339964ca-adc6-32cb-971e-c879e71ccc2f",
                                                "text": "La circulation des biens et des services."
                                            },
                                            {
                                                "example_id": "a4999b9e-6273-4062-8dc4-ac29444691a5",
                                                "sense_id": "339964ca-adc6-32cb-971e-c879e71ccc2f",
                                                "text": "Mettre des billets en circulation ou retirer des billets de la circulation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "277ab28c-9305-3878-ba2e-e14a2c17a3e2",
                                        "entry_id": "ecf354e9-24d7-3e64-80df-7885c7ced998",
                                        "glosses": [
                                            "Diffusion ; action de mettre à la connaissance du public un nouvel ouvrage, de nouvelles idées ou de nouveaux produits."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "246ff1c1-87a4-44af-83d6-627b71ced59d",
                                                "sense_id": "277ab28c-9305-3878-ba2e-e14a2c17a3e2",
                                                "text": "La diffusion (ou « circulation ») est le nombre d’exemplaires mis en vente par un titre. Le taux de circulation correspond au nombre moyen de lecteurs différents par exemplaire distribué."
                                            },
                                            {
                                                "example_id": "511473aa-def5-4ab1-9a5e-d3f785920e02",
                                                "sense_id": "277ab28c-9305-3878-ba2e-e14a2c17a3e2",
                                                "text": "Mettre un écrit en circulation."
                                            },
                                            {
                                                "example_id": "cffdfefb-e270-4e0f-95cc-bd67de485823",
                                                "sense_id": "277ab28c-9305-3878-ba2e-e14a2c17a3e2",
                                                "text": "Retirer de la circulation un ouvrage censuré."
                                            },
                                            {
                                                "example_id": "e966c4f1-6f3e-4480-83dd-d9167d32ae32",
                                                "sense_id": "277ab28c-9305-3878-ba2e-e14a2c17a3e2",
                                                "text": "Mettre en circulation de nouvelles idées."
