                    {
                        "translation_id": "d911a467-37d0-4ee5-8883-7b1ad35e5b87",
                        "source_entry_id": "85e742fa-6af1-30e3-852f-69d2421b500f",
                        "source_sense_id": "2199aa98-3490-3174-8e7c-f5044204d87b",
