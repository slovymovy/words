                        "examples": [
                            {
                                "example_id": "009f3afa-f04f-47ac-881c-c40d464fc0fb",
                                "sense_id": "279a2327-bd79-36e1-9ffb-1e1af0cd23da",
                                "text": "„In seinen letzten Lebensmonaten und -wochen war die Auseinandersetzung um die psychiatrische Versorgung zwischen Griesinger und den Anstaltspsychiatern in ihre schärfste Phase getreten.“"
                            },
                            {
                                "example_id": "ee160e64-fbbd-41da-ac99-68226d7f32cd",
                                "sense_id": "279a2327-bd79-36e1-9ffb-1e1af0cd23da",
                                "text": "„Sie hat ihn nicht losgelassen bis in die letzten Lebenswochen.“"
                            }
