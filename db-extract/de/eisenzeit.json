                            "singular"
                        ],
                        "form": "der Eisenzeit"
                    },
                    {
                        "form_id": "5447ec13-a846-4f89-b499-f7cfae272b1e",
                        "entry_id": "ae2a4936-d6c6-39e9-a253-f2468bcd4955",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Eisenzeit"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "67a47b09-6073-33ca-b469-c6f12c679c52",
                        "entry_id": "ae2a4936-d6c6-39e9-a253-f2468bcd4955",
                        "glosses": [
                            "nach der Steinzeit und der Bronzezeit die dritte Periode der Menschheitsgeschichte, in der man begann, Eisen für Werkzeuge und Waffen zu verwenden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9865a489-ebb9-4fb4-ab2f-82c02c6f6e84",
                                "sense_id": "67a47b09-6073-33ca-b469-c6f12c679c52",
                                "text": "In Mitteleuropa setzte die Eisenzeit im 8. Jahrhundert vor Christus ein."
                            },
                            {
                                "example_id": "e62af26f-aa7e-4940-b644-bfd61b018a5f",
                                "sense_id": "67a47b09-6073-33ca-b469-c6f12c679c52",
                                "text": "„Der Übergang von der Bronzezeit zur Eisenzeit verlief im gesamten südwestfälischen Raum ohne größere Brüche.“"
                            },
                            {
                                "example_id": "0179a208-e406-433c-9af2-53cd7fb5512d",
                                "sense_id": "67a47b09-6073-33ca-b469-c6f12c679c52",
                                "text": "„Während es für die Bronzezeit (frühe Hallstattkultur) keine Zeugnisse keltischer Art gibt, ist mit der Eisenzeit, das heißt mit der späten Hallstattkultur (650-400 v. Chr.), keltische Geschichte durch archäologische Zeugnisse belegt.“"
                            },
                            {
                                "example_id": "c1fad83e-ae4d-49d9-afd3-f67569a41325",
                                "sense_id": "67a47b09-6073-33ca-b469-c6f12c679c52",
                                "text": "„Für Undset und andere Forscher begann die Eisenzeit in Mitteleuropa mit der sogenannten Hallstatt-Kultur, benannt nach einem Ort im österreichischen Salzkammergut.“"
                            },
                            {
                                "example_id": "3c8d9997-7479-4d27-a383-0050f6726407",
                                "sense_id": "67a47b09-6073-33ca-b469-c6f12c679c52",
                                "text": "„Eher kann man sich die kleinen Gemeinschaften der Eisenzeit als Stämme oder Familienclans vorstellen oder als Bewohner verschiedener Siedlungszentren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f92d13c5-1338-4f5b-8aee-639a09d416be",
                        "source_entry_id": "ae2a4936-d6c6-39e9-a253-f2468bcd4955",
                        "source_sense_id": "67a47b09-6073-33ca-b469-c6f12c679c52",
                        "source_sense_description": "Periode der Menschheitsgeschichte, in der man begann, Eisen für Werkzeuge und Waffen zu verwenden",
                        "target_lang_word": "Iron Age",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Iron Age",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f1b8e9e6-bea7-3b9b-9f44-6eb54a8bdd89",
                                        "entry_id": "be039f8e-cf67-34c7-8d79-e37440f8550e",
                                        "glosses": [
                                            "The most recent and debased of the four or five classical Ages of Man; hence, any period characterized by wicked behavior."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ba1429c-6ebd-4cee-b074-572a8eaa8580",
                                                "sense_id": "f1b8e9e6-bea7-3b9b-9f44-6eb54a8bdd89",
                                                "text": "He that shall examine this iron age wherein we live, where love is cold […] may well ask where is charity?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7acb6f9-acc9-3f7d-9e81-49fd9306ad1d",
                                        "entry_id": "be039f8e-cf67-34c7-8d79-e37440f8550e",
                                        "glosses": [
                                            "An age characterized by the use of iron."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "875c9c85-1eed-326a-9c0d-e2d332830e63",
                                        "entry_id": "be039f8e-cf67-34c7-8d79-e37440f8550e",
                                        "glosses": [
                                            "A level of culture in which humans used iron and the technology of ironworking. (Estimated to have begun in Europe about 1100 BC)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
