                        "examples": [
                            {
                                "example_id": "86c69325-a65d-4134-806a-9758dcbfe300",
                                "sense_id": "80bc7e24-8529-3cd5-84a0-0de8e03e9662",
                                "text": "Es gibt nichts Erstaunlicheres als die Menschwerdung Gottes in Jesus Christus.",
                                "translation": "There is nothing more amazing than the incarnation of God in Jesus Christ.",
                                "english": "There is nothing more amazing than the incarnation of God in Jesus Christ."
                            }
                        ]
                    },
                    {
                        "sense_id": "6f350442-b975-392f-b473-41d86ab5eb48",
                        "entry_id": "213bf787-73c2-39f3-8c15-6247e643c810",
                        "glosses": [
                            "the evolutionary and intellectual development by which Homo sapiens sapiens came into being"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "9273c986-12f8-43c2-8616-82058995162d",
                                "sense_id": "6f350442-b975-392f-b473-41d86ab5eb48",
                                "text": "Es gibt nichts Erstaunlicheres als die Menschwerdung vom Einzeller bis hin zum modernen Menschen.",
                                "translation": "There is nothing more amazing than the development of man from unicellular organisms to modern human beings.",
                                "english": "There is nothing more amazing than the development of man from unicellular organisms to modern human beings."
                            }
                        ]
                    }
