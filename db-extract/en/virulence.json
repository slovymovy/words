                                    {
                                        "sense_id": "9346db33-4cf0-3f1e-ac83-e6430c274e2a",
                                        "entry_id": "315551b8-d1ed-302d-bd57-b85553769d06",
                                        "glosses": [
                                            "Aptitude des microbes à se développer dans l’organisme et à y sécréter des poisons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "722ee0ec-a1f9-4a69-88ab-c6f08fbb38fc",
                                                "sense_id": "9346db33-4cf0-3f1e-ac83-e6430c274e2a",
                                                "text": "Le bacille pesteux aurait-il par hasard perdu sa virulence ? Il ne le semble pas, d’après certaines épidémies survenues dans l’Inde et d’après la cruelle épidémie, qui frappa la Mandchourie en 1910 et fit, en moins de trois mois, 65.000 victimes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91f6b9da-3eb8-320f-8733-df217ebc91ec",
                                        "entry_id": "315551b8-d1ed-302d-bd57-b85553769d06",
                                        "glosses": [
                                            "Qualité de ce qui est virulent."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d259adeb-5e1f-40c7-ae68-7ee059e250db",
                                                "sense_id": "91f6b9da-3eb8-320f-8733-df217ebc91ec",
                                                "text": "La virulence de cette humeur."
                                            },
                                            {
                                                "example_id": "e3c36df9-7049-4401-89fd-af4a0bde2fd6",
                                                "sense_id": "91f6b9da-3eb8-320f-8733-df217ebc91ec",
                                                "text": "La virulence de ses discours."
                                            },
                                            {
                                                "example_id": "dad27ac6-0151-450b-8f07-07c38e37eb27",
                                                "sense_id": "91f6b9da-3eb8-320f-8733-df217ebc91ec",
                                                "text": "Le président américain Donald Trump s’en est une nouvelle fois pris lundi avec virulence au docteur Anthony Fauci, figure très respectée aux États-Unis et membre de la cellule de crise de la Maison-Blanche sur le coronavirus."
                                            },
                                            {
                                                "example_id": "e2257187-195f-4249-995f-9e44407b3fa8",
                                                "sense_id": "91f6b9da-3eb8-320f-8733-df217ebc91ec",
                                                "text": "Nous voici immergés dans un système qui, par la richesse de son information, par la virulence de sa contamination, par la multiplication de se canaux de propagation, permet l’apparition d’innombrables configurations nouvelles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
