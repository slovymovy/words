                "senses": [
                    {
                        "sense_id": "c257e8bf-0c89-3895-9ecd-30171794788b",
                        "entry_id": "33f526e0-8bb2-3a25-b50d-9dc4f702e82c",
                        "glosses": [
                            "zwei Wörter, die unter einem beliebigen Gesichtspunkt als Paar zusammengestellt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15098e01-301f-4b54-8786-65c21695f39e",
                                "sense_id": "c257e8bf-0c89-3895-9ecd-30171794788b",
                                "text": "„Damit werden auf ein Wortpaar bezogene hervortretende Gemeinsamkeiten und Unterschiede systematisch und direkter erfassbar gemacht.“"
                            },
                            {
                                "example_id": "4d697b38-5a86-4830-ab91-0f0e08322610",
                                "sense_id": "c257e8bf-0c89-3895-9ecd-30171794788b",
                                "text": "„Doch lassen wir uns vom konkreten Beispiel belehren, was es mit diesem Wortpaar auf sich hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a9ff8437-41dc-388f-8c6d-8f2f7763d661",
                        "entry_id": "33f526e0-8bb2-3a25-b50d-9dc4f702e82c",
                        "glosses": [
                            "zwei Wörter gleicher Wortart als Redewendung"
                        ],
                        "tags": [],
                        "examples": [
                            {
