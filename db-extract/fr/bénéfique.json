                "senses": [
                    {
                        "sense_id": "360560aa-679c-3f7d-8d97-d03ad24e8bef",
                        "entry_id": "4c684846-0997-3770-98ce-f56ff4c7be72",
                        "glosses": [
                            "Qui fait du bien, qui a une influence favorable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef81c8fa-c641-4548-905b-9a6f09b62cca",
                                "sense_id": "360560aa-679c-3f7d-8d97-d03ad24e8bef",
                                "text": "Son séjour au bord de mer lui a été très bénéfique."
                            },
                            {
                                "example_id": "6204104c-255d-45d7-8cb7-db6a8e015679",
                                "sense_id": "360560aa-679c-3f7d-8d97-d03ad24e8bef",
                                "text": "Un peu d'activité physique ne peut que vous être bénéfique."
                            },
                            {
                                "example_id": "4f4bf89b-50e0-433f-a249-6e1cfc8a05e8",
                                "sense_id": "360560aa-679c-3f7d-8d97-d03ad24e8bef",
                                "text": "Elle connaît toutes les plantes bénéfiques de la région."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e7c3d22-17f9-439b-b653-cda265989801",
                        "source_entry_id": "4c684846-0997-3770-98ce-f56ff4c7be72",
