                    {
                        "sense_id": "31672ac3-bd38-3937-8b88-84232dbf5a5c",
                        "entry_id": "34966302-8c2d-36a5-8078-7b24358638c6",
                        "glosses": [
                            "A tournament."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90988675-e25e-46d5-9330-a6170fe63864",
                                "sense_id": "31672ac3-bd38-3937-8b88-84232dbf5a5c",
                                "text": "By a knight of ghostes & shadowes,\nI sumon’d am to Tourney.\nten leagues beyond the wide worlds end"
                            },
                            {
                                "example_id": "b0885bf6-f7b1-40cf-a627-e1cc5e6e7073",
                                "sense_id": "31672ac3-bd38-3937-8b88-84232dbf5a5c",
                                "text": "And let the recreant traitors seek\n My tourney court."
                            },
                            {
                                "example_id": "3b02fe93-9845-4ae7-86e3-5a523ab91398",
                                "sense_id": "31672ac3-bd38-3937-8b88-84232dbf5a5c",
                                "text": "We hold a tourney here to-morrow morn,\n And there is scantly time for half the work."
                            },
                            {
                                "example_id": "e8b5752f-3be3-46d1-9d38-c11aa9914d8c",
                                "sense_id": "31672ac3-bd38-3937-8b88-84232dbf5a5c",
                                "text": "Kipper stood blinking, as I had sometimes seen him do at the boxing tourneys in which he indulged when in receipt of a shrewd buffet on some tender spot like the tip of the nose."
                            }
                        ]
                    }
                ],
