{
    "word_family": [
        "lopper",
        "lopping"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d89653cb-11d5-315f-b13d-90051214d805",
                    "sense_definition": "to cut off the top or extreme part of something, especially to prune branches from a tree or shrub",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cutting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener decided to <w>lop</w> off the dead branches to help the tree grow better next spring.",
                            "target_lang_translations": {
                                "ru": "Садовник решил <w>обрубить</w> сухие ветки, чтобы дерево лучше росло следующей весной."
                            }
                        },
                        {
                            "text": "You should <w>lop</w> branches regularly to maintain the shape of the hedge.",
                            "target_lang_translations": {
                                "ru": "Вам следует регулярно <w>подрезать</w> ветки, чтобы поддерживать форму живой изгороди."
                            }
                        }
                    ],
                    "synonyms": [
                        "snead"
                    ],
                    "common_phrases": [
                        "lop branches",
                        "lop off"
                    ],
                    "target_lang_definitions": {
                        "ru": "отрезать верхушку или крайнюю часть чего-либо, особенно подрезать ветки деревьев или кустарников"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обрубать",
                                "target_lang_sense_clarification": "отсекать части, укорачивая"
                            },
                            {
                                "target_lang_word": "подрезать",
                                "target_lang_sense_clarification": "ветки или растения"
                            },
                            {
                                "target_lang_word": "отсекать",
                                "target_lang_sense_clarification": "отделять от целого"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b18f2eb-6e45-3817-bed7-15bfeabdc0c9",
                    "sense_definition": "to allow something, such as the head or ears, to hang down or droop",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drooping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tired dog began to <w>lop</w> its ears as it finally fell asleep on the rug.",
                            "target_lang_translations": {
                                "ru": "Уставшая собака начала <w>свешивать</w> уши, когда наконец уснула на коврике."
                            }
                        },
                        {
                            "text": "It is common for certain animals to <w>lop</w> the head when they are feeling submissive.",
                            "target_lang_translations": {
                                "ru": "Для некоторых животных характерно <w>опускать</w> голову, когда они чувствуют себя покорными."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lop the head"
                    ],
                    "target_lang_definitions": {
                        "ru": "позволять чему-либо, например голове или ушам, свисать или поникать"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свешивать",
                                "target_lang_sense_clarification": "уши или голову"
                            },
                            {
                                "target_lang_word": "опускать",
                                "target_lang_sense_clarification": "вниз"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ee57b9f-6873-3303-8b71-5ece73285e04",
                    "sense_definition": "to hang downward, lean to one side, or be pendent",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drooping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy sunflowers started to <w>lop</w> toward the ground after the intense rainstorm.",
                            "target_lang_translations": {
                                "ru": "Тяжелые подсолнухи начали <w>склоняться</w> к земле после сильного ливня."
                            }
                        },
                        {
                            "text": "His hat would <w>lop</w> over his eyes whenever he tried to run.",
                            "target_lang_translations": {
                                "ru": "Его шляпа <w>сползала</w> на глаза каждый раз, когда он пытался бежать."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "свисать вниз, наклоняться в одну сторону или быть в подвешенном состоянии"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свисать",
                                "target_lang_sense_clarification": "вниз"
                            },
                            {
                                "target_lang_word": "болтаться",
                                "target_lang_sense_clarification": "о предметах одежды"
                            },
                            {
                                "target_lang_word": "поникать",
                                "target_lang_sense_clarification": "о растениях"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2278a405-9b82-3e6d-ad97-23186ead436c",
                    "sense_definition": "any of several breeds of rabbits characterized by ears that lie flat or hang down",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "animals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to adopt a French <w>lop</w> because she loved its long, drooping ears.",
                            "target_lang_translations": {
                                "ru": "Она решила взять французского <w>барана</w>, потому что ей нравились его длинные висячие уши."
                            }
                        },
                        {
                            "text": "The Holland <w>lop</w> is a very popular pet due to its small size and sweet temperament.",
                            "target_lang_translations": {
                                "ru": "Голландский <w>вислоухий кролик</w> — очень популярный питомец благодаря своим небольшим размерам и милому характеру."
                            }
                        }
                    ],
                    "common_phrases": [
                        "holland lop",
                        "french lop"
                    ],
                    "target_lang_definitions": {
                        "ru": "любая из нескольких пород кроликов, характеризующаяся плоскими или свисающими ушами"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вислоухий кролик",
                                "target_lang_sense_clarification": "порода"
                            },
                            {
                                "target_lang_word": "баран",
                                "target_lang_sense_clarification": "название породы кроликов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c478cf2-ba4e-3a8e-8f9b-12a3b6e0df40",
                    "sense_definition": "material that has been cut off from something, particularly branches or twigs pruned from a tree",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cutting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After pruning the orchard, the farmers gathered the <w>lop</w> to use as kindling for the fire.",
                            "target_lang_translations": {
                                "ru": "После обрезки сада фермеры собрали <w>обрубки</w> веток, чтобы использовать их для растопки костра."
                            }
                        },
                        {
                            "text": "The ground was covered in <w>lop</w> and bark after the heavy winds damaged the old oak.",
                            "target_lang_translations": {
                                "ru": "Земля была покрыта <w>ветками</w> и корой после того, как сильный ветер повредил старый дуб."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "материал, который был отрезан от чего-либо, в частности ветки или прутья, срезанные с дерева"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обрубки",
                                "target_lang_sense_clarification": "веток"
                            },
                            {
                                "target_lang_word": "хворост",
                                "target_lang_sense_clarification": "срезанные ветки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5b6bec5-07f0-321f-a23a-dfd848c67b3a",
                    "sense_definition": "a flea",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "insects",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man complained that the stray cat was jumping with <w>lops</w>.",
                            "target_lang_translations": {
                                "ru": "Старик жаловался, что бездомная кошка так и прыгает от <w>блох</w>."
                            }
                        },
                        {
                            "text": "In some northern dialects, a <w>lop</w> is a common name for the tiny biting insects found on pets.",
                            "target_lang_translations": {
                                "ru": "В некоторых северных диалектах <w>lop</w> — это обычное название крошечных кусачих насекомых, встречающихся у домашних животных."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Northern England"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "блоха (диалектное название в Северной Англии)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блоха",
                                "target_lang_sense_clarification": "насекомое"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f142082e-d831-3514-9f7d-56ef2121a669",
                    "sense_definition": "a person with a physical disability, particularly one affecting their limbs",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cruel children used the word <w>lop</w> to mock the man who walked with a heavy limp.",
                            "target_lang_translations": {
                                "ru": "Жестокие дети использовали слово <w>калека</w>, чтобы поиздеваться над человеком, который сильно хромал."
                            }
                        },
                        {
                            "text": "He felt insulted when he heard someone refer to him as a <w>lop</w> because of his leg injury.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал себя оскорбленным, когда услышал, как кто-то назвал его <w>хромым</w> из-за травмы ноги."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "offensive"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "человек с физическим недостатком, особенно затрагивающим конечности (оскорбительный сленг)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "калека",
                                "target_lang_sense_clarification": "грубое, оскорбительное"
                            },
                            {
                                "target_lang_word": "хромой",
                                "target_lang_sense_clarification": "оскорбительное"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "669595c8-4ce2-3e77-867d-4a80757cd423",
                    "sense_definition": "a county located in the Hotan prefecture of the Xinjiang autonomous region in China",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The local government in <w>Lop</w> county has been working to improve the irrigation systems for farmers.",
                            "target_lang_translations": {
                                "ru": "Местные власти уезда <w>Лоп</w> работают над улучшением ирригационных систем для фермеров."
                            }
                        },
                        {
                            "text": "Many traditional rugs are produced in the villages surrounding <w>Lop</w> county.",
                            "target_lang_translations": {
                                "ru": "Многие традиционные ковры производятся в деревнях, окружающих уезд <w>Лоп</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "Luopu",
                        "Lo-p'u",
                        "Lohpu"
                    ],
                    "common_phrases": [
                        "Lop county"
                    ],
                    "target_lang_definitions": {
                        "ru": "уезд в округе Хотан Синьцзян-Уйгурского автономного района Китая"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Лоп",
                                "target_lang_sense_clarification": "уезд в Китае"
                            },
                            {
                                "target_lang_word": "Лопу",
                                "target_lang_sense_clarification": "китайское название"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad676cdd-bd39-3c65-8a67-d310b1f5331b",
                    "sense_definition": "a specific town within Lop County, Xinjiang, China",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The administrative offices are located in the center of <w>Lop</w> town.",
                            "target_lang_translations": {
                                "ru": "Административные офисы расположены в центре города <w>Лоп</w>."
                            }
                        },
                        {
                            "text": "Travelers often stop in <w>Lop</w> town before heading further into the desert regions.",
                            "target_lang_translations": {
                                "ru": "Путешественники часто останавливаются в городе <w>Лоп</w>, прежде чем отправиться дальше в пустынные районы."
                            }
                        }
                    ],
                    "synonyms": [
                        "Luopu",
                        "Lo-p'u",
                        "Lohpu"
                    ],
                    "common_phrases": [
                        "Lop town"
                    ],
                    "target_lang_definitions": {
                        "ru": "конкретный город в уезде Лоп, Синьцзян, Китай"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Лоп",
                                "target_lang_sense_clarification": "город в Китае"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}