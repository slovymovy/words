                        "examples": [
                            {
                                "example_id": "57a97837-e893-42af-8dc2-f26519155e8c",
                                "sense_id": "855f59b2-7c6a-3fa2-a7d3-336baa55cb06",
                                "text": "Dzięki Machabeuszom Judea uzyskała niepodległość."
                            },
                            {
                                "example_id": "a9668ce7-208b-4b4e-80a9-15beb4eeed69",
