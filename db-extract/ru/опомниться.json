                "translations": [
                    {
                        "translation_id": "2e3a8424-5559-4b20-86c9-cb5b2466ccf1",
                        "source_entry_id": "993eddd6-c3e4-3c8c-b96c-53e74ce3f216",
                        "source_sense_description": "прийти в сознание после обморока, забытья",
                        "target_lang_word": "regain one's senses",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "regain one's senses",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "38944a33-38b2-3c53-941d-23eaed58cec8",
                                        "entry_id": "5b3911d0-a3a3-3ca7-ae1f-b06038925d45",
