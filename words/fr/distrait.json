                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "forme_verbale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce jeu sur tablette <w>distrait</w> les enfants pendant les longs trajets en train."
                        },
                        {
                            "text": "Le bruit constant venant de la rue le <w>distrait</w> beaucoup lorsqu'il tente de réviser."
                        }
                    ],
                    "synonyms": [
