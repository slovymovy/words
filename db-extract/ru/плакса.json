                    {
                        "form_id": "3320d3af-b32f-4414-82e7-8bfc1e92fae2",
                        "entry_id": "60ea7023-7d4d-3733-8771-1f2cbd279f11",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "пла́ксах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3bd563ce-9c5b-3bc3-83a2-f1f1534767af",
                        "entry_id": "60ea7023-7d4d-3733-8771-1f2cbd279f11",
                        "glosses": [
                            "разг. тот, кто часто, без достаточной причины плачет"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1034b874-31cc-4503-b6f3-76a62bdbd9bb",
                                "sense_id": "3bd563ce-9c5b-3bc3-83a2-f1f1534767af",
                                "text": "Где были твои глаза? Плакса! Нюнил до тех пор, пока не утащили из-под его носа жены!"
                            },
                            {
                                "example_id": "1b90d4a1-2800-4948-83de-0578cbe18c50",
                                "sense_id": "3bd563ce-9c5b-3bc3-83a2-f1f1534767af",
                                "text": "Ведь ничего еще не случилось, а вы грустите, будто жизнь уж кончена, прошла, пролетела. Вы просто от природы плакса."
                            },
                            {
                                "example_id": "84b9b52f-a64a-4079-b94a-437803a02920",
                                "sense_id": "3bd563ce-9c5b-3bc3-83a2-f1f1534767af",
                                "text": "Герда. Я давно бы вошла… Но я заплакала. А я очень не люблю, когда видят, как я плачу. Я вовсе не плакса, поверьте мне!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8330baa-89c2-447d-ac36-df5da51f5612",
                        "source_entry_id": "60ea7023-7d4d-3733-8771-1f2cbd279f11",
                        "source_sense_id": "3bd563ce-9c5b-3bc3-83a2-f1f1534767af",
                        "target_lang_word": "pleurnicheur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pleurnicheur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b578497f-0f7f-3f06-adff-c699f99a0a65",
                                        "entry_id": "088a17f9-f84f-36a3-954c-3e2b4a06032c",
                                        "glosses": [
                                            "Qui pleurniche."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7995c27-1b51-4eeb-bfb6-cde7f6d060d0",
                                                "sense_id": "b578497f-0f7f-3f06-adff-c699f99a0a65",
                                                "text": "Ses condisciples, plus résignée ou plus endurcis, se moquaient de lui et ne l’appelaient plus que le saule pleurnicheur, ce qui mettait le comble à son ennui."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pleurnicheur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "58a9b7cd-528a-37a6-8284-ae9844c56576",
                                        "entry_id": "962622c6-041f-3bb2-977d-0388d9dca005",
                                        "glosses": [
                                            "Personne qui a l’habitude de pleurnicher."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4da4ad0c-6aae-4a1e-b7a0-69901cd035c9",
                                                "sense_id": "58a9b7cd-528a-37a6-8284-ae9844c56576",
                                                "text": "C’est un pleurnicheur, une pleurnicheuse."
                                            },
                                            {
                                                "example_id": "50dd673e-a30b-47fd-861a-d111373d4fb1",
                                                "sense_id": "58a9b7cd-528a-37a6-8284-ae9844c56576",
                                                "text": "Dans les cafés de Paris on appelle M. d’Orvilliers le pleurnicheur, & l’on a fait à ce sujet les couplets suivans, sur l’ancien air des Pendus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2871e149-8b29-4920-b771-ec099ed47694",
                        "source_entry_id": "60ea7023-7d4d-3733-8771-1f2cbd279f11",
                        "source_sense_id": "3bd563ce-9c5b-3bc3-83a2-f1f1534767af",
                        "target_lang_word": "pleurnichard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pleurnichard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7581d60d-ba61-323d-93a0-830c8889bc34",
                                        "entry_id": "0f1f160c-9e7b-38f6-b925-71271cd5a969",
                                        "glosses": [
                                            "Qui pleurniche facilement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d95f558e-a16f-465d-9f47-d67ea258ee0f",
                                                "sense_id": "7581d60d-ba61-323d-93a0-830c8889bc34",
                                                "text": "Et si le monde contemporain ne renferme pas des racines pour une nouvelle morale, que deviendra-t-il ? Les gémissements d'une bourgeoisie pleurnicharde ne le sauveront pas, s'il a vraiment perdu ses mœurs pour toujours."
                                            },
                                            {
                                                "example_id": "08d7c21d-2552-4a7d-bbfa-7a8efa60eb11",
                                                "sense_id": "7581d60d-ba61-323d-93a0-830c8889bc34",
                                                "text": "Voilà ce qu'il faut réapprendre aux Français, gâtés d'un côté par les prétentions, le snobisme, la fausse élégance, de l'autre par une philosophie pleurnicharde, toute faite d'abandons à une sensibilité assez vile, à une sensiblerie aussi vaine que dévirilisante."
                                            },
                                            {
                                                "example_id": "8e842e1e-a75b-442e-81f9-0a655491f7e9",
                                                "sense_id": "7581d60d-ba61-323d-93a0-830c8889bc34",
                                                "text": "Le plus grand défaut des externes, c’est qu’ils étaient facilement pleurnichards."
                                            },
                                            {
                                                "example_id": "4aaf3c57-7fd9-4b44-85df-c1e4ac1c5737",
                                                "sense_id": "7581d60d-ba61-323d-93a0-830c8889bc34",
                                                "text": "Je prétends que la vraie charité doit être couillue, pas pleurnicharde, ni dégoulinante de bonté. Quand les gens éclatent en sanglots c'est souvent parce qu'ils ne peuvent pas te dire que tu les fais chier."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pleurnichard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "53a2281f-1d38-32fc-9990-5bc8ea69412a",
                                        "entry_id": "47a36d45-e101-393b-963c-6738424d62cc",
                                        "glosses": [
                                            "Celui qui pleurniche facilement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b549c69-46b6-4bc9-9040-d314bdb53d11",
                                                "sense_id": "53a2281f-1d38-32fc-9990-5bc8ea69412a",
                                                "text": "J’ai parfois envie de crever le mur qui me sépare de mon voisin, de le prendre par le cou et de lui hurler d’arrêter sa récitation de pleurnichard, d’assumer le monde, d’ouvrir les yeux sur sa propre force et sa dignité et d’arrêter de courir derrière un père qui a fugué vers les cieux et qui ne reviendra jamais."
                                            },
                                            {
                                                "example_id": "d079cdc2-4663-4e68-8fff-be94f115280f",
                                                "sense_id": "53a2281f-1d38-32fc-9990-5bc8ea69412a",
                                                "text": "Elle pleure pour un rien ; c’est une vraie pleurnicharde !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2bfabf4-01d7-436c-9c8b-f21889e62621",
                        "source_entry_id": "60ea7023-7d4d-3733-8771-1f2cbd279f11",
                        "source_sense_id": "3bd563ce-9c5b-3bc3-83a2-f1f1534767af",
                        "target_lang_word": "pleureur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pleureur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b85f6aa9-da05-388a-bea6-a17c25413ac2",
                                        "entry_id": "02524594-9546-3b68-b7bc-55b2eb5dfe23",
                                        "glosses": [
                                            "Qui pleure facilement, larmoyant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "763fba02-4b12-4531-853f-97853728cf79",
                                                "sense_id": "b85f6aa9-da05-388a-bea6-a17c25413ac2",
                                                "text": "Tu fus cette avidité pleureuse quêtant le lait pour les exigences de la suite."
                                            },
                                            {
                                                "example_id": "4f6b29fd-a1d6-4f8c-bcf1-6fe26b2b9744",
                                                "sense_id": "b85f6aa9-da05-388a-bea6-a17c25413ac2",
                                                "text": "Un ton pleureur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2936c443-f45e-3917-ba1a-b6e9e8368d2c",
                                        "entry_id": "02524594-9546-3b68-b7bc-55b2eb5dfe23",
                                        "glosses": [
                                            "Qualifie un arbre ou un arbuste, dont les branches frêles et longues pendent vers la terre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d20aaac-ffc5-4532-9c85-39fba004403b",
                                                "sense_id": "2936c443-f45e-3917-ba1a-b6e9e8368d2c",
                                                "text": "Saule pleureur, frêne pleureur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "778dec99-f841-381a-bb0d-fb0d050740a0",
                                        "entry_id": "02524594-9546-3b68-b7bc-55b2eb5dfe23",
                                        "glosses": [
                                            "Qui laisse filtrer l’eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6c204f0-5c51-460a-83c9-11f139ee0b0e",
                                                "sense_id": "778dec99-f841-381a-bb0d-fb0d050740a0",
                                                "text": "Une roche pleureuse."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pleureur",
