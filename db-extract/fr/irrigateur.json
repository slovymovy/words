                "senses": [
                    {
                        "sense_id": "a81e101e-8f67-3bf4-b329-7aaab140c49a",
                        "entry_id": "0ccf488d-0ea7-3392-9985-928b41807122",
                        "glosses": [
                            "Appareil qui sert à faire des lavements ou des injections de liquide nettoyant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b15fee2-1a57-4f13-84a6-1252e7653934",
                                "sense_id": "a81e101e-8f67-3bf4-b329-7aaab140c49a",
                                "text": "Un irrigateur dentaire."
                            },
                            {
                                "example_id": "dd27952b-0ec3-46e8-b59d-c21b70763064",
                                "sense_id": "a81e101e-8f67-3bf4-b329-7aaab140c49a",
                                "text": "Un irrigateur nasal."
                            },
                            {
                                "example_id": "1e7c6ba2-8b8c-43df-a71c-626078e443fd",
                                "sense_id": "a81e101e-8f67-3bf4-b329-7aaab140c49a",
                                "text": "Un irrigateur vaginal."
                            }
                        ]
                    },
                    {
                        "sense_id": "28fae311-706c-38b5-aafd-990b4ae6efe6",
                        "entry_id": "0ccf488d-0ea7-3392-9985-928b41807122",
                        "glosses": [
                            "Appareil qui sert à arroser des allées, des gazons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25dceeef-2bf5-4609-98fe-e29f0ef9a05f",
                                "sense_id": "28fae311-706c-38b5-aafd-990b4ae6efe6",
                                "text": "Chaque matin, avant de partir pour son bureau (car il est employé quelque part), monsieur descend en pantalon et en manches de chemise, et il pompe, il pompe, il pompe à perdre haleine pour alimenter son irrigateur champêtre."
                            }
                        ]
                    },
                    {
                        "sense_id": "96a528dc-d872-305f-a710-e15c4d8bd2bb",
                        "entry_id": "0ccf488d-0ea7-3392-9985-928b41807122",
                        "glosses": [
                            "Celui qui arrose, qui s’occupe de travaux d’irrigation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b9ddf3e-c644-4e0d-a1a3-58e1f5351d94",
                                "sense_id": "96a528dc-d872-305f-a710-e15c4d8bd2bb",
                                "text": "Non, je préfère la condition d’irrigateur, c’est moins commun…"
                            },
                            {
                                "example_id": "31fe8b61-f532-4eee-8bf8-3b07adf05a08",
                                "sense_id": "96a528dc-d872-305f-a710-e15c4d8bd2bb",
                                "text": "L'irrigateur doit être, dans tous les instans, maître absolu de l’eau ; il doit pouvoir la conduire à volonté dans chaque partie du terrain, et l'évacuer promptement."
                            }
                        ]
                    }
                ],
