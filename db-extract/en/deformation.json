                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vervorming",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "274ce668-87d3-308c-aef3-52ee981d8ca4",
                                        "entry_id": "5865db9a-b534-30a9-b2f7-55017170b95a",
                                        "glosses": [
                                            "een ongeplande verandering van iets"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5af907d9-7000-4c8e-b571-d704b8606043",
                                                "sense_id": "274ce668-87d3-308c-aef3-52ee981d8ca4",
                                                "text": "Kankercellen zijn soepeler dan gezonde. Van die eigenschap is gebruik gemaakt om de vervorming van cellen bij een botsing te gebruiken om kanker vast te stellen. Onderzoekers in Los Angeles maakten een chip met nauwe kanaaltjes waar duizenden cellen per seconde één voor één doorheen gevoerd worden. In de chip botsen ze op een ‘muur’ van water, waarbij ze meer of minder vervormen. Een speciale camera die 140.000 opnames per seconde schiet registreert wat er gebeurt. Een computer analyseert de beelden, meet vervorming op en geeft op welk deel van alle cellen mogelijk kankercellen zijn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d49207ee-661c-37bc-9400-01857c583c21",
                                        "entry_id": "5865db9a-b534-30a9-b2f7-55017170b95a",
                                        "glosses": [
                                            "het proces van iets een andere vorm geven"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a5af87d-8558-410d-b5a0-d3826551622c",
                                                "sense_id": "d49207ee-661c-37bc-9400-01857c583c21",
                                                "text": "Het meten van zwaartekrachtgolven is een belangrijke vernieuwing in de natuur- en sterrekunde. Het bestaan van zwaartekrachtgolven is in 1916 voorspeld door Albert Einstein. Einstein stelde de zwaartekracht voor als een vervorming van de ruimtetijd: hoe zwaarder een object, des te sterker die vervorming."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "387e33c5-4c4e-4965-a8d8-a40c601681b8",
                        "source_entry_id": "f1f20108-f42e-3e58-930a-86803dc3a1dd",
                        "source_sense_description": "act of deforming, or state of being deformed",
                        "target_lang_word": "déformation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déformation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "065036c4-fe98-37ea-9451-3777520d8ec8",
                                        "entry_id": "1d946b5b-0e1c-3bf0-a3fe-b40ef167eb4a",
                                        "glosses": [
                                            "Action de déformer, ou résultat de cette action."
                                        ],
                                        "tags": [
                                            "generally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f6bef29-4239-4296-8743-bfa4202fab5a",
                                                "sense_id": "065036c4-fe98-37ea-9451-3777520d8ec8",
                                                "text": "La déformation du langage, son altération par l’incorrection des mots ou des tours de phrases."
                                            },
                                            {
                                                "example_id": "58b61f2b-8d89-4f69-93d5-327014e683a8",
                                                "sense_id": "065036c4-fe98-37ea-9451-3777520d8ec8",
                                                "text": "Dans ce cas, le conformisme s’avère être également une déformation de l’évidence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e03161f2-08bc-3b1e-bbfe-ee7d5a55039e",
                                        "entry_id": "1d946b5b-0e1c-3bf0-a3fe-b40ef167eb4a",
                                        "glosses": [
                                            "Altération de la forme de quelque partie du corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a667a51-7ee7-44d7-af1b-cf6278487183",
                                                "sense_id": "e03161f2-08bc-3b1e-bbfe-ee7d5a55039e",
                                                "text": "La déformation de la tête, du bassin."
                                            },
                                            {
                                                "example_id": "3fc02297-8039-4509-b18a-744cc509b38a",
                                                "sense_id": "e03161f2-08bc-3b1e-bbfe-ee7d5a55039e",
                                                "text": "HP compte également parmi ses clients l’entreprise française Chabloz qui imprime des casques destinées à corriger les déformations positionnelles ou posturales chez les jeunes enfants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d91eb7d-3e44-342d-a3de-aa791e2e45ba",
                                        "entry_id": "1d946b5b-0e1c-3bf0-a3fe-b40ef167eb4a",
                                        "glosses": [
                                            "Perturbation de la forme ou de la taille d’un corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a362f08-133c-462c-a9c8-75bcf1ab5230",
                                                "sense_id": "8d91eb7d-3e44-342d-a3de-aa791e2e45ba",
                                                "text": "Un matériau peut montrer deux types de déformation sous champ électrique : l’électrostriction et la piézoélectricité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0d56f08-558f-3159-a6d4-0d6caaec018d",
                                        "entry_id": "1d946b5b-0e1c-3bf0-a3fe-b40ef167eb4a",
                                        "glosses": [
                                            "Déformation mécanique : perturbation de la géométrie d’un corps sous l’effet d’une contrainte mécanique."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2a297c8-6fc8-48ff-933a-2c1d0ed6f90f",
                                                "sense_id": "e0d56f08-558f-3159-a6d4-0d6caaec018d",
                                                "text": "Le résultat de l’essai de traction est illustré par la courbe de traction, ou courbe contrainte-déformation, montrant la relation entre la contrainte (en ordonnée) et la déformation (en abscisse)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
