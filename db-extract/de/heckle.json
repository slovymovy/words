                "senses": [
                    {
                        "sense_id": "0e330161-a05d-3967-9669-3c1c8fcabb71",
                        "entry_id": "526052d9-034b-3a2f-901a-4ff0309de5e4",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9b01755-cd02-480b-8e94-7037854a72e8",
                                "sense_id": "0e330161-a05d-3967-9669-3c1c8fcabb71",
                                "text": "Frau Heckle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "9edeeb41-05d0-498e-ac3a-cb4471eabf13",
                                "sense_id": "0e330161-a05d-3967-9669-3c1c8fcabb71",
                                "text": "Herr Heckle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c2d2bc6c-55c8-4fdf-8286-350d22a9b43e",
                                "sense_id": "0e330161-a05d-3967-9669-3c1c8fcabb71",
                                "text": "Die Heckles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "34f54175-afbd-4318-9d5a-cae992b0305b",
                                "sense_id": "0e330161-a05d-3967-9669-3c1c8fcabb71",
                                "text": "Der Heckle trägt nie die Pullover, die die Heckle ihm strickt."
                            },
                            {
                                "example_id": "206e81d9-ccb6-4ae1-ba2c-87e00169269e",
                                "sense_id": "0e330161-a05d-3967-9669-3c1c8fcabb71",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Heckle kommt, geht der Herr Heckle.“"
                            },
                            {
                                "example_id": "0c484a0d-68c0-4317-916e-39579608cd1c",
                                "sense_id": "0e330161-a05d-3967-9669-3c1c8fcabb71",
                                "text": "Heckle kommt und geht."
                            },
                            {
                                "example_id": "aee72ffa-365e-4780-bdb1-2e8b3bfa2625",
                                "sense_id": "0e330161-a05d-3967-9669-3c1c8fcabb71",
                                "text": "Heckles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
