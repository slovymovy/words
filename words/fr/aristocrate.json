    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "82076572-5614-3535-9eff-07adc416def3",
                    "sense_definition": "Personne qui appartient à l'aristocratie, à la noblesse.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "noblesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce jeune <w>aristocrate</w> a hérité d'un immense château situé dans le sud de la France."
                        },
                        {
                            "text": "Pendant la Révolution française, de nombreux <w>aristocrates</w> ont été contraints de fuir le pays."
                        }
                    ],
                    "synonyms": [
                        "gentilhomme",
                        "noble"
                    ],
                    "antonyms": [
                        "roturier"
                    ]
                },
                {
                    "sense_id": "fa12e78f-29ae-3298-8851-51dc68582add",
                    "sense_definition": "Partisan de l'aristocratie ou du pouvoir politique des nobles.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les révolutionnaires considéraient tout opposant au régime comme un dangereux <w>aristocrate</w>."
                        },
                        {
                            "text": "Ce journal dénonçait vigoureusement les <w>aristocrates</w> soupçonnés de conspirer contre la nation."
                        }
                    ],
                    "synonyms": [
                        "royaliste"
                    ]
                },
                {
                    "sense_id": "f6759769-dd32-34ff-bbe5-a7f7b0c25205",
                    "sense_definition": "Personne qui adopte les manières, les goûts raffinés ou le genre de vie de la haute société.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avec ses manières hautaines et son dédain du peuple, il se prend volontiers pour un <w>aristocrate</w>."
                        },
                        {
                            "text": "Ce collectionneur vit comme un <w>aristocrate</w> au milieu de ses tableaux précieux."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f27fb3f3-8b29-3966-94b0-6fad2aa63a28",
                    "sense_definition": "Qui a le caractère, les manières ou les préjugés propres à la noblesse.",
