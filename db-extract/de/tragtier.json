                "senses": [
                    {
                        "sense_id": "cb708c52-b8db-3970-86f7-06ec4f13d09c",
                        "entry_id": "c51be816-e3fe-3ddd-afdd-a06837ebbe83",
                        "glosses": [
                            "nichtmenschliches Lebewesen zum Lastentransport"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b46d64da-2fe5-4747-bdfc-3dba39ed8594",
                                "sense_id": "cb708c52-b8db-3970-86f7-06ec4f13d09c",
                                "text": "„Unberührt von den Sparplänen bleibt die Hochgebirgstruppe: In Hochfilzen werden weiterhin Haflinger als Tragtiere ausgebildet und eingesetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2ba1bdc4-a9c2-4189-9ba2-146d7fc6a867",
                        "source_entry_id": "c51be816-e3fe-3ddd-afdd-a06837ebbe83",
                        "source_sense_id": "cb708c52-b8db-3970-86f7-06ec4f13d09c",
                        "source_sense_description": "nichtmenschliches Lebewesen zum Lastentransport",
                        "target_lang_word": "bête de somme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bête de somme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "86133ce6-dd14-3dd0-b74a-ac76477a8b1f",
                                        "entry_id": "3eb45340-c77d-3061-946a-4731288410c2",
                                        "glosses": [
                                            "Animal qui porte ou tire une charge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3cb0d5d-ad7d-4cab-bed1-67a2ebd142aa",
                                                "sense_id": "86133ce6-dd14-3dd0-b74a-ac76477a8b1f",
                                                "text": "Ils n’osèrent pas, en effet, atteler devant nous les chrétiens qui s’étaient munis de cordes, et ils les forcèrent seulement de nous accompagner jusqu’au sommet […] « Un jour viendra où vous ne serez plus attelés comme des bêtes de somme. Prenez patience et espérez. »"
                                            },
                                            {
                                                "example_id": "f441f20d-7beb-47dc-ae89-62160a510267",
                                                "sense_id": "86133ce6-dd14-3dd0-b74a-ac76477a8b1f",
                                                "text": "Mais si l’exactitude est la politesse des rois, elle n’est pas assurément une vertu des caravaniers marocains. À huit heures et demie les bêtes de somme ne sont pas encore arrivées."
                                            },
                                            {
                                                "example_id": "c9b48ff2-239f-4da9-9a5a-9723ca0b4920",
                                                "sense_id": "86133ce6-dd14-3dd0-b74a-ac76477a8b1f",
                                                "text": "Au Tchad, nous changerons nos chevaux de réquisition (qui sont d’insignes rosses) et nos bêtes de somme contre des chameaux pour continuer notre route dans la zone désertique d’Agadem."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
