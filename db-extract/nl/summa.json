                    {
                        "translation_id": "7bcd073b-a69d-480d-ad78-89e2765772d6",
                        "source_entry_id": "a4297408-1683-3f93-a4e5-1cfd73d30347",
                        "source_sense_id": "2d3283bc-b5e8-3509-9487-46f42299bf04",
                        "source_sense_description": "de (optel)som van iets; alle te samen genomen",
                        "target_lang_word": "amount",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amount",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3acbdde2-add8-3561-9155-25d61cfaaabb",
                                        "entry_id": "3079e00b-b239-38bb-90d8-34b059d8e0d8",
                                        "glosses": [
                                            "The total, aggregate or sum of material (not applicable to discrete numbers or units or items in standard English)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6b35072-7fb6-4cb6-b08e-57c9961447d5",
                                                "sense_id": "3acbdde2-add8-3561-9155-25d61cfaaabb",
                                                "text": "The amount of atmospheric pollution threatens a health crisis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "346520b2-db20-3814-a971-a4bcfdc23659",
                                        "entry_id": "3079e00b-b239-38bb-90d8-34b059d8e0d8",
                                        "glosses": [
                                            "A quantity or volume."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aedf877f-e66d-4721-a3d0-6b0443b2396f",
                                                "sense_id": "346520b2-db20-3814-a971-a4bcfdc23659",
                                                "text": "Pour a small amount of water into the dish."
                                            },
                                            {
                                                "example_id": "24130b9b-d7aa-42c6-8afa-4a4179a58178",
                                                "sense_id": "346520b2-db20-3814-a971-a4bcfdc23659",
                                                "text": "The dogs need different amounts of food."
                                            },
                                            {
                                                "example_id": "276af064-3b0e-46ad-a140-739669ce8c93",
                                                "sense_id": "346520b2-db20-3814-a971-a4bcfdc23659",
                                                "text": "The use of algorithms in policing is one example of their increasing influence on our lives.[…]who, if anyone, is policing their use[?] Such concerns were sharpened further by the continuing revelations about how the US National Security Agency (NSA) has been using algorithms to help it interpret the colossal amounts of data it has collected from its covert dragnet of international telecommunications."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0776ab34-46ea-3f11-b923-8d11b931a873",
                                        "entry_id": "3079e00b-b239-38bb-90d8-34b059d8e0d8",
                                        "glosses": [
                                            "The number (the sum) of elements in a set."
                                        ],
                                        "tags": [
                                            "nonstandard",
                                            "proscribed",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e3f6330-2ef7-472d-821e-7dc112e95e21",
                                                "sense_id": "0776ab34-46ea-3f11-b923-8d11b931a873",
                                                "text": "The final amount of students who have participated to mobility for the period 1995-1999 is held to be around 460 000."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "amount",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22cdd3b8-e1e3-30af-8703-514cda8b20ee",
                                        "entry_id": "4cbf7f4e-22f9-376c-b27e-b03426de885c",
                                        "glosses": [
                                            "To total or evaluate."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "with-to"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a1ef160-2a6d-4240-b6f2-587838687cdf",
                                                "sense_id": "22cdd3b8-e1e3-30af-8703-514cda8b20ee",
                                                "text": "The money in my pocket amounts to three dollars and change."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "207c13b9-ff67-3e56-b556-2d3c19fd88cb",
                                        "entry_id": "4cbf7f4e-22f9-376c-b27e-b03426de885c",
                                        "glosses": [
                                            "To be the tantamount to; to reach up to the level of."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "with-to"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91198246-bcf5-4a1a-b7cc-12764e0d5a49",
                                                "sense_id": "207c13b9-ff67-3e56-b556-2d3c19fd88cb",
                                                "text": "His response amounted to gross insubordination."
                                            },
                                            {
                                                "example_id": "d10c5ba7-9274-47d4-a662-67c87e26e86b",
                                                "sense_id": "207c13b9-ff67-3e56-b556-2d3c19fd88cb",
                                                "text": "He was a pretty good student, but never amounted to much professionally."
                                            },
                                            {
                                                "example_id": "47f7f294-11e9-44d7-b70b-4cc434669a49",
                                                "sense_id": "207c13b9-ff67-3e56-b556-2d3c19fd88cb",
                                                "text": "It was, however, J.R.R. Tolkien who pointed out the close relationship in language as well as spelling, almost amounting to identity, between the Corpus MS of the Ancrene Riwle (A) and the Bodley MS of the Katherine Group (B)."
                                            },
                                            {
                                                "example_id": "9e355bcb-eafb-4c5b-a352-e9e6c95db1bb",
                                                "sense_id": "207c13b9-ff67-3e56-b556-2d3c19fd88cb",
                                                "text": "\"The breadth of this LPR system is spectacular and amounts to a warrantless search.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5336aba-6544-3076-a79a-879ba39f1982",
                                        "entry_id": "4cbf7f4e-22f9-376c-b27e-b03426de885c",
                                        "glosses": [
                                            "To go up; to ascend."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4830d57b-3ba6-40b3-b9c8-948b93a1d444",
                                                "sense_id": "f5336aba-6544-3076-a79a-879ba39f1982",
                                                "text": "So up he rose, and thence amounted straight."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
