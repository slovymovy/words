                                        "sense_id": "edb397ed-a3fd-386f-8503-ca5470d0ecc6",
                                        "entry_id": "405a4340-b898-3ac0-b521-a6e5bc7a549f",
                                        "glosses": [
                                            "Somebody or something that appears in the final stage of a competition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f365c778-f44e-4965-bf10-d7bf4849ec83",
                                                "sense_id": "edb397ed-a3fd-386f-8503-ca5470d0ecc6",
                                                "text": "If the disqualifications leave a vacancy for the full complement of finalists, swim-offs shall be continued among the disqualified swimmers until a full complement of finalists is assured."
                                            },
                                            {
                                                "example_id": "49f6e2b9-592a-4b99-8956-8339b1405935",
                                                "sense_id": "edb397ed-a3fd-386f-8503-ca5470d0ecc6",
                                                "text": "Soto was a finalist once before in right field, in 2022, when he lost to the Los Angeles Dodgers’ Mookie Betts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68caaddd-e57f-39c2-a1dc-48ba9011009d",
