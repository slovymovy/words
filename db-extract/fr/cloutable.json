                        "entry_id": "f7c97401-e39c-3365-80a0-69b69a6d6dcf",
                        "glosses": [
                            "Qui peut être garni de clous."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc2b0112-f9d2-4a24-b737-e73df61c377a",
                                "sense_id": "f291bb5b-1eb2-3201-acec-c449f2020ed8",
                                "text": "Chaussure de trail running idéale pour courir en toute sécurité dans les mois d’hiver même sur des terrains verglacés ou enneigés grâce à la semelle cloutable."
                            }
                        ]
                    },
                    {
                        "sense_id": "360f0aa1-c72f-3f1c-85dc-b88dec1e4551",
                        "entry_id": "f7c97401-e39c-3365-80a0-69b69a6d6dcf",
                        "glosses": [
                            "Qualifie un pneu qui peut être clouté."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "4548cf33-565f-4167-add1-3712969a7d8f",
                                "sense_id": "360f0aa1-c72f-3f1c-85dc-b88dec1e4551",
                                "text": "Pour répondre aux exigences des conditions hivernales les plus difficiles, ce pneumatique est cloutable."
                            },
                            {
                                "example_id": "6e1aa62f-c6a0-4261-8367-8bd74905b013",
                                "sense_id": "360f0aa1-c72f-3f1c-85dc-b88dec1e4551",
                                "text": "Contrairement au pneu clouté équipé de clous fixes, le pneu cloutable se compose d’une bande de roulement moulée de petits trous capables d’accueillir des clous amovibles. On en dénombre entre 80 et 100 par pneu."
                            },
                            {
                                "example_id": "96c8f9b8-3cce-4cef-b629-385e784f6fc4",
                                "sense_id": "360f0aa1-c72f-3f1c-85dc-b88dec1e4551",
                                "text": "Il existe également des pneus cloutables, dont la semelle a été fabriquée pour accueillir des clous, installés lors de l’achat."
                            }
                        ]
                    }
