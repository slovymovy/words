                ],
                "senses": [
                    {
                        "sense_id": "7001b439-e438-3abc-8c42-4592ed60a293",
                        "entry_id": "aecb5f28-9bcf-3793-bc09-4754d4a880d6",
                        "glosses": [
                            "Gesamtheit der Bedingungen und Umstände, Realität des Spielens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40611cb0-de81-41be-ac40-90a10b0c11b7",
                                "sense_id": "7001b439-e438-3abc-8c42-4592ed60a293",
                                "text": "„Erst wenn die Spielenden ein gemeinsames Bewusstsein von der Situation des Spiels haben und die neuen Bedeutungen von Gegenständen und Handlungen im Unterschied zur alltäglichen Bedeutung als gemeinsame Sichtweise miteinander teilen, kann die Spielwirklichkeit bzw. Spielsituation in Kraft treten.“"
                            },
                            {
                                "example_id": "72d1c980-5b2a-4e10-903c-1ca2ee732cb5",
                                "sense_id": "7001b439-e438-3abc-8c42-4592ed60a293",
                                "text": "„Für Kinder und Jugendliche kann die Symbolebene des Spiels eine solche Wirklichkeitsdichte und Mächtigkeit annehmen, dass Lebensrealität und Spielwirklichkeit nicht mehr unterschieden werden und der Spielende ganz in seiner Fantasiewelt aufgeht und lebt.“"
                            },
                            {
                                "example_id": "dc265b2c-c0dd-427a-904e-df30428c0910",
                                "sense_id": "7001b439-e438-3abc-8c42-4592ed60a293",
                                "text": "„Für viele Fußballfans ist die Ablehnung von Technik eine Kulturfrage, obwohl es nur um Tor oder nicht geht und sich die Spielwirklichkeit nur minimal ändern dürfte.“"
                            },
                            {
                                "example_id": "eb6615e2-04b3-4fc6-a303-5df965350c17",
                                "sense_id": "7001b439-e438-3abc-8c42-4592ed60a293",
                                "text": "„Es gibt nämlich eine Wende im Stück, ein Loch in der Spielwirklichkeit.“"
                            },
                            {
                                "example_id": "9ba4d10e-f953-4b82-8457-2fddd39d35c6",
                                "sense_id": "7001b439-e438-3abc-8c42-4592ed60a293",
                                "text": "„Die Spielwirklichkeiten des Computers und die Schulrealität liegen endlos weit auseinander, zwei Wirklichkeiten fast ohne Berührung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
