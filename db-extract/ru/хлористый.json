                                        "glosses": [
                                            "Chlor enthaltend, beinhaltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e635d4e-d33c-4654-b7b2-ac8bae479595",
                                                "sense_id": "885c82fd-c757-3ddf-8332-3435ceb32294",
                                                "text": "Das Wasser im Schwimmbecken ist chlorhaltig."
                                            },
                                            {
                                                "example_id": "94f4de90-4c7b-4aad-8401-b5202b6db795",
                                                "sense_id": "885c82fd-c757-3ddf-8332-3435ceb32294",
                                                "text": "„Verschlucken Sie versehentlich ein chlorhaltiges Reinigungsmittel, brennt es zuerst im Mund, der Rachen schwillt an.“"
                                            },
                                            {
                                                "example_id": "9f3bba45-eb35-4e90-90d8-dac846c89879",
                                                "sense_id": "885c82fd-c757-3ddf-8332-3435ceb32294",
                                                "text": "„Offenbar wurde versehentlich chlorhaltiges Reinigungswasser zur Getränkeproduktion benutzt.“"
                                            },
                                            {
                                                "example_id": "aaa609ff-6b6a-4211-9885-33fbf2b26498",
                                                "sense_id": "885c82fd-c757-3ddf-8332-3435ceb32294",
                                                "text": "„Die Sonne trocknet die Haut stark aus, oft im Zusammenspiel mit salziger Meeresluft oder chlorhaltigem Poolwasser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
