                                "target_senses": [
                                    {
                                        "sense_id": "8127cb65-17e7-3bef-a66e-cac057a82b3a",
                                        "entry_id": "899ca1c2-a5ec-39d4-904b-7aa6d7e7e940",
                                        "glosses": [
                                            "A type of traditional French-Canadian meat pie, usually made with pork."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "Quebec",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "569ae10d-0622-4143-8b36-53c0738cfcee",
                                                "sense_id": "8127cb65-17e7-3bef-a66e-cac057a82b3a",
                                                "text": "Last December, I called my mother to get her recipe for tourtière, a beloved traditional French-Canadian dish. It would be the meaningful heart of a bundle of gifts I had lovingly gathered to honour a Métis elder I had recently met. To share this recipe for tourtière was to share a piece of my family’s story with this elder, to whom I owed a great debt of gratitude."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "733ca9d1-4258-4d47-90c6-a18bca66013f",
                        "source_entry_id": "46b00637-e602-3f10-88a7-dfc5a841618f",
                        "source_sense_id": "7d14436a-1ccb-3cf9-97ea-30c0007d62cb",
                        "target_lang_word": "tourtiere",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tourtiere",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bcdcf576-f9e5-3f19-870e-558e355564c0",
                                        "entry_id": "3441ae3d-d409-37f6-9340-e17701861429",
                                        "glosses": [
                                            "Alternative spelling of tourtière."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "alt-of",
                                            "alternative",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a7832d3-4a21-455c-897f-411c97689045",
                                                "sense_id": "bcdcf576-f9e5-3f19-870e-558e355564c0",
                                                "text": "What I wanted Anna to understand was that I was more from here than she was. At least half my people were from Cape Breton. Salt water did run in my veins. Okay, so it was mixed with a bit of tourtiere, but it was there."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
