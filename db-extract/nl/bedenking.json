                            {
                                "example_id": "7a59dab7-e484-464b-95b0-ce1f91d89b61",
                                "sense_id": "5b6907ff-5b61-3f94-a4c5-3b5892c1d370",
                                "text": "Als u het niet eens bent met een voorgenomen besluit van het gemeentebestuur kunt u in de meeste gevallen een zienswijze of bedenking indienen"
                            },
                            {
                                "example_id": "91575408-6ca3-4d20-adb5-d07fcf32786a",
                                "sense_id": "5b6907ff-5b61-3f94-a4c5-3b5892c1d370",
                                "text": "Het tegenkamp had daar natuurlijk bedenkingen bij, en zo ontstonden er hevige discussies die dagenlang aanhielden en die de toch al verhitte chaos waarin de rechtbank was gestort alleen maar verergerden."
                            }
                        ]
                    },
