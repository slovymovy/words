                ],
                "senses": [
                    {
                        "sense_id": "2123fb55-1b46-3656-91f9-953afe3d6b24",
                        "entry_id": "c6023fdb-ec43-3f00-b21b-14a7af64cebc",
                        "glosses": [
                            "свойство или состояние по значению прилагательного непрерывный"
                        ],
                        "tags": [],
