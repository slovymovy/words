                    {
                        "sense_id": "7096009c-8e48-3d99-b33f-20e99b43e0ce",
                        "entry_id": "f7a1abe7-e06b-3572-925d-a2152101cbea",
                        "glosses": [
                            "lekkernij gemaakt van bladerdeeg, driehoekig van vorm en gevuld met een mengsel van in blokjes gesneden appel en kaneel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eede013d-67a3-45dd-a2b8-541205e269de",
                                "sense_id": "7096009c-8e48-3d99-b33f-20e99b43e0ce",
                                "text": "Een appelflap kan eventueel worden aangevuld met amandelspijs, krenten en/of rozijnen."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf1aac68-e0b9-3a9a-9e01-089353eaf93a",
                        "entry_id": "f7a1abe7-e06b-3572-925d-a2152101cbea",
                        "glosses": [
                            "lekkernij bestaande uit een schijf appel en gefrituurd deeg dat met oud en nieuw gegeten wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e01ae396-5adf-4dff-94e7-4523c5eac84f",
                                "sense_id": "bf1aac68-e0b9-3a9a-9e01-089353eaf93a",
                                "text": "Mijn moeder maakte met oud en nieuw altijd ronde appelflappen met de frituurpan."
                            }
                        ]
                    },
                    {
                        "sense_id": "98af2c24-3f8c-3dfd-8bea-2c321d84d464",
                        "entry_id": "f7a1abe7-e06b-3572-925d-a2152101cbea",
                        "glosses": [
                            "dom persoon"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "29874bf3-1fad-496c-a160-584641edadaa",
                                "sense_id": "98af2c24-3f8c-3dfd-8bea-2c321d84d464",
                                "text": "Wat zijn jullie toch een rare appelflappen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ac62c6f-4b08-480d-82ce-e2cc398d8650",
                        "source_entry_id": "f7a1abe7-e06b-3572-925d-a2152101cbea",
                        "source_sense_id": "7096009c-8e48-3d99-b33f-20e99b43e0ce",
                        "source_sense_description": "lekkernij gemaakt van bladerdeeg, driehoekig van vorm en gevuld met een mengsel van in blokjes gesneden appel en kaneel",
                        "target_lang_word": "Apfeltasche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Apfeltasche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "70f61be6-0da3-38d1-b387-77f8d081761f",
                                        "entry_id": "0f1cabc4-a516-30a2-9b89-385ad130fb14",
                                        "glosses": [
                                            "Gebäck in Form einer Tasche, das mit Äpfeln gefüllt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d7bc51f-17b1-4648-bd04-427fea2939b7",
                                                "sense_id": "70f61be6-0da3-38d1-b387-77f8d081761f",
                                                "text": "„Zum Programm der Kurverwaltung gehören Apfeltaschen backen mit Quark-Öl-Vollkornteig, Häkelketten mit Glasperlen, ganzheitliche Körperschulung, sanftes Nordic Walking, Ausdrucksmalerei und Hormon-Yoga.“"
                                            },
                                            {
                                                "example_id": "fef0359b-7f7c-45d3-98f1-a67b8bcb1313",
                                                "sense_id": "70f61be6-0da3-38d1-b387-77f8d081761f",
                                                "text": "„Ein Reformationsbrötchen ist ein meist quadratisch aussehendes, süßes Gebäck, meist von der Größe einer Apfeltasche.“"
                                            },
                                            {
                                                "example_id": "7ae1b061-31da-4bd4-b68a-9747066f15f3",
                                                "sense_id": "70f61be6-0da3-38d1-b387-77f8d081761f",
                                                "text": "„Dazu gehört das Anheizen des Gemeindebackhauses sowie die Verkostung der örtlichen Spezialitäten, der Panade, einer Art aus Brotteig gefertigten Apfeltasche und des hier angebauten Weines.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6be12f4a-fc02-4308-a8b5-d0f36725f755",
                        "source_entry_id": "f7a1abe7-e06b-3572-925d-a2152101cbea",
