            "senses": [
                {
                    "sense_id": "f60a997b-c3c1-3b57-8086-4893ffc4218d",
                    "sense_definition": "De standaardeenheid van massa die gelijk is aan duizend gram.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "massa",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb een <w>kilogram</w> appels gekocht op de markt.",
                            "target_lang_translations": {
                                "en": "I bought a <w>kilogram</w> of apples at the market.",
                                "ru": "Я купил <w>килограмм</w> яблок на рынке."
                            }
                        },
                        {
                            "text": "Een liter water weegt ongeveer één <w>kilogram</w>.",
                            "target_lang_translations": {
                                "en": "One liter of water weighs approximately one <w>kilogram</w>.",
                                "ru": "Один литр воды весит примерно один <w>килограмм</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "kilo"
                    ],
                    "common_phrases": [
                        "een kilogram appels",
                        "per kilogram"
                    ],
                    "target_lang_definitions": {
                        "en": "The standard unit of mass equal to one thousand grams.",
                        "ru": "Стандартная единица массы, равная тысяче граммов."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "kilogram",
                                "target_lang_sense_clarification": "standard unit of mass"
                            },
                            {
                                "target_lang_word": "kg",
                                "target_lang_sense_clarification": "abbreviation for the unit of mass"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "килограмм",
                                "target_lang_sense_clarification": "единица измерения массы"
                            },
                            {
                                "target_lang_word": "кг",
                                "target_lang_sense_clarification": "сокращение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "348d270b-61fd-31bd-b60d-50fd3c753794",
                    "sense_definition": "Een eenheid die in het dagelijks leven wordt gebruikt om het gewicht van een object aan te duiden.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "massa",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deze zware fiets weegt toch nog achttien <w>kilogram</w>.",
                            "target_lang_translations": {
                                "en": "This heavy bike still weighs eighteen <w>kilograms</w>.",
                                "ru": "Этот тяжелый велосипед весит целых восемнадцать <w>килограммов</w>."
                            }
                        },
                        {
                            "text": "Hoeveel <w>kilogram</w> mag je meenemen in je koffer?",
                            "target_lang_translations": {
                                "en": "How many <w>kilograms</w> are you allowed to take in your suitcase?",
                                "ru": "Сколько <w>килограммов</w> можно брать с собой в чемодане?"
                            }
                        }
                    ],
                    "synonyms": [
                        "kilo"
                    ],
                    "common_phrases": [
                        "aantal kilogram",
                        "enkele kilogram"
                    ],
                    "target_lang_definitions": {
                        "en": "A unit used in daily life to indicate the weight of an object.",
                        "ru": "Единица измерения, используемая в повседневной жизни для обозначения веса объекта."
                    },
