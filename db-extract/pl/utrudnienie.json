                    {
                        "translation_id": "6746c55b-b6b8-40a2-b087-33a35b69abcf",
                        "source_entry_id": "53f9f766-c0ff-36bb-9d76-0ac384e63111",
                        "source_sense_id": "3b6d6d91-5144-3a6d-8d79-7ea751bfb38a",
                        "target_lang_word": "беспокойство",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "беспокойство",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ff5832f7-92bb-3f50-b36e-804aa1f0c798",
                                        "entry_id": "61f2a620-5fea-37e3-8ca0-974a61a53ae7",
                                        "glosses": [
                                            "тревожное состояние души, волнение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f98fbe8d-869f-4239-b986-ecd2480e7ddb",
                                                "sense_id": "ff5832f7-92bb-3f50-b36e-804aa1f0c798",
                                                "text": "Он с беспокойством ждал решения своей участи."
                                            },
                                            {
                                                "example_id": "dea8dfc0-b6a2-4c04-84d8-4bd7fc8ac931",
                                                "sense_id": "ff5832f7-92bb-3f50-b36e-804aa1f0c798",
                                                "text": "Им овладело беспокойство, // Охота к перемене мест // (Весьма мучительное свойство, // Немногих добровольный крест)."
                                            },
                                            {
                                                "example_id": "e70638d9-d7d9-4b2f-8ffa-adbe2abdad1d",
                                                "sense_id": "ff5832f7-92bb-3f50-b36e-804aa1f0c798",
                                                "text": "Мысль металась в поисках выхода, беспокойство все дальше проникало в глубину души, и росло нервное напряжение."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bfc0b90-70f2-3d67-93a6-901616b649fd",
                                        "entry_id": "61f2a620-5fea-37e3-8ca0-974a61a53ae7",
                                        "glosses": [
                                            "заботы, хлопоты"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c80dd83f-80b7-4b7f-aa76-41f02a013a30",
                                                "sense_id": "8bfc0b90-70f2-3d67-93a6-901616b649fd",
                                                "text": "Радушное беспокойство о ком или о чём."
                                            },
                                            {
                                                "example_id": "bd82f336-248c-4cf5-a5a1-f796bdc7c106",
                                                "sense_id": "8bfc0b90-70f2-3d67-93a6-901616b649fd",
                                                "text": "Мы за постой с проезжих ничего не берём, а только за свет, за тепло, за беспокойство."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
