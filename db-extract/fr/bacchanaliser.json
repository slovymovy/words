                "senses": [
                    {
                        "sense_id": "b8fae097-278b-3fe9-b330-44ae42e378fa",
                        "entry_id": "572e61c6-ae10-3581-a2c8-76dc0cadf5b4",
                        "glosses": [
                            "Se débaucher, s'enivrer."
                        ],
                        "tags": [
                            "dated",
                            "obsolete",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "d32e0813-c855-49d2-bb71-e2e03f1ad937",
                                "sense_id": "b8fae097-278b-3fe9-b330-44ae42e378fa",
                                "text": "Nous sommes au temps de Carnaval et, après que le narrateur a marqué en paroles ses distances avec « ceux qui prennent plaisir à folastrer et bacchanaliser » , il en vient, au terme d'une excusatio bien contournée, à suivre leur exemple et s'engager comme eux en un propos passablement « folastre », puisqu'il parlera « des chastrez »."
                            }
                        ]
                    }
