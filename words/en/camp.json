                    "target_lang_definitions": {
                        "ru": "Организованное мероприятие для отдыха, тренировок или занятий, часто проводимое на природе.",
                        "zh": "一种为娱乐、训练或活动而组织的活动，通常在户外或假期期间举行。"
                    },
                    "translations": {
                        "ru": [
                            {
