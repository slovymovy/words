                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dc4ad5e-a6b5-4fd7-bb32-9ea89f404a95",
                                                "sense_id": "d15ec336-35a5-3cae-a88e-098e9270990a",
                                                "text": "С раннего утра я и моя Пшевочка засели за препарирование присланных Канаевым птичек и к полудню, или, точнее, к часовому наблюдению, всех их отпрепарировали."
                                            }
