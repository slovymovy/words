                                    {
                                        "sense_id": "4a40f975-4b5d-3c20-a390-482f2f114695",
                                        "entry_id": "7cde4618-df19-3eee-a035-1c684f25ca25",
                                        "glosses": [
                                            "Matière comprimée de façon à former briques, briquettes, blocs, planches, etc.",
                                            "Brique, bloc de béton ou parpaing fabriqué par un mélange de matières diverses (sables, cailloux, scories, déchets végétaux, bois, liège, paille, etc.) agrégé avec un liant (colle, ciment, résine…) et comprimé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa79b57b-a895-4ef6-a69c-55532025ea57",
                                                "sense_id": "4a40f975-4b5d-3c20-a390-482f2f114695",
                                                "text": "En maçonnerie on désigne les parpaings par le terme d'agglomérés ou plus souvent par la forme abrégée « agglo »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a56a4161-e5d3-399a-84a5-871cb1835ad4",
                                        "entry_id": "7cde4618-df19-3eee-a035-1c684f25ca25",
                                        "glosses": [
                                            "Matière comprimée de façon à former briques, briquettes, blocs, planches, etc.",
                                            "Panneau de particules de bois (sciure, échardes, etc.) encollées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61464c23-a9aa-4edd-a9d3-111d8728a844",
                                                "sense_id": "a56a4161-e5d3-399a-84a5-871cb1835ad4",
                                                "text": "En menuiserie on peut utiliser des panneaux d’aggloméré."
                                            },
                                            {
                                                "example_id": "d2051f12-c7ca-4583-9a56-4271574774f6",
                                                "sense_id": "a56a4161-e5d3-399a-84a5-871cb1835ad4",
                                                "text": "Quand le bois est destiné à la trituration, il sera livré à une usine qui va le broyer pour fabriquer de la pâte à papier ou reconstituer des panneaux en fibres de bois ou en particules de bois aggloméré."
                                            }
                                        ]
                                    },
