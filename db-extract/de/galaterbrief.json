                "senses": [
                    {
                        "sense_id": "704406a8-f761-3a3f-a2d9-7f2c00b210ed",
                        "entry_id": "0878257e-bd64-3286-969d-4f68eea2f234",
                        "glosses": [
                            "ein Buch des Neuen Testaments in der Bibel; verfasst von dem Apostel Paulus an die Gemeinden in Galatien"
                        ],
                        "tags": [
                            "Theologie"
                        ],
                        "examples": [
                            {
                                "example_id": "21f542e2-c84a-422d-af23-12adf4790c1d",
                                "sense_id": "704406a8-f761-3a3f-a2d9-7f2c00b210ed",
                                "text": "Die moderne Bibelwissenschaft sieht in Übereinstimmung mit der Tradition als gesichert an, dass der Apostel Paulus von Tarsus der Autor des Galaterbriefs ist."
                            },
                            {
                                "example_id": "528a8271-c561-4b1c-8c58-412623ec5c0c",
                                "sense_id": "704406a8-f761-3a3f-a2d9-7f2c00b210ed",
                                "text": "„Paulus verfolgt im Galaterbrief das Ziel, die Galater vor dem Einfluß judaistischer Missionare zu warnen, die die aus dem Heidentum Bekehrten auf das jüdische Gesetz verpflichten wollten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
