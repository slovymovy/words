                            {
                                "target_lang_word": "чернильный",
                                "target_lang_sense_clarification": "в чернильных пятнах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4eedaf9c-1ed9-3991-a236-77ac2566b1bd",
