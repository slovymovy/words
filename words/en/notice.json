{
    "word_family": [
        "noticeable",
        "noticeably",
        "unnoticed",
        "notification",
        "notify"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6c1a7345-f3f5-36a7-8bb4-7e3a66b942dd",
                    "sense_definition": "To become aware of something through the senses, especially by seeing or hearing it.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Did you <w>notice</w> the flowers in her yard when you walked past?",
                            "target_lang_translations": {
                                "ru": "Ты <w>заметил</w> цветы в её дворе, когда проходил мимо?"
                            }
                        },
                        {
                            "text": "I <w>noticed</w> a small change in his voice during the phone call.",
                            "target_lang_translations": {
                                "ru": "Я <w>заметил</w> небольшое изменение в его голосе во время телефонного разговора."
                            }
                        }
                    ],
                    "synonyms": [
                        "recognize"
                    ],
                    "antonyms": [
                        "ignore",
                        "neglect"
                    ],
                    "common_phrases": [
                        "notice a difference",
                        "hardly notice",
                        "fail to notice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Осознать что-либо с помощью органов чувств, особенно увидев или услышав это."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замечать",
                                "target_lang_sense_clarification": "обнаруживать что-либо"
                            },
                            {
                                "target_lang_word": "заметить",
                                "target_lang_sense_clarification": "обратить внимание на что-либо"
                            },
                            {
                                "target_lang_word": "обращать внимание",
                                "target_lang_sense_clarification": "фиксировать взгляд или слух"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a64e047-d5ba-3049-b85e-7163cdac0bf3",
                    "sense_definition": "To mention or remark upon something briefly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author <w>notices</w> several important arguments in the final chapter of the book.",
                            "target_lang_translations": {
                                "ru": "Автор <w>отмечает</w> несколько важных аргументов в последней главе книги."
                            }
                        },
                        {
                            "text": "I must <w>notice</w> a few points before we conclude the meeting.",
                            "target_lang_translations": {
                                "ru": "Я должен <w>упомянуть</w> несколько моментов, прежде чем мы завершим встречу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "worth noticing"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in formal writing or speeches"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кратко упомянуть или высказаться о чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замечать",
                                "target_lang_sense_clarification": "вставлять реплику в разговор"
                            },
                            {
                                "target_lang_word": "отмечать",
                                "target_lang_sense_clarification": "упоминать в речи или тексте"
                            },
                            {
                                "target_lang_word": "упоминать",
                                "target_lang_sense_clarification": "касаться темы вскользь"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0f93517-e4aa-380b-bbea-4b351428c39d",
                    "sense_definition": "To be easily seen or evident; to show.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "visibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stain on the carpet doesn't <w>notice</w> much under this dim lighting.",
                            "target_lang_translations": {
                                "ru": "Пятно на ковре не очень <w>заметно</w> при таком тусклом освещении."
                            }
                        },
                        {
                            "text": "The small scratch on the car will not <w>notice</w> once we polish it.",
                            "target_lang_translations": {
                                "ru": "Маленькая царапина на машине не будет <w>видна</w>, как только мы её отполируем."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть легко видимым или очевидным; выделяться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быть заметным",
                                "target_lang_sense_clarification": "бросаться в глаза"
                            },
                            {
                                "target_lang_word": "виднеться",
                                "target_lang_sense_clarification": "быть видимым"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a0bf56a-6d2d-38a6-8157-d2fafd664599",
                    "sense_definition": "To treat someone with kindness or give them special attention.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "attention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided she would <w>notice</w> the young girl and introduce her to society.",
                            "target_lang_translations": {
                                "ru": "Она решила, что <w>удостоит вниманием</w> молодую девушку и представит её обществу."
                            }
                        },
                        {
                            "text": "The queen began to <w>notice</w> the humble servant after his brave act.",
                            "target_lang_translations": {
                                "ru": "Королева начала <w>привечать</w> скромного слугу после его смелого поступка."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "primarily found in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относиться к кому-либо с добротой или оказывать особое внимание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удостоить вниманием",
                                "target_lang_sense_clarification": "проявить благосклонность"
                            },
                            {
                                "target_lang_word": "привечать",
                                "target_lang_sense_clarification": "принимать с добротой"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2731db61-555b-3246-a569-622dcb58d947",
                    "sense_definition": "A written or printed announcement displayed publicly to provide information.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "announcement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>notice</w> was attached to the building reminding residents about the water shortage.",
                            "target_lang_translations": {
                                "ru": "На здании было вывешено <w>объявление</w>, напоминающее жильцам о нехватке воды."
                            }
                        },
                        {
                            "text": "Please post a <w>notice</w> on the board regarding the new office policy.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, разместите <w>объявление</w> на доске относительно новой офисной политики."
                            }
                        }
                    ],
                    "common_phrases": [
                        "post a notice",
                        "public notice",
                        "death notice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Письменное или печатное объявление, выставленное публично для предоставления информации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объявление",
                                "target_lang_sense_clarification": "сообщение для всеобщего сведения"
                            },
                            {
                                "target_lang_word": "уведомление",
                                "target_lang_sense_clarification": "официальное извещение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dad80823-223b-332d-87af-cb51515f42b8",
                    "sense_definition": "The act of observing or paying attention to something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "attention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He took no <w>notice</w> of the changes and continued working as usual.",
                            "target_lang_translations": {
                                "ru": "Он не обратил никакого <w>внимания</w> на изменения и продолжил работать как обычно."
                            }
                        },
                        {
                            "text": "The small detail escaped my <w>notice</w> until you pointed it out.",
                            "target_lang_translations": {
                                "ru": "Эта маленькая деталь ускользнула от моего <w>внимания</w>, пока вы на неё не указали."
                            }
                        }
                    ],
                    "synonyms": [
                        "attention",
                        "heed",
                        "regard"
                    ],
                    "common_phrases": [
                        "take notice",
                        "escape notice",
                        "worthy of notice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по наблюдению или уделению внимания чему-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внимание",
                                "target_lang_sense_clarification": "сосредоточенность на объекте"
                            },
                            {
                                "target_lang_word": "наблюдение",
                                "target_lang_sense_clarification": "процесс слежения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa05893d-b4bf-38d1-96a4-ad486a956a32",
                    "sense_definition": "Information or warning given in advance of something happening.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "warning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I don't mind changing the venue, but please give me some <w>notice</w> first.",
                            "target_lang_translations": {
                                "ru": "Я не против сменить место встречи, но, пожалуйста, <w>предупредите</w> меня заранее."
                            }
                        },
                        {
                            "text": "The meeting was cancelled at short <w>notice</w> due to an emergency.",
                            "target_lang_translations": {
                                "ru": "Встреча была отменена без <w>предупреждения</w> из-за чрезвычайной ситуации."
                            }
                        }
                    ],
                    "common_phrases": [
                        "short notice",
                        "advance notice",
                        "prior notice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Информация или предупреждение, данные заранее до наступления события."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предупреждение",
                                "target_lang_sense_clarification": "извещение о будущем событии"
                            },
                            {
                                "target_lang_word": "уведомление",
                                "target_lang_sense_clarification": "предварительное сообщение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f10d6f65-9eff-31b5-80f5-4fc32c8a8bd5",
                    "sense_definition": "A formal statement that you are leaving your job, or that your employer is ending your contract.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "employment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I decided to hand in my <w>notice</w> after finding a better job opportunity.",
                            "target_lang_translations": {
                                "ru": "Я решил подать <w>заявление об увольнении</w>, найдя более подходящую работу."
                            }
                        },
                        {
                            "text": "The company gave her two weeks' <w>notice</w> before her contract ended.",
                            "target_lang_translations": {
                                "ru": "Компания <w>уведомила</w> её за две недели до окончания контракта."
                            }
                        }
                    ],
                    "common_phrases": [
                        "give notice",
                        "hand in notice",
                        "weeks notice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное заявление об увольнении по собственному желанию или расторжении контракта работодателем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заявление об увольнении",
                                "target_lang_sense_clarification": "сообщение об уходе с работы"
                            },
                            {
                                "target_lang_word": "уведомление",
                                "target_lang_sense_clarification": "официальный срок перед увольнением"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a3e0341-9ffc-3203-a60c-371213ea9fdd",
                    "sense_definition": "A formal legal or official warning.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "warning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sidewalk shall remain closed until further <w>notice</w> for safety reasons.",
                            "target_lang_translations": {
                                "ru": "Тротуар останется закрытым до дальнейшего <w>распоряжения</w> из соображений безопасности."
                            }
                        },
                        {
                            "text": "The landlord served a <w>notice</w> to the tenants regarding the unpaid rent.",
                            "target_lang_translations": {
                                "ru": "Арендодатель направил жильцам <w>уведомление</w> о неуплате аренды."
                            }
                        }
                    ],
                    "common_phrases": [
                        "until further notice",
                        "legal notice",
                        "official notice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Формальное юридическое или официальное предупреждение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "извещение",
                                "target_lang_sense_clarification": "официальный документ"
                            },
                            {
                                "target_lang_word": "уведомление",
                                "target_lang_sense_clarification": "юридическое предупреждение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6837082-c785-3b79-aa04-e5a56d296ded",
                    "sense_definition": "A published critical review of a creative work, such as a play or book.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "review",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>notices</w> for the new Broadway show have been mostly positive.",
                            "target_lang_translations": {
                                "ru": "<w>Рецензии</w> на новое бродвейское шоу были в основном положительными."
                            }
                        },
                        {
                            "text": "The film received rave <w>notices</w> from the critics after its premiere.",
                            "target_lang_translations": {
                                "ru": "Фильм получил восторженные <w>отзывы</w> критиков после премьеры."
                            }
                        }
                    ],
                    "common_phrases": [
                        "rave notices",
                        "press notices"
                    ],
                    "target_lang_definitions": {
                        "ru": "Опубликованный критический отзыв о творческой работе, такой как пьеса или книга."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рецензия",
                                "target_lang_sense_clarification": "критический разбор произведения"
                            },
                            {
                                "target_lang_word": "отзыв",
                                "target_lang_sense_clarification": "мнение критика в прессе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "82e02193-763c-36c5-8d11-3875524f2ed0",
                    "sense_definition": "Respectful treatment, civility, or polite attention.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "attention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was a man of such high standing that he received <w>notice</w> from the king.",
                            "target_lang_translations": {
                                "ru": "Он был человеком столь высокого положения, что удостоился <w>внимания</w> самого короля."
                            }
                        },
                        {
                            "text": "The young artist was grateful for any <w>notice</w> shown by the established masters.",
                            "target_lang_translations": {
                                "ru": "Молодой художник был благодарен за любое <w>внимание</w>, проявленное признанными мастерами."
                            }
                        }
                    ],
                    "synonyms": [
                        "regard"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rarely used in modern speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Уважительное отношение, вежливость или учтивое внимание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "внимание",
                                "target_lang_sense_clarification": "почтительное отношение"
                            },
                            {
                                "target_lang_word": "признание",
                                "target_lang_sense_clarification": "уважение заслуг"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}