{
    "word_family": [
        "lumpy",
        "lumpiness",
        "lumpish",
        "lumpily"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b0abbec6-0b97-3749-82ad-713c926af197",
                    "sense_definition": "A solid piece of something that does not have a regular shape.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_mass",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He picked up a <w>lump</w> of coal from the bucket.",
                            "target_lang_translations": {
                                "ru": "Он достал из ведра <w>кусок</w> угля.",
                                "zh": "他从桶里捡起一<w>块</w>煤。"
                            }
                        },
                        {
                            "text": "She felt a <w>lump</w> in her throat as she tried not to cry.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала <w>ком</w> в горле, пытаясь не заплакать.",
                                "zh": "她极力忍住不哭，感到喉咙里像堵了个<w>疙瘩</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chunk",
                        "hunk",
                        "clod",
                        "blob",
                        "mass",
                        "nugget"
                    ],
                    "common_phrases": [
                        "lump of coal",
                        "lump of clay",
                        "lump in one's throat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твердый кусок чего-либо, не имеющий правильной формы.",
                        "zh": "指形状不规则的固体块状物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кусок",
                                "target_lang_sense_clarification": "общий термин для части вещества"
                            },
                            {
                                "target_lang_word": "ком",
                                "target_lang_sense_clarification": "округлый или бесформенный кусок мягкого вещества"
                            },
                            {
                                "target_lang_word": "глыба",
                                "target_lang_sense_clarification": "большой, тяжелый бесформенный кусок"
                            },
                            {
                                "target_lang_word": "комок",
                                "target_lang_sense_clarification": "небольшой сгусток или ощущение в горле"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "块",
                                "target_lang_sense_clarification": "用于指代不规则的固体块状物"
                            },
                            {
                                "target_lang_word": "团",
                                "target_lang_sense_clarification": "用于指代柔软或粘稠的团状物"
                            },
                            {
                                "target_lang_word": "疙瘩",
                                "target_lang_sense_clarification": "指小而圆的块状物或喉咙里的异物感"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad5c1d2f-7696-3a82-a817-73b0a53e8aba",
                    "sense_definition": "A hard swelling found on or in the body.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "physical_mass",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor examined the small <w>lump</w> on her neck.",
                            "target_lang_translations": {
                                "ru": "Врач осмотрел небольшое <w>уплотнение</w> на её шее.",
                                "zh": "医生检查了她脖子上那个小<w>肿块</w>。"
                            }
                        },
                        {
                            "text": "He got a nasty <w>lump</w> on his head after bumping into the door.",
                            "target_lang_translations": {
                                "ru": "Он набил себе ужасную <w>шишку</w> на голове, ударившись о дверь.",
                                "zh": "他撞到门上，头上鼓起了一个大<w>包</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "swelling",
                        "bump",
                        "growth",
                        "protuberance",
                        "nodule"
                    ],
                    "common_phrases": [
                        "lump on the head"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твердая припухлость на теле или внутри него.",
                        "zh": "身体表面或内部出现的硬肿块。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шишка",
                                "target_lang_sense_clarification": "разговорное; припухлость от ушиба"
                            },
                            {
                                "target_lang_word": "уплотнение",
                                "target_lang_sense_clarification": "медицинский термин"
                            },
                            {
                                "target_lang_word": "бугор",
                                "target_lang_sense_clarification": "выпуклость на поверхности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "肿块",
                                "target_lang_sense_clarification": "医学上指身体出现的异常隆起"
                            },
                            {
                                "target_lang_word": "包",
                                "target_lang_sense_clarification": "指因碰撞等原因在皮肤上隆起的肿块"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e254a6b8-92c5-3ae5-8a43-67ff0c17639e",
                    "sense_definition": "A small cube or shaped piece of sugar used in drinks.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_mass",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do you take one <w>lump</w> or two in your tea?",
                            "target_lang_translations": {
                                "ru": "Вам положить в чай один <w>кусочек</w> или два?",
                                "zh": "你的茶里要放一<w>块</w>还是两块方糖？"
                            }
                        },
                        {
                            "text": "She dropped a <w>lump</w> of sugar into the cup and stirred it.",
                            "target_lang_translations": {
                                "ru": "Она бросила <w>кусочек</w> сахара в чашку и размешала его.",
                                "zh": "她往杯子里放了一<w>块</w>糖并搅匀了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cube"
                    ],
                    "common_phrases": [
                        "lump of sugar"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой кубик или кусочек сахара, используемый в напитках.",
                        "zh": "用于饮料中的小块状糖。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кусочек",
                                "target_lang_sense_clarification": "обычно о сахаре"
                            },
                            {
                                "target_lang_word": "кубик",
                                "target_lang_sense_clarification": "форма сахара"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "方糖",
                                "target_lang_sense_clarification": "指压制成小方块状的糖"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8ccef57-0bfb-3956-9d6a-7d33bb79c68c",
                    "sense_definition": "Punishment, criticism, or bad treatment, usually suffered as a consequence of one's actions.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He made a mistake and had to take his <w>lumps</w> from the boss.",
                            "target_lang_translations": {
                                "ru": "Он совершил ошибку, и ему пришлось получить <w>нагоняй</w> от начальника.",
                                "zh": "他犯了错，不得不<w>挨</w>了老板一顿训。"
                            }
                        },
                        {
                            "text": "The team took their <w>lumps</w> early in the season but improved later.",
                            "target_lang_translations": {
                                "ru": "Команда терпела <w>поражения</w> в начале сезона, но позже исправилась.",
                                "zh": "球队在赛季初<w>受</w>了不少挫折，但后来有所好转。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "take one's lumps"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наказание, критика или плохое обращение, обычно как последствие чьих-либо действий.",
                        "zh": "指因自己的行为而遭受的惩罚、批评或不公正待遇。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наказание",
                                "target_lang_sense_clarification": "расплата за ошибки"
                            },
                            {
                                "target_lang_word": "удары",
                                "target_lang_sense_clarification": "переносное значение; неприятности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "受罚",
                                "target_lang_sense_clarification": "指承担错误带来的后果"
                            },
                            {
                                "target_lang_word": "挨骂",
                                "target_lang_sense_clarification": "指遭受批评"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8ed4860a-ff9c-3065-89ab-7198039b1a16",
                    "sense_definition": "To put different people or things together in the same group, often without considering their differences.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You cannot simply <w>lump</w> all these different issues together.",
                            "target_lang_translations": {
                                "ru": "Нельзя просто <w>сваливать в одну кучу</w> все эти разные вопросы.",
                                "zh": "你不能简单地把这些不同的问题<w>混为一谈</w>。"
                            }
                        },
                        {
                            "text": "They tend to <w>lump</w> everyone into the same category regardless of skill.",
                            "target_lang_translations": {
                                "ru": "Они склонны <w>зачислять</w> всех в одну категорию, невзирая на навыки.",
                                "zh": "他们倾向于不顾技能水平，把所有人都<w>归</w>为同一类。"
                            }
                        }
                    ],
                    "synonyms": [
                        "group",
                        "bunch",
                        "combine",
                        "categorize"
                    ],
                    "antonyms": [
                        "separate",
                        "distinguish"
                    ],
                    "common_phrases": [
                        "lump together",
                        "lump in with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Объединять разных людей или вещи в одну группу, часто не учитывая их различий.",
                        "zh": "将不同的人或事物归为一类，通常不考虑它们之间的差异。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сваливать в одну кучу",
                                "target_lang_sense_clarification": "идиоматическое выражение"
                            },
                            {
                                "target_lang_word": "смешивать",
                                "target_lang_sense_clarification": "соединять без разбора"
                            },
                            {
                                "target_lang_word": "объединять",
                                "target_lang_sense_clarification": "группировать вместе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "混为一谈",
                                "target_lang_sense_clarification": "指将不同的事物不加区别地归在一起"
                            },
                            {
                                "target_lang_word": "归类",
                                "target_lang_sense_clarification": "指将事物放入同一类别"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa7fa00b-3b76-3541-ab9e-14595129394b",
                    "sense_definition": "To form solid pieces or become thick and uneven, usually describing a liquid or mixture.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sauce will <w>lump</w> if you do not stir it constantly.",
                            "target_lang_translations": {
                                "ru": "Соус будет <w>комковаться</w>, если его постоянно не помешивать.",
                                "zh": "如果不持续搅拌，酱汁就会<w>结块</w>。"
                            }
                        },
                        {
                            "text": "Mix the paint well so it does not <w>lump</w> on the brush.",
                            "target_lang_translations": {
                                "ru": "Хорошо перемешайте краску, чтобы она не <w>бралась комками</w> на кисти.",
                                "zh": "把油漆搅拌均匀，这样刷子就不会<w>结块</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "clot",
                        "coagulate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Образовывать твердые комки или становиться густым и неоднородным (обычно о жидкости или смеси).",
                        "zh": "指液体或混合物形成固体块状或变得浓稠不均匀。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "комковаться",
                                "target_lang_sense_clarification": "образовывать комки"
                            },
                            {
                                "target_lang_word": "сворачиваться",
                                "target_lang_sense_clarification": "о молоке, крови или краске"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "结块",
                                "target_lang_sense_clarification": "指粉末或液体凝结成块"
                            },
                            {
                                "target_lang_word": "起疙瘩",
                                "target_lang_sense_clarification": "指混合物变得不均匀"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6476bb2c-c19e-3880-addb-d04aa968b27b",
                    "sense_definition": "To carry something heavy or awkward from one place to another.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I had to <w>lump</w> that heavy suitcase all the way up the stairs.",
                            "target_lang_translations": {
                                "ru": "Мне пришлось <w>тащить</w> этот тяжелый чемодан вверх по лестнице.",
                                "zh": "我不得不把那个沉重的行李箱一路<w>扛</w>上楼。"
                            }
                        },
                        {
                            "text": "The workers <w>lumped</w> the sacks of coal into the cellar.",
                            "target_lang_translations": {
                                "ru": "Рабочие <w>перетаскивали</w> мешки с углем в подвал.",
                                "zh": "工人们把煤袋<w>搬</w>进了地窖。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lug",
                        "haul",
                        "drag"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Переносить что-то тяжелое или неудобное с одного места на другое.",
                        "zh": "搬运沉重或笨重的东西。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тащить",
                                "target_lang_sense_clarification": "нести с усилием"
                            },
                            {
                                "target_lang_word": "переть",
                                "target_lang_sense_clarification": "просторечное; нести тяжесть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "搬运",
                                "target_lang_sense_clarification": "指移动重物"
                            },
                            {
                                "target_lang_word": "扛",
                                "target_lang_sense_clarification": "指用肩或手搬运重物"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}