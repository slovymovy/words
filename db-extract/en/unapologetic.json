                                        "sense_id": "eb081db6-0b35-3098-9304-c58f3ec5e4e5",
                                        "entry_id": "22e4728c-a3ff-31d3-aa03-4e200d0f70ff",
                                        "glosses": [
                                            "Propicio para la proliferación de gérmenes."
                                        ],
                                        "tags": [],
                                        "examples": [
