                    "frequency": "Middle",
                    "semantic_group_id": "personnifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'auteur a choisi de <w>personnaliser</w> la justice sous les traits d'une femme impartiale."
                        },
                        {
                            "text": "Dans ce tableau célèbre, l'artiste tente de <w>personnaliser</w> l'angoisse par une silhouette menaçante."
