                    }
                ],
                "senses": [
                    {
                        "sense_id": "e5bc4ff5-8f09-37ec-bbbe-fc91b1d696c8",
                        "entry_id": "ddb19f05-d70a-33c3-bb2e-783ebc595cf9",
                        "glosses": [
                            "een bestuurder van een auto, chauffeur"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f4908ab-df13-4ab7-bb7c-dd7bae19132a",
                                "sense_id": "e5bc4ff5-8f09-37ec-bbbe-fc91b1d696c8",
                                "text": "Vanaf wanneer ben je nou officieel automobilist?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d1cc5a2a-79d3-4dbf-b6fb-68fcd49f5afb",
                        "source_entry_id": "ddb19f05-d70a-33c3-bb2e-783ebc595cf9",
                        "source_sense_id": "e5bc4ff5-8f09-37ec-bbbe-fc91b1d696c8",
                        "source_sense_description": "een bestuurder van een auto",
                        "target_lang_word": "Autofahrer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Autofahrer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cf7ee4d0-3887-3c8a-afae-8e49938bba27",
                                        "entry_id": "aabcf415-26b0-360b-9ae8-fee807b6fc75",
                                        "glosses": [
                                            "jemand, der ein Auto lenkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c1d0f2f-0bc5-4a4e-9548-466579c9f1b3",
                                                "sense_id": "cf7ee4d0-3887-3c8a-afae-8e49938bba27",
                                                "text": "„Der erfahrene Pilot besteigt sein Segelflugzeug mit nicht mehr Angst als der Autofahrer sein Auto.“"
                                            },
                                            {
                                                "example_id": "219a8e37-7687-4a57-a26a-a39769019189",
                                                "sense_id": "cf7ee4d0-3887-3c8a-afae-8e49938bba27",
                                                "text": "Viele Autofahrer halten nicht an Stoppschildern."
                                            },
                                            {
                                                "example_id": "bb0dca66-fc88-4e90-b9a9-bd5386359694",
                                                "sense_id": "cf7ee4d0-3887-3c8a-afae-8e49938bba27",
                                                "text": "„Durch Reform der Verkehrssünderkartei verlieren 141 000 Autofahrer ihre Punkte.“"
                                            },
                                            {
                                                "example_id": "c1b75635-b90a-4707-ac71-3e09be2f281d",
                                                "sense_id": "cf7ee4d0-3887-3c8a-afae-8e49938bba27",
                                                "text": "„Michael zeigte mir, wie man Autofahrern einen Streich spielen konnte.“"
                                            },
                                            {
                                                "example_id": "9989ee02-83ec-4a81-bada-051ff6b269f3",
                                                "sense_id": "cf7ee4d0-3887-3c8a-afae-8e49938bba27",
                                                "text": "„Sollte die spanische Costa del Sol irgendeinen Nutzen haben, dann für Autofahrer, denn die Infrastruktur an der Sonnenküste ist denkbar gut ausgebaut.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bfce59b7-3a3d-4d34-bc6b-e6b6687d8978",
                        "source_entry_id": "ddb19f05-d70a-33c3-bb2e-783ebc595cf9",
                        "source_sense_id": "e5bc4ff5-8f09-37ec-bbbe-fc91b1d696c8",
                        "source_sense_description": "een bestuurder van een auto",
                        "target_lang_word": "motorist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "motorist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4466876-3cc9-3a3a-af6b-df48569c54f9",
                                        "entry_id": "84613f6b-a468-394d-99c7-131348d3fbd4",
                                        "glosses": [
                                            "One who drives a motor vehicle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9dbaeb5-e30f-45e1-aa05-153dda30c529",
                                                "sense_id": "b4466876-3cc9-3a3a-af6b-df48569c54f9",
                                                "text": "Moreover, the motorist, even if the speed at which he travelled enabled him to appreciate what he saw, does not see the country at all. What he does see is a tarred road, a couple of blackened or dust-covered hedges, and a stream of other motorists."
                                            },
                                            {
                                                "example_id": "0f2e2e6c-f936-4ad8-9ed2-fb77f7446d23",
                                                "sense_id": "b4466876-3cc9-3a3a-af6b-df48569c54f9",
                                                "text": "In a poll released last week, the AAA Foundation for Traffic Safety found that 58 percent of drivers consider other motorists talking on a cellphone to be a very serious threat and that 87 percent consider motorists e-mailing or texting to be such a threat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "274842a2-9030-48ad-a42f-4574e0c5482f",
                        "source_entry_id": "ddb19f05-d70a-33c3-bb2e-783ebc595cf9",
                        "source_sense_id": "e5bc4ff5-8f09-37ec-bbbe-fc91b1d696c8",
                        "source_sense_description": "een bestuurder van een auto",
                        "target_lang_word": "automobiliste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "automobiliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b132f703-0cc0-3b3c-9012-f58b8cee71f3",
                                        "entry_id": "5c20b8fd-62cd-35b9-8029-d58a84af03bf",
                                        "glosses": [
                                            "Celui, celle qui conduit une automobile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfab6897-ed92-4250-8aa5-91314b9cce49",
                                                "sense_id": "b132f703-0cc0-3b3c-9012-f58b8cee71f3",
                                                "text": "De là est née l’idée de recourir à l’auto-stop, mais cela d'une manière organisée donnant un maximum de satisfaction et de garantie aussi bien à l’automobiliste qu'à l’auto-stoppeur. Ainsi fut créée par l'initiative privée dans le courant du mois de mai 1978, une association sans but lucratif, dénommée \"Taxistop\"."
                                            },
                                            {
                                                "example_id": "5a7dab58-9e4f-4a50-9e3e-fcb47ab90ee2",
                                                "sense_id": "b132f703-0cc0-3b3c-9012-f58b8cee71f3",
                                                "text": "En fait lorsque la R5 Turbo aborde l'entrée du tunnel, elle ne ralentit que très légèrement et la traversée de Lyon s'effectue sans problème. A la sortie des autostoppeurs font des signes désespérés aux automobilistes indifférents."
                                            },
                                            {
                                                "example_id": "ae9407fb-98b5-4dc0-9df9-4c32fc84cb83",
                                                "sense_id": "b132f703-0cc0-3b3c-9012-f58b8cee71f3",
                                                "text": "Je me suis rendu compte, au fil de ma carrière, de l’évolution effarante de la situation ; d’occasionnelle, la contravention est devenue quotidienne : chaque fois qu’il s'installe à son volant, l’automobiliste risque de se retrouver en tort malgré lui."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5479438-9c02-454b-9f1e-c5dcad96d85c",
                        "source_entry_id": "ddb19f05-d70a-33c3-bb2e-783ebc595cf9",
                        "source_sense_id": "e5bc4ff5-8f09-37ec-bbbe-fc91b1d696c8",
                        "source_sense_description": "een bestuurder van een auto",
                        "target_lang_word": "kierowca",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kierowca",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "8f996079-8b46-3e3d-a271-437427be6039",
                                        "entry_id": "a49b6c90-b703-3a13-a42c-04d36e9480c4",
                                        "glosses": [
                                            "osoba kierująca pojazdem (mężczyzna lub kobieta)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc407a14-50b9-4815-a530-1ecb88b1c8e3",
                                                "sense_id": "8f996079-8b46-3e3d-a271-437427be6039",
                                                "text": "Nietrzeźwy kierowca powiedział policjantowi, że piwo to nie alkohol."
                                            },
                                            {
                                                "example_id": "f1cd2347-4e89-4c9a-8b84-6c02ac7d76a6",
                                                "sense_id": "8f996079-8b46-3e3d-a271-437427be6039",
                                                "text": "To brawura kierowcy zabiła tyle osób."
                                            },
                                            {
                                                "example_id": "c4d3ffb8-41bc-4bbb-853f-b8c9b2db841c",
                                                "sense_id": "8f996079-8b46-3e3d-a271-437427be6039",
                                                "text": "Kto jest kierowcą tamtego samochodu?"
                                            },
                                            {
                                                "example_id": "53a52d03-6b6f-442f-9021-03ff21f34b81",
                                                "sense_id": "8f996079-8b46-3e3d-a271-437427be6039",
                                                "text": "Kierowco, uważaj na drodze!"
                                            },
                                            {
                                                "example_id": "bc795c54-2152-447d-a826-422344221883",
                                                "sense_id": "8f996079-8b46-3e3d-a271-437427be6039",
                                                "text": "Kierowcy denerwowali się stojąc w korku."
                                            },
                                            {
                                                "example_id": "0c4e1b9f-4e74-4860-9d22-05271a9dfb51",
                                                "sense_id": "8f996079-8b46-3e3d-a271-437427be6039",
                                                "text": "Święty Krzysztof jest patronem kierowców, przewoźników i podróżników."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c188718d-5283-472f-9a73-dcc55d2b24be",
                        "source_entry_id": "ddb19f05-d70a-33c3-bb2e-783ebc595cf9",
                        "source_sense_id": "e5bc4ff5-8f09-37ec-bbbe-fc91b1d696c8",
