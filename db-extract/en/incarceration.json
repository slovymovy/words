                                "target_senses": [
                                    {
                                        "sense_id": "5373dbf4-a5a3-37fa-aa60-e2c5ffc3de57",
                                        "entry_id": "d7111942-0cfc-3436-917f-2dbbcedf6c68",
                                        "glosses": [
                                            "Action d’incarcérer ou état de celui qui est incarcéré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fa006ef-6aa8-436d-8958-7e884919ff2e",
                                                "sense_id": "5373dbf4-a5a3-37fa-aa60-e2c5ffc3de57",
                                                "text": "Ordonner l’incarcération d’une personne. — Son incarcération dura dix jours."
                                            },
                                            {
                                                "example_id": "709b42ef-7b46-4650-994d-99db9565d3fd",
                                                "sense_id": "5373dbf4-a5a3-37fa-aa60-e2c5ffc3de57",
                                                "text": "Aujourd'hui, chacun calé dans sa bulle électromagnétique de Wi-Fi, c'est une autre vie qui commence. Une incarcération chez soi, dans laquelle il sera possible d'avoir accès à tout sans jamais voir personne - pas même son facteur."
                                            },
                                            {
                                                "example_id": "712ca40b-8b63-4ad7-a957-63d9dc91a036",
                                                "sense_id": "5373dbf4-a5a3-37fa-aa60-e2c5ffc3de57",
                                                "text": "Même les plus timides réformateurs se heurtent à cette évidence, adoucir les cruautés de l’incarcération s’oppose forcément à son principe : elle est une peine, elle est faite et uniquement faite pour punir le coupable, pour lui être pénible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d344b6c-125d-3bae-9bcc-bb54c6be493a",
                                        "entry_id": "d7111942-0cfc-3436-917f-2dbbcedf6c68",
                                        "glosses": [
                                            "Privation de liberté."
                                        ],
                                        "tags": [
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "615bd59b-c08c-49ff-8f04-9df324226e1b",
                                                "sense_id": "2d344b6c-125d-3bae-9bcc-bb54c6be493a",
                                                "text": "Sa liberté, son quant à soi, le plus grand bien, après l’incarcération de six années d'internat scolaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
