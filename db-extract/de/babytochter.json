                            {
                                "example_id": "950200b1-64de-4243-932d-713e6d9f9dcd",
                                "sense_id": "84941562-cf3a-3a4e-8d1c-ea350d0701ec",
                                "text": "„Baerbock soll über Fotos sprechen, die riesig hinter die Frauen an die Wand projiziert werden. Eines zeigt sie zusammen mit dem Grünenpolitiker Chris Kühn im Bundestag, er beugt sich über einen Kinderwagen, sie hat ihre Babytochter auf dem Arm.“"
                            },
                            {
                                "example_id": "b3a738c6-01b0-4c1d-9a04-c0b70d98c403",
                                "sense_id": "84941562-cf3a-3a4e-8d1c-ea350d0701ec",
                                "text": "„Auf der Premierenausgabe des deutschen ‚People‘-Ablegers busselt also Christina Aguilera, ‚Weltstar‘, ihrer Babytochter den apricotfarbenen Lippenstift auf die Wange.“"
                            }
                        ],
