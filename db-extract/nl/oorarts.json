                        "translation_id": "07d573f8-dd9d-433d-af9d-a20fd04afdf5",
                        "source_entry_id": "11e0387f-edb4-38d2-8fa0-ecd4cf850350",
                        "source_sense_id": "ce324f04-6bf9-3159-a481-49bf6dd314ef",
                        "source_sense_description": "medisch specialist op het gebied van oorziekten",
