{
    "word_family": [
        "relieve",
        "relievable",
        "reliever"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "63a4af54-602a-342e-8184-60a0ccfd1b51",
                    "sense_definition": "The feeling of happiness or relaxation that comes when something unpleasant stops or does not happen.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She let out a long sigh of <w>relief</w> when she heard that her family was safe.",
                            "target_lang_translations": {
                                "ru": "Она издала долгий вздох <w>облегчения</w>, когда услышала, что её семья в безопасности."
                            }
                        },
                        {
                            "text": "It was a huge <w>relief</w> to find my lost keys in the kitchen drawer.",
                            "target_lang_translations": {
                                "ru": "Найти потерянные ключи в кухонном ящике было огромным <w>облегчением</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "comfort",
                        "ease",
                        "solace"
                    ],
                    "antonyms": [
                        "anxiety",
                        "stress",
                        "worry"
                    ],
                    "common_phrases": [
                        "sigh of relief",
                        "huge relief",
                        "visible relief"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство счастья или расслабления, которое возникает, когда что-то неприятное прекращается или не происходит."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "облегчение",
                                "target_lang_sense_clarification": "чувство успокоения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5632ef29-a5f7-3cc8-bc47-c4b6c2994083",
                    "sense_definition": "Food, money, or medical supplies given to help people in a disaster or a difficult situation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "assistance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The international community sent emergency <w>relief</w> to the victims of the earthquake.",
                            "target_lang_translations": {
                                "ru": "Международное сообщество направило экстренную <w>помощь</w> пострадавшим от землетрясения."
                            }
                        },
                        {
                            "text": "The organization provides disaster <w>relief</w> to communities affected by the floods.",
                            "target_lang_translations": {
                                "ru": "Организация оказывает <w>помощь</w> при стихийных бедствиях общинам, пострадавшим от наводнений."
                            }
                        }
                    ],
                    "synonyms": [
                        "alleviation",
                        "respite"
                    ],
                    "common_phrases": [
                        "disaster relief",
                        "relief effort",
                        "emergency relief"
                    ],
                    "target_lang_definitions": {
                        "ru": "Продукты питания, деньги или медикаменты, предоставляемые для помощи людям в условиях катастрофы или трудной ситуации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "помощь",
                                "target_lang_sense_clarification": "гуманитарная или чрезвычайная"
                            },
                            {
                                "target_lang_word": "гуманитарная помощь",
                                "target_lang_sense_clarification": "материальная поддержка пострадавшим"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce51940e-e8e6-340b-b3b9-d36c4d9ac31c",
                    "sense_definition": "A person or group of people who take over a shift or duty from someone else.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "replacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The night nurse waited for her <w>relief</w> to arrive before she could go home.",
                            "target_lang_translations": {
                                "ru": "Ночная медсестра ждала прихода своей <w>смены</w>, прежде чем смогла уйти домой."
                            }
                        },
                        {
                            "text": "A <w>relief</w> crew took over the ship's operations at midnight.",
                            "target_lang_translations": {
                                "ru": "<w>Сменный</w> экипаж принял управление кораблем в полночь."
                            }
                        }
                    ],
                    "synonyms": [
                        "backup",
                        "fill-in",
                        "stand-in",
                        "substitute"
                    ],
                    "common_phrases": [
                        "relief crew",
                        "relief worker",
                        "wait for relief"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или группа людей, которые принимают смену или обязанности у кого-то другого."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смена",
                                "target_lang_sense_clarification": "заменяющий персонал"
                            },
                            {
                                "target_lang_word": "подмена",
                                "target_lang_sense_clarification": "человек, выходящий на замену"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7e7dd87-0948-3e12-8ed2-1a537f5a0a58",
                    "sense_definition": "A reduction in the amount of tax that a person or company has to pay.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government introduced new tax <w>relief</w> for small business owners this year.",
                            "target_lang_translations": {
                                "ru": "В этом году правительство ввело новые налоговые <w>льготы</w> для владельцев малого бизнеса."
                            }
                        },
                        {
                            "text": "Low-income families may be eligible for additional financial <w>relief</w>.",
                            "target_lang_translations": {
                                "ru": "Малообеспеченные семьи могут иметь право на дополнительную финансовую <w>помощь</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tax relief",
                        "debt relief",
                        "financial relief"
                    ],
                    "target_lang_definitions": {
                        "ru": "Снижение суммы налога, которую должен заплатить человек или компания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "льгота",
                                "target_lang_sense_clarification": "налоговое послабление"
                            },
                            {
                                "target_lang_word": "освобождение",
                                "target_lang_sense_clarification": "от уплаты части налогов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f54833c4-a965-3c6e-9f0b-c619ab4022aa",
                    "sense_definition": "A type of sculpture where the figures or designs stand out from a flat background.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient temple walls were decorated with beautiful stone <w>reliefs</w>.",
                            "target_lang_translations": {
                                "ru": "Стены древнего храма были украшены красивыми каменными <w>рельефами</w>."
                            }
                        },
                        {
                            "text": "The artist used a high <w>relief</w> technique to make the figures look more realistic.",
                            "target_lang_translations": {
                                "ru": "Художник использовал технику высокого <w>рельефа</w>, чтобы фигуры выглядели более реалистично."
                            }
                        }
                    ],
                    "synonyms": [
                        "embossing"
                    ],
                    "common_phrases": [
                        "high relief",
                        "bas relief",
                        "stone relief"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вид скульптуры, в котором фигуры или изображения выступают над плоским фоном."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рельеф",
                                "target_lang_sense_clarification": "скульптурное изображение на плоскости"
                            },
                            {
                                "target_lang_word": "барельеф",
                                "target_lang_sense_clarification": "низкий рельеф"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ee9a720b-a398-3486-9e9f-0c09e9f436c0",
                    "sense_definition": "The physical shape of the land, including its different heights and elevations.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The map shows the <w>relief</w> of the mountain range in great detail.",
                            "target_lang_translations": {
                                "ru": "На карте очень подробно показан <w>рельеф</w> горного хребта."
                            }
                        },
                        {
                            "text": "The snowy peaks stood out in sharp <w>relief</w> against the dark blue sky.",
                            "target_lang_translations": {
                                "ru": "Снежные вершины резко <w>выделялись</w> на фоне темно-синего неба."
                            }
                        }
                    ],
                    "synonyms": [
                        "texture",
                        "topography"
                    ],
                    "common_phrases": [
                        "sharp relief",
                        "mountain relief",
                        "topographic relief"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическая форма земной поверхности, включая её высоты и неровности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рельеф",
                                "target_lang_sense_clarification": "совокупность неровностей поверхности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "de1d5833-a0e5-33d2-aadc-d1853174d999",
                    "sense_definition": "Legal compensation or protection granted by a court of law.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plaintiff is seeking injunctive <w>relief</w> to stop the construction project.",
                            "target_lang_translations": {
                                "ru": "Истец добивается судебного <w>запрета</w>, чтобы остановить строительный проект."
                            }
                        },
                        {
                            "text": "The judge granted legal <w>relief</w> to the victims of the fraud.",
                            "target_lang_translations": {
                                "ru": "Судья предоставил правовую <w>защиту</w> жертвам мошенничества."
                            }
                        }
                    ],
                    "common_phrases": [
                        "injunctive relief",
                        "legal relief",
                        "seek relief"
                    ],
                    "target_lang_definitions": {
                        "ru": "Юридическая компенсация или защита, предоставляемая судом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "средство правовой защиты",
                                "target_lang_sense_clarification": "судебная помощь"
                            },
                            {
                                "target_lang_word": "удовлетворение требований",
                                "target_lang_sense_clarification": "в судебном порядке"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "7bebadc5-1b5e-332f-a968-6ba9259c95a2",
                    "sense_definition": "Describing a surface that is not flat but has raised parts or inequalities.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_property",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>relief</w> map allowed the students to feel the mountain ranges with their fingers.",
                            "target_lang_translations": {
                                "ru": "<w>Рельефная</w> карта позволила студентам потрогать горные хребты пальцами."
                            }
                        },
                        {
                            "text": "The architect chose a <w>relief</w> texture for the exterior walls of the building.",
                            "target_lang_translations": {
                                "ru": "Архитектор выбрал <w>рельефную</w> текстуру для внешних стен здания."
                            }
                        }
                    ],
                    "common_phrases": [
                        "relief map",
                        "relief surface"
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывает поверхность, которая не является плоской, а имеет приподнятые части или неровности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рельефный",
                                "target_lang_sense_clarification": "выпуклый, имеющий неровности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}