    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "45bcc21d-cbeb-385a-bbd0-fe36f8e8457c",
                "word": "ethnographic",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "11127437-b67f-3d57-952a-55a69fa14792",
                        "entry_id": "45bcc21d-cbeb-385a-bbd0-fe36f8e8457c",
                        "glosses": [
                            "Relating to ethnography."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "beb720fa-25d9-427a-aab9-b205c4fca6f2",
                                "sense_id": "11127437-b67f-3d57-952a-55a69fa14792",
                                "text": "Among anthropologists old ethnographic descriptions and travelbooks have a bad reputation. With the exception of ethnohistorians, anthropologists make little use of these sources for ethnographic research because of their reputed lack of reliability."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "232b25cd-9c99-46f6-95f5-b51f4bc276dc",
                        "source_entry_id": "45bcc21d-cbeb-385a-bbd0-fe36f8e8457c",
                        "source_sense_id": "11127437-b67f-3d57-952a-55a69fa14792",
                        "source_sense_description": "of, or relating to ethnography",
                        "target_lang_word": "etnografisch",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "etnografisch",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "75d9c4a4-3baf-3600-a13c-00f9e34eb162",
                                        "entry_id": "e305fda7-d4e8-3266-b5d6-e38bf615d90f",
                                        "glosses": [
                                            "betrekking hebbend op de beschrijving van volkeren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09bc1d87-b8c6-41e3-b1ab-2fdee007bdbb",
                                                "sense_id": "75d9c4a4-3baf-3600-a13c-00f9e34eb162",
                                                "text": "Het leven der niet-Russische bevolkingsgroepen was in politiek, administratief, economisch, etnografisch, materieel en godsdienstig opzicht onderzocht."
                                            },
                                            {
                                                "example_id": "9a18ea6a-224a-4cc2-9f6c-59f844a9a132",
                                                "sense_id": "75d9c4a4-3baf-3600-a13c-00f9e34eb162",
                                                "text": "Sorrymuseum: museum in een voormalige koloniale mogendheid, met een etnografische collectie die geheel of gedeeltelijk afkomstig is uit een voormalige kolonie, voor de totstandkoming waarvan de huidige leiding zich verontschuldigt tegenover de nazaten van de bewoners van die kolonie"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8aa3d27e-ad6d-4ec7-a1f8-a09c244a7acf",
                        "source_entry_id": "45bcc21d-cbeb-385a-bbd0-fe36f8e8457c",
                        "source_sense_id": "11127437-b67f-3d57-952a-55a69fa14792",
                        "source_sense_description": "of, or relating to ethnography",
                        "target_lang_word": "ethnographique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ethnographique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "64326265-d4a2-325f-a1cb-273957c935d7",
                                        "entry_id": "402eb500-9a8e-33bc-a845-13e9d3994d3f",
                                        "glosses": [
                                            "Relatif à l’ethnographie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a21bd472-2aca-4264-9b6f-ed57284cf603",
                                                "sense_id": "64326265-d4a2-325f-a1cb-273957c935d7",
                                                "text": "De nos jours, on commet une erreur plus grave : on confond la race avec la nation, et l’on attribue à des groupes ethnographiques ou plutôt linguistiques une souveraineté analogue à celle des peuples réellement existants."
                                            },
                                            {
                                                "example_id": "4c0409bb-cdd5-46f0-a854-03c10eb8a705",
                                                "sense_id": "64326265-d4a2-325f-a1cb-273957c935d7",
                                                "text": "Par « Malayo-Polynésiens », je désigne l'ensemble des peuples indonésiens, mélanésiens et polynésiens, qui, du point de vue ethnographique et surtout anthropologique, ont chacun leur individualité; mais qui parlent des langues nettement apparentées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f640a8a3-ac14-46b4-af99-881178e522a3",
                        "source_entry_id": "45bcc21d-cbeb-385a-bbd0-fe36f8e8457c",
                        "source_sense_id": "11127437-b67f-3d57-952a-55a69fa14792",
                        "source_sense_description": "of, or relating to ethnography",
                        "target_lang_word": "ethnographisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
