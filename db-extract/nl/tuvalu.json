                "senses": [
                    {
                        "sense_id": "34c68c99-e1db-31d0-8c01-cae581fbc33f",
                        "entry_id": "95ce865d-2f69-3083-9ea9-ae8e86a48c10",
                        "glosses": [
                            "een land in Oceanië"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d44dc827-111c-4a94-ad4e-050f0545bf0f",
                                "sense_id": "34c68c99-e1db-31d0-8c01-cae581fbc33f",
                                "text": "Tuvalu is niet zo'n bekend land."
                            },
                            {
                                "example_id": "3b01378d-6f7a-4262-bc78-0fe19e40050d",
                                "sense_id": "34c68c99-e1db-31d0-8c01-cae581fbc33f",
                                "text": "Donkere wolken pakken zich samen boven het eilandstaatje Tuvalu, als je het nieuws geloven mag. In 2050 is Tuvalu misschien volledig door de oceaan opgeslokt."
                            }
                        ]
                    }
                ],
