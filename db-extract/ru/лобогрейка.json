                        "tags": [],
                        "examples": [
                            {
                                "example_id": "918526d6-2dbb-4bd2-b568-8d5d617df7f5",
                                "sense_id": "3ae4e82a-3281-3ec6-9bd6-b3134b8ce8cd",
                                "text": "В неё впрягали пару лошадей, и лобогрейка, мерно помахивая крыльями, словно огромная птица, с мягким стрекотанием двигалась по полю, низко, под корень, подрезала стебли ржи и собирала их в аккуратные снопы."
                            }
                        ]
                    }
