                                        "sense_id": "bf6eda7e-e8bc-3112-919a-a8f59549183c",
                                        "entry_id": "e14e3299-5250-38ef-b699-fde79518af5d",
                                        "glosses": [
                                            "Teoría filosófica que considera a la vida como un hecho que no depende para ser más que de sí mismo, soslayando las leyes físicas y químicas, y que no puede ser explicado por la ciencia."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6d73e78-cbb7-4f7b-9087-2fbb8fcef3c9",
                        "source_entry_id": "21abc4e6-2ac5-3f4c-bb0b-c804edd60af7",
                        "source_sense_id": "056fd328-a561-3878-bd39-03e69f73f383",
