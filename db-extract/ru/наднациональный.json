                ],
                "senses": [
                    {
                        "sense_id": "aba1050c-4c04-30b2-924d-8883adcec18e",
                        "entry_id": "7f524cb5-4910-3eb9-9a63-5922d42dbced",
                        "glosses": [
                            "не зависящий от конкретного государства, охватывающий все страны"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85a7963f-11a1-4461-88c7-34a18394b96c",
                                "sense_id": "aba1050c-4c04-30b2-924d-8883adcec18e",
                                "text": "Наднациональный характер мировых религий."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0599c274-bf39-4be7-8c34-0461f2a02254",
                        "source_entry_id": "7f524cb5-4910-3eb9-9a63-5922d42dbced",
                        "source_sense_id": "aba1050c-4c04-30b2-924d-8883adcec18e",
                        "target_lang_word": "supranational",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "supranational",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5f67f421-2b1e-34dc-b1fc-d4c953d279b4",
                                        "entry_id": "052b4932-6a54-3213-9482-d433bd43001f",
                                        "glosses": [
                                            "Beyond the borders or scope of any one nation."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b70fc128-4cc3-408f-bd6c-e9b58d168946",
                                                "sense_id": "5f67f421-2b1e-34dc-b1fc-d4c953d279b4",
                                                "text": "Global warming is a supranational problem."
                                            },
                                            {
                                                "example_id": "583c3101-ca65-4bf8-a9f9-04b40c4d5fbb",
                                                "sense_id": "5f67f421-2b1e-34dc-b1fc-d4c953d279b4",
                                                "text": "The Systems Alliance is an independent supranational government representing the interests of humanity as a whole. The Alliance is responsible for the governance and defense of all extra-solar colonies and stations. […]"
                                            },
                                            {
                                                "example_id": "a4bca7c6-45db-4d73-abd9-fef7dad04690",
                                                "sense_id": "5f67f421-2b1e-34dc-b1fc-d4c953d279b4",
                                                "text": "If its Middle-earth series becomes must-see TV around the world, it would mean millions of new devoted subscribers in the Amazon Prime fellowship, collectively paying billions of dollars, lured by a fleet of dwarves, elves, and hobbits that would, one might say, rule their shopping behaviors and bind them to one supranational force."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "supranational",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7bb1788a-bd57-35fd-8869-dace1f01aa03",
                                        "entry_id": "ac297b11-d4cb-3868-a744-0fbbe0141dcc",
                                        "glosses": [
                                            "Such a person or organization."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c38a419-8937-4347-84cd-25b31eab5b44",
                                                "sense_id": "7bb1788a-bd57-35fd-8869-dace1f01aa03",
                                                "text": "This segment of issuers is known as the supranationals, or supras. Together with regional and agency borrowers, the bonds issued by supranationals form a bond market segment known as SSA (supras, sub-sovereigns and agencies)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e619da3-a938-402b-8a1c-0611925504c2",
                        "source_entry_id": "7f524cb5-4910-3eb9-9a63-5922d42dbced",
                        "source_sense_id": "aba1050c-4c04-30b2-924d-8883adcec18e",
                        "target_lang_word": "supranacional",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "supranacional",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "62fd8c7c-0f34-3199-867f-9c923744bae3",
                                        "entry_id": "3e97d318-2ba5-3445-b04f-a9c1e8b7dc2e",
                                        "glosses": [
                                            "Que tiene un nivel jerárquico por encima de los estados nacionales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17a91b62-5e1c-4d2a-852b-cfd4e3e4c572",
                                                "sense_id": "62fd8c7c-0f34-3199-867f-9c923744bae3",
                                                "text": "Y por último, teníamos al soberanista o patriota, que está muy preocupado de que la soberanía se mantenga en el Estado, el Estado nacional. Frente a lo cual se oponen aquellos que están inflando constantemente el poder de los organismos supraestatales o supranacionales."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cae2330a-7af5-4dbe-806e-cebc9ce29f17",
                        "source_entry_id": "7f524cb5-4910-3eb9-9a63-5922d42dbced",
                        "source_sense_id": "aba1050c-4c04-30b2-924d-8883adcec18e",
                        "target_lang_word": "supernazionale",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "350466d9-dbc3-4f76-b3dd-5e27def9a531",
                        "source_entry_id": "7f524cb5-4910-3eb9-9a63-5922d42dbced",
                        "source_sense_id": "aba1050c-4c04-30b2-924d-8883adcec18e",
                        "target_lang_word": "supranational",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "supranational",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1488c666-5eee-3072-9982-92a35af49311",
                                        "entry_id": "a65adff6-f3ea-3b79-9e79-be52293ec5f7",
                                        "glosses": [
                                            "mit mehreren mitwirkenden Staaten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb98ddab-78be-4c38-8b33-f2437e35a2bc",
                                                "sense_id": "1488c666-5eee-3072-9982-92a35af49311",
                                                "text": "Die supranational organisierte Europäische Union hat derzeit 27 Mitgliedsstaaten."
                                            },
                                            {
                                                "example_id": "b47c0d32-c9ff-4672-9eec-eeae545785ef",
                                                "sense_id": "1488c666-5eee-3072-9982-92a35af49311",
                                                "text": "„Tatsächlich herrscht in den supranationalen Organisationen noch immer viel regionaler und nationaler Egoismus vor.“"
                                            },
                                            {
                                                "example_id": "b2251f59-40fa-450c-b190-714e94ce686e",
                                                "sense_id": "1488c666-5eee-3072-9982-92a35af49311",
                                                "text": "„Deutschland setzt seinen Einfluss in den maßgeblichen internationalen und supranationalen Organisationen […] ein, um Kohärenz und Handlungsfähigkeit der Staatengemeinschaft zu verbessern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b75b1b04-358e-4bdb-b8b3-5fe76742f67d",
                        "source_entry_id": "7f524cb5-4910-3eb9-9a63-5922d42dbced",
                        "source_sense_id": "aba1050c-4c04-30b2-924d-8883adcec18e",
