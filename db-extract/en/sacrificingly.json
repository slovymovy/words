                "senses": [
                    {
                        "sense_id": "280c1912-eb7f-302e-bb90-e922c07aa23d",
                        "entry_id": "ec5b4222-e12f-33b3-b6fc-de45f2e0832f",
                        "glosses": [
                            "In a sacrificing manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a6364e5-f976-4a54-b069-a5bfce3073d6",
                                "sense_id": "280c1912-eb7f-302e-bb90-e922c07aa23d",
                                "text": "During the tedious lawsuit of 1895 and 1896, which threatened to involve the means her husband had left for the maintenance of the university, she sacrificingly used her personal means to help over until the suit was gained."
                            },
                            {
                                "example_id": "1c5ba6e0-dd50-4b7d-a83e-bf63371b289f",
                                "sense_id": "280c1912-eb7f-302e-bb90-e922c07aa23d",
                                "text": "Hon. Lloyd C[arpenter] Griscom said, on being introduced, it was not his intention to make a formal speech, but to give expression to his appreciation of [Women’s Union] Mission work, and especially woman’s work, for the home life of the people for whom they so sacrificingly laboured."
                            },
                            {
                                "example_id": "4b2ed8c4-fb23-47ea-9b12-4291c2b3e3df",
                                "sense_id": "280c1912-eb7f-302e-bb90-e922c07aa23d",
                                "text": "[George] O’Brien, a rich man’s son, losing all, comes west, locates on a ranch where the owner, his daughter (Dorothy Wilson) and the foreman (Paul Kelly) are being crowded out by Harry Woods’ villainy. O’Brien tames a horse, his objective, saves the ranch and gets the girl while Kelly, sacrificingly, rides off."
                            },
                            {
                                "example_id": "e08d86fa-0731-43d5-b02d-351019978453",
                                "sense_id": "280c1912-eb7f-302e-bb90-e922c07aa23d",
                                "text": "Major Church authorities have no recognizable bodies to deal with, no fixed ministries. This limits the long-term impact of these lay ministers internal to the Church they sacrificingly serve."
                            },
                            {
                                "example_id": "185b1069-ca52-4fc7-b553-962a551c2457",
                                "sense_id": "280c1912-eb7f-302e-bb90-e922c07aa23d",
                                "text": "That war could be launched into because men and women light-mindedly – often unselfishly, I give you, sacrificingly – believed that war was permissible, controllable, sometimes right; […]"
                            },
                            {
                                "example_id": "13bc4ad8-1eae-4ce2-a05b-b906d1534d24",
                                "sense_id": "280c1912-eb7f-302e-bb90-e922c07aa23d",
                                "text": "I sacrificingly give the caller five minutes to babble, cursing and resenting every second."
                            },
                            {
                                "example_id": "2b215755-860d-4520-83be-29a8c55e2a34",
                                "sense_id": "280c1912-eb7f-302e-bb90-e922c07aa23d",
                                "text": "[W]ould I like it if I left the dishes in the sink just once, and went into the next room to play my guitar, and Tom sighed all passive-aggressively and banged around the dishes as he sacrificingly cleaned them?"
                            }
                        ]
                    }
