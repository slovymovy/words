                "senses": [
                    {
                        "sense_id": "ac11d70b-1344-3562-9aad-1b36df9c57c1",
                        "entry_id": "f758e2c6-73b7-37f0-9d2d-c758798f2155",
                        "glosses": [
                            "Tending to neglect; failing to take care of matters which require attention; forgetful."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71b7832a-6f39-41f8-9979-fdb1cadf8d51",
                                "sense_id": "ac11d70b-1344-3562-9aad-1b36df9c57c1",
                                "text": "Neglectful of her fine voice, she was obviously attending more to her companions than to her own singing;..."
                            },
                            {
                                "example_id": "0a49a456-dc4d-4e5f-95e3-70e57b4c2d38",
                                "sense_id": "ac11d70b-1344-3562-9aad-1b36df9c57c1",
                                "text": "The Fates that are so careful to shut the doors of each successive life behind us had, in this case, been neglectful, and Charlie was looking, though that he did not know, where never man had been permitted to look with full knowledge since Time began."
                            },
                            {
                                "example_id": "447778f7-b930-421e-9bf0-9d8fcee5cf5c",
                                "sense_id": "ac11d70b-1344-3562-9aad-1b36df9c57c1",
                                "text": "2005, Plato, Sophist. Translation by Lesley Brown. 243a-b,\nThat they were too neglectful of ordinary people like us and overlooked us."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d5b6d3b-117e-42c0-a339-34a4347f93c6",
                        "source_entry_id": "f758e2c6-73b7-37f0-9d2d-c758798f2155",
