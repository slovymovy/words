                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12899d62-5aeb-421c-bf93-2c6de6222385",
                                                "sense_id": "2642e6cb-b5a9-33c4-96aa-150e6b3a7023",
                                                "text": "1693, John Dryden (translator), The Satires of Decimus Junius Juvenalis Translated into English Verse, London: Jacob Tonson, Satire 10, lines 307-308, p. 203,\n[…] a Visage rough,\nDeform’d, Unfeatur’d, and a Skin of Buff."
                                            },
                                            {
                                                "example_id": "d9c74733-c448-4abc-ab72-a2a7df64afc8",
                                                "sense_id": "2642e6cb-b5a9-33c4-96aa-150e6b3a7023",
                                                "text": "His face changed from tan to buff."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c47f6420-8ae6-3f2d-b040-2bdd9d44aee5",
                                        "entry_id": "42c7efe7-6823-35f4-a9b1-c3ae63356d89",
                                        "glosses": [
                                            "A military coat made of buff leather."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e3f4eeb-cf05-4f03-bc3b-f7ae506efeef",
                                                "sense_id": "c47f6420-8ae6-3f2d-b040-2bdd9d44aee5",
                                                "text": "A diuell in an euerlaſting garment hath him ; / On whoſe hard heart is button’d vp with ſteele : / A Feind, a Fairie, pittileſſe and ruffe : / A Wolfe, nay worſe, a fellow all in buffe […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51bc7a51-b52d-3f63-98b7-df2a307167a7",
                                        "entry_id": "42c7efe7-6823-35f4-a9b1-c3ae63356d89",
                                        "glosses": [
                                            "A person who is very interested in a particular subject."
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d65e9b9a-48a5-449c-865b-4ee7c7a8e971",
                                                "sense_id": "51bc7a51-b52d-3f63-98b7-df2a307167a7",
                                                "text": "He’s a real history buff. He knows everything there is to know about the civil war."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac33fd32-aa16-3803-a28f-195745da223c",
                                        "entry_id": "42c7efe7-6823-35f4-a9b1-c3ae63356d89",
                                        "glosses": [
                                            "An effect that makes a character or item stronger."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76da89d8-b969-492f-a78f-38609a3a316d",
                                                "sense_id": "ac33fd32-aa16-3803-a28f-195745da223c",
                                                "text": "I just picked up an epic damage buff! Let's go gank the other team!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d93c899f-f64f-305e-8fc9-ffbcb604f661",
                                        "entry_id": "42c7efe7-6823-35f4-a9b1-c3ae63356d89",
                                        "glosses": [
                                            "Compressive coupler force that occurs during a slack bunched condition."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "53794637-d63c-339b-9162-c72861684adf",
                                        "entry_id": "42c7efe7-6823-35f4-a9b1-c3ae63356d89",
                                        "glosses": [
                                            "The bare skin."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80139f2c-2dd9-456c-a136-56a479a33778",
                                                "sense_id": "53794637-d63c-339b-9162-c72861684adf",
                                                "text": "to strip to the buff"
                                            },
                                            {
                                                "example_id": "8c947a45-8a99-4b6d-ad69-2c5c04d5c342",
                                                "sense_id": "53794637-d63c-339b-9162-c72861684adf",
                                                "text": "To be in buff, is equivalent to being naked."
                                            },
                                            {
                                                "example_id": "a292fa36-9072-4070-bd3a-f21ed3eb4cf5",
                                                "sense_id": "53794637-d63c-339b-9162-c72861684adf",
                                                "text": "Not to mention, nudity can be just plain convenient. “Laundry is minimal,” Schulte notes. It also doesn’t hurt that being in the buff spices up his workday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb865ae4-f125-32ae-8269-ecd5a594ea65",
                                        "entry_id": "42c7efe7-6823-35f4-a9b1-c3ae63356d89",
                                        "glosses": [
                                            "The greyish viscid substance constituting the buffy coat."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6457d28b-cc21-30b5-99aa-9e370ee60f94",
                                        "entry_id": "42c7efe7-6823-35f4-a9b1-c3ae63356d89",
                                        "glosses": [
                                            "Any substance used to dilute (street) drugs in order to increase profits."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
