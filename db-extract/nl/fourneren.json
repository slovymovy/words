                                "target_senses": [
                                    {
                                        "sense_id": "104e152d-a462-348c-bf6f-6d32d3e53b99",
                                        "entry_id": "077d4633-997c-37a2-8a21-6eea3945041a",
                                        "glosses": [
                                            "To make a living; earn money for necessities."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b994cc0-4376-43ed-a6a6-ae9fb2c25e02",
                                                "sense_id": "104e152d-a462-348c-bf6f-6d32d3e53b99",
                                                "text": "It is difficult to provide for my family working on minimum wage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18ffd683-082a-3c45-b3a0-a7b9cc3fd9e9",
                                        "entry_id": "077d4633-997c-37a2-8a21-6eea3945041a",
                                        "glosses": [
                                            "To act to prepare for something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53735172-986c-422e-8a01-f448e979b2ed",
                                                "sense_id": "18ffd683-082a-3c45-b3a0-a7b9cc3fd9e9",
                                                "text": "provide against disaster."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbe9b739-f525-3ece-b496-d4a17b479cb1",
                                        "entry_id": "077d4633-997c-37a2-8a21-6eea3945041a",
                                        "glosses": [
                                            "To establish as a previous condition; to stipulate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e32da2b-e9dc-495a-9b8d-6edd71b0ae64",
                                                "sense_id": "bbe9b739-f525-3ece-b496-d4a17b479cb1",
                                                "text": "The contract provides that the work be well done."
                                            },
                                            {
                                                "example_id": "391caeb4-1ef0-406a-be64-c7ca0c7d7109",
                                                "sense_id": "bbe9b739-f525-3ece-b496-d4a17b479cb1",
                                                "text": "I'll lend you the money, provided that you pay it back by Monday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7faf6e57-07e3-3832-bb1f-e028df00f782",
                                        "entry_id": "077d4633-997c-37a2-8a21-6eea3945041a",
                                        "glosses": [
                                            "To give what is needed or desired, especially basic needs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dabc95d-de67-44f6-97db-6863456afbc9",
                                                "sense_id": "7faf6e57-07e3-3832-bb1f-e028df00f782",
                                                "text": "Don't bother bringing equipment, as we will provide it."
                                            },
                                            {
                                                "example_id": "e220a748-f96a-48a2-ad07-5d4e570f519a",
                                                "sense_id": "7faf6e57-07e3-3832-bb1f-e028df00f782",
                                                "text": "We aim to provide the local community with more green spaces."
                                            },
                                            {
                                                "example_id": "6e526f6e-3099-4871-8634-48693c515ee9",
                                                "sense_id": "7faf6e57-07e3-3832-bb1f-e028df00f782",
                                                "text": "Humans provided the animals with food and protection in exchange for which the animals provided the humans their milk, eggs, and—yes—their flesh."
                                            },
                                            {
                                                "example_id": "d978975b-853d-43b9-8415-0894751da667",
                                                "sense_id": "7faf6e57-07e3-3832-bb1f-e028df00f782",
                                                "text": "LSC provides grants to nonprofits nationwide that in turn provide civil legal aid to those who otherwise can't afford it. The beneficiaries of LSC funding include homeless veterans, low-income workers and victims of domestic abuse."
                                            },
                                            {
                                                "example_id": "48e40b51-7f08-4043-befb-3dadc610fe78",
                                                "sense_id": "7faf6e57-07e3-3832-bb1f-e028df00f782",
                                                "text": "Climate Reanalyzer uses data from the NCEP climate forecast system to provide a time series of daily mean two-metre air temperature, based on readings from surface, air balloon and satellite observations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b76cbb3-2df8-396d-91b9-ee7c4aef83bf",
                                        "entry_id": "077d4633-997c-37a2-8a21-6eea3945041a",
                                        "glosses": [
                                            "To furnish (with), cause to be present, supply."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25e63186-b42f-42b4-9f37-d2147561ac79",
                                                "sense_id": "8b76cbb3-2df8-396d-91b9-ee7c4aef83bf",
                                                "text": "Rome […] was generally well provided with corn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da8752d8-72cc-3356-a284-737c1a47df66",
                                        "entry_id": "077d4633-997c-37a2-8a21-6eea3945041a",
                                        "glosses": [
                                            "To make possible or attainable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99b85fbc-aa46-4811-9812-d10da5752549",
                                                "sense_id": "da8752d8-72cc-3356-a284-737c1a47df66",
                                                "text": "He provides us with an alternative option."
                                            },
                                            {
                                                "example_id": "0b4e1d64-9cce-41ff-b740-4b693d3fc6f6",
                                                "sense_id": "da8752d8-72cc-3356-a284-737c1a47df66",
                                                "text": "Bring me berries, or such cooling fruit / As the kind, hospitable woods provide.",
                                                "translation": "Comus",
                                                "english": "Comus"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3938f30-652f-3024-a4fa-eaeba07ebb32",
                                        "entry_id": "077d4633-997c-37a2-8a21-6eea3945041a",
                                        "glosses": [
                                            "To foresee, to consider in advance."
                                        ],
                                        "tags": [
                                            "Latinism",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0e35392-767b-4de9-82eb-3226f24cab23",
                                                "sense_id": "b3938f30-652f-3024-a4fa-eaeba07ebb32",
                                                "text": "We have not been covetous, honourable fathers, to change, neither is it now any new lust that alters our affection, or old lothing, but those needful jealousies of state, that warn wiser princes hourly to provide their safety, and do teach them how learned a thing it is to beware of the humblest enemy; much more of those great ones, whom their own employed favours have made fit for their fears."
                                            },
                                            {
                                                "example_id": "ae5a14dc-1b14-4a58-9dce-407c300ede89",
                                                "sense_id": "b3938f30-652f-3024-a4fa-eaeba07ebb32",
                                                "text": "As for those that will (by faults which charity hath raked up, or common honesty concealed) make themselves a name with the multitude, or, to draw their rude and beastly claps, care not whose living faces they intrench with their petulant styles, may they do it without a rival, for me! I choose rather to live graved in obscurity, than share with them in so preposterous a fame. Nor can I blame the wishes of those severe and wise patriots, who providing the hurts these licentious spirits may do in a state, desire rather to see fools and devils, and those antique relics of barbarism retrieved, with all other ridiculous and exploded follies, than behold the wounds of private men, of princes and nations"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7fc2177-a854-3290-be70-845310b7d542",
                                        "entry_id": "077d4633-997c-37a2-8a21-6eea3945041a",
                                        "glosses": [
                                            "To appoint to an ecclesiastical benefice before it is vacant. See provisor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6ca4d1e-a903-48ce-af9d-3da5e7c818e2",
                                                "sense_id": "b7fc2177-a854-3290-be70-845310b7d542",
                                                "text": "provide such natives to the higher dignities of the church"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "edb1ffbf-c63a-498c-8aca-b138f9ab0444",
                        "source_entry_id": "7ca64252-b552-3d1b-a3d2-7aaaa05684df",
                        "source_sense_id": "857151b4-2d8f-33c6-b220-aebc2b07883f",
                        "source_sense_description": "(financieel) iemand of iets voorzien van geld",
                        "target_lang_word": "fournir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fournir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d5612311-af71-3f33-aba6-17ebfc8fab71",
                                        "entry_id": "9f7f6b57-3aed-38b1-aa6d-6e159ed5959a",
                                        "glosses": [
                                            "Pourvoir ; approvisionner."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3ac72a6-eb80-4a62-a532-036bb8627936",
                                                "sense_id": "d5612311-af71-3f33-aba6-17ebfc8fab71",
                                                "text": "Mais, somme toute, les dirigeables n’étaient pas mieux fournis, en fait de cuirassement et d’armement, que la plus petite canonnière."
                                            },
                                            {
                                                "example_id": "ea01173d-4156-49eb-8d77-e4987b755f02",
                                                "sense_id": "d5612311-af71-3f33-aba6-17ebfc8fab71",
                                                "text": "Toutes ces plantes appartiennent à la classe des cultures dites industrielles, parce qu'elles fournissent des produits qui servent de matières premières à l'industrie."
                                            },
                                            {
                                                "example_id": "40187b1a-1e77-4b82-a2bd-801b627492a7",
                                                "sense_id": "d5612311-af71-3f33-aba6-17ebfc8fab71",
                                                "text": "Dans les sols légers et perméables la potasse sera fournie sous forme de kaïnite. Dans les sols argileux, il faut éviter de l'employer."
                                            },
                                            {
                                                "example_id": "d3a81805-a4ee-4ebf-9aed-a015f5959a32",
                                                "sense_id": "d5612311-af71-3f33-aba6-17ebfc8fab71",
                                                "text": "— Ce commerçant qui fournit dans cette maison. - Il se fournit d’ordinaire chez ce marchand."
                                            },
                                            {
                                                "example_id": "11312aa6-287e-49d1-b9c6-62b8a5f19453",
                                                "sense_id": "d5612311-af71-3f33-aba6-17ebfc8fab71",
                                                "text": "En 1894, le capitaine Alfred Dreyfus, officier français de confession juive, est condamné à la déportation à vie pour avoir fourni des documents secrets à l'Allemagne.https://fr.wikipedia.org/wiki/J%27accuse_(film,_2019)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0599fba8-27ea-3d0b-bba0-1008bb7e9cb6",
                                        "entry_id": "9f7f6b57-3aed-38b1-aa6d-6e159ed5959a",
                                        "glosses": [
                                            "Livrer ; procurer ; faire avoir."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc6e4adb-20b0-41a6-a7bd-404d158370fa",
                                                "sense_id": "0599fba8-27ea-3d0b-bba0-1008bb7e9cb6",
                                                "text": "Ces chiffres comparés avec le nombre de pieds cubes d'eau que les aqueducs de la ville fournissent en 24 heures, démontreraient, ce que la simple inspection des fontaines publiques aux diverses heures du jour et de la nuit prouve déjà, que les deux tiers environ de l’eau potable qui arrive à Lausanne se répandent dans les égouts , sans avoir été préalablement utilisés."
                                            },
                                            {
                                                "example_id": "9fe8fbae-bd20-4e9d-9fb8-816c4b6b7988",
                                                "sense_id": "0599fba8-27ea-3d0b-bba0-1008bb7e9cb6",
                                                "text": "Il pense avec d’amers regrets à son pouvoir évanoui, aux empiffreries de viande de porc que lui fournissaient les nigauds, aux vaches grasses à tout jamais remplacées par des vaches maigres."
                                            },
                                            {
                                                "example_id": "906ef838-f51f-49d2-9775-bbfe0dad378f",
                                                "sense_id": "0599fba8-27ea-3d0b-bba0-1008bb7e9cb6",
                                                "text": "Pourquoi construire d'inconfortables maisons en planches et en tôle ondulée quand le feuillage des cocotiers peut vous fournir des abris toujours frais?"
                                            },
                                            {
                                                "example_id": "a732ce7f-a7da-46a1-bdd2-102509fb8be5",
                                                "sense_id": "0599fba8-27ea-3d0b-bba0-1008bb7e9cb6",
                                                "text": "Encore aujourd'hui, le diocèse de Rodez est, de tous, celui qui fournit le plus grand nombre de prêtres, le plus grand nombre de missionnaires."
                                            },
                                            {
                                                "example_id": "3c852fd9-e1f1-4da1-a5a4-2b18a08497b7",
                                                "sense_id": "0599fba8-27ea-3d0b-bba0-1008bb7e9cb6",
                                                "text": "En effet, en dehors des tossafistes, qui illustrèrent le rabbinat français au XIIᵉ et XIIIᵉ siècle, la famille de Raschi a fourni au judaïsme maintes célébrités."
                                            },
                                            {
                                                "example_id": "9d2f9813-91b5-4261-92a6-168027f6af8b",
                                                "sense_id": "0599fba8-27ea-3d0b-bba0-1008bb7e9cb6",
                                                "text": "Je m'explique: nos usines cédulent le départ et l'arrivée des bateaux, leur fournissant la quantité de glace nécessaire pour qu'ils rapportent le poisson dans le meilleur état de fraîcheur possible."
                                            },
                                            {
                                                "example_id": "39289912-88a5-4978-a8df-92453b5b8b74",
                                                "sense_id": "0599fba8-27ea-3d0b-bba0-1008bb7e9cb6",
                                                "text": "L’huile que fournissent les graines de colza."
                                            },
                                            {
                                                "example_id": "d0361296-30f9-4282-b438-d877bdbaa6b7",
                                                "sense_id": "0599fba8-27ea-3d0b-bba0-1008bb7e9cb6",
                                                "text": "Cette école préparatoire est destinée à fournir des officiers, des professeurs, des administrateurs, etc."
                                            },
                                            {
                                                "example_id": "45079fca-1f54-4f6c-a893-fcc9f2e7cc6e",
                                                "sense_id": "0599fba8-27ea-3d0b-bba0-1008bb7e9cb6",
                                                "text": "Ce livre m’a fourni plusieurs citations, des idées, des renseignements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ffeded44-0a46-3f03-b10a-8bfe12ae2e23",
                                        "entry_id": "9f7f6b57-3aed-38b1-aa6d-6e159ed5959a",
                                        "glosses": [
                                            "Mettre la carte qui est prévue par la règle du jeu."
                                        ],
                                        "tags": [
                                            "especially",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0f60449-85e5-4060-86e4-afb0d16bc219",
                                                "sense_id": "ffeded44-0a46-3f03-b10a-8bfe12ae2e23",
                                                "text": "Si vous avez de l’atout, vous devez en fournir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30cd7f1c-ff90-34ab-b44d-e187958cca68",
                                        "entry_id": "9f7f6b57-3aed-38b1-aa6d-6e159ed5959a",
                                        "glosses": [
                                            "Produire, exposer, surtout en termes de procédure et d’administration."
                                        ],
                                        "tags": [
                                            "especially",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6318ecc2-7903-485e-a113-bc54e3e74668",
                                                "sense_id": "30cd7f1c-ff90-34ab-b44d-e187958cca68",
                                                "text": "Fournir ses défenses, ses griefs."
                                            },
                                            {
                                                "example_id": "7a03173f-3917-49a0-a4a0-b081d8a84953",
                                                "sense_id": "30cd7f1c-ff90-34ab-b44d-e187958cca68",
                                                "text": "Il n’a pas fourni toutes les pièces du dossier."
                                            },
                                            {
                                                "example_id": "8a0fe5bb-1ad4-4160-b0ef-fa055a0d6be8",
                                                "sense_id": "30cd7f1c-ff90-34ab-b44d-e187958cca68",
                                                "text": "J’en fournirai la preuve quand on le voudra."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff8d2009-dfb3-3296-9fa4-33d6461c8f23",
                                        "entry_id": "9f7f6b57-3aed-38b1-aa6d-6e159ed5959a",
                                        "glosses": [
                                            "Parcourir l'espace de dressage"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3904ef60-cfb0-4310-b84b-944754168016",
                                                "sense_id": "ff8d2009-dfb3-3296-9fa4-33d6461c8f23",
                                                "text": "Ce cheval a bien fourni la carrière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56cd8d5b-fb7c-3dee-b33c-c2a2d6c0b85d",
                                        "entry_id": "9f7f6b57-3aed-38b1-aa6d-6e159ed5959a",
                                        "glosses": [
                                            "Accomplir."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e481a68-bebd-4a64-bcee-911747b32442",
                                                "sense_id": "56cd8d5b-fb7c-3dee-b33c-c2a2d6c0b85d",
                                                "text": "Aujourd’hui à droite, demain à gauche, un jour fournissant des étapes de quarante kilomètres, le jour suivant, reculant d’autant, nous tournions sans cesse dans le même cercle, pareils à un bétail débandé qui aurait perdu son pasteur."
                                            },
                                            {
                                                "example_id": "7f2d1dd9-da48-492a-b7fc-3964a7dbe665",
                                                "sense_id": "56cd8d5b-fb7c-3dee-b33c-c2a2d6c0b85d",
                                                "text": "Il s’est jeté dans sa voiture qui a fourni une course furibonde à travers Paris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23f1b9c9-98d1-345c-9e59-b485eb390903",
                                        "entry_id": "9f7f6b57-3aed-38b1-aa6d-6e159ed5959a",
                                        "glosses": [
                                            "Subvenir, contribuer en tout ou en partie."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5083e92-249a-4d01-8f3a-a3ff418dba1c",
                                                "sense_id": "23f1b9c9-98d1-345c-9e59-b485eb390903",
                                                "text": "Fournir aux frais."
                                            },
