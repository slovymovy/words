                        "form": "verdeurs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "77b05a49-fb36-3031-87b5-e8451f487ef2",
                        "entry_id": "0a2a41e8-b468-3819-8e96-ae0b50d4e26b",
                        "glosses": [
                            "Caractère de ce qui est encore vert."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aab3faa7-2ff8-49ba-b3d8-645abfe59706",
                                "sense_id": "77b05a49-fb36-3031-87b5-e8451f487ef2",
                                "text": "Ce bois a encore de la verdeur."
                            }
                        ]
                    },
                    {
                        "sense_id": "a4dce9ea-f279-3ddb-b3de-1645f3f8beeb",
                        "entry_id": "0a2a41e8-b468-3819-8e96-ae0b50d4e26b",
                        "glosses": [
                            "Acidité du vin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab86ec13-a60e-4f19-ae5b-215c613d0ffc",
                                "sense_id": "a4dce9ea-f279-3ddb-b3de-1645f3f8beeb",
                                "text": "Le tannin, qui vient de la rafle, des pépins et des pellicules donne de l’âpreté ; […]. Les acides communiquent de la verdeur."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b1a536b-6cd7-336d-9b16-4e3f342dae3c",
                        "entry_id": "0a2a41e8-b468-3819-8e96-ae0b50d4e26b",
                        "glosses": [
                            "Sève, humidité qui se trouve à l'intérieur d'un morceau de bois coupé qui n'est pas encore sec."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70ecde4a-3416-4db7-b94c-5e329815c28e",
                                "sense_id": "6b1a536b-6cd7-336d-9b16-4e3f342dae3c",
                                "text": "Verdeur : Il se dit aussi du bois pour marquer qu'il n'a pas perdu son humidité naturelle depuis qu'il est coupé."
                            }
                        ]
                    },
                    {
                        "sense_id": "66865f37-2bdb-3d07-a57b-00441151ef9e",
                        "entry_id": "0a2a41e8-b468-3819-8e96-ae0b50d4e26b",
                        "glosses": [
                            "Jeunesse ou vigueur des hommes."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "7110d540-b4d3-416a-97a6-1e0383a24e91",
                                "sense_id": "66865f37-2bdb-3d07-a57b-00441151ef9e",
                                "text": "Dans la verdeur de l’âge, de son âge."
                            },
                            {
                                "example_id": "9894a5a5-dc77-4ee7-bca8-34c752eb0065",
                                "sense_id": "66865f37-2bdb-3d07-a57b-00441151ef9e",
                                "text": "Il était alors dans sa verdeur."
                            }
                        ]
                    },
                    {
                        "sense_id": "24511178-5da2-3a47-aa8c-2e7385b84009",
                        "entry_id": "0a2a41e8-b468-3819-8e96-ae0b50d4e26b",
                        "glosses": [
                            "Rudesse des paroles."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "2353a38d-9bdb-42a5-a35b-8c7c1b9a058b",
                                "sense_id": "24511178-5da2-3a47-aa8c-2e7385b84009",
                                "text": "Cela est fort juste ; mais Sainte-Beuve a répondu d’avance assez à propos, quoique avec une verdeur dont je n’userais certes pas et que je laisse à son compte."
                            }
                        ]
                    }
                ],
