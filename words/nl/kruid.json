                {
                    "sense_id": "4cc66a06-c172-35d7-9ec1-501ba2678262",
                    "sense_definition": "Een plant die wordt gebruikt om smaak of geur aan eten te geven, of vanwege een geneeskrachtige werking.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "planten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik gebruik vaak een vers <w>kruid</w> zoals basilicum in mijn pastasaus.",
                            "target_lang_translations": {
                                "en": "I often use a fresh <w>herb</w> like basil in my pasta sauce."
                            }
                        },
                        {
                            "text": "In deze tuin groeien veel verschillende soorten <w>kruiden</w> voor in de keuken.",
                            "target_lang_translations": {
                                "en": "Many different types of <w>herbs</w> for the kitchen grow in this garden."
                            }
                        }
                    ],
                    "synonyms": [
                        "specerij"
                    ],
                    "antonyms": [
                        "onkruid"
                    ],
                    "common_phrases": [
                        "vers kruid",
                        "gedroogde kruiden",
                        "geneeskrachtig kruid"
                    ],
                    "target_lang_definitions": {
                        "en": "A plant used to add flavor or aroma to food, or for its medicinal properties."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "herb",
                                "target_lang_sense_clarification": "culinary or medicinal plant"
                            },
                            {
                                "target_lang_word": "spice",
                                "target_lang_sense_clarification": "flavoring agent, often dried"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55b434d6-6f07-3a51-8d0a-f67f9d1fb351",
                    "sense_definition": "Een algemene benaming voor kleine, groene, niet-houterige planten.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "planten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tussen het hoge gras groeien verschillende soorten <w>kruiden</w> en bloemen.",
                            "target_lang_translations": {
                                "en": "Various types of <w>herbs</w> and flowers grow among the tall grass."
                            }
                        },
                        {
                            "text": "De bioloog onderzocht het kleine <w>kruid</w> dat alleen in dit moeras voorkomt.",
                            "target_lang_translations": {
                                "en": "The biologist studied the small <w>herb</w> that only occurs in this swamp."
                            }
                        }
                    ],
                    "antonyms": [
                        "onkruid"
                    ],
                    "common_phrases": [
                        "laag kruid"
                    ],
                    "target_lang_definitions": {
                        "en": "A general term for small, green, non-woody plants."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "herb",
                                "target_lang_sense_clarification": "botanical term for non-woody plants"
                            },
                            {
                                "target_lang_word": "herbage",
                                "target_lang_sense_clarification": "greenery or vegetation"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a4221e0a-5c16-3a78-8fcc-949c519e42fa",
                    "sense_definition": "De eerste persoon enkelvoud tegenwoordige tijd van <w>kruiden</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>kruid</w> het vlees altijd met een beetje zout en peper.",
                            "target_lang_translations": {
                                "en": "I always <w>season</w> the meat with a little salt and pepper."
                            }
                        },
                        {
                            "text": "Wacht even, ik <w>kruid</w> de soep nog voordat we gaan eten.",
                            "target_lang_translations": {
                                "en": "Wait a moment, I'm still <w>spicing</w> the soup before we eat."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The first-person singular present tense of 'to season' or 'to spice'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "season",
                                "target_lang_sense_clarification": "adding flavor to food"
                            },
                            {
                                "target_lang_word": "spice",
                                "target_lang_sense_clarification": "adding spices to food"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "827e63f0-6922-3552-8cc3-592ed7e31d17",
                    "sense_definition": "De gebiedende wijs van <w>kruiden</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Kruid</w> de vis royaal met citroen en dille voor een frisse smaak.",
                            "target_lang_translations": {
                                "en": "<w>Season</w> the fish generously with lemon and dill for a fresh taste."
                            }
                        },
                        {
                            "text": "Lees het recept goed: <w>kruid</w> eerst de groenten en bak ze daarna kort.",
                            "target_lang_translations": {
