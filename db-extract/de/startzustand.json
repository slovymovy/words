                "senses": [
                    {
                        "sense_id": "ca263689-05ed-3d33-a131-a6d17a47b497",
                        "entry_id": "a636a64e-637f-355d-890b-daceaf5a37ee",
                        "glosses": [
                            "speziell ausgezeichneter Zustand eines Automaten, von dem aus die Ableitung einer Eingabe beginnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24fff258-4092-4a9b-b621-2bf1504b09e4",
                                "sense_id": "ca263689-05ed-3d33-a131-a6d17a47b497",
                                "text": "„Ein Startzustand ist per Default der erste Zustand eines Automaten, der besucht wird.“"
                            },
                            {
                                "example_id": "8a585b5c-4e2c-4d45-8fcb-47bcd17207a8",
                                "sense_id": "ca263689-05ed-3d33-a131-a6d17a47b497",
                                "text": "„Eine Folge von Übergängen ist ein erfolgreicher Suchprozess, wenn sie mit dem Startzustand beginnt und mit einem Endzustand endet.“"
                            },
                            {
                                "example_id": "a1fe981f-1155-4714-88ab-e21cf561801c",
                                "sense_id": "ca263689-05ed-3d33-a131-a6d17a47b497",
                                "text": "„Da bei einer Turing-Maschine der Startzustand auch im rechten Glied einer Instruktion vorkommen darf, tritt in einer Berechnung der Startzustand nicht unbedingt nur beim Start auf.“"
                            },
                            {
                                "example_id": "a56d5e4c-9df7-4461-8c86-0ed26996105f",
                                "sense_id": "ca263689-05ed-3d33-a131-a6d17a47b497",
                                "text": "„Ein Random Walk auf dem Graphen entspricht einer Zustandsfolge und wir können ausgehend von einem Startzustand ermitteln, mit welcher Wahrscheinlichkeit das System ebendiese Zustandsfolge durchläuft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
