                "senses": [
                    {
                        "sense_id": "5db49f55-1552-3536-b201-d255639e3282",
                        "entry_id": "ffeb22d4-82ff-34c4-8f51-d89ff8313390",
                        "glosses": [
                            "kleiner einachsiger Wagen mit einem Rad, einer Wanne und zwei Handgriffen, der mit Muskelkraft geschoben wird"
                        ],
                        "tags": [
                            "Landfahrzeug"
                        ],
                        "examples": [
                            {
                                "example_id": "8710198e-cbe5-4154-b6f1-e0fc3d60ef8a",
                                "sense_id": "5db49f55-1552-3536-b201-d255639e3282",
                                "text": "Der Schubkarren ist im Garten ein unentbehrlicher Helfer."
                            },
                            {
                                "example_id": "61649ffb-c09a-49e7-895d-5d0fb38e93bd",
                                "sense_id": "5db49f55-1552-3536-b201-d255639e3282",
                                "text": "„Dann sitze ich auf einem umgedrehten Schubkarren und starre ins Feuer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "96da51f4-4c5a-3284-a7f4-d73b8c2329d1",
                        "entry_id": "ffeb22d4-82ff-34c4-8f51-d89ff8313390",
                        "glosses": [
                            "sportliche Übung, bei der einer auf Händen läuft, während ein Partner seine Beine hochhält und mitgeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de851fe9-fb93-4bce-bcb7-dec0a19ab77b",
                                "sense_id": "96da51f4-4c5a-3284-a7f4-d73b8c2329d1",
                                "text": "Beim Turnfest machen die Kinder paarweise Schubkarren um die Wette."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
