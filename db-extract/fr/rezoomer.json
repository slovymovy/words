                "senses": [
                    {
                        "sense_id": "edc8abb0-442d-39e3-8c5d-003a7b0fb44d",
                        "entry_id": "7d9b7f77-a06d-359f-9678-637ecb52c64d",
                        "glosses": [
                            "Zoomer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39f59205-6493-46a6-b3b3-ef482b46cc21",
                                "sense_id": "edc8abb0-442d-39e3-8c5d-003a7b0fb44d",
                                "text": "Lorsque la caméra viscontienne cadre, décadre et recadre, zoome, dézoome et rezoome, lorsqu'elle traverse l'espace de la scène comme un trait de crayon gras (pour un peu, on verrait la flèche, comme sur un tableau de Velickovic), taillant à coups de serpe dans la figuration qui piétine toute harnachée dans le plan », Serge Daney voit la main qui trace du « peintre qui a déjà tout le (...)"
                            },
                            {
                                "example_id": "1a7359ea-9ddf-46bb-a8e8-1598d2694939",
                                "sense_id": "edc8abb0-442d-39e3-8c5d-003a7b0fb44d",
                                "text": "Tu vas passer ton temps à zoomer / dézoomer / rezoomer / recentrer l'image / dézoomer / rezoomer /..."
                            },
                            {
                                "example_id": "b5c98310-d06b-4585-bbbe-868a69572e38",
                                "sense_id": "edc8abb0-442d-39e3-8c5d-003a7b0fb44d",
                                "text": "Pourquoi rezoomer sur la France à chaque affichage ?"
                            }
                        ]
                    }
