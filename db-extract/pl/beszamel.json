                                        "sense_id": "d29d3617-6888-3b60-ae23-124410eb2e86",
                                        "entry_id": "bebd8d4a-c353-3717-a612-10761c7a8a32",
                                        "glosses": [
                                            "A simple white sauce made from a roux of butter and flour to which is added hot milk."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
