                "senses": [
                    {
                        "sense_id": "9d3d5fbd-2109-3af2-ad06-ccd1096673d7",
                        "entry_id": "9172d2a6-c1b3-355f-9577-db9f46100e0e",
                        "glosses": [
                            "Konsonant, bei dem der Luftstrom beim Sprechen ungehindert austreten kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c474e9c-bcc2-4537-8e79-3a301a46cf11",
                                "sense_id": "9d3d5fbd-2109-3af2-ad06-ccd1096673d7",
                                "text": "„Wo h als Sprachlaut auftritt, ist es immer ein ‚Öffnungskonsonant‘, freilich ohne angebbare Lokalisation.“"
                            },
                            {
                                "example_id": "f98f9343-0a85-4611-8d56-488f22e6f9d6",
                                "sense_id": "9d3d5fbd-2109-3af2-ad06-ccd1096673d7",
                                "text": "„Da /h/ als einziger Konsonant der deutschen Sprache mit völliger Öffnung des Ansatzrohres gebildet wird, bezeichnet man es auch als ‚Öffnungskonsonant‘.“"
                            },
                            {
                                "example_id": "6d5df793-bd7b-408b-955c-7ff699d20c81",
                                "sense_id": "9d3d5fbd-2109-3af2-ad06-ccd1096673d7",
                                "text": "„Beim Prozess der Öffnung wird der Anlaut durch den Öffnungskonsonanten [h] ersetzt.“"
                            },
                            {
                                "example_id": "b147480a-37d2-4c65-9fdf-e2b419a3bc40",
                                "sense_id": "9d3d5fbd-2109-3af2-ad06-ccd1096673d7",
                                "text": "„Daher wird [h] auch als ‚Öffnungskonsonant‘ bezeichnet und seine Artikulationsstelle kann nicht festgelegt werden, deshalb wird [h] weder als Vokal noch als Konsonant bezeichnet [16; 178].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
