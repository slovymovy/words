                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c40b6179-5d14-3a39-b1de-0d9958219dc8",
                                        "entry_id": "652d7e0a-0e0f-3b03-a467-6e358552a5c5",
                                        "glosses": [
                                            "deel van het menselijk lichaam waar de benen samenkomen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a14f80e-569b-4c61-970e-8db946b67d56",
                                                "sense_id": "c40b6179-5d14-3a39-b1de-0d9958219dc8",
                                                "text": "In de tram was ik me bewust van mijn schaamlippen die tegen de naden van het kruis van de joggingbroek aan schuurden."
                                            },
