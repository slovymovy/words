    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "52107145-3e55-39d8-a6e3-295fe87d6d9b",
                "word": "Mammon",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e7847b4a-4989-3ff6-9bd7-61c42b20b2b6",
                        "entry_id": "52107145-3e55-39d8-a6e3-295fe87d6d9b",
                        "glosses": [
                            "The desire for wealth personified as an evil spirit or a malign influence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6752702e-3ce3-491b-89e2-92ef5bb0bbe7",
                                "sense_id": "e7847b4a-4989-3ff6-9bd7-61c42b20b2b6",
                                "text": "No man can ſerue two maſters: for either he will hate the one and loue the other, or elſe hee will holde to the one, and deſpiſe the other. Ye cannot ſerue God and Mammon."
                            },
                            {
                                "example_id": "1e0b4f7c-4709-4fc4-a0b8-7fd78d68e19f",
                                "sense_id": "e7847b4a-4989-3ff6-9bd7-61c42b20b2b6",
                                "text": "They [bankers] would do what has been done by the Bank of France—buy bullion at a premium, on the approach of danger, and keep peril at a safe and respectable distance. Any expenditure that might be incurred for that purpose would be small indeed when contrasted with the immense loss and suffering caused by the present system, and the continual fear in which the public now live of some new crisis—because it has been out of one and into another for a long period now; and that will be the case hereafter, until we have no interval to gather strength, and recruit for the next struggle with Mammon, or Moloch, or whatever other name of evil import belongs to the \"Tutelarity\" of Lombard-street and its precincts."
                            },
                            {
                                "example_id": "c23f375b-487b-497f-a8a2-c54c9869d870",
                                "sense_id": "e7847b4a-4989-3ff6-9bd7-61c42b20b2b6",
                                "text": "Lives sacrificed upon the altar of Mammon, only units in the thousands who have fallen in the wilds of Australia, victims to the fever and unrest caused by the search for gold."
                            }
                        ]
                    },
                    {
                        "sense_id": "128f9aa2-8973-3110-9403-6b0afeeb5179",
                        "entry_id": "52107145-3e55-39d8-a6e3-295fe87d6d9b",
                        "glosses": [
                            "Often mammon: wealth, material avarice, profit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d34ee1d8-042f-4b78-ac5e-5310decaa29a",
                                "sense_id": "128f9aa2-8973-3110-9403-6b0afeeb5179",
                                "text": "The proper sphere of the church, after all, was the kingdom of God, not greedy earthbound kingdoms of mammon, which should be left to temporal authorities to rule and squabble over."
                            },
                            {
                                "example_id": "3bfca319-9309-4ad3-bad4-bcec536b67e9",
                                "sense_id": "128f9aa2-8973-3110-9403-6b0afeeb5179",
                                "text": "But he [Andrew Wyeth] did not want to become an all-American illustrator like the Post's illustrious Norman Rockwell – and he had heard his own father, an illustrator, bemoan choosing the path of mammon rather than the path of virtue, and declined."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "725d5680-93ea-417f-a70a-fccd8ed946f8",
                        "source_entry_id": "52107145-3e55-39d8-a6e3-295fe87d6d9b",
                        "source_sense_description": "wealth",
                        "target_lang_word": "mamon",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
