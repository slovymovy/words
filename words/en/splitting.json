                {
                    "sense_id": "f6b037f9-d5ca-3805-9e3a-7c591936589a",
                    "sense_definition": "Resembling the sharp, cracking sound of something being split or ripped.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a loud <w>splitting</w> noise as the old tree finally gave way.",
                            "target_lang_translations": {
                                "ru": "Раздался громкий <w>треск</w>, когда старое дерево наконец рухнуло.",
                                "pl": "Rozległ się głośny <w>trzask</w>, gdy stare drzewo w końcu runęło."
                            }
                        },
                        {
                            "text": "We heard the <w>splitting</w> sound of ice cracking beneath our feet.",
                            "target_lang_translations": {
                                "ru": "Мы услышали <w>треск</w> ломающегося под ногами льда.",
                                "pl": "Usłyszeliśmy <w>trzaskający</w> dźwięk lodu pękającego pod naszymi stopami."
                            }
                        }
                    ],
                    "synonyms": [
                        "cracking",
                        "ripping"
                    ],
                    "target_lang_definitions": {
                        "ru": "Напоминающий резкий, трескучий звук чего-то раскалывающегося или рвущегося.",
                        "pl": "Przypominający ostry, trzaskający dźwięk czegoś, co pęka lub się rozdziera."
                    },
