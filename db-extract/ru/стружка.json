                            {
                                "example_id": "694cfcc2-5028-4a8e-917f-f2f992045a25",
                                "sense_id": "e9f7d77a-efe6-393f-a803-76cc483e486f",
                                "text": "(also idiomatic) снима́ть стру́жку",
                                "translation": "tear off a strip",
                                "english": "tear off a strip"
                            },
                            {
                                "example_id": "76f21cd4-45b9-4fa7-aa16-bb0b69785046",
                                "sense_id": "e9f7d77a-efe6-393f-a803-76cc483e486f",
                                "text": "Услыха́в своё и́мя, по́месь та́ксы с дворня́жкой вы́шла из-под верстака́, где она́ спала́ на стру́жках, сла́дко потяну́лась и побежа́ла за хозя́ином.",
                                "translation": "Hearing her name, the half dachshund half mutt came out from under the workbench where she slept on the wood shavings, stretched sweetly, and ran after her master.",
                                "english": "Hearing her name, the half dachshund half mutt came out from under the workbench where she slept on the wood shavings, stretched sweetly, and ran after her master."
                            }
                        ]
                    }
