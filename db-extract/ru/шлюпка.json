                "translations": [
                    {
                        "translation_id": "bd06f881-fdb9-44c2-aa27-bde76663f431",
                        "source_entry_id": "acfefacd-2cd4-3c04-aa28-dcf1cc63fa4e",
                        "target_lang_word": "canot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "canot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fc4106a7-73f6-373f-9e0b-1224b03518c8",
                                        "entry_id": "458f3c56-5b90-3b60-88aa-7b05c34e9299",
                                        "glosses": [
                                            "Synonyme de pirogue."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42c5ada6-9535-4e4a-b63d-fa0d046ce44f",
                                                "sense_id": "fc4106a7-73f6-373f-9e0b-1224b03518c8",
                                                "text": "Les canots des sauvages."
                                            },
                                            {
                                                "example_id": "0560eca5-57da-4eb7-975a-728b566c80c4",
                                                "sense_id": "fc4106a7-73f6-373f-9e0b-1224b03518c8",
                                                "text": "Un canot d’écorce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5abab816-8104-3309-b7d5-af71e930fa1c",
                                        "entry_id": "458f3c56-5b90-3b60-88aa-7b05c34e9299",
                                        "glosses": [
                                            "Synonyme de barque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f3c79c5-a02b-4a73-be2d-9918f457596b",
                                                "sense_id": "5abab816-8104-3309-b7d5-af71e930fa1c",
                                                "text": "L'épouvantail semblait recouvert de goudron, comme celui qu'on utilise pour rendre les canots étanches."
                                            },
                                            {
                                                "example_id": "649a44f6-755c-4d0e-8489-42120afe42cc",
                                                "sense_id": "5abab816-8104-3309-b7d5-af71e930fa1c",
                                                "text": "Canot à rames, à voiles, à vapeur."
                                            },
                                            {
                                                "example_id": "70c3a06d-ff15-4095-8ccc-fb7f6a207049",
                                                "sense_id": "5abab816-8104-3309-b7d5-af71e930fa1c",
                                                "text": "Canot automobile."
                                            },
                                            {
                                                "example_id": "d02802c3-e1d7-46d2-8ce4-ecebb4dfe66d",
                                                "sense_id": "5abab816-8104-3309-b7d5-af71e930fa1c",
                                                "text": "Enfin, je pus appareiller le 27 février, suivi de plusieurs amis qui, dans un canot à moteur, prenaient des photographies de mon départ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "702bffe2-811a-35e0-b9f9-943cd3d335cc",
                                        "entry_id": "458f3c56-5b90-3b60-88aa-7b05c34e9299",
                                        "glosses": [
                                            "Synonyme de barque.",
                                            "Embarcation légère, sans pont, destinée au service d’un navire ou d’un bateau de pêche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15cb8ad5-1f54-4253-b878-5b7a2f57b5cc",
                                                "sense_id": "702bffe2-811a-35e0-b9f9-943cd3d335cc",
                                                "text": "Je repartis bientôt avec le canot et les personnes qui devaient résider dans l’île."
                                            },
                                            {
                                                "example_id": "d4058346-a9d2-4b6f-9365-f3c57b75bdc8",
                                                "sense_id": "702bffe2-811a-35e0-b9f9-943cd3d335cc",
                                                "text": "La vieille et solide baleinière, construite pour l’Antarctique, ainsi qu’un bon canot poussèrent du bord."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
