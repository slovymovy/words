                        "source_sense_description": "unit of luminous intensity",
                        "target_lang_word": "kandela",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kandela",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "0295bdd7-a54a-36f3-8fc7-51a58927113b",
                                        "entry_id": "f6a42209-c9ac-3d6c-86e5-5f8c0e7d0c5b",
                                        "glosses": [
