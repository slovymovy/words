    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ef811b8e-d338-3b70-b1ad-0d5bbe955509",
                    "sense_definition": "Placer des capitaux ou de l'argent dans une entreprise ou un projet pour en tirer un profit.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a décidé d'<w>investir</w> une partie de ses économies dans l'immobilier."
                        },
                        {
                            "text": "Cette jeune entreprise cherche des partenaires prêts à <w>investir</w> massivement dans l'innovation."
                        }
                    ],
                    "synonyms": [
                        "placer"
                    ],
                    "antonyms": [
                        "désinvestir"
                    ],
                    "common_phrases": [
                        "investir dans l'immobilier",
                        "investir en bourse",
                        "investir des fonds"
                    ]
                },
                {
                    "sense_id": "67e0ac35-dd1a-3fc4-8879-f2e9da41dd5f",
                    "sense_definition": "Consacrer son temps, son énergie et ses efforts à une activité ou une cause en s'y engageant pleinement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "engagement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tous les bénévoles s'<w>investissent</w> beaucoup pour aider les personnes défavorisées de la ville."
                        },
                        {
                            "text": "Il est important de s'<w>investir</w> dans ses études dès le début de l'année scolaire."
                        }
                    ],
                    "synonyms": [
                        "s'impliquer",
                        "s'engager"
                    ],
                    "antonyms": [
                        "se désintéresser"
                    ],
                    "common_phrases": [
                        "s'investir pleinement",
                        "s'investir dans un projet"
                    ]
                },
                {
                    "sense_id": "9283f340-160f-3ad2-a2ca-92ca9a18fb26",
                    "sense_definition": "Pénétrer dans un lieu et l'occuper en grand nombre ou de manière spectaculaire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les manifestants ont pacifiquement <w>investi</w> la place centrale de la capitale."
                        },
                        {
                            "text": "Dès le début de l'été, les touristes <w>investissent</w> les plages de la côte."
                        }
                    ],
                    "synonyms": [
                        "envahir",
                        "occuper"
                    ],
                    "antonyms": [
                        "évacuer",
                        "quitter"
                    ],
                    "common_phrases": [
                        "investir les lieux",
                        "investir la scène"
                    ]
                },
                {
                    "sense_id": "fb78cf08-2194-3c0c-b3b5-54e6df69a65f",
                    "sense_definition": "Encercler militairement une place forte ou un bâtiment pour en empêcher tout accès ou toute sortie.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les forces de l'ordre ont rapidement <w>investi</w> le bâtiment où se cachaient les fugitifs."
                        },
                        {
                            "text": "L'armée a fini par <w>investir</w> la forteresse après plusieurs semaines de siège."
                        }
                    ],
                    "synonyms": [
                        "assiéger",
                        "cerner",
                        "bloquer"
                    ],
                    "common_phrases": [
                        "investir une place",
                        "investir une ville"
                    ]
                },
                {
                    "sense_id": "781fdad5-03af-3752-80fb-7480147eff05",
                    "sense_definition": "Conférer formellement ou légalement à quelqu'un un pouvoir, une autorité, une fonction ou une dignité.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La constitution l'a officiellement <w>investi</w> des pleins pouvoirs en cas d'urgence nationale."
                        },
                        {
                            "text": "Le parlement <w>investira</w> le nouveau chef du gouvernement la semaine prochaine."
                        }
                    ],
                    "synonyms": [
                        "pourvoir",
                        "habiliter"
                    ],
                    "antonyms": [
                        "destituer"
                    ],
                    "common_phrases": [
                        "investir de fonctions",
                        "investir d'un mandat"
                    ]
                }
            ]
        }
    ]
}