                        "examples": [
                            {
                                "example_id": "73c97b9a-b199-4919-a18e-e066ac81d734",
                                "sense_id": "e3a8dd48-6667-378d-9223-2023efd2bd95",
                                "text": "De eerste president van de Verenigde Staten, George Washington, blijkt een boekendief. De president leende in 1789 twee boeken bij de oudste bibliotheek van New York, maar bracht ze nooit meer terug. Dat ontdekten bibliothecarissen die de oude registers van de New York Society Library doorspitten."
                            },
                            {
                                "example_id": "d0d3ae8a-c6b3-4f53-b186-9b9d3b5b49e4",
                                "sense_id": "e3a8dd48-6667-378d-9223-2023efd2bd95",
                                "text": "De 45-jarige boekendief werkte voor het ministerie van Wetenschap van de Duitse deelstaat Hessen en zat in de lokale politiek. De duizenden boeken die hij heeft gestolen, worden de komende weken teruggebracht naar de bibliotheken waar ze vandaan komen."
                            }
                        ]
                    }
