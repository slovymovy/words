                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7c50bc0f-f961-45ba-9309-c6c9866a68c0",
                        "entry_id": "fd154aa3-6cd8-353c-9087-a2d98d6b6e87",
                        "tags": [
