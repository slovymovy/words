                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "e0832e70-fd0b-4398-8153-d8d224ca2357",
                                "sense_id": "b30eddfd-71b9-3f78-bfad-3fb8d02b02ec",
                                "text": "Zelfs hier in dit ziekenhuis, waar lief en vooral leed het hoofdbestanddeel van de dag vormden, hing er een aura van onschendbaarheid en onwereldse zelfverzekerdheid om haar heen."
                            },
                            {
                                "example_id": "61e5b8a5-48dd-4e5b-bb1d-b1a7c0c43459",
                                "sense_id": "b30eddfd-71b9-3f78-bfad-3fb8d02b02ec",
                                "text": "Ik heb altijd een aura om me heen gehad dat bij mannen wantrouwen opwekt, misschien door mijn voor vrouwen ongebruikelijke postuur en een onbeholpen manier van doen die ik mezelf heb aangeleerd doordat de ruimte die mijn brede torso en lange ledematen nodig hebben altijd werd beperkt door mensen die zeker twee of drie koppen kleiner meten dan ik."
                            }
                        ]
                    }
                ],
