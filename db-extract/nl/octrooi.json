                        "entry_id": "d6a2f300-0ac7-3b39-907d-6ddf5baa2730",
                        "glosses": [
                            "machtiging om een bepaalde tijd als enige, met uitsluiting van anderen, van een uitvinding te kunnen profiteren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd09a27b-d4c2-4b69-8288-86d8b6f530dd",
                                "sense_id": "1f447b53-f709-3c23-b913-f4d6d04ef493",
                                "text": "Wie een octrooi aanvraagt, moet tot in detail openbaar maken hoe zijn uitvinding tot stand is gekomen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "481d8607-e690-4d4d-a6cc-07a8d4aa2ead",
                        "source_entry_id": "d6a2f300-0ac7-3b39-907d-6ddf5baa2730",
                        "source_sense_id": "1f447b53-f709-3c23-b913-f4d6d04ef493",
                        "source_sense_description": "machtiging om een bepaalde tijd als enige, met uitsluiting van anderen, van een uitvinding te kunnen profiteren",
                        "target_lang_word": "patent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "patent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cabf4deb-a151-3076-8c77-611dd5052701",
                                        "entry_id": "88d061f6-4c1d-3e77-abc9-eb44f52e4610",
                                        "glosses": [
                                            "An official document granting an appointment, privilege, or right, or some property or title; letters patent."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c4a0455-5107-4203-a66c-7d81256b902a",
                                                "sense_id": "cabf4deb-a151-3076-8c77-611dd5052701",
                                                "text": "[…] Squib proved clearly by his patent that the house and office did now belong to him."
                                            },
                                            {
                                                "example_id": "2d53f547-5d25-4a32-8504-2f0b881b5ce7",
                                                "sense_id": "cabf4deb-a151-3076-8c77-611dd5052701",
                                                "text": "Philip of Spain had offered a reward of 25,000 crowns, a patent of nobility, and immunity for all past crimes, to the assassinator of the Prince of Orange."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d826c817-7e76-3c17-8bbf-087c496415fb",
                                        "entry_id": "88d061f6-4c1d-3e77-abc9-eb44f52e4610",
                                        "glosses": [
                                            "A grant of a monopoly over the manufacture, sale, and use of goods."
                                        ],
                                        "tags": [
                                            "countable",
                                            "specifically",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d19e4742-361b-3310-b453-880fb24dbdde",
                                        "entry_id": "88d061f6-4c1d-3e77-abc9-eb44f52e4610",
                                        "glosses": [
                                            "A declaration issued by a government agency that the inventor of a new invention has the sole privilege of making, selling, or using the claimed invention for a specified period."
                                        ],
                                        "tags": [
                                            "countable",
                                            "specifically",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d60591ad-8e12-4898-9186-2baff6f84f58",
                                                "sense_id": "d19e4742-361b-3310-b453-880fb24dbdde",
                                                "text": "The patent situation, too, played a part in this, as often a firm sought to produce something which would achieve a given result, and yet not infringe a patent held by another; or a railway engineer would think of a device of his own that would free him of obligation to some manufacturer."
                                            },
                                            {
                                                "example_id": "96139e69-514b-4dbb-8ba3-254c3e529d5c",
                                                "sense_id": "d19e4742-361b-3310-b453-880fb24dbdde",
                                                "text": "The solitary, lumbering trolls of Scandinavian mythology would sometimes be turned to stone by exposure to sunlight. Barack Obama is hoping that several measures announced on June 4th will have a similarly paralysing effect on their modern incarnation, the patent troll."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bafc5dac-1336-3704-98bc-156bedbd43b7",
                                        "entry_id": "88d061f6-4c1d-3e77-abc9-eb44f52e4610",
                                        "glosses": [
                                            "A specific grant of ownership of a piece of real property; a land patent."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "337651ca-9c52-3aee-89e0-f6cdfb0e6b7d",
                                        "entry_id": "88d061f6-4c1d-3e77-abc9-eb44f52e4610",
                                        "glosses": [
                                            "A product in respect of which a patent (sense 1.2.2) has been obtained."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2cacac90-9eeb-3484-b106-82bbad7061de",
                                        "entry_id": "88d061f6-4c1d-3e77-abc9-eb44f52e4610",
                                        "glosses": [
                                            "Ellipsis of patent leather (“a varnished, high-gloss leather typically used for accessories and shoes”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e5b6d299-5b13-3045-b353-f49033479393",
                                        "entry_id": "88d061f6-4c1d-3e77-abc9-eb44f52e4610",
                                        "glosses": [
                                            "A licence or (formal) permission to do something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f980eca5-8ffe-4c6e-8758-dea36a79e76c",
                                                "sense_id": "e5b6d299-5b13-3045-b353-f49033479393",
                                                "text": "If you be ſo fond ouer her iniquity, giue her patent to offend, for if it touches not you, it comes neere no body."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10c8b600-db6c-34e3-8085-8d9ab03dcd68",
                                        "entry_id": "88d061f6-4c1d-3e77-abc9-eb44f52e4610",
                                        "glosses": [
                                            "A characteristic or quality that one possesses; in particular (hyperbolic) as if exclusively; a monopoly."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8579199b-1eb0-4183-b900-aa3f232524d9",
                                                "sense_id": "10c8b600-db6c-34e3-8085-8d9ab03dcd68",
                                                "text": "So will I growe, ſo liue, ſo die my Lord, / Ere I will yield my virgin Patent, vp / Vnto his Lordſhippe, whoſe vnwiſhed yoake / My ſoule conſents not to giue ſouerainty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b45b557-c9bb-342d-8aae-85fd9de002c1",
                                        "entry_id": "88d061f6-4c1d-3e77-abc9-eb44f52e4610",
                                        "glosses": [
                                            "The combination of seven bets on three selections, offering a return even if only one bet comes in."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "patent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fff38b91-15ee-3f64-b5a7-474611150154",
                                        "entry_id": "3dd52919-01f5-336e-b579-7a4a0f86a909",
                                        "glosses": [
                                            "To (successfully) register (a new invention) with a government agency to obtain the sole privilege of its manufacture, sale, and use for a specified period."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a127402f-6344-48dd-a8be-1a746ea98aec",
                                                "sense_id": "fff38b91-15ee-3f64-b5a7-474611150154",
                                                "text": "To his great credit, Manson refused to patent his invention, as he desired to remove any obstacle to its adoption by other companies."
                                            },
                                            {
                                                "example_id": "d706c2fa-6ba5-4055-91cf-114d556c2afa",
                                                "sense_id": "fff38b91-15ee-3f64-b5a7-474611150154",
                                                "text": "The US supreme court has ruled unanimously that natural human genes cannot be patented, a decision that scientists and civil rights campaigners said removed a major barrier to patient care and medical innovation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "973eaca2-6d54-3bea-b76a-ef8bff67ef56",
                                        "entry_id": "3dd52919-01f5-336e-b579-7a4a0f86a909",
                                        "glosses": [
                                            "To obtain (over a piece of real property) a specific grant of ownership."
                                        ],
                                        "tags": [
                                            "US",
                                            "historical",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a4f4b747-a350-3ce0-976c-3caff30b0d21",
                                        "entry_id": "3dd52919-01f5-336e-b579-7a4a0f86a909",
                                        "glosses": [
                                            "To be closely associated or identified with (something); to monopolize."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "patent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e04db45f-e9f3-3c97-b4f2-6eab8a651f29",
                                        "entry_id": "de202387-f640-3de0-b719-3946c995e1e9",
                                        "glosses": [
                                            "Conspicuous; open; unconcealed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8e9f067-953d-4e5a-9c59-0b49db8954ed",
                                                "sense_id": "e04db45f-e9f3-3c97-b4f2-6eab8a651f29",
                                                "text": "At the departure of Philip he had received instructions, both patent and secret, for his guidance as stadholder of Holland, Friesland, and Utrecht."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ceb97ac6-cce9-38dc-af13-14da14f46251",
                                        "entry_id": "de202387-f640-3de0-b719-3946c995e1e9",
                                        "glosses": [
                                            "Conspicuous; open; unconcealed.",
                                            "Of flour: fine, and consisting mostly of the inner part of the endosperm of the grain from which it is milled."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "307bd16b-ade7-3d25-af89-7a807c3b9ee3",
                                        "entry_id": "de202387-f640-3de0-b719-3946c995e1e9",
                                        "glosses": [
                                            "Conspicuous; open; unconcealed.",
                                            "Open, unobstructed; specifically, especially of the ductus arteriosus or foramen ovale in the heart, having not closed as would have happened in normal development."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f2124d2-a607-4791-a211-7935575cd4e5",
                                                "sense_id": "307bd16b-ade7-3d25-af89-7a807c3b9ee3",
                                                "text": "She has a patent ductus arteriosus that will require surgery to close."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4387c8c8-10ca-3090-b213-971b88539398",
                                        "entry_id": "de202387-f640-3de0-b719-3946c995e1e9",
                                        "glosses": [
                                            "Conspicuous; open; unconcealed.",
                                            "Of an infection: in the phase when the organism causing it can be detected by clinical tests."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "279bce1c-0bfa-36fc-9221-79b9a5f16d4c",
                                        "entry_id": "de202387-f640-3de0-b719-3946c995e1e9",
                                        "glosses": [
                                            "Explicit and obvious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d64666a-8945-4e70-b554-d5e19af57a79",
                                                "sense_id": "279bce1c-0bfa-36fc-9221-79b9a5f16d4c",
                                                "text": "Those claims are patent nonsense."
                                            },
                                            {
                                                "example_id": "5a14e3f6-aae4-451a-b281-3beb60a55493",
                                                "sense_id": "279bce1c-0bfa-36fc-9221-79b9a5f16d4c",
                                                "text": "Again we read at page 174: “Instead of the Universal Roman Catholic Church there existed after 1650 the National Catholic Churches of Spain, France, Austria, Poland, etc. more subject to the Royal supremacy than to the Papal, not, however, so completely as in England.” This is obviously an exaggeration. There never existed in the countries mentioned, least of all in Spain, any National Catholic Church. There would not have existed any such contradictorially-named organization even in England had it not been for the lechery of Henry VIII. Other similar misstatements might be noticed here and there. The author's intention, however, to be just is patent and his success in this respect is noteworthy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8b8fddf-c802-304d-baad-efacd79651ea",
                                        "entry_id": "de202387-f640-3de0-b719-3946c995e1e9",
                                        "glosses": [
                                            "Especially of a document conferring some privilege or right: open to public perusal or use."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7599e8b7-4aca-4f05-8f03-f5208d5d48a9",
                                                "sense_id": "d8b8fddf-c802-304d-baad-efacd79651ea",
                                                "text": "letters patent"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dec39a7-5b4c-3a71-980f-d8de2bbc5e06",
                                        "entry_id": "de202387-f640-3de0-b719-3946c995e1e9",
                                        "glosses": [
                                            "Appointed or conferred by letters patent."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "666c878b-e2ef-421e-af13-b64913e2fb50",
                                                "sense_id": "3dec39a7-5b4c-3a71-980f-d8de2bbc5e06",
                                                "text": "[H]e did at last think of an office which do belong to him in case the King do restore every man to his places that ever had been patent, which is to be one of the clerks of the signet, which will be a fine employment for one of his sons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd571fd7-934a-3f94-bdac-ff60da9862ee",
                                        "entry_id": "de202387-f640-3de0-b719-3946c995e1e9",
                                        "glosses": [
                                            "Of a branch, leaf, etc.: outspread; also, spreading at right angles to the axis."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4eba0bbf-82b7-34d3-9bae-508c204527c1",
                                        "entry_id": "de202387-f640-3de0-b719-3946c995e1e9",
                                        "glosses": [
                                            "Protected by a legal patent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02319b09-fe8f-4194-93c1-f968c136c102",
                                                "sense_id": "4eba0bbf-82b7-34d3-9bae-508c204527c1",
                                                "text": "a patent right    patent medicines"
                                            },
                                            {
                                                "example_id": "8fbaf6ef-2a82-41d9-8f20-0a0b78f7cfd3",
                                                "sense_id": "4eba0bbf-82b7-34d3-9bae-508c204527c1",
                                                "text": "Madder is eſteemed a very rich Commodity, and what will turn to good profit; ſo that in King Charles I's Time it was made a Patent Commodity."
                                            },
                                            {
                                                "example_id": "eb78277d-1ca7-40d6-880d-8a65e41bbd11",
                                                "sense_id": "4eba0bbf-82b7-34d3-9bae-508c204527c1",
                                                "text": "[H]e took up an old newspaper; / The paper was right easy to peruse; / He read an article the king attacking, / And a long eulogy of \"Patent Blacking.\""
                                            },
                                            {
                                                "example_id": "133f2ea5-bc73-465e-8054-4e422ccb89dd",
                                                "sense_id": "4eba0bbf-82b7-34d3-9bae-508c204527c1",
                                                "text": "\"Yes, I have a pair of eyes,\" replied Sam, \"and that's just it. If they wos a pair o' patent double million magnifyin' gas microscopes of hextra power, p'raps I might be able to see through a flight o' stairs and a deal door; but bein' only eyes you see, my wision's limited.\""
                                            },
                                            {
                                                "example_id": "f65fa215-ab76-45a7-87fb-5d2e6e7354ee",
                                                "sense_id": "4eba0bbf-82b7-34d3-9bae-508c204527c1",
                                                "text": "There, were also a small mouse-trap; a patent corkscrew, too good to be used in common; fragments of a silver tea-spoon, that had, by natural decay, arrived at a dissolution of its parts; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b10df6d-af03-3fdd-b3d5-38b6da534120",
                                        "entry_id": "de202387-f640-3de0-b719-3946c995e1e9",
                                        "glosses": [
                                            "To which someone has, or seems to have, a claim or an exclusive claim; also, inventive or particularly suited for."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "202309c6-434a-44f6-b981-eb1d15523329",
                                                "sense_id": "0b10df6d-af03-3fdd-b3d5-38b6da534120",
                                                "text": "[\"]Ben, my fine fellow, put your hand into the cupboard, and bring out the patent digester.\" Mr. Benjamin Allen smiled his readiness, and produced from the closet at his elbow a black bottle half full of brandy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
