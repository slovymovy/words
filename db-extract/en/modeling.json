                                        "entry_id": "98e3ca12-3ede-346d-97a3-4dc8f00e5d37",
                                        "glosses": [
                                            "Entwicklung, Formung oder Herstellung eines Modells"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fb42862-7a9f-4842-a5b9-5a9c5b15d81a",
                                                "sense_id": "721c72d7-71a8-3267-92f9-0eeb563a8d25",
                                                "text": "Wenn etwas neu entwickelt werden soll, ist die Modellierung des geplanten Gegenstands ein guter Zwischenschritt."
                                            },
                                            {
                                                "example_id": "c776e757-9376-40be-874e-406d5c242e78",
                                                "sense_id": "721c72d7-71a8-3267-92f9-0eeb563a8d25",
                                                "text": "Modellierungen sind gute Maßnahmen, um einen Sachverhalt besser zu durchschauen."
                                            },
                                            {
                                                "example_id": "c9d38dee-d178-4e81-a211-68a02589e913",
                                                "sense_id": "721c72d7-71a8-3267-92f9-0eeb563a8d25",
                                                "text": "„Unter den Grundsätzen ordnungsmäßiger Modellierung werden zwei Aspekte subsumiert: Ziele und Modellierungskonventionen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
