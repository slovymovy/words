                {
                    "sense_id": "a64b58b2-9bf1-3efc-a437-c865b5d42573",
                    "sense_definition": "The intensity or degree of a force, power, or feeling.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>strength</w> of the wind increased significantly during the storm.",
