                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2799dfb7-0ce2-46d2-a365-7a506dd2d4e1",
                                "sense_id": "6ce9f102-9631-344c-9009-7f25c447ab98",
                                "text": "„Gelegentlich können nächtliche Panikattacken bei Patienten mit Panikstörung dem Pavor ähneln.“"
                            },
                            {
                                "example_id": "25d2a6d8-c604-4437-85cc-f0dafe0a74cb",
                                "sense_id": "6ce9f102-9631-344c-9009-7f25c447ab98",
                                "text": "„Der Pavor (lateinisch die Angst) oder der Angor (lateinisch die Beklemmung, vergleiche Angina) ist eine Form der Schlafstörung, eine Parasomnie, die vorwiegend Klein- und Schulkinder betrifft, aber auch Erwachsene ein Leben lang begleiten kann. Sie kann nach dem zeitlichen Auftreten in zwei Formen unterteilt werden: der Pavor nocturnus ist die Nachtangst, der Pavor diurnus ist die Tagangst (Form beim Mittagsschlaf).“"
                            }
                        ],
