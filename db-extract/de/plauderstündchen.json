                            {
                                "example_id": "8da2f539-0a7f-4a25-8394-b26877ecaa02",
                                "sense_id": "e46a4be5-189d-37f3-8f16-80cbbbea048c",
                                "text": "„›Die Deutschen hatten einen besonders tüchtigen Burschen in Prag sitzen. Es gelang uns, ihn zu einem Plauderstündchen in den Westen zu schaffen.‹“"
                            },
                            {
                                "example_id": "ff719e63-a823-42c8-9deb-53cbbb8b97a6",
                                "sense_id": "e46a4be5-189d-37f3-8f16-80cbbbea048c",
                                "text": "„Bei diesen Operationen hatte er keine Zeit gefunden und auch gar nicht die Kontaktmöglichkeiten gehabt für ein Plauderstündchen mit der örtlichen Intelligenzija oder den Reichen und Schönen.“"
                            }
                        ],
