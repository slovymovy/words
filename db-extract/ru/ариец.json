                    },
                    {
                        "translation_id": "6f916ed3-c8f4-4406-9059-06e49f5deb53",
                        "source_entry_id": "262627e1-b296-3263-a450-b9219ed81a3e",
                        "target_lang_word": "Arier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e612647-f1ae-3a5e-97fc-bb0653354ea0",
                                        "entry_id": "010a4083-d75f-376f-a5aa-ff855d00e1d2",
                                        "glosses": [
                                            "Selbstbezeichnung mehrerer Volksgruppen in Vorder- und Mittelasien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10462218-d80e-425e-97ce-3e9be8e1a4d8",
                                                "sense_id": "7e612647-f1ae-3a5e-97fc-bb0653354ea0",
                                                "text": "„Der Begriff \"Iran\" leitet sich vom mittelpersischen \"eran\" ab. \"Eran Shahr\" meint das \"Land der Arier\" und geht auf den Nomadenstamm der Arier zurück, der etwa 1000 v. Chr. in das persische Hochland eingewandert ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "216f4f2a-c82f-3f73-aab5-a2afbb9f3236",
                                        "entry_id": "010a4083-d75f-376f-a5aa-ff855d00e1d2",
                                        "glosses": [
                                            "Bezeichnung für Menschen mit körperlichen Merkmalen, die unter Anhängern der Rassentheorie als besonders edel galten"
                                        ],
                                        "tags": [
                                            "Nationalsozialismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adc8d08b-3e72-45e5-ba7c-e289e7eb5fa1",
                                                "sense_id": "216f4f2a-c82f-3f73-aab5-a2afbb9f3236",
                                                "text": "Die Nationalsozialisten sahen sich als Arier und betrachteten alle anderen Völker als minderwertig."
                                            },
                                            {
                                                "example_id": "3d0a93fa-bead-4dd4-bf78-81c2b501ba31",
                                                "sense_id": "216f4f2a-c82f-3f73-aab5-a2afbb9f3236",
                                                "text": "„War der Begriff Arier zunächst nur als Bezeichnung einer Sprachgruppe gedacht gewesen, so wurde daraus nun eine volkliche Urrasse konstruiert.“"
                                            },
                                            {
                                                "example_id": "82507672-473d-4476-ad0d-03fe1c0da032",
                                                "sense_id": "216f4f2a-c82f-3f73-aab5-a2afbb9f3236",
                                                "text": "„Gleichzeitig mit dem Ausdruck \"Arier\" waren — ebenfalls aus der Sprachwissenschaft — die Termini “Indogermanen\" und \"Semiten\" als Namen für Völkergruppen, die bald auch als Rassen verstanden wurden, übernommen worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "60f242be-f374-3307-a845-4485c70490f8",
                                        "entry_id": "010a4083-d75f-376f-a5aa-ff855d00e1d2",
                                        "glosses": [
                                            "Angehöriger der indoiranischen Sprachgruppe"
                                        ],
                                        "tags": [
                                            "Sprachwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35cb2779-abee-418e-94a4-a7615eaf1386",
                                                "sense_id": "60f242be-f374-3307-a845-4485c70490f8",
                                                "text": "„Der Begriff \"Indogermane\" ist ein linguistisches Vergleichskonstrukt und \"Arier\" ist eine Selbstbezeichnung indoeuropäischer Sprecher im Raum Persien; alle rassistischen und kulturhistorischen Konstrukte, die auf diesen Begriffen aufbauen wollen, sind wissenschaftlich unseriös.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
