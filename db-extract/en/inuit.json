                    {
                        "translation_id": "51505937-28a7-4916-b5d3-abb3b4e4e14a",
                        "source_entry_id": "3d79d6c4-1b14-30b0-993e-51f91ac93528",
                        "source_sense_id": "9f12aa2a-5272-3c9e-9175-8366f38e0bf2",
                        "source_sense_description": "of or pertaining to Inuit people, language, or culture",
                        "target_lang_word": "inuit",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inuit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0bd47f85-1212-35dd-ba0d-b39801e6007e",
                                        "entry_id": "0d174ac1-81db-33ef-9683-bc1db81ca272",
                                        "glosses": [
                                            "Se dit du peuple des Inuit, qui vivent dans l’Arctique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d1a916f-c0a8-4e89-9bba-a7e9c37f7453",
                                                "sense_id": "0bd47f85-1212-35dd-ba0d-b39801e6007e",
                                                "text": "Mais souvent, elles ne parlent pas suffisamment français ou anglais pour se débrouiller, ou encore leur éducation ne leur permet même pas de se trouver un emploi dans une organisation inuite."
                                            },
                                            {
                                                "example_id": "ac268ce9-ef31-4afe-a85b-53895cae6f18",
                                                "sense_id": "0bd47f85-1212-35dd-ba0d-b39801e6007e",
                                                "text": "« On n’a aucune infirmière inuite, aucun prof d’anglais ou de français inuit, aucun comptable, architecte inuit, etc. Et je ne crois pas qu’on soit prêt d’en avoir. Les Blancs occupent ces postes. »"
                                            },
                                            {
                                                "example_id": "0554bd1a-cbcf-4b0a-a5db-fa805b8f0c3e",
                                                "sense_id": "0bd47f85-1212-35dd-ba0d-b39801e6007e",
                                                "text": "La zone marine protégée de Tuvaijuittuq résulte d’un partenariat entre le gouvernement fédéral et l’Association Inuit Qikiqtani (QIA) qui pense qu’il est primordial de récolter davantage de connaissance inuite sur la région."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inuit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "38cb1ce8-ef33-370f-92fe-a6bd13905e1c",
                                        "entry_id": "72152356-e0a4-3935-803d-7acf0be2c09f",
                                        "glosses": [
                                            "Langue des Inuit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54b437f4-7529-4aae-8a92-7d5ea727726d",
                                                "sense_id": "38cb1ce8-ef33-370f-92fe-a6bd13905e1c",
                                                "text": "Le Nord est le domaine de l’inuit, seul représentant au Canada de la famille esquimau-aléoute. De l’Alaska au Groenland, l’inuit se décline en 16 dialectes, parlés par environ 65 000 personnes."
                                            },
                                            {
                                                "example_id": "11d9cc5a-1398-4bb1-9921-2b78be4d325d",
                                                "sense_id": "38cb1ce8-ef33-370f-92fe-a6bd13905e1c",
                                                "text": "M. Lowe explique que l’inuit se parlait déjà 5000 ans avant le latin et que sa structure est complètement différente de toutes les autres langues du monde."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inuit",
                                "target_lang_code": "fr",
