                            "South-German"
                        ],
                        "examples": [
                            {
                                "example_id": "899c337b-e38b-44c3-bccd-e8cc2a0ceaa7",
                                "sense_id": "cccc2a47-95bd-3347-ae9a-c1a095ea92e0",
                                "text": "„Die Metzgerpalme ist ein immergrüner Strauch mit gelb gefleckten Blättern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "aad3a54e-ca73-36da-948c-6019cc99b4c8",
                        "entry_id": "0d1bb9a4-328a-3a95-92f5-328d6ff38078",
                        "glosses": [
                            "die Schusterpalme, eine Zimmerpflanze, eine Gattung aus der Familie der Spargelgewächse"
                        ],
                        "tags": [
                            "South-German"
                        ],
                        "examples": [
                            {
                                "example_id": "70ef6df9-1feb-4fdc-8181-38682b520c30",
                                "sense_id": "aad3a54e-ca73-36da-948c-6019cc99b4c8",
                                "text": "„Der Name Schuster- oder auch Metzgerpalme stammt noch aus früheren Zeiten: Als diese Pflanze nämlich fester Bestandteil jeder schummrigen Schusterwerkstatt war und auch auf fast jeder Schlachtertheke stand.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
