        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ed463b7b-dfb6-36d2-8ddb-a9892864de9f",
                    "sense_definition": "Developed after birth; not congenital.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor confirmed that the patient's condition was <w>acquired</w> rather than inherited.",
                            "target_lang_translations": {
                                "ru": "Врач подтвердил, что заболевание пациента было <w>приобретённым</w>, а не наследственным.",
                                "zh": "医生证实病人的病情是<w>后天</w>形成的，而非遗传的。",
                                "nl": "De arts bevestigde dat de aandoening van de patiënt <w>verworven</w> was in plaats van erfelijk."
                            }
                        },
                        {
                            "text": "Strong black coffee is often considered an <w>acquired</w> taste.",
                            "target_lang_translations": {
                                "ru": "Крепкий чёрный кофе часто считают <w>приобретённым</w> вкусом (тем, к чему нужно привыкнуть).",
                                "zh": "浓黑咖啡通常被认为是一种需要<w>后天</w>培养才能习惯的口味。",
                                "nl": "Sterke zwarte koffie wordt vaak beschouwd als een <w>aangeleerde</w> smaak."
                            }
                        }
                    ],
                    "synonyms": [
                        "non-hereditary",
                        "learned"
                    ],
                    "antonyms": [
                        "congenital",
                        "innate",
                        "inherited"
                    ],
                    "common_phrases": [
                        "acquired taste",
                        "acquired immunity",
                        "acquired trait"
                    ],
                    "target_lang_definitions": {
                        "ru": "Развившийся после рождения или в течение жизни; не врождённый.",
                        "zh": "指后天形成的，而非先天遗传的。",
                        "nl": "Na de geboorte ontwikkeld; niet aangeboren."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приобретённый",
                                "target_lang_sense_clarification": "полученный в результате развития или опыта, не наследственный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "后天的",
