                    {
                        "sense_id": "f8a3380a-dc02-393d-82fc-767b7fb6512f",
                        "entry_id": "bddb75a4-5b9c-3ffa-aded-b18dfe4bcf25",
                        "glosses": [
                            "Élément chimique synthétique portant le numéro atomique 111 et de symbole Rg, synthétisé pour la première fois en 1994, appartenant à la série chimique des métaux de transition."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1bffd01d-925e-4792-a76d-11a4ff79de12",
                                "sense_id": "f8a3380a-dc02-393d-82fc-767b7fb6512f",
                                "text": "Prédit de longue date par Dmitri Mendeleïev qui l’avait baptisé provisoirement « éka-or » (car situé une case sous l’or dans le tableau périodique), le roentgenium a été obtenu pour la première fois en 1994 au centre de recherche sur les ions lourds de Darmstadt, par l’équipe de Peter Armbruster et Gottfried Münzenberg, sous la direction de Siaurd Hofmann (né en 1944)."
                            }
                        ]
                    },
                    {
                        "sense_id": "21128f76-0726-33a2-922b-2af43d915ec4",
                        "entry_id": "bddb75a4-5b9c-3ffa-aded-b18dfe4bcf25",
                        "glosses": [
                            "Métal pur de cet élément."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "eb0efd2b-d63f-34af-b35b-3905595f8c72",
                        "entry_id": "bddb75a4-5b9c-3ffa-aded-b18dfe4bcf25",
                        "glosses": [
                            "Atome (ou, par ellipse, noyau) de roentgenium."
                        ],
                        "tags": [
                            "Chimie physique"
                        ],
                        "examples": [
                            {
                                "example_id": "ee0b04a4-5d91-4f58-9eba-23bb4d642c54",
                                "sense_id": "eb0efd2b-d63f-34af-b35b-3905595f8c72",
                                "text": "Trois roentgeniums furent créés le 8 décembre 1994, tous ²⁷²Rg."
                            }
                        ]
                    }
                ],
