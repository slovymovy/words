                    {
                        "translation_id": "d463eff2-fb2b-455c-8c27-d856e07bec11",
                        "source_entry_id": "a03a478c-d9db-33b8-8825-90666cf22cfb",
                        "source_sense_id": "fd0fbd3d-c5ae-32b5-b6dc-35dc646e0ff3",
                        "target_lang_word": "optogenetics",
