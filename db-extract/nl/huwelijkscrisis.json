                        "examples": [
                            {
                                "example_id": "06c13d35-2076-4c18-9bd7-108b0650faa9",
                                "sense_id": "875754d8-68cf-365c-84ba-bf0f6225f593",
                                "text": "Intussen zitten Cherry Jones en Emily Mortimer als lesbisch echtpaar midden in een huwelijkscrisis. Volop aanleiding voor Janets beste vriendin om haar scherpe tong te roeren."
                            },
                            {
                                "example_id": "f56bd355-1474-4ac4-895b-348513629d62",
                                "sense_id": "875754d8-68cf-365c-84ba-bf0f6225f593",
                                "text": "Billy Ray en Tish Cyrus hebben besloten toch bij elkaar te blijven. De scheidingsaanvraag van het stel is ingetrokken, zo weet ENews. De ouders van onder andere Miley en Noah Cyrus gingen twee keer eerder door een huwelijkscrisis."
                            }
