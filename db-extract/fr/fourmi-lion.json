                        "sense_id": "c9b8b294-a9e1-326b-a07c-64105797ff48",
                        "entry_id": "18a28758-86cd-32ad-a079-1d50e61f6ca8",
                        "glosses": [
                            "Insecte névroptère dont l’aspect adulte rappelle les libellules et dont les larves de beaucoup d'espèces creusent un trou en forme d’entonnoir pour piéger des insectes (fourmis surtout)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "666a5f17-e174-410d-ac26-f72e3e0a84c2",
                                "sense_id": "c9b8b294-a9e1-326b-a07c-64105797ff48",
                                "text": "Plusieurs jours s’étaient écoulés depuis sa dernière venue ; déjà dans le sable non foulé, les fourmis-lions avaient creusé leurs petits entonnoirs."
                            }
                        ]
                    }
                ],
