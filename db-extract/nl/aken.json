                "forms": [
                    {
                        "form_id": "e123c942-eeaa-46f4-9cfc-c386f66513fa",
                        "entry_id": "6ebf6ce6-974c-310e-a5e8-d307c3adca0f",
                        "tags": [
                            "possessive"
                        ],
                        "form": "Akens"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "64be7649-ff8e-3db9-8553-37ba4d8af2d2",
                        "entry_id": "6ebf6ce6-974c-310e-a5e8-d307c3adca0f",
                        "glosses": [
                            "een stad in de Duitse deelstaat Noord-Rijnland-Westfalen"
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "3fa93fe1-f990-48f4-9cee-dec7c69978de",
                                "sense_id": "64be7649-ff8e-3db9-8553-37ba4d8af2d2",
                                "text": "Aken ligt dicht bij de Nederlandse grens."
                            },
                            {
                                "example_id": "f3602bab-c525-45f6-8003-a38dbbffa694",
                                "sense_id": "64be7649-ff8e-3db9-8553-37ba4d8af2d2",
                                "text": "Ik moet de route naar Aken nog even opzoeken met de routeplanner."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5503aeb0-7cbc-4857-9f1a-86df3e7c3a8d",
                        "source_entry_id": "6ebf6ce6-974c-310e-a5e8-d307c3adca0f",
                        "source_sense_id": "64be7649-ff8e-3db9-8553-37ba4d8af2d2",
                        "source_sense_description": "een stad in de Duitse deelstaat Noord-Rijnland-Westfalen, niet ver van Maastricht",
                        "target_lang_word": "Aachen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aachen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "66664c32-3678-3433-9fc8-da1d529e0080",
                                        "entry_id": "ddb4f84c-9964-3761-9ddd-ef516299cefd",
                                        "glosses": [
                                            "Stadt in Nordrhein-Westfalen, Deutschland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b65ba33d-d25c-466b-9c24-ac1b9c9f0e78",
                                                "sense_id": "66664c32-3678-3433-9fc8-da1d529e0080",
                                                "text": "Aachen ist die westlichste deutsche Großstadt."
                                            },
                                            {
                                                "example_id": "b5da24a1-dad0-4005-870a-bd674dbc712d",
                                                "sense_id": "66664c32-3678-3433-9fc8-da1d529e0080",
                                                "text": "„Die Printe ist schon deshalb der Inbegriff der regionalen Spezialität, weil außerhalb Aachens lange niemand etwas mit ihr anfangen konnte. Nur die Aachener, so schien es, liebten diese brettharten Gewürzschnitten, und das nicht nur zur Weihnachtszeit.“"
                                            },
                                            {
                                                "example_id": "99129304-94bd-4dcc-b37d-5aed11ef065e",
                                                "sense_id": "66664c32-3678-3433-9fc8-da1d529e0080",
                                                "text": "„Die Beute, die die fränkischen Heere im Reich der Awaren machten, war so groß, daß drei Transporte notwendig waren, um sie nach Aachen zu bringen.“"
                                            },
                                            {
                                                "example_id": "db247e80-5960-4ce4-a1d8-59324677ae63",
                                                "sense_id": "66664c32-3678-3433-9fc8-da1d529e0080",
                                                "text": "„Die Mutter erklärte mir wütend, sie wolle mit ihrer Tochter nach Bologna zurückkehren; um sie zu besänftigen, versprach ich ihr, sie nach unserer Reise nach Aachen selbst dorthin zu bringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Aachen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74a5104f-4b33-3f3a-b018-109749d5fefb",
                                        "entry_id": "2871f26d-0ca3-3b0c-a7d2-28dfb9f1e08e",
                                        "glosses": [
                                            "unterdurchschnittlich häufig auftretender, deutschsprachiger Familienname, Nachname (häufigstes Vorkommen in Deutschland in den Städten Bonn und Köln in Nordrhein-Westfalen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "865bf1c4-ab9c-46a2-9ab7-c5b5664b4878",
                                                "sense_id": "74a5104f-4b33-3f3a-b018-109749d5fefb",
                                                "text": "Herr Aachen ist begeisterter Anhänger von Haydn."
                                            },
                                            {
                                                "example_id": "e8deab43-76b3-422e-a2fd-3e34224d4869",
                                                "sense_id": "74a5104f-4b33-3f3a-b018-109749d5fefb",
                                                "text": "Das Haus der Aachens wurde verkauft."
                                            },
                                            {
                                                "example_id": "9c2fbe8d-57ce-4f45-a636-93b6f09e979c",
                                                "sense_id": "74a5104f-4b33-3f3a-b018-109749d5fefb",
                                                "text": "Herr Aachen wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "1affafdf-59e4-4805-946a-7d5917228b5d",
                                                "sense_id": "74a5104f-4b33-3f3a-b018-109749d5fefb",
                                                "text": "Im ersten Obergeschoss bitte bei Frau Aachen klingeln."
                                            },
                                            {
                                                "example_id": "607724d6-0cfa-4828-8650-45093ce32274",
                                                "sense_id": "74a5104f-4b33-3f3a-b018-109749d5fefb",
                                                "text": "Die Aachens fliegen heute nach Sri Lanka."
                                            },
                                            {
                                                "example_id": "853c9f63-3af5-447e-8ca5-7b27392fb4ba",
                                                "sense_id": "74a5104f-4b33-3f3a-b018-109749d5fefb",
                                                "text": "Der Aachen trägt nie die Pullover, die die Aachen ihm strickt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
