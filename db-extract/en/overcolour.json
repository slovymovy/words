                        "sense_id": "a34d91a6-f777-3353-a184-4b8bd8483c04",
                        "entry_id": "cf0ce082-7c80-37fa-a55a-4d86dd288ec4",
                        "glosses": [
                            "To exaggerate."
                        ],
                        "tags": [
                            "figuratively",
