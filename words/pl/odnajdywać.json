                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "turn up",
                                "target_lang_sense_clarification": "to be found or reappear unexpectedly"
                            },
                            {
                                "target_lang_word": "show up",
                                "target_lang_sense_clarification": "to appear after missing"
                            }
                        ]
                    }
                }
