                    }
                ],
                "senses": [
                    {
                        "sense_id": "bf921a87-31ee-34ba-b787-2eb26053ba63",
                        "entry_id": "ebba1acc-af1f-3282-ad48-383436617ada",
                        "glosses": [
                            "Dans l’Antiquité grecque puis hellénistique, soldat de l’infanterie légère, initialement protégé par une pelte, petit bouclier en forme de croissant."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "6b6d14bf-95a9-4929-b45d-7fd474ec056e",
                                "sense_id": "bf921a87-31ee-34ba-b787-2eb26053ba63",
                                "text": "Outre ce manque complet de toute représentation attique du peltaste au type d’Iphicrate, l’épigraphie s’avère sans recours."
                            },
                            {
                                "example_id": "5a28142e-0564-4284-9003-e90b9b117c7a",
                                "sense_id": "bf921a87-31ee-34ba-b787-2eb26053ba63",
                                "text": "Entretemps, l'évolution de la guerre du Péloponnèse avait amené la création d’armées permanentes d’hoplites puis, un peu plus tard, de fantassins légers, les peltastes."
                            },
                            {
                                "example_id": "1732e67e-f9ba-40e9-936b-2f3f9d37fc94",
                                "sense_id": "bf921a87-31ee-34ba-b787-2eb26053ba63",
                                "text": "Les peltastes sont recrutés au départ dans les cités grecques de la côte de Thrace puis ils viennent plus tard d'horizons plus variés."
                            }
                        ]
                    }
                ],
