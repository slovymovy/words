                        "mutiler",
                        "enlaidir"
                    ],
                    "antonyms": [
                        "embellir"
                    ],
                    "common_phrases": [
                        "défigurer le visage",
                        "défigurer le paysage"
                    ]
                },
                {
                    "sense_id": "bd9156a3-4401-3506-92b8-97fe7440e7ac",
                    "sense_definition": "Dénaturer ou fausser profondément le sens, la forme ou l'esprit d'une pensée, d'une œuvre ou d'une vérité.",
