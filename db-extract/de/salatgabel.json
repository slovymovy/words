                ],
                "senses": [
                    {
                        "sense_id": "a57da7c6-b288-3047-84ba-12a0f3a946fd",
                        "entry_id": "acad7df1-96d2-3012-93af-c6a51e085644",
                        "glosses": [
                            "besondere Gabel zum Verzehr von Salaten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad66b8fb-7803-4fd2-87a3-6a10708dbe87",
                                "sense_id": "a57da7c6-b288-3047-84ba-12a0f3a946fd",
                                "text": "„Die Spaghettizange von Magisso kann auseinandergenommen werden und wird so zur Salatgabel oder zum Kochlöffel.“"
                            },
                            {
                                "example_id": "ac76f4cd-c793-4c7e-b6fb-5d66dcc1842e",
                                "sense_id": "a57da7c6-b288-3047-84ba-12a0f3a946fd",
                                "text": "„Das sie lange Zeit umstritten war, mag angesichts der Tatsache, dass wir sie mittlerweile als Kuchengabel, Fischgabel, Pommesgabel, Salatgabel, Fleischgabel und Cocktailgabel kennen, zwar erstaunen, doch zum Essen benutzte man lieber, wie in weiten Teilen der Welt nach wie vor üblich, die Finger.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
