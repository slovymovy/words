                                "sense_id": "a6f23029-aa11-3d48-8e0d-22ba49ba2032",
                                "text": "Idiosyncrasie tegen melk."
                            }
                        ]
                    },
                    {
                        "sense_id": "379328f3-4611-3bc6-b118-bb24e2137d08",
                        "entry_id": "3e3be41e-f9db-3883-b5c7-fe60e474b756",
                        "glosses": [
                            "kenmerkende eigenaardigheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f453b655-a13a-4d21-9e56-fd309a2ec3c6",
                                "sense_id": "379328f3-4611-3bc6-b118-bb24e2137d08",
                                "text": "Met behulp van de pioniers moest en zou de N.E.F. er uiteindelijk in slagen om de idiosyncrasie van de volkeren en haar interne heterogeniteit te overstijgen."
                            }
                        ]
                    }
                ],
