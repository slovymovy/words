                ],
                "senses": [
                    {
                        "sense_id": "b72e0b88-ac06-315d-8f3a-f4aa55a9d7ea",
                        "entry_id": "92213daa-2b03-37a0-bf06-540f1388e824",
                        "glosses": [
                            "schwarzer Kittel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed42974f-b4ea-43ff-8d25-e588dd5707d8",
                                "sense_id": "b72e0b88-ac06-315d-8f3a-f4aa55a9d7ea",
                                "text": "Der Meister trägt nun einen teuren Schwarzkittel bei der Arbeit."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7c704658-f1ca-3dab-a971-feedb6e585c5",
                        "entry_id": "92213daa-2b03-37a0-bf06-540f1388e824",
                        "glosses": [
                            "Person, die einen schwarzen Kittel trägt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38436cb6-f74b-4147-9ed7-8b5cbe81ee1f",
                                "sense_id": "7c704658-f1ca-3dab-a971-feedb6e585c5",
                                "text": "Als wir in die Stadt kamen, begegneten uns allerhand dubiose Schwarzkittel."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "b2211669-434e-37cd-9e90-78cb3616ea99",
                        "entry_id": "92213daa-2b03-37a0-bf06-540f1388e824",
                        "glosses": [
                            "Jägersprache, Wildschwein"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "d92761d4-5f02-469c-b439-f0bdd299ce16",
                                "sense_id": "b2211669-434e-37cd-9e90-78cb3616ea99",
                                "text": "„Solange sich die Schwarzkittel im Wald aufhalten, führt das in der Regel zu keinen Konflikten.“"
                            },
                            {
                                "example_id": "2693c5ba-bc9a-4cb4-9d33-6b8219fab595",
                                "sense_id": "b2211669-434e-37cd-9e90-78cb3616ea99",
                                "text": "„Obschon es viele Wildschweine hier gibt, sind die Chancen, die Schwarzkittel zu Gesicht zu bekommen, eher gering.“"
                            },
                            {
                                "example_id": "985fe35f-4c90-40fa-8c6f-a747a56f178e",
                                "sense_id": "b2211669-434e-37cd-9e90-78cb3616ea99",
                                "text": "Im Saarland wurden 2017 mit mehr als 9000 Wildschweinen so viele Schwarzkittel wie noch nie erlegt."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "76399e41-9eea-3ed1-9ade-ff6b4b5be6ca",
                        "entry_id": "92213daa-2b03-37a0-bf06-540f1388e824",
                        "glosses": [
                            "(katholischer) Geistlicher"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "9a83a60d-ab50-42ba-a6ba-c4652f091be1",
                                "sense_id": "76399e41-9eea-3ed1-9ade-ff6b4b5be6ca",
                                "text": "„Bei dem immer größer werdenden Priestermangel ist man halt auf jeden Schwarzkittel angewiesen.“"
                            },
                            {
                                "example_id": "76a12369-dfc9-44d6-9250-c4ac512a987a",
                                "sense_id": "76399e41-9eea-3ed1-9ade-ff6b4b5be6ca",
                                "text": "„‚Heutzutage, mein Sohn, sind in Spanien die Geistlichen diejenigen, die die beste Zukunft vor sich haben, besonders wenn einflußreiche Gönner hinter ihnen stehen. Jeden Tölpel aus der niedersten Schicht läßt man in den besten Familien zu, wenn er nur ein Schwarzkittel ist.‘“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "490b7d81-96c1-3736-8f67-f14377d3442b",
                        "entry_id": "92213daa-2b03-37a0-bf06-540f1388e824",
                        "glosses": [
                            "Schiedsrichter"
                        ],
                        "tags": [
                            "vor allem Fußballjargon"
                        ],
                        "examples": [
                            {
                                "example_id": "3ee435ab-bc90-45a0-83d5-f6dde0a4f72e",
                                "sense_id": "490b7d81-96c1-3736-8f67-f14377d3442b",
                                "text": "„Weiterhin hat er sich als Schwarzkittel, nämlich Schiedsrichter, einen Namen in den Amateurklassen des hessischen Fußballs gemacht.“"
                            }
                        ],
                        "sense_index_json": "\"5\""
                    }
