{
    "word_family": [
        "leed",
        "wezen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f52dc560-a0d7-3ce3-ac4b-0372c2ad5af7",
                    "sense_definition": "Een gevoel van diepe droefheid of smart.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij kon haar <w>leedwezen</w> over het verlies nauwelijks verbergen.",
                            "target_lang_translations": {
                                "en": "She could barely hide her <w>sorrow</w> over the loss."
                            }
                        },
                        {
                            "text": "Het <w>leedwezen</w> was groot na het slechte nieuws.",
                            "target_lang_translations": {
                                "en": "The <w>grief</w> was great after the bad news."
                            }
                        }
                    ],
                    "synonyms": [
                        "verdriet",
                        "smart"
                    ],
                    "antonyms": [
                        "vreugde"
                    ],
                    "common_phrases": [
                        "groot leedwezen"
                    ],
                    "target_lang_definitions": {
                        "en": "A feeling of deep sadness or sorrow."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sorrow",
                                "target_lang_sense_clarification": "Deep distress or sadness, often associated with loss."
                            },
                            {
                                "target_lang_word": "grief",
                                "target_lang_sense_clarification": "Intense sorrow, especially caused by someone's death."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38f7115b-09a2-3e8d-bea7-503e500e6248",
                    "sense_definition": "Een gevoel van spijt of berouw over iets dat is gebeurd.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tot mijn grote <w>leedwezen</w> kon ik niet bij de bruiloft aanwezig zijn.",
                            "target_lang_translations": {
                                "en": "To my great <w>regret</w>, I could not attend the wedding."
                            }
                        },
                        {
                            "text": "Hij sprak met oprecht <w>leedwezen</w> over zijn gemaakte fouten.",
                            "target_lang_translations": {
                                "en": "He spoke with sincere <w>remorse</w> about the mistakes he had made."
                            }
                        }
                    ],
                    "synonyms": [
                        "spijt",
                        "berouw"
                    ],
                    "common_phrases": [
                        "tot mijn leedwezen"
                    ],
                    "target_lang_definitions": {
                        "en": "A feeling of regret or remorse about something that has happened."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "regret",
                                "target_lang_sense_clarification": "A feeling of sadness or disappointment over something that has happened or been done."
                            },
                            {
                                "target_lang_word": "remorse",
                                "target_lang_sense_clarification": "Deep regret or guilt for a wrong committed."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b67656c-2c86-36f0-bc9d-9e9a1e2f8e3a",
                    "sense_definition": "Het betuigen van medeleven bij iemands overlijden.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is met groot <w>leedwezen</w> dat wij kennisnamen van zijn overlijden.",
                            "target_lang_translations": {
                                "en": "It is with great <w>sadness</w> that we learned of his passing."
                            }
                        },
                        {
                            "text": "De directie betuigde haar <w>leedwezen</w> aan de nabestaanden.",
                            "target_lang_translations": {
                                "en": "The management expressed its <w>condolences</w> to the bereaved family."
                            }
                        }
                    ],
                    "synonyms": [
                        "medeleven",
                        "condoleance"
                    ],
                    "common_phrases": [
                        "met groot leedwezen"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Wordt vaak in formele of officiële contexten gebruikt."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The expression of sympathy or condolences upon someone's death."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "condolences",
                                "target_lang_sense_clarification": "An expression of sympathy, especially on the occasion of a death."
                            },
                            {
                                "target_lang_word": "sympathy",
                                "target_lang_sense_clarification": "Feelings of pity and sorrow for someone else's misfortune."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}