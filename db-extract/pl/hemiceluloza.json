                        "source_entry_id": "f78520be-e232-3e0d-bcc3-344195625b4d",
                        "source_sense_id": "06075a36-e3ce-3957-a261-35b0add06996",
                        "target_lang_word": "hemicellulose",
                        "target_lang_code": "en",
