                                                "sense_id": "b0bc5889-d16b-35d3-846b-88cbca74d58d",
                                                "text": "Ein Bulldozer planiert den Platzpl"
                                            },
                                            {
                                                "example_id": "20471ce9-a37b-46c8-97d8-2925d9877f07",
                                                "sense_id": "b0bc5889-d16b-35d3-846b-88cbca74d58d",
                                                "text": "„Drei große Caterpillar D9 fuhren nebeneinander, sodass nach einer Fahrt schon die halbe Flugplatzbreite planiert war.“"
                                            },
                                            {
                                                "example_id": "56f589d3-557f-4e50-870b-88b8ac788853",
                                                "sense_id": "b0bc5889-d16b-35d3-846b-88cbca74d58d",
                                                "text": "„Die Trasse war geschlagen worden, und die Straße war bereits planiert und verdichtet worden.“"
                                            }
