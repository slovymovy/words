                "senses": [
                    {
                        "sense_id": "90408149-9936-364e-8f5d-34c12d490b6a",
                        "entry_id": "c41afb6f-7d74-32c3-9072-e2da99447997",
                        "glosses": [
                            "свойство по значению прилагательного бывалый; опытность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "881078ac-ce7e-45d3-87c2-764e1af7cb8c",
                                "sense_id": "90408149-9936-364e-8f5d-34c12d490b6a",
                                "text": "По бывалости, по уму, по смелости и решимости он уже давно внушил к себе невольное уважение всем арестантам в остроге."
                            },
                            {
                                "example_id": "77cf0531-e12c-4526-84ca-30cefa29490c",
                                "sense_id": "90408149-9936-364e-8f5d-34c12d490b6a",
                                "text": "Помимо знаний, живого ума, большой житейской бывалости, он привлекал редким в французе добродушием, простотой, отсутствием мелочности."
                            }
                        ]
                    }
