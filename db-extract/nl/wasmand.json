                "forms": [
                    {
                        "form_id": "17018973-7da8-45fd-9c64-97673bbff02f",
                        "entry_id": "5057563b-8405-347f-a426-1b86119dfc0c",
                        "tags": [
                            "plural"
                        ],
                        "form": "wasmanden"
