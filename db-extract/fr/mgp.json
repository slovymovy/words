                                "sense_id": "7dcc7981-6488-3a29-a767-fa32f02021e1",
                                "text": "Ses conclusions seront sûrement importantes pour les élus de la métropole du Grand Paris (MGP), qui doivent débattre, le 30 juin, de l’interdiction des véhicules Crit’Air 3 dans la ZFE du Grand Paris."
                            },
                            {
                                "example_id": "f06b3b82-c0b2-400b-9d3d-029798285ca0",
                                "sense_id": "7dcc7981-6488-3a29-a767-fa32f02021e1",
                                "text": "La Maire remettra les cahiers de la Métropole au Président de la MGP."
                            },
                            {
                                "example_id": "06444dc8-cefd-4f12-aecf-41c00dcdbf93",
                                "sense_id": "7dcc7981-6488-3a29-a767-fa32f02021e1",
                                "text": "Depuis 2016 la MGP exerce de plein droit, en lieu et place de ses communes membres, diverses compétences du territoire."
                            }
                        ]
                    }
