                ],
                "senses": [
                    {
                        "sense_id": "2779c977-cc22-376f-b42a-8e39d8e30df8",
                        "entry_id": "4ce01beb-7106-34ba-a74a-275204cf4b95",
                        "glosses": [
                            "liczba 13"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d1f7726-86e7-4ea7-83c4-f7821daa052a",
                                "sense_id": "2779c977-cc22-376f-b42a-8e39d8e30df8",
                                "text": "W wielu hotelach nie ma pokoju numer trzynaście, bo trzynastka jest uważana za liczbę pechową."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "5820b2d9-83c2-325c-ab6f-f95f35c68d6a",
                        "entry_id": "4ce01beb-7106-34ba-a74a-275204cf4b95",
                        "glosses": [
                            "coś, czego jest 13, całość składająca się z 13 elementów, jednostek itp."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e99d3c0-a0e2-4e52-a049-2e17d390e4b5",
                                "sense_id": "5820b2d9-83c2-325c-ab6f-f95f35c68d6a",
                                "text": "Cała trzynastka weszła na boisko i dopiero kapitan zdecydował, kto będzie grał."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "524b9cc1-3fbf-3a9d-9c30-3634fc9a7877",
                        "entry_id": "4ce01beb-7106-34ba-a74a-275204cf4b95",
                        "glosses": [
                            "to, co ma numer 13, jest oznaczone liczbą 13, np. dom, autobus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0064f97-018d-4fd1-823f-dda58aa3eb7a",
                                "sense_id": "524b9cc1-3fbf-3a9d-9c30-3634fc9a7877",
                                "text": "Miałem jechać trójką, a przez pomyłkę wsiadłem do trzynastki."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "4e37f3c9-7299-34fa-9fb9-d2562a5d85d4",
                        "entry_id": "4ce01beb-7106-34ba-a74a-275204cf4b95",
                        "glosses": [
                            "dodatkowa pensja wypłacana w niektórych zakładach pracy; trzynasta pensja"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6c9a580-7ffc-44db-b20c-13d81173513b",
                                "sense_id": "4e37f3c9-7299-34fa-9fb9-d2562a5d85d4",
                                "text": "W naszym zakładzie pracy trzynastka jest wypłacana dopiero w marcu."
                            }
                        ],
                        "sense_index_json": "\"1.4\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "71770e45-df19-4077-82ba-2f6ac9645a22",
                        "source_entry_id": "4ce01beb-7106-34ba-a74a-275204cf4b95",
                        "source_sense_id": "2779c977-cc22-376f-b42a-8e39d8e30df8",
                        "target_lang_word": "thirteen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thirteen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b0b504d-28ef-3c12-a5fc-094fc4839178",
                                        "entry_id": "e8d1e9e5-8c99-3dbc-81c8-e3175d107922",
                                        "glosses": [
                                            "The cardinal number occurring after twelve and before fourteen: ten and three."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ed3d0d9-f5bc-4eea-9e11-eff5c543d9fd",
                                                "sense_id": "3b0b504d-28ef-3c12-a5fc-094fc4839178",
                                                "text": "There are thirteen cards of each of the four suits in a deck of playing cards."
                                            },
                                            {
                                                "example_id": "1bf0d541-ee71-4055-981b-0442ac43ded6",
                                                "sense_id": "3b0b504d-28ef-3c12-a5fc-094fc4839178",
                                                "text": "His brother's age is thirteen."
                                            },
                                            {
                                                "example_id": "1422a8cf-2b5a-4b83-8408-9d8946f688fa",
                                                "sense_id": "3b0b504d-28ef-3c12-a5fc-094fc4839178",
                                                "text": "During the whole time of his abode in the university he generally spent thirteen hours of the day in study; by which assiduity besides an exact dispatch of the whole course of philosophy, he read over in a manner all classic authors that are extant[…]"
                                            },
                                            {
                                                "example_id": "c433b394-05e7-4421-a719-c14f51c7ab5b",
                                                "sense_id": "3b0b504d-28ef-3c12-a5fc-094fc4839178",
                                                "text": "In the spring of 1857, I, with several friends, left Hongkong for Shanghai, viâ Foochow, in the small coasting steamer Antelope. No noteworthy incident occurred until after leaving Foochow when, as we were enjoying our after dinner coffee and cigars, and by chance discussing the question of thirteen sitting down at table that had occurred at a dinner at which one of the party had shortly before been present, a violent thump and tremulous motion of the vessel announced the unpleasant fact that we had struck upon something. We rushed on deck and found the steamer hard and fast on a reef near Matsu Island. Fortunately the day was fine and there was no sea on."
                                            },
                                            {
                                                "example_id": "5276c420-dccb-40a2-ab9b-b90715f44d08",
                                                "sense_id": "3b0b504d-28ef-3c12-a5fc-094fc4839178",
                                                "text": "In the summer of 2014, at least thirteen BTGs and elements of five SPETSNAZ units were poised on the Ukrainian border.³⁶"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
