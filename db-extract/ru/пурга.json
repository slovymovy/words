                                        "entry_id": "ce2d1d13-23df-33ed-8aef-9fdcb7010c75",
                                        "glosses": [
                                            "A large snowstorm accompanied by strong winds and greatly reduced visibility caused by blowing snow."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "033ce573-e18c-37f8-b697-a9afa707e842",
                                        "entry_id": "ce2d1d13-23df-33ed-8aef-9fdcb7010c75",
                                        "glosses": [
                                            "A large amount of paperwork."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "90dc8bec-436c-3d34-9c46-a2b5ef627b48",
                                        "entry_id": "ce2d1d13-23df-33ed-8aef-9fdcb7010c75",
                                        "glosses": [
                                            "A large number of similar things; especially, such a group arriving as an inundation, thick and fast."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20cb9975-fe53-40b2-bbe9-edc9c905aeeb",
                                                "sense_id": "90dc8bec-436c-3d34-9c46-a2b5ef627b48",
                                                "text": "Near-synonyms: flood, inundation, torrent"
                                            },
                                            {
                                                "example_id": "a7fdf736-b12a-4a90-9ec9-2168aafc8c44",
                                                "sense_id": "90dc8bec-436c-3d34-9c46-a2b5ef627b48",
                                                "text": "a blizzard of political ads"
                                            },
                                            {
                                                "example_id": "a805117f-7902-4dd6-984f-1fd4d33728a4",
                                                "sense_id": "90dc8bec-436c-3d34-9c46-a2b5ef627b48",
                                                "text": "Risk is everywhere.[…]For each one there is a frighteningly precise measurement of just how likely it is to jump from the shadows and get you. “The Norm Chronicles”[…]aims to help data-phobes find their way through this blizzard of risks."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "blizzard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da2552bf-1a81-3690-bbc7-b82e0a8f26b9",
                                        "entry_id": "cfdaf95d-526d-3372-8c26-29a0d966693d",
                                        "glosses": [
                                            "To fall in windy conditions."
                                        ],
                                        "tags": [
                                            "impersonal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4f0f921-79b6-411b-ada5-168c4f1e9ef0",
                        "source_entry_id": "d9fcd4c5-a296-38c4-b679-31ecc0fdd370",
                        "source_sense_description": "метель",
                        "target_lang_word": "snowstorm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "snowstorm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ddfa9747-360f-3477-92d5-7f31be0555cc",
                                        "entry_id": "a8f86327-03a9-3a6d-b8aa-923fe207c9c0",
                                        "glosses": [
                                            "Bad weather involving blowing winds and snow, or blowing winds and heavy snowfall amount."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9390d75-5e6b-4845-b317-caabadb7398f",
                                                "sense_id": "ddfa9747-360f-3477-92d5-7f31be0555cc",
                                                "text": "Dined at Melville Castle, whither I went through a snow-storm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4eaefe8d-a6cf-3965-bf6a-8137b3e6326e",
                                        "entry_id": "a8f86327-03a9-3a6d-b8aa-923fe207c9c0",
                                        "glosses": [
                                            "A snow globe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89f1ea61-2a2b-4671-acd1-d321f86f6fbf",
                                                "sense_id": "4eaefe8d-a6cf-3965-bf6a-8137b3e6326e",
                                                "text": "As we made our way down, my eye was caught by a snowstorm—one of those little glass balls, with a baby cottage inside."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f1f5a43-77db-4bfd-8de5-cf2955d25853",
                        "source_entry_id": "d9fcd4c5-a296-38c4-b679-31ecc0fdd370",
                        "source_sense_description": "метель",
                        "target_lang_word": "bufera di neve",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "fe338f7d-d9cc-42c7-98ec-aff618ab8b7d",
                        "source_entry_id": "d9fcd4c5-a296-38c4-b679-31ecc0fdd370",
                        "source_sense_description": "метель",
                        "target_lang_word": "Schneesturm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schneesturm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e67c2bb4-1b33-389f-9813-f9dbb2008660",
                                        "entry_id": "319741ee-4acd-388c-af52-90be2a168f48",
                                        "glosses": [
                                            "starker Schneefall bei Wind, Sturm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "beeb612e-3d93-4328-84f7-bd10f6c36bf8",
                                                "sense_id": "e67c2bb4-1b33-389f-9813-f9dbb2008660",
                                                "text": "Bei den Schneestürmen brach Chaos auf den Straßen aus."
                                            },
                                            {
                                                "example_id": "c95794f4-c13c-4248-a5ea-42f7a66ba438",
                                                "sense_id": "e67c2bb4-1b33-389f-9813-f9dbb2008660",
                                                "text": "„Als ich unten im Zentrum ankam, war der Schneefall zu einem undurchdringlichen Schneesturm angewachsen.“"
                                            },
                                            {
                                                "example_id": "4b027378-4db4-44e3-ab06-57d886fa8359",
                                                "sense_id": "e67c2bb4-1b33-389f-9813-f9dbb2008660",
                                                "text": "„Am Dienstag kam ein Schneesturm auf, und am Freitag hatten wir rodelfrei.“"
                                            },
                                            {
                                                "example_id": "dd9d1b34-6084-4135-9e16-07dfa0d4a409",
                                                "sense_id": "e67c2bb4-1b33-389f-9813-f9dbb2008660",
                                                "text": "„Dass das Leben in der Kolonie auch seine Schattenseiten hatte, lässt sich erahnen, wenn Perley schreibt, es gebe selten mehr als vier Schneestürme im Jahr.“"
                                            },
                                            {
                                                "example_id": "55f9997d-649b-4c55-9ac2-b612634f7534",
                                                "sense_id": "e67c2bb4-1b33-389f-9813-f9dbb2008660",
                                                "text": "„Die telephonischen Verbindungen zwischen uns und Munau waren seit ein paar Tagen unterbrochen, ohne daß wir wußten, ob der Schneesturm oder der Feind daran schuld war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94e491b9-8354-4b5a-8c32-6470f0dd98e1",
                        "source_entry_id": "d9fcd4c5-a296-38c4-b679-31ecc0fdd370",
                        "source_sense_description": "метель",
