                                "sense_id": "50a420fc-39f1-3d4d-ba7b-0952a66359e9",
                                "text": "L’enculeur de la Baronne."
                            },
                            {
                                "example_id": "df7eda4e-5848-40cf-ab37-08d71434a34a",
                                "sense_id": "50a420fc-39f1-3d4d-ba7b-0952a66359e9",
                                "text": "L’enculeur de ces dames."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d36f68e-7c9c-364c-8995-0f24f5ab0c6d",
                        "entry_id": "2d1f7f7d-d77d-328e-bd16-6445b5b6d932",
                        "glosses": [
