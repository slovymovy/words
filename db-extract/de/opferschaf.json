                        "glosses": [
                            "Schaf, das als Opfer getötet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "627750e0-2630-462b-930a-4db098d72efd",
                                "sense_id": "9b5920fb-390f-3355-92b4-ddaf46b34898",
                                "text": "„Im religiösen Bereich waren Schafe die gängigsten Opfertiere, was sich auch daran zeigt, daß sich der wichtigste Bereich der mesopotamischen Vorzeichenwissenschaft mit der Interpretation von Omina beschäftigte, die aus den Eingeweiden von Opferschafen gelesen werden konnten.“"
                            },
                            {
                                "example_id": "b3aea8b6-9bbc-44b5-a755-3a09ec1014e2",
                                "sense_id": "9b5920fb-390f-3355-92b4-ddaf46b34898",
                                "text": "„Hinter der Klostermauer halten zwei junge Männer ein Opferschaf, während der dritte ihm die Kehle durchschneidet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
