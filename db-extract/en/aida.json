                ],
                "senses": [
                    {
                        "sense_id": "0ad7a55d-4fa1-3438-aefd-3cbe91f2d3f1",
                        "entry_id": "2d9f563f-b951-3461-a92b-f8d33fb178da",
                        "glosses": [
                            "Synonym of Aida cloth."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7d00d986-d694-4f33-8689-686eb0c02328",
                                "sense_id": "0ad7a55d-4fa1-3438-aefd-3cbe91f2d3f1",
                                "text": "Use a size 24 needle for most aidas, and a size 26 for evenweaves and linens."
                            },
                            {
                                "example_id": "4823ba77-a5ad-43fc-813e-856c6225a4f2",
                                "sense_id": "0ad7a55d-4fa1-3438-aefd-3cbe91f2d3f1",
                                "text": "The benefit however of stitching on a higher count aida is that the overall project will be smaller, and you can fit in a greater level of detail."
                            },
                            {
                                "example_id": "ac1d6381-a6e8-494c-9de2-659e0ca6db8a",
                                "sense_id": "0ad7a55d-4fa1-3438-aefd-3cbe91f2d3f1",
                                "text": "Each of the projects in this book use 14 count aida, which means there are fourteen squares (or stitches) per inch of fabric."
                            }
                        ]
                    }
                ],
