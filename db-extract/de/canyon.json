                                "target_senses": [
                                    {
                                        "sense_id": "0a744114-4a3c-3e31-9b30-a923fd31cde5",
                                        "entry_id": "3aac56e6-e0a7-3512-931d-566c17e84c1b",
                                        "glosses": [
                                            "Muy bueno."
                                        ],
                                        "tags": [
                                            "Spain",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aaee0ea5-b1c7-4c79-aca2-54e3a1d576bc",
                                                "sense_id": "0a744114-4a3c-3e31-9b30-a923fd31cde5",
                                                "text": "Metía los dedos y se llevaba a la boca trocitos de empanada. —¡Está cañón!— decía con la boca llena, salpicando miguitas."
                                            }
                                        ],
                                        "sense_index_json": "\"22\""
                                    },
                                    {
                                        "sense_id": "88ed19ee-f2b9-3b2a-ba0b-0be0894d6f31",
                                        "entry_id": "3aac56e6-e0a7-3512-931d-566c17e84c1b",
                                        "glosses": [
                                            "Dicho de una persona, bella, de gran atractivo físico."
                                        ],
                                        "tags": [
                                            "Spain",
                                            "colloquial",
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfedeb6a-bc9d-45b3-85a8-cd871f15836f",
                                                "sense_id": "88ed19ee-f2b9-3b2a-ba0b-0be0894d6f31",
                                                "text": "Dos personas aparecen en el escenario esmirriado del Marfil's. La primera es una rubia cañón, imponente, que deja K.O. a Aniceto y despierta silbidos y comentarios procaces del público masculino."
                                            }
                                        ],
                                        "sense_index_json": "\"23\""
                                    },
                                    {
                                        "sense_id": "effe1f03-8726-3362-acb5-885eaf2cea25",
                                        "entry_id": "3aac56e6-e0a7-3512-931d-566c17e84c1b",
                                        "glosses": [
                                            "Muy difícil."
                                        ],
                                        "tags": [
                                            "Mexico",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9328acb3-d698-4741-aa3a-db473bf6d584",
                                                "sense_id": "effe1f03-8726-3362-acb5-885eaf2cea25",
                                                "text": "A estas alturas ya ni protesto. Me gané la mala fama que tengo y echarla al olvido está cañón."
                                            }
                                        ],
                                        "sense_index_json": "\"24\""
                                    }
                                ]
                            },
                            {
                                "target_word": "cañón",
