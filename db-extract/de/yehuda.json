                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69340904-e423-4432-ae86-7df969d50b8c",
                                "sense_id": "67615559-43cc-362b-8c32-ae4468dd568c",
                                "text": "Frau Yehuda ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d0afeb7f-f793-4f31-912c-a05e2a2a8644",
                                "sense_id": "67615559-43cc-362b-8c32-ae4468dd568c",
                                "text": "Herr Yehuda wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b31db343-5b48-456f-bbb7-396e84b0809b",
                                "sense_id": "67615559-43cc-362b-8c32-ae4468dd568c",
                                "text": "Die Yehudas fliegen heute nach Liverpool."
                            },
                            {
                                "example_id": "ad4e4672-a78c-45bc-ade3-d79e123c4407",
                                "sense_id": "67615559-43cc-362b-8c32-ae4468dd568c",
                                "text": "Der Yehuda trägt nie die Pullover, die die Yehuda ihm strickt."
                            },
                            {
                                "example_id": "e2f68740-dc27-4db8-834c-7ade617714c5",
                                "sense_id": "67615559-43cc-362b-8c32-ae4468dd568c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Yehuda kommt, geht der Herr Yehuda.“"
                            },
                            {
                                "example_id": "81fb1150-e398-402b-adfc-e23369af145e",
                                "sense_id": "67615559-43cc-362b-8c32-ae4468dd568c",
                                "text": "Yehuda kommt und geht."
                            },
                            {
                                "example_id": "abbd8c5a-7152-4b42-b8f1-b98071c34590",
                                "sense_id": "67615559-43cc-362b-8c32-ae4468dd568c",
                                "text": "Yehudas kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
