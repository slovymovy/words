                                "target_senses": [
                                    {
                                        "sense_id": "7a3c7d90-503e-3930-b3f8-9618d8b62628",
                                        "entry_id": "e6a28784-b667-3907-9b11-31ea26ef72f5",
                                        "glosses": [
                                            "A branched, often ornate, light fixture suspended from a ceiling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dab0607a-b175-4c63-aa55-576c2583346f",
                                                "sense_id": "7a3c7d90-503e-3930-b3f8-9618d8b62628",
                                                "text": "She opened the drawing-room door in trepidation. Would she find Esther drowned with her head in the goldfish bowl, or hanged from the chandelier by her stay-lace?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bf84b67-219b-3a03-9028-9e8f31de8dd6",
                                        "entry_id": "e6a28784-b667-3907-9b11-31ea26ef72f5",
                                        "glosses": [
                                            "A branched, often ornate, light fixture suspended from a ceiling.",
                                            "One lit by candles."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "90aac95b-b73a-34d8-ac25-d98485aa6b5f",
                                        "entry_id": "e6a28784-b667-3907-9b11-31ea26ef72f5",
                                        "glosses": [
                                            "A fictional bidder used to increase the price at an auction."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5fe5a43-6969-412e-845d-547a6e94166c",
                                                "sense_id": "90aac95b-b73a-34d8-ac25-d98485aa6b5f",
                                                "text": "2007, Frank Pope, \"Dragon Sea: a true tale of treasure, archeology, and greed off the coast of Vietnam\", Harcourt Books, p. 306.\nA mysterious phone bidder was grabbing the pieces that no one else wanted—Mensun suspected this was the auction house \"bidding against the chandelier,\" protecting itself against selling too low."
                                            },
                                            {
                                                "example_id": "ae170d7c-d38f-4048-bbcf-d231fe6972b2",
                                                "sense_id": "90aac95b-b73a-34d8-ac25-d98485aa6b5f",
                                                "text": "The bids are usually real but can be fake or ‘chandelier’ bids (non-existing bids taken ‘off the chandelier’) on behalf of the consignor, or bids left with the auctioneer in advance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90d1e35d-8757-34e1-a06e-cc10a36c8def",
                                        "entry_id": "e6a28784-b667-3907-9b11-31ea26ef72f5",
                                        "glosses": [
                                            "An endoilluminator used in eye surgery."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "97c0f097-718b-3b3c-b2ed-99ee8ced482b",
                                        "entry_id": "e6a28784-b667-3907-9b11-31ea26ef72f5",
                                        "glosses": [
                                            "A portable frame used to support temporary wooden fences."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6e62ddf-0ef8-40cd-b1fe-2122c90908f7",
                                                "sense_id": "97c0f097-718b-3b3c-b2ed-99ee8ced482b",
                                                "text": "Chandelier. A wooden frame, whereon are laid fascines or faggots, to cover the workmen in making approaches."
                                            },
                                            {
                                                "example_id": "9f40a8e8-3044-4e73-8fd3-d4c4b5e93c94",
                                                "sense_id": "97c0f097-718b-3b3c-b2ed-99ee8ced482b",
                                                "text": "Europeans solved this problem by building a temporary fence with tightly bound sticks (\"fascines\") stacked into wooden frames (\"chandeliers\")."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca646e67-2463-463d-a3a8-5249fa5c5efa",
                        "source_entry_id": "5c731631-d868-3457-b549-f5371c075b48",
                        "source_sense_id": "a034787f-ae5e-39ea-8127-28e0505fc68e",
                        "target_lang_word": "lustre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lustre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7d214a25-537e-33dd-a731-0289a89f012f",
                                        "entry_id": "32c88ed8-6c5e-3275-9710-cfaac307a1d5",
                                        "glosses": [
                                            "Époque de la cérémonie du cens qui revenait tous les cinq ans et où l’on aspergeait le peuple romain assemblé avec de l’eau lustrale."
                                        ],
                                        "tags": [
                                            "Ancient-Roman"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3919c2d4-05b3-32bc-8704-881c07de228a",
                                        "entry_id": "32c88ed8-6c5e-3275-9710-cfaac307a1d5",
                                        "glosses": [
                                            "Sacrifice expiatoire qui avait lieu à la période du cens."
                                        ],
                                        "tags": [
                                            "Ancient-Roman"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a820658e-ed6d-37ce-be1e-1b4003692619",
                                        "entry_id": "32c88ed8-6c5e-3275-9710-cfaac307a1d5",
                                        "glosses": [
                                            "Durée de cinq ans."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5f01a29-0ffa-47e1-a69e-39638ea450e5",
                                                "sense_id": "a820658e-ed6d-37ce-be1e-1b4003692619",
                                                "text": "Elle n'a pas voulu non plus changer de bagnole, chargée d'au moins deux lustres, […]."
                                            },
                                            {
                                                "example_id": "60c06a15-6e7b-4a6b-afaa-7162045b0ded",
                                                "sense_id": "a820658e-ed6d-37ce-be1e-1b4003692619",
                                                "text": "Car si de 673, qui est l’année en laquelle Faustin a bâti cette église, on en ôte dix-huit lustres, c’est-à-dire quatre-vingt-dix ans, qui s’étaient écoulés depuis la mort de saint Maur jusqu’à la construction de cette église, on trouvera que cela revient à l’an 583, qui convient fort bien au temps du décès de ce saint."
                                            },
                                            {
                                                "example_id": "e3302e82-7653-4cb0-a888-0da8e319cf0a",
                                                "sense_id": "a820658e-ed6d-37ce-be1e-1b4003692619",
                                                "text": "« Dans un mois, vers le 20 avril, m’avait dit, d’autre part, M. Térence, l’Irlande va entrer en lutte contre l’Angleterre. » Ah ! ce jour-là, le lundi de Pâques, une fille d’Antrim aurait atteint son septième lustre !"
                                            },
                                            {
                                                "example_id": "6191c903-863d-4764-b849-ae092f8b165e",
                                                "sense_id": "a820658e-ed6d-37ce-be1e-1b4003692619",
                                                "text": "Et l’homme, l’étonnant géniteur, recueillait ses dernières forces. Moins d’un lustre plus tard, il n’était plus."
                                            },
                                            {
                                                "example_id": "f0c9f845-b7fb-4043-91db-377c24fe3f68",
                                                "sense_id": "a820658e-ed6d-37ce-be1e-1b4003692619",
                                                "text": "A-t-on idée de choisir comme pseudo : Si seule ? A-t-on idée d’exposer un cas archi-banal, ridicule ? On est secrétaire, on habite évidemment un sixième, on palpite depuis un lustre pour un voisin de palier, digne jeune homme, caissier de son état, qui lui coule des œillades et qui n’ose… Faut-il oser le faire oser ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7e9eeda-fc86-3f07-8e51-6add2646a85b",
                                        "entry_id": "32c88ed8-6c5e-3275-9710-cfaac307a1d5",
                                        "glosses": [
                                            "Longue durée."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96fc2c4b-5a76-4f89-8bee-ac621d632ab1",
                                                "sense_id": "d7e9eeda-fc86-3f07-8e51-6add2646a85b",
                                                "text": "Faut pas prendre les gens pour des cons, qu’ils diront les médecins militaires, et ça t’empêchera pas, mon vieux, d’y aller à la manœuvre, avec la bande à Velpeau, et un coup de pied dans l’arrière-train, plus quatre-vingt-dix jours de forteresse pour couronner le tout, si c’est pas le conseil de guerre, Biribi, Foum, Tataouine et compagnie, et nous, les marrons du feu, on aura la police au cul pendant quelques lustres, tu comprends ?"
                                            },
                                            {
                                                "example_id": "2bd1a9a8-2e1c-4273-b057-149c03426491",
                                                "sense_id": "d7e9eeda-fc86-3f07-8e51-6add2646a85b",
                                                "text": "On attend une refonte du droit familial au Québec depuis des lustres."
                                            },
                                            {
                                                "example_id": "dcaa09ae-09d4-401f-928c-323626aa60c8",
                                                "sense_id": "d7e9eeda-fc86-3f07-8e51-6add2646a85b",
                                                "text": "Ça fait des lustres que je ne t’avais vu."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lustre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6754be13-7eba-3471-9e9f-5a9d8c0df32a",
                                        "entry_id": "ca442900-2247-3358-9619-adf95ce27049",
                                        "glosses": [
                                            "Éclat que l’on donne à un objet, soit en le polissant, soit en faisant usage de quelque eau, de quelque composition."
                                        ],
                                        "tags": [
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58ea500c-84bf-4ad7-ad9a-d29a3e053687",
                                                "sense_id": "6754be13-7eba-3471-9e9f-5a9d8c0df32a",
                                                "text": "Pierre tint serrés les cordons de sa bourse ; il ne voulut pas entendre parler d’embellissements ; l’ancien mobilier, fané, usé, éclopé, dut servir sans être seulement réparé. Félicité, qui sentait vivement, d’ailleurs, les raisons de cette ladrerie, s’ingénia pour donner un nouveau lustre à toutes ces ruines ; elle recloua elle-même certains meubles plus endommagés que les autres ; elle reprisa le velours éraillé des fauteuils."
                                            },
                                            {
                                                "example_id": "d3587661-449c-41cb-805e-c850ae610149",
                                                "sense_id": "6754be13-7eba-3471-9e9f-5a9d8c0df32a",
                                                "text": "À l’occasion du premier janvier, M. Bergeret revêtit, dès le matin, son habit noir, qui avait perdu son lustre et sur lequel le petit jour gris de l’hiver versait comme de la cendre."
                                            },
                                            {
                                                "example_id": "d32291fa-48f0-4634-a989-10ff86cfbd6b",
                                                "sense_id": "6754be13-7eba-3471-9e9f-5a9d8c0df32a",
                                                "text": "La laine est d’autant meilleure que les brins sont égaux […]. Enfin on recherche le lustre, l’éclat, puis le moelleux qui s’apprécie au toucher."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "867f29ee-4165-36c8-8b6f-3119816b9472",
                                        "entry_id": "ca442900-2247-3358-9619-adf95ce27049",
                                        "glosses": [
                                            "Éclat que l’on donne à un objet, soit en le polissant, soit en faisant usage de quelque eau, de quelque composition.",
                                            "La composition même dont les fourreurs, les chapeliers se servent pour donner du lustre aux fourrures, aux chapeaux de soie, etc."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "singular"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a6f71422-e282-3a45-b513-687ad9c673a0",
                                        "entry_id": "ca442900-2247-3358-9619-adf95ce27049",
                                        "glosses": [
                                            "Éclat que l’on donne à un objet, soit en le polissant, soit en faisant usage de quelque eau, de quelque composition.",
                                            "L’éclat que donne la parure, la beauté, le mérite, la dignité, etc."
                                        ],
                                        "tags": [
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9cebcd90-99d8-4bd0-ae3d-8e08ad1e194a",
                                                "sense_id": "a6f71422-e282-3a45-b513-687ad9c673a0",
                                                "text": "D’abord l’honneur de l’armée était en cause. Pourquoi ? Comment ? Parce que c’était porter atteinte au lustre de l’institution militaire que d’admettre que sept officiers se fussent trompé ?"
                                            },
                                            {
                                                "example_id": "9bcfac7f-8a09-4b73-ab8c-4c648145bfe4",
                                                "sense_id": "a6f71422-e282-3a45-b513-687ad9c673a0",
                                                "text": "Pleines de zèle, elles entendaient donner à leur restaurant ce lustre discret dû à une propagande chuchotée de bouche à oreille et qui permettaient de majorer les prix en donnant l’impression à ceux qui réglaient leur note qu’ils étaient des privilégiés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd5cf5fe-467e-3949-868c-13c319d326c5",
                                        "entry_id": "ca442900-2247-3358-9619-adf95ce27049",
                                        "glosses": [
                                            "Éclat que l’on donne à un objet, soit en le polissant, soit en faisant usage de quelque eau, de quelque composition.",
                                            "Vernis métallique irisé, utilisé pendant la Renaissance pour donner couleur et éclat aux décorations des poteries."
                                        ],
                                        "tags": [
                                            "dated",
                                            "singular"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "62b55191-77a9-3673-991d-8b541309bc41",
                                        "entry_id": "ca442900-2247-3358-9619-adf95ce27049",
                                        "glosses": [
                                            "Appareil d’éclairage, de cristal, de bronze, de bois, etc., à plusieurs branches, qu’on suspend au plafond."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f68728ad-faf2-498d-af2c-08ee66d56648",
                                                "sense_id": "62b55191-77a9-3673-991d-8b541309bc41",
                                                "text": "C'était une des fantaisies quotidiennes de Mˡˡᵉ de Bernage de faire allumer, dès que la nuit approchait, tous les lustres et toutes les torchères, à seule fin de ne pas ressembler aux provinciaux qui ne s'habillent que le dimanche et aux bourgeois de Paris qui ne s'éclairent à giorno que les jours où ils ont du monde à diner."
                                            },
                                            {
                                                "example_id": "8bee1620-265f-438b-a27f-980b7166a830",
                                                "sense_id": "62b55191-77a9-3673-991d-8b541309bc41",
                                                "text": "Grimaldi, dansant un jour devant l'ambassadeur turc, fit un tel bond en son honneur, qu'il heurta le lustre suspendu au-dessus de la tête du monarque."
                                            }
                                        ]
                                    }
                                ]
                            },
