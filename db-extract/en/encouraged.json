                        "examples": [
                            {
                                "example_id": "51b17d78-d5bf-4dfc-a66f-d41c35201108",
                                "sense_id": "1b6e9304-417e-31ea-86df-d1e9b2a244d6",
                                "text": "The results for item 1 indicate that in 1994-5 employees in the public sector were more encouraged to participate in management than those in the non-public sector and the impact of the ownership type is significant."
                            },
                            {
                                "example_id": "c5a3569a-1880-4d89-b6f7-ce5516bab52d",
                                "sense_id": "1b6e9304-417e-31ea-86df-d1e9b2a244d6",
                                "text": "You would certainly feel more encouraged and willing to make efforts for humans if they looked at you with joy and gratitude and encouraged you with positive words."
                            },
                            {
                                "example_id": "d67cb24b-2f66-4bc0-b5cf-2c979c155629",
                                "sense_id": "1b6e9304-417e-31ea-86df-d1e9b2a244d6",
                                "text": "Participants felt more enjoyment from the media feedback when they felt more encouraged, more competent, more autonomy, and that the information was accurate."
                            }
                        ]
                    }
