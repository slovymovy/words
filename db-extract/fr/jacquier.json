        "fr-extract.jsonl": [
            {
                "entry_id": "416af9a2-25d3-33be-8563-4a930b24beac",
                "word": "Jacquier",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "82a04130-e893-340e-80d0-c01cc8b5ede7",
                        "entry_id": "416af9a2-25d3-33be-8563-4a930b24beac",
                        "glosses": [
                            "Nom de famille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ffc8efe-fc92-403b-aa29-a7772a389472",
                                "sense_id": "82a04130-e893-340e-80d0-c01cc8b5ede7",
                                "text": "Pas question de quelqu’un qui ressemblât à Jacquier, là-dedans, mais ça ne voulait rien dire."
                            },
                            {
                                "example_id": "0841742d-d0db-46b4-b3fe-b1c6767d7d4b",
                                "sense_id": "82a04130-e893-340e-80d0-c01cc8b5ede7",
                                "text": "— C’est une jeune fille de Saint-Claude. Tu ne la connais pas. Bien entendu. Elle s’appelle Françoise… Françoise Jacquier… C’est un nom bien connu dans le pays."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "7eb6336f-3737-303a-8d72-1834c1c008ee",
                "word": "jacquier",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d2c378a4-3eba-4022-8adf-ed1183e05c0d",
                        "entry_id": "7eb6336f-3737-303a-8d72-1834c1c008ee",
                        "tags": [
                            "plural"
                        ],
                        "form": "jacquiers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3c3a8865-8481-3e04-87ee-7601913a9a09",
                        "entry_id": "7eb6336f-3737-303a-8d72-1834c1c008ee",
                        "glosses": [
                            "Variante de jaquier par rapprochement populaire avec Jacques."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "3511bf3a-3188-4610-b913-6aef2b432b60",
                                "sense_id": "3c3a8865-8481-3e04-87ee-7601913a9a09",
                                "text": "Le mandarin admira les serpents et les liserons sculptés qui s’enroulaient autour des colonnes en bois de jacquier devant l’entrée des demeures."
                            },
                            {
                                "example_id": "039f5b3e-3fad-48d4-83e2-57c01b03e487",
                                "sense_id": "3c3a8865-8481-3e04-87ee-7601913a9a09",
                                "text": "Les plantes cultivées dans ces vergers sont variées ; bananiers, manguiers, sapotilliers, papayers, jacquiers, goyaviers, cocotiers, aréquiers, citronniers, pamplemoussiers, selon l’étude du géographe Jean Delvert."
                            },
                            {
                                "example_id": "6289bb8b-af5d-493c-962c-12bdaafe7f6b",
                                "sense_id": "3c3a8865-8481-3e04-87ee-7601913a9a09",
                                "text": "Le jacquier, ou pomme de Jacque, est employé dans la cuisine végétarienne indienne. Au-delà de l’Asie, sa commercialisation connait une forte augmentation dans les pays occidentaux depuis peu."
                            },
                            {
                                "example_id": "f7ae5d6e-9027-4e35-a90f-e0b7c2325233",
                                "sense_id": "3c3a8865-8481-3e04-87ee-7601913a9a09",
                                "text": "Ce jour-là, le père transporte Sin sur son vélo, ainsi que des blocs de latex empilés, un grand fruit du jacquier et quelques corossols qu’il n’a pas eu le cœur de jeter, il compte les échanger en ville contre du riz et de la viande."
                            },
                            {
                                "example_id": "a2d0cc5b-f968-4b66-9841-36537760b6ac",
                                "sense_id": "3c3a8865-8481-3e04-87ee-7601913a9a09",
                                "text": "Je me suis mise incontinent à rêver que les jardins de la Tour, jusqu’ici inexplorés, se réservaient à l’arbre exotique, à la mangue et au chérimoya ou anone —, qui sait ? au gigantesque fruit du jacquier…"
                            }
                        ]
                    }
                ],
