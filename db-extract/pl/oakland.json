                "senses": [
                    {
                        "sense_id": "80eda084-cb9c-38e2-8aad-14f09fd2bd4f",
                        "entry_id": "b79a3e3c-bedd-3050-8629-18786236df84",
                        "glosses": [
                            "miasto leżące w północnej części Kalifornii"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b6ba1fd-3a3c-45e4-a311-1c3b2fbe2120",
                                "sense_id": "80eda084-cb9c-38e2-8aad-14f09fd2bd4f",
                                "text": "Już w ubiegły roku Oakland było na trzeciej pozycji, za Waszyngtonem i Detroit, na liście miast z największą liczbą zabójstw „na głowę mieszkańca\" . W tym roku, w ciągu niecałych trzech miesięcy, zanotowano już 55 morderstw"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bdc7170c-7f31-4f82-9425-76bb365a0860",
                        "source_entry_id": "b79a3e3c-bedd-3050-8629-18786236df84",
                        "source_sense_id": "80eda084-cb9c-38e2-8aad-14f09fd2bd4f",
                        "target_lang_word": "Oakland",
                        "target_lang_code": "en",
