                "senses": [
                    {
                        "sense_id": "374aeb10-bb5d-37bc-bdd9-f72387f1c20e",
                        "entry_id": "8a0229e7-b499-3ba1-aa2d-9b37c249d0b4",
                        "glosses": [
                            "A hook attached to a pole used for pulling or pushing boats, rafts, logs or other objects to or from the side of a boat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42829369-d157-4027-9cc5-a57332fc798d",
                                "sense_id": "374aeb10-bb5d-37bc-bdd9-f72387f1c20e",
                                "text": "After that, Hanukkah curled up on the steps of the mosque and withdrew into sleep and his dream of Sarah, of the faint smell of burning sandalwood when she took his head into her lap, a dream from which Amram’s horny toe now dislodged him with all the tenderness of a boathook."
                            }
                        ]
                    },
                    {
                        "sense_id": "320d5ee5-224a-3a12-aeb5-49f82405bcd0",
                        "entry_id": "8a0229e7-b499-3ba1-aa2d-9b37c249d0b4",
                        "glosses": [
                            "A pole or rod with such a hook at one end."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8dff7a70-e30b-46c9-a854-a5d046930a3a",
                        "source_entry_id": "8a0229e7-b499-3ba1-aa2d-9b37c249d0b4",
                        "source_sense_description": "hook attached to a pole to push out or pull in things — see also setting pole",
                        "target_lang_word": "bootshaak",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bootshaak",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "36589a67-8b4b-33ed-b95a-40b3961e14e1",
                                        "entry_id": "a42c4df1-8f48-3286-8965-eeaf6946bc40",
                                        "glosses": [
                                            "ijzeren haak op een houten stok die men voor diverse doeleinden aan boord van een schip gebruikt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3641bc6-bd2d-4096-9155-ee5f7f725591",
                                                "sense_id": "36589a67-8b4b-33ed-b95a-40b3961e14e1",
                                                "text": "„De bouwput op het Damrak lag bij de Nieuwe Brug. De diversiteit van de bodemvondsten leert ons veel over de functie van die brug. De bootshaken vertellen bijvoorbeeld een verhaal over de brug als ingang van de haven."
                                            },
                                            {
                                                "example_id": "ab7ccc85-adca-4caf-9aed-c49a231bf47e",
                                                "sense_id": "36589a67-8b4b-33ed-b95a-40b3961e14e1",
                                                "text": "Ook had ik aan een bootshaak een klein zeiltje vastgemaakt, om het bij gelegenheid te kunnen gebruiken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4eee2e86-b0dc-415a-b96e-1ab5749b14cf",
                        "source_entry_id": "8a0229e7-b499-3ba1-aa2d-9b37c249d0b4",
