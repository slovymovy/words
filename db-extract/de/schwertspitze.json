                        "glosses": [
                            "Spitze eines Schwertes; vorderste Stelle der Schwertklinge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "789b8568-e2ce-4c35-b79c-37a26b903815",
                                "sense_id": "0bc4ef80-2a28-33ab-b3b2-4ea0cb87fc47",
                                "text": "„Er ging wenige Schritte vorwärts, klopfte mit der Schwertspitze auf den goldenen Schild des Kaisers, fuhr daran vorbei, und im Nu hatte er an vier Stellen, am Halse, unter der Schulter, an der Brust und am Knie, den Leib des Kaisers mit dem Schwerte berührt; ganz leicht, beinahe streichelnd.“"
                            }
                        ],
