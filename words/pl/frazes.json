                            },
                            {
                                "target_lang_word": "банальность",
                                "target_lang_sense_clarification": "общеизвестная, избитая истина"
                            },
                            {
                                "target_lang_word": "штамп",
                                "target_lang_sense_clarification": "избитое выражение, ставшее стереотипом"
