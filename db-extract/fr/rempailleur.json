                ],
                "senses": [
                    {
                        "sense_id": "00b9a4f9-4aae-36bd-8353-740bc7d85c66",
                        "entry_id": "a04c7bd5-8c0f-3d42-a305-1cdaa3101bab",
                        "glosses": [
                            "Personne qui s'occupe du paillage des chaises."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "214be612-ce61-4944-994b-216e01951993",
                                "sense_id": "00b9a4f9-4aae-36bd-8353-740bc7d85c66",
                                "text": "Lorsque le bois des chaises ou leur bâti est terminé par le fabricant, celui-ci le remet au rempailleur, afin qu'il en couvre le siège en paille, de manière à suivre les formes adoptées par la mode , et qu'on s'y trouve solidement et commodément assis."
                            },
                            {
                                "example_id": "87e50555-9f5c-424c-832d-35d44e955a06",
                                "sense_id": "00b9a4f9-4aae-36bd-8353-740bc7d85c66",
                                "text": "Il est vrai qu’un tourneur de rouet, bien enclos dans sa chaumine, qu’un rempailleur de chaises, à l’étroit dans sa cabane de roseaux, lui inspiraient la même envie : « Est il heureux, celui-là !… Voilà ce qui s’appelle un homme heureux ! »"
                            },
                            {
                                "example_id": "909487f7-edc9-4e75-9cbd-04154b001d23",
                                "sense_id": "00b9a4f9-4aae-36bd-8353-740bc7d85c66",
                                "text": "Quant à elle, la femme, vous l’avez connue aussi, c’est la vieille rempailleuse de chaises qui venait tous les ans au château."
                            },
                            {
                                "example_id": "04a9b335-7cda-46e9-87b7-121da6e382a1",
                                "sense_id": "00b9a4f9-4aae-36bd-8353-740bc7d85c66",
                                "text": "J’ai beaucoup lu sur Péguy, ce fils de rempailleuse de chaises devenu Normalien, dreyfusard acharné, socialiste de sang et de flammes, polémiste frontal."
                            }
                        ]
                    }
                ],
