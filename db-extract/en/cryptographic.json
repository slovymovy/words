                "word": "cryptographic",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5fc39a5f-716b-3572-86e5-dd6e783a4db6",
                        "entry_id": "f1f85c6f-bc8f-3376-8bca-aa8cd1a09032",
                        "glosses": [
                            "Relating to cryptography."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "05c9c6a4-7f96-4793-906b-c193deec865e",
                                "sense_id": "5fc39a5f-716b-3572-86e5-dd6e783a4db6",
                                "text": "The cryptographic community includes both cryptographers (those who make codes) and cryptanalysts (those who break codes)."
                            },
                            {
                                "example_id": "6c92b642-e9d3-48e9-a7b6-459d4eb6f0d5",
                                "sense_id": "5fc39a5f-716b-3572-86e5-dd6e783a4db6",
                                "text": "The storage of cryptographic secrets is one of the paramount requirements in building trustworthy systems."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5de81ba2-4955-47a2-aa73-26ed14fc141d",
