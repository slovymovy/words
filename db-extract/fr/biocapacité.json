                                    {
                                        "sense_id": "354bc0a0-9d3f-3181-9fff-18692e46b204",
                                        "entry_id": "14785bfb-9787-3d46-9365-8998cc756180",
                                        "glosses": [
                                            "The capacity of an ecosystem to provide resources and absorb wastes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ac3ec28-fce3-48b5-9370-835d574487c9",
                                                "sense_id": "354bc0a0-9d3f-3181-9fff-18692e46b204",
                                                "text": "When an area's ecological footprint exceeds its biocapacity, an ecological deficit occurs."
                                            },
                                            {
                                                "example_id": "5fd5b93e-a63d-4799-b98f-12ba56fd5f00",
                                                "sense_id": "354bc0a0-9d3f-3181-9fff-18692e46b204",
                                                "text": "Forget post-scarcity. Between rising populations, climate change, a dearth of fresh water and stretched bio-capacity, just avoiding widespread famine by the middle of this century would represent an astonishing achievement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
