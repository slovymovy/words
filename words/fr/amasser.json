    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "81303c88-c720-3228-9549-71e864e184c9",
                    "sense_definition": "Accumuler des biens, de l'argent ou des objets matériels en grande quantité.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "accumuler_biens",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a travaillé dur toute sa vie pour <w>amasser</w> une fortune considérable."
                        },
                        {
                            "text": "L'avare préférait <w>amasser</w> des pièces d'or plutôt que d'aider ses proches."
                        }
                    ],
                    "synonyms": [
                        "amonceler"
                    ],
                    "antonyms": [
                        "dilapider"
                    ],
                    "common_phrases": [
                        "amasser une fortune",
                        "amasser des richesses"
                    ]
                },
                {
                    "sense_id": "6c9f397c-758c-34a5-92cc-205cfe328e70",
                    "sense_definition": "Recueillir et réunir des éléments abstraits comme des informations, des preuves ou des connaissances.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "accumuler_abstrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enquêteur a réussi à <w>amasser</w> des preuves décisives pour résoudre l'affaire."
                        },
                        {
                            "text": "Durant ses longues années d'études, elle a <w>amassé</w> des connaissances remarquables."
                        }
                    ],
                    "common_phrases": [
                        "amasser des preuves",
                        "amasser des connaissances"
                    ]
                },
                {
                    "sense_id": "3efa8172-b045-3bd7-8110-0dcb88aeefcb",
                    "sense_definition": "Se rassembler en foule ou former un groupe compact en un même lieu.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "rassemblement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une foule enthousiaste a commencé à s'<w>amasser</w> devant l'entrée de la salle."
                        },
                        {
                            "text": "Les badauds s'<w>amassaient</w> sur la place pour assister au spectacle."
                        }
                    ]
                },
                {
