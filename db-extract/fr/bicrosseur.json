                        "examples": [
                            {
                                "example_id": "753fc3c8-f16c-4e0d-bb27-5636dd00f121",
                                "sense_id": "c3d4c504-18cb-3014-b37d-39d52c88dabf",
                                "text": "Les bicrosseurs sont souvent d'excellents descendeurs. Le trial, école de l'équilibre, apprend à virer dans un mouchoir, à déclencher des extensions à l'arrêt, à maîtriser les techniques à petite vitesse."
                            },
                            {
                                "example_id": "ca6aeab9-6020-4482-af15-4d2889549b5e",
                                "sense_id": "c3d4c504-18cb-3014-b37d-39d52c88dabf",
                                "text": "Les bicrosseuses Laëtitia Le Corguillé et Manon Valentino font partie de vos dix-neuf athlètes, pourquoi n'y a-t-il pas de pistards ou de vététistes ?"
                            }
