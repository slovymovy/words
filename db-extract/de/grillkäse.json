                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68383c1b-9756-4207-bad3-644639654f17",
                                "sense_id": "3ffd6377-3fbd-368e-bd07-64bd26a1ce19",
                                "text": "„Preacher konnte Grillkäse in der Pfanne brutzeln und Nudeln kochen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8021a26e-3598-48e7-864f-15af3025daff",
                        "source_entry_id": "ec9c4baf-ac5e-3840-b1bc-ff2ffa0baf90",
                        "source_sense_id": "3ffd6377-3fbd-368e-bd07-64bd26a1ce19",
                        "source_sense_description": "gegrillt verzehrter Käse",
                        "target_lang_word": "grilled cheese",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grilled cheese",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "148fd0cc-c460-3ef2-92dd-89a5b95181a0",
                                        "entry_id": "d7ac71ba-2909-34aa-b833-ee1967183daf",
                                        "glosses": [
                                            "A cheese sandwich typically toasted or fried in butter."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df09ab19-405b-4538-8cba-0be9087809ab",
                                                "sense_id": "148fd0cc-c460-3ef2-92dd-89a5b95181a0",
                                                "text": "—Do you like grilled cheese? —I love grilled cheese! Especially with bacon and tomato!"
                                            },
                                            {
                                                "example_id": "287791f9-f4c7-4949-8e73-65ae44ffe5d2",
                                                "sense_id": "148fd0cc-c460-3ef2-92dd-89a5b95181a0",
                                                "text": "I'll have a grilled cheese and a bowl of tomato soup, please."
                                            },
                                            {
                                                "example_id": "09d767d7-31d5-460a-b1c4-571f968da838",
                                                "sense_id": "148fd0cc-c460-3ef2-92dd-89a5b95181a0",
                                                "text": "Third, when you go to lunch today, instead of ordering a steak, ask for a grilled cheese."
                                            },
                                            {
                                                "example_id": "38170993-8205-48a3-8972-67305fbf3c28",
                                                "sense_id": "148fd0cc-c460-3ef2-92dd-89a5b95181a0",
                                                "text": "A man of impeccable class, he also buys ready-made suits on sale and would as soon have grilled cheese and iced tea as coq au vin."
                                            },
                                            {
                                                "example_id": "467024f5-43b5-4cdb-88de-3fddd1eec544",
                                                "sense_id": "148fd0cc-c460-3ef2-92dd-89a5b95181a0",
                                                "text": "We sat out among the sidewalk tables, and I had a grilled cheese with bacon."
                                            },
                                            {
                                                "example_id": "c01c8340-635b-43f5-bb68-ad1b7e0719d8",
                                                "sense_id": "148fd0cc-c460-3ef2-92dd-89a5b95181a0",
                                                "text": "I passed on the healthy stuff and had a grilled cheese."
                                            },
                                            {
                                                "example_id": "6d8da540-efe2-4d69-b36c-92101f06446e",
                                                "sense_id": "148fd0cc-c460-3ef2-92dd-89a5b95181a0",
                                                "text": "Stewie: Does anybody wanna buy my shirt? [pause] I'll trade you my shirt for a grilled cheese!"
                                            },
                                            {
                                                "example_id": "c3bea512-f811-41dc-bcf4-210bdff51558",
                                                "sense_id": "148fd0cc-c460-3ef2-92dd-89a5b95181a0",
                                                "text": "He lunched on grilled cheese in Toronto and sashimi in Tokyo and had the chance to stick his finger in a true-to-life Dutch dike in Almere, Holland."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
