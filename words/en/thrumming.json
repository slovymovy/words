    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "240d0ce4-8081-3e16-937d-b31a8840d35e",
                    "sense_definition": "present participle of <w>thrum</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_inflection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He sat at his desk, nervously <w>thrumming</w> his fingers against the wood.",
                            "target_lang_translations": {
                                "it": "Era seduto alla scrivania, <w>tamburellando</w> nervosamente con le dita sul legno."
                            }
                        },
                        {
                            "text": "The engine was <w>thrumming</w> steadily as the boat moved across the calm water.",
                            "target_lang_translations": {
                                "it": "Il motore <w>ronzava</w> costantemente mentre la barca scivolava sull'acqua calma."
                            }
                        }
                    ],
                    "synonyms": [
                        "humming",
                        "buzzing",
                        "vibrating"
                    ],
                    "common_phrases": [
                        "thrumming fingers",
                        "quietly thrumming",
                        "gently thrumming"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Participio presente di \"thrum\": tamburellare con le dita o emettere un ronzio/vibrazione continua e ritmica."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "tamburellando",
                                "target_lang_sense_clarification": "detto delle dita mosse ritmicamente su una superficie"
                            },
                            {
                                "target_lang_word": "ronzando",
                                "target_lang_sense_clarification": "di un motore o meccanismo che emette un suono monotono"
                            },
                            {
                                "target_lang_word": "vibrando",
                                "target_lang_sense_clarification": "che produce una vibrazione sonora continua"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "777e7a54-64d2-38df-99da-777cfea34bd8",
                    "sense_definition": "A continuous rhythmic humming, buzzing, or vibrating sound, or the action of producing it.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The quiet <w>thrumming</w> of the refrigerator was the only sound in the dark kitchen.",
                            "target_lang_translations": {
                                "it": "Il silenzioso <w>ronzio</w> del frigorifero era l'unico suono nella cucina buia."
                            }
                        },
                        {
                            "text": "She fell asleep to the distant <w>thrumming</w> of traffic on the highway.",
                            "target_lang_translations": {
                                "it": "Si addormentò cullata dal lontano <w>rombo sordo</w> del traffico sull'autostrada."
                            }
                        }
                    ],
                    "synonyms": [
                        "hum",
                        "drone",
                        "vibration"
                    ],
                    "antonyms": [
                        "silence"
                    ],
                    "common_phrases": [
                        "constant thrumming",
                        "low thrumming",
                        "steady thrumming"
                    ],
                    "target_lang_definitions": {
                        "it": "Un ronzio, rombo sordo o vibrazione ritmica e continua."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "ronzio",
                                "target_lang_sense_clarification": "suono continuo e sommesso"
                            },
                            {
                                "target_lang_word": "rombo sordo",
                                "target_lang_sense_clarification": "rumore cupo e ritmico, ad es. di motori o traffico"
                            },
                            {
                                "target_lang_word": "tamburellio",
                                "target_lang_sense_clarification": "rumore ritmico di colpi leggeri e ripetuti"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}