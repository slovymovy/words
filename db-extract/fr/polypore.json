                        "entry_id": "9c6027e8-779b-3428-8b86-b6be9804dd67",
                        "glosses": [
                            "Champignon parasite poussant sur les arbres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e2d98bb-67fe-4ffa-8884-a2fb437f40f0",
                                "sense_id": "fd1b73f6-9563-3d20-8392-2b6eda1393c5",
                                "text": "Bien qu’annuel, ce polypore peur rester en place durant plusieurs années."
                            },
                            {
                                "example_id": "925a15e4-93ef-4776-85d6-5388ec385f9a",
                                "sense_id": "fd1b73f6-9563-3d20-8392-2b6eda1393c5",
                                "text": "Aux pieds des arbres et sur les souches, d’autres champignons étaient nés pendant la nuit : russules, pholiotes et polypores écailleux."
                            }
                        ]
                    }
