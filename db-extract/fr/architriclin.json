                "senses": [
                    {
                        "sense_id": "e201e428-bcfe-3eea-8219-040cddfe307e",
                        "entry_id": "f586929b-56b4-3889-9a84-90782d8d5b05",
                        "glosses": [
                            "Celui qui était chargé de l’ordonnance du festin."
                        ],
                        "tags": [
                            "Ancient-Roman"
                        ],
                        "examples": [
                            {
                                "example_id": "a8a06ceb-3e7e-499f-a224-c96fe7778900",
                                "sense_id": "e201e428-bcfe-3eea-8219-040cddfe307e",
                                "text": "Dans le récit des Noces de Cana [Jean 2, 1-12] Et dicit eis Jesus : Haurite nunc, et ferte architriclino. D'où Villon, Ballade pour Jehan Cotard : Architriclin, qui bien sceustes c'est art,"
                            }
                        ]
                    },
                    {
                        "sense_id": "a564ab68-c924-39fb-a9f7-36611a74e0cc",
                        "entry_id": "f586929b-56b4-3889-9a84-90782d8d5b05",
                        "glosses": [
                            "Celui qui préside à l'arrangement d’un repas."
                        ],
                        "tags": [
                            "broadly",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "6d4c8533-215c-4c1f-93eb-0f953a9fd6cc",
                                "sense_id": "a564ab68-c924-39fb-a9f7-36611a74e0cc",
                                "text": "L’Ordre de Bon-Temps fut fondé à l’hiver 1607 par Samuel de Champlain (…).À tour de rôle, chacun des membres du groupe portait le titre « d’architriclin » (maître d’hôtel) et préparait un somptueux repas dont il avait chassé la viande personnellement."
                            },
                            {
                                "example_id": "13a51ca9-f124-4f18-9964-312df84feb97",
                                "sense_id": "a564ab68-c924-39fb-a9f7-36611a74e0cc",
                                "text": "Maître Eckhart commente le miracle de Cana et étudie longuement les paroles que l’architricline adresse à l’époux : …"
                            },
                            {
                                "example_id": "c1f96845-289c-4e47-90ec-480dd2a76cd5",
                                "sense_id": "a564ab68-c924-39fb-a9f7-36611a74e0cc",
                                "text": "Les convives féminins seront : la comtesse architricline, mademoiselle Serrepine, qui lui fait société, Durut et Célestine."
                            }
                        ]
                    }
                ],
