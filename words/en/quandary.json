{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fc19d48e-b881-377e-9c0a-409f66a994c4",
                    "sense_definition": "A difficult situation or a dilemma where one must choose between two or more equally unpleasant or challenging options.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist faced a moral <w>quandary</w> over whether to share his dangerous discovery with the public.",
                            "target_lang_translations": {
                                "ru": "Ученый столкнулся с этической <w>дилеммой</w> относительно того, стоит ли делиться своим опасным открытием с общественностью."
                            }
                        },
                        {
                            "text": "The film explores the protagonist's ethical <w>quandary</w> regarding his role in the project.",
                            "target_lang_translations": {
                                "ru": "Фильм исследует этические <w>затруднения</w> главного героя относительно его роли в проекте."
                            }
                        }
                    ],
                    "synonyms": [
                        "dilemma",
                        "predicament",
                        "Catch-22"
                    ],
                    "common_phrases": [
                        "moral quandary",
                        "ethical quandary",
                        "difficult quandary"
                    ],
                    "target_lang_definitions": {
                        "ru": "Трудная ситуация или дилемма, в которой необходимо выбрать между двумя или более одинаково неприятными или сложными вариантами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дилемма",
                                "target_lang_sense_clarification": "необходимость выбора между двумя вариантами"
                            },
                            {
                                "target_lang_word": "затруднительное положение",
                                "target_lang_sense_clarification": "сложная ситуация"
                            },
                            {
                                "target_lang_word": "тупик",
                                "target_lang_sense_clarification": "безвыходная ситуация"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cbda977d-3c75-3e28-906c-4a20c852a74a",
                    "sense_definition": "A state of uncertainty, perplexity, or hesitation caused by not knowing what to do or how to decide.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden change in the market left many investors in a <w>quandary</w> about where to put their money.",
                            "target_lang_translations": {
                                "ru": "Внезапное изменение ситуации на рынке повергло многих инвесторов в <w>растерянность</w> по поводу того, куда вкладывать деньги."
                            }
                        },
                        {
                            "text": "She was in a <w>quandary</w> about whether to accept the job offer or stay in her current position.",
                            "target_lang_translations": {
                                "ru": "Она была в <w>затруднении</w>, не зная, принять ли предложение о работе или остаться на текущей должности."
                            }
                        }
                    ],
                    "synonyms": [
                        "perplexity",
                        "uncertainty",
                        "pickle",
                        "fix"
                    ],
                    "antonyms": [
                        "certainty",
                        "resolution"
                    ],
                    "common_phrases": [
                        "in a quandary",
                        "face a quandary"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние неуверенности, недоумения или нерешительности, вызванное незнанием того, что делать или как принять решение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "недоумение",
                                "target_lang_sense_clarification": "состояние нерешительности и непонимания"
                            },
                            {
                                "target_lang_word": "затруднение",
                                "target_lang_sense_clarification": "состояние нерешительности"
                            },
                            {
                                "target_lang_word": "растерянность",
                                "target_lang_sense_clarification": "неспособность принять решение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}