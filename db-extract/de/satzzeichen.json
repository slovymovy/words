                    {
                        "translation_id": "a69c8f0d-f601-4db5-a254-cce5f1822778",
                        "source_entry_id": "90ff0638-eb02-3776-8b56-3936cd07dac4",
                        "source_sense_id": "695a1208-b18c-34a7-b3ae-c2f51c2fd884",
