                                "target_lang_word": "радикал",
                                "target_lang_sense_clarification": "химический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "自由基",
                                "target_lang_sense_clarification": "化学术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13714f52-b2bb-3503-b99a-b00e0b40493b",
