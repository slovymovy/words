                "senses": [
                    {
                        "sense_id": "f8875581-2694-3bd5-9f9d-a5310e0dba45",
                        "entry_id": "5604ad93-d995-3cfb-8bcd-993ce6f73c45",
                        "glosses": [
                            "Débarrasser des buissons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0bea1b6-657f-4b31-84bf-cf86acebb3b8",
                                "sense_id": "f8875581-2694-3bd5-9f9d-a5310e0dba45",
                                "text": "Les gardes veillent encore et enjoignent aux facteurs de veiller à ce que dans un temps de neige, les ouvriers dégarnissent bien les souches, pour ne pas faire une mauvaise coupe, et à ce qu’ils aient également l’attention de bien débuissonner, et de ne pas laisser de vieux chicots ni estocs."
                            },
                            {
                                "example_id": "c98b86b5-ef56-41f6-a33c-23370cf3e8f9",
                                "sense_id": "f8875581-2694-3bd5-9f9d-a5310e0dba45",
                                "text": "Il était dit par une autre clause qu’ils pourraient débuissonner les bois et les mettre en nature de terres labourables, en payant un droit par journal."
                            }
                        ]
                    }
                ],
