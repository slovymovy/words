    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "e0b67205-8039-3b40-a1eb-8066198cdaf6",
                    "sense_definition": "Указывает на лицо или предмет, совершающее действие самостоятельно или подчеркивающее свою роль.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "emphasis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я <w>сам</w> это видел.",
                            "target_lang_translations": {
                                "cs": "Viděl jsem to <w>sám</w>."
                            }
                        },
                        {
                            "text": "Само государство так решило.",
                            "target_lang_translations": {
                                "cs": "<w>Sám</w> stát tak rozhodl."
                            }
                        }
                    ],
                    "common_phrases": [
                        "сам по себе"
                    ],
                    "target_lang_definitions": {
                        "cs": "Zdůrazňuje osobu nebo věc, která koná děj, nebo vyjadřuje její přímou účast."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "sám",
                                "target_lang_sense_clarification": "zdůraznění osoby, která děj vykonala osobně"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "adf8d0ee-b44a-3f0e-8552-ff84b5d88acf",
                    "sense_definition": "Лично, без посторонней помощи; собственными силами.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "independence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Все прививки я делаю <w>сам</w>, обрезку — сам, посадки — сам.",
                            "target_lang_translations": {
                                "cs": "Všechna očkování dělám <w>sám</w>, prořezávání také <w>sám</w>, výsadbu také <w>sám</w>."
                            }
                        },
                        {
                            "text": "Наследники отыщутся <w>сами</w>.",
                            "target_lang_translations": {
                                "cs": "Dědicové se najdou <w>sami</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "сделать самому"
                    ],
                    "target_lang_definitions": {
                        "cs": "Osobně, bez cizí pomoci; vlastními silami."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "sám",
                                "target_lang_sense_clarification": "bez cizí pomoci, vlastními silami"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "667fb29c-0f63-3c6b-8356-0ab1f4c11113",
                    "sense_definition": "Непроизвольно, без участия сознательной воли.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "involuntary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Рука <w>сама</w> тянется за гармошкой.",
                            "target_lang_translations": {
                                "cs": "Ruka se <w>sama</w> natahuje po harmonice."
                            }
                        },
                        {
                            "text": "Слезы <w>сами</w> потекли из глаз от этой новости.",
                            "target_lang_translations": {
                                "cs": "Slzy se <w>samy</w> vyronily z očí při té zprávě."
                            }
                        }
                    ],
                    "synonyms": [
                        "непроизвольно",
                        "невольно"
                    ],
                    "target_lang_definitions": {
                        "cs": "Samovolně, bez vědomého úsilí nebo vůle."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "samo",
                                "target_lang_sense_clarification": "vyjadřuje samovolný děj"
                            },
                            {
                                "target_lang_word": "samo od sebe",
                                "target_lang_sense_clarification": "idiomatické vyjádření pro samovolnost"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c05630a8-6207-3010-aba9-cf5c46cc7ef7",
                    "sense_definition": "Руководитель, хозяин или главный человек в организации.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "authority",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После обеда подойдет <w>сам</w> и завизирует вашу заявку.",
                            "target_lang_translations": {
                                "cs": "Po obědě přijde <w>sám</w> a vaši žádost podepíše."
                            }
                        },
                        {
                            "text": "Затем появился <w>сам</w> — начальник тюрьмы.",
                            "target_lang_translations": {
                                "cs": "Poté se objevil <w>sám</w> — ředitel věznice."
                            }
                        }
                    ],
                    "synonyms": [
                        "руководитель",
                        "хозяин",
                        "главный"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное употребление"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Vedoucí, majitel nebo hlavní osoba v organizaci (hovorově)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "sám",
                                "target_lang_sense_clarification": "označení pro autoritu nebo hlavního představitele"
                            },
                            {
                                "target_lang_word": "šéf",
                                "target_lang_sense_clarification": "přenesený význam pro nadřízeného"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "543cbfa0-4edc-3b82-978e-8423d7d2d765",
                    "sense_definition": "Воплощающий в себе какие-либо качества или свойства.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "embodiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я была <w>сама</w> кротость, само лукавство и обаяние.",
                            "target_lang_translations": {
                                "cs": "Byla jsem <w>sama</w> mírnost, <w>samo</w> šibalství a šarm."
                            }
                        },
                        {
                            "text": "Этот человек — <w>сама</w> доброта.",
                            "target_lang_translations": {
                                "cs": "Tento člověk je <w>sama</w> dobrota."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Ztělesnění určité vlastnosti nebo kvality."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "sama",
                                "target_lang_sense_clarification": "ztělesnění vlastnosti (např. sama dobrota)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8668fd4-02b0-3bcb-8de4-a3ee56624e8f",
                    "sense_definition": "По личной инициативе, без внешнего требования.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "independence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Человек свободен, он за всё платит <w>сам</w>.",
                            "target_lang_translations": {
                                "cs": "Člověk je svobodný, za všechno si platí <w>sám</w>."
                            }
                        },
                        {
                            "text": "Он <w>сам</w> решил уйти с работы.",
                            "target_lang_translations": {
                                "cs": "Rozhodl se <w>sám</w> odejít ze zaměstnání."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Z vlastní iniciativy, bez vnějšího požadavku."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "sám",
                                "target_lang_sense_clarification": "z vlastní vůle"
                            }
                        ]
                    }
                }
            ]
        },
