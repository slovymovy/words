                "senses": [
                    {
                        "sense_id": "dfa87d2f-9ade-3355-95a5-602bd9d04f99",
                        "entry_id": "bb638f7b-efaa-3572-bc19-04d2dfe75276",
                        "glosses": [
                            "S’écouter soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "560dfc89-6721-4f50-a949-4bb1b5861e7e",
                                "sense_id": "dfa87d2f-9ade-3355-95a5-602bd9d04f99",
                                "text": "Si l'on prend la \"nouvelle star\" et que l'on écoute les concurrents, une très grande partie chante terriblement faux, c'est l'horreur, ils ne s'auto-écoutent pas ?"
                            },
                            {
                                "example_id": "2dfd5078-f807-4f6c-aedd-47e881c2d9a1",
                                "sense_id": "dfa87d2f-9ade-3355-95a5-602bd9d04f99",
                                "text": "Toutes ces valeurs sont malmenées par la plupart des médias qui s'auto-écoutent, brandissent des anathèmes et veulent formater notre pensée."
                            },
                            {
                                "example_id": "62382312-44f6-46b7-ac4a-c3de3e4412ee",
                                "sense_id": "dfa87d2f-9ade-3355-95a5-602bd9d04f99",
                                "text": "Alors que nos gouvernants se tapent le ventre, s'auto-écoutent, se congratulent."
                            }
                        ]
                    }
