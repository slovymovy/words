                                "target_senses": [
                                    {
                                        "sense_id": "533fc51f-e801-38a4-8cf9-876e76856aff",
                                        "entry_id": "b2e1492a-391b-37ca-9929-fe22a71bbdd7",
                                        "glosses": [
                                            "an attitude of consideration or high regard"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "649f64ca-2732-4bc7-8dcc-f39cf3c8d025",
                                                "sense_id": "533fc51f-e801-38a4-8cf9-876e76856aff",
                                                "text": "He is an intellectual giant, and I have great respect for him."
                                            },
                                            {
                                                "example_id": "10e75fcb-ceaa-4bfa-9353-d25c246c47c4",
                                                "sense_id": "533fc51f-e801-38a4-8cf9-876e76856aff",
                                                "text": "A video of Tajik President Emomali Rahmon complaining to Russian President Vladimir Putin about his lack of respect for the countries of Central Asia that were once part of the Soviet Union has struck a nerve on social media, where it has been viewed millions of times.[…]\n“We have always respected the interests of our main strategic partner,” Rahmon said, referring to Russia. “We want respect, too.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "311cdb95-b421-38e7-8304-3392a2d0d7f7",
                                        "entry_id": "b2e1492a-391b-37ca-9929-fe22a71bbdd7",
                                        "glosses": [
                                            "good opinion, honor, or admiration"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0971a473-8b4f-37cc-9b58-5f03ea4fd048",
                                        "entry_id": "b2e1492a-391b-37ca-9929-fe22a71bbdd7",
                                        "glosses": [
                                            "Polite greetings, often offered as condolences after a death."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b541a01-43b0-4c67-8f84-63e4b3fbb38f",
                                                "sense_id": "0971a473-8b4f-37cc-9b58-5f03ea4fd048",
                                                "text": "The mourners paid their last respects to the deceased poet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79f2c6d4-78c1-3a82-924f-eab830c0ccfe",
                                        "entry_id": "b2e1492a-391b-37ca-9929-fe22a71bbdd7",
                                        "glosses": [
                                            "a particular aspect, feature or detail of something"
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2404839-e61e-4770-a4d8-e0acc041662a",
                                                "sense_id": "79f2c6d4-78c1-3a82-924f-eab830c0ccfe",
                                                "text": "This year's model is superior to last year's in several respects."
                                            },
                                            {
                                                "example_id": "9f3745db-bb18-4d65-b335-575979ac7dbc",
                                                "sense_id": "79f2c6d4-78c1-3a82-924f-eab830c0ccfe",
                                                "text": "In our two loves there is but one respect"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b4edfdd-10cc-370f-82ba-75156ffb16cc",
                                        "entry_id": "b2e1492a-391b-37ca-9929-fe22a71bbdd7",
                                        "glosses": [
                                            "Good will; favor"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51b515a2-bc1a-49c2-a963-e0d3623c1c78",
                                                "sense_id": "6b4edfdd-10cc-370f-82ba-75156ffb16cc",
                                                "text": "And God looked upon the children of Israel, and God had respect unto them."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "respect",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54fc8901-5356-34e5-abe4-428ecbeb471a",
                                        "entry_id": "62703291-34ca-34c2-8d5a-9a7cf1590baa",
                                        "glosses": [
                                            "To have respect for."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "705c9ebf-2b8d-4ccb-bd4a-7ecef1b933e4",
                                                "sense_id": "54fc8901-5356-34e5-abe4-428ecbeb471a",
                                                "text": "She is an intellectual giant, and I respect her greatly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "848126c2-199d-38ad-8dab-98c7aabd8b64",
                                        "entry_id": "62703291-34ca-34c2-8d5a-9a7cf1590baa",
                                        "glosses": [
                                            "To have regard for something, to observe a custom, practice, rule or right."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b969f7de-eff2-40d6-9604-6a3f74b2eacd",
                                                "sense_id": "848126c2-199d-38ad-8dab-98c7aabd8b64",
                                                "text": "I respect your right to hold that belief, although I think it is nonsense."
                                            },
                                            {
                                                "example_id": "c83f104a-bf69-43e9-8407-f099c2d61133",
                                                "sense_id": "848126c2-199d-38ad-8dab-98c7aabd8b64",
                                                "text": "I respect your right to feel offended, even though most people, myself included, totally disagree and don’t find the comment offensive in the slightest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49dcafee-0416-311b-a5a0-0a51d3071b22",
                                        "entry_id": "62703291-34ca-34c2-8d5a-9a7cf1590baa",
                                        "glosses": [
                                            "To abide by an agreement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8ba0079-0338-4bef-aed7-c36cd4c94b3e",
                                                "sense_id": "49dcafee-0416-311b-a5a0-0a51d3071b22",
                                                "text": "They failed to respect the treaty they had signed, and invaded."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "242eff0a-50ad-334b-943d-d635d200a8b5",
                                        "entry_id": "62703291-34ca-34c2-8d5a-9a7cf1590baa",
                                        "glosses": [
                                            "To take notice of; to regard as worthy of special consideration; to heed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "648f5555-9ef3-468e-9257-394ef6f5b18b",
                                                "sense_id": "242eff0a-50ad-334b-943d-d635d200a8b5",
                                                "text": "[T]hou reſpecteſt not ſpilling Edwards bloud: [...]"
                                            },
                                            {
                                                "example_id": "f93ad5d5-23ed-4a26-ba97-6047719df49c",
                                                "sense_id": "242eff0a-50ad-334b-943d-d635d200a8b5",
                                                "text": "We haue also large and various Orchards, and Gardens; Wherein we doe not ſo much reſpect Beauty, as Variety of Ground and Soile, proper for diuerſe Trees and Herbs: [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c80de723-5e04-3f63-b9e8-e64502a42a68",
                                        "entry_id": "62703291-34ca-34c2-8d5a-9a7cf1590baa",
                                        "glosses": [
                                            "To relate to; to be concerned with."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e00d9b0c-8ea0-4606-9b6b-c147078b5869",
                                                "sense_id": "c80de723-5e04-3f63-b9e8-e64502a42a68",
                                                "text": "Whatever they are else, they are always chastisements; and correction respects faults."
                                            },
                                            {
                                                "example_id": "08ccef06-4c2d-4724-95e0-f25537347253",
                                                "sense_id": "c80de723-5e04-3f63-b9e8-e64502a42a68",
                                                "text": "Glandulation respects the secretory vessels, which are either glandules, follicles, or utricles."
                                            },
                                            {
                                                "example_id": "31ba870f-f1a5-4b77-be2c-d6d088d28d30",
                                                "sense_id": "c80de723-5e04-3f63-b9e8-e64502a42a68",
                                                "text": "I hope I may never again be in a state of mind so unchristian as the mental frame in which I lived for some weeks, respecting the memory of Master B."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7810b44-ec91-349a-8dd6-d8a495722c63",
                                        "entry_id": "62703291-34ca-34c2-8d5a-9a7cf1590baa",
                                        "glosses": [
                                            "To regard; to consider; to deem."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33df2b5b-7354-4393-8664-5c588219c241",
                                                "sense_id": "d7810b44-ec91-349a-8dd6-d8a495722c63",
                                                "text": "[T]his my friend (knowen by no name) was found, / Being then a child and ſcarce of power to ſpeake, / To whom my father gaue this name of Gaſper, / And as his own reſpected him to death, [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb281b81-dd5b-3082-9904-f3f6757d31ff",
                                        "entry_id": "62703291-34ca-34c2-8d5a-9a7cf1590baa",
                                        "glosses": [
                                            "To look toward; to face."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b044560b-2821-43f2-8025-b2c22dcc0b17",
                                                "sense_id": "fb281b81-dd5b-3082-9904-f3f6757d31ff",
                                                "text": "That Palladius adviſeth the front of his edifice ſhould ſo reſpect the South, that in the firſt angle it receive the riſing raies of the winter Sunne, and decline a little from the winter ſetting thereof."
                                            }
                                        ]
                                    }
                                ]
                            },
