{
    "word_family": [
        "aanbidder",
        "aanbidding",
        "beden",
        "gebed"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1bad8ea1-64e9-3fbe-bf95-18e922a7c2b7",
                    "sense_definition": "het vereren van een god of heilige door daar een gebed aan te richten",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de kerkdienst werd God door de gelovigen <w>aanbeden</w>.",
                            "target_lang_translations": {
                                "en": "In the church service, God was <w>worshipped</w> by the believers."
                            }
                        },
                        {
                            "text": "Verschillende culturen <w>aanbidden</w> de zon als een bron van leven.",
                            "target_lang_translations": {
                                "en": "Various cultures <w>worship</w> the sun as a source of life."
                            }
                        }
                    ],
                    "synonyms": [
                        "vereren"
                    ],
                    "common_phrases": [
                        "een god aanbidden",
                        "de zon aanbidden"
                    ],
                    "target_lang_definitions": {
                        "en": "to worship a god or saint by directing a prayer to them"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "worship",
                                "target_lang_sense_clarification": "to show reverence and adoration for a deity"
                            },
                            {
                                "target_lang_word": "adore",
                                "target_lang_sense_clarification": "to worship or honor as a deity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c6e7215-5ea3-3529-9c94-5971696c2a3e",
                    "sense_definition": "iemand of iets met zeer grote bewondering of liefde behandelen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bekende sporthelden worden door veel jonge mensen <w>aanbeden</w>.",
                            "target_lang_translations": {
                                "en": "Famous sports heroes are <w>adored</w> by many young people."
                            }
                        },
                        {
                            "text": "Hij <w>aanbidt</w> zijn vrouw en doet alles voor haar.",
                            "target_lang_translations": {
                                "en": "He <w>adores</w> his wife and does everything for her."
                            }
                        }
                    ],
                    "synonyms": [
                        "vereren"
                    ],
                    "common_phrases": [
                        "iemand vurig aanbidden"
                    ],
                    "target_lang_definitions": {
                        "en": "to treat someone or something with very great admiration or love"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "adore",
                                "target_lang_sense_clarification": "to love someone very much or admire them greatly"
                            },
                            {
                                "target_lang_word": "idolize",
                                "target_lang_sense_clarification": "to admire or revere someone to an excessive degree"
                            },
                            {
                                "target_lang_word": "worship",
                                "target_lang_sense_clarification": "to love or admire someone to the point of devotion"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}