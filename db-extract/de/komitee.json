                                "target_senses": [
                                    {
                                        "sense_id": "aa386805-ad21-3c8e-863c-7791027d62f3",
                                        "entry_id": "9733cc30-e8f7-3752-9885-a43d0820e144",
                                        "glosses": [
                                            "A body of one or more persons convened for the accomplishment of some specific purpose, typically with formal protocols."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc7f5be2-7337-4fb2-9772-f70ca180b3e4",
                                                "sense_id": "aa386805-ad21-3c8e-863c-7791027d62f3",
                                                "text": "My uncle is on the committee."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cc44d76-fffd-3fe8-843e-ebfdd02db08b",
                                        "entry_id": "9733cc30-e8f7-3752-9885-a43d0820e144",
                                        "glosses": [
                                            "A guardian; someone in charge of another person deemed to be unable to look after themselves."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "726640b5-26f0-3f8b-ae72-6c3da45e3b47",
                                        "entry_id": "9733cc30-e8f7-3752-9885-a43d0820e144",
