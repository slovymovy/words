                        "examples": [
                            {
                                "example_id": "f5e860b3-f875-42dc-8cd9-3a6caeb9fe64",
                                "sense_id": "67ae7b73-fa54-3c9a-b6e3-a12fb893971f",
                                "text": "Het bekertoernooi is dit jaar uitgesteld i.v.m. de coronapandemie."
                            },
                            {
                                "example_id": "9b7b24c0-6292-4f7d-a4e5-d6934bbb9652",
                                "sense_id": "67ae7b73-fa54-3c9a-b6e3-a12fb893971f",
                                "text": "Ook de start van het bekertoernooi, normaal gesproken in oktober, is uitgesteld"
                            },
                            {
                                "example_id": "fdce9875-3e8f-4fcf-86df-9b6ad05d5cf5",
                                "sense_id": "67ae7b73-fa54-3c9a-b6e3-a12fb893971f",
                                "text": "De eerste ronde van het befaamde bekertoernooi, dat afgelopen seizoen een prooi werd voor Arsenal, wordt gespeeld op 1 september. De finale op Wembley staat gepland voor 15 mei 2021."
                            }
                        ]
                    }
