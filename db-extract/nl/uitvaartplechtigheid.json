                        "glosses": [
                            "de plechtigheid die voorafgaat aan de teraardebestelling of crematie van een overledene"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "934d8147-847f-4f8e-822e-3733fb68a2d6",
                                "sense_id": "4e9b32ce-7e63-399f-aea4-d34612808c9d",
                                "text": "De uitvaartplechtigheid van Mies Bouwman, die 26 februari thuis in Elst overleed in het bijzijn van haar kinderen, vond plaats in besloten kring. Op dezelfde plek in de rustige lommerrijke omgeving in Leusden is ook haar man Leen Timp in 2013 gecremeerd."
                            },
                            {
                                "example_id": "c8c44e8c-81eb-4629-aa26-d0e64083b1f4",
                                "sense_id": "4e9b32ce-7e63-399f-aea4-d34612808c9d",
                                "text": "De uitvaartplechtigheid van Stephen Hawking vindt zaterdag in besloten kring plaatst in een kerk van de universiteit van Cambridge. De natuurkundige woonde en werkte meer dan vijftig jaar lang in de Engelse stad. Professor Hawking overleed 14 maart op 76-jarige leeftijd."
                            }
                        ]
                    }
