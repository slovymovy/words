        "fr-extract.jsonl": [
            {
                "entry_id": "284134c8-3296-361e-9ba8-c6771aa87e81",
                "word": "Thiérache",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7d381144-aef0-3187-a8fe-c464484e57b3",
                        "entry_id": "284134c8-3296-361e-9ba8-c6771aa87e81",
                        "glosses": [
                            "Grande région naturelle située au nord de département de l’Aisne, au nord-ouest du département des Ardennes, au sud-est du département du Nord et au sud des provinces belges de Hainaut et de Namur."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "2d2c05b7-6066-4c06-98bb-db0f1be4d085",
                                "sense_id": "7d381144-aef0-3187-a8fe-c464484e57b3",
                                "text": "Du côté de l'Ardenne, une partie de l'arrondissement de Rocroy appartenait également à la Thiérache; […]; des titres beaucoup plus modernes, des actes du xviᵉ siècle, désignent encore les villages de Bossus, d’Aouste, et même de La Cerleau, comme faisant partie de la Thiérache."
                            },
                            {
                                "example_id": "2c4dad80-6f49-4e0d-8ed7-e50dae2e763f",
                                "sense_id": "7d381144-aef0-3187-a8fe-c464484e57b3",
                                "text": "Laboureurs des Crêtes ou du Vallage, sarteurs d’Ardenne, coupeurs de foin des censes de Thiérache, tous disposaient de mille et une façons de prédire le temps, la pluie surtout, si gênante pour les travaux, si redoutable dans nos pays par sa durée."
                            },
                            {
                                "example_id": "6ba7f191-41b6-43b5-91c0-7c78b2d9f360",
                                "sense_id": "7d381144-aef0-3187-a8fe-c464484e57b3",
                                "text": "Le meulon de foin s’est longtemps appelé buriau ou burieu sur une vaste étendue de la Thiérache et du Laonnois : terme de métier, il recule actuellement devant d’autres termes correspondant à des techniques plus évoluées […]"
                            },
                            {
                                "example_id": "7106869a-8add-4448-a509-02f7f212d8c3",
                                "sense_id": "7d381144-aef0-3187-a8fe-c464484e57b3",
                                "text": "Rappelons, en effet, que la Thiérache, au sens géographique, fait partie de trois régions, Champagne-Ardennes, Picardie et Nord-Pas de Calais, qui sont toutes trois des régions fortement céréalières, ou encore dominées par la betteraviculture ou la viticulture."
                            }
                        ]
                    }
