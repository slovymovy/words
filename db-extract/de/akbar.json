                        ],
                        "form": "(den) Akbar"
                    },
                    {
                        "form_id": "f3091226-d544-4468-a084-4fd6412a0234",
                        "entry_id": "2b4cf535-b9be-368d-8ddf-1f44906e40bf",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Akbars"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "228568df-84d6-3e50-921e-a96e3b74546e",
                        "entry_id": "2b4cf535-b9be-368d-8ddf-1f44906e40bf",
                        "glosses": [
                            "vom Vornamen abgeleiteter Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcfe3ad1-4459-4ef4-b491-2c515522df30",
                                "sense_id": "228568df-84d6-3e50-921e-a96e3b74546e",
                                "text": "„Ich glaubte nicht, dass Hamid Akbar es wusste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ad13e328-3880-3f4b-989c-54ce6226312d",
                        "entry_id": "2b4cf535-b9be-368d-8ddf-1f44906e40bf",
                        "glosses": [
                            "vom Vornamen abgeleiteter Familienname",
                            "Abu'l-Fath Jalal-ud-din Muhammad Akbar, von 1556 bis 1605 Herrscher des Mogulreichs"
                        ],
                        "tags": [
                            "short-form"
                        ],
                        "examples": [
                            {
                                "example_id": "a523f422-7287-4457-b8f9-a85eea9f45e6",
                                "sense_id": "ad13e328-3880-3f4b-989c-54ce6226312d",
                                "text": "„Das Kichern verstummt und ein Flüstern dringt durch das Loch in der Wand; ein beiläufiges Flüstern, als wären wir zwei Höflinge in der Audienzhalle der Festung, die auf Akbar den Großen warten.“"
                            },
                            {
                                "example_id": "f823b5a7-f701-4d85-90eb-38c4ab1e557c",
                                "sense_id": "ad13e328-3880-3f4b-989c-54ce6226312d",
                                "text": "„›Oh Kaschmir‹, sang er. Ein Volkslied aus seiner Jugend. Es stammte von Tansen, dem bedeutendsten indischen Musiker überhaupt, der im 16. Jahrhundert am Hof des Mogulkaisers Akbar gelebt hatte.“"
                            },
                            {
                                "example_id": "2c42064a-cd8f-4794-9fea-daf9b0bad2a1",
                                "sense_id": "ad13e328-3880-3f4b-989c-54ce6226312d",
                                "text": "„Akbar beherrschte im 16. Jahrhundert als Kaiser des Mogul-Reiches fast den gesamten indischen Subkontinent.“"
                            },
                            {
                                "example_id": "5cb110b5-6c5e-4dda-abfb-7937013b98d3",
                                "sense_id": "ad13e328-3880-3f4b-989c-54ce6226312d",
                                "text": "„Die dekorative Hindu-Architektur und der geometrische Baustil des Islam vermischen sich zu einem harmonischen Gesamtbild, der rote Sandstein ist durchsetzt mit weißem Marmor und blauen Fliesen, das überaus reichliche Dekor zeugt bis heute von der Pracht am Hofe Akbars.“"
                            },
                            {
                                "example_id": "939faeae-bc41-485f-ac29-6242aa6fab69",
                                "sense_id": "ad13e328-3880-3f4b-989c-54ce6226312d",
                                "text": "„Links musizieren vier Männer, ein Diener schenkt ein Getränk ein, ein weiterer macht sich mit zwei Flaschen Richtung Pavillon auf, unter dessen Baldachin Kaiser Akbar (1555–1605) mit seinen Ministern und Dienern sitzt.“"
                            },
                            {
                                "example_id": "63fdd949-b2d2-48b2-8f76-662be94cc10b",
                                "sense_id": "ad13e328-3880-3f4b-989c-54ce6226312d",
                                "text": "„Das Mausoleum für den Großmogul Humayun in Neu-Delhi, erbaut um 1570 von seinem Sohn und Nachfolger, Akbar, wurde zur Inspiration für das Taj Mahal.“"
                            },
                            {
                                "example_id": "ac721cce-13dd-4c5b-943c-b8b36bb75a77",
                                "sense_id": "ad13e328-3880-3f4b-989c-54ce6226312d",
                                "text": "„Akbar der Große baute feenhafte Paläste und pompöse Haremsanlagen in die Felsenwüste bei Agra, doch seine Luftschlösser hielten der Wüste nicht stand.“"
                            },
                            {
                                "example_id": "ad401538-a7eb-41b4-8b80-eb001d3136b4",
                                "sense_id": "ad13e328-3880-3f4b-989c-54ce6226312d",
                                "text": "„Unter Akbar entstanden die roten Mauern und Tore, unter seinem Enkel Shah Jahan, dem Erbauer des Taj Mahals, die meisten der Hauptgebäude aus demselben roten Sandstein.“"
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    }
