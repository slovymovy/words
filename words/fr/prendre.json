                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "solidification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut attendre quelques heures pour que la colle <w>prenne</w> bien."
                        },
                        {
                            "text": "La sauce a <w>pris</w> rapidement dès que le cuisinier l'a refroidie."
                        }
                    ],
                    "common_phrases": [
                        "laisser prendre"
                    ]
                }
            ]
        }
    ]
