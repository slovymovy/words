                                                "example_id": "f5157138-225e-445f-935c-afb68759c0b8",
                                                "sense_id": "501bd97b-9e8c-3c11-8ab6-d26644b3172c",
                                                "text": "He's managed to chisel a couple dollars from somewhere."
                                            },
                                            {
                                                "example_id": "26dce35b-c04d-4388-af2a-ca1b80a597ca",
                                                "sense_id": "501bd97b-9e8c-3c11-8ab6-d26644b3172c",
                                                "text": "She can always chisel whatever she needs from her father."
                                            },
