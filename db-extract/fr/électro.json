                "senses": [
                    {
                        "sense_id": "9ddb4921-3d21-36a7-b4a1-2d673201a6b1",
                        "entry_id": "13ff041d-ec3b-3725-b572-249bed2a0a86",
                        "glosses": [
                            "Musique électronique caractérisée par l’utilisation de boîtes à rythmes spécifiques (TR-808, TR-909) et d’échantillons de funk."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fc88727-623d-4da0-a518-6429132df4e6",
                                "sense_id": "9ddb4921-3d21-36a7-b4a1-2d673201a6b1",
                                "text": "Certes des initiatives se développent — […] — mais elles nécessitent encore des réseaux autres que ceux du bouche à oreille des passionnés de l’électro."
                            },
                            {
                                "example_id": "153d4fb2-db06-4b98-b7d0-ca62b8ff0731",
                                "sense_id": "9ddb4921-3d21-36a7-b4a1-2d673201a6b1",
                                "text": "Église transformée en temple de la house et de l’électro, le Glória rappelle les discothèques européennes des années 1980 et attire une foule branchée alternative."
                            }
                        ]
                    },
                    {
                        "sense_id": "c06e964f-3412-324d-a01e-7ab94d0eedd1",
                        "entry_id": "13ff041d-ec3b-3725-b572-249bed2a0a86",
                        "glosses": [
                            "Musique électronique correspondant à la première époque du hip hop, illustrant la confrontation entre une musique noire, urbaine et technologique."
                        ],
