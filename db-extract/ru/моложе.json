                        "source_sense_id": "22088ae4-5dfd-32da-8ccb-09f8abd7f660",
                        "target_lang_word": "younger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "younger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c119f29e-3c33-3a36-8fc4-4409af19cb90",
                                        "entry_id": "2991bb32-151f-356d-8dc5-6e9050e1a3d0",
                                        "glosses": [
                                            "comparative form of young: more young"
                                        ],
                                        "tags": [
                                            "comparative",
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44bf179e-3c9c-4afb-b967-b9f04de4b578",
                                                "sense_id": "c119f29e-3c33-3a36-8fc4-4409af19cb90",
                                                "text": "Our neighbors' son is younger than our daughter."
                                            },
                                            {
                                                "example_id": "d7347ec8-3a9f-41c2-95bc-298cb4efa18a",
                                                "sense_id": "c119f29e-3c33-3a36-8fc4-4409af19cb90",
                                                "text": "Reading this book takes me back to my younger days."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "younger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e6dc5496-58dd-390d-b3b0-7c5bd78d2f3c",
                                        "entry_id": "b0a25b59-92a2-335e-bc56-d8baa579fe0c",
                                        "glosses": [
                                            "One who is younger than another."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d645ea1-1cfb-4586-9282-c2f24becdd43",
                                                "sense_id": "e6dc5496-58dd-390d-b3b0-7c5bd78d2f3c",
                                                "text": "Hugh and Charlie also played fairly well, so perhaps it was not wonderful that James, who had always regarded cricket as a childish waste of time, felt rather at a loss, and did not care to display his inferiority to his youngers."
                                            },
                                            {
                                                "example_id": "5f9ee349-0990-4c1b-a6a6-815724e2a430",
                                                "sense_id": "e6dc5496-58dd-390d-b3b0-7c5bd78d2f3c",
                                                "text": "Youngers did not like olders to be mean and bossy."
                                            },
                                            {
                                                "example_id": "f740f29d-f318-4b95-bf3f-4206a3f37d16",
                                                "sense_id": "e6dc5496-58dd-390d-b3b0-7c5bd78d2f3c",
                                                "text": "First, the use of Hindi is more among the males than among the females irrespective of the interaction with elders, equals or youngers."
                                            },
                                            {
                                                "example_id": "9f5d63ba-5ba8-4ac0-b1d5-92248b4dd57c",
                                                "sense_id": "e6dc5496-58dd-390d-b3b0-7c5bd78d2f3c",
                                                "text": "A section of semi-structured interview schedule was also included in the research in order to test if youngers face any problem with elders staying with them."
                                            },
                                            {
                                                "example_id": "028e111d-bd29-4d82-b079-c83ea7b2202e",
                                                "sense_id": "e6dc5496-58dd-390d-b3b0-7c5bd78d2f3c",
                                                "text": "So, it is necessary to educate our youngers about economy and,^([sic]) school and college education can do this easily."
                                            },
                                            {
                                                "example_id": "4729cb15-5849-4636-9923-4089f6ee74b1",
                                                "sense_id": "e6dc5496-58dd-390d-b3b0-7c5bd78d2f3c",
                                                "text": "There are the usual tensions between elders and middles, and between middles and youngers."
                                            },
                                            {
                                                "example_id": "fe0e9ce6-1ffc-44e1-adc9-f4c57c9aaba4",
                                                "sense_id": "e6dc5496-58dd-390d-b3b0-7c5bd78d2f3c",
                                                "text": "Half of them youngers didn't know how much these Brixton olders are affiliated with these Peckham olders"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
