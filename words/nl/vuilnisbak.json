            "senses": [
                {
                    "sense_id": "be4362a8-eb7b-3f20-91e3-4048d5d8fbd5",
                    "sense_definition": "Een bak waarin men huisvuil verzamelt.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "afvalcontainer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gooi dat maar even in de <w>vuilnisbak</w>.",
                            "target_lang_translations": {
                                "en": "Just throw that in the <w>trash can</w>.",
                                "zh": "把那个扔进<w>垃圾桶</w>里就行了。"
                            }
                        },
                        {
                            "text": "De <w>vuilnisbak</w> zit helemaal vol met plastic flessen en papier.",
                            "target_lang_translations": {
                                "en": "The <w>garbage can</w> is completely full of plastic bottles and paper.",
                                "zh": "<w>垃圾桶</w>里装满了塑料瓶和纸张。"
                            }
                        }
                    ],
                    "synonyms": [
                        "afvalbak",
                        "prullenbak"
                    ],
                    "common_phrases": [
                        "in de vuilnisbak"
                    ],
                    "target_lang_definitions": {
                        "en": "A container in which household waste is collected.",
                        "zh": "用于收集家庭垃圾的容器。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "garbage can",
                                "target_lang_sense_clarification": "US/Canada"
                            },
                            {
                                "target_lang_word": "dustbin",
                                "target_lang_sense_clarification": "UK/Ireland"
                            },
                            {
                                "target_lang_word": "trash can",
                                "target_lang_sense_clarification": "US"
                            },
                            {
                                "target_lang_word": "rubbish bin",
                                "target_lang_sense_clarification": "UK/Australia"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "垃圾桶",
                                "target_lang_sense_clarification": "最常用的称呼"
                            },
                            {
                                "target_lang_word": "垃圾箱",
                                "target_lang_sense_clarification": "通常指公共场所或较大的容器"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f09505e9-9f18-3a64-8b1c-e406476b02d5",
                    "sense_definition": "Een hond van een onbepaald of gemengd ras.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "hond",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij hebben geen rashond gekocht, maar een lieve <w>vuilnisbak</w> uit het asiel.",
                            "target_lang_translations": {
                                "en": "They didn't buy a pedigree dog, but a sweet <w>mutt</w> from the shelter.",
                                "zh": "他们没有买纯种狗，而是从收容所领养了一只可爱的<w>杂种狗</w>。"
                            }
                        },
                        {
                            "text": "Onze hond is een echte <w>vuilnisbak</w> die van verschillende rassen afstamt.",
                            "target_lang_translations": {
                                "en": "Our dog is a real <w>mongrel</w> descended from several different breeds.",
                                "zh": "我们的狗是一只真正的<w>串串狗</w>，有着多种血统。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally to refer to a mongrel dog."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A dog of an undetermined or mixed breed.",
                        "zh": "品种不确定或混种的狗。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mongrel",
                                "target_lang_sense_clarification": "mixed-breed dog"
                            },
                            {
                                "target_lang_word": "mutt",
                                "target_lang_sense_clarification": "informal, mixed-breed dog"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "杂种狗",
                                "target_lang_sense_clarification": "指混种犬"
                            },
                            {
                                "target_lang_word": "串串狗",
                                "target_lang_sense_clarification": "口语，指混种犬"
                            }
                        ]
                    }
                }
            ]
        }
    ]
