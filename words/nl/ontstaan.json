                    "sense_definition": "beginnen te bestaan of zich te vormen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "beginnen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de hevige regenval <w>ontstonden</w> er overal diepe plassen op de weg.",
                            "target_lang_translations": {
                                "en": "Due to the heavy rainfall, deep puddles <w>formed</w> everywhere on the road.",
                                "ru": "Из-за сильных дождей повсюду на дороге <w>образовались</w> глубокие лужи."
                            }
                        },
                        {
                            "text": "Er <w>ontstond</w> een groot probleem toen de computer plotseling stopte met werken.",
                            "target_lang_translations": {
                                "en": "A big problem <w>arose</w> when the computer suddenly stopped working.",
                                "ru": "Когда компьютер внезапно перестал работать, <w>возникла</w> большая проблема."
                            }
                        }
                    ],
                    "synonyms": [
                        "tot stand komen",
                        "beginnen"
                    ],
                    "antonyms": [
                        "verdwijnen",
                        "vergaan"
                    ],
                    "common_phrases": [
                        "een probleem ontstaan",
                        "een vriendschap ontstaan",
                        "een idee ontstaan"
                    ],
                    "target_lang_definitions": {
                        "en": "to begin to exist or to take shape",
                        "ru": "начать существовать или формироваться"
                    },
                    "translations": {
