{
    "word_family": [
        "alcohol",
        "alcoholism",
        "nonalcoholic"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "947d5a48-88a2-322e-9ee6-4abf606f5836",
                    "sense_definition": "Having more than a trace amount of alcohol in its contents.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "content",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He ordered an <w>alcoholic</w> beverage with his dinner.",
                            "target_lang_translations": {
                                "ru": "Он заказал <w>алкогольный</w> напиток к ужину.",
                                "zh": "他晚餐时点了一杯<w>含酒精的</w>饮料。"
                            }
                        },
                        {
                            "text": "This punch is <w>alcoholic</w>, so it is not suitable for children.",
                            "target_lang_translations": {
                                "ru": "Этот пунш <w>алкогольный</w>, поэтому он не подходит для детей.",
                                "zh": "这种潘趣酒是<w>含酒精的</w>，所以不适合儿童饮用。"
                            }
                        }
                    ],
                    "synonyms": [
                        "intoxicating",
                        "spirituous",
                        "boozy",
                        "strong"
                    ],
                    "antonyms": [
                        "nonalcoholic",
                        "alcohol-free",
                        "virgin"
                    ],
                    "common_phrases": [
                        "alcoholic beverage",
                        "alcoholic drink",
                        "alcoholic content"
                    ],
                    "target_lang_definitions": {
                        "ru": "Содержащий в своем составе алкоголь; спиртной.",
                        "zh": "指含有酒精成分的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "алкогольный",
                                "target_lang_sense_clarification": "содержащий спирт"
                            },
                            {
                                "target_lang_word": "спиртной",
                                "target_lang_sense_clarification": "о напитках"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "含酒精的",
                                "target_lang_sense_clarification": "指饮料中含有酒精"
                            },
                            {
                                "target_lang_word": "酒精",
                                "target_lang_sense_clarification": "用于修饰饮料或饮品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52cfe304-2a28-3a97-9a8d-25fedd52459d",
                    "sense_definition": "Of, pertaining to, or affected by alcoholism.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient was treated for severe <w>alcoholic</w> poisoning.",
                            "target_lang_translations": {
                                "ru": "Пациента лечили от тяжелого <w>алкогольного</w> отравления.",
                                "zh": "病人因严重的<w>酒精性</w>中毒接受了治疗。"
                            }
                        },
                        {
                            "text": "His <w>alcoholic</w> tendencies caused many problems within the family.",
                            "target_lang_translations": {
                                "ru": "Его <w>алкогольные</w> наклонности создавали много проблем в семье.",
                                "zh": "他有<w>酒精依赖</w>倾向，这给家庭带来了许多问题。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "alcoholic liver disease",
                        "alcoholic stupor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к алкоголизму, вызванный им или страдающий от него.",
                        "zh": "与酗酒或酒精中毒有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "алкогольный",
                                "target_lang_sense_clarification": "связанный с заболеванием"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "酒精性",
                                "target_lang_sense_clarification": "用于医学或病理描述"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a0b353ed-9c5d-330d-a0e8-b136cb5ed28e",
                    "sense_definition": "A person who is addicted to alcohol.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He admitted he was an <w>alcoholic</w> and decided to seek professional help.",
                            "target_lang_translations": {
                                "ru": "Он признал, что он <w>алкоголик</w>, и решил обратиться за профессиональной помощью.",
                                "zh": "他承认自己是个<w>酒鬼</w>，并决定寻求专业帮助。"
                            }
                        },
                        {
                            "text": "A recovering <w>alcoholic</w> often avoids places where liquor is served.",
                            "target_lang_translations": {
                                "ru": "Выздоравливающий <w>алкоголик</w> часто избегает мест, где подают спиртное.",
                                "zh": "正在康复中的<w>酒精依赖者</w>通常会避开供应酒水的地方。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inebriate",
                        "drunk",
                        "problem drinker"
                    ],
                    "antonyms": [
                        "teetotaler",
                        "on the wagon"
                    ],
                    "common_phrases": [
                        "recovering alcoholic",
                        "functioning alcoholic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, страдающий физической и психической зависимостью от алкоголя.",
                        "zh": "患有酒精依赖症的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "алкоголик",
                                "target_lang_sense_clarification": "нейтральное/медицинское"
                            },
                            {
                                "target_lang_word": "пьяница",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "алкаш",
                                "target_lang_sense_clarification": "грубое/сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "酒鬼",
                                "target_lang_sense_clarification": "指酗酒成瘾的人"
                            },
                            {
                                "target_lang_word": "酒精依赖者",
                                "target_lang_sense_clarification": "医学或正式称呼"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}