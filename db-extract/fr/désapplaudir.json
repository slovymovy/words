                ],
                "senses": [
                    {
                        "sense_id": "6e6c0487-4a35-36ae-90ec-38d63c7d791b",
                        "entry_id": "35ccddc0-dccc-33f8-86f5-7f43bec62c49",
                        "glosses": [
                            "Ne pas applaudir, au contraire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb15bfcd-653a-41c1-9b11-0698531b4b90",
                                "sense_id": "6e6c0487-4a35-36ae-90ec-38d63c7d791b",
                                "text": "J’ai offert à ce peuple la liberté pour chacun de mentir, d’insulter qui il veut (sauf moi), de baiser qui il veut, de chier où il veut, je lui ai offert la véritable démocratie et au lieu de m’applaudir, ce peuple m’a désapplaudi !"
                            }
                        ]
                    },
                    {
                        "sense_id": "98eda31b-2726-3e78-bc49-d8dd1925eeff",
                        "entry_id": "35ccddc0-dccc-33f8-86f5-7f43bec62c49",
                        "glosses": [
                            "Ne plus applaudir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6a5e4ea-d77e-4331-81c6-6f93e714c85d",
                                "sense_id": "98eda31b-2726-3e78-bc49-d8dd1925eeff",
                                "text": "Que soit pourtant possible un lyrisme « désapplaudi », « désemporté », c’est ce dont témoigne parfaitement l’œuvre de Dominique Fourcade."
                            },
                            {
                                "example_id": "c4e255c0-5072-43a5-a547-f1eb21953590",
                                "sense_id": "98eda31b-2726-3e78-bc49-d8dd1925eeff",
                                "text": "Je me \"désapplaudis\"."
                            }
                        ]
                    }
                ],
