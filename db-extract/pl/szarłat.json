                                                "text": "Amaranten werden häufig als Ziervögel gehalten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2783e270-9a82-3380-b07c-36af4a960397",
