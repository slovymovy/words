            {
                "entry_id": "f1e3fe84-0209-3899-830e-330250e200c7",
                "word": "méthanation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b5292c04-84a1-40a8-ba3b-15364122e87f",
                        "entry_id": "f1e3fe84-0209-3899-830e-330250e200c7",
                        "tags": [
                            "plural"
                        ],
                        "form": "méthanations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "32756bf3-97bd-39f8-bf66-e916c5103559",
                        "entry_id": "f1e3fe84-0209-3899-830e-330250e200c7",
                        "glosses": [
                            "Processus industriel de conversion catalytique de l'hydrogène et du monoxyde de carbone ou du dioxyde de carbone en méthane."
                        ],
                        "tags": [
                            "Bioénergie"
                        ],
                        "examples": [
                            {
                                "example_id": "59cb659f-d517-4623-b48b-bbf4826020db",
                                "sense_id": "32756bf3-97bd-39f8-bf66-e916c5103559",
                                "text": "La méthanation permet d’obtenir du méthane de synthèse d’origine renouvelable."
                            },
                            {
                                "example_id": "11c03144-40ac-44d9-a7ac-6d2a9d2d7b10",
                                "sense_id": "32756bf3-97bd-39f8-bf66-e916c5103559",
                                "text": "De nombreux industriels développent des programmes pour utiliser l’électrolyse et la méthanation pour le stockage de l’électricité dans les moments excédentaires."
                            },
                            {
                                "example_id": "34c0fa4f-80c6-4a5f-8691-00b99a3e09a7",
                                "sense_id": "32756bf3-97bd-39f8-bf66-e916c5103559",
                                "text": "La méthanation ne doit pas être confondue avec la méthanisation, processus naturel biologique de dégradation de la matière organique en absence d’oxygène, qui transforme la matière organique dégradée essentiellement en biogaz."
                            },
                            {
                                "example_id": "732e1ed7-bef4-4fdb-ab59-e6dd789e0f3a",
                                "sense_id": "32756bf3-97bd-39f8-bf66-e916c5103559",
                                "text": "La purification par méthanation conduit à de l’hydrogène purifié à 97-98 %, à moins qu’elle ne soit suivie d’une séparation cryogénique du méthane et de l'azote afin d’augmenter la pureté."
                            }
                        ]
                    }
                ],
