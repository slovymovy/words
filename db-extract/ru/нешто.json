                "senses": [
                    {
                        "sense_id": "f3020664-6e55-33ba-bfc4-ce51d0e80c62",
                        "entry_id": "743513a6-b8a3-3b94-93fd-8da943f8061f",
                        "glosses": [
                            "прост. неужели, разве"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35928dd8-b01a-426b-9af5-3841fe14ded1",
                                "sense_id": "f3020664-6e55-33ba-bfc4-ce51d0e80c62",
                                "text": "Известное дело ― фрак; нешто не понимаем-с!"
                            },
                            {
                                "example_id": "9a3dd50e-6642-4493-850a-ee04af86dd00",
                                "sense_id": "f3020664-6e55-33ba-bfc4-ce51d0e80c62",
                                "text": "― Не́што мужики ― люди? Не люди, а, извините, зверьё, шарлатаны. Какая у мужика жизнь?"
                            },
                            {
                                "example_id": "a6050c41-cfbe-479d-adc4-51e49811bef4",
                                "sense_id": "f3020664-6e55-33ba-bfc4-ce51d0e80c62",
                                "text": "― Нешто из-за полтинника мокли-то цельный день?"
                            }
                        ]
                    }
                ],
