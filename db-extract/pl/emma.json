                "senses": [
                    {
                        "sense_id": "62c767c7-0b38-3c5a-a937-656baadbd97e",
                        "entry_id": "9fd8e784-bcf1-391d-9ca2-bf090729bef5",
                        "glosses": [
                            "imię żeńskie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a67887c-1d36-4271-b2f4-860742608b5e",
                                "sense_id": "62c767c7-0b38-3c5a-a937-656baadbd97e",
                                "text": "Ciotka Lidii ma na imię Emma."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9ba79b4-956e-4b5d-80a4-1e166d673b1e",
                        "source_entry_id": "9fd8e784-bcf1-391d-9ca2-bf090729bef5",
                        "source_sense_id": "62c767c7-0b38-3c5a-a937-656baadbd97e",
                        "target_lang_word": "Emma",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Emma",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3bb006c3-0c2a-3702-bff4-bf790ba871f9",
                                        "entry_id": "b8b7e37f-81e7-34a8-9d4e-b9e164eb6745",
                                        "glosses": [
                                            "A female given name from the Germanic languages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ae46480-45fa-41e7-b968-61b735542942",
                                                "sense_id": "3bb006c3-0c2a-3702-bff4-bf790ba871f9",
                                                "text": "Both Saxon and Norman chroniclers unite in representing the youthful Queen Emma as in a peculiar degree gifted with elegance and beauty; so that many flattering epithets had been bestowed on her - as \"the Pearl,\" \"the Flower,\" or \"the Fair Maid\" of Normandy."
                                            },
                                            {
                                                "example_id": "0bf6f92d-4b17-45af-9bb5-ed7832f945c4",
                                                "sense_id": "3bb006c3-0c2a-3702-bff4-bf790ba871f9",
                                                "text": "Emma Calvé...since Madame Bovary the name Emma suggests a solid bourgeois foundation, a country family...Emma Eames, a chilly name...a wind from the East."
                                            },
                                            {
                                                "example_id": "cb4a15c4-80e7-4abd-afd1-5231fc8a6818",
                                                "sense_id": "3bb006c3-0c2a-3702-bff4-bf790ba871f9",
                                                "text": "The cottage now belonged to Emma's mother Beatrix, who was a tutor in English literature at a women's college, specialising in eighteenth- and nineteenth-century novel. This may have accounted for Emma's Christian name, for it had seemed to Beatrix unfair to call her daughter Emily, a name associated with her grandmother's servants rather than the author of The Wuthering Heights, so Emma had been chosen, perhaps with the hope that some of the qualities possessed by the heroine of the novel might be perpetuated."
                                            },
                                            {
                                                "example_id": "27467bac-3f1a-4885-9185-fe93ffdd2ffd",
                                                "sense_id": "3bb006c3-0c2a-3702-bff4-bf790ba871f9",
                                                "text": "Ken Cuccinelli tweaked the famous poem from Emma Lazarus – whose words, “Give me your tired, your poor, your huddled masses yearning to breathe free” are long associated with immigration to the US and the nation’s history as a haven – as part of a case for strict new measures pushed Monday by the Trump administration that could dramatically change the legal immigration system."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73d7ec8a-8270-45a1-9ad1-d9debfd77ce5",
                        "source_entry_id": "9fd8e784-bcf1-391d-9ca2-bf090729bef5",
                        "source_sense_id": "62c767c7-0b38-3c5a-a937-656baadbd97e",
                        "target_lang_word": "Emma",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "15d16128-3437-4fed-a085-4a80fe4e9aa7",
                        "source_entry_id": "9fd8e784-bcf1-391d-9ca2-bf090729bef5",
                        "source_sense_id": "62c767c7-0b38-3c5a-a937-656baadbd97e",
                        "target_lang_word": "Emma",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Emma",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4332b7ea-8496-334a-846d-87169a7e522c",
                                        "entry_id": "b50f0124-2df1-3027-a085-305d9ff54036",
                                        "glosses": [
                                            "weiblicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d303b6f6-a96b-405d-b165-1ce2fd3c144c",
                                                "sense_id": "4332b7ea-8496-334a-846d-87169a7e522c",
                                                "text": "Die kleine Emma möchte im Kinderparadies abgeholt werden."
                                            },
                                            {
                                                "example_id": "70435eac-758a-480a-9c1b-a829f16c7218",
                                                "sense_id": "4332b7ea-8496-334a-846d-87169a7e522c",
                                                "text": "Emma Mustermann ist ein schönes Mädchen."
                                            },
                                            {
                                                "example_id": "aa099067-027e-4f71-ba0c-35f491805b7a",
                                                "sense_id": "4332b7ea-8496-334a-846d-87169a7e522c",
                                                "text": "Emma ist 20 Jahre alt."
                                            },
                                            {
                                                "example_id": "e9174fda-13d9-49ee-b726-50de5fe731da",
                                                "sense_id": "4332b7ea-8496-334a-846d-87169a7e522c",
                                                "text": "Grüß bitte Emma Mustermann herzlich von mir."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Emma",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7897fe31-0124-3f42-947e-cc75e537bd43",
                                        "entry_id": "00edb860-487e-33db-a915-a5060d4ddf1c",
                                        "glosses": [
                                            "Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e32b471e-2c28-4223-a73b-e68cee9b2848",
                                                "sense_id": "7897fe31-0124-3f42-947e-cc75e537bd43",
                                                "text": "Frau Emma ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "a0fb269b-dec4-4202-ae76-21f97780e6bb",
                                                "sense_id": "7897fe31-0124-3f42-947e-cc75e537bd43",
                                                "text": "Herr Emma wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "4843e88e-b505-4d73-9444-6c0cfb6f4c7e",
                                                "sense_id": "7897fe31-0124-3f42-947e-cc75e537bd43",
                                                "text": "Die Emmas kommen heute aus Saarbrücken."
                                            },
                                            {
                                                "example_id": "67a1083a-1229-4bba-a8b0-eaf2af2a04f9",
                                                "sense_id": "7897fe31-0124-3f42-947e-cc75e537bd43",
                                                "text": "Der Emma trägt nie die Schals, die die Emma ihm strickt."
                                            },
                                            {
                                                "example_id": "506b55be-cc95-4718-a7fe-b0844eda134b",
                                                "sense_id": "7897fe31-0124-3f42-947e-cc75e537bd43",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Emma kommt, geht der Herr Emma.“"
                                            },
                                            {
                                                "example_id": "b9244884-a6b5-4674-9d4d-2d3b53b5a914",
                                                "sense_id": "7897fe31-0124-3f42-947e-cc75e537bd43",
                                                "text": "Emma kommt und geht."
                                            },
                                            {
                                                "example_id": "9cb5374b-033e-4356-beaf-4e2a8be7fe81",
                                                "sense_id": "7897fe31-0124-3f42-947e-cc75e537bd43",
                                                "text": "Emmas kamen, sahen und siegten."
                                            },
                                            {
                                                "example_id": "671c24e6-7274-47a4-94b6-553409a797ef",
                                                "sense_id": "7897fe31-0124-3f42-947e-cc75e537bd43",
                                                "text": "An verregneten Herbsttagen ist Familie Emmas liebste Beschäftigung das Bemalen von Hühnereiern."
                                            },
                                            {
                                                "example_id": "78441aac-9746-4503-81e7-b9c79a1c89a3",
                                                "sense_id": "7897fe31-0124-3f42-947e-cc75e537bd43",
                                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Emma das Schmücken von Weihnachtsbäumen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
