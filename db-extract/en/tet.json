                        "sense_id": "84c706bf-351c-3b57-8a03-f625322c4294",
                        "entry_id": "a2becf98-0a08-330c-9871-5d132d515fa4",
                        "glosses": [
                            "A tetra (freshwater fish)."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "fd45c258-0782-45bf-81b7-9cc9eb6dc76c",
                                "sense_id": "84c706bf-351c-3b57-8a03-f625322c4294",
                                "text": "All the tetras in my tank (3 species - black neons, Pristellas, and red eyes) died within a 36 hour period. The corys and otos in the same tank are fine.\nThere was no change in water quality, feeding habits, or water temperature. I have no idea why all the tets would die in such a short time span."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
