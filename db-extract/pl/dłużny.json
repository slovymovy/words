                        "cross_references": [
                            {
                                "target_word": "indebted",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8457fac-d41a-34a2-9c3b-651636b90024",
                                        "entry_id": "c24db94e-8fc8-3cb8-bdea-d7a55ee38b27",
                                        "glosses": [
                                            "simple past and past participle of indebt"
                                        ],
                                        "tags": [
