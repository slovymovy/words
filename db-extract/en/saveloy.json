                    },
                    {
                        "translation_id": "26737692-7268-4bbb-8bdc-7259ad189d38",
                        "source_entry_id": "ada55139-e238-3afe-a126-25d287be78cb",
                        "source_sense_id": "1a4f3bc2-5b29-3c33-8c02-22c974bf1a9c",
