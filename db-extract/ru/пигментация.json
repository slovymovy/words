                                "target_senses": [
                                    {
                                        "sense_id": "02513201-8bb8-3f88-b792-4d39e657f6b0",
                                        "entry_id": "ea202976-9e4b-3093-b754-81e9cbd4befa",
                                        "glosses": [
                                            "distribuzione di pigmenti in un essere vivente animale o vegetale, in grado di formare particolari disegni"
                                        ],
                                        "tags": [],
