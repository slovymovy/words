                ],
                "senses": [
                    {
                        "sense_id": "2f187054-a136-3a2c-b938-7cb7ca56dd95",
                        "entry_id": "aba47bb1-eeac-3c9a-924e-2b165aafcdd2",
                        "glosses": [
                            "разг. начать пинаться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0392f7e4-5f71-486a-941c-813798c14b86",
                                "sense_id": "2f187054-a136-3a2c-b938-7cb7ca56dd95",
                                "text": "Девочки, если малыш распинался не на шутку в животе, то что это значит?"
                            }
                        ]
                    },
                    {
                        "sense_id": "0a451b28-004a-36d1-a9b4-b194aaea9406",
                        "entry_id": "aba47bb1-eeac-3c9a-924e-2b165aafcdd2",
                        "glosses": [
                            "разг. (обычно о ребёнке) находясь под одеялами, пелёнками, раскрыться, разбросав их пинками"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "090d69b8-57f4-4a92-b4da-e2b65a25d0d1",
                                "sense_id": "0a451b28-004a-36d1-a9b4-b194aaea9406",
                                "text": "Она маленькая, распинается ночью, вот и простудилась."
                            },
                            {
                                "example_id": "fb0a4e74-9576-4d33-a2a4-961a2e557e61",
                                "sense_id": "0a451b28-004a-36d1-a9b4-b194aaea9406",
                                "text": "Девчонки без ума спят, распинались все."
                            }
                        ]
                    }
                ],
