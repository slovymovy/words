                        "translation_id": "293ede9b-1672-4d98-90f0-b7d5550c07aa",
                        "source_entry_id": "1ca0ab5f-c830-3d25-8b8d-113eefd9e505",
                        "source_sense_id": "8ef4ee64-eb8b-330a-8fcb-0ffba4dc4f82",
                        "target_lang_word": "disparate",
