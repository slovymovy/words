                ],
                "senses": [
                    {
                        "sense_id": "608f154a-3f6c-3def-9ff7-5b03400f20a5",
                        "entry_id": "4267a58f-7024-3094-a040-f4582abca00c",
                        "glosses": [
                            "A translucent, reddish type of zircon used as a gemstone; a hyacinth."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6424edb4-b2fa-4d40-a040-07ddadae13ac",
                                "sense_id": "608f154a-3f6c-3def-9ff7-5b03400f20a5",
                                "text": "The fift Sardonix, the sixt Sardius, the seuenth Chrysolite, the eight Beryl, the ninth a Topas, the tenth a Chrysoprasus, the eleuenth a Iacinct, the twelfth an Amethyst."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bb0ca056-f4d3-4519-9b2d-f752cc62f6f6",
                        "source_entry_id": "4267a58f-7024-3094-a040-f4582abca00c",
                        "source_sense_id": "608f154a-3f6c-3def-9ff7-5b03400f20a5",
                        "source_sense_description": "a gemstone",
                        "target_lang_word": "hiacynt",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hiacynt",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "0a25c84a-b1b6-33e7-a52f-e0a9afc50172",
                                        "entry_id": "2a849e63-02b3-3c29-840a-6d657c826525",
                                        "glosses": [
                                            "wieloletnia roślina cebulowa z rodzaju Hyacinthus L. o ozdobnych kwiatach"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1ef5ae6-f343-45e2-a389-1b47aac3b928",
                                                "sense_id": "0a25c84a-b1b6-33e7-a52f-e0a9afc50172",
                                                "text": "Korzystne dla hiacyntów jest coroczne ich wykopywanie na początku lata i sadzenie jesienią w inne, żyzne miejsce."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "3a6c2222-a965-37df-84cd-90406cfb512d",
                                        "entry_id": "2a849e63-02b3-3c29-840a-6d657c826525",
                                        "glosses": [
                                            "kwiat hiacynta (1.1)"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a50a6c0-ec1b-4048-9970-a3a683263fd8",
                                                "sense_id": "3a6c2222-a965-37df-84cd-90406cfb512d",
                                                "text": "Hiacynt jest ulubionym kwiatem mojej mamy."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "81082618-6926-39b6-b9af-5337f90c97cd",
                                        "entry_id": "2a849e63-02b3-3c29-840a-6d657c826525",
                                        "glosses": [
                                            "przezroczysta odmiana cyrkonu o barwie czerwonopomarańczowej, czerwonej, żółtej lub czerwonobrunatnej"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1a42bb0-a563-497d-be45-d0cda1c25afe",
                                                "sense_id": "81082618-6926-39b6-b9af-5337f90c97cd",
                                                "text": "Hiacynt to bardzo rzadki minerał kolekcjonerski i cenny kamień jubilerski."
                                            },
                                            {
                                                "example_id": "0622a6f4-d7a7-402d-9218-c846242cd2c5",
                                                "sense_id": "81082618-6926-39b6-b9af-5337f90c97cd",
                                                "text": "I nabiorą złota, i hiacyntu, i szarłatu, i karmazynu dwakroć farbowanego, i bisioru"
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "23ddebcb-94a5-365e-8720-b1180c86da64",
                                        "entry_id": "2a849e63-02b3-3c29-840a-6d657c826525",
                                        "glosses": [
                                            "niewłaściwa, handlowa nazwa niektórych odmian szafiru, hessonitu, topazu, grossularu i spinelu, które przypominają hiacynt (1.3)"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "649ef0aa-408d-4240-9c53-7379c7187883",
                                                "sense_id": "23ddebcb-94a5-365e-8720-b1180c86da64",
                                                "text": "Kupiłam sobie tanią broszkę z hiacyntem."
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
                                    },
                                    {
                                        "sense_id": "19b5b735-fff0-3c5e-86c5-7f1d386891c3",
                                        "entry_id": "2a849e63-02b3-3c29-840a-6d657c826525",
                                        "glosses": [
                                            "zob. hiacynt wodny"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1.5\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9625ea2f-860b-4df1-8823-553fc13823f5",
                        "source_entry_id": "4267a58f-7024-3094-a040-f4582abca00c",
                        "source_sense_id": "608f154a-3f6c-3def-9ff7-5b03400f20a5",
                        "source_sense_description": "a gemstone",
                        "target_lang_word": "гиаци́нт",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "гиаци́нт",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6aa7139d-25f3-3361-9319-3bb8f39d3da1",
                                        "entry_id": "6a716453-9e78-3949-8cdd-697bb60999b5",
                                        "glosses": [
                                            "ботан. растение из семейства гиацинтовых (Hyacinthus L.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "782547a0-cde7-4c5c-ac25-42700282481a",
                                                "sense_id": "6aa7139d-25f3-3361-9319-3bb8f39d3da1",
                                                "text": "Гораздо дольше цветут таинственные лилово-розовые гиацинты, славящиеся своим неповторимым дурманящим ароматом."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa07ef98-b65f-358e-a4a3-dc6f57022318",
                                        "entry_id": "6a716453-9e78-3949-8cdd-697bb60999b5",
                                        "glosses": [
                                            "цветок этого растения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d0e2ac0-f265-4b63-80f5-4705cf09b7f7",
                                                "sense_id": "fa07ef98-b65f-358e-a4a3-dc6f57022318",
                                                "text": "И мальчик знал, что как раз к самой пасхе чудесно появятся на толстой ножке тугие, кудрявые соцветия бледно-розовых, белых и лиловых гиацинтов. ❬…❭ Это было так же невозможно, как угадать, какого цвета распустится к первому дню пасхи гиацинт из бледной ножки."
                                            },
                                            {
                                                "example_id": "82a3de7d-2d21-4bd1-a7ea-9de8b80e7d59",
                                                "sense_id": "fa07ef98-b65f-358e-a4a3-dc6f57022318",
                                                "text": "Ещё Гомер сравнивает убранные волосы с гиацинтом, и, пожалуй, так специально и завивали свои волосы греческие дамы — гиацинтообразно."
                                            },
                                            {
                                                "example_id": "5b95d322-fcf7-45a0-9de3-d0ab3b10962e",
                                                "sense_id": "fa07ef98-b65f-358e-a4a3-dc6f57022318",
                                                "text": "Я иду в первый класс: мышиного цвета костюмчик, школьная форма; счастье в глазах; огромный букет гиацинтов в руках."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "гиаци́нт",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e1055c96-3a5d-342d-bde5-95133e1dc356",
                                        "entry_id": "f7766b30-8448-3039-8782-622952470b45",
                                        "glosses": [
                                            "минер. драгоценный камень красного, оранжевого или жёлтого цвета, разновидность циркона"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95fd9d83-c4bd-4a23-8105-0775dc13d71a",
                                                "sense_id": "e1055c96-3a5d-342d-bde5-95133e1dc356",
                                                "text": "Затем следовали двадцать три кольца, более всего бриллиантовых, но были среди них также сапфиры, александриты, лунный камень, турмалины и гиацинты."
                                            },
                                            {
                                                "example_id": "7fb435dc-b715-4374-b02b-05482bff8593",
                                                "sense_id": "e1055c96-3a5d-342d-bde5-95133e1dc356",
                                                "text": "Излюбленными становятся светло-сиреневые аметисты, нежно-голубые аквамарины, гиацинты и, конечно же, бриллианты."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
