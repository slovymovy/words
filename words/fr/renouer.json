                {
                    "sense_id": "c189e137-882d-3248-9809-08f3bfd310c8",
                    "sense_definition": "Retrouver ou recommencer une habitude, une tradition ou un état interrompu.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reprise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette équipe sportive espère bien <w>renouer</w> avec le succès après une série de défaites.",
                            "target_lang_translations": {
                                "en": "This sports team is certainly hoping to <w>regain</w> success after a run of defeats.",
                                "ru": "Эта спортивная команда очень надеется <w>вернуть</w> себе успех после череды поражений.",
                                "de": "Diese Sportmannschaft hofft sehr, nach einer Serie von Niederlagen den Erfolg <w>zurückzugewinnen</w>.",
                                "es": "Este equipo deportivo espera de verdad <w>recuperar</w> el éxito tras una serie de derrotas.",
                                "zh": "这支运动队在连续失利之后，十分希望<w>重振</w>雄风。"
                            }
                        },
                        {
                            "text": "L'orateur prend un moment de silence pour <w>renouer</w> le fil de son discours.",
                            "target_lang_translations": {
                                "en": "The speaker falls silent for a moment to <w>resume</w> the thread of his speech.",
                                "ru": "Оратор делает паузу, чтобы <w>возобновить</w> нить своей речи.",
                                "de": "Der Redner schweigt einen Moment, um den Faden seiner Rede <w>wiederaufzunehmen</w>.",
                                "es": "El orador guarda un momento de silencio para <w>retomar</w> el hilo de su discurso.",
                                "zh": "演讲者沉默了片刻，以便<w>重拾</w>演讲的思路。"
                            }
                        }
                    ],
                    "synonyms": [
                        "retrouver"
                    ],
                    "antonyms": [
                        "abandonner",
                        "délaisser"
                    ],
                    "common_phrases": [
                        "renouer avec le succès",
                        "renouer avec la tradition",
                        "renouer le fil"
                    ],
                    "target_lang_definitions": {
                        "en": "To regain or resume a habit, tradition or state that was interrupted.",
                        "ru": "Вновь обрести или возобновить привычку, традицию или прерванное состояние.",
                        "de": "Eine Gewohnheit, Tradition oder einen unterbrochenen Zustand wiedererlangen oder wieder aufnehmen.",
                        "es": "Recuperar o volver a empezar un hábito, una tradición o un estado que se había interrumpido.",
                        "zh": "重新找回或恢复中断的习惯、传统或状态。"
                    },
