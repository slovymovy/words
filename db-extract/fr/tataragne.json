                                        "sense_id": "245413c9-571a-3206-827c-6d9c9286625b",
                                        "entry_id": "f73d8d49-333c-3d8d-8c9d-eed8626570d7",
                                        "glosses": [
                                            "Any of various eight-legged, predatory arthropods, of the order Araneae, most of which spin webs to catch prey."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cc010c5-de48-4de9-a025-43d6f14c7804",
                                                "sense_id": "245413c9-571a-3206-827c-6d9c9286625b",
                                                "text": "Little Miss Muffet, She sat on a tuffet, Eating of curds and whey; There came a little spider, Who sat down beside her, And frighted Miss Muffet away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "168bf2e6-b715-3099-89df-6c3d7e90cc55",
                                        "entry_id": "f73d8d49-333c-3d8d-8c9d-eed8626570d7",
                                        "glosses": [
                                            "A program which follows links on the World Wide Web in order to gather information."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e612ff6-c09c-4b3f-b099-0546fbacacfb",
                                                "sense_id": "168bf2e6-b715-3099-89df-6c3d7e90cc55",
                                                "text": "Crawler-based search engines have three major elements. The first is the spider, also called the crawler, which visits a web page, reads it, and then follows links to other pages within the site."
                                            }
                                        ]
                                    },
