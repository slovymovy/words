                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2e7e00a-c084-4a37-8241-36f84436e64f",
                        "source_entry_id": "97727754-7b80-3f34-a252-55ad917f8666",
                        "source_sense_id": "69a1ff13-59d6-30c4-a75e-deebf1e974e8",
                        "target_lang_word": "decubitus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "decubitus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c2c73ff-1a71-3b5d-905d-4d78b01585d4",
                                        "entry_id": "8639cdcc-8db4-38bc-8998-fb97cfa618b0",
                                        "glosses": [
                                            "The posture of someone in bed, lying down or reclining."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a9ec9e6-8752-498b-a860-92c56fc4fe74",
                                                "sense_id": "8c2c73ff-1a71-3b5d-905d-4d78b01585d4",
                                                "text": "The initial recesses of the pleural cavity filled with blood effusion are declivitous; they can vary according to the decubitus, whereas, with the progressive filling of the pleural cavity, blood is invariably collected in the lateral pleural spaces over the apex of the lung (apical cap): they are very large pleural effusions, in the order of about 800-1200 cc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dea2e9b-218c-3cc3-a066-f896faae908d",
                                        "entry_id": "8639cdcc-8db4-38bc-8998-fb97cfa618b0",
                                        "glosses": [
                                            "Ellipsis of decubitus ulcer."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "975eba53-3479-4d87-9777-9c68dd921cc6",
