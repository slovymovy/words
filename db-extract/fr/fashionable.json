                "senses": [
                    {
                        "sense_id": "4848d122-f651-38e8-8a99-25b6fb61e2de",
                        "entry_id": "2fa79ee6-c5b5-31a2-8e75-fe75fbe1292d",
                        "glosses": [
                            "Personne qui suit la mode, fashionista."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "cd096273-3ae3-46f9-bf89-444b474dc826",
                                "sense_id": "4848d122-f651-38e8-8a99-25b6fb61e2de",
                                "text": "Son costume avait ce caractère de recherche et de propreté qui distingue les fashionables de la prude Angleterre."
                            },
                            {
                                "example_id": "b5237384-01e7-4735-9587-adc9559467d4",
                                "sense_id": "4848d122-f651-38e8-8a99-25b6fb61e2de",
                                "text": "Il te sied bien de faire le fashionable (que le diable soit des mots anglais !) quand tu ne peux pas payer ton tailleur !"
                            },
                            {
                                "example_id": "908b2636-f5e4-4ebd-bc90-da2b925b87df",
                                "sense_id": "4848d122-f651-38e8-8a99-25b6fb61e2de",
                                "text": "Ce fashionable eut l’audace de prendre tilbury, groom, et de hanter les clubs."
                            },
                            {
                                "example_id": "6b1a7fbb-49e4-4625-aaf2-631d4f8b3416",
                                "sense_id": "4848d122-f651-38e8-8a99-25b6fb61e2de",
                                "text": "L’heure vint ; il s’habilla, la toilette fut longue ; comme tous les artistes (quand ils ne sont pas sales à faire peur), Onuphrius était recherché dans sa mise, non que ce fût un fashionable, mais il cherchait à donner à nos pitoyables vêtements un galbe pittoresque, une tournure moins prosaïque."
                            }
                        ]
                    }
