                                        "sense_id": "94051470-b475-390d-9a79-d896a6c575cb",
                                        "entry_id": "80153709-6749-35e2-a0e9-3204f63f5ba7",
                                        "glosses": [
                                            "motorbetriebene Säge mit einem runden Sägeblatt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fec74372-4837-454f-92bf-d7b24e2e40ac",
                                                "sense_id": "94051470-b475-390d-9a79-d896a6c575cb",
                                                "text": "Die Bretter wurden mit der Kreissäge in kürzester Zeit durchgesägt."
                                            },
                                            {
                                                "example_id": "9d5082b2-9e2a-470d-b5fd-5352b5eee935",
                                                "sense_id": "94051470-b475-390d-9a79-d896a6c575cb",
                                                "text": "Eine Kreissäge ohne Schutzvorrichtungen ist sehr gefährlich, da man sich leicht einen Finger abschneidet oder mit Kleidungsstücken darin hängen bleiben kann."
                                            },
                                            {
                                                "example_id": "fbbe1974-76f0-40ce-a043-7b3718f94aba",
                                                "sense_id": "94051470-b475-390d-9a79-d896a6c575cb",
                                                "text": "„Kreissägen schnitten mit schriller Ungeduld in die alten Stämme.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3d976a66-e725-3873-b7b7-cc28ce1bac54",
                                        "entry_id": "80153709-6749-35e2-a0e9-3204f63f5ba7",
                                        "glosses": [
                                            "scherzhafte Bezeichnung für den kreisrunden, steifen Strohhut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5485c5a3-ae24-432c-bb0a-6feb81a692eb",
                                                "sense_id": "3d976a66-e725-3873-b7b7-cc28ce1bac54",
                                                "text": "Der Florentiner Strohhut wurde wegen seiner kreisrunden Form auch als Kreissäge bezeichnet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
