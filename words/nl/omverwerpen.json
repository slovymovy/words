{
    "word_family": [
        "omverwerping",
        "werpen",
        "worp"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7338ec93-138e-3f1c-a505-2b1d28090551",
                    "sense_definition": "iets door een worp of stoot doen omvallen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met een zware bal probeerde hij alle houten kegels in één keer <w>omver</w> te <w>werpen</w>.",
                            "target_lang_translations": {
                                "en": "With a heavy ball, he tried to <w>knock down</w> all the wooden skittles in one go."
                            }
                        },
                        {
                            "text": "Tijdens het rennen <w>wierp</w> het kind per ongeluk een stapel dozen <w>omver</w>.",
                            "target_lang_translations": {
                                "en": "While running, the child accidentally <w>knocked over</w> a stack of boxes."
                            }
                        }
                    ],
                    "synonyms": [
                        "omgooien",
                        "omsmijten"
                    ],
                    "antonyms": [
                        "oprichten",
                        "overeindzetten"
                    ],
                    "common_phrases": [
                        "een stapel omverwerpen",
                        "kegels omverwerpen"
                    ],
                    "target_lang_definitions": {
                        "en": "to knock something over or cause it to fall by throwing or pushing"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "knock over",
                                "target_lang_sense_clarification": "objects or standing items"
                            },
                            {
                                "target_lang_word": "topple",
                                "target_lang_sense_clarification": "cause to fall down"
                            },
                            {
                                "target_lang_word": "knock down",
                                "target_lang_sense_clarification": "strike down to the ground"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "abc95487-cfa4-3ea6-8853-a2157e600b4f",
                    "sense_definition": "een regering, bewind of heersende orde met geweld ten val brengen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuurlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rebellen wilden de zittende regering <w>omverwerpen</w> om zelf de controle over het land over te nemen.",
                            "target_lang_translations": {
                                "en": "The rebels wanted to <w>overthrow</w> the sitting government to take control of the country themselves."
                            }
                        },
                        {
                            "text": "Het leger <w>wierp</w> in een gewelddadige opstand het corrupte bewind van de dictator <w>omver</w>.",
                            "target_lang_translations": {
                                "en": "In a violent uprising, the army <w>toppled</w> the dictator's corrupt regime."
                            }
                        }
                    ],
                    "synonyms": [
                        "ombuigt",
                        "onttronen",
                        "verjagen"
                    ],
                    "antonyms": [
                        "handhaven",
                        "vestigen"
                    ],
                    "common_phrases": [
                        "het bewind omverwerpen",
                        "de regering omverwerpen"
                    ],
                    "target_lang_definitions": {
                        "en": "to bring down a government, regime, or established order by force"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "overthrow",
                                "target_lang_sense_clarification": "a government or ruler"
                            },
                            {
                                "target_lang_word": "topple",
                                "target_lang_sense_clarification": "a regime or leader"
                            },
                            {
                                "target_lang_word": "bring down",
                                "target_lang_sense_clarification": "cause to fall from power"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}