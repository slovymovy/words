                "senses": [
                    {
                        "sense_id": "27f82c16-75e6-32c8-ac47-9662c3a755be",
                        "entry_id": "8f3550b4-d4d6-37b0-8850-2e888a2fcd62",
                        "glosses": [
                            "Vorrichtung an den Tragflächen eines Flugzeugs, die einen höheren Auftrieb erzeugen und somit ein langsameres Fliegen erlauben"
                        ],
                        "tags": [
                            "Luftfahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "bd0a0c38-2115-4f25-84bb-47ded52dafc0",
                                "sense_id": "27f82c16-75e6-32c8-ac47-9662c3a755be",
                                "text": "Man kann schon einen Schreck bekommen, wenn man zum ersten Mal spürt, wie die Landeklappen eines Flugzeugs ausgefahren werden."
                            },
                            {
                                "example_id": "e2502795-c367-4a72-8e4c-8899e4209c84",
                                "sense_id": "27f82c16-75e6-32c8-ac47-9662c3a755be",
                                "text": "Die ausgefahrenen Landeklappen entwickeln eine starke Bremswirkung."
                            },
                            {
                                "example_id": "e5584b04-13b7-469d-a1a7-9ab13d40f6df",
                                "sense_id": "27f82c16-75e6-32c8-ac47-9662c3a755be",
                                "text": "„Drei Minuten später wird dem Piloten ein Problem mit den Landeklappen angezeigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e8ed1d4a-2717-4334-9136-7726d83de718",
