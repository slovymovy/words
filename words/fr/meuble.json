                {
                    "sense_id": "12f4c104-34c0-326f-ba43-f5ab5b8d7f11",
                    "sense_definition": "Objet mobile servant à l'aménagement, à l'usage ou à la décoration d'un lieu d'habitation (table, chaise, armoire, lit, etc.).",
