                                "target_senses": [
                                    {
                                        "sense_id": "b685f646-a6ac-337a-a48a-f88ea4a6334d",
                                        "entry_id": "7dbdfe8f-aba3-375f-82de-633ad1df42f9",
                                        "glosses": [
                                            "The process of supplying food."
                                        ],
                                        "tags": [
                                            "especially",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9c5b798-ec80-4610-92cd-f586a500e9c0",
                                                "sense_id": "b685f646-a6ac-337a-a48a-f88ea4a6334d",
                                                "text": "The High Treasurer of the Armie […] hath […] the superintendencie of the victualling of the campe […]"
                                            },
                                            {
                                                "example_id": "d92f9c87-6772-48a6-b69f-5197f9814fce",
                                                "sense_id": "b685f646-a6ac-337a-a48a-f88ea4a6334d",
                                                "text": "[…] Lieutenant Hirsch appeared with a sheaf of signals in his hand. He took these from the young man and read them through. Mostly they dealt with routine matters of the fuelling and victualling, but one from the Third Naval Member’s office was unexpected."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c2de330-73fe-363e-a91e-b3798047effa",
                                        "entry_id": "7dbdfe8f-aba3-375f-82de-633ad1df42f9",
                                        "glosses": [
                                            "Provisions of food."
                                        ],
                                        "tags": [
                                            "especially",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0649a53a-3448-4919-b8b6-1637f1721f39",
                                                "sense_id": "2c2de330-73fe-363e-a91e-b3798047effa",
                                                "text": "1624, Patrick Simson (editor), The Historie of the Church, London: John Bellamie, Book 2, Centurie VI, p. 361,\nZosymas a monke is commended […] for the miracle of the Lyon, who slew the Asse that caried his victualing to Caesarea, and likewise the Lyon by his mandate was compelled to beare that same burden which the Asse had borne to the portes of Caesarea."
                                            },
                                            {
                                                "example_id": "f4bcda6b-4635-4954-a00a-a38b5057c2a5",
                                                "sense_id": "2c2de330-73fe-363e-a91e-b3798047effa",
                                                "text": "He was oblig’d often to set upon the Enemy, and skirmish with them; for he wanted both Victualling for his Men, and Forage for his Horse […]"
                                            },
                                            {
                                                "example_id": "f94f50e9-01a4-4ab4-98f9-d24d87cb9ee6",
                                                "sense_id": "2c2de330-73fe-363e-a91e-b3798047effa",
                                                "text": "[…] as each man has a vote in all the affairs of his parish, and for his own sake must wish well to the public, the land is let in very small farms, which makes employment for a greater number of hands, and makes more victualling of all kinds be raised."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
