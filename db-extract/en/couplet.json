                ],
                "senses": [
                    {
                        "sense_id": "6830b4b5-38a9-3779-8202-aac348f5ff47",
                        "entry_id": "0127cd8e-ba76-3ca7-8884-e1e282c2f83d",
                        "glosses": [
                            "A set of two things, particularly.",
                            "A pair of lines, typically with rhyming end words."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a6fcbda0-a577-3c11-a543-681b4b89188a",
                        "entry_id": "0127cd8e-ba76-3ca7-8884-e1e282c2f83d",
                        "glosses": [
                            "A set of two things, particularly.",
                            "A pair of one-way streets which carry opposing directions of traffic through gridded urban areas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78479f09-e95d-4b9b-b9d8-d73221994f0f",
                                "sense_id": "a6fcbda0-a577-3c11-a543-681b4b89188a",
                                "text": "5th Street is one-way west only and 6th Street is one-way east only. Together, they form a couplet in Downtown Los Angeles."
                            }
                        ]
                    },
                    {
                        "sense_id": "e8d52100-fd6a-3205-a1bd-699144776f27",
                        "entry_id": "0127cd8e-ba76-3ca7-8884-e1e282c2f83d",
                        "glosses": [
                            "A set of two things, particularly.",
                            "A pair of two mutually exclusive choices in a dichotomous key."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25e72a6c-38b5-489a-a203-42346dc67497",
                                "sense_id": "e8d52100-fd6a-3205-a1bd-699144776f27",
                                "text": "The dichotomous keys are constructed so that each couplet presents a set of alternative choices."
                            },
                            {
                                "example_id": "3db0830c-e196-4e3e-977b-965dc3f5a986",
                                "sense_id": "e8d52100-fd6a-3205-a1bd-699144776f27",
                                "text": "As long as the correct statement of each couplet is chosen, and the unknown organism is included in the key, a confident identification is usually achieved."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b135fad-a8bc-4a7e-a8e2-17f79be389b4",
                        "source_entry_id": "0127cd8e-ba76-3ca7-8884-e1e282c2f83d",
                        "source_sense_description": "in poetry, a pair of lines with rhyming end words",
                        "target_lang_word": "dvojverší",
