                        "glosses": [
                            "Someone or something that is phenomenal, especially a promising young player in sports like baseball, American football, basketball, tennis, and golf."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7521bb95-b8eb-4147-96fb-b62806f1a8f9",
                                "sense_id": "77267a26-d43e-3564-aefc-5ec788fc9637",
                                "text": "Managed and shortstopped by George Wright and full of league stalwarts—Joe Start, Paul Hines, and Jim O'rourke—they also had 1-year-old phenom Monte Ward as primary moundsman (teams now generally used multiple pitchers)."
                            },
                            {
                                "example_id": "8f89d9a0-13ce-40f1-a777-a495bada7a78",
                                "sense_id": "77267a26-d43e-3564-aefc-5ec788fc9637",
                                "text": "It is the first all-teen final since 1999 – when neither was born – which saw Serena Williams, 17, beat an 18-year-old Martina Hingis. Teen phenoms were relatively commonplace back then, especially on the women’s side, occasionally on the men’s."
                            }
                        ]
                    },
