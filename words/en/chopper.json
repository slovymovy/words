                {
                    "sense_id": "bf9aa358-e9d6-3144-a1fe-a722f1beb4d4",
                    "sense_definition": "A type of custom motorcycle with extended forks and a stripped-down frame.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vehicles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent all summer building a custom <w>chopper</w> in his garage.",
