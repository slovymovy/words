                ],
                "senses": [
                    {
                        "sense_id": "2a786dcf-17eb-32bf-8b7d-7a94186038e2",
                        "entry_id": "e887fd01-3eb0-39a9-844a-8dcb2d882e0a",
                        "glosses": [
                            "een soevereine staat (die een dominante positie inneemt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cca5bb1-af46-4ada-a2e5-e0e3068aebc2",
                                "sense_id": "2a786dcf-17eb-32bf-8b7d-7a94186038e2",
                                "text": "Nederland was ooit een vrij belangrijke mogendheid, vanwege zijn koloniale rijk."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34d966e9-8ff0-49e3-bad4-db340c2e54a8",
                        "source_entry_id": "e887fd01-3eb0-39a9-844a-8dcb2d882e0a",
                        "source_sense_id": "2a786dcf-17eb-32bf-8b7d-7a94186038e2",
                        "target_lang_word": "Großmacht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Großmacht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cba14f92-716b-3d76-bc78-9649079549cc",
                                        "entry_id": "3a73dbe3-8380-39d2-b115-a145d3e64e4d",
                                        "glosses": [
                                            "Staat mit wesentlichem geopolitischen Einfluss"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da7d5e9b-6a7c-4aae-bfc4-fb0c6357a034",
                                                "sense_id": "cba14f92-716b-3d76-bc78-9649079549cc",
                                                "text": "„Ein FDP-Wahlwerbespot zeigt den Spitzenmann als Kontinuum berühmter liberaler Außenminister. Sich als internationale Großmacht zu präsentieren, wirkt aber ein wenig anmaßend, wenn man gerade seinen nationalen Wohnsitz verloren hat. Also plakatieren die Liberalen, was auch die anderen plakatieren: irgendwas mit Chancen.“"
                                            },
                                            {
                                                "example_id": "e68024fe-35ff-41d1-a2c7-9da6c45ade12",
                                                "sense_id": "cba14f92-716b-3d76-bc78-9649079549cc",
                                                "text": "„Hisbollah, sozusagen das \"Expeditionskorps\" der Iraner, kämpft zu Tausenden aufseiten des Regimes. Zurück in die Zukunft des 19. Jahrhunderts, wo die Großmächte einander mit Machtgebärden die Hölle heiß machten. Ein Assad-Regime von Teherans Gnaden, eine russische Militärpräsenz in der Levante, der gefährlichsten Region auf Erden ?“"
                                            },
                                            {
                                                "example_id": "10cc83b0-6fb7-4600-aa1d-1efb04ccb02c",
                                                "sense_id": "cba14f92-716b-3d76-bc78-9649079549cc",
                                                "text": "„Diese Union dient einzig und allein zur Durchsetzung der Interessen Großbritanniens, die ja bekanntlich auch von der amerikanischen Großmacht abhängig sind.“"
                                            },
                                            {
                                                "example_id": "2e9f2b43-6375-44e4-a4db-9b1b15c66177",
                                                "sense_id": "cba14f92-716b-3d76-bc78-9649079549cc",
                                                "text": "„Die \"Terrorfront\", die 2001 mit einem guten Dutzend arabischer Jünglinge die gesamte Großmacht USA zum Horst gemacht hat, angeblich vier Großraumjets in vorbestimmte Ziele gesteuert hat, schickt jetzt \"Sprengstoffpäckchen\" durchs Ländle?“"
                                            },
                                            {
                                                "example_id": "e232dcf1-fb8a-4438-a401-7db998ffce8e",
                                                "sense_id": "cba14f92-716b-3d76-bc78-9649079549cc",
                                                "text": "„Die Unfähigkeit der kosmischen Großmacht Russland, mit unbedeutenden technischen Problemen fertig zu werden, ist zum System geworden.“"
                                            },
                                            {
                                                "example_id": "b3bfff80-c18f-4820-aaa3-408bb4727c76",
                                                "sense_id": "cba14f92-716b-3d76-bc78-9649079549cc",
                                                "text": "„Häufig wird als Kriterium für den Begriff angeführt, dass eine defensive Großmacht allein gegen jeden anderen Staat militärisch bestehen kann. Eine offensive Großmacht hingegen muss in der Lage sein, weltweit militärisch Einfluss zu üben. Eine eindeutige und allgemein akzeptierte Definition existiert jedoch nicht, so dass es im Einzelfall umstritten sein kann, ob ein Staat als Großmacht gelten kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
