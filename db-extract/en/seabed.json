                                        "glosses": [
                                            "Boden eines Meeres"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7751d6c2-42f9-4a60-945a-098fef10d960",
                                                "sense_id": "55f6fd65-5f8f-3ca9-97c1-44c91c1cc586",
                                                "text": "„Auf der 43-tägigen Forschungsreise, die drei Teams — Mikrobiologen, Geologen und Geochemiker — von Costa Rica über die Galapagos-Inseln bis nach Hawaii führte, haben sich die Geoforscher aus Potsdam das Leben im Meeresboden genauer angeschaut.“"
                                            },
                                            {
                                                "example_id": "afa8402b-c2df-4afd-83d3-feceec1a727a",
                                                "sense_id": "55f6fd65-5f8f-3ca9-97c1-44c91c1cc586",
                                                "text": "„Vulkanische Gase steigen aus einem hydrothermalen Schlot am Meeresboden auf.“"
                                            },
                                            {
                                                "example_id": "38d2af1c-0dd3-4a9d-bc6c-98dd4823beb6",
                                                "sense_id": "55f6fd65-5f8f-3ca9-97c1-44c91c1cc586",
                                                "text": "„Da Wüstensand nicht für Beton taugt, gerät der Meeresboden ins Visier.“"
                                            },
                                            {
                                                "example_id": "b08aef63-66b4-4b58-86f4-ab15c100be06",
                                                "sense_id": "55f6fd65-5f8f-3ca9-97c1-44c91c1cc586",
                                                "text": "„Das Boot ruckte an und kam vom Meeresboden frei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
