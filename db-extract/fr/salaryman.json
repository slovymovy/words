                                        "entry_id": "de3b4cf1-1df6-3f9e-9d65-4478ebe35438",
                                        "glosses": [
                                            "An employee, a worker; now especially a Japanese white-collar worker who works long hours yet has an insignificant position within the corporate hierarchy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "990496b6-7490-42a6-b2d4-bd0d0714fdb1",
                                                "sense_id": "a147c564-c8eb-3e9c-bd74-e45f9e893d22",
                                                "text": "In this way, the salaryman was both a progressive social stratum and an intellectual class."
                                            },
                                            {
                                                "example_id": "30d7a096-1c8f-48e0-a487-e6ca3f88a1f1",
                                                "sense_id": "a147c564-c8eb-3e9c-bd74-e45f9e893d22",
                                                "text": "2017 May 30, NTT Solmare, Moe! Ninja Girls, Season 6 Chapter 2, iOS and Android\n― Yamabuki: “Okay... *Sigh*... I thought l'd get to go home and sleep after taking the Principal back...but here I am, still at it, like an overworked salaryman!”\n― John: “What? Salaryman?”"
                                            }
                                        ]
