            {
                "entry_id": "4289bcff-9255-3d0c-81ef-0f8609968c35",
                "word": "bidouille",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a1750263-9147-4b02-b1e8-4912e060b4ab",
                        "entry_id": "4289bcff-9255-3d0c-81ef-0f8609968c35",
                        "tags": [
                            "plural"
                        ],
                        "form": "bidouilles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "749d66c8-9902-3102-aa8d-58a23c4a5435",
                        "entry_id": "4289bcff-9255-3d0c-81ef-0f8609968c35",
                        "glosses": [
                            "Personne naïve, peu dégourdie et en général légèrement niaise."
                        ],
                        "tags": [
                            "Sud de la France"
                        ],
                        "examples": [
                            {
                                "example_id": "5c828b11-27b5-4d0b-a5dd-228bfa5a6993",
                                "sense_id": "749d66c8-9902-3102-aa8d-58a23c4a5435",
                                "text": "Que je suis bidouille ! s’écria Dorian."
                            }
                        ]
                    },
                    {
                        "sense_id": "a2dd4e3c-30f7-3b0f-9268-5e3f22f597a0",
                        "entry_id": "4289bcff-9255-3d0c-81ef-0f8609968c35",
                        "glosses": [
                            "Action d’amélioration, ou de réalisation, pérenne ou temporaire réalisée sans respecter les règles de l’art."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "fb3821dd-2735-49ea-9ed2-aa304df31b33",
                                "sense_id": "a2dd4e3c-30f7-3b0f-9268-5e3f22f597a0",
                                "text": "Quelques hackers se souviennent que, pour lui, la bidouille excluait l’idée de se laver et qu’il dégageait une forte odeur de chacal."
                            },
                            {
                                "example_id": "1ffb4cc7-8dac-45d0-a689-2d1f26a26abd",
                                "sense_id": "a2dd4e3c-30f7-3b0f-9268-5e3f22f597a0",
                                "text": "Avec l’aide de son technicien, ils avaient mis au point une bidouille qui permettait de passer les postes de 40 canaux en 120 canaux grâce à une prise jack que nous appelions « suppo »."
                            },
                            {
                                "example_id": "536ed6b5-cb78-4f75-a612-93f165ccf045",
                                "sense_id": "a2dd4e3c-30f7-3b0f-9268-5e3f22f597a0",
                                "text": "('Familier') Personne un peu folle et impliqué dans le crime notamment dans le Sud de la France.\n'\"Je suis la 'bidouille' de la DZ Mafia, fuyez tant qu'il en est encore temps !'"
                            }
                        ]
                    }
                ],
