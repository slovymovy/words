                                "example_id": "7fec2acd-15e0-4a07-ada7-a5ada530b588",
                                "sense_id": "cc4700fb-175c-3848-ac7c-8c9103aad366",
                                "text": "Dave plays the lottery almost every week, but always picks different numbers."
                            }
                        ]
                    },
                    {
                        "sense_id": "c9f138e6-e04e-32ab-86fc-bd91e6349c91",
                        "entry_id": "5d280ac4-b59f-3767-b850-89762bc302d5",
                        "glosses": [
