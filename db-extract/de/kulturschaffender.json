                "senses": [
                    {
                        "sense_id": "5574608b-8a63-3404-9848-77ed409e2ba0",
                        "entry_id": "0639a1fb-f0d2-32f2-86d8-d0b173bfaaee",
                        "glosses": [
                            "eine Person, die Kultur schafft oder erschafft, auf dem Gebiet der Kultur tätig ist, ein Künstler"
                        ],
                        "tags": [
                            "unscharf"
                        ],
                        "examples": [
                            {
                                "example_id": "41d790f3-99f2-418d-9530-525bfd873830",
                                "sense_id": "5574608b-8a63-3404-9848-77ed409e2ba0",
                                "text": "Die Kulturschaffenden eröffnen ein neues Internet-Portal."
                            },
                            {
                                "example_id": "b8a1d97a-da8b-4735-a7ab-3cfda6913e56",
                                "sense_id": "5574608b-8a63-3404-9848-77ed409e2ba0",
                                "text": "„Ich erzähle hier nichts Neues: Seit den frühen 90ern, als ich begann, in der deutschen Film- und TV-Branche zu arbeiten, sprechen Kulturschaffende über das Problem, dass deutsche Kultur, vor allem Popkultur weit hinter den Erwartungen zurückbleibt und international mit wenigen Ausnahmen peinlich ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
