{
    "word_family": [
        "dignity",
        "dignitary",
        "indignity"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "767b0083-9e3e-35b3-af26-f3214019ee0d",
                    "sense_definition": "To give honor or dignity to someone or something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "honor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The presence of the queen will <w>dignify</w> the opening ceremony.",
                            "target_lang_translations": {
                                "cs": "Přítomnost královny <w>dodá důstojnost</w> slavnostnímu zahájení."
                            }
                        },
                        {
                            "text": "His humble actions <w>dignify</w> the entire profession.",
                            "target_lang_translations": {
                                "cs": "Jeho skromné činy <w>dodávají důstojnost</w> celému povolání."
                            }
                        }
                    ],
                    "synonyms": [
                        "honor",
                        "ennoble",
                        "exalt"
                    ],
                    "antonyms": [
                        "demean",
                        "humiliate"
                    ],
                    "target_lang_definitions": {
                        "cs": "Dodat někomu nebo něčemu důstojnost či vážnost."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "dodat důstojnost",
                                "target_lang_sense_clarification": "vyjádření pocty nebo zvýšení vážnosti"
                            },
                            {
                                "target_lang_word": "poctít",
                                "target_lang_sense_clarification": "prokázat někomu čest svou přítomností"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09a54b1f-38e2-3445-bdc5-f54bcba68620",
                    "sense_definition": "To make something appear more distinguished or impressive.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "honor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A simple stone archway helps to <w>dignify</w> the entrance of the garden.",
                            "target_lang_translations": {
                                "cs": "Jednoduchý kamenný oblouk pomáhá <w>zušlechtit</w> vstup do zahrady."
                            }
                        },
                        {
                            "text": "The old portraits <w>dignify</w> the walls of the library.",
                            "target_lang_translations": {
                                "cs": "Staré portréty <w>dodávají stěnám</w> knihovny na vážnosti."
                            }
                        }
                    ],
                    "synonyms": [
                        "adorn",
                        "elevate"
                    ],
                    "target_lang_definitions": {
                        "cs": "Způsobit, že něco působí vznešeněji nebo působivěji."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zušlechtit",
                                "target_lang_sense_clarification": "dodat něčemu vyšší estetickou nebo morální hodnotu"
                            },
                            {
                                "target_lang_word": "dodat na vážnosti",
                                "target_lang_sense_clarification": "učinit něco působivějším"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "729c0dfc-eb93-3209-b743-637efd52ce93",
                    "sense_definition": "To acknowledge something by giving it attention, often used in the negative to show it is unworthy.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "acknowledge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She refused to <w>dignify</w> his rude remark with a response.",
                            "target_lang_translations": {
                                "cs": "Odmítla jeho hrubou poznámku <w>poctít</w> odpovědí."
                            }
                        },
                        {
                            "text": "I will not <w>dignify</w> such baseless accusations with an answer.",
                            "target_lang_translations": {
                                "cs": "Taková nepodložená obvinění <w>nebudu</w> ani <w>poctít</w> odpovědí."
                            }
                        }
                    ],
                    "antonyms": [
                        "shame"
                    ],
                    "common_phrases": [
                        "dignify with response"
                    ],
                    "target_lang_definitions": {
                        "cs": "Věnovat něčemu pozornost, často používáno v záporu pro vyjádření, že si to pozornost nezaslouží."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "poctít pozorností",
                                "target_lang_sense_clarification": "často v záporu, např. nepoctít odpovědí"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}