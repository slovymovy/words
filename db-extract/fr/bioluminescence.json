                        "sense_id": "2c02a5c6-94e7-33ae-8a41-7662d29a3eb7",
                        "entry_id": "8ac8428c-7aec-3952-9292-f4c7b5ff7f37",
                        "glosses": [
                            "Phénomène biologique qui produit de la lumière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7db59016-3d89-4312-823b-db8c04c04f18",
                                "sense_id": "2c02a5c6-94e7-33ae-8a41-7662d29a3eb7",
                                "text": "Quel que soit le cas de bioluminescence, l’énergie chimique est convertie en énergie lumineuse avec un rendement quantique élevé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "234ff752-ab63-4c74-b05f-6ab4b3408b4d",
                        "source_entry_id": "8ac8428c-7aec-3952-9292-f4c7b5ff7f37",
                        "source_sense_id": "2c02a5c6-94e7-33ae-8a41-7662d29a3eb7",
                        "target_lang_word": "Biolumineszenz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Biolumineszenz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3752aa2d-9e9c-379d-a211-471a598d79b4",
                                        "entry_id": "139673a9-28e7-35cf-b4b2-70cd795e7a74",
                                        "glosses": [
                                            "Fähigkeit von Lebewesen, selbst oder mit Hilfe von Symbionten Licht zu erzeugen"
                                        ],
                                        "tags": [
                                            "Biophysik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3ef4e48-cd61-46bb-8459-2b77c35fab2e",
                                                "sense_id": "3752aa2d-9e9c-379d-a211-471a598d79b4",
                                                "text": "Oft ist die Funktion der Biolumineszenz im Leben der leuchtenden Organismen nur unzureichend geklärt oder gar völlig unbekannt."
                                            },
                                            {
                                                "example_id": "8de0351b-2586-4ddf-9eab-5cd7e39d8ebb",
                                                "sense_id": "3752aa2d-9e9c-379d-a211-471a598d79b4",
                                                "text": "„Da zur visuellen Kommunikation Licht notwendig ist, ist sie nachts oder in lichtlosen Umgebungen, wie in Höhlen und in der Tiefsee, nicht ohne weiteres einsetzbar. Ganz unterschiedliche Arten haben diese Einschränkung überwunden, indem sie selbst leuchten (Biolumineszenz).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
