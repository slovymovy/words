                        "entry_id": "2e639752-7119-3a41-85dd-a9c52cc2dd39",
                        "glosses": [
                            "Trouble d'un balancement, d'un équilibre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab2d6fe9-1f56-443e-842d-e6d3086ef363",
                                "sense_id": "26e11af9-5f6b-3804-99cc-197b6e6df218",
                                "text": "En toutes autres circonstances, le débalancement de la chimie du cerveau est à mon avis un effet de la déprime plutôt qu'une cause. Il y a même lieu de se demander si la chimie de notre cerveau ne se modifie pas en vue de nous aviser que ça ne va pas, […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
