    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8eb50718-0358-37d1-8c00-ad5cd351ecff",
                    "sense_definition": "goederen of personen naar een bepaalde plaats brengen of transporteren",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vrachtwagens <w>voeren</w> dagelijks verse groenten <w>aan</w> naar de centrale markt.",
                            "target_lang_translations": {
                                "en": "The trucks <w>supply</w> fresh vegetables to the central market daily."
                            }
                        },
                        {
                            "text": "Zij <w>voeren</w> extra graan <w>aan</w> nu de lokale oogst volledig verloren is gegaan.",
                            "target_lang_translations": {
                                "en": "They are <w>bringing in</w> extra grain now that the local harvest has been completely lost."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanbrengen",
                        "leveren",
                        "toevoeren",
                        "transporteren"
                    ],
                    "antonyms": [
                        "afvoeren"
                    ],
                    "common_phrases": [
                        "goederen aanvoeren",
                        "voorraad aanvoeren",
                        "vers aanvoeren"
                    ],
                    "target_lang_definitions": {
                        "en": "to bring or transport goods or people to a specific location"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "supply",
                                "target_lang_sense_clarification": "to provide or make available for use"
                            },
                            {
                                "target_lang_word": "deliver",
                                "target_lang_sense_clarification": "to bring goods to a destination"
                            },
                            {
                                "target_lang_word": "bring in",
                                "target_lang_sense_clarification": "to transport items to a place"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0087900b-9f48-3a7f-bb6a-1b9636418439",
                    "sense_definition": "de leiding hebben over een groep, zoals een leger of een sportteam",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "leiderschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De ervaren kapitein zal het elftal tijdens de belangrijke finale <w>aanvoeren</w>.",
                            "target_lang_translations": {
                                "en": "The experienced captain will <w>lead</w> the team during the important final."
                            }
                        },
                        {
                            "text": "Na enkele grote overwinningen kreeg hij een groot leger om <w>aan</w> te <w>voeren</w>.",
                            "target_lang_translations": {
                                "en": "After several major victories, he was given a large army to <w>command</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "leiden",
                        "besturen",
                        "commanderen"
                    ],
                    "antonyms": [
                        "volgen"
                    ],
                    "common_phrases": [
                        "een leger aanvoeren",
                        "de lijst aanvoeren",
                        "een team aanvoeren"
                    ],
                    "target_lang_definitions": {
                        "en": "to be in charge of a group, such as an army or a sports team"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "command",
                                "target_lang_sense_clarification": "to exercise supreme authority over a military unit"
                            },
                            {
                                "target_lang_word": "lead",
                                "target_lang_sense_clarification": "to be the head of a team or group"
                            },
                            {
                                "target_lang_word": "captain",
                                "target_lang_sense_clarification": "to lead a sports team"
                            },
                            {
                                "target_lang_word": "head",
                                "target_lang_sense_clarification": "to be at the top of a list or organization"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29fec441-7900-3423-a242-9abbe2b66885",
                    "sense_definition": "iets naar voren brengen als argument, reden of bewijs",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "argumentatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De advocaat wilde nieuwe feiten <w>aanvoeren</w> om de onschuld van zijn cliënt te bewijzen.",
                            "target_lang_translations": {
                                "en": "The lawyer wanted to <w>adduce</w> new facts to prove his client's innocence."
                            }
                        },
                        {
                            "text": "Tegenstanders hebben <w>aangevoerd</w> dat het plan veel te duur is voor de gemeente.",
                            "target_lang_translations": {
                                "en": "Opponents have <w>argued</w> that the plan is much too expensive for the municipality."
                            }
                        }
                    ],
                    "synonyms": [
                        "opperen",
                        "stellen",
                        "beroepen",
                        "inbrengen"
                    ],
                    "common_phrases": [
                        "argumenten aanvoeren",
                        "bewijs aanvoeren",
                        "redenen aanvoeren"
                    ],
                    "target_lang_definitions": {
                        "en": "to put something forward as an argument, reason, or evidence"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "adduce",
                                "target_lang_sense_clarification": "to bring forward as evidence or proof"
                            },
                            {
                                "target_lang_word": "put forward",
                                "target_lang_sense_clarification": "to propose an argument or reason"
                            },
                            {
                                "target_lang_word": "cite",
                                "target_lang_sense_clarification": "to quote or mention as a justification"
                            },
                            {
                                "target_lang_word": "allege",
                                "target_lang_sense_clarification": "to state as a reason or fact, often in a legal context"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "decf69b4-fca9-3809-bde7-a9ff59499448",
                    "sense_definition": "meervoud verleden tijd van <w>aanvaren</w>",
