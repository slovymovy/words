                    },
                    {
                        "form_id": "70b538ad-de3b-4bac-8caf-fa18ab166cc4",
                        "entry_id": "010d9b2e-c074-3db5-9e20-6c42dcb1fd48",
                        "tags": [],
                        "form": "1/2 finale"
                    },
                    {
                        "form_id": "f54399e5-935a-4cde-95c5-bde418e4eda0",
                        "entry_id": "010d9b2e-c074-3db5-9e20-6c42dcb1fd48",
                        "tags": [],
                        "form": "½ finale"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a78df02e-d5c7-3eb2-87e5-56c60fe9db38",
                        "entry_id": "010d9b2e-c074-3db5-9e20-6c42dcb1fd48",
                        "glosses": [
                            "Épreuve éliminatoire dont le ou les meilleurs concurrents seront appelés à disputer la finale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "060873f9-ad15-4024-8e92-789d5f557e07",
                                "sense_id": "a78df02e-d5c7-3eb2-87e5-56c60fe9db38",
                                "text": "Je ne suis revenu que pour la « petite finale », ce match qui opposait les deux équipes vaincues en demi-finale, les Néo-Zélandais et nous. Pour mon retour dans l'équipe, j'ai été gâté !"
                            },
                            {
                                "example_id": "d7fc1fe3-7084-4016-94dd-be7f1e014517",
                                "sense_id": "a78df02e-d5c7-3eb2-87e5-56c60fe9db38",
                                "text": "Les épreuves comportent des séries, suivies de repêchages, puis des demi-finales, des petites finales pour les places de septième à douzième et des finales pour les places de premier à sixième."
                            },
                            {
                                "example_id": "272b21fb-7495-4ab9-8c0b-c213a402d546",
                                "sense_id": "a78df02e-d5c7-3eb2-87e5-56c60fe9db38",
                                "text": "L’équipe de France de basket peine à trouver la trace d’un match plein de son leadeur, Evan Fournier, alors que se profile la demi-finale de l’Euro, contre la Pologne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa2b8da7-c8bd-42d5-821a-261190c80406",
                        "source_entry_id": "010d9b2e-c074-3db5-9e20-6c42dcb1fd48",
                        "source_sense_id": "a78df02e-d5c7-3eb2-87e5-56c60fe9db38",
                        "target_lang_word": "Halbfinale",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Halbfinale",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dd56e893-c61c-3883-80d8-0c5c117f6981",
                                        "entry_id": "21ecdded-2080-3fed-bd4a-a6cdfb401065",
                                        "glosses": [
                                            "Runde der (meist vier) Teilnehmer, bei der sich die besten (meist zwei) für das Finale qualifizieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb164f7f-9470-4853-8995-55c018c309e8",
                                                "sense_id": "dd56e893-c61c-3883-80d8-0c5c117f6981",
                                                "text": "„Im Halbfinale scheiterte er als 13.“"
                                            },
                                            {
                                                "example_id": "54cfbf12-e894-4b4a-8182-3c4c8db96bfd",
                                                "sense_id": "dd56e893-c61c-3883-80d8-0c5c117f6981",
                                                "text": "Die Mannschaft erreichte mit einem klaren Sieg das Halbfinale."
                                            },
                                            {
                                                "example_id": "f5c4e9a2-d6d3-40a2-8ce3-111481bc0e2e",
                                                "sense_id": "dd56e893-c61c-3883-80d8-0c5c117f6981",
                                                "text": "„Die Niederösterreicherin stieg nach den Vorläufen als Zwölfte in das Halbfinale der besten 15 am Donnerstag (15.15 Uhr MESZ) auf.“"
                                            },
                                            {
                                                "example_id": "4df4d3f7-0dee-40c9-8296-1d372d43cbef",
                                                "sense_id": "dd56e893-c61c-3883-80d8-0c5c117f6981",
                                                "text": "„Wir gehen noch einmal nach Brasilien, in die Halbfinale und das Finale der WM 2014.“"
                                            },
                                            {
                                                "example_id": "e2f53612-542b-420a-8b8c-407c59455fa6",
                                                "sense_id": "dd56e893-c61c-3883-80d8-0c5c117f6981",
                                                "text": "[Tennis:] „Alexander Zverev hat bei den French Open den Einzug ins Halbfinale verpasst. […] Der Vorjahresfinalist verlor sein Viertelfinale in Paris gegen den Serben Novak Djokovic mit 6:4, 3:6, 2:6, 4:6.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "416cf161-a5df-47c6-a157-d1f075a478d1",
                        "source_entry_id": "010d9b2e-c074-3db5-9e20-6c42dcb1fd48",
                        "source_sense_id": "a78df02e-d5c7-3eb2-87e5-56c60fe9db38",
                        "target_lang_word": "semifinal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "semifinal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc5a8463-2995-3137-b711-dc4e45a6dffb",
                                        "entry_id": "729d48d1-ca75-39a9-bb66-c3f9ab9e5ef4",
                                        "glosses": [
                                            "A playoff in the round with only four players or teams left, the stage before the final."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04c59780-5c13-400e-bbd0-151a24f45d36",
                                                "sense_id": "dc5a8463-2995-3137-b711-dc4e45a6dffb",
                                                "text": "Roger Federer extended his grasscourt streak to 57 matches with a victory over Marcos Baghdatis and will play Nicolas Kiefer in the semifinals of the Gerry Weber Open in Halle, Germany."
                                            },
                                            {
                                                "example_id": "87aa328b-266d-45ad-98eb-3eb65c33c9c8",
                                                "sense_id": "dc5a8463-2995-3137-b711-dc4e45a6dffb",
                                                "text": "In the 1991 Wimbledon semifinal between Michael Stich and Stefan Edberg, there was just one service break in the entire match, and the guy whose serve was broken, Stich, ended up winning the match!"
                                            },
                                            {
                                                "example_id": "a5b428b9-231e-46f1-b9f5-3ff946f714ee",
                                                "sense_id": "dc5a8463-2995-3137-b711-dc4e45a6dffb",
                                                "text": "The highly anticipated all-American matchup between Taylor Fritz and Frances Tiafoe — marking the first US Open semifinals between two US men in nearly 20 years — will cost you quite a few Honey Deuces to attend."
                                            },
                                            {
                                                "example_id": "19045465-2d27-4fab-a334-7d126e2ba433",
                                                "sense_id": "dc5a8463-2995-3137-b711-dc4e45a6dffb",
                                                "text": "Badosa has the slightly more explosive power, but if Navarro can redirect the pace of Badosa’s shots effectively, she could well be on the way to a first Grand Slam semifinal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c2be60d-6ed9-3cf7-abba-7486abd7a76e",
                                        "entry_id": "729d48d1-ca75-39a9-bb66-c3f9ab9e5ef4",
                                        "glosses": [
                                            "A competition that narrows a field of contestants (semifinalists) to a set of finalists, for a subsequent final."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
