                                "sense_id": "eb85e244-c660-3f5b-b5a3-3d1a6ce7cf17",
                                "text": "Sam won't be doing any work this afternoon."
                            },
                            {
                                "example_id": "89e9ec36-1737-4ba9-9308-74913edb8261",
                                "sense_id": "eb85e244-c660-3f5b-b5a3-3d1a6ce7cf17",
                                "text": "Come in, won’t you?"
