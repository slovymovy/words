                "senses": [
                    {
                        "sense_id": "297084d0-f60c-3d28-8d3c-5f84143de3a0",
                        "entry_id": "6053e243-442d-3d7c-806b-00c5a607a7f7",
                        "glosses": [
                            "To make no longer a brother; to expel from a brotherhood."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "98f55029-0c6f-48ba-b78f-e36462308b37",
                                "sense_id": "297084d0-f60c-3d28-8d3c-5f84143de3a0",
                                "text": "It is not in the power of the sins of our infirmity, to unbrother us; when we look at the acts themselves, they are heinous; when at the persons, they are so much more faulty as more obliged; but when we look at the mercy of thee who hast called us, now, Who shall separate us?"
                            },
                            {
                                "example_id": "93591346-3f5d-43a9-804a-7f96ed7cdd31",
                                "sense_id": "297084d0-f60c-3d28-8d3c-5f84143de3a0",
                                "text": "Some of us take fresh heart at the thought of it, and learn that it is not in the power of infirmity to unbrother us; we are Christ's brothers; and 'brothers are brothers evermore.'"
                            }
                        ]
                    }
                ],
