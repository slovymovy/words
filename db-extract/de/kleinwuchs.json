                    {
                        "translation_id": "7f289d32-a3ad-4154-bb22-f7c69b73548b",
                        "source_entry_id": "13f37d97-b88c-3465-b569-c5cd2d97b084",
                        "source_sense_id": "9e18d7c9-d292-37b2-9ee2-157e834d27b8",
                        "target_lang_word": "nanisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nanisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a769d8c9-3958-31f4-b903-6e62cf14f526",
                                        "entry_id": "683fce15-15c1-360e-983d-c89c1faf36f7",
                                        "glosses": [
                                            "Insuffisance de croissance conférant à celui ou celle qui en est atteint(e) une taille limitée à l’âge adulte."
                                        ],
                                        "tags": [
                                            "Handicap"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16da816c-ff96-44a0-8890-ed9a5ea5f3ae",
                                                "sense_id": "a769d8c9-3958-31f4-b903-6e62cf14f526",
                                                "text": "Elle vit dans une sorte d’îlot frappé de nanisme. Et lorsqu’elle finit par découvrir ce qui l’entoure – les gens normaux, en somme – elle les traite de monstres."
                                            },
                                            {
                                                "example_id": "01e8a3eb-e404-4510-a883-f54008c7476b",
                                                "sense_id": "a769d8c9-3958-31f4-b903-6e62cf14f526",
                                                "text": "Michelangelo Vitaliani, dit Mimo, le protagoniste du roman de Jean-Baptiste Andrea Veiller sur elle, est atteint de nanisme."
                                            },
                                            {
                                                "example_id": "f62148b0-8243-4019-8e1d-a92f705bb78a",
                                                "sense_id": "a769d8c9-3958-31f4-b903-6e62cf14f526",
                                                "text": "De plus, ces populations montagnardes n’avaient pas accès au sel de mer en raison de son prix, et les cas de difformité et de nanisme étaient fréquents."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
