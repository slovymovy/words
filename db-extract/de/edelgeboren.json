                "senses": [
                    {
                        "sense_id": "01ceead9-949d-36da-a24e-605bc4987f3a",
                        "entry_id": "b4ddecd8-2fb0-3093-8a1b-04882510b1c7",
                        "glosses": [
                            "von vornehmer/adliger Herkunft"
                        ],
                        "tags": [
                            "gehoben",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "d88f6bd9-f55d-408b-b33d-3d9df633c32c",
                                "sense_id": "01ceead9-949d-36da-a24e-605bc4987f3a",
                                "text": "„Hier weilten viele von den Offizieren, die sich dann später in den königlichen Heeren auszeichneten; hier trieb sich eine Menge erfahrener und erprobter Partisaner herum, welche die edle Überzeugung hegten, daß es einerlei sei, wo man Krieg führe, wenn man nur Krieg führe, weil es für einen edelgeborenen Menschen unanständig sei, ohne Schlachten zu leben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
