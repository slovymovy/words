                                                "sense_id": "d0237bc0-ee68-359c-81aa-7fc14ee0f24b",
                                                "text": "Files with the .txt extension usually contain text."
                                            },
                                            {
                                                "example_id": "3c2266fb-614b-43ee-ba7d-c80f24a1a5aa",
                                                "sense_id": "d0237bc0-ee68-359c-81aa-7fc14ee0f24b",
                                                "text": "If you plan to plot data with error bars, you must name them with an. ERR extension. Failure to do so will crash the system, and you will lose your precious work."
                                            }
