                "senses": [
                    {
                        "sense_id": "d7e92c67-13b2-3e59-bb12-69231c517a95",
                        "entry_id": "f70ba819-2ed3-3c4f-b31b-7d972920ef7e",
                        "glosses": [
                            "intensive Bemühungen darum, jemanden/andere von etwas zu überzeugen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26313624-1202-4f4f-b4f0-8cb2ec87e539",
                                "sense_id": "d7e92c67-13b2-3e59-bb12-69231c517a95",
                                "text": "„Um bei den Wahlen zu reüssieren, muss Barbara Nowacka viel Überzeugungsarbeit leisten.“"
                            },
                            {
                                "example_id": "04644c3c-ddc2-4f6d-aaaf-fb3afa390d0b",
                                "sense_id": "d7e92c67-13b2-3e59-bb12-69231c517a95",
                                "text": "„Während die Herrschenden in feudalen Zeiten Kriege unter sich ausmachten, müssen sie in demokratischen Zeiten beim Volk jede Menge Überzeugungsarbeit leisten, bevor ein Krieg akzeptiert wird.“"
                            },
                            {
                                "example_id": "32baf49a-48b9-4bd4-acc6-149c8411c089",
                                "sense_id": "d7e92c67-13b2-3e59-bb12-69231c517a95",
                                "text": "„Es bedurfte erheblicher Überzeugungsarbeit, ehe Ben bereit war, das Auto zu verlassen, um sich mit mir zu Fuß durch die Dunkelheit zu schlagen und auf das Licht zuzugehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
