                                "target_senses": [
                                    {
                                        "sense_id": "fe1de253-1293-3f87-8dfc-6be826a42e80",
                                        "entry_id": "6cd6f090-05de-3001-9d45-10aa40c59739",
                                        "glosses": [
                                            "Surprised, shocked."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9de5f62-324f-4ae7-9a65-7bba60ca5579",
                                                "sense_id": "fe1de253-1293-3f87-8dfc-6be826a42e80",
                                                "text": "It was a casual sneer, obviously one of a long line. There was hatred behind it, but of a quiet, chronic type, nothing new or unduly virulent, and he was taken aback by the flicker of amazed incredulity that passed over the younger man's ravaged face."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97b8575a-15fb-30c5-80ca-ee641b0f551f",
                                        "entry_id": "6cd6f090-05de-3001-9d45-10aa40c59739",
                                        "glosses": [
                                            "Said of a ship, when the wind, suddenly changing, forces the sails aft against the mast."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
