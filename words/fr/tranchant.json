                {
                    "sense_id": "87a0c3b3-2bda-30d0-b9c8-9f8598ace3aa",
                    "sense_definition": "Qui est péremptoire, catégorique, sans nuance dans ses propos ou ses manières.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuré",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a répondu d'un ton <w>tranchant</w> qui ne laissait place à aucune discussion.",
                            "target_lang_translations": {
                                "en": "The director replied in a <w>cutting</w> tone that left no room for discussion.",
                                "ru": "Директор ответил <w>резким</w> тоном, не оставлявшим места для обсуждения.",
                                "de": "Der Direktor antwortete in einem <w>schneidenden</w> Ton, der keine Diskussion zuließ.",
                                "es": "El director respondió con un tono <w>tajante</w> que no dejaba lugar a ninguna discusión.",
                                "zh": "主任用一种<w>武断</w>的语气回答，不留任何讨论余地。"
                            }
                        },
                        {
                            "text": "Elle a exprimé une opinion <w>tranchante</w> sur les propositions du comité.",
                            "target_lang_translations": {
                                "en": "She voiced a <w>trenchant</w> opinion on the committee's proposals.",
                                "ru": "Она высказала <w>категоричное</w> мнение о предложениях комитета.",
                                "de": "Sie äußerte eine <w>kategorische</w> Meinung zu den Vorschlägen des Komitees.",
                                "es": "Ella expresó una opinión <w>tajante</w> sobre las propuestas del comité.",
                                "zh": "她对委员会的提案发表了一个<w>尖锐</w>的看法。"
                            }
                        }
