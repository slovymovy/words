                                        "sense_id": "1370604e-7773-3ede-8307-03c931acf426",
                                        "entry_id": "e7c8211d-f3fa-3df5-803c-eb3e80c93358",
                                        "glosses": [
                                            "die Eigentümerin oder Besitzerin eines Hauses, die Wohnungen in diesem Haus vermietet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0cbd3c91-799d-4fee-b033-bd010745ada7",
                                                "sense_id": "1370604e-7773-3ede-8307-03c931acf426",
                                                "text": "„Unter den übrigen Frauen, die wegen eines ähnlichen Verbrechens wie Elizabeth Gosling hinter Gittern saßen, befanden sich zwei, die von derselben Hauswirtin angezeigt worden waren.“"
                                            },
                                            {
                                                "example_id": "dee369db-da79-4dfe-a7fd-5a345f42740b",
                                                "sense_id": "1370604e-7773-3ede-8307-03c931acf426",
                                                "text": "„Während sich die anderen Bewohner an den Hund gewöhnt hatten, sann Alf auf Widerstand und legte, gegen Leas Einspruch, Beschwerde bei der Hauswirtin ein, einer spindeldürren, präzise an jedem Monatsersten zum Miete-Inkasso erscheinenden Person.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5ae6220b-f915-47d4-9bca-d37deb2c74ce",
