{
    "word_family": [
        "lucidity",
        "lucidly",
        "elucidate",
        "elucidation",
        "pellucid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0875b4aa-1d3d-3331-91be-4de3cbf7a953",
                    "sense_definition": "Expressed in a way that is clear and easy to understand.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "clarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor gave a <w>lucid</w> explanation of the complex theory that everyone could follow.",
                            "target_lang_translations": {
                                "ru": "Профессор дал <w>ясное</w> объяснение сложной теории, которое каждый смог понять."
                            }
                        },
                        {
                            "text": "She is known for her <w>lucid</w> writing style which makes difficult topics accessible.",
                            "target_lang_translations": {
                                "ru": "Она известна своим <w>понятным</w> стилем письма, который делает сложные темы доступными."
                            }
                        }
                    ],
                    "synonyms": [
                        "clear",
                        "perspicuous",
                        "straightforward"
                    ],
                    "antonyms": [
                        "confusing",
                        "vague",
                        "obscure"
                    ],
                    "common_phrases": [
                        "lucid explanation",
                        "lucid writing style"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выраженный ясно и понятно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ясный",
                                "target_lang_sense_clarification": "о стиле или объяснении"
                            },
                            {
                                "target_lang_word": "понятный",
                                "target_lang_sense_clarification": "легкий для восприятия"
                            },
                            {
                                "target_lang_word": "вразумительный",
                                "target_lang_sense_clarification": "четкий и логичный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "991ffd6d-5a17-397e-8646-f5936e1bdb58",
                    "sense_definition": "Able to think clearly, especially during or after a period of illness or confusion.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In a <w>lucid</w> moment, the patient was able to recognize his family members.",
                            "target_lang_translations": {
                                "ru": "В момент <w>просветления</w> сознания пациент смог узнать членов своей семьи."
                            }
                        },
                        {
                            "text": "Despite his advanced age, he remained <w>lucid</w> and sharp until his final days.",
                            "target_lang_translations": {
                                "ru": "Несмотря на преклонный возраст, он сохранял <w>здравый</w> ум и остроту восприятия до последних дней."
                            }
                        }
                    ],
                    "synonyms": [
                        "sane",
                        "coherent"
                    ],
                    "antonyms": [
                        "delirious",
                        "confused",
                        "irrational"
                    ],
                    "common_phrases": [
                        "lucid moment",
                        "remain lucid"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способный мыслить ясно, особенно во время или после болезни или замешательства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "здравый",
                                "target_lang_sense_clarification": "о рассудке"
                            },
                            {
                                "target_lang_word": "ясный",
                                "target_lang_sense_clarification": "о сознании или уме"
                            },
                            {
                                "target_lang_word": "разумный",
                                "target_lang_sense_clarification": "находящийся в сознании"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d52c62e-d453-385b-86ae-3c7c546625dc",
                    "sense_definition": "Bright, luminous, or transparent in appearance.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>lucid</w> waters of the mountain lake allowed us to see the pebbles on the bottom.",
                            "target_lang_translations": {
                                "ru": "<w>Прозрачные</w> воды горного озера позволяли нам видеть гальку на дне."
                            }
                        },
                        {
                            "text": "A <w>lucid</w> stream of light filtered through the stained glass window.",
                            "target_lang_translations": {
                                "ru": "<w>Ясный</w> луч света пробивался сквозь витражное окно."
                            }
                        }
                    ],
                    "synonyms": [
                        "brilliant",
                        "radiant",
                        "transparent",
                        "translucent",
                        "pellucid"
                    ],
                    "antonyms": [
                        "opaque",
                        "murky",
                        "dark"
                    ],
                    "common_phrases": [
                        "lucid water",
                        "lucid stream"
                    ],
                    "target_lang_definitions": {
                        "ru": "Яркий, светящийся или прозрачный на вид."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прозрачный",
                                "target_lang_sense_clarification": "о воде или воздухе"
                            },
                            {
                                "target_lang_word": "светлый",
                                "target_lang_sense_clarification": "чистый и сияющий"
                            },
                            {
                                "target_lang_word": "ясный",
                                "target_lang_sense_clarification": "о свете или небе"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f5ac78d7-d5c8-3e52-bab9-8ceee86ce20d",
                    "sense_definition": "An instance of a <w>lucid</w> dream, where the dreamer is aware they are dreaming.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dreaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He practiced specific techniques every night to increase the frequency of his <w>lucids</w>.",
                            "target_lang_translations": {
                                "ru": "Он каждую ночь практиковал специальные техники, чтобы увеличить частоту своих <w>осознанных снов</w>."
                            }
                        },
                        {
                            "text": "Some people report that their <w>lucids</w> feel more real than waking life.",
                            "target_lang_translations": {
                                "ru": "Некоторые люди сообщают, что их <w>осознанные сновидения</w> кажутся более реальными, чем жизнь наяву."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Случай осознанного сновидения, когда спящий понимает, что видит сон."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осознанное сновидение",
                                "target_lang_sense_clarification": "состояние во сне"
                            },
                            {
                                "target_lang_word": "осознанный сон",
                                "target_lang_sense_clarification": "краткое название явления"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "76c67b32-0a97-3f36-ad04-ed62778f4376",
                    "sense_definition": "A surname of Irish origin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local history book mentions a family named <w>Lucid</w> who settled here in the 1800s.",
                            "target_lang_translations": {
                                "ru": "В книге по местной истории упоминается семья по фамилии <w>Люсид</w>, поселившаяся здесь в 1800-х годах."
                            }
                        },
                        {
                            "text": "Mr. <w>Lucid</w> was appointed as the new director of the community center.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Люсид</w> был назначен новым директором общественного центра."
                            }
                        }
                    ],
