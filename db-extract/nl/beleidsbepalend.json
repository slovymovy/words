                "senses": [
                    {
                        "sense_id": "6dac2080-eb83-30f8-9f3e-0130e3bbca8f",
                        "entry_id": "80ed992b-2bb5-30f1-9e8e-333a39de912c",
                        "glosses": [
                            "van iets dat het een grote invloed heeft op de manier waarop men iets aanpakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "030bb523-be43-44d5-9879-fe715a4069ee",
                                "sense_id": "6dac2080-eb83-30f8-9f3e-0130e3bbca8f",
                                "text": "\"De aanname dat mensen die zichtbaar religieus zijn hun functie niet onpartijdig kunnen uitoefenen, is stigmatiserend en bovendien ineffectief\", zegt het college. De vrees voor hoe burgers kunnen reageren op een boa met een hoofddoek moet volgens het college niet beleidsbepalend zijn."
                            },
                            {
                                "example_id": "2b4b3906-7970-430b-b46f-56ffc76e589f",
                                "sense_id": "6dac2080-eb83-30f8-9f3e-0130e3bbca8f",
                                "text": "Dat blijkt uit de notulen die vanavond openbaar zijn gemaakt van een vergadering van het beleidsbepalend comité van de Fed eind oktober. Al eerder werd bekend dat de Fed tijdens die vergadering besloot om het steunprogramma voorlopig te handhaven."
                            },
                            {
                                "example_id": "e8f1cb52-4c6f-4ffd-b2a4-fe50c1ac3991",
                                "sense_id": "6dac2080-eb83-30f8-9f3e-0130e3bbca8f",
                                "text": "Binnen de Fed is brede steun voor de plannen van president Bernanke om dit jaar het steunprogramma voor de Amerikaanse economie af te bouwen. Dat blijkt uit notulen van de vergadering van het beleidsbepalend comité van de Fed op 30 en 31 juli, waarvan de notulen vanavond bekend zijn gemaakt."
                            }
                        ]
                    }
