                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee81d5b8-c3f8-44b9-b39f-169509447f84",
                                "sense_id": "b8cd183e-b19a-3a6f-820f-93ca49a10607",
                                "text": "Ludzie przynieśli kolorowe wiatrochrony i małe namioty."
