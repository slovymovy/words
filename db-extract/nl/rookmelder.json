                        "sense_id": "843b07df-83fe-38ea-8279-0a70bd0b67e1",
                        "entry_id": "a5bf2216-63e6-39c9-b76d-a1b56fefa49a",
                        "glosses": [
                            "apparaat dat een zeer luid signaal afgeeft als er rook aanwezig is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eec5a4f7-7988-4beb-b694-54e5d6a3b7ca",
                                "sense_id": "843b07df-83fe-38ea-8279-0a70bd0b67e1",
                                "text": "Twee keer maakten rookmelders de afgelopen nacht het verschil, bij woningbranden in Ekeren en Deurne. Beide branden bleven beperkt omdat de bewoners of buren werden gewekt door rookmelders."
                            },
                            {
                                "example_id": "8bb0f3eb-b4e0-475b-afb7-587098f75e37",
                                "sense_id": "843b07df-83fe-38ea-8279-0a70bd0b67e1",
                                "text": "De brandweerlieden spreken hun zorg uit dat het 'echte bluswerk' minder centraal zal komen te staan door de toegenomen aandacht van de samenleving en de brandweer voor brandveilig leven en de verschuiving van verantwoordelijkheden naar de burger, zoals de nadruk op rookmelders en brandveilige huizen."
                            }
                        ]
                    }
