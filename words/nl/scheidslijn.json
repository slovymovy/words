                },
                {
                    "sense_id": "7f4555a1-2277-3753-8371-20cb398793d1",
                    "sense_definition": "Een scheiding of verschil tussen ideeën, groepen of zaken die ze van elkaar afzondert.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er bestaat een dunne <w>scheidslijn</w> tussen succes en mislukking.",
                            "target_lang_translations": {
                                "en": "There is a fine <w>line</w> between success and failure."
                            }
                        },
                        {
                            "text": "Politici proberen de <w>scheidslijn</w> tussen de groepen weg te nemen.",
                            "target_lang_translations": {
