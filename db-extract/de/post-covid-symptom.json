                ],
                "senses": [
                    {
                        "sense_id": "cb303804-15e6-33aa-b521-631ad06c9363",
                        "entry_id": "f9b4c5dc-c992-39fe-9ce1-e31fc12a5b21",
                        "glosses": [
                            "Anzeichen für Nachwirkungen/Langzeitfolgen von Covid-19; Weiterbestehen von Krankheitssymptomen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27a5fa3b-c687-4d62-80fe-c7a9cc7358d7",
                                "sense_id": "cb303804-15e6-33aa-b521-631ad06c9363",
                                "text": "„Je schwerer die Infektion während des akuten Geschehens verläuft, umso höher ist auch das Risiko, ein Post-Covid-Symptom zu entwickeln.“"
                            },
                            {
                                "example_id": "d13ddd31-2a27-41cd-83fb-27442854848f",
                                "sense_id": "cb303804-15e6-33aa-b521-631ad06c9363",
                                "text": "„Nun bin ich zurück, wenn auch noch nicht völlig frei von Post-Covid-Symptomen und werde neben Beratungen mit meinem Ministerium und im Kabinett auch wieder Termine wahrnehmen […].“"
                            },
                            {
                                "example_id": "6e82ec3b-a1ed-4a4a-b082-c04f538ace37",
                                "sense_id": "cb303804-15e6-33aa-b521-631ad06c9363",
                                "text": "„Seit April 2020 wurden dort mehr als 270 Patientinnen und Patienten mit Post-Covid-Symptomen behandelt: anfangs nach einem Krankenhausaufenthalt mit schwerem Verlauf, mittlerweile vor allem bei Post-Covid-Symptomen wie Atemnot oder Herzproblemen, die auch lange nach einer überstandenen Infektion noch auftreten können.“"
                            },
                            {
                                "example_id": "610bee9f-57d8-4653-bc9e-b892abf36019",
                                "sense_id": "cb303804-15e6-33aa-b521-631ad06c9363",
                                "text": "„Anhaltendes hohes Fieber kann den Körper austrocknen lassen, heftige Elektrolytmangelkrisen auslösen und zu Post-Covid-Symptomen wie Gehirnerschöpfung führen, und dieser Zustand kann drei Monate oder ein halbes Jahr anhalten, bevor man sich wieder normal fühlt.“"
                            },
                            {
                                "example_id": "1da0f287-c17d-464b-9d41-614380b58562",
                                "sense_id": "cb303804-15e6-33aa-b521-631ad06c9363",
                                "text": "„Viele Forscherinnen und Forscher suchen aktuell nach den Ursachen und Mechanismen der Entstehung dieser Post-Covid-Symptome, meist auf der kleinsten molekularen Ebene, jeder in seinem Fachbereich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
