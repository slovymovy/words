                        "sense_id": "662441db-b0d5-302a-8ce6-1138302f2153",
                        "entry_id": "0750615e-7f40-343c-8766-868976f4df8e",
                        "glosses": [
                            "En forme de paraboloïde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b8e2986-a885-40d9-8fc9-8e5af2081db7",
                                "sense_id": "662441db-b0d5-302a-8ce6-1138302f2153",
                                "text": "On voit alors la nappe sʼépanouir et prendre grossièrement la forme paraboloïdale."
                            },
                            {
                                "example_id": "c25d6c65-0cb4-48b4-8f6a-a5851768906a",
                                "sense_id": "662441db-b0d5-302a-8ce6-1138302f2153",
                                "text": "Leur extrados légèrement paraboloïdal rappelle encore la forme des ouvertures du mur occidental de la crypte."
                            },
                            {
                                "example_id": "e6ff8750-e049-40e9-ac34-77d822b5c326",
                                "sense_id": "662441db-b0d5-302a-8ce6-1138302f2153",
                                "text": "De fait, les approximations que nous ferons sont de type parabolique, et il serait sans doute plus rigoureux dʼutiliser des émetteurs et des récepteurs paraboloïdaux."
                            }
                        ]
                    }
