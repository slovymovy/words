                "senses": [
                    {
                        "sense_id": "6ad39cb2-b442-3cae-b524-2828eb85aae4",
                        "entry_id": "bf94ac85-78ba-3fd1-adaa-4e9ba6299560",
                        "glosses": [
                            "Feiertag an Ostern (Ostersonntag beziehungsweise Ostermontag)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7b108b2-3957-41c5-90ef-4c2e3dedfbbf",
                                "sense_id": "6ad39cb2-b442-3cae-b524-2828eb85aae4",
                                "text": "Sie machten an beiden Osterfeiertagen eine Radtour."
                            },
                            {
                                "example_id": "82271c8a-f14a-48a5-8a17-f277c88696b2",
                                "sense_id": "6ad39cb2-b442-3cae-b524-2828eb85aae4",
                                "text": "„In den Osterfeiertagen wagten sie nicht, sich in Turin zu zeigen.“"
                            },
                            {
                                "example_id": "2cf8243f-7e89-42bc-9cff-f46bbbb7f586",
                                "sense_id": "6ad39cb2-b442-3cae-b524-2828eb85aae4",
                                "text": "„Die Osterfeiertage waren besonders beliebt dafür, und auch dieses Jahr stand ein schönes Wochenende auf den Pisten in Aussicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
