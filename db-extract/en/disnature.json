                        "sense_id": "99b84e19-e344-3b3b-bc5b-219aa749777e",
                        "entry_id": "6a4dc82f-ce37-33aa-9517-b8d8c2b0fdc3",
                        "glosses": [
                            "Synonym of denature (“take away a natural characteristic or inherent property of”)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c63b9d22-c0c8-4a71-9978-0d812c09119b",
                                "sense_id": "99b84e19-e344-3b3b-bc5b-219aa749777e",
                                "text": "It is not the soul's nature to leave the body; rather, the body (disnatured by the Fall) deserts the soul."
                            },
                            {
                                "example_id": "1466374c-3e82-4811-ab25-9a2139354a54",
                                "sense_id": "99b84e19-e344-3b3b-bc5b-219aa749777e",
                                "text": "The truth has been disnatured by its legal setting: Caleb's appeal to the conscience is not an instrument of ' true ' justice but, in spite of all he can do to prevent it, an act of revenge against the institution of aristocracy ."
                            },
                            {
                                "example_id": "4e69d8ab-c19b-4153-bfb9-2d2ed95017c4",
                                "sense_id": "99b84e19-e344-3b3b-bc5b-219aa749777e",
                                "text": "Naturally, no one has disnatured all of nature before. Destroying and remaking all of existence is unique, unparalleled."
                            }
                        ]
                    }
