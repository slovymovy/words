                "senses": [
                    {
                        "sense_id": "4f832f3b-33de-3663-a127-1d7b8a25b0f9",
                        "entry_id": "b428959f-7cb8-3256-8fac-3edc40a09c97",
                        "glosses": [
                            "Manieur d’argent dépourvu de scrupules."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "fa3c8ba9-b149-458a-8030-64c8558db1b0",
                                "sense_id": "4f832f3b-33de-3663-a127-1d7b8a25b0f9",
                                "text": "Le temps est aux tripoteurs d’affaires, aux agioteurs à la petite semaine, aux bonisseurs qui promettent, si on leur confie un petit écu, de rendre six francs."
                            },
                            {
                                "example_id": "43d7c103-b957-4355-85b4-567af5778f5e",
                                "sense_id": "4f832f3b-33de-3663-a127-1d7b8a25b0f9",
                                "text": "[…] et qu’en même temps, les États-Unis voulaient gagner de l’argent, ainsi que les métallurgistes, les cotonniers et autres tripoteurs omnipotents de l’humanité."
                            },
                            {
                                "example_id": "320a2ce9-a6a9-463b-88fd-17c2229aa74c",
                                "sense_id": "4f832f3b-33de-3663-a127-1d7b8a25b0f9",
                                "text": "Banquiers, boursiers, courtiers, tripoteurs, faiseurs d’or ;\nEt tous les éclopés admirant ces rapines..."
                            }
                        ]
                    }
                ],
