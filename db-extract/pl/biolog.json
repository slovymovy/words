                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acc2c0ef-ff4e-4c57-b1bc-b91c83b47d42",
                                "sense_id": "47bbeb81-278f-31ed-b5f1-77b0436a0c4e",
                                "text": "Dendrolog jest botanikiem, biologiem, który bada drzewa."
