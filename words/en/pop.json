                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "汽水",
                                "target_lang_sense_clarification": "碳酸饮料"
                            },
                            {
                                "target_lang_word": "碳酸饮料",
                                "target_lang_sense_clarification": "正式称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f9e5a13-7bb5-3e3f-a15f-05343e976c79",
