            "senses": [
                {
                    "sense_id": "9e0e8320-fccb-32c9-a544-3a0f1b011116",
                    "sense_definition": "Grande compétence ou habileté remarquable acquise dans un art, une science ou une technique.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "competence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette pianiste montre une parfaite <w>maîtrise</w> de son instrument lors de chaque concert."
                        },
                        {
                            "text": "L'artiste a impressionné le public grâce à sa <w>maîtrise</w> technique exceptionnelle."
                        }
                    ],
                    "synonyms": [
                        "virtuosité",
                        "savoir-faire",
                        "expertise"
                    ],
                    "antonyms": [
                        "maladresse",
                        "incompétence"
                    ],
                    "common_phrases": [
