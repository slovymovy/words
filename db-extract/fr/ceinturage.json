                            {
                                "example_id": "fc082cdc-be1a-43b3-ad46-325f2153774b",
                                "sense_id": "c1cbed9d-5452-3124-84d2-17da754edd8e",
                                "text": "(architecture) Le plan nécessitait la mise en place d’un ceinturage à l’endroit où la première tour du Golden Gate bridge devait être érigée."
                            },
                            {
                                "example_id": "e99c7111-4b31-4cfa-90f3-04f74ec076d3",
                                "sense_id": "c1cbed9d-5452-3124-84d2-17da754edd8e",
                                "text": "(sport) La surface de réparation deviendra un lieu où les erreurs ne seront pas pardonnées : tout ceinturage ou autre faute grossière sera sanctionnée d'un penalty."
                            }
                        ]
                    },
                    {
                        "sense_id": "389311ac-a621-3edc-9e83-4b53d632363e",
                        "entry_id": "de779afb-5307-3178-9046-37c46c0b0dbc",
                        "glosses": [
                            "Ce qui ceinture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "170faa72-f2e8-4b35-81d6-ee4ed0427ea8",
                                "sense_id": "389311ac-a621-3edc-9e83-4b53d632363e",
                                "text": "Fait assez inhabituel, il avait gardé sur sa chemise le harnachement de son holster, ceinturage de cuir toujours un peu impressionnant, qui contrastait avec sa tenue négligée, la chemise fripée, le pantalon de toile fatigué, les pieds nus."
                            }
                        ]
                    }
