                    },
                    {
                        "sense_id": "4bd19acd-c643-3316-91ee-1e60ca374d50",
                        "entry_id": "0c334e70-e823-309d-8cc1-9e6987ad8f1d",
                        "glosses": [
                            "Coming or exhaling in puffs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80e7305f-f889-4d5b-b52f-2720c4bca649",
                                "sense_id": "4bd19acd-c643-3316-91ee-1e60ca374d50",
                                "text": "puffy breath"
                            },
                            {
                                "example_id": "16b90d9c-2d40-4c5e-a48a-1de39035df1d",
                                "sense_id": "4bd19acd-c643-3316-91ee-1e60ca374d50",
                                "text": "A puffy fat man in a tracksuit came jogging around the corner."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a0cd40e-9fb5-341d-bdcc-4b67728cdda2",
                        "entry_id": "0c334e70-e823-309d-8cc1-9e6987ad8f1d",
                        "glosses": [
                            "Speaking or writing in an exaggeratedly eloquent and self-important manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e78da4c-8437-45b5-bf1a-95170f7128be",
                                "sense_id": "6a0cd40e-9fb5-341d-bdcc-4b67728cdda2",
                                "text": "There has been much puffy stuff written about whether Lyell's uniformitarianism permitted variations in intensity of causes, or whether he applied his logic in a consistent way, and whether he assumed indefinite stretches of geological time."
                            }
                        ]
                    },
                    {
                        "sense_id": "cf40b6da-a2a3-39b0-99df-cb61f48438bf",
                        "entry_id": "0c334e70-e823-309d-8cc1-9e6987ad8f1d",
                        "glosses": [
                            "Having inflated cheeks."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3693bdae-2f87-4348-b30c-00962e8336b1",
                        "source_entry_id": "0c334e70-e823-309d-8cc1-9e6987ad8f1d",
                        "source_sense_description": "inflated",
                        "target_lang_word": "bouffi",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bouffi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "430a8160-e161-35b2-a874-0e95b25cf9b6",
                                        "entry_id": "b2a4ac31-9432-3a28-8872-7b33c472463d",
                                        "glosses": [
                                            "Enflé de façon malsaine, maladive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5939dfe8-df2d-431a-b5f1-d5a82696bafe",
                                                "sense_id": "430a8160-e161-35b2-a874-0e95b25cf9b6",
                                                "text": "Des visages encore bouffis de sommeil apparurent aux fenêtres ; des groupes d’hommes, en bras de chemise, de femmes en camisole et en bonnet de nuit, se formèrent, animés, sur le bas des portes."
                                            },
                                            {
                                                "example_id": "38faf29d-b843-4e9b-a559-8dfb45b10e49",
                                                "sense_id": "430a8160-e161-35b2-a874-0e95b25cf9b6",
                                                "text": "Tous les jours, je voyais cette grosse dame bouffie, importante, ressemblant à une oie gavée, se promener dans le jardin, vêtue à la russe, avec des perles et, quel que fût le temps, une ombrelle, […]"
                                            },
                                            {
                                                "example_id": "c8cfd76c-77ee-42c3-9ec6-50137b5b26d1",
                                                "sense_id": "430a8160-e161-35b2-a874-0e95b25cf9b6",
                                                "text": "Il est bouffi d’orgueil."
                                            },
                                            {
                                                "example_id": "a4d1438c-ce31-44a3-8b88-248921884001",
                                                "sense_id": "430a8160-e161-35b2-a874-0e95b25cf9b6",
                                                "text": "Lanterne, énorme valet bouffi de vanité, apparut avec plusieurs flacons que Cogolin l'aidait à porter en disant : « Ah ! monsieur de Lanterne, que de fonds de bouteilles pour nous ! »"
                                            },
                                            {
                                                "example_id": "e6cb88ad-9a9f-402c-a9b3-a43e4d59b5d9",
                                                "sense_id": "430a8160-e161-35b2-a874-0e95b25cf9b6",
                                                "text": "Hendrickje avec ses paupières un peu bouffies de domestique levée trop tôt, et son corps fatigué et doux, teinté d’ombres grises, qu’elle a prêté à la Bethsabée du Louvre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e43190a5-2981-3c76-97d9-716bb4548009",
                                        "entry_id": "b2a4ac31-9432-3a28-8872-7b33c472463d",
                                        "glosses": [
                                            "Désigne le hareng présenté entier, légèrement fumé et salé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c82a66d-f185-4557-be3c-ba01ca51ee38",
                                                "sense_id": "e43190a5-2981-3c76-97d9-716bb4548009",
                                                "text": "Coresse moins grande pour faire des Harengs bouffis ou Craquelots : toutes ces opérations, qui différent peu de celles qu'on fait pour le Hareng saur, s'exécutent par des femmes, qu'on nomme Craquelotières."
                                            },
                                            {
                                                "example_id": "eef0faf0-18e0-4acb-a496-4007d1c51126",
                                                "sense_id": "e43190a5-2981-3c76-97d9-716bb4548009",
                                                "text": "Le hareng bouffi ou \"bloater\" est un hareng peu salé pendant une seule journée puis fumé jusqu'à ce qu'il prenne une couleur paille, il se conserve pendant 5 à 10 jours maximum au réfrigérateur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bouffi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c058402-602d-3b95-a1e5-8406c5a8a4e0",
                                        "entry_id": "fb2663c1-4733-399c-a80e-bfbcc307ec04",
                                        "glosses": [
                                            "Abréviation de hareng bouffi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d8bd443-b71a-4115-83d4-83e02b04e251",
                                                "sense_id": "7c058402-602d-3b95-a1e5-8406c5a8a4e0",
                                                "text": "Cette Planche est destinée à faire voir les préparations qu'on donne aux Harengs, nommés les uns Sauris, les autres Bouffis."
                                            },
                                            {
                                                "example_id": "3e401cc1-e1b5-40d4-ba89-e96fc00e8741",
                                                "sense_id": "7c058402-602d-3b95-a1e5-8406c5a8a4e0",
                                                "text": "… moins salé, c'est le craquelot, bouffi ou bloater;"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bouffi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "476336c0-1816-3af2-92f7-b0c9de903b65",
                                        "entry_id": "1d00f754-a026-3e3b-bd1c-63f26a890e3b",
                                        "glosses": [
                                            "Personnage enflé ; enflure."
                                        ],
                                        "tags": [
                                            "offensive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "abfcb7ba-cfae-4bc0-8757-97e26242a66f",
                                                "sense_id": "476336c0-1816-3af2-92f7-b0c9de903b65",
                                                "text": "— Et vous autres ! Qu’est-ce que vous avez à me regarder ? Parce que je n’ai pas de redingote ni de tuyau de poêle ? Tas de bouffis, va ! Attendez que je vous décolle le cul de vos chaises !"
                                            },
                                            {
                                                "example_id": "7c3625c9-dab8-477e-b5de-fe8430f827c4",
                                                "sense_id": "476336c0-1816-3af2-92f7-b0c9de903b65",
                                                "text": "Embarque, bouffi! 'faut qu'on le retrouve!"
                                            },
                                            {
                                                "example_id": "889d7a06-4816-46c0-a5e3-6f5fde4a4911",
                                                "sense_id": "476336c0-1816-3af2-92f7-b0c9de903b65",
                                                "text": "Comment ose-t-il, ce bouffi plein de courants d'air, aussi malodorant qu'un pet de bouc, ce... cet insupportable merdailleur, plus nuisible que nuée de pigeons ? M'empêcher de quitter Cahors ! À moi !"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bouffi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c2ca9b1a-6348-3fa2-8c5a-19609ee97f6b",
                                        "entry_id": "9352b250-5ac9-3499-b311-c095cb4ac520",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe bouffir."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
