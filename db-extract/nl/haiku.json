                    {
                        "sense_id": "fbc925f2-122f-3c97-b1ab-c4b3dd668162",
                        "entry_id": "8ec6891c-1089-30c1-a3e6-6c3544055d44",
                        "glosses": [
                            "een vorm van Japanse dichtkunst, geschreven in drie regels waarvan de eerste regel 5, de tweede regel 7 en de derde regel weer 5 lettergrepen telt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "018dcb2c-aeea-4c28-b35c-d9ff856ef354",
                                "sense_id": "fbc925f2-122f-3c97-b1ab-c4b3dd668162",
                                "text": "De huidige en tevens eerste voorzitter van de Europese Raad, de voormalige premier van België, Herman Van Rompuy, is een bekend liefhebber en schrijver van haiku, die op zijn website te vinden zijn."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5902782e-3c5c-4d3a-a506-3d850d49b711",
                        "source_entry_id": "8ec6891c-1089-30c1-a3e6-6c3544055d44",
                        "source_sense_id": "fbc925f2-122f-3c97-b1ab-c4b3dd668162",
                        "target_lang_word": "Haiku",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Haiku",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef1eb505-a0ca-35f0-ad16-0e4d05e35823",
                                        "entry_id": "1bc84e06-285f-3c0e-84e6-261ff8554178",
                                        "glosses": [
                                            "Gedichtform aus dem Japanischen, bei der in 3 Zeilen 17 Silben vorkommen, nämlich in der ersten 5, in der zweiten 7, und in der dritten wieder 5"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acfcc317-d67c-47f8-8f46-720d71281218",
                                                "sense_id": "ef1eb505-a0ca-35f0-ad16-0e4d05e35823",
                                                "text": "„Das Kurze ist eine unterschätzte literarische Form und in anderen Kulturen stärker verankert: Hemingways Sechs-Wörter-Geschichte, das Haiku – Texte wie Koffeintabletten!“"
                                            },
                                            {
                                                "example_id": "9134cb52-fcb3-48b3-8cc1-039ce885f0dd",
                                                "sense_id": "ef1eb505-a0ca-35f0-ad16-0e4d05e35823",
                                                "text": "„Haikus schreiben war erholsam wie Kreuzworträtsellösen.“"
                                            },
                                            {
                                                "example_id": "2f8fee51-2a16-4c9a-a493-5d02d74953d6",
                                                "sense_id": "ef1eb505-a0ca-35f0-ad16-0e4d05e35823",
                                                "text": "„Bis zum Morgen fand ich das den großartigsten Satz ever, ein gewiefter Haiku der Spitzenklasse.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "357bc30b-3e98-4563-acac-9076cb620949",
                        "source_entry_id": "8ec6891c-1089-30c1-a3e6-6c3544055d44",
