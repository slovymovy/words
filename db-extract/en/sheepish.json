                        "glosses": [
                            "Having the characteristics of a sheep, as meekness, shyness, or docility."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e66c683-c435-4b23-90aa-60fa90d93909",
                                "sense_id": "0086f58e-21a6-39b0-a96e-9429fb2d6e2c",
                                "text": "“King Ty? Your sister is back.” “I don't want to talk to her unless she's here to apologize. Does she look sheepish?” “I guess I've seen a sheep in a cage before, so, yeah, kind of.”"
                            }
                        ]
                    },
