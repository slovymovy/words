                ],
                "senses": [
                    {
                        "sense_id": "e35a46c3-8f43-366d-856b-1e416cd3ff8a",
                        "entry_id": "8d00ee57-e794-3961-a14b-4a8e7b61958b",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ce520b7-df81-4592-a67e-9cef1e80ff25",
                                "sense_id": "e35a46c3-8f43-366d-856b-1e416cd3ff8a",
                                "text": "Frau Schille ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6294030e-f01c-45a8-9b64-4a3651fef12a",
                                "sense_id": "e35a46c3-8f43-366d-856b-1e416cd3ff8a",
                                "text": "Herr Schille wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "98f62906-62fb-4d17-931c-1a5438c85441",
                                "sense_id": "e35a46c3-8f43-366d-856b-1e416cd3ff8a",
                                "text": "Die Schilles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "f8ad5c58-a055-4c4c-8ab1-4018d989031a",
                                "sense_id": "e35a46c3-8f43-366d-856b-1e416cd3ff8a",
                                "text": "Der Schille trägt nie die Schals, die die Schille ihm strickt."
                            },
                            {
                                "example_id": "26126e9b-5305-46b0-9fb8-4748c25dddca",
                                "sense_id": "e35a46c3-8f43-366d-856b-1e416cd3ff8a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schille kommt, geht der Herr Schille.“"
                            },
                            {
                                "example_id": "dc31724a-57ea-448d-871e-fc86276d1497",
                                "sense_id": "e35a46c3-8f43-366d-856b-1e416cd3ff8a",
                                "text": "Schille kommt und geht."
                            },
                            {
                                "example_id": "e620bb4c-bafa-4d5e-9a49-ef7ccdd1c0c8",
                                "sense_id": "e35a46c3-8f43-366d-856b-1e416cd3ff8a",
                                "text": "Schilles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
