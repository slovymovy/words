                        "glosses": [
                            "An alcoholic."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "2f69aae5-a8d3-47e2-8f4f-b76530b71d0e",
                                "sense_id": "95f50f31-f349-36fa-be35-ffdf98b7095b",
                                "text": "You want to know what it's like to be an alkie, don't you, boy?"
                            },
                            {
                                "example_id": "be3e0631-a5f2-4680-9238-7cce9813ea36",
                                "sense_id": "95f50f31-f349-36fa-be35-ffdf98b7095b",
                                "text": "Also, she fed patients who were unable to feed themselves and, occasionally, dealt with an alkie who treated a patient badly."
                            }
                        ]
                    }
                ],
