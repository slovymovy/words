                        "examples": [
                            {
                                "example_id": "c92f1e5a-5f98-4f22-9cf0-83e929b64c74",
                                "sense_id": "1605d718-da87-3bde-86e5-859e99d6fde7",
                                "text": "Sesamstangen schmecken sehr gut. Viele Bäcker bieten Sesamstangen an."
                            },
                            {
                                "example_id": "6741979a-52ad-4668-9f10-aba3c122a3ee",
                                "sense_id": "1605d718-da87-3bde-86e5-859e99d6fde7",
                                "text": "In den Restaurants werden Sesambrötchen oder Sesamstangen angeboten und auch Sesamöl kommt häufiger zum Einsatz."
                            },
                            {
                                "example_id": "e6993a27-8746-4657-9a60-1a4e07332f67",
                                "sense_id": "1605d718-da87-3bde-86e5-859e99d6fde7",
                                "text": "Im Milchkeller, so erfahren wir, werden zwar keine Süßigkeiten verkauft, sondern bloß Snacks wie Sesamstange und Käsestange."
                            }
