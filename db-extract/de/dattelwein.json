                    {
                        "sense_id": "7838994e-a7ee-3067-ad75-8d6b0ecfcb5a",
                        "entry_id": "bc04432a-7406-32a0-82f6-9e5cfff6f8db",
                        "glosses": [
                            "aus Datteln hergestellter Wein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b64ab24-09d0-4b52-8d5d-db0eb76e8552",
                                "sense_id": "7838994e-a7ee-3067-ad75-8d6b0ecfcb5a",
                                "text": "„Alberne Sprüche rinnen mir durch den Kopf: Wenn jemand eine Reise tut, so kann er was erzählen. Nur hemmen mich Schock und Wut und die Reisequalen. Verzage nicht, du Hänschen klein. Lausche auf der Palme Rauschen, an ihrem Fuß klebt Dattelwein.“"
                            },
                            {
                                "example_id": "9443ca86-8957-4cda-9a63-19d145ea2ec0",
                                "sense_id": "7838994e-a7ee-3067-ad75-8d6b0ecfcb5a",
                                "text": "„Er hat lediglich seine Gedichte rezitiert, die sicher eine stärkere Anregung sind als dein Dattelwein!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
