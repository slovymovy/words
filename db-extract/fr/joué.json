                    {
                        "sense_id": "650baec0-3917-3e03-bd3e-aa1a86f4ac3a",
                        "entry_id": "ace25377-eef9-3ce7-9b5f-c2a06306e595",
                        "glosses": [
                            "Hameau de Belin-Béliet, commune française de la Gironde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ed8d8ac-411f-4b08-bf69-5e0dc729cc0c",
                                "sense_id": "650baec0-3917-3e03-bd3e-aa1a86f4ac3a",
                                "text": "Dans la nuit de mardi à mercredi, seize maisons des hameaux de l’Ambéliet et Joué ont été ravagées par les flammes."
                            },
                            {
                                "example_id": "94f4662d-a5fc-499f-b7c7-ed7d8d121334",
                                "sense_id": "650baec0-3917-3e03-bd3e-aa1a86f4ac3a",
                                "text": "Ce cocon de verdure qui entourait l’airial de Marie a aussi disparu sur la route de Joué, où la tour de guet culmine, esseulée, au milieu d’un paysage lunaire."
                            }
                        ]
                    }
