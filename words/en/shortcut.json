{
    "word_family": [
        "short",
        "cut"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f502b730-dfde-3c76-9156-c14c8210dc83",
                    "sense_definition": "A path between two points that is faster than the commonly used paths.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "path",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We took a <w>shortcut</w> through the park to get home ten minutes earlier.",
                            "target_lang_translations": {
                                "ru": "Мы пошли <w>кратчайшим путем</w> через парк, чтобы прийти домой на десять минут раньше.",
                                "zh": "我们穿过公园<w>走捷径</w>，提前十分钟回到了家。"
                            }
                        },
                        {
                            "text": "If you take the scenic <w>shortcut</w> through the woods, you will avoid the heavy traffic.",
                            "target_lang_translations": {
                                "ru": "Если вы выберете живописный <w>срез</w> через лес, вы избежите пробок.",
                                "zh": "如果你选择穿过树林的风景<w>捷径</w>，就能避开拥堵的交通。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bypass",
                        "cut-off"
                    ],
                    "antonyms": [
                        "detour"
                    ],
                    "common_phrases": [
                        "take a shortcut",
                        "scenic shortcut",
                        "quick shortcut"
                    ],
                    "target_lang_definitions": {
                        "ru": "Путь между двумя точками, который быстрее, чем обычно используемые маршруты.",
                        "zh": "两点之间比常用路径更快的路线。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кратчайший путь",
                                "target_lang_sense_clarification": "самая короткая дорога"
                            },
                            {
                                "target_lang_word": "срез",
                                "target_lang_sense_clarification": "разговорное обозначение короткого пути"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "捷径",
                                "target_lang_sense_clarification": "比常规路线更短的路径"
                            },
                            {
                                "target_lang_word": "近路",
                                "target_lang_sense_clarification": "距离较短的道路"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3bbb205-3747-39fc-8767-71a07b8008e0",
                    "sense_definition": "A file that points to the location of another file and serves as a quick way to access it.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I created a desktop <w>shortcut</w> for the document so I can open it instantly.",
                            "target_lang_translations": {
                                "ru": "Я создал <w>ярлык</w> для документа на рабочем столе, чтобы открывать его мгновенно.",
                                "zh": "我为该文档创建了一个桌面<w>快捷方式</w>，这样就能立即打开它。"
                            }
                        },
                        {
                            "text": "There are <w>shortcuts</w> to some of my favourite applications on my desktop.",
                            "target_lang_translations": {
                                "ru": "На моем рабочем столе есть <w>ярлыки</w> для некоторых моих любимых приложений.",
                                "zh": "我的桌面上有一些常用应用程序的<w>快捷方式</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "alias",
                        "link",
                        "symlink"
                    ],
                    "common_phrases": [
                        "desktop shortcut",
                        "create a shortcut"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Файл, который указывает на местоположение другого файла и служит быстрым способом доступа к нему.",
                        "zh": "指向另一个文件位置并提供快速访问方式的文件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ярлык",
                                "target_lang_sense_clarification": "значок на рабочем столе или в папке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "快捷方式",
                                "target_lang_sense_clarification": "计算机中指向文件或程序的图标"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "120337e8-cbc9-3b8e-9fcb-02521aaa809b",
                    "sense_definition": "A method to accomplish something that omits one or more steps.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "method",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is no <w>shortcut</w> to success because hard work is always required.",
                            "target_lang_translations": {
                                "ru": "К успеху нет <w>кратчайшего пути</w>, потому что всегда требуется упорный труд.",
                                "zh": "成功没有<w>捷径</w>，因为总是需要付出努力。"
                            }
                        },
                        {
                            "text": "The company is introducing new <w>shortcuts</w> for claiming compensation in the event of late-running services.",
                            "target_lang_translations": {
                                "ru": "Компания вводит новые <w>упрощенные способы</w> подачи заявок на компенсацию в случае задержки рейсов.",
                                "zh": "公司正在引入新的<w>简便方法</w>，以便在服务延误时申请赔偿。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "shortcut to success",
                        "take shortcuts"
                    ],
                    "target_lang_definitions": {
                        "ru": "Метод выполнения чего-либо, который пропускает один или несколько этапов.",
                        "zh": "一种省略一个或多个步骤以完成某事的方法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кратчайший путь",
                                "target_lang_sense_clarification": "способ быстрее достичь цели"
                            },
                            {
                                "target_lang_word": "наиболее рациональный способ",
                                "target_lang_sense_clarification": "эффективный метод"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "捷径",
                                "target_lang_sense_clarification": "达成目标的快速方法"
                            },
                            {
                                "target_lang_word": "简便方法",
                                "target_lang_sense_clarification": "简化流程的手段"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b698460-0558-3c07-a20f-ee95d45b6a12",
                    "sense_definition": "A combination of keys that provides quick access to a particular function within a computer program.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Using a keyboard <w>shortcut</w> like Ctrl+C is much faster than using the mouse menu.",
                            "target_lang_translations": {
                                "ru": "Использование <w>сочетания клавиш</w>, такого как Ctrl+C, намного быстрее, чем использование меню мыши.",
                                "zh": "使用像 Ctrl+C 这样的<w>快捷键</w>比使用鼠标菜单快得多。"
                            }
                        },
                        {
                            "text": "You should learn the keyboard <w>shortcut</w> for saving your work frequently.",
                            "target_lang_translations": {
                                "ru": "Вам следует выучить <w>горячие клавиши</w> для частого сохранения вашей работы.",
                                "zh": "你应该学习用于频繁保存工作的<w>快捷键</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hotkey"
                    ],
                    "common_phrases": [
                        "keyboard shortcut"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Комбинация клавиш, обеспечивающая быстрый доступ к определенной функции в компьютерной программе.",
                        "zh": "提供对计算机程序内特定功能快速访问的按键组合。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сочетание клавиш",
                                "target_lang_sense_clarification": "комбинация на клавиатуре"
                            },
                            {
                                "target_lang_word": "горячая клавиша",
                                "target_lang_sense_clarification": "быстрый вызов функции"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "快捷键",
                                "target_lang_sense_clarification": "键盘上的功能组合键"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "de5c3d72-9d0f-3382-8105-462acca15054",
                    "sense_definition": "To take or use a shortcut.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to <w>shortcut</w> through the alley to reach the station before the train left.",
                            "target_lang_translations": {
                                "ru": "Мы решили <w>срезать</w> через переулок, чтобы добраться до станции до отправления поезда.",
                                "zh": "我们决定<w>抄近路</w>穿过小巷，以便在火车开走前到达车站。"
                            }
                        },
                        {
                            "text": "The hikers tried to <w>shortcut</w> the trail but ended up getting lost in the dense forest.",
                            "target_lang_translations": {
                                "ru": "Туристы попытались <w>сократить путь</w>, но в итоге заблудились в густом лесу.",
                                "zh": "徒步旅行者试图在小径上<w>走捷径</w>，结果却在茂密的森林里迷了路。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Воспользоваться коротким путем или срезать дорогу.",
                        "zh": "走捷径或使用捷径。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "срезать",
                                "target_lang_sense_clarification": "пойти более коротким путем"
                            },
                            {
                                "target_lang_word": "сократить путь",
                                "target_lang_sense_clarification": "выбрать дорогу покороче"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "走捷径",
                                "target_lang_sense_clarification": "选择更短的路线"
                            },
                            {
                                "target_lang_word": "抄近路",
                                "target_lang_sense_clarification": "走近路以节省时间"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}