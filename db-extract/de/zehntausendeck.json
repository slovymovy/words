                "senses": [
                    {
                        "sense_id": "1a3f5bd8-609a-3e91-85a8-c7115c94d6f5",
                        "entry_id": "a955b38a-99ec-37a8-8418-c503ac9c4879",
                        "glosses": [
                            "geometrische Figur mit zehntausend Ecken"
                        ],
                        "tags": [
                            "geometry"
                        ],
                        "examples": [
                            {
                                "example_id": "7aa5fd1c-d5eb-4e22-bf27-37dc2e753702",
                                "sense_id": "1a3f5bd8-609a-3e91-85a8-c7115c94d6f5",
                                "text": "„Ein reguläres Zehntausendeck ist seinem umschriebenen Kreis ähnlicher als ein diesem eingeschriebenes Dreieck.“"
                            },
                            {
                                "example_id": "fcca31f7-6e23-4292-9bc8-59937c3c7f5c",
                                "sense_id": "1a3f5bd8-609a-3e91-85a8-c7115c94d6f5",
                                "text": "Vor allem kann das Tausendeck nicht anschaulich beispielsweise von einem Zehntausendeck unterschieden werden, aber sehr wohl begrifflich (Descartes, 1972)."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38efa6d7-17c9-4e7e-b4a3-1c59d9b10f99",
                        "source_entry_id": "a955b38a-99ec-37a8-8418-c503ac9c4879",
                        "source_sense_id": "1a3f5bd8-609a-3e91-85a8-c7115c94d6f5",
                        "source_sense_description": "Mathematik, Geometrie: geometrische Figur mit zehntausend Ecken",
                        "target_lang_word": "myriagon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "myriagon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8e59bfc9-5290-3c7c-9b18-ac8cb7ac259c",
                                        "entry_id": "03c4a8f8-9046-33d7-a203-08f69782407f",
                                        "glosses": [
                                            "A polygon with 10,000 sides."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5493f294-cc6c-462c-9622-b5bd93bc83ef",
                                                "sense_id": "8e59bfc9-5290-3c7c-9b18-ac8cb7ac259c",
                                                "text": "For it differs in no way from the representation I should form if I were thinking of a myriagon, or any figure with very many sides."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5d42afd-79c9-44ea-b531-5de7e7263470",
                        "source_entry_id": "a955b38a-99ec-37a8-8418-c503ac9c4879",
                        "source_sense_id": "1a3f5bd8-609a-3e91-85a8-c7115c94d6f5",
                        "source_sense_description": "Mathematik, Geometrie: geometrische Figur mit zehntausend Ecken",
                        "target_lang_word": "myriagone",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "myriagone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0bee02ac-1f0d-37df-bbd3-a14eec5d7afe",
                                        "entry_id": "6479dfb2-b4c6-3b29-b854-d726151a9b5d",
                                        "glosses": [
                                            "Polygone à 10 000 sommets et donc 10 000 côtés."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cf16602-45a7-4e8d-aa50-68fb0ebbfb51",
                                                "sense_id": "0bee02ac-1f0d-37df-bbd3-a14eec5d7afe",
                                                "text": "Pour s'en convaincre, que le lecteur considère le mot myriagone et ce qu'il désigne. Un myriagone est un polygone de dix mille cotés. Impossible de l’imaginer, même coloré et particulier, à plus forte raison général et abstrait."
                                            },
                                            {
                                                "example_id": "e580f2a1-e48e-47dd-b8ae-2275076218da",
                                                "sense_id": "0bee02ac-1f0d-37df-bbd3-a14eec5d7afe",
                                                "text": "Certes, je m'arrêterai bien avant le millième côté, et la figure que je dessinerais ou que, doué d'une imagination plus riche, je verrais surgir devant mon regard intérieur, serait la même que pour un hectogone ou un myriagone ; mais c'est uniquement parce que, déjà instruit par le tracé des polygones d'un petit nombre de côtés, et, sachant que les propriétés essentielles sont les mêmes, quel que soit le nombre des côtés, je m'épargnerai ce travail minutieux, fatigant et sans profit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae3be6c0-878e-47fa-a4ee-6da6bc9dbf09",
                        "source_entry_id": "a955b38a-99ec-37a8-8418-c503ac9c4879",
                        "source_sense_id": "1a3f5bd8-609a-3e91-85a8-c7115c94d6f5",
                        "source_sense_description": "Mathematik, Geometrie: geometrische Figur mit zehntausend Ecken",
                        "target_lang_word": "myriogone",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "myriogone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a2c881f4-a7fb-367a-8ee8-f8b3da9ecf73",
                                        "entry_id": "26647057-4b13-304d-ba35-2ff71b4a6554",
                                        "glosses": [
                                            "Variante de myriagone."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a117095c-7d9e-4b58-a448-e853fdd0a6b0",
                                                "sense_id": "a2c881f4-a7fb-367a-8ee8-f8b3da9ecf73",
                                                "text": "Si je pensais à un myriogone ou à quelque autre figure de beaucoup de côtés."
                                            },
                                            {
                                                "example_id": "7c807c82-f2e8-4279-9722-885a7952d9c8",
                                                "sense_id": "a2c881f4-a7fb-367a-8ee8-f8b3da9ecf73",
                                                "text": "Cet enchaînement d'exercices fait donc apparaître la différence entre le concept et l'image, ou entre la conception et l'imagination. On la saisira définitivement en pensant à présent à un myriogone, une figure à dix mille côtés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d989ddd8-0a05-4e0a-9469-d58107a80fdb",
                        "source_entry_id": "a955b38a-99ec-37a8-8418-c503ac9c4879",
                        "source_sense_id": "1a3f5bd8-609a-3e91-85a8-c7115c94d6f5",
