            "senses": [
                {
                    "sense_id": "61365599-164a-3832-82b0-be7e1989fd47",
                    "sense_definition": "Récipient à boire sans anse ni pied, généralement en carton, en plastique ou en métal.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "recipient",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a pris un <w>gobelet</w> en plastique pour boire un peu d'eau fraîche au distributeur."
                        },
                        {
                            "text": "Le serveur a déposé un <w>gobelet</w> de café bien chaud sur la petite table du bureau ce matin."
                        }
                    ],
                    "synonyms": [
                        "verre",
                        "godet"
                    ],
                    "common_phrases": [
                        "gobelet en plastique",
                        "gobelet en carton"
                    ]
                },
                {
                    "sense_id": "ad3b468c-f073-36fb-95b4-060eda3f078f",
                    "sense_definition": "Contenu d'un gobelet.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "quantite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a bu un grand <w>gobelet</w> de jus d'orange avant de partir travailler sous la pluie."
                        },
                        {
                            "text": "Elle a gentiment offert un <w>gobelet</w> d'eau bien fraîche au voyageur fatigué qui attendait dehors."
                        }
                    ],
                    "common_phrases": [
                        "boire un gobelet"
                    ]
                },
                {
                    "sense_id": "a167d4e0-bf7f-3432-9b06-8fb369071893",
                    "sense_definition": "Récipient utilisé pour secouer et lancer des dés ou par les magiciens pour exécuter des tours d'escamotage.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "jeu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le joueur secoue vigoureusement les dés dans le <w>gobelet</w> avant de les lancer sur la table."
                        },
                        {
                            "text": "L'illusionniste fait disparaître une petite balle rouge sous un vieux <w>gobelet</w> en cuivre devant le public émerveillé."
                        }
                    ],
                    "common_phrases": [
