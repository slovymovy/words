                                "target_senses": [
                                    {
                                        "sense_id": "2001c5d9-5c00-3ec4-be0d-06a2eec574af",
                                        "entry_id": "9411ec6c-ccf1-30df-9895-c309b05535b8",
                                        "glosses": [
                                            "An Asian wild dog, Cuon alpinus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f8e10d7-fc59-4d81-ac9b-96b19b1d2626",
                                                "sense_id": "2001c5d9-5c00-3ec4-be0d-06a2eec574af",
                                                "text": "Mowgli's wanderings had taken him to the edge of the high grassy downs of the Dekkan, and he had seen the fearless dholes sleeping and playing and scratching themselves in the little hollows and tussocks that they use for lairs."
                                            },
                                            {
                                                "example_id": "3f947ffc-2710-4db3-acc4-07b29a05855d",
                                                "sense_id": "2001c5d9-5c00-3ec4-be0d-06a2eec574af",
                                                "text": "This whistling, a means of communication for a pack of dhole regrouping after an unsuccessful hunt, inspired the other common name of this species—the whistling dog."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
