                ],
                "senses": [
                    {
                        "sense_id": "8a71f018-fc8f-3934-86d7-a590fe6282b9",
                        "entry_id": "795c503c-2e02-35f1-8451-d95b11bd938a",
                        "glosses": [
                            "Donner un caractère vocationnel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5164e4fc-4ef6-4cc7-83d8-45eab7adce1d",
                                "sense_id": "8a71f018-fc8f-3934-86d7-a590fe6282b9",
                                "text": "Profiter de chaque occasion pour semer la semence de la vocation, d'une manière telle qu'on arrive à « vocationnaliser » toute la vie et la Mission de la Congrégation."
                            },
                            {
                                "example_id": "58182971-5cf2-42f4-be6c-812a170e7a07",
                                "sense_id": "8a71f018-fc8f-3934-86d7-a590fe6282b9",
                                "text": "En ce sens, on peut dire qu'il faut « vocationnaliser » toute la pastorale, ou faire en sorte que chaque expression de la pastorale manifeste d’une façon claire et sans équivoque un projet ou un don de Dieu fait à la personne et stimule chez elle une volonté de réponse et d’implication personnelle."
                            },
                            {
                                "example_id": "05f823db-7e6f-4313-8d6d-951d223e2f67",
                                "sense_id": "8a71f018-fc8f-3934-86d7-a590fe6282b9",
                                "text": "L’analyse de nos récits de vocation montre que l’engagement dans le projet artiste implique de vocationnaliser son choix, voire de le « survocationnaliser »."
                            }
                        ]
                    }
                ],
