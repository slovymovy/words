                "senses": [
                    {
                        "sense_id": "19434c55-9118-39c6-adb3-40ed8577b1e6",
                        "entry_id": "26a1d566-7130-350d-a574-4085b17253f7",
                        "glosses": [
                            "ein kleineres Gewölbe über einem Fenster oder über einer Tür, das in der Regel in ein größeres Gewölbe integriert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb41fa6d-13fd-43c8-91eb-0dd4565375f4",
                                "sense_id": "19434c55-9118-39c6-adb3-40ed8577b1e6",
                                "text": "„Das Ohrgewölbe. Dieses Gewölbe, welches ein Ohr oder eine Kappe heißt, ist eigentlich ein zufälliger Theil eines andern Gewölbes, womit man Thüren oder Fenster überwölbt, um die durch die Thür- oder Fensteröffnung geschwächte Mauer wieder zu verstärken.“"
                            },
                            {
                                "example_id": "40610ced-020e-45c1-b01a-0034f1c8caed",
                                "sense_id": "19434c55-9118-39c6-adb3-40ed8577b1e6",
                                "text": "„Obgleich die Tonnengewölbe, ihrer Natur nach, einen ununterbrochenen Seitendruck auf ihre Widerlagen ausüben, so kann man doch, mittelst der Ohrgewölbe, diesen Druck aus bestimmte Punkte leiten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
