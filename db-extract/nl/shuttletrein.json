                        "examples": [
                            {
                                "example_id": "5d8b1b77-3ab2-4c88-b29d-10941ad53a16",
                                "sense_id": "da410649-25a5-3cdc-a97e-e48a7bc8fc14",
                                "text": "Britse agenten hebben op een shuttletrein door de Kanaaltunnel het lichaam van een tiener gevonden. De jongen lag op het dak van een open wagon, die door vrachtauto's wordt gebruikt om op de trein te komen. Bij het eindpunt in Folkestone werd het lichaam ontdekt."
                            },
                            {
                                "example_id": "2e8c7e91-5f9b-4aeb-84f0-fb121a26c088",
                                "sense_id": "da410649-25a5-3cdc-a97e-e48a7bc8fc14",
                                "text": "Vorig jaar zijn veel minder vrachtwagens vervoerd door de Kanaaltunnel tussen Frankrijk en Engeland. Beheerder Eurotunnel zegt dat er zo'n 770.000 vrachtwagens via shuttletreinen werden overgezet in 2009. Dat is veertig procent minder dan een jaar eerder."
                            }
                        ]
                    }
