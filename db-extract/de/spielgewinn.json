                    }
                ],
                "senses": [
                    {
                        "sense_id": "4d0d4a30-8cce-3432-8317-ae03de2a364f",
                        "entry_id": "f978f293-3d68-36ad-ad6b-c35f10befaa6",
                        "glosses": [
                            "erfolgreicher Abschluss eines Wettspiels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d415b31-fac1-4274-8220-e5b916ac0067",
                                "sense_id": "4d0d4a30-8cce-3432-8317-ae03de2a364f",
                                "text": "„Williams feuerte sich nach dem Spielgewinn zum 2:3 noch einmal mit einem durchdringenden ‚Come oooon’ an, beim 3:5 konnte sie in teilweise großer Manier vier Matchbälle abwehren.“"
                            },
                            {
                                "example_id": "ed259d81-2dd6-4b0e-b4d4-1d3d63059ea7",
                                "sense_id": "4d0d4a30-8cce-3432-8317-ae03de2a364f",
                                "text": "„Von einer 3:1-Führung im zweiten Satz bis zum 0:5 im dritten verlor er elf Spiele in Folge, doch mit dem Spielgewinn zum 1:5 schien er endlich wieder neuen Mut zu schöpfen, und von da ab wurde sein Spiel wieder ein wenig besser.“"
                            },
                            {
                                "example_id": "2ef4396e-6d9f-478b-bdf3-fdc2d5ccf732",
                                "sense_id": "4d0d4a30-8cce-3432-8317-ae03de2a364f",
                                "text": "„Zuerst versuchte die 16 Jahre alte Serena ihr Glück; sie rannte hin und her, bis sie pumpte wie ein Maikäfer, und im Schweiße ihres Angesichts gelang ihr tatsächlich ein Spielgewinn.“"
                            },
                            {
                                "example_id": "2c579b57-e6dd-4a44-a8f2-064c480ff45d",
                                "sense_id": "4d0d4a30-8cce-3432-8317-ae03de2a364f",
                                "text": "„Es klappte schließlich mit dem Spielgewinn zum 5:4, der nach Hubers Einschätzung vorentscheidend für den Ausgang der Partie war.“"
                            },
                            {
                                "example_id": "440cc70b-6844-418c-8c16-fed79a99be01",
                                "sense_id": "4d0d4a30-8cce-3432-8317-ae03de2a364f",
                                "text": "„Füchse schnuppern am ersten Spielgewinn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "082c17b7-3860-39a6-ad39-0bea8f73f75a",
                        "entry_id": "f978f293-3d68-36ad-ad6b-c35f10befaa6",
                        "glosses": [
                            "ideelle oder materielle Wertschöpfung aus einem Spiel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ca2ef7c-96ce-43e9-a729-19e06e4aa41a",
                                "sense_id": "082c17b7-3860-39a6-ad39-0bea8f73f75a",
                                "text": "„Der Spielgewinn, den die Beteiligten aus der selbstständigen Gestaltung eines Dschungelfestivals erwarten dürfen, lohnt den Aufwand, mit dem sie rechnen müssen.“"
                            },
                            {
                                "example_id": "abc84d3b-9609-464b-bff7-5bc24eab552d",
                                "sense_id": "082c17b7-3860-39a6-ad39-0bea8f73f75a",
                                "text": "„Niemand wird verabsäumen, seinen Spielgewinn einzustreichen, aber den Spielverlust zu bezahlen, vergessen so manche.“"
                            },
                            {
                                "example_id": "f2eca409-ee9d-4219-8e9d-ac94a26b4786",
                                "sense_id": "082c17b7-3860-39a6-ad39-0bea8f73f75a",
                                "text": "„Die Angeklagten sind genau wie alle übrigen natürlich durch den Spielgewinn und die Hoffnung auf solchen zum Spiel gelockt worden.“"
                            },
                            {
                                "example_id": "b8639037-78fb-42f0-9849-57f09b4f3211",
                                "sense_id": "082c17b7-3860-39a6-ad39-0bea8f73f75a",
                                "text": "„Nach geltendem Recht könnte sie ihren Spielgewinn in kürzester Zeit nicht so einfach mit kostspieligen Fernreisen oder teuren Restaurantbesuchen durchbringen.“"
                            },
                            {
                                "example_id": "21712875-7527-4454-a97a-2391a67dae1f",
                                "sense_id": "082c17b7-3860-39a6-ad39-0bea8f73f75a",
                                "text": "„Das Stück setzt ein mit der feierlichen Schlachtung des Sparschweins, in dem die Spielgewinne gesammelt wurden, und folgt der leidenschaftlichen Debatte über die Vergnügungen, die mit dessen Inhalt finanziert werden sollen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
