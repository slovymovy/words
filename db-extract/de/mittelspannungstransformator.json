                "senses": [
                    {
                        "sense_id": "d0606b27-4420-3c48-9a64-8d64aefbba96",
                        "entry_id": "0486c5cf-b499-3c5d-8763-00f526003d06",
                        "glosses": [
                            "Vorrichtung aus zwei Spulen, die elektrische Energie transformiert, das heißt ihre charakteristische Größe Spannung so ändert, dass Mittelspannung am Ausgang entsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d64184f1-39be-43ae-8778-1ef2613981d7",
                                "sense_id": "d0606b27-4420-3c48-9a64-8d64aefbba96",
                                "text": "„Für den Energiebezug aus der Oberleitung ist ein Mittelspannungstransformator erforderlich.“"
                            },
                            {
                                "example_id": "c7f10ac8-d567-4099-836b-201b7521377a",
                                "sense_id": "d0606b27-4420-3c48-9a64-8d64aefbba96",
                                "text": "„Ausgestattet mit einem SMA Zentral-Wechselrichter HE-Familie und einem Mittelspannungstransformator speist der Sunny Central MV direkt in das Mittelspannungsnetz ein.“"
                            },
                            {
                                "example_id": "e92cd935-df65-4b44-8843-e105adf5a051",
                                "sense_id": "d0606b27-4420-3c48-9a64-8d64aefbba96",
                                "text": "„Für die Stromversorgung einer neuen Fertigungshalle wird ein Mittelspannungstransformator mit einer Eingangsspannung von 20kV, Ausgangsspannung 400V und reduzierten Verlusten, gebraucht.“"
                            },
                            {
                                "example_id": "76850c15-fa63-46d3-9b40-ee10cfd87f85",
                                "sense_id": "d0606b27-4420-3c48-9a64-8d64aefbba96",
                                "text": "„Wird nun der Mittelspannungstransformator am Leistungsmaximum betrieben, so erhöht der Transformator die Netzimpedanz und die Oberwellenströme lassen einen dementsprechend höhere Oberwellenspannung im Netz abfallen.“"
                            },
                            {
                                "example_id": "0fe93047-e077-43f9-be5b-04e5eabc5e40",
                                "sense_id": "d0606b27-4420-3c48-9a64-8d64aefbba96",
                                "text": "„Ziel des Programmes ist die Entwicklung, Konstruktion und Herstellung eines für Smart Grids geeigneten Mittelspannungstransformators für 28 MVA.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
