                        "examples": [
                            {
                                "example_id": "e6154720-2031-4619-bfba-db8419173961",
                                "sense_id": "49a58277-3fd3-3f78-b8fa-ec764c445ef6",
                                "text": "Het bekendst is zijn project om de opiumteelt in het noorden van het land te vervangen door andere gewassen, zoals koffie en thee. Bhumibol zorgde ervoor dat de boeren een inkomensgarantie kregen doordat de Thaise overheid een flink deel van de productie opkocht."
                            },
                            {
                                "example_id": "5981df98-13b5-43f2-a16e-9f2966a17e34",
                                "sense_id": "49a58277-3fd3-3f78-b8fa-ec764c445ef6",
                                "text": "Hij dwong een inkomensgarantie af omdat hij vreesde dat hij zijn baan zou kunnen verliezen door de bemiddeling. Tussen 2002 en 2006 wist hij de garantie nog een aantal maal fors te verbeteren."
                            }
                        ]
