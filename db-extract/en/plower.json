                        "entry_id": "70de9ff0-ee42-3916-9dd5-8fffed1cfad7",
                        "glosses": [
                            "One who plows; one who works land with a plow."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f0e4400-21e5-40fe-ac3a-705d06c39636",
                                "sense_id": "ab6d4ae0-dbf4-3011-8e0c-2395a2cf283a",
                                "text": "Only plowers can expect to become harvesters."
                            },
                            {
                                "example_id": "b2097a2a-69f4-47d8-adc3-c5fc0c08aad9",
                                "sense_id": "ab6d4ae0-dbf4-3011-8e0c-2395a2cf283a",
                                "text": "We have referred to the Bull many times, both in his astronomical aspect as pioneer of the Spring-Sun, and in his more direct rôle as plougher of the fields[.]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
