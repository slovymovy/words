                        "examples": [
                            {
                                "example_id": "da2cd3e9-73ac-4bdf-a8e1-e16d04136ac9",
                                "sense_id": "6ea2fc84-42cb-3e12-b575-f4b3e769e5e0",
                                "text": "\"In whose eyes I shall find grace\" is furthermore a very important alliterational brush-stroke on this charming broad canvas."
                            },
                            {
                                "example_id": "2bef10de-4852-42f2-b7e6-295edc2b7476",
                                "sense_id": "6ea2fc84-42cb-3e12-b575-f4b3e769e5e0",
                                "text": "In the heroic lays, parallelisms of long lines predominate, strictly organized from the point of view of alliterational technique."
                            },
                            {
                                "example_id": "30e2d459-5356-486e-9211-b7a876251566",
                                "sense_id": "6ea2fc84-42cb-3e12-b575-f4b3e769e5e0",
                                "text": "Their language has two remarkable peculiarities which seem to separate it from other African tongues; viz., the system of prefixing to every noun a syllable without any separate meaning, and alliterational concord, which changes the initial sound of a secondary word into that of the priamary one."
                            }
                        ]
