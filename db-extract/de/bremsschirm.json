                        "source_sense_id": "a5840337-1033-3153-b3f2-bd01d6e22d77",
                        "source_sense_description": "textiler Schirm zum Abbremsen der Geschwindigkeit eines Flugobjekts",
                        "target_lang_word": "drag parachute",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drag parachute",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "429403dd-2e74-3b0d-bf3e-2b56f80b72ae",
                                        "entry_id": "bb5e9f76-770b-31d8-9463-26a8c99a94aa",
                                        "glosses": [
                                            "A parachute deployed behind an aircraft, space shuttle, or motor vehicle as a braking device."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ced8146-4927-4532-b245-6270ca53f0f7",
                                                "sense_id": "429403dd-2e74-3b0d-bf3e-2b56f80b72ae",
                                                "text": "The jet dragster has been clocked at 232.24 miles per hour. . . . The car is stopped by a drag parachute."
                                            },
                                            {
                                                "example_id": "2e429fce-8d79-4f63-bd5d-2f4a68e76c3a",
                                                "sense_id": "429403dd-2e74-3b0d-bf3e-2b56f80b72ae",
                                                "text": "As planned, within seconds of touching down, the space craft released a 40-foot-wide drag parachute to help slow it down."
                                            },
                                            {
                                                "example_id": "9770545c-14db-43a7-84ec-07fe180747d9",
                                                "sense_id": "429403dd-2e74-3b0d-bf3e-2b56f80b72ae",
                                                "text": "The aircraft is designed to use a drag parachute as a brake, but Mr Prothero didn't have time to deploy it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
