                "senses": [
                    {
                        "sense_id": "1dba586c-9e92-370a-b380-3cbb668bbabc",
                        "entry_id": "61e8e251-d83f-3db6-a46b-319fad796c57",
                        "glosses": [
                            "weibliche Person, die zum Beispiel im Theater oder Film etwas verkörpert, etwas darstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67315e79-462c-4b1b-8e5a-274a60b67d72",
                                "sense_id": "1dba586c-9e92-370a-b380-3cbb668bbabc",
                                "text": "Gestern waren wir im Theater. Die Darstellerin der Julia überzeugte, während Romeo immer wieder Schwierigkeiten mit seinem Text zu haben schien."
                            },
                            {
                                "example_id": "c27b48db-6493-4ab9-a20e-4b244bcbc62c",
                                "sense_id": "1dba586c-9e92-370a-b380-3cbb668bbabc",
                                "text": "Zwanzig Darsteller und Darstellerinnen waren gleichzeitig auf der Bühne."
                            },
                            {
                                "example_id": "e03f9896-4b4d-4e20-ab9e-08fb05b00830",
                                "sense_id": "1dba586c-9e92-370a-b380-3cbb668bbabc",
                                "text": "Auf dem Filmfestival wurde Marianne Müller als „Beste Darstellerin“ ausgezeichnet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "561f27fc-61ad-4ee0-8f9d-2724418cba90",
                        "source_entry_id": "61e8e251-d83f-3db6-a46b-319fad796c57",
                        "source_sense_id": "1dba586c-9e92-370a-b380-3cbb668bbabc",
                        "source_sense_description": "weibliche Person, die zum Beispiel im Theater oder Film etwas verkörpert, etwas darstellt",
                        "target_lang_word": "actress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "actress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3876b11f-6466-3007-869c-bbe229a2b5dd",
                                        "entry_id": "00b17417-dd4d-3008-aaa8-0049e4b2270e",
                                        "glosses": [
                                            "A female who performs on the stage or in films."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5a42363-81f1-4b8b-8ff9-879895a29601",
                                                "sense_id": "3876b11f-6466-3007-869c-bbe229a2b5dd",
                                                "text": "A while ago somewhere I don't know when / I was watchin' a movie with a friend / I fell in love with the actress / She was playin' a part that I could understand"
                                            },
                                            {
                                                "example_id": "9236a94e-d062-4f08-96f9-69f3c7b8f0f3",
                                                "sense_id": "3876b11f-6466-3007-869c-bbe229a2b5dd",
                                                "text": "\"I'm an actress -- actor, as we have to say these days.\""
                                            },
                                            {
                                                "example_id": "60c2368a-30ec-481c-a2a7-3b35351dec9c",
                                                "sense_id": "3876b11f-6466-3007-869c-bbe229a2b5dd",
                                                "text": "Court documents appear to show that Ian Edmondson, a senior News of the World journalist, had authorised Mr Mulcaire to hack phones belonging to Sienna Miller, an actress."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23be3a93-71a9-3dd6-ae13-2fc3af4534b9",
                                        "entry_id": "00b17417-dd4d-3008-aaa8-0049e4b2270e",
                                        "glosses": [
                                            "A female doer or \\\"actor\\\" (in a general sense)."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2d5f912-3c4c-474c-a16a-8248b2bdadab",
                                                "sense_id": "23be3a93-71a9-3dd6-ae13-2fc3af4534b9",
                                                "text": "My mental anguish, and the dreadful scenes in which I had been an actress, advanced the period of my labour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "72ee4e50-490b-4505-b5f6-ade313641cc0",
                        "source_entry_id": "61e8e251-d83f-3db6-a46b-319fad796c57",
                        "source_sense_id": "1dba586c-9e92-370a-b380-3cbb668bbabc",
