                    },
                    {
                        "sense_id": "7da74f87-1180-3769-8c58-62af9fcf7bce",
                        "entry_id": "5ce1b08f-5a46-33ad-b286-c930a58834c5",
                        "glosses": [
                            "wspaniale, wyjątkowo, bardzo dobrze"
                        ],
