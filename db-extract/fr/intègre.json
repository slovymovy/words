                        "form": "intègres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c11f80ba-a67a-314c-a0b5-485a3586e010",
                        "entry_id": "720d2aa9-d53c-317a-b02f-209639ee1549",
                        "glosses": [
                            "Qui est d’une probité incorruptible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4983a364-0256-4e60-a247-dbdb63b45a88",
                                "sense_id": "c11f80ba-a67a-314c-a0b5-485a3586e010",
                                "text": "Le fonctionnaire de la police nationale est loyal envers les institutions républicaines. Il est intègre et impartial ; il ne se départit de sa dignité en aucune circonstance."
                            }
                        ]
                    },
                    {
                        "sense_id": "85f66bcb-7237-3106-a4c9-872bf8be6608",
                        "entry_id": "720d2aa9-d53c-317a-b02f-209639ee1549",
                        "glosses": [
                            "Qui est en parfait état, qui n’est pas abîmé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34788b66-1572-4ca7-b087-904d6d4ef617",
                                "sense_id": "85f66bcb-7237-3106-a4c9-872bf8be6608",
                                "text": "La coque du bateau est intègre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70eb9076-1f07-40c9-bc64-e158bae4d603",
                        "source_entry_id": "720d2aa9-d53c-317a-b02f-209639ee1549",
                        "target_lang_word": "integrous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "integrous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81c4fbd9-a8a6-3fbe-ac26-c7690c46def6",
                                        "entry_id": "69e875d4-2287-3c7b-a4ef-760d9b10a869",
                                        "glosses": [
                                            "Having or characterized by integrity."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0683ae7-e7c1-4e08-b1cf-1bbcd7c75b23",
                                                "sense_id": "81c4fbd9-a8a6-3fbe-ac26-c7690c46def6",
                                                "text": "No doubt hard, no doubt proud, unpleasant in self-esteem, and singularly blind to much of what was going on, and yet such a high-minded and integrous woman, […]"
                                            },
                                            {
                                                "example_id": "0a11e53c-51ea-4da8-b387-d574cc8dae39",
                                                "sense_id": "81c4fbd9-a8a6-3fbe-ac26-c7690c46def6",
                                                "text": "And Smiths of Policie shall invent,\nTo cast new Molds of Government;\nWhile vulgar Birds, of weakest wing,\nGrow stout against the Eagle King,\nWhose just integrous heart shall prove\nThe Adamant of Subjects love."
                                            },
                                            {
                                                "example_id": "02393ee0-cbd8-4b88-ad70-f6da68616627",
                                                "sense_id": "81c4fbd9-a8a6-3fbe-ac26-c7690c46def6",
                                                "text": "He concluded by writing that ‘Hillsong is the most integrous church in the country, and its leadership is above reproach’."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "021676bd-4ea2-4d0a-b0e8-14c61dc7baab",
                        "source_entry_id": "720d2aa9-d53c-317a-b02f-209639ee1549",
                        "target_lang_word": "honest",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "honest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50171bdd-1469-3df7-a67a-8fd991854b8d",
                                        "entry_id": "641bc85f-5870-3320-976a-bad630b1285e",
                                        "glosses": [
                                            "Scrupulous with regard to telling the truth; not given to swindling, lying, or fraud; upright."
                                        ],
                                        "tags": [
                                            "of a person or institution"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45510c9f-07d2-41f0-bbf9-81054cc4401e",
                                                "sense_id": "50171bdd-1469-3df7-a67a-8fd991854b8d",
                                                "text": "brutally honest"
                                            },
                                            {
                                                "example_id": "6d982242-dedb-4e9a-9821-f79d415dff90",
                                                "sense_id": "50171bdd-1469-3df7-a67a-8fd991854b8d",
                                                "text": "We’re the most honest people you will ever come across."
                                            },
                                            {
                                                "example_id": "1295b0aa-4a27-4ff6-9e0e-470d6644a792",
                                                "sense_id": "50171bdd-1469-3df7-a67a-8fd991854b8d",
                                                "text": "A true and honest physician is excused for leaving his patient, when he finds the disease grown desperate"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bf13b1c-404d-39bd-b0d3-08c7af696ca0",
                                        "entry_id": "641bc85f-5870-3320-976a-bad630b1285e",
                                        "glosses": [
                                            "True, especially as far as is known by the person making the statement; fair; unbiased."
                                        ],
                                        "tags": [
                                            "of a statement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d07856a-7dd7-4904-8460-82ed7730d795",
                                                "sense_id": "6bf13b1c-404d-39bd-b0d3-08c7af696ca0",
                                                "text": "an honest account of events"
                                            },
                                            {
                                                "example_id": "3b167f49-c305-42db-a303-0bad096db0dc",
                                                "sense_id": "6bf13b1c-404d-39bd-b0d3-08c7af696ca0",
                                                "text": "honest reporting"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "176ae173-3966-317b-8a27-4bf6559a0f50",
                                        "entry_id": "641bc85f-5870-3320-976a-bad630b1285e",
                                        "glosses": [
                                            "In good faith; without malice."
