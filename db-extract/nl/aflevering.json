                "senses": [
                    {
                        "sense_id": "1c2579ef-c639-3aba-9487-b463f131e711",
                        "entry_id": "fb3f7b13-bd15-3eb1-b3a9-25b8244faf75",
                        "glosses": [
                            "elk onderdeel van een tv-serie dat op regelmatige tijden wordt uitgebracht of uitgezonden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e775200-17e3-450b-9b40-26e774bc04bb",
                                "sense_id": "1c2579ef-c639-3aba-9487-b463f131e711",
                                "text": "Ik heb die aflevering al drie keer gezien!"
                            },
                            {
                                "example_id": "ffb6767f-9ff5-4a49-98f9-d3ed206f29a7",
                                "sense_id": "1c2579ef-c639-3aba-9487-b463f131e711",
                                "text": "Het beeld dat u schetst hoort echter meer thuis in een aflevering van The Sopranos."
                            },
                            {
                                "example_id": "794233ea-bf9f-416f-a4a5-45bf1b96b112",
                                "sense_id": "1c2579ef-c639-3aba-9487-b463f131e711",
                                "text": "Van Veen, die al in de eerste aflevering in 1990 te zien was, hoorde vorig jaar dat ze uit de serie werd geschreven. In december werd de laatste aflevering uitgezonden waarin ze nog te zien was."
                            }
                        ]
                    },
                    {
                        "sense_id": "42783de4-ba66-3f6a-a4d7-c568ec8bd908",
                        "entry_id": "fb3f7b13-bd15-3eb1-b3a9-25b8244faf75",
                        "glosses": [
                            "het afleveren van iets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bb9a6a6-2d01-4e15-a999-6d65f5dc92f8",
                                "sense_id": "42783de4-ba66-3f6a-a4d7-c568ec8bd908",
                                "text": "De aflevering van deze goederen zal door het noodweer wat vertraagd worden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61e01aa8-f667-401b-a933-d2cba04bda42",
                        "source_entry_id": "fb3f7b13-bd15-3eb1-b3a9-25b8244faf75",
                        "source_sense_id": "1c2579ef-c639-3aba-9487-b463f131e711",
                        "source_sense_description": "elk onderdeel van een tv-serie dat op regelmatige tijden wordt uitgebracht of uitgezonden",
                        "target_lang_word": "Folge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Folge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b0c35507-758e-310e-b050-4006f107ec20",
                                        "entry_id": "f8586ebb-4a3a-381f-a2fb-2ed57d63e5b3",
                                        "glosses": [
                                            "Ergebnis oder Wirkung einer Handlung oder eines Geschehens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17aaf3e3-099e-49c2-b479-326fe96c3c86",
                                                "sense_id": "b0c35507-758e-310e-b050-4006f107ec20",
                                                "text": "„Aber die Grenzsprengung auf der wirtschaftlichen Seite hat zwangsweise die Grenzsprengung auf der sozial-gesellschaftlichen Seite zur Folge.“"
                                            },
                                            {
                                                "example_id": "173128d4-5dda-49fe-8cad-9ff17143ab4a",
                                                "sense_id": "b0c35507-758e-310e-b050-4006f107ec20",
                                                "text": "„Sie haben wohl davon gehört, wie er 1997 die Folgen der großen Oderflut linderte, wie er sich einen Namen als Krisenmanager machte und bald von vielen ‚Der Deichgraf’ genannt wurde.“"
                                            },
                                            {
                                                "example_id": "d4a3a368-ed5f-4a62-be8b-52d4e6505c92",
                                                "sense_id": "b0c35507-758e-310e-b050-4006f107ec20",
                                                "text": "„Ihr Tod hatte Folgen, die mich nötigten, eine andere Lebensweise zu beginnen.“"
                                            },
                                            {
                                                "example_id": "bb10fa7d-cb73-4b59-89d9-dda9b3465c61",
                                                "sense_id": "b0c35507-758e-310e-b050-4006f107ec20",
                                                "text": "Schulden waren die Folge der zu hohen Ausgaben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "40af18c9-fc3c-38e6-9cab-0daba1823916",
                                        "entry_id": "f8586ebb-4a3a-381f-a2fb-2ed57d63e5b3",
                                        "glosses": [
                                            "Reihe von aufeinanderfolgenden Dingen oder Ereignissen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0eb10e0-4152-4687-a927-94fbad4cfa45",
                                                "sense_id": "40af18c9-fc3c-38e6-9cab-0daba1823916",
                                                "text": "Nach einer Folge von mysteriösen Zwischenfällen wurde ein Ermittler mit deren Aufklärung beauftragt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "464fa4a5-e83b-3982-965f-e5cc2b51e014",
                                        "entry_id": "f8586ebb-4a3a-381f-a2fb-2ed57d63e5b3",
                                        "glosses": [
                                            "Teil einer Serie, insbesondere bei Büchern, Zeitschriften, Fernsehserien und Hörspielen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e728bdf-a994-497f-850d-32b72e889fae",
                                                "sense_id": "464fa4a5-e83b-3982-965f-e5cc2b51e014",
                                                "text": "Nach der dritten Folge wurde die Fernsehserie mangels Zuschauerinteresses abgesetzt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "1032911b-beff-38fc-bcda-8f876d5dbaf7",
                                        "entry_id": "f8586ebb-4a3a-381f-a2fb-2ed57d63e5b3",
                                        "glosses": [
                                            "in ihrer Reihenfolge festgelegte Liste von Zahlen; genauer: eine Abbildung der natürlichen Zahlen auf eine andere Menge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a7e7bcd-b4fd-41c8-aaf7-858223c5d8fc",
                                                "sense_id": "1032911b-beff-38fc-bcda-8f876d5dbaf7",
                                                "text": "Eine in ihrer Anordnung festgelegte Auflistung von endlich oder unendlich vielen Zahlen heißt in der Mathematik Zahlenfolge oder kurz Folge. Die einzelnen Zahlen, aus denen die Folge zusammengesetzt ist, heißen die Glieder der Folge."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "96993466-1fe5-4c7a-9c91-31956f031c8f",
                        "source_entry_id": "fb3f7b13-bd15-3eb1-b3a9-25b8244faf75",
                        "source_sense_id": "1c2579ef-c639-3aba-9487-b463f131e711",
                        "source_sense_description": "elk onderdeel van een tv-serie dat op regelmatige tijden wordt uitgebracht of uitgezonden",
                        "target_lang_word": "episode",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "episode",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2fd9fdad-79a1-3a35-bcd1-503c661cfc8d",
                                        "entry_id": "0fd6c845-1c9b-3b60-a99b-23403e4018bd",
                                        "glosses": [
                                            "An incident, action, or time period standing out by itself, but more or less connected with a complete series of events."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b675bb2-a741-4a57-a0ac-80ec7f0da6c5",
                                                "sense_id": "2fd9fdad-79a1-3a35-bcd1-503c661cfc8d",
                                                "text": "It was a most embarrassing episode in my life."
                                            },
                                            {
                                                "example_id": "f75a63f1-7462-4e7f-a528-8b1b0f70a32e",
                                                "sense_id": "2fd9fdad-79a1-3a35-bcd1-503c661cfc8d",
                                                "text": "The Attorney-General, however, had used this episode, which Martin in retrospect had felt to be a blot on the scutcheon, merely to emphasise the intelligence and resource of the prisoner."
                                            },
                                            {
                                                "example_id": "e8d1ef6a-dcb1-4b30-a707-9f5563a4c269",
                                                "sense_id": "2fd9fdad-79a1-3a35-bcd1-503c661cfc8d",
                                                "text": "Three of the great extinctions appear to have occurred during cold episodes and two during hot episodes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c34c398-ef11-31bf-9e86-9917c0b6e5ca",
                                        "entry_id": "0fd6c845-1c9b-3b60-a99b-23403e4018bd",
                                        "glosses": [
                                            "An installment of a drama told in parts, as in a TV series."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "411cece0-9fd4-4dea-ba4a-0be53f8010e9",
                                                "sense_id": "9c34c398-ef11-31bf-9e86-9917c0b6e5ca",
                                                "text": "I can't wait till next week’s episode."
                                            },
                                            {
                                                "example_id": "65b7587a-fe4f-47a8-8f2b-0426ff148f41",
                                                "sense_id": "9c34c398-ef11-31bf-9e86-9917c0b6e5ca",
                                                "text": "We all know how genius “Kamp Krusty,” “A Streetcar Named Marge,” “Homer The Heretic,” “Itchy & Scratchy: The Movie” and “Mr. Plow” are, but even the relatively unheralded episodes offer wall-to-wall laughs and some of the smartest, darkest, and weirdest gags ever Trojan-horsed into a network cartoon with a massive family audience."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
