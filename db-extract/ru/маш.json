        "ru-extract.jsonl": [
            {
                "entry_id": "1f70aeaa-05b8-384e-8a6b-c27618ca9c99",
                "word": "МАШ",
                "pos": "abbrev",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9d66a76e-f5c0-324b-8df2-34c767bbd994",
                        "entry_id": "1f70aeaa-05b8-384e-8a6b-c27618ca9c99",
                        "glosses": [
                            "сокр. от международный аэропорт Шереметьево"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3822b214-0881-4301-a69d-d130460b6f00",
                                "sense_id": "9d66a76e-f5c0-324b-8df2-34c767bbd994",
                                "text": "Принадлежащий государству Международный аэропорт Шереметьево (МАШ) оценили в 53 млрд руб. — в пять раз выше подконтрольного «Аэрофлоту» и ВЭБу ОАО «Терминал». ❬…❭ В конце прошлого года «Аэрофлот», МАШ и ВЭБ заказали Ernst & Young провести вторую оценку бизнеса ❬…❭ По данным источников РБК daily, ОАО «Терминал» было оценено в 10,7 млрд руб., или 353 млн долл., а остальные терминалы — B, C, D, E и F (операторами которых является МАШ) — в 53 млрд руб. (1,743 млрд долл.)."
                            }
                        ]
                    }
                ],
