                        "glosses": [
                            "Personne de genre masculin qui pratique une sexualité intermédiaire entre sexuel et asexuel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00ebbb66-3e09-4405-bb5a-0ec7fb76173d",
                                "sense_id": "22230078-e0dd-3d1b-a16f-f7510052e206",
                                "text": "Les graysexuels se placent dans un entre-deux, l'asexualité et la sexualité. Ceux qui se disent graysexuels peuvent également s'identifier comme homo, hétéro ou d'une toute autre identité sexuelle."
                            }
