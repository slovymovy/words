                    {
                        "translation_id": "c3343bf9-93a0-4cdd-a75d-46eec10f84f9",
                        "source_entry_id": "733a5512-73a1-3ae6-b082-98f36685322e",
                        "source_sense_id": "1887476f-efd4-3705-9e26-c0de381e8cea",
                        "source_sense_description": "behuizing voor rundvee",
                        "target_lang_word": "Kuhstall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kuhstall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2683120a-6632-3f3c-9cfb-b4150ad946c3",
                                        "entry_id": "8d7d7f7b-4bca-3424-bf1a-99b9a4c744dc",
                                        "glosses": [
                                            "Gebäude einer Farm, eines landwirtschaftlichen Betriebs, das zur Unterbringung von Kühen dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e981801-e78f-425e-bb23-ab876625a761",
                                                "sense_id": "2683120a-6632-3f3c-9cfb-b4150ad946c3",
                                                "text": "Am Abend bringen wir die Kühe wieder in den Kuhstall."
                                            },
                                            {
                                                "example_id": "1acf77ce-d9b0-4510-a7fc-116b2e036443",
                                                "sense_id": "2683120a-6632-3f3c-9cfb-b4150ad946c3",
                                                "text": "„Sie rannten zu den Heuballen, die den rückwärtigen Eingang des Kuhstalls versperrten, und krochen dann so tief geduckt wie möglich zum Hühnerstall unter dem Küchenfenster.“"
                                            },
                                            {
                                                "example_id": "11052dc1-4a3c-490b-940e-4fd5eb90ae2a",
                                                "sense_id": "2683120a-6632-3f3c-9cfb-b4150ad946c3",
                                                "text": "„Zwar wird Claudia von ihrer Amme getreulich versorgt, und ein neuer, energischer Kommandant hat im Kuhstall wieder eine bescheidene Herde zusammengebracht.“"
                                            },
                                            {
                                                "example_id": "5555475c-f37e-47e6-86bf-cc02f2fe0492",
                                                "sense_id": "2683120a-6632-3f3c-9cfb-b4150ad946c3",
                                                "text": "„Der deutsche Quartierwirt guckte in Wams und Zipfelmütze, in der Hand die Mistgabel, mit der er den Kuhstall ausgemistet hatte, aus der Stalltür.“"
                                            },
                                            {
                                                "example_id": "a689700a-a5d4-454b-85e0-d2a6e537ad34",
                                                "sense_id": "2683120a-6632-3f3c-9cfb-b4150ad946c3",
                                                "text": "„Die übrigen Notabeln seien: der Graf de Faverges, ehemals Abgeordneter, dessen Kuhställe musterhaft waren; der Bürgermeister, Monsieur Foureau, der mit Holz, Gips und allen möglichen Sachen handelte; ferner Monsieur Marescot, der Notar; der Abbé Jeufroy und die Witwe Bordin, die von ihren Zinsen lebe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3a3f7b9-9bf8-4081-86c6-be963d3cb8d5",
                        "source_entry_id": "733a5512-73a1-3ae6-b082-98f36685322e",
                        "source_sense_id": "1887476f-efd4-3705-9e26-c0de381e8cea",
                        "source_sense_description": "behuizing voor rundvee",
                        "target_lang_word": "cowshed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cowshed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63e147a1-5dad-3c26-849b-29297c3d1927",
                                        "entry_id": "a295b946-6027-3a20-8ce6-0fc94871b279",
                                        "glosses": [
                                            "A shed for keeping cows."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d9c2258-e774-401f-b0df-c8d328bb4527",
                                                "sense_id": "63e147a1-5dad-3c26-849b-29297c3d1927",
                                                "text": "K-K-K-Katy, beautiful Katy, / You're the only g-g-g-girl that I adore; / When the m-m-m-moon shines, / Over the cowshed, / I'll be waiting at the k-k-k-kitchen door."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b129734e-0e44-494f-9125-9d0cde6141d2",
                        "source_entry_id": "733a5512-73a1-3ae6-b082-98f36685322e",
                        "source_sense_id": "1887476f-efd4-3705-9e26-c0de381e8cea",
                        "source_sense_description": "behuizing voor rundvee",
                        "target_lang_word": "byre",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "byre",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd2a28c1-c944-3875-a3f5-fe7e52253aaa",
                                        "entry_id": "14128257-bab5-3db1-a8ed-182ad9a2867e",
                                        "glosses": [
                                            "A barn, especially one used for keeping cattle in."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ef6e365-561b-47b8-8a02-2b708e5e7665",
                                                "sense_id": "cd2a28c1-c944-3875-a3f5-fe7e52253aaa",
                                                "text": "It was here in the kitchen, in the passage,\nIn the mews in the harn in the byre in the market-place [...]"
                                            },
                                            {
                                                "example_id": "1e354f65-3959-4fac-b6ed-953d190f261b",
                                                "sense_id": "cd2a28c1-c944-3875-a3f5-fe7e52253aaa",
                                                "text": "’Children crawled over each other like little grey worms in the gutters,’ he said. ‘The only red things about them were their buttocks and they were raw. Their faces looked as if snails had slimed on them and their mothers were like great sick beasts whose byres had never been cleared.[…]’"
                                            },
                                            {
                                                "example_id": "2814b532-a937-4fd9-b881-ef812a39da2c",
                                                "sense_id": "cd2a28c1-c944-3875-a3f5-fe7e52253aaa",
                                                "text": "The visitors came up the narrow road through the forest from the south; they filled the spare-rooms, they bunked out in cow byres and barns."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e6fcaa7-48eb-4a02-a680-554b1432febd",
                        "source_entry_id": "733a5512-73a1-3ae6-b082-98f36685322e",
                        "source_sense_id": "1887476f-efd4-3705-9e26-c0de381e8cea",
                        "source_sense_description": "behuizing voor rundvee",
                        "target_lang_word": "vacherie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vacherie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "68a28231-d4de-346c-aba4-fd106529ce59",
                                        "entry_id": "cdb56460-0b8f-3ad2-ab02-93e786a7d00c",
                                        "glosses": [
                                            "Étable à vaches."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07107246-51e3-43cc-aab3-2017e6104557",
                                                "sense_id": "68a28231-d4de-346c-aba4-fd106529ce59",
                                                "text": "Sous le ciel pâlissant, les bâtiments de la Borderie sommeillaient encore, à demi sombres, trois longs bâtiments aux trois bords de la vaste cour carrée, la bergerie au fond, les granges à droite, la vacherie, l’écurie et la maison d’habitation à gauche."
                                            },
                                            {
                                                "example_id": "e0608888-a772-4035-b4b8-a170de4c5c0f",
                                                "sense_id": "68a28231-d4de-346c-aba4-fd106529ce59",
                                                "text": "Tous les jours, actuellement, l’étable fournit 250 à 300 litres de lait. Recueilli dans de vastes « berthes » brillantes il est remis au service de la stérilisation qui occupe la partie droite de la vacherie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39aad0cf-9d3d-3932-9ed8-d36c9926f07f",
                                        "entry_id": "cdb56460-0b8f-3ad2-ab02-93e786a7d00c",
                                        "glosses": [
                                            "Méchanceté, trahison."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1651037f-39ee-45c4-af7e-7baedc3c6166",
                                                "sense_id": "39aad0cf-9d3d-3932-9ed8-d36c9926f07f",
                                                "text": "Et c’est encore ce maudit esprit de soumission qui ferme le bec aux esclaves et les empêche de gueuler aux quatre coins de Paris les vacheries qu’elles endurent."
                                            },
                                            {
                                                "example_id": "f140bc69-074c-4b63-86c6-4a3eb4887696",
                                                "sense_id": "39aad0cf-9d3d-3932-9ed8-d36c9926f07f",
                                                "text": "« En plus de toutes les vacheries que tu nous as fait endurer, à moi et à ta mère, tu me bafoues, comme un salaud que tu es, et tu as obligé le facteur à se payer de ma gueule ! »"
                                            },
                                            {
                                                "example_id": "f88d62ea-92ca-4adc-a0e5-9ea28fd1288d",
                                                "sense_id": "39aad0cf-9d3d-3932-9ed8-d36c9926f07f",
                                                "text": "Je savais qu’il préparait un truc en catimini, mais jamais, l’idée d’une telle vacherie ne m’a effleuré.."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd5e12d1-68f7-39d9-a2d9-087898c2ffcf",
                                        "entry_id": "cdb56460-0b8f-3ad2-ab02-93e786a7d00c",
                                        "glosses": [
                                            "Événement pénible."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed51064d-1e4f-4468-83f3-50ea34459013",
                                                "sense_id": "bd5e12d1-68f7-39d9-a2d9-087898c2ffcf",
                                                "text": "Vacherie de vie ! dit le premier. On était si bien ici."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "699c3776-6cc6-4144-97a5-b55f872e34b5",
                        "source_entry_id": "733a5512-73a1-3ae6-b082-98f36685322e",
                        "source_sense_id": "1887476f-efd4-3705-9e26-c0de381e8cea",
                        "source_sense_description": "behuizing voor rundvee",
                        "target_lang_word": "étable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "étable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6e642b47-6257-3178-af43-f1b93c3e4bdc",
                                        "entry_id": "c62ab451-9332-3d15-9385-1e2de5464abb",
                                        "glosses": [
                                            "Lieu où l’on loge des bœufs, des vaches, des brebis et autres bestiaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c26e4c53-ad0b-4d59-b32c-20115c6781b5",
                                                "sense_id": "6e642b47-6257-3178-af43-f1b93c3e4bdc",
                                                "text": "Mac Nap avait eu le temps de construire une étable bien close, destinée aux rennes domestiques."
                                            },
                                            {
                                                "example_id": "534e1b6c-5a02-4613-abbf-30fcfa3e37a2",
                                                "sense_id": "6e642b47-6257-3178-af43-f1b93c3e4bdc",
                                                "text": "Elle était parvenue, certaine nuit à couler dans la grange son corps vermiforme, et de là, tombant par les abat-foin dans le râtelier des vaches, à pénétrer dans l’étable chaude où logeaient les poules."
                                            },
                                            {
                                                "example_id": "e37ce7a0-10d0-460c-931c-845e2829bde7",
                                                "sense_id": "6e642b47-6257-3178-af43-f1b93c3e4bdc",
                                                "text": "Une basse-cour, une étable, des toits à porcs faisaient face à la maison."
                                            },
                                            {
                                                "example_id": "3569ac68-e25a-457b-acce-5d4b9cff70bf",
                                                "sense_id": "6e642b47-6257-3178-af43-f1b93c3e4bdc",
                                                "text": "Monsieur le juge, comment serait-il possible que je possédasse une vache tachetée ou pas tachetée, n’ayant ni étable pour la loger, ni champ pour la nourrir."
                                            },
                                            {
                                                "example_id": "c658ca90-be05-458e-af3c-bb410e7e13bb",
                                                "sense_id": "6e642b47-6257-3178-af43-f1b93c3e4bdc",
                                                "text": "Imaginez des étables géantes où vivent 1.680 vaches."
                                            }
                                        ]
                                    }
                                ]
                            },
