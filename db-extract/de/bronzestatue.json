                "senses": [
                    {
                        "sense_id": "5c7c3efc-0cb8-3a0a-bee7-e4dd0c43d396",
                        "entry_id": "3b0dc1fd-680e-3d41-b89b-7421c3d5f41a",
                        "glosses": [
                            "Statue, hergestellt aus Bronze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adff8650-50e9-452a-9237-b824e2120a4e",
                                "sense_id": "5c7c3efc-0cb8-3a0a-bee7-e4dd0c43d396",
                                "text": "„Aus rund 20 Meter Höhe starrt die umstrittene Bronzestatue des ehemaligen Bürgermeisters Karl Lueger auf den Wiener Stubenring.“"
                            },
                            {
                                "example_id": "4f51b07e-07fd-40ed-b79e-15ce796db503",
                                "sense_id": "5c7c3efc-0cb8-3a0a-bee7-e4dd0c43d396",
                                "text": "„2002 lässt Kongos Präsident Joseph Kabila eine Bronzestatue des Freiheitskämpfers in Kinshasa errichten.“"
                            },
                            {
                                "example_id": "a6a48e02-a0d9-4622-a5c1-b4b0479a5faf",
                                "sense_id": "5c7c3efc-0cb8-3a0a-bee7-e4dd0c43d396",
                                "text": "„Im Tempel befand sich mit großer Sicherheit die Bronzestatue der Göttin Sequana, einer erhabenen Frau in gegürtetem Faltengewand, mit einem Diadem auf der Stirn und schulterlangen Haaren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
