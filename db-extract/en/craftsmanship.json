                                    {
                                        "sense_id": "f2d4672b-4470-30c1-ac11-ca95c51f1a46",
                                        "entry_id": "42711545-9f4e-3d84-a4b2-a075b1121601",
                                        "glosses": [
                                            "drobna wytwórczość przemysłowa, polegająca na wytwarzaniu i naprawie przedmiotów codziennego użytku przy pomocy ręcznych narzędzi i prostych maszyn; także: umiejętność prowadzenia takiej działalności"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69f64308-c3b9-454c-b685-cc15e0fc29d7",
                                                "sense_id": "f2d4672b-4470-30c1-ac11-ca95c51f1a46",
                                                "text": "W ostatnich latach obserwuje się wzrost zainteresowania dawnymi rzemiosłami."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "203cf9ea-a878-39a9-a483-2700c4470c0d",
                                        "entry_id": "42711545-9f4e-3d84-a4b2-a075b1121601",
                                        "glosses": [
                                            "umiejętności warsztatowe artysty, obejmujące technikę tworzenia i znajomość formy dzieła"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96b033bf-2217-40e8-890e-f3007245fdc8",
                                                "sense_id": "203cf9ea-a878-39a9-a483-2700c4470c0d",
                                                "text": "Ta rzeźba jest świadectwem nie tylko niezwykłej wyobraźni artysty, lecz także doskonale opanowanego rzemiosła."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "572fe261-e291-3bd2-9cf6-8137cfaa6882",
                                        "entry_id": "42711545-9f4e-3d84-a4b2-a075b1121601",
                                        "glosses": [
                                            "twórczość o niskich walorach artystycznych"
                                        ],
                                        "tags": [
                                            "scornfully"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82780b10-d4c1-48f6-9eed-5154ed1069b3",
                                                "sense_id": "572fe261-e291-3bd2-9cf6-8137cfaa6882",
                                                "text": "Powiedz, komu zamierzasz wcisnąć to marne rzemiosło?"
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "78ebb307-9457-34fc-9f98-93e3a45d8d36",
                                        "entry_id": "42711545-9f4e-3d84-a4b2-a075b1121601",
                                        "glosses": [
                                            "zawód, profesja, zajęcie"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "091b17d8-0eec-41d9-b3e9-800a363f43e2",
                                                "sense_id": "78ebb307-9457-34fc-9f98-93e3a45d8d36",
                                                "text": "Tego lata poznaliśmy trochę lekarskiego rzemiosła."
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
                                    }
                                ]
