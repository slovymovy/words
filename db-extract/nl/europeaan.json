                "translations": [
                    {
                        "translation_id": "2db1862b-3154-4cdd-b262-05f48b9309fb",
                        "source_entry_id": "a5bbea7c-379d-32dd-ab52-910076330de5",
                        "source_sense_id": "1e2592bd-091c-3280-9c79-a3923d8731c4",
                        "source_sense_description": "bewoner van het Europese continent of iemand die daarvan afkomstig is",
                        "target_lang_word": "Europäer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Europäer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "267581c3-91ac-3286-b986-0033e6fd3a6a",
                                        "entry_id": "f03ad5e7-508f-30f3-bcdb-4b5f3971bb83",
                                        "glosses": [
                                            "Bewohner des europäischen Kontinents"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e65a42bc-f20d-459c-8112-d74302961800",
                                                "sense_id": "267581c3-91ac-3286-b986-0033e6fd3a6a",
                                                "text": "Der Europäer - das unbekannte Wesen."
                                            },
                                            {
                                                "example_id": "92b7f8eb-a3ff-4e37-8a6b-03155dc51818",
                                                "sense_id": "267581c3-91ac-3286-b986-0033e6fd3a6a",
                                                "text": "„Doch solange dieser Staat und ein nennenswerter Teil der Gesellschaft bereit sind, alles in ihrer Macht Stehende zu tun, um uns zu schützen, werde ich kein Israeli, bleibe ich Europäer, Deutscher.“"
                                            },
                                            {
                                                "example_id": "2bb72e56-1eab-4d85-96c8-3e1ebc70be3a",
                                                "sense_id": "267581c3-91ac-3286-b986-0033e6fd3a6a",
                                                "text": "„Er sieht in den Europäern also keine Gegner, sondern mögliche Aliierte.“"
                                            },
                                            {
                                                "example_id": "fcc0384a-4bb6-4559-ab85-3d2e475caa75",
                                                "sense_id": "267581c3-91ac-3286-b986-0033e6fd3a6a",
                                                "text": "„Und dann ist er ja auch noch ein glühender Europäer, was viele schreckt, die nicht so genau hinschauen.“"
                                            },
                                            {
                                                "example_id": "0c9f875d-7eb1-4d15-a50e-d37237378fad",
                                                "sense_id": "267581c3-91ac-3286-b986-0033e6fd3a6a",
                                                "text": "„Die großen Reiche Asiens – die Osmanen, Perser, Moguln und Chinesen – bekamen sehr bald mit, dass die Europäer einen neuen Kontinent entdeckt hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ee0b9a3-1620-4889-9753-81e7738e8f4c",
                        "source_entry_id": "a5bbea7c-379d-32dd-ab52-910076330de5",
                        "source_sense_id": "1e2592bd-091c-3280-9c79-a3923d8731c4",
                        "source_sense_description": "bewoner van het Europese continent of iemand die daarvan afkomstig is",
                        "target_lang_word": "European",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
