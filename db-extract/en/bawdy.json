                                                "sense_id": "c8f2acf2-213b-3133-bd3b-a71d20824b68",
                                                "text": "Une chanson paillarde fut reprise en chœur."
                                            },
                                            {
                                                "example_id": "4f17761f-7e34-4b2b-bc24-847d6a02655c",
                                                "sense_id": "c8f2acf2-213b-3133-bd3b-a71d20824b68",
                                                "text": "Broudier eut un rire gras comme s’il découvrait aux paroles de Bénin quelque sens paillard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4861478b-b702-3012-ba54-a2fbc17c6a53",
                                        "entry_id": "70920cf8-e8c2-3776-986d-1e235c5f2338",
                                        "glosses": [
                                            "Qui mène une vie dissolue, qui s’adonne à la luxure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de0ed296-badf-4d53-83ba-9230b320682e",
                                                "sense_id": "4861478b-b702-3012-ba54-a2fbc17c6a53",
                                                "text": "Avoir la mine paillarde, mener une vie de paillard."
                                            },
                                            {
                                                "example_id": "a88c01a0-b592-429a-be24-0129d5c5626e",
                                                "sense_id": "4861478b-b702-3012-ba54-a2fbc17c6a53",
                                                "text": "« Tu peux être sûr qu’avant la fin de l’année, tous les hommes de l’Université seront allés là-bas, fit une voix épaissie par l’alcool.\n– Je parie que non ! s’écria Mac Allister.\n– Exception faite pour quelques futurs pasteurs, dit une autre voix.\n– Imbécile ! Ceux-là sont les plus paillards !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1928bc07-a175-37e9-86eb-5f3eb00891c0",
                                        "entry_id": "70920cf8-e8c2-3776-986d-1e235c5f2338",
                                        "glosses": [
                                            "Qui couche sur la paille, personne misérable."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "paillard",
