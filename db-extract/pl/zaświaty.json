                                "target_senses": [
                                    {
                                        "sense_id": "b80af7ea-b470-30d6-8869-e8f0a73ec483",
                                        "entry_id": "0c5c6557-bbe1-39b7-a445-9c7deaab15ed",
                                        "glosses": [
                                            "The world of the dead, located underneath the world of the living; the afterlife."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "508b9c51-c332-4fcd-9998-c23ac551a85c",
                                                "sense_id": "b80af7ea-b470-30d6-8869-e8f0a73ec483",
                                                "text": "In Hindu scriptures, the four-eyed dogs Śārvara and Śyāma guard the underworld's entrance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8e431e6-405d-3fad-a27f-9917b4ebefea",
                                        "entry_id": "0c5c6557-bbe1-39b7-a445-9c7deaab15ed",
                                        "glosses": [
                                            "That part of society that is engaged in crime or vice, and particularly those involved in organized crime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80f798ff-f701-47cd-bde8-aa7c0d5d009f",
                                                "sense_id": "b8e431e6-405d-3fad-a27f-9917b4ebefea",
                                                "text": "A disproportionate amount of local politicians have connections to the underworld."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28c8ea74-35d8-3200-b1f9-f2d7c1414503",
                                        "entry_id": "0c5c6557-bbe1-39b7-a445-9c7deaab15ed",
                                        "glosses": [
                                            "The portion of a game that is set below ground."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "324b28f0-a5c2-49e9-9171-7dee8ef1e39d",
                                                "sense_id": "28c8ea74-35d8-3200-b1f9-f2d7c1414503",
                                                "text": "In the underworld theme, low notes create a darker feeling that matches the cave setting. This song also creates a sense of continuity across early Mario games, since it's a remix of SMB1's original underworld theme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed7992b9-4114-4d69-abf9-176ac3304f79",
