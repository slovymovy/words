                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d043ec7f-21ed-3744-bee4-0ca0c10beef9",
                        "entry_id": "b0b0b281-b02b-37cc-a00e-8fb8ed8f9607",
                        "glosses": [
                            "Variante ancienne de Kiev (capitale de l’Ukraine)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c511b7d0-fbda-47c0-83d5-779096d4626e",
                                "sense_id": "d043ec7f-21ed-3744-bee4-0ca0c10beef9",
                                "text": "Des architectes et des peintres élèvent et décorent des églises à Kief, à Novgorod ; d’ici quelques années, Kief deviendra l’émule en beauté de Constantinople."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "94fbd6a0-b3c5-37c4-a4e2-316a0114070d",
