                ],
                "senses": [
                    {
                        "sense_id": "6b189702-841b-31ef-b7fc-dd458915fec6",
                        "entry_id": "b2006d22-f2a5-39ab-93da-e3804994da43",
                        "glosses": [
                            "der Ansatz und die Betrachtungsweise, dass psychische Zustände oder geistige Vorgänge sich auf den Krankheits- beziehungsweise Gesundheitszustand des betreffenden Menschen auswirken und sich in körperlichen Symptomen zeigen können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d18d64f-69f7-4651-a56d-c6dca9c3eaa5",
                                "sense_id": "6b189702-841b-31ef-b7fc-dd458915fec6",
                                "text": "„Die Ursprünge der Psychosomatik lassen sich bis an die Anfänge der Medizin zurückverfolgen […].“"
                            },
                            {
                                "example_id": "661ee529-6113-4ede-8b96-2775cd34b6bc",
                                "sense_id": "6b189702-841b-31ef-b7fc-dd458915fec6",
                                "text": "„Sprache wurde zum zentralen Behandlungswerkzeug der Psychotherapie und der Psychosomatik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "119f7fbb-628f-4d82-8565-a683e1282230",
                        "source_entry_id": "b2006d22-f2a5-39ab-93da-e3804994da43",
