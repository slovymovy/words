                        "sense_id": "01a80383-fba8-3984-baf0-43a4f096f1b0",
                        "entry_id": "90cbeca7-5de7-354c-ae51-4ba44d0f0c8c",
                        "glosses": [
                            "Incautious; precipitate; heedless."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "57dc0a72-3fea-403c-913e-b34423598e80",
                                "sense_id": "01a80383-fba8-3984-baf0-43a4f096f1b0",
                                "text": "Love looks not with the eyes, but with the mind\nAnd therefore is winged Cupid painted blind.\nNor hath love's mind of any judgement taste;\nWings and no eyes figure unheedy haste.\nAnd therefore is love said to be a child\nBecause in choice he is so oft beguiled."
                            },
                            {
                                "example_id": "ae75149e-9c70-4ae6-8b36-fc4d7ab31d26",
                                "sense_id": "01a80383-fba8-3984-baf0-43a4f096f1b0",
                                "text": "So have I seen some tender slip,\nSaved with care from winter's nip,\nThe pride of her carnation train,\nPlucked up by some unheedy swain\nWho only thought to crop the flower"
                            }
                        ]
                    }
