            {
                "entry_id": "081c015b-9456-3646-bcfe-ab0ef562bd62",
                "word": "féculent",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "61a3ca7d-3820-484c-b7e3-9960a713533e",
                        "entry_id": "081c015b-9456-3646-bcfe-ab0ef562bd62",
                        "tags": [
                            "plural"
