                    {
                        "sense_id": "55e51af3-41eb-35f9-8ca9-b28672a6f8cb",
                        "entry_id": "78cb9aee-7a5d-3627-942e-81fa0d5b31d7",
                        "glosses": [
                            "geld dat mensen ontvangen die geen recht hebben op een andere (hogere) uitkering"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab6ad212-cecd-4a0e-b33f-1f90f3cce2a5",
                                "sense_id": "55e51af3-41eb-35f9-8ca9-b28672a6f8cb",
                                "text": "Ook uitkeringsgerechtigden leverden veel in. Zo zagen gepensioneerden voor het derde jaar op rij de koopkracht dalen, nu met 1,2 procent. Mensen met een bijstanduitkering verloren 1,5 procent."
                            },
                            {
                                "example_id": "c9c97ca2-925f-4ebb-8698-0e4783ce4a2b",
                                "sense_id": "55e51af3-41eb-35f9-8ca9-b28672a6f8cb",
                                "text": "Rotterdam wil dit jaar duizend werklozen met een bijstanduitkering in de kassen van het Westland aan het werk zetten. En het jaar daarna nog eens duizend. Marco Florijn - wethouder van Sociale Zaken in Rotterdam - weet dat veel bestuurders dat eerder al zonder succes hebben geprobeerd, maar hij is ervan overtuigd dat het hem wél gaat lukken."
                            }
                        ]
                    }
