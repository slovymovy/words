                                "example_id": "909c08b7-1b99-4e80-b99b-de5148f4e8ca",
                                "sense_id": "3c582fc6-a1ed-3f9d-97c6-7d8f12e067b8",
                                "text": "Alacke the time that ever I was borne, / To be partaker of this destinie. / Alacke the day, alacke and welladay."
                            },
                            {
                                "example_id": "47fb1c64-6770-42c4-af70-03f8752678bc",
                                "sense_id": "3c582fc6-a1ed-3f9d-97c6-7d8f12e067b8",
                                "text": "Ah! wel-a-day! what evil looks / Had I from old and young; / Instead of the Cross the Albatross / About my neck was hung."
                            }
                        ]
                    }
