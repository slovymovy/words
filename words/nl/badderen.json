            "senses": [
                {
                    "sense_id": "0f13f944-dd63-3e1a-886e-c05f8842e5cb",
                    "sense_definition": "Zich wassen of ontspannen in een bad.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "wassen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een lange werkdag vindt ze het heerlijk om urenlang te <w>badderen</w>.",
                            "target_lang_translations": {
                                "en": "After a long workday, she loves to <w>soak in the bath</w> for hours."
                            }
                        },
                        {
                            "text": "De kinderen moeten vanavond nog even <w>badderen</w> voordat ze naar bed gaan.",
                            "target_lang_translations": {
                                "en": "The children still need to <w>take a bath</w> tonight before going to bed."
                            }
                        }
                    ],
                    "synonyms": [
                        "baden",
                        "wassen"
                    ],
                    "common_phrases": [
                        "lekker badderen",
                        "in bad badderen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vaak gebruikt in een informele of gezellige context."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To wash or relax in a bathtub."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to bathe",
                                "target_lang_sense_clarification": "to take a bath for relaxation or washing"
                            },
                            {
                                "target_lang_word": "to take a bath",
                                "target_lang_sense_clarification": "to wash oneself in a tub"
                            },
                            {
                                "target_lang_word": "to soak",
                                "target_lang_sense_clarification": "to lie in a bath for relaxation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c0024e9-f56e-3722-bdfc-5dc9f9591bee",
                    "sense_definition": "Zich in het water vermaken door te zwemmen, te spelen of te spetteren.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "spelen_in_water",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De peuters waren vrolijk aan het <w>badderen</w> in het kleine opblaasbare zwembadje.",
                            "target_lang_translations": {
                                "en": "The toddlers were happily <w>splashing around</w> in the small inflatable pool."
                            }
                        },
                        {
                            "text": "In de zomer zie je overal mensen gezellig <w>badderen</w> in het meer.",
                            "target_lang_translations": {
                                "en": "In the summer, you see people everywhere enjoying a <w>dip</w> in the lake."
                            }
                        }
                    ],
                    "synonyms": [
                        "pootjebaden",
                        "spetteren",
                        "plonzen"
                    ],
                    "common_phrases": [
                        "in het water badderen",
                        "gezellig badderen"
                    ],
                    "target_lang_definitions": {
                        "en": "To enjoy oneself in the water by swimming, playing, or splashing."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to splash around",
                                "target_lang_sense_clarification": "to play in water"
                            },
                            {
                                "target_lang_word": "to paddle",
                                "target_lang_sense_clarification": "to wade or play in shallow water"
                            },
                            {
                                "target_lang_word": "to bathe",
                                "target_lang_sense_clarification": "to swim or play in a body of water for pleasure"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0f4c0f4-f527-3dbd-91c1-84043b0fe287",
                    "sense_definition": "Het met veel gespetter of beweging nemen van een bad in water of stof door vogels.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "dierengedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het fijne zand zijn de mussen lekker aan het <w>badderen</w>.",
                            "target_lang_translations": {
                                "en": "The sparrows are happily <w>taking a dust bath</w> in the fine sand."
                            }
                        },
                        {
                            "text": "Kijk eens hoe die kleine vogeltjes in de tuinvijver staan te <w>badderen</w>.",
                            "target_lang_translations": {
                                "en": "Look at how those little birds are <w>bathing</w> in the garden pond."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in het zand badderen",
                        "vogels die badderen"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of birds taking a bath in water or dust with lots of splashing or movement."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to bathe",
