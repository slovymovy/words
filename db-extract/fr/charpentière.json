                    {
                        "sense_id": "09b33f07-adbf-3ea0-8a57-9e873728a822",
                        "entry_id": "02ca4510-2c9b-3192-90d2-89234c3f950e",
                        "glosses": [
                            "Artisane qui fait des travaux d’assemblage de pièces de bois ou de métal servant de charpente à une construction."
                        ],
                        "tags": [
                            "Métier"
                        ],
                        "examples": [
                            {
                                "example_id": "6683f2b5-b1af-4c9e-b850-beade8dbf6d9",
                                "sense_id": "09b33f07-adbf-3ea0-8a57-9e873728a822",
                                "text": "Ouvrière chez les Compagnons du devoir, Laurine Lesné, charpentière, reproduit des structures de charpente de monuments, en version réduite, dans le cadre de son tour de la France."
                            },
                            {
                                "example_id": "f6bfe43d-31c7-496f-a278-265019909f89",
                                "sense_id": "09b33f07-adbf-3ea0-8a57-9e873728a822",
                                "text": "Après avoir roulé sa bosse dans l’édition et les magazines féminins, elle devient charpentière-menuisière"
                            }
                        ]
                    },
                    {
                        "sense_id": "7d513aa4-fa4f-38f2-8ef9-2838345ce87c",
                        "entry_id": "02ca4510-2c9b-3192-90d2-89234c3f950e",
                        "glosses": [
                            "Branche maîtresse émanant du tronc et soutenant une partie du houppier."
