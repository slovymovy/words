        "fr-extract.jsonl": [
            {
                "entry_id": "fb014cee-d818-32c0-b601-5413bf1d063d",
                "word": "groggy",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "894497cf-467a-3b8c-80b1-1b0262509bc7",
                        "entry_id": "fb014cee-d818-32c0-b601-5413bf1d063d",
                        "glosses": [
                            "Étourdi par les coups."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee5ee89c-1d6e-453a-b063-32078d3a695f",
                                "sense_id": "894497cf-467a-3b8c-80b1-1b0262509bc7",
                                "text": "Un ballon reçu en pleine tête l’avait rendu groggy."
                            },
                            {
                                "example_id": "0c7ff928-c969-4c35-a7f7-9184f266cd45",
                                "sense_id": "894497cf-467a-3b8c-80b1-1b0262509bc7",
                                "text": "Il me poussa devant lui et, d'un coup de pied, me jeta à terre. « Tu ne vois pas qu'il est groggy, dit l'autre avec un accent de France : fous-lui la paix! » — (Henri Alleg, La Question, 1957)"
                            }
                        ]
                    },
                    {
                        "sense_id": "127cda3c-dbb9-37c4-868c-1b7be5fda172",
                        "entry_id": "fb014cee-d818-32c0-b601-5413bf1d063d",
                        "glosses": [
                            "Prêt à s’écrouler d’étourdissement ou de fatigue."
                        ],
                        "tags": [
                            "broadly",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "8f768d19-2fa0-4849-8357-be4d876da959",
                                "sense_id": "127cda3c-dbb9-37c4-868c-1b7be5fda172",
                                "text": "Malgré la fin du suspense, les cégétistes avaient toujours l’air groggy, vendredi."
                            },
                            {
                                "example_id": "28c3c9d5-f8b2-498d-8cd7-e74f8163594e",
                                "sense_id": "127cda3c-dbb9-37c4-868c-1b7be5fda172",
                                "text": "Complètement anéanti, groggy, gâteux, il ne sut que répondre : « Heuh… euh… Oui… Au revoir… euh… »"
                            },
                            {
                                "example_id": "0348bc46-518a-4d5a-bff7-4b098ea8c600",
                                "sense_id": "127cda3c-dbb9-37c4-868c-1b7be5fda172",
                                "text": "C’est encore tout groggy de cette tourneboulante entrée en matière qu’on traverse l’une des quatre vénérables portes de cette ville agglutinée au pied de falaises aussi hautes que renversantes, et dont les 4,5 kilomètres de murs d’enceinte s’élèvent vers le ciel, 1426 marches et 280 mètres plus haut."
                            }
                        ]
                    }
                ],
