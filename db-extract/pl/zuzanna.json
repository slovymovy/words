                                ]
                            },
                            {
                                "target_word": "Suzanne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4f05904e-3841-3224-8669-93a342e5b5b1",
                                        "entry_id": "ff7ebf14-4cce-342a-81e2-41cb93a0ce92",
                                        "glosses": [
                                            "Commune française, située dans le département des Ardennes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4cd4a1f-9dfa-4e23-9423-c3c3f1e6b608",
                                                "sense_id": "4f05904e-3841-3224-8669-93a342e5b5b1",
                                                "text": "On trouve aussi des vignes dans les communes de Suzanne, Tourteron, Guincourt , Neuville-et-Day. Ces quatre communes en contiennent environ 140 hectares produisant, année moyenne, 12,400 hectolitres de vin de médiocre qualité."
                                            },
                                            {
                                                "example_id": "7898d983-9f9e-4a42-8bde-80d84451376a",
                                                "sense_id": "4f05904e-3841-3224-8669-93a342e5b5b1",
                                                "text": "La seconde ligne partira de la station d’Attigny, sur le chemin de fer d’intérêt général d’Amagne à Révigny, passera par ou près Saint-Lambert, Suzanne, Tourteron, Guincourt, Saint-Loup et aboutira à la gare de Baâlons de la première ligne; la longueur du tracé sera d’environ 17 kil. 500."
                                            },
                                            {
                                                "example_id": "f85a774a-3b7a-424d-ac2f-0af0f26fb0f3",
                                                "sense_id": "4f05904e-3841-3224-8669-93a342e5b5b1",
                                                "text": "Pour en éprouver toute la valeur et le sortilège, rien ne vaut comme de s'enfoncer dans ce vaste bocage qui, depuis les Crêtes forestières, descend peu à peu vers l'Aisne et la Champagne, cette région du Tourteronnais et des Vallées, avec pour principaux jalons : Marquigny, Jonval, Suzanne, Écordal, Saulces-Monclin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94484f4b-ed2b-39ec-8ec5-6a327424b2d7",
                                        "entry_id": "ff7ebf14-4cce-342a-81e2-41cb93a0ce92",
                                        "glosses": [
                                            "Commune française, située dans le département de la Somme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc4324c9-e534-4dc4-87f2-9381326a29f2",
                                                "sense_id": "94484f4b-ed2b-39ec-8ec5-6a327424b2d7",
                                                "text": "Après une période de repos dans la région de Fouilloy, le régiment s'établit, dès le début de juin, entre Suzanne et Maricourt, pour préparer une attaque en liaison avec l'armée anglaise."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Suzanne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "65cb7be2-0008-3043-84dd-d4cd58f60cb8",
                                        "entry_id": "8c91e0d6-18a1-3216-af0d-c254e60430de",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "492bae15-4957-4014-8d02-cef57a30a8f6",
                                                "sense_id": "65cb7be2-0008-3043-84dd-d4cd58f60cb8",
                                                "text": "Suzanne prit la chemise, la combinaison, les plaqua sur elle, se tortillant, avançant les jambes l’une après l’autre, les bras maintenant chaque pièce à hauteur de la poitrine."
                                            },
                                            {
                                                "example_id": "0a4e3021-26cb-4936-96ab-4581541fa781",
                                                "sense_id": "65cb7be2-0008-3043-84dd-d4cd58f60cb8",
                                                "text": "’jour, mademoiselle Suzanne…"
                                            },
                                            {
                                                "example_id": "bbe70b01-e20f-4f2f-97cb-936781b07eba",
                                                "sense_id": "65cb7be2-0008-3043-84dd-d4cd58f60cb8",
                                                "text": "En réponse à ses questions vaguement angoissées, il découvrait une Suzanne agressive qui le rabrouait."
                                            },
                                            {
                                                "example_id": "5ccbe6a5-34ad-4e1e-bc07-b2e48f22bd59",
                                                "sense_id": "65cb7be2-0008-3043-84dd-d4cd58f60cb8",
                                                "text": "Cheminant vers la rue Saint-Joseph, elle songe avec nostalgie à l’ancienne Suzanne, celle qui s’épivardait dans la rue avec ses enfants pendant les récréations et qui, parfois, grimpait au pommier en déchirant sa jupe…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
