                {
                    "sense_id": "57ba648f-15d9-30a4-9592-ad60ac62cb98",
                    "sense_definition": "Направленный взгляд; то, как человек смотрит на кого-либо или что-либо",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Все присутствующие в зале устремили <глаза> на сцену.",
                            "target_lang_translations": {
                                "en": "Everyone present in the hall fixed their <eyes> on the stage.",
                                "zh": "大厅里的所有人都把<w>目光</w>投向了舞台。"
                            }
