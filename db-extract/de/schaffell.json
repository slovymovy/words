                "senses": [
                    {
                        "sense_id": "67ab794d-ff54-3f04-9680-433bcd237e08",
                        "entry_id": "3356e802-1fad-3d7d-bc9c-6e37b4d9574f",
                        "glosses": [
                            "(abgezogenes) Fell eines Schafes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15ef7f4c-56b8-4c39-83a6-f90ff1880495",
                                "sense_id": "67ab794d-ff54-3f04-9680-433bcd237e08",
                                "text": "„Jetzt erst merkte ich, dass ich direkt auf den Resten des Schaffelles meines Vaters stand, das ihm als Gebetsteppich gedient hatte. Der Großteil davon war mit Staub bedeckt.“"
                            },
                            {
                                "example_id": "3a2f7545-f9a7-4fe9-a011-f1f7265b2702",
                                "sense_id": "67ab794d-ff54-3f04-9680-433bcd237e08",
                                "text": "„In der einen Ecke war eine Lagerstatt, hergerichtet aus isländischen Schaffellen, und davor ein großer Nachttopf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
