                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reduce_amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the flood, it took several days for the high waters to <w>abate</w>.",
