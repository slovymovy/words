                "senses": [
                    {
                        "sense_id": "4ad1463c-d2ca-3fa5-9998-fcc26e0f63e1",
                        "entry_id": "4b3584b0-0a6c-3e36-bb1b-521e558e6031",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным Рейн"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e592d339-6282-4f2f-8c0f-09cc28b1dd53",
                                "sense_id": "4ad1463c-d2ca-3fa5-9998-fcc26e0f63e1",
                                "text": "— Я знаю Крефельд. Это дрянной, провинциальный, пыльный городок, в котором не найдёшь ни хорошеньких девушек, ни приличного рейнского вина."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fc04d00e-478d-4f8c-8f28-a0e9b1d0bb21",
                        "source_entry_id": "4b3584b0-0a6c-3e36-bb1b-521e558e6031",
                        "source_sense_id": "4ad1463c-d2ca-3fa5-9998-fcc26e0f63e1",
                        "target_lang_word": "rheinisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rheinisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f7b5e690-6552-3b2f-82f4-b60b65b3fc22",
                                        "entry_id": "0691a7d0-3c6c-3721-8b45-084155e9cf65",
                                        "glosses": [
                                            "auf den Rhein, das Rheinland, die Rheinländer und das Rheinische bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "034961e6-4831-4db9-9f26-5d36b78418fd",
                                                "sense_id": "f7b5e690-6552-3b2f-82f4-b60b65b3fc22",
                                                "text": "Die rheinische Lebensart zieht viele Menschen an."
                                            },
                                            {
                                                "example_id": "3a948801-5670-4ebc-ac3f-7f9e7f885407",
                                                "sense_id": "f7b5e690-6552-3b2f-82f4-b60b65b3fc22",
                                                "text": "„Im ‚rheinischsten aller rheinischen‘ Museen kann man seit Jahren die Vorweihnachtszeit mit allen Sinnen erleben.“"
                                            },
                                            {
                                                "example_id": "2dad9030-2151-4abe-8833-cf4ac64c8a25",
                                                "sense_id": "f7b5e690-6552-3b2f-82f4-b60b65b3fc22",
                                                "text": "„Mitte des 12. Jahrhunderts entsteht die reichste Chorfassade, eine von zwei flankierenden Türmen gerahmte Apsis, die die rheinische Romanik kennt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
