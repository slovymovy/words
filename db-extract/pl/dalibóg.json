                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91bb7ef7-e4b5-44d4-b4d4-d92b8d30ae2f",
                                                "sense_id": "8febf65e-9193-3c79-bea4-8f55217c94df",
                                                "text": "She is honest to God brilliant."
                                            }
                                        ]
                                    }
                                ]
