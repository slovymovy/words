                                        "entry_id": "2363c6ee-8934-3697-a3a9-a4e406bb091f",
                                        "glosses": [
                                            "A person who lives alone in the bush."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11c3bcf7-fbf8-4a83-8d31-6cc9bf87a94e",
                                                "sense_id": "21cbc10a-ae79-341a-8678-6410dfc14cb4",
                                                "text": "Lonely hut where drought’s eternal, suffocating atmosphere\nWhere the God-forgotten hatter dreams of city life and beer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58ae6371-48ff-3f95-b31d-2392b93a2d4c",
                                        "entry_id": "2363c6ee-8934-3697-a3a9-a4e406bb091f",
                                        "glosses": [
                                            "A miner who works by himself."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
