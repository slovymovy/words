                ],
                "senses": [
                    {
                        "sense_id": "854a8c9a-d487-3975-a12a-8fe1740f52a6",
                        "entry_id": "68785de9-b170-3b26-bd12-1e0db8e7bae6",
                        "glosses": [
                            "Ne plus comparer, refuser de comparer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cd4fd46-4b83-4e80-97af-756682a17099",
                                "sense_id": "854a8c9a-d487-3975-a12a-8fe1740f52a6",
                                "text": "Face à ce qui n’est pas comparable ou à ce que la traduction ne peut traduire, il faudra aussi « décomparer » dit F. Jullien."
                            },
                            {
                                "example_id": "495a66fa-52e6-44bd-ab71-b88c72db3c61",
                                "sense_id": "854a8c9a-d487-3975-a12a-8fe1740f52a6",
                                "text": "Si on empêche les gens de se décomparer, il y a un impact de la comparaison."
                            },
                            {
                                "example_id": "9d489848-ac11-4ecb-9fa4-bd3fa267bf56",
                                "sense_id": "854a8c9a-d487-3975-a12a-8fe1740f52a6",
                                "text": "Alors Ever va voir Madame M pour l’aider à se déjuger, à se décomparer, à se retrouver plus entière, et réelle."
                            }
                        ]
                    }
                ],
