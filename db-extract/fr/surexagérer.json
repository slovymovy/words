                        "tags": [],
                        "form": "sur-exagérer"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c9bca18b-a515-3460-a5ad-daa417073f8e",
                        "entry_id": "0c6d6dbb-f60f-3733-982c-ee1c95a4e1d2",
                        "glosses": [
                            "Exagérer énormément."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbb16c1a-0a5a-4da9-a283-c92305bff4cf",
                                "sense_id": "c9bca18b-a515-3460-a5ad-daa417073f8e",
                                "text": "Et il convient d’ajouter que la récession mondiale qui frappe la quasi-totalité des pays industrialisés a amené ceux-ci à réviser à la baisse — et parfois de façon dramatique — leurs programmes d’équipement en centrales électriques, nucléaires et/ou à combustibles fossiles, semblant donner ainsi curieusement la main à une opposition publique dont il ne faut pas surexagérer l’importance."
                            },
                            {
                                "example_id": "f9bfcbdf-f591-4dfe-bff7-a2cfaefb455d",
                                "sense_id": "c9bca18b-a515-3460-a5ad-daa417073f8e",
                                "text": "Évidemment qu’il faut que ce soit surexagéré."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34c4de48-7d8b-4fa8-84b0-425a5e9c0d2c",
                        "source_entry_id": "0c6d6dbb-f60f-3733-982c-ee1c95a4e1d2",
                        "source_sense_id": "c9bca18b-a515-3460-a5ad-daa417073f8e",
                        "target_lang_word": "overexaggerate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overexaggerate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "442ab71e-9dfc-3033-8a75-0060e8c77bb6",
                                        "entry_id": "e3b0f679-fc21-3211-af9d-b8d73fec486f",
                                        "glosses": [
                                            "To exaggerate, to overstate excessively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca11548e-c53c-4a31-a483-586d2d2a47ed",
                                                "sense_id": "442ab71e-9dfc-3033-8a75-0060e8c77bb6",
                                                "text": "\"That math test was so hard, nobody could have passed it! Albert Einstein couldn't have done it! Our professor probably had no idea how to solve those equations! I mean-\""
                                            },
                                            {
                                                "example_id": "c95a8b91-518d-4710-9086-11b6b6312bc2",
                                                "sense_id": "442ab71e-9dfc-3033-8a75-0060e8c77bb6",
                                                "text": "I get it, OK? Quit overexaggerating!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
