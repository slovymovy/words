                            {
                                "example_id": "e9b8312b-eb11-4d73-97b0-2b9dbc4ca2f2",
                                "sense_id": "ee785021-f616-334c-8eaf-22c64a6a7263",
                                "text": "Shenyang ist die Hauptstadt von Liaoning."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
