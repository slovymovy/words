                ],
                "senses": [
                    {
                        "sense_id": "7881edc9-0479-3830-b43a-ad5fd518a55f",
                        "entry_id": "4362760b-3fb8-397c-aaa2-087828396e5a",
                        "glosses": [
                            "истор. сотрудник милиции"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ac89f81-e1f1-48bb-b21f-87e6d670f61f",
                                "sense_id": "7881edc9-0479-3830-b43a-ad5fd518a55f",
                                "text": "Однажды в выходной день явился в квартиру милиционер, вызвал в переднюю второго жильца (фамилия которого утратилась) и сказал, что того просят на минутку зайти в отделение милиции в чём-то расписаться."
                            }
                        ]
                    },
                    {
                        "sense_id": "b1fb1adb-27cb-3de5-a546-8bf4cad69048",
                        "entry_id": "4362760b-3fb8-397c-aaa2-087828396e5a",
                        "glosses": [
                            "истор. военнообязанный, входящий в состав милиционной армии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "335a0d32-a014-44ce-9de1-4c1b0f7f3f95",
                                "sense_id": "b1fb1adb-27cb-3de5-a546-8bf4cad69048",
                                "text": "Это был Карганов, уездный воинский начальник, с своими милиционерами."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a89aec44-c3c9-4a95-871c-82f4e7368fd8",
                        "source_entry_id": "4362760b-3fb8-397c-aaa2-087828396e5a",
                        "source_sense_description": "хранитель порядка",
                        "target_lang_word": "Milizionär",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Milizionär",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f8d78a58-ccce-3407-821b-558d6e6af239",
                                        "entry_id": "510fad35-8dc8-3a8b-be53-c29b5061cde8",
                                        "glosses": [
                                            "Angehöriger einer Miliz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cab533de-e7df-4530-95f1-b33c2c7b1f9c",
                                                "sense_id": "f8d78a58-ccce-3407-821b-558d6e6af239",
                                                "text": "„Zuletzt hätten die islamistischen Milizionäre in einigen Stadtteilen sogar wieder die Kontrolle übernommen.“"
                                            },
                                            {
                                                "example_id": "0401a84a-955c-464e-b6a3-95b323f81607",
                                                "sense_id": "f8d78a58-ccce-3407-821b-558d6e6af239",
                                                "text": "„Ein Milizionär durchtrennte mit Babas Messer ihre Fesseln.“"
                                            },
                                            {
                                                "example_id": "895d8ddc-e2a9-4f12-a5be-649b7698ec6d",
                                                "sense_id": "f8d78a58-ccce-3407-821b-558d6e6af239",
                                                "text": "„Erst als sich die Situation etwas beruhigt, findet die Mutter des jungen Mannes bei einem polnischen Milizionär Gehör.“"
                                            },
                                            {
                                                "example_id": "a947ad84-9885-4d5d-af40-9cb135e8096a",
                                                "sense_id": "f8d78a58-ccce-3407-821b-558d6e6af239",
                                                "text": "„Dagegen lösten iranische Milizionäre mit Maschinengewehren behagliche Gefühle in ihr aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d72df448-8379-324c-a090-36e0c1987234",
                                        "entry_id": "510fad35-8dc8-3a8b-be53-c29b5061cde8",
                                        "glosses": [
                                            "Polizist"
                                        ],
                                        "tags": [
                                            "historisch in einigen sowjetischen Staaten"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
