            {
                "entry_id": "19c0ffc0-6bc3-3a7e-a6c8-ca5062e0b357",
                "word": "satanisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "79a113c9-df6e-4bbe-a5f8-a11a816761bf",
                        "entry_id": "19c0ffc0-6bc3-3a7e-a6c8-ca5062e0b357",
                        "tags": [
                            "plural"
                        ],
                        "form": "satanismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ad3b42aa-320f-3379-a604-577f5c6bb1c6",
                        "entry_id": "19c0ffc0-6bc3-3a7e-a6c8-ca5062e0b357",
                        "glosses": [
                            "Fait de pratiquer des actions et/ou rites vénérant Satan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8d2cd91-de6c-468a-b3fd-dbaa3081a929",
                                "sense_id": "ad3b42aa-320f-3379-a604-577f5c6bb1c6",
                                "text": "Fonsègue s’amusait à taquiner la princesse Rosemonde sur sa robe de satin feu, où il prétendait qu’elle cuisait déjà de toutes les flammes de l’enfer, ce qui la ravissait au fond, dans son satanisme, sa passion du moment."
                            },
                            {
                                "example_id": "d61d7bf8-e687-4783-ab51-8d221e9a1d52",
                                "sense_id": "ad3b42aa-320f-3379-a604-577f5c6bb1c6",
                                "text": "On étudiait tout ce qui nous tombait sous la main : …, le satanisme, l’hermétisme, l’orphisme..."
                            }
                        ]
                    },
                    {
                        "sense_id": "2d276151-2c94-3f00-a8a0-5686b7f11795",
                        "entry_id": "19c0ffc0-6bc3-3a7e-a6c8-ca5062e0b357",
                        "glosses": [
                            "Caractère de ce qui est satanique."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b3afa518-8f1f-47da-a3ae-69207f799633",
                        "source_entry_id": "19c0ffc0-6bc3-3a7e-a6c8-ca5062e0b357",
                        "target_lang_word": "Satanismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Satanismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cdbd7c47-5695-386e-b8d2-094638b474e4",
                                        "entry_id": "056eafd4-e9ee-3d53-8179-e52dda87fb05",
                                        "glosses": [
                                            "zusammenfassender Begriff für verschiedene Strömungen, bei denen die Figur des Satan im Mittelpunkt steht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3115a4b9-9a53-49f1-9bfd-7d627098b004",
                                                "sense_id": "cdbd7c47-5695-386e-b8d2-094638b474e4",
                                                "text": "„Für einen real existierenden Satanismus in Mittelalter und Frühneuzeit vor dem Hintergrund der Verfolgung von Ketzern und der zahlreichen Hexenverbrennungen dieser Epoche gibt es zum gegenwärtigen Zeitpunkt der Forschung keinerlei Anhaltspunkte.“"
                                            },
                                            {
                                                "example_id": "d693c241-26e7-4ed9-9f69-4cf77c4fd8ad",
                                                "sense_id": "cdbd7c47-5695-386e-b8d2-094638b474e4",
                                                "text": "„Eine päpstliche Akademie gibt einen Kurs zum Satanismus, damit angehende Priester lernen, wie sie junge Italiener vom Teufelskult abbringen können.“"
                                            },
                                            {
                                                "example_id": "7f75c166-6e74-41be-9553-1fd4d4737ebc",
                                                "sense_id": "cdbd7c47-5695-386e-b8d2-094638b474e4",
                                                "text": "„Sie […] genießen die Privilegien, mit denen die englische Toleranz die Freiheit der Religionsausübung gewährleistet, vorausgesetzt,- daß sich ihre Kultformen auf die Riten der Weißen Magie beschränken. Hingegen greifen die Behörden unbarmherzig ein, wenn es sich um Schwarze Magie handelt, um Kulthandlungen des Satanismus mit sexuellen Orgien, Tieropfern und Grabschändungen.“"
                                            },
                                            {
                                                "example_id": "20b77875-87fd-4d56-804f-2919af161796",
                                                "sense_id": "cdbd7c47-5695-386e-b8d2-094638b474e4",
                                                "text": "„Hier und an ähnlichen Stellen erlangt der Satanismus Tiefgang.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ee59857-8297-4d02-97bc-83fe3d18aff7",
                        "source_entry_id": "19c0ffc0-6bc3-3a7e-a6c8-ca5062e0b357",
