                                        "sense_id": "780fdd34-6e11-32b2-89e2-d385f21984c4",
                                        "entry_id": "07942409-7028-3e7e-ba83-1bc3f0b3e3d6",
                                        "glosses": [
                                            "Chef de l’ancienne république des Provinces-Unies."
