                    "sense_definition": "Qui agit ou qui est produit directement, sans intermédiaire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enquêteurs cherchent à déterminer la cause <w>immédiate</w> de cet accident."
                        },
                        {
                            "text": "Elle a prévenu les membres de son entourage <w>immédiat</w> dès son arrivée."
                        }
                    ],
                    "common_phrases": [
