                    {
                        "sense_id": "0a43c5a4-5365-3448-bb78-80c7f64bf80e",
                        "entry_id": "45a75202-0af6-34d9-bade-4b3ea83607e1",
                        "glosses": [
                            "Morceau de musique écrit pour cinq voix ou pour cinq instruments."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5cde485-5b9f-4e95-b282-0a06a1f501ce",
                                "sense_id": "0a43c5a4-5365-3448-bb78-80c7f64bf80e",
                                "text": "Les quintettes de Beethoven, de Mozart."
                            }
                        ]
                    },
                    {
                        "sense_id": "49fae1d7-f515-3c04-8984-7124951adf3a",
                        "entry_id": "45a75202-0af6-34d9-bade-4b3ea83607e1",
                        "glosses": [
                            "Petit orchestre de cinq musiciens, particulièrement en jazz."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f557e494-f269-4fe4-8758-98631777b2ab",
                                "sense_id": "49fae1d7-f515-3c04-8984-7124951adf3a",
                                "text": "— On ne peut pas, sans blesser les lois de l’harmonie, introduire un cinquième exécutant dans un quatuor ; autrement ça cesse d’être quatuor. — Ça devient un quintette, répondit Carolus."
                            }
                        ]
                    },
                    {
                        "sense_id": "7cddf330-97da-34ae-8f62-513098f234d9",
                        "entry_id": "45a75202-0af6-34d9-bade-4b3ea83607e1",
                        "glosses": [
                            "Groupe de cinq personnes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35726a16-a369-4437-9cca-17d1880e49c0",
                                "sense_id": "7cddf330-97da-34ae-8f62-513098f234d9",
                                "text": "Le quintette fait désormais face à plusieurs graves accusations, dont trafic d’armes à feu, trafic de stupéfiants, possession de produits de la criminalité et conduite dangereuse."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
