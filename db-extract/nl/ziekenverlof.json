                            {
                                "example_id": "a2fc82f8-1473-47a8-9d3c-836ad2066fb4",
                                "sense_id": "ee30f807-5a2f-3bdd-9328-a6e0d7a469d8",
                                "text": "De Noorse kroonprinses Mette-Marit is zeker twee weken met ziekenverlof. Ze heeft te veel last van een verschoven wervel in haar nek. De prinses heeft al jaren rugklachten."
                            },
                            {
                                "example_id": "f9c89dfd-131e-47f0-b91d-f8a745432182",
                                "sense_id": "ee30f807-5a2f-3bdd-9328-a6e0d7a469d8",
                                "text": "Momenteel is Moreau met ziekenverlof. Het is Thomas Cialone, die in 2018 de MR-lijst zal trekken bij de gemeenteraadsverkiezingen, die momenteel plaatsvervangend burgemeester is. Welke PS’er in de plaats van Moreau tot het schepencollege zal toetreden, is nog niet duidelijk."
                            }
                        ]
