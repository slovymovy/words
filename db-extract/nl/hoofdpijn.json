                    }
                ],
                "senses": [
                    {
                        "sense_id": "dd632add-9024-3fe6-bfdf-9658b4a7f22d",
                        "entry_id": "c2a87817-c0e5-32ba-ae1b-e035b8ad15fc",
                        "glosses": [
                            "pijn in het hoofd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5558cfc7-c032-47d4-848c-cdcd67c43189",
                                "sense_id": "dd632add-9024-3fe6-bfdf-9658b4a7f22d",
                                "text": "Omdat ik al een tijdje last van hoofdpijn heb, ben ik gisteren aspirines gaan kopen."
                            },
                            {
                                "example_id": "287f66ff-9956-40b6-a7f7-960b3089428a",
                                "sense_id": "dd632add-9024-3fe6-bfdf-9658b4a7f22d",
                                "text": "Dat ze last zou hebben van hoofdpijn was ronduit lachwekkend."
                            },
                            {
                                "example_id": "d8f17733-1afb-4027-b59a-33e2d8e64c18",
                                "sense_id": "dd632add-9024-3fe6-bfdf-9658b4a7f22d",
                                "text": "Ik was kortademig en had ’s avonds hoofdpijn. Wonen op drie meter onder zeeniveau (NAP) is heel wat anders dan lopen op duizend meter boven de zeespiegel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98de9c3d-0ea3-47a0-b4f0-6380c971596c",
                        "source_entry_id": "c2a87817-c0e5-32ba-ae1b-e035b8ad15fc",
                        "source_sense_id": "dd632add-9024-3fe6-bfdf-9658b4a7f22d",
                        "source_sense_description": "pijn in het hoofd",
                        "target_lang_word": "Kopfschmerz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kopfschmerz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c978fea-15fc-3dd7-a6d4-4cb825db33a0",
                                        "entry_id": "0a561728-ec63-3480-951e-f8d83eda2291",
                                        "glosses": [
                                            "unangenehme Sinneswahrnehmung (Schmerz) im Kopf"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b702d99b-8fb0-4dec-b90d-b35654333476",
                                                "sense_id": "3c978fea-15fc-3dd7-a6d4-4cb825db33a0",
                                                "text": "„Er rieb sich behutsam die Stirn, als ob er Kopfschmerzen habe.“"
                                            },
                                            {
                                                "example_id": "4d295b8f-2333-495a-b42c-635939d6f193",
                                                "sense_id": "3c978fea-15fc-3dd7-a6d4-4cb825db33a0",
                                                "text": "„Sie bekam Kopfschmerzen und bereute, überhaupt nach Tórshavn gekommen zu sein.“"
                                            },
                                            {
                                                "example_id": "19b8b7f5-b794-4177-bacd-82b457964128",
                                                "sense_id": "3c978fea-15fc-3dd7-a6d4-4cb825db33a0",
                                                "text": "„Einsam lag ich im Bett, spürte das sanfte Pochen in meiner Wade und merkte, wie der Kopfschmerz vom Morgen wieder zurückkam.“"
                                            },
                                            {
                                                "example_id": "76dde8df-8b6d-4b4c-b3f0-f7076ccd8f4f",
                                                "sense_id": "3c978fea-15fc-3dd7-a6d4-4cb825db33a0",
                                                "text": "„Außerdem hatte sie Kopfschmerzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f004df7-ee54-4e2d-928c-afd36acd7b85",
                        "source_entry_id": "c2a87817-c0e5-32ba-ae1b-e035b8ad15fc",
                        "source_sense_id": "dd632add-9024-3fe6-bfdf-9658b4a7f22d",
                        "source_sense_description": "pijn in het hoofd",
                        "target_lang_word": "Kopfweh",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kopfweh",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b196ad6-a643-3ef1-810e-9b88d76dda54",
                                        "entry_id": "e9f44e46-5479-372c-85c9-95a6b3f57f0f",
                                        "glosses": [
                                            "Schmerz(en) im Kopfbereich"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acd14d69-69e0-4e3e-a0be-d859742d134a",
                                                "sense_id": "4b196ad6-a643-3ef1-810e-9b88d76dda54",
                                                "text": "Bei Föhn kriege ich immer Kopfweh."
                                            },
                                            {
                                                "example_id": "391ac26d-fcef-44f1-aa3a-8b2edf77fba5",
                                                "sense_id": "4b196ad6-a643-3ef1-810e-9b88d76dda54",
                                                "text": "„Ein Viertel aller Gymnasiastinnen klagt regelmäßig über Kopfweh, das hat die Krankenkasse DAK herausgefunden.“"
                                            },
                                            {
                                                "example_id": "fd5629d2-bb12-4b9c-8b6c-0491fa12b7d6",
                                                "sense_id": "4b196ad6-a643-3ef1-810e-9b88d76dda54",
                                                "text": "„Sie hatte häufig Kopfweh, war müde und lustlos, bekam heftige Schmerzen im Rücken, in Fingern, Händen, Muskeln und Gelenken, die sich sehr oft wiederholten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "208cddfb-c98c-4fc8-ab75-a931b1b8ea42",
                        "source_entry_id": "c2a87817-c0e5-32ba-ae1b-e035b8ad15fc",
                        "source_sense_id": "dd632add-9024-3fe6-bfdf-9658b4a7f22d",
                        "source_sense_description": "pijn in het hoofd",
                        "target_lang_word": "headache",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "headache",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "876b7c03-c4ae-3eef-b910-82fa691927b2",
                                        "entry_id": "23a6c3ad-8d0f-3fe4-bddc-302109edaa11",
                                        "glosses": [
                                            "A pain or ache in the head."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa39f425-fe3f-430d-90cd-72a1d2f85f12",
                                                "sense_id": "876b7c03-c4ae-3eef-b910-82fa691927b2",
                                                "text": "I have a splitting headache after that party last night."
                                            },
                                            {
                                                "example_id": "082cf4c5-5bab-436d-8135-293c995ca2c4",
                                                "sense_id": "876b7c03-c4ae-3eef-b910-82fa691927b2",
                                                "text": "I advise you to take some painkillers for the headache, it's probably nothing serious."
                                            },
                                            {
                                                "example_id": "c235ea89-ecb7-4afc-8e65-7c7fc92d29fe",
                                                "sense_id": "876b7c03-c4ae-3eef-b910-82fa691927b2",
                                                "text": "Sometimes on television they tell you a product is \"good for headaches.\" I don't want something that's good for headaches. I want something that's bad for headaches. And good for me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91a0db06-332e-307f-ba28-62a6d6171805",
                                        "entry_id": "23a6c3ad-8d0f-3fe4-bddc-302109edaa11",
                                        "glosses": [
                                            "A nuisance or unpleasant problem."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aab9347e-7c0c-4a19-b43b-07429083c813",
                                                "sense_id": "91a0db06-332e-307f-ba28-62a6d6171805",
                                                "text": "The clumsy filing system has been a huge headache."
                                            },
                                            {
                                                "example_id": "2b0612d6-5c94-40b9-9d3b-26f3f90f6d6d",
                                                "sense_id": "91a0db06-332e-307f-ba28-62a6d6171805",
                                                "text": "Bogland now dominates the scene and the construction engineers must have suffered many a headache in seeking to secure a firm foundation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
