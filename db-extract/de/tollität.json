                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ad7bcdb-c991-4a53-9512-679787dda3ea",
                                "sense_id": "b1a972d2-4534-39bd-ae09-dd3d64a32293",
                                "text": "„Der Prunkwagen der Tollitäten im Rosenmontagszug war in Blau und Silber gehalten und mit den Initialen des Prinzenpaares geschmückt.“"
                            },
                            {
                                "example_id": "afda96be-1a94-4efe-908d-eff1d25bfa57",
                                "sense_id": "b1a972d2-4534-39bd-ae09-dd3d64a32293",
                                "text": "„Bei der Kappensitzung im Lantershofener Winzersaal stimmte alles und die rund 250 Gäste feierten die lokalen Größen überschwänglich. Nur eine jecke Tollität fanden die Lantershofener einmal mehr nicht. Allerdings ist das Prinzendasein in dem Grafschafter Ort, dessen närrisches Treiben von einem Arbeitskreis unter der Obhut von Junggesellen-Schützen und Gesangverein ‚Cäcilia‘ organisiert wird, auch nur Beiwerk einer losgelösten Partyzeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
