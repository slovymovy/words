                                "target_senses": [
                                    {
                                        "sense_id": "e396bc94-e161-3b9b-8e05-49d98772124f",
                                        "entry_id": "8569521f-fb93-308a-9162-c2ae349504ea",
                                        "glosses": [
                                            "Spezialform der Animation, die aus vielen, meist per Hand hergestellten, Zeichnungen, die zeitlich nacheinander präsentiert werden, besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "920e60fd-356e-4c6e-af0e-cc8c44dc933e",
                                                "sense_id": "e396bc94-e161-3b9b-8e05-49d98772124f",
                                                "text": "Ich gucke mir sehr gern Zeichentrickfilme an."
                                            },
                                            {
                                                "example_id": "e531415c-f546-4773-91ba-94c6a3318507",
                                                "sense_id": "e396bc94-e161-3b9b-8e05-49d98772124f",
                                                "text": "„Rosa und Bobby schauten sich Zeichentrickfilme an.“"
                                            },
                                            {
                                                "example_id": "4e0cbaed-92d3-4d1f-8f32-a8807e503f6e",
                                                "sense_id": "e396bc94-e161-3b9b-8e05-49d98772124f",
                                                "text": "„Heute war ein vollkommener, wirklich vollkommener Tag, dachte Ama, die kaum auf den Zeichentrickfilm im Fernsehen achtete.“"
                                            },
                                            {
                                                "example_id": "60f2d644-524a-485f-a061-78e6067a0ae5",
                                                "sense_id": "e396bc94-e161-3b9b-8e05-49d98772124f",
                                                "text": "„Die Figur aus dem Zeichentrickfilm orientiert sich ohnehin an der indigenen Schauspielerin Irene Bedard, die auch die Figur spricht.“"
                                            },
                                            {
                                                "example_id": "dd8e769b-5a53-41fe-b47c-92bc9d04c31e",
                                                "sense_id": "e396bc94-e161-3b9b-8e05-49d98772124f",
                                                "text": "„Fjalar und Ernir saßen auf dem Sofa und guckten einen Zeichentrickfilm; sie waren ungewöhnlich leise.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
