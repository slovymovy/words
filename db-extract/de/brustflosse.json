                        "entry_id": "7626ab7a-a01e-3dc5-9945-5280b1a1a668",
                        "glosses": [
                            "Flosse, die sich an der Brust eines Fisches befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73408f84-26de-4317-81d7-9c8ae9afefbc",
                                "sense_id": "e09c524f-c760-39b1-bd0e-03f5c63eba47",
                                "text": "„Die Brustflosse des Fischs traf den Mann und schleuderte ihn zu Boden.“"
                            },
                            {
                                "example_id": "968e7574-1177-444a-85d7-d468e393e6a6",
                                "sense_id": "e09c524f-c760-39b1-bd0e-03f5c63eba47",
                                "text": "„Welse reiben hingegen mit einem Stachel ihrer Brustflosse an ihrem Schultergelenk und produzieren so ganz andere, hochfrequente Laute.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
