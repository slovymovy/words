        "ru-extract.jsonl": [
            {
                "entry_id": "8f1d5bc8-3d15-3d07-9dfa-1b69a99f4273",
                "word": "сию",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "03ff0012-549d-3a05-b656-ee71fac57d62",
                        "entry_id": "8f1d5bc8-3d15-3d07-9dfa-1b69a99f4273",
                        "glosses": [
                            "авиац. сейчас (используется при переговорах пилотов с авиадиспетчером)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bfd40e3-c5d1-427f-873c-69cc658dff0e",
                                "sense_id": "03ff0012-549d-3a05-b656-ee71fac57d62",
                                "text": "Пилот: Аварийный маяк у нас сработал? Диспетчер: Нет, не сработал. Диспетчер: Наблюдаю сию, СЖР 178."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4543624a-3157-4ebc-b0f7-06c2e195e5c1",
                        "source_entry_id": "8f1d5bc8-3d15-3d07-9dfa-1b69a99f4273",
                        "source_sense_id": "03ff0012-549d-3a05-b656-ee71fac57d62",
                        "target_lang_word": "now",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "now",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b6dce725-d2c1-37c6-b9f1-90dd270b429d",
                                        "entry_id": "23fa6085-764e-3e5a-95f7-ef2a46a16f2d",
                                        "glosses": [
                                            "Since, because, in light of the fact."
                                        ],
                                        "tags": [
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca91bdd9-a71a-4e48-9a23-23e21cfbde4b",
                                                "sense_id": "b6dce725-d2c1-37c6-b9f1-90dd270b429d",
                                                "text": "Now all the children have grown up and left, the house is very quiet."
                                            },
                                            {
                                                "example_id": "9b0ae7dc-694f-4006-bfc0-703b36dc88fe",
                                                "sense_id": "b6dce725-d2c1-37c6-b9f1-90dd270b429d",
                                                "text": "Now that my sister has gotten rid of their cat, we can go to her house this coming Thanksgiving."
                                            },
                                            {
                                                "example_id": "d2825810-51c2-4ddb-9797-3555f08701ce",
                                                "sense_id": "b6dce725-d2c1-37c6-b9f1-90dd270b429d",
                                                "text": "We can play football now that the rain has stopped."
                                            },
                                            {
                                                "example_id": "dc635f90-00f5-4c0d-95a0-6ddc9baef1d7",
                                                "sense_id": "b6dce725-d2c1-37c6-b9f1-90dd270b429d",
                                                "text": "Now that you mention it, I am kind of hungry."
                                            },
                                            {
                                                "example_id": "a2130672-873e-46f2-aa4a-d2f9241ed52a",
                                                "sense_id": "b6dce725-d2c1-37c6-b9f1-90dd270b429d",
                                                "text": "Now that we're all here, let's start the meeting."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "now",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "020b32c7-105a-33d5-9a10-9029a43f9110",
                                        "entry_id": "9bc22afd-84e6-3868-a650-0dea3ed277c0",
                                        "glosses": [
                                            "Present; current."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6be8e0db-3034-4ce9-89ee-648dbd0a65a0",
                                                "sense_id": "020b32c7-105a-33d5-9a10-9029a43f9110",
                                                "text": "Defects seem as necessary to our now happiness as their Opposites."
                                            },
                                            {
                                                "example_id": "bc12e538-8ca0-4369-8814-96d52e2ef8fc",
                                                "sense_id": "020b32c7-105a-33d5-9a10-9029a43f9110",
                                                "text": "The history of the infant colonies teaches us that the country comprised within the limits of the now United States of America was originally patented in the reign of James I., of England, into two portions: that in less than eighty years from that period, the same was again divided into twelve distinct provinces; a thirteenth being after added in the creation of the State of Georgia."
                                            },
                                            {
                                                "example_id": "a9377674-1549-49a0-97e5-81ff1e073f29",
                                                "sense_id": "020b32c7-105a-33d5-9a10-9029a43f9110",
                                                "text": "Where in assumpsit for money lent, the defendant pleaded that in an action in which the now defendant was plaintiff, and the now plaintiff was defendant,[…]."
                                            },
                                            {
                                                "example_id": "eb48fcbd-ed55-4a28-828c-3a2eab31c170",
                                                "sense_id": "020b32c7-105a-33d5-9a10-9029a43f9110",
                                                "text": "Radio 4's continuity announcer said at the end of the show: \"As many of you will have noticed, that edition of The Now Show wasn't very now. It was actually last week's programme. Our apologies for that.\""
                                            },
                                            {
                                                "example_id": "5bf037f3-1cf8-4c17-8ecb-5efdf5a958eb",
                                                "sense_id": "020b32c7-105a-33d5-9a10-9029a43f9110",
                                                "text": "For example, the organization has groundlessly denounced Elon Musk, a powerful libertarian voice, as an antisemite in a baldfaced effort to drain his social network, X, of advertising revenue. Yet, when now-Minority Leader Hakeem Jeffries (D-N.Y.) came to the defense of his uncle for antisemitic remarks he made in the ’90s, the organization refused to condemn him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86c11fb3-19e3-37bf-8f43-3fe97ee5f18b",
                                        "entry_id": "9bc22afd-84e6-3868-a650-0dea3ed277c0",
                                        "glosses": [
                                            "Fashionable; popular; up to date; current."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "edb25037-8d3f-43b3-8d85-a38955b194a9",
                                                "sense_id": "86c11fb3-19e3-37bf-8f43-3fe97ee5f18b",
                                                "text": "I think this band's sound is very now."
                                            },
                                            {
                                                "example_id": "66735ba2-1bbc-4d02-9379-9799f97c9eef",
                                                "sense_id": "86c11fb3-19e3-37bf-8f43-3fe97ee5f18b",
                                                "text": "Bernard: What does it do?\nFran: It's very in.\nBernard: You don't know what it is, do you?\nFran: It's very now."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93c74b6a-e587-30c9-b545-6bf74ba58089",
                                        "entry_id": "9bc22afd-84e6-3868-a650-0dea3ed277c0",
                                        "glosses": [
                                            "At the time the will is written. Used in order to prevent any inheritance from being transferred to a person of a future marriage. Does not indicate the existence of a previous marriage."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8ba6496-205b-41f9-b50a-f2053a11abb6",
                                                "sense_id": "93c74b6a-e587-30c9-b545-6bf74ba58089",
                                                "text": "now wife"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "now",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "afc22c5f-0061-3fb1-bd89-83f581491654",
                                        "entry_id": "0dc70869-e6fc-3a42-9bdf-e32f96ea39dd",
                                        "glosses": [
                                            "At the present time."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e59a0de-fd45-4586-8267-37ccf91e0a7f",
                                                "sense_id": "afc22c5f-0061-3fb1-bd89-83f581491654",
                                                "text": "Now I am six."
                                            },
                                            {
                                                "example_id": "83be6296-f88a-44d1-8639-cbbe1c9a9d8b",
                                                "sense_id": "afc22c5f-0061-3fb1-bd89-83f581491654",
                                                "text": "Stop that now, Jimmy!"
                                            },
                                            {
                                                "example_id": "2fc49a85-1087-4e5c-ae35-465568e19d40",
                                                "sense_id": "afc22c5f-0061-3fb1-bd89-83f581491654",
                                                "text": "I could have been Secretary of State now if I hadn’t left politics five years ago."
                                            },
                                            {
                                                "example_id": "0dda4a66-5065-4932-af82-d657fb66e950",
                                                "sense_id": "afc22c5f-0061-3fb1-bd89-83f581491654",
                                                "text": "We can’t phone now – they will certaintly have gone to bed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdb1794d-538a-3e05-894e-9f6941d4279d",
                                        "entry_id": "0dc70869-e6fc-3a42-9bdf-e32f96ea39dd",
                                        "glosses": [
                                            "Used to introduce a point, a qualification of what has previously been said, a remonstration or a rebuke."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f4382561-7e0c-4fcf-9ee9-8dd2cfdd4283",
                                                "sense_id": "fdb1794d-538a-3e05-894e-9f6941d4279d",
                                                "text": "Now, we all want what is best for our children."
                                            },
                                            {
                                                "example_id": "87c32953-c918-4bad-85db-02afacf0ef2e",
                                                "sense_id": "fdb1794d-538a-3e05-894e-9f6941d4279d",
                                                "text": "Now, Jimmy, stop that."
                                            },
                                            {
                                                "example_id": "c40b8ba8-3242-4a31-8a4f-00453f210817",
                                                "sense_id": "fdb1794d-538a-3e05-894e-9f6941d4279d",
                                                "text": "Now all this was very fine, but not at all in keeping with the Celebrity's character as I had come to conceive it. The idea that adulation ever cloyed on him was ludicrous in itself. In fact I thought the whole story fishy, and came very near to saying so."
                                            },
                                            {
                                                "example_id": "4221f2ac-f08c-4625-b665-96a28200153e",
                                                "sense_id": "fdb1794d-538a-3e05-894e-9f6941d4279d",
                                                "text": "“I don’t stare at her,” Steve insisted quickly. “It’s just that every once in a while she is looking at me when I look out the window.” / “A peeping Thomasina.” / “Now, Harry.” / “Well, it’s her name. Elizabeth Thomas.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4efd1ee9-2ca8-3aa6-ba43-c3b5d91e27a3",
                                        "entry_id": "0dc70869-e6fc-3a42-9bdf-e32f96ea39dd",
                                        "glosses": [
                                            "Differently from the immediate past; differently from a more remote past or a possible future; differently from all other times."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8545fd6-716e-46eb-b68b-5feb759b8ceb",
                                                "sense_id": "4efd1ee9-2ca8-3aa6-ba43-c3b5d91e27a3",
                                                "text": "Now I am ready."
                                            },
                                            {
                                                "example_id": "eaa777c2-0ece-4731-9659-146c15350b3a",
                                                "sense_id": "4efd1ee9-2ca8-3aa6-ba43-c3b5d91e27a3",
                                                "text": "We all now want the latest toys for our children."
                                            },
                                            {
                                                "example_id": "c29083a6-48c1-444d-a491-1abbcbd439b4",
                                                "sense_id": "4efd1ee9-2ca8-3aa6-ba43-c3b5d91e27a3",
                                                "text": "We all want what is now best for our children."
                                            },
                                            {
                                                "example_id": "8c46e240-e6fb-4b2e-8dff-a1f90b3b58aa",
                                                "sense_id": "4efd1ee9-2ca8-3aa6-ba43-c3b5d91e27a3",
                                                "text": "Although the Celebrity was almost impervious to sarcasm, he was now beginning to exhibit visible signs of uneasiness, the consciousness dawning upon him that his eccentricity was not receiving the ovation it merited."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "399e3c85-7f9f-3603-a5fc-02e886ba3cdf",
                                        "entry_id": "0dc70869-e6fc-3a42-9bdf-e32f96ea39dd",
                                        "glosses": [
                                            "At the time reached within a narration."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f1df653-24fa-41b0-b2ee-2f80d200c631",
                                                "sense_id": "399e3c85-7f9f-3603-a5fc-02e886ba3cdf",
                                                "text": "Now he remembered why he had come."
                                            },
                                            {
                                                "example_id": "9d8d3627-3d56-4453-8f31-0efb47ba7ea0",
                                                "sense_id": "399e3c85-7f9f-3603-a5fc-02e886ba3cdf",
                                                "text": "He now asked her whether she had made pudding."
                                            },
                                            {
                                                "example_id": "c569dc02-eba3-4a87-8e86-b55fd2c4c844",
                                                "sense_id": "399e3c85-7f9f-3603-a5fc-02e886ba3cdf",
                                                "text": "The pudding was now ready to be served."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1190313-6eed-3c57-8305-d3885026eded",
                                        "entry_id": "0dc70869-e6fc-3a42-9bdf-e32f96ea39dd",
                                        "glosses": [
                                            "Used to indicate a context of urgency."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8827116a-5b2a-4f99-acb2-67af545cd3ef",
                                                "sense_id": "b1190313-6eed-3c57-8305-d3885026eded",
                                                "text": "Now listen, we must do something about this."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05c46fb9-f308-36b9-a011-9a5ede2bf66f",
                                        "entry_id": "0dc70869-e6fc-3a42-9bdf-e32f96ea39dd",
                                        "glosses": [
                                            "At the present point of a recurring cycle or event."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d87eca63-9552-4a9d-afa3-e1a758601401",
                                                "sense_id": "05c46fb9-f308-36b9-a011-9a5ede2bf66f",
                                                "text": "I always used to do my shopping now, to avoid the rush."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18cf5c75-afac-3197-bc1a-1f5908727d7e",
                                        "entry_id": "0dc70869-e6fc-3a42-9bdf-e32f96ea39dd",
                                        "glosses": [
                                            "Very recently; not long ago; up to the present."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e7bf839-08b7-4253-a824-680cbefe9593",
                                                "sense_id": "18cf5c75-afac-3197-bc1a-1f5908727d7e",
                                                "text": "They that but now, for honour and for plate, / Made the sea blush with blood, resign their hate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb2d3843-8831-36b7-b908-bfe90784fd41",
                                        "entry_id": "0dc70869-e6fc-3a42-9bdf-e32f96ea39dd",
                                        "glosses": [
                                            "Used to address a switching side, or sharp change in attitude from before."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "449abd42-d028-4bdd-bd00-74e37d7f426d",
                                                "sense_id": "fb2d3843-8831-36b7-b908-bfe90784fd41",
                                                "text": "Now, you want to protect me. An hour ago, you were mercilessly bullying me!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a04438cb-0bf6-3502-9f8b-14c28e8881a2",
                                        "entry_id": "0dc70869-e6fc-3a42-9bdf-e32f96ea39dd",
                                        "glosses": [
                                            "Sometimes; occasionally; used to list a series of often assumed states."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c624648-9e15-4f8a-b0e4-8d97a493d772",
                                                "sense_id": "a04438cb-0bf6-3502-9f8b-14c28e8881a2",
                                                "text": "His face fit his roles: now smiling, now earnest, now glowering, now raging."
                                            },
                                            {
                                                "example_id": "27665c3c-fa7d-4a24-8a90-68e27c3f733f",
                                                "sense_id": "a04438cb-0bf6-3502-9f8b-14c28e8881a2",
                                                "text": "And then they stood about, as soldiers do; now, with their hands loosely clasped before them; now, resting a knee or a shoulder; now, easing a belt or a pouch; now, opening the door to spit stiffly over their high stocks, out into the yard."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "now",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d37da9bc-aba0-3c72-baab-132fa7795bba",
                                        "entry_id": "62a7f08a-de0d-32a0-8de1-5de8994f57e8",
                                        "glosses": [
                                            "Indicates a signal to begin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40b53db5-811b-4b0e-a037-9f371b8e4fd6",
                                                "sense_id": "d37da9bc-aba0-3c72-baab-132fa7795bba",
                                                "text": "Now! Fire all we've got while the enemy is in reach!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "now",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3e29be2-ce1c-3364-a3e0-d03e2be0947e",
                                        "entry_id": "d7ab3c8c-29bd-3643-a30b-fd9522ff4863",
                                        "glosses": [
                                            "The present time."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "317a1704-f6af-4624-b9dd-8b688abf956a",
                                                "sense_id": "d3e29be2-ce1c-3364-a3e0-d03e2be0947e",
                                                "text": "Now is the right time."
                                            },
                                            {
                                                "example_id": "d1047e37-ea92-4ca2-af49-98b39995d3b4",
                                                "sense_id": "d3e29be2-ce1c-3364-a3e0-d03e2be0947e",
                                                "text": "There is no better time than now."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a0a86ea-0730-3944-891b-f86de341f991",
                                        "entry_id": "d7ab3c8c-29bd-3643-a30b-fd9522ff4863",
                                        "glosses": [
                                            "The state of not paying attention to the future or the past."
                                        ],
                                        "tags": [
                                            "often",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a67dfc9f-aa19-4532-972a-6594c41cbf4f",
                                                "sense_id": "1a0a86ea-0730-3944-891b-f86de341f991",
                                                "text": "She is living in the now."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21638196-f207-35b4-beae-0455bdd704ea",
                                        "entry_id": "d7ab3c8c-29bd-3643-a30b-fd9522ff4863",
                                        "glosses": [
                                            "A particular instant in time, as perceived at that instant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10ac5bcd-740f-4944-9bf4-2173b07a4c10",
                                                "sense_id": "21638196-f207-35b4-beae-0455bdd704ea",
                                                "text": "Forever is composed of Nows— / 'T is not a different time, / Except for infiniteness / And latitude of home."
                                            },
                                            {
