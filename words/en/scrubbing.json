    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f62ff420-db34-30cb-849d-83395bf403d7",
                    "sense_definition": "The act of cleaning something by rubbing it hard with a brush or cloth.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cleaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The floor needed a good <w>scrubbing</w> to remove the stubborn stains.",
                            "target_lang_translations": {
                                "cs": "Podlaha potřebovala pořádné <w>vydrhnutí</w>, aby se odstranily odolné skvrny."
                            }
                        },
                        {
                            "text": "After a quick <w>scrubbing</w>, the old pan looked almost brand new.",
                            "target_lang_translations": {
                                "cs": "Po rychlém <w>vydrhnutí</w> vypadala stará pánev skoro jako nová."
                            }
                        }
                    ],
                    "synonyms": [
                        "cleaning",
                        "scouring"
                    ],
                    "common_phrases": [
                        "give a scrubbing"
                    ],
                    "target_lang_definitions": {
                        "cs": "Činnost čištění něčeho intenzivním drhnutím kartáčem nebo hadrem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "drhnutí",
                                "target_lang_sense_clarification": "intenzivní čištění povrchu"
                            },
                            {
                                "target_lang_word": "vydrhnutí",
                                "target_lang_sense_clarification": "dokončený proces čištění"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "223b3a98-e925-3604-950b-ed452d09f572",
                    "sense_definition": "The general process or activity of rubbing something clean.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "cleaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>scrubbing</w> of the deck took several hours of hard work.",
                            "target_lang_translations": {
                                "cs": "<w>Drhnutí</w> paluby zabralo několik hodin tvrdé práce."
                            }
                        },
                        {
                            "text": "Constant <w>scrubbing</w> can eventually damage the surface of the material.",
                            "target_lang_translations": {
                                "cs": "Neustálé <w>drhnutí</w> může časem poškodit povrch materiálu."
                            }
                        }
                    ],
                    "synonyms": [
                        "washing"
                    ],
                    "target_lang_definitions": {
