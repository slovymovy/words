                        "entry_id": "7b0907f1-1d5f-358b-a239-9cdb769aee99",
                        "glosses": [
                            "Feier, die anlässlich der Fertigstellung des Rohbaus eines Gebäudes abgehalten wird"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "5b8d05a0-4a85-4780-9a0a-f4b7553ff836",
                                "sense_id": "282093c1-c62a-3723-902c-6036922dbf45",
                                "text": "Manche Bauherren verzichten leider aus Kostengründen auf eine zünftige Gleichenfeier."
                            },
                            {
                                "example_id": "7687ea15-b1a2-4e8e-b708-ef9610df0956",
                                "sense_id": "282093c1-c62a-3723-902c-6036922dbf45",
                                "text": "„Kommende Woche steigt die offizielle Gleichenfeier der neuen Generali Arena.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aeabd6e3-c9bb-43a0-817b-5eea7dee67f0",
                        "source_entry_id": "7b0907f1-1d5f-358b-a239-9cdb769aee99",
                        "source_sense_id": "282093c1-c62a-3723-902c-6036922dbf45",
                        "source_sense_description": "Österreich: Feier, die anlässlich der Fertigstellung des Rohbaus eines Gebäudes abgehalten wird",
                        "target_lang_word": "cérémonie de clôture",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cérémonie de clôture",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8f4864ea-c03a-33a8-889c-51ad0b2d6b07",
                                        "entry_id": "9f097dd8-0557-3aa8-bdb8-3541d45738f5",
                                        "glosses": [
                                            "Cérémonie marquant la fin d’un évènement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab0b64c9-0198-4578-b552-b62edaea4e8f",
                                                "sense_id": "8f4864ea-c03a-33a8-889c-51ad0b2d6b07",
                                                "text": "Monseigneur a terminé, ce matin, les exercices de la mission aux Îlets-Caribou. Cette cérémonie de clôture s’est faite à une heure matinale, afin que nous pussions profiter du bon vent, s’il y en avait, pour nous rendre au poste voisin, la Pointe-aux-Anglais. Malheureusement, le vent resta contraire. Sans doute il n’y avait qu’à attendre qu’il devînt favorable."
                                            },
                                            {
                                                "example_id": "b93b47a1-1495-47a8-ba0c-6ee1bb3c4dee",
                                                "sense_id": "8f4864ea-c03a-33a8-889c-51ad0b2d6b07",
                                                "text": "L’Impératrice, qui était venue veiller elle-même à cette installation, trouva cet homme qui démontait le lit pour l’établir à sa façon. Le 15 novembre, à la cérémonie de clôture de l’Exposition, l’Impératrice, en robe de velours rouge avec des dentelles blanches, était admirablement belle. On annonçait sa délivrance pour le mois de mars.",
                                                "translation": "Gustave de Reiset, Mes souvenirs, Plon-Nourrit et Cie, 1903, pages 316"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
