                "senses": [
                    {
                        "sense_id": "d5f71b1c-cc60-3f43-a416-aa403e41800b",
                        "entry_id": "7a907545-8c36-3f2a-bd72-9b65dcce6573",
                        "glosses": [
                            "iemand die in het buitenland woont, of iemand afkomstig uit het buitenland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c58103cc-8a8d-409c-9e86-4df033ebe65b",
                                "sense_id": "d5f71b1c-cc60-3f43-a416-aa403e41800b",
                                "text": "- Zowel Belgen als buitenlanders moeten straks tolgeld betalen op de grote doorgaande wegen in Vlaanderen."
                            },
                            {
                                "example_id": "8603a9b7-c3a3-4393-bd63-2931f3b301d7",
                                "sense_id": "d5f71b1c-cc60-3f43-a416-aa403e41800b",
                                "text": "- Je wordt wel steeds met de neus op het feit gedrukt dat je buitenlander bent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa6c76d5-fb86-4f5d-8400-2e31a684c57a",
                        "source_entry_id": "7a907545-8c36-3f2a-bd72-9b65dcce6573",
                        "source_sense_id": "d5f71b1c-cc60-3f43-a416-aa403e41800b",
                        "source_sense_description": "iemand die in het buitenland woont, of iemand afkomstig uit het buitenland",
                        "target_lang_word": "Ausländer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ausländer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0773155f-17f1-373f-881b-54d2bf57946c",
                                        "entry_id": "398f3f84-19f3-30d0-b7dd-4e7157b24642",
                                        "glosses": [
                                            "Person aus dem Ausland (Herkunft aus einem anderen Land)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8274ba7-fad0-4aa1-a8e8-37cb63c25501",
                                                "sense_id": "0773155f-17f1-373f-881b-54d2bf57946c",
                                                "text": "In den 70er Jahren sind viele Ausländer nach Deutschland gekommen, um hier Arbeit zu finden."
                                            },
                                            {
                                                "example_id": "4414c0ae-b049-4abf-a49c-09236fa633ff",
                                                "sense_id": "0773155f-17f1-373f-881b-54d2bf57946c",
                                                "text": "„Auf lange Sicht ist damit zu rechnen, daß ein großer Teil der zugewanderten Ausländerinnen und Ausländer in der deutschen Gesellschaft aufgehen wird, sicher nicht ohne bewußt bewahrte Rückstände des Andersseins, aber keineswegs nur in Äußerlichkeiten ‚eingedeutscht‘.“"
                                            },
                                            {
                                                "example_id": "bf1f3508-8982-4808-9c3d-5790829db1d9",
                                                "sense_id": "0773155f-17f1-373f-881b-54d2bf57946c",
                                                "text": "„Nicht alle Ur-Deutschen kennen einen echten Ausländer oder Deutsch-Türken mit Migrationshintergrund - nennt es, wie ihr wollt, ihr wisst, was ich meine.“"
                                            },
                                            {
                                                "example_id": "e28328db-e767-4f2f-8647-bc84e3d7ceba",
                                                "sense_id": "0773155f-17f1-373f-881b-54d2bf57946c",
                                                "text": "„Die kleinen Kratzer zeigt er dann den Ausländern, die meist kein Wort der Landessprache Amharisch beherrschen.“"
                                            },
                                            {
                                                "example_id": "9e8af370-e26c-475d-b8b9-632693b4d5e6",
                                                "sense_id": "0773155f-17f1-373f-881b-54d2bf57946c",
                                                "text": "„Ich sah ein, dass ich über einige Bemühungen von Ausländern vorschnell geurteilt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a18e59bc-0130-3c6c-849c-2a3da93bd193",
                                        "entry_id": "398f3f84-19f3-30d0-b7dd-4e7157b24642",
                                        "glosses": [
                                            "Staatsangehöriger eines fremden, eines anderen Staates"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21f93149-aad2-43cd-baf1-0fb7d57c6cf8",
                                                "sense_id": "a18e59bc-0130-3c6c-849c-2a3da93bd193",
                                                "text": "Ausländer sind Personen, die eine andere Staatsangehörigkeit haben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "99c75b73-b30b-4501-bec5-5b0546085bc6",
                        "source_entry_id": "7a907545-8c36-3f2a-bd72-9b65dcce6573",
                        "source_sense_id": "d5f71b1c-cc60-3f43-a416-aa403e41800b",
                        "source_sense_description": "iemand die in het buitenland woont, of iemand afkomstig uit het buitenland",
                        "target_lang_word": "foreigner",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "foreigner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aaba12db-f57e-3b17-87b1-9714dd095c16",
                                        "entry_id": "75d067f6-26af-3db1-b2da-ec7ca238cf58",
                                        "glosses": [
                                            "A person from a foreign country."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f45607b-dd2d-4410-8ce8-2f2d4ff461be",
                                                "sense_id": "aaba12db-f57e-3b17-87b1-9714dd095c16",
                                                "text": "By the existing law of Great Britain all foreigners have the unrestricted right of entrance and residence in this country; and while they remain in it are, equally with British subjects, under the protection of the law; nor can they be punished except for an offence against the law, and under the sentence of the ordinary tribunals of justice, after a public trial, and on a conviction founded on evidence given in open court. No foreigners, as such, can be sent out of this country by the Executive Government, except persons removed by virtue of treaties with other States; confirmed by Act of Parliament, for the mutual surrender of criminal offenders."
                                            },
                                            {
                                                "example_id": "95da5636-fc4e-4000-b66a-9e7ca55060f5",
                                                "sense_id": "aaba12db-f57e-3b17-87b1-9714dd095c16",
                                                "text": "For a student of American history and a foreigner like myself, it is easier to understand all these extremisms of conscience."
                                            },
                                            {
                                                "example_id": "cf664add-89e4-4ba3-ac89-646964f9f27d",
                                                "sense_id": "aaba12db-f57e-3b17-87b1-9714dd095c16",
                                                "text": "Though foreigners did play some part in fighting as mercenaries for Gadhafi during the bloody Libyan war, the IOM and local leaders in Chad say the vast majority of Chadians, like Mohammed, were working to send remittances home."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7c451cc-ff0f-3371-96d6-83f1bcb1697c",
                                        "entry_id": "75d067f6-26af-3db1-b2da-ec7ca238cf58",
                                        "glosses": [
                                            "A private job run by an employee at a trade factory rather than going through the business."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
