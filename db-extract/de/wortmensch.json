                "senses": [
                    {
                        "sense_id": "40f1e4bf-371c-3594-b614-0e49be97cf39",
                        "entry_id": "ceab04a2-2d96-342c-9d9f-f05fd1be87c6",
                        "glosses": [
                            "Person, für die sprachliche Aktivität wesentliches Lebenselement ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8c0cc2a-61f1-435c-8878-997ef9160877",
                                "sense_id": "40f1e4bf-371c-3594-b614-0e49be97cf39",
                                "text": "„Nur dass ich als Wortmensch Karl Kraus nachzuahmen begann, von ihm konnte ich besonders das Hören, bis zu einem gewissen Grade aber auch (und nicht ohne einiges Widerstreben) die Rhetorik der Anklage lernen.“"
                            },
                            {
                                "example_id": "de3360c0-320c-426d-9b31-52aba7812331",
                                "sense_id": "40f1e4bf-371c-3594-b614-0e49be97cf39",
                                "text": "„Es ist die Sprache jener Skala, die den Wortmenschen Huler in ihren Bann schlägt, jenes Universum aus \"Kräuselwellen\" und \"Schaumköpfen\", in dem das Windgeschehen möglichst knapp, exakt und für jeden Beobachter nachvollziehbar erfasst ist.“"
                            },
                            {
                                "example_id": "4fb21878-4535-46a9-8c6a-01d7a1edf8d4",
                                "sense_id": "40f1e4bf-371c-3594-b614-0e49be97cf39",
                                "text": "„Die Attraktivität von Tatmenschen für Wortmenschen ist ebenfalls ein bekanntes Phänomen der politischen Psychologie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
