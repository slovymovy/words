                        "examples": [
                            {
                                "example_id": "6fc70f48-964d-49c7-a97c-75982f07196c",
                                "sense_id": "3a0f7273-e80a-3691-bf3d-59c32c620832",
                                "text": "C’était bizarre. Jamalou n’éprouvait plus, devant cette face douloureuse dont les yeux révulsés, la bouche aux lèvres tuméfiées, presque noire, révélaient l’atroce agonie, aucune espèce de compassion."
                            },
                            {
                                "example_id": "f6adedd8-58e5-4e24-a57f-45d84cfed06f",
                                "sense_id": "3a0f7273-e80a-3691-bf3d-59c32c620832",
                                "text": "Bière dans une main, machette dans l'autre, l'oeil révulsé, la démarche incertaine."
                            }
                        ]
                    }
