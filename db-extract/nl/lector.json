                                        "sense_id": "a3687a63-8305-34e7-93da-beb7e3fbe92d",
                                        "entry_id": "880a23d4-c32b-38be-ae35-6b967b96c8c6",
                                        "glosses": [
                                            "A public lecturer or reader at some universities."
