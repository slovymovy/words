{
    "word_family": [
        "fickleness",
        "fickly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "71632446-ae3a-3eeb-97d2-5f27b27f5574",
                    "sense_definition": "Quick to change one's mind, feelings, or loyalties; not reliable or constant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inconstant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was known to be a <w>fickle</w> friend who only stayed around when things were easy.",
                            "target_lang_translations": {
                                "es": "Era conocido por ser un amigo <w>inconstante</w> que solo se quedaba cuando las cosas eran fáciles."
                            }
                        },
                        {
                            "text": "The public can be notoriously <w>fickle</w>, cheering for an artist one day and forgetting them the next.",
                            "target_lang_translations": {
                                "es": "El público puede ser notablemente <w>voluble</w>, aplaudiendo a un artista un día y olvidándolo al siguiente."
                            }
                        }
                    ],
                    "synonyms": [
                        "capricious",
                        "flighty",
                        "mercurial"
                    ],
                    "antonyms": [
                        "loyal",
                        "faithful",
                        "constant",
                        "steadfast"
                    ],
                    "common_phrases": [
                        "fickle nature",
                        "fickle heart"
                    ],
                    "target_lang_definitions": {
                        "es": "Que cambia rápidamente de opinión, sentimientos o lealtades; poco constante o de poco fiar."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "inconstante",
                                "target_lang_sense_clarification": "que cambia con frecuencia de opinión o afecto"
                            },
                            {
                                "target_lang_word": "voluble",
                                "target_lang_sense_clarification": "de carácter mudable o caprichoso"
                            },
                            {
                                "target_lang_word": "veleidoso",
                                "target_lang_sense_clarification": "que cambia fácilmente de lealtad o propósito"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd66bf55-277d-3fd0-9295-60db8b025292",
                    "sense_definition": "Unpredictably changeable or unstable, especially regarding weather or conditions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inconstant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We packed jackets and umbrellas because of the <w>fickle</w> spring weather.",
                            "target_lang_translations": {
                                "es": "Empacamos chaquetas y paraguas debido al <w>cambiante</w> clima de primavera."
                            }
                        },
                        {
                            "text": "Sailors struggled to make progress amid the <w>fickle</w> winds of the channel.",
                            "target_lang_translations": {
                                "es": "Los marineros lucharon por avanzar en medio de los vientos <w>caprichosos</w> del canal."
                            }
                        }
                    ],
                    "synonyms": [
                        "erratic",
                        "capricious"
                    ],
                    "antonyms": [
                        "stable",
                        "predictable",
                        "steady"
                    ],
                    "common_phrases": [
                        "fickle weather",
                        "fickle winds",
                        "fickle fortune"
                    ],
                    "target_lang_definitions": {
                        "es": "Inestable o impredecible, especialmente referido al tiempo meteorológico o a las condiciones."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "cambiante",
                                "target_lang_sense_clarification": "que varía continuamente y de forma impredecible"
                            },
                            {
                                "target_lang_word": "inestable",
                                "target_lang_sense_clarification": "poco constante, propenso a cambios repentinos"
                            },
                            {
                                "target_lang_word": "caprichoso",
                                "target_lang_sense_clarification": "impredecible, como el clima o el viento"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "510dbe4a-884a-3724-b255-557150cdf07e",
                    "sense_definition": "To deceive, trick, or flatter someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He attempted to <w>fickle</w> the old man with false promises of wealth.",
                            "target_lang_translations": {
                                "es": "Intentó <w>engañar</w> al anciano con falsas promesas de riqueza."
                            }
                        },
                        {
                            "text": "She warned her brother not to let dishonest traders <w>fickle</w> him.",
                            "target_lang_translations": {
                                "es": "Le advirtió a su hermano que no permitiera que comerciantes deshonestos lo <w>embaucaran</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "sense is no longer in modern use"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Engañar, embaucar o adular a alguien (uso obsoleto)."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "engañar",
                                "target_lang_sense_clarification": "inducir a error o hacer creer algo falso"
                            },
                            {
                                "target_lang_word": "embaucar",
                                "target_lang_sense_clarification": "seducir con engaños o falsas promesas"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8621769e-a468-3aa7-98e4-38389ec34ac9",
                    "sense_definition": "To puzzle, perplex, or nonplus.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The complex riddle completely <w>fickled</w> the curious students.",
                            "target_lang_translations": {
                                "es": "El complejo acertijo <w>desconcertó</w> por completo a los curiosos estudiantes."
                            }
                        },
                        {
                            "text": "Such strange behavior was enough to <w>fickle</w> even his closest companions.",
                            "target_lang_translations": {
                                "es": "Un comportamiento tan extraño fue suficiente para <w>dejar perplejos</w> incluso a sus compañeros más cercanos."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "chiefly regional or archaic usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Desconcertar, dejar perplejo o confundir (uso dialectal)."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "desconcertar",
                                "target_lang_sense_clarification": "dejar a alguien confuso o perplejo"
                            },
                            {
                                "target_lang_word": "perplejizar",
                                "target_lang_sense_clarification": "causar perplejidad o confusión"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "0404e67c-4028-32ef-89d8-e523c68c219f",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Fickle</w> joined the committee as its newest member.",
                            "target_lang_translations": {
                                "es": "El señor <w>Fickle</w> se unió al comité como su miembro más nuevo."
                            }
                        },
                        {
                            "text": "The letter was addressed to the <w>Fickles</w> down the street.",
                            "target_lang_translations": {
                                "es": "La carta estaba dirigida a los <w>Fickle</w>, que vivían más abajo en la calle."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Apellido de origen inglés."
                    },
                    "translations": {
                        "es": []
                    }
                }
            ]
        }
    ]
}