                    },
                    {
                        "sense_id": "d3e1fc78-de75-3c58-b21b-31e22480e380",
                        "entry_id": "978f0100-a27f-3229-8246-9894e21a8d4c",
                        "glosses": [
                            "bedrijf dat ijzerwaren verkoopt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28e3ab51-cb0c-4c1a-912d-bb34f87b40ba",
                                "sense_id": "d3e1fc78-de75-3c58-b21b-31e22480e380",
                                "text": "Hij loopt de slaapkamer in en maakt het bed op, hangt zijn colbertjes op hun plek in de kast en pakt de zak van de ijzerhandel die onderin op zijn schoenen ligt, haalt het opgerolde touw eruit en vouwt de zak netjes op, neemt ze allebei mee naar de keuken, legt het touw op het aanrecht, pakt een glas uit de kast en vult dat met water uit de kraan."
                            },
                            {
                                "example_id": "5e14c8a8-47a8-45c2-97f3-f621631804a6",
                                "sense_id": "d3e1fc78-de75-3c58-b21b-31e22480e380",
                                "text": "Een dag later seinde een metaalverwerkingsbedrijf de politie in toen iemand een partij restanten van instrumenten te koop aanbood. Onderzoek leidde naar een ijzerhandel, waar de politie zo'n tien in stukken gezaagde instrumenten vond."
                            }
                        ]
                    }
