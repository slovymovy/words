                ],
                "senses": [
                    {
                        "sense_id": "38855fd7-d7f6-339c-b496-689a4a7d57ac",
                        "entry_id": "9d4df7e9-9adf-3e31-bf63-57e350a0ae52",
                        "glosses": [
                            "Entscheidung im Leben, die wesentlichen Einfluss auf das künftige Lebens hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dce99762-5e8c-4b25-a335-208f07196d63",
                                "sense_id": "38855fd7-d7f6-339c-b496-689a4a7d57ac",
                                "text": "„Der Teilnehmer an Glücksspielen treffe keine ökonomisch rationale Entscheidung, sondern suche im Rahmen einer mit Suchtgefahren behafteten Betätigung eine Schicksalsentscheidung.“"
                            },
                            {
                                "example_id": "f4c37a93-8482-4954-82f5-eef5cd05a0f4",
                                "sense_id": "38855fd7-d7f6-339c-b496-689a4a7d57ac",
                                "text": "„Sollte die ‚Schicksalsentscheidung‘ Schwangerschaft akzeptiert werden, kann eine weniger sichere Methode durchaus sinnvoll sein.“"
                            },
                            {
                                "example_id": "4b827023-e017-4ed0-95ee-43b370e1e2e0",
                                "sense_id": "38855fd7-d7f6-339c-b496-689a4a7d57ac",
                                "text": "„In menschlicher Daseinsform geboren zu sein, ist ein Privileg, das schon der Buddha als solches anerkannte, da es die seltene Gelegenheit der Schicksalsentscheidung, der »Umkehr«, und damit der Befreiung bietet.“"
                            },
                            {
                                "example_id": "b9bf7287-9e9d-4dad-8fae-1516a1f44cd3",
                                "sense_id": "38855fd7-d7f6-339c-b496-689a4a7d57ac",
                                "text": "„Sie seufzte stumm, nicht nur für sie brachte der heutige Tag eine Schicksalsentscheidung.“"
                            },
                            {
                                "example_id": "6912577c-c58c-4246-acd5-c452a8d450bd",
                                "sense_id": "38855fd7-d7f6-339c-b496-689a4a7d57ac",
                                "text": "„Es war eine Schicksalsentscheidung, die er zwar in Gang gesetzt hatte, dann aber nicht mehr in der Lage war, sie zu beeinflussen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
