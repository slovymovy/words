                "translations": [
                    {
                        "translation_id": "f75d460a-b46b-4d4a-8397-f4b4856ac881",
                        "source_entry_id": "07b2d48a-506f-361c-8057-3e9dc2e708d3",
                        "source_sense_id": "7d836f3e-9d8f-34c4-b018-46589efe33a1",
                        "target_lang_word": "separatism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "separatism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06dff2e8-44a9-3d19-811c-e3da11c79892",
                                        "entry_id": "a6f213b6-3a98-3b53-92de-c199b8781d4b",
                                        "glosses": [
                                            "A theory or doctrine which supports a state of separation between organizations, institutions, or other societal groups (e.g. between church and state) or between different political jurisdictions (e.g. a country and its former colony)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9f042e7-1704-4daf-b349-f77902fd21f1",
                                                "sense_id": "06dff2e8-44a9-3d19-811c-e3da11c79892",
                                                "text": "She wrote an essay expounding the tenets of Scottish separatism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6448357-06e6-3565-84a0-90f3652fb119",
                                        "entry_id": "a6f213b6-3a98-3b53-92de-c199b8781d4b",
                                        "glosses": [
                                            "The practice of treating members of different societal groups in a politically, legally, or economically different manner."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af09a467-a7c6-4eba-9998-56f5619f768f",
                                                "sense_id": "d6448357-06e6-3565-84a0-90f3652fb119",
                                                "text": "Apartheid was a government-enforced form of separatism in which people received unequal social benefits based on race."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf6abe65-502e-48cb-ac0d-4c00d93da912",
                        "source_entry_id": "07b2d48a-506f-361c-8057-3e9dc2e708d3",
                        "source_sense_id": "7d836f3e-9d8f-34c4-b018-46589efe33a1",
                        "target_lang_word": "séparatisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "séparatisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a5a987ff-9a7f-39e2-ad85-4bef5e02a2e1",
                                        "entry_id": "47a64860-e523-3446-8267-a1940dce8fa0",
                                        "glosses": [
                                            "Mouvement favorable au principe de la séparation de l’Église et de l’État."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "65fa67a4-3ef5-35b8-8eb5-ea44b58be86f",
                                        "entry_id": "47a64860-e523-3446-8267-a1940dce8fa0",
                                        "glosses": [
                                            "Tendance d’une partie d’un peuple, d’un État, à la séparation, le plus souvent pour devenir un État indépendant, ou éventuellement pour se rattacher à un autre État."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de35b468-5fa8-449a-a99e-a235559f1170",
                                                "sense_id": "65fa67a4-3ef5-35b8-8eb5-ea44b58be86f",
                                                "text": "Il est partisan de rétablir toutes les barrières qui séparaient au siècle précédent les juifs d’avec les chrétiens. Quitte sans doute à accuser ensuite les juifs de séparatisme !"
                                            },
                                            {
                                                "example_id": "95dd0e94-9b92-4d90-9783-0a06025f35cd",
                                                "sense_id": "65fa67a4-3ef5-35b8-8eb5-ea44b58be86f",
                                                "text": "Au même moment, le président irakien, Jalal Talabani, le leader de l’autre grand parti kurde, l’UPK (Union patriotique du Kurdistan), calmait le jeu assurant que « les Kurdes ne veulent pas le séparatisme », tout en reconnaissant qu’il fallait « changer le drapeau irakien »."
                                            },
                                            {
                                                "example_id": "f97e8818-e27b-451e-94a2-dd92982fb998",
                                                "sense_id": "65fa67a4-3ef5-35b8-8eb5-ea44b58be86f",
                                                "text": "Dans le Sud [de la Thaïlande], le séparatisme musulman est combattu avec une poigne de fer, ce qui suscite la défiance de la population."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "caaff87a-83e2-30fc-adb1-5605b1d9d11a",
                                        "entry_id": "47a64860-e523-3446-8267-a1940dce8fa0",
                                        "glosses": [
                                            "Mouvement qui consiste pour une communauté donnée à vouloir s’organiser en marge de la République, comme si on voulait s’en séparer, à ne plus en respecter les lois et à considérer que ses valeurs religieuses, sexuelles, culturelles ou autres sont supérieures aux règles de la République."
                                        ],
                                        "tags": [
                                            "France"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e3b3a02-bb13-451f-aa7f-a41bb9b0cb3c",
                                                "sense_id": "caaff87a-83e2-30fc-adb1-5605b1d9d11a",
                                                "text": "Accusé de tergiverser sur un sujet qui divise profondément la classe politique, jusque dans son propre camp, Emmanuel Macron a voulu se montrer tranchant et déterminé, tout en s’efforçant de ne pas exacerber les tensions. Devant une poignée de ministres et d’élus et quelques dizaines de journalistes, il a prononcé vendredi dans la mairie des Mureaux (Yvelines), « ville laboratoire » où sont expérimentés plusieurs dispositifs visant à favoriser l’intégration républicaine, son très attendu discours sur le « séparatisme », finalement au singulier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24b0bee2-3e22-4ce8-9729-789ba306faa4",
                        "source_entry_id": "07b2d48a-506f-361c-8057-3e9dc2e708d3",
                        "source_sense_id": "7d836f3e-9d8f-34c4-b018-46589efe33a1",
                        "target_lang_word": "indépendantisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indépendantisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4b823a84-84b7-3ed6-bdb1-6dd2bdbba77e",
                                        "entry_id": "e2e3a4ee-603d-3ffb-adf6-6785f0eb6cba",
                                        "glosses": [
                                            "Option politique visant l’indépendance politique d’un peuple ou d’un territoire par rapport à une entité politique (pays, fédération) à laquelle il est rattaché."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2530aeae-eb1e-419b-96bf-5a28e0d843cf",
                                                "sense_id": "4b823a84-84b7-3ed6-bdb1-6dd2bdbba77e",
                                                "text": "Ayant tourné la page de l'indépendantisme pur et dur (« Nous préférons parler de souveraineté partagée et de prise de responsabilité »), le Mouvement guadeloupéen et ses compagnons de route ont donc choisi un « homme neuf », de 53 ans lui aussi, ouvert et maire…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "211199ee-d4bf-3340-b050-1bfb6fb7dcdb",
                                        "entry_id": "e2e3a4ee-603d-3ffb-adf6-6785f0eb6cba",
                                        "glosses": [
                                            "Option politique visant l’indépendance politique d’un peuple ou d’un territoire par rapport à une entité politique (pays, fédération) à laquelle il est rattaché.",
                                            "Option politique visant l’indépendance politique du Québec par rapport à la fédération canadienne."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18ce0bc6-9274-4d6c-aaaf-a176d9e0986f",
                                                "sense_id": "211199ee-d4bf-3340-b050-1bfb6fb7dcdb",
                                                "text": "Il y a près de dix ans, Pierre Trudeau devenait premier ministre, avec quelques buts bien précis : rendre le Canada bilingue, assurer la participation des francophones à l’administration du pays, bloquer la montée de l’indépendantisme québécois, réorienter certaines grandes options en politique étrangère, en économie…"
                                            },
                                            {
                                                "example_id": "5f85c774-c94b-4b95-ac4e-29ede5b0beb3",
                                                "sense_id": "211199ee-d4bf-3340-b050-1bfb6fb7dcdb",
                                                "text": "Le jour des Patriotes nous offre l’occasion parfaite de rappeler l’historique de l'indépendantisme québécois et des jalons de ce combat pour la démocratie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b12d9b9-8c22-4aa6-91d3-8986cc174107",
                        "source_entry_id": "07b2d48a-506f-361c-8057-3e9dc2e708d3",
                        "source_sense_id": "7d836f3e-9d8f-34c4-b018-46589efe33a1",
