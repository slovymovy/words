                    {
                        "sense_id": "b092ed60-9480-3ce1-a7a3-b215738759cb",
                        "entry_id": "3a7ac57d-7d13-39bb-9c2f-63836089227f",
                        "glosses": [
                            "een bedrijf waar dieren geslacht worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97bf74bf-7b53-405b-acc4-a95a45108a20",
                                "sense_id": "b092ed60-9480-3ce1-a7a3-b215738759cb",
                                "text": "Daarachter was de brede toegang tot een abattoir - de beroemde slachtplaats, die niet langer in gebruik was."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "81e3d488-9d0a-49a8-97b1-8f343b1e293e",
                        "source_entry_id": "3a7ac57d-7d13-39bb-9c2f-63836089227f",
                        "source_sense_id": "b092ed60-9480-3ce1-a7a3-b215738759cb",
                        "source_sense_description": "een bedrijf waar dieren geslacht worden",
                        "target_lang_word": "Schlachthaus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlachthaus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "06712738-ad31-3b1b-b5d7-3479b72c39e8",
                                        "entry_id": "9dd57976-53cf-3a32-9573-87ff4346d979",
                                        "glosses": [
                                            "Haus, in dem geschlachtet werden darf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "761cfd85-8210-43d9-acf7-e60dc4682f7d",
                                                "sense_id": "06712738-ad31-3b1b-b5d7-3479b72c39e8",
                                                "text": "„Sie schmeckte mir so vorzüglich, dass ich mir fest vornahm, an einer jener mystischen privaten Hausschlachtungen teilzunehmen, die der Klaus nur wenige Schritte vom »Klausenhof« entfernt in einem eigens dafür hergerichteten historischen Schlachthaus zelebriert.“"
                                            },
                                            {
                                                "example_id": "b7db47ca-1d5b-4955-bf0a-11a361d05909",
                                                "sense_id": "06712738-ad31-3b1b-b5d7-3479b72c39e8",
                                                "text": "„Schnell ließen sie die Viehbörse hinter sich und durchquerten ein Labyrinth von Ställen, Schlachthäusern und Verwaltungsgebäuden.“"
                                            },
                                            {
                                                "example_id": "a86fa4b2-d963-4662-b404-234258cbe5e0",
                                                "sense_id": "06712738-ad31-3b1b-b5d7-3479b72c39e8",
                                                "text": "„Unsere Lóa ist in Wirklichkeit so harmlos und gutherzig, dass sie sich vor Sorge und Kummer ins Bett legt, wenn sie im Herbst die Schafe ins Schlachthaus schicken muss.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a10cd324-5181-4c84-bd5f-179c09103b64",
                        "source_entry_id": "3a7ac57d-7d13-39bb-9c2f-63836089227f",
                        "source_sense_id": "b092ed60-9480-3ce1-a7a3-b215738759cb",
                        "source_sense_description": "een bedrijf waar dieren geslacht worden",
                        "target_lang_word": "Schlachthof",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlachthof",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23889a0d-f959-3829-9fc4-c6adadc1a7b3",
                                        "entry_id": "e8407251-0dd2-3470-89b3-c000f79f3a66",
                                        "glosses": [
                                            "Einrichtung, in welcher Tieren das Leben genommen werden darf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55d898fc-b27f-4555-b564-69f81b243026",
                                                "sense_id": "23889a0d-f959-3829-9fc4-c6adadc1a7b3",
                                                "text": "In Schlachthöfen werden Tiere geschlachtet."
                                            },
                                            {
                                                "example_id": "3023c2d2-b413-4f4a-b93f-bc4dba1afd0b",
                                                "sense_id": "23889a0d-f959-3829-9fc4-c6adadc1a7b3",
                                                "text": "„Viehhof, Schlachthof und Fleischgroßmarkt bilden ein untrennbares wirtschaftliches Ganzes.“"
                                            },
                                            {
                                                "example_id": "aca2b31e-34b2-4abd-aea7-d3d7c798f6ff",
                                                "sense_id": "23889a0d-f959-3829-9fc4-c6adadc1a7b3",
                                                "text": "„Man hätte sie für eine berühmte Schauspielerin halten können, doch in Fritze Grails Kneipe gegenüber dem Schlachthof verirrten sich keine Ufa-Stars.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d4a112a-e6dc-4368-9584-63c01b44a8c9",
                        "source_entry_id": "3a7ac57d-7d13-39bb-9c2f-63836089227f",
                        "source_sense_id": "b092ed60-9480-3ce1-a7a3-b215738759cb",
                        "source_sense_description": "een bedrijf waar dieren geslacht worden",
                        "target_lang_word": "abattoir",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abattoir",
