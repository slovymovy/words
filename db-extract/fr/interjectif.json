                                "text": "Particule interjective."
                            },
                            {
                                "example_id": "9024170d-3e53-461f-83e8-121885cd84d7",
                                "sense_id": "80f30302-afd2-3355-8c8d-1c287ea87625",
                                "text": "Locution interjective."
                            },
