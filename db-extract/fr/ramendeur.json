                        "glosses": [
                            "Réparateur de filet de pêche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9366e520-50ae-43a6-908b-34deb8af87e7",
                                "sense_id": "01fe6e1e-9951-31a5-bab0-67fb297e71f2",
                                "text": "Le ramendeur, qui maniait aussi bien la tondeuse que la navette, coupait les cheveux qui dépassaient du suroît."
                            },
                            {
                                "example_id": "e3d8ca14-91a7-48b2-aed7-1d5b22ac3b42",
                                "sense_id": "01fe6e1e-9951-31a5-bab0-67fb297e71f2",
                                "text": "Il y a plein de métiers maritimes qui se perdent comme fabricant de cordes, repasseuses de coiffes, ramendeurs de filets de pêche, sculpteurs de proue, botulomodélistes, saurisseur, marchande de crevettes, lessiveuse à l'ancienne."
                            },
                            {
                                "example_id": "6e4a6e7c-6990-4684-aed7-7893cf3f3c65",
                                "sense_id": "01fe6e1e-9951-31a5-bab0-67fb297e71f2",
                                "text": "Rosette Nerou et Irène Menat sont les deux dernières ramendeuses sur le port de Saint-Jean-de-Luz."
                            }
                        ]
                    }
