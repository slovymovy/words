                "senses": [
                    {
                        "sense_id": "1a64e806-4b53-315f-b7b3-a34a7454bbb2",
                        "entry_id": "ddfb2b01-8813-3bb1-8e2b-ecc955ac1696",
                        "glosses": [
                            "meist aus Metall bestehender Gegenstand, mit dem man per Knopfdruck eine Flüssigkeit oder ein Gas versprühen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f88dc948-6ad1-49ea-9b40-6ecf2c82bdef",
                                "sense_id": "1a64e806-4b53-315f-b7b3-a34a7454bbb2",
                                "text": "In der Nähe eines Graffitis fand man eine Sprühdose."
                            },
                            {
                                "example_id": "35b81185-8956-4fa8-8e7a-a76481ca849e",
                                "sense_id": "1a64e806-4b53-315f-b7b3-a34a7454bbb2",
                                "text": "„Regen; Lack oder andere Stoffe aus einer Sprühdose; Kühlwasser aus einer Düse oder Löschwasser aus einem Feuerwehrschlauch; das Kraftstoff-Luft-Gemisch im Vergaser eines Ottomotors: Überall, wo Tropfen in hoher Konzentration in (nicht zu regelmäßiger) Bewegung sind, stoßen sie auch zusammen.“"
                            },
                            {
                                "example_id": "61e1583e-25fb-4901-8fd9-472df2a8853a",
                                "sense_id": "1a64e806-4b53-315f-b7b3-a34a7454bbb2",
                                "text": "„Er nimmt seine Sprühdose und lässt auf der nackten Betonmauer den Befreiungsschrei los.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
