                ],
                "senses": [
                    {
                        "sense_id": "162d2e31-5a1f-3ea3-9bb9-d094d83c0f2b",
                        "entry_id": "9a610223-23fe-3a71-8db4-f157d66f7c55",
                        "glosses": [
                            "Personne nostalgique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afe33555-f860-4df7-aec6-30618fc54bb0",
                                "sense_id": "162d2e31-5a1f-3ea3-9bb9-d094d83c0f2b",
                                "text": "Le nostalgique est en position instable, tenaillé entre le passé et le présent : son regard est tourné vers la douceur imaginaire du passé, et lorsqu’il le dirige sur son présent, tout lui semble fade et sans intérêt."
                            },
                            {
                                "example_id": "956591ca-01f5-4ca2-bf79-9336da1c8a4a",
                                "sense_id": "162d2e31-5a1f-3ea3-9bb9-d094d83c0f2b",
                                "text": "En ce sens, les analphabètes actuels sont des précurseurs, non des « bavures » ; et ceux qui veulent les « désanalphabétiser » des nostalgiques."
                            }
                        ]
                    }
                ],
