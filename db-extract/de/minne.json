                        "sense_id": "334ec284-3e93-3f68-a16e-b082fad9e17e",
                        "entry_id": "08464f9f-7dae-3a28-a4fc-fabef1b2c47c",
                        "glosses": [
                            "láska, zejména rytířská, světská, romantická; v mystice láska k Bohu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49499978-432d-4a94-adbf-c876f53b4927",
                                "sense_id": "334ec284-3e93-3f68-a16e-b082fad9e17e",
                                "text": "Unter andern war eine, die hatte ihr Herz auf zergängliche Minne fest gekehret, das da heißt Sponsiren, und ist ein Gift geistlicher Seligkeit.",
                                "translation": "Mezi nimi byla sestra, jež své srdce zcela věnovala pomíjející lásce, milkování, jež jest jedem duchovní dokonalosti."
                            },
                            {
                                "example_id": "31e4aa55-3e9e-40bc-a011-ec4db2abc6e1",
                                "sense_id": "334ec284-3e93-3f68-a16e-b082fad9e17e",
                                "text": "Wie er etliche Herzen von zeitlicher Minne zu göttlicher Minne zog.",
                                "translation": "Jak přivedl různá milující srdce od pomíjející lásky k božskému milování."
                            }
                        ]
                    }
