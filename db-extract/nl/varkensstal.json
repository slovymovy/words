                    {
                        "form_id": "efb1d57f-ab20-4197-a900-5824c0c9a6c9",
                        "entry_id": "bbd64349-e9f0-327a-860c-3f81aa419601",
                        "tags": [
                            "plural"
                        ],
                        "form": "varkensstallen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a15b1423-55ce-3f54-89bb-74a7a10093b6",
                        "entry_id": "bbd64349-e9f0-327a-860c-3f81aa419601",
                        "glosses": [
                            "overdekt verblijf voor varkens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b416ed9e-73bc-49fc-8a76-aa555c44a58d",
                                "sense_id": "a15b1423-55ce-3f54-89bb-74a7a10093b6",
                                "text": "„Een varken vreet alles”, zegt Bob. „Daarom moet je speeltjes in de varkensstal ophangen, anders vreten ze elkaar op uit pure verveling. Een boer had een hartinfarct in de varkensstal. Toen ze hem vonden waren zijn neus, zijn vingers en zijn oren opgegeten.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "9b513455-4e1d-3ace-a1f5-1c4d214cc4bb",
                        "entry_id": "bbd64349-e9f0-327a-860c-3f81aa419601",
                        "glosses": [
                            "een zeer smerig huis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cf17bf8-71bc-4634-bbef-2632bc536d24",
                                "sense_id": "9b513455-4e1d-3ace-a1f5-1c4d214cc4bb",
                                "text": "Richards’ beschrijving van „een varkensstal” is zacht uitgedrukt. Je loopt door een keuken met afwas die hoog is opgestapeld, lege melkflessen met peuken erin, half opgegeten blikjes bonen waaruit een vork steekt. De slaapkamer met onopgemaakte bedden, de borden met etensresten eronder. Jagger, Richards en Ronnie Wood hoor je herinneringen ophalen. Ze wilden „alleen maar muziek maken”."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ffca3bc4-c1eb-4e2c-a97b-1ecf910b1dfc",
                        "source_entry_id": "bbd64349-e9f0-327a-860c-3f81aa419601",
                        "source_sense_id": "a15b1423-55ce-3f54-89bb-74a7a10093b6",
                        "source_sense_description": "overdekt verblijf voor varkens",
                        "target_lang_word": "Saustall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Saustall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2587a3ad-1abd-32d9-bf66-7fd463bd1e33",
                                        "entry_id": "e437f470-3973-3f05-b9ab-24aef938a97c",
                                        "glosses": [
                                            "Stall für Schweine"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc3faee6-cc41-41c4-9695-3c5891481004",
                                                "sense_id": "2587a3ad-1abd-32d9-bf66-7fd463bd1e33",
                                                "text": "„Wenn ein Schwein beschrien ist, soll man die Blätter von einer alten Karten inwendig hin und her im Saustall anzwecken, so wird es mit ihr besser.“ (1759)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "10fa0937-fb38-3d03-b109-10976edd5e27",
                                        "entry_id": "e437f470-3973-3f05-b9ab-24aef938a97c",
                                        "glosses": [
                                            "sehr schmutzige, unaufgeräumte Räumlichkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7509cd7e-9e24-4045-ad5a-ca1805d714e5",
                                                "sense_id": "10fa0937-fb38-3d03-b109-10976edd5e27",
                                                "text": "Was ist denn das für ein Saustall hier!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a14e023-d206-4a09-9f1c-a83fb96dd4f2",
                        "source_entry_id": "bbd64349-e9f0-327a-860c-3f81aa419601",
                        "source_sense_id": "a15b1423-55ce-3f54-89bb-74a7a10093b6",
                        "source_sense_description": "overdekt verblijf voor varkens",
                        "target_lang_word": "Schweinestall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schweinestall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "89699861-cf3e-36ae-9dab-ab3590071bcb",
                                        "entry_id": "1a2e12e2-39b4-3b17-a458-256ef0bd1e6a",
                                        "glosses": [
                                            "Stall, in dem Hausschweine gehalten werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cdad035-2258-491d-a042-a1a14e5437e1",
                                                "sense_id": "89699861-cf3e-36ae-9dab-ab3590071bcb",
                                                "text": "Morgen wird der Schweinestall ausgemistet."
                                            },
                                            {
                                                "example_id": "d007560b-ebe8-42fb-941b-805e7be335a0",
                                                "sense_id": "89699861-cf3e-36ae-9dab-ab3590071bcb",
                                                "text": "„Die Dondorfer Zinkwanne im ausgedienten Schweinestall vor Augen, prustete ich los.“"
                                            },
                                            {
                                                "example_id": "5abb44c0-231c-4ce3-97f5-5a468848098d",
                                                "sense_id": "89699861-cf3e-36ae-9dab-ab3590071bcb",
                                                "text": "„Ein paar Kuh- und Schweineställe bildeten das Ganze dieser Hinterwäldler-Siedlung.“"
                                            },
                                            {
                                                "example_id": "8b8e6511-8ae8-4260-b382-9929bde2a5f7",
                                                "sense_id": "89699861-cf3e-36ae-9dab-ab3590071bcb",
                                                "text": "„Er war ein Mannsbild und in der Faktorei ein Mädchen für alles und durfte im Schweinestall schlafen.“"
                                            },
                                            {
                                                "example_id": "3fb20b0b-18e5-4111-8b03-230c72a060f4",
                                                "sense_id": "89699861-cf3e-36ae-9dab-ab3590071bcb",
                                                "text": "„Bald wurde der Schweinestall zu eng.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ad271371-ca7f-3476-b818-68012d9fd713",
                                        "entry_id": "1a2e12e2-39b4-3b17-a458-256ef0bd1e6a",
                                        "glosses": [
                                            "unordentlicher, schmutziger Raum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6fe1252-dd75-4b32-a6ea-4776e2da22e3",
                                                "sense_id": "ad271371-ca7f-3476-b818-68012d9fd713",
                                                "text": "Wie kannst du in aller Ruhe in diesem Schweinestall sitzen und fernsehen?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d635eabc-9656-4ba0-a943-3ea0d038158b",
