                        ],
                        "examples": [
                            {
                                "example_id": "81661068-b991-47e9-9af4-ee350dea5e4d",
                                "sense_id": "1730f6d5-600c-324a-a919-bfda08fab70c",
                                "text": "Le mode judicatif, indicatif."
                            },
                            {
                                "example_id": "b05d450d-2a28-487e-938e-e129fcd097f9",
                                "sense_id": "1730f6d5-600c-324a-a919-bfda08fab70c",
                                "text": "Judicatif, adj. « Puissance cognoscitive et judicative. — Astrologie judicative. »."
                            },
                            {
                                "example_id": "b5e6b6ef-effb-4668-a1ea-90ac8816116a",
                                "sense_id": "1730f6d5-600c-324a-a919-bfda08fab70c",
                                "text": "Aristote présente les catégories comme les différentes espèces de prédicats que l'on peut attribuer à un sujet dans le jugement (le terme κατηγορία vient du verbe κατηγορεῖν, « affirmer », ou, plus explicitement, « attribuer – positivement ou négativement – un prédicat à un sujet »). Mais, comme la synthèse judicative a une signification ontologique, les catégories doivent elles-mêmes être considérées comme des déterminations réelles de l'être."
                            }
                        ]
                    }
