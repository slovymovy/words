                                        "entry_id": "6d8fc29b-1a27-3bb6-b169-f9d1d7809c72",
                                        "glosses": [
                                            "The act by which something is clasped."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b4b5dde-02fe-4338-849f-527d9f14bc55",
                                                "sense_id": "cdcd3384-771f-3468-971e-eaa758862278",
                                                "text": "Nothing had been said during our drive, but the high thin breathing of our new companion, and the claspings and unclaspings of his hands spoke of the nervous tension within him."
                                            }
                                        ]
                                    }
                                ]
