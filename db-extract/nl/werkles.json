                        "entry_id": "3974bd86-97fa-3292-b505-809007032b45",
                        "glosses": [
                            "activiteit op school waarbij de leerlingen zelfstandig met hun 'huiswerk' bezig zijn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a33da6e8-8be2-42ce-b62a-b19af989553c",
                                "sense_id": "7767dd00-f558-3570-b642-60249237d166",
                                "text": "“Behalve lessen van 45 minuten krijgt onze school vanaf augustus ook lessen van 60, 80, 100 en 120 minuten. Eigenlijk kun je niet eens meer spreken van dé les, want iedere les heeft een ander karakter: instructieles, werkles of zelfstudie."
                            },
                            {
                                "example_id": "986be3ce-ca6b-4a95-aedf-0bd566ea44ab",
                                "sense_id": "7767dd00-f558-3570-b642-60249237d166",
                                "text": "'Ik heb wel veel geluk op vrijdagmiddag met mijn mentor. Van hem heb ik, na een tussenuur, het zesde uur eigenlijk een werkles wiskunde. Maar als ik hem laat zien dat ik thuis al vooruit heb gewerkt, mag ik wegblijven en kan ik iets vroeger op de trein stappen naar Amstelveen.'"
                            }
                        ]
                    }
