                "senses": [
                    {
                        "sense_id": "c67400fc-8126-3d91-bf58-ec83108f5551",
                        "entry_id": "694656ec-aa5c-3732-a9f4-9b8bccd26cfb",
                        "glosses": [
                            "Reisender, der als Gepäck nur einen Rucksack mit sich führt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c2f5772-6dae-46f7-8d0b-94e93c802035",
                                "sense_id": "c67400fc-8126-3d91-bf58-ec83108f5551",
                                "text": "Die skandinavischen Länder sind bei Backpackern beliebte Reiseziele."
                            },
                            {
                                "example_id": "2b7d7962-7afb-4fcb-b25e-cc452db2b5ae",
                                "sense_id": "c67400fc-8126-3d91-bf58-ec83108f5551",
                                "text": "„Die Entscheidung fällt am Abend in feucht-fröhlicher Runde mit den Backpackern von gestern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dadcf858-2e7d-4727-b986-912d1c06dd41",
                        "source_entry_id": "694656ec-aa5c-3732-a9f4-9b8bccd26cfb",
                        "source_sense_id": "c67400fc-8126-3d91-bf58-ec83108f5551",
                        "source_sense_description": "Reisender, der als Gepäck nur einen Rucksack mit sich führt",
                        "target_lang_word": "backpacker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "backpacker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d429e570-8fc0-30c1-89a7-ba6eed929faf",
                                        "entry_id": "9f635467-3583-315a-a393-e355f18f3222",
                                        "glosses": [
                                            "A traveler whose luggage consists of a backpack; especially, such a traveler who uses hostels, public transport, and other inexpensive services."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed83ee32-1d02-4a6b-b075-09d60aeaf722",
                                                "sense_id": "d429e570-8fc0-30c1-89a7-ba6eed929faf",
                                                "text": "Among the ah bengs and ah lians, the mats and the minahs, the young expats and the backpackers, he stood out like a dozen guys on a male-only dance floor singing Dancing Queen (I'll never forgive Blur for ruining my 21st birthday)."
                                            },
                                            {
                                                "example_id": "d203cf7c-6410-46fb-bc28-6781f1fa5502",
                                                "sense_id": "d429e570-8fc0-30c1-89a7-ba6eed929faf",
                                                "text": "A decade ago, I was a backpacker entirely reliant on the railways as a means to see Britain, and with castles as my destination. Via trains alone, I was able to tick off nearly all of the castles that my English Heritage annual pass afforded me."
                                            },
                                            {
                                                "example_id": "a47687cd-0835-4c23-b85e-a43d43e56b58",
                                                "sense_id": "d429e570-8fc0-30c1-89a7-ba6eed929faf",
                                                "text": "Eight staff members of a backpacker hostel in Laos have been detained by local authorities as they investigate the deaths of six foreign tourists from suspected methanol poisoning, according to state-affiliated media in the Southeast Asian country."
                                            },
                                            {
                                                "example_id": "bcca4a90-ea4c-41b6-a4c0-80d70a19a9e6",
                                                "sense_id": "d429e570-8fc0-30c1-89a7-ba6eed929faf",
                                                "text": "Lots of pockets help with a commute, a storm hood is great if you get caught in a storm on a hike, weight and packability are essential for backpackers and if you’re a climber or biker, you’ll want a helmet-compatible hood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf58b53f-995e-389f-8c55-0a3f2b3f58b1",
                                        "entry_id": "9f635467-3583-315a-a393-e355f18f3222",
                                        "glosses": [
                                            "A hostel offering accommodation for such people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "585a009f-7fca-46ba-806a-1798f53738f6",
                                                "sense_id": "cf58b53f-995e-389f-8c55-0a3f2b3f58b1",
                                                "text": "We hardly ever stayed in backpackers as it was approximately double the cost of pitching a tent in a caravan park or nature reserve."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "605cb048-8e4d-3f26-b922-41e06c15bfed",
                                        "entry_id": "9f635467-3583-315a-a393-e355f18f3222",
                                        "glosses": [
                                            "A fan or performer of backpack rap."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66a62b14-62c6-468d-ab95-9bfea71ea23c",
                                                "sense_id": "605cb048-8e4d-3f26-b922-41e06c15bfed",
                                                "text": "Blacks and Latinos were more likely to be gangsta rappers than backpackers."
                                            },
                                            {
                                                "example_id": "326f154f-355a-46d6-b76e-fe4812b16f12",
                                                "sense_id": "605cb048-8e4d-3f26-b922-41e06c15bfed",
                                                "text": "To him the white backpackers are abject, 'safari wiggers' who threaten to undo all his careful work at 'passing' in this culture. With their earnestness and clumsy naiveté they betray the scandalous truth of his posturing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
