                        "examples": [
                            {
                                "example_id": "260b69e8-e610-4f41-a3a6-ad632c16cd61",
                                "sense_id": "0d4da02b-5019-3a69-9234-46ef64dd7bd3",
                                "text": "The purohit helps the pilgrim should he fall sick or have difficulties with officials."
                            },
                            {
                                "example_id": "5afb4e06-3a60-429f-aee2-fdb9e310c38e",
                                "sense_id": "0d4da02b-5019-3a69-9234-46ef64dd7bd3",
                                "text": "At the end of a long drawn-out ceremony, the purohit put a tilak on his forehead."
                            },
                            {
                                "example_id": "12506f0d-82a4-4a65-9bc0-109bbe0c9f4a",
                                "sense_id": "0d4da02b-5019-3a69-9234-46ef64dd7bd3",
                                "text": "The purohit then comes back to conduct the bridegroom and his followers to the bride's house accompanied by the musicians."
                            }
                        ]
                    }
