                    },
                    {
                        "translation_id": "ec3b73b2-42c6-43f9-b447-ac9874d14279",
                        "source_entry_id": "0a2d54ee-0ffe-3d41-89c1-3876025146e5",
                        "source_sense_description": "the state of being without clothing on the body",
                        "target_lang_word": "nudité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nudité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bb9e04ca-bab4-3997-81a9-e875cb6c1ebb",
                                        "entry_id": "864a902c-180c-3a6b-bbb3-3bc43afb8d6f",
                                        "glosses": [
                                            "État d’une personne qui est nue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5702bef2-ea11-4f0a-9732-1eb0351ce0db",
                                                "sense_id": "bb9e04ca-bab4-3997-81a9-e875cb6c1ebb",
                                                "text": "La nudité est un état naturel, le nu un genre artistique, le naturisme une philosophie…"
                                            },
                                            {
                                                "example_id": "afe933d5-9a90-4228-984a-ab3852c5755d",
                                                "sense_id": "bb9e04ca-bab4-3997-81a9-e875cb6c1ebb",
                                                "text": "Mais leur nudité ne choquait personne, car elles n’en eussent pas ainsi exposé tous les détails au soleil, si l’un d’eux se fût signalé par le moindre défaut qui prêtât aux railleries des femmes mariées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aba81afb-341a-3911-862b-d5c6fd79778f",
                                        "entry_id": "864a902c-180c-3a6b-bbb3-3bc43afb8d6f",
                                        "glosses": [
                                            "État de ce qui n’est pas recouvert, en parlant des choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4759312-da87-42d4-83bf-b3d15f51c5f4",
                                                "sense_id": "aba81afb-341a-3911-862b-d5c6fd79778f",
                                                "text": "[…] il ne demeura plus que la route, la britchka, les trois chevaux […], Sélifane, Tchitchikov, la vaste nudité des champs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "803fcdd4-87c6-3789-a41d-ce7b1c4ee185",
                                        "entry_id": "864a902c-180c-3a6b-bbb3-3bc43afb8d6f",
                                        "glosses": [
                                            "Figure nue."
                                        ],
                                        "tags": [
                                            "Peinture",
                                            "Surtout au pluriel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e817987d-3a70-4f22-bdf4-d6bcf4da71ff",
                                                "sense_id": "803fcdd4-87c6-3789-a41d-ce7b1c4ee185",
                                                "text": "Les bons moines de Châalis auraient voulu supprimer quelques nudités trop voyantes du \"style Médicis\"."
                                            },
                                            {
                                                "example_id": "1f0ddbb1-c998-4adf-9b4c-1a529bc30c17",
                                                "sense_id": "803fcdd4-87c6-3789-a41d-ce7b1c4ee185",
                                                "text": "[…] je lis avec effarement, à plusieurs encoignures, des affiches enluminées […]. « Engagez-vous dans l’armée coloniale! » s’écrie l’autre, toute enluminée de perroquets, toute rehaussée de nudités affriolantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9161a6db-3f95-38f5-af83-f22314af7e23",
                                        "entry_id": "864a902c-180c-3a6b-bbb3-3bc43afb8d6f",
                                        "glosses": [
                                            "Se dit en parlant d’un style sec, sans couleur, sans agrément."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7800d4ad-b052-42ce-938f-882a70aa836e",
                                                "sense_id": "9161a6db-3f95-38f5-af83-f22314af7e23",
                                                "text": "Formulé dans sa nudité, ce problème révèle son obscène banalité. Nous engendrons des vies précaires, nous créons des œuvres périssables."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15014792-2ebe-4ac6-bee8-51b6d4633493",
                        "source_entry_id": "0a2d54ee-0ffe-3d41-89c1-3876025146e5",
                        "source_sense_description": "the state of being without clothing on the body",
                        "target_lang_word": "Nacktheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nacktheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4a81edff-6dd4-358d-9e52-a010c78fff70",
                                        "entry_id": "96f870c8-95fe-30b2-a8c1-d313485aa099",
                                        "glosses": [
                                            "Zustand, in dem man unbekleidet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61356d86-9f05-4969-bda8-c92be784bd5a",
                                                "sense_id": "4a81edff-6dd4-358d-9e52-a010c78fff70",
                                                "text": "Sie schämt sich ihrer Nacktheit nicht, als sie die Tür öffnet."
                                            },
                                            {
                                                "example_id": "44a631af-1eda-4c70-a228-4ca838c6606e",
                                                "sense_id": "4a81edff-6dd4-358d-9e52-a010c78fff70",
                                                "text": "„Seine Nacktheit machte ihm nicht mehr so viel aus.“"
                                            },
                                            {
                                                "example_id": "2214092a-e4e9-4e46-a06a-e09eac287268",
                                                "sense_id": "4a81edff-6dd4-358d-9e52-a010c78fff70",
                                                "text": "„Dabei glaubte ich, in Deutschland würde die mitten in der Stadt ausgestellte Nacktheit als Erregung öffentlichen Ärgernisses gelten.“"
                                            },
                                            {
                                                "example_id": "21a50859-c8ab-454d-a71d-b7f65dc81ed7",
                                                "sense_id": "4a81edff-6dd4-358d-9e52-a010c78fff70",
                                                "text": "„Schon früher hatte ich bemerkt, dass die Nacktheit des Ostens besonders nackt war.“"
                                            },
                                            {
                                                "example_id": "3bb85eb8-f1da-4b4e-b4df-d5265e4b0c67",
                                                "sense_id": "4a81edff-6dd4-358d-9e52-a010c78fff70",
                                                "text": "„Ihre Nacktheit hypnotisiert ihn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6aea389f-19f5-33b3-84ed-4f809abe27e5",
                                        "entry_id": "96f870c8-95fe-30b2-a8c1-d313485aa099",
                                        "glosses": [
                                            "Kahlheit"
                                        ],
                                        "tags": [
                                            "bildlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d84a34e5-722c-44f8-a944-72f28baf47fa",
                                                "sense_id": "6aea389f-19f5-33b3-84ed-4f809abe27e5",
                                                "text": "Die Nacktheit der Räume in ihrem neuen Haus erschreckte Ruth."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
