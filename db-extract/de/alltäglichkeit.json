                ],
                "senses": [
                    {
                        "sense_id": "4fa9bbd0-4002-37fe-8e73-f1922f1f0c19",
                        "entry_id": "00dbe628-7846-3adf-81ce-d8c344c1d5e1",
                        "glosses": [
                            "Zustand, dass etwas jeden Tag gemacht oder erlebt wird; nichts Besonderes mehr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ed97281-f042-47a9-986a-d48fbf8ad508",
                                "sense_id": "4fa9bbd0-4002-37fe-8e73-f1922f1f0c19",
                                "text": "„Das Üben am Klavier muss zur Alltäglichkeit werden, wenn Du gut werden willst!“"
                            },
                            {
                                "example_id": "f8c42baf-8fab-4253-afc4-28e076c455ff",
                                "sense_id": "4fa9bbd0-4002-37fe-8e73-f1922f1f0c19",
                                "text": "Alltäglichkeiten wie Wasserholen, Feldarbeit oder Versteckspielen werden durch Landminen zur tödlichen Gefahr."
                            },
                            {
                                "example_id": "d868179c-aae7-412c-813b-a1d53e91a938",
                                "sense_id": "4fa9bbd0-4002-37fe-8e73-f1922f1f0c19",
                                "text": "Der Autor, der Auschwitz aus eigener Erfahrung kannte, beschreibt […] den Massenmord als Alltäglichkeit."
                            },
                            {
                                "example_id": "a7531770-934c-4262-94ce-efbbc34966a1",
                                "sense_id": "4fa9bbd0-4002-37fe-8e73-f1922f1f0c19",
                                "text": "Die Wahl von normalem DIN-A4 Papier ist bewusst, der Künstler will mit der Alltäglichkeit des Materials spielen und aus einem absolut gewöhnlichen Material fantasivolle und außergewöhnliche Arbeiten schaffen."
                            },
                            {
                                "example_id": "d1e2de8a-ef21-489d-9de7-8227a6daed9a",
                                "sense_id": "4fa9bbd0-4002-37fe-8e73-f1922f1f0c19",
                                "text": "Nur die verdrängten Alltäglichkeiten der DDR lassen sie heute in einem rosaroten Licht erscheinen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df7b9a06-e570-4953-a55f-882c9498a65d",
                        "source_entry_id": "00dbe628-7846-3adf-81ce-d8c344c1d5e1",
                        "source_sense_id": "4fa9bbd0-4002-37fe-8e73-f1922f1f0c19",
                        "source_sense_description": "Zustand, dass etwas jeden Tag gemacht oder erlebt wird; nichts Besonderes mehr",
                        "target_lang_word": "banality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "banality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "104a5c53-0a68-32f8-b692-f245ac064708",
                                        "entry_id": "6f309ed3-ed3a-3379-bd06-c387f35b59e8",
                                        "glosses": [
                                            "The quality of being banal."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76fca270-c682-4ee0-9b78-34c0a681548a",
                                                "sense_id": "104a5c53-0a68-32f8-b692-f245ac064708",
                                                "text": "The concept of the banality of evil came into prominence following the publication of Hannah Arendt's 1963 book Eichmann in Jerusalem: A Report on the Banality of Evil, which was based on the trial of Adolph Eichmann in Jerusalem."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "200ae23b-e4b6-316d-b0ea-6ddcda6b712d",
                                        "entry_id": "6f309ed3-ed3a-3379-bd06-c387f35b59e8",
                                        "glosses": [
                                            "Something which is banal."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1eb184f6-f06c-34ba-bd3c-98a1afb3c50b",
                                        "entry_id": "6f309ed3-ed3a-3379-bd06-c387f35b59e8",
                                        "glosses": [
                                            "A feudal right or obligation, especially the obligation for a peasant to grind grain at the lord's mill, or the profits accruing from such rights."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a50a350f-656f-40d9-9cd4-1f4478d69b90",
                                                "sense_id": "1eb184f6-f06c-34ba-bd3c-98a1afb3c50b",
                                                "text": "The law of banality, one of the most oppressive products of feudalism, was revived for the advantage of the nobility."
                                            },
                                            {
                                                "example_id": "b563f39b-c914-4ef8-b9ef-17ec43b56de9",
                                                "sense_id": "1eb184f6-f06c-34ba-bd3c-98a1afb3c50b",
                                                "text": "Other banalities included the lord's exclusive right to hunt over the land, his monopoly over fishing, and his right to keep the dove-cote whose feathery occupants ate a peasant's standing crops."
                                            },
                                            {
                                                "example_id": "dfc31caa-5d95-4678-acd4-8f90b7fe0821",
                                                "sense_id": "1eb184f6-f06c-34ba-bd3c-98a1afb3c50b",
                                                "text": "In fact corvées, champarts, and rights of banality not only continued but had been increased in the course of the seventeenth century."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
