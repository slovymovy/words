                {
                    "sense_id": "e15b4ef3-832f-3783-b97e-ea1790c56f5f",
                    "sense_definition": "De seizoensgebonden reis of verplaatsing van dieren of mensen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jaarlijkse <w>trek</w> van de vogels naar het zuiden is begonnen.",
                            "target_lang_translations": {
                                "en": "The annual <w>migration</w> of the birds to the south has begun.",
                                "ru": "Начался ежегодный <w>перелёт</w> птиц на юг.",
                                "de": "Der jährliche <w>Zug</w> der Vögel nach Süden hat begonnen."
                            }
                        },
                        {
                            "text": "Tijdens de grote <w>trek</w> steken duizenden gnoes de rivier over.",
                            "target_lang_translations": {
                                "en": "During the great <w>migration</w>, thousands of wildebeest cross the river.",
                                "ru": "Во время великой <w>миграции</w> тысячи гну переправляются через реку.",
                                "de": "Während der großen <w>Wanderung</w> überqueren Tausende Gnus den Fluss."
                            }
                        }
                    ],
                    "common_phrases": [
                        "de grote trek",
                        "vogeltrek"
                    ],
                    "target_lang_definitions": {
                        "en": "The seasonal journey or movement of animals or people.",
                        "ru": "Сезонное перемещение животных или людей.",
                        "de": "Die saisonale Wanderung oder Fortbewegung von Tieren oder Menschen."
