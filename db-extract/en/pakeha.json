                        "glosses": [
                            "A non-Maori, especially a European New Zealander."
                        ],
                        "tags": [
                            "New-Zealand"
                        ],
                        "examples": [
                            {
                                "example_id": "ec99fa8a-3b45-4b9b-be65-3af0e501f7f6",
                                "sense_id": "1577a1f0-76b3-3113-9a94-28adebb60f33",
                                "text": "They were the kind of Pākehā who, in the eyes of the Protestant missionaries, set a bad example to Māori."
                            },
                            {
                                "example_id": "6cbd84a7-200f-4085-a770-bcae0053c004",
                                "sense_id": "1577a1f0-76b3-3113-9a94-28adebb60f33",
                                "text": "Henry asked if missionaries were now active on the Chathams at which Mr Evans & Mr D’Arnoq exchanged looks, & the former informed us, ‘Nay, the Maori don’t take kindly to us Pakeha spoiling their Moriori with too much civilization.’"
                            }
                        ]
                    }
