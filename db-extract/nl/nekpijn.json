                            {
                                "example_id": "3d280f60-d14a-4311-9851-a08b056c408c",
                                "sense_id": "ecc924ce-4261-3396-9c76-a8819b487c9c",
                                "text": "Na het autoongeluk bleef de vrouw lang nekpijn houden."
                            },
                            {
                                "example_id": "7c45c1a8-7efb-4f85-a96e-7672fee4d2cf",
                                "sense_id": "ecc924ce-4261-3396-9c76-a8819b487c9c",
                                "text": "„Hypercompetitie. Belang van de eigen carrière. Ik heb het zelf meegemaakt. In de jaren 90 was ik wetenschappelijk directeur van onderzoeksinstituut EMGO, hier aan het VUmc. Ik onderzocht aandoeningen van het bewegingsapparaat: rugpijn, nekpijn, tennisellebogen. Op enig moment had ik 30 promovendi. Ik zorgde wel dat ze begeleiders hadden, maar dat was natuurlijk veel te veel.”"
                            }
                        ]
