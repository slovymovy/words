                "senses": [
                    {
                        "sense_id": "e6eb58d2-38a2-3343-ac39-dda1d8e9293c",
                        "entry_id": "80c03563-1d94-39cc-9800-28a89b94a910",
                        "glosses": [
                            "Stadtstaat im präkolumbischen Mesoamerika"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "320f7b15-7ecb-44ae-a36c-41df58369516",
                                "sense_id": "e6eb58d2-38a2-3343-ac39-dda1d8e9293c",
                                "text": "„Die Stadt hieß Tlacopan und sollte später ein bedeutender ORt werden; die Spanier, die den Namen nicht aussprechen konnten, nannten ihn Tacuba.“"
                            },
                            {
                                "example_id": "526ede02-f774-402f-a0d4-82c90f0a6b5d",
                                "sense_id": "e6eb58d2-38a2-3343-ac39-dda1d8e9293c",
                                "text": "„Seit dem frühen 15. Jahrhundert hatten sich die Mexica mit den Stadtstaaten Texcoco und Tlacopan zur Tripelallianz (excan tlatoloyan) vereint und begonnen, den umliegenden Herrschern Tributabgaben aufzuzwingen.“"
                            },
                            {
                                "example_id": "58663748-6d31-4489-a51b-601fa7f15395",
                                "sense_id": "e6eb58d2-38a2-3343-ac39-dda1d8e9293c",
                                "text": "„Dem daraufhin ausbrechenden Aufstand schlossen sich die Stadtstaaten Tlacopan und Texcoco an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
