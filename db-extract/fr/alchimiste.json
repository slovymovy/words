                        "translation_id": "8536c29d-2bca-45be-9eea-17c9c7a1f839",
                        "source_entry_id": "7fcaf875-3b74-3efb-b8d4-f663bbba9e5e",
                        "source_sense_id": "9bd8b8f5-5bd6-34c8-b09d-4da390eef09f",
