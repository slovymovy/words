                    }
                ],
                "senses": [
                    {
                        "sense_id": "41ba834c-bea4-397d-98e4-dc4a46c35ab8",
                        "entry_id": "bb11e9f1-509c-3849-a6d5-67bb8e414b73",
                        "glosses": [
                            "A fleshy spike (inflorescence) with reduced flowers, usually enclosed by a spathe, characteristic of aroids."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9ca0fe9-0612-4db8-84b7-f4e974cde4b6",
                                "sense_id": "41ba834c-bea4-397d-98e4-dc4a46c35ab8",
                                "text": "The spadix of this plant is frequently quite white, or coloured, and the leaves liable to be streaked with white, and to have black, or scarlet blotches on them."
                            }
                        ]
                    },
                    {
                        "sense_id": "c0531a02-05ab-3abb-8c57-a4c5d4ec1a1c",
                        "entry_id": "bb11e9f1-509c-3849-a6d5-67bb8e414b73",
                        "glosses": [
                            "A male sexual organ of certain cephalopods and hydrozoans (especially the nautilus), used to transfer sperm."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cac99cb-8387-449d-9152-4e85cbbe1d87",
                                "sense_id": "c0531a02-05ab-3abb-8c57-a4c5d4ec1a1c",
                                "text": "However, the shells of modern nautiluses show the opposite pattern—males are somewhat larger than females, with a wider aperture to accommodate the spadix."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ef10f86-efd6-432e-a0b7-fb05ac6e902b",
