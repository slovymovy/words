                ],
                "senses": [
                    {
                        "sense_id": "49326251-0134-384b-bf8c-1960bca0d1ea",
                        "entry_id": "33f453e8-2bf7-3805-8791-6e02a6f60066",
                        "glosses": [
                            "so, dass es betreten werden kann"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "19dab9b0-1292-45a2-aedf-50a7748bd941",
                                "sense_id": "49326251-0134-384b-bf8c-1960bca0d1ea",
                                "text": "„Ich zählte die Osterien nicht, die ich zurückließ. Je hungriger ich aber wurde, desto weniger schienen sie mir einladend oder auch nur betretbar. “"
                            },
                            {
                                "example_id": "c6bac548-a01e-4291-9f69-2ef478f7f5e2",
                                "sense_id": "49326251-0134-384b-bf8c-1960bca0d1ea",
                                "text": "„Die Wiesen und Felder am Fluß sind ja vor vierzehn Tagen nicht wieder betretbar, und die Herren können nicht jagen, auch wenn das Wetter wieder gut wird.“"
                            },
                            {
                                "example_id": "e8ead615-65de-423f-a63f-e47f34d39846",
                                "sense_id": "49326251-0134-384b-bf8c-1960bca0d1ea",
                                "text": "„Was du für Wiesen ansiehst, ist trügerischer Moosgrund und nicht betretbar. Wir müssen suchen die Rollestraße zu gewinnen, sagte der Konsul, der über vielem Reden die Richte verloren hatte.“"
                            },
                            {
                                "example_id": "06503e7a-1bc2-4980-97b5-c5d043fb8bb9",
                                "sense_id": "49326251-0134-384b-bf8c-1960bca0d1ea",
                                "text": "„[Diese Lehre] müsse, meinte er, ein Mysterium bleiben, enthüllt nur für eine kleine Zahl von Geweihten, ein Allerheiligstes, betretbar nur für auserwählte, zur Herrschaft über die Kirche berufene Geister.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
