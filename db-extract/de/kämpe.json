                "senses": [
                    {
                        "sense_id": "afec95ce-c614-3b07-9e46-dd461a91acdc",
                        "entry_id": "6c7c8741-64d9-3574-86b0-392acc34eefe",
                        "glosses": [
                            "an experienced fighter (or activist); a warhorse"
                        ],
                        "tags": [
                            "literary",
                            "masculine",
                            "weak"
                        ],
                        "examples": [
                            {
                                "example_id": "c596bbf6-f1f2-4d64-a32b-bbabbdcc5d83",
                                "sense_id": "afec95ce-c614-3b07-9e46-dd461a91acdc",
                                "text": "Die alten Kämpen des palästinensischen Widerstands haben nur wenig Einfluss auf die radikalisierte Jugend.",
                                "translation": "The old warhorses of the Palestinian resistance have but little influence on the radicalised youth.",
                                "english": "The old warhorses of the Palestinian resistance have but little influence on the radicalised youth."
                            },
                            {
                                "example_id": "212a0f20-b683-4562-9f1b-9e330f7d08a8",
                                "sense_id": "afec95ce-c614-3b07-9e46-dd461a91acdc",
                                "text": "Und dich nun frag' ich, Elsa von Brabant! / Willst du, daß hier auf Leben und auf Tod / im Gottesgericht ein Kämpe für dich streite?"
                            }
                        ]
                    }
                ],
