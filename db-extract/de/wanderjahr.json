                        ],
                        "examples": [
                            {
                                "example_id": "31b46a05-5a14-48cb-9424-33b8b4a7883f",
                                "sense_id": "fcf5ac6d-55e6-342e-9677-0f9cc7821ffd",
                                "text": "Der Rock ’n’ Roll ist schon in den ersten Liedern ein leeres Freiheitsversprechen. Es werden Jugendjahre, manchmal Wanderjahre beschrieben, aber nie Meisterjahre."
                            },
                            {
                                "example_id": "91d0b4a9-7b29-4cb4-b5f7-76664bfd9661",
                                "sense_id": "fcf5ac6d-55e6-342e-9677-0f9cc7821ffd",
                                "text": "[…] und vom Destillieren erzählte er, immer wieder davon, auf freiem Feld, nachts, beim Mondschein, bei Wein und Zikadengeschrei, und von einem Lavendelöl, das er dabei erzeugt habe, so fein und kräftig, daß man es ihm mit Silber aufgewogen habe; von seiner Lehrzeit in Genua, von seinen Wanderjahren und von der Stadt Grasse, in der es so viele Parfumeure gebe wie anderswo Schuster, […]"
                            }
                        ]
                    }
