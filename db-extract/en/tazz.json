                "senses": [
                    {
                        "sense_id": "9084dc96-903c-3d31-8238-32f7d161158f",
                        "entry_id": "ec9502f8-6009-3506-99cf-980c825eb598",
                        "glosses": [
                            "To move quickly; to dash; to rush."
                        ],
                        "tags": [
                            "Midlands",
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "f3334064-ed28-4d44-ad86-d89eecf3c54f",
                                "sense_id": "9084dc96-903c-3d31-8238-32f7d161158f",
                                "text": "It’s bad for him [the dog] if he’s kept tied up in that dismal place, and perhaps not properly fed. I say, how would it be if I tazzed down there and had a look at him?"
                            },
                            {
                                "example_id": "bbc2dda3-c3d3-4a28-8716-16d7b231d1c9",
                                "sense_id": "9084dc96-903c-3d31-8238-32f7d161158f",
                                "text": "I was riding this whacking big motor bike […] and I was being chased by all the girls from the Younger Generation [etc.] […] And then all of a sudden, Mary Whitehouse came tazzing up and overtook the lot of them, and she was riding a horse […]"
                            },
                            {
                                "example_id": "02f2ab16-ae42-4cea-a0d4-d49c31b3cff1",
                                "sense_id": "9084dc96-903c-3d31-8238-32f7d161158f",
                                "text": "The kooky pair were snapped at a ski resort in Khvalynsk, Russia by video director Alexander Kalinin from studio Dr Creative tazzing down the slopes in little more than bikinis."
                            },
                            {
                                "example_id": "34595067-4b01-46ff-b355-d259c287f46c",
                                "sense_id": "9084dc96-903c-3d31-8238-32f7d161158f",
                                "text": "Well, the autumn leaffall timetable has been running a fortnight and this is the first time I've had to get off for a ten- minute^([sic]) stop at Longbridge because the train tazzes through…"
                            },
                            {
                                "example_id": "77852a50-595f-480c-85a7-f1bc9b00e019",
                                "sense_id": "9084dc96-903c-3d31-8238-32f7d161158f",
                                "text": "Fireblade SP bikes and Civic Type R cars will be tazzing about the Island, letting marshals and medics get to where they need to be sharpish..."
                            }
                        ]
                    }
                ],
