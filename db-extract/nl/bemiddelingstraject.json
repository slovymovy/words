                        "examples": [
                            {
                                "example_id": "06b593e8-a853-4051-befa-20093575df30",
                                "sense_id": "173f5e8c-5a7f-3803-97a9-5592e73d4ea1",
                                "text": "Krikke's eerste beslissing die de wenkbrauwen deed fronsen, was nog een redelijk onschuldige: omdat zij graag haar hond wilde meenemen naar haar werk, werd het hondenverbod in het complete stadhuis opgeheven. Serieuzer was de verstoorde werkrelatie met haar afdeling Kabinet en Protocol, die onder meer de bezoeken van de burgemeester in de stad regelt. Die relatie was uiteindelijk zo slecht. dat er recent een bemiddelingstraject werd gestart."
                            },
                            {
                                "example_id": "993c4073-8552-4ffe-8d11-1b0ff090dff1",
                                "sense_id": "173f5e8c-5a7f-3803-97a9-5592e73d4ea1",
                                "text": "Het OM meldt dat de beslissing tot stand is gekomen na een geslaagd bemiddelingstraject. Na afloop van dat traject heeft de persoon die Gosschalk beschuldigde van een zedendelict de wens uitgesproken de zaak te laten rusten. Het OM gaat daarin mee."
                            }
                        ]
                    }
