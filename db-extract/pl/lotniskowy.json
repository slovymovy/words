                                    {
                                        "sense_id": "dd0aea66-caf3-308a-b788-b99fb633ac4d",
                                        "entry_id": "a2960af0-edca-3b97-9159-2a8896240440",
                                        "glosses": [
                                            "Relatif à un aéroport."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f99f021-696c-4163-aaf9-f1ad5a3c6155",
                                                "sense_id": "dd0aea66-caf3-308a-b788-b99fb633ac4d",
                                                "text": "Nous allons bientôt pénétrer dans la zone aéroportuaire."
                                            },
                                            {
                                                "example_id": "23c05e9d-0bf1-43ee-b409-82b58b3e4d3f",
                                                "sense_id": "dd0aea66-caf3-308a-b788-b99fb633ac4d",
                                                "text": "Quand l’appareil se pose, les passagers respirent un grand coup.\nLes formalités sont au moins deux fois plus longues qu’avant. […]. Après avoir enfin satisfait les autorités aéroportuaires, nous prenons le train pour Kyoto."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
