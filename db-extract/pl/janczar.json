                                "target_senses": [
                                    {
                                        "sense_id": "e6e2760f-b572-35e5-be81-9f0241d0935f",
                                        "entry_id": "23ddb00a-ceb1-344d-843a-ea45d62c72d5",
                                        "glosses": [
                                            "истор. солдат особых частей регулярной пехоты, комплектовавшейся из пленных юношей, а также христиан, обращенных в ислам"
                                        ],
                                        "tags": [
                                            "в султанской Турции с 1330 до 1826 г."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0a08ab3-80a7-4923-889f-a3ece9665391",
                                                "sense_id": "e6e2760f-b572-35e5-be81-9f0241d0935f",
                                                "text": "...Алибек убит и никто больше не разбойничает на дороге, кроме разве султанских янычар!"
                                            }
                                        ]
                                    }
                                ]
