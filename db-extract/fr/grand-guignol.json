                "forms": [],
                "senses": [
                    {
                        "sense_id": "1542dd08-f9c5-3361-a68e-8774838d6584",
                        "entry_id": "e402a80f-8a02-3d68-b536-27614da178e1",
                        "glosses": [
                            "Macabre tout en étant exagéré, loufoque, invraisemblable et bouffon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5fe28660-6716-429e-bcf7-953713e06f21",
                                "sense_id": "1542dd08-f9c5-3361-a68e-8774838d6584",
                                "text": "Fan d’absurde, de gore, de sang, de décadence, d’humour noir mais surtout fan de second degré, cette soirée grand-guignol est pour vous !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bb742be4-5f0e-4c85-8609-9d9f5e48455e",
                        "source_entry_id": "e402a80f-8a02-3d68-b536-27614da178e1",
                        "source_sense_id": "1542dd08-f9c5-3361-a68e-8774838d6584",
