                                "target_senses": [
                                    {
                                        "sense_id": "8462e3d8-3dfa-33be-b951-5cadef2043a4",
                                        "entry_id": "67d50750-b063-302f-85a5-4fe17d86769b",
                                        "glosses": [
                                            "Sportart, deren Ziel es ist, nur mit den Fähigkeiten des eigenen Körpers Hindernisse zu überwinden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c19b02a0-9c36-4c76-8fd1-d376c155cb9d",
                                                "sense_id": "8462e3d8-3dfa-33be-b951-5cadef2043a4",
                                                "text": "„Weder Shaw noch sein Bruder waren versiert in Parkour - der urbanen Form des Hindernislaufs -, aber sie wussten, wie man sich fallen lassen muss und wie man bei Sprüngen aus größeren Höhen sicher landet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
