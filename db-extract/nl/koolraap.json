                    },
                    {
                        "translation_id": "f6df8cfd-f830-4eec-a7f7-63220df1cc54",
                        "source_entry_id": "c529b044-f438-3cbe-896b-592317b6d7ef",
                        "source_sense_id": "669edde4-4624-3991-a7d6-59fc7bab76d2",
