                        "examples": [
                            {
                                "example_id": "74e72e90-00a6-40e7-999b-f65a36541733",
                                "sense_id": "d3627905-2546-3094-9a77-37bc718194b0",
                                "text": "„Man komplimentierte ihn in eine Art VIP-Lounge und servierte ihm ein weiteres Mal Tee und Süßes, während jemand sein Gepäck holte.“"
                            },
                            {
                                "example_id": "823ef3f0-fbea-466b-8782-dc6d9fefc513",
                                "sense_id": "d3627905-2546-3094-9a77-37bc718194b0",
                                "text": "„Wir wandern weiter, schlurfen durch die flockig fettige Haarschuppen-Wüste und nähern uns einer kleinen Gruppe verdammter Seelen. Ein Grüppchen etwa von der Größe einer Cocktailparty in der VIP-Lounge eines exquisiten Nachtclubs in Barcelona, und sie alle haben den Blick auf einen in ihrer Mitte gerichtet.“"
                            }
                        ],
