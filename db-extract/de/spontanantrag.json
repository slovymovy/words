                        "glosses": [
                            "innerhalb einer Versammlung geäußerter, nicht im Vorhinein angekündigter oder eingebrachter Antrag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc817a7d-9fa6-4376-92b9-eaedc4f55ea8",
                                "sense_id": "f036d52c-afa1-3e53-b28a-2b9fd684a320",
                                "text": "„Möglich wäre auch noch ein Spontanantrag in der Jahreshauptversammlung am kommenden Donnerstag.“"
                            },
                            {
                                "example_id": "3efcaec4-6623-457c-9679-014905bfd50a",
                                "sense_id": "f036d52c-afa1-3e53-b28a-2b9fd684a320",
                                "text": "„Daher sind Spontananträge zur Satzungsänderung in der bestehenden Generalversammlung nach hier vertretener Ansicht unzulässig.“"
                            },
                            {
                                "example_id": "da5c70cc-62ed-41ae-8ce7-1e8708ed92cc",
                                "sense_id": "f036d52c-afa1-3e53-b28a-2b9fd684a320",
                                "text": "„Der in der Hauptversammlung 2001 gestellte Spontanantrag auf Erhöhung des Mitgliedsbeitrags konnte aus Verfahrensgründen seinerzeit nicht sogleich zur Abstimmung gebracht werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
