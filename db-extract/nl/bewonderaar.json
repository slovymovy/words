                "translations": [
                    {
                        "translation_id": "e5f01330-14d8-4f2c-9c76-96e6221ddbf3",
                        "source_entry_id": "819576c8-6763-3f9e-b73a-ac7abe04fe0c",
                        "source_sense_id": "40024be7-99fd-32e2-a36a-9b389e41e1eb",
                        "source_sense_description": "een persoon die iemand bewondert",
                        "target_lang_word": "Bewunderer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bewunderer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2fd26e70-8ce1-3cdd-bfa9-29b5fad4880f",
                                        "entry_id": "62b6887b-68fc-35be-a632-665226ce22d3",
                                        "glosses": [
                                            "(männliche^☆) Person, die jemanden oder etwas sehr verehrt, wertschätzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "644bdf00-ae30-4848-bf52-13eb8f7b31ab",
                                                "sense_id": "2fd26e70-8ce1-3cdd-bfa9-29b5fad4880f",
                                                "text": "„Kann das gut gehen? Zwei Maler als Paar? Oder funktionieren Künstlerehen nur, wenn einer die Muse oder der Bewunderer ist und der andere der Kreative?“"
                                            },
                                            {
                                                "example_id": "136741e7-31f3-4f1a-bfc5-335465977946",
                                                "sense_id": "2fd26e70-8ce1-3cdd-bfa9-29b5fad4880f",
                                                "text": "„Doch darin hatte er sich getäuscht, denn Hitler war ein Bewunderer der britischen Kolonialherrschaft und dachte gar nicht daran, den Indern zu helfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
