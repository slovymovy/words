                        "examples": [
                            {
                                "example_id": "5c938ee9-8883-4a06-95fb-89b619cb1885",
                                "sense_id": "66a16fd0-8743-3fa3-be69-ba4ac427d953",
                                "text": "De CJP Cultuurkaart voor jongeren moet blijven. Dat stellen acht branche- en koepelorganisaties uit de culturele sector en de Stichting Cultureel Jongeren Paspoort (CJP) in een convenant dat ze vandaag in theater Frascati in Amsterdam ondertekenen."
                            },
                            {
                                "example_id": "b0f87446-17d3-470c-af8a-ccd946359940",
                                "sense_id": "66a16fd0-8743-3fa3-be69-ba4ac427d953",
                                "text": "Voor 7,50 euro naar een voorstelling in de schouwburg. Die mogelijkheid biedt het Hengelose Rabotheater vanaf vandaag aan houders van een cultuurkaart/cjp-pas."
                            },
                            {
                                "example_id": "5351b9ee-76dc-4af5-a5ea-fa19cd583f6b",
                                "sense_id": "66a16fd0-8743-3fa3-be69-ba4ac427d953",
                                "text": "De eenmalige bijdrage voor de Cultuurkaart van 600.000 euro waartoe de Tweede Kamer heeft besloten, gaat ten koste van een bijdrage aan het Ruslandjaar dat in 2013 wordt gevierd. Dat schrijft staatssecretaris Halbe Zijlstra dinsdag in een brief aan de Tweede Kamer."
                            }
                        ]
                    }
