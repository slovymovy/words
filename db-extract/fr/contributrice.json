                                    },
                                    {
                                        "sense_id": "849b607a-9d68-35b2-a4d7-6a483bd2a223",
                                        "entry_id": "7235d3bc-1a5a-384a-9baf-fa11707cb1c3",
                                        "glosses": [
                                            "A person (or thing) instrumental in the creation or growth of something."
