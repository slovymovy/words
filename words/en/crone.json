{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6cb4acf9-a730-3083-a9fa-e471e28137bf",
                    "sense_definition": "An ugly, evil-looking, or frightening old woman; a hag.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "old_woman",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children ran away in fear when the old <w>crone</w> glared at them from her porch.",
                            "target_lang_translations": {
                                "ru": "Дети в страхе разбежались, когда старая <w>карга</w> сердито посмотрела на них со своего крыльца."
                            }
                        },
                        {
                            "text": "In many fairy tales, a wicked <w>crone</w> offers the protagonist a poisoned apple.",
                            "target_lang_translations": {
                                "ru": "Во многих сказках злая <w>ведьма</w> предлагает главному герою отравленное яблоко."
                            }
                        }
                    ],
                    "synonyms": [
                        "hag",
                        "witch"
                    ],
                    "common_phrases": [
                        "wicked crone",
                        "old crone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уродливая, злая или пугающая пожилая женщина; карга, ведьма."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "карга",
                                "target_lang_sense_clarification": "злобная и уродливая старуха"
                            },
                            {
                                "target_lang_word": "ведьма",
                                "target_lang_sense_clarification": "злая старуха, колдунья"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "344231de-7940-33ef-b316-a30d9d9598f5",
                    "sense_definition": "An old woman.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "old_woman",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The traveler stopped to ask the ancient <w>crone</w> for directions to the nearest village.",
                            "target_lang_translations": {
                                "ru": "Путник остановился, чтобы спросить у древней <w>старухи</w> дорогу к ближайшей деревне."
                            }
                        },
                        {
                            "text": "She lived a quiet life, known to the villagers only as a harmless old <w>crone</w>.",
                            "target_lang_translations": {
                                "ru": "Она вела тихую жизнь, и деревенские жители знали её лишь как безобидную старую <w>старушку</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "old woman",
                        "granny",
                        "grandam"
                    ],
                    "common_phrases": [
                        "ancient crone"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often used in a literary or historical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пожилая женщина, старуха."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "старуха",
                                "target_lang_sense_clarification": "старая женщина"
                            },
                            {
                                "target_lang_word": "старушка",
                                "target_lang_sense_clarification": "пожилая женщина, часто с оттенком сочувствия или фамильярности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e55274b0-f3dc-3de8-a488-615598d0c2e5",
                    "sense_definition": "An archetypal figure, a wise woman.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "archetype",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In mythology, the <w>crone</w> represents wisdom, experience, and the final stage of life.",
                            "target_lang_translations": {
                                "ru": "В мифологии <w>Старуха</w> олицетворяет мудрость, опыт и завершающий этап жизни."
                            }
                        },
                        {
                            "text": "The hero sought the counsel of the wise <w>crone</w> who lived deep within the forest.",
                            "target_lang_translations": {
                                "ru": "Герой искал совета мудрой <w>старицы</w>, жившей глубоко в лесу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wise crone"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used in mythological or spiritual contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Архетипический персонаж, мудрая старуха."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Старуха",
                                "target_lang_sense_clarification": "архетип мудрой пожилой женщины в мифологии"
                            },
                            {
                                "target_lang_word": "мудрая старуха",
                                "target_lang_sense_clarification": "архетипический образ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63c48477-5141-3552-bb18-9dfe079b7b86",
                    "sense_definition": "One of the triune goddesses of the Lady in Wicca alongside the Mother and Maiden, representing an old woman.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wicca",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "During the ritual, they invoked the Maiden, the Mother, and the <w>Crone</w>.",
                            "target_lang_translations": {
                                "ru": "Во время ритуала они призывали Деву, Мать и <w>Старуху</w>."
                            }
                        },
                        {
                            "text": "The <w>Crone</w> aspect of the goddess is associated with the waning moon and winter.",
                            "target_lang_translations": {
                                "ru": "Аспект <w>Старухи</w> у богини ассоциируется с убывающей луной и зимой."
                            }
                        }
                    ],
                    "antonyms": [
                        "Sage"
                    ],
                    "common_phrases": [
                        "maiden mother and crone"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Specific to Wiccan and pagan terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Один из трех аспектов триединой богини в викканстве (наряду с Девой и Матерью), олицетворяющий старуху."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Старуха",
                                "target_lang_sense_clarification": "аспект триединой богини в викканстве"
                            },
                            {
                                "target_lang_word": "Крона",
                                "target_lang_sense_clarification": "транслитерация термина в язычестве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b04d73f9-915e-33d7-90d9-e492c4c49190",
                    "sense_definition": "An old ewe.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer decided to sell the <w>crones</w> from his flock before the winter started.",
                            "target_lang_translations": {
                                "ru": "Фермер решил продать <w>старых овец</w> из своего стада до начала зимы."
                            }
                        },
                        {
                            "text": "He managed to buy forty good <w>crones</w> at the livestock market.",
                            "target_lang_translations": {
                                "ru": "Ему удалось купить сорок хороших <w>старых овец</w> на скотном рынке."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Mainly agricultural or dialectal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Старая овца."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "старая овца",
                                "target_lang_sense_clarification": "выбракованная по возрасту овца"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1ab6644-ba3c-3dbc-9ceb-8967c68b5d45",
                    "sense_definition": "An old man, especially one who talks and acts like an old woman.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "old_man",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old <w>crone</w> spent his days gossiping with neighbors over the fence.",
                            "target_lang_translations": {
                                "ru": "Этот старый <w>брюзга</w> целыми днями сплетничал с соседями через забор."
                            }
                        },
                        {
                            "text": "He was described as a battered <w>crone</w> of office, clinging to his old habits.",
                            "target_lang_translations": {
                                "ru": "Его описывали как потрепанного жизнью старого <w>чинушу</w>, цепляющегося за свои старые привычки."
                            }
                        }
                    ],
                    "synonyms": [
                        "geezer"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Старик, особенно ведущий себя или болтающий как старуха."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "старый брюзга",
                                "target_lang_sense_clarification": "ворчливый старик"
                            },
                            {
                                "target_lang_word": "баба",
                                "target_lang_sense_clarification": "о мужчине, ведущем себя по-женски"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}