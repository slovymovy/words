                "senses": [
                    {
                        "sense_id": "b0f783f1-eb07-38c2-a8db-3d1f796accc9",
                        "entry_id": "0e1793ab-63df-3a80-bbc2-b9b4c38c04ba",
                        "glosses": [
                            "iemand die teveel ruzie zoekt of maakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6192f59-9c0c-44e8-9260-3603d03bba09",
                                "sense_id": "b0f783f1-eb07-38c2-a8db-3d1f796accc9",
                                "text": "Wat is er meer voor de hand liggend dan eerst het overleg met VVD en PVV – de laatste komt niet eens in de regering – af te wachten en dan pas te oordelen, aanvaarden of verwerpen? Begrijpen deze kibbelaars niet dat ze het alleen maar erger maken? Beschamend."
                            },
                            {
                                "example_id": "43b65c29-5072-40ac-bcd3-a902346f64fe",
                                "sense_id": "b0f783f1-eb07-38c2-a8db-3d1f796accc9",
                                "text": "Waarom hoor je kibbelaars dan voornamelijk de argumenten van de tegenpartij de grond in boren, in plaats van de eigen standpunten zo aantrekkelijk mogelijk te maken?"
                            }
                        ]
                    }
                ],
                "translations": [
