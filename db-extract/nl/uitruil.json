                                            },
                                            {
                                                "example_id": "df85727f-bc5f-4353-8be1-f781324da742",
                                                "sense_id": "e8b51ca9-4e9e-3fae-92b2-f55557a531ac",
                                                "text": "I'll help you out this time, depending on what can you give me in exchange."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e9272ed-3a7e-348d-84e7-1b92d8d8d0a5",
