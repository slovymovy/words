                            {
                                "example_id": "a5c8a05c-8b18-4f4d-bd8c-21a5614f6844",
                                "sense_id": "1fdd4978-46df-31d0-8051-25ed221ff226",
                                "text": "De bibliografie van zijn omvangrijk oeuvre die onlangs in het 85ste deel van het Muséon is verschenen, legt een welsprekend getuigenis af van een vruchtbaar leven, gewijd aan de studie van de Bijbel, het Accadisch en bovenal aan de semitische epigrafie."
                            }
                        ]
                    }
