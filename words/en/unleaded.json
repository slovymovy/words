                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fuel_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gas station offers regular <w>unleaded</w> as well as premium options.",
                            "target_lang_translations": {
                                "ru": "На заправке предлагают как обычный <w>неэтилированный бензин</w>, так и варианты премиум-класса."
                            }
                        },
                        {
                            "text": "Many older vehicles cannot run efficiently on modern <w>unleadeds</w> without additives.",
                            "target_lang_translations": {
                                "ru": "Многие старые автомобили не могут эффективно работать на современном <w>неэтилированном топливе</w> без присадок."
                            }
                        }
                    ],
                    "common_phrases": [
                        "regular unleaded"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неэтилированный бензин."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неэтилированный бензин",
                                "target_lang_sense_clarification": "топливо"
                            },
                            {
                                "target_lang_word": "неэтилированное топливо",
                                "target_lang_sense_clarification": "топливо"
                            }
                        ]
                    }
                },
                {
