                    {
                        "translation_id": "624dd40c-5f31-4449-b664-c398841af102",
                        "source_entry_id": "7e18a65b-1bce-3513-a588-101a5ace2932",
                        "source_sense_id": "df62276c-ac0e-3df5-9e9d-d074574410d1",
                        "target_lang_word": "ewangelik",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ewangelik",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "0348d133-a440-3f47-add5-32b019b2e8c8",
                                        "entry_id": "b9ebee38-164f-3fb3-bb4a-4e9a75492cc8",
                                        "glosses": [
                                            "wyznawca ewangelicyzmu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "321e7e6a-e6fa-4b78-8ca8-eb6118733214",
                                                "sense_id": "0348d133-a440-3f47-add5-32b019b2e8c8",
                                                "text": "Dopiero pokój westfalski dał szansę ewangelikom na posiadanie własnych świątyń"
                                            },
                                            {
                                                "example_id": "a307938d-95db-46c5-aa81-25a03bc094db",
                                                "sense_id": "0348d133-a440-3f47-add5-32b019b2e8c8",
                                                "text": "Wierni Kościołów ewangelickich, zwani ewangelikami, wyznają tzw. pięć zasad protestantyzmu sformułowanych w XVI wieku podczas reformacji"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf80d789-5c89-4b5b-91c9-02d8a2f1c6b1",
                        "source_entry_id": "7e18a65b-1bce-3513-a588-101a5ace2932",
                        "source_sense_id": "df62276c-ac0e-3df5-9e9d-d074574410d1",
                        "target_lang_word": "évangélique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "évangélique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a14300f7-1319-343a-9364-30e8d43fc1c1",
                                        "entry_id": "3e169a8a-56c5-3823-8792-9c9581e3874a",
                                        "glosses": [
                                            "Qui est de l’évangile ; qui est selon l’évangile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49c174ec-c3eb-41c0-a4fe-b71f4aac530c",
                                                "sense_id": "a14300f7-1319-343a-9364-30e8d43fc1c1",
                                                "text": "À bon entendeur, salut ! n’est pas seulement un précepte évangélique, c’est encore une excellente spéculation ; observez-le, on vous passera tout, jusqu’à des vices."
                                            },
                                            {
                                                "example_id": "161243d2-6dd1-49f3-8684-b87b18dbb9c1",
                                                "sense_id": "a14300f7-1319-343a-9364-30e8d43fc1c1",
                                                "text": "Je leur souhaite, comme vœu du Jour de l’An, de mener à bien leur entreprise et de ramener sur la terre l’âge évangélique."
                                            },
                                            {
                                                "example_id": "1fa95a06-4c72-4804-be1a-aac41b891ce7",
                                                "sense_id": "a14300f7-1319-343a-9364-30e8d43fc1c1",
                                                "text": "Cette bienveillance, qui peut même parfois être vue telle une braise ardente venue du fond de ton être, est la mise en oeuvre de ce grand principe évangélique et si radicalement humain : « Aime ton prochain comme toi-même. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65085a24-d12e-3fcc-87e9-86571231d80c",
                                        "entry_id": "3e169a8a-56c5-3823-8792-9c9581e3874a",
                                        "glosses": [
                                            "Qui est adepte de l'évangélisme, branche du protestantisme."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1853a7f-bb4d-4b47-bcca-05826623d184",
                                                "sense_id": "65085a24-d12e-3fcc-87e9-86571231d80c",
                                                "text": "Les protestants évangéliques revendiquent le droit de dire leur foi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1894d97b-3931-3df5-af5f-606bac4bbf0a",
                                        "entry_id": "3e169a8a-56c5-3823-8792-9c9581e3874a",
                                        "glosses": [
                                            "Qui est adepte du protestantisme."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bf23559-b035-4ba2-8b7c-9dbd27a9627f",
                                                "sense_id": "1894d97b-3931-3df5-af5f-606bac4bbf0a",
                                                "text": "Qu'un catholique romain qui n'a jamais vu que le clocher de son village, qui n'a lu que son catéchisme et son livre d’heures, reproche aux chrétiens évangéliques leur défaut d'unité, à la bonne heure ! […]."
                                            },
                                            {
                                                "example_id": "8429539f-2720-426c-b37a-ebc0f5ab419d",
                                                "sense_id": "1894d97b-3931-3df5-af5f-606bac4bbf0a",
                                                "text": "Vous savez que j'appartiens à la communion évangélique, de même que ma fiancée ; or, notre ministre, qui demeure à une trentaine de lieues, est perclus de la goutte, et j'ai osé espérer que vous voudriez bien officier à sa place."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "évangélique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3fec94b1-1b05-3255-bb04-adad95988c35",
                                        "entry_id": "c3c160c6-34a4-338d-a708-331695815801",
                                        "glosses": [
                                            "Membre d'une église évangélique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b34dc58b-83a8-4f21-90c7-1ec60d21d944",
                                                "sense_id": "3fec94b1-1b05-3255-bb04-adad95988c35",
                                                "text": "Les évangéliques et les catholiques, tout en étant différents, se retrouvent sur de nombreux points, comme les questions d'éthique. La principale différence est l'autorité de la Bible, les évangéliques ont un rapport très personnel aux écritures, ils s'y réfèrent, ils la lisent régulièrement, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "595e2d5e-8143-3c85-931f-01b3bbe4e7ff",
                                        "entry_id": "c3c160c6-34a4-338d-a708-331695815801",
                                        "glosses": [
                                            "Membre d'une Église protestante."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "985607dd-3d2b-4c7b-bf5f-cc3cebe2d8b5",
                        "source_entry_id": "7e18a65b-1bce-3513-a588-101a5ace2932",
                        "source_sense_id": "df62276c-ac0e-3df5-9e9d-d074574410d1",
                        "target_lang_word": "évangéliste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "évangéliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee4b5a7e-b453-329f-bb4c-6c23512a1a29",
                                        "entry_id": "8db4511b-b340-37f8-aaa1-a07aacbe12bb",
                                        "glosses": [
                                            "Auteur de l’un des quatre évangiles, dans la religion chrétienne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3aae0172-d074-4188-a4e3-7fd66fd0c075",
                                                "sense_id": "ee4b5a7e-b453-329f-bb4c-6c23512a1a29",
                                                "text": "Les quatre évangélistes sont saint Matthieu, saint Marc, saint Luc et saint Jean."
                                            },
                                            {
                                                "example_id": "eb46015f-d747-474d-a711-21a54ba80fd9",
                                                "sense_id": "ee4b5a7e-b453-329f-bb4c-6c23512a1a29",
                                                "text": "Les évangélistes nous décrivent tous une seule voie pour arriver au salut, celle de la repentance, de l’humiliation, de la connaissance vivante des péchés, la voie de la foi en la personne de Jésus-Christ comme Fils du Dieu vivant."
                                            },
                                            {
                                                "example_id": "b6ab3851-9598-4e79-a4a6-3e6f2395dee6",
                                                "sense_id": "ee4b5a7e-b453-329f-bb4c-6c23512a1a29",
                                                "text": "Cet ouvrage a le rôle de former une image d’ensemble sur Christ, en englobant des détails fournis par les quatre évangélistes sur la naissance, la vie, l’activité, la mort et la résurrection de Jésus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "809a4621-cbea-3e2c-8f77-76383df39504",
                                        "entry_id": "8db4511b-b340-37f8-aaa1-a07aacbe12bb",
                                        "glosses": [
                                            "Personne qui pratique l’évangélisation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1dded08-e73d-41bf-bd28-b18e12757144",
                                                "sense_id": "809a4621-cbea-3e2c-8f77-76383df39504",
                                                "text": "Mais à cause des évangélistes radicaux, l'influence du christianisme était maintenant perçue par les ultranationalistes hindous comme une ingérence étrangère et une menace pour la nature hindoue de leur pays."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "évangéliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a17a3fbb-9b5e-3f0c-a1a5-8ab8b5e492b6",
                                        "entry_id": "1bbfd8ae-7dd4-3766-af9f-db26520d3f92",
                                        "glosses": [
                                            "Relatif à l’évangélisation ; qui permet, préconise ou a pour but l’évangélisation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1076b120-c80d-40f5-b129-2168ffd2c3e7",
                                                "sense_id": "a17a3fbb-9b5e-3f0c-a1a5-8ab8b5e492b6",
                                                "text": "Une action évangéliste, une Église évangéliste."
                                            }
                                        ]
                                    }
                                ]
                            }
