                    {
                        "translation_id": "26c76487-4338-4c52-8ff1-7e03af671e1e",
                        "source_entry_id": "b5735739-9f81-3875-8d21-f8b3041acad0",
                        "target_lang_word": "heartless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heartless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7efb5cdf-f432-37c5-af4c-bd6839442296",
                                        "entry_id": "4e9e7f36-4cce-3791-a382-b62328c01af0",
                                        "glosses": [
                                            "Without feeling, emotion, or concern for others; uncaring; cruel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04470f3c-416e-47bb-9f47-fc67a76c8956",
                                                "sense_id": "7efb5cdf-f432-37c5-af4c-bd6839442296",
                                                "text": "His heartless actions and cold manner left her saddened and feeling alone."
                                            },
                                            {
                                                "example_id": "c9474884-b764-4116-9122-1762d8a83e97",
                                                "sense_id": "7efb5cdf-f432-37c5-af4c-bd6839442296",
                                                "text": "The world is a dangerous, violent place […] and the only true refuge from this heartless world is the family."
                                            },
                                            {
                                                "example_id": "e2d6331d-9c7d-478a-b21f-796eeca4ffbb",
                                                "sense_id": "7efb5cdf-f432-37c5-af4c-bd6839442296",
                                                "text": "It's safer to be heartless than mindless. The history of the world is the history of the triumph of the heartless over the mindless."
                                            },
                                            {
                                                "example_id": "7df848d9-85ca-4b57-99f8-998f487af970",
                                                "sense_id": "7efb5cdf-f432-37c5-af4c-bd6839442296",
                                                "text": "Mr. Burns is similarly perfectly cast as a heartless capitalist willing to do anything for a quick buck, even if it means endangering the lives of those around him and Marge elegantly rounds out the main cast as a good, pure-hearted and overly indulgent woman who sees the big, good heart (literally and metaphorically) of a monstrous man-brute."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c6d48e3-f62c-3d6c-9ffc-ca14ac20aabd",
                                        "entry_id": "4e9e7f36-4cce-3791-a382-b62328c01af0",
                                        "glosses": [
                                            "Without a physical heart."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a48b5566-1834-3ab8-a951-c1bf57455921",
                                        "entry_id": "4e9e7f36-4cce-3791-a382-b62328c01af0",
                                        "glosses": [
                                            "Listless, unenthusiastic."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "014e7ada-b24f-4251-9545-0300018964fa",
                                                "sense_id": "a48b5566-1834-3ab8-a951-c1bf57455921",
                                                "text": "Near-synonyms: spiritless, unhearty"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36ff8ba9-9164-37c5-b120-41e88a25d002",
                                        "entry_id": "4e9e7f36-4cce-3791-a382-b62328c01af0",
                                        "glosses": [
                                            "Without courage; fearful, cowardly."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cccba9a-8f1f-449e-a0a7-2886124832e6",
                                                "sense_id": "36ff8ba9-9164-37c5-b120-41e88a25d002",
                                                "text": "Cecilia then, though almost heartless, resolved upon talking with Mr. Harrel himself […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f336d0f7-939a-4819-aa95-dc4c9ceda24f",
                        "source_entry_id": "b5735739-9f81-3875-8d21-f8b3041acad0",
                        "target_lang_word": "callous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "callous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c85ed0c-ee4a-30f9-81e8-a92734e90d3e",
                                        "entry_id": "874bedc2-7956-34ec-80ae-a8ba31ce4a72",
                                        "glosses": [
                                            "Emotionally hardened; unfeeling and indifferent to the suffering/feelings of others."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa257671-1c08-49b6-b96a-87e970da1d91",
                                                "sense_id": "1c85ed0c-ee4a-30f9-81e8-a92734e90d3e",
                                                "text": "She was so callous that she could criticise a cancer patient for wearing a wig."
                                            },
                                            {
                                                "example_id": "69e5bc1e-6828-4bfe-9c5c-bdb35e86facf",
                                                "sense_id": "1c85ed0c-ee4a-30f9-81e8-a92734e90d3e",
                                                "text": "Re-watching some of the audition rounds of these shows now, you're struck by how callous the judges' comments often were, and how they presented a cruel spectacle in which the audience were set up to laugh at the \"deluded\" members of the public who believed they could sing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c868ff7-7f06-38dc-adbd-dda8557c5027",
                                        "entry_id": "874bedc2-7956-34ec-80ae-a8ba31ce4a72",
                                        "glosses": [
                                            "Having calluses, or relating to calluses."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "callous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0643622e-f2a8-36eb-8897-3e12709604b6",
                                        "entry_id": "a23b5093-4c90-3e8e-8931-5a5eb2ebb5c1",
                                        "glosses": [
                                            "Alternative form of callus."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df1a610f-7392-4ef7-b900-7abfa5b0b61d",
                                                "sense_id": "0643622e-f2a8-36eb-8897-3e12709604b6",
                                                "text": "Hanson was beginning to feel annoyance at the suddenly cocksure and unsympathetic girl, but he stood fully erect and flexed his muscles. There wasn't even a trace of bedsoreness, though he had been flat on his back long enough to grow callouses."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "callous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5aae06ee-097b-3d50-a6e1-db362aabadf0",
                                        "entry_id": "95777277-6006-3978-a58a-adfafa98a5e5",
