            {
                "entry_id": "c8b39452-4aa9-3673-82e2-c28382b88900",
                "word": "perp",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5a722ccb-062b-48b8-963d-f0b83c8cb713",
                        "entry_id": "c8b39452-4aa9-3673-82e2-c28382b88900",
                        "tags": [
                            "plural"
                        ],
                        "form": "perps"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "536f5bd5-27d9-327c-a091-835c267ad97b",
                        "entry_id": "c8b39452-4aa9-3673-82e2-c28382b88900",
                        "glosses": [
                            "A perpetrator."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "5f014468-86d6-408d-af8d-eb68104a9047",
                                "sense_id": "536f5bd5-27d9-327c-a091-835c267ad97b",
                                "text": "\"We have the perp in custody,\" the policeman said."
                            },
                            {
                                "example_id": "5fe3098e-834d-4629-a4eb-c1e4221945cb",
                                "sense_id": "536f5bd5-27d9-327c-a091-835c267ad97b",
                                "text": "Got himself fired for pulling a sword on an acknowledged perp. Slid it right through the fabric of the perp’s shirt, gliding the flat of the blade along the base of his neck, and pinned him to a warped and bubbled expanse of vinyl siding on the wall of the house that the perp was trying to break into."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f78e12e2-3b1b-477d-8644-47336d1df6bd",
                        "source_entry_id": "c8b39452-4aa9-3673-82e2-c28382b88900",
                        "source_sense_id": "536f5bd5-27d9-327c-a091-835c267ad97b",
                        "source_sense_description": "perpetrator",
                        "target_lang_word": "Täter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Täter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85e8de39-7d4e-36ae-8cae-a7f3c924cc1e",
                                        "entry_id": "a96ec9ae-2bc6-32df-b83e-94bed09890aa",
                                        "glosses": [
                                            "jemand, der etwas getan hat, womit fast immer eine verwerfliche Tat gemeint ist; häufig im juristischen Zusammenhang gebraucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8388af51-fdb5-43ce-8678-0487467e0cf4",
                                                "sense_id": "85e8de39-7d4e-36ae-8cae-a7f3c924cc1e",
                                                "text": "Lehrerin: „Hier hat jemand ein sehr hässliches Bild von Carola an die Tafel gemalt. Wer war der Täter?“"
                                            },
                                            {
                                                "example_id": "68ade528-29da-4ac5-ae35-48458733dce4",
                                                "sense_id": "85e8de39-7d4e-36ae-8cae-a7f3c924cc1e",
                                                "text": "„Mancher Kriminalfall hat nur deshalb Berühmtheit erlangt, weil der Täter durch eine neuartige medizinische oder naturwissenschaftliche Methode überführt werden konnte.“"
                                            },
                                            {
                                                "example_id": "8c9ec2a6-5de8-470f-b1c5-4aff92ed3cfb",
                                                "sense_id": "85e8de39-7d4e-36ae-8cae-a7f3c924cc1e",
                                                "text": "„So führen sie die Tradition der Blutrache fort und legen fest, dass die Familie eines Ermordeten den Täter töten darf.“"
                                            },
                                            {
                                                "example_id": "6d3c9e80-b349-4501-a04c-df9d5cfb4ef1",
                                                "sense_id": "85e8de39-7d4e-36ae-8cae-a7f3c924cc1e",
                                                "text": "Zu den bizarren Pointen der furchtbaren Terrorserie in Frankreich zählt aber auch die Tatsache, dass Muslime nicht nur Täter und Opfer, sondern auch Helden geworden sind. Am Mittwoch war es der Polizist Ahmed Merabet, ein 42-jähriger muslimischer Familienvater, den die terroristischen Kouachi-Brüder brutal ermordeten."
                                            },
                                            {
                                                "example_id": "92bd71e6-232a-4894-aa0e-81fc5f4bc2bf",
                                                "sense_id": "85e8de39-7d4e-36ae-8cae-a7f3c924cc1e",
                                                "text": "Nach über 30 Jahren tauchten nun neue Beweise gegen den Täter auf, doch weil sein Freispruch rechtskräftig ist, ist es fast unmöglich, wieder gegen ihn zu ermitteln."
                                            },
                                            {
                                                "example_id": "950ce7c7-3964-482c-a638-d30a35c980fc",
                                                "sense_id": "85e8de39-7d4e-36ae-8cae-a7f3c924cc1e",
                                                "text": "Dieses Jubliäum könne nur deshalb gefeiert werden, weil das Land der Opfer [Israel] dem der Täter [Deutschland] die Hand gereicht habe. \"Für uns Deutsche wie ein Wunder\", betonte der Außenminister."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae32251b-c34e-47d0-958e-2dc3c7378788",
                        "source_entry_id": "c8b39452-4aa9-3673-82e2-c28382b88900",
                        "source_sense_id": "536f5bd5-27d9-327c-a091-835c267ad97b",
                        "source_sense_description": "perpetrator",
                        "target_lang_word": "Täterin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Täterin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "490aeb6c-b935-354f-9bea-05079442e36b",
                                        "entry_id": "5faa8214-523a-3560-94d8-bdcfaa235070",
                                        "glosses": [
                                            "weibliche Person, die sich etwas zuschulden kommen lassen hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "336b0a9f-46ee-4352-8647-f4609bfc0270",
                                                "sense_id": "490aeb6c-b935-354f-9bea-05079442e36b",
                                                "text": "„Die Namen der Täterinnen kenne ich noch heute.“"
                                            },
                                            {
                                                "example_id": "62902dfb-bd8c-4203-8dfc-b75935e54223",
                                                "sense_id": "490aeb6c-b935-354f-9bea-05079442e36b",
                                                "text": "„Bei einer Messerattacke in Hamburg sind am Freitagabend mehrere Menschen schwer verletzt worden. Die Polizei gab später erste Informationen zur mutmaßlichen Täterin bekannt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7d2f983-56b3-4e0b-8edd-21f170acfe81",
                        "source_entry_id": "c8b39452-4aa9-3673-82e2-c28382b88900",
                        "source_sense_id": "536f5bd5-27d9-327c-a091-835c267ad97b",
