                    {
                        "translation_id": "3e2e7aa6-edc9-4d93-babb-11c8f4b6b9c1",
                        "source_entry_id": "0e3ea08c-de12-3e3f-98e4-1c50a8de9eaf",
                        "source_sense_id": "61ca0131-1c96-3a9a-b90c-a0a8a4b13cf6",
                        "source_sense_description": "property of being superficial",
                        "target_lang_word": "пове́рхностность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пове́рхностность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bb7f556d-1d57-3fee-a3a9-ef5f22804268",
                                        "entry_id": "01a94594-534c-3c95-8c93-301ab5d51865",
                                        "glosses": [
                                            "свойство по значению прилагательного поверхностный; отсутствие глубины, значимости, основательности, важности"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85d5e1b7-2879-4ed9-833b-e06ab39d0e13",
                                                "sense_id": "bb7f556d-1d57-3fee-a3a9-ef5f22804268",
                                                "text": "Но, строго разбирая умственную деятельность этих лиц, мы невольно поражаемся её крайней поверхностностью."
                                            },
                                            {
                                                "example_id": "03a809b3-ef3d-41d2-9e9b-85e4b0a0383b",
                                                "sense_id": "bb7f556d-1d57-3fee-a3a9-ef5f22804268",
                                                "text": "Семья не предохраняет от этой развратности сексуального акта, от этой поверхностности, внешности касания одного существа к другому, от этого бессилия внутреннего проникновения одного существа в другое, бессилия слить все клетки мужа и жены."
                                            },
                                            {
                                                "example_id": "3bc03359-daba-446e-aad6-e39e8c071365",
                                                "sense_id": "bb7f556d-1d57-3fee-a3a9-ef5f22804268",
                                                "text": "Мышление носит печать поверхностности, легкомыслия и, ввиду того что не подчиняется одному какому-нибудь плану, совершенно хаотично, не оказывается в той мере продуктивным, как бы следовало ожидать, имея в виду полную сохранность формальных способностей интеллекта и большую активность больного."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
