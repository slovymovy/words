                "senses": [
                    {
                        "sense_id": "b8a54670-27ed-387c-a4f6-9928c6f801ab",
                        "entry_id": "46ae5650-8327-3fdd-a664-8576c7f29d3d",
                        "glosses": [
                            "Libérer les voiles qui avaient été carguées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dce88d3-22bc-4395-864b-6bfcc5c8da64",
                                "sense_id": "b8a54670-27ed-387c-a4f6-9928c6f801ab",
                                "text": "Et, d'ailleurs, le meunier, alors qu'il serait venu décarguer ses toiles et manœuvrer le levier extérieur, eût aperçu cet homme achevalé au croisement des ailes."
                            },
                            {
                                "example_id": "f8c374ad-eaf0-4182-b213-edcd1cc11f5d",
                                "sense_id": "b8a54670-27ed-387c-a4f6-9928c6f801ab",
                                "text": "En Bretagne, on pense : «...il est temps de décarguer les voiles car on se prépare déjà au voyage !»."
                            }
                        ]
                    }
