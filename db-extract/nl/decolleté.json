                    {
                        "translation_id": "84da4239-b640-4bcb-b752-1f405e7d530f",
                        "source_entry_id": "af2c5061-2e96-39c2-af24-77cd031f8084",
                        "source_sense_id": "eb80875b-754e-323d-9b61-e94b1eb6285e",
                        "source_sense_description": "laag uitgesneden halslijn bij vrouwenkleding",
                        "target_lang_word": "Dekolleté",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dekolleté",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b3e56b1b-b1bc-3775-a3e3-1486ea1b3104",
                                        "entry_id": "21aea343-b511-35e2-8185-4fb6a59a9b08",
                                        "glosses": [
                                            "Halsausschnitt von Blusen, Kleidern et cetera bei der Damenoberbekleidung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2952e26-4281-4088-b2ef-75786380ebdd",
                                                "sense_id": "b3e56b1b-b1bc-3775-a3e3-1486ea1b3104",
                                                "text": "„Die Sonne scheint senkrecht durch das Schiebedach, legt sich auf ihre Schultern und kitzelt ihr Dekolleté.“"
                                            },
                                            {
                                                "example_id": "e1c0a3b7-7277-461a-918a-6db538b93e22",
                                                "sense_id": "b3e56b1b-b1bc-3775-a3e3-1486ea1b3104",
                                                "text": "„Man sieht sofort auf ihr Dekolleté.“"
                                            },
                                            {
                                                "example_id": "590a6f5f-36d7-4aed-bb06-5b5258900b61",
                                                "sense_id": "b3e56b1b-b1bc-3775-a3e3-1486ea1b3104",
                                                "text": "„Wir können gar nicht anders, als auf ihr tiefausgeschnittenes Dekolleté und ihre nach oben und zur Mitte geschobene Brust zu sehen.“"
                                            },
                                            {
                                                "example_id": "2b13f13c-aa6f-486c-be9c-8de97a566c36",
                                                "sense_id": "b3e56b1b-b1bc-3775-a3e3-1486ea1b3104",
                                                "text": "„Sie stellte das Tablett ab, beugte sich zu Grenfeld herunter und gewährte ihm einen unerwarteten Blick in ihr Dekolleté.“"
                                            },
                                            {
                                                "example_id": "a1f6a612-802f-45e1-b53e-3a26ffb45a74",
                                                "sense_id": "b3e56b1b-b1bc-3775-a3e3-1486ea1b3104",
                                                "text": "„Als er seinen Blick auf ihr Dekolleté richtete, zog sie ihr Cape enger um die Schultern und rückte etwas von ihm weg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f27a2dd2-b435-4637-b7f6-c77422996304",
                        "source_entry_id": "af2c5061-2e96-39c2-af24-77cd031f8084",
                        "source_sense_id": "eb80875b-754e-323d-9b61-e94b1eb6285e",
                        "source_sense_description": "laag uitgesneden halslijn bij vrouwenkleding",
                        "target_lang_word": "cleavage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cleavage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d688c85a-f70e-324b-9a90-5f4476398a35",
                                        "entry_id": "255dfb5f-c0a3-36c4-9fd3-64894bfa66f9",
                                        "glosses": [
                                            "The act of cleaving or the state of being cleft."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de1e64b0-ab49-408a-b9a1-b6187137ebf6",
                                                "sense_id": "d688c85a-f70e-324b-9a90-5f4476398a35",
                                                "text": "Mineral cleavage is a property of cohesion. The cleavage of the particles themselves and its attitude with reference to the plane of the greatest and mean dimensional axes help to determine the perfection of rock cleavage. The more nearly parallel to the greater dimensions of the particle, and the better the mineral cleavage, the better the rock cleavage produced."
                                            },
                                            {
                                                "example_id": "6463822b-24d6-47e1-8d16-249410bd6aaa",
                                                "sense_id": "d688c85a-f70e-324b-9a90-5f4476398a35",
                                                "text": "[…] the forces — the internal cleavages over class differences, the desire for \"the good life,\" the white racist flight from the die schwartze — which shattered Jewish working-class community in the generation before mine."
                                            },
                                            {
                                                "example_id": "fe699df0-fe20-422d-b07b-cc73b0ed0319",
                                                "sense_id": "d688c85a-f70e-324b-9a90-5f4476398a35",
                                                "text": "It will become apparent from the following discussion that some of the various structures which are grouped together as cleavage may correspond to a schistosity and/or foliation. Accordingly, Wilson defines rock cleavage (and schistosity) as a planar structure, usually distinct from stratification, which permits rocks to be fractured or cleaved into thin slices. Dennis (1977) defines cleavage as a set of closely spaced secondary, planar, parallel fabric elements that impart mechanical anisotropy to a rock without apparent loss of cohesion. This latter definition appears more precise; however, as we shall see, it presents many difficulties in dealing with those forms of cleavage which are mainly defined by foliation or by fractures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab2038bb-a718-35c7-b6e3-caa5ccbd8044",
                                        "entry_id": "255dfb5f-c0a3-36c4-9fd3-64894bfa66f9",
                                        "glosses": [
                                            "The hollow or separation between a woman's breasts, especially as revealed by a low neckline."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5cf8117d-3c36-4a56-8e70-a62299f9d7c7",
                                                "sense_id": "ab2038bb-a718-35c7-b6e3-caa5ccbd8044",
                                                "text": "Low-cut Restoration costumes worn by the Misses Lockwood and Roc (see cut) display too much \"cleavage\" (Johnston Office trade term for the shadowed depression dividing an actress' bosom into two distinct sections)."
                                            },
                                            {
                                                "example_id": "dc6079ff-1f37-4b70-a320-7785afc5dd8e",
                                                "sense_id": "ab2038bb-a718-35c7-b6e3-caa5ccbd8044",
                                                "text": "Wendy thought that her therapist was looking down her cleavage and said so. The therapist was mortified and chiefly felt guilty, unsure whether she had been looking down her patient's cleavage or not. On a reflex she assured Wendy that she was not looking down her cleavage and the matter appeared to rest."
                                            },
                                            {
                                                "example_id": "85b80f89-d631-494c-a30d-11dfa0af379b",
                                                "sense_id": "ab2038bb-a718-35c7-b6e3-caa5ccbd8044",
                                                "text": "All this time I kept my gaze fixed on hers, an enormously difficult task given the gravitational pull exerted by her cleavage. While I was critical of many things when it came to so-called Western civilization, cleavage was not one of them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72f7d211-b9a9-36b4-b475-8bbfef213069",
                                        "entry_id": "255dfb5f-c0a3-36c4-9fd3-64894bfa66f9",
                                        "glosses": [
                                            "Any similar separation between two body parts, such as the buttocks or toes."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0cca642-ce36-42c8-b0bb-0dd27daace08",
                                                "sense_id": "72f7d211-b9a9-36b4-b475-8bbfef213069",
                                                "text": "Half an hour later, she was staring at a large bottom-cleavage, which was protruding from under the bed. / 'Ohhh Kayyy. Here we go. This is basically your problem.' / Olivia took a few steps back as the bottom-cleavage started wriggling out towards her. Connor the counter-surveillance expert pulled himself awkwardly to his knees, […]"
                                            },
                                            {
                                                "example_id": "59fe9a58-6910-484b-a167-eae8230871b1",
                                                "sense_id": "72f7d211-b9a9-36b4-b475-8bbfef213069",
                                                "text": "Brenda lifted the top off a shoebox and dug beneath the tissue paper, unearthing a two-toned, turquoise-and-cream, high-heeled pump. \"This is one of my favorites,\" she said, balancing it in the palm of her hand. \"I love shoes that show toe cleavage.\" / \"Toe cleavage?\" / Brenda kicked off a leather sandal, slipped her foot into the pump, and pointed to the baseline of her toes peeking through. \"That's toe cleavage!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aaa62291-8075-3c52-ade4-53e1135f39cd",
                                        "entry_id": "255dfb5f-c0a3-36c4-9fd3-64894bfa66f9",
                                        "glosses": [
                                            "The repeated division of a cell into daughter cells after mitosis."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cffb222-a2cc-4fff-98ab-86acdee74129",
                                                "sense_id": "aaa62291-8075-3c52-ade4-53e1135f39cd",
                                                "text": "[C]itellate annelids (leeches + oligochaetes) provide solid ground for comparative analyses, because they form a monophyletic group within the paraphyletic polychaetes[…]. […] The unequal cleavage of the zygote followed by the unequal cleavage of the CD cell is critical for D-quadrant specification since the cytoplasmic determinants present in teloplasm are segregated to the larger CD cell at first asymmetric cleavage and then to the larger D cell at the second asymmetric cleavage[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "935015ea-5076-3073-a759-777b057812dc",
                                        "entry_id": "255dfb5f-c0a3-36c4-9fd3-64894bfa66f9",
                                        "glosses": [
                                            "The splitting of a large molecule into smaller ones."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ead858f-34a1-4e60-ba36-80dd8fe64b0e",
                                                "sense_id": "935015ea-5076-3073-a759-777b057812dc",
                                                "text": "Carotenoid cleavage oxygenases (CCOs) are a class of enzymes that oxidatively cleave carotenoids into apocarotenoids. Carotenoid cleavage oxygenases have been identified in plants and animals and produce a wide range of cleavage products. […] Two of the three enzymes showed cleavage of β, β-carotene at the 9,10 and 15,15' position, respectively."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f61eac4-20ab-3efe-968e-80efea7f0f5b",
                                        "entry_id": "255dfb5f-c0a3-36c4-9fd3-64894bfa66f9",
                                        "glosses": [
                                            "The tendency of a crystal to split along specific planes; schistosity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7babdf6-cce6-4c0b-b52f-6808ffbfe2a6",
                                                "sense_id": "5f61eac4-20ab-3efe-968e-80efea7f0f5b",
                                                "text": "Notice that cleavage has nothing to do with imperfections in the crystal. Indeed, if you try cleaving an imperfect crystal, you may find that it cannot be cleaved as well as a perfect one. The cleavage is the result of the orderliness of the atomic arrangement. No wonder imperfections, which disturb the orderliness, disturb the cleavage as well. You will also note that the cleavage directions are obedient to the symmetry of the crystal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed7920cb-146b-3b9e-80b6-c9645ea67060",
                                        "entry_id": "255dfb5f-c0a3-36c4-9fd3-64894bfa66f9",
                                        "glosses": [
                                            "The division of voters into voting blocs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f93a2c13-5be8-46fb-a5f4-1c647068ce9a",
                                                "sense_id": "ed7920cb-146b-3b9e-80b6-c9645ea67060",
                                                "text": "A voting bloc in Congress can represent a long-standing alliance or can be created anew as a result of the increased saliency of a particular issue, such as war or a severe economic downturn. A division between voting blocs is called a cleavage and because voting blocs are impermanent, dominant cleavages are always changing."
                                            },
                                            {
                                                "example_id": "a9b59786-1943-4b10-a876-e688a5a25207",
                                                "sense_id": "ed7920cb-146b-3b9e-80b6-c9645ea67060",
                                                "text": "The Kremlin has appointed graduates of the federal \"Time of Heroes\" programs to high level positions in the Russian federal, regional, and local governments -- likely to militarize Russian society and prevent veterans from becoming a disenfranchised political cleavage that could pose a risk to the Kremlin’s regime security."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "770e83d9-f8b5-48e4-bd8e-edb897afdb7d",
                        "source_entry_id": "af2c5061-2e96-39c2-af24-77cd031f8084",
                        "source_sense_id": "eb80875b-754e-323d-9b61-e94b1eb6285e",
                        "source_sense_description": "laag uitgesneden halslijn bij vrouwenkleding",
                        "target_lang_word": "décolleté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "décolleté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "af01fa30-0f16-39e4-9b42-a5e1e834e784",
                                        "entry_id": "a3bd0c0f-35bb-3898-9374-b7311b7654c2",
                                        "glosses": [
                                            "Forme de la vêture féminine qui laisse apparaître en partie le cou, le dos, la poitrine, les épaules."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6c9d3a9-2de4-45d2-b653-02b07fd21ac0",
                                                "sense_id": "af01fa30-0f16-39e4-9b42-a5e1e834e784",
                                                "text": "Je commande un pastis, et je promène mon œil dans la salle. Rien que de très ordinaire : au bout du comptoir, un client quelconque joue au 421 avec une brune au décolleté vertigineux."
                                            },
                                            {
                                                "example_id": "f83a3661-e703-420f-935d-154e3637b272",
                                                "sense_id": "af01fa30-0f16-39e4-9b42-a5e1e834e784",
                                                "text": "Elle est calme, légèrement penchée en avant sur son siège, un décolleté savamment dosé, assez profond pour être bouleversant, mais trop sage pour qu’on ne désire pas en voir plus."
                                            },
                                            {
                                                "example_id": "f5ffd9fd-d49c-4a17-ba77-d85c9fba742f",
                                                "sense_id": "af01fa30-0f16-39e4-9b42-a5e1e834e784",
                                                "text": "Je tombai assez rapidement sur l’objet : une photo — marquée MISS PEARL dans l’angle — représentant une fille appétissante, blond-platine apparemment, avec un décolleté d’autant plus profond qu’elle se penchait un peu pour qu’on ne perdît rien du paysage."
                                            },
                                            {
                                                "example_id": "efbb280f-c4a7-4d48-8c4b-7f6a7583107c",
                                                "sense_id": "af01fa30-0f16-39e4-9b42-a5e1e834e784",
                                                "text": "D'autant qu'une bombe peroxydée d'une trentaine d'années, dont le décolleté profond comme une chanson de staracadémicienne tranchait radicalement avec la sagesse vestimentaire ambiante, envisageait de toute évidence de lui tomber sur le poil dans un avenir aussi proche qu’imminent, et qu'il se demandait à quelle sauce elle menaçait de le manger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "520682de-ddc8-33d0-a8f7-9e1ce74b3390",
                                        "entry_id": "a3bd0c0f-35bb-3898-9374-b7311b7654c2",
                                        "glosses": [
                                            "Partie de la poitrine visible au bas du cou ou partie du dos laissée découverte par les vêtements au dos échancré."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
