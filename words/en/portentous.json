{
    "word_family": [
        "portent",
        "portentously",
        "portentousness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "46235552-fc44-3d26-b250-705c0152423e",
                    "sense_definition": "Having great importance or serving as a sign of future events.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "significance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dark clouds were a <w>portentous</w> sign of the coming storm.",
                            "target_lang_translations": {
                                "nl": "De donkere wolken waren een <w>onheilspellend</w> teken van de naderende storm."
                            }
                        },
                        {
                            "text": "The leader made a <w>portentous</w> announcement that changed the course of the war.",
                            "target_lang_translations": {
                                "nl": "De leider deed een <w>gewichtige</w> aankondiging die de loop van de oorlog veranderde."
                            }
                        }
                    ],
                    "synonyms": [
                        "momentous",
                        "significant",
                        "fateful"
                    ],
                    "common_phrases": [
                        "portentous sign",
                        "portentous event"
                    ],
                    "target_lang_definitions": {
                        "nl": "Van groot belang zijnd of dienend als een teken voor toekomstige gebeurtenissen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gewichtig",
                                "target_lang_sense_clarification": "van groot gewicht of belang"
                            },
                            {
                                "target_lang_word": "veelbetekenend",
                                "target_lang_sense_clarification": "een teken dragend voor de toekomst"
                            },
                            {
                                "target_lang_word": "noodlottig",
                                "target_lang_sense_clarification": "bepalend voor het lot"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9fbdc458-738f-3ba0-9982-8bc839dccf46",
                    "sense_definition": "Suggesting that something bad or unpleasant is going to happen.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "significance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spoke in a <w>portentous</w> tone that made everyone feel uneasy.",
                            "target_lang_translations": {
                                "nl": "Hij sprak op een <w>onheilspellende</w> toon waardoor iedereen zich ongemakkelijk voelde."
                            }
                        },
                        {
                            "text": "The silence in the room felt heavy and <w>portentous</w>.",
                            "target_lang_translations": {
                                "nl": "De stilte in de kamer voelde zwaar en <w>onheilspellend</w> aan."
                            }
                        }
                    ],
                    "synonyms": [
                        "ominous",
                        "foreboding",
                        "sinister"
                    ],
                    "common_phrases": [
                        "portentous silence",
                        "portentous tone"
                    ],
                    "target_lang_definitions": {
                        "nl": "Aanduidend dat er iets slechts of onaangenaams gaat gebeuren."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "onheilspellend",
                                "target_lang_sense_clarification": "onheil aankondigend"
                            },
                            {
                                "target_lang_word": "dreigend",
                                "target_lang_sense_clarification": "gevaar of onheil voorspellend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "831e3852-f854-34c1-b7c6-3ec8ab6c9181",
                    "sense_definition": "Exhibiting excessive pride or self-importance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vanity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor gave a <w>portentous</w> lecture that impressed no one.",
                            "target_lang_translations": {
                                "nl": "De professor gaf een <w>hoogdravend</w> college dat op niemand indruk maakte."
                            }
                        },
                        {
                            "text": "His <w>portentous</w> attitude made it difficult for his colleagues to work with him.",
                            "target_lang_translations": {
                                "nl": "Zijn <w>gewichtdoenerige</w> houding maakte het voor zijn collega's moeilijk om met hem samen te werken."
                            }
                        }
                    ],
                    "synonyms": [
                        "vain",
                        "pompous"
                    ],
                    "antonyms": [
                        "humble",
                        "insignificant",
                        "trivial",
                        "unremarkable"
                    ],
                    "target_lang_definitions": {
                        "nl": "Blijk gevend van overmatige trots, verwaandheid of gewichtigdoenerij."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gewichtdoenerig",
                                "target_lang_sense_clarification": "zichzelf belangrijker voordoend dan men is"
                            },
                            {
                                "target_lang_word": "hoogdravend",
                                "target_lang_sense_clarification": "overdreven plechtig of theatraal"
                            },
                            {
                                "target_lang_word": "gezwollen",
                                "target_lang_sense_clarification": "bombastisch en pretentieus"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}