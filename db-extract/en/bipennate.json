    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "2a26b60d-38d4-3871-b8fc-b0f2fbdef29f",
                "word": "bipennate",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "878b2ff7-52ac-3af9-902f-c12158d4ef1c",
                        "entry_id": "2a26b60d-38d4-3871-b8fc-b0f2fbdef29f",
                        "glosses": [
                            "Of, pertaining to, or having the nature of a muscle, the fibres of which attach to a tendon on two sides (as a feather barbed on both sides)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "9f9619ea-0a88-4e1d-a853-1af2c765ff24",
                                "sense_id": "878b2ff7-52ac-3af9-902f-c12158d4ef1c",
                                "text": "It then follows that bipennate muscles generate even more force than unipennate ones of similar volume, and the force increases with the angle of pennation."
                            },
                            {
                                "example_id": "acf243a7-2e8b-44ff-966b-c556d805dec7",
                                "sense_id": "878b2ff7-52ac-3af9-902f-c12158d4ef1c",
                                "text": "Beneath the deltoid lies the external rotators of the shoulders, including the bipennate infraspinatus and the teres minor (Fig. 5-20B)."
                            },
                            {
                                "example_id": "92f361ca-1d7d-4170-8f76-dd727a460949",
                                "sense_id": "878b2ff7-52ac-3af9-902f-c12158d4ef1c",
                                "text": "Bipennate muscles have a central tendon with oblique insertion fibers on both sides, eg, the rectus femoris (Figure 1.3c)."
                            }
                        ]
                    },
                    {
                        "sense_id": "5388b03e-c895-3ca5-b0f6-95c7af4b94be",
                        "entry_id": "2a26b60d-38d4-3871-b8fc-b0f2fbdef29f",
                        "glosses": [
                            "Bipinnate (pinnate and having a pinnate leaflet)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "9378b7af-b964-4022-8232-7d9ea6b42479",
                                "sense_id": "5388b03e-c895-3ca5-b0f6-95c7af4b94be",
                                "text": "Its bipennate leaves are composed of a slightly straightened general petiole, of four partial petioles, situated, two at the extremity of the proceeding, and convergent, two a little lower, and growing almost at right angles; each of them bearing more than twenty pairs of small horizontal petioles."
                            },
                            {
                                "example_id": "dbd2626a-3c27-4e40-9712-2e8d9d436b32",
                                "sense_id": "5388b03e-c895-3ca5-b0f6-95c7af4b94be",
                                "text": "But this Burnet Pimpinella is of a different (Umbelliferous) order, though similarly styled because its leaves are likewise bipennate."
                            }
                        ]
                    },
                    {
                        "sense_id": "27d394e4-4c40-38ec-a893-32c07b4a0c88",
                        "entry_id": "2a26b60d-38d4-3871-b8fc-b0f2fbdef29f",
                        "glosses": [
                            "Having two wings; bipennated."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
