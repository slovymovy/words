                    {
                        "translation_id": "24f2924f-b6be-4c19-98b6-6e5c01098bdd",
                        "source_entry_id": "258cf242-9251-3849-b187-16a1aa4efa7e",
                        "source_sense_id": "070e0383-3974-362e-9873-d5b008c3ad07",
                        "target_lang_word": "Deklinationsmesser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "60701c46-4adf-49a4-b9b2-cea8827675d4",
                        "source_entry_id": "258cf242-9251-3849-b187-16a1aa4efa7e",
                        "source_sense_id": "070e0383-3974-362e-9873-d5b008c3ad07",
                        "target_lang_word": "Deklinometer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Deklinometer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2fa9f0e0-97c5-39f7-9f68-c2aa08677786",
                                        "entry_id": "c9865f39-0edc-32bb-8e98-390a2ba2b3bb",
                                        "glosses": [
                                            "Gerät zur Bestimmung der Abweichung zwischen magnetischer und geografischer Richtung"
                                        ],
                                        "tags": [
                                            "geography",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "880b4bd5-5248-4f54-b6fb-a790944afab6",
                                                "sense_id": "2fa9f0e0-97c5-39f7-9f68-c2aa08677786",
                                                "text": "„Durch Kompensationsmagnete kann die Empfindlichkeit magnetometrisch beeinflußt werden, gerade wie beim Deklinometer.“"
                                            },
                                            {
                                                "example_id": "2bcbbfa5-4f17-4ce2-b58e-aad17654b05d",
                                                "sense_id": "2fa9f0e0-97c5-39f7-9f68-c2aa08677786",
                                                "text": "„Sind diese mit dem Erdfeld gleichgerichtet, so wird das Deklinometer unempfindlich, im anderen Falle überempfindlich […].“"
                                            },
                                            {
                                                "example_id": "f7c604cc-30cf-4d3e-84e3-5ec75e5f2be1",
                                                "sense_id": "2fa9f0e0-97c5-39f7-9f68-c2aa08677786",
                                                "text": "„Um nun andererseits den magnetischen Meridian und durch Vergleich desselben mit dem astronomischen die Deklination zu bestimmen, bedient man sich eines Deklinatoriums oder Deklinometers (auch Deklinationsbussole genannt).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2f172a1e-1410-350d-8b8d-56bff680949e",
                                        "entry_id": "c9865f39-0edc-32bb-8e98-390a2ba2b3bb",
                                        "glosses": [
                                            "Vorrichtung zur graphischen Aufzeichnung von Deklinationsdifferenzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfb99905-65b2-48df-8068-44185ccb5b53",
                                                "sense_id": "2f172a1e-1410-350d-8b8d-56bff680949e",
                                                "text": "„Am 19. Februar wurde das Fuess’sche Deklinometer untersucht. Es ergab sich aus 24 Messungen von Deklinationsdifferenzen der Plejaden-Sterne für die einer Schraubenumdrehung am Ablesemikroskope entsprechende Differenz auf dem Deklinationsstreifen des Apparates den Wert u = […].“"
                                            },
                                            {
                                                "example_id": "76b3a6a6-0e10-4c9f-922b-6a790dfb13fa",
                                                "sense_id": "2f172a1e-1410-350d-8b8d-56bff680949e",
                                                "text": "„Besonder hervorzuheben sind das Universaldurchgangs-Instrument für die Berliner Sternwarte von Bamberger, sowie dessen Theodoliten, Tubuse, Perspektive, Sertanten und Chronometer, die Barometer, Thermometer, Barographen, Windgeschwindigkeitsmesser, Deklinometer und die photographische Camera für die Sternwarte in Potsdam, Mikroskope in und alle möglichen Dünnschliffpräparate von sämmtlichen Mineralien von Fueß […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
