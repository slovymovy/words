                    {
                        "sense_id": "76c0c365-a822-343e-aaaa-dcf7664e3867",
                        "entry_id": "1c4838eb-07fc-3bc3-99d8-c8f31037f6af",
                        "glosses": [
                            "свойство по значению прилагательного мерзкий"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "62374ceb-b55f-368c-9b7f-cdc0cae47277",
                        "entry_id": "1c4838eb-07fc-3bc3-99d8-c8f31037f6af",
                        "glosses": [
                            "нечто крайне отталкивающее, вызывающее непроизвольное содрогание"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acd5d641-0940-4dab-a02f-3c5a263333e2",
                                "sense_id": "62374ceb-b55f-368c-9b7f-cdc0cae47277",
                                "text": "Он сказал им: вы выказываете себя праведниками пред людьми, но Бог знает сердца́ ваши, ибо что высоко у людей, то́ мерзость пред Богом."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "19bb7e89-e908-48b2-99dc-f8205d4fdb66",
                        "source_entry_id": "1c4838eb-07fc-3bc3-99d8-c8f31037f6af",
                        "source_sense_description": "свойство",
                        "target_lang_word": "abomination",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abomination",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "72c40462-2dc7-3f91-91ba-43b33d8a4147",
                                        "entry_id": "f14aaf5f-dcea-363f-8729-4d42819bb6aa",
                                        "glosses": [
                                            "An abominable act; a disgusting vice; a despicable habit."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48e304d8-61a1-44c1-85fa-c348edfa87a1",
                                                "sense_id": "72c40462-2dc7-3f91-91ba-43b33d8a4147",
                                                "text": "Onely th’adulterous Anthony, most large / In his abhominations, turnes you off"
                                            },
                                            {
                                                "example_id": "6688ee4a-a186-4d3f-b0bf-372be0e49c42",
                                                "sense_id": "72c40462-2dc7-3f91-91ba-43b33d8a4147",
                                                "text": "Religious sodomy was practised by male prostitutes in the Hebrew temple groves, which was one of the abominations of Israel that Josiah cleared away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e13e11a-cc87-3cd8-851a-478417079ace",
                                        "entry_id": "f14aaf5f-dcea-363f-8729-4d42819bb6aa",
                                        "glosses": [
                                            "The feeling of extreme disgust and hatred"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "34e29b6e-4faf-337d-adb1-906b2525f6fa",
                                        "entry_id": "f14aaf5f-dcea-363f-8729-4d42819bb6aa",
                                        "glosses": [
                                            "A state that excites detestation or abhorrence; pollution."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "582f3037-1370-336e-a6ee-c63a6309ced0",
                                        "entry_id": "f14aaf5f-dcea-363f-8729-4d42819bb6aa",
                                        "glosses": [
                                            "That which is abominable, shamefully vile; an object that excites disgust and hatred (often with religious undertones)."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "165c0245-11fa-4af7-8e8a-0881f8175df2",
                                                "sense_id": "582f3037-1370-336e-a6ee-c63a6309ced0",
                                                "text": "Appalled by a child she found hideous, Philyra begged the gods to free her from having to rear such an abomination."
                                            },
                                            {
                                                "example_id": "ce642071-7ba8-46f4-86d9-4836f56ed9f4",
                                                "sense_id": "582f3037-1370-336e-a6ee-c63a6309ced0",
                                                "text": "Elon Musk, the billionaire tech entrepreneur, has opened a new rift with Donald Trump by denouncing the US president’s tax and spending bill as a “disgusting abomination”."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb111b2a-6c66-4e5f-966b-771972aca0f9",
                        "source_entry_id": "1c4838eb-07fc-3bc3-99d8-c8f31037f6af",
                        "source_sense_description": "свойство",
                        "target_lang_word": "loathsomeness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loathsomeness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b23d6c28-bbbd-3256-8dcd-eb7a3a539697",
                                        "entry_id": "cb74d582-61e3-37fd-8947-149328781bd9",
                                        "glosses": [
                                            "The nature or property that gives rise to revulsion or inspires loathing."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0636a762-25bd-466f-9aff-0585f84e00ab",
                                                "sense_id": "b23d6c28-bbbd-3256-8dcd-eb7a3a539697",
                                                "text": "For my part I would rather counſell you to deſtroy your Rattes and Miſe with Traps, Banes, or Weeſels: for beſides the ſluttiſhneſſe ⁊ lothſomeneſſe of the Catte (you know what ſhe layes in the Malt heape) ſhe is moſt daungerous and pernicious among children, as I mee ſelf haue had good experience."
                                            },
                                            {
                                                "example_id": "caff02bc-7444-4aba-8004-d0a8cedcd062",
                                                "sense_id": "b23d6c28-bbbd-3256-8dcd-eb7a3a539697",
                                                "text": "Must putrefaction's breath / Leave nothing of this heavenly sight / But loathsomeness and ruin?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e66f011-b6c4-35d4-ad8c-800405ba5d7e",
                                        "entry_id": "cb74d582-61e3-37fd-8947-149328781bd9",
                                        "glosses": [
                                            "A loathsome thing."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "248fb053-9fd7-4be1-8dfb-430d7cffe20d",
                                                "sense_id": "9e66f011-b6c4-35d4-ad8c-800405ba5d7e",
                                                "text": "H. P. Lovecraft\nAfter it raced the naked, tittering, phosphorescent thing that belonged on the carven pedestal, and still farther behind panted the dark men, and all the dread crew of sentient loathsomenesses. The corpse was gaining on its pursuers …"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03bfa503-5620-4a37-8bc0-7a031c7c786a",
                        "source_entry_id": "1c4838eb-07fc-3bc3-99d8-c8f31037f6af",
                        "source_sense_description": "свойство",
                        "target_lang_word": "meanness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meanness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f14b494-17a9-3162-a44d-cff056411adf",
                                        "entry_id": "1e3dc032-1779-33ef-b54e-2836e0faae4f",
                                        "glosses": [
                                            "The condition, or quality, of being mean (any of its definitions)"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d38fe5c9-0784-40d8-a2b3-739c0ee7c6e6",
                                                "sense_id": "3f14b494-17a9-3162-a44d-cff056411adf",
                                                "text": "This figure is of a later date, by the meanness of the workmanship."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19733eb7-c502-3a0a-898b-f8853ca8cad7",
                                        "entry_id": "1e3dc032-1779-33ef-b54e-2836e0faae4f",
                                        "glosses": [
                                            "A mean act."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebbcd0a9-bf80-41f2-b9f2-5402df66b755",
                                                "sense_id": "19733eb7-c502-3a0a-898b-f8853ca8cad7",
                                                "text": "There are enough meannesses in everyone — ourselves included — to make for us a contemptible world, if we select the meannesses and let our minds dwell upon them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
