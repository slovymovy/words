                ],
                "senses": [
                    {
                        "sense_id": "974a7866-6225-3f25-8a13-e881f77ac686",
                        "entry_id": "20fe5a10-5782-30cd-9863-55e624e5b7f9",
                        "glosses": [
                            "von Militärangehörigen gebildete Leitung eines Staates (oder einer vergleichbaren Institution)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af06d3df-ec3d-4e74-8770-c30ba23cca4b",
                                "sense_id": "974a7866-6225-3f25-8a13-e881f77ac686",
                                "text": "Nach dem Zweiten Weltkrieg waren in Deutschland mehrere Jahre lang verschiedene Militärregierungen an der Macht."
                            },
                            {
                                "example_id": "00b2d079-0615-48a2-b742-4148ec5243e3",
                                "sense_id": "974a7866-6225-3f25-8a13-e881f77ac686",
                                "text": "„Die Proklamation Nr. 2 der US-Militärregierung erhob diese Gebiete in den Rang von Ländern.“"
                            },
                            {
                                "example_id": "9690a8da-1d07-41fd-95db-0d4d792ebd4c",
                                "sense_id": "974a7866-6225-3f25-8a13-e881f77ac686",
                                "text": "„Als ich das erste Mal nach Heidelberg kam, war ich mit einem Auto der Militärregierung unterwegs, und wir hatten eine Reifenpanne auf der Autobahn.“"
                            },
                            {
                                "example_id": "33b98f28-81f2-42cd-90f5-550131753254",
                                "sense_id": "974a7866-6225-3f25-8a13-e881f77ac686",
                                "text": "„Ihr Protest richtete sich einheitlich gegen die Militärregierung, war aber durch individuelle Wahrnehmung öffentlich-rechtlicher Benachteiligung motiviert.“"
                            },
                            {
                                "example_id": "f4b22987-c4d6-472a-a2d1-be0d0129f3c0",
                                "sense_id": "974a7866-6225-3f25-8a13-e881f77ac686",
                                "text": "„Baden-Baden war der Sitz der französischen Militärregierung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
