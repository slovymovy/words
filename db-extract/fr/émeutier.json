                                        "glosses": [
                                            "Having the characteristics of a riot."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1b91f0f2-fa31-3abd-826a-c182aba1e0b2",
                                        "entry_id": "3b3f3773-741b-3d05-b3ec-64bd7677240a",
                                        "glosses": [
                                            "Causing, inciting or taking part in a riot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ebad0bd-35df-42a4-9cce-f28766a68398",
                                                "sense_id": "1b91f0f2-fa31-3abd-826a-c182aba1e0b2",
                                                "text": "The prison administrators are always planting seeds of hate, division, separatism, and prison peer group racism in the various ethnic groups here, causing friction and riotous situations where one group is set against another."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48773fc0-c6f6-3824-9462-5a39dd725d95",
                                        "entry_id": "3b3f3773-741b-3d05-b3ec-64bd7677240a",
                                        "glosses": [
                                            "Unrestrained and boisterous; degenerate or dissolute."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
