                "senses": [
                    {
                        "sense_id": "9db24c4d-d044-3da7-8bf6-eed1702eaa78",
                        "entry_id": "e57cbf5c-c2ab-3531-923f-a00df65a9de6",
                        "glosses": [
                            "Person, die sich in ihren Ferien in einem Ort aufhält, der nicht ihr Wohnort ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "019d00dc-4e5b-443f-ba43-6d47a2d8557a",
                                "sense_id": "9db24c4d-d044-3da7-8bf6-eed1702eaa78",
                                "text": "„Er wohnt aber nicht in dieser Wohnung, sondern er vermietet sie an Feriengäste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f53ae23-dd1d-4bfd-86ad-5959ef6968b2",
                        "source_entry_id": "e57cbf5c-c2ab-3531-923f-a00df65a9de6",
                        "source_sense_id": "9db24c4d-d044-3da7-8bf6-eed1702eaa78",
                        "source_sense_description": "Person, die sich in ihren Ferien in einem Ort aufhält, der nicht ihr Wohnort ist",
                        "target_lang_word": "vacationist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vacationist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aab35e9b-4185-38b7-b828-61e6967e6231",
                                        "entry_id": "55080e07-efdf-3f05-ad27-6fb1b69b9bef",
                                        "glosses": [
                                            "Someone who is on vacation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8fb7613-5f81-449d-af4d-d4dc8fe7770f",
                                                "sense_id": "aab35e9b-4185-38b7-b828-61e6967e6231",
                                                "text": "Anyone was welcome to ride. And as the train rolled along the backwoods section it picked up countless non-paying passengers from among vacationists and boys from camps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "10621b6e-d088-4226-8273-1d2d8b67bba4",
                        "source_entry_id": "e57cbf5c-c2ab-3531-923f-a00df65a9de6",
                        "source_sense_id": "9db24c4d-d044-3da7-8bf6-eed1702eaa78",
                        "source_sense_description": "Person, die sich in ihren Ferien in einem Ort aufhält, der nicht ihr Wohnort ist",
                        "target_lang_word": "touriste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "touriste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f6a5c87a-b75a-382e-a4d1-567b05731283",
                                        "entry_id": "33ffbbee-4f84-3dad-8c55-37179c86c27b",
                                        "glosses": [
                                            "Personne qui voyage pour son plaisir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "088a2f88-eac6-449c-85e6-e52add3ba6d9",
                                                "sense_id": "f6a5c87a-b75a-382e-a4d1-567b05731283",
                                                "text": "Fourchette à la main et vue sur mer, un combo souvent recherché par les touristes mais également apprécié par les locaux qui ne souhaitent pas trop dépenser."
                                            },
                                            {
                                                "example_id": "29fde68a-2c3b-41d9-b967-46b5ef0c2886",
                                                "sense_id": "f6a5c87a-b75a-382e-a4d1-567b05731283",
                                                "text": "Du touriste, il n’avait ni la curiosité ni la hâte. Il préférait découvrir les détails lentement, peu à peu, au hasard de la vie et des promenades quotidiennes, sans but et sans intention."
                                            },
                                            {
                                                "example_id": "0aa0de49-2f41-4bfa-a7e5-9ee341b82285",
                                                "sense_id": "f6a5c87a-b75a-382e-a4d1-567b05731283",
                                                "text": "L’avion allemand qui passe là-haut ne peut noter dans ce coin de village qu’un touriste ou un indiscret."
                                            },
                                            {
                                                "example_id": "40bf2ad5-d393-4e39-9cdb-18066edfeb00",
                                                "sense_id": "f6a5c87a-b75a-382e-a4d1-567b05731283",
                                                "text": "Chaque semaine, des paquebots arrivaient de New-York et débarquaient des touristes américains qui venaient se reposer de leurs affaires, à l’abri des lois de la prohibition."
                                            },
                                            {
                                                "example_id": "d9446bb5-cb76-46b2-8bca-d6a77037dbb4",
                                                "sense_id": "f6a5c87a-b75a-382e-a4d1-567b05731283",
                                                "text": "L’artiste, le poète et le touriste se réjouissent ici d’un pittoresque qui fait le désespoir de l’agriculteur."
                                            },
                                            {
                                                "example_id": "2886de40-eb1e-4b58-bcbf-4d1ade5abf81",
                                                "sense_id": "f6a5c87a-b75a-382e-a4d1-567b05731283",
                                                "text": "La vie de touriste n’est pas une vie. Le touriste toujours va où va le touriste, aux seules fins de pouvoir narrer chez lui à d’autres touristes des histoires de touristes."
                                            },
                                            {
                                                "example_id": "95ae6d2c-4df8-40d3-8dd4-679302ecd714",
                                                "sense_id": "f6a5c87a-b75a-382e-a4d1-567b05731283",
                                                "text": "Selon les informations de BFMTV, les touristes faisaient du camping sauvage à proximité de Castellane (Alpes-de-Haute-Provence) et ont décidé d’allumer un feu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3fba773-6ffc-3ad9-9075-b512e307f768",
                                        "entry_id": "33ffbbee-4f84-3dad-8c55-37179c86c27b",
                                        "glosses": [
                                            "Dilettante."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4263ad79-864d-457e-a2b3-5bc3edf80f7a",
                                                "sense_id": "c3fba773-6ffc-3ad9-9075-b512e307f768",
                                                "text": "Il vient au lycée en touriste, se déplace d’une salle à une autre, en sifflotant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
