                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e67cce7-a5b2-42f1-a97c-22190920e78d",
                                "sense_id": "8d14b6d7-1fd4-37ea-a7bb-2de9468a96d8",
                                "text": "Szedł przez zasypane śniegiem pole w tej swojej baranicy, która sięgała mu do kolan.",
                                "translation": "Kráčel přes zaváté pole v té své beranině, která mu sahala po kolena."
