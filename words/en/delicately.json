{
    "word_family": [
        "delicate",
        "delicacy",
        "indelicately",
        "indelicate"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ac87d927-4164-309e-bd2b-6fce5bcaf543",
                    "sense_definition": "In a delicate, fine, or exquisite manner; with great care, softness, or precision.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist <w>delicately</w> painted the tiny petals of the flower with a very fine brush.",
                            "target_lang_translations": {
                                "ru": "Художник <w>изящно</w> вырисовывал крошечные лепестки цветка очень тонкой кистью."
                            }
                        },
                        {
                            "text": "The old glass vase was <w>delicately</w> balanced on the edge of the wooden shelf.",
                            "target_lang_translations": {
                                "ru": "Старая стеклянная ваза была <w>хрупко</w> сбалансирована на самом краю деревянной полки."
                            }
                        }
                    ],
                    "synonyms": [
                        "exquisitely",
                        "gently",
                        "softly",
                        "finely"
                    ],
                    "antonyms": [
                        "roughly",
                        "coarsely",
                        "clumsily"
                    ],
                    "common_phrases": [
                        "delicately balanced",
                        "delicately painted",
                        "delicately carved"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изящно, тонко или аккуратно; с большой осторожностью, мягкостью или точностью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "деликатно",
                                "target_lang_sense_clarification": "с осторожностью и мягкостью"
                            },
                            {
                                "target_lang_word": "изящно",
                                "target_lang_sense_clarification": "грациозно и тонко"
                            },
                            {
                                "target_lang_word": "аккуратно",
                                "target_lang_sense_clarification": "с высокой точностью и бережностью"
                            },
                            {
                                "target_lang_word": "тонко",
                                "target_lang_sense_clarification": "с высокой степенью мастерства или детализации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e231c8c3-1784-33c7-97b7-c02eb466ded5",
                    "sense_definition": "In a tactful, sensitive, or diplomatic manner, especially to avoid offending or upsetting anyone.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "tact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She tried to handle the difficult situation <w>delicately</w> so that no one felt insulted.",
                            "target_lang_translations": {
                                "ru": "Она постаралась разрешить эту сложную ситуацию <w>деликатно</w>, чтобы никто не почувствовал себя оскорбленным."
                            }
                        },
                        {
                            "text": "The manager decided to <w>delicately</w> raise the issue of poor performance during the meeting.",
                            "target_lang_translations": {
                                "ru": "Менеджер решил <w>тактично</w> поднять вопрос о низкой производительности во время собрания."
                            }
                        }
                    ],
                    "synonyms": [
                        "tactfully",
                        "diplomatically",
                        "sensitively"
                    ],
                    "antonyms": [
                        "tactlessly",
                        "bluntly",
                        "indelicately"
                    ],
                    "common_phrases": [
                        "delicately handled",
                        "raise the issue delicately"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тактично, чутко или дипломатично, особенно во избежание обид или огорчений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "деликатно",
                                "target_lang_sense_clarification": "тактично и мягко в общении"
                            },
                            {
                                "target_lang_word": "тактично",
                                "target_lang_sense_clarification": "с соблюдением приличий и уважения"
                            },
                            {
                                "target_lang_word": "дипломатично",
                                "target_lang_sense_clarification": "умело обходя острые углы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}