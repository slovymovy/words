                "senses": [
                    {
                        "sense_id": "8293e34c-4add-3543-a5ac-632005c28ab6",
                        "entry_id": "8f5b35d5-6d05-3b1b-904f-4be74e88d824",
                        "glosses": [
                            "warden, turnkey, supervisor, overseer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b14b3f65-dc37-45cf-a158-dcf433379db4",
                                "sense_id": "8293e34c-4add-3543-a5ac-632005c28ab6",
                                "text": "Побыва́в у мещани́на и возвраща́ясь к себе́ домо́й, он встре́тил о́коло по́чты знако́мого полице́йского надзира́теля, кото́рый поздоро́вался и прошёл с ним по у́лице не́сколько шаго́в, и почему́-то э́то показа́лось ему́ подозри́тельным.",
                                "translation": "After visiting the artisan, on the way home he met near the post office a police superintendent of his acquaintance, who greeted him and walked a few paces along the street with him, and for some reason this seemed to him suspicious.",
                                "english": "After visiting the artisan, on the way home he met near the post office a police superintendent of his acquaintance, who greeted him and walked a few paces along the street with him, and for some reason this seemed to him suspicious."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
