                    ]
                },
                {
                    "sense_id": "68f780f7-cf32-3f93-b3a9-542667229342",
                    "sense_definition": "Donner un démenti par sa conduite ou être en contradiction avec ses engagements.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "contradiction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En acceptant ce compromis douteux, il a craint de <w>mentir</w> à ses principes fondateurs."
                        },
                        {
                            "text": "Le ministre a pris soin de ne pas <w>mentir</w> à sa réputation d'homme intransigeant."
