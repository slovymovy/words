                "senses": [
                    {
                        "sense_id": "d84bb755-de66-3108-b936-32fc9a67b28e",
                        "entry_id": "519c1bcd-6c4f-361f-aa6d-b5cd694b890a",
                        "glosses": [
                            "Dangerous, full of peril."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "517b5ced-9ce6-48fe-9f54-e159a74f9eec",
                                "sense_id": "d84bb755-de66-3108-b936-32fc9a67b28e",
                                "text": "Three miles or more to our starboard is a low dim line. It is the Eastern shore of Central Africa. We are running to the southward, before the North East Monsoon, between the mainland and the reef that for hundreds of miles fringes this perilous coast."
                            },
                            {
                                "example_id": "983a3728-33b9-4d9e-a924-42a182632563",
                                "sense_id": "d84bb755-de66-3108-b936-32fc9a67b28e",
                                "text": "The effects are already being felt. Gamma radiation is flooding through the gaps; the quick-breeding viruses are mutating through half the world, faster than the Medical Art can control them, so that millions of us are sneezing and choking—and dying, too, for lack of antibiotics and proper care. Air travel is a perilous thing; just today, a stratosphere roc crashed head-on into a fragment of the sky and was killed with all its passengers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7bf7f921-6367-4e4d-9691-595bdfbd8772",
                        "source_entry_id": "519c1bcd-6c4f-361f-aa6d-b5cd694b890a",
                        "source_sense_id": "d84bb755-de66-3108-b936-32fc9a67b28e",
                        "source_sense_description": "dangerous, full of peril",
                        "target_lang_word": "gevaarlijk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gevaarlijk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ac291d40-a5ce-3970-8e05-d7dc7b596e8a",
                                        "entry_id": "f4935b9c-bc8a-3420-b9dc-684dc8238ae3",
                                        "glosses": [
                                            "gevaar met zich meebrengend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a565b11c-39de-4831-adec-8e79272ae824",
                                                "sense_id": "ac291d40-a5ce-3970-8e05-d7dc7b596e8a",
                                                "text": "Doe alsjeblieft voorzichtig, het is een gevaarlijke tocht!"
                                            },
                                            {
                                                "example_id": "c1e70ea5-5f25-48b5-8825-2674fde6d964",
                                                "sense_id": "ac291d40-a5ce-3970-8e05-d7dc7b596e8a",
                                                "text": "Gebruikers van deze app lieten opmerkingen achter om kwaliteit en kwantiteit van het water aan te geven, voorzien van een datum, waaruit op te maken was of een bron wel of niet was opgedroogd. Ook werden er waarschuwingen bij specifieke stukken trail achtergelaten, zoals bijvoorbeeld op welke plek men het best een gevaarlijke rivier in de bergen kon oversteken."
                                            },
                                            {
                                                "example_id": "35717043-7b1e-40e0-a91c-a96667732924",
                                                "sense_id": "ac291d40-a5ce-3970-8e05-d7dc7b596e8a",
                                                "text": "Hier was duidelijk het verschil in leeftijd te zien: jonge kerels willen alles uitproberen, hoe gevaarlijker hoe beter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "423b27db-57a6-42ab-aa9d-9d57beb50543",
                        "source_entry_id": "519c1bcd-6c4f-361f-aa6d-b5cd694b890a",
                        "source_sense_id": "d84bb755-de66-3108-b936-32fc9a67b28e",
