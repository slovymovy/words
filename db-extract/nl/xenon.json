        "nl-extract.jsonl": [
            {
                "entry_id": "9fbe3311-8a9d-3472-b764-00c8bf1ee947",
                "word": "xenon",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0a4573c5-625a-37d6-9d4d-9da16e77f020",
                        "entry_id": "9fbe3311-8a9d-3472-b764-00c8bf1ee947",
                        "glosses": [
                            "een scheikundig element en kleurloos edelgas met het symbool Xe en het atoomnummer 54"
                        ],
                        "tags": [
                            "element"
                        ],
                        "examples": [
                            {
                                "example_id": "2c79d5cd-17b6-4b83-9e49-ca83e7f39755",
                                "sense_id": "0a4573c5-625a-37d6-9d4d-9da16e77f020",
                                "text": "Xenon is een kleurloos edelgas dat in zeer kleine hoeveelheid in lucht voorkomt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61cb0715-cb01-4d4c-8d06-53e7c35519c3",
                        "source_entry_id": "9fbe3311-8a9d-3472-b764-00c8bf1ee947",
                        "source_sense_id": "0a4573c5-625a-37d6-9d4d-9da16e77f020",
                        "source_sense_description": "een scheikundig element en kleurloos edelgas met het symbool Xe en het atoomnummer 54",
                        "target_lang_word": "Xenon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Xenon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2d6e3f9f-1ebe-347c-b655-395c9560b6d3",
                                        "entry_id": "bb4e1ffe-598d-386a-b643-96950802f3d5",
                                        "glosses": [
                                            "geruch- und farbloses Edelgas, das beispielsweise als Narkotikum oder als Füllgas in Leuchtmitteln Anwendung findet"
                                        ],
                                        "tags": [
                                            "Ordnungszahl 54"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bfa755b-5303-4b8a-a54a-59cad346fd73",
                                                "sense_id": "2d6e3f9f-1ebe-347c-b655-395c9560b6d3",
                                                "text": "Als Füllung in Gasentladungsröhren erzeugt Xenon violettes Licht."
                                            },
                                            {
                                                "example_id": "76682d1e-39b5-4ec9-ad53-9570756fb49d",
                                                "sense_id": "2d6e3f9f-1ebe-347c-b655-395c9560b6d3",
                                                "text": "„Den Beweis eines Atomtests liefern erst radioaktive Spaltprodukte oder freigesetztes Xenon.“"
                                            },
                                            {
                                                "example_id": "34d3a3bb-b818-4437-bab7-392237af0959",
                                                "sense_id": "2d6e3f9f-1ebe-347c-b655-395c9560b6d3",
                                                "text": "„Als Treibstoff wird meist Xenon verwendet, keine schweren Tanks sind mehr nötig, das Gas reicht aus.“"
                                            },
                                            {
                                                "example_id": "fbec94f3-e775-44d6-8de6-cd335133da5d",
                                                "sense_id": "2d6e3f9f-1ebe-347c-b655-395c9560b6d3",
                                                "text": "„Nach der Entdeckung des Xenons hat Tepco Borsäure-Lösung mit dem Kühlwasser in den Reaktor eingeleitet, um eine Kettenreaktion aufzuhalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8301229-140c-4cd3-b647-160d6cd0054f",
