                    {
                        "translation_id": "edeb89e8-2e9f-41a5-ad17-3ddcf36aeab6",
                        "source_entry_id": "7221c2cb-0700-3f59-b13c-89ddecaa3cea",
                        "source_sense_description": "Bat or beetle for washing clothes",
                        "target_lang_word": "валёк",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "валёк",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b2e08ad5-01d0-3fd9-bce1-d83d4f50b705",
                                        "entry_id": "4b8b1bef-dee0-3cb4-ad1a-fa3d9e3601cd",
                                        "glosses": [
                                            "деревянный брусок с рукояткой или округлая палка для валяния шерсти, обмолота и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efb86ed9-10ce-4a2c-888a-fd0aa7d4a5db",
                                                "sense_id": "b2e08ad5-01d0-3fd9-bce1-d83d4f50b705",
                                                "text": "Подложили под снопы торпище, на нём и молотили не цепами, а вальками ― каждое зерно на учёте."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3174d6e2-fecd-3c0f-bad2-c4a2cccd19c2",
                                        "entry_id": "4b8b1bef-dee0-3cb4-ad1a-fa3d9e3601cd",
                                        "glosses": [
                                            "плоский деревянный брусок с рукояткой для выколачивания белья при полоскании или для катания его на скалке"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8e9304f-ef55-4649-9b1a-9ca2c4162c1d",
                                                "sense_id": "3174d6e2-fecd-3c0f-bad2-c4a2cccd19c2",
                                                "text": "Баба подняла голову, посмотрела на Байкаловых и продолжала колотить вальком по белью."
                                            },
                                            {
                                                "example_id": "c56550f0-72f2-4752-9204-fade1a2eb82c",
                                                "sense_id": "3174d6e2-fecd-3c0f-bad2-c4a2cccd19c2",
                                                "text": "В хозяйстве обладаются также предметы, которые мать называет катком и вальком, а Дементий Порфирьевич ― скалкой и рубелем."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c91b6bad-3545-3981-a2f1-fce687746134",
                                        "entry_id": "4b8b1bef-dee0-3cb4-ad1a-fa3d9e3601cd",
                                        "glosses": [
                                            "толстая палка, к которой прикрепляются постромки пристяжной лошади"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e8298b1-bacc-404b-ad2e-ad6568185aab",
                                                "sense_id": "c91b6bad-3545-3981-a2f1-fce687746134",
                                                "text": "А лошади кашляли и не спеша бежали, валёк левой пристяжки порою скрёб по колесу, порою натягивался, и всё время мелькала под ним белой сталью стёртая подкова."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "096b5330-2d9e-3994-8cb3-e8c4be24ee4f",
                                        "entry_id": "4b8b1bef-dee0-3cb4-ad1a-fa3d9e3601cd",
                                        "glosses": [
                                            "круглый деревянный или металлический брусок, стержень, используемый в качестве катка, оси и т. п."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d3a4a724-dd9c-38d4-988b-1ffa6b04eb4c",
                                        "entry_id": "4b8b1bef-dee0-3cb4-ad1a-fa3d9e3601cd",
                                        "glosses": [
                                            "верхняя утолщённая часть весла"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2038c40-1e98-4d3e-b19f-e4f37206b17b",
                                                "sense_id": "d3a4a724-dd9c-38d4-988b-1ffa6b04eb4c",
                                                "text": "Вёсла по самые вальки уходят в воду, и Костя с трудом вытаскивает их."
                                            },
                                            {
                                                "example_id": "a7a883a2-afe7-4173-a5c6-4c6e53f3a859",
                                                "sense_id": "d3a4a724-dd9c-38d4-988b-1ffa6b04eb4c",
                                                "text": "Мы полезли по банкам, стали доставать вёсла, вставлять в уключины, толкая вальками друг друга в спины."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba0ad680-d4cb-39ff-a330-2dbe42c8faa1",
                                        "entry_id": "4b8b1bef-dee0-3cb4-ad1a-fa3d9e3601cd",
                                        "glosses": [
                                            "устар. то же, что валик (деталь мебели)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1e7e288-2bfd-4e7c-b845-385cf1627221",
                                                "sense_id": "ba0ad680-d4cb-39ff-a330-2dbe42c8faa1",
                                                "text": "Что её некогда грациозная головка ― покоится ли на подушке, обшитой кружевами, в своём отеле, или она склонилась на жёсткий больничный валек, для того чтоб уснуть навеки или проснуться на горе и бедность."
                                            },
                                            {
                                                "example_id": "09f4d559-c393-4e92-b84e-4bf32cba4db6",
                                                "sense_id": "ba0ad680-d4cb-39ff-a330-2dbe42c8faa1",
                                                "text": "Это был не номер, а одна из трактирных комнат верхнего этажа, со столом, покрытым грязной скатертью, диваном совсем без спинки и без вальков и двумя стульями."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "валёк",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fddfa1ee-f32e-30ab-b2e6-34815a8d612e",
                                        "entry_id": "b005c248-3004-3fda-b728-4f308c8399f2",
                                        "glosses": [
                                            "зоол., ихтиол. рыба семейства лососёвых (Prosopium)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "771f186d-f1cf-4f6d-a1ff-7ab34d959ed4",
                                                "sense_id": "fddfa1ee-f32e-30ab-b2e6-34815a8d612e",
                                                "text": "Прямо перед собой вижу стайку серебристых вальков, мелькают юркие хариусы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
