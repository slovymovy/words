                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "0c74426d-0222-439c-9cec-d124e83a7f38",
                                "sense_id": "a369ff45-56ab-3e1f-8c7b-434069e8f393",
                                "text": "- Voor het feit dat rond diezelfde tijd door botsende zwermen puin onze aarde werd gevormd - een door lava overspoelde onbewoonbare rots, die door de zwaartekracht toevallig als derde planeet in een baan rond de zon werd gebracht - precies op de juiste afstand (0,38 tot 1 astronomische eenheden) voor het ontstaan van leven."
                            }
                        ]
                    }
