                        ],
                        "form": "tonneliers"
                    },
                    {
                        "form_id": "48683adc-b506-46dc-af25-38715ba202c9",
                        "entry_id": "a5f36642-384c-3879-864c-00c8b0187dc7",
                        "tags": [
                            "feminine"
                        ],
                        "form": "tonnelière"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5effbc28-3e5f-320c-b711-a92eaf24b7b7",
                        "entry_id": "a5f36642-384c-3879-864c-00c8b0187dc7",
                        "glosses": [
                            "Celui qui fait et répare des tonneaux, qui vend des baquets, des bouteilles, des bouchons, etc., et qui se charge de mettre le vin en bouteilles."
                        ],
                        "tags": [
                            "Tonnellerie"
                        ],
                        "examples": [
                            {
                                "example_id": "2858e6c1-36b5-4390-a440-24c4ef22f4e3",
                                "sense_id": "5effbc28-3e5f-320c-b711-a92eaf24b7b7",
                                "text": "Le marteau des tonneliers fait retentir les voûtes de caves aériennes."
                            },
                            {
                                "example_id": "1dcff78b-195e-42bf-825a-ff81eda88cc9",
                                "sense_id": "5effbc28-3e5f-320c-b711-a92eaf24b7b7",
                                "text": "Si les corporations exclusivement féminines restent l’exception, les corporations mixtes qui admettent indistinctement les hommes et les femmes sont extrêmement nombreuses. Parmi celles-ci, il faut citer les drapiers, les tisserands, les grainiers (Rouen, Paris), les passementiers (Paris, Tours, Clermont), les cabaretiers (Tours, Orléans), les tonneliers (Nîmes), les tailleurs (Coutances, Angoulême, Dijon), les boulangers (Orléans, Paris), les merciers (Paris, Caen), les poissonniers (Paris, Dijon), les imprimeurs (Paris, Orléans, Caen), les limonadiers (Caen), les maçons (Apt), les corroyeurs (Annonay), les orfèvres (Lyon), les chaudronniers (Orléans), les charcutiers."
                            },
                            {
                                "example_id": "4cb2bf72-c9c4-4cac-963d-927aa2e2a8dc",
                                "sense_id": "5effbc28-3e5f-320c-b711-a92eaf24b7b7",
                                "text": "A la fin du xixᵉ siècle, c'est toute une population qui vit du hareng à Boulogne-sur-Mer: outre les équipages de la centaine de harenguiers, il y a les saleurs, les fileuses, les tonneliers qui concourent à cet âge d'or."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "515a0c06-3d3b-4674-8168-c2b2511312ca",
                        "source_entry_id": "a5f36642-384c-3879-864c-00c8b0187dc7",
                        "source_sense_id": "5effbc28-3e5f-320c-b711-a92eaf24b7b7",
                        "target_lang_word": "Küfer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Küfer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bfdef6e2-42a0-33f1-b12f-3426ea035c85",
                                        "entry_id": "c0bad17f-daa4-30f4-9c72-aa3e09059745",
                                        "glosses": [
                                            "Person, die beruflich Fässer und andere Holzgefäße herstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6a17af3-06b2-4eaf-81d8-5cbe5ed8694e",
                                                "sense_id": "bfdef6e2-42a0-33f1-b12f-3426ea035c85",
                                                "text": "Mein Großvater war Küfer."
                                            },
                                            {
                                                "example_id": "55ad0d1e-dbe0-413d-8822-30b20d76944e",
                                                "sense_id": "bfdef6e2-42a0-33f1-b12f-3426ea035c85",
                                                "text": "„An Land waren die Küfer besonders beansprucht worden.“"
                                            },
                                            {
                                                "example_id": "66a80169-dc02-4dd7-b9ef-aedf33c14d19",
                                                "sense_id": "bfdef6e2-42a0-33f1-b12f-3426ea035c85",
                                                "text": "„Die Küfer hämmern tagsüber und nachts aus schlanken Eichendauben die bauchigen blitzsauberen Fässer und ersetzen so, was altersschwach; was mit dem letzten Jahrgang gefüllt, ging weit in die Welt.“"
                                            },
                                            {
                                                "example_id": "6aee9c7b-510d-4af4-929f-a699a5fe2a90",
                                                "sense_id": "bfdef6e2-42a0-33f1-b12f-3426ea035c85",
                                                "text": "„Der Küfer, der seine Sorte wohl kannte, steckte einen Trichter in dieses Ungeheuer von Feldflasche und füllte es mit einem fast schwarzen Rotwein an.“"
                                            },
                                            {
                                                "example_id": "188d0116-7378-42f8-97f7-085e3ae78460",
                                                "sense_id": "bfdef6e2-42a0-33f1-b12f-3426ea035c85",
                                                "text": "„Der Küfer brachte Wein und trug dazu einen Teller mit Rauchfleisch und einem frischen Fisch auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dbbfaafd-407b-472f-a380-c3037ea55b91",
                        "source_entry_id": "a5f36642-384c-3879-864c-00c8b0187dc7",
