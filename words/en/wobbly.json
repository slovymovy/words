{
    "word_family": [
        "wobble",
        "wobbler",
        "wobbliness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8e7eeaba-6e6f-3b58-ae83-65a6346114f7",
                    "sense_definition": "Unsteady and tending to move from side to side in a way that shows a lack of balance.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "unsteady",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old wooden chair felt very <w>wobbly</w> when I sat down on it.",
                            "target_lang_translations": {
                                "ru": "Старый деревянный стул показался очень <w>шатким</w>, когда я на него сел."
                            }
                        },
                        {
                            "text": "He tried to fix the <w>wobbly</w> table by putting a piece of folded paper under one leg.",
                            "target_lang_translations": {
                                "ru": "Он попытался починить <w>шатающийся</w> стол, подложив под одну ножку кусок сложенной бумаги."
                            }
                        }
                    ],
                    "synonyms": [
                        "rickety",
                        "shaky",
                        "unstable",
                        "unsteady"
                    ],
                    "antonyms": [
                        "stable",
                        "steady",
                        "firm"
                    ],
                    "common_phrases": [
                        "wobbly table",
                        "wobbly chair",
                        "wobbly legs",
                        "wobbly bridge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неустойчивый и имеющий тенденцию качаться из стороны в сторону из-за отсутствия равновесия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шаткий",
                                "target_lang_sense_clarification": "о мебели или конструкциях"
                            },
                            {
                                "target_lang_word": "неустойчивый",
                                "target_lang_sense_clarification": "не имеющий твердой опоры"
                            },
                            {
                                "target_lang_word": "шатающийся",
                                "target_lang_sense_clarification": "который качается"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bd4976b6-dfa7-33bb-916e-01e0bdbd6065",
                    "sense_definition": "A sudden fit of anger or a tantrum.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "anger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The toddler had a massive <w>wobbly</w> in the middle of the supermarket because he couldn't have the toy.",
                            "target_lang_translations": {
                                "ru": "Малыш закатил жуткую <w>истерику</w> посреди супермаркета, потому что ему не купили игрушку."
                            }
                        },
                        {
                            "text": "If things don't go his way, he is likely to throw a <w>wobbly</w> and stop working.",
                            "target_lang_translations": {
                                "ru": "Если всё идет не по его плану, он, скорее всего, <w>психанёт</w> и бросит работу."
                            }
                        }
                    ],
                    "synonyms": [
                        "tantrum",
                        "meltdown",
                        "paddy",
                        "wobbler"
                    ],
                    "common_phrases": [
                        "throw a wobbly"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "primarily British and Australian"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапная вспышка гнева или истерика."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "истерика",
                                "target_lang_sense_clarification": "внезапный приступ гнева"
                            },
                            {
                                "target_lang_word": "псих",
                                "target_lang_sense_clarification": "разговорное, о потере самообладания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "31dd9eec-5d50-321f-9389-73069ad8fafb",
                    "sense_definition": "A member of the Industrial Workers of the World, a radical international labor union.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "labor_union",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was a proud <w>wobbly</w> who spent his life fighting for better working conditions.",
                            "target_lang_translations": {
                                "ru": "Он был гордым <w>воббли</w>, посвятившим жизнь борьбе за лучшие условия труда."
                            }
                        },
                        {
                            "text": "The history book describes the influence of the <w>wobbly</w> movement on early twentieth-century labor laws.",
                            "target_lang_translations": {
                                "ru": "В учебнике истории описывается влияние движения <w>воббли</w> на трудовое законодательство начала двадцатого века."
                            }
                        }
                    ],
                    "synonyms": [
                        "Wob"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Член организации «Индустриальные рабочие мира», радикального международного профсоюза."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воббли",
                                "target_lang_sense_clarification": "член профсоюза ИРМ"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}