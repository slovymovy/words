                "senses": [
                    {
                        "sense_id": "45dd9326-aab9-33b8-8ab6-d9fb20bee282",
                        "entry_id": "cf5a8a24-3e0f-3a3b-a241-339a2adda926",
                        "glosses": [
                            "pomocnik"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "cde2646a-0089-426a-88e3-254d03520448",
                                "sense_id": "45dd9326-aab9-33b8-8ab6-d9fb20bee282",
                                "text": "Rozsierdzona G. nakazała swym pomagierom nękać sąsiada telefonicznymi pogróżkami i żądać pieniędzy"
                            },
                            {
                                "example_id": "40837ed1-f6b8-4060-ab15-753e9aaf4520",
                                "sense_id": "45dd9326-aab9-33b8-8ab6-d9fb20bee282",
                                "text": "Głównym podręcznym był narzeczony, pan Barwicki. Lecz były również pomagiery drugorzędne, między innymi Hipolit Wielosławski i Cezary Baryka"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
