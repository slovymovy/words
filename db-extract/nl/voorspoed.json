        "nl-extract.jsonl": [
            {
                "entry_id": "ba4ccf75-6637-38f5-b4d4-f1e64f5f3428",
                "word": "voorspoed",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e7acf98c-ce46-36de-a470-8ac7b9638e15",
                        "entry_id": "ba4ccf75-6637-38f5-b4d4-f1e64f5f3428",
                        "glosses": [
                            "dat het goed gaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce3bf251-ac21-4bf4-94f5-faf01d75b3c2",
                                "sense_id": "e7acf98c-ce46-36de-a470-8ac7b9638e15",
                                "text": "Bij het huwelijk wensen wij het bruidspaar veel voorspoed en geluk."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c7e39ffc-b327-4e6d-91c1-29992dbb59d4",
                        "source_entry_id": "ba4ccf75-6637-38f5-b4d4-f1e64f5f3428",
                        "source_sense_id": "e7acf98c-ce46-36de-a470-8ac7b9638e15",
                        "target_lang_word": "Wohlergehen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wohlergehen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "832b6d4b-3fd5-385d-b7b1-46d7981afbd8",
                                        "entry_id": "71761296-f902-307c-8863-27992b6114cf",
                                        "glosses": [
                                            "Zustand, in dem sich jemand gut fühlt und sich in guter Verfassung befindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5e79acf-9022-4c48-a4db-ace12f00f52c",
                                                "sense_id": "832b6d4b-3fd5-385d-b7b1-46d7981afbd8",
                                                "text": "Ich sorge mich sehr um Marthas Wohlergehen."
                                            },
                                            {
                                                "example_id": "8d4fc293-05d5-4c2b-9b34-683f4eb2bc50",
                                                "sense_id": "832b6d4b-3fd5-385d-b7b1-46d7981afbd8",
                                                "text": "„Das Wohlergehen der Juden in der ‚Diaspora‘, wie man in Israel unser selbstgewähltes ‚Exil‘ nennt, interessiert Politiker vom seinem Schlage nur, wenn sie innenpolitisch damit punkten können.“"
                                            },
                                            {
                                                "example_id": "ac8f565c-2f2b-4a4b-b18d-5cf1973a97ab",
                                                "sense_id": "832b6d4b-3fd5-385d-b7b1-46d7981afbd8",
                                                "text": "„Meine Mutter wachte über das Wohlergehen der Zither strenger als über das Wohlergehen ihrer Nähmaschine.“"
                                            },
                                            {
                                                "example_id": "83332e8e-ce12-4e85-b1f9-9777235ccb94",
                                                "sense_id": "832b6d4b-3fd5-385d-b7b1-46d7981afbd8",
                                                "text": "[Coronapandemie 2021:] „Seit einem Jahr werden Kinder und Jugendliche als Pandemietreiber verunglimpft. Ihr Wohlergehen spielt keine Rolle.“"
                                            },
                                            {
                                                "example_id": "a10c1f54-263c-45c7-a5de-45330c5b687f",
                                                "sense_id": "832b6d4b-3fd5-385d-b7b1-46d7981afbd8",
                                                "text": "„Immer geht es dabei um Fragen nach dem Streben nach Glück, das, wenn es zum Streben nach Erfolg, Anerkennung, materiellem Wohlergehen missrät, mit Unglück, Depression, Ennui entgolten wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40e206af-1506-4e8a-927d-bb906e4e9571",
                        "source_entry_id": "ba4ccf75-6637-38f5-b4d4-f1e64f5f3428",
                        "source_sense_id": "e7acf98c-ce46-36de-a470-8ac7b9638e15",
                        "target_lang_word": "Wohl",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wohl",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8cc54425-96a6-36fa-a69c-2d8c9b5b1057",
                                        "entry_id": "fdb52d29-ebaf-370f-b363-2e1845db8e49",
                                        "glosses": [
                                            "Zustand des Gutgehens, körperlich und geistig, auch Gesundheit und Glück"
                                        ],
                                        "tags": [
                                            "auf den Einzelnen bezogen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79ac190f-cc77-4e00-b5a7-4a38ae0921b1",
                                                "sense_id": "8cc54425-96a6-36fa-a69c-2d8c9b5b1057",
                                                "text": "Die Kneipengänger riefen alle aus voller Brust: zum Wohl!"
                                            },
                                            {
                                                "example_id": "1a6bb134-aa62-4cd7-920b-a0a63bd9c5c5",
                                                "sense_id": "8cc54425-96a6-36fa-a69c-2d8c9b5b1057",
                                                "text": "Der Hirte kümmert sich nach dem unheilvollen Gewitter um das Wohl der Tiere."
                                            },
                                            {
                                                "example_id": "84488701-8d16-4204-8c3f-5875f15e7a2e",
                                                "sense_id": "8cc54425-96a6-36fa-a69c-2d8c9b5b1057",
                                                "text": "Vernachlässigung, psychische und körperliche Misshandlung: Immer mehr Kinder sind nach Einschätzung von Jugendämtern in ihrem Wohl gefährdet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "647ea7c3-40e1-3ace-81ef-5b4cd60ed9ec",
                                        "entry_id": "fdb52d29-ebaf-370f-b363-2e1845db8e49",
                                        "glosses": [
                                            "das Gute im Interesse der Masse, zum Beispiel Reichtum und (soziale) Stabilität"
                                        ],
                                        "tags": [
                                            "auf mehrere bezogen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99909768-a07f-4abf-a06a-36034764b5cc",
                                                "sense_id": "647ea7c3-40e1-3ace-81ef-5b4cd60ed9ec",
                                                "text": "Amtseid des Bundespräsidenten, der Kanzlerin, auch vor Antritt eines Ministeramtes (Grundgesetz, Artikel 56 und 64): Ich schwöre, daß ich meine Kraft zum Wohle des deutschen Volkes widmen, seinen Nutzen mehren, Schaden von ihm wenden, das Grundgesetz und die Gesetze des Bundes wahren und verteidigen, meine Pflichten gewissenhaft erfüllen und Gerechtigkeit gegen jedermann und -frau üben werde."
                                            },
                                            {
                                                "example_id": "31fb4a2a-ef90-4ae0-ad8c-3ae6eae14696",
                                                "sense_id": "647ea7c3-40e1-3ace-81ef-5b4cd60ed9ec",
                                                "text": "Der Mörder meinte: er habe den Mord zum Wohl der Gesellschaft begangen."
                                            },
                                            {
                                                "example_id": "15f614b1-3ad7-47d6-99c1-eace305a357a",
                                                "sense_id": "647ea7c3-40e1-3ace-81ef-5b4cd60ed9ec",
                                                "text": "Erneut gab es dort eine Zusammenkunft, bei der es um das Wohl und Wehe der sozialen Einrichtung ging."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45bd1882-d0a4-4c31-a738-e7503a4f30d5",
                        "source_entry_id": "ba4ccf75-6637-38f5-b4d4-f1e64f5f3428",
                        "source_sense_id": "e7acf98c-ce46-36de-a470-8ac7b9638e15",
                        "target_lang_word": "Wohlstand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wohlstand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "951ecab2-6662-3c42-9c85-fd4e8c65cd33",
                                        "entry_id": "6adaf4c7-7944-34ef-8691-a5644d2d727a",
                                        "glosses": [
                                            "gute wirtschaftliche Lage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "892e4235-dafe-44b1-bc42-749ec08c4c02",
                                                "sense_id": "951ecab2-6662-3c42-9c85-fd4e8c65cd33",
                                                "text": "„Ich neide anderen Menschen ihren Wohlstand nicht.“"
                                            },
                                            {
                                                "example_id": "4d81d02d-216e-4395-8663-a7f67a4f7a0d",
                                                "sense_id": "951ecab2-6662-3c42-9c85-fd4e8c65cd33",
                                                "text": "„Dieser Hof verschaffte ihr Wohlstand und Einfluss.“"
                                            },
                                            {
                                                "example_id": "2fd30c53-19b9-4581-864e-fbddd6195b45",
                                                "sense_id": "951ecab2-6662-3c42-9c85-fd4e8c65cd33",
                                                "text": "„Bei Renate war der Wohlstand ausgebrochen.“"
                                            },
                                            {
                                                "example_id": "2550827d-5f5b-4dc2-9bc7-92088ed0e782",
                                                "sense_id": "951ecab2-6662-3c42-9c85-fd4e8c65cd33",
                                                "text": "„Der neue Wohlstand und die Macht von Addis Abeba untergraben den Einfluss der Provinzfürsten zusätzlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "629e6b61-3ca4-4fd7-93ff-a417a1435102",
                        "source_entry_id": "ba4ccf75-6637-38f5-b4d4-f1e64f5f3428",
                        "source_sense_id": "e7acf98c-ce46-36de-a470-8ac7b9638e15",
                        "target_lang_word": "prosperity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prosperity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1ebb5d6-09fd-32e8-b1dd-34bae21e36f1",
                                        "entry_id": "2b72211a-5cad-32f7-90f0-e17398ea335f",
                                        "glosses": [
                                            "The condition of being prosperous: having good fortune and a fortune."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0927d78-62df-4d6a-b391-45a4171fdb37",
                                                "sense_id": "d1ebb5d6-09fd-32e8-b1dd-34bae21e36f1",
                                                "text": "Near-synonym: thriving"
                                            },
                                            {
                                                "example_id": "3d281ed2-658e-4d33-89ed-37980f85246b",
                                                "sense_id": "d1ebb5d6-09fd-32e8-b1dd-34bae21e36f1",
                                                "text": "“Eating meat means prosperity in the coming year,” the roastery wrote on Weibo on February 5, days before the Lunar New Year began."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1799f66c-fd31-4cd4-aac8-6b6d677c4752",
                        "source_entry_id": "ba4ccf75-6637-38f5-b4d4-f1e64f5f3428",
                        "source_sense_id": "e7acf98c-ce46-36de-a470-8ac7b9638e15",
                        "target_lang_word": "prospérité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prospérité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e225935d-c885-3691-8ec7-49ba6e3f0db4",
                                        "entry_id": "7479ada2-3b80-3bff-b2e1-16bba1e6ecf7",
                                        "glosses": [
                                            "Heureux état, heureuse situation, soit des affaires générales, soit des affaires particulières."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f360882-c805-454d-8bfb-87ef7774f057",
                                                "sense_id": "e225935d-c885-3691-8ec7-49ba6e3f0db4",
                                                "text": "Les divers états de prospérité ou de dépérissement d'une Nation agricole, offrent une multitude d'autres données, dont chacune est le fondement d'un calcul particulier qui lui est propre en toute rigueur."
                                            },
                                            {
                                                "example_id": "3d567ee7-beb8-4391-8354-5f2d6ddf217a",
                                                "sense_id": "e225935d-c885-3691-8ec7-49ba6e3f0db4",
                                                "text": "J'ai connu l'Amérique de la prospérité. J'ai connu cette confiance, cette certitude, cet orgueil. J'ai connu ce peuple qui croyait, de bonne foi, monter tout entier vers une stratosphère paradisiaque."
                                            },
                                            {
                                                "example_id": "41a1cad0-9899-4f10-a4a5-8cba48c30103",
                                                "sense_id": "e225935d-c885-3691-8ec7-49ba6e3f0db4",
                                                "text": "Elle ne devint catastrophe que dans sa troisième phase, quand soudain, au milieu d'un ciel serein, la foudre du krach bancaire de New-York frappa l'édifice orgueilleux de la prospérité du capital américain."
                                            },
                                            {
                                                "example_id": "89801814-1297-4dbc-a5f7-62b3ad8540e3",
                                                "sense_id": "e225935d-c885-3691-8ec7-49ba6e3f0db4",
                                                "text": "Les paysans du Lot, il y a vingt ans, étaient misérables, accablés par les hypothèques dont une prospérité relative, survenue à la suite de la guerre, les libéra."
                                            },
                                            {
                                                "example_id": "7cc54715-e42a-48a1-a634-ecb3ba289ef0",
                                                "sense_id": "e225935d-c885-3691-8ec7-49ba6e3f0db4",
                                                "text": "La vie urbaine dépérit et, comme la civilisation islamique médiévale était elle-même essentiellement urbaine et que la richesse matérielle dépendait du commerce, la prospérité déclina."
                                            },
                                            {
                                                "example_id": "86f84627-2a8e-45c9-a8f6-53b8e4d56b18",
                                                "sense_id": "e225935d-c885-3691-8ec7-49ba6e3f0db4",
                                                "text": "Du même coup, Épernay passe de 4.000 habitants vers 1850 à 20.000 vers 1900, à 23.000 de nos jours, entraînant dans sa prospérité ses voisines Ay, Dizy, Magenta."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e232d335-2a0d-3d24-8754-6e30e3744bb4",
                                        "entry_id": "7479ada2-3b80-3bff-b2e1-16bba1e6ecf7",
                                        "glosses": [
                                            "Événements heureux."
                                        ],
                                        "tags": [
                                            "dated",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d44d8c21-691b-44b6-8b60-9fd0f0e9f680",
                                                "sense_id": "e232d335-2a0d-3d24-8754-6e30e3744bb4",
                                                "text": "Rien n’a interrompu le cours de ses prospérités. - Je vous souhaite toute sorte de prospérités."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
