                    },
                    {
                        "translation_id": "47890d5f-7802-4627-9708-74713ff05892",
                        "source_entry_id": "6b8fa16f-4d37-3e3f-b492-1282a0b1ae7a",
                        "source_sense_id": "1b07b165-a666-3461-bc80-c5c2fba26369",
