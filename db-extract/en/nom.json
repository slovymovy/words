                "senses": [
                    {
                        "sense_id": "4f3c3b1a-1adf-3c54-8ec8-e652a41d82d2",
                        "entry_id": "f07cd6c0-7bfc-3d28-9368-9c5eb1723d83",
                        "glosses": [
                            "nominate (“提名”) 的截斷形式"
                        ],
                        "tags": [
                            "form-of",
                            "informal",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "509e69e5-67f6-42f1-a661-57a2d93f1427",
                                "sense_id": "4f3c3b1a-1adf-3c54-8ec8-e652a41d82d2",
                                "text": "I have a little request to make. When you kids nom, do you think you could make clear who it is you're nomming -- and maybe even include the article headers for the voters (and the judge) -- many of whom are not psychics?",
                                "translation": "我有一個小小的請求。當你們這些孩子提名時，你們能不能清楚說明你們提名的是誰——也許甚至為投票者（和評委）附上文章標頭，因為他們中很多人並不是會讀心術的靈媒？"
                            },
                            {
                                "example_id": "25d0cffc-a1a4-42cb-bb0d-023398837ca5",
                                "sense_id": "4f3c3b1a-1adf-3c54-8ec8-e652a41d82d2",
                                "text": "Quite a big percentage of the anagrams posted here get nommed - IMO it should only be around 20% or so.",
                                "translation": "在這裡發布的易位構詞中，有相當大一部分被提名了——依我看，應該只有大約20%左右。"
                            },
                            {
                                "example_id": "7f6d21c6-c68c-4d22-aed7-250204074a7b",
                                "sense_id": "4f3c3b1a-1adf-3c54-8ec8-e652a41d82d2",
                                "text": "Emmy-nommed composer Robert Prince died March 4 in Los Angeles after a brief illness.",
                                "translation": "曾獲艾美獎提名的作曲家羅伯特·普林斯在短暫患病後於3月4日在洛杉磯去世。"
                            }
                        ]
                    }
