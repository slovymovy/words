                                "target_senses": [
                                    {
                                        "sense_id": "ca3cd6a8-b253-3541-8a9c-91eabcd8f64f",
                                        "entry_id": "01c3341c-10fd-3360-992a-b6d268a906eb",
                                        "glosses": [
                                            "Divinité marine descendant du dieu Triton, représentée avec une figure humaine et une queue de poisson dont l’attribut est une conque au son retentissant."
                                        ],
                                        "tags": [
                                            "Mythologie grecque"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd9d6849-0dc0-4961-bbc2-bacfcc5dcd1a",
                                                "sense_id": "ca3cd6a8-b253-3541-8a9c-91eabcd8f64f",
                                                "text": "L’allée des tilleuls s’interrompait, au niveau du rond-point occupé par le grand bassin au milieu duquel s’élevait un groupe de tritons et de néréides soufflant dans leurs conques pour former, lorsque jouaient les eaux, un diadème liquide, aux fleurons d’écume."
                                            },
                                            {
                                                "example_id": "69ee60ec-795f-4873-b10f-0ae44731db7d",
                                                "sense_id": "ca3cd6a8-b253-3541-8a9c-91eabcd8f64f",
                                                "text": "Louis XIV prouva l’estime qu’il réservait au maître de Toulon, à ce “bûcheur”, qui, avant d’orner ses parcs, avait décoré ses vaisseaux, dans l’orme et le tilleul, de tant d’atlantes, de tritons et de gigantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "099fb499-3d4f-3066-812e-024bb720ae29",
                                        "entry_id": "01c3341c-10fd-3360-992a-b6d268a906eb",
                                        "glosses": [
                                            "Équivalent masculin des sirènes ; créature mi-homme, mi-poisson."
                                        ],
                                        "tags": [
                                            "Fantastique"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "add38c43-5d5a-3cf1-8ebc-e828202bf8bd",
                                        "entry_id": "01c3341c-10fd-3360-992a-b6d268a906eb",
                                        "glosses": [
                                            "Nageur."
                                        ],
                                        "tags": [
                                            "Par plaisanterie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3a72c085-0ff3-3a86-88d5-8ec502a9a105",
                                        "entry_id": "01c3341c-10fd-3360-992a-b6d268a906eb",
                                        "glosses": [
                                            "Appareil qui permettait à un plongeur de rester quelques minutes sous l’eau."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "triton",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5484fb73-ab16-36b7-9e40-2a10c5ad677e",
                                        "entry_id": "c5433765-b81c-3ba2-bf8f-c27c4e09129d",
                                        "glosses": [
                                            "Mollusque gastéropode (Charonia tritonis), de grande taille, enfermé dans une conque."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6781f582-55f5-3bfc-beb4-e9c82896a596",
                                        "entry_id": "c5433765-b81c-3ba2-bf8f-c27c4e09129d",
                                        "glosses": [
                                            "Amphibien voisin des salamandres, dont l’adulte a quatre pieds et une longue queue à section comprimée et passe beaucoup de temps dans l’eau."
                                        ],
                                        "tags": [
                                            "Batrachologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c54c161-1a60-489b-bb24-fefc4f205122",
                                                "sense_id": "6781f582-55f5-3bfc-beb4-e9c82896a596",
                                                "text": "Ce 2 septembre 2017, chacun découvre donc cette zone marécageuse avec tritons et azurés des paluds, un papillon dont la chenille se fait passer pour une fourmi afin de mieux squatter les fourmilières."
                                            }
                                        ]
                                    }
                                ]
                            },
