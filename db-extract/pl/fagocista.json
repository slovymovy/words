                    {
                        "translation_id": "fddf5616-b029-48f6-a93d-32cfe828a8c4",
                        "source_entry_id": "4e8f4afd-f9a1-38eb-9518-6118dcbac14e",
                        "source_sense_id": "4a996d24-5edb-3973-8c46-d1a62df99ea8",
                        "target_lang_word": "bassoniste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bassoniste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c903d104-72dc-3e57-8a65-31376afc9a0b",
                                        "entry_id": "9bb55cf8-7433-3d9c-95a0-e683c9b16b50",
                                        "glosses": [
                                            "Celui, celle qui joue du basson."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a25a3f1d-eb3d-4d37-9f0c-6c112fc56f83",
                                                "sense_id": "c903d104-72dc-3e57-8a65-31376afc9a0b",
                                                "text": "Sur 13 bassonistes demi-finalistes au concours international de Paris-Ville d’Avray en 2009, 13 jouaient du basson français, le fagott serait-il en voie de disparition?"
                                            },
                                            {
                                                "example_id": "b9d43d51-ce60-433b-8995-6f0aa02c1aba",
                                                "sense_id": "c903d104-72dc-3e57-8a65-31376afc9a0b",
                                                "text": "Émeline était bassoniste. On n’entend jamais le basson sans un autre instrument."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "daa079a8-9220-4635-99ed-afd534fae9d2",
                        "source_entry_id": "4e8f4afd-f9a1-38eb-9518-6118dcbac14e",
                        "source_sense_id": "4a996d24-5edb-3973-8c46-d1a62df99ea8",
                        "target_lang_word": "basson",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "basson",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2e9b4750-2e8c-3213-b06d-1c576215aa3b",
                                        "entry_id": "359f5b55-7c37-37fa-a743-63c39b27f2a6",
                                        "glosses": [
                                            "Instrument de musique à vent qui, dans les orchestres, sert à exécuter des parties de basse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee8faba6-efd8-47df-8267-941b08b7f59a",
                                                "sense_id": "2e9b4750-2e8c-3213-b06d-1c576215aa3b",
                                                "text": "Des chansons à boire de l’époque baroque ont été interprétées par le jeune ensemble Le Mystère, invité du Petit festival 2022 et composé de Marie Poupardin, dessus ; Quentin Fondecave, basson baroque et flûtes à bec ; Lætitia Schneider, théorbe et guitare ; Julie Dutoit, viole de gambe."
                                            },
                                            {
                                                "example_id": "70d2e126-ac10-46d2-91b4-d8a057558013",
                                                "sense_id": "2e9b4750-2e8c-3213-b06d-1c576215aa3b",
                                                "text": "Le basson qui, dans la famille des hautbois, tient le même rang que le violoncelle dans celle du violon, est un instrument indispensable dans la composition d’un orchestre, pour lier les différentes parties de l’harmonie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b027038-1f44-350b-87ee-ccea5656b547",
                                        "entry_id": "359f5b55-7c37-37fa-a743-63c39b27f2a6",
                                        "glosses": [
                                            "Musicien qui joue de cet instrument, bassoniste."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec522a72-73d7-44ad-a5e0-c56bb072f529",
                                                "sense_id": "8b027038-1f44-350b-87ee-ccea5656b547",
                                                "text": "C’est un excellent basson."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1af2d5f5-8861-306e-9c67-d89530d4d3e4",
                                        "entry_id": "359f5b55-7c37-37fa-a743-63c39b27f2a6",
                                        "glosses": [
                                            "Bruit qui rappelle le son de cet instrument de musique."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19e91ac9-85b7-41e2-b862-dcb24a8aec8a",
                                                "sense_id": "1af2d5f5-8861-306e-9c67-d89530d4d3e4",
                                                "text": "Nous montâmes l’escalier monumental du château, spirale de pierre grise dentelée de moquette cendrée, tandis que le basson du tonnerre plus rapproché accompagnait notre ascension."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
