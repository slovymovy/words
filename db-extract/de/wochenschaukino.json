                        "examples": [
                            {
                                "example_id": "129b84da-7d9a-4c4b-8379-2d6306629d56",
                                "sense_id": "defd0260-fdf7-3677-b1e5-2b9a880c8a3c",
                                "text": "Die ersten Wochenschaukinos entstanden in Frankreich."
                            },
                            {
                                "example_id": "cc0dbf7c-22bf-44e7-a3f0-da2e1dd90518",
                                "sense_id": "defd0260-fdf7-3677-b1e5-2b9a880c8a3c",
                                "text": "„Damit auch die Amerikaner schnellstens in den Genuss der Krönungsbilder kamen, brachen zwei Canberry-Bomber und ein zum Filmstudio umgewandeltes Stratosphärenflugzeug mit Filmmaterial nach Kanada und New York auf. Die dortigen Wochenschaukinos konnten wegen der Zeitverschiebung noch am Dienstagabend erste Bilder zeigen.“"
                            }
