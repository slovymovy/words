                        "glosses": [
                            "A snoring sound, implying that somebody is asleep."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b3dc7681-a0eb-46fa-b5f0-be8d20bd227f",
