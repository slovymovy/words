                            },
                            {
                                "target_word": "flatter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4539c2f8-33a3-382f-818a-6889e8a5dfd2",
                                        "entry_id": "a01f7ff6-8289-37b9-9ae8-35435e45927c",
                                        "glosses": [
                                            "To compliment someone, often (but not necessarily) insincerely and sometimes to win favour."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e98b91b9-795b-4f80-a28d-1ece2e1b04d3",
                                                "sense_id": "4539c2f8-33a3-382f-818a-6889e8a5dfd2",
                                                "text": "A man that flattereth his neighbour spreadeth a net for his feet."
                                            },
                                            {
                                                "example_id": "3cc100e0-a7df-4c94-956d-f1f79b7dc231",
                                                "sense_id": "4539c2f8-33a3-382f-818a-6889e8a5dfd2",
                                                "text": "1855, William H. Prescott, History of the Reign of Philip the Second, King of Spain, Boston: Phillips, Sampson & Co., Volume 1, Book 1, Chapter 7, p. 242,\nSome he complimented for their bravery; others he flattered by asking their advice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c39a8ca-8cff-31eb-a5f0-c1ccd9a2d485",
                                        "entry_id": "a01f7ff6-8289-37b9-9ae8-35435e45927c",
                                        "glosses": [
                                            "To enhance or gratify someone's vanity by praising them."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b58e2019-7306-3346-b140-75813b5f5e15",
                                        "entry_id": "a01f7ff6-8289-37b9-9ae8-35435e45927c",
                                        "glosses": [
                                            "To portray someone to advantage."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e8b855d-51b5-483a-b5f5-7c9f834f5f5b",
                                                "sense_id": "b58e2019-7306-3346-b140-75813b5f5e15",
                                                "text": "Her portrait flatters her."
                                            },
                                            {
                                                "example_id": "10aa02e9-877b-4160-a23d-eaaa8f540833",
                                                "sense_id": "b58e2019-7306-3346-b140-75813b5f5e15",
                                                "text": "Here is her picture: let me see; I think,\nIf I had such a tire, this face of mine\nWere full as lovely as is this of hers:\nAnd yet the painter flatter’d her a little […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1da82b2-f8ce-3248-b8c1-7cf2287ab4e7",
                                        "entry_id": "a01f7ff6-8289-37b9-9ae8-35435e45927c",
                                        "glosses": [
                                            "To encourage or cheer someone with (usually false) hope."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f4881eb-7cfc-4e47-a155-f96285c56c81",
                                                "sense_id": "d1da82b2-f8ce-3248-b8c1-7cf2287ab4e7",
                                                "text": "[…] I went up, and sat there two Hours and an half before I cou’d discern any Thing like Land; and when I first saw it I told my Comrade, but not being certain I wou’d not call out; for the Case was of such Importance, that they were not to be trifled with, or flatter’d into vain Hopes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7015f879-c24f-343b-a85b-95e3920698be",
                                        "entry_id": "a01f7ff6-8289-37b9-9ae8-35435e45927c",
                                        "glosses": [
                                            "To cheer or please (with the idea that); congratulate oneself, especially when the perception is false."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "reflexive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49cb5d07-4ec4-43b7-b8db-15aca01333bb",
                                                "sense_id": "7015f879-c24f-343b-a85b-95e3920698be",
                                                "text": "Before the results came out, I flattered myself that I had done well on the test. It turned out I was the worst in the class!"
                                            },
                                            {
                                                "example_id": "b7e2508f-fa6f-43c4-a2a7-94cb59b3c13f",
                                                "sense_id": "7015f879-c24f-343b-a85b-95e3920698be",
                                                "text": "The dire imagination she did follow\nThis sound of hope doth labour to expel;\nFor now reviving joy bids her rejoice,\nAnd flatters her it is Adonis’ voice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c343adce-8a45-3ffe-85e3-05684df41346",
                                        "entry_id": "a01f7ff6-8289-37b9-9ae8-35435e45927c",
                                        "glosses": [
                                            "To cheer or please (with the idea that); congratulate oneself, especially when the perception is false.",
                                            "In phrasal verb \\\"to flatter with\\\": to encourage, inspire with hope."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "intransitive",
                                            "obsolete",
                                            "reflexive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8ec3f6e-0c2a-4005-bb9d-7295389dc92c",
                                                "sense_id": "c343adce-8a45-3ffe-85e3-05684df41346",
                                                "text": "Run after that ſame peeuiſh Meſſenger / The Countes man: he left this Ring behinde him / Would I, or not: tell him, Ile none of it. / Deſire him not to flatter with his Lord, / Nor hold him vp with hopes, I am not for him:"
                                            }
                                        ]
                                    }
                                ]
                            },
