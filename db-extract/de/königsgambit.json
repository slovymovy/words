                "senses": [
                    {
                        "sense_id": "5edd2f1b-7a53-3c60-99b5-db636701cdce",
                        "entry_id": "57fcfe67-7602-3ffc-80d9-e3d5309fe8bc",
                        "glosses": [
                            "Eröffnung des Schachspiels mit 1. e4 e5 2. f4, in der Material geopfert wird, um Stellungsvorteile zu erlangen"
                        ],
                        "tags": [
                            "Schach"
                        ],
                        "examples": [
                            {
                                "example_id": "b48c7def-ed16-4dc4-9f8a-0b52ddb7b339",
                                "sense_id": "5edd2f1b-7a53-3c60-99b5-db636701cdce",
                                "text": "Das Königsgambit ist ohne Zweifel die berühmteste Schacheröffnung."
                            },
                            {
                                "example_id": "e6ae3eb9-27e1-46f7-b3cd-b1eeac2a0ca5",
                                "sense_id": "5edd2f1b-7a53-3c60-99b5-db636701cdce",
                                "text": "Beim Königsgambit wird durch ein Bauernopfer auf f4 das Zentrum mit den beiden Mittelbauern e4 und d4 schnell besetzt und damit im Zentrum ein Übergewicht aufgebaut."
                            },
                            {
                                "example_id": "cce9c41c-8441-4dbd-86de-ce512594ba9d",
                                "sense_id": "5edd2f1b-7a53-3c60-99b5-db636701cdce",
                                "text": "„Wer Königsgambit spielt, muss taktisch versiert sein und darf nicht am Material »kleben«.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
