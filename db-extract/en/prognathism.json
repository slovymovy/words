                                "target_senses": [
                                    {
                                        "sense_id": "84c126d0-a575-393b-86a7-fda55b055c9d",
                                        "entry_id": "a8c58047-d095-3167-91e7-9bf620050895",
                                        "glosses": [
                                            "Protrusión (deformación sobresaliente) en el plano vertical de la cara, ya sea en la parte inferior o en la superior de la mandíbula, causada por factores hereditarios o por alguna otra etiología. En la especie humana dificulta el habla, el dentelleo y la masticación."
                                        ],
                                        "tags": [
                                            "osteología"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "498fc1e6-1267-4a3c-b741-711f5409c514",
                                                "sense_id": "84c126d0-a575-393b-86a7-fda55b055c9d",
                                                "text": "Prognatismo. Es una extensión o protrusión del maxilar inferior (mandíbula). Ocurre cuando los dientes no están alineados de manera apropiada debido a la forma de los huesos de la cara. Consideraciones. El prognatismo puede causar oclusión dental defectuosa (desalineación de las superficies oclusoras de los dientes superiores e inferiores), lo que puede darle a las personas una apariencia de enfado o de peleador. El prognatismo puede ser un síntoma de diversos síndromes o afecciones"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
