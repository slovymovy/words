            "senses": [
                {
                    "sense_id": "ca9da7c4-ee13-3491-b5d5-372761acd31a",
                    "sense_definition": "Een metalen voorwerp in de vorm van een munt, meestal bedoeld als herinnering of onderscheiding.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onderscheiding",
                    "name_type": "no",
