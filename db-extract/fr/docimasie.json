                            },
                            {
                                "target_word": "assay",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31a55ef9-a255-3874-bfa9-f842183313cf",
                                        "entry_id": "cc3e706b-9040-34f1-a1f3-cb89334ae9a5",
                                        "glosses": [
                                            "To attempt (something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb13875a-3a84-48c1-86ab-a4d015c11d63",
                                                "sense_id": "31a55ef9-a255-3874-bfa9-f842183313cf",
                                                "text": "Who seest the stark array\nAnd hast not stayed to count\nBut singly wilt assay\nThe many-cannoned mount[…]."
                                            },
                                            {
                                                "example_id": "aaf34c81-40a8-42eb-915d-b63971bfd7e5",
                                                "sense_id": "31a55ef9-a255-3874-bfa9-f842183313cf",
                                                "text": "To-night let us assay our plot."
                                            },
                                            {
                                                "example_id": "62b6161a-b32a-4f8a-8612-4fb4eb12e689",
                                                "sense_id": "31a55ef9-a255-3874-bfa9-f842183313cf",
                                                "text": "Soft words to his fierce passion she assayed."
                                            },
                                            {
                                                "example_id": "7df1d2ef-ac53-4678-93f9-f4d66560aa60",
                                                "sense_id": "31a55ef9-a255-3874-bfa9-f842183313cf",
                                                "text": "Speaking before a small crowd beneath antique airplanes suspended in the atrium of the State of Iowa Historical Museum, an effortfully cheerful Mr Romney assayed an early version of a stump speech I imagine will become a staple of his campaign for the Republican nomination, once it \"officially\" begins some time next week in New Hampshire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c66fa93-eacf-3ea9-842a-465c3e0f20c1",
                                        "entry_id": "cc3e706b-9040-34f1-a1f3-cb89334ae9a5",
                                        "glosses": [
                                            "To try, attempt (to do something)."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2bfe890-39d3-47e3-93c7-07a568ff8b0e",
                                                "sense_id": "3c66fa93-eacf-3ea9-842a-465c3e0f20c1",
                                                "text": "When Saul cam to Jerusalem he assayde to cople hymsilfe with the apostles, and they wer all afrayde of hym and beleved not that he was a disciple."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "556a1a40-4cbb-3e1b-82d4-2bd69d4c32a0",
                                        "entry_id": "cc3e706b-9040-34f1-a1f3-cb89334ae9a5",
                                        "glosses": [
                                            "To analyze or estimate the composition or value of (a metal, ore etc.)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "90ea7403-f5e4-30b2-aaf7-01bd0aafe6b7",
                                        "entry_id": "cc3e706b-9040-34f1-a1f3-cb89334ae9a5",
                                        "glosses": [
                                            "To test the abilities of (someone) in combat; to fight."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ae40e36-27ed-4ce7-a4ee-e783ecd30d78",
                                                "sense_id": "90ea7403-f5e4-30b2-aaf7-01bd0aafe6b7",
                                                "text": "I wold not by my wille that ony of vs were matched with hym\nNay said sir Gawayne not so\nit were shame to vs were he not assayed were he neuer soo good a knyghte"
                                            },
                                            {
                                                "example_id": "705c62fb-8b91-4833-9dcf-e8bbf8b98adf",
                                                "sense_id": "90ea7403-f5e4-30b2-aaf7-01bd0aafe6b7",
                                                "text": "The marquis, in obsession for his wife,\nLonged to expose her constancy to test.\nHe could not throw the thought away or rest,\nHaving a marvellous passion to assay her;\nNeedless, God knows, to frighten and dismay her,\nHe had assayed her faith enough before\nAnd ever found her good; what was the need\nOf heaping trial on her, more and more?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1be4a2c-f8cb-325f-890f-e56ec76419ca",
                                        "entry_id": "cc3e706b-9040-34f1-a1f3-cb89334ae9a5",
                                        "glosses": [
                                            "To affect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "470c6c4a-c543-4ec5-88e3-fb953eb95e59",
                                                "sense_id": "d1be4a2c-f8cb-325f-890f-e56ec76419ca",
                                                "text": "when the heart is ill assay'd"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a150fa3-78cd-3115-922d-5979116b2648",
                                        "entry_id": "cc3e706b-9040-34f1-a1f3-cb89334ae9a5",
                                        "glosses": [
                                            "To try tasting, as food or drink."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
