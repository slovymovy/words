                "senses": [
                    {
                        "sense_id": "f619af96-a93d-3142-9888-d03f2e298ed0",
                        "entry_id": "985ae099-5d26-3274-a52b-bc94706f8b38",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным монархист"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7362fd43-45ea-4914-8187-e32397ea7bd8",
                        "source_entry_id": "985ae099-5d26-3274-a52b-bc94706f8b38",
                        "source_sense_id": "f619af96-a93d-3142-9888-d03f2e298ed0",
                        "target_lang_word": "monarchistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monarchistisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ff249ae8-8a85-32aa-8422-065ecd3797fe",
                                        "entry_id": "a7f021e0-d92d-3af5-9b5c-2f4d94ddadb2",
                                        "glosses": [
                                            "die Staatsform der Monarchie annehmend; eine monarchische Ordnung anstrebend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "970301a0-633c-441f-a9af-70ae3a5b31a6",
                                                "sense_id": "ff249ae8-8a85-32aa-8422-065ecd3797fe",
                                                "text": "„Doch besaß die Tradition der königlichen Macht in Frankreich im Jahre 1789 noch die Anerkennung des ganzen Volkes, abgesehen davon, dass Europa ringsum noch monarchistisch war.“"
                                            },
                                            {
                                                "example_id": "230f1bc6-4e84-4e32-8d19-f1c89585bfdd",
                                                "sense_id": "ff249ae8-8a85-32aa-8422-065ecd3797fe",
                                                "text": "„Zum weit überwiegenden Teil antidemokratisch und monarchistisch gesinnt, konnten diese Beamten an einer Befestigung der Republik und des republikanischen Denkens kaum ein Interesse haben.“"
                                            },
                                            {
                                                "example_id": "b7f337d0-f4c2-4b9d-bd02-156cc3b5dde2",
                                                "sense_id": "ff249ae8-8a85-32aa-8422-065ecd3797fe",
                                                "text": "„Er sei der Auffassung, daß die monarchistische Bewegung gerade in Bayern im Wachsen sei.“"
                                            },
                                            {
                                                "example_id": "f3467696-45bc-43a4-a499-8b18501435ce",
                                                "sense_id": "ff249ae8-8a85-32aa-8422-065ecd3797fe",
                                                "text": "„Und noch im November 1939 berichtet Victor Klemperer von monarchistischen Volksstimmungen.“"
                                            },
                                            {
                                                "example_id": "5aa06331-8a1c-492b-a1f3-ac9a78cc5965",
                                                "sense_id": "ff249ae8-8a85-32aa-8422-065ecd3797fe",
                                                "text": "„Im Falle eines Umsturzes würden die Mongolen die monarchistische Regierung anerkennen, wenn diese ihre Unabhängigkeit und das Abkommen mit Rußland anerkenne.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
