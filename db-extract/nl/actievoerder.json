                "senses": [
                    {
                        "sense_id": "54d6d982-ba13-3543-b292-39ecdc6fd8a5",
                        "entry_id": "af2189c8-094a-3be1-9fad-e987299fcafa",
                        "glosses": [
                            "iemand die deelneemt aan een actie (vaak gaat het om een politieke actie), activist."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "356b1129-742c-472d-b79f-e8e85f3c8385",
                                "sense_id": "54d6d982-ba13-3543-b292-39ecdc6fd8a5",
                                "text": "De actievoerder werd met geweld door de politie verwijderd."
                            },
                            {
                                "example_id": "eb7209ac-41af-4651-b341-48e06e06b7bc",
                                "sense_id": "54d6d982-ba13-3543-b292-39ecdc6fd8a5",
                                "text": "Ludiek verzet tegen de oorlog in Oekraïne is voor de Russische autoriteiten niet om te lachen. Rechtszaken tegen actievoerders zitten vol absurdisme, is te zien in een documentaire over de zaak tegen tekenaar Sasja Skotsjilenko."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bb09cfe7-c1c2-4e37-b40b-d6cafd57da3f",
                        "source_entry_id": "af2189c8-094a-3be1-9fad-e987299fcafa",
                        "source_sense_id": "54d6d982-ba13-3543-b292-39ecdc6fd8a5",
                        "target_lang_word": "Aktivist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aktivist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "85e03d8a-49a5-3a21-b1f7-71cd3ab9b4b2",
                                        "entry_id": "c25445d5-867f-3cab-972a-ccc1095e258d",
                                        "glosses": [
                                            "engagierte, zielbewusst häufig gesellschaftlich oder politisch handelnde Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "475edef3-74e4-4b1e-9428-3e1f8a45cbe6",
                                                "sense_id": "85e03d8a-49a5-3a21-b1f7-71cd3ab9b4b2",
                                                "text": "„Bei den Luftangriffen der US-geführten Koalition gegen die Dschihadistengruppe Islamischer Staat (IS) in Syrien sind nach Angaben von Aktivisten schon mehr als 550 Menschen getötet worden.“"
                                            },
                                            {
                                                "example_id": "cf055118-0ce3-4b80-9843-72ef9384ec6d",
                                                "sense_id": "85e03d8a-49a5-3a21-b1f7-71cd3ab9b4b2",
                                                "text": "Die Aktivisten fertigten Wahlplakate an."
                                            },
                                            {
                                                "example_id": "fdb0527f-7173-429d-9326-35438be04b0a",
                                                "sense_id": "85e03d8a-49a5-3a21-b1f7-71cd3ab9b4b2",
                                                "text": "„Schon seit Wochen berichten Aktivisten, wie sie von der Polizei eingeschüchtert werden, in Form von Hausdurchsuchungen oder Vorladungen.“"
                                            },
                                            {
                                                "example_id": "8784841a-42b0-48eb-ad5a-cfa183307f22",
                                                "sense_id": "85e03d8a-49a5-3a21-b1f7-71cd3ab9b4b2",
                                                "text": "„In der Metropole Berlin gab es ähnliche Veranstaltungen, aber meist auf lokale Initiative von Aktivisten hin.“"
                                            },
                                            {
                                                "example_id": "19dd26b1-3c52-4837-b63c-b88824214acd",
                                                "sense_id": "85e03d8a-49a5-3a21-b1f7-71cd3ab9b4b2",
                                                "text": "„Andere Aktivisten zünden im Bahnhof von Johannesburg eine Bombe, eine Frau stirbt.“"
                                            },
                                            {
                                                "example_id": "d70b73c2-432d-4bb6-8795-c3f9f9967cd7",
                                                "sense_id": "85e03d8a-49a5-3a21-b1f7-71cd3ab9b4b2",
                                                "text": "„Die niederländische Polizei hat am Morgen ein Lager propalästinensischer Aktivisten an der Universität von Amsterdam gewaltsam aufgelöst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "db58c053-6de3-339d-9389-cf17267e004a",
                                        "entry_id": "c25445d5-867f-3cab-972a-ccc1095e258d",
                                        "glosses": [
                                            "staatliche Auszeichnung, Kurzform für Aktivist der sozialistischen Arbeit, werktätige Person in der DDR, die Leistungen erbracht hat, die über die Normen und Vorgaben hinausgingen"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aec6096b-b248-4a04-955b-d8f7b664ae0a",
                                                "sense_id": "db58c053-6de3-339d-9389-cf17267e004a",
                                                "text": "In seinem Arbeitsleben war er bis 1989 dreimal Aktivist geworden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "49f76323-5d4e-40ac-9e29-237362ef445d",
                        "source_entry_id": "af2189c8-094a-3be1-9fad-e987299fcafa",
                        "source_sense_id": "54d6d982-ba13-3543-b292-39ecdc6fd8a5",
                        "target_lang_word": "activist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "activist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9371ea8c-22eb-3cf9-ac20-adca73a8d6d5",
                                        "entry_id": "2d8eec51-a98d-37a3-85f4-8fcbc54b18af",
                                        "glosses": [
                                            "One who is politically active in the role of a citizen; especially, one who campaigns for change."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d51dbc0-8b5a-4f81-8685-3742673278a8",
                                                "sense_id": "9371ea8c-22eb-3cf9-ac20-adca73a8d6d5",
                                                "text": "It has jailed environmental activists and is planning to limit the power of judicial oversight by handing a state-approved body a monopoly over bringing environmental lawsuits."
                                            },
                                            {
                                                "example_id": "3987b315-eb54-4a92-87a4-8b07106648c0",
                                                "sense_id": "9371ea8c-22eb-3cf9-ac20-adca73a8d6d5",
                                                "text": "The six activists will now face a retrial at Highbury Magistrates' Court, in front of a new judge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "688bdc77-53e8-3b64-9ebb-e187cffb26a7",
                                        "entry_id": "2d8eec51-a98d-37a3-85f4-8fcbc54b18af",
                                        "glosses": [
                                            "One who is conspicuously active in carrying out any occupational or professional functions."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "activist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e230d134-d39d-3c3b-8280-1c31c0e7f6f2",
                                        "entry_id": "ba5970b6-e294-398c-90fe-26912fc94068",
                                        "glosses": [
                                            "Behaving as an activist."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86eb1319-2809-4571-af82-cc7118489603",
                                                "sense_id": "e230d134-d39d-3c3b-8280-1c31c0e7f6f2",
                                                "text": "Even in the area of free speech, Justice Harlan sometimes emerged as more activist than his brother"
                                            },
                                            {
                                                "example_id": "41cb93d1-ac0c-4d05-a68a-041573a01159",
                                                "sense_id": "e230d134-d39d-3c3b-8280-1c31c0e7f6f2",
                                                "text": "Now GM has what may well be the most activist board ever."
                                            },
                                            {
                                                "example_id": "87a8ad9b-2808-49a1-80c1-b561da93f64e",
                                                "sense_id": "e230d134-d39d-3c3b-8280-1c31c0e7f6f2",
                                                "text": "Gov. Chris Christie has long complained that New Jersey's Supreme Court is too liberal and too activist"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b402b0b-358e-406c-9a67-b7aa125e4203",
                        "source_entry_id": "af2189c8-094a-3be1-9fad-e987299fcafa",
                        "source_sense_id": "54d6d982-ba13-3543-b292-39ecdc6fd8a5",
                        "target_lang_word": "activiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "activiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0659af3a-9e86-359b-bc50-a43f9b00680e",
                                        "entry_id": "1715fd75-546c-3060-bcc0-9431457e5b3a",
                                        "glosses": [
                                            "Relatif à l’activisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb3b98ef-a1cf-455c-848a-02fc852b7adf",
                                                "sense_id": "0659af3a-9e86-359b-bc50-a43f9b00680e",
                                                "text": "Certains juges utiliseront déjà au XIXᵉ siècle la Constitution de manière activiste dans un certain nombre de décisions."
                                            },
                                            {
                                                "example_id": "d1a518d0-0a94-4fe6-b8ee-c76f8e69e106",
                                                "sense_id": "0659af3a-9e86-359b-bc50-a43f9b00680e",
                                                "text": "Il s’agit d’une organisation activiste, qui multiplie les opérations spectaculaires : commandos contre des fast-food halals, « apéros saucisson-pinard », ou manifestations musclées."
                                            },
                                            {
                                                "example_id": "e279fd94-3380-4304-975a-a65b1cdeb911",
                                                "sense_id": "0659af3a-9e86-359b-bc50-a43f9b00680e",
                                                "text": "L’OCML-VP pêche depuis longtemps par des tendances activistes, c’est à dire la tentation d’être présente dans toutes les luttes à la fois, même si cela est au-dessus de nos forces et entraîne surcharge et tensions."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "activiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dc6c8c04-d2d8-3380-b774-e6755a1d547d",
                                        "entry_id": "0ac2f7e7-ce9a-3139-8d1c-9c47dacb19ce",
                                        "glosses": [
                                            "Celui, celle qui pratique l’activisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c34106e6-57d9-48fc-b115-7f7b4d35efc8",
                                                "sense_id": "dc6c8c04-d2d8-3380-b774-e6755a1d547d",
                                                "text": "En fait, l’un des jurés devint lui-même un activiste en faveur des programmes d’échanges."
                                            },
                                            {
                                                "example_id": "eae19688-e759-424d-89d9-d784b0ff8490",
                                                "sense_id": "dc6c8c04-d2d8-3380-b774-e6755a1d547d",
                                                "text": "Une patricienne italienne peut ripoliner la façade de son présidentiel époux, et tenter, en vain, de dissimuler sa confondante vulgarité d’activiste, sa vraie nature pointe toujours."
                                            },
                                            {
                                                "example_id": "ea186bbd-46e1-4b76-a5f2-d814e7b755d5",
                                                "sense_id": "dc6c8c04-d2d8-3380-b774-e6755a1d547d",
                                                "text": "Le propriétaire d’une ferme laitière de Compton, en Estrie, a eu une bien mauvaise surprise samedi midi, quand trois activistes ont pénétré dans son étable, sans autorisation, et ont libéré plusieurs de ses vaches."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
