                "senses": [
                    {
                        "sense_id": "8fe058ff-4b43-3146-b045-4681b9e8e902",
                        "entry_id": "cfac2f5c-adae-35a0-ba22-3135a283485f",
                        "glosses": [
                            "traditionelles Fischgericht am Aschermittwoch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ca76b98-c689-4c9c-9532-7ed6278f8851",
                                "sense_id": "8fe058ff-4b43-3146-b045-4681b9e8e902",
                                "text": "„Sie serviert ihn mit Himbeeren, roten Rüben, Sauerklee, der Gaumen weiß nicht, ob Skandinavien oder Südamerika, Heringsschmaus oder Hochsommer, und so geht es weiter: Hirschherz, roh, mit Seeigel, Forellenkaviar und eingelegten Rübchen.“"
                            },
                            {
                                "example_id": "44456ae9-8ac6-43dc-a3c3-1e890fbdfbb9",
                                "sense_id": "8fe058ff-4b43-3146-b045-4681b9e8e902",
                                "text": "„Warum heißt es nun eigentlich Heringsschmaus?“"
                            },
                            {
                                "example_id": "bb4aee26-c1fe-447d-aa9c-1a84b662815d",
                                "sense_id": "8fe058ff-4b43-3146-b045-4681b9e8e902",
                                "text": "„Wolfgang Krivanec kredenzt einen japanischen Heringsschmaus […], etwa mit Miso, Heilbutt und Garnelen, auch mit Sake-Begleitung.“"
                            },
                            {
                                "example_id": "d1cf86e2-4d69-46be-817f-6fa8e38560eb",
                                "sense_id": "8fe058ff-4b43-3146-b045-4681b9e8e902",
                                "text": "„Zwei Rezepte für den Heringsschmaus am Aschermittwoch hat der Innsbrucker Haubenkoch Manfred Jabinger: Heringssalat ganz fein mit Roter Bete und Hering gebraten.“"
                            },
                            {
                                "example_id": "8b6492ca-0d76-4006-9aea-7a62f55fbfb3",
                                "sense_id": "8fe058ff-4b43-3146-b045-4681b9e8e902",
                                "text": "„Legendär bei den Promis waren sowohl die Faschingsfeste als auch die optisch hervorzuhebenden Heringsschmäuse.“"
                            },
                            {
                                "example_id": "2d1941a2-79f5-4916-85c0-249c1f19dcd2",
                                "sense_id": "8fe058ff-4b43-3146-b045-4681b9e8e902",
                                "text": "„Doch das große Schmausen der Faschingszeit dehnte sich über das Faschingsende hinaus aus – damit kamen auch üppige Heringsschmäuse in Mode.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
