                        "glosses": [
                            "Avantage comparatif, concurrentiel d’un produit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1b15fe3-05cf-4b16-b341-8be6d03c7f84",
                                "sense_id": "a53372fd-0004-36e3-81b7-7c944c9b50e0",
                                "text": "Confrontés à une baisse des recettes publicitaires, les journaux cherchent de nouveaux revenus et des moyens d’augmenter leur diffusion. Les plus-produits — livres, encyclopédies, DVD, CD… vendus avec les journaux avec un supplément de prix — en sont un."
                            }
                        ]
