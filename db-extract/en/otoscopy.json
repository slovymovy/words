                    },
                    {
                        "translation_id": "6e7fc8f9-4382-4a60-a7ee-dab5d7a0365e",
                        "source_entry_id": "72294893-0225-3681-a954-275285325cd5",
                        "source_sense_id": "7d5c5346-dbd1-3822-b3ad-79121ef2f169",
                        "source_sense_description": "Translations",
                        "target_lang_word": "Otoskopie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Otoskopie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "250f505b-0b06-366c-9858-4419acbdcdeb",
                                        "entry_id": "96f5ae30-270f-3d2b-aaa0-ab482b05137c",
                                        "glosses": [
                                            "„Betrachtung des äußeren Gehörganges und des Trommelfells“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c77b9258-79f4-4587-9c3d-ad4a3ead277d",
                                                "sense_id": "250f505b-0b06-366c-9858-4419acbdcdeb",
                                                "text": "„Vor der Otoskopie erfolgen Inspektion der Ohrmuschel und Palpation der Ohrmuschelumgebung, insbesondere des Warzenfortsatzes.“"
                                            },
                                            {
                                                "example_id": "ba0207ab-e766-45a2-97a1-46ee27d13501",
                                                "sense_id": "250f505b-0b06-366c-9858-4419acbdcdeb",
                                                "text": "„Bei der Otoskopie untersucht man den äußeren Gehörgang und das Trommelfell mittels eines Ohrtrichters bzw. eines Otoskops.“"
                                            },
                                            {
                                                "example_id": "0c7cb487-8402-4421-b6b5-7cdbfe95a3b1",
                                                "sense_id": "250f505b-0b06-366c-9858-4419acbdcdeb",
                                                "text": "„Durch die Otoskopie wird dann mit Hilfe des Stirnreflektors und des Ohrtrichters der Gehörgangs- und Trommelfellbefund erhoben.“"
                                            },
                                            {
                                                "example_id": "58c1a1d8-09f3-4cda-811d-dbfaba419743",
                                                "sense_id": "250f505b-0b06-366c-9858-4419acbdcdeb",
                                                "text": "„Durch Verengerung oder Verschluß des Gehörganges kann die Otoskopie erschwert oder unmöglich werden.“"
                                            },
                                            {
                                                "example_id": "e7b06ecb-6125-4abd-973c-0bb11e8708de",
                                                "sense_id": "250f505b-0b06-366c-9858-4419acbdcdeb",
                                                "text": "„Bei der Otoskopie fand ich zu meiner Überraschung symmetrische schlitzförmige beiderseitige Trommelfellperforationen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
