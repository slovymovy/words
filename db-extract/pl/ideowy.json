                                "target_senses": [
                                    {
                                        "sense_id": "9a5034b9-79f7-32ce-9046-81ffb40514d6",
                                        "entry_id": "ee9c34e7-fd10-3b9b-849a-ef455ded94ed",
                                        "glosses": [
                                            "Vowed; dedicated; consecrated."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc3b18ee-5c46-4f0a-9af7-b2cc3c919732",
                                                "sense_id": "9a5034b9-79f7-32ce-9046-81ffb40514d6",
                                                "text": "He describes the operation thus: \"The heavy ram employed to impart the finishing strokes, hoisted up with double purchase and snail's pace to the summit of the Piling Engine, and then falling down like a thunderbolt on the head of the devoted timber, driving it perhaps a single half inch in to the stratum below, is well calculated to put to the test the virtue of patience, while it illustrates the old adage of—slow and sure.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2e46d0a-7a3e-37c4-9239-bcc7aec78286",
                                        "entry_id": "ee9c34e7-fd10-3b9b-849a-ef455ded94ed",
                                        "glosses": [
                                            "Strongly emotionally attached; very fond of someone or something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d0e9eaa-88f9-4209-a75b-474c39ab707d",
                                                "sense_id": "e2e46d0a-7a3e-37c4-9239-bcc7aec78286",
                                                "text": "Bob and Sara are devoted to their children."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83803cc3-7b34-3848-9339-b1aebf7844d1",
                                        "entry_id": "ee9c34e7-fd10-3b9b-849a-ef455ded94ed",
                                        "glosses": [
                                            "Zealous; characterized by devotion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c3b3224-3839-3b3f-a07c-9d4a14c822f6",
                                        "entry_id": "ee9c34e7-fd10-3b9b-849a-ef455ded94ed",
                                        "glosses": [
                                            "Cursed; doomed."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b55757bb-db69-4c60-b699-71b21f846bf4",
                                                "sense_id": "6c3b3224-3839-3b3f-a07c-9d4a14c822f6",
                                                "text": "The attendance of that brother was now become like the attendance of a demon on some devoted being that had sold himself to destruction […]"
                                            },
                                            {
                                                "example_id": "9376e57f-bb4f-4bb9-ac8f-bfdb8a596205",
                                                "sense_id": "6c3b3224-3839-3b3f-a07c-9d4a14c822f6",
                                                "text": "The feelings of the crew now burst forth in the most extravagant transports. They had recently considered themselves devoted men, hurrying forwards to destruction; they now looked upon themselves as favorites of fortune, and gave themselves up to the most unbounded joy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
