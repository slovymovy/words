                                    },
                                    {
                                        "sense_id": "a952ed44-47cc-3a37-a66e-0cab69224907",
                                        "entry_id": "f48c868e-91bf-34a9-82e3-9a22975b8af1",
                                        "glosses": [
                                            "The part of a wave that has not yet broken."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7bc24a6-5b12-4ce5-8487-ea2bda521a7f",
                                                "sense_id": "a952ed44-47cc-3a37-a66e-0cab69224907",
                                                "text": "You see you're going to make it into the safety of the shoulder. It feels like the happiest day of your life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90fc0506-d9e7-340c-b38b-9043d207f760",
                                        "entry_id": "f48c868e-91bf-34a9-82e3-9a22975b8af1",
                                        "glosses": [
                                            "A season or a time of day when there is relatively little air traffic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "712a4ebf-9eee-41c2-ab97-d69bd2ecad05",
                                                "sense_id": "90fc0506-d9e7-340c-b38b-9043d207f760",
                                                "text": "For a round-trip journey starting from the UK during the shoulder period (1 April-30 June) […]"
                                            },
                                            {
                                                "example_id": "676129a4-92aa-4189-bf14-f8ed70f5f177",
                                                "sense_id": "90fc0506-d9e7-340c-b38b-9043d207f760",
                                                "text": "the determination of noise-induced disturbances during the shoulder hours and their consequences for the consecutive sleep period"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shoulder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9bb03816-0200-3ae0-a0fe-bffc65b2aec5",
                                        "entry_id": "b1a57b69-d538-317c-8d23-cda16b3b2561",
                                        "glosses": [
                                            "To push (a person or thing) using one's shoulder."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2a93947-666a-477c-835a-72e7c9baccf3",
                                                "sense_id": "9bb03816-0200-3ae0-a0fe-bffc65b2aec5",
                                                "text": "[…]As they the earth would ſhoulder from her ſeat,[…]"
                                            },
                                            {
                                                "example_id": "3ef626e0-89d5-4139-9ab3-f62e7035ec92",
                                                "sense_id": "9bb03816-0200-3ae0-a0fe-bffc65b2aec5",
                                                "text": "Around her numberless the rabble flowed, / Shouldering each other, crowding for a view."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e961b63-cf37-3a6d-a596-046853014cc2",
                                        "entry_id": "b1a57b69-d538-317c-8d23-cda16b3b2561",
                                        "glosses": [
                                            "To bully, manipulate or pull rank on (somebody)."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b8b27f0-d249-4638-8744-e55530757e43",
                                                "sense_id": "6e961b63-cf37-3a6d-a596-046853014cc2",
                                                "text": "He shouldered me out of my own band."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c78d6bb-5ff9-3bf5-955a-cc90a05d7f56",
                                        "entry_id": "b1a57b69-d538-317c-8d23-cda16b3b2561",
                                        "glosses": [
                                            "To put (something) on one's shoulders."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00a2ed4e-7839-4d60-bfba-650cd694fac7",
                                                "sense_id": "1c78d6bb-5ff9-3bf5-955a-cc90a05d7f56",
                                                "text": "Early in the morning they shouldered light packs, took their rifles, crossed the big draw, and entered the timber where was the deadfall."
                                            },
                                            {
                                                "example_id": "f8be4b64-e0b1-4a4f-ac25-031f57a4f149",
                                                "sense_id": "1c78d6bb-5ff9-3bf5-955a-cc90a05d7f56",
                                                "text": "Like a power clean, shouldering a sandbag — lifting it from the floor to your shoulder in one explosive movement — requires a coordinated effort from your core, upper body, and legs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85d2c4c9-7178-39a4-8899-c0fcdbac466a",
                                        "entry_id": "b1a57b69-d538-317c-8d23-cda16b3b2561",
                                        "glosses": [
                                            "To place (something) against one's shoulders."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32ae1519-8ae1-4bfd-83cd-5fd9949a4452",
                                                "sense_id": "85d2c4c9-7178-39a4-8899-c0fcdbac466a",
                                                "text": "All three sets are nicely sculptured along the bottom to prevent interference when shouldering your gun with proper shooting form."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd285f58-9124-3025-905c-678857799b69",
                                        "entry_id": "b1a57b69-d538-317c-8d23-cda16b3b2561",
                                        "glosses": [
                                            "To bear a burden, as a financial obligation."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2db59a32-ce10-4584-9729-ea6385c1133e",
                                                "sense_id": "dd285f58-9124-3025-905c-678857799b69",
                                                "text": "The shareholders were then shouldering a burden of liability out of proportion to their mere ownership of theoretical fractions of the business."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b4a577d-fbf1-303b-bc63-2978abf71dd4",
                                        "entry_id": "b1a57b69-d538-317c-8d23-cda16b3b2561",
                                        "glosses": [
                                            "To accept responsibility for."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27b45ad5-fb0c-4f6e-aff3-f65611c81782",
                                                "sense_id": "5b4a577d-fbf1-303b-bc63-2978abf71dd4",
                                                "text": "shoulder the blame"
                                            },
                                            {
                                                "example_id": "f19082d2-4051-4636-9639-db27f9f27531",
                                                "sense_id": "5b4a577d-fbf1-303b-bc63-2978abf71dd4",
                                                "text": "The former president has been forced to shoulder some of the blame for poor performances in key races, including in Pennsylvania, where his handpicked Republican candidate, Mehmet Oz, lost to Democrat John Fetterman in a contest that allowed Democrats to keep the Senate majority."
                                            },
                                            {
                                                "example_id": "6a92ca54-f1c7-4b24-8b2c-ce7d92e4bd3e",
                                                "sense_id": "5b4a577d-fbf1-303b-bc63-2978abf71dd4",
                                                "text": "She had a father before this and now she doesn’t have a father. And I shouldered that because if Meg wasn’t with me, then her dad would still be her dad."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2aa995b-aca3-3897-9624-d06d72c4d854",
                                        "entry_id": "b1a57b69-d538-317c-8d23-cda16b3b2561",
                                        "glosses": [
                                            "To form a shape resembling a shoulder."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d06bb592-ac61-40e7-b784-ff2590454051",
                                                "sense_id": "b2aa995b-aca3-3897-9624-d06d72c4d854",
                                                "text": "allowance at the bottom of blind bores for the chamfered tip of the reamer will obviate additional operations with shouldering or bottoming reamers to completely finish the entire length of a hole."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4c70cb4-a042-36a3-9331-114d41d461cb",
                                        "entry_id": "b1a57b69-d538-317c-8d23-cda16b3b2561",
                                        "glosses": [
                                            "To move by or as if by using one's shoulders."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23b69bf2-a760-46e4-99c4-f67ba2a189d2",
                                                "sense_id": "c4c70cb4-a042-36a3-9331-114d41d461cb",
                                                "text": "The sullen murmur of the bees shouldering their way through the long unmown grass, or circling with monotonous insistence round the dusty gilt horns of the straggling woodbine, seemed to make the stillness more oppressive."
                                            },
                                            {
                                                "example_id": "c9b3f0a8-047e-4ba8-849b-eb968c17d161",
                                                "sense_id": "c4c70cb4-a042-36a3-9331-114d41d461cb",
                                                "text": "[…]a yoke of the great sulky white bullocks […] came shouldering along together;"
                                            },
                                            {
                                                "example_id": "bc7deb03-6358-43f4-bb5f-d23e3aba2677",
                                                "sense_id": "c4c70cb4-a042-36a3-9331-114d41d461cb",
                                                "text": "He had seen them in the beer halls, shouldering up to the head of the queues"
                                            },
                                            {
                                                "example_id": "b355378a-7785-4b5c-b901-2ed4d5e0bd8e",
                                                "sense_id": "c4c70cb4-a042-36a3-9331-114d41d461cb",
                                                "text": "Mr. Wagstaff strolled with me along the wooded arm of land shouldering northwards from Bethlehem Bay."
