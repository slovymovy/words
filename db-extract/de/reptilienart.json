                ],
                "senses": [
                    {
                        "sense_id": "8040cdd9-4813-38c0-aa81-6dcec56f585d",
                        "entry_id": "9edec40d-ad0e-31ff-b49e-86f2d8cbd40f",
                        "glosses": [
                            "Art von Landwirbeltieren, die mit Hornplatten oder Schuppen bedeckt sind (= Reptilien)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc84251a-e17a-4173-96e5-e0ec0939f6d4",
                                "sense_id": "8040cdd9-4813-38c0-aa81-6dcec56f585d",
                                "text": "„Jede fünfte Reptilienart ist vom Aussterben bedroht.“"
                            },
                            {
                                "example_id": "b6d91983-011a-40b4-9618-73cf0948fdfe",
                                "sense_id": "8040cdd9-4813-38c0-aa81-6dcec56f585d",
                                "text": "„Besonders gefährdet sind Reptilienarten in Südostasien, Westafrika, der Andenregion und der Karibik, weniger in Nordeuropa.“"
                            },
                            {
                                "example_id": "01b64ba2-b4c6-459c-80e7-d7637aaf82f2",
                                "sense_id": "8040cdd9-4813-38c0-aa81-6dcec56f585d",
                                "text": "„Weltweit gibt es wohl mehr als 11.000 Reptilienarten.“"
                            },
                            {
                                "example_id": "2956a2db-1f1c-4980-ac35-0d7e61799b2a",
                                "sense_id": "8040cdd9-4813-38c0-aa81-6dcec56f585d",
                                "text": "„Aktuell sind um die 11.500 Reptilienarten bekannt.“"
                            },
                            {
                                "example_id": "5d8a67dd-8797-4747-8890-cb228a5385bb",
                                "sense_id": "8040cdd9-4813-38c0-aa81-6dcec56f585d",
                                "text": "„Vor 65 Millionen Jahren wurden die Dinosaurier und die Mehrzahl aller Tierarten durch eine Katastrophe ausgelöscht. Aber nicht alle Reptilienarten fielen ihr zum Opfer: Die Vorfahren der Echsen, Schlangen, Schildkröten und Krokodile überlebten.“"
                            },
                            {
                                "example_id": "7226c3f9-2b8a-4040-bc69-4cded53cfbfe",
                                "sense_id": "8040cdd9-4813-38c0-aa81-6dcec56f585d",
                                "text": "„Der Sandfisch ist eine rund 15 Zentimeter lange Reptilienart, die in der Sahara zuhause ist.“"
                            },
                            {
                                "example_id": "86702c88-f093-448c-913d-3925b4b2595e",
                                "sense_id": "8040cdd9-4813-38c0-aa81-6dcec56f585d",
                                "text": "„Das Pantanal ist reich an Säugetier-, Vogel- und Reptilienarten.“"
                            },
                            {
                                "example_id": "3f55dcb6-b8bd-481a-877d-2df9c9190e97",
                                "sense_id": "8040cdd9-4813-38c0-aa81-6dcec56f585d",
                                "text": "[Mississippi:] „Bald beginnen dann die Sümpfe des Südens, in denen sich der Strom in einem Labyrinth aus Wasserwegen, Inseln, Buchten und Feuchtgebieten zu verlieren scheint. Sie sind die Heimat von 270 Vogelarten und rund 65 Amphibien- und Reptilienarten.“"
                            },
                            {
                                "example_id": "16b663ce-5398-4fb5-9901-45772fbd773b",
                                "sense_id": "8040cdd9-4813-38c0-aa81-6dcec56f585d",
                                "text": "„Jede zweite Amphibienart und mehr als zwei Drittel der Reptilienarten sind laut RLZ bestandsgefährdet. Bei allen Reptilien- und fast allen Amphibienarten sei der Bestand in den vergangenen 120 Jahren zurückgegangen.“"
                            },
                            {
                                "example_id": "7a0cbf29-35ee-427e-a9dd-c4af263d2c09",
                                "sense_id": "8040cdd9-4813-38c0-aa81-6dcec56f585d",
                                "text": "„Was die australischen Wissenschaftler beunruhigt – die Katzen gefährden so den Bestand von elf ohnehin schon bedrohten Reptilienarten auf dem Kontinent.“"
                            },
                            {
                                "example_id": "013d3b53-69f8-45af-947c-4c01e21a06f8",
                                "sense_id": "8040cdd9-4813-38c0-aa81-6dcec56f585d",
                                "text": "„Auf der Artenschutzkonferenz beschlossen die Delegierten nun den Schutz von 55 Reptilienarten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
