                        "source_sense_id": "ce7d2580-c0a5-3c27-80c2-257a2165a63a",
                        "source_sense_description": "zeichnerische Darstellung der Vorder- oder Seitenansicht eines Gebäudes oder eines Objektes",
                        "target_lang_word": "projection",
