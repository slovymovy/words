                ],
                "senses": [
                    {
                        "sense_id": "2f323e7e-3175-3ea4-90c7-d4b4f7abd047",
                        "entry_id": "5f2a3c11-881d-389d-b382-9c8d55eb6cdc",
                        "glosses": [
                            "Angehöriger eines fiktiven außerirdischen Volkes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e940cd6-10d3-4533-897f-d2e57fe9caf9",
                                "sense_id": "2f323e7e-3175-3ea4-90c7-d4b4f7abd047",
                                "text": "„Und deshalb zerren sie mich aus dem Bett? Weil die Klingonen wütend sind?“ Er sah zu Cooper. „Notieren sie das, Commander: Die Klingonen sind wütend.“"
                            },
                            {
                                "example_id": "ca2dd8c3-7aba-407e-aeb7-7d68209b6cd8",
                                "sense_id": "2f323e7e-3175-3ea4-90c7-d4b4f7abd047",
                                "text": "„Buchberger erzählt, dass der Sprachenerfinder fortan behauptet, er habe einen Klingonen in seinem Keller gefangen und dieser teile ihm immer wieder neue Wörter mit. Klingonisch – ein einziges Fantasiegebilde und ein Riesenspaß?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be8c040a-60d7-41fb-9ba7-6e0bebd68624",
                        "source_entry_id": "5f2a3c11-881d-389d-b382-9c8d55eb6cdc",
                        "source_sense_id": "2f323e7e-3175-3ea4-90c7-d4b4f7abd047",
                        "source_sense_description": "Angehöriger eines fiktiven außerirdischen Volkes",
                        "target_lang_word": "Klingon",
