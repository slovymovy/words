                "senses": [
                    {
                        "sense_id": "01c30aa8-9541-3fd1-9452-5727bb6817ca",
                        "entry_id": "4cfa73c7-12eb-33d0-968c-866794bf6cbf",
                        "glosses": [
                            "Felswand, die besonders steil ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a551b4a-a1be-464b-9fb8-d3ca68fa912c",
                                "sense_id": "01c30aa8-9541-3fd1-9452-5727bb6817ca",
                                "text": "Sie hatten großen Probleme, die Steilwand zu überwinden."
                            },
                            {
                                "example_id": "c52bb645-66bd-4349-b829-feedbff0e904",
                                "sense_id": "01c30aa8-9541-3fd1-9452-5727bb6817ca",
                                "text": "„Wir ließen das Auto zurück und gingen zu Fuß am nackten Fels entlang den Berg hinauf, kletterten eine Steilwand hoch und klammerten uns dabei an eine im Fels befestigte Kette.“"
                            },
                            {
                                "example_id": "e5bf34ad-2c29-455c-8e10-2ffae8db3b31",
                                "sense_id": "01c30aa8-9541-3fd1-9452-5727bb6817ca",
                                "text": "„Nach einer Viertelstunde hatten Harbert, der Reporter und Pencroff das Ende der Steilwand erreicht, der sie bei ihrem Wettlauf mit dem Sturm immer ausgewichen waren und verschnauften.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
