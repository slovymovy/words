                        "form": "der Jungsteinzeit"
                    },
                    {
                        "form_id": "da356210-2ac7-4ff3-a0fc-ae8ec1692abb",
                        "entry_id": "e1bc56c9-2f9a-37a3-a0cd-241f61797984",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Jungsteinzeit"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e1ca327f-e2ca-3b35-9b79-545309a84b22",
                        "entry_id": "e1bc56c9-2f9a-37a3-a0cd-241f61797984",
                        "glosses": [
                            "Epoche der Menschheitsgeschichte, die als letzter Abschnitt der Steinzeit angesehen wird und durch die Entwicklung von frühen Siedlungen, Landwirtschaft, Domestikation von Wildtieren und Religion gekennzeichnet ist."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "adfbf65b-c5a0-4b1e-8f6b-50f247325a3c",
                                "sense_id": "e1ca327f-e2ca-3b35-9b79-545309a84b22",
                                "text": "„Doch dann, mit Beginn der Jungsteinzeit vor 10.000 Jahren, explodierte die Menschenzahl – um das 1000-Fache in nur 500 Generationen.“"
                            },
                            {
                                "example_id": "2dda3c56-fb5e-40cc-9f59-9d3cb0136da1",
                                "sense_id": "e1ca327f-e2ca-3b35-9b79-545309a84b22",
                                "text": "„Bereits in der Jungsteinzeit entdeckte man die hervorragende Eignung des hiesigen Basalts für das Mahlen von Getreide.“"
                            },
                            {
                                "example_id": "1040a4d2-c36d-4518-9400-e338290301fa",
                                "sense_id": "e1ca327f-e2ca-3b35-9b79-545309a84b22",
                                "text": "„Die ersten Exemplare entstanden in der Jungsteinzeit, dabei handelt es sich um mächtige Erd- oder Steinpackungen über Großsteingräbern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "182e2819-9515-4ebf-aded-44f302ab7e48",
                        "source_entry_id": "e1bc56c9-2f9a-37a3-a0cd-241f61797984",
                        "source_sense_id": "e1ca327f-e2ca-3b35-9b79-545309a84b22",
                        "target_lang_word": "Neolithic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Neolithic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78123630-a495-37c9-93bc-e9f0d6f58cca",
                                        "entry_id": "4df7041f-91cc-309f-aecb-6f8457004d29",
                                        "glosses": [
                                            "The period of prehistory from circa 8500 to 4500 BCE."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fc8994e-a9b7-4e27-b6a0-d9f2ac5964dd",
                                                "sense_id": "78123630-a495-37c9-93bc-e9f0d6f58cca",
                                                "text": "Holonyms: Stone Age < prehistory"
                                            },
                                            {
                                                "example_id": "b54759b4-1a46-4b62-89c3-83cd19372033",
                                                "sense_id": "78123630-a495-37c9-93bc-e9f0d6f58cca",
                                                "text": "Meronyms: Pre-Pottery Neolithic, Pre-Pottery Neolithic A, Pre-Pottery Neolithic B"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Neolithic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "506f9890-f7f2-3e0b-8f7d-f87bd3a99e09",
                                        "entry_id": "89b7dad1-fa5c-3133-b6fa-b0429be7fab9",
                                        "glosses": [
                                            "Of or relating to the New Stone Age."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a76275c7-dd24-4507-9e66-be120fc0eade",
                                                "sense_id": "506f9890-f7f2-3e0b-8f7d-f87bd3a99e09",
                                                "text": "Tokens are first identified at around the same time as the local peoples changed from a life based on hunting and gathering to one based on agriculture. The tokens, as Schmandt-Besserat says, \"were part and parcel of the Neolithic phenomenon; that is, the so-called agricultural revolution.\" (Before Writing 41)."
                                            },
                                            {
                                                "example_id": "3c256d5a-9d38-40ed-870f-79461026426d",
                                                "sense_id": "506f9890-f7f2-3e0b-8f7d-f87bd3a99e09",
                                                "text": "... I was fascinated by a pair of stories about a Neolithic girl who wrote the first letter, and invented the first alphabet."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Neolithic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "795fe14c-09b0-38dd-a1ab-759823be052e",
                                        "entry_id": "9cecb260-8003-31ab-8112-1f129c462dec",
                                        "glosses": [
                                            "A person who lived during the New Stone Age."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5040be65-028b-4b86-8d0f-f0d570b4978c",
                                                "sense_id": "795fe14c-09b0-38dd-a1ab-759823be052e",
                                                "text": "For the Neolithics, the stone was flint, and it's still impressive to see what they were able to achieve with it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "302d25c2-c693-473d-8cdc-1e508a33c837",
                        "source_entry_id": "e1bc56c9-2f9a-37a3-a0cd-241f61797984",
                        "source_sense_id": "e1ca327f-e2ca-3b35-9b79-545309a84b22",
                        "target_lang_word": "Néolithique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Néolithique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ae3d785-3a69-3751-89f2-19f45001c338",
                                        "entry_id": "2293458b-94f4-3995-bbbf-de72830c43b5",
                                        "glosses": [
                                            "Dernière période de l’âge de pierre."
                                        ],
                                        "tags": [
                                            "Préhistoire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9cde875-5f28-4e2a-a54e-cbcc1144f925",
                                                "sense_id": "0ae3d785-3a69-3751-89f2-19f45001c338",
                                                "text": "Au Néolithique se développe un culte des crânes, pour créer et maintenir un lien avec les entités de l'autre monde."
                                            },
                                            {
                                                "example_id": "8ec38a4a-2299-4d86-8bde-23a76580ad2c",
                                                "sense_id": "0ae3d785-3a69-3751-89f2-19f45001c338",
                                                "text": "Les multicoques furent inventés dès le Néolithique, probablement par les peuples du Pacifique qui migraient, d'île en île, sur ces embarcations rapides."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Néolithique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "009fc161-c10e-3400-8ed6-1a74fecd9616",
                                        "entry_id": "acb43678-16a8-3e1c-baaf-c2facf037e60",
                                        "glosses": [
                                            "Personne ayant vécu au Néolithique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02ed0736-0cb3-457f-b9b7-6022cd5f7332",
                                                "sense_id": "009fc161-c10e-3400-8ed6-1a74fecd9616",
                                                "text": "Il faut dire que le « couloir périphérique » (…) fut soigneusement rebouché par les Néolithiques lorsqu’ils eurent fini d’utiliser l’allée couverte (…)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
