                "senses": [
                    {
                        "sense_id": "69cced7d-45c0-3350-a0b1-bd3607cf7e2e",
                        "entry_id": "a2aa5578-f5df-3031-a36b-6560784e7516",
                        "glosses": [
                            "спец. связанный, соотносящийся по значению с существительным форманта"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92af36e6-bca7-4f8c-bf17-750f1fc3c712",
                                "sense_id": "69cced7d-45c0-3350-a0b1-bd3607cf7e2e",
                                "text": "Согласные звуки (приближающиеся к шумам) по своей структуре гораздо сложнее, чем гласные; формантные области здесь шире."
                            },
                            {
                                "example_id": "2d28a953-f973-4621-ab68-f32b8681ddb1",
                                "sense_id": "69cced7d-45c0-3350-a0b1-bd3607cf7e2e",
                                "text": "Предварительно речевой сигнал был пропущен через формантный фильтр, частотная характеристика которого была близка к треугольной форме с граничными частотами 0,2 — 1,0 кГц."
                            }
                        ]
                    }
