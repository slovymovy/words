                "senses": [
                    {
                        "sense_id": "4c12ba95-d125-356d-9224-613387c270b4",
                        "entry_id": "bc159609-280c-30c5-9544-4cc3ab30c35c",
                        "glosses": [
                            "Methode Schlüsse zu ziehen: These + Antithese ➝ Synthese"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd47ef5f-4c5f-4494-861e-f5e2173ed952",
                                "sense_id": "4c12ba95-d125-356d-9224-613387c270b4",
                                "text": "„Zum ersten Mal findet sich der Ausdruck Dialektik bei Platon.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "22878f69-8354-3039-8e00-0c0fc1e267cb",
                        "entry_id": "bc159609-280c-30c5-9544-4cc3ab30c35c",
                        "glosses": [
                            "Kunst der Gesprächsführung"
                        ],
                        "tags": [
                            "Rhetorik"
                        ],
                        "examples": [
                            {
                                "example_id": "ecf7c056-c132-4713-8ec4-04ad201bf438",
                                "sense_id": "22878f69-8354-3039-8e00-0c0fc1e267cb",
                                "text": "„Hier ist für uns nur wichtig, daß die Dialektik für die Konstitution von Mathematik verantwortlich ist.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c1c580f2-5ac4-4146-b022-a1c1dbc31b4f",
                        "source_entry_id": "bc159609-280c-30c5-9544-4cc3ab30c35c",
                        "source_sense_id": "4c12ba95-d125-356d-9224-613387c270b4",
                        "source_sense_description": "Philosophie: Methode Schlüsse zu ziehen: These",
                        "target_lang_word": "dialectic",
