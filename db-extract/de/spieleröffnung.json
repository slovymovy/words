                "senses": [
                    {
                        "sense_id": "912a948b-32d8-3439-b5e2-b7f7c4f04c2a",
                        "entry_id": "71a10eff-3e3a-3957-be2f-af6d9303b566",
                        "glosses": [
                            "Einleitung eines Spielgeschehens, zum Beispiel als Anspiel beim Fußball oder Schach oder als Ausspielen beim Kartenspiel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74757557-26d3-4659-ba62-8e77f831fe5a",
                                "sense_id": "912a948b-32d8-3439-b5e2-b7f7c4f04c2a",
                                "text": "„Bei der Spieleröffnung passieren mit dem Ausspielen der ersten Karte die folgenschwersten Fehler.“"
                            },
                            {
                                "example_id": "c3cc9f0d-4e10-43d0-9ace-aa678d1da08e",
                                "sense_id": "912a948b-32d8-3439-b5e2-b7f7c4f04c2a",
                                "text": "„Bei der Spieleröffnung und beim Spielaufbau im Fußballspiel ist die Ballsicherung bzw. die Vermeidung von Ballverlusten in den Mittelpunkt der Spielhandlungen zu stellen.“"
                            },
                            {
                                "example_id": "cd4b3e3f-7699-4c20-937c-20f6af3e6ba2",
                                "sense_id": "912a948b-32d8-3439-b5e2-b7f7c4f04c2a",
                                "text": "„Der Däne beeindruckt mit seiner körperlichen Präsenz, überzeugt aber noch nicht vollends. Dafür überrascht er bei der Spieleröffnung.“"
                            },
                            {
                                "example_id": "226ad766-f1d3-4ee6-82e1-fba8e2d92b62",
                                "sense_id": "912a948b-32d8-3439-b5e2-b7f7c4f04c2a",
                                "text": "„Die Mannschaft in Überzahl beginnt mit der Spieleröffnung und erzielt Treffer auf die kleinen Tore.“"
                            },
                            {
                                "example_id": "c3d8ec70-ea8d-4a9a-9854-7324546245d6",
                                "sense_id": "912a948b-32d8-3439-b5e2-b7f7c4f04c2a",
                                "text": "„Van Gaal wollte immer, dass der Torwart zur Spieleröffnung einen hohen Ball auf den Außenverteidiger spielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
