    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ed9be79b-0a64-35e0-addb-101cf4df5a7a",
                    "sense_definition": "Harmoniser ou faire coexister des éléments en apparence opposés, contradictoires ou difficiles à associer.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est souvent difficile de <w>concilier</w> vie professionnelle et vie de famille au quotidien."
                        },
                        {
                            "text": "Cette entreprise cherche à <w>concilier</w> la rentabilité économique avec le respect de l'environnement."
                        }
                    ],
                    "synonyms": [
                        "accorder",
                        "harmoniser"
                    ],
                    "antonyms": [
                        "opposer"
                    ],
                    "common_phrases": [
                        "concilier vie professionnelle et vie privée",
                        "concilier les contraires"
                    ]
                },
                {
                    "sense_id": "ae50deb9-efd7-3330-bc92-e251fd80b423",
                    "sense_definition": "Mettre d'accord des personnes en désaccord ou divisées par des intérêts contraires.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médiateur tente de <w>concilier</w> les deux voisins pour éviter un procès coûteux."
                        },
                        {
                            "text": "Nous espérons <w>concilier</w> les différentes parties avant la fin des négociations."
                        }
                    ],
                    "synonyms": [
                        "réconcilier",
                        "accorder",
                        "rapprocher"
                    ],
                    "antonyms": [
                        "diviser",
                        "opposer"
                    ],
                    "common_phrases": [
                        "concilier les parties",
                        "concilier les points de vue"
                    ]
                },
                {
                    "sense_id": "807b7882-bfb2-3f0e-991d-e5a088443f3c",
                    "sense_definition": "Gagner, attirer ou s'attirer la bienveillance, la sympathie ou la faveur de quelqu'un.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Par sa courtoisie naturelle, il a su se <w>concilier</w> la sympathie de toute l'équipe."
                        },
                        {
                            "text": "Le nouveau directeur cherche à se <w>concilier</w> les bonnes grâces des actionnaires principaux."
                        }
                    ],
                    "synonyms": [
                        "gagner",
                        "s'attirer"
                    ],
                    "antonyms": [
                        "s'aliéner"
                    ],
                    "common_phrases": [
                        "se concilier les bonnes grâces",
                        "se concilier la faveur"
                    ]
                }
            ]
        }
    ]
}