{
    "word_family": [
        "kordzik",
        "kordowy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8fa8c1f0-5e1a-3834-ab57-37bbf34c47aa",
                    "sense_definition": "mocna tkanina lub siatka z włókien bądź drutów stosowana jako warstwa wzmacniająca w oponach samochodowych i pasach transmisyjnych",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technika i tkaniny",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bieżnik był tak zniszczony, że na boku opony pojawił się metalowy <w>kord</w>.",
                            "target_lang_translations": {
                                "ru": "Протектор был настолько изношен, что сбоку шины показался металлический <w>корд</w>."
                            }
                        },
                        {
                            "text": "Konstrukcja nowoczesnych opon wykorzystuje wytrzymały <w>kord</w> stalowy lub syntetyczny.",
                            "target_lang_translations": {
                                "ru": "В конструкции современных шин используется прочный стальной или синтетический <w>корд</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stalowy kord",
                        "kord w oponie"
                    ],
                    "target_lang_definitions": {
                        "ru": "прочная ткань или сетка из волокон либо проволоки, служащая армирующим слоем в автомобильных шинах и приводных ремнях"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корд",
                                "target_lang_sense_clarification": "в шинах и ремнях"
                            },
                            {
                                "target_lang_word": "кордная ткань",
                                "target_lang_sense_clarification": "армирующая ткань"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9dfaeab7-2698-3248-8f58-7a1e36bf7f7c",
                    "sense_definition": "dawna krótka, sieczna broń biała o jednosiecznej lub obusiecznej głowni, noszona głównie przez piechotę, mieszczan lub marynarzy",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "broń biała",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W średniowieczu prosty żołnierz często nosił przy pasie krótki <w>kord</w> do obrony z bliska.",
                            "target_lang_translations": {
                                "ru": "В Средние века простой солдат часто носил на поясе короткий <w>корд</w> для ближнего боя."
                            }
                        },
                        {
                            "text": "W muzealnej gablocie wystawiono zabytkowy <w>kord</w> należący dawniej do miejskiego strażnika.",
                            "target_lang_translations": {
                                "ru": "В музейной витрине был выставлен старинный <w>тесак</w>, некогда принадлежавший городскому стражнику."
                            }
                        }
                    ],
                    "synonyms": [
                        "kordelas"
                    ],
                    "common_phrases": [
                        "kord u boku",
                        "krótki kord"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "określenie historyczne"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "старинное короткое рубяще-колющее холодное оружие с одно- или двулезвийным клинком, бывшее на вооружении пехоты, горожан или матросов"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корд",
                                "target_lang_sense_clarification": "историческое холодное оружие"
                            },
                            {
                                "target_lang_word": "корделас",
                                "target_lang_sense_clarification": "короткий широкий меч или тесак"
                            },
                            {
                                "target_lang_word": "тесак",
                                "target_lang_sense_clarification": "короткое рубящее холодное оружие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b7b5162e-6292-3709-ad6b-e1bb67ab6baa",
                    "sense_definition": "krótka szabla o zakrzywionej głowni używana dawniej w walkach na morzu",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "broń biała",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Korsarz wyciągnął zakrzywiony <w>kord</w> i ruszył do walki na pokładzie wrogiego statku.",
                            "target_lang_translations": {
                                "ru": "Корсар обнажил изогнутую <w>абордажную саблю</w> и бросился в бой на палубе вражеского корабля."
                            }
                        },
                        {
                            "text": "Marynarze ćwiczyli fechtunek, do którego służył im poręczny morski <w>kord</w>.",
                            "target_lang_translations": {
                                "ru": "Моряки упражнялись в фехтовании, для которого им служил удобный морской <w>корделас</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "szabla abordażowa",
                        "kordelas"
                    ],
                    "common_phrases": [
                        "morski kord"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "określenie historyczne"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "короткая сабля с искривлённым клинком, использовавшаяся в старину в морских и абордажных боях"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "абордажная сабля",
                                "target_lang_sense_clarification": "морское оружие"
                            },
                            {
                                "target_lang_word": "корд",
                                "target_lang_sense_clarification": "морской тесак или короткая сабля"
                            },
                            {
                                "target_lang_word": "корделас",
                                "target_lang_sense_clarification": "абордажное оружие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95f71acb-e631-34e5-b30e-7873a7fc2e56",
                    "sense_definition": "gruba tkanina o prążkowanej strukturze, używana tradycyjnie do szycia odzieży roboczej lub użytkowej",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technika i tkaniny",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zimowe spodnie uszyto z grubego materiału, jakim jest prążkowany <w>kord</w>.",
                            "target_lang_translations": {
                                "ru": "Зимние брюки сшили из плотной ткани — рубчатого <w>вельвета</w>."
                            }
                        },
                        {
                            "text": "Do produkcji ubrań roboczych wykorzystywano trwały <w>kord</w> odporny na przetarcia.",
                            "target_lang_translations": {
                                "ru": "Для производства рабочей одежды использовали прочный, устойчивый к истиранию <w>корд</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gruby kord"
                    ],
                    "target_lang_definitions": {
                        "ru": "плотная хлопчатобумажная ткань в рубчик, традиционно используемая для пошива рабочей или практичной одежды"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корд",
                                "target_lang_sense_clarification": "рубчатая ткань"
                            },
                            {
                                "target_lang_word": "вельвет-корд",
                                "target_lang_sense_clarification": "ткань в широкий рубчик"
                            }
                        ]
                    }
                }
            ]
        }
    ]
