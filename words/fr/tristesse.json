                {
                    "sense_id": "493123d6-5306-3c1a-b25c-9849de25e1ea",
                    "sense_definition": "État affectif douloureux, sentiment de peine ou d'abattement moral causé par un événement pénible ou une déception.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle ressentait une immense <w>tristesse</w> après le départ de sa meilleure amie.",
                            "target_lang_translations": {
                                "en": "She felt an immense <w>sadness</w> after her best friend left.",
                                "ru": "Она испытывала огромную <w>грусть</w> после отъезда своей лучшей подруги.",
                                "nl": "Ze voelde een enorm <w>verdriet</w> na het vertrek van haar beste vriendin.",
                                "de": "Sie empfand nach dem Weggang ihrer besten Freundin eine riesige <w>Traurigkeit</w>.",
                                "pl": "Po wyjeździe jej najlepszej przyjaciółki odczuwała ogromny <w>smutek</w>.",
                                "it": "Dopo la partenza della sua migliore amica provava un'immensa <w>tristezza</w>.",
                                "cs": "Po odchodu své nejlepší kamarádky cítila obrovský <w>smutek</w>.",
                                "tr": "En iyi arkadaşının ayrılmasının ardından büyük bir <w>üzüntü</w> hissediyordu.",
                                "es": "Sentía una inmensa <w>tristeza</w> después de la marcha de su mejor amiga.",
                                "zh": "她的好朋友离开后，她心中充满了巨大的<w>悲伤</w>。"
                            }
                        },
                        {
                            "text": "Il n'a pas pu cacher sa <w>tristesse</w> en apprenant la mauvaise nouvelle.",
                            "target_lang_translations": {
                                "en": "He could not hide his <w>sadness</w> when he heard the bad news.",
                                "ru": "Он не смог скрыть свою <w>печаль</w>, узнав плохую новость.",
                                "nl": "Hij kon zijn <w>verdriet</w> niet verbergen toen hij het slechte nieuws hoorde.",
                                "de": "Er konnte seine <w>Traurigkeit</w> nicht verbergen, als er die schlechte Nachricht erfuhr.",
                                "pl": "Nie mógł ukryć swojego <w>smutku</w>, gdy dowiedział się o złej wiadomości.",
                                "it": "Non è riuscito a nascondere la sua <w>tristezza</w> quando ha saputo la brutta notizia.",
                                "cs": "Nedokázal skrýt svůj <w>smutek</w>, když se dozvěděl špatnou zprávu.",
                                "tr": "Kötü haberi öğrenince <w>üzüntüsünü</w> gizleyemedi.",
                                "es": "No pudo ocultar su <w>tristeza</w> al enterarse de la mala noticia.",
                                "zh": "听到这个坏消息时，他无法掩饰自己的<w>悲伤</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "joie"
                    ],
                    "common_phrases": [
                        "grande tristesse",
                        "pleurer de tristesse",
                        "sentiment de tristesse"
                    ],
                    "target_lang_definitions": {
                        "en": "A painful emotional state of grief or low spirits caused by a distressing event or disappointment.",
                        "ru": "Тяжёлое душевное состояние печали и подавленности, вызванное горем или разочарованием.",
                        "nl": "Pijnlijke gemoedstoestand van verdriet of neerslachtigheid, veroorzaakt door een pijnlijke gebeurtenis of teleurstelling.",
                        "de": "Schmerzliches seelisches Gefühl von Kummer oder Niedergeschlagenheit, ausgelöst durch ein belastendes Ereignis oder eine Enttäuschung.",
                        "pl": "Bolesny stan emocjonalny, poczucie żalu i przygnębienia wywołane przykrym wydarzeniem lub zawodem.",
                        "it": "Stato emotivo doloroso, sentimento di pena e di abbattimento morale causato da un evento spiacevole o da una delusione.",
                        "cs": "Bolestný citový stav smutku nebo sklíčenosti způsobený těžkou událostí nebo zklamáním.",
                        "tr": "Kötü bir olay ya da hayal kırıklığının yol açtığı, acı veren ve moral bozan bir duygu hâli.",
                        "es": "Estado emocional doloroso de pena o abatimiento moral causado por un suceso penoso o una decepción.",
                        "zh": "内心痛苦的情绪状态，通常因令人伤心的事件或失望而产生。"
                    },
