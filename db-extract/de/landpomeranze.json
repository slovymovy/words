                                "target_senses": [
                                    {
                                        "sense_id": "99e1bf62-62fb-3fa8-803d-97bc1e7bade0",
                                        "entry_id": "cfc31432-205b-3acf-9e4e-f3317af18a19",
                                        "glosses": [
                                            "Paysanne ou fille de la campagne."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd35f6b8-70dd-440f-ab5e-7c5919c76fb1",
                                                "sense_id": "99e1bf62-62fb-3fa8-803d-97bc1e7bade0",
                                                "text": "Ludo n’osa rien rétorquer, mais il était vexé que son meilleur copain traita son grand amour de péquenaude, estimant que sa beauté n’avait rien de rural."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bedbaac6-9548-4580-b518-bdfdb0af5f18",
                        "source_entry_id": "9f45abc7-f6a2-36df-bf1c-a6ba1215c8bc",
                        "source_sense_id": "4539247c-4529-39e3-a6d7-12b5752fff4e",
                        "source_sense_description": "umgangssprachlich: heutzutage auch männliche Person mit ländlich-provinziellen Herkunft",
                        "target_lang_word": "péquenaud",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "péquenaud",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "83de05c6-0c5f-3152-8aba-94b5ab1a2eb4",
                                        "entry_id": "36dede84-fb67-3d0f-a5b3-f9530717a85e",
                                        "glosses": [
                                            "Paysan ou gars de la campagne."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d687c7ef-345e-4984-adc7-a07afcf297ea",
                                                "sense_id": "83de05c6-0c5f-3152-8aba-94b5ab1a2eb4",
                                                "text": "Il était le péquenaud, le cul-terreux, le ventre jaune de notre brigade."
                                            },
                                            {
                                                "example_id": "b8105865-8c0d-48b7-a55c-611b0bd6bf4b",
                                                "sense_id": "83de05c6-0c5f-3152-8aba-94b5ab1a2eb4",
                                                "text": "Il n’y a guère que des péquenauds qui viennent par ici."
                                            },
                                            {
                                                "example_id": "4638d26a-f3ce-438a-8873-fb3ee4347b7b",
                                                "sense_id": "83de05c6-0c5f-3152-8aba-94b5ab1a2eb4",
                                                "text": "Tous les quarts d’heure,\nUn paon siffleur\nNous traite de péquenauds, de vendus, d’abrutis,\nDe vieux débris\nEt j’en oublie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "péquenaud",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3004cd9f-4089-30c0-b0f7-30753ab0b38b",
                                        "entry_id": "5c76fee1-f83b-3eba-a80e-29395d5f5c7d",
                                        "glosses": [
                                            "Adjectif dérivé du nom commun pequenaud."
                                        ],
