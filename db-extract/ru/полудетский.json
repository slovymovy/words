                "senses": [
                    {
                        "sense_id": "7e3e9327-d247-3b91-9588-bd2118df14ef",
                        "entry_id": "be2a3d26-cae1-32eb-a72f-3315b61232b2",
                        "glosses": [
                            "half-childish"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bb4db70-8723-44ea-aa9f-36bc4fa02ed7",
                                "sense_id": "7e3e9327-d247-3b91-9588-bd2118df14ef",
                                "text": "Мы и действи́тельно бы́ли в како́м-то чаду́, нас охвати́ла неудержи́мая полуде́тская потре́бность бе́гать, петь, смея́ться и де́лать всё очертя́ го́лову.",
                                "translation": "We were indeed in some sort of daze, overcome by an irrepressible, half-childish need to run, sing, laugh, and do everything recklessly.",
                                "english": "We were indeed in some sort of daze, overcome by an irrepressible, half-childish need to run, sing, laugh, and do everything recklessly."
                            }
                        ]
                    }
                ],
