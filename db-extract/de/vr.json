                        "sense_index_json": "\"18\""
                    },
                    {
                        "sense_id": "e26eb885-bea8-39e2-9848-29977429afe0",
                        "entry_id": "52b76246-2e4e-3852-b061-68922b70845d",
                        "glosses": [
                            "Verwendungsreihe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f3e20c3-03f3-4d4b-b7dc-77c1157cd930",
                                "sense_id": "e26eb885-bea8-39e2-9848-29977429afe0",
                                "text": "„Verwendungsreihe 28 - Elektronischer Kampf Marine (zusammengeschlossen mit VR 23 in VR 2328)“"
                            },
                            {
                                "example_id": "7ff19850-f200-41ee-921b-76131b4a6807",
                                "sense_id": "e26eb885-bea8-39e2-9848-29977429afe0",
                                "text": "„Verwendungsbereich Logistik und Stabsdienst (60er): Angehörige dieser Verwendungsreihen sind zuständig für Verwaltung und Versorgung der Truppenteile. Der Schiffskoch (Smut) gehört der VR 62 an.“"
                            },
                            {
                                "example_id": "7a169360-66d6-402b-b2cb-230bd9e3e89d",
                                "sense_id": "e26eb885-bea8-39e2-9848-29977429afe0",
                                "text": "„Es erfolgte ein Wechsel von Verwendungsreihe (VR) 76 (Marinesicherungsdienst) auf VR 73 (Kraftfahrbetrieb);“"
                            },
                            {
                                "example_id": "67532254-98f7-423e-b4a3-4afaecf015d0",
                                "sense_id": "e26eb885-bea8-39e2-9848-29977429afe0",
                                "text": "„Meine Grundausbildung fand an der Marinewaffenschule in Kappeln statt. Dort wurde ich zum Feuerleitgasten (VR 32) für das Waffensystem Zerstörer Klasse Z 103B ausgebildet.“"
                            },
                            {
                                "example_id": "574b07a2-d388-48b2-bdf5-2491cddc46ae",
                                "sense_id": "e26eb885-bea8-39e2-9848-29977429afe0",
                                "text": "„Mir wurde gesagt, dass ich beim Einstellungstest noch die Wahl hätte, mir die entsprechende Verwendungsreihe (VR) auszusuchen,“"
                            }
                        ],
                        "sense_index_json": "\"19\""
                    }
