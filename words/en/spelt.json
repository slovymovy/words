                            "trait_type": "archaic",
                            "comment": "archaic or historical usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "rozgnieciony, rozdrobniony lub pośrutowany, zwłaszcza o suszonych nasionach strączkowych"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "śrutowany",
                                "target_lang_sense_clarification": "grubo zmielony lub rozdrobniony"
                            },
                            {
                                "target_lang_word": "rozdrobniony",
                                "target_lang_sense_clarification": "o ziarnie lub nasionach"
                            }
                        ]
                    }
                }
            ]
        }
    ]
