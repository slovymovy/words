                "senses": [
                    {
                        "sense_id": "d4f8214d-b78d-30d9-abfe-7cddbc38132a",
                        "entry_id": "9e38ae51-cd1c-3e05-bd28-43486231ee04",
                        "glosses": [
                            "Donner un caractère souterrain à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9008e1a5-7b38-472d-b031-be47303d0bf2",
                                "sense_id": "d4f8214d-b78d-30d9-abfe-7cddbc38132a",
                                "text": "Car laisser tout en surface, c'est vrai que cela coupe la ville en deux et nécessiterait de hideux murs antibruit.. et tout souterraniser couterait trop cher, d’autant plus qu’il faudra toujours un minimum de routes en surface…"
                            },
                            {
                                "example_id": "97fd6209-a01a-4cc3-b2f0-d27c80e1676f",
                                "sense_id": "d4f8214d-b78d-30d9-abfe-7cddbc38132a",
                                "text": "Chef de service du réseau des lignes, qui se sont peu à peu «souterranisées», André Roth a fini par connaître la ville autant par-dessus que par-dessous : ainsi lors de la pose La rue Saint-Honoré entre 1902 et 1910 (Collection André Roth)."
                            },
                            {
                                "example_id": "bbbb4a9d-d3cc-4d23-b6b6-2370a526eb3b",
                                "sense_id": "d4f8214d-b78d-30d9-abfe-7cddbc38132a",
                                "text": "Mais tout se souterranise."
                            }
                        ]
                    }
