                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "horticulture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jardinier du domaine a décidé d'<w>encaisser</w> les orangers pour les abriter du gel hivernal."
                        },
                        {
                            "text": "On doit soigneusement <w>encaisser</w> ces jeunes arbustes pour faciliter leur déplacement dans la serre."
                        }
                    ]
                }
            ]
