                        "sense_id": "dc2b9dc3-bf33-3e5c-8b61-11a8db1bb40c",
                        "entry_id": "5a0d060d-8e79-3010-be14-70feed20a4b2",
                        "glosses": [
                            "Speed that exceeds a reasonable or permitted rate."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "bd94b337-8340-426f-a3fb-174a14696088",
                                "sense_id": "dc2b9dc3-bf33-3e5c-8b61-11a8db1bb40c",
                                "text": "Trashes are clogs strapped round the neck of a dog to prevent his overspeed."
                            },
                            {
                                "example_id": "bf33ec6a-478b-4069-ba4b-8b43a07e19c3",
                                "sense_id": "dc2b9dc3-bf33-3e5c-8b61-11a8db1bb40c",
                                "text": "Protection devices are provided for engine and locomotive overspeed (maximum service speed is set at 90 m.p.h.); [...]."
                            },
                            {
                                "example_id": "cda6f63a-7c36-4fe8-8bbc-7793d845dcc4",
                                "sense_id": "dc2b9dc3-bf33-3e5c-8b61-11a8db1bb40c",
                                "text": "Investigating four 'overspeed' incidents during hot weather on July 18/19, RAIB discovered that confusion over where the BESRs [blanket emergency speed restrictions] started and finished, as well as the routes to which they applied, were contributory factors. […] There were no consequences from the overspeeds, [resulting from the BESRs] which had been put in place owing to danger of buckled rails."
                            }
                        ]
                    }
