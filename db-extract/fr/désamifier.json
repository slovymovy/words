                ],
                "senses": [
                    {
                        "sense_id": "b67b791b-5aa4-3c05-bc4b-d99f5ff07cb1",
                        "entry_id": "66621bd1-79ce-31b2-8b18-befc5544f3c7",
                        "glosses": [
                            "Supprimer un contact de sa liste d’amis sur des réseaux sociaux."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "37af3f72-5b52-414e-aa10-8efed5532665",
                                "sense_id": "b67b791b-5aa4-3c05-bc4b-d99f5ff07cb1",
                                "text": "Vu les commentaires nazes qu’il poste, je ne vais pas tarder à le désamifier."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "29cbc9b4-8508-4326-b5d0-9dbd090c8d84",
                        "source_entry_id": "66621bd1-79ce-31b2-8b18-befc5544f3c7",
                        "source_sense_id": "b67b791b-5aa4-3c05-bc4b-d99f5ff07cb1",
                        "target_lang_word": "unfriend",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unfriend",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "77230c74-d6cf-393b-91d7-fec1124060bd",
                                        "entry_id": "74fae0df-ae0c-3a8e-8a38-10934c190bdb",
                                        "glosses": [
                                            "One who is not a friend; an enemy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23382b35-7e53-4788-994a-7d762ad79813",
                                                "sense_id": "77230c74-d6cf-393b-91d7-fec1124060bd",
                                                "text": "It is even as I suspected, my lord, […] Ye have back-friends, my lord, that is, unfriends—or, to be plain, enemies—about the person of the Prince."
                                            },
                                            {
                                                "example_id": "6d8739d6-b6c0-4f3f-bc8c-894bbca50eaf",
                                                "sense_id": "77230c74-d6cf-393b-91d7-fec1124060bd",
                                                "text": "I wonder often it has not drawn her out of the grave to come and stand before me, and hear me tell her how I loved her. For, sir, we parted unfriends."
                                            },
                                            {
                                                "example_id": "1a939c88-6012-4006-be51-08d8852a614b",
                                                "sense_id": "77230c74-d6cf-393b-91d7-fec1124060bd",
                                                "text": "Thus many unfriends and some friends of the Capital agree upon the same policy with diverse and contradictory motives[…]"
                                            },
                                            {
                                                "example_id": "2b3d4159-4f7a-4648-bc49-7f135a6c9d58",
                                                "sense_id": "77230c74-d6cf-393b-91d7-fec1124060bd",
                                                "text": "For we desire no strangers in these lands to break the peace in which we live, and these folk are hewers of trees and hunters of beasts; therefore we are their unfriends, and if they will not depart we shall afflict them in all ways that we can."
                                            },
                                            {
                                                "example_id": "37ee39c7-8727-41b8-9702-8352ed0701d8",
                                                "sense_id": "77230c74-d6cf-393b-91d7-fec1124060bd",
                                                "text": "The unfriend betrays me, ignores me, denies me, breaks me down; the unfriend is against and tries to devour my personhood."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "unfriend",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "42d903db-3348-3c0d-b249-4c5945509d26",
                                        "entry_id": "3c0a4aa1-3914-31f5-b18f-32db34e05492",
                                        "glosses": [
                                            "To sever as friends."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9f90003-9f61-47cf-9481-539c599db61e",
                                                "sense_id": "42d903db-3348-3c0d-b249-4c5945509d26",
                                                "text": "\"I hope, sir, that we are not mutually Unfriended by this Difference which hath happened betwixt us.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f11506d-a673-366f-82e7-7b5b3b17fadf",
                                        "entry_id": "3c0a4aa1-3914-31f5-b18f-32db34e05492",
                                        "glosses": [
                                            "To defriend; to remove from one's friends list (e.g. on a social networking website)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e960184-7e1b-4458-9648-d7eedf3a8831",
                                                "sense_id": "5f11506d-a673-366f-82e7-7b5b3b17fadf",
                                                "text": "\"I asked her why, she said it was because I didn't comment, and I shrugged and said whatever. I didn't unfriend her.\""
                                            },
                                            {
                                                "example_id": "48a5ff75-9bca-41d3-a9f6-d94f8d2aaf20",
                                                "sense_id": "5f11506d-a673-366f-82e7-7b5b3b17fadf",
                                                "text": "Without unfriending someone, you can now choose to limit or block (unsubscribe) someone from your newsfeed or choose to see only what Facebook deems as very important."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
