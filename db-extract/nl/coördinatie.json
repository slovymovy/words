                ],
                "senses": [
                    {
                        "sense_id": "e6313ecc-8e23-3dbb-ae09-101400bb3649",
                        "entry_id": "9cc3dd33-ce94-3fac-b1b7-8cf77a4f253c",
                        "glosses": [
                            "onderlinge afstemming, het coördineren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a1c5b66-56e8-4b9f-a164-dc8dac97ed2b",
                                "sense_id": "e6313ecc-8e23-3dbb-ae09-101400bb3649",
                                "text": "Bij het bestrijden van de gevolgen van een ramp is er een goede coördinatie tussen de verschillende hulpdiensten nodig."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e86f8a2-33a7-30fb-b089-34b1276bf0c1",
                        "entry_id": "9cc3dd33-ce94-3fac-b1b7-8cf77a4f253c",
                        "glosses": [
                            "onderlinge afstemming in de bewegingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe0f36ea-f385-4e2f-acc0-845a6ca9e1ea",
                                "sense_id": "4e86f8a2-33a7-30fb-b089-34b1276bf0c1",
                                "text": "Als chirurg heb je een goede oog-handcoördinatie nodig."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8489da20-d4ce-4b27-a0dc-a00b51f0157d",
                        "source_entry_id": "9cc3dd33-ce94-3fac-b1b7-8cf77a4f253c",
                        "source_sense_id": "e6313ecc-8e23-3dbb-ae09-101400bb3649",
                        "source_sense_description": "onderlinge afstemming, het coördineren",
                        "target_lang_word": "coordination",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coordination",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b29ff9e-b711-3e30-b917-28dd187b1cca",
                                        "entry_id": "00bee926-f1f2-3e01-908a-83f4b04bd73a",
                                        "glosses": [
                                            "The act of coordinating, making different people or things work together for a goal or effect."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0757d8ac-649a-4b7c-b807-57071d47f0fb",
                                                "sense_id": "4b29ff9e-b711-3e30-b917-28dd187b1cca",
                                                "text": "Then there's the State Service and the police and several other services. And there is no proper co-ordination, no single head for all these agencies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d58c0507-4d54-3bee-9f5b-03abbc2a6a04",
                                        "entry_id": "00bee926-f1f2-3e01-908a-83f4b04bd73a",
                                        "glosses": [
                                            "The resulting state of working together; cooperation; synchronization."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad33c02e-2d5c-4a94-b805-a9f65bdb5cf2",
                                                "sense_id": "d58c0507-4d54-3bee-9f5b-03abbc2a6a04",
                                                "text": "We stood dodging each other a moment with that unfortunate co-ordination of purpose men sometimes encounter when passing each other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93d9a877-56ac-3078-a6af-df0bccca26de",
                                        "entry_id": "00bee926-f1f2-3e01-908a-83f4b04bd73a",
                                        "glosses": [
                                            "The ability to coordinate one's senses and physical movements in order to act skillfully."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "822b4587-9ab8-41ea-b6b6-1043656b9ef6",
                                                "sense_id": "93d9a877-56ac-3078-a6af-df0bccca26de",
                                                "text": "I’m terrible at sports; I have no coordination."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62532605-2c29-39a8-9b3f-7e3de2de7225",
                                        "entry_id": "00bee926-f1f2-3e01-908a-83f4b04bd73a",
                                        "glosses": [
                                            "The state of being equal in rank or power."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e64d2f87-85ab-4c5f-9ff0-67185e050f3f",
                                                "sense_id": "62532605-2c29-39a8-9b3f-7e3de2de7225",
                                                "text": "There are two possible modes of unity in a State; one by absolute co-ordination of each to all, and of all to each; the other by subordination of classes and offices."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43bd2291-775e-34d2-94c3-8dcfdeb8c827",
                                        "entry_id": "00bee926-f1f2-3e01-908a-83f4b04bd73a",
                                        "glosses": [
                                            "An equal joining together of two or more phrases or clauses, for example, using and, or, or but."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d965ee4b-b475-4944-b14f-e2340bf91820",
                                                "sense_id": "43bd2291-775e-34d2-94c3-8dcfdeb8c827",
                                                "text": "There’s a wealth of other complex facts about coordination that could be explored […] coordinations with but are limited to two coordinates […]; yet coordinations with and or with or can have any number of coordinates, with the coordinator preceding just the last one […] or repeated before all except the first […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa5949aa-14ef-3518-b3fa-c72c2c439971",
                                        "entry_id": "00bee926-f1f2-3e01-908a-83f4b04bd73a",
                                        "glosses": [
                                            "The reaction of one or more ligands with a metal ion to form a coordination compound."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0bc3cac-af9a-43fb-8b39-e1fdbaaf37ef",
                        "source_entry_id": "9cc3dd33-ce94-3fac-b1b7-8cf77a4f253c",
                        "source_sense_id": "e6313ecc-8e23-3dbb-ae09-101400bb3649",
                        "source_sense_description": "onderlinge afstemming, het coördineren",
                        "target_lang_word": "coordination",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coordination",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ca1cbe0f-fb4f-3586-a007-782ff60c12d7",
                                        "entry_id": "8b32c2ac-516f-3120-83a3-4fad12ea2c51",
                                        "glosses": [
                                            "Action de coordonner qui permet, facilite et ordonne à des entités à travailler ensemble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1714557e-a264-4cdc-86f9-27bfce21194f",
                                                "sense_id": "ca1cbe0f-fb4f-3586-a007-782ff60c12d7",
                                                "text": "La conférence hebdomadaire des chefs de service est pour la coordination ce que le programme d'action est pour la prévoyance"
                                            },
                                            {
                                                "example_id": "a684086e-934f-4a12-8790-8072bbff0d69",
                                                "sense_id": "ca1cbe0f-fb4f-3586-a007-782ff60c12d7",
                                                "text": "La coordination de tous les êtres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b910f3b-59d9-3459-a0ca-c6eecffdadfc",
                                        "entry_id": "8b32c2ac-516f-3120-83a3-4fad12ea2c51",
                                        "glosses": [
                                            "Résultat de cette action qui amène des entités à travailler ensemble de bon ou de mal gré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "668762dd-5c2d-4650-8f62-55e5e9d73c39",
                                                "sense_id": "2b910f3b-59d9-3459-a0ca-c6eecffdadfc",
                                                "text": "La coordination des services est une des exigences du management d'une entreprise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a0e8f22-2681-3e4f-8708-cd24200e2934",
                                        "entry_id": "8b32c2ac-516f-3120-83a3-4fad12ea2c51",
                                        "glosses": [
                                            "Fonction, dans une entreprise, qui consiste à s'occuper de tâches administratives diverses facilitant le travail des personnes contribuant plus directement aux activités définitoires de l'entreprise."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93d64714-9fb3-4be8-bf62-700d6feaff6e",
                                                "sense_id": "6a0e8f22-2681-3e4f-8708-cd24200e2934",
                                                "text": "Dans le processus, nous jugeâmes qu'il nous fallait une personne à la coordination pour nous aider à structurer l'entreprise et à atteindre certains objectifs, comme la création d'un guide d'entreprise et d'un wiki interne (devant nous servir d'intranet). Cette personne-clé, ça allait être Isabelle, qui nous arriverait dès le début de l'automne 2019 et ferait des merveilles en organisant nos dossiers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "756d01cb-3e68-314b-af2d-822f03dc4d98",
                                        "entry_id": "8b32c2ac-516f-3120-83a3-4fad12ea2c51",
                                        "glosses": [
                                            "Action de coordonner des mouvements corporels."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d261394-7f11-480c-a4fd-6b851c60f95f",
                                                "sense_id": "756d01cb-3e68-314b-af2d-822f03dc4d98",
                                                "text": "L’âge d'or pour le travail de la coordination générale se situe entre 8 et 12 ans, c'est-à-dire dans les catégories Poussin et Benjamin. Et, c'est seulement à partir de la puberté (12 ans) qu'on est censé travailler la coordination spécifique par une pratique spécialisée et acquérir une habileté motrice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "902aa2e1-c917-3b59-a9d0-c7d8b075cf49",
                                        "entry_id": "8b32c2ac-516f-3120-83a3-4fad12ea2c51",
                                        "glosses": [
                                            "Action de grouper, en les unissant par des conjonctions spéciales, des termes de même nature ou des propositions dont la valeur est identique logiquement ou seulement par la forme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95d36174-f78a-466d-8846-f37ef7d98494",
                                                "sense_id": "902aa2e1-c917-3b59-a9d0-c7d8b075cf49",
                                                "text": "Les principales conjonctions de coordination sont : mais, ou, et, donc, or, ni, car."
                                            },
                                            {
                                                "example_id": "d97c4478-ff6b-485d-b662-e150ad11cd04",
                                                "sense_id": "902aa2e1-c917-3b59-a9d0-c7d8b075cf49",
                                                "text": "Syntaxe de coordination."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d46da366-8cd8-35b5-bd5c-2c86c731aceb",
                                        "entry_id": "8b32c2ac-516f-3120-83a3-4fad12ea2c51",
                                        "glosses": [
                                            "Ensemble des mesures prises, notamment dans le cadre d’opérations militaires, pour assurer la cohérence des actions menées conjointement par plusieurs intervenants dans un espace donné."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
