                "senses": [
                    {
                        "sense_id": "60fce927-de52-3192-acc5-86de4613bdf4",
                        "entry_id": "e7478ee3-c728-36f9-9182-560440f75393",
                        "glosses": [
                            "The rhythmic contraction of the heart, by which blood is driven through the arteries."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1eeef3aa-ed48-467b-9d1e-c5787d0a474f",
                                "sense_id": "60fce927-de52-3192-acc5-86de4613bdf4",
                                "text": "[…] I did almoſt beleeve, that the motion of the Heart vvas knovvn to God alone: For neither could I rightly diſtinguiſh, vvhich vvay the Diaſtole and Systole came to be, nor vvhen nor vvhere the dilation and conſtriction had its exiſtence."
                            },
                            {
                                "example_id": "b9e6269d-8be5-4e9f-a6f9-7a6632596213",
                                "sense_id": "60fce927-de52-3192-acc5-86de4613bdf4",
                                "text": "A double systole catapulted him into full consciousness again, and he promised his uncorrected self that he would limit his daily ration of cigarettes to a couple of heartbeats."
                            },
                            {
                                "example_id": "7bc5c6f2-2b2e-406a-96d5-169efc66e4f9",
                                "sense_id": "60fce927-de52-3192-acc5-86de4613bdf4",
                                "text": "There is no essential virtue in comfort. To be relaxed is good if it is part of a process of systole and diastole. Relaxation comes between phases of tenseness."
                            }
                        ]
                    },
                    {
                        "sense_id": "eacbc3a7-6b17-3607-abb7-5ab7dd9a7659",
                        "entry_id": "e7478ee3-c728-36f9-9182-560440f75393",
                        "glosses": [
                            "A shortening of a naturally long vowel."
