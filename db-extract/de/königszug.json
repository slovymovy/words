                        ],
                        "examples": [
                            {
                                "example_id": "c905b1bf-5a3f-407f-8c5e-4f5c2cd5adb9",
                                "sense_id": "edfcaad8-2f49-374b-bdfe-9731a061030f",
                                "text": "Mit einem abwartenden Königszug brachte Weiß seinen Gegner in Zugzwang."
                            },
                            {
                                "example_id": "b6e406a2-8868-41d9-bd6c-edaf95c19074",
                                "sense_id": "edfcaad8-2f49-374b-bdfe-9731a061030f",
                                "text": "Wer bereits einen Königszug ausgeführt hat, darf nicht mehr rochieren."
                            },
                            {
                                "example_id": "69448191-9386-4277-9748-8dd0fb9163c2",
                                "sense_id": "edfcaad8-2f49-374b-bdfe-9731a061030f",
                                "text": "Aber ich überlegte mir kaum einen Augenblick, ob ich den Springer schlagen sollte, denn der Königszug ist ja offenbar viel stärker, der Springer bleibt immer noch angegriffen und Schwarz gelangt sofort zum Gegenangriff."
                            },
                            {
                                "example_id": "c5db2fa7-1df8-4edf-a044-f850002fa2c8",
                                "sense_id": "edfcaad8-2f49-374b-bdfe-9731a061030f",
                                "text": "Der Königszug ist jetzt der beste Weg, um dem Verluste einer Figur, bezw. eines Bauers zu entgehen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
