        "fr-extract.jsonl": [
            {
                "entry_id": "7d789f6c-ab75-33c4-80d7-bd443846543c",
                "word": "Norne",
                "pos": "name",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4bb0ba48-5381-429d-8afe-f90bd75ba29f",
                        "entry_id": "7d789f6c-ab75-33c4-80d7-bd443846543c",
                        "tags": [
                            "plural"
                        ],
                        "form": "Nornes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ff196020-f65e-371a-bdf3-045c67fd6803",
                        "entry_id": "7d789f6c-ab75-33c4-80d7-bd443846543c",
                        "glosses": [
                            "Puissantes déités féminines de la mythologie nordique, dont les trois principales président à la destinée des divinités et des êtres humains au pied de l’arbre-monde Yggdrasil."
                        ],
                        "tags": [
                            "Divinité"
                        ],
                        "examples": [
                            {
                                "example_id": "3ce71eaa-a2ac-4088-9ad6-07addc10e25b",
                                "sense_id": "ff196020-f65e-371a-bdf3-045c67fd6803",
                                "text": "Vieille Urda, Verdandi, lamentez-vous, ô Nornes !\nCar voici que j’entends monter comme des flots\nDes cris de mort mêlés à de divins sanglots.\nPleurez, lamentez-vous, Nornes désespérées !\nIls sont venus, les jours des épreuves sacrées,\nLes suprêmes soleils dont le ciel flamboiera,\nLe siècle d’épouvante où le Juste mourra."
                            },
                            {
                                "example_id": "8b12ac18-05f7-4407-aae1-45c612c602e5",
                                "sense_id": "ff196020-f65e-371a-bdf3-045c67fd6803",
                                "text": "Cependant ils venaient vers moi ; peut-être apparition mythique, ronde de sorcières ou de nornes qui me proposait ses oracles. Je crus plutôt que c'étaient des fantômes du passé, de chers compagnons de mon enfance, des amis disparus qui invoquaient nos communs souvenirs."
                            },
                            {
                                "example_id": "9f28b806-ffba-4e3d-a825-206691cf01f4",
                                "sense_id": "ff196020-f65e-371a-bdf3-045c67fd6803",
                                "text": "Minne effiloche les franges de son châle, grave comme une jeune Norne tisseuse de destinées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ed7beb7-d071-447b-8bae-493d37eb0234",
                        "source_entry_id": "7d789f6c-ab75-33c4-80d7-bd443846543c",
                        "source_sense_id": "ff196020-f65e-371a-bdf3-045c67fd6803",
                        "target_lang_word": "Norne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Norne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cfab9f2c-0143-3d58-8245-58e3c760e53a",
                                        "entry_id": "9329b23b-7b13-30dd-9767-0b9120925b2a",
                                        "glosses": [
                                            "nordische Orchidee aus der Gattung Calypso"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f79d6ea3-6fa7-4893-9673-0493c8a7bb43",
                                                "sense_id": "cfab9f2c-0143-3d58-8245-58e3c760e53a",
                                                "text": "Die Norne ist zwar weit verbreitet, aber im Rückgang begriffen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bb810efa-25be-3387-b2e4-caddb67daa8c",
                                        "entry_id": "9329b23b-7b13-30dd-9767-0b9120925b2a",
                                        "glosses": [
                                            "Schicksalsgöttin der germanischen Mythologie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d71ebe45-efb2-4d14-8296-21a41b768248",
                                                "sense_id": "bb810efa-25be-3387-b2e4-caddb67daa8c",
                                                "text": "„Sie aber wollte als heilige Jungfrau den Nornen dienen.“"
                                            },
                                            {
                                                "example_id": "db73507a-7846-48bc-bbaa-2c9fa0872493",
                                                "sense_id": "bb810efa-25be-3387-b2e4-caddb67daa8c",
                                                "text": "„Aber eine Alte schleicht wie eine düstere Norne heran und führt das Mädchen weg.“"
                                            },
                                            {
                                                "example_id": "3ee883d8-4bb8-41e4-b182-82e2a1d7341d",
                                                "sense_id": "bb810efa-25be-3387-b2e4-caddb67daa8c",
                                                "text": "„Und vielleicht ist sie eine Norne oder eine Göttin, denn die Zeit erwacht, der Zeiger ruckt und wandert weiter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
