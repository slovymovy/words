                "senses": [
                    {
                        "sense_id": "b4fc5e65-707a-3e33-917b-5d812f9e2cf9",
                        "entry_id": "196e3b84-53c6-3aa3-8d0a-efe7df5c6ce1",
                        "glosses": [
                            "Verfahren zur Trennung eines Materialgemisches, bei dem Teile geringerer Dichte durch einen Luftstrom abgetrieben werden, während Teile größerer Dichte nach unten fallen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9aac93f0-bc8e-4924-b22d-c6587f6f831e",
                                "sense_id": "b4fc5e65-707a-3e33-917b-5d812f9e2cf9",
                                "text": "„Durch Windsichtung, Metallabscheider und andere Sortierverfahren werden die Verschlüsse aussortiert und beeinträchtigen die Glasschmelze nicht.“"
                            },
                            {
                                "example_id": "67c2235a-2e60-48b9-82ce-57a64599364a",
                                "sense_id": "b4fc5e65-707a-3e33-917b-5d812f9e2cf9",
                                "text": "„Zwei Windsichtungen sowie eine Magnetseparierung befreien das Strahlmittel von Staub, Blei und Asbest.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
