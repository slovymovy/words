                "senses": [
                    {
                        "sense_id": "69d2752d-7bf5-329e-8b9b-d19a63dd719e",
                        "entry_id": "a7d3c11c-c07c-30e1-a9bb-7b8129057972",
                        "glosses": [
                            "ursprünglich dramatische Dichtung für den Hörfunk; heute auch auf anderen Medien wie Schallplatte und CD erhältlich"
                        ],
                        "tags": [
                            "Medien"
                        ],
                        "examples": [
                            {
                                "example_id": "008d2605-89d9-4608-b7a6-692264e8cb7e",
                                "sense_id": "69d2752d-7bf5-329e-8b9b-d19a63dd719e",
                                "text": "Melchior Schedlers Hörspiel „Cordoba oder die Kunst des Badens“ ist auch als Hörbuch erhältlich."
                            },
                            {
                                "example_id": "5b86b2a7-45d3-4977-8130-49b6c23cbeb2",
                                "sense_id": "69d2752d-7bf5-329e-8b9b-d19a63dd719e",
                                "text": "„Das war wie ein Hörspiel, nur in echt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4ebb3147-5076-4349-8f6e-d2e056888773",
                        "source_entry_id": "a7d3c11c-c07c-30e1-a9bb-7b8129057972",
                        "source_sense_id": "69d2752d-7bf5-329e-8b9b-d19a63dd719e",
                        "target_lang_word": "radio drama",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "radio drama",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1af0be8-3455-3445-aa94-ebf8fccec75d",
                                        "entry_id": "547c3dbc-d6c6-3c6c-a310-c3467e321ee7",
                                        "glosses": [
                                            "Dramatized, purely acoustic performance, broadcast on radio or published on audio media, such as tape or CD."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd7c0214-5ab6-4b7d-adb7-dcc33e0370f6",
                                                "sense_id": "c1af0be8-3455-3445-aa94-ebf8fccec75d",
                                                "text": "STREAMING AUDIO & VIDEO: Including our live \"Seeing Ear Theatre\" radio drama staring Walter Koenig, classic SF & horror movies, Orson Welles' WAR OF THE WORLDS broadcast, episodes of MYSTERY SCIENCE THEATER 3000, Alien Voices, readings by Greg Bear, Sam Delany, Bruce Sterling & K.W. Jeter, cartoons, classic trailers & more!"
                                            },
                                            {
                                                "example_id": "ce7e6777-29c4-4344-b7b9-4763ead36a79",
                                                "sense_id": "c1af0be8-3455-3445-aa94-ebf8fccec75d",
                                                "text": "Before the advent of television, radio drama had a huge popular audience and dominated much of the broadcast schedule."
                                            },
                                            {
                                                "example_id": "0a2b1d6c-3d88-40f4-8d0b-01e2c49bbef3",
                                                "sense_id": "c1af0be8-3455-3445-aa94-ebf8fccec75d",
                                                "text": "Radio dramas in America are online."
                                            },
                                            {
                                                "example_id": "42b1dc39-c7c8-4136-bd93-72ed195ef883",
                                                "sense_id": "c1af0be8-3455-3445-aa94-ebf8fccec75d",
                                                "text": "Whether you want to create a simple one-person podcast or a multi segment radio drama, you'll find all the user-friendly tips, tools and tricks you need to get the perfect sound and reach your audience."
                                            },
                                            {
                                                "example_id": "b69fc79b-690c-4eb8-a562-43c05fb8b745",
                                                "sense_id": "c1af0be8-3455-3445-aa94-ebf8fccec75d",
                                                "text": "In a radio drama version, she and Rhys this week reprise their roles for LA Theatre Works."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fdbc7402-d4ac-4a9c-9f7f-d36ce122b249",
                        "source_entry_id": "a7d3c11c-c07c-30e1-a9bb-7b8129057972",
