                        "sense_id": "e941f971-5d01-362c-9d24-b5c367985fb7",
                        "entry_id": "9f97e306-d3e2-3d11-b74f-fc2057973445",
                        "glosses": [
                            "Radiogerät, in das ein Gerät zum Abspielen von Kassetten (Tonbandkassetten) integriert ist"
                        ],
                        "tags": [
                            "Unterhaltungselektronik"
                        ],
                        "examples": [
                            {
                                "example_id": "af3c8d0c-2825-4c4d-8b4b-47a275736b9f",
                                "sense_id": "e941f971-5d01-362c-9d24-b5c367985fb7",
                                "text": "„Erst die Musik aus dem Kassettenradio meines Mietwagens macht es mir möglich, diese Ruhe zu verstehen.“"
                            },
                            {
                                "example_id": "ff7f436c-da7b-4c86-a538-991eb7f1f8dc",
                                "sense_id": "e941f971-5d01-362c-9d24-b5c367985fb7",
                                "text": "„Die zivile Iltisversion bot sogar ein Kassettenradio.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
