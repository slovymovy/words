                ],
                "senses": [
                    {
                        "sense_id": "52bfebae-7789-33e2-bc34-5e1b19ca75c0",
                        "entry_id": "5bee7daa-65fc-3a65-bf23-fefaa52a3e00",
                        "glosses": [
                            "gekozen worden in een verkiezing"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14336d64-b184-40a9-90e4-d826e531441b",
                                "sense_id": "52bfebae-7789-33e2-bc34-5e1b19ca75c0",
                                "text": "Voor Schippers is het de tweede verkiezing tot Sportvrouw van het Jaar, na 2015. Ze volgt op de erelijst turnster Sanne Wevers op. Voor Dumoulin was het zijn eerste uitverkiezing, hij volgt op de erelijst Max Verstappen op."
                            },
                            {
                                "example_id": "d6213021-8cb9-43c5-9f3a-41ab849175c2",
                                "sense_id": "52bfebae-7789-33e2-bc34-5e1b19ca75c0",
                                "text": "Vorig seizoen eindigde Verstappen ook al als tweede in de uitverkiezing. Hij dankte die plek toen grotendeels aan een weergaloze inhaalrace in de GP van Brazilië."
                            }
                        ]
                    },
                    {
                        "sense_id": "0bb14bcf-2043-3038-b920-22c3d9e279a8",
                        "entry_id": "5bee7daa-65fc-3a65-bf23-fefaa52a3e00",
                        "glosses": [
                            "het door god uitgekozen zijn om het eeuwige leven te krijgen na de dood"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe69bb45-5445-45e6-8aed-d79dfaa953c0",
                        "source_entry_id": "5bee7daa-65fc-3a65-bf23-fefaa52a3e00",
