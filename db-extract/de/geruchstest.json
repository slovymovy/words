                                "target_senses": [
                                    {
                                        "sense_id": "5ebe3d07-8b9a-3e7d-844f-b94c91e51be4",
                                        "entry_id": "a46041c3-057e-3c28-a6a7-0b51badb680a",
                                        "glosses": [
                                            "An informal method for determining whether something is authentic, credible, or ethical, by using one's common sense or sense of propriety."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e68b371b-d06b-4a51-86b6-88d4f0e03c1a",
                                                "sense_id": "5ebe3d07-8b9a-3e7d-844f-b94c91e51be4",
                                                "text": "Near-synonyms: sanity test, sanity check, reality check"
                                            },
                                            {
                                                "example_id": "d637f24d-015d-44ba-bbf8-711341492b47",
                                                "sense_id": "5ebe3d07-8b9a-3e7d-844f-b94c91e51be4",
                                                "text": "to pass the smell test"
                                            },
                                            {
                                                "example_id": "ebd9b07f-84a7-4b34-bcac-125557a8470c",
                                                "sense_id": "5ebe3d07-8b9a-3e7d-844f-b94c91e51be4",
                                                "text": "It just doesn't pass the smell test. It just creates too many opportunities for cutting corners, doing unethical things and basically not telling the truth."
                                            },
                                            {
                                                "example_id": "d2cdbe8e-c27b-486c-87c1-144c84391f7a",
                                                "sense_id": "5ebe3d07-8b9a-3e7d-844f-b94c91e51be4",
                                                "text": "These aren’t the first megadeals cut by politicians that do not pass the smell test, but nobody has been swindled like the Yankee Stadium community."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17f43c61-bd56-30af-b79f-2fd085aedacf",
                                        "entry_id": "a46041c3-057e-3c28-a6a7-0b51badb680a",
                                        "glosses": [
                                            "An inspection of an object using the sense of smell, as for freshness of food or cleanliness of clothing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "591e1424-f8a5-4b11-8390-bee2920eadb9",
                                                "sense_id": "17f43c61-bd56-30af-b79f-2fd085aedacf",
                                                "text": "I give the smell test to many foods when I shop."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "baa04b0d-5521-3237-be24-6f4099e34c6c",
                                        "entry_id": "a46041c3-057e-3c28-a6a7-0b51badb680a",
                                        "glosses": [
                                            "An assessment of a subject's ability to detect and distinguish odors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1682bfba-cd49-4ee4-a134-ca12bb45f626",
                                                "sense_id": "baa04b0d-5521-3237-be24-6f4099e34c6c",
                                                "text": "Although scientists have yet to pin down any biological basis for cigarette smokers' impaired performance on the smell test, Doty says he suspects that certain chemicals in smoke . . . damage the olfactory receptor cells in the nose."
                                            }
                                        ]
                                    }
