                                            {
                                                "example_id": "8ae00d13-ea6f-4164-87ca-d162a5b9d104",
                                                "sense_id": "94556a5e-14a2-31fe-977a-2730f40ffa53",
                                                "text": "De actiegroep 'hooligans tegen salafisten', een oplossing voor twee problemen?"
                                            }
                                        ]
