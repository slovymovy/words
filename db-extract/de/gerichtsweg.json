                ],
                "senses": [
                    {
                        "sense_id": "8d1ebab7-a28e-32ef-9765-67fff1d5e3ef",
                        "entry_id": "dbd94b07-a3a8-3f2b-ad85-612ebc51d4a1",
                        "glosses": [
                            "ein Straßenname in verschiedenen Städten Deutschlands (beispielsweise in Bonn, Leipzig)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4313452-86e9-4563-a2b3-cbb2bfe2a57a",
                                "sense_id": "8d1ebab7-a28e-32ef-9765-67fff1d5e3ef",
                                "text": "„Der Gebäudekomplex erstreckt sich über 100 Meter längs der Prager Straße zwischen dem Gutenbergplatz und dem Gerichtsweg, in dem sich unter der Nummer 28 der Zugang befindet.“"
                            },
                            {
                                "example_id": "99daec58-aa85-4f6a-81be-cd7d81ee4b2d",
                                "sense_id": "8d1ebab7-a28e-32ef-9765-67fff1d5e3ef",
                                "text": "[Leipzig, Prager Straße:] „Vom Gerichtsweg bis Probstheida ist sie vierstreifig ausgebaut.“"
                            },
                            {
                                "example_id": "13a94f10-b00a-4b34-93bd-87d72b639e8d",
                                "sense_id": "8d1ebab7-a28e-32ef-9765-67fff1d5e3ef",
                                "text": "„Die vom Namensgeber C.G.Röder 1846 gegründete Druckereiwerkstatt (Graphische Anstalt) wuchs sehr schnell, so wurde bereits 1872 der Firmensitz in den Leipziger Gerichtsweg, nahe dem Graphischen Viertel verlegt, wo die Firma 1905 in eine GmbH umgewandelt wurde.“"
                            },
                            {
                                "example_id": "cdc57d9c-8611-4259-bda8-ba482bc48aff",
                                "sense_id": "8d1ebab7-a28e-32ef-9765-67fff1d5e3ef",
                                "text": "„Laut Polizei ist ein Lkw-Fahrer von der Bundesstraße 5 in den Gerichtsweg abgebogen.“"
                            },
                            {
                                "example_id": "17e751f2-aa12-4f75-9bf0-324a5a79a395",
                                "sense_id": "8d1ebab7-a28e-32ef-9765-67fff1d5e3ef",
                                "text": "„Ein guter Ausgangspunkt für einen Spaziergang ist der Parkplatz am Gerichtsweg/ Ecke Weißer Moorweg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
