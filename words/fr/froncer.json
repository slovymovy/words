                    "frequency": "Low",
                    "semantic_group_id": "plissement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La couturière doit <w>froncer</w> une jupe pour lui donner une forme beaucoup plus élégante."
                        },
                        {
                            "text": "Elle tire doucement sur deux fils parallèles afin de <w>froncer</w> le tissu de manière régulière."
