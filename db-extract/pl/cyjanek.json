                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f111e4d1-306e-4792-99fb-ebd3191bf378",
                                                "sense_id": "57a10a83-a8ba-33a2-bcaa-f8ec1a5c0f8e",
                                                "text": "Die Großrazzia gegen eine vermutete Bombenwerkstatt in London ist nach Zeitungsangaben durch Hinweise auf einen geplanten Anschlag mit dem Giftstoff Zyanid ausgelöst worden."
                                            },
                                            {
                                                "example_id": "47ac9ed2-890e-4d8c-b34e-5025164acc98",
                                                "sense_id": "57a10a83-a8ba-33a2-bcaa-f8ec1a5c0f8e",
                                                "text": "Flüsse, Bäche und Seen sind mit Blei, Quecksilber, Zyanid und Öl nicht nur vergiftet, sondern regelrecht gesättigt."
                                            },
                                            {
                                                "example_id": "528b9be8-f745-4f05-9543-f318d3354c96",
                                                "sense_id": "57a10a83-a8ba-33a2-bcaa-f8ec1a5c0f8e",
                                                "text": "Die Säure, die in Reaktion mit dem Zyanid das tödliche Gas (Zyklon B) produzieren soll, wird in den Behälter unter dem perforierten Sitz geleitet."
                                            },
                                            {
                                                "example_id": "b7da060e-f25e-4df8-b581-c8d8fadcd6bc",
                                                "sense_id": "57a10a83-a8ba-33a2-bcaa-f8ec1a5c0f8e",
                                                "text": "1954 verspeiste er im Bett liegend einen Apfel, den er selbst mit Zyanid vergiftet hatte."
                                            },
                                            {
                                                "example_id": "d5764ef4-764b-4f06-9fd8-481c9d92dc93",
                                                "sense_id": "57a10a83-a8ba-33a2-bcaa-f8ec1a5c0f8e",
                                                "text": "Die Entdeckungen gingen quer über alle Klassen, Ordnungen, Familien, Gattungen und Arten: ein Tausendfüßler, dem man nicht zu nahe kommen sollte, weil er seine Feinde mit hochgiftigem Zyanid vertreibt; […]"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
