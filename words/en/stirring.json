{
    "word_family": [
        "stir"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d89af451-c858-338d-a51f-09a9b136b713",
                    "sense_definition": "Causing strong feelings of excitement or enthusiasm",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_impact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band played a <w>stirring</w> anthem that made the entire crowd stand up and cheer.",
                            "target_lang_translations": {
                                "cs": "Kapela zahrála <w>strhující</w> hymnu, při které celé publikum vstalo a začalo jásat.",
                                "fr": "Le groupe a joué un hymne <w>enthousiasmant</w> qui a fait se lever et acclamer toute la foule."
                            }
                        },
                        {
                            "text": "She gave a <w>stirring</w> speech that inspired everyone in the room to take action.",
                            "target_lang_translations": {
                                "cs": "Pronesla <w>dojemný</w> projev, který inspiroval všechny v místnosti k akci.",
                                "fr": "Elle a prononcé un discours <w>passionnant</w> qui a inspiré tout le monde dans la salle à passer à l'action."
                            }
                        }
                    ],
                    "synonyms": [
                        "inspiring",
                        "moving",
                        "exciting"
                    ],
                    "antonyms": [
                        "boring",
                        "dull"
                    ],
                    "common_phrases": [
                        "stirring speech",
                        "stirring performance"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vyvolávající silné pocity nadšení nebo vzrušení",
                        "fr": "Qui suscite de forts sentiments d'enthousiasme ou d'excitation"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "dojemný",
                                "target_lang_sense_clarification": "vyvolávající silné emoce"
                            },
                            {
                                "target_lang_word": "strhující",
                                "target_lang_sense_clarification": "poutavý a vzrušující"
                            },
                            {
                                "target_lang_word": "inspirativní",
                                "target_lang_sense_clarification": "podněcující k akci nebo myšlení"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "enthousiasmant",
                                "target_lang_sense_clarification": "qui provoque l'enthousiasme"
                            },
                            {
                                "target_lang_word": "passionnant",
                                "target_lang_sense_clarification": "qui captive et suscite un vif intérêt"
                            },
                            {
                                "target_lang_word": "émouvant",
                                "target_lang_sense_clarification": "qui touche profondément les sentiments"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0e1dc604-5153-3e69-aff2-2a10d5deb002",
                    "sense_definition": "The first signs or early feelings of something starting to happen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "beginning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We felt the first <w>stirrings</w> of spring as the snow began to melt away.",
                            "target_lang_translations": {
                                "cs": "Cítili jsme první <w>náznaky</w> jara, jak sníh začal tát.",
                                "fr": "Nous avons senti les <w>prémices</w> du printemps alors que la neige commençait à fondre."
                            }
                        },
                        {
                            "text": "The economic report showed the early <w>stirrings</w> of a recovery in the local market.",
                            "target_lang_translations": {
                                "cs": "Ekonomická zpráva ukázala první <w>zárodky</w> oživení na místním trhu.",
                                "fr": "Le rapport économique a montré les <w>débuts</w> d'une reprise sur le marché local."
                            }
                        }
                    ],
                    "synonyms": [
                        "beginnings",
                        "signs"
                    ],
                    "common_phrases": [
                        "stirrings of change",
                        "early stirrings"
                    ],
                    "target_lang_definitions": {
                        "cs": "První náznaky nebo počáteční pocity něčeho, co začíná",
                        "fr": "Les premiers signes ou sentiments initiaux de quelque chose qui commence à se produire"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "náznaky",
                                "target_lang_sense_clarification": "prvotní projevy něčeho"
                            },
                            {
                                "target_lang_word": "zárodky",
                                "target_lang_sense_clarification": "počáteční fáze vývoje"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "prémices",
                                "target_lang_sense_clarification": "les premiers signes d'un événement"
                            },
                            {
                                "target_lang_word": "débuts",
                                "target_lang_sense_clarification": "la phase initiale d'un processus"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7f8e4d2d-9c56-33ae-8d49-3d550e5f2baf",
                    "sense_definition": "Present participle and gerund of <w>stir</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was <w>stirring</w> the soup while it cooked on the stove.",
                            "target_lang_translations": {
                                "cs": "Právě <w>míchala</w> polévku, zatímco se vařila na sporáku.",
                                "fr": "Elle était <w>en train de remuer</w> la soupe pendant qu'elle cuisait sur la cuisinière."
                            }
                        },
                        {
                            "text": "The wind was <w>stirring</w> the leaves on the ground.",
                            "target_lang_translations": {
                                "cs": "Vítr <w>vířil</w> listí na zemi.",
                                "fr": "Le vent <w>remuait</w> les feuilles sur le sol."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stirring the pot"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Přítomné příčestí a gerundium slovesa míchat",
                        "fr": "Participe présent et gérondif du verbe remuer ou mélanger"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "míchající",
                                "target_lang_sense_clarification": "pohybující něčím v kruhu"
                            },
                            {
                                "target_lang_word": "míchání",
                                "target_lang_sense_clarification": "činnost spočívající v míchání"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "remuant",
                                "target_lang_sense_clarification": "qui est en train de mélanger ou de bouger"
                            },
                            {
                                "target_lang_word": "en train de remuer",
                                "target_lang_sense_clarification": "expression pour décrire l'action en cours"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}