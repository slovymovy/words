                    {
                        "sense_id": "e4802e59-fbb2-3e1e-a347-c4f2fe1ea337",
                        "entry_id": "fbc3ffd8-d3f7-33c9-a2cb-f14943362b74",
                        "glosses": [
                            "Action de commercialiser ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d1a2933-58a8-4615-9cbf-da5773408970",
                                "sense_id": "e4802e59-fbb2-3e1e-a347-c4f2fe1ea337",
                                "text": "Le caractère périssable génère un risque de « stock mort », c'est-à-dire sans possibilité de commercialisation si ce n'est dans le cadre d'une valorisation des déchets."
                            },
                            {
                                "example_id": "8e9aa224-fb1c-4b4f-9624-28489b0df26a",
                                "sense_id": "e4802e59-fbb2-3e1e-a347-c4f2fe1ea337",
                                "text": "La Commission européenne a autorisé, le 3 janvier, la commercialisation « d’Acheta domesticus (grillons domestiques) partiellement dégraissés en tant que nouvel aliment »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5048d5c1-cc5c-406f-b945-48c349dd5d38",
                        "source_entry_id": "fbc3ffd8-d3f7-33c9-a2cb-f14943362b74",
                        "source_sense_id": "e4802e59-fbb2-3e1e-a347-c4f2fe1ea337",
                        "target_lang_word": "Vermarktung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vermarktung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "586c19b4-cf6d-3322-b686-b90e3fe2d402",
                                        "entry_id": "38c8bb3d-248c-303d-8746-d3045912524e",
                                        "glosses": [
                                            "Förderung des Absatzes von Produkten oder Dienstleistungen zur Unterstützung des Vertriebes unter besonderer Berücksichtigung der Bedürfnisse ausgewählter Märkte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c673d2b5-be0d-4c01-ae6e-da100c5b55ba",
                                                "sense_id": "586c19b4-cf6d-3322-b686-b90e3fe2d402",
                                                "text": "Am Donnerstag haben der britische Premierminister Gordon Brown und der französische Staatspräsident Nicolas Sarkozy wie angekündigt ein Abkommen über die Entwicklung und Vermarktung einer neuen Generation von Atomreaktoren unterzeichnet."
                                            },
                                            {
                                                "example_id": "aaea149b-939c-407a-85ac-d3ae4d3c1926",
                                                "sense_id": "586c19b4-cf6d-3322-b686-b90e3fe2d402",
                                                "text": "ProSiebenSat1 hatte - wie der Rivale RTL - nach Ansicht des deutschen Bundeskartellamts große Kunden bei der Vermarktung von Fernsehwerbezeiten begünstigt und kleine unfair benachteiligt."
                                            },
                                            {
                                                "example_id": "9aa0d8a6-5e8c-4202-911b-683bb1893ba9",
                                                "sense_id": "586c19b4-cf6d-3322-b686-b90e3fe2d402",
                                                "text": "Mit einer Mahnwache in Eisbärenkostümen protestierten Mitglieder der Organisation Menschen für Tierrechte vor dem Nürnberger Tiergarten gegen die ihrer Ansicht nach gnadenlose Vermarktung der kleinen Flocke."
                                            },
                                            {
                                                "example_id": "bb9bab41-0cd6-4468-81a8-5c07d2469979",
                                                "sense_id": "586c19b4-cf6d-3322-b686-b90e3fe2d402",
                                                "text": "In der IdeenBox wird die Arbeitsweise eines produzierenden Unternehmens transparent und verständlich gemacht. Sie veranschaulicht den Weg einer Idee über die Umsetzung in ein Produkt bis hin zu dessen Vermarktung."
                                            },
                                            {
                                                "example_id": "373cb66f-ce41-4b44-95b8-b6b0e8f9e1a4",
                                                "sense_id": "586c19b4-cf6d-3322-b686-b90e3fe2d402",
                                                "text": "Der Clou an Nabucco: Im Gegensatz zu allen anderen Leitungen aus dem Osten Europas wäre hier der fast allmächtige russische Konzern Gasprom einmal nicht an Produktion, Transport und Vermarktung beteiligt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a397f8d-d460-4448-a372-8f55f9cedee7",
                        "source_entry_id": "fbc3ffd8-d3f7-33c9-a2cb-f14943362b74",
