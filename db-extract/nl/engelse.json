                                "sense_id": "875d9d21-6307-31ba-97ec-1d9011f82a1c",
                                "text": "Ik was niet voor niets de strijd met de jongens aangegaan om cum laude af te studeren in Engelse literatuur aan de universiteit van West-Indië."
                            },
                            {
                                "example_id": "f8b6b4eb-c0bf-4a07-b31f-31aad623f71d",
                                "sense_id": "875d9d21-6307-31ba-97ec-1d9011f82a1c",
                                "text": "In de tussentijd schreef ik wraakgedichten over het Engelse weer en diste ik tegen mijn moeder de leugen op dat Londen het einde was."
                            }
                        ]
                    }
