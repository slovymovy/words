                                "sense_id": "c0b42070-fa45-3c5f-8bf0-359828d34fe5",
                                "text": "De yank ging het restaurant binnen."
                            },
                            {
                                "example_id": "b5a02270-fa53-4726-bae3-18ebe1b55bb6",
                                "sense_id": "c0b42070-fa45-3c5f-8bf0-359828d34fe5",
