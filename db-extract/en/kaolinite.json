                        "entry_id": "4ab946c2-60ac-3010-9b3d-cc5e5ee8f099",
                        "glosses": [
                            "A common hydrous aluminosilicate mineral found in sediments, soils and sedimentary rocks, Al₂Si₂O₅(OH)₄; one of the kaolin group of minerals."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "998c7b2b-243a-481d-ac17-a790e29cf0b9",
                        "source_entry_id": "4ab946c2-60ac-3010-9b3d-cc5e5ee8f099",
                        "source_sense_id": "a3723b0f-725e-367d-b692-5dbafec48ae2",
