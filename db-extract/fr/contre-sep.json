                        "entry_id": "6e62e805-8f9e-3e8e-9c01-b639bbc19598",
                        "glosses": [
                            "Pièce métallique protégeant le sep et l’étançon d’une charrue de l’usure par frottement."
                        ],
                        "tags": [
                            "Technique agricole"
                        ],
                        "examples": [
                            {
                                "example_id": "30563abd-7122-41e6-ac1d-695528dbcd7c",
                                "sense_id": "0b82c277-6975-365e-94c5-c841bb855b59",
                                "text": "La pointe, à feuillures, s’engage dans une rainure du porte-soc en fer forgé et dans la feuillure du contre-sep trapéziforme."
                            },
                            {
                                "example_id": "2d28ebce-c549-4c34-a1c2-c9a8e425b16f",
                                "sense_id": "0b82c277-6975-365e-94c5-c841bb855b59",
                                "text": "Afin de donner un plus bel aspect au labour, on rapporte contre le sep et contre les étançons une feuille d’acier qui porte le nom de contre-sep."
                            },
                            {
                                "example_id": "e31e1058-598c-4621-907c-21c0f400e86a",
                                "sense_id": "0b82c277-6975-365e-94c5-c841bb855b59",
                                "text": "Le contre-sep est une plaque d’usure horizontale. Il frotte contre la muraille et permet au corps de labour d’avancer parallèlement à l’axe du tracteur."
                            }
                        ]
                    }
