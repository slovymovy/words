                                "example_id": "9b412a9c-6d1f-46ae-8a23-62ddd7a9dced",
                                "sense_id": "0f4b09b1-18be-319d-84fa-6f6f3ea0c12b",
                                "text": "„Die Zelle wird von einer Vorratsbatterie oder einem Gleichrichter gespeist und ist mit einem Coulombmeter der gebräuchlichen Art verbunden.“"
                            }
                        ],
