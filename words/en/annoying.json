    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4e89b8d1-9345-312f-93a8-a56448c45656",
                    "sense_definition": "Causing irritation or annoyance; troublesome; vexatious.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Having flies in your bedroom when you're trying to sleep is really <w>annoying</w>.",
                            "target_lang_translations": {
                                "ru": "Мухи в спальне, когда пытаешься уснуть, действительно <w>раздражают</w>.",
                                "zh": "睡觉时卧室里有苍蝇真的很<w>烦人</w>。"
                            }
                        },
                        {
                            "text": "She has an <w>annoying</w> habit of tapping her pen on the desk.",
                            "target_lang_translations": {
                                "ru": "У неё есть <w>раздражающая</w> привычка стучать ручкой по столу.",
                                "zh": "她有一个<w>讨厌</w>的习惯，喜欢用笔敲桌子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "irritating",
                        "bothersome",
                        "troublesome",
                        "aggravating",
                        "obnoxious",
                        "irksome",
                        "vexatious",
                        "frustrating",
                        "pesky"
                    ],
                    "antonyms": [
                        "pleasant",
                        "delightful",
                        "soothing"
                    ],
                    "common_phrases": [
                        "really annoying",
                        "annoying habit",
                        "how annoying",
                        "find it annoying"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий раздражение или беспокойство; досадный, неприятный.",
                        "zh": "引起烦恼或不快的；令人讨厌的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздража́ющий",
                                "target_lang_sense_clarification": "causing irritation"
                            },
                            {
                                "target_lang_word": "надое́дливый",
                                "target_lang_sense_clarification": "bothersome, tiresome"
                            },
                            {
                                "target_lang_word": "назо́йливый",
                                "target_lang_sense_clarification": "intrusive, pestering"
                            },
                            {
                                "target_lang_word": "доса́дный",
                                "target_lang_sense_clarification": "vexatious, unfortunate"
                            }
                        ],
                        "zh": [
