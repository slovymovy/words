{
    "word_family": [
        "holiness",
        "unholy"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0ab8aee3-5be7-306c-80ab-b31b6ba8ef64",
                    "sense_definition": "Dedicated to a religious purpose or a god.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "religious_meaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many pilgrims travel to the <w>holy</w> city every year to pray.",
                            "target_lang_translations": {
                                "ru": "Многие паломники каждый год едут в <w>святой</w> город, чтобы помолиться.",
                                "zh": "每年都有许多朝圣者前往那座<w>圣</w>城祈祷。"
                            }
                        },
                        {
                            "text": "The priest blessed the congregation with <w>holy</w> water during the service.",
                            "target_lang_translations": {
                                "ru": "Священник благословил прихожан <w>святой</w> водой во время службы.",
                                "zh": "仪式期间，牧师用<w>圣</w>水为会众祝福。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sacred",
                        "religious"
                    ],
                    "antonyms": [
                        "profane",
                        "secular",
                        "unholy",
                        "worldly"
                    ],
                    "common_phrases": [
                        "holy water",
                        "holy spirit",
                        "holy land",
                        "holy war",
                        "holy book"
                    ],
                    "target_lang_definitions": {
                        "ru": "Посвященный религиозной цели или богу.",
                        "zh": "专门用于宗教目的或献给神的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свято́й",
                                "target_lang_sense_clarification": "относящийся к богу, обладающий божественной силой"
                            },
                            {
                                "target_lang_word": "свяще́нный",
                                "target_lang_sense_clarification": "чтимый, неприкосновенный, связанный с богослужением"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "神圣的",
                                "target_lang_sense_clarification": "指与神相关或受宗教崇敬的"
                            },
                            {
                                "target_lang_word": "圣",
                                "target_lang_sense_clarification": "用于地名或特定宗教事物前缀"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ed5cf76-68e0-3025-89c6-4bf7d306b6ad",
                    "sense_definition": "Morally perfect, pure, or very devout.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "religious_meaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was known as a <w>holy</w> woman who dedicated her life to the poor.",
                            "target_lang_translations": {
                                "ru": "Она была известна как <w>святая</w> женщина, посвятившая свою жизнь бедным.",
                                "zh": "她以一位<w>圣洁</w>的女性而闻名，一生致力于帮助穷人。"
                            }
                        },
                        {
                            "text": "The monks strive to live a <w>holy</w> life away from modern distractions.",
                            "target_lang_translations": {
                                "ru": "Монахи стремятся вести <w>святую</w> жизнь вдали от современных соблазнов.",
                                "zh": "僧侣们努力远离现代生活的干扰，过着<w>圣洁</w>的生活。"
                            }
                        }
                    ],
                    "synonyms": [
                        "godly",
                        "perfect",
                        "flawless",
                        "pious",
                        "saintly"
                    ],
                    "antonyms": [
                        "unholy",
                        "flawed",
                        "imperfect"
                    ],
                    "common_phrases": [
                        "holy man",
                        "holy life"
                    ],
                    "target_lang_definitions": {
                        "ru": "Морально совершенный, чистый или очень набожный.",
                        "zh": "道德上完美、纯洁或非常虔诚的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свято́й",
                                "target_lang_sense_clarification": "обладающий высокой нравственной чистотой"
                            },
                            {
                                "target_lang_word": "пра́ведный",
                                "target_lang_sense_clarification": "живущий согласно религиозным правилам, безгрешный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "圣洁的",
                                "target_lang_sense_clarification": "指品德高尚、纯洁无瑕"
                            },
                            {
                                "target_lang_word": "虔诚的",
                                "target_lang_sense_clarification": "指对宗教信仰非常忠诚"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5cc9919-9df0-307e-9734-aa37868d3488",
                    "sense_definition": "Used as an intensifier to express surprise, shock, or annoyance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Holy</w> cow, I cannot believe we actually won the lottery!",
                            "target_lang_translations": {
                                "ru": "<w>Боже</w>, не могу поверить, что мы действительно выиграли в лотерею!",
                                "zh": "<w>天哪</w>，真不敢相信我们竟然中了彩票！"
                            }
                        },
                        {
                            "text": "It was a <w>holy</w> mess in the kitchen after the kids finished cooking.",
                            "target_lang_translations": {
                                "ru": "На кухне был <w>ужасный</w> бардак, когда дети закончили готовить.",
                                "zh": "孩子们做完饭后，厨房里<w>简直</w>是一团糟。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "holy cow",
                        "holy smoke",
                        "holy moly"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used for emphasis in exclamations"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для усиления выражения удивления, шока или раздражения.",
                        "zh": "用作强调词，表达惊讶、震惊或恼怒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бо́же",
                                "target_lang_sense_clarification": "в составе восклицаний (напр. Holy cow - Боже мой)"
                            },
                            {
                                "target_lang_word": "ну и",
                                "target_lang_sense_clarification": "усилительная частица для негативных ситуаций (напр. Holy mess)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "天哪",
                                "target_lang_sense_clarification": "用于表达惊讶或震惊"
                            },
                            {
                                "target_lang_word": "简直",
                                "target_lang_sense_clarification": "用于强调程度，常带负面情绪"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "72e05df2-4ee9-389c-a7ba-a41890df33d4",
                    "sense_definition": "An expression of astonishment and awe.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Holy</w>, did you see how fast that car was going?",
                            "target_lang_translations": {
                                "ru": "<w>Обалдеть</w>, ты видел, как быстро ехала эта машина?",
                                "zh": "<w>天哪</w>，你看到那辆车开得有多快了吗？"
                            }
                        },
                        {
                            "text": "<w>Holy</w>, that was an incredibly close call for us.",
                            "target_lang_translations": {
                                "ru": "<w>Офигеть</w>, это было невероятно опасно для нас.",
                                "zh": "<w>我的天</w>，我们刚才真是死里逃生。"
                            }
                        }
                    ],
                    "synonyms": [
                        "holy shit"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often short for longer exclamations"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражение изумления и благоговения.",
                        "zh": "表达惊奇和敬畏的感叹。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обалде́ть",
                                "target_lang_sense_clarification": "разговорное выражение сильного удивления"
                            },
                            {
                                "target_lang_word": "ничего́ себе",
                                "target_lang_sense_clarification": "возглас удивления"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "天哪",
                                "target_lang_sense_clarification": "表达极度惊讶"
                            },
                            {
                                "target_lang_word": "我的天",
                                "target_lang_sense_clarification": "表达惊叹"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e3da2f6d-cf8a-31e4-bf25-5d31a63cdb0c",
                    "sense_definition": "A specific sacred place or thing; the inner sanctuary of a temple.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Only the high priest was allowed to enter the <w>holy</w> of holies once a year.",
                            "target_lang_translations": {
                                "ru": "Только первосвященнику разрешалось входить в <w>святая</w> святых раз в год.",
                                "zh": "只有大祭司每年才被允许进入<w>至圣所</w>一次。"
                            }
                        },
                        {
                            "text": "He considered his private office to be his personal <w>holy</w> of holies.",
                            "target_lang_translations": {
                                "ru": "Он считал свой личный кабинет своей персональной <w>святая</w> святых.",
                                "zh": "他把自己的私人办公室视为个人的<w>圣地</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "holy of holies"
                    ],
                    "target_lang_definitions": {
                        "ru": "Особое священное место или предмет; внутреннее святилище храма.",
                        "zh": "特定的神圣场所或事物；寺庙的内殿。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "святы́ня",
                                "target_lang_sense_clarification": "предмет или место религиозного поклонения"
                            },
                            {
                                "target_lang_word": "свята́я святы́х",
                                "target_lang_sense_clarification": "сакральное, сокровенное место"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "圣地",
                                "target_lang_sense_clarification": "指神圣的场所"
                            },
                            {
                                "target_lang_word": "至圣所",
                                "target_lang_sense_clarification": "指宗教建筑中最神圣的内殿"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}