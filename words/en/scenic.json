{
    "word_family": [
        "scene",
        "scenery",
        "scenically",
        "scenario",
        "scenography"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4af86ec9-021e-3760-9f48-e256620ddb41",
                    "sense_definition": "Having beautiful or impressive natural scenery; picturesque.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "visual_beauty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We have plenty of time, so let's take the <w>scenic</w> route through the mountains.",
                            "target_lang_translations": {
                                "ru": "У нас много времени, так что давай поедем по <w>живописному</w> маршруту через горы."
                            }
                        },
                        {
                            "text": "The hotel balcony offers a <w>scenic</w> view of the entire bay.",
                            "target_lang_translations": {
                                "ru": "С балкона отеля открывается <w>красивый</w> вид на весь залив."
                            }
                        }
                    ],
                    "synonyms": [
                        "picturesque",
                        "panoramic",
                        "beautiful"
                    ],
                    "antonyms": [
                        "unattractive",
                        "ugly"
                    ],
                    "common_phrases": [
                        "scenic route",
                        "scenic view",
                        "scenic beauty",
                        "scenic overlook"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий красивыми или впечатляющими природными пейзажами; живописный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "живописный",
                                "target_lang_sense_clarification": "о пейзаже или маршруте"
                            },
                            {
                                "target_lang_word": "красивый",
                                "target_lang_sense_clarification": "о виде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce657265-5b4d-348f-bb82-2ab5e6257c04",
                    "sense_definition": "Relating to the natural features of a landscape or the stage sets in a theater.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "landscape_theater",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The designer is responsible for all the <w>scenic</w> elements of the play.",
                            "target_lang_translations": {
                                "ru": "Дизайнер отвечает за все <w>сценические</w> элементы спектакля."
                            }
                        },
                        {
                            "text": "The committee is working on <w>scenic</w> preservation to protect the valley.",
                            "target_lang_translations": {
                                "ru": "Комитет работает над сохранением <w>ландшафтной</w> красоты для защиты долины."
                            }
                        }
                    ],
                    "common_phrases": [
                        "scenic design",
                        "scenic artist"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к природным особенностям ландшафта или к декорациям в театре."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сценический",
                                "target_lang_sense_clarification": "относящийся к театру и декорациям"
                            },
                            {
                                "target_lang_word": "ландшафтный",
                                "target_lang_sense_clarification": "относящийся к сохранению природы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b8038a4-2f2a-3465-b764-7f0c3dd1c28a",
                    "sense_definition": "Relating to or resembling a dramatic or theatrical performance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "theatrical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The novel's <w>scenic</w> structure makes it very easy to adapt for the screen.",
                            "target_lang_translations": {
                                "ru": "<w>Сценичная</w> структура романа позволяет очень легко адаптировать его для экрана."
                            }
                        },
                        {
                            "text": "He had a <w>scenic</w> way of describing his travels that captivated the audience.",
                            "target_lang_translations": {
                                "ru": "Он описывал свои путешествия в такой <w>живописной</w> манере, что это завораживало аудиторию."
                            }
                        }
                    ],
                    "synonyms": [
                        "dramatic",
                        "theatrical"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к драматическому или театральному представлению или напоминающий его."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сценичный",
                                "target_lang_sense_clarification": "пригодный для сцены или напоминающий её"
                            },
                            {
                                "target_lang_word": "драматический",
                                "target_lang_sense_clarification": "о структуре повествования"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "828477fd-32b5-3e62-8cef-2b88fdcb09a1",
                    "sense_definition": "A picture, photograph, or other depiction of beautiful natural scenery.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "visual_art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The calendar is filled with beautiful <w>scenics</w> from across the national parks.",
                            "target_lang_translations": {
                                "ru": "Календарь наполнен прекрасными <w>пейзажами</w> из национальных парков."
                            }
                        },
                        {
                            "text": "The photographer specialized in capturing mountain <w>scenics</w> during the winter.",
                            "target_lang_translations": {
                                "ru": "Фотограф специализировался на съемке горных <w>видов</w> зимой."
                            }
                        }
                    ],
                    "synonyms": [
                        "landscape"
                    ],
                    "target_lang_definitions": {
                        "ru": "Картина, фотография или иное изображение красивой природы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пейзаж",
                                "target_lang_sense_clarification": "изображение природы"
                            },
                            {
                                "target_lang_word": "панорамный снимок",
                                "target_lang_sense_clarification": "фотография вида"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ddf1b1b8-c07a-3a58-88fe-145920913e69",
                    "sense_definition": "A person employed to design or paint backgrounds and sets for theater or film.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lead <w>scenic</w> spent weeks painting the backdrop for the opera.",
                            "target_lang_translations": {
                                "ru": "Ведущий <w>художник-декоратор</w> неделями расписывал задник для оперы."
                            }
                        },
                        {
                            "text": "She started her career as a <w>scenic</w> before becoming an art director.",
                            "target_lang_translations": {
                                "ru": "Она начала свою карьеру как <w>декоратор</w>, прежде чем стать арт-директором."
                            }
                        }
                    ],
                    "synonyms": [
                        "scenographer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, нанятый для проектирования или росписи фонов и декораций для театра или кино."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "художник-декоратор",
                                "target_lang_sense_clarification": "профессия в театре или кино"
                            },
                            {
                                "target_lang_word": "сценограф",
                                "target_lang_sense_clarification": "дизайнер сценического пространства"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}