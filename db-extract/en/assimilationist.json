            {
                "entry_id": "f00a86fc-58ef-394d-b9fb-2c13677ae4f2",
                "word": "assimilationist",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "29e84c9d-c228-4e2f-95fe-829f7a360686",
                        "entry_id": "f00a86fc-58ef-394d-b9fb-2c13677ae4f2",
                        "tags": [
                            "plural"
                        ],
                        "form": "assimilationists"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e835e2b0-d600-37db-ae5e-bea192667dad",
                        "entry_id": "f00a86fc-58ef-394d-b9fb-2c13677ae4f2",
                        "glosses": [
                            "An advocate of the policy or practice of the assimilation of immigrant or other minority cultures into a mainstream culture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b0c6c1e-2ae4-4d0a-bb3e-988ac8bc0761",
                                "sense_id": "e835e2b0-d600-37db-ae5e-bea192667dad",
                                "text": "Spanish-language education is not favored by assimilationist parents of Latino children in the US."
                            },
                            {
                                "example_id": "01be875b-e755-4729-a060-0a7c23033d0c",
                                "sense_id": "e835e2b0-d600-37db-ae5e-bea192667dad",
                                "text": "To the assimilationists, American Jews have not merely acculturated — they have assimilated."
                            },
                            {
                                "example_id": "c8db7282-3b43-4994-aa63-2735fe095850",
                                "sense_id": "e835e2b0-d600-37db-ae5e-bea192667dad",
                                "text": "The conflict between melting-pot assimilationists and cultural pluralists betrays a fundamental uncertainty about the meaning of American nationhood, and about the role ethnicity plays in it."
                            },
                            {
                                "example_id": "50e532c2-e133-4eac-bd0b-781ae6667993",
                                "sense_id": "e835e2b0-d600-37db-ae5e-bea192667dad",
                                "text": "The one area where there was at least some agreement between assimilationists and Zionists was Palestine."
                            }
                        ]
                    }
                ],
