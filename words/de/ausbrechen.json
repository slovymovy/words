    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "40258c4d-c772-3024-b58e-0d870c754714",
                    "sense_definition": "sich gewaltsam oder heimlich aus einer Gefangenschaft, einem Gefängnis oder einschränkenden Verhältnissen befreien",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gestern Nacht versuchten zwei Häftlinge, aus dem Gefängnis <w>auszubrechen</w>."
                        },
                        {
                            "text": "Der gefährliche Kriminelle <w>brach</w> trotz der hohen Mauern und scharfen Bewachung <w>aus</w>."
                        }
                    ],
                    "synonyms": [
                        "fliehen",
                        "befreien"
                    ],
                    "antonyms": [
                        "bleiben"
                    ],
                    "common_phrases": [
                        "aus dem Gefängnis ausbrechen"
                    ]
                },
                {
                    "sense_id": "b56b9920-f079-3ad6-b723-b3e5c4676fcc",
                    "sense_definition": "plötzlich und mit großer Wucht beginnen (von Bränden, Kriegen, Seuchen oder Vulkanen)",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In der historischen Altstadt <w>brach</w> mitten in der Nacht ein gefährliches Feuer <w>aus</w>."
                        },
                        {
                            "text": "Niemand konnte vorhersehen, wann der seit Jahrhunderten ruhende Vulkan wieder <w>ausbrechen</w> würde."
                        }
                    ],
                    "synonyms": [
                        "anfangen"
                    ],
                    "common_phrases": [
                        "ein Feuer bricht aus",
                        "ein Krieg bricht aus"
                    ]
                },
                {
                    "sense_id": "667ca922-ee53-39be-bb93-9984ca3c91d8",
                    "sense_definition": "plötzlich und intensiv anfangen, ein bestimmtes Gefühl oder eine laute Reaktion zu zeigen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als das kleine Mädchen seine Mutter sah, <w>brach</w> es vor Freude in Tränen <w>aus</w>."
                        },
                        {
                            "text": "Das gesamte Publikum <w>brach</w> nach der unerwarteten Pointe des Komikers in schallendes Gelächter <w>aus</w>."
                        }
                    ],
                    "common_phrases": [
                        "in Tränen ausbrechen",
                        "in Gelächter ausbrechen",
                        "in Panik ausbrechen"
                    ]
                },
                {
                    "sense_id": "98b9ad4b-1db7-38fb-9470-3f22cf768305",
                    "sense_definition": "die vorgesehene Fahrspur oder Richtung plötzlich und unkontrolliert seitlich verlassen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Auf der vereisten Fahrbahn <w>brach</w> das Heck des Wagens plötzlich nach links <w>aus</w>."
                        },
                        {
                            "text": "Der Fahrer reagierte sofort, als das schwere Fahrzeug in der engen Kurve <w>ausbrach</w>."
                        }
                    ],
                    "common_phrases": [
                        "mit dem Heck ausbrechen",
                        "in der Kurve ausbrechen"
                    ]
                },
                {
                    "sense_id": "15512443-defa-3186-8719-e117afaa05f1",
                    "sense_definition": "einen Teil durch Krafteinwirkung aus einem festen Gegenstand herauslösen oder abbrechen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Beim unglücklichen Sturz vom Fahrrad <w>brach</w> ihr ein kleiner Teil des Schneidezahns <w>aus</w>."
                        },
                        {
                            "text": "Die Arbeiter mussten vorsichtig mehrere Steine aus der beschädigten Mauer <w>ausbrechen</w>."
                        }
                    ],
                    "synonyms": [
                        "abbrechen",
                        "entfernen"
                    ],
                    "common_phrases": [
                        "einen Zahn ausbrechen"
                    ]
                },
                {
                    "sense_id": "1bfd6b2d-ba59-38e6-9ad0-20d669821588",
                    "sense_definition": "den Mageninhalt durch den Mund wieder herausbefördern; sich übergeben",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Patient fühlte sich so elend, dass er das gesamte Mittagessen wieder <w>ausbrach</w>."
                        },
                        {
                            "text": "Wegen der heftigen Magenverstimmung musste der Junge die eingenommene Medizin sofort wieder <w>ausbrechen</w>."
                        }
                    ],
                    "synonyms": [
                        "erbrechen",
                        "herauswürgen",
                        "rauswürgen",
                        "auskotzen"
                    ],
                    "common_phrases": [
                        "das Essen wieder ausbrechen"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ffb958f0-8402-3776-8df7-0d356642a16b",
                    "sense_definition": "das Entfliehen oder plötzliche Beginnen; substantivierter Infinitiv des Verbs <w>ausbrechen</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das plötzliche <w>Ausbrechen</w> des Vulkans zwang die Bewohner des Dorfes zur schnellen Flucht."
                        },
                        {
                            "text": "Die Sicherheitskräfte konnten das gewaltsame <w>Ausbrechen</w> mehrerer Gefangener durch schnelles Eingreifen verhindern."
                        }
                    ],
                    "common_phrases": [
                        "das Ausbrechen des Vulkans",
                        "ein Ausbrechen verhindern"
                    ]
                }
            ]
        }
    ]
}