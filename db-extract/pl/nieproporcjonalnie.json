                    {
                        "translation_id": "a12c5f2f-c460-45ba-b6d0-333671a0764c",
                        "source_entry_id": "d2bef692-4894-3feb-a4a8-c512a9059041",
                        "source_sense_id": "de347f04-c7ea-3626-af15-ba0daa2b852b",
                        "target_lang_word": "unverhältnismäßig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unverhältnismäßig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "379ddcad-60cc-3939-bd84-c8e97a7a646e",
                                        "entry_id": "a21f6450-faf7-3c86-9fa3-0a3f57336dd4",
                                        "glosses": [
                                            "über das übliche Maß hinaus; zu sehr, in zu hohem Grade"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73306fda-4756-4d97-8fb9-ec1b6a7313c5",
                                                "sense_id": "379ddcad-60cc-3939-bd84-c8e97a7a646e",
                                                "text": "„Er hat unverhältnismäßig große Kieferknochen, einen eher kleinen Schädel und ein zottiges Fell, das an das von Hyänen erinnert.“"
                                            },
                                            {
                                                "example_id": "ae053dec-daca-4a09-b7f8-494b851e39e0",
                                                "sense_id": "379ddcad-60cc-3939-bd84-c8e97a7a646e",
                                                "text": "„Es ist demnach unzulässig, ein Ausschließungsrecht zur Abwendung einer Schädigung geltend zu machen, wenn einem anderen ein unverhältnismäßig großer Schaden entstehen würde.“"
                                            },
                                            {
                                                "example_id": "d6a97cc8-a872-42fa-becb-64496954f9c7",
                                                "sense_id": "379ddcad-60cc-3939-bd84-c8e97a7a646e",
                                                "text": "„Um ihren Marktanteil zu erhöhen, wäre ein unverhältnismäßig hoher Mitteleinsatz nötig.“"
                                            },
                                            {
                                                "example_id": "f353e01a-f28b-406b-ab3b-cb9487ff529f",
                                                "sense_id": "379ddcad-60cc-3939-bd84-c8e97a7a646e",
                                                "text": "„Damit gewannen der Circus und das Amphitheater im politischen Leben Roms eine unverhältnismäßig große Bedeutung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a54836e2-382b-3d0b-8ca6-8907ea6709ab",
                                        "entry_id": "a21f6450-faf7-3c86-9fa3-0a3f57336dd4",
                                        "glosses": [
                                            "in einem schlechten, unausgewogenen Verhältnis zueinander stehend"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "591f626a-68d8-4016-a7fa-8c37c881b347",
                                                "sense_id": "a54836e2-382b-3d0b-8ca6-8907ea6709ab",
                                                "text": "„Heutzutage wird ein unverhältnismäßiges Gewicht auf Nahrungsmittel gelegt, die schwangere Frauen nicht essen sollten, weshalb Frauen oft Angst haben, ihr Kind zu schädigen, wenn sie auch nur eine falsche Entscheidung treffen.“"
                                            },
                                            {
                                                "example_id": "f63b64f6-d2f3-43b0-8234-a1603842723c",
                                                "sense_id": "a54836e2-382b-3d0b-8ca6-8907ea6709ab",
                                                "text": "„Die Gestaltung des Wahlrechts darf nicht zu willkürlichen und unverhältnismäßigen Beschränkungen führen oder die Wahlgrundsätze in ihrem Kern verletzen.“"
                                            },
                                            {
                                                "example_id": "0d0bc2e9-a732-4f9a-b358-2f3a9d79dcde",
                                                "sense_id": "a54836e2-382b-3d0b-8ca6-8907ea6709ab",
                                                "text": "„Inzwischen haben auch die Käufer, die Land zu produktiven Zwecken erworben haben, immer unverhältnismäßigere Kaufpreise gezahlt.“"
                                            },
                                            {
                                                "example_id": "d4276979-a34a-42af-8e6f-6e2ccf0174f1",
                                                "sense_id": "a54836e2-382b-3d0b-8ca6-8907ea6709ab",
                                                "text": "„Die zahlreichsten und ärmsten Volksklassen, die Tagelöhner, kleinen Handwerker und Fabrikanten werden am unverhältnismäßigsten, und zwar gerade in dem Maße recht hart herangezogen, wie sie dem Vaterlande viele Kinder erziehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
