                "senses": [
                    {
                        "sense_id": "b39a2a67-5a2d-334a-a99a-3ff4f89a14a0",
                        "entry_id": "c1ca2f7e-aca1-370d-a102-d313851da18a",
                        "glosses": [
                            "Sitz/ Sitzbank des Kutschers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d66a2d26-d9cf-403b-a6ca-54832c16c9d1",
                                "sense_id": "b39a2a67-5a2d-334a-a99a-3ff4f89a14a0",
                                "text": "„Ich setzte mich neben ihn auf den Kutschbock, während Ben mit unserem Gepäck hinten aufstieg.“"
                            },
                            {
                                "example_id": "b655ab2c-01a2-4aef-a743-71d3e434f03a",
                                "sense_id": "b39a2a67-5a2d-334a-a99a-3ff4f89a14a0",
                                "text": "„Auf dem Kutschbock sitzt rechts Onkel Ernst, der Kutscher, und der Vater links von ihm.“"
                            },
                            {
                                "example_id": "452a069c-9ea0-41c9-a695-b7e6cba69912",
                                "sense_id": "b39a2a67-5a2d-334a-a99a-3ff4f89a14a0",
                                "text": "„Auf dem Kutschbock saß ein merkwürdig aussehender kleiner Mann.“"
                            },
                            {
                                "example_id": "5c34ef8a-b454-4347-9b16-7d79ec655c00",
                                "sense_id": "b39a2a67-5a2d-334a-a99a-3ff4f89a14a0",
                                "text": "„Der Lakai auf dem Kutschbock versucht mit verklammten Fingern das Halstuch um die frostroten Ohren zu knüpfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
