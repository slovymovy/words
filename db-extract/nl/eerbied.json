                        "source_sense_id": "31744d93-ed8e-3cd4-923b-ea54695c3812",
                        "target_lang_word": "Ehrfurcht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ehrfurcht",
