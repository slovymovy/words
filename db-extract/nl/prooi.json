                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prey",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "201bd0f8-5371-32b4-9068-30faf1c37649",
                                        "entry_id": "7f57c1ba-9b6b-3dbf-856a-8a81c6f5a222",
                                        "glosses": [
                                            "That which is or may be seized by animals to be devoured."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56b21ada-1c8d-45ed-8934-314243b9f5e1",
                                                "sense_id": "201bd0f8-5371-32b4-9068-30faf1c37649",
                                                "text": "Already sees herself the monster's prey."
                                            },
                                            {
                                                "example_id": "53253f3e-fbc1-410a-bf37-9f56049746aa",
                                                "sense_id": "201bd0f8-5371-32b4-9068-30faf1c37649",
                                                "text": "The deer became prey to the lion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bd345ee-6428-3fa6-81fb-11096adc9479",
                                        "entry_id": "7f57c1ba-9b6b-3dbf-856a-8a81c6f5a222",
                                        "glosses": [
                                            "A person or thing given up as a victim."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0769b197-665a-4e48-baf8-6a2476d4fee4",
                                                "sense_id": "8bd345ee-6428-3fa6-81fb-11096adc9479",
                                                "text": "[The helmsman] steered with no end of a swagger while you were by; but if he lost sight of you, he became instantly the prey of an abject funk […]"
                                            },
                                            {
                                                "example_id": "fc2cf3b4-3169-4ef7-87c5-1a838d90ea12",
                                                "sense_id": "8bd345ee-6428-3fa6-81fb-11096adc9479",
                                                "text": "Being so inflexible, the railway was easy prey to road competition, and the arrival of unregulated lorry transport from farm fields to town centres quickly captured all locally generated business."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8bbd1a5-8306-3d61-aa40-74f6459c548d",
                                        "entry_id": "7f57c1ba-9b6b-3dbf-856a-8a81c6f5a222",
                                        "glosses": [
                                            "A living thing, usually an animal, that is eaten by another living thing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e321bdc2-661e-435a-8dca-8f7bc48fb162",
                                                "sense_id": "d8bbd1a5-8306-3d61-aa40-74f6459c548d",
                                                "text": "The rabbit was eaten by the coyote, so the rabbit is the coyote's prey."
                                            },
                                            {
                                                "example_id": "3407fcd3-46e4-4bac-ac49-a2030522fa1e",
                                                "sense_id": "d8bbd1a5-8306-3d61-aa40-74f6459c548d",
                                                "text": "Stranded without any weapons, we made very easy prey."
                                            },
                                            {
                                                "example_id": "6b929cfe-01de-43f2-af96-081d120c4f48",
                                                "sense_id": "d8bbd1a5-8306-3d61-aa40-74f6459c548d",
                                                "text": "The old lion perisheth for lack of prey."
                                            },
                                            {
                                                "example_id": "8b572334-9051-4c12-b2c2-cba77458770a",
                                                "sense_id": "d8bbd1a5-8306-3d61-aa40-74f6459c548d",
                                                "text": "Nonetheless, some insect prey take advantage of clutter by hiding in it. Earless ghost swift moths become “invisible” to echolocating bats by forming mating clusters close (less than half a meter) above vegetation and effectively blending into the clutter of echoes that the bat receives from the leaves and stems around them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2ff6798-20d2-3af7-9642-d5c65ad6b19e",
                                        "entry_id": "7f57c1ba-9b6b-3dbf-856a-8a81c6f5a222",
                                        "glosses": [
                                            "Anything, such as goods, etc., taken or got by violence; something taken by force from an enemy in war."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9182ebd7-f2ba-42fc-960b-bc182f9e38cf",
                                                "sense_id": "e2ff6798-20d2-3af7-9642-d5c65ad6b19e",
                                                "text": "And they brought the captiues, and the pray, and the spoile vnto Moses and Eleazar the Priest, and vnto the Congregation of the children of Israel, vnto the campe at the plaines of Moab, which are by Iordan neere Iericho."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a1ca917-b13f-3136-829a-44cb5109ba78",
                                        "entry_id": "7f57c1ba-9b6b-3dbf-856a-8a81c6f5a222",
                                        "glosses": [
                                            "The act of devouring other creatures; ravage."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75ae1a38-ea31-4ffe-aba9-e3f6199d480d",
                                                "sense_id": "4a1ca917-b13f-3136-829a-44cb5109ba78",
                                                "text": "Hog in sloth, fox in stealth, […] lion in prey."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb455c67-cbf3-3abd-b347-1525ffaab8bf",
                                        "entry_id": "7f57c1ba-9b6b-3dbf-856a-8a81c6f5a222",
                                        "glosses": [
                                            "The victim of a disease."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c31fa69c-9cf7-4214-8cdb-00ea0ded3d89",
                                                "sense_id": "cb455c67-cbf3-3abd-b347-1525ffaab8bf",
                                                "text": "He became the prey of dengue."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "prey",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99f2d7a0-d1a0-3d16-8334-42f8b8b5ff1b",
