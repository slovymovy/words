                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0df53f3-9add-4b75-a51a-6d80abac4b1c",
                                "sense_id": "92614890-8170-317d-a03b-ae0aa9eeb089",
                                "text": "Divers échantillons de pierres gypseuses, durcies et marborisées par un procédé particulier, de l’invention de M. Tissot jeune, mécanicien et horloger, place de l’Hôtel-de-Ville, n°. 3."
                            },
                            {
                                "example_id": "4fd5b08e-797a-42b7-a3a3-0cf46e035cbc",
                                "sense_id": "92614890-8170-317d-a03b-ae0aa9eeb089",
                                "text": "Procédé pour durcir et marboriser les plâtres et les albâtres, et pour rendre ces matières propres à l’usage de l’art statuaire et de la lithographie."
                            }
                        ]
                    }
