                        "source_sense_description": "sterk in mate",
                        "target_lang_word": "hefty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hefty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf1e59d8-0238-30f6-9995-1ca734bd5429",
                                        "entry_id": "1657c59e-3413-313e-8ef8-648daf2f1361",
                                        "glosses": [
                                            "With heft; heavy, strong, vigorous, mighty, impressive"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8479564-8f60-4a40-b3cd-d3a1f81b12b0",
                                                "sense_id": "cf1e59d8-0238-30f6-9995-1ca734bd5429",
                                                "text": "He can throw a hefty punch."
                                            },
                                            {
                                                "example_id": "306d36c7-0612-48b1-b17a-2f7e7832891a",
                                                "sense_id": "cf1e59d8-0238-30f6-9995-1ca734bd5429",
                                                "text": "The Remove dormitory echoed to the old, familiar sound of Bunter's hefty snore."
                                            },
                                            {
                                                "example_id": "68f3e02b-74a7-4a96-bf3c-ca4bff8732a2",
                                                "sense_id": "cf1e59d8-0238-30f6-9995-1ca734bd5429",
                                                "text": "Fill up on some of the heftiest burritos in captivity, fashioned around grilled beef, chicken, greasy and indulgent barbecued pork al pastor, carnitas and the more exotic [things]."
                                            },
                                            {
                                                "example_id": "521c1007-06b6-49ab-85d4-03ed4417f778",
                                                "sense_id": "cf1e59d8-0238-30f6-9995-1ca734bd5429",
                                                "text": "[…] on Sunday four more violinists, a second violist and a harpsichordist were added to give the ripieno sections of the fast movements a heftier punch than the smaller group delivered."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b69662b3-048d-30c8-bb6c-4a655edfe5c8",
                                        "entry_id": "1657c59e-3413-313e-8ef8-648daf2f1361",
                                        "glosses": [
                                            "Strong; bulky."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3615d480-19ad-4d8d-b491-457abf4c3675",
                                                "sense_id": "b69662b3-048d-30c8-bb6c-4a655edfe5c8",
                                                "text": "They use some hefty bolts to hold up road signs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0939d336-76b5-3e2d-822c-24e2ec9698c7",
                                        "entry_id": "1657c59e-3413-313e-8ef8-648daf2f1361",
                                        "glosses": [
                                            "Possessing physical strength and weight; rugged and powerful; powerfully or heavily built."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70273dd0-9879-4405-bbe3-3611e8a3180f",
                                                "sense_id": "0939d336-76b5-3e2d-822c-24e2ec9698c7",
                                                "text": "He was a tall, hefty man."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a93097d7-c68f-3d15-9d70-96022d883344",
                                        "entry_id": "1657c59e-3413-313e-8ef8-648daf2f1361",
                                        "glosses": [
                                            "Heavy, weighing a lot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "511ca5ec-07e5-40c6-a200-f7d5fdd6e11e",
                                                "sense_id": "a93097d7-c68f-3d15-9d70-96022d883344",
                                                "text": "She carries a hefty backpack full of books."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10fbebd7-8fd8-39c5-a655-a9e703d8b56b",
                                        "entry_id": "1657c59e-3413-313e-8ef8-648daf2f1361",
                                        "glosses": [
                                            "Large, healthy."
                                        ],
                                        "tags": [
                                            "of a number or amount"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34c2d3a7-1c9a-4095-aaa8-2fc562c40417",
                                                "sense_id": "10fbebd7-8fd8-39c5-a655-a9e703d8b56b",
                                                "text": "That's going to cost you a hefty sum."
                                            },
                                            {
                                                "example_id": "3f02ad74-cd09-4358-b470-7194b4cebcfd",
                                                "sense_id": "10fbebd7-8fd8-39c5-a655-a9e703d8b56b",
