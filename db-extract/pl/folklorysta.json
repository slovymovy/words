                        "examples": [
                            {
                                "example_id": "03ce46fd-dc64-4c6d-9037-d516cbd0aa81",
                                "sense_id": "2fd78103-6bd1-3a34-b884-5595240c43d5",
                                "text": "Jej dziadek był znanym śląskim folklorystą."
                            }
                        ],
