{
    "word_family": [
        "sensational",
        "sensationalism",
        "sense",
        "sensitive",
        "sensory",
        "sensual"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "494db0d5-6fad-3bc3-b6f3-80c7d80142d3",
                    "sense_definition": "A physical feeling or perception resulting from something happening to or coming into contact with the body.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I felt a strange <w>sensation</w> in my arm after the injection.",
                            "target_lang_translations": {
                                "ru": "Я почувствовал странное <w>ощущение</w> в руке после укола.",
                                "de": "Ich spürte nach der Spritze ein seltsames <w>Gefühl</w> in meinem Arm.",
                                "fr": "J'ai ressenti une <w>sensation</w> étrange dans mon bras après l'injection."
                            }
                        },
                        {
                            "text": "The warm water created a pleasant <w>sensation</w> on her skin.",
                            "target_lang_translations": {
                                "ru": "Теплая вода создала приятное <w>ощущение</w> на ее коже.",
                                "de": "Das warme Wasser erzeugte ein angenehmes <w>Gefühl</w> auf ihrer Haut.",
                                "fr": "L'eau chaude créait une <w>sensation</w> agréable sur sa peau."
                            }
                        }
                    ],
                    "synonyms": [
                        "feeling",
                        "perception"
                    ],
                    "antonyms": [
                        "lack of sensation"
                    ],
                    "common_phrases": [
                        "burning sensation",
                        "tingling sensation",
                        "strange sensation",
                        "loss of sensation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическое чувство или восприятие, возникающее в результате воздействия чего-либо на тело или контакта с ним.",
                        "de": "Ein körperliches Gefühl oder eine Wahrnehmung, die durch eine Einwirkung auf den Körper oder Kontakt mit ihm entsteht.",
                        "fr": "Une impression ou perception physique résultant d'un contact avec le corps ou d'une action sur celui-ci."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ощущение",
                                "target_lang_sense_clarification": "физическое чувство"
                            },
                            {
                                "target_lang_word": "чувство",
                                "target_lang_sense_clarification": "восприятие"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Empfindung",
                                "target_lang_sense_clarification": "sinnliche Wahrnehmung oder körperliches Gefühl"
                            },
                            {
                                "target_lang_word": "Gefühl",
                                "target_lang_sense_clarification": "allgemeine körperliche Wahrnehmung"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "sensation",
                                "target_lang_sense_clarification": "perception physique ou impression corporelle"
                            },
                            {
                                "target_lang_word": "impression",
                                "target_lang_sense_clarification": "ressenti physique vague"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "374c88cf-2b98-3cd4-9f94-facd534a4255",
                    "sense_definition": "A widespread reaction of interest or excitement among a large group of people.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new movie caused a <w>sensation</w> at the film festival.",
                            "target_lang_translations": {
                                "ru": "Новый фильм произвел <w>сенсацию</w> на кинофестивале.",
                                "de": "Der neue Film sorgte auf dem Filmfestival für eine <w>Sensation</w>.",
                                "fr": "Le nouveau film a fait <w>sensation</w> au festival du film."
                            }
                        },
                        {
                            "text": "Her sudden resignation created a <w>sensation</w> in the political world.",
                            "target_lang_translations": {
                                "ru": "Ее внезапная отставка произвела <w>сенсацию</w> в политическом мире.",
                                "de": "Ihr plötzlicher Rücktritt erregte in der politischen Welt großes <w>Aufsehen</w>.",
                                "fr": "Sa démission soudaine a fait <w>sensation</w> dans le monde politique."
                            }
                        }
                    ],
                    "synonyms": [
                        "event"
                    ],
                    "common_phrases": [
                        "cause a sensation",
                        "create a sensation",
                        "media sensation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бурная реакция интереса или возбуждения среди большой группы людей.",
                        "de": "Eine weit verbreitete Reaktion von Interesse oder Aufregung in einer großen Gruppe von Menschen.",
                        "fr": "Une réaction généralisée d'intérêt ou d'excitation au sein d'un grand groupe de personnes."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сенсация",
                                "target_lang_sense_clarification": "событие, вызывающее ажиотаж"
                            },
                            {
                                "target_lang_word": "фурор",
                                "target_lang_sense_clarification": "шумный успех"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Sensation",
                                "target_lang_sense_clarification": "aufsehenerregendes Ereignis"
                            },
                            {
                                "target_lang_word": "Aufsehen",
                                "target_lang_sense_clarification": "besondere öffentliche Aufmerksamkeit"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "sensation",
                                "target_lang_sense_clarification": "événement qui fait grand bruit"
                            },
                            {
                                "target_lang_word": "fureur",
                                "target_lang_sense_clarification": "succès retentissant"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "573d0ae7-8330-3eed-a184-0c532f782340",
                    "sense_definition": "A person or thing that causes great excitement or interest.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a singer, he is a global <w>sensation</w>.",
                            "target_lang_translations": {
                                "ru": "Как певец, он — мировая <w>сенсация</w>.",
                                "de": "Als Sänger ist er eine weltweite <w>Sensation</w>.",
                                "fr": "En tant que chanteur, il est un <w>phénomène</w> mondial."
                            }
                        },
                        {
                            "text": "The young athlete became an overnight <w>sensation</w>.",
                            "target_lang_translations": {
                                "ru": "Молодой спортсмен в одночасье стал <w>сенсацией</w>.",
                                "de": "Der junge Sportler wurde über Nacht zur <w>Sensation</w>.",
                                "fr": "Le jeune athlète est devenu une <w>sensation</w> du jour au lendemain."
                            }
                        }
                    ],
                    "common_phrases": [
                        "overnight sensation",
                        "pop sensation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или предмет, вызывающий всеобщее волнение или интерес.",
                        "de": "Eine Person oder Sache, die große Aufregung oder Interesse hervorruft.",
                        "fr": "Une personne ou une chose qui suscite une grande excitation ou un vif intérêt."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сенсация",
                                "target_lang_sense_clarification": "о человеке или объекте"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Sensation",
                                "target_lang_sense_clarification": "Person oder Objekt, das für Furore sorgt"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "phénomène",
                                "target_lang_sense_clarification": "personne qui suscite l'admiration"
                            },
                            {
                                "target_lang_word": "sensation",
                                "target_lang_sense_clarification": "quelqu'un ou quelque chose qui fait sensation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c23ab46-db04-3b7b-9bfd-deece3bc3904",
                    "sense_definition": "The physiological process of stimulating sensory organs.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The drug blocks the <w>sensation</w> of pain in the nerves.",
                            "target_lang_translations": {
                                "ru": "Препарат блокирует болевые <w>ощущения</w> в нервах.",
                                "de": "Das Medikament blockiert die <w>Empfindung</w> von Schmerz in den Nerven.",
                                "fr": "Le médicament bloque la <w>sensation</w> de douleur dans les nerfs."
                            }
                        },
                        {
                            "text": "The study of <w>sensation</w> explains how we detect light and sound.",
                            "target_lang_translations": {
                                "ru": "Изучение <w>ощущений</w> объясняет, как мы различаем свет и звук.",
                                "de": "Die Erforschung der <w>Wahrnehmung</w> erklärt, wie wir Licht und Schall erkennen.",
                                "fr": "L'étude de la <w>sensation</w> explique comment nous détectons la lumière et le son."
                            }
                        }
                    ],
                    "synonyms": [
                        "perception"
                    ],
                    "common_phrases": [
                        "sensation and perception"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физиологический процесс стимуляции органов чувств.",
                        "de": "Der physiologische Prozess der Reizung von Sinnesorganen.",
                        "fr": "Le processus physiologique de stimulation des organes sensoriels."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ощущение",
                                "target_lang_sense_clarification": "физиологический процесс"
                            },
                            {
                                "target_lang_word": "восприятие",
                                "target_lang_sense_clarification": "перцепция"
                            }
                        ],
                        "de": [
