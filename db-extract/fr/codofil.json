                        "glosses": [
                            "Agence de l’État de Louisiane pour la promotion de l’usage du français au sein de la population louisianaise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62725bb9-f1aa-42cb-94bd-501b5d6200c1",
                                "sense_id": "fdea33ed-aec0-3bf0-925e-c5c1afd68f26",
                                "text": "Depuis sa création à la fin des années 60, le CODOFIL cherche à mobiliser les francophones de la Louisiane en faveur d’une renaissance de la langue française dans l’État."
                            },
                            {
                                "example_id": "881def88-a149-4104-8039-6a5ae6797df3",
                                "sense_id": "fdea33ed-aec0-3bf0-925e-c5c1afd68f26",
                                "text": "Même si la langue française n'a plus de présence dans la Constitution de la Louisiane, on peut constater que, à travers le CODOFIL et les programmes qui lui sont associés, le français maintient une place privilégiée dans le droit louisianais."
                            }
                        ]
                    }
