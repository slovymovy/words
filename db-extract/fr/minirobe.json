                ],
                "senses": [
                    {
                        "sense_id": "006f8dae-4cfb-39b5-a4b4-d1f80a8c1240",
                        "entry_id": "fd4621d0-7ce3-36f0-8d11-22d16806ea7c",
                        "glosses": [
                            "Robe très courte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc70009e-8c70-4a81-b137-ce1b55c91eda",
                                "sense_id": "006f8dae-4cfb-39b5-a4b4-d1f80a8c1240",
                                "text": "Qualifiée par la presse de « révolutionnaire », la minirobe présentée par André Courrèges lors desa collection été de 1965 fut le symbole ultime de la libération de la femme."
                            },
                            {
                                "example_id": "eae2af23-a32a-432b-afdc-f4f0d2a56857",
                                "sense_id": "006f8dae-4cfb-39b5-a4b4-d1f80a8c1240",
                                "text": "Dans sa minirobe mi-broderie mi-paillettes, elle se sentait mal. Elle était en avance. Esseulée, perchée contre sa table, elle polarisait les regards. Pire, elle en était consciente."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3352b356-cf48-4739-a7b3-7938cf2ab4f5",
                        "source_entry_id": "fd4621d0-7ce3-36f0-8d11-22d16806ea7c",
                        "source_sense_id": "006f8dae-4cfb-39b5-a4b4-d1f80a8c1240",
                        "target_lang_word": "Minikleid",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Minikleid",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e91104e8-636a-3243-8ec8-dff370b72031",
                                        "entry_id": "24b3ba13-4d56-3b44-95d9-e9004c723bbc",
                                        "glosses": [
                                            "sehr kurz geschnittenes Kleid mit viel Beinfreiheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff8e38bd-c933-46be-9537-182338aa5dce",
                                                "sense_id": "e91104e8-636a-3243-8ec8-dff370b72031",
                                                "text": "„Joyce sah blendend aus in ihrem schwarzen Minikleid, in dem ihre langen Beine ausgezeichnet zur Geltung kamen.“"
                                            },
                                            {
                                                "example_id": "c4804618-138d-44df-abd1-6485a56e3cba",
                                                "sense_id": "e91104e8-636a-3243-8ec8-dff370b72031",
                                                "text": "„Nicole ist groß, schlank, blond und trägt ein schlichtes schwarzes Minikleid, schwarze Strumpfhosen mit Naht und hochhackige spitze Schuhe, die eigentlich unter das Waffengesetz fallen müssten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
