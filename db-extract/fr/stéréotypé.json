                                                "sense_id": "44812b70-621e-356d-bc2a-2ff05f6e4b5f",
                                                "text": "That TV series has become awfully formulaic in the last couple of seasons."
                                            },
                                            {
                                                "example_id": "e4bb8489-1642-4316-969d-384151756c2f",
                                                "sense_id": "44812b70-621e-356d-bc2a-2ff05f6e4b5f",
