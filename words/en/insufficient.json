{
    "word_family": [
        "sufficiency",
        "sufficiently",
        "insufficiency",
        "insufficiently"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "08a0e980-821b-39e7-b466-5e38c2b6c1e8",
                    "sense_definition": "Not enough to meet a need or a requirement.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "inadequacy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company had <w>insufficient</w> funds to pay all its employees this month.",
                            "target_lang_translations": {
                                "ru": "У компании было <w>недостаточно</w> средств, чтобы выплатить зарплату всем сотрудникам в этом месяце."
                            }
                        },
                        {
                            "text": "The evidence provided was <w>insufficient</w> evidence to prove his innocence in court.",
                            "target_lang_translations": {
                                "ru": "Представленные доказательства были <w>недостаточными</w> для того, чтобы доказать его невиновность в суде."
                            }
                        }
                    ],
                    "synonyms": [
                        "unsufficient"
                    ],
                    "antonyms": [
                        "sufficient",
                        "adequate",
                        "enough"
                    ],
                    "common_phrases": [
                        "insufficient evidence",
                        "insufficient funds",
                        "insufficient data"
                    ],
                    "target_lang_definitions": {
                        "ru": "Недостаточный для удовлетворения потребности или требования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "недостаточный",
                                "target_lang_sense_clarification": "о количестве или ресурсах"
                            },
                            {
                                "target_lang_word": "нехватка",
                                "target_lang_sense_clarification": "в контексте отсутствия нужного объема"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c47c46a-1e19-3835-bab1-731afd2e9310",
                    "sense_definition": "Lacking the necessary ability, power, or qualifications for a task.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "incompetence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt <w>insufficient</w> to the task of leading such a large and complex organization.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал себя <w>несостоятельным</w> для задачи руководства такой большой и сложной организацией."
                            }
                        },
                        {
                            "text": "The young king felt <w>insufficient</w> to express the depth of his grief.",
                            "target_lang_translations": {
                                "ru": "Молодой король чувствовал, что его слов <w>недостаточно</w>, чтобы выразить всю глубину своего горя."
                            }
                        }
                    ],
                    "antonyms": [
                        "capable",
                        "competent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не обладающий необходимыми способностями, силой или квалификацией для выполнения задачи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "несостоятельный",
                                "target_lang_sense_clarification": "неспособный справиться с чем-либо"
                            },
                            {
                                "target_lang_word": "недостаточный",
                                "target_lang_sense_clarification": "о личных качествах или силах"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "determiner",
            "senses": [
                {
                    "sense_id": "d0f901ae-d430-3095-8d33-f246e6061d10",
                    "sense_definition": "An inadequate amount or quantity of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is <w>insufficient</w> time to complete the project before the deadline.",
                            "target_lang_translations": {
                                "ru": "Времени <w>недостаточно</w>, чтобы завершить проект до установленного срока."
                            }
                        },
                        {
                            "text": "The hikers realized they had <w>insufficient</w> water for the long journey ahead.",
                            "target_lang_translations": {
                                "ru": "Походники поняли, что у них <w>недостаточно</w> воды для предстоящего долгого пути."
                            }
                        }
                    ],
                    "antonyms": [
                        "enough",
                        "plenty"
                    ],
                    "common_phrases": [
                        "insufficient time",
                        "insufficient space"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неадекватное количество или объем чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "недостаточно",
                                "target_lang_sense_clarification": "мало для какой-то цели"
                            },
                            {
                                "target_lang_word": "нехватка",
                                "target_lang_sense_clarification": "дефицит чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33859ec6-e56d-3e16-aa2a-55095d981313",
                    "sense_definition": "A portion or amount of something that is less than what is required.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Insufficient</w> of the original structure remains to identify its historical purpose.",
                            "target_lang_translations": {
                                "ru": "От первоначального строения осталось <w>недостаточно</w>, чтобы определить его историческое назначение."
                            }
                        },
                        {
                            "text": "Because <w>insufficient</w> of the crop survived the frost, prices are expected to rise.",
                            "target_lang_translations": {
                                "ru": "Поскольку <w>недостаточная часть</w> урожая уцелела после заморозков, ожидается рост цен."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Часть или количество чего-либо, которое меньше требуемого."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "недостаточное количество",
                                "target_lang_sense_clarification": "остаток или доля чего-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}