                        "cross_references": []
                    },
                    {
                        "translation_id": "cb90f67a-d666-4f93-b403-6b3b1609dbf8",
                        "source_entry_id": "30fa4e0c-d417-385d-acd6-c3d203518f9a",
                        "source_sense_id": "4a3ab130-6ef7-3c2c-8fff-6135ef90ddc5",
                        "target_lang_word": "ellipsis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ellipsis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ab49e72-d0f9-3f5b-b454-d78dfb5ac4ce",
                                        "entry_id": "3096a8e5-7e32-36c2-bdb1-403af1378690",
                                        "glosses": [
                                            "A mark consisting of multiple full stops (with or without spaces), used to indicate omitted, missing, or illegible words; or (in mathematics) that a pattern continues."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cf88038-6e9d-492a-aeda-4158de5046c7",
                                                "sense_id": "0ab49e72-d0f9-3f5b-b454-d78dfb5ac4ce",
                                                "text": "The ellipsis in 1, 2, 3, ..., 8, 9 means that the numbers 4, 5, 6, and 7 are not explicitly included, but are considered to be part of the pattern."
                                            },
                                            {
                                                "example_id": "24622cfa-058e-46aa-8f76-333fcec80359",
                                                "sense_id": "0ab49e72-d0f9-3f5b-b454-d78dfb5ac4ce",
                                                "text": "The ellipsis in 0.333... means that the number is a repeating decimal, having threes that go on forever."
                                            },
                                            {
                                                "example_id": "cecd226d-42d0-411a-a1f9-6c6eee952733",
                                                "sense_id": "0ab49e72-d0f9-3f5b-b454-d78dfb5ac4ce",
                                                "text": "CARD: Hey Baby. Thanks for the … last night. Love you!\nHAZEL: Wow. I've never despised an ellipsis so much in my life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d55e460-36e9-3e95-b838-e68742767733",
                                        "entry_id": "3096a8e5-7e32-36c2-bdb1-403af1378690",
                                        "glosses": [
                                            "The omission of a word or phrase that can be inferred from the context."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c96a2021-1699-3c6e-bf92-1dc8f9ce4960",
                                        "entry_id": "3096a8e5-7e32-36c2-bdb1-403af1378690",
                                        "glosses": [
                                            "The omission of scenes in a film that do not advance the plot."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "751686c1-4bac-411c-92d7-ea793c111853",
                                                "sense_id": "c96a2021-1699-3c6e-bf92-1dc8f9ce4960",
                                                "text": "It was now possible for writers and directors to cut scenes that did not further the plot; called \"ellipses\" by filmmakers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2ab923c-841e-3ec5-83f9-fa8f981c656f",
                                        "entry_id": "3096a8e5-7e32-36c2-bdb1-403af1378690",
                                        "glosses": [
                                            "An ellipse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce803367-fced-4cba-99f1-b18e088d4e3d",
                        "source_entry_id": "30fa4e0c-d417-385d-acd6-c3d203518f9a",
                        "source_sense_id": "4a3ab130-6ef7-3c2c-8fff-6135ef90ddc5",
                        "target_lang_word": "Ellipse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ellipse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8d09de44-351c-359c-b6b6-85a581973cb7",
                                        "entry_id": "edc80835-6fc3-32e7-8fc8-ccef1b5d199b",
                                        "glosses": [
                                            "geschlossene ovale Kurve"
                                        ],
                                        "tags": [
                                            "geometry"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1c19972-9f16-487c-859d-966927ec3ec0",
                                                "sense_id": "8d09de44-351c-359c-b6b6-85a581973cb7",
                                                "text": "Eine Ellipse ist die Menge aller Punkte einer Ebene, für die die Summe der Abstände zu zwei gegebenen Punkten, den Brennpunkten, gleich ist."
                                            },
                                            {
                                                "example_id": "99990711-09ee-4c85-89e6-f4187fe22772",
                                                "sense_id": "8d09de44-351c-359c-b6b6-85a581973cb7",
                                                "text": "„Wie Johannes Kepler (1571 bis 1630) im Jahre 1609 gezeigt hat, ist die Erdbahn nicht exakt kreisförmig, sondern angenähert eine Ellipse, in deren einem Brennpunkt die Sonne steht.“"
                                            },
                                            {
                                                "example_id": "611154c1-f412-42bd-87fd-b01f25771cea",
                                                "sense_id": "8d09de44-351c-359c-b6b6-85a581973cb7",
                                                "text": "„Die Erde beschreibt auf ihrem Weg um die Sonne keine perfekte Kreisbahn, sondern eine schwache Ellipse.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3554df7e-47f0-31b6-9fb0-a27019492701",
                                        "entry_id": "edc80835-6fc3-32e7-8fc8-ccef1b5d199b",
                                        "glosses": [
                                            "Fehlen von syntaktisch notwendigen Satzteilen"
                                        ],
                                        "tags": [
                                            "Sprachwissenschaft",
                                            "Rhetorik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca4f2020-0687-4e0f-8e0c-0d287cd29bbb",
                                                "sense_id": "3554df7e-47f0-31b6-9fb0-a27019492701",
                                                "text": "Viele Überschriften sind keine vollständigen Sätze und daher Ellipsen."
                                            },
                                            {
                                                "example_id": "f327e320-6dc8-4235-9a81-298875013fa4",
                                                "sense_id": "3554df7e-47f0-31b6-9fb0-a27019492701",
                                                "text": "„Werden Teile eines sprachlichen Ausdrucks weggelassen, so nennt man dies eine Ellipse (…).“"
                                            },
                                            {
                                                "example_id": "f6492fc8-b6f2-4e00-ac14-0b28967a9f86",
                                                "sense_id": "3554df7e-47f0-31b6-9fb0-a27019492701",
                                                "text": "„In der Tendenz zum einfachen Satz, ja sogar vermehrt zum unvollständigen Satz, zur sogenannten Ellipse, spiegelt sich nicht zuletzt die auch ins Schriftliche und Gedruckte ausgreifende Gepflogenheit der gesprochenen Sprache.“"
                                            },
                                            {
                                                "example_id": "95d72214-56aa-4ea4-82b3-94f7ca4c72ae",
                                                "sense_id": "3554df7e-47f0-31b6-9fb0-a27019492701",
                                                "text": "„Sprechsprache des Alltags hat überwiegend unvollständige Sätze, Ellipsen, Einwortsätze, Zweiwortsätze, Dreiwortsätze, Interjektionen undsoweiter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
