    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "97b2d5e3-269e-3889-ab3c-655c6cd2bfb1",
                    "sense_definition": "Geleidelijk groter worden of zich ontwikkelen tot iets anders.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het kleine bedrijfje kan snel <w>uitgroeien</w> tot een heel grote onderneming.",
                            "target_lang_translations": {
                                "fr": "La petite entreprise peut rapidement <w>se transformer en</w> une très grande société."
                            }
                        },
                        {
                            "text": "Onze kleine winkel is in een paar jaar tijd <w>uitgegroeid</w> tot een succesvolle supermarktketen.",
                            "target_lang_translations": {
                                "fr": "Notre petit magasin <w>est devenu</w> en quelques années une chaîne de supermarchés florissante."
                            }
                        }
                    ],
                    "common_phrases": [
                        "uitgroeien tot"
                    ],
                    "target_lang_definitions": {
                        "fr": "Devenir progressivement plus grand ou se développer pour devenir autre chose."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "se transformer en",
                                "target_lang_sense_clarification": "devenir avec le temps"
                            },
                            {
                                "target_lang_word": "devenir",
                                "target_lang_sense_clarification": "évoluer vers"
                            },
                            {
                                "target_lang_word": "se développer pour devenir",
                                "target_lang_sense_clarification": "grandir jusqu'à être"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c25ae373-7404-3f73-a6dd-b8c9033c334a",
                    "sense_definition": "Volgroeid raken en ophouden met fysiek groter worden.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De dokter zegt dat de jongen pas een operatie krijgt als hij helemaal is <w>uitgegroeid</w>.",
                            "target_lang_translations": {
                                "fr": "Le médecin dit que le garçon ne se fera opérer que lorsqu'il <w>aura complètement fini sa croissance</w>."
                            }
                        },
                        {
                            "text": "Wanneer je eenmaal bent <w>uitgegroeid</w>, verandert je lengte meestal niet meer.",
                            "target_lang_translations": {
                                "fr": "Une fois que tu <w>as fini de grandir</w>, ta taille ne change généralement plus."
                            }
                        }
                    ],
                    "common_phrases": [
                        "helemaal uitgegroeid zijn"
                    ],
                    "target_lang_definitions": {
                        "fr": "Atteindre sa taille adulte et cesser de grandir physiquement."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "avoir fini sa croissance",
                                "target_lang_sense_clarification": "pour une personne ou un être vivant"
                            },
                            {
                                "target_lang_word": "être pleinement développé",
                                "target_lang_sense_clarification": "avoir atteint la maturité physique"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}