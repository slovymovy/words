                ],
                "senses": [
                    {
                        "sense_id": "f67463ae-c5d1-334f-bd59-37a4c90c42be",
                        "entry_id": "5c5443e6-0ff7-30e7-8c78-d1b311ac128f",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a7558b4-5a68-4195-a533-b03e950f1aed",
                                "sense_id": "f67463ae-c5d1-334f-bd59-37a4c90c42be",
                                "text": "Frau Gläsle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ae01b0c6-c662-47c0-b3a6-087a4c9511e6",
                                "sense_id": "f67463ae-c5d1-334f-bd59-37a4c90c42be",
                                "text": "Herr Gläsle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "bced6f19-674e-4968-9d7a-0659e32008b4",
                                "sense_id": "f67463ae-c5d1-334f-bd59-37a4c90c42be",
                                "text": "Die Gläsles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "6f9f5b33-c597-4b37-8ba6-c5c7f572491c",
                                "sense_id": "f67463ae-c5d1-334f-bd59-37a4c90c42be",
                                "text": "Der Gläsle trägt nie die Pullover, die die Gläsle ihm strickt."
                            },
                            {
                                "example_id": "1a11a463-9dfc-4df2-b356-ef795af4f588",
                                "sense_id": "f67463ae-c5d1-334f-bd59-37a4c90c42be",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gläsle kommt, geht der Herr Gläsle.“"
                            },
                            {
                                "example_id": "d4bf2978-b3ec-4911-b500-64fd60c29b5f",
                                "sense_id": "f67463ae-c5d1-334f-bd59-37a4c90c42be",
                                "text": "Gläsle kommt und geht."
                            },
                            {
                                "example_id": "9e3e0648-2bc4-422d-8d06-93f75cd8ce8b",
                                "sense_id": "f67463ae-c5d1-334f-bd59-37a4c90c42be",
                                "text": "Gläsles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
