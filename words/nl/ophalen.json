                {
                    "sense_id": "41159a29-3e98-3e79-a89b-b16e8721a002",
                    "sense_definition": "Iets naar boven trekken of hijsen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "raise_lift",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>haalde</w> zijn schouders <w>op</w> toen ik hem een vraag stelde.",
                            "target_lang_translations": {
                                "ru": "Он <w>пожал</w> плечами, когда я задал ему вопрос.",
                                "en": "He <w>shrugged</w> his shoulders when I asked him a question.",
                                "it": "Si è <w>stretto nelle spalle</w> quando gli ho fatto una domanda.",
                                "pl": "<w>Wzruszył</w> ramionami, gdy zadałem mu pytanie.",
                                "de": "Er <w>zuckte</w> mit den Schultern, als ich ihm eine Frage stellte.",
                                "fr": "Il a <w>haussé</w> les épaules quand je lui ai posé une question.",
                                "cs": "Když jsem mu položil otázku, <w>pokrčil</w> rameny.",
                                "tr": "Ona bir soru sorduğumda <w>omuz silkti</w>.",
                                "es": "Se <w>encogió de hombros</w> cuando le hice una pregunta.",
                                "zh": "当我问他问题时，他<w>耸</w>了耸肩。"
                            }
                        },
                        {
                            "text": "De vissers <w>haalden</w> de zware netten <w>op</w>.",
                            "target_lang_translations": {
                                "ru": "Рыбаки <w>поднимали</w> тяжелые сети.",
                                "en": "The fishermen <w>pulled up</w> the heavy nets.",
                                "it": "I pescatori hanno <w>sollevato</w> le reti pesanti.",
                                "pl": "Rybacy <w>podnieśli</w> ciężkie sieci.",
                                "de": "Die Fischer <w>zogen</w> die schweren Netze <w>hoch</w>.",
                                "fr": "Les pêcheurs ont <w>remonté</w> les filets lourds.",
                                "cs": "Rybáři <w>vytahovali</w> těžké sítě.",
                                "tr": "Balıkçılar ağır ağları <w>yukarı çektiler</w>.",
                                "es": "Los pescadores <w>subieron</w> las redes pesadas.",
                                "zh": "渔民们把沉重的网<w>拉起</w>来。"
                            }
                        }
                    ],
                    "synonyms": [
