                    {
                        "translation_id": "a6a3f6e9-3cd1-4996-96cc-b83b71491adc",
                        "source_entry_id": "296a4ecd-deb4-3743-bbea-9a119d6d28fb",
                        "source_sense_id": "1e4b66bf-2bf4-34fa-b630-d74563fece4b",
                        "target_lang_word": "Hydrant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hydrant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9dacd00e-a5b7-3b18-aaf1-daf76631a517",
                                        "entry_id": "72aade74-754c-394c-841f-894b728262ff",
                                        "glosses": [
                                            "Wasserentnahmestelle (meist in der Straße), die zur Versorgung mit Wasser (etwa zum Löschen von Bränden, zur Straßenreinigung oder auch auf dem Bau) benutzt wird und an das öffentliche Wasserversorgungsnetz angeschlossen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "971ee72e-7f17-4e19-a59c-c1f529f1598c",
                                                "sense_id": "9dacd00e-a5b7-3b18-aaf1-daf76631a517",
                                                "text": "Die Feuerwehr schließt ihre Schläuche an den Hydranten und beginnt sofort mit der Löschung des Wohnungsbrandes."
                                            },
                                            {
                                                "example_id": "af2e5157-9db5-4def-a8c3-6c7c42a6136b",
                                                "sense_id": "9dacd00e-a5b7-3b18-aaf1-daf76631a517",
                                                "text": "Auch soll es anfangs Probleme mit der Wasserversorgung gegeben haben, da einige Hydranten schwer erreichbar gewesen seien."
                                            },
                                            {
                                                "example_id": "4663902c-4b63-47b1-bb97-38880403bf86",
                                                "sense_id": "9dacd00e-a5b7-3b18-aaf1-daf76631a517",
                                                "text": "Es ist ein wenig wie bei der Brandbekämpfung: Der Wasserschlauch und auch der Hydrant helfen als technische Werkzeuge; aber es bedarf der Institution Feuerwehr, des menschlichen Wissens, wie gelöscht werden muss."
                                            },
                                            {
                                                "example_id": "513926cc-c201-4e81-885f-e65a342caa3a",
                                                "sense_id": "9dacd00e-a5b7-3b18-aaf1-daf76631a517",
                                                "text": "„Die Straßenreiniger öffneten einen Hydranten.“"
                                            },
                                            {
                                                "example_id": "ef6d1950-a202-4382-9c7a-dbada37abce1",
                                                "sense_id": "9dacd00e-a5b7-3b18-aaf1-daf76631a517",
                                                "text": "„Dee Witt war zum Hydranten im Seitenhof gegangen, steckte den Kopf drunter und wusch sich die Erde ab, mit der ihn Anse beworfen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
