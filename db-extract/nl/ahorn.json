                                    {
                                        "sense_id": "d0965458-0e27-3c90-bc70-a33bae62c9c8",
                                        "entry_id": "90c4b6f9-147f-3629-b2da-6cdbab2c7744",
                                        "glosses": [
                                            "Laubbaum mit gelappten Blättern (Gattung Acer)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99743852-8cf6-4266-9cd1-49b6f02d0ea4",
                                                "sense_id": "d0965458-0e27-3c90-bc70-a33bae62c9c8",
                                                "text": "Zwischen den Eichen stehen einzelne Ahorne."
                                            },
                                            {
                                                "example_id": "9c20a618-6151-4c1b-8188-45d2f3262505",
                                                "sense_id": "d0965458-0e27-3c90-bc70-a33bae62c9c8",
                                                "text": "„Alleen aus Ulmen, Pappeln, Eichen, Ahorn, Eschen oder Linden verbanden die Gutsdörfer und Kleinstädte, deren solide erbaute Häuser mit farbenprächtig angelegten Vorgärten strunzten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "24a8eccb-fc0f-3208-9135-35bdd197be54",
                                        "entry_id": "90c4b6f9-147f-3629-b2da-6cdbab2c7744",
                                        "glosses": [
                                            "Holz von [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0f4512d-9258-40a6-958d-b794e4a821dd",
                                                "sense_id": "24a8eccb-fc0f-3208-9135-35bdd197be54",
                                                "text": "Der Tisch ist aus Ahorn."
                                            },
                                            {
                                                "example_id": "f60bbac7-936c-4391-93b6-49c6e52e7b0d",
                                                "sense_id": "24a8eccb-fc0f-3208-9135-35bdd197be54",
                                                "text": "„Während er in dieses Faktum einsackte, nahm er fasziniert die Eleganz seiner Möbel wahr: das Telefontischchen aus Ahorn mit den spitz zulaufenden Beinen, den Spiegelrahmen mit dem Akanthusmuster und der abblätternden Vergoldung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
