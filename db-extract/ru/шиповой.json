                "translations": [
                    {
                        "translation_id": "6aaf3170-cf95-4b3e-9740-41610d86b7ff",
                        "source_entry_id": "06d8d45d-a20b-3b60-8d53-020e03b8732a",
                        "target_lang_word": "thorny",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thorny",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4bec99a7-1c4f-3c0f-bc95-d6d3c3d4ae50",
                                        "entry_id": "391e7bf1-f823-3cee-8eec-18ec953cb2fc",
                                        "glosses": [
                                            "Having thorns or spines."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b81081e4-29c2-41fc-93c3-284f7cd37954",
                                                "sense_id": "4bec99a7-1c4f-3c0f-bc95-d6d3c3d4ae50",
                                                "text": "Tara flour is one of two products made from the seed pods of a thorny shrub native to Peru. One of those, tara gum, has been used safely for years as a thickening agent or stabilizer in human foods."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d692d749-5c2e-31f3-a431-0a6b04206538",
                                        "entry_id": "391e7bf1-f823-3cee-8eec-18ec953cb2fc",
                                        "glosses": [
                                            "Troublesome or vexatious."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64a94cb7-511d-4c40-813c-1356c206b800",
                                                "sense_id": "d692d749-5c2e-31f3-a431-0a6b04206538",
                                                "text": "thorny issues"
                                            },
                                            {
                                                "example_id": "4caabe0e-8af1-4430-9f7b-802d4901a127",
                                                "sense_id": "d692d749-5c2e-31f3-a431-0a6b04206538",
                                                "text": "the steep and thorny way to heaven"
                                            },
                                            {
                                                "example_id": "c344e867-dff1-4df0-b8ba-c0192ce0dc0d",
                                                "sense_id": "d692d749-5c2e-31f3-a431-0a6b04206538",
                                                "text": "Westcott doesn’t even consider the thornier question of fan fiction based on real and often living people, for instance, the “bandslash” or “bandfic” phenomenon built around rock-star characters and often homoerotic subplots."
                                            },
                                            {
                                                "example_id": "0b74a2c4-3a7d-484a-9a06-ca24d689d039",
                                                "sense_id": "d692d749-5c2e-31f3-a431-0a6b04206538",
                                                "text": "Six weeks into the renegotiation of the North American Free Trade Agreement, the thorniest issues surrounding the pact remain unresolved."
                                            },
                                            {
                                                "example_id": "d91a01af-009b-4c43-a477-59a6a70ba9b6",
                                                "sense_id": "d692d749-5c2e-31f3-a431-0a6b04206538",
                                                "text": "Museums have recently begun to confront the same thorny question, with several issuing public apologies for collecting the remains of people believed or known to have been enslaved."
                                            },
                                            {
                                                "example_id": "c89aa11d-55c8-45f9-8c9d-e7996e57570d",
                                                "sense_id": "d692d749-5c2e-31f3-a431-0a6b04206538",
                                                "text": "Station capacity in London, Paris, Brussels and Amsterdam remains a thorny issue, as does obtaining suitable Channel Tunnel-compliant trains."
                                            },
                                            {
                                                "example_id": "42e9dd9e-dc91-4480-8546-fc189c383552",
                                                "sense_id": "d692d749-5c2e-31f3-a431-0a6b04206538",
                                                "text": "Mr. [Jake] Sullivan noted that turning away from thorny global issues like climate change would not stop them from posing a threat to the United States, and the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "180fac26-626b-38ba-ac74-8799fa61f76a",
                                        "entry_id": "391e7bf1-f823-3cee-8eec-18ec953cb2fc",
                                        "glosses": [
                                            "Aloof and irritable."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c62bbd06-cb9a-4607-b5f1-d7fdb3351d2e",
                                                "sense_id": "180fac26-626b-38ba-ac74-8799fa61f76a",
                                                "text": "Come, Jo, don't be thorny. After studying himself to a skeleton all the week, a fellow deserves petting, and ought to get it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f55c4552-1f84-42bd-8452-4552679d0bcf",
                        "source_entry_id": "06d8d45d-a20b-3b60-8d53-020e03b8732a",
                        "target_lang_word": "barbed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "barbed",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0fce09e5-371a-3d1b-bca6-895bf9e08434",
                                        "entry_id": "5a33a5b1-ea81-3655-830f-90010765bc31",
                                        "glosses": [
                                            "Having barbs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9668745-be59-4030-89e1-9f33ab7aa3db",
                                                "sense_id": "0fce09e5-371a-3d1b-bca6-895bf9e08434",
                                                "text": "COCKATRICE an imaginary monster resembling a wivern with the head of a cock, the tongue barbed. It occurs displayed, but is ordinarily borne with the wings endorsed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68aa3f47-be52-350e-a2aa-15da7b9ce90b",
                                        "entry_id": "5a33a5b1-ea81-3655-830f-90010765bc31",
                                        "glosses": [
                                            "Having barbs of a certain colour (as or similar to an arrow); beared."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f776a43-adeb-446d-8d37-c871a8dd61c2",
                                                "sense_id": "68aa3f47-be52-350e-a2aa-15da7b9ce90b",
                                                "text": "Crest : A demi-cockatrice or, crested gules, stricken through the back of the neck with an arrow sable, barbed and flighted argent. Sable, two bars humettée or between a cock in fesse and a swan in chief and in base argent."
                                            },
                                            {
                                                "example_id": "5b033b21-a88a-423d-8f7e-50fe776ba372",
                                                "sense_id": "68aa3f47-be52-350e-a2aa-15da7b9ce90b",
                                                "text": "The cross barbed has its limbs terminated by arrow-heads; it is sometimes emblazoned cramponée and tournée, but Edmondson gives the last name to a totally different cross, one not unlike the cross fourchée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51d1e0a6-9e6a-35f7-ae8b-b2e19417b8c0",
                                        "entry_id": "5a33a5b1-ea81-3655-830f-90010765bc31",
                                        "glosses": [
                                            "Having gills or wattles (as a bird); wattled."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9dd889d-71e6-4a87-b166-020a0769e27c",
                                                "sense_id": "51d1e0a6-9e6a-35f7-ae8b-b2e19417b8c0",
                                                "text": "Ex. A Cock barbed and crested, (that is, wattled and combed, which signifies the Comb and Gills of a Cock, when born of a different Tincture from the Body)"
                                            },
                                            {
                                                "example_id": "75d8eb3c-71ec-4363-8801-938c409b7f00",
                                                "sense_id": "51d1e0a6-9e6a-35f7-ae8b-b2e19417b8c0",
                                                "text": "About the year 1446, he carried, as by our old books of blazons, quarterly, first and fourth Marr; second and third Lyle, as above blazoned; for crest, a cock or, crested and barbed gules: motto, An I may; supported by two[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cbc2a3b2-6e61-32a7-82d4-d693cf3b1f0f",
                                        "entry_id": "5a33a5b1-ea81-3655-830f-90010765bc31",
                                        "glosses": [
                                            "Having sepals or leaves between the petals (on a rose, etc)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7d9c054-f499-4542-bfee-86a02d91a854",
                                                "sense_id": "cbc2a3b2-6e61-32a7-82d4-d693cf3b1f0f",
                                                "text": "PLANT (?Plantagenet). Arg. a rose gu. seeded or barbed vert."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd251978-267f-39f8-854e-60d38668a30b",
                                        "entry_id": "5a33a5b1-ea81-3655-830f-90010765bc31",
                                        "glosses": [
                                            "Deliberately hurtful; biting; caustic."
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f0f21ee-81af-388a-9599-921e9d627699",
                                        "entry_id": "5a33a5b1-ea81-3655-830f-90010765bc31",
                                        "glosses": [
                                            "Accoutered with defensive armor; barded."
                                        ],
                                        "tags": [
                                            "of a horse"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3096d614-ccc9-472a-8c46-26dd5a969cea",
                                                "sense_id": "8f0f21ee-81af-388a-9599-921e9d627699",
                                                "text": "Your Lordship may remember in your reading, that there were many Earles could bring into the field a thousand Barbed horses"
                                            }
                                        ]
                                    }
                                ]
                            },
