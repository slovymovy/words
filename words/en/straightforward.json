{
    "word_family": [
        "straightforwardly",
        "straightforwardness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e8e2c075-ae5c-366f-9d4e-112aecd9eb18",
                    "sense_definition": "Easy to do or understand; not complicated or difficult.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "simplicity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The assembly instructions for the new desk were very <w>straightforward</w> and easy to follow.",
                            "target_lang_translations": {
                                "ru": "Инструкции по сборке нового стола были очень <w>простыми</w> и понятными.",
                                "de": "Die Aufbauanleitung für den neuen Schreibtisch war sehr <w>einfach</w> und leicht zu befolgen."
                            }
                        },
                        {
                            "text": "It was a <w>straightforward</w> process that only took a few minutes to complete.",
                            "target_lang_translations": {
                                "ru": "Это был <w>несложный</w> процесс, который занял всего несколько минут.",
                                "de": "Es war ein <w>unkomplizierter</w> Prozess, der nur wenige Minuten in Anspruch nahm."
                            }
                        }
                    ],
                    "synonyms": [
                        "unvarnished"
                    ],
                    "antonyms": [
                        "complicated",
                        "complex",
                        "difficult"
                    ],
                    "common_phrases": [
                        "straightforward process",
                        "straightforward answer",
                        "straightforward task"
                    ],
                    "target_lang_definitions": {
                        "ru": "Простой в выполнении или понимании; не сложный и не трудный.",
                        "de": "Einfach zu erledigen oder zu verstehen; nicht kompliziert oder schwierig."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "простой",
                                "target_lang_sense_clarification": "несложный для понимания"
                            },
                            {
                                "target_lang_word": "понятный",
                                "target_lang_sense_clarification": "ясный"
                            },
                            {
                                "target_lang_word": "лёгкий",
                                "target_lang_sense_clarification": "не требующий усилий"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "einfach",
                                "target_lang_sense_clarification": "nicht schwierig oder komplex"
                            },
                            {
                                "target_lang_word": "leicht",
                                "target_lang_sense_clarification": "ohne große Anstrengung zu bewältigen"
                            },
                            {
                                "target_lang_word": "verständlich",
                                "target_lang_sense_clarification": "klar und leicht nachzuvollziehen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd389ca3-72aa-3d36-a14b-29dbbe207cdb",
                    "sense_definition": "Honest and direct in manner or speech; saying exactly what one means.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "honesty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I appreciate your <w>straightforward</w> approach to solving this conflict.",
                            "target_lang_translations": {
                                "ru": "Я ценю ваш <w>прямой</w> подход к разрешению этого конфликта.",
                                "de": "Ich schätze deine <w>direkte</w> Art, diesen Konflikt zu lösen."
                            }
                        },
                        {
                            "text": "He gave a <w>straightforward</w> account of what happened during the meeting.",
                            "target_lang_translations": {
                                "ru": "Он представил <w>честный</w> отчет о том, что произошло во время встречи.",
                                "de": "Er gab einen <w>aufrichtigen</w> Bericht darüber ab, was während des Treffens geschah."
                            }
                        }
                    ],
                    "synonyms": [
                        "unvarnished"
                    ],
                    "antonyms": [
                        "evasive",
                        "deceptive",
                        "indirect"
                    ],
                    "common_phrases": [
                        "straightforward person",
                        "straightforward manner",
                        "straightforward talk"
                    ],
                    "target_lang_definitions": {
                        "ru": "Честный и прямой в манере общения или речи; говорящий именно то, что имеет в виду.",
                        "de": "Ehrlich und direkt in der Art oder Sprache; genau das sagend, was man meint."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прямой",
                                "target_lang_sense_clarification": "откровенный и честный"
                            },
                            {
                                "target_lang_word": "честный",
                                "target_lang_sense_clarification": "искренний"
                            },
                            {
                                "target_lang_word": "откровенный",
                                "target_lang_sense_clarification": "прямолинейный"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "direkt",
                                "target_lang_sense_clarification": "offen und ohne Umschweife"
                            },
                            {
                                "target_lang_word": "aufrichtig",
                                "target_lang_sense_clarification": "ehrlich und wahrhaftig"
                            },
                            {
                                "target_lang_word": "ehrlich",
                                "target_lang_sense_clarification": "aufrichtig und fair"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4cd454f9-4a45-3034-a509-c3ac458a1bed",
                    "sense_definition": "Moving or proceeding in a direct course without deviating.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The path through the forest is <w>straightforward</w> and leads directly to the lake.",
                            "target_lang_translations": {
                                "ru": "Тропа через лес <w>прямая</w> и ведет прямо к озеру.",
                                "de": "Der Weg durch den Wald ist <w>geradlinig</w> und führt direkt zum See."
                            }
                        },
                        {
                            "text": "The ship maintained a <w>straightforward</w> course despite the heavy winds.",
                            "target_lang_translations": {
                                "ru": "Корабль придерживался <w>прямого</w> курса, несмотря на сильный ветер.",
                                "de": "Das Schiff hielt trotz des starken Windes einen <w>direkten</w> Kurs."
                            }
                        }
                    ],
                    "antonyms": [
                        "winding",
                        "deviating"
                    ],
                    "common_phrases": [
                        "straightforward course",
                        "straightforward path"
                    ],
                    "target_lang_definitions": {
                        "ru": "Движущийся или идущий по прямому курсу без отклонений.",
                        "de": "Sich in einer direkten Linie bewegend oder verlaufend, ohne Abweichungen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прямой",
                                "target_lang_sense_clarification": "без поворотов и изгибов"
                            },
                            {
                                "target_lang_word": "кратчайший",
                                "target_lang_sense_clarification": "ведущий прямо к цели"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "direkt",
                                "target_lang_sense_clarification": "ohne Umwege"
                            },
                            {
                                "target_lang_word": "geradlinig",
                                "target_lang_sense_clarification": "ohne Kurven oder Abweichungen"
                            }
                        ]
                    }
                }
            ]
        },
        {
