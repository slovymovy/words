        "fr-extract.jsonl": [
            {
                "entry_id": "3283851f-8e88-3548-b4ad-a204054538ca",
                "word": "phytoplancton",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4ef80b61-384f-41b0-8e51-bd65445ae7c4",
                        "entry_id": "3283851f-8e88-3548-b4ad-a204054538ca",
                        "tags": [
                            "plural"
                        ],
                        "form": "phytoplanctons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ea289189-84df-3798-aa83-e53e3709f12f",
                        "entry_id": "3283851f-8e88-3548-b4ad-a204054538ca",
                        "glosses": [
                            "Plancton végétal, et particulièrement l’ensemble des espèces de plancton autotrophes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78ef7041-bd22-4488-8794-9545dfe7c465",
                                "sense_id": "ea289189-84df-3798-aa83-e53e3709f12f",
                                "text": "Le plancton rassemble les espèces aquatiques entraînées par le courant, animales comme des méduses pour le zooplancton, et végétales comme les algues pour le phytoplancton, ainsi que des bactéries et des virus."
                            },
                            {
                                "example_id": "ec4f42f8-7048-42e6-9065-228248e34c37",
                                "sense_id": "ea289189-84df-3798-aa83-e53e3709f12f",
                                "text": "« Les rejets en mer tuent instantanément le phytoplancton et viennent acidifier les océans et les mers, qui contribuent à réguler le réchauffement climatique », avance ainsi Hervé Menchon, adjoint au maire de Marseille chargé de la biodiversité marine"
                            },
                            {
                                "example_id": "3f84fad0-f63a-4c49-a128-4685e9a2a98c",
                                "sense_id": "ea289189-84df-3798-aa83-e53e3709f12f",
                                "text": "Un tiers des émissions mondiales de CO2 sont absorbées par l’océan, notamment grâce aux phytoplanctons, des microalgues qui photosynthétisent le CO2 en matière organique."
                            }
                        ]
                    }
                ],
