{
    "word_family": [
        "linkage",
        "linker",
        "interlink",
        "hyperlink",
        "unlink"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "315e50fb-4c81-3bf2-96f4-3d1a44e81aa3",
                    "sense_definition": "A clickable reference in a digital document or on a website that takes the user to another file or page.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "computing_link",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Click the <w>link</w> below to visit our official website.",
                            "target_lang_translations": {
                                "ru": "Нажмите на <w>ссылку</w> ниже, чтобы посетить наш официальный сайт.",
                                "zh": "点击下方的<w>链接</w>访问我们的官方网站。"
                            }
                        },
                        {
                            "text": "She sent me a <w>link</w> to the video so I could watch it later.",
                            "target_lang_translations": {
                                "ru": "Она прислала мне <w>ссылку</w> на видео, чтобы я мог посмотреть его позже.",
                                "zh": "她给我发了一个视频<w>链接</w>，这样我稍后就能看了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "click the link",
                        "follow the link",
                        "broken link",
                        "send a link"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кликабельный элемент в цифровом документе или на веб-сайте, который перенаправляет пользователя на другой файл или страницу.",
                        "zh": "数字文档或网站中可点击的引用，将用户引导至另一个文件或页面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ссылка",
                                "target_lang_sense_clarification": "в интернете или документе"
                            },
                            {
                                "target_lang_word": "гиперссылка",
                                "target_lang_sense_clarification": "технический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "链接",
                                "target_lang_sense_clarification": "互联网或文档中的超链接"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40cce546-f45a-397a-b6ce-c4c1fa8ac351",
                    "sense_definition": "A relationship or connection between people, things, ideas, or events.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "general_connection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Police are investigating the <w>link</w> between the two crimes.",
                            "target_lang_translations": {
                                "ru": "Полиция расследует <w>связь</w> между двумя преступлениями.",
                                "zh": "警方正在调查这两起犯罪之间的<w>联系</w>。"
                            }
                        },
                        {
                            "text": "There is a strong <w>link</w> between diet and overall health.",
                            "target_lang_translations": {
                                "ru": "Существует сильная <w>связь</w> между диетой и общим состоянием здоровья.",
                                "zh": "饮食与整体健康之间存在着紧密的<w>联系</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "connection",
                        "bond",
                        "tie",
                        "nexus",
                        "relationship",
                        "association"
                    ],
                    "antonyms": [
                        "break",
                        "gap"
                    ],
                    "common_phrases": [
                        "link between",
                        "missing link",
                        "direct link",
                        "weak link"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отношения или связь между людьми, вещами, идеями или событиями.",
                        "zh": "人、事物、思想或事件之间的关系或联系。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "связь",
                                "target_lang_sense_clarification": "взаимоотношение, корреляция"
                            },
                            {
                                "target_lang_word": "соединение",
                                "target_lang_sense_clarification": "контакт, сцепление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "联系",
                                "target_lang_sense_clarification": "事物间的关联"
                            },
                            {
                                "target_lang_word": "关系",
                                "target_lang_sense_clarification": "人或事物间的相互作用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ebe6888d-3510-39ec-89ec-59ab8c11a02f",
                    "sense_definition": "One single ring or loop that forms part of a chain.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_chain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chain broke because one <w>link</w> was rusted and weak.",
                            "target_lang_translations": {
                                "ru": "Цепь порвалась, потому что одно <w>звено</w> проржавело и ослабло.",
                                "zh": "链条断了，因为其中一个<w>环节</w>生锈且脆弱。"
                            }
                        },
                        {
                            "text": "He examined every <w>link</w> of the metal chain to ensure it was secure.",
                            "target_lang_translations": {
                                "ru": "Он осмотрел каждое <w>звено</w> металлической цепи, чтобы убедиться в её надежности.",
                                "zh": "他检查了金属链的每一个<w>环节</w>，以确保其牢固。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "chain link",
                        "weakest link"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одно отдельное кольцо или петля, составляющая часть цепи.",
                        "zh": "构成链条一部分的单个环或圈。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "звено",
                                "target_lang_sense_clarification": "часть цепи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "环节",
                                "target_lang_sense_clarification": "链条的组成部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e75583c4-2568-3750-9e8a-37e76db92dea",
                    "sense_definition": "A single sausage that is part of a connected string.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He cooked a sausage <w>link</w> for breakfast along with some eggs.",
                            "target_lang_translations": {
                                "ru": "Он приготовил <w>колбаску</w> на завтрак вместе с яйцами.",
                                "zh": "他早餐煎了一根<w>香肠</w>，还配了些鸡蛋。"
                            }
                        },
                        {
                            "text": "The butcher sells fresh pork by the <w>link</w>.",
                            "target_lang_translations": {
                                "ru": "Мясник продает свежие свиные <w>колбаски</w> поштучно.",
                                "zh": "肉铺按<w>根</w>出售新鲜猪肉香肠。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sausage link"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельная сосиска или колбаска, являющаяся частью связки.",
                        "zh": "作为连接串一部分的单根香肠。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колбаска",
                                "target_lang_sense_clarification": "часть связки"
                            },
                            {
                                "target_lang_word": "сосиска",
                                "target_lang_sense_clarification": "продукт питания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "香肠",
                                "target_lang_sense_clarification": "食品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b27622e-f68d-3d64-8898-28b3f32de68a",
                    "sense_definition": "A torch made of pitch and tow, formerly used to light dark streets.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "historical_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The servant carried a burning <w>link</w> to guide the carriage through the fog.",
                            "target_lang_translations": {
                                "ru": "Слуга нес горящий <w>факел</w>, чтобы провести карету сквозь туман.",
                                "zh": "仆人举着燃烧的<w>火把</w>，引导马车穿过浓雾。"
                            }
                        },
                        {
                            "text": "Without a <w>link</w>, the alleyway was too dark to navigate safely.",
                            "target_lang_translations": {
                                "ru": "Без <w>факела</w> переулок был слишком темным, чтобы по нему можно было безопасно пройти.",
                                "zh": "没有<w>火把</w>，巷子里太黑，无法安全通行。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical term for a type of torch"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Факел из смолы и пакли, использовавшийся в прошлом для освещения темных улиц.",
                        "zh": "一种由沥青和麻絮制成的火把，过去用于照亮黑暗的街道。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "факел",
                                "target_lang_sense_clarification": "историческое"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "火把",
                                "target_lang_sense_clarification": "历史用语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e5c4c911-674e-377b-8b6a-d269a5b6fb27",
                    "sense_definition": "To join or connect two or more things, people, or ideas together.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "general_connection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A new bridge will <w>link</w> the island to the mainland.",
                            "target_lang_translations": {
                                "ru": "Новый мост <w>соединит</w> остров с материком.",
                                "zh": "一座新桥将把岛屿与大陆<w>连接</w>起来。"
                            }
                        },
                        {
                            "text": "Scientists have <w>linked</w> the disease to a specific genetic mutation.",
                            "target_lang_translations": {
                                "ru": "Ученые <w>связали</w> это заболевание с конкретной генетической мутацией.",
                                "zh": "科学家已将该疾病与特定的基因突变<w>联系</w>了起来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "join",
                        "attach",
                        "put together",
                        "connect",
                        "relate"
                    ],
                    "common_phrases": [
                        "link together",
                        "link up",
                        "closely linked"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соединять или связывать две или более вещи, людей или идеи вместе.",
                        "zh": "将两个或多个事物、人或思想连接在一起。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соединять",
                                "target_lang_sense_clarification": "физически или логически"
                            },
                            {
                                "target_lang_word": "связывать",
                                "target_lang_sense_clarification": "ассоциировать, скреплять"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "连接",
                                "target_lang_sense_clarification": "物理或逻辑上的结合"
                            },
                            {
                                "target_lang_word": "联系",
                                "target_lang_sense_clarification": "建立关联"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a51442f4-1550-3be0-a2c3-befedc6a102f",
                    "sense_definition": "To provide a hyperlink to a website or digital file.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "computing_link",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The article <w>links</w> to several sources that support the author's claims.",
                            "target_lang_translations": {
                                "ru": "Статья <w>ссылается</w> на несколько источников, подтверждающих утверждения автора.",
                                "zh": "这篇文章<w>链接</w>到了几个支持作者观点的来源。"
                            }
                        },
                        {
                            "text": "Can you <w>link</w> me to the document you mentioned earlier?",
                            "target_lang_translations": {
                                "ru": "Можешь <w>скинуть ссылку</w> на документ, о котором ты говорил ранее?",
                                "zh": "你能把刚才提到的那个文档<w>链接</w>发给我吗？"
                            }
                        }
                    ],
                    "common_phrases": [
                        "link to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать гиперссылку на веб-сайт или цифровой файл.",
                        "zh": "提供指向网站或数字文件的超链接。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ссылаться",
                                "target_lang_sense_clarification": "указывать источник"
                            },
                            {
                                "target_lang_word": "давать ссылку",
                                "target_lang_sense_clarification": "предоставлять адрес"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "链接",
                                "target_lang_sense_clarification": "提供超链接"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "732c06a3-5858-3085-b1e5-535ef4f84a5c",
                    "sense_definition": "To meet or connect with someone socially.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "social_meet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We should <w>link</w> up later this week to catch up.",
                            "target_lang_translations": {
                                "ru": "Нам стоит <w>пересечься</w> на этой неделе, чтобы поболтать.",
                                "zh": "我们这周晚些时候应该<w>碰面</w>叙叙旧。"
                            }
                        },
                        {
                            "text": "He is planning to <w>link</w> with his friends at the park.",
                            "target_lang_translations": {
                                "ru": "Он планирует <w>встретиться</w> с друзьями в парке.",
                                "zh": "他计划在公园和朋友们<w>见面</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "link up"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "common in MLE and urban dialects"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Встречаться или общаться с кем-то в неформальной обстановке.",
                        "zh": "在社交场合与某人见面或建立联系。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "встретиться",
                                "target_lang_sense_clarification": "увидеться"
                            },
                            {
                                "target_lang_word": "пересечься",
                                "target_lang_sense_clarification": "сленг: встретиться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "见面",
                                "target_lang_sense_clarification": "社交会面"
                            },
                            {
                                "target_lang_word": "碰面",
                                "target_lang_sense_clarification": "非正式会面"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
