                    {
                        "sense_id": "9a5da894-b27d-3405-bbc8-7a6966af10cc",
                        "entry_id": "62e2cd08-5702-30c7-a219-f473864e4e8a",
                        "glosses": [
                            "употребляется как вежливо-почтительное обращение к замужней женщине из привилегированного сословия"
                        ],
                        "tags": [],
