                "senses": [
                    {
                        "sense_id": "e0bc60be-27d6-3ac6-a2e4-a82a0d63736a",
                        "entry_id": "9cad9f50-f5e8-392d-8575-d00ab9aa80f1",
                        "glosses": [
                            "(abgezogenes) Fell eines Luchs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2a3e843-d3b2-483a-805c-f70a8410f134",
                                "sense_id": "e0bc60be-27d6-3ac6-a2e4-a82a0d63736a",
                                "text": "„Als er seinen schweren Mantel abgeworfen hatte, stand er in einem Luchsfell da, das seine Hüften umkleidete, und stampfte mit seinen kleinen bloßen Füßen, die weiß vom Staub waren, fest auf die Fliesen.“"
                            },
                            {
                                "example_id": "f724f0dd-0de6-4334-a13f-bdd4e5b4fde7",
                                "sense_id": "e0bc60be-27d6-3ac6-a2e4-a82a0d63736a",
                                "text": "„Mitten auf der Terrasse stand ein niedriges Ruhebett aus Elfenbein. Luchsfelle und mit Papageienfedern gefüllte Kissen lagen darauf.“"
                            },
                            {
                                "example_id": "0d3797e5-e5db-4f61-a080-52de27439b93",
                                "sense_id": "e0bc60be-27d6-3ac6-a2e4-a82a0d63736a",
                                "text": "„Spendius betastete den Boden und erkannte, dass er kunstfertig mit Luchsfellen ausgeschlagen war.“"
                            },
                            {
                                "example_id": "80dc3fec-f1d5-4749-9b20-0bec7f175c03",
                                "sense_id": "e0bc60be-27d6-3ac6-a2e4-a82a0d63736a",
                                "text": "„Männer, Frauen und Kinder trugen ihrer Körperkraft entsprechende Bündel von Biber-, Seeotter-, Marder-, Bären- und Luchsfellen und schon bearbeitete Elchhäute.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
