                ],
                "senses": [
                    {
                        "sense_id": "fbcbe27b-509c-3e1e-bddc-29eef12f278f",
                        "entry_id": "41a1bf8d-c241-3163-8db3-15ec232c2478",
                        "glosses": [
                            "akrobatische Darbietung eines Seiltänzers auf einem Drahtseil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8d90750-8044-4556-9dbb-52e79abd8d3c",
                                "sense_id": "fbcbe27b-509c-3e1e-bddc-29eef12f278f",
                                "text": "Der Drahtseilakt ist der Höhepunkt der heutigen Zirkusvorstellung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bf1c9fa5-ffdb-3da8-9fb8-7425b90d12a1",
                        "entry_id": "41a1bf8d-c241-3163-8db3-15ec232c2478",
                        "glosses": [
                            "schwieriges oder gefährliches Vorhaben, bei dem die Balance gewahrt werden muss, um nicht zu scheitern"
                        ],
                        "tags": [
                            "bildlich"
                        ],
                        "examples": [
                            {
                                "example_id": "235287c6-e21b-4b56-b81b-0576f20c23bc",
                                "sense_id": "bf1c9fa5-ffdb-3da8-9fb8-7425b90d12a1",
                                "text": "Die Regierungskrise ist zum Drahtseilakt geworden."
                            },
                            {
                                "example_id": "91299569-9e5b-4489-92c3-70ea2c5daffa",
                                "sense_id": "bf1c9fa5-ffdb-3da8-9fb8-7425b90d12a1",
                                "text": "„Islamabad vollführt stets einen Drahtseilakt: Einerseits macht die Regierung den USA nur so viele Zugeständnisse, wie es nötig und lukrativ ist. Andererseits ist sie darauf bedacht, sich medienwirksam von den USA zu distanzieren, wenn die pakistanische Volksseele mal wieder überkocht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
