    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9b5b33c1-a8ee-3c63-b6cd-b910f19c7b81",
                    "sense_definition": "een voertuig met vier wielen dat wordt aangedreven door een motor",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "voertuigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij vertrekt en keert zijn <w>wagen</w> op de brede weg.",
                            "target_lang_translations": {
                                "en": "He leaves and turns his <w>car</w> around on the wide road.",
                                "ru": "Он уезжает и разворачивает свою <w>машину</w> на широкой дороге."
                            }
                        },
                        {
                            "text": "Teresa hoorde de mannen uit de <w>wagen</w> springen en de achterklep openmaken.",
                            "target_lang_translations": {
                                "en": "Teresa heard the men jump out of the <w>car</w> and open the tailgate.",
                                "ru": "Тереза слышала, как мужчины выпрыгнули из <w>машины</w> и открыли заднюю дверь."
                            }
                        }
                    ],
                    "synonyms": [
                        "auto",
                        "automobiel"
                    ],
                    "common_phrases": [
                        "nieuwe wagen",
                        "snelle wagen"
                    ],
                    "target_lang_definitions": {
                        "en": "a four-wheeled vehicle powered by an engine",
                        "ru": "четырехколесное транспортное средство с двигателем"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "car",
                                "target_lang_sense_clarification": "the most common term for a personal motor vehicle"
                            },
                            {
                                "target_lang_word": "automobile",
                                "target_lang_sense_clarification": "a more formal or technical term for a car"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "машина",
                                "target_lang_sense_clarification": "самое распространенное разговорное название автомобиля"
                            },
                            {
                                "target_lang_word": "автомобиль",
                                "target_lang_sense_clarification": "более официальный или технический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "300d768d-b424-3707-a89a-3827ed9ea1ce",
                    "sense_definition": "een voertuig op wielen dat wordt getrokken door dieren of een ander voertuig",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "voertuigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer laadde het hooi op de houten <w>wagen</w> achter het paard.",
                            "target_lang_translations": {
                                "en": "The farmer loaded the hay onto the wooden <w>wagon</w> behind the horse.",
                                "ru": "Фермер грузил сено на деревянную <w>телегу</w> позади лошади."
                            }
                        },
                        {
                            "text": "In het museum staat een oude <w>wagen</w> die vroeger door ossen werd getrokken.",
                            "target_lang_translations": {
                                "en": "In the museum stands an old <w>cart</w> that used to be pulled by oxen.",
                                "ru": "В музее стоит старая <w>повозка</w>, которую раньше тянули волы."
                            }
                        }
                    ],
                    "synonyms": [
                        "kar"
                    ],
                    "common_phrases": [
                        "houten wagen"
                    ],
                    "target_lang_definitions": {
                        "en": "a wheeled vehicle pulled by animals or another vehicle",
