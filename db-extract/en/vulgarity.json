                                "target_senses": [
                                    {
                                        "sense_id": "5ddee713-81d5-3ee1-9e12-2ab79b11f96f",
                                        "entry_id": "2d57ab87-216d-338a-afea-fa076eedc18f",
                                        "glosses": [
                                            "Eigenschaft (von Bildern, Personen, Texten, Verhaltensweisen), vulgär, das heißt ordinär, unkultiviert, derb, unflätig zu sein"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9a5bfe3-4150-4f09-866b-b3a383fb82c5",
                                                "sense_id": "5ddee713-81d5-3ee1-9e12-2ab79b11f96f",
                                                "text": "„In der Vulgarität ist also indirekt, eben latent, das Sexuelle im Bewusstsein anwesend, auch wenn selten jemandem der Gedanke an Sexuelles im Kopf herumgeht, wenn er dergleichen sagt oder hört.“"
                                            },
                                            {
                                                "example_id": "1c77cbd0-5db9-4e26-9d78-6244630f54c4",
                                                "sense_id": "5ddee713-81d5-3ee1-9e12-2ab79b11f96f",
                                                "text": "„Papageien aber können nicht nur durch ihre Vulgarität für Ungemach sorgen.“"
                                            },
                                            {
                                                "example_id": "f58f463c-1ebc-4b2b-817e-ac5515b62134",
                                                "sense_id": "5ddee713-81d5-3ee1-9e12-2ab79b11f96f",
                                                "text": "„Es war ausschließlich Philip, der angespannt war, denn er war mehr denn je abgestoßen von dem, was er als die Vulgarität seines Vaters bezeichnete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4dda781e-5526-31fc-b6fa-327525edf89f",
                                        "entry_id": "2d57ab87-216d-338a-afea-fa076eedc18f",
                                        "glosses": [
                                            "Eigenschaft, allzu vereinfacht und nicht wissenschaftlich dargestellt zu sein"
