{
    "word_family": [
        "chamomile"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "38bb3b38-2a0a-304c-a784-3e3fd551f0f3",
                    "sense_definition": "A herbal tea made from the dried flowers of the camomile plant.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "beverage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I usually drink a cup of hot <w>camomile</w> before going to bed to help me sleep.",
                            "target_lang_translations": {
                                "zh": "我通常在睡前喝一杯热的<w>洋甘菊茶</w>来帮助睡眠。"
                            }
                        },
                        {
                            "text": "She poured her mum some <w>camomile</w> to help her relax after a long day.",
                            "target_lang_translations": {
                                "zh": "她给妈妈倒了一些<w>洋甘菊茶</w>，好让她在忙碌一天后放松一下。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cup of camomile",
                        "soothing camomile",
                        "hot camomile"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种用洋甘菊干花制成的草本茶。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "洋甘菊茶",
                                "target_lang_sense_clarification": "指代作为饮料的洋甘菊茶。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "308435e4-02b0-3776-b395-90c6f3a31088",
                    "sense_definition": "A plant with small daisy-like flowers used in herbal medicine and for making tea.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The garden was filled with the sweet scent of wild <w>camomile</w> growing near the fence.",
                            "target_lang_translations": {
                                "zh": "花园里弥漫着围栏旁生长的野生<w>洋甘菊</w>的甜美香气。"
                            }
                        },
                        {
                            "text": "Farmers often harvest German <w>camomile</w> for its medicinal properties and fragrant flowers.",
                            "target_lang_translations": {
                                "zh": "农民经常收获德国<w>洋甘菊</w>，以利用其药用价值和芬芳的花朵。"
                            }
                        }
                    ],
                    "synonyms": [
                        "German camomile",
                        "Hungarian camomile"
                    ],
                    "common_phrases": [
                        "wild camomile",
                        "camomile flowers",
                        "extract of camomile"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种开着雏菊状小花、常用于草药和制茶的植物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "洋甘菊",
                                "target_lang_sense_clarification": "指代植物本身。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25552be1-17d6-323b-9e21-2b3132a2e7c3",
                    "sense_definition": "A low-growing plant used as a fragrant ground cover in gardens.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to plant English <w>camomile</w> instead of grass to create a scented lawn.",
                            "target_lang_translations": {
                                "zh": "我们决定种植<w>罗马洋甘菊</w>而不是草，来打造一片芳香的草坪。"
                            }
                        },
                        {
                            "text": "Walking on the <w>camomile</w> released a pleasant aroma reminiscent of fresh apples.",
                            "target_lang_translations": {
                                "zh": "走在<w>罗马洋甘菊</w>上会散发出一种让人想起新鲜苹果的宜人香气。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Roman camomile",
                        "English camomile"
                    ],
                    "common_phrases": [
                        "camomile lawn",
                        "creeping camomile"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种低矮的、常作为花园芳香地被植物种植的品种。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "罗马洋甘菊",
                                "target_lang_sense_clarification": "指代常用于地被的品种。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}