            {
                "entry_id": "bc7f0758-27ad-3788-8548-c4b4ac0d9287",
                "word": "lamzak",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "3ec774d0-8bda-4513-bb7c-b12a5561e9c5",
                        "entry_id": "bc7f0758-27ad-3788-8548-c4b4ac0d9287",
                        "tags": [
                            "plural"
                        ],
                        "form": "lamzakken"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "df1eae64-4a89-36e7-b18e-fecd4069187a",
                        "entry_id": "bc7f0758-27ad-3788-8548-c4b4ac0d9287",
                        "glosses": [
                            "een krachteloos of volkomen futloos persoon"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "79340b4d-8e5b-41fb-8f5b-34b907645577",
                                "sense_id": "df1eae64-4a89-36e7-b18e-fecd4069187a",
                                "text": "\"De BMW Concept X2 is een auto voor actieve mensen die zoeken naar een combinatie van plezier en praktisch nut\", lezen we tot slot. Hè, dat is nou jammer. Altijd maar dat actieve in persberichten. Waarom worden auto's nooit eens ontworpen voor lamzakken?"
                            },
                            {
                                "example_id": "f2f86b9d-edff-4618-ba1d-34e251586656",
                                "sense_id": "df1eae64-4a89-36e7-b18e-fecd4069187a",
                                "text": "Hoeveel doden moet er nog vallen voor dat lamzakwerknemers, -managers en -directieleden levenslang op non-actief worden gesteld? Want aan dom personeel gaat je bedrijf ten onder."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1322bfc5-4741-42d6-b254-cff5e1d01c3d",
                        "source_entry_id": "bc7f0758-27ad-3788-8548-c4b4ac0d9287",
                        "source_sense_id": "df1eae64-4a89-36e7-b18e-fecd4069187a",
                        "target_lang_word": "lackluster person",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "cd7dcd3e-d385-444b-a163-4a30dcd2a6ba",
                        "source_entry_id": "bc7f0758-27ad-3788-8548-c4b4ac0d9287",
                        "source_sense_id": "df1eae64-4a89-36e7-b18e-fecd4069187a",
                        "target_lang_word": "dull",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dull",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d56ff2a3-9f02-31c5-aaa0-3bdb417cf577",
                                        "entry_id": "f0d6fd69-f305-3e3e-94df-ee1144f112d7",
                                        "glosses": [
                                            "Lacking the ability to cut easily; not sharp."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63d5e2a6-ee38-422d-b2a3-b034099006d9",
                                                "sense_id": "d56ff2a3-9f02-31c5-aaa0-3bdb417cf577",
                                                "text": "All these knives are dull."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15cf3ebe-292f-37e5-b96a-456b3000b910",
                                        "entry_id": "f0d6fd69-f305-3e3e-94df-ee1144f112d7",
                                        "glosses": [
                                            "Boring; not exciting or interesting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e26efbf-2c8d-4f31-9364-5dc203145725",
                                                "sense_id": "15cf3ebe-292f-37e5-b96a-456b3000b910",
                                                "text": "He sat through the dull lecture and barely stayed awake."
                                            },
                                            {
                                                "example_id": "425b5d90-e8b0-4fd4-adad-f9db08d23e6f",
                                                "sense_id": "15cf3ebe-292f-37e5-b96a-456b3000b910",
                                                "text": "\"You are very dull this morning, Sheriff,\" said the youngest daughter of the house, who, being the baby and pretty, had grown pettishly privileged in speech."
                                            },
                                            {
                                                "example_id": "a3588479-5d53-4c9a-982f-98d7b4158ad8",
                                                "sense_id": "15cf3ebe-292f-37e5-b96a-456b3000b910",
                                                "text": "But there we were given only the dullest, driest, pemmicanised forms like The Student's Hume, Once I had a hundred pages of The Student's Hume as a holiday task."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be9b9ccf-3b80-39f5-b10a-c8d748ff2e06",
                                        "entry_id": "f0d6fd69-f305-3e3e-94df-ee1144f112d7",
                                        "glosses": [
                                            "Not shiny; having a matte finish or no particular luster or brightness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4e350fe-dab6-4724-bc89-8adaf2cbcff8",
                                                "sense_id": "be9b9ccf-3b80-39f5-b10a-c8d748ff2e06",
                                                "text": "Choose a dull finish to hide fingerprints."
                                            },
                                            {
                                                "example_id": "53c86e74-cc4e-4a3b-a9a4-6dd813afa4f2",
                                                "sense_id": "be9b9ccf-3b80-39f5-b10a-c8d748ff2e06",
                                                "text": "a dull fire or lamp;  a dull red or yellow;  a dull mirror"
                                            },
                                            {
                                                "example_id": "fdc16e2a-4193-402a-9486-070ede49a55b",
                                                "sense_id": "be9b9ccf-3b80-39f5-b10a-c8d748ff2e06",
                                                "text": "A great bargain also had been the excellent Axminster carpet which covered the floor; as, again, the arm-chair in which Bunting now sat forward, staring into the dull, small fire."
                                            },
                                            {
                                                "example_id": "da75609c-1469-4b85-bb53-6c4af32a2d7e",
                                                "sense_id": "be9b9ccf-3b80-39f5-b10a-c8d748ff2e06",
                                                "text": "The young bird had the plumage of the saddleback, not the even chestnut of the jackbird, although its plumage was rather duller than that of the adult."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96505395-9ab3-339a-bf33-8cf9dba7235e",
                                        "entry_id": "f0d6fd69-f305-3e3e-94df-ee1144f112d7",
                                        "glosses": [
                                            "Not bright or intelligent; stupid; having slow understanding."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b293cbc3-151b-463f-8821-1355424cc4aa",
                                                "sense_id": "96505395-9ab3-339a-bf33-8cf9dba7235e",
                                                "text": "She is not bred so dull but she can learn."
                                            },
                                            {
                                                "example_id": "fdbafd86-3a34-447b-9bac-7458b1f4b736",
                                                "sense_id": "96505395-9ab3-339a-bf33-8cf9dba7235e",
                                                "text": "dull at classical learning"
                                            },
                                            {
                                                "example_id": "e4fc5907-e7cc-46e7-9759-6f4eec2a4852",
                                                "sense_id": "96505395-9ab3-339a-bf33-8cf9dba7235e",
                                                "text": "She paused and took a defiant breath. ‘If you don't believe me, I can't help it. But I'm not a liar.’ ¶ ‘No,’ said Luke, grinning at her. ‘You're not dull enough! […] What about the kid's clothes? I don't suppose they were anything to write home about, but didn't you keep anything? A bootee or a bit of embroidery or anything at all?’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b8b5ffb-7866-3243-83c7-3be36776d66d",
                                        "entry_id": "f0d6fd69-f305-3e3e-94df-ee1144f112d7",
                                        "glosses": [
                                            "Sluggish, listless."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e469ce9f-b611-41ab-a48a-54c317f44dbe",
                                                "sense_id": "3b8b5ffb-7866-3243-83c7-3be36776d66d",
                                                "text": "This people's heart is waxed gross, and their ears are dull of hearing."
                                            },
                                            {
                                                "example_id": "a0d91d7a-b045-4f2d-a18f-e27c9cd9e50a",
                                                "sense_id": "3b8b5ffb-7866-3243-83c7-3be36776d66d",
                                                "text": "O, help my weak wit and sharpen my dull tongue."
                                            },
                                            {
                                                "example_id": "1dc6a8ce-f81c-49bf-b60d-4b6f0679399a",
                                                "sense_id": "3b8b5ffb-7866-3243-83c7-3be36776d66d",
                                                "text": "[…] St. Bede's at this period of its history was perhaps the poorest and most miserable parish in the East End of London. Close-packed, crushed by the buttressed height of the railway viaduct, rendered airless by huge walls of factories, it at once banished lively interest from a stranger's mind and left only a dull oppression of the spirit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b1bbe1c-8ecf-3394-a935-8b33b3b831d1",
                                        "entry_id": "f0d6fd69-f305-3e3e-94df-ee1144f112d7",
                                        "glosses": [
                                            "Bored, depressed, down."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9a80064-9103-4e25-bf1e-c0f59c9bca72",
                                                "sense_id": "4b1bbe1c-8ecf-3394-a935-8b33b3b831d1",
                                                "text": "I felt dull all day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e16beda-617c-34cb-a52d-d5d18f881f61",
                                        "entry_id": "f0d6fd69-f305-3e3e-94df-ee1144f112d7",
                                        "glosses": [
                                            "Cloudy, overcast."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47d7015b-bf28-4437-a300-24bf8140a54d",
                                                "sense_id": "5e16beda-617c-34cb-a52d-d5d18f881f61",
                                                "text": "It's a dull day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c732e78c-e49e-33c5-a074-8e6bd1290949",
                                        "entry_id": "f0d6fd69-f305-3e3e-94df-ee1144f112d7",
                                        "glosses": [
                                            "Insensible; unfeeling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3039ffa3-1fbc-4f33-baf3-edac5a211dcd",
                                                "sense_id": "c732e78c-e49e-33c5-a074-8e6bd1290949",
                                                "text": "Think me not / So dull a devil to forget the loss / Of such a matchless wife."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2576c17-7c28-3fb2-81e5-2d118382dfe3",
                                        "entry_id": "f0d6fd69-f305-3e3e-94df-ee1144f112d7",
                                        "glosses": [
                                            "Heavy; lifeless; inert."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44733401-a3c9-4181-82cb-2dae685a3a85",
                                                "sense_id": "f2576c17-7c28-3fb2-81e5-2d118382dfe3",
                                                "text": "the dull earth"
                                            },
                                            {
                                                "example_id": "15a6aa49-55e3-45aa-a419-b962dd6ce635",
                                                "sense_id": "f2576c17-7c28-3fb2-81e5-2d118382dfe3",
                                                "text": "c. 1857', Henry Wadsworth Longfellow, Table-Talk\nAs turning the logs will make a dull fire burn, so changes of study a dull brain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29ef82d0-9890-3239-a2cd-93d5cfe8c888",
                                        "entry_id": "f0d6fd69-f305-3e3e-94df-ee1144f112d7",
                                        "glosses": [
                                            "Not intense; felt indistinctly or only slightly."
                                        ],
                                        "tags": [
                                            "of pain etc"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4bb9e81-8c2c-4754-842e-c2123161ff9a",
                                                "sense_id": "29ef82d0-9890-3239-a2cd-93d5cfe8c888",
                                                "text": "Pressing on the bruise produces a dull pain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f405a932-a3a0-3093-889d-35b5ad40d387",
                                        "entry_id": "f0d6fd69-f305-3e3e-94df-ee1144f112d7",
                                        "glosses": [
                                            "Not clear, muffled. (of a noise or sound)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "dull",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "207ece44-a2b8-3672-b9b0-19dfd0f7edc2",
                                        "entry_id": "753eb4a3-bc7a-3d44-9def-0e4e63bc326d",
                                        "glosses": [
                                            "To render dull; to remove or blunt an edge or something that was sharp."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e02ebfe-03b9-4e1f-9336-00cae486d469",
                                                "sense_id": "207ece44-a2b8-3672-b9b0-19dfd0f7edc2",
                                                "text": "Years of misuse have dulled the tools."
                                            },
                                            {
                                                "example_id": "78cd6858-8c90-43d6-aaa2-398f0107c85a",
                                                "sense_id": "207ece44-a2b8-3672-b9b0-19dfd0f7edc2",
                                                "text": "This […] dulled their swords."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef1ccc76-688c-3d88-9cfb-1c743f2de966",
                                        "entry_id": "753eb4a3-bc7a-3d44-9def-0e4e63bc326d",
                                        "glosses": [
                                            "To soften, moderate or blunt; to make dull, stupid, or sluggish; to stupefy."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bddc04ad-b025-4d76-935b-c96c4ca6cb21",
                                                "sense_id": "ef1ccc76-688c-3d88-9cfb-1c743f2de966",
                                                "text": "He drinks to dull the pain."
                                            },
                                            {
                                                "example_id": "6f069e77-437d-4ed3-957a-c05ca4c98f36",
                                                "sense_id": "ef1ccc76-688c-3d88-9cfb-1c743f2de966",
                                                "text": "Those [drugs] she has / Will stupefy and dull the sense a while."
                                            },
                                            {
                                                "example_id": "a4523878-e537-468d-aa80-475d850e0336",
                                                "sense_id": "ef1ccc76-688c-3d88-9cfb-1c743f2de966",
                                                "text": "Use and custom have so dulled our eyes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f9e88c7-f4e9-3d42-827d-657b61ab4247",
                                        "entry_id": "753eb4a3-bc7a-3d44-9def-0e4e63bc326d",
                                        "glosses": [
                                            "To lose a sharp edge; to become dull."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f41e160e-8690-4dee-9a8d-d110cb695829",
                                                "sense_id": "1f9e88c7-f4e9-3d42-827d-657b61ab4247",
                                                "text": "A razor will dull with use."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6533c3f6-8851-3505-b195-2bf288f7ca34",
                                        "entry_id": "753eb4a3-bc7a-3d44-9def-0e4e63bc326d",
                                        "glosses": [
                                            "To render dim or obscure; to sully; to tarnish."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
