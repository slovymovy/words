                                        "examples": [
                                            {
                                                "example_id": "9c277011-5a96-450d-a044-4496af02a502",
                                                "sense_id": "e64cacb6-495e-3d8f-8630-356aec058364",
                                                "text": "The floor and walls for Copthall tunnel have already been constructed using formwork into which rebar (reinforcing bar) was placed, and then concrete poured."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f1f9523-a887-31d1-addb-88a31952f343",
                                        "entry_id": "c801d6a2-a688-33cc-82d1-786c20ba9971",
                                        "glosses": [
                                            "A grid-shaped system of such bars."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
