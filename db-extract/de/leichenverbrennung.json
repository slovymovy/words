                        "examples": [
                            {
                                "example_id": "4087c027-f69f-4e67-84b5-16b779830f54",
                                "sense_id": "5280724b-94b0-3600-95ab-eaca8d214187",
                                "text": "In deutschen Großstädten sind heute mehr als die Hälfte aller Beisetzungen Leichenverbrennungen."
                            },
                            {
                                "example_id": "c2800c2a-f430-4edc-8b55-9faf48dddff7",
                                "sense_id": "5280724b-94b0-3600-95ab-eaca8d214187",
                                "text": "Aufgrund der hohen Kosten ziehen immer mehr Menschen eine Leichenverbrennung vor."
                            },
                            {
                                "example_id": "5b9bd526-0ebd-47c7-9c10-e1bb8f8805d2",
                                "sense_id": "5280724b-94b0-3600-95ab-eaca8d214187",
                                "text": "Hierzulande bedarf eine Leichenverbrennung als Begräbnis einer Genehmigung."
                            },
                            {
                                "example_id": "0ea090b4-0988-492d-a08c-7089d5519e86",
                                "sense_id": "5280724b-94b0-3600-95ab-eaca8d214187",
                                "text": "Im Judentum ist die Leichenverbrennung strengstens untersagt."
                            }
                        ],
