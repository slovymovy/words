                        ],
                        "examples": [
                            {
                                "example_id": "4f71a67e-169a-4d0f-9809-9616a89b0120",
                                "sense_id": "ac87cabc-6d65-3c67-b044-87d0fb610612",
                                "text": "Fuchs, du hast die Gans gestohlen, / gib sie wieder her! / Sonst wird sie der Jäger holen, / mit dem Schießgewehr.",
                                "translation": "Fox, you stole the goose, / give it back! / Else the hunter will shoot it / with the rifle.",
                                "english": "Fox, you stole the goose, / give it back! / Else the hunter will shoot it / with the rifle."
                            },
                            {
                                "example_id": "b1f49d8e-4139-4495-870f-8bc0000f359e",
                                "sense_id": "ac87cabc-6d65-3c67-b044-87d0fb610612",
                                "text": "Alle Soldaten woll'n nach Haus / Sie woll'n die Uniform nicht mehr, / Den Stahlhelm und das Schießgewehr",
                                "translation": "All the soldiers wanna go home / they don't want the uniform / [nor] their helmet nor their gun",
                                "english": "All the soldiers wanna go home / they don't want the uniform / [nor] their helmet nor their gun"
                            }
                        ]
