                "senses": [
                    {
                        "sense_id": "815a43ee-680d-3660-b791-0bc01d059489",
                        "entry_id": "26446ab0-1ec7-3063-984f-b8f52ce545c9",
                        "glosses": [
                            "рег. уменьш. к козюля (в знач. «гадюка»)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "cfbd2641-a06c-372d-9d6b-97a045e0ddc3",
                        "entry_id": "26446ab0-1ec7-3063-984f-b8f52ce545c9",
                        "glosses": [
                            "прост. уменьш. к козюля (в знач. «засохшая сопля в носу»)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bddf689-d16b-46db-a623-6c9ae2ca7194",
                                "sense_id": "cfbd2641-a06c-372d-9d6b-97a045e0ddc3",
                                "text": "Вытаскивать эти каменные козюльки, забивавшие весь нос, было сущим наказанием."
                            },
                            {
                                "example_id": "5111cc07-453b-4449-b677-b1576400a40d",
                                "sense_id": "cfbd2641-a06c-372d-9d6b-97a045e0ddc3",
                                "text": "И взял и показывает мне эту ее козюльку, эту отвратительную соплю."
                            }
                        ]
                    },
                    {
                        "sense_id": "d0613d86-cd9c-38c3-97d2-7d779248bda8",
                        "entry_id": "26446ab0-1ec7-3063-984f-b8f52ce545c9",
                        "glosses": [
                            "диал. козявка"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9f1bbf1-9243-4821-81e6-53696fc2bfc2",
                                "sense_id": "d0613d86-cd9c-38c3-97d2-7d779248bda8",
                                "text": "И красный весь был от стыда: метил в бугаи, а сам так, козюлька."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb7d6f5b-5c48-4dec-8b62-38251aefa8ae",
                        "source_entry_id": "26446ab0-1ec7-3063-984f-b8f52ce545c9",
                        "source_sense_description": "змея",
                        "target_lang_word": "Schlange",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlange",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "064955ef-0fe9-3308-bef8-f503ac4bd60f",
                                        "entry_id": "81b57f9d-8894-384f-bd83-665031d27dbf",
                                        "glosses": [
                                            "Unterordnung von fußlosen Tieren (Serpentes)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83393b39-c510-422b-86aa-9de08ded7a8d",
                                                "sense_id": "064955ef-0fe9-3308-bef8-f503ac4bd60f",
                                                "text": "Vorsicht, hier gibt’s Schlangen!"
                                            },
                                            {
                                                "example_id": "8e71cb5b-8064-4ab8-9000-d6e495d37962",
                                                "sense_id": "064955ef-0fe9-3308-bef8-f503ac4bd60f",
                                                "text": "„Es hatte damit begonnen, dass die Alte eine Schlange tötete.“"
                                            },
                                            {
                                                "example_id": "45b912ef-71a8-42f2-94dd-d27456e586ee",
                                                "sense_id": "064955ef-0fe9-3308-bef8-f503ac4bd60f",
                                                "text": "„Dann sah ich eine Schlange mit einem Kaninchen im Maul.“"
                                            },
                                            {
                                                "example_id": "da4792c9-ca28-48f4-b7a7-0a20a7fef76b",
                                                "sense_id": "064955ef-0fe9-3308-bef8-f503ac4bd60f",
                                                "text": "„Die Priester, meine Reisegefährten, lachten, als ich ihnen meine Angst vor Taranteln und Schlangen gestand.“"
                                            },
                                            {
                                                "example_id": "3f4ff026-ac6a-42ef-99dc-1917438f72b5",
                                                "sense_id": "064955ef-0fe9-3308-bef8-f503ac4bd60f",
                                                "text": "„Zu den größten Gefahren für das menschliche Leben überhaupt zählen in Ägypten Bisse giftiger Schlangen und Skorpione.“"
                                            },
                                            {
                                                "example_id": "3a4278e4-d32e-46e1-b8d8-7207e49a20f8",
                                                "sense_id": "064955ef-0fe9-3308-bef8-f503ac4bd60f",
                                                "text": "„Es erhebt sich nun das Bild einer Schlange, die mit zäher Mühe Eingang in das Heiligtum zu erzwingen weiß, die schleimige Länge ihres Leibes über den kostbaren Fußboden zieht und den Altar gewinnt, wo sie Brot und Wein mit ihrem Gifte bespeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "95d34988-f902-3149-9981-ca959ac25586",
                                        "entry_id": "81b57f9d-8894-384f-bd83-665031d27dbf",
                                        "glosses": [
                                            "Abfolge, Reihe von Individuen oder Gegenständen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aa2fc7f-2a9d-4b3e-ae14-ed66e6adf25b",
                                                "sense_id": "95d34988-f902-3149-9981-ca959ac25586",
                                                "text": "Vor der Kasse war eine lange Schlange."
                                            },
                                            {
                                                "example_id": "6ef0eaec-2159-4469-a524-8a0c04d6d882",
                                                "sense_id": "95d34988-f902-3149-9981-ca959ac25586",
                                                "text": "„Obwohl es erst vormittags war, war es bereits glühend heiß, so ließ ich mein Motorrad in der Schlange der frustrierten, vor Hitze brutzelnden Autofahrer stehen und kauerte mich in den Schatten eines Gebäudes, von wo ich meine Mitfahrer beobachten konnte.“"
                                            },
                                            {
                                                "example_id": "b96d760b-2f88-4d25-b994-1352ba0ff9cb",
                                                "sense_id": "95d34988-f902-3149-9981-ca959ac25586",
                                                "text": "„Dort reiht sie sich in die anscheinend endlose Schlange von Menschen ein, die auf eine Audienz beim großen Guru warten.“"
                                            },
                                            {
                                                "example_id": "046238e4-c873-4187-a5ee-7205d88201c0",
                                                "sense_id": "95d34988-f902-3149-9981-ca959ac25586",
                                                "text": "„Als er sich dem Ende dessen näherte, was sich bald zu einer langen Schlange von Jobsuchenden entwickeln sollte, stellte er ebenso erstaunt wie verärgert fest, dass die Frau vor ihm eine Bauchtrage mit einem schlafenden Baby umgeschnallt hatte.“"
                                            },
                                            {
                                                "example_id": "d47434ab-61bb-4975-a727-42d741f49592",
                                                "sense_id": "95d34988-f902-3149-9981-ca959ac25586",
                                                "text": "„Ich hasse Fliegen. Ich finde es furchtbar, genervt mit anderen Genervten in langen Schlangen zu stehen, mich in einen unbequemen Sitz zu quetschen, schlecht zu essen und zu wissen, wenn etwas schiefgeht, hast du keine Chance.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "23b6b9cb-d5c8-38a1-8237-5a465755d4eb",
                                        "entry_id": "81b57f9d-8894-384f-bd83-665031d27dbf",
                                        "glosses": [
                                            "hinterhältige Frau"
                                        ],
                                        "tags": [
                                            "Schimpfwort"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b5e6077-4c8b-4a14-affd-c5888c21cf2d",
                                                "sense_id": "23b6b9cb-d5c8-38a1-8237-5a465755d4eb",
                                                "text": "„Sie sind eine scheinheilige Schlange.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
