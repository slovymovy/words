                        "examples": [
                            {
                                "example_id": "b3e5a2f3-6af9-43b7-89c8-0a2f332aed72",
                                "sense_id": "2f03820e-941e-3ddc-84dd-73dbdfa3fb6f",
                                "text": "Hij had veel zelfmedelijden omdat hij een onvoldoende voor de toets had gehaald. Terwijl hij er hard voor had gestudeerd."
                            },
                            {
                                "example_id": "fbc3dc28-7733-438d-9299-1bc0ed52a0af",
                                "sense_id": "2f03820e-941e-3ddc-84dd-73dbdfa3fb6f",
                                "text": "Hij is charmant, open en heeft gevoel voor humor. Zelfmedelijden ligt op de loer, maar krijgt niet veel kans. Zijn hele bezit bestaat uit een halflege plastic zak, waarin een tondeuse zit die hij oplaadt in de bibliotheek: „Je bent nu eenmaal een valse nicht,” zegt hij meerdere keren over zichzelf, net als de krachtterm „krijg de tandjes!”"
                            }
                        ]
                    }
