                                    },
                                    {
                                        "sense_id": "cb2d0a68-3426-330e-8f11-d1fccf592c22",
                                        "entry_id": "4b8a91a9-d980-359c-9948-7299eaaa9d73",
                                        "glosses": [
                                            "immancabilmente, teso a sottolineare qualcosa di negativo"
