                "senses": [
                    {
                        "sense_id": "7844f6c4-9bcc-344e-baac-9d4f68b483a4",
                        "entry_id": "18081a05-1a98-348b-bfb7-8f71bc6dd1bf",
                        "glosses": [
                            "Eigenschaft, keinen (sinnvollen) Inhalt zu besitzen; leer, nichtig (inan) zu sein"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "0e44e547-c335-4f47-9229-636bc556155c",
                                "sense_id": "7844f6c4-9bcc-344e-baac-9d4f68b483a4",
                                "text": "„Da berichtet etwa der französische Humanist Guillaume Bude', dass ihm durch die Lektüre von Hythlodaeus' Bericht über die Insel Utopia schlagartig die Inanität seines Strebens nach ökonomischem Erfolg zu Bewusstsein gekommen sei.“"
                            },
                            {
                                "example_id": "7fd923c3-be79-430a-b56f-86942ecb8bd6",
                                "sense_id": "7844f6c4-9bcc-344e-baac-9d4f68b483a4",
                                "text": "„Jene Untersuchungen, welche für die Mädchen eine bessere Erinnerung speziell an den Lehrstoff ergeben haben als für die Knaben, können nur so erklärt werden: aus der Inanität und Nullität der Frauen, die mit allem Beliebigen imprägniert werden können, indes der Mann nur behält, was ihn wirklich interessiert und alles übrige vergißt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
