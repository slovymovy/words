                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8fd23bf-c5b6-45bb-8666-eb0b66dc8d2a",
                                                "sense_id": "a431dc27-411d-36f0-9ede-eca0fd546223",
                                                "text": "Zijn onverstaanbare gemompel was hielp niet erg."
                                            },
                                            {
                                                "example_id": "43356fb1-570d-475a-a84c-5cb3a340a4c7",
                                                "sense_id": "a431dc27-411d-36f0-9ede-eca0fd546223",
                                                "text": "Ik tikte mijn wandelstokken tegen elkaar en sloeg onverstaanbare wartaal uit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c3b724b-2c76-407c-8504-73f63e1bcec8",
                        "source_entry_id": "11bd7bc4-b766-390d-b734-8c9b0d361274",
                        "source_sense_id": "7d9386c3-37dd-3321-b23c-bcf859e65e02",
                        "source_sense_description": "not intelligible",
                        "target_lang_word": "onbegrijpelijk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onbegrijpelijk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "1aa28dd9-66d0-3d40-9845-fec83e97fdfb",
                                        "entry_id": "9c15b69a-9b6d-3922-b650-23b1d9cb731e",
                                        "glosses": [
                                            "eigenschap van een persoon of van een zaak: niet of zeer moeilijk te begrijpen, rationeel niet te volgen, onlogisch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ac6d9a4-c707-43c8-911b-3b2350be02be",
                                                "sense_id": "1aa28dd9-66d0-3d40-9845-fec83e97fdfb",
                                                "text": "De plannen zijn onbegrijpelijk en onaanvaardbaar."
                                            },
                                            {
                                                "example_id": "65b49394-7968-4963-bbaa-509a5fbb92f5",
                                                "sense_id": "1aa28dd9-66d0-3d40-9845-fec83e97fdfb",
                                                "text": "Het Universitair Medisch Centrum Groningen is teleurgesteld over het \"onbegrijpelijke\" besluit om niet tot vervolging over te gaan. Het UMCG somt de ernstige gevolgen van tabaksverslaving nog eens op en zegt dat het goed zou zijn geweest als de strafrechter een oordeel had gegeven over de rol van de tabakssector."
                                            },
                                            {
                                                "example_id": "c70e6b7a-4e1e-4ca0-a51f-b0bdc8e087ff",
                                                "sense_id": "1aa28dd9-66d0-3d40-9845-fec83e97fdfb",
                                                "text": "Mama's reactie werd nog onbegrijpelijker."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "onbegrijpelijk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "31e3f0b1-e688-3f1e-88fc-77fe5527484c",
                                        "entry_id": "28750b18-66ce-3288-8770-751262e22c3a",
                                        "glosses": [
                                            "niet of zeer moeilijk te begrijpen, rationeel niet te volgen, onlogisch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9606199-66ed-47ce-bfc9-5e6466ed7e93",
                                                "sense_id": "31e3f0b1-e688-3f1e-88fc-77fe5527484c",
                                                "text": "Hij vindt het onbegrijpelijk dat de rechters zich niet uitspreken over de onjuistheden die volgens de school in het rapport staan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53efff94-9413-461f-ba78-bfce86499885",
                        "source_entry_id": "11bd7bc4-b766-390d-b734-8c9b0d361274",
                        "source_sense_id": "7d9386c3-37dd-3321-b23c-bcf859e65e02",
                        "source_sense_description": "not intelligible",
                        "target_lang_word": "inintelligible",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inintelligible",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c5e8c2d0-5f45-30c6-a1ea-048000362e84",
                                        "entry_id": "fd0791c0-bc12-3d98-98cf-a54a914b33b5",
                                        "glosses": [
                                            "Qui n’est pas intelligible, qu’on ne peut comprendre par l’intelligence ou l’ouïe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1035a7ba-6fde-445b-ac9c-dd055c35a75a",
                                                "sense_id": "c5e8c2d0-5f45-30c6-a1ea-048000362e84",
                                                "text": "[…] ainsi s’enroulent, pour ainsi dire, comme le fil sur le fuseau, tous ces commentaires ingénieux d’un texte inintelligible."
                                            },
                                            {
                                                "example_id": "816e08de-3e54-4584-bce6-bf2cc6d3fd15",
                                                "sense_id": "c5e8c2d0-5f45-30c6-a1ea-048000362e84",
                                                "text": "Il me salua gauchement, et prononça, en moldave, quelques paroles qui restèrent inintelligibles pour moi."
                                            },
                                            {
                                                "example_id": "b3ebd11a-b5c7-493d-ae5c-3665b8a04985",
                                                "sense_id": "c5e8c2d0-5f45-30c6-a1ea-048000362e84",
                                                "text": "Le charlatanisme des saints-simoniens fut aussi dégoûtant que celui de Murat; d’ailleurs l’histoire de cette école est inintelligible quand on ne la rapproche pas des modèles napoléoniens."
                                            },
                                            {
                                                "example_id": "c57a90de-04dd-4a32-9f66-60c488e8d4d7",
                                                "sense_id": "c5e8c2d0-5f45-30c6-a1ea-048000362e84",
                                                "text": "C’est afin d’améliorer l’orthographe des écoliers qu’on se propose de rendre inintelligible pour eux tout ce qui a été imprimé jusqu’à cette époque."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inintelligible",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "50d48422-df05-3b5c-89cb-24ba18a4d619",
                                        "entry_id": "39469928-e6ba-3c38-9055-e3526e620f88",
                                        "glosses": [
                                            "Ce qu’il est impossible d’appréhender par l’intelligence et l’entendement ; ce qui ne peut pas faire l’objet d’une compréhension."
                                        ],
                                        "tags": [
                                            "Par substantivation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a6de2e2-8bc5-4fd5-b185-176df75b9791",
                                                "sense_id": "50d48422-df05-3b5c-89cb-24ba18a4d619",
                                                "text": "Travailler auprès d’enfants victimes d’événements traumatiques nous apprend combien les répercussions psychiques sont différentes lorsque les blessures ont été causées de façon intentionnelle, qu’elles ont duré, qu’elles ont été commises par des adultes faisant autorité et censés les protéger. Les processus d’emprise, d’identification à l’agresseur sont alors à l’œuvre pour majorer l’impact traumatique et placer ces petites victimes dans un état d’agonie psychique. Comment dès lors dénoncer l’innommable ? Comment parvenir à se plaindre face à l’inintelligible ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
