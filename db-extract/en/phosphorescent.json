                                "example_id": "bc37d356-33ec-437c-a863-15b7204a3671",
                                "sense_id": "715b81c0-6203-337b-bc68-1108cfb8a65f",
                                "text": "So he imports this special breed of scorpions and feeds them on metal meal and the scorpions turned a phosphorescent blue color and sort of hummed."
                            }
                        ]
