                                "target_senses": [
                                    {
                                        "sense_id": "de77208b-6d00-3e96-b01e-46c1fe96d81b",
                                        "entry_id": "529dd9e8-8f73-305e-8550-514e9d177843",
                                        "glosses": [
                                            "Résidence secondaire dans la campagne russe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1afd0e94-32d9-4b94-b3a6-36d90b7445c2",
                                                "sense_id": "de77208b-6d00-3e96-b01e-46c1fe96d81b",
                                                "text": "Une petite datcha de rondins de bouleau."
                                            },
                                            {
                                                "example_id": "ec36b0b7-670a-4ccb-97dd-ddb5baa95c35",
                                                "sense_id": "de77208b-6d00-3e96-b01e-46c1fe96d81b",
                                                "text": "La luxueuse datcha d’un membre de la nomenklatura."
                                            },
                                            {
                                                "example_id": "ce193928-f41d-40eb-89b9-708db52b5dbd",
                                                "sense_id": "de77208b-6d00-3e96-b01e-46c1fe96d81b",
                                                "text": "À l’issue des projections, Staline invitait souvent les participants à dîner dans sa datcha."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fc59e0d1-28cc-4112-b8bf-f920d652eb11",
                        "source_entry_id": "58c90a38-919a-353e-9cbc-1502acb2933e",
                        "source_sense_id": "c205f670-cd8d-3e72-9aad-1501040ec791",
