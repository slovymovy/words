                        "glosses": [
                            "de woonkamer exclusief de eethoek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74b15bf3-d8e0-4b80-a5c5-e18407a14bb5",
                                "sense_id": "73b8c9f6-7598-36a8-bbcf-b7a134361e8c",
                                "text": "Er komen brede gangen en deuren, een aangepaste inrichting en tuinaanleg, leefhoeken en gemeenschappelijke ruimten. Tegelijk worden er ook de nodige zorgen voor de bewoners aan huis geleverd.’ De investering wordt geraamd op 2,8 miljoen euro."
                            },
                            {
                                "example_id": "3b9e8c35-39ad-4880-98f1-b68f886c83c6",
                                "sense_id": "73b8c9f6-7598-36a8-bbcf-b7a134361e8c",
                                "text": "Nog in de oude vleugel werden op alle verdiepingen nieuwe zit- en leefhoeken gecreëerd, die het kleinschalig en huiselijk karakter maximaal onderstrepen."
                            },
                            {
                                "example_id": "71707d01-0ba0-4a3d-abcf-6714aff1b57d",
                                "sense_id": "73b8c9f6-7598-36a8-bbcf-b7a134361e8c",
                                "text": "De absolute blikvanger in de leefhoek prijkt aan de wand: een collectie uiterst bekoorlijke foto's. Het eindwerk van haar talentrijke broer, Thomas Pittoors. De Standaard 15 JULI 2006 OM 00:00 UUR"
                            },
                            {
                                "example_id": "a3a351d7-bddc-4e0e-9526-44c10cdcd52d",
                                "sense_id": "73b8c9f6-7598-36a8-bbcf-b7a134361e8c",
                                "text": "Belangrijker nog is dat het huis helemaal is afgestemd op de muziek. Pianokamer en leefhoek zijn geen vreemden voor elkaar. Ze lopen intiem in elkaar over, en samen vormen ze de kern van de familiale biotoop. De Standaard 29 MAART 2003 OM 00:00 UUR"
                            }
                        ]
                    }
