                "senses": [
                    {
                        "sense_id": "4b3c555c-4ee4-3508-a84a-30865e582d15",
                        "entry_id": "d67f58e4-c161-3bf5-8964-3cc8b60acde3",
                        "glosses": [
                            "страд. прич. прош. вр. от перекрестить"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "484a189c-13af-4b8d-bbb8-ebbbcc207394",
                                "sense_id": "4b3c555c-4ee4-3508-a84a-30865e582d15",
                                "text": "Сапог он не любил и ходил всегда в лаптях; белые онучи, красиво перекрещённые оборами, рельефно обрисовывали икры ног."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a990672-ff78-484a-bb38-7e6ab479a14e",
                        "source_entry_id": "d67f58e4-c161-3bf5-8964-3cc8b60acde3",
                        "source_sense_id": "4b3c555c-4ee4-3508-a84a-30865e582d15",
                        "target_lang_word": "braided",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "braided",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a3426ad5-9f72-3504-a68a-26b093a6e8be",
                                        "entry_id": "3671a75d-33e4-3a3b-80a1-2a204486df0c",
                                        "glosses": [
                                            "simple past and past participle of braid"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bcfc3ee-a2ef-48ac-b71c-8199fd7db29e",
                                                "sense_id": "a3426ad5-9f72-3504-a68a-26b093a6e8be",
                                                "text": "That concertina was a wonder in its way. The handles that was on it first was wore out long ago, and he'd made new ones of braided rope yarn. And the bellows was patched in more places than a cranberry picker's overalls."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "braided",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "775b0989-a9f3-39ef-9ce3-4192cc21a838",
                                        "entry_id": "eba576b9-5d98-3d33-ac5a-f7846fdf80ff",
                                        "glosses": [
                                            "Plaited, woven, entwined."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4e1e14eb-9c77-36c8-8d9c-7b7784341e94",
                                        "entry_id": "eba576b9-5d98-3d33-ac5a-f7846fdf80ff",
                                        "glosses": [
                                            "Divided into several channels."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf88e0c0-00f9-47d9-bd60-c6cb596bfe99",
                                                "sense_id": "4e1e14eb-9c77-36c8-8d9c-7b7784341e94",
                                                "text": "Further upstream, at the gravel mining site near the mouth of Sweetwater Creek, the Arroyo Seco channel is very braided and shallow with some exposed bedrock ledges."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90b171a3-2d46-4941-8ed0-7ed83f7aead3",
                        "source_entry_id": "d67f58e4-c161-3bf5-8964-3cc8b60acde3",
                        "source_sense_id": "4b3c555c-4ee4-3508-a84a-30865e582d15",
                        "target_lang_word": "crisscrossed",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crisscrossed",
                                "target_lang_code": "en",
