                        "examples": [
                            {
                                "example_id": "966717a4-bfbf-4596-bdd9-10821c3940ea",
                                "sense_id": "5beec989-c845-3fe5-ba02-ad960bece79d",
                                "text": "Strażacy wyciągnęli z rzeki samochód marki Toyota."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "e7c2f674-0d6b-3e11-86f9-0215e07d9b86",
                        "entry_id": "dab48fea-cf41-3a9d-b785-72a5cbb06b56",
                        "glosses": [
                            "japońska firma samochodowa"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41a1f999-f562-4441-b148-ba68ce51ed78",
                                "sense_id": "e7c2f674-0d6b-3e11-86f9-0215e07d9b86",
                                "text": "Japoński koncern samochodowy Toyota zamierza wprowadzić na rynek kilka tysięcy wyprodukowanych przez siebie samochodów, które będą w stanie porozumiewać się ze sobą"
                            },
                            {
                                "example_id": "e4523abf-eb9f-464e-97fd-b31b90f081fc",
                                "sense_id": "e7c2f674-0d6b-3e11-86f9-0215e07d9b86",
                                "text": "W kilku zakładach przemysłowych, m.in. Hondy, Toyoty i Nissana, przerwano lub ograniczono produkcję"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
