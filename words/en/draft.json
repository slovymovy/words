                                "target_lang_word": "призыв",
                                "target_lang_sense_clarification": "на военную службу"
                            },
                            {
                                "target_lang_word": "набор",
                                "target_lang_sense_clarification": "в армию"
                            },
                            {
                                "target_lang_word": "контрибуция",
                                "target_lang_sense_clarification": "воинская повинность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e02726d-84a5-3025-bad8-104a5db7dc4b",
                    "sense_definition": "Beer or other drinks served from a large container like a keg or cask rather than from a bottle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "beverages",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pub has a great selection of local <w>draft</w> beers on tap.",
                            "target_lang_translations": {
                                "ru": "В пабе отличный выбор местного <w>разливного</w> пива."
                            }
                        },
                        {
                            "text": "I usually prefer <w>draft</w> cider because it tastes fresher than the bottled version.",
                            "target_lang_translations": {
                                "ru": "Я обычно предпочитаю <w>разливной</w> сидр, потому что он на вкус свежее бутылочного."
                            }
                        }
                    ],
                    "antonyms": [
