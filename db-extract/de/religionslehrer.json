                "senses": [
                    {
                        "sense_id": "c56fa74a-7617-3578-9ab9-fbefd0eb7071",
                        "entry_id": "8eb240bb-4adf-3c51-a112-6619c63252d2",
                        "glosses": [
                            "jemand, der in einer Schule Religion unterrichtet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29136d77-4bd4-4994-8570-8296986e7e31",
                                "sense_id": "c56fa74a-7617-3578-9ab9-fbefd0eb7071",
                                "text": "„Der Religionslehrer lispelte.“"
                            },
                            {
                                "example_id": "bb66676f-8c10-43ff-9ed7-f755f0df26bb",
                                "sense_id": "c56fa74a-7617-3578-9ab9-fbefd0eb7071",
                                "text": "„Der sadistische Religionslehrer und der Vikar, der in der Schule unterrichtete, packten die Kinder gerne grob am Kinn und zogen ihnen die Ohren lang, bis Blut kam.“"
                            },
                            {
                                "example_id": "46a7bbcf-1fac-42ac-af3c-f5e49e08447e",
                                "sense_id": "c56fa74a-7617-3578-9ab9-fbefd0eb7071",
                                "text": "„Petrus wollte erst nicht, aber der Religionslehrer hatte uns erklärt, dass es gut sei, sich von Jesus die Füße waschen zu lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
