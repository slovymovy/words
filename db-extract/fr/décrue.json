                "senses": [
                    {
                        "sense_id": "1ba305e1-a39e-30d0-ba94-40205cbccdbe",
                        "entry_id": "92b228f6-9f77-38d9-8ceb-d4a3f544f3c2",
                        "glosses": [
                            "Baisse du niveau d'eau d'un cours d’eau qui était en crue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5043dd7a-2a08-4b01-8786-febfd083af7d",
                                "sense_id": "1ba305e1-a39e-30d0-ba94-40205cbccdbe",
                                "text": "La Loire entame sa décrue."
                            },
                            {
                                "example_id": "c865d596-0f92-42ef-a633-ec11395a15a3",
                                "sense_id": "1ba305e1-a39e-30d0-ba94-40205cbccdbe",
                                "text": "Lors de la décrue, la majorité des poissons qui ont grandi dans la plaine d’inondation regagnent le lit du fleuve ou d’autres milieux pérennes (lacs, bras morts) où ils se répartissent."
                            }
                        ]
                    },
                    {
                        "sense_id": "a90f7ff3-827c-3083-bd93-6caa569919a0",
                        "entry_id": "92b228f6-9f77-38d9-8ceb-d4a3f544f3c2",
                        "glosses": [
                            "Quantité dont un fleuve, une rivière a décru."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "8c9ce106-459c-405b-80b2-3f081d2377aa",
                                "sense_id": "a90f7ff3-827c-3083-bd93-6caa569919a0",
                                "text": "La décrue est de cinquante centimètres."
                            }
                        ]
                    }
                ],
