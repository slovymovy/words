                                "target_senses": [
                                    {
                                        "sense_id": "c10c86c6-b65a-3eaa-a3ad-c82fd7d16ae0",
                                        "entry_id": "e5edd5ad-0497-3017-8a2c-d52c84ec0c88",
                                        "glosses": [
                                            "Person, die beruflich Kraftfahrzeuge repariert und wartet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0073be83-5c1c-44ac-ae6c-d6d965ba2e5c",
                                                "sense_id": "c10c86c6-b65a-3eaa-a3ad-c82fd7d16ae0",
                                                "text": "Mein Vater ist Automechaniker und hat eine eigene Werkstatt."
                                            },
                                            {
                                                "example_id": "d12fafa6-6238-40f1-aef4-2b37f2e09385",
                                                "sense_id": "c10c86c6-b65a-3eaa-a3ad-c82fd7d16ae0",
                                                "text": "„Automechaniker sagen dir die Wahrheit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b5373385-fa82-4250-b173-3fd9cf7ad7a5",
