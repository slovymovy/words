                    {
                        "sense_id": "a5b75da3-d71b-3b04-8d01-8f6e96a73432",
                        "entry_id": "96e12f07-83ae-3ba2-9c0c-b98266390068",
                        "glosses": [
                            "\\\"Isn't that so?\\\" (used in representations of Maori English)."
                        ],
                        "tags": [
                            "New-Zealand",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "3f5445fa-186d-4892-9d79-4b0e6eacfb04",
                                "sense_id": "a5b75da3-d71b-3b04-8d01-8f6e96a73432",
                                "text": "Then, he had only chuckled again and said, “Well, we got him on the way, ne?”"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "99ac32bd-38cc-359b-af0a-9baa2c960e57",
