                "senses": [
                    {
                        "sense_id": "fd25083c-80f2-33f8-b790-8c3d51aad12d",
                        "entry_id": "facdec49-3dde-3f35-a575-adfa1eb4914b",
                        "glosses": [
                            "Merkmal (Symptom), das ein Patient zeigt, das für eine bestimmte Krankheit typisch ist und somit bei der Diagnose der vorliegenden Erkrankung hilft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "704dd680-be85-4ec1-91b5-c9b00878f081",
                                "sense_id": "fd25083c-80f2-33f8-b790-8c3d51aad12d",
                                "text": "„Der Arzt/die Ärztin fragt nach den Beschwerden – länger anhaltender Husten ist das Leitsymptom – aber auch danach, ob der Patient/die Patientin Kontakt mit Erkrankten hatte.“"
                            },
                            {
                                "example_id": "41ddcaff-ecef-4725-aa04-c18cd070b6e4",
                                "sense_id": "fd25083c-80f2-33f8-b790-8c3d51aad12d",
                                "text": "Die Leitsymptome, nach denen im Gespräch mit dem Arzt gefragt wird, sind in der ICD-10 für Schizophrenie festgelegt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
