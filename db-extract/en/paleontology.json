                                                "sense_id": "754d1b37-ca9a-36c9-b1cd-79cb67e380cd",
                                                "text": "Hij studeert paleontologie in Groningen."
                                            },
                                            {
                                                "example_id": "1fdd99c1-14c8-4155-8b21-6e8a0d6edd62",
                                                "sense_id": "754d1b37-ca9a-36c9-b1cd-79cb67e380cd",
                                                "text": "Ook het afgeven op schedelmeters is een misser. Die zijn onmisbaar bij de paleontologie en de forensische antropologie."
                                            }
