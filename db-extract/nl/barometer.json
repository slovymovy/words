                "senses": [
                    {
                        "sense_id": "f0954d66-11cb-3f9f-ace9-feb1744e0961",
                        "entry_id": "c5517319-b27c-3877-a33a-4e7da9ae9e86",
                        "glosses": [
                            "een instrument dat de luchtdruk meet, weerglas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19d0a3e5-4c82-4bdb-8297-6717297fd7e2",
                                "sense_id": "f0954d66-11cb-3f9f-ace9-feb1744e0961",
                                "text": "De barometer is een uitvinding van Torricelli."
                            }
                        ]
                    },
                    {
                        "sense_id": "2025df48-e501-344c-b700-bc595b44f199",
                        "entry_id": "c5517319-b27c-3877-a33a-4e7da9ae9e86",
                        "glosses": [
                            "instrument of getal dat de stemming aangeeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c2c06c7-2451-415a-8757-64daa2f2423c",
                                "sense_id": "2025df48-e501-344c-b700-bc595b44f199",
                                "text": "De beursbarometer geeft aan hoe de stemming op de beurs is."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1b0d9e64-0035-4299-b5d0-f5179419880a",
                        "source_entry_id": "c5517319-b27c-3877-a33a-4e7da9ae9e86",
                        "source_sense_id": "f0954d66-11cb-3f9f-ace9-feb1744e0961",
                        "source_sense_description": "een instrument dat de luchtdruk meet",
                        "target_lang_word": "Barometer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Barometer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1489da89-bcf0-3ec9-850f-5b48782084b8",
                                        "entry_id": "70d41c4d-bb98-3183-a277-a5038f19b2bc",
                                        "glosses": [
                                            "Messgerät zur Bestimmung des Luftdrucks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc827bbc-9da1-4df0-864c-38fd3248fdae",
                                                "sense_id": "1489da89-bcf0-3ec9-850f-5b48782084b8",
                                                "text": "Das Barometer gibt wesentliche Auskünfte über den Luftdruck und somit das Wetter."
                                            },
                                            {
                                                "example_id": "3f1f8c88-fdb6-4d3c-a8a1-33c2db314d89",
                                                "sense_id": "1489da89-bcf0-3ec9-850f-5b48782084b8",
                                                "text": "„Humboldt maß die Inklination der Magnetnadel und bestimmte ihre Höhe mit dem Barometer.“"
                                            },
                                            {
                                                "example_id": "299da53a-88ae-4b8d-bc51-23167a72962b",
                                                "sense_id": "1489da89-bcf0-3ec9-850f-5b48782084b8",
                                                "text": "„Er knipste ihn ein paarmal an und aus, beklopfte ihn wie ein Barometer und rüttelte auch ein wenig an ihm herum.“"
                                            },
                                            {
                                                "example_id": "bbacab09-29b1-4c42-b6dd-0921e3228dc2",
                                                "sense_id": "1489da89-bcf0-3ec9-850f-5b48782084b8",
                                                "text": "„Kaum jemand dürfte wohl jenen katastrophalen Nordoststurm vergessen haben, der um die Tagundnachtgleiche herum losbrach und das Barometer auf 710 mm hinunterdrückte.“"
                                            },
                                            {
                                                "example_id": "1e532f72-b857-49d8-af45-b9ea9a44aa93",
                                                "sense_id": "1489da89-bcf0-3ec9-850f-5b48782084b8",
                                                "text": "„Das Barometer täuschte sie, aus dem Thermometer war nichts zu ersehen; und so nahmen sie ihre Zuflucht zu dem Auskunftsmittel, das unter Ludwig XV. ein Priester in der Touraine erfunden hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3cbe7482-ea60-405f-bf95-b0ed380ca8bb",
                        "source_entry_id": "c5517319-b27c-3877-a33a-4e7da9ae9e86",
                        "source_sense_id": "f0954d66-11cb-3f9f-ace9-feb1744e0961",
                        "source_sense_description": "een instrument dat de luchtdruk meet",
                        "target_lang_word": "barometer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "barometer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cec19b57-ebe4-305e-95db-faeb543cd3ad",
                                        "entry_id": "3bbfa6d0-bf1c-3b3a-909a-d7ba6744f03f",
                                        "glosses": [
                                            "An instrument for measuring atmospheric pressure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f32da9a-88f6-4b3f-af1f-e15aa6e57452",
                                                "sense_id": "cec19b57-ebe4-305e-95db-faeb543cd3ad",
                                                "text": "Elsewhere, professionals could enthuse over new precision instruments capable, for instance, of measuring weights down to a tenth of a milligram, or over a host of self-registering thermometers and barometers, microscopes, typewriters, calculators and all sorts of technical and musical devices, including automatic concertinas, edeophones, auto-harps, bigophones and other long-forgotten objects."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60c38039-45c7-30bd-8360-ddd40906100c",
                                        "entry_id": "3bbfa6d0-bf1c-3b3a-909a-d7ba6744f03f",
                                        "glosses": [
                                            "Anything used as a gauge or indicator."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "030a301a-44ad-414b-825b-1010507d47ca",
                                                "sense_id": "60c38039-45c7-30bd-8360-ddd40906100c",
                                                "text": "\"An election is not necessarily an accurate barometer of public opinion. There are other ways in which it makes itself felt, through the press, the forum, discussion, and through every other type of communication.\""
                                            },
                                            {
                                                "example_id": "acb024d3-7609-40f6-9dda-b064cc7fa9ce",
                                                "sense_id": "60c38039-45c7-30bd-8360-ddd40906100c",
                                                "text": "The weakest members of society become social barometers or canaries in a coal mine."
                                            },
                                            {
                                                "example_id": "102de644-a11a-44ed-b064-96fa8959799b",
                                                "sense_id": "60c38039-45c7-30bd-8360-ddd40906100c",
                                                "text": "Italy’s 10-year yield spread versus Germany, considered a barometer of political and economic risks in the euro area, climbed as high as 1.9 percentage points on Tuesday, its widest since the early stages of the pandemic when investors dumped riskier eurozone government debt."
                                            },
                                            {
                                                "example_id": "b6633c87-4705-48b9-9ab2-475748bc69d7",
                                                "sense_id": "60c38039-45c7-30bd-8360-ddd40906100c",
                                                "text": "Elections in six Malaysian states on Saturday will serve as a barometer of public sentiment for Prime Minister Anwar Ibrahim’s unity government against a powerful opposition consisting of Malay-Muslim political parties."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c5e2055-8a31-4217-abf5-40cbf3fb2911",
                        "source_entry_id": "c5517319-b27c-3877-a33a-4e7da9ae9e86",
                        "source_sense_id": "f0954d66-11cb-3f9f-ace9-feb1744e0961",
                        "source_sense_description": "een instrument dat de luchtdruk meet",
                        "target_lang_word": "baromètre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baromètre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "acc5648b-000f-3ebf-b31e-e01bf6de7ad4",
                                        "entry_id": "87edb0a1-2f52-34a8-9114-63fcf5a57e82",
                                        "glosses": [
                                            "Instrument qui mesure la pression de l’atmosphère et dont les indications ont des rapports plus ou moins marqués avec les changements de temps."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba043d7c-7f27-4cd0-9ca3-076ac3578f3e",
                                                "sense_id": "acc5648b-000f-3ebf-b31e-e01bf6de7ad4",
                                                "text": "On nomme baromètres des instruments propres à mesurer la pression atmosphérique. Dans les baromètres ordinaires, cette pression est mesurée par la hauteur d'une colonne de mercure dans un tube de verre, comme dans l'expérience de Torricelli."
                                            },
                                            {
                                                "example_id": "58ce5f91-4fa4-43b0-a997-82797e3044db",
                                                "sense_id": "acc5648b-000f-3ebf-b31e-e01bf6de7ad4",
                                                "text": "Le vent du nord couvrait le pays de son souffle glacé. Le baromètre restait au « beau sec », et, de ce sol qui ne formait plus qu’un immense icefield, aucune vapeur ne se dégageait."
                                            },
                                            {
                                                "example_id": "d70d09c0-e0cb-401f-81a2-b6f45d2526ac",
                                                "sense_id": "acc5648b-000f-3ebf-b31e-e01bf6de7ad4",
                                                "text": "À ce moment mes yeux tombèrent sur le baromètre enregistreur qui marquait une chute subite de 1 mm. 8."
                                            },
                                            {
                                                "example_id": "c2c66fc2-c81e-4473-9a5e-bb792a77f23e",
                                                "sense_id": "acc5648b-000f-3ebf-b31e-e01bf6de7ad4",
                                                "text": "Le baromètre a baissé terriblement pendant la nuit et la matinée. Je m’attends à du gros temps."
                                            },
                                            {
                                                "example_id": "4dd7f5da-7538-4784-a73c-ea614ef1d682",
                                                "sense_id": "acc5648b-000f-3ebf-b31e-e01bf6de7ad4",
                                                "text": "Il y avait deux grands lits de bois, majestueux comme des navires, et entre bien d’autres choses, un monumental baromètre à mercure. Les déménageurs l’avaient couché, pour le transport. Une grosse perle liquide était tombée sur le parquet. Quand nous voulûmes la saisir, elle s’enfuit comme une bête vivante."
                                            },
                                            {
                                                "example_id": "51322ff8-e00d-4f8d-a6e0-e4e1208c8fb7",
                                                "sense_id": "acc5648b-000f-3ebf-b31e-e01bf6de7ad4",
                                                "text": "— Papa prend des airs renseignés et distants de baromètre suisse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4be81d5-8fa3-34ad-9ecb-f29fca6b01a4",
                                        "entry_id": "87edb0a1-2f52-34a8-9114-63fcf5a57e82",
                                        "glosses": [
                                            "Indicateur qui permet de mesurer une tendance."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "023087fe-24ee-4f46-b4d6-1eb010c659a6",
                                                "sense_id": "c4be81d5-8fa3-34ad-9ecb-f29fca6b01a4",
                                                "text": "Nos passions sont-elles bien sincères ? qui peut savoir sûrement ce qu’il veut et connaître au juste le baromètre de son cœur ?"
                                            },
                                            {
                                                "example_id": "dff9521f-c30b-4a7a-969a-cd791121ae42",
                                                "sense_id": "c4be81d5-8fa3-34ad-9ecb-f29fca6b01a4",
                                                "text": "Les manuscrits que reçoivent les éditeurs sont un excellent baromètre de l’état de la société."
                                            },
                                            {
                                                "example_id": "c91bf8f3-4e70-4bc2-8db7-bf665f8c124f",
                                                "sense_id": "c4be81d5-8fa3-34ad-9ecb-f29fca6b01a4",
                                                "text": "baromètre politique : sondage indiquant l’état de l’opinion sur la même question, effectué à intervalles réguliers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "855c4c65-2fc2-3f5f-91bc-d2d61fc248c3",
                                        "entry_id": "87edb0a1-2f52-34a8-9114-63fcf5a57e82",
                                        "glosses": [
                                            "Insigne officiel des députés et des sénateurs en France."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5dcf37a-092a-4a33-870f-fec37f853a19",
                                                "sense_id": "855c4c65-2fc2-3f5f-91bc-d2d61fc248c3",
                                                "text": "La tourbe des parlementaires se distinguait par cet insigne qu’ils appellent plaisamment leur « baromètre » et par leurs écharpes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b38aa229-ac87-32e3-8d0e-ca353688c3d3",
                                        "entry_id": "87edb0a1-2f52-34a8-9114-63fcf5a57e82",
                                        "glosses": [
                                            "Carline à feuilles d’acanthe."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d075196-6b95-4e4f-9cd8-840519f95e0e",
