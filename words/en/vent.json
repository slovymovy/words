{
    "word_family": [
        "ventilation",
        "ventilator",
        "venting",
        "unvented",
        "ventless"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "75309151-a58b-3243-935c-5c6914be8f30",
                    "sense_definition": "To express a strong emotion, especially anger or frustration, in order to feel better.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a long day at work, I really need to <w>vent</w> to someone who understands.",
                            "target_lang_translations": {
                                "ru": "После долгого рабочего дня мне очень нужно <w>выговориться</w> кому-то, кто меня поймет."
                            }
                        },
                        {
                            "text": "He <w>vents</w> his anger by shouting at the television whenever the news is on.",
                            "target_lang_translations": {
                                "ru": "Он <w>изливает</w> свой гнев, крича на телевизор каждый раз, когда идут новости."
                            }
                        }
                    ],
                    "antonyms": [
                        "suppress",
                        "bottle up"
                    ],
                    "common_phrases": [
                        "need to vent",
                        "vent one's anger",
                        "vent one's frustration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражать сильные эмоции, особенно гнев или разочарование, чтобы почувствовать облегчение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изливать",
                                "target_lang_sense_clarification": "чувства или душу"
                            },
                            {
                                "target_lang_word": "выпускать пар",
                                "target_lang_sense_clarification": "идиома: давать выход эмоциям"
                            },
                            {
                                "target_lang_word": "выговориться",
                                "target_lang_sense_clarification": "рассказать о наболевшем"
                            },
                            {
                                "target_lang_word": "вымещать",
                                "target_lang_sense_clarification": "гнев на ком-то"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "354001c4-4f83-30df-bfb0-0c792e374192",
                    "sense_definition": "To allow gases, smoke, or air to escape from a confined space.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "airflow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The kitchen stove <w>vents</w> to the outside to keep the air clean while cooking.",
                            "target_lang_translations": {
                                "ru": "Кухонная плита <w>вентилируется</w> наружу, чтобы воздух оставался чистым во время готовки."
                            }
                        },
                        {
                            "text": "Make sure the heating system <w>vents</w> properly to avoid any carbon monoxide buildup.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что отопительная система <w>отводит газы</w> должным образом, чтобы избежать скопления угарного газа."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vent to the outside"
                    ],
                    "target_lang_definitions": {
                        "ru": "Позволять газам, дыму или воздуху выходить из замкнутого пространства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вентилировать",
                                "target_lang_sense_clarification": "обеспечивать приток воздуха"
                            },
                            {
                                "target_lang_word": "выпускать",
                                "target_lang_sense_clarification": "газ или пар"
                            },
                            {
                                "target_lang_word": "отводить",
                                "target_lang_sense_clarification": "газы наружу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96ccadc7-4e26-3931-8419-403d85853328",
                    "sense_definition": "To release something, such as exhaust or steam, through an opening.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "airflow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory <w>vented</w> steam into the atmosphere throughout the afternoon.",
                            "target_lang_translations": {
                                "ru": "Завод <w>выпускал</w> пар в атмосферу в течение всего дня."
                            }
                        },
                        {
                            "text": "Toxic fumes must be <w>vented</w> safely away from the residential area.",
                            "target_lang_translations": {
                                "ru": "Токсичные пары должны <w>отводиться</w> безопасным способом вдали от жилых районов."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vented into the air"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выбрасывать что-либо, например выхлопные газы или пар, через отверстие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выбрасывать",
                                "target_lang_sense_clarification": "в атмосферу"
                            },
                            {
                                "target_lang_word": "выпускать",
                                "target_lang_sense_clarification": "через клапан или отверстие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed975fe9-40bc-35d7-bfe8-43a74423d8d5",
                    "sense_definition": "To use a ventilation shaft to move quickly or hide, specifically in the context of the video game Among Us.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "gaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I saw the red player <w>vent</w> in the cafeteria, so they must be the impostor.",
                            "target_lang_translations": {
                                "ru": "Я видел, как красный игрок <w>прыгнул в люк</w> в столовой, так что он точно предатель."
                            }
                        },
                        {
                            "text": "When you are playing as the impostor, you can <w>vent</w> to escape the room quickly.",
                            "target_lang_translations": {
                                "ru": "Когда ты играешь за предателя, ты можешь <w>использовать вентиляцию</w>, чтобы быстро покинуть комнату."
                            }
                        }
                    ],
                    "common_phrases": [
                        "saw someone vent"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "gaming context"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "internet culture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Использовать вентиляционную шахту для быстрого перемещения или маскировки (в контексте игры Among Us)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прыгнуть в люк",
                                "target_lang_sense_clarification": "игровой сленг"
                            },
                            {
                                "target_lang_word": "вентить",
                                "target_lang_sense_clarification": "сленг игроков"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47a19007-a37d-35b1-a76b-fdf79cf08595",
                    "sense_definition": "To sell or <w>vend</w> goods.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old marketplace, merchants would <w>vent</w> their wares to passing travelers.",
                            "target_lang_translations": {
                                "ru": "На старом рынке купцы <w>сбывали</w> свои товары проезжим путешественникам."
                            }
                        },
                        {
                            "text": "The company sought new territories where they could <w>vent</w> their surplus stock.",
                            "target_lang_translations": {
                                "ru": "Компания искала новые территории, где она могла бы <w>распродать</w> излишки запасов."
                            }
                        }
                    ],
                    "synonyms": [],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Продавать или сбывать товары (архаизм)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сбывать",
                                "target_lang_sense_clarification": "товар"
                            },
                            {
                                "target_lang_word": "торговать",
                                "target_lang_sense_clarification": "распродавать"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "17a8cf7d-e5be-3ac9-a77b-052174e7a5df",
                    "sense_definition": "An opening that allows air, gas, or liquid to pass out of or into a confined space.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "opening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The air <w>vent</w> in the bathroom was clogged with dust and needed cleaning.",
                            "target_lang_translations": {
                                "ru": "Вентиляционное <w>отверстие</w> в ванной забилось пылью и нуждалось в чистке."
                            }
                        },
                        {
                            "text": "He opened the <w>vent</w> on the side of the machine to let the heat escape.",
                            "target_lang_translations": {
                                "ru": "Он открыл <w>отдушину</w> сбоку машины, чтобы выпустить жар."
                            }
                        }
                    ],
                    "common_phrases": [
                        "air vent",
                        "dryer vent",
                        "heating vent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отверстие, позволяющее воздуху, газу или жидкости выходить или входить в замкнутое пространство."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вентиляционное отверстие",
                                "target_lang_sense_clarification": "техническое"
                            },
                            {
                                "target_lang_word": "отдушина",
                                "target_lang_sense_clarification": "для выхода воздуха"
                            },
                            {
                                "target_lang_word": "вытяжка",
                                "target_lang_sense_clarification": "кухонная или промышленная"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88ed6d17-1802-393c-8c8e-10d75ff64dfd",
                    "sense_definition": "A shortened form of <w>ventilation</w> or <w>ventilator</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "airflow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have adjusted the <w>vent</w> settings on the dashboard to get more cool air.",
                            "target_lang_translations": {
                                "ru": "Я отрегулировал настройки <w>дефлекторов</w> на приборной панели, чтобы поступало больше прохладного воздуха."
                            }
                        },
                        {
                            "text": "The technician checked the <w>vent</w> to ensure the building had proper airflow.",
                            "target_lang_translations": {
                                "ru": "Техник проверил <w>вентиляцию</w>, чтобы убедиться в правильной циркуляции воздуха в здании."
                            }
                        }
                    ],
                    "common_phrases": [
                        "vent settings"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "clipping"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращенная форма слов «вентиляция» или «вентилятор»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вентиляция",
                                "target_lang_sense_clarification": "система"
                            },
                            {
                                "target_lang_word": "дефлектор",
                                "target_lang_sense_clarification": "в автомобиле"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52f93a54-0570-3037-a049-93a740ef2909",
                    "sense_definition": "A vertical slit in the seam of a garment, such as a jacket or skirt, to allow for movement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This suit jacket features a double <w>vent</w> at the back for a more comfortable fit.",
                            "target_lang_translations": {
                                "ru": "У этого пиджака сзади двойная <w>шлица</w> для более удобной посадки."
                            }
                        },
                        {
                            "text": "The skirt has a small <w>vent</w> in the back to make walking easier.",
                            "target_lang_translations": {
                                "ru": "На юбке сзади есть небольшой <w>разрез</w>, чтобы было удобнее ходить."
                            }
                        }
                    ],
                    "common_phrases": [
                        "side vent",
                        "double vent",
                        "back vent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вертикальный разрез в шве одежды, например пиджака или юбки, для удобства движения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шлица",
                                "target_lang_sense_clarification": "на пиджаке или юбке"
                            },
                            {
                                "target_lang_word": "разрез",
                                "target_lang_sense_clarification": "на одежде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24b7fded-ac14-34b1-afd3-1848ff88cc9c",
                    "sense_definition": "An opening in the Earth's crust, such as in a volcano, through which molten rock or gases erupt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Deep-sea <w>vents</w> provide heat and minerals to unique ecosystems on the ocean floor.",
                            "target_lang_translations": {
                                "ru": "Глубоководные <w>источники</w> обеспечивают теплом и минералами уникальные экосистемы на дне океана."
                            }
                        },
                        {
                            "text": "The volcanic <w>vent</w> began to glow as the pressure from the magma increased.",
                            "target_lang_translations": {
                                "ru": "Вулканическое <w>жерло</w> начало светиться по мере роста давления магмы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "volcanic vent",
                        "hydrothermal vent"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отверстие в земной коре, например в вулкане, через которое извергаются газы или лава."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жерло",
                                "target_lang_sense_clarification": "вулкана"
                            },
                            {
                                "target_lang_word": "источник",
                                "target_lang_sense_clarification": "гидротермальный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ffad85e-07f2-3a13-b374-4e6769fc8aaa",
                    "sense_definition": "An instance or session of expressing strong verbal frustration or anger.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her social media post was just a long <w>vent</w> about the poor customer service she received.",
                            "target_lang_translations": {
                                "ru": "Ее пост в соцсетях был просто длинным <w>изливанием души</w> по поводу плохого обслуживания клиентов."
                            }
                        },
                        {
                            "text": "I listened to his <w>vent</w> for twenty minutes without interrupting him once.",
                            "target_lang_translations": {
                                "ru": "Я слушал его <w>поток жалоб</w> в течение двадцати минут, ни разу не перебив."
                            }
                        }
                    ],
                    "common_phrases": [
                        "have a vent"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Случай или сеанс выражения сильного вербального разочарования или гнева."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изливание души",
                                "target_lang_sense_clarification": "разговор"
                            },
                            {
                                "target_lang_word": "вспышка гнева",
                                "target_lang_sense_clarification": "эмоциональный выплеск"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18e6bd7d-3523-3d58-bd78-9a3434358ebb",
                    "sense_definition": "The small hole in a firearm through which the charge is ignited.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "weaponry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier cleaned the <w>vent</w> of the cannon to ensure it would fire correctly.",
                            "target_lang_translations": {
                                "ru": "Солдат прочистил <w>запальное отверстие</w> пушки, чтобы она выстрелила правильно."
                            }
                        },
                        {
                            "text": "If the <w>vent</w> is blocked, the gunpowder will not ignite when the trigger is pulled.",
                            "target_lang_translations": {
                                "ru": "Если <w>запал</w> заблокирован, порох не воспламенится при нажатии на курок."
                            }
                        }
                    ],
                    "synonyms": [
                        "touch hole"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое отверстие в огнестрельном оружии, через которое воспламеняется заряд."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запальное отверстие",
                                "target_lang_sense_clarification": "в пушке или ружье"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "134340c0-1bae-3992-9483-f65e22f56f4b",
                    "sense_definition": "A family name of Dutch origin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The <w>Vent</w> family has lived in this region for several generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Вент</w> живет в этом регионе уже несколько поколений."
                            }
                        },
                        {
                            "text": "We are researching the genealogy of a man named Peter <w>Vent</w> from the Netherlands.",
                            "target_lang_translations": {
                                "ru": "Мы изучаем генеалогию человека по имени Питер <w>Вент</w> из Нидерландов."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Dutch origin"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия голландского происхождения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Вент",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}