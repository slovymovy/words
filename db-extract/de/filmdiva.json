                    {
                        "sense_id": "2a2f1212-6b1d-33ae-9cdc-42ab49fe0c9f",
                        "entry_id": "da282868-a16a-3e4f-a4f2-e4593d7ed61f",
                        "glosses": [
                            "durch den Film bekannte Frau, die wegen ihrer außergewöhnlichen schauspielerischen Begabung berühmt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54ebcd95-1aac-4640-a0d5-eff557926e6a",
                                "sense_id": "2a2f1212-6b1d-33ae-9cdc-42ab49fe0c9f",
                                "text": "„Wie eine Filmdiva kommt sie über den Vorplatz geschritten und drückt Ali an sich.“"
                            },
                            {
                                "example_id": "e18e4345-2b5a-4a4b-a313-0e908a5a6688",
                                "sense_id": "2a2f1212-6b1d-33ae-9cdc-42ab49fe0c9f",
                                "text": "„Schlank, von großer Statur und langbeinig hätte sie es mit jeder Filmdiva aufnehmen können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "34d6946c-68ef-394f-9ce6-8ac3ff21a934",
                        "entry_id": "da282868-a16a-3e4f-a4f2-e4593d7ed61f",
                        "glosses": [
                            "durch den Film bekannte Person (meist eine Frau, aber auch Mann), die durch exzentrische Allüren und Launenhaftigkeit auffällt"
                        ],
