    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "94ac6e7f-cd51-356d-8e14-60ec11d22c38",
                "word": "eared",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a5b7c877-5c4f-39d8-a535-0595277035e3",
                        "entry_id": "94ac6e7f-cd51-356d-8e14-60ec11d22c38",
                        "glosses": [
                            "Having ears (of a specified type)."
                        ],
                        "tags": [
                            "in-compounds",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "cee855e5-592f-444d-962a-72ee1499f322",
                                "sense_id": "a5b7c877-5c4f-39d8-a535-0595277035e3",
                                "text": "He was a large-eared man."
                            },
                            {
                                "example_id": "e43f3fb5-6c50-4eb9-b733-4a8892e233aa",
                                "sense_id": "a5b7c877-5c4f-39d8-a535-0595277035e3",
                                "text": "What doſt thou puſh, thou prickeard cur of Iſeland?"
                            },
                            {
                                "example_id": "e4f5cc8b-732a-4acc-8ed3-b77e3f018ce3",
                                "sense_id": "a5b7c877-5c4f-39d8-a535-0595277035e3",
                                "text": "Tho' he despond that sows his grain, / To bind his full-ear'd sheaves, and bring / from long captivity,"
                            },
                            {
                                "example_id": "5703d520-63a2-41a0-b920-ca604bf0e6c4",
                                "sense_id": "a5b7c877-5c4f-39d8-a535-0595277035e3",
                                "text": "1835, William Wordsworth, \"On a High Part of the Coast of Cumberland,\" line 19-20, in The Poetical Works of William Wordsworth, edited by William Knight, Volume VII, London: Macmillan & Co., 1896, http://www.gutenberg.org/files/47143/47143-h/47143-h.htm\nTeach me with quick-eared spirit to rejoice / In admonitions of thy softest voice!"
                            },
                            {
                                "example_id": "2b4e613b-50ab-440d-aeb1-6096b5ef7dae",
                                "sense_id": "a5b7c877-5c4f-39d8-a535-0595277035e3",
                                "text": "Towery city and branchy between towers; / Cuckoo-echoing, bell-swarmèd, lark-charmèd, rook-racked, river-rounded; / The dapple-eared lily below thee; that country and town did / Once encounter in, here coped and poisèd powers; […]"
                            },
                            {
                                "example_id": "7b712245-1169-4937-8cd3-85e33a0aaae5",
                                "sense_id": "a5b7c877-5c4f-39d8-a535-0595277035e3",
                                "text": "He might have flinched altogether from speaking if at this moment he had not seen Ampleforth, the hairy-eared poet, wandering limply round the room with a tray, looking for a place to sit down."
                            },
                            {
                                "example_id": "872fcba8-37d1-4eaa-9513-36f31d709f7b",
                                "sense_id": "a5b7c877-5c4f-39d8-a535-0595277035e3",
                                "text": "1960, Harper Lee, To Kill a Mockingbird, Perennial Classics, 2002, Part Two, Chapter 28, p. 305,\nSome of his rural clients would park their long-eared steeds under the chinaberry trees in the back yard, and Atticus would keep appointments on the back steps."
                            }
                        ]
                    },
                    {
                        "sense_id": "c175ae44-9248-3488-a6a2-1a2cc7bd5d05",
                        "entry_id": "94ac6e7f-cd51-356d-8e14-60ec11d22c38",
                        "glosses": [
                            "Having ears."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "a0c211ca-273f-41dd-a597-c5297acd0709",
                                "sense_id": "c175ae44-9248-3488-a6a2-1a2cc7bd5d05",
                                "text": "But for his other guests he let bear in the massy cups of silver, and the great eared wine jars holding two firkins apiece, and he let pour forth to the Witches and the Foliots, and they drank the cup of memory unto King Gorice XI., slain that day by the hand of Goldry Bluszco."
                            }
                        ]
                    }
