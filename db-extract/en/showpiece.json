                                                "sense_id": "17ca5bcd-c7c3-30b1-b4ce-60276d6a6f10",
                                                "text": "„Um mich vor neuen Unterkühlungen zu schützen, erhalte ich einen blütenweißen Seidenschal, ein Prachtstück seiner Gattung, der früher einmal zu einem Frack gehörte.“"
                                            },
                                            {
                                                "example_id": "f0526aba-580c-4067-8636-0b6e526d5d05",
                                                "sense_id": "17ca5bcd-c7c3-30b1-b4ce-60276d6a6f10",
                                                "text": "„Damit verglichen ist die viel reparierte, renovierte und restaurierte Turmuhr ein Prachtstück historischer Authentizität.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
