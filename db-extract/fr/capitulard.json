                        "entry_id": "81cbf60b-0797-3a41-b5d8-8581d8d995b8",
                        "glosses": [
                            "Celui qui capitule, ou qui est favorable à la capitulation."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "1bb51bda-318c-47ab-a966-3c8348e2a185",
                                "sense_id": "84d60dd3-3f0b-3fb3-a4dc-dab27cba0cfa",
                                "text": "La France ne reconnut pas comme son épée l'épée déshonorée du capitulard de Sedan."
                            },
                            {
                                "example_id": "65dc45f2-c6a6-4496-9076-3f3e6aee6563",
                                "sense_id": "84d60dd3-3f0b-3fb3-a4dc-dab27cba0cfa",
                                "text": "Du nord au sud de la France et de l’est à l’ouest, on haïssait le capitulard de Sedan."
                            }
                        ]
                    }
