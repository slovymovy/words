                "senses": [
                    {
                        "sense_id": "e6a779ce-860c-3b56-938e-6433ea64a385",
                        "entry_id": "51b6473f-0dc3-3f04-aa40-08bb2f134c32",
                        "glosses": [
                            "afhankelijk zijn van hulp, onvoldoende zichzelf kunnen helpen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0833e594-e232-49c2-85f1-9991d82a084a",
                                "sense_id": "e6a779ce-860c-3b56-938e-6433ea64a385",
                                "text": "De vraagstukken zijn minder heftig dan bij de professionele hulpbehoevenden. Niet: hoe zorg ik ervoor dat ik niet binnen drie weken failliet ben omdat klanten wegblijven? Vinden ze mijn in de magnetron opgewarmde specialiteit bloemkool met Zwitserse chocoladesaus soms niet lekker? Wel: hoe weet ik het als mijn blauwe schimmelkaas niet meer goed is?"
                            },
                            {
                                "example_id": "04610c33-09ae-4dda-99ba-b28a9ae86cff",
                                "sense_id": "e6a779ce-860c-3b56-938e-6433ea64a385",
                                "text": "Hoogleraar Jos Schols vindt dat zorgsector en politiek een belangrijke morele vraag moeten beantwoorden: „Hoe lang kun je kwetsbare en hulpbehoevende ouderen echt veilig thuis laten wonen en verzorgen?”"
                            }
                        ]
                    }
