                        "examples": [
                            {
                                "example_id": "f1d48a8d-de17-4db9-b3a2-2dd27e2938e3",
                                "sense_id": "92c2480a-a51d-3eef-bef5-37b9853c5378",
                                "text": "Die Polizei versuchte die Identität des Mordopfers festzustellen."
                            },
                            {
                                "example_id": "12a0d424-2e14-40f7-918b-cce8cf684e67",
                                "sense_id": "92c2480a-a51d-3eef-bef5-37b9853c5378",
                                "text": "„Eher beiläufig kam sie dann auf das Mordopfer zu sprechen.“"
                            },
                            {
                                "example_id": "b87e469b-738b-403a-a92a-b8cb247d4d06",
                                "sense_id": "92c2480a-a51d-3eef-bef5-37b9853c5378",
                                "text": "„Für gewöhnlich waren Mordopfer in Island keine zweifachen Mütter Mitte dreißig.“"
                            }
                        ],
