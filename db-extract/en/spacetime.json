                "word": "spacetime",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "681037d8-bc57-4ae8-865a-91eb30e0af62",
                        "entry_id": "78db9c86-f4a2-3bfb-946b-29691be826c5",
                        "tags": [
                            "plural"
                        ],
                        "form": "spacetimes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "16e69b8b-56e5-3e3b-af6c-6d41d8a16a83",
                        "entry_id": "78db9c86-f4a2-3bfb-946b-29691be826c5",
                        "glosses": [
                            "The four-dimensional continuum of the three spatial dimensions plus time."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7efebab4-cbec-449e-b404-1922421a8c42",
                                "sense_id": "16e69b8b-56e5-3e3b-af6c-6d41d8a16a83",
                                "text": "An event is a point in spacetime, specified by the coordinates x, y, z, and t."
                            }
                        ]
                    },
                    {
                        "sense_id": "efa421e4-a776-3251-a3cd-c8bb81b1d013",
                        "entry_id": "78db9c86-f4a2-3bfb-946b-29691be826c5",
                        "glosses": [
                            "An n-dimensional continuum consisting of dimensions of both space and time. Normally spacetime is considered as having 4 dimensions (x, y, z, t), but higher-dimensional spacetimes are often encountered in theoretical physics, e.g. the 5-dimensional spacetime of Kaluza-Klein theory or the 11 dimensions of spacetime in M-theory."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "449834e5-d90b-4dec-9dd6-f49bbd03ff84",
                                "sense_id": "efa421e4-a776-3251-a3cd-c8bb81b1d013",
                                "text": "a Minkowski spacetime"
                            },
                            {
                                "example_id": "19c21672-6a07-494e-9bc9-46f5323605ce",
                                "sense_id": "efa421e4-a776-3251-a3cd-c8bb81b1d013",
                                "text": "a 5-dimensional spacetime"
                            }
                        ]
                    },
                    {
                        "sense_id": "f3e1a226-deda-30cf-af7c-be6646b5986e",
                        "entry_id": "78db9c86-f4a2-3bfb-946b-29691be826c5",
                        "glosses": [
                            "A specific region of the universe with mathematically different properties than the surrounding spacetime. Synonymous with \\\"metric\\\" within the context of general relativity."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "9ddca0af-1816-4592-b5a0-c9f59a4baa9c",
                                "sense_id": "f3e1a226-deda-30cf-af7c-be6646b5986e",
                                "text": "a Schwarzschild spacetime"
                            },
                            {
                                "example_id": "23689b37-c434-4c81-8e00-92b84bbf842f",
                                "sense_id": "f3e1a226-deda-30cf-af7c-be6646b5986e",
                                "text": "a Reissner-Nordström spacetime"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
