                    "frequency": "Middle",
                    "semantic_group_id": "apprentissage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle participe à un stage d'<w>initiation</w> à la poterie pendant ses vacances."
                        },
                        {
                            "text": "Ce livre propose une excellente <w>initiation</w> à la programmation pour les débutants."
                        }
                    ],
                    "synonyms": [
