                "senses": [
                    {
                        "sense_id": "795d5d85-6cb5-33c3-9e1e-d331153c1620",
                        "entry_id": "41b1c199-b732-3d5b-991d-caaaba6912d2",
                        "glosses": [
                            "Person, die höfische Liebeslyrik (Minnesang) verfasst/vorträgt"
                        ],
                        "tags": [
                            "historisch im Mittelalter"
                        ],
                        "examples": [
                            {
                                "example_id": "da61763f-a310-4097-8315-313934fa88f5",
                                "sense_id": "795d5d85-6cb5-33c3-9e1e-d331153c1620",
                                "text": "„Die Sprachkunst der höfischen Epiker und Minnesänger hörte nicht schlagartig auf, sondern lief langsam aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b35f41f6-9d7b-463d-a484-d4012959ed80",
                        "source_entry_id": "41b1c199-b732-3d5b-991d-caaaba6912d2",
                        "source_sense_id": "795d5d85-6cb5-33c3-9e1e-d331153c1620",
                        "source_sense_description": "historisch im Mittelalter: Person, die höfische Liebeslyrik (Minnesang) verfasst/vorträgt",
                        "target_lang_word": "minnesinger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "minnesinger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5fa5200-8382-388f-ae2c-15bcfe92b7ee",
                                        "entry_id": "9d35975f-b11c-305a-b995-d9b79b01c886",
                                        "glosses": [
                                            "A peripatetic musician in Germany in the 12th to the 14th centuries, often performing songs of courtly love."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67ce983b-5aed-4fd5-8e4e-b549b2151f8f",
                        "source_entry_id": "41b1c199-b732-3d5b-991d-caaaba6912d2",
                        "source_sense_id": "795d5d85-6cb5-33c3-9e1e-d331153c1620",
                        "source_sense_description": "historisch im Mittelalter: Person, die höfische Liebeslyrik (Minnesang) verfasst/vorträgt",
                        "target_lang_word": "ménestrel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ménestrel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ec1bbc8e-538e-3435-a0ea-5a7b7c3a6dd7",
                                        "entry_id": "047b1d63-48f4-31b2-8399-ca031f0a5620",
                                        "glosses": [
                                            "Poète et musicien qui allait, au Moyen Âge, de châteaux en châteaux, chantant des vers composés par lui ou par d’autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "928fab0b-20be-4e14-b9c5-406dbdd6d65d",
                                                "sense_id": "ec1bbc8e-538e-3435-a0ea-5a7b7c3a6dd7",
                                                "text": "Prieur Aymer, dit le templier, vous êtes un homme galant, docte dans l’étude de la beauté, et aussi expert qu’un ménestrel dans toutes les affaires qui concernent les arrêts d’amour."
                                            },
                                            {
                                                "example_id": "e8ab3924-3e40-43d4-af93-0ba3e73becba",
                                                "sense_id": "ec1bbc8e-538e-3435-a0ea-5a7b7c3a6dd7",
                                                "text": "Pourquoi restaurer les histoires vermoulues et poudreuses du moyen-âge, lorsque la chevalerie s’en est allée pour toujours, accompagnée des concerts de ses ménestrels, des enchantements de ses fées et de la gloire de ses preux ?"
                                            },
                                            {
                                                "example_id": "9fde62b2-07df-4ce2-ac48-6738efda2a6d",
                                                "sense_id": "ec1bbc8e-538e-3435-a0ea-5a7b7c3a6dd7",
                                                "text": "Avec Walter Scott, plus tard, elle s’éprit de choses historiques, rêva bahuts, salle des gardes et ménestrels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40f33666-a9ad-316b-8db0-772134dbc4ba",
                                        "entry_id": "047b1d63-48f4-31b2-8399-ca031f0a5620",
                                        "glosses": [
                                            "Poète, chanteur."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73d38214-1f21-40df-b839-da6a1ed1468d",
                                                "sense_id": "40f33666-a9ad-316b-8db0-772134dbc4ba",
                                                "text": "…quelque chevaleresque que soit le poète français ; à Paris, vous pourriez rencontrer plus d’un ménestrel dégénéré, prêt à cultiver votre affection pour la tromper."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
