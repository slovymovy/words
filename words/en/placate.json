    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0ce2bfdd-6d20-36da-bb37-ce75f80dd08f",
                    "sense_definition": "To calm, soothe, or pacify someone, especially by making concessions or giving in to their demands.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager tried to <w>placate</w> the angry customer by offering a full refund and a discount voucher.",
                            "target_lang_translations": {
                                "cs": "Manažer se pokusil <w>uklidnit</w> rozzlobeného zákazníka tím, že mu nabídl plnou náhradu a slevový poukaz."
                            }
                        },
                        {
                            "text": "They made several concessions to <w>placate</w> the protesters, but the demonstrations continued.",
                            "target_lang_translations": {
                                "cs": "Učinili několik ústupků, aby <w>zklidnili</w> protestující, ale demonstrace pokračovaly."
                            }
                        }
                    ],
                    "synonyms": [
                        "appease",
                        "soothe",
                        "conciliate",
                        "mollify",
                        "propitiate",
                        "satisfy",
                        "assuage",
                        "pacify"
                    ],
                    "antonyms": [
                        "enrage"
                    ],
                    "common_phrases": [
                        "placate the angry crowd",
                        "attempt to placate"
                    ],
                    "target_lang_definitions": {
                        "cs": "Uklidnit, utišit nebo usmířit někoho, zejména ústupky nebo vyhověním jeho požadavkům."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "uklidnit",
                                "target_lang_sense_clarification": "uvést někoho do klidu, zmírnit jeho rozrušení"
                            },
                            {
                                "target_lang_word": "zklidnit",
                                "target_lang_sense_clarification": "snížit intenzitu něčího hněvu nebo rozrušení"
                            },
                            {
                                "target_lang_word": "utišit",
                                "target_lang_sense_clarification": "způsobit, že se někdo přestane bouřit nebo křičet"
                            }
                        ]
                    }
                }
            ]
        },
        {
