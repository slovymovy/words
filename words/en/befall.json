{
    "word_family": [
        "fall"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "77395bd2-6eda-31e0-b50e-60a843ea682e",
                    "sense_definition": "To happen to someone or something, especially of something bad or unexpected.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "happen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family was anxious to know what terrible fate might <w>befall</w> them in the strange city.",
                            "target_lang_translations": {
                                "es": "La familia estaba angustiada por saber qué terrible destino podría <w>acaecerles</w> en la extraña ciudad."
                            }
                        },
                        {
                            "text": "A sudden misfortune <w>befell</w> the travelers when a severe storm destroyed their camp.",
                            "target_lang_translations": {
                                "es": "Una repentina desgracia les <w>sobrevino</w> a los viajeros cuando una fuerte tormenta destruyó su campamento."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tragedy to befall",
                        "fate to befall",
                        "misfortune to befall"
                    ],
                    "target_lang_definitions": {
                        "es": "Ocurrirle o sucederle a alguien o algo, especialmente tratándose de algo malo o inesperado."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "acaecer",
                                "target_lang_sense_clarification": "suceder a alguien"
                            },
                            {
                                "target_lang_word": "sobrevenir",
                                "target_lang_sense_clarification": "ocurrir de forma imprevista o desfavorable"
                            },
                            {
                                "target_lang_word": "suceder",
                                "target_lang_sense_clarification": "pasar algo a alguien"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4eeff8c7-c2f0-3e58-b1d4-3e1c40198756",
                    "sense_definition": "To happen or take place.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "happen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It <w>befell</w> that the old king passed away before his rightful successor could be crowned.",
                            "target_lang_translations": {
                                "es": "<w>Aconteció</w> que el viejo rey falleció antes de que su legítimo sucesor pudiera ser coronado."
                            }
                        },
                        {
                            "text": "Whatever may <w>befall</w>, we must remain steadfast and honor our original commitment.",
                            "target_lang_translations": {
                                "es": "<w>Pase lo que pase</w>, debemos permanecer firmes y honrar nuestro compromiso original."
                            }
                        }
                    ],
                    "synonyms": [
                        "come to pass",
                        "occur",
                        "transpire"
                    ],
                    "common_phrases": [
                        "whatever may befall"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used without an indirect object to mean occur or happen"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Ocurrir o tener lugar."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "acontecer",
                                "target_lang_sense_clarification": "suceder o tener lugar"
                            },
                            {
                                "target_lang_word": "suceder",
                                "target_lang_sense_clarification": "pasar o tener lugar"
                            },
                            {
                                "target_lang_word": "acaecer",
                                "target_lang_sense_clarification": "ocurrir"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01acd6b5-ecb8-3baa-b7a6-647b7ec11b4a",
                    "sense_definition": "To fall upon, overtake, or descend over someone or something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "At dusk a profound silence <w>befalls</w> the valley as the creatures prepare to rest.",
                            "target_lang_translations": {
                                "es": "Al anochecer, un profundo silencio <w>se cierne sobre</w> el valle mientras las criaturas se preparan para descansar."
                            }
                        },
                        {
                            "text": "A dark gloom had <w>befallen</w> the ancient castle long before the explorers arrived.",
                            "target_lang_translations": {
                                "es": "Una oscura penumbra <w>se había apoderado</w> del antiguo castillo mucho antes de que llegaran los exploradores."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Literary or poetic usage meaning to fall upon or settle over"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Caer sobre, cernirse o descender sobre alguien o algo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "cernirse sobre",
                                "target_lang_sense_clarification": "descender o posarse sobre algo de forma amenazante o solemne"
                            },
                            {
                                "target_lang_word": "apoderarse de",
                                "target_lang_sense_clarification": "adueñarse o envolver"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a03a4786-16f0-3eb3-94b7-08883aea9073",
                    "sense_definition": "To drop or tumble down; to fall.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In his madness, the poor knight <w>befell</w> into deep misery and confusion.",
                            "target_lang_translations": {
                                "es": "En su locura, el pobre caballero <w>cayó</w> en una profunda miseria y confusión."
                            }
                        },
                        {
                            "text": "The drunken wanderer stumbled and <w>befell</w> headlong into the ditch beside the road.",
                            "target_lang_translations": {
                                "es": "El vagabundo ebrio tropezó y <w>cayó</w> de cabeza en la zanja junto al camino."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Obsolete literal usage meaning to fall down"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Caerse o desplomarse."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "caer",
                                "target_lang_sense_clarification": "desplomarse hacia abajo"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1898a769-d33f-3970-a689-03d62a51008b",
                    "sense_definition": "An incident, event, or happening; a circumstance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chronicler gave a complete accounting of every curious <w>befall</w> in the province.",
                            "target_lang_translations": {
                                "es": "El cronista dio cuenta completa de cada curioso <w>suceso</w> en la provincia."
                            }
                        },
                        {
                            "text": "They were unprepared for the sudden <w>befall</w> of unexpected disasters during the journey.",
                            "target_lang_translations": {
                                "es": "No estaban preparados para el repentino <w>acontecimiento</w> de desastres inesperados durante el viaje."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Obsolete noun form meaning an occurrence or event"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Un incidente, acontecimiento o suceso; una circunstancia."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "suceso",
                                "target_lang_sense_clarification": "acontecimiento o hecho"
                            },
                            {
                                "target_lang_word": "acontecimiento",
                                "target_lang_sense_clarification": "hecho importante o inesperado"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}