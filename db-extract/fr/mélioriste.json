                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6072bc96-446b-4e5e-bcdd-86536a6bd3c8",
                                "sense_id": "efc162f7-d57f-3efc-be30-43aecfb72768",
                                "text": "Il est, dans la plénitude de sa foi et la certitude de sa force, un mélioriste."
                            },
                            {
                                "example_id": "e48b37a1-5cac-4bf8-9fe2-3e909b87a553",
                                "sense_id": "efc162f7-d57f-3efc-be30-43aecfb72768",
                                "text": "Nous faisions partie des derniers utopistes, ou mélioristes […] qui croyaient à un progrès moral continu en vertu duquel le genre humain comprenait déjà des hommes et des femmes fiables, rationnels et honnêtes […] qui pouvaient se libérer sans danger des contraintes extérieures de la convention, des critères traditionnels et des lois inflexibles de la conduite."
                            }
                        ]
                    }
