                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "mytí",
                                "target_lang_sense_clarification": "obecný proces čištění"
                            },
                            {
                                "target_lang_word": "čištění",
                                "target_lang_sense_clarification": "odstraňování nečistot"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20a13e9b-f33b-37dc-b0e8-d40b986c5b5d",
                    "sense_definition": "The industrial process of removing impurities or pollutants from a gas stream.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "industrial_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory installed a new system for the <w>scrubbing</w> of exhaust gases.",
                            "target_lang_translations": {
                                "cs": "Továrna nainstalovala nový systém pro <w>čištění</w> výfukových plynů."
                            }
                        },
                        {
                            "text": "Effective <w>scrubbing</w> is essential to meet modern environmental air quality standards.",
                            "target_lang_translations": {
                                "cs": "Efektivní <w>čištění</w> je nezbytné pro splnění moderních ekologických norem kvality ovzduší."
                            }
                        }
                    ],
                    "synonyms": [
                        "purification",
                        "filtration"
                    ],
                    "target_lang_definitions": {
                        "cs": "Průmyslový proces odstraňování nečistot nebo znečišťujících látek z proudu plynu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "čištění",
