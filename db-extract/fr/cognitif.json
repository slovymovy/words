                ],
                "senses": [
                    {
                        "sense_id": "931e671d-6b4d-36fd-99e0-93f4c52432c6",
                        "entry_id": "20c4af5c-533d-3687-9646-f6a75cae80a8",
                        "glosses": [
                            "Se dit des processus mentaux qui se rapportent à la connaissance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6618d513-2a7f-4bc5-ab91-50ee3f26b422",
                                "sense_id": "931e671d-6b4d-36fd-99e0-93f4c52432c6",
                                "text": "Il s'ensuit diverses sensations physiques (p. ex., rougissements, tremblements, transpiration) et une contre-performance des fonctions cognitives (p. ex., problèmes de concentration, trous de mémoire)."
                            },
                            {
                                "example_id": "2f17ba24-5ebf-4568-a4ed-610818aded3f",
                                "sense_id": "931e671d-6b4d-36fd-99e0-93f4c52432c6",
                                "text": "Il est, bien sûr, difficile d’aborder ces questions et de proposer des réponses définitives. Non seulement parce qu’il est extrêmement ardu de porter un regard extérieur sur son monde mais aussi parce que les outils cognitifs que nous possédons, notre corps, nos sens, notre intelligence, ne sont pas faits pour analyser le monde, lui trouver une vérité, des structures, des mécanismes, des emboîtages."
                            },
                            {
                                "example_id": "5be990bc-487c-4532-978e-cac23ef86354",
                                "sense_id": "931e671d-6b4d-36fd-99e0-93f4c52432c6",
                                "text": "La distractibilité est un problème fréquent dans la schizophrénie, qu'elle soit rapportée par les membres de la famille, repérée par les équipes soignantes, ou soulevée au moment de l'entretien sur les plaintes cognitives par le patient lui-même."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b344a074-e2d5-4f9b-94da-1789a65b384f",
                        "source_entry_id": "20c4af5c-533d-3687-9646-f6a75cae80a8",
                        "source_sense_id": "931e671d-6b4d-36fd-99e0-93f4c52432c6",
                        "source_sense_description": "Qui se rapporte à la connaissance",
                        "target_lang_word": "cognitive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cognitive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bfb12f13-001a-3dd0-9a5a-8f788e28f11c",
                                        "entry_id": "285c22c4-0be4-3d5e-9288-92490a930de6",
                                        "glosses": [
                                            "Relating to the part of mental functions that deals with logic, as opposed to affective which deals with emotions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35115339-d19b-45c1-b98e-edb952ebff75",
                                                "sense_id": "bfb12f13-001a-3dd0-9a5a-8f788e28f11c",
                                                "text": "Recent findings in cognitive neuroscience are also beginning to unravel how the body perceives magnitudes through sensory-motor systems. Variations in size, speed, quantity and duration, are registered in the brain by electro-chemical changes in neurons. The neurons that respond to these different magnitudes share a common neural network. In a survey of this research, cognitive neuroscientists Domenica Bueti and Vincent Walsh tell us that the brain does not treat temporal perception, spatial perception and perceived quantity as different."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea7f9f1b-a4e2-35a6-87f8-061a08e8fa59",
                                        "entry_id": "285c22c4-0be4-3d5e-9288-92490a930de6",
                                        "glosses": [
                                            "Intellectual."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eae03cb2-e9a2-3f88-853b-b552980ca21d",
                                        "entry_id": "285c22c4-0be4-3d5e-9288-92490a930de6",
                                        "glosses": [
                                            "Cognate; to be recognized as cognate."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c21d798-adb0-4261-95ff-2b1b60c3fe5d",
                                                "sense_id": "eae03cb2-e9a2-3f88-853b-b552980ca21d",
                                                "text": "Wanux \"white man,\" cognitive with Aben. awanoch, now used for \"Canadian Frenchman\";"
                                            }
                                        ]
                                    }
                                ]
                            },
