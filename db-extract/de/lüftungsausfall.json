                "senses": [
                    {
                        "sense_id": "df93c31f-f9cd-3973-837c-50cf87ae8d2b",
                        "entry_id": "730ea193-5cc5-3c6f-b1b5-562e8f9a5c13",
                        "glosses": [
                            "technisches Versagen der Lüftungstechnik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e932a0d-d3cb-4af1-85a3-bc0216ed5b45",
                                "sense_id": "df93c31f-f9cd-3973-837c-50cf87ae8d2b",
                                "text": "„Nachdem Ende Juli in einem Maststall im Westmünsterland rund 900 Schweine nach einem Lüftungsausfall verendet sind, wird das Thema zum Politikum.“"
                            },
                            {
                                "example_id": "9c35747e-d2d7-44cc-bf16-2e0a2ceb34d7",
                                "sense_id": "df93c31f-f9cd-3973-837c-50cf87ae8d2b",
                                "text": "„Am 12.07.2010 wurde ein Schaden aufgrund eines Lüftungsausfalles gemeldet.“"
                            },
                            {
                                "example_id": "0d2874cd-aad1-461f-82aa-84cc7a011fb3",
                                "sense_id": "df93c31f-f9cd-3973-837c-50cf87ae8d2b",
                                "text": "„In der Massentierhaltung bleiben Tiere sich selbst überlassen und ein Lüftungsausfall unbemerkt, bis fast tausend Tiere verenden.“"
                            },
                            {
                                "example_id": "3eb0c41e-80e9-48b9-8d3d-a13e3bcd7871",
                                "sense_id": "df93c31f-f9cd-3973-837c-50cf87ae8d2b",
                                "text": "„So war im Berichtszeitraum auch ein Thüringer Schweinezuchtbetrieb betroffen, in dem nach totalem Lüftungsausfall über 600 Absatzferkel verendeten.“"
                            },
                            {
                                "example_id": "0b0abaf2-840b-494f-afd0-19dd8fc6a59b",
                                "sense_id": "df93c31f-f9cd-3973-837c-50cf87ae8d2b",
                                "text": "„Bei einem Lüftungsausfall sollte im Normalfall ein Ersatzsystem anspringen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
