                    {
                        "form_id": "6923df21-70b6-4b1e-9cde-3ec90f093554",
                        "entry_id": "fcd93462-1ea1-3c0d-bb62-9d5061246132",
                        "tags": [
                            "plural"
                        ],
                        "form": "obits"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fa04a46c-fea9-3fcb-8a37-a371758db116",
                        "entry_id": "fcd93462-1ea1-3c0d-bb62-9d5061246132",
                        "glosses": [
                            "Service fondé pour le repos de l’âme d’un mort et qui doit être célébré à des époques déterminées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3b7ceaf-185f-4173-ace9-44d8ee03723a",
                                "sense_id": "fa04a46c-fea9-3fcb-8a37-a371758db116",
                                "text": "Fonder, dire un obit."
                            },
                            {
                                "example_id": "1c67b7d3-b31a-491c-8b9f-f4e41cba3f8a",
                                "sense_id": "fa04a46c-fea9-3fcb-8a37-a371758db116",
                                "text": "Il savait qui il enterrait l’archiprêtre. Il n’attendait pas foule ; il n’avait pas été autrement étonné par l’absence des vieilles habituées, aux distractions pleureuses, qui ne manquent jamais ni une messe de requiem ni un bout de l’an ni un obit et dont les chuchotements cinéraires sont utiles, après tout, pour étoffer les deuils pauvres."
                            }
                        ]
                    },
                    {
                        "sense_id": "b933d73d-d149-30f9-9120-c400ad121e0c",
                        "entry_id": "fcd93462-1ea1-3c0d-bb62-9d5061246132",
                        "glosses": [
                            "Ce que rapporte ce service."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8fc54bd1-7ce9-3fef-b7b9-edcec6d00127",
                        "entry_id": "fcd93462-1ea1-3c0d-bb62-9d5061246132",
                        "glosses": [
                            "Somme versée au prêtre pour dire un office funéraire."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "156e2ceb-90bf-3da0-aa93-c154c7deab69",
                        "entry_id": "fcd93462-1ea1-3c0d-bb62-9d5061246132",
                        "glosses": [
                            "Empattement supérieur d’une lettre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff42b96c-d758-4a5f-a8a1-4a9cba410e6a",
                                "sense_id": "156e2ceb-90bf-3da0-aa93-c154c7deab69",
                                "text": "Les lettres b, d, h, i, k, m, n, p, r, l, u, portent à leur partie supérieure, et vers la gauche, un léger trait nommé obit ou empattement de tête : b, d, h, i, k, m, n, p, r, l, u ; […] l’obit est double, c’est-à-dire gravé à droite et à gauche, dans les lettres v, x, y : v, x, y ; […]."
                            },
                            {
                                "example_id": "4fec8067-d20a-4b87-a1a2-6a7a702526df",
                                "sense_id": "156e2ceb-90bf-3da0-aa93-c154c7deab69",
                                "text": "Le petit trait placé au sommet des lettres b, d, h, i, j, k, l, s’appelle obit, et celui placé au bas des lettres f, h, i, k, l, m, n, p, q, r, s’appelle empattement."
                            }
                        ]
                    }
