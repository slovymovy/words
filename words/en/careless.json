{
    "word_family": [
        "care",
        "carelessly",
        "carelessness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3b202549-038e-36cf-aad5-767e3d046f52",
                    "sense_definition": "Not giving sufficient attention or thought, especially concerning the avoidance of harm or mistakes.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "lack of attention",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student made several <w>careless</w> mistakes on the math test because he was in a hurry.",
                            "target_lang_translations": {
                                "ru": "Студент допустил несколько <w>небрежных</w> ошибок в тесте по математике, потому что торопился."
                            }
                        },
                        {
                            "text": "It was very <w>careless</w> driving to ignore the stop sign at the busy intersection.",
                            "target_lang_translations": {
                                "ru": "Игнорирование знака «стоп» на оживленном перекрестке было очень <w>неосторожным</w> вождением."
                            }
                        }
                    ],
                    "synonyms": [
                        "negligent",
                        "heedless",
                        "sloppy",
                        "slapdash"
                    ],
                    "antonyms": [
                        "meticulous"
                    ],
                    "common_phrases": [
                        "careless driving",
                        "careless mistake",
                        "careless attitude"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не уделяющий достаточного внимания или мыслей, особенно в отношении предотвращения вреда или ошибок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "невнимательный",
                                "target_lang_sense_clarification": "не проявляющий должного внимания"
                            },
                            {
                                "target_lang_word": "небрежный",
                                "target_lang_sense_clarification": "выполненный без старания или аккуратности"
                            },
                            {
                                "target_lang_word": "неосторожный",
                                "target_lang_sense_clarification": "не соблюдающий мер предосторожности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "978b55f6-7088-3da1-97f9-01e5ff793963",
                    "sense_definition": "Free from care; unworried, without anxiety.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unworried",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They spent a <w>careless</w> afternoon lounging by the pool without a single worry.",
                            "target_lang_translations": {
                                "ru": "Они провели <w>беззаботный</w> день, нежась у бассейна без единой тревоги."
                            }
                        },
                        {
                            "text": "His <w>careless</w> ease made everyone else in the room feel more relaxed.",
                            "target_lang_translations": {
                                "ru": "Его <w>беспечная</w> непринужденность заставила всех остальных в комнате почувствовать себя более расслабленно."
                            }
                        }
                    ],
                    "synonyms": [
                        "carefree",
                        "unworried",
                        "untroubled",
                        "insouciant"
                    ],
                    "common_phrases": [
                        "careless ease",
                        "careless youth"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in literary contexts to mean carefree"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Свободный от забот; беззаботный, не испытывающий тревоги."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беззаботный",
                                "target_lang_sense_clarification": "свободный от тревог и хлопот"
                            },
                            {
                                "target_lang_word": "беспечный",
                                "target_lang_sense_clarification": "не думающий о последствиях или трудностях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c64680f-c854-3035-9a7a-30195d187813",
                    "sense_definition": "Not concerned or worried about something; showing a lack of interest.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "unworried",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He dismissed the serious accusations with a <w>careless</w> shrug of his shoulders.",
                            "target_lang_translations": {
                                "ru": "Он отверг серьезные обвинения <w>небрежным</w> пожатием плеч."
                            }
                        },
                        {
                            "text": "She gave a <w>careless</w> word of greeting before turning back to her book.",
                            "target_lang_translations": {
                                "ru": "Она бросила <w>невзначай</w> слово приветствия, прежде чем снова вернуться к своей книге."
                            }
                        }
                    ],
                    "synonyms": [
                        "unconcerned",
                        "nonchalant",
                        "indifferent",
                        "casual"
                    ],
                    "common_phrases": [
                        "careless shrug",
                        "careless word"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не обеспокоенный или не волнующийся о чем-либо; проявляющий отсутствие интереса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "небрежный",
                                "target_lang_sense_clarification": "выражающий безразличие или отсутствие интереса"
                            },
                            {
                                "target_lang_word": "безучастный",
                                "target_lang_sense_clarification": "не проявляющий интереса или сочувствия"
                            },
                            {
                                "target_lang_word": "легкомысленный",
                                "target_lang_sense_clarification": "несерьезный в отношении к чему-либо"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}