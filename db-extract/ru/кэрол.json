                "translations": [
                    {
                        "translation_id": "3568d5ca-dbdd-40e4-b57b-9d81c6871fd0",
                        "source_entry_id": "e2ada654-f472-324f-b358-6b1d335dcc99",
                        "source_sense_id": "c68c4ef2-2d86-3743-a896-dabeb362f7db",
                        "target_lang_word": "Carol",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Carol",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d464123-be88-3fc3-9420-7f2327533629",
                                        "entry_id": "36592968-a5ac-300b-9a87-eed975ac518b",
                                        "glosses": [
                                            "A female given name from the Germanic languages, popular in the middle of the 20th century."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "989dcfc8-e013-463a-a3b9-d75c082c5143",
                                                "sense_id": "9d464123-be88-3fc3-9420-7f2327533629",
                                                "text": "Carol is fifteen years old and I'm sixteen. Her name is really Caroline, but she hates it and wants to be called Carol - it's so much prettier."
                                            },
                                            {
                                                "example_id": "ad36a2dc-952c-4284-bed2-6f347922f58e",
                                                "sense_id": "9d464123-be88-3fc3-9420-7f2327533629",
                                                "text": "\"Holly, would you mind if I named my little girl 'Holly'? I mean, it's right around Christmas time, and I always think of holly with Christmas. I like the name Carol, too, like Christmas carol. I heard once that the name Carol means 'song of joy'\"."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Carol",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93c537e9-045a-356c-ac7e-c2cd97c04438",
                                        "entry_id": "842f77d5-623e-36c8-bc5d-02a9f2991ef4",
                                        "glosses": [
                                            "A male given name from the Germanic languages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f11a5713-b00c-4030-a5c5-da8ffe65b19c",
                                                "sense_id": "93c537e9-045a-356c-ac7e-c2cd97c04438",
                                                "text": "This table shows the curious fact that little Prince Carol of Roumania (who is at once the great-grandson and the third cousin of Queen Victoria) has a better hereditary right to the British Throne than Her Majesty."
                                            },
                                            {
                                                "example_id": "734dca1e-45bb-4d3f-86ec-9ed1890ae5d4",
                                                "sense_id": "93c537e9-045a-356c-ac7e-c2cd97c04438",
                                                "text": "What splendid names for boys there are!\nThere's Carol like a rolling car […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e85a1761-320e-4676-9b27-eccf5b5ebd83",
                        "source_entry_id": "e2ada654-f472-324f-b358-6b1d335dcc99",
                        "source_sense_id": "c68c4ef2-2d86-3743-a896-dabeb362f7db",
                        "target_lang_word": "Carole",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Carole",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "703047da-ec04-335f-a74a-28d8e2f6ee68",
                                        "entry_id": "fac13bb7-caa3-30f4-bed9-11796c029fb0",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a3e6859-9cf7-4d9d-bd7f-e00a884bfb2b",
                                                "sense_id": "703047da-ec04-335f-a74a-28d8e2f6ee68",
                                                "text": "Carole, tes cheveux volent quand le vent frôle ta nuque d’or frivole."
                                            },
                                            {
                                                "example_id": "f64db6cc-37b3-4577-bbb1-035b41a20c56",
                                                "sense_id": "703047da-ec04-335f-a74a-28d8e2f6ee68",
                                                "text": "Suffisait-il d’épouser une jeunesse pour avancer d’une génération ? Il l’avait cru, jadis, en se mariant avec Carole."
                                            },
                                            {
                                                "example_id": "f694b08d-c82f-4581-a875-f32e3600d193",
                                                "sense_id": "703047da-ec04-335f-a74a-28d8e2f6ee68",
                                                "text": "« Est-ce que la critique ne s’inscrit pas dans cette configuration ? », s’interroge Carole Grimaud."
                                            },
                                            {
                                                "example_id": "eee2616e-def8-41ee-922c-08c453b7ce93",
                                                "sense_id": "703047da-ec04-335f-a74a-28d8e2f6ee68",
                                                "text": "Conférence : Mathilde Bonaparte : la culture, une arme politique par Carole Blumenfeld (voir page 24)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
