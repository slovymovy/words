                "senses": [
                    {
                        "sense_id": "f661afaf-9fd8-3381-bef9-f4463355f9ed",
                        "entry_id": "b064f301-6cba-358e-8399-c9496cff6c35",
                        "glosses": [
                            "Fragilité anormale, excessive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b15bd631-b551-4888-8e80-8eb025878890",
                                "sense_id": "f661afaf-9fd8-3381-bef9-f4463355f9ed",
                                "text": "Les ressources mentales s’amenuisent. Le corps n’a plus d’importance. La mort est en embuscade. L’aide sociale inadéquate et l’apathie médiatique renforcent cette hyperfragilité."
                            },
                            {
                                "example_id": "e7ae2b2c-c376-4da4-99cf-8fe21df04648",
                                "sense_id": "f661afaf-9fd8-3381-bef9-f4463355f9ed",
                                "text": "L’épidermolyse bulleuse se caractérise par une hyperfragilité de la peau la rendant aussi fragile que les ailes d’un papillon."
                            },
                            {
                                "example_id": "222a5c2c-0399-4cff-be06-d88861d8db09",
                                "sense_id": "f661afaf-9fd8-3381-bef9-f4463355f9ed",
                                "text": "C’est un gros problème, pointe Jean-Pierre Marc, maire de Gouesnach. Tant que cette canalisation ne sera pas changée, on sera en hyperfragilité. Elle a déjà cassé."
                            }
                        ]
                    }
