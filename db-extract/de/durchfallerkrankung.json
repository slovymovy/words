                "senses": [
                    {
                        "sense_id": "18897be2-f04b-303d-b403-b299b3ec8a39",
                        "entry_id": "7fe29859-63de-3e27-b46a-8cce6252be27",
                        "glosses": [
                            "Erkrankung, zu deren Symptomen vor allem Diarrhö gehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef779e39-bbd5-49c3-92da-6ea239e3f414",
                                "sense_id": "18897be2-f04b-303d-b403-b299b3ec8a39",
                                "text": "„Die häufigsten Reiseinfektionen sind die Darm- und Durchfallerkrankungen.“"
                            },
                            {
                                "example_id": "29bc29b6-c2c6-4b07-86b7-2d6c11fd0858",
                                "sense_id": "18897be2-f04b-303d-b403-b299b3ec8a39",
                                "text": "„Heilerde wird äußerlich z. B. bei entzündlichen Hautveränderungen angewendet, innerlich zur Behandlung von Durchfallerkrankungen.“"
                            },
                            {
                                "example_id": "ba423a85-22ba-473e-9c88-340e2e4526d9",
                                "sense_id": "18897be2-f04b-303d-b403-b299b3ec8a39",
                                "text": "„Die Cholera kann subklinisch verlaufen als leichte, unkomplizierte Durchfallerkrankung oder fulminant als rasch zum Tode führende Krankheit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
