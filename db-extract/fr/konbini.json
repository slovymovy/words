                            {
                                "example_id": "fd3f7bd2-4e74-4484-91b5-ca3a9b66c015",
                                "sense_id": "696d4f30-f37f-3ad9-bac9-c4f76db9ec2c",
                                "text": "Il est donc concevable de vivre en autarcie complète en se rendant à son konbini."
