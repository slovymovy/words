                            "target_lang_translations": {
                                "en": "The <w>Tolstovka River</w> flows through the Saratov region."
                            }
                        },
                        {
                            "text": "Туристы часто останавливаются на берегу реки <w>Толстовка</w> во время похода.",
                            "target_lang_translations": {
                                "en": "Tourists often stop on the banks of the <w>Tolstovka River</w> during a hike."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A river in Russia, a tributary of the Bolshoy Irgiz River."
                    },
                    "translations": {
