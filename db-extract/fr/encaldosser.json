                                "sense_id": "1ebd94fd-17a6-33c6-8097-d63407e8f869",
                                "text": "Tu parles, ledit mari se faisait encaldosser depuis sa puberté par moult petits camarades."
                            },
                            {
                                "example_id": "f1c53660-b21f-4df6-9401-6f8983180025",
                                "sense_id": "1ebd94fd-17a6-33c6-8097-d63407e8f869",
                                "text": "Tu t’es encore fait encaldosser par un qui l’avait trop longue !"
                            },
                            {
                                "example_id": "f42efc96-f114-4280-aab5-df5d9e0f85dd",
                                "sense_id": "1ebd94fd-17a6-33c6-8097-d63407e8f869",
                                "text": "Je l’ai vu comme je vous vois se faire encaldosser dans une tasse derrière la place d’Italie."
                            }
                        ]
                    }
