                ],
                "senses": [
                    {
                        "sense_id": "d1baffc5-b0d8-357e-8fde-a9738e8a4402",
                        "entry_id": "cdb95add-2485-37c9-b102-6c3be9cea456",
                        "glosses": [
                            "weibliche Person, die mit etwas handelt, einen Handel betreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c67d88ce-02d2-4a23-ae00-7a6656cb8a02",
                                "sense_id": "d1baffc5-b0d8-357e-8fde-a9738e8a4402",
                                "text": "Die Händlerinnen haben sich darauf geeinigt, ihre Geschäfte in der Mittagszeit offen zu halten."
                            },
                            {
                                "example_id": "6b6eba21-2b3d-4ff8-bde2-1ba6bb23d550",
                                "sense_id": "d1baffc5-b0d8-357e-8fde-a9738e8a4402",
                                "text": "„Die Händlerin aus Torshok bot ihm mit ihrer kreischenden Stimme ihre Waren an, besonders Pantoffeln aus Ziegenleder.“"
                            },
                            {
                                "example_id": "1b961711-3c18-4082-9881-da3442da3155",
                                "sense_id": "d1baffc5-b0d8-357e-8fde-a9738e8a4402",
                                "text": "„Die Händlerin versteifte sich darauf, sie habe drei gesagt.“"
                            },
                            {
                                "example_id": "7598c495-88ae-49ba-b046-35f82866eb5b",
                                "sense_id": "d1baffc5-b0d8-357e-8fde-a9738e8a4402",
                                "text": "„Der Zeitungsjunge, die Fischerfrauen auf dem Belsunce, die Händlerinnen, die ihre Läden öffneten, die Arbeiter auf dem Weg zur Frühschicht, sie alle gehörten zur Menge derer, die nie abfahren, mag geschehen, was will.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
