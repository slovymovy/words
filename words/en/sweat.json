                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hard-work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It took a lot of <w>sweat</w> and tears to get this business started.",
                            "target_lang_translations": {
                                "ru": "Потребовалось много <w>пота</w> и слез, чтобы запустить этот бизнес."
                            }
                        },
                        {
                            "text": "Success is usually the result of hard work and honest <w>sweat</w>.",
                            "target_lang_translations": {
                                "ru": "Успех обычно является результатом упорного труда и честного <w>пота</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "perspiration"
                    ],
                    "common_phrases": [
                        "sweat and tears",
                        "honest sweat"
                    ],
                    "target_lang_definitions": {
                        "ru": "усилия или тяжелая работа"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пот",
                                "target_lang_sense_clarification": "перен. большое напряжение, труд"
                            },
                            {
                                "target_lang_word": "усилия",
                                "target_lang_sense_clarification": "старания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13b00113-7ea6-3bfe-a3e5-02d7cb60d126",
