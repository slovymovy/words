                                        "glosses": [
                                            "техн. приспособление, используемое как быстродействующее соединительное звено между двумя предметами, оснащёнными петлями, обычно имеющее форму скобы с пружинной защёлкой или резьбовой муфтой"
                                        ],
                                        "tags": [],
