                ],
                "senses": [
                    {
                        "sense_id": "84321e81-11e3-33a7-bcf8-7ed3f8b5e83c",
                        "entry_id": "715799b9-6693-3c7e-9485-c5a0b7f3503e",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdaff7ed-7bb4-4147-88f8-269f5f755e76",
                                "sense_id": "84321e81-11e3-33a7-bcf8-7ed3f8b5e83c",
                                "text": "Frau Mündle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "66d9ba8e-ddb3-4fec-a99c-69b97cba3fe6",
                                "sense_id": "84321e81-11e3-33a7-bcf8-7ed3f8b5e83c",
                                "text": "Herr Mündle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "60d5106d-ac5a-4437-90c2-32933fe1360e",
                                "sense_id": "84321e81-11e3-33a7-bcf8-7ed3f8b5e83c",
                                "text": "Die Mündles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "de0ba27b-f312-4079-9aee-f7f2fd8c3935",
                                "sense_id": "84321e81-11e3-33a7-bcf8-7ed3f8b5e83c",
                                "text": "Der Mündle trägt nie die Pullover, die die Mündle ihm strickt."
                            },
                            {
                                "example_id": "66ce51fc-0e68-4d05-8afb-8d561ce535e3",
                                "sense_id": "84321e81-11e3-33a7-bcf8-7ed3f8b5e83c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Mündle kommt, geht der Herr Mündle.“"
                            },
                            {
                                "example_id": "2218529f-ee5b-4d67-8011-0544bf21c2ec",
                                "sense_id": "84321e81-11e3-33a7-bcf8-7ed3f8b5e83c",
                                "text": "Mündle kommt und geht."
                            },
                            {
                                "example_id": "d3e0a6bb-f260-421e-91d9-e85f120a2782",
                                "sense_id": "84321e81-11e3-33a7-bcf8-7ed3f8b5e83c",
                                "text": "Mündles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
