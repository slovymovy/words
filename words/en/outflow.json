{
    "word_family": [
        "flow"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "13f39348-7497-3fff-bbca-626209a33558",
                    "sense_definition": "The process of flowing out.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>outflow</w> of water from the dam was carefully monitored during the storm.",
                            "target_lang_translations": {
                                "pl": "<w>Wypływ</w> wody z tamy był uważnie monitorowany podczas burzy."
                            }
                        },
                        {
                            "text": "Engineers studied the <w>outflow</w> of air from the ventilation system to improve efficiency.",
                            "target_lang_translations": {
                                "pl": "Inżynierowie badali <w>wypływ</w> powietrza z systemu wentylacyjnego, aby poprawić jego wydajność."
                            }
                        }
                    ],
                    "synonyms": [
                        "effluence",
                        "efflux",
                        "effluxion"
                    ],
                    "common_phrases": [
                        "steady outflow"
                    ],
                    "target_lang_definitions": {
                        "pl": "Proces wypływania cieczy lub gazu na zewnątrz."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wypływ",
                                "target_lang_sense_clarification": "ogólny proces wydostawania się substancji"
                            },
                            {
                                "target_lang_word": "odpływ",
                                "target_lang_sense_clarification": "ruch cieczy w określonym kierunku"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aea069a1-ae10-3203-943a-b95a8652194e",
                    "sense_definition": "Any outward movement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a significant <w>outflow</w> of capital from the country during the economic crisis.",
                            "target_lang_translations": {
                                "pl": "Podczas kryzysu gospodarczego nastąpił znaczący <w>odpływ</w> kapitału z kraju."
                            }
                        },
                        {
                            "text": "The company reported a large <w>outflow</w> of employees seeking better opportunities elsewhere.",
                            "target_lang_translations": {
                                "pl": "Firma odnotowała duży <w>odpływ</w> pracowników szukających lepszych możliwości gdzie indziej."
                            }
                        }
                    ],
                    "common_phrases": [
                        "capital outflow"
                    ],
                    "target_lang_definitions": {
                        "pl": "Jakikolwiek ruch skierowany na zewnątrz, np. kapitału lub ludzi."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "odpływ",
                                "target_lang_sense_clarification": "przemieszczanie się zasobów lub osób poza dany obszar"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4d94918-d63b-3e9c-a896-e2992e882efa",
                    "sense_definition": "A fluid that flows out.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The river is an <w>outflow</w> from the large lake located in the mountains.",
                            "target_lang_translations": {
                                "pl": "Rzeka stanowi <w>wypływ</w> z dużego jeziora położonego w górach."
                            }
                        },
                        {
                            "text": "The pipe carries the <w>outflow</w> from the factory directly into the nearby stream.",
                            "target_lang_translations": {
                                "pl": "Rura odprowadza <w>ścieki</w> z fabryki bezpośrednio do pobliskiego strumienia."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Ciecz lub substancja, która wypływa z danego miejsca."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wypływ",
                                "target_lang_sense_clarification": "substancja wydostająca się ze źródła"
                            },
                            {
                                "target_lang_word": "ściek",
                                "target_lang_sense_clarification": "w kontekście przemysłowym lub zanieczyszczonej wody"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f1b3cbd9-bc0c-38dd-ba60-99471592532c",
                    "sense_definition": "The part of a system that allows material to flow out.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>outflow</w> of the drainage system was blocked by debris after the heavy rain.",
                            "target_lang_translations": {
                                "pl": "<w>Odpływ</w> systemu drenażowego został zablokowany przez zanieczyszczenia po ulewnym deszczu."
                            }
                        },
                        {
                            "text": "Check the <w>outflow</w> to ensure that the liquid is not backing up into the tank.",
                            "target_lang_translations": {
                                "pl": "Sprawdź <w>wylot</w>, aby upewnić się, że ciecz nie cofa się do zbiornika."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Element systemu umożliwiający odprowadzanie materiału na zewnątrz."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wylot",
                                "target_lang_sense_clarification": "miejsce, przez które coś wypływa"
                            },
                            {
                                "target_lang_word": "odpływ",
                                "target_lang_sense_clarification": "kanał lub otwór odprowadzający"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b72be8f6-b041-3868-9f56-aafa29a58f33",
                    "sense_definition": "Something that flows out of a sewage treatment plant.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The treated <w>outflow</w> is tested daily to ensure it meets environmental safety standards.",
                            "target_lang_translations": {
                                "pl": "Oczyszczony <w>odpływ</w> jest codziennie badany, aby upewnić się, że spełnia normy bezpieczeństwa środowiskowego."
                            }
                        },
                        {
                            "text": "Local authorities are concerned about the impact of the plant's <w>outflow</w> on the river ecosystem.",
                            "target_lang_translations": {
                                "pl": "Władze lokalne są zaniepokojone wpływem <w>ścieków</w> z zakładu na ekosystem rzeki."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Substancja odprowadzana z oczyszczalni ścieków."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ścieki oczyszczone",
                                "target_lang_sense_clarification": "woda opuszczająca oczyszczalnię"
                            },
                            {
                                "target_lang_word": "odpływ",
                                "target_lang_sense_clarification": "techniczne określenie strumienia cieczy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0aec111a-559f-37a7-be5f-cd4231960410",
                    "sense_definition": "A stream of gaseous material emanating from an active galactic nucleus.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Astronomers observed a powerful <w>outflow</w> of gas from the center of the distant galaxy.",
                            "target_lang_translations": {
                                "pl": "Astronomowie zaobserwowali potężny <w>wypływ</w> gazu z centrum odległej galaktyki."
                            }
                        },
                        {
                            "text": "The galactic <w>outflow</w> plays a crucial role in regulating star formation within the galaxy.",
                            "target_lang_translations": {
                                "pl": "Galaktyczny <w>wypływ</w> odgrywa kluczową rolę w regulowaniu procesu formowania się gwiazd w galaktyce."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Strumień gazu wydobywający się z jądra galaktyki."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wypływ",
                                "target_lang_sense_clarification": "strumień materii w astrofizyce"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5af1a1da-2fb5-3f3b-9fed-a0a00971f24e",
                    "sense_definition": "To flow outward.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lava began to <w>outflow</w> from the crater during the early hours of the morning.",
                            "target_lang_translations": {
                                "pl": "Lawa zaczęła <w>wypływać</w> z krateru we wczesnych godzinach porannych."
                            }
                        },
                        {
                            "text": "Water will <w>outflow</w> from the reservoir whenever the gates are opened.",
                            "target_lang_translations": {
                                "pl": "Woda będzie <w>wypływać</w> ze zbiornika, gdy tylko bramy zostaną otwarte."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Wypływać na zewnątrz."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wypływać",
                                "target_lang_sense_clarification": "przemieszczać się z wnętrza na zewnątrz"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}