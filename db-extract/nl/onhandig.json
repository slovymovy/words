                "senses": [
                    {
                        "sense_id": "6c36eb7c-def0-3549-b601-44ca028fcddf",
                        "entry_id": "0c40f26e-21b9-3614-b87e-e0ad587f6819",
                        "glosses": [
                            "niet goed met de handen om kunnen gaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8171b61c-139c-43f8-a76f-4bb45a71c56f",
                                "sense_id": "6c36eb7c-def0-3549-b601-44ca028fcddf",
                                "text": "Ze kwamen hiernaartoe via Parijs of Toulouse, Madrid of Barcelona, beladen met dozen verf en boeken - en typemachines om hun eigen boeken op te schrijven - en koffers met hun initialen erop, koffers die soms op de grond vielen omdat ze zo onhandig waren met de dorpsezels."
                            },
                            {
                                "example_id": "117fcb28-b676-4ed9-ac0e-b4ccf408b668",
                                "sense_id": "6c36eb7c-def0-3549-b601-44ca028fcddf",
                                "text": "De onhandige man had al drie spijkers krom geslagen."
                            }
                        ]
                    },
                    {
                        "sense_id": "2cb30e61-0a8f-3aa6-8c6c-371a8c83d711",
                        "entry_id": "0c40f26e-21b9-3614-b87e-e0ad587f6819",
                        "glosses": [
                            "niet gemakkelijk om mee om te gaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44a19e88-2e36-4b23-80a0-8d7d9bbac652",
                                "sense_id": "2cb30e61-0a8f-3aa6-8c6c-371a8c83d711",
                                "text": "Wat een onhandig trucje is dat, zeg!"
                            }
                        ]
                    },
                    {
                        "sense_id": "f4280eeb-39af-3f87-a9c9-1f776e7cc2f7",
                        "entry_id": "0c40f26e-21b9-3614-b87e-e0ad587f6819",
                        "glosses": [
                            "omslachtig, moeilijk, mijl op zeven, oncomfortabel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d7682df-19cb-498a-a288-7164584393ff",
                                "sense_id": "f4280eeb-39af-3f87-a9c9-1f776e7cc2f7",
                                "text": "Ik liep langs hem heen en stak onhandig de sleutel in het slot."
                            },
                            {
                                "example_id": "89face09-2a8f-4c93-a879-a409232d872a",
                                "sense_id": "f4280eeb-39af-3f87-a9c9-1f776e7cc2f7",
                                "text": "Ondanks dat er honderd redenen zijn waarom iets niet kan of onhandig is, liet deze doodgewone familie uit Yorkshire zien dat het wel gewoon kan. Beter onderwijs voor je kinderen kan ik me nauwelijks voorstellen."
                            },
                            {
                                "example_id": "82bdb3ec-8a61-4f1e-8d69-b4d939b3ec17",
                                "sense_id": "f4280eeb-39af-3f87-a9c9-1f776e7cc2f7",
                                "text": "Hij vindt een helm vooral onhandig. \"Dan moet ik hem meenemen in de trein.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac8dbd78-2649-432d-9827-90658803bfd6",
                        "source_entry_id": "0c40f26e-21b9-3614-b87e-e0ad587f6819",
                        "source_sense_id": "6c36eb7c-def0-3549-b601-44ca028fcddf",
                        "source_sense_description": "niet goed met de handen om kunnen gaan",
                        "target_lang_word": "unbeholfen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unbeholfen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5d481499-8c86-33b8-93c6-3c8ff43b2228",
                                        "entry_id": "e84337c9-8bee-3972-9d00-1010b34c8179",
                                        "glosses": [
                                            "mit schlechter körperlicher Koordination, mit wenig Geschick"
                                        ],
                                        "tags": [
                                            "auch übertragen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7d2bf99-3f4d-4bc4-a031-55603283430b",
                                                "sense_id": "5d481499-8c86-33b8-93c6-3c8ff43b2228",
                                                "text": "Der kleine Elefant machte seine ersten unbeholfenen Schritte."
                                            },
                                            {
                                                "example_id": "4d6fe76b-0ad1-45ce-b4b1-ea3b104b1237",
                                                "sense_id": "5d481499-8c86-33b8-93c6-3c8ff43b2228",
                                                "text": "„Kleiner Eisbär übt das Krabbeln – […] das Kleine ist schon sehr agil. »Die Bewegungen sind aber noch etwas unbeholfen und die ersten Krabbelversuche enden meist mit einem Purzeln«, teilt der Zoo mit.“"
                                            },
                                            {
                                                "example_id": "faaa096c-de45-4df5-8175-3d02710d29fe",
                                                "sense_id": "5d481499-8c86-33b8-93c6-3c8ff43b2228",
                                                "text": "„Sie watscheln, tragen einen Frack und wirken fast immer ein bisschen unbeholfen - aber Pinguine sind dennoch nicht zu unterschätzen.“"
                                            },
                                            {
                                                "example_id": "95a591eb-4921-44a9-935e-f8836c8cf873",
                                                "sense_id": "5d481499-8c86-33b8-93c6-3c8ff43b2228",
                                                "text": "„Mit ihren großen schwarzen Kulleraugen und dem massigen Körper wirken Seehunde an Land harmlos und unbeholfen. Im Wasser aber sind sie echte Könner, die mit tödlicher Präzision jagen.“"
                                            },
                                            {
                                                "example_id": "6ac5f559-787f-464f-bd52-ebfc4d2128a7",
                                                "sense_id": "5d481499-8c86-33b8-93c6-3c8ff43b2228",
                                                "text": "»Dabei lachte sie unbeholfen und ruderte mit den Armen.«"
                                            },
                                            {
                                                "example_id": "f350a6e4-fbde-49bf-91a6-1dd8f16f72b9",
                                                "sense_id": "5d481499-8c86-33b8-93c6-3c8ff43b2228",
                                                "text": "„Mit Wanderstöcken bewaffnet strömen viele Menschen in die Berge. Oft sehen diese Wanderer etwas unbeholfen aus. Denn vielfach sind die Wanderstöcke falsch eingestellt.“"
                                            },
                                            {
                                                "example_id": "e9d1e0bb-9db9-4565-bbc1-ebe73e81aecc",
                                                "sense_id": "5d481499-8c86-33b8-93c6-3c8ff43b2228",
                                                "text": "„Auch energische - wenn auch glücklose und leicht unbeholfen wirkende - Angriffsbemühungen des FC Basel in der Schlussphase ergaben keine zählbaren Ergebnisse […]“"
                                            },
                                            {
                                                "example_id": "415079ba-b2ca-4a17-9e01-89f2bd856d40",
                                                "sense_id": "5d481499-8c86-33b8-93c6-3c8ff43b2228",
                                                "text": "„Die Schauspielerin Diane Keaton wirkt immer etwas unbeholfen und unscheinbar.“"
                                            },
                                            {
                                                "example_id": "c5829400-ba7b-4d3b-88e1-dbd307a55109",
                                                "sense_id": "5d481499-8c86-33b8-93c6-3c8ff43b2228",
                                                "text": "„Der König selbst trägt damals wenig dazu bei, die Vorwürfe gegen ihn zu entkräften: Bei einer Pressekonferenz während der jährlichen Elchjagd stammelt er unbeholfen in die Mikrofone der Journalisten, dementiert nicht.“"
                                            },
                                            {
                                                "example_id": "513fcd71-a6ad-497d-97e5-eb76323e4f0a",
                                                "sense_id": "5d481499-8c86-33b8-93c6-3c8ff43b2228",
                                                "text": "„Was auf den ersten Blick manchmal etwas unbeholfen wirkt, erweist sich oft als seine stärkste Waffe: weil die Leute ihn unterschätzen, nehmen sie sich vor seinen scheinbar naiven Fragen oft nicht richtig in Acht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "90d9bf75-62b7-4f09-b0e3-226850c08014",
                        "source_entry_id": "0c40f26e-21b9-3614-b87e-e0ad587f6819",
