                                "target_senses": [
                                    {
                                        "sense_id": "9dcd69a3-d8df-34b5-8881-a3909c8d77a8",
                                        "entry_id": "88ca3b56-91ab-3f88-9cac-b7581fbca7b0",
                                        "glosses": [
                                            "Propre à l’ablation."
                                        ],
                                        "tags": [
                                            "Matériaux-Thermique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4ff985d-6ad4-447e-9bfe-5a5bdb90ab5c",
                                                "sense_id": "9dcd69a3-d8df-34b5-8881-a3909c8d77a8",
                                                "text": "Enfin, un procédé ablatif est actuellement développé à l’échelle pilote pour la production d’huiles de pyrolyse utilisables comme carburant pour automobiles."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ablatif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "276e3e31-7427-3e41-af07-f3b533416ac1",
                                        "entry_id": "ac80eb71-d2ec-37f2-91de-b857527f05cd",
                                        "glosses": [
                                            "Cas exprimant généralement le lieu depuis lequel se produit un déplacement, dans certaines langues comme le latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c11df2d-a029-4baf-ae8d-593f29a54e2a",
                                                "sense_id": "276e3e31-7427-3e41-af07-f3b533416ac1",
                                                "text": "Ablatif singulier, pluriel."
                                            },
                                            {
                                                "example_id": "0d8e7237-22f9-47ce-acbe-862ea45b9c9a",
                                                "sense_id": "276e3e31-7427-3e41-af07-f3b533416ac1",
                                                "text": "Cette préposition régit l’ablatif."
                                            },
                                            {
                                                "example_id": "0ea8d9ed-1748-40b8-b7ed-4f72f9b33f8c",
                                                "sense_id": "276e3e31-7427-3e41-af07-f3b533416ac1",
                                                "text": "Je me demande ce que c’est que l’ablatif, auquel vous faites allusion.\n— Je vous le dirai plus tard...\n— C’est donc une chose qu’on ne doit savoir qu’après son mariage ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
