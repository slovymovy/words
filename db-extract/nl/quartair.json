                        "sense_id": "18f031ed-6e42-3abb-a18c-a412acab9c6c",
                        "entry_id": "b376e2fa-124a-3a75-b41e-8b248bbe11cb",
                        "glosses": [
                            "een geologisch tijdperk van een indeling die inmiddels als verouderd beschouwd wordt"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d895b9f3-9313-4194-835c-83b896c739fb",
                                "sense_id": "18f031ed-6e42-3abb-a18c-a412acab9c6c",
                                "text": "Het quartair was het laatste en jongste van vier tijdvakken waarin men aanvankelijk de geschiedenis van de aarde indeelde."
                            }
                        ]
                    },
                    {
                        "sense_id": "c21b537c-c96e-366f-b72e-f1b17569f1db",
                        "entry_id": "b376e2fa-124a-3a75-b41e-8b248bbe11cb",
                        "glosses": [
                            "laatste geologische periode van het era kaenozoïcum, die ongeveer 2,6 miljoen jaar geleden begon"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d0a1908e-b0be-4c4f-aa6f-8fc65907352c",
