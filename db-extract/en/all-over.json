                                        "entry_id": "06a188be-5722-327a-8591-a2a37715dae5",
                                        "glosses": [
                                            "ein bestimmtes Areal vollständig erfassend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddc0ae26-878f-4460-ab4c-07095ecbed84",
                                                "sense_id": "82a79b0f-a188-3b17-887a-66939d07499a",
                                                "text": "„Ein nahezu flächendeckender Zusammenbruch der Industrie, massenhafte Arbeitslosigkeit und beständige Abwanderung erschütterten in den neunziger Jahren die ostdeutschen Bundesländer.“"
                                            },
                                            {
                                                "example_id": "9f798168-231d-46d7-875e-950778c3d94e",
                                                "sense_id": "82a79b0f-a188-3b17-887a-66939d07499a",
                                                "text": "„Nach dem dunkelsten und trübsten Winter seit dem Beginn flächendeckender Wetteraufzeichnung im Jahr 1951 machen die ersten wohlig warmen Sonnenstrahlen die ganze Welt verrückt […].“"
                                            },
                                            {
                                                "example_id": "daa3e5a3-2767-4d0a-8785-441e70db8b3f",
                                                "sense_id": "82a79b0f-a188-3b17-887a-66939d07499a",
                                                "text": "„Wegen der Corona-Epidemie schließen immer mehr Bundesländer flächendeckend Schulen und Kindergärten.“"
                                            },
                                            {
                                                "example_id": "4db9ea03-132b-4093-9bde-ba742a252c5c",
                                                "sense_id": "82a79b0f-a188-3b17-887a-66939d07499a",
                                                "text": "„Für die flächendeckende Nutzung von Wasserstoff als Treibstoff müsste ein dichtes Netz an Wasserstofftankstellen vorhanden sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40ae3b07-411e-4c22-ab7f-e29c5c1ea37f",
                        "source_entry_id": "c34251f3-c332-3eb4-93b2-70c8d5f12c19",
