                                                "example_id": "457b4dab-c199-4217-bc16-ddad1e66aeb1",
                                                "sense_id": "6d2dd078-ec69-30b3-9101-346544e53770",
                                                "text": "Near-synonyms: common, everyday, indigenous, ordinary, vulgar, colloquial, basilectal, demotic"
                                            },
