                ],
                "senses": [
                    {
                        "sense_id": "51886af5-f86c-3cf6-b4cf-d77bc7fafec2",
                        "entry_id": "c14f8c54-d9a8-38fc-9b0d-a5d3c57ae53f",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d472d6fe-e826-49d9-9313-53ba40c1a1ba",
                                "sense_id": "51886af5-f86c-3cf6-b4cf-d77bc7fafec2",
                                "text": "Frau Thiem ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "74f104eb-4afc-47c4-ac45-4ebcd57753d9",
                                "sense_id": "51886af5-f86c-3cf6-b4cf-d77bc7fafec2",
                                "text": "Herr Thiem wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "19680501-e6ab-4911-81e4-c165c5381f7e",
                                "sense_id": "51886af5-f86c-3cf6-b4cf-d77bc7fafec2",
                                "text": "Die Thiems fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "6c3ad9d7-e186-40e8-84a0-afc61e530e3f",
                                "sense_id": "51886af5-f86c-3cf6-b4cf-d77bc7fafec2",
                                "text": "Der Thiem trägt nie die Schals, die die Thiem ihm strickt."
                            },
                            {
                                "example_id": "226de7ff-d0dc-4b70-9810-154de09e5247",
                                "sense_id": "51886af5-f86c-3cf6-b4cf-d77bc7fafec2",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Thiem kommt, geht der Herr Thiem.“"
                            },
                            {
                                "example_id": "02d5e515-230f-492d-a875-0c8ef6742df5",
                                "sense_id": "51886af5-f86c-3cf6-b4cf-d77bc7fafec2",
                                "text": "Thiem kommt und geht."
                            },
                            {
                                "example_id": "18f9a564-8505-47cd-8f8d-886fcfba91c0",
                                "sense_id": "51886af5-f86c-3cf6-b4cf-d77bc7fafec2",
                                "text": "Thiems kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
