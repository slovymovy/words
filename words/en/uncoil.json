{
    "word_family": [
        "coil",
        "coiling",
        "coiled"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "df9bfcbc-90c8-3d40-944f-4def6a151dea",
                    "sense_definition": "To straighten or loosen something that is wound in a spiral or circular shape.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "unwind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>uncoil</w> the garden hose so we can water the plants.",
                            "target_lang_translations": {
                                "pl": "Proszę <w>rozwiń</w> wąż ogrodowy, żebyśmy mogli podlać rośliny."
                            }
                        },
                        {
                            "text": "He had to <w>uncoil</w> the rope carefully to avoid any knots.",
                            "target_lang_translations": {
                                "pl": "Musiał ostrożnie <w>odwinąć</w> linę, aby uniknąć supłów."
                            }
                        }
                    ],
                    "synonyms": [
                        "unwind",
                        "untwist"
                    ],
                    "antonyms": [
                        "coil",
                        "wind"
                    ],
                    "common_phrases": [
                        "uncoil the rope",
                        "uncoil the hose"
                    ],
                    "target_lang_definitions": {
                        "pl": "Prostować lub rozwijać coś, co jest zwinięte w spiralę lub okrąg."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rozwijać",
                                "target_lang_sense_clarification": "odnosi się do rozwijania zwiniętego przedmiotu, np. węża lub liny"
                            },
                            {
                                "target_lang_word": "odwijać",
                                "target_lang_sense_clarification": "zdejmowanie zwojów z czegoś"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "463a559a-5a08-3015-b4a0-3226a5d7eea4",
                    "sense_definition": "To straighten one's own body from a curled or spiral position.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "unwind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The large snake began to <w>uncoil</w> slowly as it felt the warmth of the sun.",
                            "target_lang_translations": {
                                "pl": "Duży wąż zaczął powoli <w>rozwijać się</w>, gdy poczuł ciepło słońca."
                            }
                        },
                        {
                            "text": "I watched the cat <w>uncoil</w> itself after a long nap on the sofa.",
                            "target_lang_translations": {
                                "pl": "Obserwowałem, jak kot <w>prostuje się</w> po długiej drzemce na kanapie."
                            }
                        }
                    ],
                    "synonyms": [
                        "stretch",
                        "unwind"
                    ],
                    "antonyms": [
                        "curl",
                        "coil"
                    ],
                    "common_phrases": [
                        "uncoil slowly"
                    ],
                    "target_lang_definitions": {
                        "pl": "Prostować własne ciało ze zwiniętej lub skulonej pozycji."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "prostować się",
                                "target_lang_sense_clarification": "przyjmowanie wyprostowanej pozycji ciała"
                            },
                            {
                                "target_lang_word": "rozwijać się",
                                "target_lang_sense_clarification": "używane w kontekście zwierząt, np. węża, wychodzących ze zwiniętej pozycji"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d293c9ab-aaa3-3685-a1f3-9e3199208f49",
                    "sense_definition": "To pass solid waste from the body.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The slang term is sometimes used to <w>uncoil</w> in a crude manner.",
                            "target_lang_translations": {
                                "pl": "Ten slangowy termin jest czasami używany, by w wulgarny sposób powiedzieć <w>wypróżnić się</w>."
                            }
                        },
                        {
                            "text": "It is highly offensive to <w>uncoil</w> in public spaces.",
                            "target_lang_translations": {
                                "pl": "Bardzo obraźliwe jest <w>sranie</w> w miejscach publicznych."
                            }
                        }
                    ],
                    "synonyms": [
                        "defecate"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Highly offensive and vulgar usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Wulgarny termin oznaczający wypróżnianie się."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wypróżniać się",
                                "target_lang_sense_clarification": "neutralne określenie fizjologicznej czynności"
                            },
                            {
                                "target_lang_word": "srać",
                                "target_lang_sense_clarification": "bardzo wulgarne określenie, odpowiadające rejestrowi angielskiego terminu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}