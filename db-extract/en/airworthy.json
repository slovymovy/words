                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40f7792e-699e-4994-b9f7-74379e3dc9e2",
                                "sense_id": "7c574cf0-8fc8-3bb9-bf41-a433b8c18664",
                                "text": "An airworthy helicopter..."
                            },
                            {
                                "example_id": "a1e7a4a5-bcdd-42ab-955b-5b5d7672c3d9",
                                "sense_id": "7c574cf0-8fc8-3bb9-bf41-a433b8c18664",
