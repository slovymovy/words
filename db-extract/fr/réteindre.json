                        "glosses": [
                            "Éteindre encore une fois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "001c24e0-ed64-4485-b7b6-f3ba602e94f6",
                                "sense_id": "f6455108-509b-3197-89f4-ac761df64246",
                                "text": "Je chicanais, j’allais éteindre ; elle rallumait, j’allais réteindre."
                            },
                            {
                                "example_id": "997eacf6-34b8-42e2-aa98-d9bdc56f9f00",
                                "sense_id": "f6455108-509b-3197-89f4-ac761df64246",
                                "text": "En clair: je fume dans Metro Shopping, je prends l’escalator et j’éteins ma clope, puis la rallume sur les quais, pour la réteindre lorsque je grimpe dans le train."
                            },
                            {
                                "example_id": "f31035aa-404e-46ef-b102-24300deaee12",
                                "sense_id": "f6455108-509b-3197-89f4-ac761df64246",
                                "text": "Ce virus va éteindre l'ordinateur dès que l'utilisateur va le lancer, et au redémarrage de la session, l'ordinateur va se réteindre."
                            }
                        ]
