                                "example_id": "220f9132-8812-4edf-b44a-665a63550527",
                                "sense_id": "128a0e04-1501-325d-bb63-3adbf0d6af87",
                                "text": "Durch den Türspion beobachtete Fr. Mayer die Spione, die die Tür des Nachbarn Müller unheimlich leise öffneten."
                            },
                            {
                                "example_id": "6612ae5f-6cfd-40ea-ae57-24d9faec3dea",
                                "sense_id": "128a0e04-1501-325d-bb63-3adbf0d6af87",
                                "text": "Aufmachen Polizei! Wir wissen, dass Sie da sind, wir haben Ihren Schatten im Türspion gesehen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
