                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5940dec-928d-4deb-91af-a0c1c3ffc370",
                                "sense_id": "eef02ef2-b58d-3625-9faa-89f6f44904a9",
                                "text": "Od XI do XV wieku Piemont był podzielony na pięć jednostek terytorialnych."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eec6d03f-d1bd-426d-a9b0-b99c36c5a9a4",
                        "source_entry_id": "c3dc22e9-3290-3030-ab29-537e13cb6e8c",
                        "source_sense_id": "eef02ef2-b58d-3625-9faa-89f6f44904a9",
                        "target_lang_word": "territorial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "territorial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ddd41efb-a701-3dc0-9df7-1bed7930953f",
                                        "entry_id": "30744e64-677a-31e0-ac60-a3ca859faf09",
                                        "glosses": [
                                            "Of, relating to, or restricted to a specific geographic area, or territory."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f8e04a61-e89a-329e-a91f-b669e36d66c2",
                                        "entry_id": "30744e64-677a-31e0-ac60-a3ca859faf09",
                                        "glosses": [
                                            "Of or relating to geography or territory."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fea13d80-1293-4d50-8cba-edce668a99a3",
                                                "sense_id": "f8e04a61-e89a-329e-a91f-b669e36d66c2",
                                                "text": "Rumania, Serbia, and Montenegro should be evacuated ; occupied territories restored ; Serbia accorded free and secure access to the sea ; and the relations of the several Balkan states to one another determined by friendly counsel along historically established lines of allegiance and nationality ; and international guarantees of the political and economic independence and territorial integrity of the several Balkan states should be entered into."
                                            },
                                            {
                                                "example_id": "45815298-2206-439b-9fbd-01733077fbfc",
                                                "sense_id": "f8e04a61-e89a-329e-a91f-b669e36d66c2",
                                                "text": "Studies have narrowed the territorial focus to signage used in specific cities, townships, suburbs, precincts, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56510b51-de04-31b8-b6be-5e1c67024378",
                                        "entry_id": "30744e64-677a-31e0-ac60-a3ca859faf09",
                                        "glosses": [
                                            "Organized for home defence - such as the Territorial Army."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "often"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "32d39bdb-45f7-3959-aa2f-b7e8bf64ac6b",
                                        "entry_id": "30744e64-677a-31e0-ac60-a3ca859faf09",
                                        "glosses": [
                                            "Displaying territoriality."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "territorial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9060e57-bde9-32c8-b434-401540c129b0",
                                        "entry_id": "8b587b23-1dfe-335a-b15b-48f65937bfc9",
                                        "glosses": [
                                            "A non-professional member of a territorial army."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a13c414b-0f69-486a-9b00-6d4b6f20f132",
                                                "sense_id": "e9060e57-bde9-32c8-b434-401540c129b0",
                                                "text": "The territorials initiated about as many ground contacts (7,175) as the communists initiated against them (7,391) and more than those initiated by the army. As expected, the enemy attacked the territorials almost three times as often as it did the army."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b95361e-4b96-4688-ad26-4cbe3283b574",
                        "source_entry_id": "c3dc22e9-3290-3030-ab29-537e13cb6e8c",
