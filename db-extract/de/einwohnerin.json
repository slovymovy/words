                    }
                ],
                "translations": [
                    {
                        "translation_id": "3812b801-ec5c-4a29-a28a-89f83025024f",
                        "source_entry_id": "05c06854-7e23-39a6-9d52-52c27d8ace18",
                        "source_sense_id": "8b6f2a3b-a5e2-3eca-ab4b-b84e8ff20836",
                        "source_sense_description": "weibliche Person, die in einem bestimmten Ort, Land oder einer bestimmten Gegend wohnt",
                        "target_lang_word": "inhabitant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inhabitant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "345c45f4-b904-3840-8217-33f3d5f10566",
                                        "entry_id": "efe7aef3-5c28-34c1-aafa-c9138b42a8c3",
                                        "glosses": [
                                            "Someone or thing who lives in a place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49cdd6e6-5ae0-461b-bd6f-291622f983b2",
                                                "sense_id": "345c45f4-b904-3840-8217-33f3d5f10566",
                                                "text": "I believed it in the same way one of you might believe there are inhabitants in the planet Mars. I knew once a Scotch sailmaker who was certain, dead sure, there were people in Mars."
                                            },
                                            {
                                                "example_id": "40efea68-9e75-47f0-8bdb-dd54294a74e3",
                                                "sense_id": "345c45f4-b904-3840-8217-33f3d5f10566",
                                                "text": "It was obvious to the inhabitants of the small coastal town of Bridport that in the midst of these squabbles their need for a railway was going to be overlooked, and they decided to take the matter into their own hands."
                                            },
                                            {
                                                "example_id": "aec6b4bb-8b01-4f91-8f55-a6f272ecb234",
                                                "sense_id": "345c45f4-b904-3840-8217-33f3d5f10566",
                                                "text": "About 98 per cent of Taiwan's inhabitants are Han Chinese, a diverse mix of ethnic and linguistic groups, including Hakka, Cantonese and Fujianese, who came from China's southern coast. Taiwan's other two per cent are from one of the nine indigenous tribes, which are scattered throughout the island but largely concentrated along the east coast and in the Central Mountain Range."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c6085fa-edd5-35db-9008-5b7c7d07af97",
                                        "entry_id": "efe7aef3-5c28-34c1-aafa-c9138b42a8c3",
                                        "glosses": [
                                            "A possible value for a type."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c070f3b0-f6cd-4e56-b2b0-a4774281d711",
                                                "sense_id": "1c6085fa-edd5-35db-9008-5b7c7d07af97",
                                                "text": "One way to observe this connection with mathematics is by mapping each type to its cardinality, a count of the inhabitants of that type."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "inhabitant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "275a7689-faf7-3788-b72f-3e22b71c2026",
                                        "entry_id": "1faf802d-3de8-3826-8689-6fc852e298e3",
                                        "glosses": [
                                            "resident"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
