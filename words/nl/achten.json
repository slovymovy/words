                        {
                            "text": "We spreken af om een uur of <w>achten</w> bij de bioscoop.",
                            "target_lang_translations": {
                                "en": "We'll meet at the cinema around <w>eight</w>."
                            }
                        }
                    ],
                    "common_phrases": [
