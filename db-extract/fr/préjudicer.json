                        ],
                        "examples": [
                            {
                                "example_id": "3a755a42-bc0f-4285-be44-371c960e5aa1",
                                "sense_id": "a3f5a3a0-e9ce-3300-b885-eb912eb34d68",
                                "text": "Le vieux Mandarin rit de sa priere, & l’assura qu’il ne feroit jamais rien qui pût préjudicer à son bonheur & à sa réputation."
                            },
                            {
                                "example_id": "9c88a9a3-cffa-4467-9bf9-2a6e7bf5c60c",
                                "sense_id": "a3f5a3a0-e9ce-3300-b885-eb912eb34d68",
                                "text": "Qu’il n'en étoit pas de même du Roi d’Espagne, qui n’en aiant que de Catoliques, pouvoit se conformer aux volontés du Pape sans préjudicer à ses Etats."
                            }
                        ]
                    }
