                "translations": [
                    {
                        "translation_id": "50793559-765b-491b-bc0e-4d7d917d67ff",
                        "source_entry_id": "5eed1cb5-f7f9-32eb-8110-759c421dc7fa",
                        "source_sense_id": "54f9d55d-1e4b-34f9-ab4d-a5749da565b8",
                        "target_lang_word": "verschwenderisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verschwenderisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "59f4efa0-fd1a-325e-803d-7e650834b82b",
                                        "entry_id": "1bd285e2-ae84-36e0-9f0f-186e9c81baeb",
                                        "glosses": [
                                            "unbedacht beim Ausgeben von Geld oder beim Einsatz von Vermögen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9c09896-5d92-4929-8426-d2ebc0c33230",
                                                "sense_id": "59f4efa0-fd1a-325e-803d-7e650834b82b",
                                                "text": "Offensichtlich haben Regierungen in Griechenland ein verschwenderisches Finanzgebaren mindestens von 2002 bis 2014 an den Tag gelegt."
                                            },
                                            {
                                                "example_id": "036c55b8-914b-44d5-8685-14f113bc4cd9",
                                                "sense_id": "59f4efa0-fd1a-325e-803d-7e650834b82b",
                                                "text": "Nirgendwo werden die Folgen des verschwenderischen Umgangs mit den Ressourcen so deutlich spürbar wie in dem Wirtschaftswunderland China. Über 80 Prozent der Flüsse gelten als verseucht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e35a0f23-3d93-3b17-a729-4b9d13b1475b",
                                        "entry_id": "1bd285e2-ae84-36e0-9f0f-186e9c81baeb",
                                        "glosses": [
                                            "in großer, nahezu unbegrenzter Menge vorhanden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "557cfc70-d984-49a6-a65b-89a9a0d8b639",
                                                "sense_id": "e35a0f23-3d93-3b17-a729-4b9d13b1475b",
                                                "text": "Hauptsächlich haben drei Gründe zu dieser 0:1-Niederlage [des FC Bayern München] geführt, die deutlich höher hätte ausfallen können, wäre Real [Madrid] nicht so verschwenderisch mit seinen Chancen umgegangen."
                                            },
                                            {
                                                "example_id": "ca96b11e-732f-4389-b742-efe1e14c7359",
                                                "sense_id": "e35a0f23-3d93-3b17-a729-4b9d13b1475b",
                                                "text": "Hamburg ist ’ne feine Stadt. Verschwenderisch ausgestattet mit weitläufigen Parks, lauen und stürmischen Gewässern wie Alster und Elbe, beschaulichen Wassergräben – die hier Fleet heißen – ansehnlichen Fassaden aus des Kaufmanns Ära, mit Wandelhallen für Flaneure."
                                            },
                                            {
                                                "example_id": "c55432d4-fbd3-4c8f-847d-b1283f8ee8f4",
                                                "sense_id": "e35a0f23-3d93-3b17-a729-4b9d13b1475b",
                                                "text": "Seiner Einschätzung nach [nach der des stellvertretenden Landesvorsitzenden des BUND in Bayern, Sebastian Schönauer] wird insgesamt viel zu sorglos und verschwenderisch mit Medikamenten umgegangen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "58662e32-a703-412d-8464-02d088f6664c",
                        "source_entry_id": "5eed1cb5-f7f9-32eb-8110-759c421dc7fa",
                        "source_sense_id": "54f9d55d-1e4b-34f9-ab4d-a5749da565b8",
                        "target_lang_word": "wasteful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wasteful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6c47a904-d10e-3570-86ea-f9c49e712701",
                                        "entry_id": "a35116ad-57cf-3c11-b1ab-0384abe2f135",
                                        "glosses": [
                                            "Inclined to waste or squander money or resources."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "446d239d-1a1a-4c56-a3e1-7e03961ea569",
                                                "sense_id": "6c47a904-d10e-3570-86ea-f9c49e712701",
                                                "text": "As a narrative, competition of the type seen between the London Midland & Scottish Railway (LMS) and the London & North Eastern Railway (LNER) was seen as wasteful, with duplicate routes reflecting an unnecessary use of resources."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adfcd3ba-e150-38bc-aa3e-b80814e7bc6e",
                                        "entry_id": "a35116ad-57cf-3c11-b1ab-0384abe2f135",
                                        "glosses": [
                                            "Uninhabited, desolate."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd26e3bd-e405-4d5b-8e28-8a9710250f39",
                                                "sense_id": "adfcd3ba-e150-38bc-aa3e-b80814e7bc6e",
                                                "text": "Shortly vnto the vvaſtefull vvoods ſhe came, / VVhereas ſhe found the Goddeſſe vvith her crevv, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f00bf52-0e05-41fc-a938-7fde08df4a28",
                        "source_entry_id": "5eed1cb5-f7f9-32eb-8110-759c421dc7fa",
                        "source_sense_id": "54f9d55d-1e4b-34f9-ab4d-a5749da565b8",
                        "target_lang_word": "dépensier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dépensier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c3a00f35-15fc-3348-ade3-80fe6a356845",
                                        "entry_id": "462ee128-34b6-3609-adcc-7e079a7a01f7",
                                        "glosses": [
                                            "Qui dépense excessivement, qui aime à dépenser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fca01d2b-b314-4279-b23d-b351a0dd8cd8",
                                                "sense_id": "c3a00f35-15fc-3348-ade3-80fe6a356845",
                                                "text": "Je connais Victor : sa gaieté est une gaieté sans esprit, une gaieté de caserne, il est sans talent et dépensier."
                                            },
                                            {
                                                "example_id": "b5346a86-2123-4002-9d50-ed58f6989f4f",
                                                "sense_id": "c3a00f35-15fc-3348-ade3-80fe6a356845",
                                                "text": "Le duc d’Orléans était leur garant, leur pavillon, leur espoir. Ils le savaient futile, versatile, influençable, […], aussi dépourvu de sens critique que de sens pratique, joueur, débauché, dépensier."
                                            },
                                            {
                                                "example_id": "672c4ed3-3fa2-4068-aeac-388af75c1690",
                                                "sense_id": "c3a00f35-15fc-3348-ade3-80fe6a356845",
                                                "text": "Les conservateurs ne manquèrent cependant de me reprocher à l'époque ma prétendue faiblesse vis-à-vis des services dépensiers."
                                            },
                                            {
                                                "example_id": "7bae40b9-85c3-482c-9e2e-37b6fef588dd",
                                                "sense_id": "c3a00f35-15fc-3348-ade3-80fe6a356845",
                                                "text": "Gaspilleur, qui verse sans compter."
                                            },
                                            {
                                                "example_id": "2ff7d419-c35b-4888-9e29-3f82be20546a",
                                                "sense_id": "c3a00f35-15fc-3348-ade3-80fe6a356845",
                                                "text": "Les hommes, qui sont si follement dépensiers de leur sang…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dépensier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f1f27685-0b55-3357-82f4-c9e93d9bc6ee",
                                        "entry_id": "5a39f2c0-ec52-37e4-a06d-9b53e18d506a",
                                        "glosses": [
                                            "Économe en charge de la dépense dans une communauté religieuse, un internat scolaire, ou autre organisation semblable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dcd76a5-6378-4103-9916-6b373290573a",
                                                "sense_id": "f1f27685-0b55-3357-82f4-c9e93d9bc6ee",
                                                "text": "La dépensière du couvent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0930fd66-8aba-3723-a41c-441110b989a7",
                                        "entry_id": "5a39f2c0-ec52-37e4-a06d-9b53e18d506a",
                                        "glosses": [
                                            "Trésorier au sein d'une association, d'un groupe."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45e8bd92-8798-4bea-9828-09801dd002cf",
                                                "sense_id": "0930fd66-8aba-3723-a41c-441110b989a7",
                                                "text": "Une fille très jolie, accorte et fine, Line, dirigeait admirablement ce relais galant et tenait lieu de dépensière, d’économe, de caviste et de cuisinière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d09a57b3-d87d-3a70-80fc-c2219ea7b900",
                                        "entry_id": "5a39f2c0-ec52-37e4-a06d-9b53e18d506a",
                                        "glosses": [
                                            "Personne qui dépense sans compter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96d70c2d-351a-4de6-b308-0717f56708ea",
                                                "sense_id": "d09a57b3-d87d-3a70-80fc-c2219ea7b900",
                                                "text": "Le grand dépensier Napoléon III fait repriser ses chaussettes à raison de 24 centimes le reprisage."
                                            },
                                            {
                                                "example_id": "a18df333-bfbb-4069-971f-6edfcb9efc40",
                                                "sense_id": "d09a57b3-d87d-3a70-80fc-c2219ea7b900",
                                                "text": "Lantier est un ambitieux, un dépensier, un homme qui ne songe qu'à son amusement."
                                            },
                                            {
                                                "example_id": "345aa23c-a5dc-4cf1-8e8f-d357b1e41df1",
                                                "sense_id": "d09a57b3-d87d-3a70-80fc-c2219ea7b900",
                                                "text": "C’est une grande dépensière."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
