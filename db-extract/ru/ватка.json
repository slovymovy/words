                    }
                ],
                "senses": [
                    {
                        "sense_id": "4df3c468-2db3-33db-8188-70a47e48c01f",
                        "entry_id": "81826f51-914d-3ddb-914e-171fdb9e2111",
                        "glosses": [
                            "разг. кусочек ваты"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e872aec-8ad0-49ca-bfc5-b299a9a61d1d",
                                "sense_id": "4df3c468-2db3-33db-8188-70a47e48c01f",
                                "text": "И в каком порядке он держал свой станок: он пыль с него сдувал и каждый винтик гигроскопической ваткой обтирал."
                            },
                            {
                                "example_id": "9a69d781-6a31-4f4c-ad83-ac330a4791ca",
                                "sense_id": "4df3c468-2db3-33db-8188-70a47e48c01f",
                                "text": "Когда один цилиндр вставляли в другой, бляшка соприкасалась с ваткой, и ватка загоралась."
                            },
                            {
                                "example_id": "4151a72c-263d-4c05-b57f-fb8382ae93b8",
                                "sense_id": "4df3c468-2db3-33db-8188-70a47e48c01f",
                                "text": "Максим ощутил на руке холодок проспиртованной ватки."
                            }
                        ]
                    },
                    {
                        "sense_id": "6b52690f-6270-3fc3-bcb1-5fceda373a3e",
                        "entry_id": "81826f51-914d-3ddb-914e-171fdb9e2111",
                        "glosses": [
                            "уменьш.-ласк., редк. вата"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdb76608-c19d-43d1-8927-745b9d24f4cd",
                                "sense_id": "6b52690f-6270-3fc3-bcb1-5fceda373a3e",
                                "text": "Мастерскую выбелили заново, стёкла промыли с мелом; между рамами насыпаны для тепла опилки, прикрыты ваткой, а по ватке разложены шерстинки, — зелёные, голубые, красные."
                            }
                        ]
                    }
                ],
