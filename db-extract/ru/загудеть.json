                    },
                    {
                        "form_id": "fe6cc9d6-81eb-420d-9ec9-81d26d9db3db",
                        "entry_id": "68f88f8a-e8ed-3e61-9931-6df74bef9694",
                        "tags": [
                            "imperative",
                            "second-person"
                        ],
                        "form": "загуди́те"
                    },
                    {
                        "form_id": "3d014c30-4b15-41d8-9142-41f4ada5ebed",
                        "entry_id": "68f88f8a-e8ed-3e61-9931-6df74bef9694",
                        "tags": [
                            "participle",
