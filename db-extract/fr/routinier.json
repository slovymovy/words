                                        "sense_id": "6c1e02d6-42df-3451-a83a-e5338c2a1abd",
                                        "entry_id": "f1ef4bd0-d748-35df-9637-1ec00775a8df",
                                        "glosses": [
                                            "A performance, execution of gymnastics for one of the apparatus."
