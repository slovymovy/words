                "senses": [
                    {
                        "sense_id": "ff39395c-e4d7-34af-9343-aac191278fc1",
                        "entry_id": "49c12169-ffb2-39bc-b845-5d82e9c173ad",
                        "glosses": [
                            "S'écrouler, tomber (par exemple en avalanche)."
                        ],
                        "tags": [
                            "Suisse"
                        ],
                        "examples": [
                            {
                                "example_id": "39910156-e52d-4296-8dba-4a92de557871",
                                "sense_id": "ff39395c-e4d7-34af-9343-aac191278fc1",
                                "text": "Il se tient debout devant la gosse, dense, menaçant comme un pan de montagne sur le point d’avalancher."
                            },
                            {
                                "example_id": "294660ff-7bd7-4185-bb42-7112eb59b937",
                                "sense_id": "ff39395c-e4d7-34af-9343-aac191278fc1",
                                "text": "Une « nécessité inexorable les oblige pourtant à s'avalancher dans ces abîmes où la station verticale est impossible, la position horizontale atroce, la position roulante horrible."
                            },
                            {
                                "example_id": "06cb9d98-8394-412c-bee9-8dddad84f423",
                                "sense_id": "ff39395c-e4d7-34af-9343-aac191278fc1",
                                "text": "eh bien je n'ai pas bougé d'un poil, pas même esquissé le moindre geste de recul, comme lorsqu'une montagne est sur le point de vous avalancher sur la tête."
                            }
                        ]
                    }
