                ],
                "senses": [
                    {
                        "sense_id": "42e88f7f-9fb6-37a9-adab-31cf514143f2",
                        "entry_id": "7c785c16-d694-3495-90bf-81cfd8564192",
                        "glosses": [
                            "transitif indirect Faire de manière active, dynamique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "460e0ae6-4778-4602-9f1a-3404718e1754",
                                "sense_id": "42e88f7f-9fb6-37a9-adab-31cf514143f2",
                                "text": "Révérente dans son caraco gris, […], Léonie s’activait à repriser du linge de corps en bonne toile de chanvre très ancienne."
                            }
                        ]
                    },
                    {
                        "sense_id": "9dd46d71-46ae-33bd-bcc2-62f6c62f4403",
                        "entry_id": "7c785c16-d694-3495-90bf-81cfd8564192",
                        "glosses": [
                            "intransitif Se mettre en activité, en mouvement, au travail."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06633690-07e4-4499-9058-e1088267d603",
                                "sense_id": "9dd46d71-46ae-33bd-bcc2-62f6c62f4403",
                                "text": "Ma grand-mère disait que l'avenir appartient à ceux qui se lèvent tôt, mais je ne crois pas que c'est pour cette raison que je m'activais dès la demi-clarté."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd6a7b51-6351-3e02-bae5-6aeb29a09a34",
                        "entry_id": "7c785c16-d694-3495-90bf-81cfd8564192",
                        "glosses": [
                            "intransitif Agir, travailler de manière dynamique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30fe90fe-0dab-4cc3-905b-d5de96fae87b",
                                "sense_id": "fd6a7b51-6351-3e02-bae5-6aeb29a09a34",
                                "text": "La commande leur parviendra rapidement grâce à une armée de livreurs qui s’activeront dans les gradins tout au long du match."
                            }
                        ]
                    },
                    {
                        "sense_id": "9de92594-935f-355b-b8ba-a3b20e8f2ca0",
                        "entry_id": "7c785c16-d694-3495-90bf-81cfd8564192",
                        "glosses": [
                            "intransitif Mener une vie active."
                        ],
                        "tags": [
                            "Plus rare"
                        ],
                        "examples": [
                            {
                                "example_id": "889013e0-d9f8-42ce-bb7a-138767ceb1aa",
                                "sense_id": "9de92594-935f-355b-b8ba-a3b20e8f2ca0",
                                "text": "Le Réseau FADOQ fait partie de la vie quotidienne des personnes de 50 ans et plus, leur permettant d'économiser, de s'activer, de socialiser et de prendre pleinement leur place dans la société québécoise."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e32bc14-8429-4471-9ff1-59139e7da544",
                        "source_entry_id": "7c785c16-d694-3495-90bf-81cfd8564192",
                        "target_lang_word": "get to work",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5c14a3b7-c6a5-4b5e-a063-97b48cf14749",
                        "source_entry_id": "7c785c16-d694-3495-90bf-81cfd8564192",
                        "target_lang_word": "get busy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "get busy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dc232c4f-bae0-31ef-bb65-b073079eea68",
                                        "entry_id": "183a5b2a-a73c-3333-9572-b26046769517",
                                        "glosses": [
                                            "To cease to be idle and start working."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "380d85f4-6c58-4834-9dd8-b27d9b46686c",
                                                "sense_id": "dc232c4f-bae0-31ef-bb65-b073079eea68",
                                                "text": "Stop playing computer games, and get busy with your homework."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "570d3604-a64f-32f9-b5de-e51bc73691db",
                                        "entry_id": "183a5b2a-a73c-3333-9572-b26046769517",
                                        "glosses": [
                                            "To have sex."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c07bcb1e-fdf4-45a2-b560-793a7974dc15",
                                                "sense_id": "570d3604-a64f-32f9-b5de-e51bc73691db",
                                                "text": "The couple were getting busy in the front room when the doorbell rang."
                                            },
                                            {
                                                "example_id": "173876d8-1d82-4160-a1e1-6d48e4bc2c0f",
                                                "sense_id": "570d3604-a64f-32f9-b5de-e51bc73691db",
                                                "text": "Homer and Marge have to try to explain things to children who are too worldly to fall for most excuses, the explanation trails off, and what could be a pleasant family outing to solve it all turns out to be yet another excuse for self-involvement when one public humiliation doesn’t outweigh the joys of getting busy in a windmill."
                                            },
                                            {
                                                "example_id": "14f69e20-f315-4e80-9105-fb8309621b49",
                                                "sense_id": "570d3604-a64f-32f9-b5de-e51bc73691db",
                                                "text": "Alyx Vance: Did Dr. Kleiner just say to everyone that they should get busy?"
                                            },
                                            {
                                                "example_id": "2f863b13-8423-406c-8496-2af7e4a67de7",
                                                "sense_id": "570d3604-a64f-32f9-b5de-e51bc73691db",
                                                "text": "Thurl: Are you busy?\nAlexia: Really? The days pass like decades in here, Thurl. We won't be busy until that worldship decides to talk back to us.\nThurl: And yet, you have been…\nAlexia: Thurl. If you say \"getting busy\" I will punch you so hard you'll have to spawn child processes just to feel all the pain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
