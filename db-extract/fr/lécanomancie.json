                "senses": [
                    {
                        "sense_id": "49c4590b-a230-39e1-a6fd-5be93abc4a65",
                        "entry_id": "003c6ad7-38d4-3c42-a02c-aa2babb5e87c",
                        "glosses": [
                            "Divination qui se pratiquait en jetant dans un bassin plein d'eau des pierres précieuses et des métaux, et en observant le son que ces objets produisaient quand ils touchaient le fond."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "aa232926-39be-4bf5-b221-202b766a8e90",
                                "sense_id": "49c4590b-a230-39e1-a6fd-5be93abc4a65",
                                "text": "La géomancie nous donne l’art de deviner par les signes de la terre ; ce secret-ci nous vient des Arabes ; l’hidromancie nous apprend à deviner par l’eau ; l’aéromancie par les signes de l’air ; la piromancie par ceux du feu ; la lécanomancie, par l’usage d’un bassin ; la chiromancie, par l’inspection des mains ; la métoposcopie, par celle des signes du front ; la cristalomancie, par le secours du verre ou du miroir. Cirile de Jérusalem au Traité de l’adoration, dit que de son tems on évoquoit aussi les spectres. La cléromancie n’a recours qu’au sort ; la bibliomancie est l’art de deviner par les livres ; la céphalomancie par le moyen de la tête d’un âne ; la capnomancie par la fumée ; la botanomancie par les simples, la lictiomancie par les poissons, la dactylomancie par des anneaux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c753b79-2652-4618-b48a-9add9c11554f",
                        "source_entry_id": "003c6ad7-38d4-3c42-a02c-aa2babb5e87c",
                        "source_sense_id": "49c4590b-a230-39e1-a6fd-5be93abc4a65",
                        "target_lang_word": "lecanomancy",
