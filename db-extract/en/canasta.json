        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a42125ae-d2fc-3459-b69d-046bb83b04ca",
                "word": "canasta",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "54318b25-70b3-4e34-8f1c-be0644b8320d",
                        "entry_id": "a42125ae-d2fc-3459-b69d-046bb83b04ca",
                        "tags": [
                            "plural"
                        ],
                        "form": "canastas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "278183b5-46e8-380a-b206-62318e458b80",
                        "entry_id": "a42125ae-d2fc-3459-b69d-046bb83b04ca",
                        "glosses": [
                            "A card game similar to rummy and played using two packs, where the object is to meld groups of the same rank."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "11308cd5-9769-4b00-8f94-d79b723dcc1f",
                                "sense_id": "278183b5-46e8-380a-b206-62318e458b80",
                                "text": "“Do you know something, Fred?” she announced, “I won four dollars and eighty-five cents playing Canasta this afternoon.”\n“Canasta!” exclaimed Mr. Grimes, “I didn′t know you could play that silly game.”"
                            },
                            {
                                "example_id": "d079cec2-752f-4aac-a1a2-6a81e3fd3edb",
                                "sense_id": "278183b5-46e8-380a-b206-62318e458b80",
                                "text": "Imagine, first, two players who engage in a game of canasta according to a standard set of rules.[…]We may imagine, however, that at a certain moment the two canasta players cease to play canasta and start a discussion of the rules."
                            },
                            {
                                "example_id": "9e55a452-d0b8-4bb1-99f6-0115915df24f",
                                "sense_id": "278183b5-46e8-380a-b206-62318e458b80",
                                "text": "Modern American Canasta is a younger cousin of the game of Canasta I explain here."
                            }
                        ]
                    },
                    {
                        "sense_id": "3fbcb27c-8e59-395b-a266-c3c0b3ecbf93",
                        "entry_id": "a42125ae-d2fc-3459-b69d-046bb83b04ca",
                        "glosses": [
                            "A meld of seven cards in a game of canasta."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "b5921891-55ac-427e-b724-f0ace4f8c754",
                                "sense_id": "3fbcb27c-8e59-395b-a266-c3c0b3ecbf93",
                                "text": "Groups of seven of a kind are called canastas, and before a player can go out he or his partner must have at least one canasta."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1ef7db1-8a00-4922-9526-2fa03d01f156",
                        "source_entry_id": "a42125ae-d2fc-3459-b69d-046bb83b04ca",
