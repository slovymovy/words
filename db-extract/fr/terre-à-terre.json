                "senses": [
                    {
                        "sense_id": "8c262fee-488c-396c-a4e2-f63c0f27dff1",
                        "entry_id": "825055cf-5f4f-3d99-8100-ecff4dceb114",
                        "glosses": [
                            "Qui ne s’élève pas au-dessus des réalités de la vie pratique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04b3f3ba-3fdb-4941-9c14-32d0828730bf",
                                "sense_id": "8c262fee-488c-396c-a4e2-f63c0f27dff1",
                                "text": "Le décalage s'accentuait d'autant plus que le monde de l’Assistance a évolué, concernant de nouveaux domaines de la vie quotidienne beaucoup plus terre-à-terre (assistance et aide quotidienne en cas d'hospitalisation par exemple)."
                            },
                            {
                                "example_id": "a8ed0936-4c6c-4a3b-ad5f-620bebe5a94c",
                                "sense_id": "8c262fee-488c-396c-a4e2-f63c0f27dff1",
                                "text": "Il adapta ses ambitions à des considérations plus terre à terre comme trouver un petit boulot pour se nourrir."
                            },
                            {
                                "example_id": "dd0808aa-f145-4213-aaab-6ba448109a39",
                                "sense_id": "8c262fee-488c-396c-a4e2-f63c0f27dff1",
                                "text": "Plus terre à terre que lui, il fallait vraiment être un concombre ou une patate !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "63235d6e-b984-4da1-895c-933aa9c803df",
                        "source_entry_id": "825055cf-5f4f-3d99-8100-ecff4dceb114",
                        "source_sense_id": "8c262fee-488c-396c-a4e2-f63c0f27dff1",
                        "target_lang_word": "down-to-earth",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "down-to-earth",
