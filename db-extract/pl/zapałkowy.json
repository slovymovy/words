                "translations": [
                    {
                        "translation_id": "c32a6354-95ce-430c-b7c1-3e804764e6ad",
                        "source_entry_id": "11a884cb-1524-3f71-9a63-65ffedea187d",
                        "source_sense_id": "7c5f23ab-3496-3f11-915b-61c4e9b6e877",
                        "target_lang_word": "zápalkový",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3bf2d122-3365-4cd7-be9f-c9f8c3d42caa",
                        "source_entry_id": "11a884cb-1524-3f71-9a63-65ffedea187d",
                        "source_sense_id": "7c5f23ab-3496-3f11-915b-61c4e9b6e877",
                        "target_lang_word": "Streichholz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Streichholz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "973494c4-cb7f-37bb-91f1-161af69c269c",
                                        "entry_id": "24a5f294-d4c2-3783-a3a0-b451f0bb7254",
                                        "glosses": [
                                            "Stäbchen aus Holz, an dessen Kopf sich ein Material befindet, das sich – sobald man es über angeraute Pappe streicht – leicht entzündet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a883a90e-16f1-44fa-8990-d13ff0ad979d",
                                                "sense_id": "973494c4-cb7f-37bb-91f1-161af69c269c",
                                                "text": "Ich zünde mit dem Streichholz eine Kerze an."
                                            },
                                            {
                                                "example_id": "fb179d38-83eb-41ba-ada0-8283ff5c20e2",
                                                "sense_id": "973494c4-cb7f-37bb-91f1-161af69c269c",
                                                "text": "„Bei uns hatte keiner ein Streichholz, um eine Kerze anzuzünden.“"
                                            },
                                            {
                                                "example_id": "c8d0e8b5-e8e2-4796-9120-cb14ff190270",
                                                "sense_id": "973494c4-cb7f-37bb-91f1-161af69c269c",
                                                "text": "„Herr Pums sucht auf dem Tisch Streichhölzer für seine Zigarre.“"
                                            },
                                            {
                                                "example_id": "7deaeacb-3e0e-42c4-8006-a700ba684a42",
                                                "sense_id": "973494c4-cb7f-37bb-91f1-161af69c269c",
                                                "text": "„Nun muss Feuer gemacht werden, und zwar ohne Streichhölzer oder Feuerzeug auf Massaiart.“"
                                            },
                                            {
                                                "example_id": "c5367aff-2b11-4ca2-aa77-27e378fb9a73",
                                                "sense_id": "973494c4-cb7f-37bb-91f1-161af69c269c",
                                                "text": "„Er suchte nach der Zigarettenschachtel und konnte dann kein Streichholz anreißen: die zweite Hand fehlte.“"
                                            },
                                            {
                                                "example_id": "09110d03-0ea7-47b2-bd5a-e8ef6cedfecf",
                                                "sense_id": "973494c4-cb7f-37bb-91f1-161af69c269c",
                                                "text": "„Dann ließ er sich von der Mutter die Streichhölzer geben, die sie stets bei sich am Körper trug, denn Streichhölzer dürfen nicht so in der Stube herumliegen.“"
                                            },
                                            {
                                                "example_id": "d97202ba-3caa-4380-81a6-0db1f4b04ce4",
                                                "sense_id": "973494c4-cb7f-37bb-91f1-161af69c269c",
                                                "text": "„Bei 38 Streichhölzern pro Packung und geschätzten 40 bis 50 Cent für die 10er-Packung sind Streichhölzer in jedem Fall etwas teurer als billige Einwegfeuerzeuge.“"
                                            },
                                            {
                                                "example_id": "7af39dac-48b0-4d5d-8b0c-a3c6fc5d5087",
                                                "sense_id": "973494c4-cb7f-37bb-91f1-161af69c269c",
                                                "text": "[30.01.1930, Zündwarenmonopol in Deutschland:] „Aufgrund dieses Gesetzes durften von da an Streichhölzer im Deutschen Reich nur von der DZMG vertrieben werden […].“"
                                            },
                                            {
                                                "example_id": "f96ff8ad-4bd2-4936-944a-3a33ee7bbfad",
                                                "sense_id": "973494c4-cb7f-37bb-91f1-161af69c269c",
                                                "text": "„Nach 1830 wurde weißer Phosphor zur Herstellung von Streichhölzern verwendet […].“"
                                            },
                                            {
                                                "example_id": "fbf5159a-c520-4345-b069-6588ce7ef096",
                                                "sense_id": "973494c4-cb7f-37bb-91f1-161af69c269c",
                                                "text": "[Singapur:] „Auch ein weggeworfenes Streichholz kann schnell zur teuren Nachlässigkeit werden. Wer erstmals ertappt wird, kommt für kleinere Abfälle noch mit einer Strafe von 150 Singapur-Dollar (94 Euro) davon.“"
                                            },
                                            {
                                                "example_id": "61a8c691-5e3e-47c6-9395-67b7f9d4d468",
                                                "sense_id": "973494c4-cb7f-37bb-91f1-161af69c269c",
                                                "text": "„Die Anklage hatte ihn während des Prozesses als \"Speerspitze dieses Mobs\" bezeichnet. »Er hat das Streichholz angezündet, das das Feuer entfacht hat.«“"
                                            },
                                            {
                                                "example_id": "1c9ae189-f008-4279-80ac-434af8237884",
                                                "sense_id": "973494c4-cb7f-37bb-91f1-161af69c269c",
                                                "text": "„Wie der Tankwagen Feuer fangen konnte, blieb zunächst unklar. Ein Mitarbeiter des Roten Kreuzes und verschiedene Augenzeugen gaben an, das Feuer sei von Streichhölzern ausgelöst worden, als sich jemand eine Zigarette ansteckte.“"
                                            },
                                            {
                                                "example_id": "f884b4e2-e77d-4521-b8fc-b390762d60cd",
                                                "sense_id": "973494c4-cb7f-37bb-91f1-161af69c269c",
                                                "text": "„Der Wald fängt nicht von alleine Feuer, da muss schon jemand ein Streichholz anzünden.“"
                                            },
                                            {
                                                "example_id": "db12e5f8-e8dc-4517-9eca-9fd81f2c6f43",
                                                "sense_id": "973494c4-cb7f-37bb-91f1-161af69c269c",
                                                "text": "„Das Problem in den Tropenländern liegt in der Entfernung des Waldes zugunsten der Agroindustrie, per Bulldozer, Motorsäge und dem Streichholz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8520591b-8abe-4fd4-a2fc-d96cc4aa652a",
                        "source_entry_id": "11a884cb-1524-3f71-9a63-65ffedea187d",
                        "source_sense_id": "7c5f23ab-3496-3f11-915b-61c4e9b6e877",
                        "target_lang_word": "Zündholz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zündholz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cdb8f355-ef90-3907-b6f1-a4b75f3aa308",
                                        "entry_id": "72793497-02f5-373a-aefe-142fccc20936",
                                        "glosses": [
                                            "fachsprachlich: Holzstäbchen, an dessen Kopf sich ein Material befindet, das sich – sobald man es über angeraute Pappe streicht – leicht entzündet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a67a067c-f606-4d25-a702-719d9bda7ea6",
                                                "sense_id": "cdb8f355-ef90-3907-b6f1-a4b75f3aa308",
                                                "text": "„Fabian nahm eine Zigarette und strich das Zündholz so behutsam an, als fürchte er, der Reibfläche weh zu tun.“"
                                            },
                                            {
                                                "example_id": "60f669d7-a40b-431d-9744-9e06886a4932",
                                                "sense_id": "cdb8f355-ef90-3907-b6f1-a4b75f3aa308",
                                                "text": "„Dann holte er ein paar Zündhölzer hervor und gab sie dem Mann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
