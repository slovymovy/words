                    {
                        "sense_id": "c34ad59b-caa9-3113-bcc1-b333699cd1fe",
                        "entry_id": "ecc84fc6-f3c8-3d5b-9f85-66fd20cd2e10",
                        "glosses": [
                            "Bezeichnung für augenblicklich schlechtes, ungünstiges Wetter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b0cd6c6-868c-4858-a520-948b8ff2bb7e",
                                "sense_id": "c34ad59b-caa9-3113-bcc1-b333699cd1fe",
                                "text": "Das Schlechtwetter im Herbst legt sich aufs Gemüt und man liegt dann lieber vorm wärmenden Kamin."
                            },
                            {
                                "example_id": "4e4b572c-81c6-4792-8c3c-bd28990806d6",
                                "sense_id": "c34ad59b-caa9-3113-bcc1-b333699cd1fe",
                                "text": "„Obwohl alles nach Schlechtwetter aussieht, geht kein Wind, das Wasser liegt still und wie gelähmt unter dem vielen Grau.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
