                "senses": [
                    {
                        "sense_id": "c7171125-d3bc-3b81-9f6c-1cb2dc08926c",
                        "entry_id": "b72c9d6b-87a1-301a-9410-6d2803385912",
                        "glosses": [
                            "Lipoprotein von niederer Dichte (Low Density Lipoprotein)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8ddd106-ea3b-470a-9663-84be975962d2",
                                "sense_id": "c7171125-d3bc-3b81-9f6c-1cb2dc08926c",
                                "text": "Entgegen der landläufigen Meinung senkt Knoblauch nicht den Spiegel des „bösen“ LDL-Cholesterins (Low Density Lipoprotein), das mitverantwortlich für die Entstehung von Arteriosklerose und Herzkrankheiten ist."
                            },
                            {
                                "example_id": "b4d6dec6-e798-41d3-80de-d65567c6bf3f",
                                "sense_id": "c7171125-d3bc-3b81-9f6c-1cb2dc08926c",
                                "text": "Bei manchen erhöht sich tatsächlich nach einer Eier-Speise das als schädlich geltende LDL-Cholesterin im Blut – allerdings so minimal, dass Mediziner diesem Effekt keine Bedeutung beimessen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "71cfbc8d-6c5c-4dff-9bff-cead7de554b4",
