    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bce08239-349a-3bb0-9295-9db2f02cf095",
                    "sense_definition": "Être employé de façon impersonnelle dans des formules de politesse ou de courtoisie.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "politesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pourriez-vous m'indiquer le chemin de la gare, s'il vous <w>plaît</w> ?"
                        },
                        {
                            "text": "Passe-moi le pain s'il te <w>plaît</w>, la corbeille est trop loin de moi."
                        }
                    ],
                    "common_phrases": [
                        "s'il vous plaît",
                        "s'il te plaît"
                    ]
                },
                {
                    "sense_id": "c0e880de-561f-3c88-b8cb-cfd4f19478aa",
                    "sense_definition": "Être agréable, convenir au goût ou susciter l'attrait de quelqu'un.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle robe rouge lui <w>plaît</w> beaucoup et lui va parfaitement bien."
                        },
                        {
                            "text": "Son discours franc a su <w>plaire</w> aux électeurs rassemblés sur la place."
                        }
                    ],
                    "synonyms": [
                        "agréer",
                        "séduire",
                        "charmer"
                    ],
                    "antonyms": [
                        "déplaire",
                        "répugner"
                    ],
                    "common_phrases": [
                        "plaire à tout le monde",
                        "chercher à plaire"
                    ]
                },
                {
                    "sense_id": "8de57911-5969-329a-8200-01f48504da5a",
                    "sense_definition": "Se trouver bien dans un lieu ou dans une situation déterminée.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bien-etre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis qu'ils ont déménagé en province, ils se <w>plaisent</w> énormément dans leur maison."
                        },
                        {
                            "text": "Mon frère s'est vite <w>plu</w> à l'université après un début un peu difficile."
                        }
                    ],
                    "synonyms": [
                        "s'acclimater"
                    ],
                    "common_phrases": [
                        "bien se plaire",
                        "se plaire ici"
                    ]
                },
                {
                    "sense_id": "33b40259-26dc-3f81-95e6-2e225db82ea8",
                    "sense_definition": "Prendre plaisir ou trouver de la satisfaction à faire une action.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sentiment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il se <w>plaît</w> à raconter des anecdotes amusantes pour détendre l'atmosphère lors des réunions."
                        },
                        {
                            "text": "L'écrivain se <w>plaisait</w> à décrire avec précision les paysages de son enfance."
                        }
                    ],
                    "synonyms": [
                        "s'amuser",
                        "se délecter"
                    ],
                    "common_phrases": [
                        "se plaire à croire",
                        "se plaire à faire"
                    ]
                },
                {
                    "sense_id": "780fc37c-835e-314f-b8de-f13824181d63",
                    "sense_definition": "Décider selon son bon vouloir, convenir à la volonté de quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "volonte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chacun est entièrement libre d'organiser son emploi du temps comme bon lui <w>plaît</w>."
                        },
                        {
                            "text": "Vous pouvez choisir la couleur des rideaux, nous ferons ce qu'il vous <w>plaira</w>."
                        }
                    ],
                    "common_phrases": [
                        "comme bon lui plaît",
                        "ce qu'il vous plaira"
                    ]
                }
            ]
        }
    ]
}