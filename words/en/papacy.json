{
    "word_family": [
        "pope",
        "papal",
        "papist"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b3c13650-d37b-3721-bd6f-54ad4d433403",
                    "sense_definition": "The office, authority, or system of government of the Pope as head of the Catholic Church.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "office",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Vatican continues to defend the spiritual authority of the <w>papacy</w>.",
                            "target_lang_translations": {
                                "de": "Der Vatikan verteidigt weiterhin die geistliche Autorität des <w>Papsttums</w>."
                            }
                        },
                        {
                            "text": "During the Middle Ages, the <w>papacy</w> held immense political influence across Europe.",
                            "target_lang_translations": {
                                "de": "Im Mittelalter besaß das <w>Papsttum</w> enormen politischen Einfluss in ganz Europa."
                            }
                        }
                    ],
                    "synonyms": [
                        "pontificate"
                    ],
                    "common_phrases": [
                        "office of the papacy",
                        "medieval papacy"
                    ],
                    "target_lang_definitions": {
                        "de": "Das Amt, die Autorität oder die Institution des Papstes als Oberhaupt der katholischen Kirche."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Papsttum",
                                "target_lang_sense_clarification": "Institution und Amt des Papstes"
                            },
                            {
                                "target_lang_word": "Pontifikat",
                                "target_lang_sense_clarification": "Papstamt, geistliche Würde"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0f7e0c1-b6b2-3be6-946f-3006db44662a",
                    "sense_definition": "The period during which a specific pope reigns.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tenure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>papacy</w> of John Paul II lasted for more than twenty-six years.",
                            "target_lang_translations": {
                                "de": "Das <w>Pontifikat</w> von Johannes Paul II. dauerte mehr als sechsundzwanzig Jahre."
                            }
                        },
                        {
                            "text": "Several important reforms were enacted during his brief <w>papacy</w>.",
                            "target_lang_translations": {
                                "de": "Während seines kurzen <w>Pontifikats</w> wurden mehrere wichtige Reformen erlassen."
                            }
                        }
                    ],
                    "synonyms": [
                        "pontificate"
                    ],
                    "target_lang_definitions": {
                        "de": "Die Amtszeit eines bestimmten Papstes."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Pontifikat",
                                "target_lang_sense_clarification": "Amtszeit eines Papstes"
                            },
                            {
                                "target_lang_word": "Papat",
                                "target_lang_sense_clarification": "historisch für Amtszeit eines Papstes"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6887f54-1352-3994-bf14-21a5269dac08",
                    "sense_definition": "The system or doctrines of the Roman Catholic Church, historically used in a critical or Protestant context.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Reformers in the sixteenth century wrote extensive treatises attacking the doctrines of the <w>papacy</w>.",
                            "target_lang_translations": {
                                "de": "Reformatoren im 16. Jahrhundert verfassten umfangreiche Abhandlungen, in denen sie die Lehren des <w>Papsttums</w> angriffen."
                            }
                        },
                        {
                            "text": "The pamphlet argued strongly against what it described as the corrupt practices of the <w>papacy</w>.",
                            "target_lang_translations": {
                                "de": "Die Flugschrift argumentierte scharf gegen das, was sie als korrupte Praktiken des <w>Papismus</w> bezeichnete."
                            }
                        }
                    ],
                    "synonyms": [
                        "popery"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used historically to denote Roman Catholicism, often pejoratively."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Das System oder die Lehren der römisch-katholischen Kirche, historisch oft kritisch oder abwertend verwendet."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Papsttum",
                                "target_lang_sense_clarification": "das römisch-katholische System"
                            },
                            {
                                "target_lang_word": "Papismus",
                                "target_lang_sense_clarification": "abwertend/historisch für Katholizismus"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}