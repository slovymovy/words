                                        "entry_id": "bb157fec-f5d6-3d48-b32f-2a2f9d01caf0",
                                        "glosses": [
                                            "zum Islam bekehren; dem Herrschaftsbereich des Islams zuführen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a63b2b0-3cf7-4c29-b213-49917ab44b4a",
                                                "sense_id": "7532834e-f949-30d1-8dc1-8d98d2cd7f47",
                                                "text": "„Im 8. Jh. wurde Choresmien von den Arabern unterworfen und islamisiert.“"
                                            },
                                            {
                                                "example_id": "85c51ef0-45e3-4c6b-82ab-6ec0069ae615",
                                                "sense_id": "7532834e-f949-30d1-8dc1-8d98d2cd7f47",
                                                "text": "„Doch Europa lasse sich gar nicht islamisieren: \"Warum kamen Muslime nach Europa?“"
                                            },
                                            {
                                                "example_id": "0dae1b5f-fb5e-43f4-b743-33ec5c0dd58c",
                                                "sense_id": "7532834e-f949-30d1-8dc1-8d98d2cd7f47",
                                                "text": "„Doch hier, bei dieser Diskussion, geht es darum, den intensiven Bemühungen islamischer Kreise, Europa zu \"bekehren\" und zu islamisieren, Einhalt zu gebieten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
