                "senses": [
                    {
                        "sense_id": "ea4f2da6-0099-3769-98c7-d217a8b3cb54",
                        "entry_id": "44a58b3d-d5ca-305e-b429-8df1bb73ae3d",
                        "glosses": [
                            "Futter für Ferkel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af13c759-8f4d-4eb6-849d-5ee3bf85ec65",
                                "sense_id": "ea4f2da6-0099-3769-98c7-d217a8b3cb54",
                                "text": "„Der positive Effekt eines abgesenkten Rohproteingehaltes im Ferkelfutter auf die Verdauungsvorgänge konnte bereits mehrfach in verschiedenen Fütterungsversuchen gezeigt werden.“"
                            },
                            {
                                "example_id": "cac52f3e-a0b5-4039-b728-6af844b41f5d",
                                "sense_id": "ea4f2da6-0099-3769-98c7-d217a8b3cb54",
                                "text": "„In Ferkelfutter kommen verschiedene Fette und Öle zum Einsatz.“"
                            },
                            {
                                "example_id": "670ec8ef-1ccd-4fdf-9140-395fac297a8d",
                                "sense_id": "ea4f2da6-0099-3769-98c7-d217a8b3cb54",
                                "text": "„Das wichtigste Ziel ist, jedem Typ Sauenbetrieb Ferkelfutter zur Verfügung zu stellen, das bei Wachstum, Gesundheit und Effizienz brilliert und nachweislich für ein besseres Betriebsergebnis für den Sauenhalter sorgt.“"
                            },
                            {
                                "example_id": "a8df320f-cabb-4f26-b99f-635c0e1d0664",
                                "sense_id": "ea4f2da6-0099-3769-98c7-d217a8b3cb54",
                                "text": "„Erst langsam gewöhnt sich der Verdauungstrakt des Ferkels an die Umstellung von der Sauenmilch zum Ferkelfutter pflanzlicher Herkunft.“"
                            },
                            {
                                "example_id": "46782e8c-635d-4677-ba84-20c745a62340",
                                "sense_id": "ea4f2da6-0099-3769-98c7-d217a8b3cb54",
                                "text": "„Ferkelfutter macht nur 20% (5% Prästarter + 15% Starter) von den gesamten Futterkosten aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
