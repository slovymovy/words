                                            "das Unwesentliche, das Veränderliche einer Sache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "100d4bb4-f8bb-4d59-b787-3f338ca4462b",
                                                "sense_id": "11a30d6a-a2c2-32dc-8112-c2b314916166",
                                                "text": "Die Akzidenz ist ein wichtiger Bestandteil der Philosophie von Thomas."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ea53e9b3-5bdd-30c3-81e4-cebe0ad137d7",
                                        "entry_id": "1986b704-80e5-37e9-8bac-64b1287397d6",
                                        "glosses": [
                                            "gelegentliches nicht verlagsmäßiges Druckerzeugnis"
                                        ],
                                        "tags": [
                                            "Druckwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "662abe37-a7f9-49a2-9d19-098a1136840a",
                                                "sense_id": "ea53e9b3-5bdd-30c3-81e4-cebe0ad137d7",
                                                "text": "Akzidenzen werden vornehmlich außerhalb vom Verlagswesen gedruckt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7aa4ff4f-8179-4b29-b1bb-bff59570b9d3",
                        "source_entry_id": "70758454-84cb-3d34-aa1f-19ec94d7bd0b",
                        "source_sense_id": "4858b455-9427-34e9-a2e9-afd06eb2c632",
                        "source_sense_description": "Philosophie: Akzidens, Akzidenz",
                        "target_lang_word": "Akzidens",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Akzidens",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a216f941-e6a3-396c-8459-ee1f588bdf56",
                                        "entry_id": "f3c37da8-c194-32ea-baf1-40f9ae3f231e",
                                        "glosses": [
                                            "ein zufälliges Phänomen, das nicht unbedingt zum Wesen einer Sache gehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cba5c1f0-0391-4442-8e7f-a45487fa1c89",
                                                "sense_id": "a216f941-e6a3-396c-8459-ee1f588bdf56",
                                                "text": "„Der Zufall, das Akzidens, wird nach der aristotelischen Logik als von außen kommender Zusatz dem Notwendigen, der Substanz, entgegengesetzt.“"
                                            },
                                            {
                                                "example_id": "16a4adbb-7b64-43d6-bb14-58f394ac4fa5",
                                                "sense_id": "a216f941-e6a3-396c-8459-ee1f588bdf56",
                                                "text": "„Obwohl sie [die Philosophen] sich selbst nicht kennen […], so rühmen sie sich dennoch, sie sähen die Ideen, die Formen, die Materien, die Eigenschaften und die Akzidentien, und das sind doch so subtile Dinge, daß meiner Meinung nach niemand sie sehen kann, und hätte er Luchsaugen.“"
                                            },
                                            {
                                                "example_id": "98c7a461-6d4b-45db-83e0-16ce56232bc5",
                                                "sense_id": "a216f941-e6a3-396c-8459-ee1f588bdf56",
                                                "text": "„Jetzt, liebevoll bis ins kleinste ornamentale Akzidens hin renoviert, nutzen es die Mainzer, um in intimen Rahmen des kleinen Rokoko-Saals mit rund 150 Sitzplätzen, Bühnenwerke und Kammeropern aufzuführen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9247956d-d749-352f-9dca-a427752998c4",
                                        "entry_id": "f3c37da8-c194-32ea-baf1-40f9ae3f231e",
                                        "glosses": [
                                            "Versetzungszeichen, das innerhalb eines Taktes zu den Noten hinzutritt"
                                        ],
                                        "tags": [
                                            "Musik",
                                            "im Plural auch Akzidentien"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "930e857a-4f23-4806-9ff1-6aa1a3e2f9a4",
                                                "sense_id": "9247956d-d749-352f-9dca-a427752998c4",
                                                "text": "Akzidentien können Stammtöne um einen oder zwei Halbtöne nach oben oder unten versetzen."
                                            },
                                            {
                                                "example_id": "2e3c47d0-bbf3-4fb7-8b14-b9fdc7011bde",
                                                "sense_id": "9247956d-d749-352f-9dca-a427752998c4",
                                                "text": "„Ein weiteres Beispiel für den Einsatz von Akzidentien sind Septsprünge, wobei häufig die obere Note mit einem Akzidens versehen ist.“"
                                            },
                                            {
                                                "example_id": "d124235d-f352-474f-a8df-00b587620441",
                                                "sense_id": "9247956d-d749-352f-9dca-a427752998c4",
                                                "text": "„Im Tenor ist an drei Stellen ein Akzidens eingezeichnet und zwar immer dann, wenn er den Ambitus des Hexchord naturale, das die dorische Quintenspecies d-re/a-la umfaßt, überschreitet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
