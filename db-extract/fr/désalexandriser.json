                "senses": [
                    {
                        "sense_id": "14ad1ee4-a6c5-38a7-b9e4-cbde8ecdf9c0",
                        "entry_id": "ba0e4857-561a-33b5-955f-8ce065b369fd",
                        "glosses": [
                            "Faire cesser l’influence d’Alexandre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88262308-34c3-4b5c-8987-4f4ea3f7daf4",
                                "sense_id": "14ad1ee4-a6c5-38a7-b9e4-cbde8ecdf9c0",
                                "text": "Sa manie est de faire l’Alexandre ; mais comme disoit Campobasse, nous voilà bien désalexandrisés."
                            },
                            {
                                "example_id": "e526df42-54c9-4f3b-8f34-f4d9707d7cba",
                                "sense_id": "14ad1ee4-a6c5-38a7-b9e4-cbde8ecdf9c0",
                                "text": "Le soir, pour me désalexandriser, une partie de la nuit dans les bars, avec Jean-Claude Pascal, qui boit comme une éponge avec beaucoup de dignité."
                            }
                        ]
                    }
