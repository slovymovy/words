                    {
                        "sense_id": "adc5730f-e296-3c70-8471-effa9e083987",
                        "entry_id": "48e31838-6820-3758-9f3a-7ab9ca0414e2",
                        "glosses": [
                            "shell, shell construction, structural work – the basic structure of a building without interior work or finishing."
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "39a3c399-310d-4d3d-be39-b67f31485360",
                                "sense_id": "adc5730f-e296-3c70-8471-effa9e083987",
                                "text": "Der Rohbau des neuen Hauses ist fast fertig.",
                                "translation": "The shell of the new house is almost finished.",
                                "english": "The shell of the new house is almost finished."
                            },
                            {
                                "example_id": "44eeacd4-71a2-4091-8b25-4eadb76ed9e3",
                                "sense_id": "adc5730f-e296-3c70-8471-effa9e083987",
                                "text": "Der Rohbau war eine gewaltige Herausforderung für alle Beteiligten.",
                                "translation": "The shell construction was a tremendous challenge for all involved.",
                                "english": "The shell construction was a tremendous challenge for all involved."
                            }
                        ]
                    }
