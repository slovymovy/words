                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Adriatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bc600758-6af1-372b-a313-8c194ec3c522",
                                        "entry_id": "0b3aa0eb-2486-3670-9d63-d9905e8fb309",
                                        "glosses": [
                                            "Mer Adriatique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6af6d6d1-d144-4eda-9df6-808ccff90746",
                                                "sense_id": "bc600758-6af1-372b-a313-8c194ec3c522",
                                                "text": "Or, voici maintenant les moyens personnels que la nature vous a mis entre les mains, pour vous défendre ; car la Providence n’a oublié personne : si elle a donné à la sépia (poisson de l’Adriatique) cette couleur noire qui lui sert à produire un nuage au sein duquel elle se dérobe à son ennemi, vous devez bien penser qu’elle n’a pas laissé un mari sans épée : or le moment est venu de tirer la vôtre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e1f91ac-45a9-461c-9c82-5f13cd1f33b1",
                        "source_entry_id": "bb02c615-80eb-38ee-99b2-402528ff76a9",
                        "source_sense_id": "247a3152-f425-34cf-b506-f0dfeb3f4e6f",
