                "senses": [
                    {
                        "sense_id": "0ca76bdc-b1ca-362f-83b5-e1b77060c725",
                        "entry_id": "0017de0d-4b36-3ac8-9535-f7e6ea1dce5c",
                        "glosses": [
                            "Enlever son caractère de blague à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea0ecba1-a8ac-44f9-8bea-8f526620eda7",
                                "sense_id": "0ca76bdc-b1ca-362f-83b5-e1b77060c725",
                                "text": "Dans ses carnets, il semble y songer quand il écrit familièrement : « Il faut déblaguer la science; car la science est souvent l’occasion de dire les plus fortes bêtises sans que le public s’en aperçoive. »!"
                            },
                            {
                                "example_id": "70ea7f62-82f7-4e9e-ad68-dba9c9dc897a",
                                "sense_id": "0ca76bdc-b1ca-362f-83b5-e1b77060c725",
                                "text": "Certes, ils sont parvenus à «déblaguer» la médecine, comme Claude Bernard l’a noté un jour, ils l’ont tirée de l’ornière des spéculations vides et des systèmes ;"
                            }
                        ]
                    },
                    {
                        "sense_id": "187b151c-3bd2-3ccf-951d-138a3f5470e5",
                        "entry_id": "0017de0d-4b36-3ac8-9535-f7e6ea1dce5c",
                        "glosses": [
                            "Arrêter de blaguer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dffe3aff-e526-4ce2-951c-d315d20e9657",
                                "sense_id": "187b151c-3bd2-3ccf-951d-138a3f5470e5",
                                "text": "bref un plan Q ou n’importe quoi d’autre, nous sommes ouverts à ttes propositions (je déblague) nan sinon on a vraiment besoin d’amour nous faisons partie de la S.P.A (société protectrice de l’Amour)"
                            }
                        ]
                    }
