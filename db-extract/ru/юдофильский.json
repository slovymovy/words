                                "target_word": "philosémite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6977c598-ec62-377e-bc3c-b5a4dfed9cb8",
                                        "entry_id": "2a74da22-a95f-383a-858d-b666a206ee05",
                                        "glosses": [
                                            "Personne favorable aux Juifs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a147e14d-f7d7-44e8-8f47-2cbe082c9a3b",
                                                "sense_id": "6977c598-ec62-377e-bc3c-b5a4dfed9cb8",
                                                "text": "Le philosémite, inévitablement déçu par le caractère simplement humain des Juifs concrets, mutera spontanément en un antisémite actif."
                                            }
                                        ]
                                    }
