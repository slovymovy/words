{
    "word_family": [
        "support",
        "supportive",
        "supportively",
        "supportable",
        "unsupported"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c78bb22f-7380-34d9-8bcd-e5d2cc57adcd",
                    "sense_definition": "Someone who is a fan of a certain sports team or athlete.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "person_fan",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stadium was filled with cheering <w>supporters</w> wearing their team colors.",
                            "target_lang_translations": {
                                "ru": "Стадион был заполнен ликующими <w>болельщиками</w>, одетыми в цвета своей команды.",
                                "zh": "体育场里挤满了身穿本队队服、热情欢呼的<w>球迷</w>。"
                            }
                        },
                        {
                            "text": "He has been a loyal football <w>supporter</w> for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Он был преданным футбольным <w>болельщиком</w> более двадцати лет.",
                                "zh": "二十多年来，他一直都是一名忠实的足球<w>球迷</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "football supporter",
                        "loyal supporter",
                        "team supporter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который болеет за определенную спортивную команду или спортсмена.",
                        "zh": "支持某支运动队或某位运动员的球迷。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "болельщик",
                                "target_lang_sense_clarification": "самый распространенный термин для любителей спорта"
                            },
                            {
                                "target_lang_word": "фанат",
                                "target_lang_sense_clarification": "преданный, иногда фанатичный поклонник"
                            },
                            {
                                "target_lang_word": "поклонник",
                                "target_lang_sense_clarification": "человек, восхищающийся чьим-то талантом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "球迷",
                                "target_lang_sense_clarification": "指支持某支球队或某位运动员的人，最常用"
                            },
                            {
                                "target_lang_word": "支持者",
                                "target_lang_sense_clarification": "较正式，也可指某队或某运动员的支持者"
                            },
                            {
                                "target_lang_word": "粉丝",
                                "target_lang_sense_clarification": "强调热情追随，口语常用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b44ab537-ded3-3c86-a031-d308ed608f2b",
                    "sense_definition": "A person who actively approves of and encourages a public figure, political party, policy, or idea.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "person_advocate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a strong <w>supporter</w> of animal rights and environmental protection.",
                            "target_lang_translations": {
                                "ru": "Она является ярой <w>сторонницей</w> прав животных и защиты окружающей среды.",
                                "zh": "她是动物权利和环境保护的坚定<w>支持者</w>。"
                            }
                        },
                        {
                            "text": "The politician thanked every <w>supporter</w> who helped with the campaign.",
                            "target_lang_translations": {
                                "ru": "Политик поблагодарил каждого <w>сторонника</w>, который помог с кампанией.",
                                "zh": "那位政客感谢了每一位为竞选活动出力的<w>支持者</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "adherent",
                        "proponent"
                    ],
                    "antonyms": [
                        "opponent",
                        "detractor"
                    ],
                    "common_phrases": [
                        "strong supporter",
                        "political supporter",
                        "staunch supporter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который активно поддерживает общественного деятеля, политическую партию или идею.",
                        "zh": "积极赞同并支持某位公众人物、某个政党、某项政策或某种观点的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сторонник",
                                "target_lang_sense_clarification": "человек, стоящий на чьей-либо стороне"
                            },
                            {
                                "target_lang_word": "приверженец",
                                "target_lang_sense_clarification": "верный последователь взглядов или учения"
                            },
                            {
                                "target_lang_word": "поборник",
                                "target_lang_sense_clarification": "активный защитник идеи (книжное)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "支持者",
                                "target_lang_sense_clarification": "对某位公众人物、政党、政策或观点表示支持的人"
                            },
                            {
                                "target_lang_word": "拥护者",
                                "target_lang_sense_clarification": "强调公开赞同和拥护"
                            },
                            {
                                "target_lang_word": "倡导者",
                                "target_lang_sense_clarification": "强调积极推动某种理念或事业"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76be8b55-65d9-3ebe-bad6-ffd14e466ee3",
                    "sense_definition": "A person who provides help, money, or encouragement to someone else.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "person_helper",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her parents were her biggest <w>supporters</w> when she decided to start her own business.",
                            "target_lang_translations": {
                                "ru": "Её родители были её главной <w>поддержкой</w>, когда она решила открыть своё дело.",
                                "zh": "当她决定自己创业时，她的父母是她最大的<w>支持者</w>。"
                            }
                        },
                        {
                            "text": "The museum relies on a generous <w>supporter</w> to fund its new exhibitions.",
                            "target_lang_translations": {
                                "ru": "Музей полагается на щедрого <w>спонсора</w> для финансирования новых выставок.",
                                "zh": "这家博物馆依靠一位慷慨的<w>赞助者</w>为新展览提供资金。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "financial supporter",
                        "main supporter"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, оказывающий помощь, финансовую поддержку или поощрение кому-либо.",
                        "zh": "向他人提供帮助、资金或鼓励的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спонсор",
                                "target_lang_sense_clarification": "тот, кто поддерживает финансово"
                            },
                            {
                                "target_lang_word": "покровитель",
                                "target_lang_sense_clarification": "лицо, оказывающее протекцию и поддержку"
                            },
                            {
                                "target_lang_word": "опора",
                                "target_lang_sense_clarification": "переносное значение: надежный человек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "支持者",
                                "target_lang_sense_clarification": "泛指给予帮助、鼓励或支持的人"
                            },
                            {
                                "target_lang_word": "赞助者",
                                "target_lang_sense_clarification": "强调提供金钱资助的人"
                            },
                            {
                                "target_lang_word": "资助者",
                                "target_lang_sense_clarification": "强调提供经费或物质帮助的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24d166eb-d19f-363a-b2a9-aeaa6526a79f",
                    "sense_definition": "Underwear worn by men participating in sports to support and protect the genitals.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "object_clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coach reminded the players to wear a <w>supporter</w> during the rugby match.",
                            "target_lang_translations": {
                                "ru": "Тренер напомнил игрокам надеть <w>бандаж</w> во время матча по регби.",
                                "zh": "教练提醒队员们在打橄榄球比赛时要穿好<w>护裆</w>。"
                            }
                        },
                        {
                            "text": "He bought a new athletic <w>supporter</w> before the start of the season.",
                            "target_lang_translations": {
                                "ru": "Он купил новый спортивный <w>бандаж</w> перед началом сезона.",
                                "zh": "赛季开始前，他买了一个新的运动<w>护裆</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "athletic supporter"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "short for athletic supporter"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужское нижнее белье для занятий спортом, поддерживающее и защищающее гениталии.",
                        "zh": "男性在运动时穿戴的、用于支撑和保护生殖器的内衣或护具。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бандаж",
                                "target_lang_sense_clarification": "защитная экипировка"
                            },
                            {
                                "target_lang_word": "суспензорий",
                                "target_lang_sense_clarification": "медицинский или спортивный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "护裆",
                                "target_lang_sense_clarification": "男子运动时用于支撑和保护生殖器的护具，最常用"
                            },
                            {
                                "target_lang_word": "运动护裆",
                                "target_lang_sense_clarification": "较完整的说法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "34aed0c2-4df0-3f45-8468-99096f421e66",
                    "sense_definition": "A physical object or structure that holds something up.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "object_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old bridge needs a new <w>supporter</w> to ensure it remains safe for traffic.",
                            "target_lang_translations": {
                                "ru": "Старому мосту нужна новая <w>опора</w>, чтобы он оставался безопасным для движения.",
                                "zh": "为了确保通行安全，这座老桥需要一个新的<w>支柱</w>。"
                            }
                        },
                        {
                            "text": "These metal beams act as the main <w>supporters</w> for the roof.",
                            "target_lang_translations": {
                                "ru": "Эти металлические балки служат главными <w>опорами</w> для крыши.",
                                "zh": "这些金属梁是屋顶的主要<w>支撑物</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Физический объект или конструкция, которая удерживает что-либо.",
                        "zh": "用来把某物支撑住的实体物体或结构。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опора",
                                "target_lang_sense_clarification": "несущая конструкция"
                            },
                            {
                                "target_lang_word": "подпорка",
                                "target_lang_sense_clarification": "вспомогательная опора"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "支撑物",
                                "target_lang_sense_clarification": "泛指起支撑作用的物体"
                            },
                            {
                                "target_lang_word": "支柱",
                                "target_lang_sense_clarification": "指柱状的承重支撑结构"
                            },
                            {
                                "target_lang_word": "支架",
                                "target_lang_sense_clarification": "多指架住或托住某物的结构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3e6adac-05b6-3793-90d7-1219158ca339",
                    "sense_definition": "An animal or figure depicted on either side of a shield in a coat of arms.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "object_heraldry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lion and the unicorn appear as <w>supporters</w> on the royal coat of arms.",
                            "target_lang_translations": {
                                "ru": "Лев и единорог выступают в качестве <w>щитодержателей</w> на королевском гербе.",
                                "zh": "狮子和独角兽出现在王室纹章上，作为<w>扶盾兽</w>分列盾牌两侧。"
                            }
                        },
                        {
                            "text": "In heraldry, a <w>supporter</w> is often a beast or mythological creature standing by the shield.",
                            "target_lang_translations": {
                                "ru": "В геральдике <w>щитодержатель</w> — это часто зверь или мифологическое существо, стоящее у щита.",
                                "zh": "在纹章学中，<w>扶盾兽</w>通常是站在盾牌旁边的野兽或神话生物。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фигура (животное или человек), изображенная по сторонам геральдического щита.",
                        "zh": "纹章学中位于盾牌两侧、用来扶持盾牌的动物、人物或其他形象。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щитодержатель",
                                "target_lang_sense_clarification": "геральдический термин"
                            },
                            {
                                "target_lang_word": "щитоносец",
                                "target_lang_sense_clarification": "вариант термина"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "扶盾兽",
                                "target_lang_sense_clarification": "纹章学术语，指位于盾牌两侧的动物或其他形象"
                            },
                            {
                                "target_lang_word": "扶盾像",
                                "target_lang_sense_clarification": "更广义，可指人物、动物等扶持盾牌的形象"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}