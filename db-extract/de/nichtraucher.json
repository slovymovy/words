                                        "glosses": [
                                            "не имеющий привычки курить (табак, сигареты и т. п.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d6128a1-11d8-41a6-b718-8022e6f5cc8a",
                                                "sense_id": "d0b5f5ed-c781-334e-84b2-48b1fe5b7e5f",
                                                "text": "Поэт и владелец портсигара закурили, а некурящий Берлиоз отказался."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27103ec3-68f9-3766-b8f4-bde1e58d767e",
                                        "entry_id": "5c2aca30-8a8d-3acf-a147-77af337ae672",
                                        "glosses": [
                                            "разг. предназначенный для тех, кто не курит"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b5cf19b-2268-4aa8-86b2-74de5d9c4924",
                                                "sense_id": "27103ec3-68f9-3766-b8f4-bde1e58d767e",
                                                "text": "Слава Богу, хозяин, мой друг Андрей Деллос, превратил банкетный зал в отдельный некурящий зал."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e13d981c-c768-3778-aa29-aba4e623f9e8",
                                        "entry_id": "5c2aca30-8a8d-3acf-a147-77af337ae672",
                                        "glosses": [
                                            "субстантивир. тот, кто не имеет привычки курить (табак, сигареты и т. п.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f226b443-3312-47cd-9900-aa1d7b8f5575",
                                                "sense_id": "e13d981c-c768-3778-aa29-aba4e623f9e8",
                                                "text": "Потом мы собирались в холле, где курящие курили, а некурящие при сем присутствовали."
                                            }
                                        ]
                                    }
                                ]
                            }
