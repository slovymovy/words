                ],
                "senses": [
                    {
                        "sense_id": "fb34f6ff-7137-351f-aee4-b1239b7929b4",
                        "entry_id": "1574a187-9305-39a7-a844-3bdd0d3f58bf",
                        "glosses": [
                            "lebensnotwendige Nährstoffe für das Wachstum von Pflanzen, die in größeren Mengen notwendig sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7509816e-df67-48e4-9d45-a95ae3e20296",
                                "sense_id": "fb34f6ff-7137-351f-aee4-b1239b7929b4",
                                "text": "„Fett wurde lange Zeit von der Deutschen Gesellschaft für Ernährung verteufelt: Der Makronährstoff, der sich in rotem Fleisch, Käse oder Milch befindet, soll an der Übergewichts-Epidemie und an Herz-Kreislauferkrankungen schuld sein.“"
                            },
                            {
                                "example_id": "60315f77-bb96-44ff-9e4a-835c497393b6",
                                "sense_id": "fb34f6ff-7137-351f-aee4-b1239b7929b4",
                                "text": "„Doch eine neue Studie will nun ergeben haben, dass der verpönte Makronährstoff nicht so ungesund ist, wie es uns Promis und Fitnessgurus weismachen wollen.“"
                            },
                            {
                                "example_id": "3bb614bc-aa06-44d8-9e8d-ca11bb45c8f6",
                                "sense_id": "fb34f6ff-7137-351f-aee4-b1239b7929b4",
                                "text": "„Ohne genügend Eiweiß ist ein gesundes Leben nicht möglich. Gleichzeitig ist dies aber auch der Makronährstoff, der gemessen an seinem Energiegehalt derzeit am meisten Ressourcen verbraucht – weil er größtenteils von Tieren stammt.“"
                            },
                            {
                                "example_id": "1bbb9d40-ad6e-4641-b5fb-91b96af17504",
                                "sense_id": "fb34f6ff-7137-351f-aee4-b1239b7929b4",
                                "text": "„Ein übermäßiges Algenwachstum deutet immer auf ein Ungleichgewicht hin. Im Umkehrschluss erhalten die im Wasser befindlichen Tiere eine zu hohe Dosis an Makronährstoffen.“"
                            },
                            {
                                "example_id": "435218e0-3e8c-4faf-9190-c2fa0fc825a6",
                                "sense_id": "fb34f6ff-7137-351f-aee4-b1239b7929b4",
                                "text": "„Mit den Mahlzeiten bekommt der Körper nicht immer genug Eiweiße, um den erhöhten Bedarf an diesen Makronährstoffen zu kompensieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
