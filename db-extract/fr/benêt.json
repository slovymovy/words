                        "examples": [
                            {
                                "example_id": "8fd53cd6-e2d4-42df-8ee4-0b4b52a28bd3",
                                "sense_id": "5b64a34a-e7d0-36ca-ae90-c5c82318e8c7",
                                "text": "Les benêts suivirent à demi, comme ils suivent toujours ceux qui, de bonne foi ou non, dénoncent de mystérieuses machinations."
                            },
                            {
                                "example_id": "43d33a8e-96b5-47c7-9178-b61658f731ac",
                                "sense_id": "5b64a34a-e7d0-36ca-ae90-c5c82318e8c7",
                                "text": "Elle n’a jamais su aligner deux sons, cette benête, que des cris de lièvre qu’on écorche."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1eac8fa9-7372-4243-a8c5-8fd9dadb69ee",
