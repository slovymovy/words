{
    "word_family": [
        "pardonner",
        "pardonnable",
        "impardonnable"
    ],
    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "863e534e-4320-3dc5-9a41-bd4115d2a0dd",
                    "sense_definition": "Formule de politesse employée pour s'excuser d'une maladresse, d'une erreur ou d'un dérangement involontaire.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "excuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Pardon</w>, je ne voulais pas vous bousculer dans le couloir."
                        },
                        {
                            "text": "Oh, <w>pardon</w>, j'ai fait tomber votre stylo par terre !"
                        }
                    ],
                    "synonyms": [
                        "excusez-moi",
                        "je m'excuse"
                    ]
                },
                {
                    "sense_id": "bf0148c7-2fd6-3dc3-8a17-1e7573b740a4",
                    "sense_definition": "Formule de politesse utilisée pour attirer l'attention ou pour demander poliment le passage.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "politesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Pardon</w>, pourriez-vous me laisser passer pour descendre du bus ?"
                        },
                        {
                            "text": "<w>Pardon</w>, madame, savez-vous où se trouve la gare centrale ?"
                        }
                    ],
                    "synonyms": [
                        "excusez-moi"
                    ]
                },
                {
                    "sense_id": "d073e7c4-0bce-3f29-8aa9-8609581a45ca",
                    "sense_definition": "Formule interrogative utilisée pour inviter poliment l'interlocuteur à répéter ce qu'il vient de dire.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "repetition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Pardon</w> ? Je n'ai pas bien compris ce que tu as dit."
                        },
                        {
                            "text": "<w>Pardon</w> ? Il y a trop de bruit ici, tu peux répéter plus fort ?"
                        }
                    ],
                    "synonyms": [
                        "comment",
                        "hein",
                        "plaît-il",
                        "quoi"
                    ]
                },
                {
                    "sense_id": "4e12314e-0ddd-3592-8494-a05536693c9d",
                    "sense_definition": "Formule employée pour solliciter un service ou appuyer une prière amicale.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "priere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Donne-moi un verre d'eau fraîche pour la route, <w>pardon</w>."
                        },
                        {
                            "text": "<w>Pardon</w>, mon ami, ne te fâche pas contre nous sans raison."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Afrique francophone"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "72b79766-c0d2-3d70-a7ca-ee18f921194f",
                    "sense_definition": "Action de pardonner une offense, une faute, ou fait d'accorder la rémission d'un tort.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "absolution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est allé lui demander <w>pardon</w> après cette dispute inutile."
                        },
                        {
                            "text": "Accorder son sincère <w>pardon</w> exige parfois une grande force morale."
                        }
                    ],
                    "common_phrases": [
                        "demander pardon",
                        "accorder son pardon"
                    ]
                },
                {
                    "sense_id": "9f396cdc-5ab8-349f-a873-5416d9bac952",
                    "sense_definition": "Pèlerinage religieux traditionnel célébré en Bretagne en l'honneur d'un saint patron, accompagné de festivités.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fete_religieuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque été, les habitants du village assistent au traditionnel <w>pardon</w> breton."
                        },
                        {
                            "text": "De nombreux fidèles viennent assister aux processions du grand <w>pardon</w> local."
                        }
                    ],
                    "common_phrases": [
                        "pardon breton"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Bretagne"
                        }
                    ]
                }
            ]
        }
    ]
}