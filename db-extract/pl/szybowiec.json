                        ]
                    },
                    {
                        "translation_id": "a8f83968-5f30-4c14-b56c-14758cc7c801",
                        "source_entry_id": "e3655838-4488-3c6b-8524-668460c1cd20",
                        "source_sense_id": "e8ffc195-350e-30d2-8a42-ceb55dbd99bc",
                        "target_lang_word": "planeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "planeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "07b66374-8bda-3cc2-b304-9b94513c4052",
                                        "entry_id": "bcf6fe5f-fe45-3552-80d1-9227124105e0",
                                        "glosses": [
                                            "Avion sans moteur, pouvant planer de façon prolongée et pratiquer le vol à voile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08f8dd8c-f4ec-46a0-9ded-970343ee425b",
                                                "sense_id": "07b66374-8bda-3cc2-b304-9b94513c4052",
                                                "text": "Comme anémomètre, le venturi est utilisé uniquement sur les avions lents et les planeurs."
                                            },
                                            {
                                                "example_id": "39139743-27a1-467e-ac61-2cab2a3faa2d",
                                                "sense_id": "07b66374-8bda-3cc2-b304-9b94513c4052",
                                                "text": "Il fallait abandonner la poutre et recommencer une instruction de trois jours sur un C-800 pansu, un planeur véritable, davantage configuré pour la vitesse et capable d’atteindre des hauteurs sérieuses."
                                            },
                                            {
                                                "example_id": "174908de-acca-41b2-b397-98ac195cbf98",
                                                "sense_id": "07b66374-8bda-3cc2-b304-9b94513c4052",
                                                "text": "Contrairement aux avions à moteur, un planeur vole nez incliné vers le bas même s’il monte, puisque c’est la vitesse seule, donc la pente imprimée par le pilote à la machine, qui lui permet de se maintenir en l’air, de rester airborne, comme disent les Américains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65dccc31-5e42-3464-a4a6-f334f09e11df",
                                        "entry_id": "bcf6fe5f-fe45-3552-80d1-9227124105e0",
                                        "glosses": [
                                            "Cellule de l’avion, à l’exclusion des moteurs."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d8943451-91be-3666-8cbb-39ef793a1f4e",
                                        "entry_id": "bcf6fe5f-fe45-3552-80d1-9227124105e0",
                                        "glosses": [
                                            "Ce qui pratique le vol à voile."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1875fdc4-5135-4d15-93f4-9a875860f4b0",
                                                "sense_id": "d8943451-91be-3666-8cbb-39ef793a1f4e",
                                                "text": "L'albatros est un excellent planeur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "planeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c6b74ee7-4461-3d4d-931d-95353eeeeaac",
                                        "entry_id": "184dc2b7-7800-3dff-abe0-c265b3209cba",
                                        "glosses": [
                                            "Ouvrier qui plane les métaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dd802b0-f91b-46e5-8e58-d81e57039e73",
                                                "sense_id": "c6b74ee7-4461-3d4d-931d-95353eeeeaac",
                                                "text": "Planeur en cuivre — Artisan qui plane, dresse et polit les planches de cuivre destinées à la gravure."
                                            },
                                            {
                                                "example_id": "c0435bb0-0d82-48fc-81d2-8ed7b94396df",
                                                "sense_id": "c6b74ee7-4461-3d4d-931d-95353eeeeaac",
                                                "text": "Atelier de planeur."
                                            },
                                            {
                                                "example_id": "60960677-b0d0-4caf-9e3b-061f79eb843e",
                                                "sense_id": "c6b74ee7-4461-3d4d-931d-95353eeeeaac",
                                                "text": "Ça y est, lui dit-elle, vite un fiacre… C’est rue de la Huchette, que tu m’as dit, en face d’un planeur de cuivre, ta sage-femme, n’est-ce pas ? Tu n’as pas une plume, du papier ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c5a28919-003f-4bf7-976f-2adea00c2b94",
                        "source_entry_id": "e3655838-4488-3c6b-8524-668460c1cd20",
                        "source_sense_id": "e8ffc195-350e-30d2-8a42-ceb55dbd99bc",
