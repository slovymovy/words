                            "target_lang_translations": {
                                "en": "He is currently <w>watering</w> the flowers in the backyard."
                            }
                        },
                        {
                            "text": "Je moet het gazon regelmatig <w>besproeien</w> tijdens een droge zomer.",
                            "target_lang_translations": {
                                "en": "You must <w>sprinkle</w> the lawn regularly during a dry summer."
                            }
