                    {
                        "sense_id": "fed8c270-3b5f-3731-a036-fdb08690d0d9",
                        "entry_id": "c35b4670-45a7-31e1-9bda-fc5238720ff5",
                        "glosses": [
                            "Chevauchement d’une plaque océanique sur une plaque continentale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bb43f5a-9a80-45b6-8da4-60b956340a18",
                                "sense_id": "fed8c270-3b5f-3731-a036-fdb08690d0d9",
                                "text": "Ces unités dont la majorité appartiennent à la marge de Norfolk ont été enfouies dans la subduction et leur exhumation est contemporaine de l’obduction dans le sud de l’île."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "622e14cc-56d8-4268-90b4-29fa1c1ae09e",
                        "source_entry_id": "c35b4670-45a7-31e1-9bda-fc5238720ff5",
                        "source_sense_id": "fed8c270-3b5f-3731-a036-fdb08690d0d9",
                        "source_sense_description": "(Géologie) Chevauchement de plaques",
                        "target_lang_word": "Obduktion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Obduktion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b4186005-90b8-3117-a0a0-be1f23b98b53",
                                        "entry_id": "145b31c8-3f25-3df8-8673-a511d2d83e3e",
                                        "glosses": [
                                            "meist gerichtlich angeordnete innere Leichenschau (Leichenöffnung) zur Feststellung der Todesursache und zur Rekonstruktion des Sterbevorgangs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cbc16bd-1539-481e-a8ce-487b87c2f691",
                                                "sense_id": "b4186005-90b8-3117-a0a0-be1f23b98b53",
                                                "text": "Die Obduktion ergab keine Hinweise auf einen Selbstmord."
                                            },
                                            {
                                                "example_id": "4b9a355b-1004-4524-836e-046757257cb2",
                                                "sense_id": "b4186005-90b8-3117-a0a0-be1f23b98b53",
                                                "text": "„Aufgrund der polizeilich gesicherten Beweislage und der nach der Obduktion einwandfreien ärztlichen Dokumentation hat die Assekuranz der Mordversion Glauben geschenkt, und, wie Rudi weiß und erzählt, die enorme Versicherungssumme ausgezahlt.“"
                                            },
                                            {
                                                "example_id": "f27c3e5d-009d-470e-ab63-7775ffe5aba0",
                                                "sense_id": "b4186005-90b8-3117-a0a0-be1f23b98b53",
                                                "text": "„Sie ging noch einmal zum Hospital; die Empfangsschwester erklärte ihr, daß sie Clerfayt nicht mehr sehen könne; eine Obduktion werde auf Wunsch eines Mitgliedes der Familie vorgenommen.“"
                                            },
                                            {
                                                "example_id": "3b36d61e-d67d-4250-8137-324db42c8b6a",
                                                "sense_id": "b4186005-90b8-3117-a0a0-be1f23b98b53",
                                                "text": "„Aber um Klarheit über die Todesursache zu bekommen, musste sie auf das Ergebnis der Obduktion warten, das am Tag darauf kommen sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec10bc85-9104-4d36-bb96-673929cf6cec",
                        "source_entry_id": "c35b4670-45a7-31e1-9bda-fc5238720ff5",
                        "source_sense_id": "fed8c270-3b5f-3731-a036-fdb08690d0d9",
