                                        "examples": [
                                            {
                                                "example_id": "62556dfb-ea22-4442-bc3a-c75102e64ec7",
                                                "sense_id": "478fa642-e230-3855-bec4-225595a9bae7",
                                                "text": "„Mit den passenden Kleiderbügeln zerknittern die gebügelten Kleidungsstücke weniger schnell.“"
                                            },
                                            {
                                                "example_id": "c393e1c3-10e2-4809-9d18-c442f16d361e",
                                                "sense_id": "478fa642-e230-3855-bec4-225595a9bae7",
                                                "text": "Nach dem Mittagsschläfchen auf der Couch bin ich ganz zerknittert."
                                            },
                                            {
                                                "example_id": "624c21d0-45fa-4f77-94fe-088efae6001c",
                                                "sense_id": "478fa642-e230-3855-bec4-225595a9bae7",
                                                "text": "Vorsichtig glättete sie das zerknitterte Stückchen Papier."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
