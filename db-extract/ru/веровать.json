                    {
                        "sense_id": "e9e2bfb9-76d9-3868-8f1d-623f565c2ddc",
                        "entry_id": "33b80bdf-5c6a-3e5e-b106-c95bf205c659",
                        "glosses": [
                            "to believe (in, especially to believe in God)"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "ad26c700-dd6f-4b40-a430-69186871e52a",
                                "sense_id": "e9e2bfb9-76d9-3868-8f1d-623f565c2ddc",
                                "text": "Хочу я с небом примириться,\nХочу любить, хочу молиться,\nХочу я веровать добру.",
                                "translation": "I want to make peace with the heaven,\nI want to love, I want to pray,\nI want to believe in goodness.",
                                "english": "I want to make peace with the heaven,\nI want to love, I want to pray,\nI want to believe in goodness."
                            }
                        ]
                    }
