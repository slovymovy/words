                ],
                "senses": [
                    {
                        "sense_id": "4af0d1b5-debf-393e-a2d2-cae609ef7ecb",
                        "entry_id": "8491d2e6-370b-324a-8282-e1292c8c582d",
                        "glosses": [
                            "mehrarmige Deckenlampe"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "275e299b-25d9-4297-ba37-999e0865c3c8",
                                "sense_id": "4af0d1b5-debf-393e-a2d2-cae609ef7ecb",
                                "text": "„Beim Kauf eines Schlafzimmers kostet der 5-flammige Maria-Theresien-Luster nur 99.-“"
                            },
                            {
                                "example_id": "9ee59b03-0f16-448c-9125-07c6f3fa5747",
                                "sense_id": "4af0d1b5-debf-393e-a2d2-cae609ef7ecb",
                                "text": "„Und tatsächlich wanderten die Blicke der Gäste aus Wirtschaft, Politik und Kunst verdächtig oft nach oben, wo Luster hängen, für die so manches Wohnzimmer selbst als Lager zu klein wäre.“"
                            },
                            {
                                "example_id": "8f8d0c04-ec9d-41ce-b28c-f4254f37cbb6",
                                "sense_id": "4af0d1b5-debf-393e-a2d2-cae609ef7ecb",
                                "text": "„Der Graben kam ohne große Bühne aus. Dort sorgten die Besucher selbst für Unterhaltung – sie dürfen immerhin im ‚größten Ballsaal Wiens‘ das Tanzbein schwingen. Die imposanten Luster der Weihnachtsbeleuchtung passen dazu bestens.“"
                            },
                            {
                                "example_id": "a9e503f1-934f-43ab-8488-2bcbb8f336aa",
                                "sense_id": "4af0d1b5-debf-393e-a2d2-cae609ef7ecb",
                                "text": "„Tatsächlich bestand jedoch dieses Inventar lediglich aus einem alten Luster und alten, nicht mehr brauchbaren Plüschmöbeln.“"
                            },
                            {
                                "example_id": "2bc87eea-0c86-49ef-a58d-3991dca4948b",
                                "sense_id": "4af0d1b5-debf-393e-a2d2-cae609ef7ecb",
                                "text": "„Da die Zweitklägerin und ihr Ehemann die Möbel des Wohn- und Schlafzimmers nicht benötigten, einigten sich die Vertragsteile dahin, daß in den genannten Zimmern nur die Vorhänge bzw. im Schlafzimmer auch der Luster und zwei Soffitten abgelöst werden.“"
                            },
                            {
                                "example_id": "3a8ffb02-1cb7-4b79-a2b7-654c94c9d0ea",
                                "sense_id": "4af0d1b5-debf-393e-a2d2-cae609ef7ecb",
                                "text": "„Auch für Luster und Teppiche sei die Annahme einer zehnjährigen Nutzungsdauer üblich und entsprechend.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
