                        "examples": [
                            {
                                "example_id": "99a94794-da1f-4c14-92be-d4dc9a0ab5c8",
                                "sense_id": "9938b314-09ca-35d9-a7b8-1264bbb7f592",
                                "text": "Un jour qu'elle était venue me voir, je lui dis : \"Pardié ! Mademoiselle Billard, vous qui êtes une coquette, il faut que je vous fasse cadeau d'un chapeau\"."
                            },
                            {
                                "example_id": "270e4f4b-315c-4712-bd86-f4f0a538f489",
                                "sense_id": "9938b314-09ca-35d9-a7b8-1264bbb7f592",
                                "text": "— Ce n’est pas ton papa, pour sûr ?\n— J’en ai pas.\n— Qui ça alors ?\n— Eh bin, pardié, un homme qui venait dormir."
                            }
                        ]
                    }
