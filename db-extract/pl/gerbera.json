                                    {
                                        "sense_id": "21f0c322-fe90-302b-ac0e-6c0ea90bbe60",
                                        "entry_id": "61f9f7dd-0860-3937-a7f8-7d62218fe2dc",
                                        "glosses": [
                                            "A daisy of the genus Gerbera."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a5b423b-68bf-42fc-ae6c-ed602a523ef0",
                                                "sense_id": "21f0c322-fe90-302b-ac0e-6c0ea90bbe60",
                                                "text": "The gerbera daisies come packed in what look like shirt boxes, their happy-face blossoms all looking outward, their stems dangling down like wires from the back of a computer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "adb87ffc-6515-4a5d-9fc8-def26cb3f1cb",
                        "source_entry_id": "71fdfd93-24eb-34db-a39d-3c178f4c93c2",
