                                    {
                                        "sense_id": "e858fc75-d16a-3f9c-8bc9-de4cd6e7f3d4",
                                        "entry_id": "21504c06-d133-3022-80e4-5cd2ae101b6e",
                                        "glosses": [
                                            "A Pharisee, a secret follower of Jesus in the New Testament."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0c7b842-0dce-41a0-a196-b6696594cf99",
                                                "sense_id": "e858fc75-d16a-3f9c-8bc9-de4cd6e7f3d4",
                                                "text": "There was a man of the Pharisees, named Nicodemus, a ruler of the Jews; The same came to Jesus by night, and said unto him, Rabbi, we know that thou art a teacher come from God:"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7b6273e-fb00-332c-8438-282eec0891c0",
                                        "entry_id": "21504c06-d133-3022-80e4-5cd2ae101b6e",
                                        "glosses": [
                                            "A male given name from Ancient Greek."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Nicodemus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d6aae10-9e91-3c9b-a4c2-050ce866c672",
                                        "entry_id": "3a2133dc-8a0f-353a-b9ce-7096a77ae15c",
                                        "glosses": [
                                            "To be kept hidden, in the manner of the Pharisee Nicodemus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e3cb6a6-a3d9-48f1-b15d-59a13d12cb33",
                                                "sense_id": "9d6aae10-9e91-3c9b-a4c2-050ce866c672",
                                                "text": "How many Caesars and Pompeys, he would say, by mere inspiration of their names, have been rendered worthy of them? And how many, he would add, are there, who might have done exceedingly well in the world, had not their characters and spirits been totally depressed and Nicodemus’d into nothing?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
