                    {
                        "form_id": "6305aad4-48b8-4248-922c-c38247b66fba",
                        "entry_id": "0b4b1bfa-66c4-3b4a-8a72-924962f7a9ed",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Dramatik"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e173f5a5-690f-39af-a3b3-6cfeadace9e3",
                        "entry_id": "0b4b1bfa-66c4-3b4a-8a72-924962f7a9ed",
                        "glosses": [
                            "aufregende Situation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2d31bf2-d3d8-4989-a953-78fd06cfc9ed",
                                "sense_id": "e173f5a5-690f-39af-a3b3-6cfeadace9e3",
                                "text": "Die Dramatik des Finalspiels löste viele Emotionen bei den Zuschauern aus."
                            },
                            {
                                "example_id": "c77b152f-ce35-434c-bb03-2c51be907812",
                                "sense_id": "e173f5a5-690f-39af-a3b3-6cfeadace9e3",
                                "text": "„Im übrigen aber muß ich mich jetzt sehr zusammennehmen, um die ganze Dramatik der nun folgenden Vorgänge sauber hinzukriegen.“"
                            },
                            {
                                "example_id": "d68d7ef4-fa8f-40c9-a44b-e20678c40733",
                                "sense_id": "e173f5a5-690f-39af-a3b3-6cfeadace9e3",
                                "text": "„Es sollte ein an Dramatik und Spannung kaum zu überbietendes Endspiel werden, welches das Sportmagazin Sports Illustrated später zum besten Spiel aller Zeiten hochstilisierte.“"
                            },
                            {
                                "example_id": "0d9352b8-1f4e-4aff-b4a2-95c5f2860841",
                                "sense_id": "e173f5a5-690f-39af-a3b3-6cfeadace9e3",
                                "text": "„All die Spannung, die es zwischen uns in den letzten Monaten gegeben hatte, war durch die Dramatik der Ereignisse restlos absorbiert worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6888f4ac-ba38-3e22-9bc7-b3da7aa72765",
                        "entry_id": "0b4b1bfa-66c4-3b4a-8a72-924962f7a9ed",
