                "senses": [
                    {
                        "sense_id": "545563cb-51fa-344c-87d4-3a26ef73f5cc",
                        "entry_id": "70d23254-2b20-3a74-aece-49d1e6d45491",
                        "glosses": [
                            "Sangle de cuir attachée à la selle ou à un harnais et passant en dessous de la base de la queue du cheval."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f642edc9-30ae-4858-a7fc-670d6828765b",
                                "sense_id": "545563cb-51fa-344c-87d4-3a26ef73f5cc",
                                "text": "Clovis dégrafa les œillères, déboucla la sous-ventrière, dégagea la queutière."
                            },
                            {
                                "example_id": "553d4f10-40e4-441e-8a05-05e634980f1d",
                                "sense_id": "545563cb-51fa-344c-87d4-3a26ef73f5cc",
                                "text": "Chacun de son côté, ils harnachèrent le cheval, relevant la crinière, glissant la queue dans la queutière, bouclant la sous-ventrière."
                            }
                        ]
                    },
                    {
                        "sense_id": "ccfa58ac-e1d3-38cb-8d85-858cd0da7332",
                        "entry_id": "70d23254-2b20-3a74-aece-49d1e6d45491",
                        "glosses": [
                            "Personne qui, moyennant une rémunération, fait la queue dans une file d'attente à la place d'une autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04b867e1-7fd8-40dd-9972-2c353f99d3a7",
                                "sense_id": "ccfa58ac-e1d3-38cb-8d85-858cd0da7332",
                                "text": "Et ceux-là, voyez cette clocharde, c'est une queutière. Elle est payée par des gens qui ont de quoi pour faire la queue à leur place. C'est très bien payé ! Jusqu'à sept francs de l'heure !",
                                "translation": "Lola Sémonin, La Madeleine Proust, une vie 1940-1941 Sous la botte, éd. Place des éditeurs, 2021"
                            },
                            {
                                "example_id": "c601e5e4-79b5-4059-a96f-e55c246d9ec2",
                                "sense_id": "ccfa58ac-e1d3-38cb-8d85-858cd0da7332",
                                "text": "Des solidarité s'instaurent, des petits métiers et profiteurs aussi : la queutière se fait payer pour remplacer une mère dans la file d'attente , quand d'autres - concierges surtout - louent un coin de cave à proximité d'un commerce."
                            }
                        ]
                    }
