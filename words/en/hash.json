                        "zh": [
                            {
                                "target_lang_word": "搞砸",
                                "target_lang_sense_clarification": "把事情弄得一团糟"
                            },
                            {
                                "target_lang_word": "弄糟",
                                "target_lang_sense_clarification": "使事情变得糟糕"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fccf3267-d843-3e17-a56b-0da4893bc27b",
                    "sense_definition": "To convert data into a fixed-size numerical value using an algorithm.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The server will <w>hash</w> the input string to create a secure identifier.",
                            "target_lang_translations": {
                                "ru": "Сервер будет <w>хешировать</w> входную строку для создания безопасного идентификатора.",
                                "zh": "服务器将对输入字符串进行<w>哈希</w>处理，以创建一个安全标识符。"
                            }
                        },
                        {
                            "text": "It is standard practice to <w>hash</w> passwords before storing them in a database.",
                            "target_lang_translations": {
                                "ru": "Стандартной практикой является <w>хеширование</w> паролей перед их сохранением в базе данных.",
                                "zh": "在将密码存入数据库之前对其进行<w>哈希</w>处理是标准做法。"
                            }
                        }
