                "senses": [
                    {
                        "sense_id": "4bb13c13-b7ad-3737-9c1e-5098bb55092a",
                        "entry_id": "96125c8f-4708-36ca-af86-7d37593f5537",
                        "glosses": [
                            "To replace the traction-providing surface of a vehicle that employs tires, tracks or treads."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1c70ad5a-fb24-304b-ba41-957747c8e743",
                        "entry_id": "96125c8f-4708-36ca-af86-7d37593f5537",
                        "glosses": [
                            "To renew the tread of a tyre, providing a cheaper alternative to buying a new tyre, but potentially introducing a risk of premature failure if performed improperly."
                        ],
                        "tags": [
                            "UK"
                        ],
                        "examples": [
                            {
                                "example_id": "4e804f1f-c49b-485c-b995-c7862147efa7",
                                "sense_id": "1c70ad5a-fb24-304b-ba41-957747c8e743",
                                "text": "There was no evidence to suggest that the fact that both tyres had been retreaded 3 times was a factor in the failure occurrence. This type of aircraft tyre (Type VII) is routinely retreaded 6 times or more before being taken out of service."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "396b0cb2-0dda-47be-9bb9-d714eb78455c",
                        "source_entry_id": "96125c8f-4708-36ca-af86-7d37593f5537",
                        "source_sense_description": "to replace the traction-providing surface of a vehicle",
                        "target_lang_word": "bieżnikować",
