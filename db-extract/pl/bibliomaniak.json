                        "sense_id": "b8341928-9ad8-31a4-832f-5651872c9d2c",
                        "entry_id": "994f9326-5a8c-32b8-80a2-53c8adba1e8f",
                        "glosses": [
                            "osoba z pasją gromadząca książki"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "fc5c9053-5b82-416f-9ee3-68862021e528",
                                "sense_id": "b8341928-9ad8-31a4-832f-5651872c9d2c",
                                "text": "Wcisnął jakiemuś bibliomaniakowi kilka książek po profesorze."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e151ffe5-5d68-462f-8bfb-a857589addff",
                        "source_entry_id": "994f9326-5a8c-32b8-80a2-53c8adba1e8f",
                        "source_sense_id": "b8341928-9ad8-31a4-832f-5651872c9d2c",
                        "target_lang_word": "bibliomaniac",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bibliomaniac",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20164005-885d-3237-a2cb-a920d1ff1026",
                                        "entry_id": "80dd101e-e5de-3e00-976b-d50036a53901",
                                        "glosses": [
                                            "A person who is obsessed with owning books, especially valuable ones."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c36f957c-e797-4ae2-8de0-81a1ce93f2ac",
                                                "sense_id": "20164005-885d-3237-a2cb-a920d1ff1026",
                                                "text": "A bad example often finds imitators, and every season there crop up for public sale one or two such collections formed by bibliomaniacs who, although calling themselves bibliophiles, ought really to be ranked among the worst enemies of books."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "112a4d44-8746-4196-b226-aadc6957491f",
                        "source_entry_id": "994f9326-5a8c-32b8-80a2-53c8adba1e8f",
                        "source_sense_id": "b8341928-9ad8-31a4-832f-5651872c9d2c",
                        "target_lang_word": "bibliomane",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bibliomane",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "237c7774-f46e-3fca-819e-a46f14133c2e",
                                        "entry_id": "b33d1dfe-35c8-3cad-8369-7c5bb6fd19ab",
                                        "glosses": [
                                            "Personne atteinte de collectionnite de livres, dont le contenu importe peu, qui comptent seulement en tant qu’objets à ses yeux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8d290bc-2510-42d6-9617-591f94ac454d",
                                                "sense_id": "237c7774-f46e-3fca-819e-a46f14133c2e",
                                                "text": "Le docteur reconnut que la congestion cérébrale étoit imminente, et il fit un beau rapport sur cette maladie dans le Journal des Sciences médicales, où elle est désignée sous le nom de monomanie du maroquin, ou de typhus des bibliomanes ; mais il n’en fut pas question à l’Académie des sciences, parce qu’elle se trouva en concurrence avec le choléra-morbus."
                                            },
                                            {
                                                "example_id": "a5f2a59f-5d11-4fbc-a1ce-0dbb42b26282",
                                                "sense_id": "237c7774-f46e-3fca-819e-a46f14133c2e",
                                                "text": "Mais je ne sais où il est. Je ne sais s’il est gardé dans une armoire de fer, sous une triple serrure, par un jaloux bibliomane ; je ne sais s’il moisit dans le grenier d’un ignorant. Je frémis à la pensée que, peut-être, ses feuillets arrachés couvrent les pots de cornichons de quelque ménagère."
                                            },
                                            {
                                                "example_id": "5b4d7bc3-899f-4387-9871-e66e502a8421",
                                                "sense_id": "237c7774-f46e-3fca-819e-a46f14133c2e",
                                                "text": "Fréquemment il arrive que le bibliophile se transforme en bibliomane, devient le bibliolâtre, pour qui le livre est TOUT, pour qui tout le reste n’est rien et ne compte plus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "221f3b43-cc9e-414a-8f26-15ac6784941c",
                        "source_entry_id": "994f9326-5a8c-32b8-80a2-53c8adba1e8f",
