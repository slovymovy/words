                "senses": [
                    {
                        "sense_id": "da072295-b3c6-389b-80eb-39798cfe45fb",
                        "entry_id": "d38ba891-e44a-35e3-86cf-7aa84f2ebffd",
                        "glosses": [
                            "halbierte Semmel mit einer Scheibe warmen Leberkäse zwischen den beiden Hälften"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "fea51997-0e5c-41ab-b85d-a10ea9ebcdd3",
                                "sense_id": "da072295-b3c6-389b-80eb-39798cfe45fb",
                                "text": "Eine warme Leberkässemmel gibt es in Bayern praktisch bei jedem Metzger."
                            },
                            {
                                "example_id": "ab53d848-0871-4109-a0cd-631392c37b43",
                                "sense_id": "da072295-b3c6-389b-80eb-39798cfe45fb",
                                "text": "„Vor dem Klinikgebäude parkte ein Polizeiwagen, daneben standen zwei Sanitäter mit Leberkässemmeln in der Hand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
