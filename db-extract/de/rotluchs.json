                        ],
                        "form": "die Rotluchse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7074a3dc-09c5-36c5-ba6d-db06017ed345",
                        "entry_id": "26a8e5f5-0387-3761-a6c8-7b967feb4610",
                        "glosses": [
                            "(in Nordamerika beheimatetes) kleines, hochbeiniges katzenartiges Raubtier mit einem blassgelben bis rötlich braunen, häufig dunkelbraun bis schwarz gefleckten Fell, kleinem, rundlichem Kopf und kurzem Schwanz (Lynx rufus)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54d63fcd-5974-4a8f-8928-aa2fff15400f",
                                "sense_id": "7074a3dc-09c5-36c5-ba6d-db06017ed345",
                                "text": "„Eine Fahrt von Idaho ins nördliche Nevada zum Beispiel. Die führt durch dichte Wälder und über einen prächtigen Gebirgszug, in dem Schwarzbären, Rotluchse und Berglöwen leben und auf dessen Gipfeln man hunderte Meilen weit in eine Landschaft blicken kann, in der die Menschen so gut wie keine Spur hinterlassen haben.“"
                            },
                            {
                                "example_id": "8716ec1b-40e3-4c0d-98ca-58c86c662d29",
                                "sense_id": "7074a3dc-09c5-36c5-ba6d-db06017ed345",
                                "text": "„Der Biologe Snow hat die Bäuche gefangener Pythons aufgeschnitten und darin Überreste von Reihern, Rotluchsen, Waschbären, Beutelratten, Bindentauchern, Schneesichlern und Rallenkranichen gefunden.“"
                            },
                            {
                                "example_id": "cde4c6ef-e56d-46c7-be1c-0e4828f75545",
                                "sense_id": "7074a3dc-09c5-36c5-ba6d-db06017ed345",
                                "text": "„In Amerika lebt der Rotluchs mit verschiedenen Unterarten.“"
                            },
                            {
                                "example_id": "525e8489-741c-41fc-a77a-e125c7015940",
                                "sense_id": "7074a3dc-09c5-36c5-ba6d-db06017ed345",
                                "text": "„Ein Rotluchs schlich ums Lager und lamentierte über unser Eindringen in seinen Yard, sonst war alles nawa.“"
                            },
                            {
                                "example_id": "2c259e24-9136-42f6-80f1-6179f742781a",
                                "sense_id": "7074a3dc-09c5-36c5-ba6d-db06017ed345",
                                "text": "«Rotluchse sind kleiner als ihre hiesigen Verwandten und ernähren sich von Hasen, Kaninchen und Kleinsäugern.»"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
