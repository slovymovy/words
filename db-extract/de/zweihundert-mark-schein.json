                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "2a7ab880-e64b-42ca-aed0-9bf24328ccb0",
                                "sense_id": "7824cd7d-9794-38b2-bc19-3a3116846e34",
                                "text": "„(nach der Aktenlage handelte es sich in vier Fällen um einen Zweihundert-Mark-Schein und in einem Fall um einen Einhundert-Mark-Schein)“"
                            },
                            {
                                "example_id": "a61a494d-fe11-475b-8619-9301c04476f2",
                                "sense_id": "7824cd7d-9794-38b2-bc19-3a3116846e34",
                                "text": "„[…] einen Zweihundert-Mark-Schein hat es zwar (1985 gedruckt) gegeben, er kam aber nie in Umlauf.“"
                            },
                            {
                                "example_id": "2ef19eaf-b6ff-4a85-b93e-eb97e9f8a6a5",
                                "sense_id": "7824cd7d-9794-38b2-bc19-3a3116846e34",
                                "text": "„‚Ich bin Kalifornier und habe den Zweihundert-Mark-Schein in meinem Schreibtisch gefunden. […]‘“"
                            },
                            {
                                "example_id": "f0dbed00-5757-4ece-9499-e013ccde489d",
                                "sense_id": "7824cd7d-9794-38b2-bc19-3a3116846e34",
                                "text": "„Allein ein Drittel aller erkannten Fälschungen waren demzufolge Zweihundert-Mark-Scheine.“"
                            },
                            {
                                "example_id": "e69757fe-0c51-43e2-adc8-c5489b1f9216",
                                "sense_id": "7824cd7d-9794-38b2-bc19-3a3116846e34",
                                "text": "„Die Fünfzig-, Hundert- und Zweihundert-Mark-Scheine sind seit 1997 nicht mehr ganz so beliebt bei Fälschern.“"
                            }
                        ],
