                                                "sense_id": "6190911f-b1c1-3264-925b-f946afdb74fb",
                                                "text": "Pfahl (Viechtach), Ortsteil der Stadt Viechtach, Landkreis Regen, Bayern"
                                            },
                                            {
                                                "example_id": "b8ced9a4-bb90-4ef9-b32a-cd34873ca7e7",
                                                "sense_id": "6190911f-b1c1-3264-925b-f946afdb74fb",
