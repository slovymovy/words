            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "36c993fd-149d-3cf9-8304-d5f4409a11b5",
                    "sense_definition": "Drückt eine Beschränkung oder Ausschließlichkeit aus; nicht mehr als, bloß oder lediglich.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "einschraenkung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich trinke morgens <w>nur</w> eine Tasse schwarzen Kaffee zum Frühstück."
                        },
                        {
                            "text": "Das neue Ticket für den Bus kostet <w>nur</w> zwei Euro pro Fahrt."
                        }
                    ],
                    "synonyms": [
                        "bloß",
                        "lediglich",
                        "ausschließlich"
                    ],
                    "antonyms": [],
                    "common_phrases": [
                        "nur noch heute",
                        "nicht nur sondern auch",
                        "nur einen Moment"
                    ]
                },
                {
                    "sense_id": "a287c0dc-0371-351a-89e0-321a63283043",
                    "sense_definition": "Verstärkt eine Frage, Verwunderung oder einen Relativsatz im Sinne von überhaupt oder denkbar.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verstaerkung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich versuche meinen Freunden immer zu helfen, wo ich <w>nur</w> kann."
                        },
                        {
                            "text": "Wo hat mein Bruder in diesem Chaos <w>nur</w> seinen Schlüssel hingelegt?"
                        }
                    ],
                    "synonyms": [
                        "bloß",
                        "überhaupt"
                    ],
                    "common_phrases": [
                        "wo ich nur kann",
                        "was soll das nur",
                        "wie ist das nur möglich"
                    ]
                },
                {
                    "sense_id": "f84861f5-d00f-39ed-acb1-0bba541ca7c2",
                    "sense_definition": "Unterstreicht eine Aufforderung oder einen Rat im Sinne von ruhig oder ohne Bedenken.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "aufforderung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wenn du müde bist, leg dich <w>nur</w> hin, ich räume die Küche auf."
                        },
                        {
                            "text": "Frag <w>nur</w>, wenn du etwas nicht verstehst."
                        }
                    ],
                    "synonyms": [
                        "doch",
                        "ruhig"
                    ],
                    "common_phrases": [
                        "komm nur herein",
                        "mach nur weiter"
                    ]
                },
                {
                    "sense_id": "921acc67-03b4-312e-814b-03da14e356b9",
                    "sense_definition": "Leitet als Adverb eine einschränkende Bemerkung ein; drückt jedoch oder allerdings aus.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gegensatz",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wir könnten den Plan umsetzen, <w>nur</w> wären die finanziellen Risiken dabei viel zu groß."
                        },
                        {
                            "text": "Das Hotel war sehr schön, <w>nur</w> das Wetter hat leider überhaupt nicht mitgespielt."
                        }
                    ],
                    "synonyms": [
                        "jedoch",
                        "allerdings"
                    ],
                    "common_phrases": [
                        "nur mit dem Unterschied"
                    ]
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "68bc5415-f0cc-3153-a859-729c37cfc446",
                    "sense_definition": "Verbindet Hauptsätze und schränkt eine Aussage ein; gleichbedeutend mit aber.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "gegensatz",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich würde sehr gerne mitkommen, <w>nur</w> habe ich heute leider überhaupt keine Zeit."
                        },
                        {
                            "text": "Er wollte gestern pünktlich ankommen, <w>nur</w> der späte Zug hatte eine Stunde Verspätung."
                        }
                    ],
                    "synonyms": [
                        "aber",
                        "doch"
                    ],
                    "common_phrases": [
                        "nur dass"
                    ]
                }
            ]
        }
    ]
}