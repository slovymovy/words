                                        "glosses": [
                                            "Of or pertaining to a pharaoh."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fe0e7607-8a2a-3f44-9cb7-9b027ac8cbf0",
                                        "entry_id": "7c0dcf5b-e5f2-3fc3-b65b-1158154ee958",
                                        "glosses": [
                                            "Impressively large or luxurious."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff1ce641-4238-4494-872c-6d7d78bfc2a5",
                                                "sense_id": "fe0e7607-8a2a-3f44-9cb7-9b027ac8cbf0",
                                                "text": "It could be argued there is a note of shared significance to both deaths. Both feel like reminders that the real divide, so starkly present at this Pharaonic sporting super-show, is between the powerful and the powerless."
                                            },
                                            {
                                                "example_id": "b764638a-205e-4892-aa1e-ce2f744980fc",
                                                "sense_id": "fe0e7607-8a2a-3f44-9cb7-9b027ac8cbf0",
                                                "text": "Mark Zuckerberg sculpts his pharaonic Hawaii compound. He and his ilk own the present."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "811aaa04-8ced-383b-8eb0-d9e4ab97ed19",
                                        "entry_id": "7c0dcf5b-e5f2-3fc3-b65b-1158154ee958",
                                        "glosses": [
                                            "Tyrannical or brutally oppressive."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "99cc788d-6c29-3cd8-a85c-458bf96f6874",
                                        "entry_id": "7c0dcf5b-e5f2-3fc3-b65b-1158154ee958",
                                        "glosses": [
                                            "Of or pertaining to infibulation as a means of female genital mutilation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5acbf94-b247-4cd2-998f-f9d4695db787",
