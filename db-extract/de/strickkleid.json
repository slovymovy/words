                ],
                "senses": [
                    {
                        "sense_id": "b9a38dd7-0209-3490-97d6-0d56b2e89ae5",
                        "entry_id": "5d73a19e-ef7d-3b5f-8832-0fb6e9886bba",
                        "glosses": [
                            "Kleid, dessen Stoff aus erkennbaren einzelnen dickeren Fäden besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5abfe25-f67c-4e8e-978a-0faec97ea194",
                                "sense_id": "b9a38dd7-0209-3490-97d6-0d56b2e89ae5",
                                "text": "Die Modedesignerin Sonia Rykiel ist berühmt für ihre gestreiften Strickkleider."
                            },
                            {
                                "example_id": "af6b7b12-9b2b-4294-95ef-8b23e7c91722",
                                "sense_id": "b9a38dd7-0209-3490-97d6-0d56b2e89ae5",
                                "text": "„Eine schmale Frau, um die 70, im grauen Strickkleid schlurft heran.“"
                            },
                            {
                                "example_id": "108a55e6-44c3-40a2-8b33-6f4a9ec0b22a",
                                "sense_id": "b9a38dd7-0209-3490-97d6-0d56b2e89ae5",
                                "text": "„Lothars Frau Elke steht im dicken Strickkleid mit etwas Abstand zu ihm auf der Wiese, die Hände vor dem Bauch verhakt, Blick direkt in die Kamera.“"
                            },
                            {
                                "example_id": "acb1771c-54e3-46a2-ba84-6fc5a7527a01",
                                "sense_id": "b9a38dd7-0209-3490-97d6-0d56b2e89ae5",
                                "text": "„Sie trägt ein schwarzes halblanges Strickkleid, dazu eine schwarze Strumpfhose und schwarze Pumps.“"
                            },
                            {
                                "example_id": "7a9fdfa9-f7bb-4775-8c3e-02ae820d61d6",
                                "sense_id": "b9a38dd7-0209-3490-97d6-0d56b2e89ae5",
                                "text": "„Er konnte nur hoffen, dass sie unter dem Trenchcoat auch das kurze, enganliegende, schwarze Strickkleid trug, das ihm so an ihr gefiel.“"
                            },
                            {
                                "example_id": "cbc40ecb-b47e-4519-a03f-b6f1357161cd",
                                "sense_id": "b9a38dd7-0209-3490-97d6-0d56b2e89ae5",
                                "text": "[Vivienne Westwood:] „Ihre Haare leuchten feuerrot wie immer, heute trägt die einstige Königin des Punk ein dezentes graues Strickkleid.“"
                            },
                            {
                                "example_id": "9f45da90-0365-4810-9f15-953bb1b1e30f",
                                "sense_id": "b9a38dd7-0209-3490-97d6-0d56b2e89ae5",
                                "text": "[Second Hand Shop:] „Bei unserem Testkauf gab es einen Strickcardigan für 39 Euro und ein Strickkleid für 36 Euro.“"
                            },
                            {
                                "example_id": "538cebca-b506-4b91-974f-128b3e82a758",
                                "sense_id": "b9a38dd7-0209-3490-97d6-0d56b2e89ae5",
                                "text": "„Es gibt ein paar Designer, die unverwechselbar und unvergesslich sind und nicht ihresgleichen haben. Ihre Stücke sind durch nichts zu ersetzen und verlieren niemals ihren Wert. Ein Strickkleid von Missoni ist unbestritten eines dieser Stücke. Ob es keine anderen Strickkleider gibt? Aber natürlich. Doch werden diese in zehn, zwanzig oder dreißig Jahren noch immer aktuell sein? Eher nicht.“"
                            },
                            {
                                "example_id": "2b04b8a7-1712-4b05-99b4-985833678df1",
                                "sense_id": "b9a38dd7-0209-3490-97d6-0d56b2e89ae5",
                                "text": "„In diesem Winter der Coronapandemie, wo man zu Hause festsitzt, hat nun vor allem ein Teil Konjunktur: das Strickkleid. Die amerikanische Vogue stellt in ihrem Newsletter gleich mal 17 verschiedene Modelle vor. Angefangen bei Bottega Veneta und ihrem Strickkleid aus Baumwolle für 2.180 Dollar über das Kleid von Mango für 60 Dollar bis hin zum Turtleneck Sweater Dress von Entireworld für 195 Dollar.“"
                            },
                            {
                                "example_id": "bfef6607-d86a-48b4-a9f3-4efb56368454",
                                "sense_id": "b9a38dd7-0209-3490-97d6-0d56b2e89ae5",
                                "text": "„Seit 2002 entstehen im Atelier von Ludvig […] die Entwürfe für […] grobmaschige Strickkleider mit Fischleder-Accessoires, die eher auf internationale Laufstege als in die Innenstadt von Tórshavn passen.“"
                            },
                            {
                                "example_id": "6b6c516d-7889-4773-80d7-60730ac73316",
                                "sense_id": "b9a38dd7-0209-3490-97d6-0d56b2e89ae5",
                                "text": "„Verflixt! Dieses dämliche Strickkleid. In dem Ding konnte ich mich doch nicht mit Sam treffen!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
