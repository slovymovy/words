                                "example_id": "3f706de9-2406-4d1c-a325-5f6f22076b67",
                                "sense_id": "4fbfe39a-203d-30e1-b1f1-2bf3b189cf12",
                                "text": "Be she as foul as Florentius' love, / As old as Sibyl, and as curst and shrewd / As Socrates' Xanthippe, or worse, / She moves me not."
                            }
