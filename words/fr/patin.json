                {
                    "sense_id": "abb3299b-6a38-3e3e-9c10-8bd407b9b886",
                    "sense_definition": "Chaussure équipée d'une lame en acier ou de roulettes permettant de glisser sur la glace ou sur une surface plane.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "glisse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En hiver, les enfants aiment chausser leurs <w>patins</w> pour s'amuser sur la glace."
                        },
                        {
                            "text": "Elle a acheté une nouvelle paire de <w>patins</w> pour aller au parc ce week-end."
                        }
                    ],
                    "common_phrases": [
                        "patin à glace",
                        "patin à roulettes"
                    ]
                },
                {
                    "sense_id": "7bb6fc87-3255-309d-8aef-91bb31c9400b",
                    "sense_definition": "Pièce frottante d'un mécanisme de freinage qui entre en contact avec une roue ou une jante pour la ralentir.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mecanique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le mécanicien a rapidement changé le <w>patin</w> de frein usé sur la roue avant."
                        },
                        {
                            "text": "Il faut vérifier régulièrement les <w>patins</w> de son vélo pour assurer un bon freinage."
                        }
                    ],
                    "common_phrases": [
                        "patin de frein"
                    ]
                },
                {
                    "sense_id": "3d05e4ba-b720-3728-951f-37728d413771",
                    "sense_definition": "Baiser amoureux prolongé et passionné avec la langue.",
