                    },
                    {
                        "form_id": "615ade8a-da57-46fa-9a9f-bbd97994ffce",
                        "entry_id": "f981b223-5f8e-3397-b134-ac48cb901a1d",
                        "tags": [
                            "singular"
                        ],
                        "form": "портве́йну"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8655d3eb-05a7-3a07-b164-4bcd27fc9c63",
                        "entry_id": "f981b223-5f8e-3397-b134-ac48cb901a1d",
                        "glosses": [
                            "сорт сладкого креплёного виноградного вина"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "795cfe6f-ae00-4868-9536-f49830c62f7d",
                                "sense_id": "8655d3eb-05a7-3a07-b164-4bcd27fc9c63",
                                "text": "За рюмкой портвейну я напомнил ему о соломе."
                            },
                            {
                                "example_id": "a292f6ff-e4e5-48b8-8608-d172a00407be",
                                "sense_id": "8655d3eb-05a7-3a07-b164-4bcd27fc9c63",
                                "text": "Пили и шампанское, и кларет, и портвейн, и эль, и портер."
                            },
                            {
                                "example_id": "df842549-b0d0-4d49-8865-c152b80e0e2b",
                                "sense_id": "8655d3eb-05a7-3a07-b164-4bcd27fc9c63",
                                "text": "Кроме того, Вздошников и виноградные вина делает: мадеру, портвейн, лафит, рейнвейн."
                            },
                            {
                                "example_id": "f8226996-53e2-4a8d-827e-cfab0c73ec75",
                                "sense_id": "8655d3eb-05a7-3a07-b164-4bcd27fc9c63",
                                "text": "«Свадьба будет!» Да, будет, без сладкого портвейна, без гармошки."
                            },
                            {
                                "example_id": "34319e34-af3f-4eaa-846d-f76ed0f51880",
                                "sense_id": "8655d3eb-05a7-3a07-b164-4bcd27fc9c63",
                                "text": "Михаил принёс бутылку водки и бутылку портвейна, водку разлил себе и Илье, портвейн сёстрам и жене."
                            }
                        ]
                    }
                ],
