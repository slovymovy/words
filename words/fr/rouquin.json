                    "sense_id": "24c2286e-8c88-34db-b217-a333878583f9",
                    "sense_definition": "Personne qui a les cheveux roux.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "chevelure_rousse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce grand <w>rouquin</w> passe toutes ses vacances chez ses grands-parents à la campagne.",
                            "target_lang_translations": {
                                "en": "This tall <w>redhead</w> spends all his holidays at his grandparents' house in the countryside.",
                                "ru": "Этот высокий <w>рыжий</w> проводит все каникулы у бабушки с дедушкой в деревне.",
                                "de": "Dieser große <w>Rotschopf</w> verbringt alle seine Ferien bei seinen Großeltern auf dem Land.",
                                "es": "Este <w>pelirrojo</w> alto pasa todas sus vacaciones en casa de sus abuelos en el campo.",
                                "zh": "这个高个子<w>红头发的人</w>，所有假期都在乡下的祖父母家里度过。"
                            }
                        },
                        {
                            "text": "Mon camarade de classe est un <w>rouquin</w> très sympathique et toujours souriant.",
                            "target_lang_translations": {
                                "en": "My classmate is a very friendly <w>redhead</w> who is always smiling.",
                                "ru": "Мой одноклассник — очень приятный и всегда улыбающийся <w>рыжий</w>.",
                                "de": "Mein Klassenkamerad ist ein sehr sympathischer und immer lächelnder <w>Rotschopf</w>.",
                                "es": "Mi compañero de clase es un <w>pelirrojo</w> muy simpático y siempre sonriente.",
                                "zh": "我的同班同学是个<w>红头发的人</w>，非常友善，总是笑眯眯的。"
                            }
                        }
                    ],
