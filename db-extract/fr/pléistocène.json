                                "target_senses": [
                                    {
                                        "sense_id": "b86d34a0-bc95-3d4d-92cb-5e4c11316d2d",
                                        "entry_id": "b70393e2-4db1-3f65-91b3-cff337f2c5c9",
                                        "glosses": [
                                            "erdgeschichtliche Epoche, geprägt durch mehrere Eiszeiten, die vor etwa 2,4 Mio. Jahren begann und vor etwa 11.300 Jahren endete"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f29ec31-8236-4fb4-a0eb-7ef9bbb18ffd",
                                                "sense_id": "b86d34a0-bc95-3d4d-92cb-5e4c11316d2d",
                                                "text": "Das Pleistozän wurde abgelöst vom Holozän."
                                            },
                                            {
                                                "example_id": "68712073-326f-4ea9-a4fc-097332fe9553",
                                                "sense_id": "b86d34a0-bc95-3d4d-92cb-5e4c11316d2d",
                                                "text": "Im Pleistozän bedeckte das Eis bis zu 30% des gesamten Festlandes."
                                            },
                                            {
                                                "example_id": "cd145417-15ce-4c02-930e-bc34c0061194",
                                                "sense_id": "b86d34a0-bc95-3d4d-92cb-5e4c11316d2d",
                                                "text": "„Zu dieser Zeit herrschten in Mitteleuropa noch kaltzeitliche Verhältnisse mit deutlich geringeren Jahresmitteltemperaturen als heute, die - abgesehen von kurzen Wärmeschwankungen - für fast das gesamte damals ausklingende Pleistozän, das Eiszeitalter, kennzeichnend waren.“"
                                            },
                                            {
                                                "example_id": "d00e6573-25a1-45cc-b78a-be3efc12e97f",
                                                "sense_id": "b86d34a0-bc95-3d4d-92cb-5e4c11316d2d",
                                                "text": "„Im Pleistozän herrschten in Europa mehrere Eiszeiten.“"
                                            },
                                            {
                                                "example_id": "d8b73ce5-4bd9-436f-8fef-cfea21d6fc88",
                                                "sense_id": "b86d34a0-bc95-3d4d-92cb-5e4c11316d2d",
                                                "text": "„Im mittleren Pleistozän wirkten sich die klimatischen Bedingungen der Eiszeiten auf die biologische und kulturelle Evolution des Frühmenschen aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
