                "senses": [
                    {
                        "sense_id": "4dc05440-2329-3f1d-bb51-206245d869e4",
                        "entry_id": "4a93f86d-42b5-3c03-8353-30e632712753",
                        "glosses": [
                            "Wissenschaftler, der sich damit beschäftigt, Meinungen der Bevölkerung zu erforschen, z.B. durch das Auswerten von Umfragen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e8ab311-8859-4f16-b38a-d24c54277f6a",
                                "sense_id": "4dc05440-2329-3f1d-bb51-206245d869e4",
                                "text": "„Inzwischen ist es sogar soweit, dass die Demoskopen für ihre Umfragen nicht mehr genügend FDP-Wähler finden und die Partei zu bestimmten Fragepunkten gar nicht mehr auftaucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98820070-12bb-4dca-9262-6f898f968b4a",
