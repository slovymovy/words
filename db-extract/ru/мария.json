                    }
                ],
                "senses": [
                    {
                        "sense_id": "30eea485-dab9-3921-862a-44e483ce47d8",
                        "entry_id": "e9c1c4eb-ad69-3f81-a3d4-fe5bc7019359",
                        "glosses": [
                            "женское имя"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d595b93-c78d-442c-86f7-9e6f309f6e89",
                                "sense_id": "30eea485-dab9-3921-862a-44e483ce47d8",
                                "text": "Мари́я, бедная Мари́я, // Краса черкасских дочерей!"
                            },
                            {
                                "example_id": "ae2336cb-0827-4cd6-aa3f-2650fadadc53",
                                "sense_id": "30eea485-dab9-3921-862a-44e483ce47d8",
                                "text": "Пускай страдальческую грудь // Волнуют страсти роковые — // Душа́ готова, как Мари́я, // К ногам Христа навек прильнуть."
                            },
                            {
                                "example_id": "3d77c39a-0cd3-45a2-8c6f-fa1ccae38cae",
                                "sense_id": "30eea485-dab9-3921-862a-44e483ce47d8",
                                "text": "О, радуйся, мой друг, прелестная Мари́я!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3fdf0609-7343-4532-9a12-22dfc703804a",
                        "source_entry_id": "e9c1c4eb-ad69-3f81-a3d4-fe5bc7019359",
                        "source_sense_id": "30eea485-dab9-3921-862a-44e483ce47d8",
                        "source_sense_description": "Иноязычные аналоги",
                        "target_lang_word": "Maria",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Maria",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2096820-9ad9-3763-a736-45980a893f05",
                                        "entry_id": "829449f2-7fa5-3c1b-99e8-309b137068ea",
                                        "glosses": [
                                            "A female given name from Hebrew."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50b26b76-fc9d-40d1-9f16-536f17e659aa",
                                                "sense_id": "f2096820-9ad9-3763-a736-45980a893f05",
                                                "text": "Yet herein they come short of the monks and friars in their conceits of the word Maria; they have so tossed it and turned it, so anagrammatized and transposed it, that never were five poor letters so worried since time did put them into the alphabet."
                                            },
                                            {
                                                "example_id": "5eee7a7b-eb07-4d77-9430-b97ebc7a04ca",
                                                "sense_id": "f2096820-9ad9-3763-a736-45980a893f05",
                                                "text": "By their dresses, their names, and the airs of quality they give themselves, I am rendered ridiculous among all my acquaintance. My wife, who is a very plain good woman, and whose name is Amey, has been new-christened, and is called Amelia; and my little daughter, a child of a year old, is no longer Polly, but Maria."
                                            },
                                            {
                                                "example_id": "c18cc8a3-af3f-4dc4-aa4f-97f27a999dcd",
                                                "sense_id": "f2096820-9ad9-3763-a736-45980a893f05",
                                                "text": "I've just kissed a girl named Maria / And suddenly I found how wonderful a sound can be! / Maria! Say it loud and there's music playing / Say it soft and it's almost like praying"
                                            },
                                            {
                                                "example_id": "ca627ce2-cbc7-4002-ac55-f47a70e991cf",
                                                "sense_id": "f2096820-9ad9-3763-a736-45980a893f05",
                                                "text": "CNN anchor and correspondent Maria Santana was reporting from the scene when she and her team were hit by pepper balls and tear gas that officers fired into the crowd. “At that time, I can tell you, it is very hard to breathe, very hard to talk, your eyes begin to water,” she reported."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d1a24da-4cf4-3b37-805e-74354515c5d2",
                                        "entry_id": "829449f2-7fa5-3c1b-99e8-309b137068ea",
                                        "glosses": [
                                            "Synonym of Mary, mother of Jesus, in Latin, Spanish, etc. contexts."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b4189a24-f972-34b4-af55-adb0fb2a0de3",
                                        "entry_id": "829449f2-7fa5-3c1b-99e8-309b137068ea",
                                        "glosses": [
                                            "A surname originating as a matronymic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Maria",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b81b54e3-5a90-3252-ae07-cb61dbef3f97",
                                        "entry_id": "ff13b91b-853d-38c3-b6f6-1329af268fd4",
                                        "glosses": [
                                            "A Dravidian language spoken in Maharashtra and Madhya Pradesh provinces in India."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Maria",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "102f643b-510d-37a1-85ea-d73f3836840e",
                                        "entry_id": "4e963fda-4534-3cbc-ab26-20e6845e691c",
