                "senses": [
                    {
                        "sense_id": "1442817a-3994-3462-b583-3f920cd73c01",
                        "entry_id": "5a84a55b-c6c3-3529-ae45-30b8f0e97120",
                        "glosses": [
                            "Person im Ruhestand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca23dbbd-39cc-4c7a-a509-c1bbd2f4506e",
                                "sense_id": "1442817a-3994-3462-b583-3f920cd73c01",
                                "text": "„Etwa 20,5 Millionen Ruheständler können für Mitte 2014 mit einer Rentenerhöhung um voraussichtlich gut zwei Prozent rechnen.“"
                            },
                            {
                                "example_id": "f9d47904-0216-4582-8574-3eb0f108230c",
                                "sense_id": "1442817a-3994-3462-b583-3f920cd73c01",
                                "text": "„Auch als Ruheständler zog er es meistens vor, nachts im Bett zu lesen, doch statt tagsüber zu schreiben, sah er viel fern (wie sein Nachbar und Mieter nach seinem Tod bezeugte).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
