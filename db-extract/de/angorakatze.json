                "senses": [
                    {
                        "sense_id": "0cd6f053-6dbf-32b3-bbbc-9bd252cdbb11",
                        "entry_id": "054002a5-3bd6-340e-9f53-755f18621a55",
                        "glosses": [
                            "Hauskatzenzüchtung mit langem Fell, die es in diversen Farben gibt; Perserkatze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9135b42-4245-437f-914e-c2f27cc94753",
                                "sense_id": "0cd6f053-6dbf-32b3-bbbc-9bd252cdbb11",
                                "text": "Meine Freundin besitzt eine Angorakatze."
                            },
                            {
                                "example_id": "93907df3-037f-44b6-a3ae-60812981f8cf",
                                "sense_id": "0cd6f053-6dbf-32b3-bbbc-9bd252cdbb11",
                                "text": "Deine beiden Angorakatzen haben ja richtig langes Fell!"
                            },
                            {
                                "example_id": "cd834da9-669c-4989-8bd3-3a9ce61b7826",
                                "sense_id": "0cd6f053-6dbf-32b3-bbbc-9bd252cdbb11",
                                "text": "„Bei der Cats-Show spielte eine Angorakatze eine wichtige Rolle.“"
                            },
                            {
                                "example_id": "d48af890-776e-44ed-bc41-03ae34e9506e",
                                "sense_id": "0cd6f053-6dbf-32b3-bbbc-9bd252cdbb11",
                                "text": "„Ein prachtvoll schönes Tier ist die Angorakatze, die ein langes, seidiges Haar aufweist, ähnlich dem Angorakaninchen.“"
                            },
                            {
                                "example_id": "026d5869-a1bb-454e-9d48-673118fc2940",
                                "sense_id": "0cd6f053-6dbf-32b3-bbbc-9bd252cdbb11",
                                "text": "„»Ein wildes Kind, vielmehr eine Angorakatze«, dachte Hassa und fühlte plötzlich den unstillbaren Wunsch, die Angorakatze zu streicheln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
