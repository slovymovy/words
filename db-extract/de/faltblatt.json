                        ],
                        "form": "die Faltblätter"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "acbd00a6-fdc7-3fb5-aaf9-625f42bbdb37",
                        "entry_id": "3abb6d85-7845-39f0-8aec-a5f88742ed58",
                        "glosses": [
                            "ein kleines Schriftstück auf einem mindestens einmal gefalteten (zusammenklappbaren) Stück Papier mit Informationen oder Werbung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c0c2d85-db70-450a-981d-c4581372250b",
                                "sense_id": "acbd00a6-fdc7-3fb5-aaf9-625f42bbdb37",
                                "text": "Wahlwerbung wird häufig in Form von Faltblättern an die Wähler verteilt."
                            },
                            {
                                "example_id": "4ce1cdc7-ab10-45dc-9a9f-49f24164d6d8",
                                "sense_id": "acbd00a6-fdc7-3fb5-aaf9-625f42bbdb37",
                                "text": "„Früher war diese, nicht jeder erinnerte sich noch daran, ein dünnes Faltblatt gewesen, das Informationen enthalten hatte über die Haltestationen des Zuges, über Ankunfts- und Abfahrtszeiten und die Anschlusszüge.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af6247bd-6f4f-4edf-aa7e-83480057f86d",
                        "source_entry_id": "3abb6d85-7845-39f0-8aec-a5f88742ed58",
                        "source_sense_id": "acbd00a6-fdc7-3fb5-aaf9-625f42bbdb37",
