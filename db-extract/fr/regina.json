            {
                "entry_id": "d5b95899-3565-3c2a-9ad7-dcb6246954e0",
                "word": "Regina",
                "pos": "name",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "197b9052-37f5-4ef5-bb93-ab544dbbbd09",
                        "entry_id": "d5b95899-3565-3c2a-9ad7-dcb6246954e0",
                        "tags": [
                            "N’a pas de valeur officielle"
                        ],
                        "form": "Régina"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3692361a-af9a-3693-bb5a-68759bd031e6",
                        "entry_id": "d5b95899-3565-3c2a-9ad7-dcb6246954e0",
                        "glosses": [
                            "Capitale de la Saskatchewan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ff2d480-f5d6-43a5-8f31-e7cd5959e81d",
                                "sense_id": "3692361a-af9a-3693-bb5a-68759bd031e6",
                                "text": "Une femme de 19 ans est accusée de possession de marijuana dans le but d’en faire le trafic, et d’autres accusations pourraient suivre, à la suite d’une explosion survenue dans une maison à Regina."
                            },
                            {
                                "example_id": "4a85316a-ddb9-4ac7-98f8-6baec7515eb2",
                                "sense_id": "3692361a-af9a-3693-bb5a-68759bd031e6",
                                "text": "Le Canada allait être celui de Regina, d’Alberta, de Victoria; il n’allait pas être celui de Batoche, du lac aux Canards ou de l’Île-à-la-Crosse."
                            }
                        ]
                    },
                    {
                        "sense_id": "1f4bf56c-ba40-3d1a-81a4-592113a012ac",
                        "entry_id": "d5b95899-3565-3c2a-9ad7-dcb6246954e0",
                        "glosses": [
                            "Gouvernement de la Saskatchewan, basé dans cette ville."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "a68917da-ea52-46ce-8209-f372553f1495",
                                "sense_id": "1f4bf56c-ba40-3d1a-81a4-592113a012ac",
                                "text": "Plus de 2000 personnes manifestent pour dénoncer la décision de la province de ne plus financer la construction du centre de santé Station 20 Ouest. Le mois dernier, Regina a décidé de ne plus octroyer 8 millions de dollars pour la construction de la Station 20 Ouest qui devait notamment abriter une épicerie ainsi qu’offrir des soins dentaires et de santé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4b72dbdc-ae4b-42b6-8027-c5e7bcb64ecc",
                        "source_entry_id": "d5b95899-3565-3c2a-9ad7-dcb6246954e0",
                        "target_lang_word": "Regina",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Regina",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "82365f2e-591a-3556-ac64-05138b2956a2",
                                        "entry_id": "524db636-b260-39cf-806e-34fc442c8bac",
                                        "glosses": [
                                            "The reigning queen."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08ff861a-dff8-4d99-a134-58ea2d56ebcf",
                                                "sense_id": "82365f2e-591a-3556-ac64-05138b2956a2",
                                                "text": "Your Good FRIEND, / ANNE Regina. / SUNDERLAND."
                                            },
                                            {
                                                "example_id": "aa822268-1bfe-473a-bed0-0f02aeb56e85",
                                                "sense_id": "82365f2e-591a-3556-ac64-05138b2956a2",
                                                "text": "The conveying of the Duc de Nevers and a Capuchin father to Civita Vecchia in 1608, was, indeed the Regina’s [Marie de’ Medici’s] sole real commission."
                                            },
                                            {
                                                "example_id": "6f66eddc-a317-4fad-8e14-9f2a86eea74b",
                                                "sense_id": "82365f2e-591a-3556-ac64-05138b2956a2",
                                                "text": "Jesus is the new Adam, and Mary as the Queen of Heaven is His spouse and the perfection of Eve. / Perhaps the most explicit example of this felix culpa is displayed in the van Eyck Ghent Altarpiece. The artist used the same model for the shockingly nude Eve and for the Virgin Annunciate and her elevation to the heavens as the Regina, married to her own resurrected Son. Similarly, the model whom he used for Adam reappears in the inner presentation of the Altarpiece as Jesus in the role of the Regina’s Spouse."
                                            },
                                            {
                                                "example_id": "bc3dafea-1a9d-478c-a46a-165d3284178d",
                                                "sense_id": "82365f2e-591a-3556-ac64-05138b2956a2",
                                                "text": "After work, she [Queen Victoria] would roll in her wheelchair along the smooth paths between the cypresses, palms and urns overflowing with flowers that crammed the Regina’s paradisical garden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4793606a-898d-38b4-8956-05f477716c9e",
                                        "entry_id": "524db636-b260-39cf-806e-34fc442c8bac",
                                        "glosses": [
                                            "The capital city of Saskatchewan, Canada, with a metropolitan population of about 250,000."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b8291db0-bc46-33dd-877c-777c707b4d85",
                                        "entry_id": "524db636-b260-39cf-806e-34fc442c8bac",
                                        "glosses": [
                                            "A neighborhood in the community of Nokomis, Minneapolis, Minnesota, United States."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
