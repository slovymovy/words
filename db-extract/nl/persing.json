                        "examples": [
                            {
                                "example_id": "b66a8f20-2542-4054-b618-ec22a909688d",
                                "sense_id": "f44a700b-2306-3f53-b4fc-3d13ebe88543",
                                "text": "Zo is er in de eerste helft van het jaar vergeleken met 2012 maar liefst 10 procent minder besteed aan olijfolie uit de eerste koude persing, de basis voor menig delicieus Italiaans gerecht."
                            },
                            {
                                "example_id": "170f485e-3939-448e-aad2-31b4d6f7ced9",
                                "sense_id": "f44a700b-2306-3f53-b4fc-3d13ebe88543",
                                "text": "Originele persingen uit de jaren '60 van The Beatles zijn gewilde en vaak dure verzamelobjecten. Zo wisselde in 2008 een exemplaar van de dubbelelpee 'The Beatles', beter bekend als het 'White Album', voor 23.656 euro van eigenaar. Bijzondere aan de plaat was dat deze het volgnummer 0000005 had. Naar verluidt was de plaat eigendom van John Lennon die het album later aan een bevriende muzikant zou hebben gegeven."
                            }
                        ]
                    },
                    {
                        "sense_id": "7087ade5-c995-3e1a-a757-16b8ee1eed93",
                        "entry_id": "6abbdabc-8548-3a3c-a3cb-a93d1eec0caa",
                        "glosses": [
                            "de keer dat je door hard drukken iets gaat maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e76f7ed-7d9f-406d-9468-3964123adef4",
                                "sense_id": "7087ade5-c995-3e1a-a757-16b8ee1eed93",
                                "text": "De JuiceMe bevat een nieuw ontworpen persvat en vulopening voor optimaal gebruik.Als je verschillende sappen na elkaar wilt bereiden heeft de Juiceme een streepje voor op andere slowjuicers: met het automatische spoelsysteem is het apparaat in een mum van tijd klaar voor een volgende persing."
                            }
                        ]
                    }
