                ],
                "senses": [
                    {
                        "sense_id": "4e1dd49a-c041-3953-b62c-1b690c9bca5a",
                        "entry_id": "fa1cba93-f51a-3efd-ad9b-344c10cd583b",
                        "glosses": [
                            "A member of a semimonastic Christian lay religious order active in Northern Europe, particularly in the Low Countries in the 13th–16th centuries."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43936395-629e-49cc-9ab1-268eb647c99a",
                        "source_entry_id": "fa1cba93-f51a-3efd-ad9b-344c10cd583b",
                        "source_sense_id": "4e1dd49a-c041-3953-b62c-1b690c9bca5a",
                        "source_sense_description": "Translations",
                        "target_lang_word": "begijn",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "begijn",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "12f79779-7693-3b36-bdc0-3298f79da2c2",
                                        "entry_id": "eb754222-226d-3fc7-89c0-4389142178af",
                                        "glosses": [
                                            "vrouw die, zonder een kloostergelofte af te leggen, met anderen gemeenschappelijk als geestelijke zuster leefde (vanaf begin der 13de eeuw)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0e9f50c-17a6-4735-afaa-2a4829be4fd6",
                        "source_entry_id": "fa1cba93-f51a-3efd-ad9b-344c10cd583b",
                        "source_sense_id": "4e1dd49a-c041-3953-b62c-1b690c9bca5a",
                        "source_sense_description": "Translations",
                        "target_lang_word": "béguin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "béguin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ac839489-10bd-3905-a06f-bc88b99f7e27",
                                        "entry_id": "d67b6b3b-b8c0-3117-8a8c-6830245b16e5",
                                        "glosses": [
                                            "Membre d'un ordre franciscain qui s’opposa, durant le Moyen Âge, à l’Église et fit schisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dfd6034-86a7-4d13-bb13-2084a80d290c",
                                                "sense_id": "ac839489-10bd-3905-a06f-bc88b99f7e27",
                                                "text": "[…] il serait facile d’installer, au fond, des salles communes et un oratoire et cela suggérerait assez bien l’idée d’une miniature de couvent, d’un petit institut de béguins ou de laïques bénédictins."
                                            },
                                            {
                                                "example_id": "fb04c5e9-152c-496d-bc05-fdef250677c9",
                                                "sense_id": "ac839489-10bd-3905-a06f-bc88b99f7e27",
                                                "text": "D’ici furent dirigés ces inquisiteurs qui allèrent brûler Vaudois, cathares, fraticelles, béguins, sorciers, envoûteurs, magiciens, flagellants, ou juifs convertis, mais soupçonnés de sortilèges."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd9a1dc4-d5cc-3245-a8a0-4904d69a178a",
                                        "entry_id": "d67b6b3b-b8c0-3117-8a8c-6830245b16e5",
                                        "glosses": [
                                            "Habitant d'un logement communautaire appelé béguinage."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53035132-bdae-432d-82c0-103f717b6d4e",
                                                "sense_id": "dd9a1dc4-d5cc-3245-a8a0-4904d69a178a",
                                                "text": "Nazelles-Négron, près d’Amboise (Indre-et-Loire), les béguins qui n’envisageaient nullement d’être « animés » ont lancé un potager, ouvert leurs portes aux associations locales (photos, chorale…)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "béguin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aaee8fdb-fb7f-3511-a3df-41b4d2d87806",
                                        "entry_id": "cc44a91d-9087-32f7-8dd9-c994a9b78803",
                                        "glosses": [
                                            "Coiffe qui s’attache sous le menton avec une petite bride."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3635914-b161-4100-9005-e946fa94cb6a",
                                                "sense_id": "aaee8fdb-fb7f-3511-a3df-41b4d2d87806",
                                                "text": "Dans l’étage inférieur du tombeau, il y a une quantité de figures qui sont de petits chefs-d’œuvre. — L’une, toute enveloppée d’une camisole par-dessus une longue robe à plis, la tête dans un large béguin, un peu boudeuse et flegmatique à la flamande, est cependant bien aimable dans sa langueur calme."
                                            },
                                            {
                                                "example_id": "eaa245c6-11a3-439c-ad62-140a4831d984",
                                                "sense_id": "aaee8fdb-fb7f-3511-a3df-41b4d2d87806",
                                                "text": "Elle portait au-dessus d'une mante de drap noir un petit béguin blanc, presque de religieuse, et une maladie de peau donnait à une partie de ses joues et à son nez recourbé, les tons rose vif de la balsamine."
                                            },
                                            {
                                                "example_id": "feebe824-f5ff-44e8-8edc-5d5413c9f034",
                                                "sense_id": "aaee8fdb-fb7f-3511-a3df-41b4d2d87806",
                                                "text": "Je n'ai pas oublié non plus cette sorte de béguin Directoire en velours vert avec des incrustations de dentelle noire et des brides que ma mère portait (elle ne le mit que ce soir-là) le soir mémorable d’une représentation de l’Aiglon où elle fut malade."
                                            },
                                            {
                                                "example_id": "4df6a8d8-c704-447e-b0be-797bc4c4b1c0",
                                                "sense_id": "aaee8fdb-fb7f-3511-a3df-41b4d2d87806",
                                                "text": "Ôtant son béguin de velours cerise pour le remplacer par un madras, la créole découvrit ses épais et magnifiques cheveux..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44b315f4-0232-307d-9de2-4c7a1e6e4bbc",
                                        "entry_id": "cc44a91d-9087-32f7-8dd9-c994a9b78803",
                                        "glosses": [
                                            "Sorte de coiffe pour les enfants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2d89c66-3c7d-4024-9529-181537f58383",
                                                "sense_id": "44b315f4-0232-307d-9de2-4c7a1e6e4bbc",
                                                "text": "Sa petite sœur [de Petit-Pierre] Solange avait, pour la première fois de sa vie, une cornette à la place du béguin d’indienne que portent les petites filles jusqu’à l’âge de deux ou trois ans."
                                            },
                                            {
                                                "example_id": "cce183f5-503f-453b-9af0-6c7abd7bb113",
                                                "sense_id": "44b315f4-0232-307d-9de2-4c7a1e6e4bbc",
                                                "text": "Le soir, quand je suis rentré, tu étais couché dans ton berceau auprès de ta mère. Je te vois encore avec ton béguin, et tu n’étais pas beau."
                                            },
                                            {
                                                "example_id": "0e04c3b2-1517-4b21-8246-de8840fc62a6",
                                                "sense_id": "44b315f4-0232-307d-9de2-4c7a1e6e4bbc",
                                                "text": "Bien serré dans ses langes, la mine rose et les yeux bleus, avec son manteau de brocart et son béguin chargé de perles, il ressemblait à un petit Jésus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5312da23-da55-31c9-aaf0-7d704e4ebcc7",
                                        "entry_id": "cc44a91d-9087-32f7-8dd9-c994a9b78803",
                                        "glosses": [
                                            "Petit bonnet que les chevaux portent à l’écurie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "béguin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5c6f0701-9db9-3f75-a3a0-d52aaab9acb7",
                                        "entry_id": "e6034bbe-7ab1-3ba7-8251-432a8945cb72",
                                        "glosses": [
                                            "Affection soudaine pour quelqu’un, tocade."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32bed32a-a9ae-4de7-8920-e62796f7722a",
                                                "sense_id": "5c6f0701-9db9-3f75-a3a0-d52aaab9acb7",
                                                "text": "Nées pour faire l’amour toute leur vie, elles savent que c’est un dur moment quand tout se décolle et elles évitent les béguins."
                                            },
                                            {
                                                "example_id": "ee9ded24-97fa-44b1-8c7e-a1f524cd8581",
                                                "sense_id": "5c6f0701-9db9-3f75-a3a0-d52aaab9acb7",
                                                "text": "Tout cela, pour si flatteur qu’il vous paraisse et qu’il vous soit, n’a rapport que d’assez loin à cette espèce de passion canaille dénommée béguin."
                                            },
                                            {
                                                "example_id": "66c6ffe8-dd36-4491-980a-418b6762088e",
                                                "sense_id": "5c6f0701-9db9-3f75-a3a0-d52aaab9acb7",
                                                "text": "— Mais raconte, nom de Dieu, raconte ! J'en ai jamais baisé, moi, de Polonaise. Tu l'as eue tout de suite, là, au béguin ?\n— Non, c'est le résultat d'une erreur. Elle m'a pris pour un gendarme."
                                            },
                                            {
                                                "example_id": "86d93faf-561e-4aeb-a015-eb1475f410be",
                                                "sense_id": "5c6f0701-9db9-3f75-a3a0-d52aaab9acb7",
                                                "text": "Je suis biaiseuse chez Paquin,\nPour mon métier j’ai le béguin\nQuand mes parents m’voient pas rentrer\nY disent y’a pas à s’inquiéter\nElle est encore en train d’biaiser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45d6f168-07d5-3eb6-bbb3-952ae3954db0",
                                        "entry_id": "e6034bbe-7ab1-3ba7-8251-432a8945cb72",
                                        "glosses": [
                                            "Soupirant."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09a926e2-8800-4dba-9b41-33f45782fe12",
                                                "sense_id": "45d6f168-07d5-3eb6-bbb3-952ae3954db0",
                                                "text": "Il entrait dans une salle de restaurant, la tête haute, le chapeau en arrière, et aussitôt, dans quelque groupe joyeux, il se trouvait toujours une belle femme pour dire : « Tiens, voilà mon béguin. »"
                                            },
                                            {
                                                "example_id": "499ab7b8-f838-4d54-981e-1606ebaecbdb",
                                                "sense_id": "45d6f168-07d5-3eb6-bbb3-952ae3954db0",
                                                "text": "— Mais, me dit-il, en quel honneur vous voit-on ici ? Vous avez cet aspect qu’on prend malgré soi, lorsqu’on attend une autre dame que celles qui sont là. Est-ce que vous auriez fait un béguin, par hasard ?"
                                            },
                                            {
                                                "example_id": "dc23b172-a9f9-4c3d-b6de-63e50c5e8e04",
                                                "sense_id": "45d6f168-07d5-3eb6-bbb3-952ae3954db0",
                                                "text": "Ma chère, lui dit Michel, je crois que tu as fait un béguin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a77b98da-4f8f-4bca-8b59-fbb9a6038265",
                        "source_entry_id": "fa1cba93-f51a-3efd-ad9b-344c10cd583b",
                        "source_sense_id": "4e1dd49a-c041-3953-b62c-1b690c9bca5a",
                        "source_sense_description": "Translations",
                        "target_lang_word": "béguine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "béguine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c31095f1-ef8f-3366-8da5-488a5f8b0b4d",
                                        "entry_id": "5c352679-2044-382a-ab14-4551bcbbb5f2",
                                        "glosses": [
                                            "Religieuse qui est soumise aux règles monastiques sans avoir prononcé de vœux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab1b24a8-4878-4c5c-90b7-b7a4b7e2743d",
                                                "sense_id": "c31095f1-ef8f-3366-8da5-488a5f8b0b4d",
                                                "text": "Ce mouvement spirituel des béguines, à partir du XIIᵉ siècle, grandit dans les Flandres au nord de la France, et en Allemagne."
                                            },
                                            {
                                                "example_id": "58a6b399-dc5a-4b64-bd1b-08c5c355edb1",
                                                "sense_id": "c31095f1-ef8f-3366-8da5-488a5f8b0b4d",
                                                "text": "« Chez nous, il y a des femmes qu’on nomme béguines. Un certain nombre d’entre elles excellent en arguties et raffolent de nouveautés. Elles lisent la Bible en groupe, sans respect, d’une manière pleine d’audace, et cela en petites assemblées, dans des ateliers et même en pleine rue », s’offusque le moine Guibert de Tournai, lors du concile de Lyon, en 1274."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c62a72b5-ff54-34d5-bec9-0b59b89b5523",
                                        "entry_id": "5c352679-2044-382a-ab14-4551bcbbb5f2",
                                        "glosses": [
                                            "Religieuse d’une communauté des Pays-Bas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bedd834a-b373-42e3-9703-3c48df77faaa",
                                                "sense_id": "c62a72b5-ff54-34d5-bec9-0b59b89b5523",
                                                "text": "La supérieure des béguines, […], ne put suivre ses compagnes : le lendemain, on la trouvait dans la cave du béguinage, asphyxiée, les bras en croix."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55a4d060-c9e6-347b-8cea-a27330c6262c",
                                        "entry_id": "5c352679-2044-382a-ab14-4551bcbbb5f2",
                                        "glosses": [
                                            "Dévote minutieuse."
                                        ],
                                        "tags": [
                                            "dated",
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7b69003-391e-4059-a108-2e68ca4b676c",
                                                "sense_id": "55a4d060-c9e6-347b-8cea-a27330c6262c",
                                                "text": "[…] ; vous les béguines au noir bonnet, vous direz vos patenôtres au lieu de radoter sur l'un et l'autre et en même temps ça vous diminuera votre temps de purgatoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2579cf15-998a-392d-b159-e989d5ec5f9e",
                                        "entry_id": "5c352679-2044-382a-ab14-4551bcbbb5f2",
                                        "glosses": [
                                            "Personne qui pratique un mode de vie inspiré de celui des béguinages du Moyen Age."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
