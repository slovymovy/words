                    {
                        "form_id": "1950041d-f994-4f90-a568-87de44093a64",
                        "entry_id": "32b36824-9461-3d73-8f52-a5b16894511e",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "grijsaardjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "934c88d6-155e-3b6b-9c07-3c2a8eed7ed7",
                        "entry_id": "32b36824-9461-3d73-8f52-a5b16894511e",
                        "glosses": [
                            "oude man"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bbb2e29-4d42-4254-b2e1-3980ec0a8c26",
                                "sense_id": "934c88d6-155e-3b6b-9c07-3c2a8eed7ed7",
                                "text": "De grijsaard zei hem: 'Blijf in je habijt en ik zal boete doen voor jou.'"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a2a98ed-f391-4482-ac0e-a62d66495654",
                        "source_entry_id": "32b36824-9461-3d73-8f52-a5b16894511e",
                        "source_sense_id": "934c88d6-155e-3b6b-9c07-3c2a8eed7ed7",
                        "source_sense_description": "oude man",
                        "target_lang_word": "Greis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Greis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7ecf5733-bca9-315f-a114-c6a63b7598b7",
                                        "entry_id": "cd94d810-f2e0-3e85-9291-b4c6a3f4e2ef",
                                        "glosses": [
                                            "sehr alter Mensch, meist Mann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ae4e08c-2c27-472e-9624-2fa77a8f4756",
                                                "sense_id": "7ecf5733-bca9-315f-a114-c6a63b7598b7",
                                                "text": "Nachdem ich Ludwig 1922 aus den Augen verloren hatte, traf ich ihn erst 72 Jahre später wieder, als er schon ein Greis war."
                                            },
                                            {
                                                "example_id": "839b7f90-1f50-4a1e-81d0-75b42ef31d47",
                                                "sense_id": "7ecf5733-bca9-315f-a114-c6a63b7598b7",
                                                "text": "„Heute amüsiert man sich königlich darüber, wenn man liest, daß etwa der große deutsche Philosoph Immanuel Kant in der Laudatio der Königsberger Universität zu seinem 50. (!) Geburtstag mit ‚Ehrwürdiger Greis‘ angesprochen wurde.“"
                                            },
                                            {
                                                "example_id": "054474f5-09c8-4294-98b4-71596c447ecc",
                                                "sense_id": "7ecf5733-bca9-315f-a114-c6a63b7598b7",
                                                "text": "„Den mümmelnden Greis gibt es nicht mehr. Er trägt Implantate.“"
                                            },
                                            {
                                                "example_id": "05854b98-65ed-4bb7-b9f9-567248b8fd4c",
                                                "sense_id": "7ecf5733-bca9-315f-a114-c6a63b7598b7",
                                                "text": "„Der parfümierte Greis schwang sich rittlings auf einen Stuhl und blieb uns zugekehrt, als ich Lena aufzuknöpfen begann.“"
                                            },
                                            {
                                                "example_id": "0e500622-8f5c-4d9d-ab4c-ba36b23808f8",
                                                "sense_id": "7ecf5733-bca9-315f-a114-c6a63b7598b7",
                                                "text": "„Pierre war auf den Korridor gegangen und sah den halb wahnsinnigen Greis mitleidig und angeekelt zugleich an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a8391802-0c45-44d4-a4ed-691954d856f0",
                        "source_entry_id": "32b36824-9461-3d73-8f52-a5b16894511e",
                        "source_sense_id": "934c88d6-155e-3b6b-9c07-3c2a8eed7ed7",
                        "source_sense_description": "oude man",
                        "target_lang_word": "vieillard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vieillard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e5826b6a-9821-3ebc-a9ab-cf6556a07f58",
                                        "entry_id": "2a57cc14-70fc-3597-ade3-ab6ee750caba",
                                        "glosses": [
                                            "Homme d’un âge avancé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11750504-cae3-4f5d-b94d-f59aca8200bf",
                                                "sense_id": "e5826b6a-9821-3ebc-a9ab-cf6556a07f58",
                                                "text": "Le vieillard, qui revient vers la source première,\nEntre aux jours éternels et sort des jours changeants ;\nEt l’on voit de la flamme aux yeux des jeunes gens,\nMais dans l’œil du vieillard on voit de la lumière."
                                            },
                                            {
                                                "example_id": "08f800a8-96ee-4f4e-83c2-7d01a0a20244",
                                                "sense_id": "e5826b6a-9821-3ebc-a9ab-cf6556a07f58",
                                                "text": "Nous avons connu des vieillards qui étaient, hélas ! ce que nous ne sommes plus, c’est-à-dire des hommes de bonne compagnie."
                                            },
                                            {
                                                "example_id": "fd57a81f-58f4-4c57-81ee-1b20dd912750",
                                                "sense_id": "e5826b6a-9821-3ebc-a9ab-cf6556a07f58",
                                                "text": "Mais, à la place d’un vaillant général, on ne vit qu’un vieillard à la voix enrouée branlant gâteusement la tête."
                                            },
                                            {
                                                "example_id": "fce1476c-2561-4326-86fd-2bcfd7ff4734",
                                                "sense_id": "e5826b6a-9821-3ebc-a9ab-cf6556a07f58",
                                                "text": "Avec beaucoup de tact, ce vieillard, qui savait n’être ni autoritaire ni égoïste, s’efforçait de gagner l’affection de Nazira et de se faire pardonner d’être vieux."
                                            },
                                            {
                                                "example_id": "eb73525c-79a4-4080-a4e4-4ee24e0a4546",
                                                "sense_id": "e5826b6a-9821-3ebc-a9ab-cf6556a07f58",
                                                "text": "Ici un vieillard tuberculeux tisonnant un poêle et prolongeant son agonie tout en criblant innocemment de ses bacilles les tout petits confiés à sa garde."
                                            },
                                            {
                                                "example_id": "a2ea9de7-2114-4dcc-bf23-ac7ea1de7b27",
                                                "sense_id": "e5826b6a-9821-3ebc-a9ab-cf6556a07f58",
                                                "text": "C’est un long vieillard, mince comme un baliveau, un peu courbé par une bonne septantaine d’ans."
                                            },
                                            {
                                                "example_id": "dcac358f-08dd-4709-9928-3f624158260c",
                                                "sense_id": "e5826b6a-9821-3ebc-a9ab-cf6556a07f58",
                                                "text": "Aussi la duchesse avait-elle conservé ces lettres émouvantes, comme certains vieillards ont des gravures obscènes, à cause des éloges hyperboliques donnés à ce qu’elle avait de moins duchesse en elle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92378d7a-2dc4-3794-956b-bcf4977a4f3d",
                                        "entry_id": "2a57cc14-70fc-3597-ade3-ab6ee750caba",
                                        "glosses": [
                                            "Personnes d’un âge avancé, hommes ou femmes."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54b28cff-f63d-44bb-9b15-43e5184bd376",
                                                "sense_id": "92378d7a-2dc4-3794-956b-bcf4977a4f3d",
                                                "text": "Moi, j’aimerais habiter la montagne, où il y a de grands arbres qui sont plus vieux que les plus anciens des vieillards, […]"
                                            },
                                            {
                                                "example_id": "25cc40b1-f99b-4aab-a6f1-79f0f6548294",
                                                "sense_id": "92378d7a-2dc4-3794-956b-bcf4977a4f3d",
                                                "text": "Les rares villages qu'on traversait étaient quasi déserts. On ne trouvait dans les fermes et les isbas que quelques vieillards, parfois des enfants."
                                            },
                                            {
                                                "example_id": "f9e0c01e-a47e-4478-ab9a-f4ecbfbad5bc",
                                                "sense_id": "92378d7a-2dc4-3794-956b-bcf4977a4f3d",
                                                "text": "Dans quelques heures, les compartiments et les couchettes se rempliront d’enfants et de vieillards, de baluchons rassemblés à la va-vite, de chats, de chiens, et de l’immense tristesse de l’exil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1b3441e-136a-46ce-9562-18d650006d87",
                        "source_entry_id": "32b36824-9461-3d73-8f52-a5b16894511e",
                        "source_sense_id": "934c88d6-155e-3b6b-9c07-3c2a8eed7ed7",
                        "source_sense_description": "oude man",
                        "target_lang_word": "старик",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "старик",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "138cba65-45e6-347e-9614-a02b9bb61945",
                                        "entry_id": "e923d589-3121-35cb-bc38-0aec19841b5d",
                                        "glosses": [
                                            "мужчина, достигший старости"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "438affe1-0653-41d1-b6bf-5b47297a0209",
                                                "sense_id": "138cba65-45e6-347e-9614-a02b9bb61945",
                                                "text": "Мудрый старик и глупый царь ¶ Во времена давно прошедшие был в одном городе молодой царь. Невзлюбил он стариков и повелел всех их убить. ❬…❭"
                                            },
                                            {
                                                "example_id": "c880514c-1c44-4dc8-bc76-80e6b2c80eb6",
                                                "sense_id": "138cba65-45e6-347e-9614-a02b9bb61945",
                                                "text": "❬…❭ Он как-то сразу сдал, посерел. Ещё не старик, но уже пожилой, с обмякшими щёчками дяденька. ❬…❭"
                                            },
                                            {
                                                "example_id": "d2ba33d1-c28f-4117-b520-5cce2271da7d",
                                                "sense_id": "138cba65-45e6-347e-9614-a02b9bb61945",
                                                "text": "❬…❭ Выглядит [Фукс] стариком, хотя не стар, лет сорока пяти: лысина, пенсне, сивая борода. ❬…❭"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e046a3cb-da93-366a-a51c-4a7bbea74cff",
                                        "entry_id": "e923d589-3121-35cb-bc38-0aec19841b5d",
                                        "glosses": [
                                            "мн. ч. старые люди (мужчины и женщины)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ada96d5-c027-4289-ad4b-f89a916805ce",
                                                "sense_id": "e046a3cb-da93-366a-a51c-4a7bbea74cff",
                                                "text": "❬…❭ Мне рассказали такой случай. Ярмарка взялась обеспечить прибавку к пенсии старикам и инвалидам микрорайона. Через несколько месяцев учредителей вызывают в префектуру и показывают им письмо — жалобу, что ярмарка мешает спокойно жить, развели шум и грязь, антисанитарию и махинации, надо её закрыть, зарыть, уничтожить. Подписи под жалобой вполне соответствовали списку лиц, получающих вспоможение от дирекции. ❬…❭"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6372c4c-6fe3-3665-b9ff-518122b4b7bc",
                                        "entry_id": "e923d589-3121-35cb-bc38-0aec19841b5d",
                                        "glosses": [
                                            "мн. ч., разг. родители и/или другие родственники старшего возраста"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11b04e5e-d9d9-472b-ba71-acff4531e0a4",
                                                "sense_id": "d6372c4c-6fe3-3665-b9ff-518122b4b7bc",
                                                "text": "Он сидит на шее у своих стариков."
                                            },
                                            {
                                                "example_id": "45011b42-b42f-4099-ac86-77d80ab6b599",
                                                "sense_id": "d6372c4c-6fe3-3665-b9ff-518122b4b7bc",
                                                "text": "Надо навестить своих стариков."
                                            },
                                            {
                                                "example_id": "6a461e0e-474b-4357-81c3-ad14b9c52db1",
                                                "sense_id": "d6372c4c-6fe3-3665-b9ff-518122b4b7bc",
                                                "text": "Постарели мои старики."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3543fc39-49bb-3253-9c48-cb9c6a2d7fdc",
                                        "entry_id": "e923d589-3121-35cb-bc38-0aec19841b5d",
                                        "glosses": [
                                            "мн. ч., фам. обращение к своим родителям"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32ca8081-dbe1-472e-919f-1cbca3c623aa",
                                                "sense_id": "3543fc39-49bb-3253-9c48-cb9c6a2d7fdc",
                                                "text": "— Эй, старики, гоните монету!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66177625-e237-3d19-96fa-b81b3f7834bb",
                                        "entry_id": "e923d589-3121-35cb-bc38-0aec19841b5d",
                                        "glosses": [
                                            "разг. опытный, бывалый человек, уже знающий какое-либо дело, работу (в противоположность новичку)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d33aec0-6c2f-4c37-9883-cccc3754298c",
                                                "sense_id": "66177625-e237-3d19-96fa-b81b3f7834bb",
                                                "text": "— Этот студент не впервые в стройотряде, уже старик."
                                            },
                                            {
                                                "example_id": "c84e67db-4306-4047-8485-57c1ac073d4a",
                                                "sense_id": "66177625-e237-3d19-96fa-b81b3f7834bb",
                                                "text": "В археологическую экспедицию поехали новенькие и старики."
                                            },
                                            {
                                                "example_id": "5221cb70-6eef-4109-874d-e37e45fd5cc2",
                                                "sense_id": "66177625-e237-3d19-96fa-b81b3f7834bb",
                                                "text": "Эти парни уже старики на стройке."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4037428b-22c1-38f9-8950-ca6e70fdca6f",
                                        "entry_id": "e923d589-3121-35cb-bc38-0aec19841b5d",
                                        "glosses": [
                                            "фам. или шутл. обращение к давнему другу, приятелю"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99e76ff0-fdda-47ff-9a1b-cf92979c5f74",
                                                "sense_id": "4037428b-22c1-38f9-8950-ca6e70fdca6f",
                                                "text": "— Привет, старик!"
                                            },
                                            {
                                                "example_id": "be85bfd9-d3ad-4028-b6af-6d5b3b182b48",
                                                "sense_id": "4037428b-22c1-38f9-8950-ca6e70fdca6f",
                                                "text": "— Эй, старик, дай прикурить!"
                                            },
                                            {
                                                "example_id": "8a6f9e75-0c38-4c95-a68b-5b19bb2bd889",
                                                "sense_id": "4037428b-22c1-38f9-8950-ca6e70fdca6f",
                                                "text": "— Ну ты, старик, даёшь!"
                                            }
                                        ]
                                    }
                                ]
                            },
