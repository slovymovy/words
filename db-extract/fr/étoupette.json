                        "glosses": [
                            "Bâtonnet de bois dont un bout est recouvert d’étoffe ou de coton, préfiguration d'un coton-tige."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c0a8b72-f986-4935-80f1-c360966e012f",
                                "sense_id": "028835ed-90d9-37ef-9153-9a715cb57376",
                                "text": "« Coupez-moi un petit bout de bois dans ce balais de bruyère », dit le jeune homme. Il fit une étoupette avec un peu de charpie de sa sacoche et il nettoya la bouche de l’homme."
                            },
                            {
                                "example_id": "4982fc22-de90-450d-a3d2-429c7af7e6d0",
                                "sense_id": "028835ed-90d9-37ef-9153-9a715cb57376",
                                "text": "Cette défense s'étendra aux cocons restans des moresques, ou cocons mouillés dans les bassins, percé.s, crus et percés lavés, ainsi qu'à la partie supérieure du cocon au naturel et à l'étoupette du cocon."
                            }
                        ]
                    }
