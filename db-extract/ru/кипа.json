                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fde88a0-80bd-4b82-be8f-ef102dbcd983",
                                                "sense_id": "9e6498df-5a0d-3694-acaf-953af42bfb72",
                                                "text": "Cry a reward, to him who shall first bring\n News of that vanished Arabian,\n A full-heap’d helmet of the purest gold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26f11a65-7f53-383f-a2db-b5efb065cc0c",
                                        "entry_id": "c3461773-1526-3e5a-9a68-b52536ea1226",
                                        "glosses": [
                                            "To supply in great quantity."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40199c85-bac4-49e6-8941-60e6ebc7f145",
                                                "sense_id": "26f11a65-7f53-383f-a2db-b5efb065cc0c",
                                                "text": "They heaped praise upon their newest hero."
                                            },
                                            {
                                                "example_id": "9e27b329-ee3b-437e-866b-d0b25a0a3fe0",
                                                "sense_id": "26f11a65-7f53-383f-a2db-b5efb065cc0c",
                                                "text": "Then, in January, a creeping tsunami of train cancellations, triggered by major staff absences as a result of the aggressive transmissibility of Omicron, heaped further misery on rail users."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "heap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f166330-893c-3f21-bfdd-d47b7a7af7cd",
                                        "entry_id": "281f0a4b-5dec-3364-bdbb-645010c9b91f",
                                        "glosses": [
                                            "very or much; representing broken English stereotypically or comically attributed to Native Americans"
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "offensive",
                                            "possibly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d1cd7ac-095d-4b08-89ee-cc8f4c53a36c",
                                                "sense_id": "2f166330-893c-3f21-bfdd-d47b7a7af7cd",
                                                "text": "Chuckaway too no good. Heap water, little chuckaway. Heap sticks, and still little chuckaway."
                                            },
                                            {
                                                "example_id": "34cd34f7-5512-4b7a-8b6d-35bdfa9f91d9",
                                                "sense_id": "2f166330-893c-3f21-bfdd-d47b7a7af7cd",
                                                "text": "We are all familiar with the stereotyped broken English which writers of Western stories, comic strips, and similar literature put into the mouths of Indians: 'me heap big chief', 'you like um fire water', and so forth."
                                            },
                                            {
                                                "example_id": "b1529762-80af-4ce4-bf40-3be5e7448495",
                                                "sense_id": "2f166330-893c-3f21-bfdd-d47b7a7af7cd",
                                                "text": "Once upon a time, a Scotsman, an Englishman, and an Irishman are captured by the Red Indians […] He approaches the Englishman, pinches the skin of his upper arm, and says, \"Hmmm, heap good skin, nice and thick."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
