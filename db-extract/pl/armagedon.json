                        ],
                        "examples": [
                            {
                                "example_id": "e7575a53-73e9-48a8-96d6-8937c16d2f66",
                                "sense_id": "945b84e9-10a6-3802-91f4-8250ee84d1f8",
                                "text": "Bójka na stadionie była prawdziwym Armagedonem!"
