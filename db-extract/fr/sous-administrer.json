                "senses": [
                    {
                        "sense_id": "7ac38471-9ab5-3dd9-afd2-29a9d77d14d3",
                        "entry_id": "fd0c3db1-d57d-33b4-9b21-9df0033a387e",
                        "glosses": [
                            "Ne pas administrer suffisamment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10b8ea97-6dda-45f0-a12c-0e044db1e91b",
                                "sense_id": "7ac38471-9ab5-3dd9-afd2-29a9d77d14d3",
                                "text": "Pour les élus, administrer autant de communes directement depuis la préfecture, c'est «sous-administrer»."
                            },
                            {
                                "example_id": "83c0a55a-60b6-40a3-ae02-bc9b46073320",
                                "sense_id": "7ac38471-9ab5-3dd9-afd2-29a9d77d14d3",
                                "text": "Dans sa hâte, ou peut-être dans sa volonté de ne pas sous-administrer, elle a omis ces anachronismes, à l'époque de l'automobile et de la motorisation généralisée, ces organismes de freinage de l'action administrative : les sous- préfectures."
                            }
                        ]
                    }
