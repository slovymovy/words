                        ],
                        "examples": [
                            {
                                "example_id": "3e519a82-826d-4ed0-bcd0-e926937da323",
                                "sense_id": "7b704d29-7e44-3ad2-9f54-775f668db82d",
                                "text": "Der BGH weist insoweit zu Recht darauf hin, dass die vorübergehende mietweise Fremdnutzung von abnutzbaren Gütern wie Pkw wegen der viel höheren, nicht abnutzungsbedingten Kostenfaktoren weit über den Wert der Gebrauchsvorteile hinausreicht, die man bei Erwerb des Gegenstandes zur Eigennutzung erzielt und die sich aus der regelmäßigen Abnutzung errechnen lassen."
                            }
                        ]
