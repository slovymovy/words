                    }
                ],
                "senses": [
                    {
                        "sense_id": "8b8e0722-71f3-30c2-84a4-bdce2bfff203",
                        "entry_id": "fceded11-acc1-3956-b750-421369694379",
                        "glosses": [
                            "Hypermétrope, qui ne distingue bien que les objets éloignés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "207db578-396e-4ff2-ad94-6d7a7dba16f7",
                                "sense_id": "8b8e0722-71f3-30c2-84a4-bdce2bfff203",
                                "text": "Les vieillards sont le plus souvent presbytes."
                            },
                            {
                                "example_id": "81005f53-b5e9-443c-a3b8-532be59756ab",
                                "sense_id": "8b8e0722-71f3-30c2-84a4-bdce2bfff203",
                                "text": "Je le vois soudain en personne en face de moi, posant son binocle devant ses yeux presbytes, sursautant dès les premiers mots, puis, avec sa façon colérique, frappant brusquement du poing sur la table."
                            }
                        ]
                    },
                    {
                        "sense_id": "6129df53-adea-3f29-97ee-59f54dfe3cf1",
                        "entry_id": "fceded11-acc1-3956-b750-421369694379",
                        "glosses": [
                            "Qui a une vision générale des êtres et des choses, qui ne discerne pas leurs aspects immédiats, partiels."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "94ecbd90-2163-42f5-b5dd-c3004a547cb9",
                                "sense_id": "6129df53-adea-3f29-97ee-59f54dfe3cf1",
                                "text": "Il était de ces esprits presbytes, qui sont gênés, de près. Ils ont parfois du génie, et butent à chaque pas."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2aed9edf-7e91-4548-84b5-6cb044abab1b",
                        "source_entry_id": "fceded11-acc1-3956-b750-421369694379",
                        "target_lang_word": "weitsichtig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "weitsichtig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b2a9865b-259c-3f96-99c3-7e01cbe8cd67",
                                        "entry_id": "367a2849-7f2a-3812-b821-acb19a2d60fc",
                                        "glosses": [
                                            "einen Sehfehler habend, der es erschwert, Dinge zu sehen, die nahe am Auge sind"
                                        ],
                                        "tags": [
                                            "Augenheilkunde"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "170a70df-702c-45c5-ab38-4d9aef376bff",
                                                "sense_id": "b2a9865b-259c-3f96-99c3-7e01cbe8cd67",
                                                "text": "Oh, du trägst Brille. Bist du weitsichtig oder kurzsichtig?"
                                            },
                                            {
                                                "example_id": "e58729fa-4ab7-4ec0-bdd7-2ec68c7c9f81",
                                                "sense_id": "b2a9865b-259c-3f96-99c3-7e01cbe8cd67",
                                                "text": "Meine Augen haben nachgelassen, heute bin ich viel weitsichtiger als früher."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5f4655fc-cba9-36b1-874d-549c381a0365",
                                        "entry_id": "367a2849-7f2a-3812-b821-acb19a2d60fc",
                                        "glosses": [
                                            "bei der Planung viele Aspekte berücksichtigend, die die Zukunft beeinflussen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a3e0970-6c7a-4952-ba92-bd2d29c804eb",
                                                "sense_id": "5f4655fc-cba9-36b1-874d-549c381a0365",
                                                "text": "Das war sehr weitsichtig gedacht."
                                            },
                                            {
                                                "example_id": "5c0905fc-5753-4532-99c6-b846b0d82eb4",
                                                "sense_id": "5f4655fc-cba9-36b1-874d-549c381a0365",
                                                "text": "Sie ist eine weitsichtige Strategin."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8594338f-d4af-476f-9dac-48835c6c76fc",
