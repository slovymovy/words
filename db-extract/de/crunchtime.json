                "senses": [
                    {
                        "sense_id": "dd4e5f1b-f1db-332b-8f88-b1b0659f7d31",
                        "entry_id": "5c09fd35-370b-3fe8-87cb-a4c1d01693ea",
                        "glosses": [
                            "Phase am Ende eines Spiels, die entscheidend für den Ausgang ist"
                        ],
                        "tags": [
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "5e69d7bd-c42a-4d69-9e87-67500fe94097",
                                "sense_id": "dd4e5f1b-f1db-332b-8f88-b1b0659f7d31",
                                "text": "„Stimmen die körperlichen Voraussetzungen, zählt Arenas inzwischen vor allem in der Crunchtime zu den meistgefürchteten Akteuren der Liga, als Scorer auf einem Level mit Laker Kobe Bryant und LeBron James von den Cleveland Cavaliers.“"
                            },
                            {
                                "example_id": "41c54cde-fd90-4a79-872e-693433bd8c97",
                                "sense_id": "dd4e5f1b-f1db-332b-8f88-b1b0659f7d31",
                                "text": "„Er hält sein Team im Spiel und Kobe darf dann punkten, wenn das Spiel in die entscheidende Phase geht - die so genannte Crunchtime.“"
                            },
                            {
                                "example_id": "cc48b384-5f42-47ad-bccd-138b96ff6a60",
                                "sense_id": "dd4e5f1b-f1db-332b-8f88-b1b0659f7d31",
                                "text": "„Doch das Team um die Spielertrainer Dennis Saur und Benjamin Krotz zeigte zum wiederholten Mal in dieser Saison, dass es in der Crunchtime besonders gut ist.“"
                            },
                            {
                                "example_id": "b1e2e97a-8fe9-4012-b561-5ed9e1e38c71",
                                "sense_id": "dd4e5f1b-f1db-332b-8f88-b1b0659f7d31",
                                "text": "„Roethlisberger kam auf einen Raumgewinn von 256 Yards, zeigte sich in der Crunchtime aber nervenstark.“"
                            },
                            {
                                "example_id": "d952abb7-b6ee-44f8-93a5-597189859db0",
                                "sense_id": "dd4e5f1b-f1db-332b-8f88-b1b0659f7d31",
                                "text": "„Selbstlose Spieler, die Siege mit der Mannschaft anstelle von individuellen Statistiken in den Vordergrund rücken, sind gerne gesehen. Spieler, die immer 100 % geben und hart arbeiten, gleichgültig, ob es in der Crunchtime eines wichtigen Spiels ist oder in einem Testspiel oder in einer Trainingseinheit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
