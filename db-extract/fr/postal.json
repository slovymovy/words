                        ],
                        "form": "postales"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a5c22864-dad8-383b-874e-972d318b5f24",
                        "entry_id": "d8ca8a82-24f8-3699-b8dd-6fc0fe7a56be",
                        "glosses": [
                            "Qui concerne le service de la poste, qui est entre autres chargé d'acheminer le courrier sous forme matérielle ou dématérialisée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f62e0b31-9e5f-4b37-a33d-0e34f85fb842",
                                "sense_id": "a5c22864-dad8-383b-874e-972d318b5f24",
                                "text": "Bien que les services postaux ne soient ni des services de transport, ni des services de télécommunications, les liens entre ces trois activités sont extrêmement importants."
                            },
                            {
                                "example_id": "be815e8d-04c4-4e27-9344-3b3d712669f5",
                                "sense_id": "a5c22864-dad8-383b-874e-972d318b5f24",
                                "text": "Les bureaux ruraux ne sont pas rentables: 3 000 agences postales qui constituent 18 pour cent du nombre des bureaux ne réalisent que 0,05 pour cent du chiffre d'affaires de l'entreprise."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8f6e6144-a68c-4934-9553-ae9f5f0252f1",
                        "source_entry_id": "d8ca8a82-24f8-3699-b8dd-6fc0fe7a56be",
                        "source_sense_id": "a5c22864-dad8-383b-874e-972d318b5f24",
                        "source_sense_description": "Qui concerne la poste",
                        "target_lang_word": "postalisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "postalisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "be62c99a-d971-3715-bf75-2c21b4bd0706",
                                        "entry_id": "84886dc4-65a5-3401-a1b6-bada627ab7ff",
                                        "glosses": [
                                            "die Post betreffend, von der Post ausgehend, zur Post gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fe8b43e-93d3-4596-a198-8b514d3fdf95",
                                                "sense_id": "be62c99a-d971-3715-bf75-2c21b4bd0706",
                                                "text": "„Das kommt auch auf den zweisprachig gehaltenen Texten auf den Briefmarken, Ganzsachen und postalischen Vordrucken des Landes zur Geltung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1cefd3f1-9bbf-3986-8c38-4b602b69c00e",
                                        "entry_id": "84886dc4-65a5-3401-a1b6-bada627ab7ff",
                                        "glosses": [
                                            "per Post (durch die Post, von der Post)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f882040f-ede0-46bf-a6b2-940d8dfa53a2",
                                                "sense_id": "1cefd3f1-9bbf-3986-8c38-4b602b69c00e",
                                                "text": "Das postalische Zustellen von Briefen war für ihn immer ein Problem."
                                            },
                                            {
                                                "example_id": "94fb6944-4b1e-43d4-a103-2670c95c0619",
                                                "sense_id": "1cefd3f1-9bbf-3986-8c38-4b602b69c00e",
                                                "text": "„Sendungen von Postdienststellen im gegenseitigen Verkehr oder an private Postbenutzer sind entsprechend gekennzeichnet, werden entgeltfrei befördert und gelten als postalische Massenware.“"
                                            },
                                            {
                                                "example_id": "bab268d6-5e7c-4ab8-8d42-6028233a94be",
                                                "sense_id": "1cefd3f1-9bbf-3986-8c38-4b602b69c00e",
                                                "text": "„Die postalische Verbindung zwischen den Bertinis und den Lehmbergs war regelmäßig, aber einseitig - die meisten Briefe kamen aus Richtung Bodendorf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
