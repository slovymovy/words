                                        "sense_id": "6ada7360-af58-31c2-ab94-922e40589889",
                                        "entry_id": "c701c841-ef3d-362c-9395-d980773a968d",
                                        "glosses": [
                                            "One who jests, jokes or teases."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d42c533e-241a-4d64-a6e6-e5f308da6100",
                                                "sense_id": "6ada7360-af58-31c2-ab94-922e40589889",
                                                "text": "As resident jester at the maverick journalism outlet The Free Press, Nellie Bowles scours the news for the absurd and hypocritical, and then skewers the best of the worst in her column, TGIF."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d922f6c9-d942-3e30-ab27-ffe1636f2c2c",
                                        "entry_id": "c701c841-ef3d-362c-9395-d980773a968d",
                                        "glosses": [
