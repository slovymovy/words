                "senses": [
                    {
                        "sense_id": "fc133a25-2bf6-3a01-b9ad-a2fa23ee770e",
                        "entry_id": "746e45a7-d49c-300f-88d2-44f903099d2d",
                        "glosses": [
                            "Très grande quantité, pas précisément déterminée."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "8521ad9c-6e88-45b0-bfbe-79ad81cb7ec7",
                                "sense_id": "fc133a25-2bf6-3a01-b9ad-a2fa23ee770e",
                                "text": "Pour une étude supplémentaire et une référence des neuf zillions quatre compétences de Vim, reportez-vous à l'excellent manuel utilisateur et manuel de référence de Bram Moolenaar, l'auteur de Vim."
                            },
                            {
                                "example_id": "52d7c185-2ba7-426a-9c6d-7f01325f9dc3",
                                "sense_id": "fc133a25-2bf6-3a01-b9ad-a2fa23ee770e",
                                "text": "— Papa ! Pourquoi tu ne m'a pas rappelée ? Je t'ai laissé un zillion de messages !\n— Un zillion, je ne sais pas, mais bien trop en tout cas."
                            },
                            {
                                "example_id": "0370f5fa-0dee-4245-9870-968d0c778a75",
                                "sense_id": "fc133a25-2bf6-3a01-b9ad-a2fa23ee770e",
                                "text": "Julie rit.\n— Ouais. Moi et d'autres gens, quelques « zillions », essayons de trouver la solution.\n— Est-ce que les mathématiciens utilisent le mot « zillion » ?\n Julie rit à nouveau."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9447cc1e-970b-4604-b255-e5bea4bd7118",
                        "source_entry_id": "746e45a7-d49c-300f-88d2-44f903099d2d",
