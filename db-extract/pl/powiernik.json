                    },
                    {
                        "sense_id": "403df5e9-9996-3113-ad06-2155208ae04e",
                        "entry_id": "6c694041-6c92-3749-824e-fc0ae0df13fb",
                        "glosses": [
                            "osoba upoważniona przez kogoś do reprezentowania go w sprawach prawnych, sądowych, urzędowych itd."
                        ],
                        "tags": [],
