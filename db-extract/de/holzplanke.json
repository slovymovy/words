                "senses": [
                    {
                        "sense_id": "8db668d1-547b-3191-93a8-51f1ba4fdca8",
                        "entry_id": "c9d65c88-dd75-3ddc-a4c6-b2ab155cc976",
                        "glosses": [
                            "starkes, schweres Brett aus Holz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e01d45c-8cee-484e-971d-82ef1b9baf14",
                                "sense_id": "8db668d1-547b-3191-93a8-51f1ba4fdca8",
                                "text": "„Der Fußboden besteht auch in der roykstova (Rauchstube) aus Holzplanken, weshalb dort nicht auf einer offenen Feuerstelle, sondern auf einem richtigen Herd gekocht wurde.“"
                            },
                            {
                                "example_id": "58f6be64-d2ac-4b64-8a2a-0417688eb126",
                                "sense_id": "8db668d1-547b-3191-93a8-51f1ba4fdca8",
                                "text": "„Über ein paar Holzplanken, die als Steg dienten, gelangte man auf die andere Seite.“"
                            },
                            {
                                "example_id": "70769c65-e37f-48b8-8f92-0ea4532614f3",
                                "sense_id": "8db668d1-547b-3191-93a8-51f1ba4fdca8",
                                "text": "„Das Tor war mit Balken und Holzplanken verrammelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
