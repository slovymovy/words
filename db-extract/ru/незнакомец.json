                                "target_senses": [
                                    {
                                        "sense_id": "cc903c0b-7eb1-3c7d-9dc5-b751f9d0609a",
                                        "entry_id": "1ac3414c-d699-33ca-8085-ed668a143977",
                                        "glosses": [
                                            "başka bir milletten olan, başka devlet uyruğunda olan, bigâne, ecnebî"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6bdccb9-0cb9-4e9d-a423-96c3842efea9",
                                                "sense_id": "cc903c0b-7eb1-3c7d-9dc5-b751f9d0609a",
                                                "text": "Bu toprak bizimdir, içinde yabancının işi yok."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "877e143a-a915-36da-bc71-a3d06ca11aff",
                                        "entry_id": "1ac3414c-d699-33ca-8085-ed668a143977",
                                        "glosses": [
                                            "başka bir milletle ilgili olan, özge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47814383-2864-4375-83c4-ad8ac9fc3ee0",
                                                "sense_id": "877e143a-a915-36da-bc71-a3d06ca11aff",
                                                "text": "Hiçbir millet, milletimizden daha çok yabancı unsurların inanç ve âdetlerine riayet etmemiştir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f746ffd-d329-3876-816c-dbaa13d521e3",
                                        "entry_id": "1ac3414c-d699-33ca-8085-ed668a143977",
                                        "glosses": [
                                            "aileden, çevreden olmayan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38f97495-d07d-4d63-9924-dabc7ba3173d",
                                                "sense_id": "4f746ffd-d329-3876-816c-dbaa13d521e3",
                                                "text": "Ben, yabancı bir adam, neme lâzım, hiç sesimi çıkarmadım."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99435e08-b95f-3787-bd78-9c741246028a",
                                        "entry_id": "1ac3414c-d699-33ca-8085-ed668a143977",
                                        "glosses": [
                                            "bilinmeyen, tanınmayan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b61f8690-533f-4adc-8b1f-01c9d35b9777",
                                                "sense_id": "99435e08-b95f-3787-bd78-9c741246028a",
                                                "text": "Yabancı müşteri giremezdi kapısından. Gelenler hep edebiyat adamlarıydı."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98493c6c-fdb6-3503-b60b-b01bd27fd37b",
                                        "entry_id": "1ac3414c-d699-33ca-8085-ed668a143977",
                                        "glosses": [
                                            "aynı türden, aynı çeşitten olmayan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "662afdf4-2e31-4f89-bb5f-6fae50d26cc0",
                                                "sense_id": "98493c6c-fdb6-3503-b60b-b01bd27fd37b",
                                                "text": "Yağın içinde yabancı maddeler var."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05dfc06b-71df-37df-9f9f-2c726fbab218",
                                        "entry_id": "1ac3414c-d699-33ca-8085-ed668a143977",
                                        "glosses": [
                                            "bir konuda bilgisi, tecrübesi olmayan"
                                        ],
                                        "tags": [],
                                        "examples": [
