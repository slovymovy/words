                        "entry_id": "9e925619-0309-3219-9010-d4de49e547e5",
                        "glosses": [
                            "Likelihood, probability or chance of occurrence; plausibility or believability."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "46208529-48bb-473a-996b-215f04dbc50e",
                                "sense_id": "e8165217-644a-38e8-93c5-ed733a4796f8",
                                "text": "The proposed HEA is based on the assumption that each specific error has a certain impact on a system/aircraft state whilst the crew's likeliness to commit this error is decreasing with an increasing number of safeguards against it."
                            },
                            {
                                "example_id": "34c3df37-ed60-46af-8efc-11cc5b0ed787",
                                "sense_id": "e8165217-644a-38e8-93c5-ed733a4796f8",
                                "text": "To determine the likeliness of an individual in a concept, a membership function is required."
                            }
                        ]
                    },
                    {
                        "sense_id": "ef3407c1-7fe5-3620-a1ac-ff991c34d9e3",
                        "entry_id": "9e925619-0309-3219-9010-d4de49e547e5",
                        "glosses": [
                            "Suitability; agreeableness."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "efd9c33e-5f64-4efc-a328-116e8f46ae0a",
                                "sense_id": "ef3407c1-7fe5-3620-a1ac-ff991c34d9e3",
                                "text": "A new competitor may decrease the likeliness of an old hypothesis, but it will usually not change its loveliness."
                            }
                        ]
                    },
                    {
                        "sense_id": "e95d1314-11b1-3b18-9cad-025661929563",
                        "entry_id": "9e925619-0309-3219-9010-d4de49e547e5",
                        "glosses": [
                            "Likeness; similarity."
                        ],
                        "tags": [
