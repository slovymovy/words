                    {
                        "sense_id": "3bb9f732-2bef-31c9-9bbe-9529bcb5c18f",
                        "entry_id": "304d7a5b-a200-3c2f-a7c3-b2d75358f4dc",
                        "glosses": [
                            "oglądanie jam ciała za pomocą wziernika"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2f183e8-1273-478e-ba7b-eb82b3ef7199",
                                "sense_id": "3bb9f732-2bef-31c9-9bbe-9529bcb5c18f",
                                "text": "Dwa dni temu zrobili mi endoskopię i nic nie znaleźli."
                            }
