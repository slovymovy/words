                                "target_senses": [
                                    {
                                        "sense_id": "58016044-9b38-373f-9ede-3d81824bb9bf",
                                        "entry_id": "444419d3-6717-358a-a353-3a90410016fc",
                                        "glosses": [
                                            "The singing or the writing of psalms."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7848d28-0659-4e5f-b119-192c7d177481",
                                                "sense_id": "58016044-9b38-373f-9ede-3d81824bb9bf",
                                                "text": "They deserved the enmity of the Pagans; and some of them might deserve the reproaches of avarice and intemperance; of avarice, which they gratified with holy plunder, and of intemperance, which they indulged at the expense of the people, who foolishly admired their tattered garments, loud psalmody, and artificial paleness."
                                            },
                                            {
                                                "example_id": "a9b0db52-d569-4b5a-8711-b10886cbc46d",
                                                "sense_id": "58016044-9b38-373f-9ede-3d81824bb9bf",
                                                "text": "All these strange antics were accompanied by still stranger guttural noises from the devotee, who seemed to be praying in a sing-song or else singing some pagan psalmody or other, during which his face twitched about in the most unnatural manner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb37c1dc-e2cb-33b5-a0f2-3e70ffd29201",
                                        "entry_id": "444419d3-6717-358a-a353-3a90410016fc",
                                        "glosses": [
                                            "A collection of psalms."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
