                ],
                "senses": [
                    {
                        "sense_id": "5d9e06bb-4930-33bb-8477-ea99537f6a6f",
                        "entry_id": "c8557a66-1dd2-3a0e-af47-97b5501a3def",
                        "glosses": [
                            "работать акробатом, выступать как акробат"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8fac01c-6965-443a-9ec5-7a9ba279f3e2",
                                "sense_id": "5d9e06bb-4930-33bb-8477-ea99537f6a6f",
                                "text": "Китайский актер должен уметь петь, декламировать, танцевать, акробатничать — и все с одинаковым совершенством."
                            }
                        ]
                    },
                    {
                        "sense_id": "0b1f817b-a6fd-3bac-8fb7-7eaeaa34deca",
                        "entry_id": "c8557a66-1dd2-3a0e-af47-97b5501a3def",
                        "glosses": [
                            "разг. неодобр. вдаваться в шутовство, кривляться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0273d76-5fd9-4ac8-8952-53d0a7eb589b",
                                "sense_id": "0b1f817b-a6fd-3bac-8fb7-7eaeaa34deca",
                                "text": "И зачем это вы, милые мои, не хотите самими собою быть? И зачем вы способностями своими пренебрегаете? И зачем вы из кожи лезете, акробатничаете, паясничаете? Взгляните в окно, вокруг себя поглядите, — разве всё, что вы видите, нуждается в том, чтобы всё это искажать, портить, оскорблять, а? Нехорошо, ах как нехорошо!"
                            }
                        ]
                    },
                    {
                        "sense_id": "5ab1df0d-eadb-36fc-a295-2bac7ac22e3c",
                        "entry_id": "c8557a66-1dd2-3a0e-af47-97b5501a3def",
                        "glosses": [
                            "разг. вынужденно проявлять акробатическую ловкость"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4c7d367-3cf0-4a43-8c38-f54fc02436b1",
                                "sense_id": "5ab1df0d-eadb-36fc-a295-2bac7ac22e3c",
                                "text": "Сергей безмятежно спал, вытянув ноги, и супругам пришлось акробатничать, перешагивая их, как бурелом в лесу."
                            }
                        ]
                    }
                ],
