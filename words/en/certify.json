{
    "word_family": [
        "certificate",
        "certification",
        "certifier"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "af53a4bc-7ea0-3df7-b1c4-02d9d00459f9",
                    "sense_definition": "To formally declare that something is true or accurate.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness was called to <w>certify</w> the events of that night.",
                            "target_lang_translations": {
                                "ru": "Свидетеля вызвали, чтобы <w>засвидетельствовать</w> события той ночи."
                            }
                        },
                        {
                            "text": "Experts will <w>certify</w> that the painting is an original work.",
                            "target_lang_translations": {
                                "ru": "Эксперты <w>удостоверят</w>, что эта картина является подлинником."
                            }
                        }
                    ],
                    "synonyms": [
                        "attest",
                        "witness",
                        "confirm"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально заявлять, что что-либо является правдой или соответствует действительности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удостоверять",
                                "target_lang_sense_clarification": "подтверждать достоверность или подлинность фактов"
                            },
                            {
                                "target_lang_word": "засвидетельствовать",
                                "target_lang_sense_clarification": "подтвердить что-либо в качестве свидетеля"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41c9f2e6-a177-327a-8d89-4e4a7c9ff804",
                    "sense_definition": "To provide official written proof or verification of a document or fact.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The notary public must <w>certify</w> the signature on the contract.",
                            "target_lang_translations": {
                                "ru": "Нотариус должен <w>заверить</w> подпись на контракте."
                            }
                        },
                        {
                            "text": "You need to <w>certify</w> your documents before applying for the visa.",
                            "target_lang_translations": {
                                "ru": "Вам нужно <w>заверить</w> свои документы перед подачей на визу."
                            }
                        }
                    ],
                    "synonyms": [
                        "confirm"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять официальное письменное подтверждение документа или факта."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заверять",
                                "target_lang_sense_clarification": "официально подтверждать подлинность документа (например, у нотариуса)"
                            },
                            {
                                "target_lang_word": "засвидетельствовать",
                                "target_lang_sense_clarification": "подтвердить подлинность подписи или копии документа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e3b3a41-ac41-3a0c-aa64-4f3043d72f5f",
                    "sense_definition": "To officially confirm that a person or product meets specific standards.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "These blankets have been <w>certified</w> as fireproof.",
                            "target_lang_translations": {
                                "ru": "Эти одеяла были <w>сертифицированы</w> как огнеупорные."
                            }
                        },
                        {
                            "text": "The organization will <w>certify</w> the new teachers after their training.",
                            "target_lang_translations": {
                                "ru": "Организация <w>аттестует</w> новых учителей после их обучения."
                            }
                        }
                    ],
                    "synonyms": [
                        "approve"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально подтверждать, что человек или продукт соответствует определенным стандартам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сертифицировать",
                                "target_lang_sense_clarification": "проводить официальную сертификацию товара или услуги"
                            },
                            {
                                "target_lang_word": "аттестовать",
                                "target_lang_sense_clarification": "официально подтверждать квалификацию или уровень знаний специалиста"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1eb411dc-827e-3ef6-936f-13394f0049c6",
                    "sense_definition": "To make certain or assure oneself of a fact.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wanted to <w>certify</w> himself of the facts before speaking.",
                            "target_lang_translations": {
                                "ru": "Он хотел <w>удостовериться</w> в фактах, прежде чем говорить."
                            }
                        },
                        {
                            "text": "She checked the records to <w>certify</w> that the data was correct.",
                            "target_lang_translations": {
                                "ru": "Она проверила записи, чтобы <w>удостовериться</w>, что данные верны."
                            }
                        }
                    ],
                    "synonyms": [
                        "confirm"
                    ],
                    "target_lang_definitions": {
                        "ru": "Убедиться в чем-либо или удостовериться в факте."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удостовериться",
                                "target_lang_sense_clarification": "лично убедиться в истинности чего-либо"
                            },
                            {
                                "target_lang_word": "проверить",
                                "target_lang_sense_clarification": "убедиться в правильности данных путем проверки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d247dd5-f7dd-3a84-ac6b-ac8e90b011cc",
                    "sense_definition": "To inform or tell someone that something is true.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The report serves to <w>certify</w> the public of the recent changes.",
                            "target_lang_translations": {
                                "ru": "Этот отчет служит для того, чтобы <w>уведомить</w> общественность о недавних изменениях."
                            }
                        },
                        {
                            "text": "The letter was sent to <w>certify</w> the members of the upcoming meeting.",
                            "target_lang_translations": {
                                "ru": "Письмо было отправлено, чтобы <w>известить</w> участников о предстоящей встрече."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely outdated."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сообщать кому-либо о том, что что-то является правдой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "извещать",
                                "target_lang_sense_clarification": "официально уведомлять о чем-либо"
                            },
                            {
                                "target_lang_word": "уведомлять",
                                "target_lang_sense_clarification": "сообщать информацию официально"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}