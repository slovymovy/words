                                ]
                            },
                            {
                                "target_word": "lime",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12eff9d0-0c32-3c76-965c-493de2a12b3f",
                                        "entry_id": "afd76e27-275b-34dc-893b-9722b634db0c",
                                        "glosses": [
                                            "Any inorganic material containing calcium, usually calcium oxide (quicklime) or calcium hydroxide (slaked lime)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "129de236-b146-41f3-a013-64ddbf917da4",
                                                "sense_id": "12eff9d0-0c32-3c76-965c-493de2a12b3f",
                                                "text": "Lime, which is the product of the burning of chalk or limestone, might be bought ready burnt, or it could be burnt in kilns specially constructed in the neighbourhood of the building operations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26a6b2ab-2181-38b6-829e-d2dde9da8c94",
                                        "entry_id": "afd76e27-275b-34dc-893b-9722b634db0c",
                                        "glosses": [
                                            "Any gluey or adhesive substance that traps or captures; sometimes a synonym for birdlime."
                                        ],
                                        "tags": [
                                            "countable",
                                            "poetic",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e4ce5ce-f14c-47f4-985a-60cfc68baad8",
                                                "sense_id": "26a6b2ab-2181-38b6-829e-d2dde9da8c94",
                                                "text": "Monster, come, put some lime upon your fingers, and away with the rest."
                                            },
                                            {
                                                "example_id": "9f108f2d-ec36-45dd-9602-250395858ec2",
                                                "sense_id": "26a6b2ab-2181-38b6-829e-d2dde9da8c94",
                                                "text": "Like the lime which foolish birds are caught with."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b13d55fc-5b59-3a44-b04e-e6ea74b1bd63",
                                        "entry_id": "afd76e27-275b-34dc-893b-9722b634db0c",
                                        "glosses": [
                                            "A limelight; any spotlight."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e24d89e-c27e-4b27-8248-cbcf9101d42f",
                                                "sense_id": "b13d55fc-5b59-3a44-b04e-e6ea74b1bd63",
                                                "text": "Sellers moved on until he was actually trusted to operate the limes, the spotlights that can make or destroy an artist's act."
                                            },
                                            {
                                                "example_id": "c7bfd7d2-0d64-4ed5-8829-7e76fecea694",
                                                "sense_id": "b13d55fc-5b59-3a44-b04e-e6ea74b1bd63",
                                                "text": "Then out of the blue, a spotlight much like the “limes” in a theatre, lit up what seemed like a Punch and Judy tent […] He struggled even more, when from out of the shadows and into the bright light of the limes, stepped Uncle Jolly."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lime",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c127bb0-7482-3fa8-ab8d-204bbeabd3a1",
                                        "entry_id": "766a28db-1a6c-374c-8387-277339daa540",
                                        "glosses": [
                                            "To treat with calcium hydroxide or calcium oxide (lime)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0dc2403-875a-43c6-9cba-3025c68d5cf7",
                                                "sense_id": "1c127bb0-7482-3fa8-ab8d-204bbeabd3a1",
                                                "text": "If I were you, I'd lime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b70f76a2-2b32-3c1e-b6a6-eabf2b44c9e9",
                                        "entry_id": "766a28db-1a6c-374c-8387-277339daa540",
                                        "glosses": [
                                            "To smear with birdlime."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "09b662d2-2cd6-3b62-b50c-88a625bac9b0",
                                        "entry_id": "766a28db-1a6c-374c-8387-277339daa540",
                                        "glosses": [
                                            "To smear with birdlime.",
                                            "To ensnare, catch, entrap."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f5c5491-b5d4-4783-9283-0b0b8557fd29",
                                                "sense_id": "09b662d2-2cd6-3b62-b50c-88a625bac9b0",
                                                "text": "URSULA. She's lim'd, I warrant you: we have caught her, madam.\nHERO. If it prove so, then loving goes by haps:\nSome Cupid kills with arrows, some with traps."
                                            },
                                            {
                                                "example_id": "2b2133d5-2e46-4e0c-99eb-afc9162f1816",
                                                "sense_id": "09b662d2-2cd6-3b62-b50c-88a625bac9b0",
                                                "text": "Abraham, like his parents, seemed to have been limed and caught by the ensnaring inn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ef1e72a-e81c-3435-98bc-db6ecec48ba3",
                                        "entry_id": "766a28db-1a6c-374c-8387-277339daa540",
                                        "glosses": [
                                            "To apply limewash."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "lime",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "911eba45-82b8-3755-bb8d-5fd737cb099a",
                                        "entry_id": "ec56cf8a-1b0c-3cc0-bb7c-1e1f2de30fc2",
                                        "glosses": [
                                            "A deciduous tree of the genus Tilia, especially Tilia × europaea; the linden tree."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0a3ddb2-24bd-469e-9d56-530a5a2b7780",
                                                "sense_id": "911eba45-82b8-3755-bb8d-5fd737cb099a",
                                                "text": "The linden or lime tree is the favourite haunt of the Elves and cognate beings; and it is not safe to be near it after sunset."
                                            },
                                            {
                                                "example_id": "a374f93e-6647-4523-b414-1ca91b15aceb",
                                                "sense_id": "911eba45-82b8-3755-bb8d-5fd737cb099a",
                                                "text": "But there was nothing of an ascetic's expression in her bright full eyes, as she looked before her, not consciously seeing, but absorbing into the intensity of her mood, the solemn glory of the afternoon with its long swathes of light between the far-off rows of limes, whose shadows touched each other."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bfe819c-c935-3e32-95cd-f71c569df00b",
                                        "entry_id": "ec56cf8a-1b0c-3cc0-bb7c-1e1f2de30fc2",
                                        "glosses": [
                                            "The wood of this tree."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "lime",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b6e9f25c-3914-3a7c-8215-a08ff2046719",
                                        "entry_id": "516d847f-c7f0-3cf2-82c2-d5ff505dda8d",
                                        "glosses": [
                                            "Any of several green citrus fruit, somewhat smaller and sharper-tasting than a lemon."
                                        ],
                                        "tags": [
