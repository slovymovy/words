{
    "word_family": [
        "minty",
        "minter",
        "mintage"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "879bd367-c0e4-35c3-bebf-cf790c89e500",
                    "sense_definition": "A sweet candy flavored with peppermint or spearmint, often eaten to freshen breath.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "food_flavor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She offered me a <w>mint</w> after we finished our dinner.",
                            "target_lang_translations": {
                                "ru": "Она предложила мне <w>мятную конфету</w> после того, как мы закончили ужин.",
                                "zh": "晚餐后，她给了我一颗<w>薄荷糖</w>。"
                            }
                        },
                        {
                            "text": "I always keep a packet of <w>mints</w> in my pocket.",
                            "target_lang_translations": {
                                "ru": "Я всегда держу пачку <w>мятных леденцов</w> в кармане.",
                                "zh": "我口袋里总是装着一包<w>薄荷糖</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "breath mint",
                        "after-dinner mint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сладкая конфета со вкусом перечной или колосистой мяты, которую часто едят для освежения дыхания.",
                        "zh": "一种带有薄荷味的甜糖，常用于清新口气。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мятная конфета",
                                "target_lang_sense_clarification": "sweet"
                            },
                            {
                                "target_lang_word": "мятный леденец",
                                "target_lang_sense_clarification": "hard candy"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "薄荷糖",
                                "target_lang_sense_clarification": "甜味糖果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbd2a226-c22c-3905-ac47-28031aadb7c0",
                    "sense_definition": "The aromatic flavor derived from the mint plant, used in food and drinks.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "food_flavor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I love the taste of chocolate and <w>mint</w> together.",
                            "target_lang_translations": {
                                "ru": "Я обожаю вкус шоколада и <w>мяты</w> вместе.",
                                "zh": "我喜欢巧克力和<w>薄荷</w>混合的味道。"
                            }
                        },
                        {
                            "text": "This ice cream has a strong <w>mint</w> flavor.",
                            "target_lang_translations": {
                                "ru": "У этого мороженого сильный <w>мятный</w> вкус.",
                                "zh": "这款冰淇淋有浓郁的<w>薄荷</w>味。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ароматный вкус, получаемый из растения мята, используемый в еде и напитках.",
                        "zh": "从薄荷植物中提取的芳香风味，用于食品和饮料中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мята",
                                "target_lang_sense_clarification": "flavor"
                            },
                            {
                                "target_lang_word": "мятный вкус",
                                "target_lang_sense_clarification": "taste"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "薄荷味",
                                "target_lang_sense_clarification": "风味"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65e171ff-2576-3714-91fd-ab34bd43dae2",
                    "sense_definition": "An aromatic herb with fresh-smelling leaves, often used in cooking, tea, or medicine.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "food_flavor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We grow fresh <w>mint</w> in a pot on the windowsill.",
                            "target_lang_translations": {
                                "ru": "Мы выращиваем свежую <w>мяту</w> в горшке на подоконнике.",
                                "zh": "我们在窗台的花盆里种了新鲜的<w>薄荷</w>。"
                            }
                        },
                        {
                            "text": "The recipe calls for a handful of chopped <w>mint</w> leaves.",
                            "target_lang_translations": {
                                "ru": "В рецепте требуется горсть нарезанных листьев <w>мяты</w>.",
                                "zh": "食谱里需要一把切碎的<w>薄荷</w>叶。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mentha"
                    ],
                    "common_phrases": [
                        "fresh mint",
                        "mint tea",
                        "mint leaf"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ароматное травянистое растение со свежим запахом листьев, часто используемое в кулинарии, чае или медицине.",
                        "zh": "一种具有清新气味的芳香草本植物，常用于烹饪、泡茶或药用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мята",
                                "target_lang_sense_clarification": "plant"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "薄荷",
                                "target_lang_sense_clarification": "植物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e96b5c00-a981-3267-bdbc-04cb8c7d4bb2",
                    "sense_definition": "A very large amount of money.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "money_value",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That vintage sports car must be worth a <w>mint</w>.",
                            "target_lang_translations": {
                                "ru": "Этот старинный спортивный автомобиль, должно быть, стоит <w>целое состояние</w>.",
                                "zh": "那辆复古跑车一定值<w>一大笔钱</w>。"
                            }
                        },
                        {
                            "text": "He made a <w>mint</w> by investing in technology stocks early on.",
                            "target_lang_translations": {
                                "ru": "Он заработал <w>кучу денег</w>, рано инвестировав в технологические акции.",
                                "zh": "他通过早期投资科技股赚了<w>一大笔钱</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bundle",
                        "pile",
                        "small fortune"
                    ],
                    "common_phrases": [
                        "cost a mint",
                        "make a mint",
                        "worth a mint"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень большая сумма денег.",
                        "zh": "一大笔钱。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "куча денег",
                                "target_lang_sense_clarification": "colloquial"
                            },
                            {
                                "target_lang_word": "целое состояние",
                                "target_lang_sense_clarification": "fortune"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一大笔钱",
                                "target_lang_sense_clarification": "口语"
                            },
                            {
                                "target_lang_word": "巨款",
                                "target_lang_sense_clarification": "财富"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c331a10-2670-3fa8-ab3b-545c677c0da0",
                    "sense_definition": "A government facility where coins and currency are manufactured.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "money_place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Royal <w>Mint</w> produces all the coins used in the United Kingdom.",
                            "target_lang_translations": {
                                "ru": "Королевский <w>монетный двор</w> производит все монеты, используемые в Соединенном Королевстве.",
                                "zh": "英国皇家<w>铸币局</w>生产英国使用的所有硬币。"
                            }
                        },
                        {
                            "text": "Security at the <w>mint</w> is extremely tight to prevent theft.",
                            "target_lang_translations": {
                                "ru": "Охрана на <w>монетном дворе</w> чрезвычайно строгая для предотвращения краж.",
                                "zh": "为了防止盗窃，<w>铸币局</w>的安保极其严密。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Государственное предприятие, где изготавливаются монеты и валюта.",
                        "zh": "制造硬币和货币的政府机构。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "монетный двор",
                                "target_lang_sense_clarification": "facility"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "铸币局",
                                "target_lang_sense_clarification": "机构"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e933dbfd-f859-33d7-8386-b912412d49b8",
                    "sense_definition": "A pale green color.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to paint the bathroom walls in a soft <w>mint</w>.",
                            "target_lang_translations": {
                                "ru": "Она решила покрасить стены ванной в мягкий <w>мятный цвет</w>.",
                                "zh": "她决定把浴室的墙壁漆成柔和的<w>薄荷绿</w>。"
                            }
                        },
                        {
                            "text": "The bridesmaids wore dresses in shades of <w>mint</w> and peach.",
                            "target_lang_translations": {
                                "ru": "Подружки невесты были в платьях оттенков <w>мяты</w> и персика.",
                                "zh": "伴娘们穿着<w>薄荷绿</w>和桃红色的礼服。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mint green"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бледно-зеленый цвет.",
                        "zh": "一种淡绿色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мятный цвет",
                                "target_lang_sense_clarification": "color name"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "薄荷绿",
                                "target_lang_sense_clarification": "颜色名称"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5a5b9180-98f0-39a0-88d7-61098b028392",
                    "sense_definition": "In perfect condition, appearing brand new; often used to describe collectibles.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I found a first edition book in <w>mint</w> condition at the garage sale.",
                            "target_lang_translations": {
                                "ru": "Я нашел первое издание книги в <w>идеальном</w> состоянии на гаражной распродаже.",
                                "zh": "我在车库旧货拍卖会上发现了一本<w>崭新</w>的第一版书。"
                            }
                        },
                        {
                            "text": "Although the car is old, the interior is absolutely <w>mint</w>.",
                            "target_lang_translations": {
                                "ru": "Хотя машина старая, салон абсолютно <w>как новый</w>.",
                                "zh": "虽然车很旧，但内饰看起来依然<w>崭新</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mint condition",
                        "near mint"
                    ],
                    "target_lang_definitions": {
                        "ru": "В идеальном состоянии, выглядящий совершенно новым; часто используется для описания коллекционных предметов.",
                        "zh": "处于完美状态，看起来像全新的；常用于描述收藏品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "идеальный",
                                "target_lang_sense_clarification": "condition"
                            },
                            {
                                "target_lang_word": "новый",
                                "target_lang_sense_clarification": "appearance"
                            },
                            {
                                "target_lang_word": "безупречный",
                                "target_lang_sense_clarification": "flawless"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "崭新",
                                "target_lang_sense_clarification": "外观"
                            },
                            {
                                "target_lang_word": "完美",
                                "target_lang_sense_clarification": "状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ba7b739-c324-30c3-81a6-2397c62bebb6",
                    "sense_definition": "Excellent, cool, or very good.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "quality_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That new video game is absolutely <w>mint</w>.",
                            "target_lang_translations": {
                                "ru": "Эта новая видеоигра просто <w>классная</w>.",
                                "zh": "那款新出的电子游戏简直<w>超赞</w>。"
                            }
                        },
                        {
                            "text": "We had a <w>mint</w> time at the concert last night.",
                            "target_lang_translations": {
                                "ru": "Мы <w>классно</w> провели время на концерте вчера вечером.",
                                "zh": "昨晚我们在音乐会上玩得特别<w>棒</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "common in UK and New Zealand"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отличный, крутой или очень хороший.",
                        "zh": "极好的、酷的或非常好的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "классный",
                                "target_lang_sense_clarification": "colloquial"
                            },
                            {
                                "target_lang_word": "крутой",
                                "target_lang_sense_clarification": "slang"
                            },
                            {
                                "target_lang_word": "отличный",
                                "target_lang_sense_clarification": "quality"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "棒",
                                "target_lang_sense_clarification": "口语"
                            },
                            {
                                "target_lang_word": "超赞",
                                "target_lang_sense_clarification": "俚语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "502fa1f6-c8c0-357c-b150-89c2ba2de609",
                    "sense_definition": "Having a pale green color.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wore a <w>mint</w> shirt that matched her dress.",
                            "target_lang_translations": {
                                "ru": "На нем была <w>мятная</w> рубашка, которая подходила к ее платью.",
                                "zh": "他穿了一件<w>薄荷色</w>的衬衫，和她的裙子很搭。"
                            }
                        },
                        {
                            "text": "The kitchen cabinets were painted a <w>mint</w> shade.",
                            "target_lang_translations": {
                                "ru": "Кухонные шкафы были покрашены в <w>мятный</w> оттенок.",
                                "zh": "厨房的橱柜被漆成了<w>薄荷色</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mint green"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий бледно-зеленый цвет.",
                        "zh": "带有淡绿色的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мятный",
                                "target_lang_sense_clarification": "color"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "薄荷色",
                                "target_lang_sense_clarification": "颜色"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8e55ea6f-eb6d-35eb-9d25-38aa2a859e7a",
                    "sense_definition": "To manufacture coins by stamping metal, usually under government authority.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government <w>mints</w> new coins every year to replace old ones.",
                            "target_lang_translations": {
                                "ru": "Правительство <w>чеканит</w> новые монеты каждый год для замены старых.",
                                "zh": "政府每年都会<w>铸造</w>新硬币来替换旧硬币。"
                            }
                        },
                        {
                            "text": "This commemorative coin was <w>minted</w> to celebrate the anniversary.",
                            "target_lang_translations": {
                                "ru": "Эта памятная монета была <w>отчеканена</w> в честь юбилея.",
                                "zh": "这枚纪念币是为了庆祝周年纪念而<w>铸造</w>的。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Изготавливать монеты путем штамповки металла, обычно под государственным контролем.",
                        "zh": "通过冲压金属制造硬币，通常在政府授权下进行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чеканить",
                                "target_lang_sense_clarification": "coins"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "铸造",
                                "target_lang_sense_clarification": "硬币"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c93e35ac-05f8-3395-8a68-0928e4d865ce",
                    "sense_definition": "To invent or create a new word, phrase, or concept.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist <w>minted</w> a new term to describe the strange phenomenon.",
                            "target_lang_translations": {
                                "ru": "Ученый <w>придумал</w> новый термин для описания этого странного явления.",
                                "zh": "科学家<w>创造</w>了一个新术语来描述这种奇怪的现象。"
                            }
                        },
                        {
                            "text": "Many common phrases were originally <w>minted</w> by Shakespeare.",
                            "target_lang_translations": {
                                "ru": "Многие расхожие фразы были изначально <w>изобретены</w> Шекспиром.",
                                "zh": "许多常用短语最初都是由莎士比亚<w>创造</w>的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "newly minted"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изобретать или создавать новое слово, фразу или понятие.",
                        "zh": "发明或创造一个新词、短语或概念。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изобретать",
                                "target_lang_sense_clarification": "invent"
                            },
                            {
                                "target_lang_word": "придумывать",
                                "target_lang_sense_clarification": "think up"
                            },
                            {
                                "target_lang_word": "создавать",
                                "target_lang_sense_clarification": "create"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "创造",
                                "target_lang_sense_clarification": "概念"
                            },
                            {
                                "target_lang_word": "杜撰",
                                "target_lang_sense_clarification": "词汇"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61d733bf-5619-3f0a-89e7-725a0b7786fb",
                    "sense_definition": "To create a digital asset or token on a blockchain.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist <w>minted</w> her digital collection as NFTs.",
                            "target_lang_translations": {
                                "ru": "Художница <w>выпустила</w> свою цифровую коллекцию в виде NFT.",
                                "zh": "这位艺术家将她的数字收藏品以NFT的形式<w>铸造</w>了出来。"
                            }
                        },
                        {
