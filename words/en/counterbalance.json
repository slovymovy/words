{
    "word_family": [
        "balance",
        "imbalance",
        "overbalance",
        "rebalance",
        "unbalance"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fd84d27f-70d6-3956-ab06-fb90fb1cd3c1",
                    "sense_definition": "To match or equal in effect when applying opposing force.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_balance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her cheerful nature helps <w>counterbalance</w> his gloominess.",
                            "target_lang_translations": {
                                "ru": "Её жизнерадостный характер помогает <w>уравновесить</w> его мрачность.",
                                "zh": "她开朗的性格有助于<w>抵消</w>他的忧郁。"
                            }
                        },
                        {
                            "text": "The advantages of this method <w>counterbalance</w> the disadvantages.",
                            "target_lang_translations": {
                                "ru": "Преимущества этого метода <w>компенсируют</w> недостатки.",
                                "zh": "这种方法的优点<w>平衡</w>了其缺点。"
                            }
                        }
                    ],
                    "synonyms": [
                        "counteract",
                        "counterpoise"
                    ],
                    "antonyms": [
                        "outweigh",
                        "overpower",
                        "overcome"
                    ],
                    "common_phrases": [
                        "counterbalance the effect",
                        "counterbalance the risk",
                        "counterbalance the influence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сглаживать или компенсировать воздействие противоположной силы.",
                        "zh": "通过施加相反的力量来抵消或平衡某种影响。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уравновешивать",
                                "target_lang_sense_clarification": "сглаживать различие"
                            },
                            {
                                "target_lang_word": "компенсировать",
                                "target_lang_sense_clarification": "возмещать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抵消",
                                "target_lang_sense_clarification": "使作用力相互抵消"
                            },
                            {
                                "target_lang_word": "平衡",
                                "target_lang_sense_clarification": "使双方力量均等"
                            },
                            {
                                "target_lang_word": "补偿",
                                "target_lang_sense_clarification": "弥补不足或抵消负面影响"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4de73ee-2ece-399b-bd6b-1848eff42c01",
                    "sense_definition": "To apply weight in order to balance an opposing weight.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_balance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crane operator must <w>counterbalance</w> the heavy steel beams.",
                            "target_lang_translations": {
                                "ru": "Крановщик должен <w>уравновесить</w> тяжелые стальные балки.",
                                "zh": "起重机操作员必须<w>配平</w>那些沉重的钢梁。"
                            }
                        },
                        {
                            "text": "He extended his arms to <w>counterbalance</w> his unstable footing.",
                            "target_lang_translations": {
                                "ru": "Он вытянул руки, чтобы <w>уравновесить</w> своё неустойчивое положение.",
                                "zh": "他伸出双臂以<w>平衡</w>自己不稳的站姿。"
                            }
                        }
                    ],
                    "synonyms": [
                        "counterpoise"
                    ],
                    "common_phrases": [
                        "counterbalance the weight",
                        "counterbalance the load"
                    ],
                    "target_lang_definitions": {
                        "ru": "Применять вес для уравновешивания противоположного веса.",
                        "zh": "通过施加重量来平衡相反方向的重量。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уравновешивать",
                                "target_lang_sense_clarification": "приводить в равновесие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "平衡",
                                "target_lang_sense_clarification": "使物体保持稳定"
                            },
                            {
                                "target_lang_word": "配平",
                                "target_lang_sense_clarification": "通过添加配重达到平衡"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "62d88bfb-68a4-31d2-bdf8-0fc3c71298c1",
                    "sense_definition": "A force or influence that balances, checks or limits an opposite one.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_balance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Humor can be a great <w>counterbalance</w> to stress.",
                            "target_lang_translations": {
                                "ru": "Юмор может стать отличным <w>противовесом</w> стрессу.",
                                "zh": "幽默可以成为缓解压力的极好<w>制衡</w>手段。"
                            }
                        },
                        {
                            "text": "The new law acts as a <w>counterbalance</w> to corporate power.",
                            "target_lang_translations": {
                                "ru": "Новый закон действует как <w>противовес</w> корпоративной власти.",
                                "zh": "这项新法律起到了对企业权力的<w>制衡</w>作用。"
                            }
                        }
                    ],
                    "synonyms": [
                        "counterpoise",
                        "equipoise",
                        "counterweight"
                    ],
                    "common_phrases": [
                        "effective counterbalance",
                        "necessary counterbalance",
                        "provide a counterbalance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сила или влияние, которое уравновешивает или сдерживает противоположное воздействие.",
                        "zh": "一种能够平衡、制约或限制相反力量的影响力或因素。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "противовес",
                                "target_lang_sense_clarification": "сдерживающий фактор"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "制衡",
                                "target_lang_sense_clarification": "相互制约以达到平衡"
                            },
                            {
                                "target_lang_word": "平衡力量",
                                "target_lang_sense_clarification": "起到平衡作用的因素"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "208b0b2e-1604-3893-ba82-2ae29c709fa8",
                    "sense_definition": "A weight that is put in opposition to an equal weight so it keeps that in balance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_balance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old window uses a lead <w>counterbalance</w> to stay open.",
                            "target_lang_translations": {
                                "ru": "В старом окне используется свинцовый <w>противовес</w>, чтобы оно оставалось открытым.",
                                "zh": "这扇老式窗户使用铅制<w>配重</w>来保持开启状态。"
                            }
                        },
                        {
                            "text": "Ensure the <w>counterbalance</w> is secure before lifting the load.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что <w>противовес</w> надежно закреплен перед подъемом груза.",
                                "zh": "在起吊重物前，请确保<w>配重</w>已固定牢靠。"
                            }
                        }
                    ],
                    "synonyms": [
                        "counterweight",
                        "counterpoise"
                    ],
                    "common_phrases": [
                        "heavy counterbalance",
                        "lead counterbalance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Груз, который помещается напротив равного веса для поддержания равновесия.",
                        "zh": "为了保持平衡而放置在对立面的重物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "противовес",
                                "target_lang_sense_clarification": "груз для баланса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "配重",
                                "target_lang_sense_clarification": "用于平衡的重物"
                            },
                            {
                                "target_lang_word": "平衡块",
                                "target_lang_sense_clarification": "机械装置中的平衡部件"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}