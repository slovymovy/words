                    {
                        "sense_id": "f5650dbb-d5c9-3686-86b7-aa4e6f269448",
                        "entry_id": "fad22bef-4874-3290-8fd3-63757c8d8003",
                        "glosses": [
                            "vorsätzliche Tötung einer Person, bei der diese (anschließend) gezielt durch ein Feuer verbrannt wird"
                        ],
                        "tags": [
                            "Rechtsmedizin"
                        ],
                        "examples": [
                            {
                                "example_id": "d4672b3c-874e-4b4a-944b-533338b0c559",
                                "sense_id": "f5650dbb-d5c9-3686-86b7-aa4e6f269448",
                                "text": "Somit stand nun die Frage im Vordergrund, ob Brandmord vorlag oder aber eine Leiche zum Zwecke des Versicherungsbetruges ausgegraben und in den Laden geschafft worden war."
                            },
                            {
                                "example_id": "1b67162f-9878-4565-b9cb-dd6337f8d99a",
                                "sense_id": "f5650dbb-d5c9-3686-86b7-aa4e6f269448",
                                "text": "Gegen Brandmord, d.h. gegen das Verbrennen eines ad hoc ermordeten Mensehen, sprach sehr viel. So waren keinerlei Reste innerer Organe vorhanden."
                            }
                        ],
                        "sense_index_json": "\"1\""
