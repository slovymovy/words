{
    "word_family": [
        "hygiene",
        "hygienist"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6036bc7f-9a52-3ea0-a2f4-771c9525efeb",
                    "sense_definition": "Relating to cleanliness and the maintenance of health, especially by preventing the spread of disease.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cleanliness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is important to keep the kitchen <w>hygienic</w> to prevent food poisoning.",
                            "target_lang_translations": {
                                "zh": "保持厨房<w>卫生</w>对于预防食物中毒非常重要。"
                            }
                        },
                        {
                            "text": "The hospital maintains a very <w>hygienic</w> environment for all its patients.",
                            "target_lang_translations": {
                                "zh": "医院为所有病人维持着非常<w>卫生</w>的环境。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sanitary",
                        "clean"
                    ],
                    "antonyms": [
                        "unhygienic"
                    ],
                    "common_phrases": [
                        "hygienic conditions",
                        "hygienic practices"
                    ],
                    "target_lang_definitions": {
                        "zh": "与清洁和维护健康有关的，特别是通过预防疾病传播来保持健康。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "卫生",
                                "target_lang_sense_clarification": "指符合卫生要求，能预防疾病的。"
                            },
                            {
                                "target_lang_word": "清洁",
                                "target_lang_sense_clarification": "指干净、无污垢的。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7dd56da9-871a-30d8-9c1e-704c9a55dd4d",
                    "sense_definition": "In computer programming, referring to a macro system that prevents accidental variable name conflicts.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The language uses a <w>hygienic</w> macro system to ensure that local variables are not accidentally overwritten.",
                            "target_lang_translations": {
                                "zh": "该语言使用<w>卫生</w>宏系统，以确保局部变量不会被意外覆盖。"
                            }
                        },
                        {
                            "text": "Developers prefer <w>hygienic</w> macros because they make code safer and easier to maintain.",
                            "target_lang_translations": {
                                "zh": "开发人员更喜欢<w>卫生</w>宏，因为它们使代码更安全、更易于维护。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hygienic macro"
                    ],
                    "target_lang_definitions": {
                        "zh": "在计算机编程中，指一种能防止变量名冲突的宏系统。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "卫生",
                                "target_lang_sense_clarification": "计算机术语，指宏系统不会导致变量名冲突。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}