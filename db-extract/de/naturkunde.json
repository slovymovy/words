                                    {
                                        "sense_id": "80ffc4ea-2531-33d5-991d-7daca22f57c8",
                                        "entry_id": "8ef392ac-482a-3484-87a9-f231b952cdb2",
                                        "glosses": [
                                            "Étude des objets observables dans la nature, tant en astronomie, qu’en botanique, en zoologie ou en géologie."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1ef7a25-3a42-4656-9ebe-76418a71a419",
                                                "sense_id": "80ffc4ea-2531-33d5-991d-7daca22f57c8",
                                                "text": "Il ajoutait qu’on ne pouvait mieux faire que de consulter les ouvrages composés à la Chine, sur l’histoire naturelle des climats qu’elle renferme, […] ."
                                            },
                                            {
                                                "example_id": "4124be04-f8f2-40c6-b097-1db8b75a5825",
                                                "sense_id": "80ffc4ea-2531-33d5-991d-7daca22f57c8",
                                                "text": "Puis nous passons à l’histoire naturelle et étudions les mœurs des abeilles, des fourmis, des sauterelles et les vertus de certaines plantes médicinales."
                                            },
                                            {
                                                "example_id": "9c51f7d8-6305-4ad7-82d5-61ca95dbb451",
                                                "sense_id": "80ffc4ea-2531-33d5-991d-7daca22f57c8",
                                                "text": "Vous connaissez ma passion pour l’histoire naturelle. Il ne se passe pas de semaine que je n’herborise, dans la campagne, autour de la ville."
                                            }
                                        ]
                                    }
                                ]
                            }
