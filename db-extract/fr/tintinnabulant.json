                "senses": [
                    {
                        "sense_id": "fac52ad6-b298-3206-b75b-ebf85ca10e3e",
                        "entry_id": "4153e373-31d4-3dbe-9286-edda49383cef",
                        "glosses": [
                            "Qui tinte avec un son cristallin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1737d6bd-8161-488d-bcb1-5fc2918a4f2e",
                                "sense_id": "fac52ad6-b298-3206-b75b-ebf85ca10e3e",
                                "text": "Les calculs qui s'opèrent dans la machine sont à tout moment signalés par des cliquetis des déclics des sons aigus des timbres tintinnabulants, des espèces de bruits compa­rables à ceux d'une caisse enregistreuse."
                            },
                            {
                                "example_id": "6d7ba96e-59b0-4011-9024-f3a3cde1f85c",
                                "sense_id": "fac52ad6-b298-3206-b75b-ebf85ca10e3e",
                                "text": "Ils croisèrent, jaillie, eût-on dit, d’une porte vitrée, une jeune personne tintinnabulante d’amulettes qui sourit, machinale, à Frédéric."
                            },
                            {
                                "example_id": "c9f52d3c-5194-439a-9f9f-3158f1956206",
                                "sense_id": "fac52ad6-b298-3206-b75b-ebf85ca10e3e",
                                "text": "Un rire tintinnabulant."
                            }
                        ]
                    }
