                        "examples": [
                            {
                                "example_id": "fff47a0e-6b2f-4085-acbe-68c762298bf9",
                                "sense_id": "a90575d8-5b11-3a8b-a009-69ef7194c0b6",
                                "text": "‘Ze kunnen juist trots zijn op hun sociale identiteit als leipe mocro’s. (straattaal voor Marokkanen – red.) …’",
                                "translation": "Ils peuvent être fiers de leur identité sociale en tant que Marocains barjos."
                            },
                            {
                                "example_id": "bfa69bb4-84d2-4156-95c2-41b970125de8",
                                "sense_id": "a90575d8-5b11-3a8b-a009-69ef7194c0b6",
                                "text": "\"Geen mocro's. Geen bende blacks... Simpel. Ook niet op lijst \", staat er in een Facebookgesprek dat is uigelekt via de sociale media.",
                                "translation": "\"Pas de Marocains, pas de meutes de blacks.. Comme ça. Même listés (listés)\", est-il écrit sur un tchat de Facebook, qui est divulgué aux réseaux sociaux."
                            }
                        ]
                    }
