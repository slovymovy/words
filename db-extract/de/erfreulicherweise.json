        "de-extract.jsonl": [
            {
                "entry_id": "07c163ed-3925-3fa8-be4a-a2441e70b229",
                "word": "erfreulicherweise",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a51d0fce-be09-31de-bed4-420984738757",
                        "entry_id": "07c163ed-3925-3fa8-be4a-a2441e70b229",
                        "glosses": [
                            "zur Freude des Sprechers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87f0c5f8-51be-48dc-b96c-67c55d94a7f3",
                                "sense_id": "a51d0fce-be09-31de-bed4-420984738757",
                                "text": "Zu unserer Grillfeier war das Wetter erfreulicherweise sehr schön."
                            },
                            {
                                "example_id": "fd20c247-e87f-42c5-bbc4-085303558b95",
                                "sense_id": "a51d0fce-be09-31de-bed4-420984738757",
                                "text": "Erfreulicherweise konnte George W. Bush keine dritte Amtszeit in Anspruch nehmen."
                            },
                            {
                                "example_id": "be048343-26d0-4ae3-b5b5-8a71a4980c34",
                                "sense_id": "a51d0fce-be09-31de-bed4-420984738757",
                                "text": "„Und das wird hier erfreulicherweise noch immer in Suppentellern kredenzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "87fd878a-29a4-4a3b-ab68-7b6f262b2fdf",
                        "source_entry_id": "07c163ed-3925-3fa8-be4a-a2441e70b229",
                        "source_sense_id": "a51d0fce-be09-31de-bed4-420984738757",
                        "source_sense_description": "zur Freude des Sprechers",
                        "target_lang_word": "fortunately",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fortunately",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8dd3bdb6-1961-36e1-8ccd-2f65bf4f93ac",
                                        "entry_id": "f8f5567b-caea-3aaa-bf99-d9d18c82e4ef",
                                        "glosses": [
                                            "In a fortunate manner."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a1bc5d3d-96c3-386d-afbd-1ebeb4605eac",
                                        "entry_id": "f8f5567b-caea-3aaa-bf99-d9d18c82e4ef",
                                        "glosses": [
                                            "It is (or was, etc) fortunate that."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08714842-52f2-4e8a-bc85-76d1a6de58dc",
                                                "sense_id": "a1bc5d3d-96c3-386d-afbd-1ebeb4605eac",
                                                "text": "Fortunately for Sam, his pet hamster was alive."
                                            },
                                            {
                                                "example_id": "9a4ccee3-09b7-43ce-815d-0832069c2300",
                                                "sense_id": "a1bc5d3d-96c3-386d-afbd-1ebeb4605eac",
                                                "text": "My mom has fortunately agreed to help us with the science project for school."
                                            },
                                            {
                                                "example_id": "5d39e9f6-7928-4c23-a2fc-83b4754f1879",
                                                "sense_id": "a1bc5d3d-96c3-386d-afbd-1ebeb4605eac",
                                                "text": "[…]the best thing to do is to curl up with a good goose-flesher and try to forget, and fortunately I had packed among my effects one called Murder at Greystone Grange."
                                            },
                                            {
                                                "example_id": "1037c556-c8bd-4cd6-bba2-8aa144f3081b",
                                                "sense_id": "a1bc5d3d-96c3-386d-afbd-1ebeb4605eac",
                                                "text": "Fortunately — very fortunately — the American people have a happy alternative to this bankrupt Republican campaign and its captive candidate."
                                            },
                                            {
                                                "example_id": "a93892a8-c294-43a4-a9d6-2ca40276299a",
                                                "sense_id": "a1bc5d3d-96c3-386d-afbd-1ebeb4605eac",
                                                "text": "Most pitchside medical staff fortunately will never have to treat a life threatening injury on the field of play."
                                            },
                                            {
                                                "example_id": "4c169188-4b0a-4a54-8ef8-0055e910f8da",
                                                "sense_id": "a1bc5d3d-96c3-386d-afbd-1ebeb4605eac",
                                                "text": "Fortunately for the noncampers, half of the hotel rooms overlook the seaside stage, making attendance almost automatic, and very convenient in bad weather."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7bf33600-cb5d-41ae-b382-cf64401ebaaf",
                        "source_entry_id": "07c163ed-3925-3fa8-be4a-a2441e70b229",
                        "source_sense_id": "a51d0fce-be09-31de-bed4-420984738757",
                        "source_sense_description": "zur Freude des Sprechers",
                        "target_lang_word": "happily",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "happily",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de95d93e-c960-3e47-a541-aaa00b2e88ea",
                                        "entry_id": "71bd1161-03d3-3c86-8e05-e53c2b9a8d5a",
                                        "glosses": [
                                            "In a happy or cheerful manner; with happiness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f0cd391-bf2c-4c06-a226-f5f6ee3ea0b1",
                                                "sense_id": "de95d93e-c960-3e47-a541-aaa00b2e88ea",
                                                "text": "This time next month I’ll be happily fishing at the beach."
                                            },
                                            {
                                                "example_id": "aa828e31-617b-450e-8739-5baf0be85ba0",
                                                "sense_id": "de95d93e-c960-3e47-a541-aaa00b2e88ea",
                                                "text": "And thus I have given the first part of a life of fortune and adventure, a life of Providence's chequer-work, and of a variety which the world will seldom be able to shew the like of: beginning foolishly, but closing much more happily than any part of it ever gave me leave so much as to hope for."
                                            },
                                            {
                                                "example_id": "ea2ce3e6-936d-43e7-a3de-784a79335de4",
                                                "sense_id": "de95d93e-c960-3e47-a541-aaa00b2e88ea",
                                                "text": "Train operating companies get plenty of column inches in the tabloids, usually for negative reasons. Happily, Southeastern is worthy of praise for having made The Sun for something positive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81054a6c-9a4e-3d16-8f60-660610a36c31",
                                        "entry_id": "71bd1161-03d3-3c86-8e05-e53c2b9a8d5a",
                                        "glosses": [
                                            "By good chance; fortunately, successfully."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "774e1733-253b-494b-a480-193607f08318",
                                                "sense_id": "81054a6c-9a4e-3d16-8f60-660610a36c31",
                                                "text": "Watt wore, on his feet, a boot, brown in colour, and a shoe, happily of a brownish colour also."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ad5cb87-5a0a-3781-a61e-31639014727b",
                                        "entry_id": "71bd1161-03d3-3c86-8e05-e53c2b9a8d5a",
                                        "glosses": [
                                            "With good will; in all happiness; willingly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62a17171-6d89-4412-9f16-b5f172348077",
                                                "sense_id": "9ad5cb87-5a0a-3781-a61e-31639014727b",
                                                "text": "I will happily help you look for your lost wallet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5306604-7dff-3488-9c86-f35980b59732",
                                        "entry_id": "71bd1161-03d3-3c86-8e05-e53c2b9a8d5a",
                                        "glosses": [
                                            "By chance; perhaps."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72740378-37da-4b13-be3e-540bafc6c561",
                                                "sense_id": "f5306604-7dff-3488-9c86-f35980b59732",
                                                "text": "And who knoweth whether a thousand yeares hence a third opinion will rise, which happily shall overthrow these two precedents?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4099791a-b375-4f70-a312-768e6d084db4",
                        "source_entry_id": "07c163ed-3925-3fa8-be4a-a2441e70b229",
                        "source_sense_id": "a51d0fce-be09-31de-bed4-420984738757",
                        "source_sense_description": "zur Freude des Sprechers",
                        "target_lang_word": "thankfully",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thankfully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "26335b40-2eb2-337a-bbd9-36056d0aa6dc",
                                        "entry_id": "ff0f265a-4b27-3c3c-a05a-4986b8ae0015",
                                        "glosses": [
                                            "In a thankful manner; giving thanks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66ee3ae6-5930-4776-9f7c-d649897dc3f4",
                                                "sense_id": "26335b40-2eb2-337a-bbd9-36056d0aa6dc",
                                                "text": "Gratiano:\n[…]I owe you much, and, like a wilful youth\nThat which I owe is lost; but if you please\nTo shoot another arrow that self way\nWhich you did shoot the first, I do not doubt,\nAs I will watch the aim, or to find both,\nOr bring your latter hazard back again,\nAnd thankfully rest debtor for the first."
                                            },
                                            {
                                                "example_id": "2d3ae19a-58c4-44e6-873e-c3c57c5a86dc",
                                                "sense_id": "26335b40-2eb2-337a-bbd9-36056d0aa6dc",
                                                "text": "I immediately offered my assistance to the unhappy person, who thankfully accepted it, and, putting himself under my conduct, begged me to convey him to some tavern, where he might send for a surgeon […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97913b28-44e0-3898-8d38-aef72ba3163d",
                                        "entry_id": "ff0f265a-4b27-3c3c-a05a-4986b8ae0015",
                                        "glosses": [
                                            "fortunately, gratefully."
                                        ],
                                        "tags": [
                                            "proscribed",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd82015e-a5ab-4260-aea1-42068d58f01d",
                                                "sense_id": "97913b28-44e0-3898-8d38-aef72ba3163d",
                                                "text": "I was almost late for work, but thankfully there wasn't much traffic on the roads."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cfdbd3c1-addf-4991-b9e5-4a0e0a431400",
                        "source_entry_id": "07c163ed-3925-3fa8-be4a-a2441e70b229",
                        "source_sense_id": "a51d0fce-be09-31de-bed4-420984738757",
                        "source_sense_description": "zur Freude des Sprechers",
                        "target_lang_word": "gelukkig",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gelukkig",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "31582006-d29c-3963-8023-5eb6c87a3806",
                                        "entry_id": "66ad9c02-6767-34be-960d-99e12c9b436c",
                                        "glosses": [
                                            "in een tevredene toestand zijn, zich goed voelen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c65d37bb-ac64-429e-ab7c-eb69a9ebae64",
                                                "sense_id": "31582006-d29c-3963-8023-5eb6c87a3806",
                                                "text": "\"Veel mensen vergissen zich in wat ze gelukkig maakt\""
                                            },
                                            {
                                                "example_id": "a3f348ed-d11e-42ce-a1e4-6548cc672d9e",
                                                "sense_id": "31582006-d29c-3963-8023-5eb6c87a3806",
                                                "text": "De hemel van de zomer verjaagt het zuur van de stad, zong Charles Trenet al: 'Wij zijn gelukkig, Route Nationale 7.'"
                                            },
                                            {
                                                "example_id": "6b79f476-5411-4d0c-8637-e24708c5eee3",
                                                "sense_id": "31582006-d29c-3963-8023-5eb6c87a3806",
                                                "text": "Dit alles betekende ook dat ik mijn gezin lange tijd niet zou zien. Gelukkig had mijn vrouw daar geen probleem mee omdat ze zelf kort ervoor een lange wandeling naar Santiago de Compostela had gemaakt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "890f2877-b45f-31c8-a15c-2b4d595dbe47",
                                        "entry_id": "66ad9c02-6767-34be-960d-99e12c9b436c",
                                        "glosses": [
                                            "door gunstig toeval, met mazzel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c40ee084-b598-4607-b9eb-c87867484273",
                                                "sense_id": "890f2877-b45f-31c8-a15c-2b4d595dbe47",
                                                "text": "Het elftal van Ernie Brandts mocht in de eerste helft van geluk spreken dat de thuisclub een zestal kansen onbenut liet, voordat Simon Cziommer in de 41ste minuut na een actie van Dembélé met een gelukkig schot de score openbrak."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
