                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "begierig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "098bb29a-cf78-3dd8-be58-3b77d00e6f99",
                                        "entry_id": "10334f2e-3394-3f85-8af6-56e3afc2ad70",
                                        "glosses": [
                                            "von intensiven Wünschen erfüllt sein, begehren nach"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6c0f579-f29f-430c-8198-4aa86fb2a2ca",
                                                "sense_id": "098bb29a-cf78-3dd8-be58-3b77d00e6f99",
                                                "text": "adjektivisch: Seine begierigen Wünsche wurden nicht erfüllt."
                                            },
                                            {
                                                "example_id": "059e7f3b-f8d6-4b68-8f20-2b593e0c63e3",
                                                "sense_id": "098bb29a-cf78-3dd8-be58-3b77d00e6f99",
                                                "text": "adverbial: Er war begierig auf ein Treffen mit ihr."
                                            },
                                            {
                                                "example_id": "f33a5ef4-c196-4f1c-9e90-d623e8783051",
                                                "sense_id": "098bb29a-cf78-3dd8-be58-3b77d00e6f99",
                                                "text": "postpositional (mit dem Genitiv): Des Neuen immer begierig, war er oft auf den Märkten zu finden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4da6f51-b6a5-4942-9f8f-7a993694ad9b",
                        "source_entry_id": "df0fc9ab-06bf-3aa6-88f2-46aacfd8eab0",
