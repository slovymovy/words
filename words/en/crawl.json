{
    "word_family": [
        "crawler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d9e692fe-abca-322c-9513-e82996eb3eca",
                    "sense_definition": "To move slowly with the body close to the ground, typically on hands and knees.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baby began to <w>crawl</w> across the living room floor.",
                            "target_lang_translations": {
                                "ru": "Ребёнок начал <w>ползать</w> по полу в гостиной.",
                                "zh": "婴儿开始在客厅地板上<w>爬行</w>。"
                            }
                        },
                        {
                            "text": "The injured soldier <w>crawled</w> to safety behind the wall.",
                            "target_lang_translations": {
                                "ru": "Раненый солдат <w>пополз</w> в укрытие за стену.",
                                "zh": "受伤的士兵<w>爬</w>到了墙后的安全地带。"
                            }
                        }
                    ],
                    "synonyms": [
                        "creep"
                    ],
                    "antonyms": [
                        "walk",
                        "run"
                    ],
                    "common_phrases": [
                        "crawl on hands and knees",
                        "crawl out of bed"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться медленно, прижавшись телом к земле, обычно на четвереньках.",
                        "zh": "指身体贴近地面缓慢移动，通常指用手和膝盖爬行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ползти́",
                                "target_lang_sense_clarification": "двигаться в определенном направлении"
                            },
                            {
                                "target_lang_word": "по́лзать",
                                "target_lang_sense_clarification": "двигаться в разных направлениях или обладать способностью ползать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "爬行",
                                "target_lang_sense_clarification": "指用手和膝盖在地上移动"
                            },
                            {
                                "target_lang_word": "爬",
                                "target_lang_sense_clarification": "动作的动词形式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14a1d99e-dcaf-3880-a0f6-05663e9f60de",
                    "sense_definition": "To move forward at a very slow pace, often due to heavy traffic or obstruction.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "slow_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rush-hour traffic <w>crawled</w> along the highway this morning.",
                            "target_lang_translations": {
                                "ru": "Сегодня утром движение на шоссе <w>ползло</w> из-за часа пик.",
                                "zh": "今天早上高峰期的交通在高速公路上缓慢<w>挪动</w>。"
                            }
                        },
                        {
                            "text": "Time seemed to <w>crawl</w> while we waited for the test results.",
                            "target_lang_translations": {
                                "ru": "Казалось, время <w>ползет</w>, пока мы ждали результатов анализов.",
                                "zh": "等待检查结果时，时间仿佛在<w>缓慢移动</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "inch",
                        "plod",
                        "creep",
                        "drag"
                    ],
                    "antonyms": [
                        "sprint"
                    ],
                    "common_phrases": [
                        "traffic crawls",
                        "time crawls"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться вперед очень медленно, часто из-за плотного движения или препятствий.",
                        "zh": "指移动速度非常缓慢，常用于形容交通拥堵或进展缓慢。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ползти́",
                                "target_lang_sense_clarification": "метафорически: о транспорте или времени"
                            },
                            {
                                "target_lang_word": "е́ле тащи́ться",
                                "target_lang_sense_clarification": "разговорное: двигаться с трудом и медленно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "缓慢移动",
                                "target_lang_sense_clarification": "形容速度极慢"
                            },
                            {
                                "target_lang_word": "挪动",
                                "target_lang_sense_clarification": "形容像蜗牛一样缓慢前进"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "069fe3f7-524b-327e-b2c6-478633cdaa9c",
                    "sense_definition": "To feel an uncomfortable sensation on the skin, as if insects are moving over it, usually caused by fear or disgust.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sight of all those snakes made my skin <w>crawl</w>.",
                            "target_lang_translations": {
                                "ru": "От вида всех этих змей у меня <w>мурашки по коже</w>.",
                                "zh": "看到那么多蛇，我感到<w>毛骨悚然</w>。"
                            }
                        },
                        {
                            "text": "His creepy voice makes my skin <w>crawl</w> every time I hear it.",
                            "target_lang_translations": {
                                "ru": "От его жуткого голоса у меня каждый раз <w>мороз по коже</w>.",
                                "zh": "每次听到他那令人毛骨悚然的声音，我都会<w>起鸡皮疙瘩</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "make one's skin crawl"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ощущать неприятное чувство на коже, будто по ней ползают насекомые (обычно от страха или отвращения).",
                        "zh": "指因恐惧或厌恶而感到皮肤上有类似虫子爬行的不适感。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мура́шки по ко́же",
                                "target_lang_sense_clarification": "идиома: ощущение озноба от страха"
                            },
                            {
                                "target_lang_word": "моро́з по ко́же",
                                "target_lang_sense_clarification": "идиома: сильное чувство страха"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "毛骨悚然",
                                "target_lang_sense_clarification": "形容极度恐惧"
                            },
                            {
                                "target_lang_word": "起鸡皮疙瘩",
                                "target_lang_sense_clarification": "形容因恐惧或恶心而产生的生理反应"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a43b8416-1f95-3c91-93c0-96d5c318dec9",
                    "sense_definition": "To behave in a very humble or submissive way to someone in authority, often to ask for forgiveness or a favor.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He came <w>crawling</w> back to her after he realized his mistake.",
                            "target_lang_translations": {
                                "ru": "Он <w>приполз</w> к ней обратно, когда осознал свою ошибку.",
                                "zh": "意识到错误后，他<w>卑躬屈膝</w>地回到她身边。"
                            }
                        },
                        {
                            "text": "I refuse to <w>crawl</w> to the boss just to get a promotion.",
                            "target_lang_translations": {
                                "ru": "Я отказываюсь <w>пресмыкаться</w> перед боссом только ради повышения.",
                                "zh": "我拒绝为了升职而向老板<w>摇尾乞怜</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "grovel",
                        "kowtow"
                    ],
                    "common_phrases": [
                        "crawl back"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вести себя униженно или подобострастно перед кем-то, имеющим власть, часто чтобы попросить прощения или об одолжении.",
                        "zh": "指在权威面前表现得卑躬屈膝，通常是为了请求宽恕或讨好。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пресмыка́ться",
                                "target_lang_sense_clarification": "раболепствовать, унижаться"
                            },
                            {
                                "target_lang_word": "унижа́ться",
                                "target_lang_sense_clarification": "ставить себя в унизительное положение"
                            },
                            {
                                "target_lang_word": "приползти́",
                                "target_lang_sense_clarification": "разговорное: вернуться с повинной"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "卑躬屈膝",
                                "target_lang_sense_clarification": "形容态度极其卑微"
                            },
                            {
                                "target_lang_word": "摇尾乞怜",
                                "target_lang_sense_clarification": "形容讨好权贵"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37aa8b8c-8f6e-3714-bf29-94d32ef3a155",
                    "sense_definition": "To automatically visit websites or files in order to index them for a search engine.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Search engine bots <w>crawl</w> the internet to discover new pages.",
                            "target_lang_translations": {
                                "ru": "Боты поисковых систем <w>сканируют</w> интернет, чтобы находить новые страницы.",
                                "zh": "搜索引擎机器人会在互联网上<w>抓取</w>信息以发现新页面。"
                            }
                        },
                        {
                            "text": "The software is designed to <w>crawl</w> the database for specific errors.",
                            "target_lang_translations": {
                                "ru": "Программа создана, чтобы <w>проверять</w> базу данных на наличие конкретных ошибок.",
                                "zh": "该软件旨在<w>扫描</w>数据库以查找特定错误。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "crawl the web"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical context (computing)"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Автоматически посещать веб-сайты или файлы для их индексации поисковой системой.",
                        "zh": "指搜索引擎自动访问网站或文件以进行索引。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "индекси́ровать",
                                "target_lang_sense_clarification": "обрабатывать данные для поиска"
                            },
                            {
                                "target_lang_word": "скани́ровать",
                                "target_lang_sense_clarification": "просматривать содержимое"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抓取",
                                "target_lang_sense_clarification": "网络爬虫获取网页数据"
                            },
                            {
                                "target_lang_word": "索引",
                                "target_lang_sense_clarification": "对网页内容进行编目"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a35ed367-78a4-35cc-9309-1edbdc6da006",
                    "sense_definition": "A swimming style where the swimmer lies face down and uses alternate overarm strokes and a fluttering kick.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "swimming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She swam the front <w>crawl</w> faster than anyone else in the race.",
                            "target_lang_translations": {
                                "ru": "Она проплыла <w>кролем</w> быстрее всех в гонке.",
                                "zh": "她在比赛中游<w>自由泳</w>的速度比其他任何人都快。"
                            }
                        },
                        {
                            "text": "He is taking lessons to improve his technique for the <w>crawl</w>.",
                            "target_lang_translations": {
                                "ru": "Он берет уроки, чтобы улучшить свою технику <w>кроля</w>.",
                                "zh": "他正在上课以改进他的<w>自由泳</w>技术。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "front crawl"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стиль плавания на животе, при котором пловец совершает попеременные гребки руками и движения ногами вверх-вниз.",
                        "zh": "一种游泳姿势，即自由泳，通过交替划臂和打腿前进。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кроль",
                                "target_lang_sense_clarification": "стиль плавания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "自由泳",
                                "target_lang_sense_clarification": "游泳的一种竞技姿势"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53855769-ee82-3c68-8b1f-9ed1e60fd85d",
                    "sense_definition": "A very slow speed or pace.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "slow_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Traffic slowed to a <w>crawl</w> because of the accident ahead.",
                            "target_lang_translations": {
                                "ru": "Движение замедлилось до <w>черепашьего шага</w> из-за аварии впереди.",
                                "zh": "由于前方发生事故，交通速度降到了<w>龟速</w>。"
                            }
                        },
                        {
                            "text": "Construction work on the new building has slowed to a <w>crawl</w>.",
                            "target_lang_translations": {
                                "ru": "Строительные работы над новым зданием практически <w>остановились</w>.",
                                "zh": "新大楼的施工进度已经慢到了<w>极慢的速度</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "slow to a crawl"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень низкая скорость или темп движения.",
                        "zh": "指极慢的速度或节奏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "черепа́ший шаг",
                                "target_lang_sense_clarification": "идиома: очень медленное движение"
                            },
                            {
                                "target_lang_word": "ме́дленное движе́ние",
                                "target_lang_sense_clarification": "прямое значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "龟速",
                                "target_lang_sense_clarification": "形容速度极慢"
                            },
                            {
                                "target_lang_word": "极慢的速度",
                                "target_lang_sense_clarification": "描述进展缓慢的状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be577ebe-04ea-3691-bc27-421d99b6ba32",
                    "sense_definition": "The act of moving on hands and knees.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The baby did a quick <w>crawl</w> towards the toy.",
                            "target_lang_translations": {
                                "ru": "Малыш быстро <w>пополз</w> к игрушке.",
                                "zh": "婴儿快速地向玩具<w>爬行</w>过去。"
                            }
                        },
                        {
                            "text": "We had to do a long <w>crawl</w> through the narrow tunnel.",
                            "target_lang_translations": {
                                "ru": "Нам пришлось долго <w>ползти</w> через узкий туннель.",
                                "zh": "我们不得不通过狭窄的隧道进行了一段漫长的<w>爬行</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс передвижения на четвереньках.",
                        "zh": "用手和膝盖在地上移动的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "по́лзание",
                                "target_lang_sense_clarification": "существительное: процесс"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "爬行",
                                "target_lang_sense_clarification": "名词形式的动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b1b23ba-83a5-33c7-8ad7-3ccb09470f26",
                    "sense_definition": "A social activity involving visiting several pubs or bars in succession.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "social_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They organized a pub <w>crawl</w> to celebrate his graduation.",
                            "target_lang_translations": {
                                "ru": "Они организовали <w>поход по барам</w>, чтобы отпраздновать его выпускной.",
                                "zh": "他们组织了一场<w>酒吧巡游</w>来庆祝他毕业。"
                            }
                        },
                        {
                            "text": "We went on a bar <w>crawl</w> downtown last Saturday night.",
                            "target_lang_translations": {
                                "ru": "В прошлую субботу вечером мы устроили <w>тур по барам</w> в центре города.",
                                "zh": "上周六晚上，我们在市中心进行了一次<w>酒吧巡游</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pub crawl",
                        "bar crawl"
                    ],
                    "target_lang_definitions": {
                        "ru": "Развлекательное мероприятие, включающее посещение нескольких пабов или баров подряд.",
                        "zh": "一种社交活动，指连续去多家酒吧喝酒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "похо́д по ба́рам",
                                "target_lang_sense_clarification": "развлечение"
                            },
                            {
                                "target_lang_word": "тур по ба́рам",
                                "target_lang_sense_clarification": "организованное мероприятие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "酒吧巡游",
                                "target_lang_sense_clarification": "连续访问多家酒吧的活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "795cddea-89de-3093-8f28-862a1ca6d921",
                    "sense_definition": "A line of text that moves across a screen, typically showing news or credits.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "media",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The news <w>crawl</w> at the bottom of the screen displayed the election results.",
                            "target_lang_translations": {
                                "ru": "<w>Бегущая строка</w> новостей внизу экрана показывала результаты выборов.",
                                "zh": "屏幕底部的<w>滚动字幕</w>显示了选举结果。"
                            }
                        },
                        {
                            "text": "The movie started with a famous opening <w>crawl</w> explaining the war.",
                            "target_lang_translations": {
                                "ru": "Фильм начался со знаменитых вступительных <w>титров</w>, объясняющих войну.",
                                "zh": "电影以一段著名的解释战争背景的开场<w>滚动字幕</w>开始。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "opening crawl",
                        "news crawl"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "media/technical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Строка текста, движущаяся по экрану, обычно показывающая новости или титры.",
                        "zh": "屏幕上移动的文字行，通常用于显示新闻或演职员表。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бегу́щая строка́",
                                "target_lang_sense_clarification": "текст на экране"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "滚动字幕",
                                "target_lang_sense_clarification": "屏幕上移动的文字"
                            },
                            {
                                "target_lang_word": "跑马灯",
                                "target_lang_sense_clarification": "指屏幕下方滚动的新闻条"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}