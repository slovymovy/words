                "senses": [
                    {
                        "sense_id": "c734a9c1-326d-37bb-94dc-e62a970191cc",
                        "entry_id": "b3c0df66-9e30-3fc1-a0b2-d539d1df74cf",
                        "glosses": [
                            "Offizier beim israelischen Auslandsgeheimdienst Mossad"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a34e48ff-9046-4553-b9ad-64a4070ede90",
                                "sense_id": "c734a9c1-326d-37bb-94dc-e62a970191cc",
                                "text": "„Solche Autobomben – die bevorzugte Waffe der israelischen Streitkräfte, die Beirut belagerten, und eines ihrer schrecklichsten Instrumente für Tod und Zerstörung – wurden von einem Mossad-Offizier als »Töten um des Tötens willen« bezeichnet.“"
                            },
                            {
                                "example_id": "c4d20e91-66e7-4396-8f03-775e74b6cf4a",
                                "sense_id": "c734a9c1-326d-37bb-94dc-e62a970191cc",
                                "text": "„Derartige Aufgaben überließen sie Mossad-Offizieren aus Europa, für die es keinerlei Problem darstellte, sich in Paris oder Rom mit Agenten zu treffen, von diesen Informationen entgegenzunehmen und ihnen ihr Gehalt zu bezahlen.“"
                            },
                            {
                                "example_id": "0beb7867-3dfe-4dc0-8803-ed3516811355",
                                "sense_id": "c734a9c1-326d-37bb-94dc-e62a970191cc",
                                "text": "„Court wollte nicht weiter mit diesem Mossad-Offizier in Verbindung bleiben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
