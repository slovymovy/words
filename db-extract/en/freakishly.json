                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37e2efb2-ade4-4561-b879-13ad2cf915f0",
                                "sense_id": "11b94c04-30c3-3d8c-9d71-83d83b7f39d2",
                                "text": "“King Homer” follows the story of King Kong closely, with Mr. Burns taking the freakishly over-sized King Homer from his native Africa, where he lives proud as a simian god, to the United States, where he is an initially impressive but ultimately rather limited Broadway attraction."
                            },
                            {
                                "example_id": "579b5df7-edab-41a1-9f35-627b5fd3512e",
                                "sense_id": "11b94c04-30c3-3d8c-9d71-83d83b7f39d2",
                                "text": "\"Certainly not freakishly small and certainly not enormous,\" Horwell said. \"Not one of these witnesses can be relied upon.\""
                            },
                            {
                                "example_id": "e03b9c3c-5771-4396-8dcb-067e7316896d",
                                "sense_id": "11b94c04-30c3-3d8c-9d71-83d83b7f39d2",
                                "text": "Nicolas Cage’s performance in the freakishly great 1989 cult classic Vampire’s Kiss transcends language and exposes the limitations of human vocabulary, entering a space sometimes rationalised with the defeatist turn of phrase: “there are no words”."
                            }
                        ]
                    }
