                    {
                        "sense_id": "a9b8b701-6c69-34cf-b226-344bb353ab49",
                        "entry_id": "09267d8f-084f-3996-8b2e-aae44dfa9c8f",
                        "glosses": [
                            "A morbid fear of childbirth or pregnancy."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e658a4bf-61a6-41f2-ab4c-b640619f7267",
                                "sense_id": "a9b8b701-6c69-34cf-b226-344bb353ab49",
                                "text": "As soon as Dr Guy Glass cured Rebecca of her tokophobia, the place would be full of children."
                            },
                            {
                                "example_id": "e5dfe8d1-a223-4484-b3f0-3894da7cedc3",
                                "sense_id": "a9b8b701-6c69-34cf-b226-344bb353ab49",
                                "text": "A multitude of stories are required, not just to help those telling them to work out their own narratives, or to help those looking for information, but to challenge tokophobia by enriching and complicating our cultural understanding of childbirth."
                            }
                        ]
                    }
