                "senses": [
                    {
                        "sense_id": "4ee9b15f-a03a-31e3-aac9-faa6f73520c3",
                        "entry_id": "fa63a6a1-7868-3643-9ac9-b4dde1d5fde6",
                        "glosses": [
                            "als in Utopia, als in een utopie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be5dcf7c-3461-4850-8266-c2d0d4fc1c17",
                                "sense_id": "4ee9b15f-a03a-31e3-aac9-faa6f73520c3",
                                "text": "Maar vergis je niet, dit was geen utopisch paradijs."
                            }
                        ]
                    },
                    {
                        "sense_id": "b1d87bde-d381-3c96-bfa2-127d65080597",
                        "entry_id": "fa63a6a1-7868-3643-9ac9-b4dde1d5fde6",
                        "glosses": [
                            "gericht op drastische verandering die echter onhaalbaar lijkt"
                        ],
                        "tags": [],
