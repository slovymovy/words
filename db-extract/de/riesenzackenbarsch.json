                "senses": [
                    {
                        "sense_id": "0c0f5524-0f48-323c-bad4-aa94a25720cf",
                        "entry_id": "e3be4da0-106e-3b0c-82a0-7650f745401c",
                        "glosses": [
                            "besonders großer Knochenfisch, der vorzugsweise in der Nähe von Korallenriffen lebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc79c05a-315a-4191-b00d-c2476a881332",
                                "sense_id": "0c0f5524-0f48-323c-bad4-aa94a25720cf",
                                "text": "„Wenn sich den Riesenzackenbarschen jemand nähert, ziehen sie ihre Schwimmblase zusammen, den Luftsack, der ihnen Auftrieb gibt, und stoßen grollende Laute aus.“"
                            },
                            {
                                "example_id": "5d931177-0a7a-4300-b1d8-2a9921c51cda",
                                "sense_id": "0c0f5524-0f48-323c-bad4-aa94a25720cf",
                                "text": "„Die Herkunft der Bezeichnung „Judenfisch“ ist unklar. Möglicherweise entspricht sein weißes und festes Fleisch, welches von ausgezeichneter Qualität ist, den Anforderungen eines koscheren Nahrungsmittels. Seit dem Jahr 2001 wird von der „American Fisheries Society“ nur noch der englische Trivialname „Atlantic goliath grouper“ verwendet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
