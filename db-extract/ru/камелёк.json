                        "examples": [
                            {
                                "example_id": "b5a6524f-041f-4fb9-b159-dea7adc2ddc2",
                                "sense_id": "f87d7165-9495-38ae-9e56-b11489246ead",
                                "text": "По́здним ве́чером, о́коло полу́ночи, сиде́ли у потуха́ющего камелька́ пя́теро ста́рых друзе́й и расска́зывали друг дру́гу исто́рии.",
