                "senses": [
                    {
                        "sense_id": "804c11f1-e0af-3ee0-95d4-13c0ba83e413",
                        "entry_id": "20d40649-293d-33e0-9d63-56c629a04d3a",
                        "glosses": [
                            "Donner un caractère indigène à."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "e694f095-345f-4008-8c46-210c23d8f7df",
                                "sense_id": "804c11f1-e0af-3ee0-95d4-13c0ba83e413",
                                "text": "Plusieurs recherches ont montré que les apports de la mondialisation peuvent se conjuguer avec les cultures « locales ». On a dit aussi de ces apports qu’ils étaient « indigénéisés », « métabolisés »."
                            },
                            {
                                "example_id": "6238a3f2-eedf-4137-8aad-f97d023b96d4",
                                "sense_id": "804c11f1-e0af-3ee0-95d4-13c0ba83e413",
                                "text": "Ce n’est que plus tard qu’il s’appliqua à l’indigénéiser."
                            },
                            {
                                "example_id": "e91dce1d-1225-4b83-82e4-c9dc41f97fb7",
                                "sense_id": "804c11f1-e0af-3ee0-95d4-13c0ba83e413",
                                "text": "C’est par ce biais pourtant que la société dominée prend lentement conscience que son univers symbolique est discrédité, périphérisé, marginalisé et qu’elle en train de s’« indigénéiser »."
                            }
                        ]
                    }
                ],
