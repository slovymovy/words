                "senses": [
                    {
                        "sense_id": "0d0c1abc-8a43-3905-a71a-3bdeef97fb90",
                        "entry_id": "e3bbaffb-7fce-33d8-b95d-a96c16be0d79",
                        "glosses": [
                            "Handlung, ein Lokal zu betreten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d692eae-9d56-42a3-b890-ab01199463db",
                                "sense_id": "0d0c1abc-8a43-3905-a71a-3bdeef97fb90",
                                "text": "„Überall gibt es die Höfe der Winzer und Straußwirtschaften, die zur Einkehr einladen.“"
                            },
                            {
                                "example_id": "e035616f-f581-4522-96aa-1e9e7923d04b",
                                "sense_id": "0d0c1abc-8a43-3905-a71a-3bdeef97fb90",
                                "text": "„Die Aktentasche eng an den Körper gepresst, widerstand er der Versuchung einer feuchtfröhlichen Einkehr und blieb erst vor einem Schaufenster stehen, in dessen Auslage die glänzenden Füllfederhalter der Firma Goldfink präsentiert wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d9e46077-6fb2-387b-88fc-f683004c1e05",
                        "entry_id": "e3bbaffb-7fce-33d8-b95d-a96c16be0d79",
                        "glosses": [
                            "Handlung, sich zu besinnen, prüfen"
                        ],
