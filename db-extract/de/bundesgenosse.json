                                "example_id": "0c2689f3-c5e6-4e45-a7e6-dbdbeb030f7e",
                                "sense_id": "5facc8b4-04c9-37b8-adf4-1d7dca7c4d82",
                                "text": "„Aber allmählich zeichnete sich schon eine wachsende Entfremdung zwischen den Bundesgenossen ab.“"
                            },
