                                        "entry_id": "42c36b16-7b85-36d9-9b5b-416aeca6a868",
                                        "glosses": [
                                            "A fine clay, rich in kaolinite, used in ceramics, paper-making, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
