                ],
                "senses": [
                    {
                        "sense_id": "090e07ca-1bb4-368c-b5d8-99213db128c3",
                        "entry_id": "b80e1ca8-1918-3b45-9094-23ff96bc547a",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcd836d7-0937-4e07-b5d6-da1a8ea30b92",
                                "sense_id": "090e07ca-1bb4-368c-b5d8-99213db128c3",
                                "text": "Frau Gyger ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "e2a95e22-69d0-40aa-a169-222cbad0dd45",
                                "sense_id": "090e07ca-1bb4-368c-b5d8-99213db128c3",
                                "text": "Herr Gyger wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "bbcc3260-0cbb-40ad-a5b5-cd82285952bd",
                                "sense_id": "090e07ca-1bb4-368c-b5d8-99213db128c3",
                                "text": "Die Gygers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "4f06f24e-1af7-4685-8b69-fdcb734b53bf",
                                "sense_id": "090e07ca-1bb4-368c-b5d8-99213db128c3",
                                "text": "Der Gyger trägt nie die Schals, die die Gyger ihm strickt."
                            },
                            {
                                "example_id": "98dc677c-a9c3-4a77-889d-47a354b8637a",
                                "sense_id": "090e07ca-1bb4-368c-b5d8-99213db128c3",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gyger kommt, geht der Herr Ullrich.“"
                            },
                            {
                                "example_id": "007b9506-024d-41fb-936e-880e01bdb75a",
                                "sense_id": "090e07ca-1bb4-368c-b5d8-99213db128c3",
                                "text": "Gyger kommt und geht."
                            },
                            {
                                "example_id": "b982c3c2-c95d-453a-a982-bf9e36d331b2",
                                "sense_id": "090e07ca-1bb4-368c-b5d8-99213db128c3",
                                "text": "Gygers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
