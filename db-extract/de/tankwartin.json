                "senses": [
                    {
                        "sense_id": "ff991190-f678-38c0-ae56-951b42941031",
                        "entry_id": "a44eff72-79e3-36db-8b01-14c21305540c",
                        "glosses": [
                            "Beschäftigte einer Tankstelle, die die Zapfanlage bedient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee8c3ad8-334f-4caa-b612-426edae8b210",
                                "sense_id": "ff991190-f678-38c0-ae56-951b42941031",
                                "text": "Wir waren schon eine Weile hin- und hergefahren, bis uns eine Tankwartin endlich den richtigen Weg erklären konnte."
                            },
                            {
                                "example_id": "d69871ca-540d-406f-b231-0e9c1599904b",
                                "sense_id": "ff991190-f678-38c0-ae56-951b42941031",
                                "text": "„An einer Raststätte in Südtirol wollte er einen Schokoriegel kaufen und heiratete im Jahr darauf die Tochter der Tankwartin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82f3a6f2-4687-4e9d-ada9-8017333c298e",
                        "source_entry_id": "a44eff72-79e3-36db-8b01-14c21305540c",
                        "source_sense_id": "ff991190-f678-38c0-ae56-951b42941031",
                        "source_sense_description": "Beschäftigte einer Tankstelle, die die Zapfanlage bedient",
                        "target_lang_word": "pompiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pompiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb14753b-6560-32ee-9aff-83c13b5d15e5",
                                        "entry_id": "f3006178-db37-3dbb-adcf-196f97ca163b",
                                        "glosses": [
                                            "Technicien qui s’occupe d’une station de pompage et en contrôle le bon fonctionnement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70bef462-8b0a-4039-92b1-5618c07c1dcd",
                                                "sense_id": "cb14753b-6560-32ee-9aff-83c13b5d15e5",
                                                "text": "En général le pompiste est le seul membre du groupement qui ait le droit de manœuvre du groupe moto-pompe."
                                            },
                                            {
                                                "example_id": "523b14c6-39cb-4b1c-a852-b1d0cfc2cde3",
                                                "sense_id": "cb14753b-6560-32ee-9aff-83c13b5d15e5",
                                                "text": "En limitant la participation des usagers au fonctionnement de l'association et en mettant l'essentiel du pouvoir réel dans les mains des pompistes, les ingénieurs ont, de fait, gardé la haute main sur le marché de l'eau. En complicité directe avec les pompistes, ils sont en mesure de détourner une grande partie de ce que les paysans paient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2db7757-d60a-3908-9889-77586e74bdf0",
                                        "entry_id": "f3006178-db37-3dbb-adcf-196f97ca163b",
                                        "glosses": [
                                            "Ouvrier spécialisé qui manipule une pompe à béton."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "915d66f0-9c62-4b36-9b36-f1c5cda068b2",
                                                "sense_id": "b2db7757-d60a-3908-9889-77586e74bdf0",
                                                "text": "Dispositions d’organisation du chantier : un périmètre de sécurité doit être établi par le pompiste ; l’accès à l’intérieur de ce périmètre n’est possible qu’avec son accord."
                                            },
                                            {
                                                "example_id": "1b71dda1-cb26-4987-a543-6a50a24a9400",
                                                "sense_id": "b2db7757-d60a-3908-9889-77586e74bdf0",
                                                "text": "Lorsque le pompiste n'a pas de contrôle visuel, les dispositions nécessaires doivent être prises afin qu'une autre personne transmette les informations ou instructions nécessaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63291a65-b334-35b3-b722-edb815bb095d",
                                        "entry_id": "f3006178-db37-3dbb-adcf-196f97ca163b",
                                        "glosses": [
                                            "Commerçant ou employé qui s’occupe de la vente de carburants pour véhicules, dans une station-service."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2af8746a-8042-4431-8a8e-0a8666f4d96f",
                                                "sense_id": "63291a65-b334-35b3-b722-edb815bb095d",
                                                "text": "Si je devais rester avec eux, au départ de la station-service, je me retrouverais dans une situation plus compromettante, car je ne doutais pas que le pompiste alerterait la police, dès notre départ."
                                            },
                                            {
                                                "example_id": "26786d46-d088-4ee0-9996-2f49fac1c612",
                                                "sense_id": "63291a65-b334-35b3-b722-edb815bb095d",
                                                "text": "En voilà une installation, dit le pompiste après avoir introduit le pistolet dans le réservoir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
