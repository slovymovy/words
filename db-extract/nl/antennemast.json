                                    }
                                ]
                            },
                            {
                                "target_word": "mast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "103115b5-e128-3b09-8953-4d656d401191",
                                        "entry_id": "fcb28415-8759-3a7e-a031-f6ea013c1e18",
                                        "glosses": [
                                            "A type of heavy cue, with the broad end of which one strikes the ball."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20c0e2db-782f-4349-86d6-f67440bb2174",
                                                "sense_id": "103115b5-e128-3b09-8953-4d656d401191",
                                                "text": "Godfrey thus conquered, pretended to lose his temper, curs'd his own ill luck, swore that the table had a cast, and that the balls did not run true, changed his mast, and with great warmth challenged his enemy to double his sum."
                                            }
                                        ]
                                    }
