                "senses": [
                    {
                        "sense_id": "b99cb2e6-d15c-3949-b558-d78c8664e096",
                        "entry_id": "864dbe38-af6d-3f6b-a0f2-614e7d2b8190",
                        "glosses": [
                            "ein Land in Südostasien"
                        ],
                        "tags": [
                            "traditionelle Bezeichnung"
                        ],
                        "examples": [
                            {
                                "example_id": "5002158f-449b-4052-bdc0-0ca3f88fb091",
                                "sense_id": "b99cb2e6-d15c-3949-b558-d78c8664e096",
                                "text": "Mit vielen berühmten buddhistischen Statuen und ist Birma ein faszinierendes Land."
                            },
                            {
                                "example_id": "4d782d8f-31b8-48e9-a550-440e1b10e924",
                                "sense_id": "b99cb2e6-d15c-3949-b558-d78c8664e096",
                                "text": "Nach einer kurzen demokratischen Phase bis 1962 wurde Birma von verschiedenen Militärregimen kontrolliert."
                            },
                            {
                                "example_id": "b0a71f16-102f-49f2-8b5f-b1d8341aae53",
                                "sense_id": "b99cb2e6-d15c-3949-b558-d78c8664e096",
                                "text": "„In Birma, das damals noch zu Britisch-Indien gehörte, brach Anfang 1931 ein solcher Aufstand aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2c7d2e75-6785-40b5-963a-193711ada00e",
                        "source_entry_id": "864dbe38-af6d-3f6b-a0f2-614e7d2b8190",
                        "source_sense_id": "b99cb2e6-d15c-3949-b558-d78c8664e096",
                        "source_sense_description": "traditionelle Bezeichnung: ein Land in Südostasien",
                        "target_lang_word": "Burma",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Burma",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "476d5c5c-ab9e-3f9c-a7a4-74f98b9e9203",
                                        "entry_id": "1fe33f8d-123c-39f8-bd04-84cfb6568d11",
                                        "glosses": [
                                            "A country in Southeast Asia. Official name: Republic of the Union of Myanmar. Capital: Naypyidaw. Officially known as Myanmar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69781686-b6b4-4826-af07-c5ce515eb0bd",
                                                "sense_id": "476d5c5c-ab9e-3f9c-a7a4-74f98b9e9203",
                                                "text": "The province of Yunnan lies in the extreme southwest of the Empire, its southern and western borders forming the northern frontiers of Tongking and Burma respectively. On the north it is bordered by Szechuan, and on the east by Kweichau and Kwangsi. It is the third largest province of the Empire, its area measuring 122,000 square miles, but, as elsewhere remarked, owing to the devastatations^([sic – meaning devastations]) of the Mohammedan rebellion and ensuing plague, its population has been greatly reduced, and now is not more than 6,000,000. Yet its mineral wealth is greater and more varied than that of any other province. Its capital is Yunnan, between which town and Burma a considerable trade is carried on."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4f90627-c3c1-45f8-9dba-9871179452c3",
                        "source_entry_id": "864dbe38-af6d-3f6b-a0f2-614e7d2b8190",
                        "source_sense_id": "b99cb2e6-d15c-3949-b558-d78c8664e096",
                        "source_sense_description": "traditionelle Bezeichnung: ein Land in Südostasien",
                        "target_lang_word": "Birmanie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Birmanie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bac19ff5-e83f-3b0d-9b28-2a98c441ad5b",
                                        "entry_id": "2b2033b4-1f4d-36a2-8a42-c9d0febba188",
                                        "glosses": [
                                            "Pays d’Asie du Sud-Est bordé par le Bangladesh, l'Inde, la Chine, le Laos, la Thaïlande, la mer d’Andaman et le golfe du Bengale, et dont la capitale est Naypyidaw."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38e0ec24-4481-4334-a049-7e949c08f9cb",
                                                "sense_id": "bac19ff5-e83f-3b0d-9b28-2a98c441ad5b",
                                                "text": "Le gros des forces aériennes indo-britanniques périt dans la Birmanie sur un bûcher d’antagonistes embrasés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dacb82c4-5a33-4bb1-af6a-8442a9a211f4",
                        "source_entry_id": "864dbe38-af6d-3f6b-a0f2-614e7d2b8190",
                        "source_sense_id": "b99cb2e6-d15c-3949-b558-d78c8664e096",
