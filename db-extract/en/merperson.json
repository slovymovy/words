                    {
                        "translation_id": "98951470-9123-4d7c-95d0-2206bc141e22",
                        "source_entry_id": "1da2307f-4deb-3430-a313-3930456d9258",
                        "source_sense_id": "afed5c24-8583-362d-abd1-f1682c79b612",
