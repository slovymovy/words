                            {
                                "example_id": "7b9acf8e-d2ed-487e-8d3d-8cdf614ecf9a",
                                "sense_id": "7664e7f8-fd6e-3238-a840-6ba2b9cc73e2",
                                "text": "„Nach einer Mitteilung des Hofs seien bei ihm Untersuchungen wegen einer Gallenblasenentzündung notwendig geworden, berichtete die Staatsagentur SPA ohne weitere Angaben.“"
                            },
                            {
                                "example_id": "b3730b61-13c4-4e44-b1b0-429f1d8b992b",
                                "sense_id": "7664e7f8-fd6e-3238-a840-6ba2b9cc73e2",
                                "text": "„Der Arzt, den Frau Helena Lewicka holte, stellte eine akute Gallenblasenentzündung fest und empfahl strenge Diät.“"
                            }
                        ],
