                                "target_senses": [
                                    {
                                        "sense_id": "4d9b6b00-50a3-3506-9bd8-4780df4c7dfd",
                                        "entry_id": "ba47d188-e50b-3aaf-a72a-c8ab7796460e",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c98db520-eb90-4a67-b170-8d9dbace5ab0",
                                                "sense_id": "4d9b6b00-50a3-3506-9bd8-4780df4c7dfd",
                                                "text": "J'habite la voie lactée\n Tu es mon ami\n Je m'appelle Édith\n Je ne veux pas que tu me quittes."
                                            },
                                            {
                                                "example_id": "ed3a1988-cf30-4a2e-b088-8f3962e79a86",
                                                "sense_id": "4d9b6b00-50a3-3506-9bd8-4780df4c7dfd",
                                                "text": "Comme Édith Piaf, vous aussi vous vous en foutez du monde entier ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80f5670d-e57d-4db1-bdca-c4cb8f1eab63",
