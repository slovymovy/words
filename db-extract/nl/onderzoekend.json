                "senses": [
                    {
                        "sense_id": "a6bc91bf-5586-306a-8fb8-5d1fb8aced42",
                        "entry_id": "db306b68-f19a-3ad5-a82a-c8819d803da9",
                        "glosses": [
                            "gericht op het willen begrijpen van iets"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4460f64a-508c-4a41-8746-cb1107ae5323",
                                "sense_id": "a6bc91bf-5586-306a-8fb8-5d1fb8aced42",
                                "text": "Trump kan zelf bepalen welke informatie hij uit het onderzoek naar buiten wil brengen, hoewel de onderzoekende arts vandaag wel met een verklaring komt. Voordat hij verkozen werd, meldde zijn eigen arts dat Trump 'de gezondste persoon ooit was die wordt gekozen tot president'."
                            },
                            {
                                "example_id": "1b830778-ba02-40f3-a8e6-1c85c2981213",
                                "sense_id": "a6bc91bf-5586-306a-8fb8-5d1fb8aced42",
                                "text": "Alle namen en paspoortnummers van bezoekers worden geregistreerd. In de tuin lopen agenten in burger, mannen met onderzoekende blikken en nauwelijks zichtbare draadjes achter het oor."
                            }
                        ]
                    }
