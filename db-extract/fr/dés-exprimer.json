                ],
                "senses": [
                    {
                        "sense_id": "70e9daa0-bc78-3902-b9d9-759aad593dc6",
                        "entry_id": "47db76a0-0e8a-3465-adb0-57d0c72cef17",
                        "glosses": [
                            "Ne plus exprimer, faire en sorte que quelque chose ne soit plus exprimé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c1e92ed-70d5-4317-a9f5-699a700298a5",
                                "sense_id": "70e9daa0-bc78-3902-b9d9-759aad593dc6",
                                "text": "Dé-composer c’est sortir de l’expression, c’est dés-exprimer."
                            },
                            {
                                "example_id": "0b49ab0b-3fae-4e57-ae65-45d2dc050974",
                                "sense_id": "70e9daa0-bc78-3902-b9d9-759aad593dc6",
                                "text": "Le silence étant « la meilleure chose au monde » (Mackenzie, 71), Rhys s’applique à dés-exprimer les choses, à défaire la représentation, à découdre les liaisons symboliques, à entailler le discours des interstices du collage."
                            },
                            {
                                "example_id": "2993249c-0539-4a86-bb2c-e0a87d7c318e",
                                "sense_id": "70e9daa0-bc78-3902-b9d9-759aad593dc6",
                                "text": "Je propose d’inverser le processus : non pas exprimer l’Innommable, mais \"in-exprimer / dés-exprimer\" ce qui est déjà dit, déclaré, nommé, rapporté : une installation dans la masse du langage pour le dégraisser, le rendre à sa simplicité signifiante et questionnante."
                            }
                        ]
                    }
                ],
