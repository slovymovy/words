                            }
                        ]
                    },
                    {
                        "translation_id": "1e4bb97e-1122-4bb7-a6cf-bf21c4dba6e9",
                        "source_entry_id": "e97b2e5e-7ab7-328c-8a82-ea9dc2049287",
                        "target_lang_word": "grönländisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grönländisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "151597c7-e7c0-3911-9020-ebed488a205b",
                                        "entry_id": "32d72db4-0f8a-325c-a834-1d575cffffdc",
                                        "glosses": [
                                            "Grönland oder Grönländer betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a6d8e6e-c593-4b41-8e65-b5fb5284dda6",
                                                "sense_id": "151597c7-e7c0-3911-9020-ebed488a205b",
                                                "text": "Beim Treffen des Arktischen Rats im grönländischen Nuuk unterzeichneten die acht Außenminister, darunter US-Außenministerin Hillary Clinton und ihr russischer Kollege Sergej Lawrow, ein Abkommen über gemeinsame Rettungsaktionen bei Schiffs- und Flugzeugunglücken."
                                            },
                                            {
                                                "example_id": "5e290ce9-8a34-4ead-8ffe-626a61f5625f",
                                                "sense_id": "151597c7-e7c0-3911-9020-ebed488a205b",
                                                "text": "Geplant waren Untersuchungen zur Rotation der grönländischen Erdplatte im Paläozän und Eozän."
                                            },
                                            {
                                                "example_id": "e94c699e-d88e-406f-8adc-1839863b28b2",
                                                "sense_id": "151597c7-e7c0-3911-9020-ebed488a205b",
                                                "text": "… erzählt: »Das Knirschen und Krachen der grönländischen Gletscher: unvorstellbar, wenn man es nicht mit eigenen Augen wahrgenommen hat…«"
                                            },
                                            {
                                                "example_id": "7a98267d-a4ce-496a-a819-acf5c9b8b0e7",
                                                "sense_id": "151597c7-e7c0-3911-9020-ebed488a205b",
                                                "text": "Diese grönländische Elite, die an dänischen Hochschulen studierte, forderte ein grönländischeres Grönland und eine eigene grönländische Kollektividentität in Abgrenzung zur dänischen Kollektividentität."
