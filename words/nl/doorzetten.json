                        "doordrukken",
                        "volhouden"
                    ],
                    "antonyms": [
                        "opgeven"
                    ],
                    "common_phrases": [
                        "even doorzetten",
                        "een plan doorzetten"
                    ],
                    "target_lang_definitions": {
