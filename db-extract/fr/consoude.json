                "senses": [
                    {
                        "sense_id": "2f68264e-e30e-39cc-a784-76a16c1e1026",
                        "entry_id": "41f6a70f-6919-3d50-96a2-412e0e4c621b",
                        "glosses": [
                            "Plante de la famille des Boraginacées, dont une espèce, la grande consoude ou consoude officinale, est employée en médecine contre les hémorragies et les diarrhées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "644a0b97-3cd8-4460-a201-e8f77c4219d9",
                                "sense_id": "2f68264e-e30e-39cc-a784-76a16c1e1026",
                                "text": "Sirop de grande consoude."
                            },
                            {
                                "example_id": "d936828d-f4f1-4388-8e75-563b0bb604b4",
                                "sense_id": "2f68264e-e30e-39cc-a784-76a16c1e1026",
                                "text": "La consoude est une plante vivace à tiges rameuses, hérissées de poils raides, à feuilles rudes au toucher."
                            },
                            {
                                "example_id": "0fedfbd7-93d8-417a-a402-1c6f23dc120e",
                                "sense_id": "2f68264e-e30e-39cc-a784-76a16c1e1026",
                                "text": "Parce que l’industrie phytosanitaire s’acharne contre les préparations naturelles telles que la consoude ou le purin d’ortie, qui pourraient remplacer nombre d’engrais et de pesticides chimiques à moindre coût."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24223751-eeff-4d88-a685-653c8ae838aa",
                        "source_entry_id": "41f6a70f-6919-3d50-96a2-412e0e4c621b",
