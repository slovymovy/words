                                "sense_id": "c1b9f864-abb3-3b10-b360-7b2b6ca2e632",
                                "text": "Odzysk metali kolorowych z tego cacuszka jak najbardziej się opłaca."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "454da106-911d-33bc-909f-360f8cff2f5e",
                        "entry_id": "4d205ed2-c9a2-32db-97ae-7f82ad927386",
