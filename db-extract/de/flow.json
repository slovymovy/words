                                                "sense_id": "202638e6-f648-3eff-86d7-e81dfdcb8ee6",
                                                "text": "The notion of flow is basic to the study of ordinary differential equations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2f727e8-c535-3488-b9f3-c9b8a484e83d",
                                        "entry_id": "61016d52-5805-34e1-abc8-8f69c9808820",
