                ],
                "senses": [
                    {
                        "sense_id": "3fe346ee-515a-3bc3-8778-510c824ac64e",
                        "entry_id": "125945a9-c26e-32fe-879e-094f0583d48b",
                        "glosses": [
                            "Angehöriger des gleichnamigen antiken nomadisch lebenden Reitervolkes, das nördlich des Schwarzen Meeres siedelte"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "159a037e-0dd9-4f1e-92e9-e2250d731de5",
                                "sense_id": "3fe346ee-515a-3bc3-8778-510c824ac64e",
                                "text": "„Nach dem Feldzug des Perserkönigs Dareios I. gegen die Skythen in den Jahren 513 und 512 v. Chr. […] pflegten die Fürsten – wohl vorsorglich – gute Kontakte zu dem Großreich im Osten.“"
                            },
                            {
                                "example_id": "052fe6ed-d6a4-49be-b5a2-46df0b6aaaa2",
                                "sense_id": "3fe346ee-515a-3bc3-8778-510c824ac64e",
                                "text": "„Zwar verarbeiten die Skythen primär die Häute ihrer Nutztiere, aber in einigen Fällen scheuten sie offenbar nicht davor zurück, auch Menschenhaut zu verwenden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "32184fba-6d4a-48b6-b30e-3f44479aa91e",
                        "source_entry_id": "125945a9-c26e-32fe-879e-094f0583d48b",
                        "source_sense_id": "3fe346ee-515a-3bc3-8778-510c824ac64e",
                        "target_lang_word": "Scythian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Scythian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d7602c67-c2be-31c3-a530-d8f25b2de16a",
                                        "entry_id": "e21cb6cf-8ebc-36c8-82e6-8b19f7b7a1bc",
                                        "glosses": [
                                            "Of or relating to Scythia (a region of Central Eurasia in the classical era) or its inhabitants."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Scythian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6847cbd-3aca-3c11-84f0-a421a8518540",
                                        "entry_id": "0f0bdedb-df37-344b-9a5b-0dc9a0b500dd",
                                        "glosses": [
                                            "An inhabitant of Scythia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95fb2cd1-3d32-4773-891f-b9a8a510721a",
                                                "sense_id": "a6847cbd-3aca-3c11-84f0-a421a8518540",
                                                "text": "1685, John Norris, (translator), The Institution and Life of Cyrus the Great [Cyropaedia] by Xenophon Book I\nHow far he surpassed them all may be felt if we remember that no Scythian, although the Scythians are reckoned by their myriads, has ever succeeded in dominating a foreign nation […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Scythian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b4500d6-00e7-3bbd-aa02-dc169e08a659",
                                        "entry_id": "001d4496-db89-3da8-9a2c-fb5d67572071",
                                        "glosses": [
                                            "The Eastern Iranian language of Scythians."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d4457551-4bc6-33af-9196-d61da5157c85",
                                        "entry_id": "001d4496-db89-3da8-9a2c-fb5d67572071",
                                        "glosses": [
                                            "The Proto-Indo-European language."
                                        ],
                                        "tags": [
                                            "Indo-European-studies"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0368491c-14cd-4734-b044-21ecf7e7eac4",
                                                "sense_id": "d4457551-4bc6-33af-9196-d61da5157c85",
                                                "text": "Scythian was therefore not the same as modern Dutch, but the ancestral language of the Dutch as well as other neighbouring languages."
                                            },
                                            {
                                                "example_id": "8273bddb-7c19-4112-8ca5-530c39bc7dea",
                                                "sense_id": "d4457551-4bc6-33af-9196-d61da5157c85",
                                                "text": "Though Boxhorn was working over a century before Sir William Jones, his ‘Scythian’ is not conceptually far off the later notion of Indo-European, and his choice of term ‘Scythian’ shows that Boxhorn was envisaging a cultural connection between the (northern) languages of the Near East and their Western European brethren, a perspicacious hypothesis that assumend some kind of ethnic drift between the two continents."
                                            },
                                            {
                                                "example_id": "3fad3cfc-2684-4832-8da1-5fc4be133806",
                                                "sense_id": "d4457551-4bc6-33af-9196-d61da5157c85",
                                                "text": "From 1647 onwards, in several of his writings, Boxhorn elaborated the idea that Scythian was the original mother language of Persian, Greek, Latin, the Germanic languages, Turkish, Welsh, Lithuanian, Russian and Latvian (cf. Boxhorn 1647)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a75407a9-c21b-4960-bebd-464c9adb6fc5",
                        "source_entry_id": "125945a9-c26e-32fe-879e-094f0583d48b",
                        "source_sense_id": "3fe346ee-515a-3bc3-8778-510c824ac64e",
                        "target_lang_word": "Scythe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Scythe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "915daf5a-5219-3a1d-9c98-634e7a3f9311",
                                        "entry_id": "ce45c044-63f3-3f36-a66d-867cd2aa2e7c",
                                        "glosses": [
                                            "Peuple des bords de le mer Noire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "457d59bd-ba1b-4fd5-8ec6-feeccf7e658b",
                                                "sense_id": "915daf5a-5219-3a1d-9c98-634e7a3f9311",
                                                "text": "Celtes, Germains, Slaves m’apparurent comme des espèces de Scythes consciencieux, mais péniblement civilisés."
                                            },
                                            {
                                                "example_id": "25d2363e-5035-4a34-9673-9bf5d552529e",
                                                "sense_id": "915daf5a-5219-3a1d-9c98-634e7a3f9311",
                                                "text": "Les objets sculptés par les Scythes au VIIe siècle avant J.-C. (casques, épées, bijoux) font la joie d’un public de connaisseurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d87d0cd-be5b-3387-8e52-a85cfa9c3ca3",
                                        "entry_id": "ce45c044-63f3-3f36-a66d-867cd2aa2e7c",
                                        "glosses": [
                                            "Personne mal dégrossie, peu civilisée."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b788c5d3-1322-45af-b0be-db62b5130d28",
                                                "sense_id": "6d87d0cd-be5b-3387-8e52-a85cfa9c3ca3",
                                                "text": "Le Scythe, retourné dans sa triste demeure,\nPrend la serpe à son tour, coupe et taille à toute heure,\nConseille à ses voisins, prescrit à ses amis\nUn universel abattis."
                                            },
                                            {
                                                "example_id": "24fdb1e1-ea4b-4fcf-a747-4f2a9333d355",
                                                "sense_id": "6d87d0cd-be5b-3387-8e52-a85cfa9c3ca3",
                                                "text": "Alphonse Daudet le renseigna sur quelques tours de phrase, qu’il n’avait pas parfaitement saisis : « Je vis ici au milieu de Scythes, vous comprenez, Daudet ; il faut me pardonner »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
