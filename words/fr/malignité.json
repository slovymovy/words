            "senses": [
                {
                    "sense_id": "c2555332-d2f5-3e7e-8edf-7819090226f9",
                    "sense_definition": "Disposition à faire le mal ou à nuire à autrui, que ce soit par des actes ou des paroles malveillantes.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "malveillance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a répandu ces fausses rumeurs par pure <w>malignité</w> afin de détruire sa réputation."
                        },
                        {
                            "text": "Personne ne comprenait la <w>malignité</w> de ses propos envers des personnes pourtant bienveillantes."
                        }
                    ],
                    "synonyms": [
                        "méchanceté",
                        "malveillance",
                        "perfidie"
                    ],
                    "antonyms": [
                        "bonté",
                        "bienveillance"
                    ],
                    "common_phrases": [
