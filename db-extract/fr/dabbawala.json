                                        "entry_id": "b36d1e9b-ee52-39c1-86d6-d86375b1b299",
                                        "glosses": [
                                            "A deliveryperson in Mumbai, India who collects freshly cooked food in lunchboxes from workers' residences (mostly in the suburbs), delivers it to their respective workplaces, and returns the empty containers."
                                        ],
                                        "tags": [
                                            "India"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3ad6d9a-d279-4dee-954f-d0213e781e73",
                                                "sense_id": "3dc1826b-f55f-316a-964f-989e264791fc",
                                                "text": "“There is a service called FedEx that is similar to ours — but they don’t deliver lunch,” said one dabbawalla, Dhondu Kondaji Chowdhury."
                                            }
                                        ]
                                    }
                                ]
