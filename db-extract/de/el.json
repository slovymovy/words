                    {
                        "form_id": "8decce8f-a0ce-4f20-80f0-eb891d245720",
                        "entry_id": "3dcf2a3e-a59d-3d12-b122-4b092398aca1",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den El"
                    },
                    {
                        "form_id": "cc314c60-ee77-4158-b567-9e2408ac1d57",
                        "entry_id": "3dcf2a3e-a59d-3d12-b122-4b092398aca1",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Elim"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "94434de8-665b-32ee-90c9-c78ef50f6609",
                        "entry_id": "3dcf2a3e-a59d-3d12-b122-4b092398aca1",
                        "glosses": [
                            "bei einem Großteil der semitischen Völker (beispielsweise der vorisraelitischen kanaanäischen Bewohner Palästinas), Bezeichnung für die höchste Gottheit"
                        ],
                        "tags": [
                            "Theologie"
                        ],
                        "examples": [
                            {
                                "example_id": "3e1ecb68-1a61-4875-817f-18042dd39aba",
                                "sense_id": "94434de8-665b-32ee-90c9-c78ef50f6609",
                                "text": "„Die nächste Frage ist wohl, welcher Natur jener El, jener Gott sey, dessen Verkündiger und Diener zwar alle vorangehenden Gottheiten, zunächst aber und unmittelbar Kadmilos ist?“"
                            },
                            {
                                "example_id": "e4dd7da6-15ba-4bd7-9f3e-02728058f94f",
                                "sense_id": "94434de8-665b-32ee-90c9-c78ef50f6609",
                                "text": "„Der höchste Gott der semitischen Völker, der erste und bevorzugteste, führte den Namen El oder Il, was der Mächtige bedeutet¹.[…]Die Mitstreiter des El sind bei den Phönikiern die anderen Elohim genannten Götter; sie bilden gleichsam die Unterkönige im Götterkreise⁶. El blieb sogar später noch ein allgemein semitischer Gottesname, als die Hebräer gewöhnlich den Jehova darunter verstanden. Sie bezeichneten damit zuweilen auch den heidnisch-semitischen Gott⁷.“"
                            },
                            {
                                "example_id": "6cd209a0-2d62-4256-b503-314c01af2512",
                                "sense_id": "94434de8-665b-32ee-90c9-c78ef50f6609",
                                "text": "„Die Erinnerung daran, daß dies einst [Jahwe] gegenüber selbständige Götter waren, lebt außer in zornigen Bemerkungen des Jesaja gegen die Elim auch in den Namen einiger von ihnen und der offensichtlich nachträglichen Identifikation mit Jahwe fort.“"
                            },
                            {
                                "example_id": "3210da56-be8f-49c4-bd81-f09ad737d46e",
                                "sense_id": "94434de8-665b-32ee-90c9-c78ef50f6609",
                                "text": "„Die Worte [im Psalm] lauten so, als ob es andere Elim ausser Jahwe gäbe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c49611b6-4a7a-4506-801f-d3b4c48a3932",
                        "source_entry_id": "3dcf2a3e-a59d-3d12-b122-4b092398aca1",
                        "source_sense_id": "94434de8-665b-32ee-90c9-c78ef50f6609",
                        "source_sense_description": "bei einem Großteil der semitischen Völker: Bezeichnung für die höchste Gottheit",
                        "target_lang_word": "El",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "El",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bf94496d-b561-3f0f-a9d7-5c2120300e9f",
                                        "entry_id": "1b152372-b247-3539-9e67-34d6e15037f3",
                                        "glosses": [
                                            "Any of several major ancient Near East deities, including the supreme god of the Canaanite religion, but especially the supreme Hebrew God."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a31ffb8-3d56-425f-9d64-a134a7bcb251",
                                                "sense_id": "bf94496d-b561-3f0f-a9d7-5c2120300e9f",
                                                "text": "[…]who bared their brains to Heaven under the El and saw Mohammedan angels staggering on tenement roofs illuminated,[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "El",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "05df28b8-dd3b-3667-91b8-9661059e481b",
                                        "entry_id": "5ea18f61-e6b3-386b-85ef-06f34dd117ca",
                                        "glosses": [
                                            "Any one of several specific elevated railways."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5ca0a1b-c2fa-48c7-91be-a9ae7a800017",
                                                "sense_id": "05df28b8-dd3b-3667-91b8-9661059e481b",
                                                "text": "The Washington Street El was torn down in 1987."
                                            },
                                            {
                                                "example_id": "5e98901a-b70c-42c6-90bc-362689d6dbef",
                                                "sense_id": "05df28b8-dd3b-3667-91b8-9661059e481b",
                                                "text": "Known colloquially as the \"El,\" the elevated lines constituted the earliest attempt to remove urban passenger traffic from the streets."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "El",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76e78f85-158e-390b-a6ea-6a9c9423297c",
                                        "entry_id": "439e95dc-9e8a-3bb3-9aeb-9efa8b200335",
                                        "glosses": [
                                            "A unisex given name, often used as a nickname."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c060a6d8-ec9e-4d75-8dd0-e3afc4771ab8",
                                                "sense_id": "76e78f85-158e-390b-a6ea-6a9c9423297c",
                                                "text": "Ever since El Martinez started asking to be called by the gender-neutral pronouns “they/them” in the ninth grade, they have fielded skepticism in a variety of forms and from a multitude of sources about what it means to identify as nonbinary."
                                            }
                                        ]
                                    }
                                ]
                            }
