                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant cet hiver particulièrement rude, l'enfant souffrait de douloureuses <w>mules</w> aux pieds."
                        },
                        {
                            "text": "Le froid glacial lui a causé une <w>mule</w> persistante qui rend la marche pénible."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "terme vieilli"
                        }
                    ]
                }
            ]
