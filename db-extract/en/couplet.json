                                                "sense_id": "f1cf4c5e-f24a-3136-94ae-42481663cc96",
                                                "text": "„Allmählich unterschied er einen kräftigen Burschen mit Infanteriehosen und einer Matrosenbluse, der ein Couplet vortrug mit heiserer und besoffener Stimme, das sich nicht für zarte Ohren eignete.“"
                                            },
                                            {
                                                "example_id": "626361e6-622a-4231-b07d-b6bfaeadab25",
                                                "sense_id": "f1cf4c5e-f24a-3136-94ae-42481663cc96",
                                                "text": "„Der Vater benötigt zum Vortragen eines seiner Couplets eine überlange, bunte Weste.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
