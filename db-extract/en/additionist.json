                        "glosses": [
                            "One who supports or implements a policy of adding something."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "a202596c-34bb-427f-b948-1df42261547f",
                                "sense_id": "c058c362-9b08-3a68-bdde-b686266b2c7d",
                                "text": "They were additionists in the sense that all they wanted was to add to their heritage 'pure' education from the Europeans. And their traditional cultures were supposed to remain intact and uninterfered with."
                            },
                            {
                                "example_id": "ae59f8c2-2b69-4d8c-b3e3-dc68af04c8f7",
                                "sense_id": "c058c362-9b08-3a68-bdde-b686266b2c7d",
                                "text": "He was, he said, an \"additionist\"— the fellow who comes along after the historical accounts have been written and adds what's been (inadvertently or deliberately) left out."
                            }
                        ]
                    }
