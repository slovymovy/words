                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "563f7b40-0e90-4260-bf99-90651edef116",
                                                "sense_id": "5f5ab526-851d-3e16-8144-923e68e3c945",
                                                "text": "The British barges, off New-London, sometimes meet with the rubbers. In an attack upon an armed smack, some days ago, they were beaten off, with the reported loss of 8 men killed."
                                            },
                                            {
                                                "example_id": "0c1a7046-26fa-434c-b0c6-ad9b1dfb4099",
                                                "sense_id": "5f5ab526-851d-3e16-8144-923e68e3c945",
                                                "text": "'Twas a bit gone December, / As I well remember, / I met with a rubber, and got some advice; […]"
                                            }
                                        ]
                                    }
                                ]
