    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c3007b8d-d54d-3baf-9451-6e0ad59a7144",
                    "sense_definition": "Something such as a tradition, problem, or situation that exists now because of events or actions in the past.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "inheritance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The environmentalist left an enduring <w>legacy</w> of respect for the natural world.",
                            "target_lang_translations": {
                                "ru": "Эколог оставил после себя <w>наследие</w> в виде глубокого уважения к миру природы."
                            }
                        },
                        {
                            "text": "The new government is still struggling to overcome the bitter <w>legacy</w> of the previous regime.",
                            "target_lang_translations": {
                                "ru": "Новое правительство все еще пытается преодолеть горькое <w>наследие</w> предыдущего режима."
                            }
                        }
                    ],
                    "synonyms": [
                        "heritage"
                    ],
                    "common_phrases": [
                        "enduring legacy",
                        "bitter legacy",
                        "leave a legacy",
                        "lasting legacy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, например традиция, проблема или ситуация, существующая в настоящее время из-за событий или действий в прошлом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наследие",
                                "target_lang_sense_clarification": "культурное или историческое влияние прошлого"
                            },
                            {
                                "target_lang_word": "последствия",
                                "target_lang_sense_clarification": "результаты прошлых событий или режимов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cdc31429-d73b-3081-a4e5-6a04a9f80c51",
                    "sense_definition": "An amount of money or property that is left to someone in a will.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "inheritance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She received a substantial <w>legacy</w> from her aunt which allowed her to buy a house.",
                            "target_lang_translations": {
                                "ru": "Она получила значительное <w>наследство</w> от своей тети, что позволило ей купить дом."
                            }
                        },
                        {
                            "text": "The museum was founded thanks to a generous financial <w>legacy</w> from a local businessman.",
                            "target_lang_translations": {
                                "ru": "Музей был основан благодаря щедрому денежному <w>пожертвованию</w> по завещанию от местного бизнесмена."
                            }
                        }
                    ],
                    "synonyms": [
                        "heritage"
                    ],
                    "common_phrases": [
                        "substantial legacy",
                        "financial legacy",
                        "receive a legacy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сумма денег или имущество, оставленное кому-либо по завещанию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наследство",
                                "target_lang_sense_clarification": "имущество или деньги по завещанию"
                            },
                            {
                                "target_lang_word": "посмертный дар",
                                "target_lang_sense_clarification": "пожертвование по завещанию"
                            }
                        ]
