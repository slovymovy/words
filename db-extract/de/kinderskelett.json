                    {
                        "translation_id": "2c4c7f1b-15c2-48d5-9272-1366c6060502",
                        "source_entry_id": "a3faf69e-e52f-3b9e-b3b1-75437e08293a",
                        "source_sense_id": "bc13da09-9b4e-3948-b92b-918d37e8c78a",
