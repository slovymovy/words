                "senses": [
                    {
                        "sense_id": "343bbdd8-7898-301c-b91d-503745496ec5",
                        "entry_id": "2af5b987-3202-335c-80bf-ad5f5aa402ef",
                        "glosses": [
                            "Minderung der Gefährlichkeit giftiger Stoffe durch den Übergang von schädlichen, komplexeren zu einfacheren und weniger oder nicht mehr schädlichen Strukturen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01ca33d6-11a7-4b1b-9227-94ab9dc60524",
                                "sense_id": "343bbdd8-7898-301c-b91d-503745496ec5",
                                "text": "Die Verklappung von mit Schadstoffen belasteten Stoffen im Meer ist kein Schadstoffabbau, sondern eine billige Weiterleitung der eigenen Probleme an \"Mutter Natur\"!"
                            },
                            {
                                "example_id": "631b7e84-e3ba-42c3-8b45-4ebc3c3581de",
                                "sense_id": "343bbdd8-7898-301c-b91d-503745496ec5",
                                "text": "„Das Verfahren verbindet die Prozessschritte Pervaporation und photochemischen Schadstoffabbau in der Gasphase.“"
                            },
                            {
                                "example_id": "00a1e024-ec04-48b3-93c2-df712a3279c4",
                                "sense_id": "343bbdd8-7898-301c-b91d-503745496ec5",
                                "text": "„Dieses Verhältnis der beiden Isotope zueinander wird beim Isotopenmonitoring als Referenzwert zur Einschätzung des Schadstoffabbaus zugrunde gelegt.“"
                            },
                            {
                                "example_id": "b9c5f45c-83af-4616-b216-9278e0431412",
                                "sense_id": "343bbdd8-7898-301c-b91d-503745496ec5",
                                "text": "„Umfang und Geschwindigkeit des biologischen Schadstoffabbaus werden maßgeblich durch die chemisch-physikalischen Eigenschaften der Schadstoffe wie z.B. Wasserlöslichkeit und Molekülstruktur bestimmt.“"
                            },
                            {
                                "example_id": "1554ad91-b755-41c2-9c34-88da8834644b",
                                "sense_id": "343bbdd8-7898-301c-b91d-503745496ec5",
                                "text": "„Der Einsatz von Tensiden, sowohl chemischen als auch biologischen Ursprungs, kann den mikrobiellen Schadstoffabbau beschleunigen, ebenso gut aber auch inhibieren.“"
                            },
                            {
                                "example_id": "e338516a-828e-4f07-a436-b5eacf1be806",
                                "sense_id": "343bbdd8-7898-301c-b91d-503745496ec5",
                                "text": "„Im Forschungsschwerpunkt Schadstoffabbau wird an einem tieferen Verständnis der Elementarprozesse und Mechanismen der nicht-thermischen Plasmachemie gearbeitet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
