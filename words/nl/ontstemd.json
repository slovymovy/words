    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0b5f333a-9693-3708-a1fc-2ad0a866a812",
                    "sense_definition": "een gevoel van lichte boosheid of ontevredenheid ervarend",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De bewoners waren erg <w>ontstemd</w> over het plotselinge besluit van de gemeente.",
                            "target_lang_translations": {
                                "en": "The residents were very <w>displeased</w> about the municipality's sudden decision."
                            }
                        },
                        {
                            "text": "Hij reageerde zichtbaar <w>ontstemd</w> toen hij hoorde dat de afspraak niet doorging.",
                            "target_lang_translations": {
                                "en": "He reacted visibly <w>annoyed</w> when he heard that the appointment was cancelled."
                            }
                        }
                    ],
                    "synonyms": [
                        "geërgerd",
                        "gebelgd",
                        "ontevreden",
                        "geprikkeld",
                        "geïrriteerd"
                    ],
                    "antonyms": [
                        "tevreden",
                        "verheugd"
                    ],
                    "common_phrases": [
                        "zichtbaar ontstemd",
                        "erg ontstemd over"
                    ],
                    "target_lang_definitions": {
                        "en": "experiencing a feeling of slight anger or dissatisfaction"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "displeased",
                                "target_lang_sense_clarification": "feeling or showing annoyance"
                            },
                            {
                                "target_lang_word": "annoyed",
                                "target_lang_sense_clarification": "slightly angry"
                            },
                            {
                                "target_lang_word": "upset",
                                "target_lang_sense_clarification": "unhappy or disappointed"
                            },
                            {
                                "target_lang_word": "disgruntled",
                                "target_lang_sense_clarification": "angry or dissatisfied"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84fa1fad-1f65-3b06-9df4-dab02c0b622a",
                    "sense_definition": "gezegd van een muziekinstrument dat niet meer de juiste toonhoogte heeft",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "muziek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het was onmogelijk om op de <w>ontstemde</w> piano een mooi stuk te spelen.",
                            "target_lang_translations": {
                                "en": "It was impossible to play a beautiful piece on the <w>out-of-tune</w> piano."
                            }
                        },
                        {
                            "text": "Door de hoge luchtvochtigheid in de zaal raakte de gitaar volledig <w>ontstemd</w>.",
                            "target_lang_translations": {
                                "en": "Due to the high humidity in the hall, the guitar went completely <w>out of tune</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "vals"
                    ],
                    "antonyms": [
                        "zuiver",
                        "gestemd"
                    ],
                    "common_phrases": [
                        "een ontstemde piano"
                    ],
                    "target_lang_definitions": {
                        "en": "said of a musical instrument that no longer has the correct pitch"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "out of tune",
                                "target_lang_sense_clarification": "not at the correct pitch"
                            },
                            {
                                "target_lang_word": "untuned",
                                "target_lang_sense_clarification": "not tuned"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "88aa67b8-d318-3b90-8d6a-b6180ac93f9c",
                    "sense_definition": "voltooid deelwoord van <w>ontstemmen</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn botte opmerking heeft veel mensen in de zaal behoorlijk <w>ontstemd</w>.",
                            "target_lang_translations": {
                                "en": "His blunt remark has <w>upset</w> many people in the room considerably."
                            }
                        },
                        {
                            "text": "De plotselinge prijswijziging heeft de vaste klanten van de winkel <w>ontstemd</w>.",
                            "target_lang_translations": {
                                "en": "The sudden price change has <w>annoyed</w> the store's regular customers."
                            }
                        }
