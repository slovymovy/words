                "senses": [
                    {
                        "sense_id": "9638248a-56c3-3dd8-ad1f-c4c7a57e9151",
                        "entry_id": "17b4b7a1-2db4-32e3-a7e9-a1ff242d30f7",
                        "glosses": [
                            "Buchstabe, der allein oder in Kombination mit einem/mehreren anderen Buchstaben in der Schrift für einen oder mehrere konsonantische Laute/Phoneme steht"
                        ],
                        "tags": [
                            "Schriftlinguistik"
                        ],
                        "examples": [
                            {
                                "example_id": "d0a05dcc-a0ee-4b65-9897-87085dc04112",
                                "sense_id": "9638248a-56c3-3dd8-ad1f-c4c7a57e9151",
                                "text": "„Künftig sollen immer drei gleiche Konsonantenbuchstaben (Trigrapheme) geschrieben werden, ganz gleich, ob ein Vokal oder ein weiterer Konsonant folgt, ganz gleich, ob das Wort auf der Zeile steht oder von oberer Zeile zur unteren Zeile getrennt wird.“"
                            },
                            {
                                "example_id": "00709c60-f75f-4278-87ae-c7468a3d5402",
                                "sense_id": "9638248a-56c3-3dd8-ad1f-c4c7a57e9151",
                                "text": "„Bei den Konsonantenbuchstaben x bzw. z handelt es sich um Konsonantencluster der zwei Konsonantenphoneme /⁠k⁠/ und /⁠s⁠/ bzw. /⁠t⁠/ und /⁠s⁠/. “"
                            }
                        ],
