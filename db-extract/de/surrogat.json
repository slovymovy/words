                "senses": [
                    {
                        "sense_id": "5ef84d4d-709b-3798-bf1f-a9f2d4dd7aee",
                        "entry_id": "65cabd51-3f15-3af1-b46b-a69f9b9b63b0",
                        "glosses": [
                            "nicht vollwertiger Ersatzstoff, beispielsweise Malz oder Zichorie als Ersatz für „echten” Kaffee"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58b5e519-d499-4be4-b4cd-52ba317e8de0",
                                "sense_id": "5ef84d4d-709b-3798-bf1f-a9f2d4dd7aee",
                                "text": "Mit bestimmten Surrogaten lässt sich koffeinfreier Ersatzkaffee brauen."
                            },
                            {
                                "example_id": "8b7bbfdb-7833-4cee-9b28-0c436543bcc8",
                                "sense_id": "5ef84d4d-709b-3798-bf1f-a9f2d4dd7aee",
                                "text": "„Das bedeutet aber nicht, dass er sich ein ‚Lieschen am Herd‘ wünscht. Im Gegenteil: er verehrt stets intelligente, gebildete Frauen. Doch manche seiner Frauen-Aphorismen sind einfach nur platt: ‚Ein Weib ist manchmal ein ganz brauchbares Surrogat für die Selbstbefriedigung. Freilich gehört ein Übermass an Phantasie dazu‘.“"
                            },
                            {
                                "example_id": "7f0ac285-b85c-489e-9f58-f83b65e51167",
                                "sense_id": "5ef84d4d-709b-3798-bf1f-a9f2d4dd7aee",
                                "text": "„Vom Surrogat zum echten Buhlen war nur ein kleiner Schritt.“"
                            },
                            {
                                "example_id": "aaf4d083-2a4a-4514-82df-6ae9ee5f2363",
                                "sense_id": "5ef84d4d-709b-3798-bf1f-a9f2d4dd7aee",
                                "text": "„Weniger mit Surrogaten als mit unverdicktem Wasser hat der sächsische »Bliemchenkaffee« der ebenso dünnen Leipziger »Gose« , die zu den Bieren gerechnet wird, den Rang abgelaufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "147e933e-6ab7-37c4-82d9-7b76d3db0923",
                        "entry_id": "65cabd51-3f15-3af1-b46b-a69f9b9b63b0",
                        "glosses": [
                            "das an Stelle einer Sache bei Verlust, Veräußerung oder Zerstörung Erlangte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbbf048e-5e78-4b19-957c-c91358daa21d",
                                "sense_id": "147e933e-6ab7-37c4-82d9-7b76d3db0923",
                                "text": "Ein Surrogat schafft einen äquivalenten Ersatz, damit ist die Geldleistung der Vollkaskoversicherung Surrogat für das zerstörte Kraftfahrzeug."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "53db8983-0282-395c-9d63-69552f0dd40a",
                        "entry_id": "65cabd51-3f15-3af1-b46b-a69f9b9b63b0",
                        "glosses": [
                            "kurz für Surrogatschlüssel („Stellvertreterschlüssel“)"
                        ],
                        "tags": [
                            "Datenbanken"
                        ],
                        "examples": [
                            {
                                "example_id": "7160d1b6-1e7f-4b61-bb65-be3224ae7191",
                                "sense_id": "53db8983-0282-395c-9d63-69552f0dd40a",
                                "text": "„Generierte Schlüssel sind Schlüssel, deren Werte innerhalb der Datenbank mit einem Algorithmus bestimmt werden. Sie können danach als natürliche Schlüssel oder als Surrogat benutzt werden.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
