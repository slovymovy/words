                    {
                        "form_id": "a94076aa-1711-45c1-84a7-41ee5448dc9f",
                        "entry_id": "9e03c893-4385-3d62-bc2c-333269f9a9b9",
                        "tags": [
                            "masculine"
                        ],
                        "form": "soigneur"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9919d4ff-7aff-3bda-9bb6-c64fcae3f6f0",
                        "entry_id": "9e03c893-4385-3d62-bc2c-333269f9a9b9",
                        "glosses": [
                            "Femme qui donne des soins et s’occupe de l’état physique d’un sportif, en particulier un boxeur, un catcheur, un cycliste, un athlète."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d38a6a0c-d6df-3d17-aca0-75fb6b679d3d",
                        "entry_id": "9e03c893-4385-3d62-bc2c-333269f9a9b9",
                        "glosses": [
                            "Femme qui donne des soins et s'occupe de nourrir des animaux, en particulier dans les zoos."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3bd507f-71de-4e19-a303-f7113ec696b6",
                                "sense_id": "d38a6a0c-d6df-3d17-aca0-75fb6b679d3d",
                                "text": "Je fais régulièrement des prises de sang à Katia, une tigresse sujette à des crises d'épilepsie ; comme elle a très bonnes relations avec sa soigneuse et qu'elle est très confiante, je peux entrer avec la soigneuse dans la cage de soins."
                            },
                            {
                                "example_id": "b089d904-82ce-4dc8-a4eb-ecc41134c6b8",
                                "sense_id": "d38a6a0c-d6df-3d17-aca0-75fb6b679d3d",
                                "text": "S'occuper des animaux et de leur santé au quotidien dans un parc zoologique est le rôle des soigneurs et des soigneuses."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d35cc150-6c2c-4f96-9023-2abcb723a8ac",
                        "source_entry_id": "9e03c893-4385-3d62-bc2c-333269f9a9b9",
                        "source_sense_id": "9919d4ff-7aff-3bda-9bb6-c64fcae3f6f0",
                        "source_sense_description": "Femme qui donne des soins à un sportif",
                        "target_lang_word": "Betreuerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Betreuerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d762df69-0475-3bc8-9c8e-f647160f1a85",
                                        "entry_id": "b1877084-34cc-3af6-b5ce-04e2d14d3d46",
                                        "glosses": [
                                            "weibliche Person, die die Aufgabe hat, eine oder mehrere andere Personen zu begleiten, pflegen oder ihnen zu helfen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "554d2838-0767-4d21-98a8-fd3cbaabb5e5",
                                                "sense_id": "d762df69-0475-3bc8-9c8e-f647160f1a85",
                                                "text": "Den Erfolg unseres Unternehmens haben wir vor allem unseren Betreuerinnen in der Marketing-Abteilung zu verdanken."
                                            },
                                            {
                                                "example_id": "02498a31-30da-4d3f-bba5-f8f1390276ac",
                                                "sense_id": "d762df69-0475-3bc8-9c8e-f647160f1a85",
                                                "text": "„Als die Betreuerin auch Kratzspuren am Schloss mit Zahlencode entdeckte, informierte sie die Polizei.“"
                                            },
                                            {
                                                "example_id": "5d2fd524-f0ab-44d2-aa21-091c001d7e78",
                                                "sense_id": "d762df69-0475-3bc8-9c8e-f647160f1a85",
                                                "text": "„Hin und wieder besucht ihn eine Betreuerin.“"
                                            },
                                            {
                                                "example_id": "81923f5f-0542-4e19-a32c-b9bbb575522d",
                                                "sense_id": "d762df69-0475-3bc8-9c8e-f647160f1a85",
                                                "text": "Sie ist eine Betreuerin von mir."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bfbf4cc2-95d1-4667-95cc-c24521e461d8",
                        "source_entry_id": "9e03c893-4385-3d62-bc2c-333269f9a9b9",
                        "source_sense_id": "d38a6a0c-d6df-3d17-aca0-75fb6b679d3d",
                        "source_sense_description": "Femme qui donne des soins à des animaux",
                        "target_lang_word": "Wärterin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wärterin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d1ad2340-befb-3bd7-8162-cc4f9a0a6ae6",
                                        "entry_id": "2ca5ad57-9516-3ebe-80a5-abf68e6648fb",
                                        "glosses": [
                                            "weibliche Person, die etwas beaufsichtigt oder bewacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44031595-53f8-44d5-8d94-0af26ac3ae07",
                                                "sense_id": "d1ad2340-befb-3bd7-8162-cc4f9a0a6ae6",
                                                "text": "Die Wärterinnen waren alle eingeschlafen."
                                            },
                                            {
                                                "example_id": "c40264f9-b1ae-4dd8-8990-b2be7770ea03",
                                                "sense_id": "d1ad2340-befb-3bd7-8162-cc4f9a0a6ae6",
                                                "text": "„Einmal will die Wärterin für ihre illegalen Kurierdienste 800, mal 600 Euro g ihres Geliebten Informationen aus dem justizinternen EDV-System gezogen haben.“"
                                            },
                                            {
                                                "example_id": "0b9036d8-d77d-436d-bf65-97b9881e920f",
                                                "sense_id": "d1ad2340-befb-3bd7-8162-cc4f9a0a6ae6",
                                                "text": "„Die Affäre flog auf, weil andere Insassen die Wärterin anzeigten.“"
                                            },
                                            {
                                                "example_id": "04905a22-0533-494a-9644-87567e00b1ce",
                                                "sense_id": "d1ad2340-befb-3bd7-8162-cc4f9a0a6ae6",
                                                "text": "„Die Wärterin hat den Hut gerettet und marschiert nun auf ihren breiten Sohlen heran wie das Schicksal.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "052b82fa-0bd0-4809-81ff-d7627ed6fc8c",
                        "source_entry_id": "9e03c893-4385-3d62-bc2c-333269f9a9b9",
