    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "904121b4-a387-3154-bfb8-5f2a026c56b1",
                    "sense_definition": "Zaimek pytajny oznaczający <w>co</w>, używany dla podkreślenia emocji, zdziwienia lub zniecierpliwienia.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zaimek_pytajny",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Cóż</w> ty dzisiaj wyprawiasz?",
                            "target_lang_translations": {
                                "ru": "<w>Что же</w> ты сегодня вытворяешь?"
                            }
                        },
                        {
                            "text": "<w>Cóż</w> to za dziwny hałas?",
                            "target_lang_translations": {
                                "ru": "<w>Что же</w> это за странный шум?"
                            }
                        }
                    ],
                    "synonyms": [
                        "co"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вопросительное местоимение, означающее «что», используемое для выражения эмоций, удивления или нетерпения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "что же",
                                "target_lang_sense_clarification": "усилительное вопросительное слово"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49a572e3-2cff-35fc-86f2-a8e40d7759cb",
                    "sense_definition": "Zaimek wprowadzający pytania o orzeczniki, wyrażający silne emocje, zniecierpliwienie lub zdziwienie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zaimek_pytajny",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Cóż</w> nam dzisiaj przyniosłeś?",
                            "target_lang_translations": {
                                "ru": "<w>Что же</w> ты нам сегодня принес?"
                            }
                        },
                        {
                            "text": "<w>Czegóż</w> wam więcej trzeba?",
                            "target_lang_translations": {
                                "ru": "<w>Чего же</w> вам еще нужно?"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Местоимение, вводящее вопросы и выражающее сильные эмоции, нетерпение или удивление."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "что же",
                                "target_lang_sense_clarification": "эмоционально окрашенный вопрос"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4c591aa-e480-3c02-a2c0-6c98bf4b774a",
                    "sense_definition": "Zaimek tworzący pytania retoryczne, wyrażający silne emocje, zniecierpliwienie lub zdziwienie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "zaimek_pytajny",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Cóż</w> było robić w takiej sytuacji?",
                            "target_lang_translations": {
                                "ru": "<w>Что же</w> было делать в такой ситуации?"
                            }
                        },
                        {
                            "text": "<w>Czegoż</w> tam nie było na tym stole!",
                            "target_lang_translations": {
                                "ru": "<w>Чего же</w> там только не было на этом столе!"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Местоимение, используемое в риторических вопросах для выражения сильных эмоций."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "что же",
                                "target_lang_sense_clarification": "риторический вопрос"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54c3b665-b385-37ba-851e-e6b8e4c5ea53",
                    "sense_definition": "Zaimek używany w znaczeniu dlaczego, wyrażający silne emocje, zniecierpliwienie lub zdziwienie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "zaimek_pytajny",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Na</w> <w>cóż</w> nam to było potrzebne?",
                            "target_lang_translations": {
                                "ru": "<w>Зачем же</w> нам это было нужно?"
                            }
                        },
                        {
                            "text": "<w>Czemuż</w> tego wcześniej nie powiedziałeś?",
                            "target_lang_translations": {
                                "ru": "<w>Почему же</w> ты этого раньше не сказал?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "na cóż",
                        "po cóż"
                    ],
                    "target_lang_definitions": {
                        "ru": "Местоимение в значении «почему» или «зачем», выражающее сильные эмоции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зачем же",
                                "target_lang_sense_clarification": "вопрос о цели с оттенком эмоций"
                            },
                            {
                                "target_lang_word": "почему же",
                                "target_lang_sense_clarification": "вопрос о причине с оттенком эмоций"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "article",
            "senses": [
                {
                    "sense_id": "b57f9ce8-2622-3b31-954a-877765266268",
                    "sense_definition": "Partykuła wzmacniająca następujący komunikat, często o wydźwięku negatywnym lub rezygnującym.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "partykuła_emocjonalna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Cóż</w> nie mam dzisiaj innego wyjścia.",
                            "target_lang_translations": {
                                "ru": "<w>Ну что ж</w>, у меня сегодня нет другого выхода."
                            }
                        },
                        {
                            "text": "Nie wyszło ale <w>cóż</w> świat się nie skończył.",
                            "target_lang_translations": {
                                "ru": "Не получилось, но <w>что ж</w>, свет на этом клином не сошелся."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Частица, усиливающая высказывание, часто с оттенком смирения или негатива."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ну что ж",
                                "target_lang_sense_clarification": "выражение смирения или принятия ситуации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5092206-a3e4-3b83-9ad3-265fe163a4f6",
                    "sense_definition": "Partykuła wprowadzająca pytanie, znamionująca silne emocje, zniecierpliwienie lub zdziwienie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "partykuła_emocjonalna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Cóż</w> tak biegasz ciągle dookoła?",
                            "target_lang_translations": {
                                "ru": "<w>Что же</w> ты так бегаешь постоянно вокруг?"
                            }
                        },
                        {
                            "text": "<w>Cóżeście</w> tacy zdziwieni tą wiadomością?",
                            "target_lang_translations": {
                                "ru": "<w>Что же вы</w> так удивлены этой новостью?"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Частица, вводящая вопрос и выражающая сильные эмоции или удивление."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "что же",
                                "target_lang_sense_clarification": "эмоциональное усиление вопроса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df1a3fff-7d80-333b-9427-ef24b653a312",
                    "sense_definition": "Partykuła używana jako wtrącenie, odpowiednik słowa dobrze lub no.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "partykuła_emocjonalna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Cóż</w> chyba jednak nie przyjdzie na spotkanie.",
                            "target_lang_translations": {
                                "ru": "<w>Ну</w>, кажется, он все-таки не придет на встречу."
                            }
                        },
                        {
                            "text": "<w>Cóż</w> musimy zacząć od nowa.",
                            "target_lang_translations": {
                                "ru": "<w>Что ж</w>, нам придется начать сначала."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Частица, используемая как вводное слово, эквивалент «ну» или «хорошо»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ну",
                                "target_lang_sense_clarification": "вводное слово для перехода к мысли"
                            },
                            {
                                "target_lang_word": "что ж",
                                "target_lang_sense_clarification": "вводное слово для подведения итога"
                            }
                        ]
                    }
                }
            ]
        },
        {
