            "senses": [
                {
                    "sense_id": "f23cd90d-741f-3d7b-9382-c999a2cf5ffc",
                    "sense_definition": "Projet ou idéal qui paraît irréalisable ou chimérique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ideal_irrealisable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Penser que la pauvreté disparaîtra du jour au lendemain relève de la pure <w>utopie</w>."
                        },
                        {
                            "text": "Ce projet de ville sans voitures semblait être une <w>utopie</w>, mais il a finalement réussi."
                        }
                    ],
                    "synonyms": [
                        "chimère",
                        "illusion",
                        "rêve"
                    ],
                    "common_phrases": [
                        "pure utopie",
                        "douce utopie"
                    ]
                },
                {
                    "sense_id": "09dc4c17-b139-3f00-be42-efb2c7fe260e",
                    "sense_definition": "Modèle ou plan d'une société et d'un gouvernement idéaux et parfaits.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "societe_ideale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce philosophe a imaginé une véritable <w>utopie</w> politique où chacun partage équitablement les richesses."
                        },
                        {
                            "text": "Son livre décrit une <w>utopie</w> moderne où les technologies servent uniquement le bien-être de la population."
                        }
                    ],
                    "synonyms": [
                        "Eldorado"
                    ],
                    "antonyms": [
                        "contre-utopie",
                        "dystopie"
                    ],
                    "common_phrases": [
                        "utopie politique",
                        "utopie sociale"
                    ]
                },
                {
                    "sense_id": "efb25650-2c8a-3ac3-8354-25bde8973d2c",
                    "sense_definition": "Récit ou genre littéraire ayant pour cadre une société parfaite et harmonieuse.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "societe_ideale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>utopie</w> littéraire a connu un grand essor pendant la période de la Renaissance."
                        },
                        {
                            "text": "Le professeur a demandé aux étudiants de rédiger une <w>utopie</w> pour imaginer la société future."
                        }
                    ],
                    "antonyms": [
                        "contre-utopie",
                        "dystopie"
                    ]
                }
            ]
        }
