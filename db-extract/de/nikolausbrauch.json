                        "examples": [
                            {
                                "example_id": "0f65a2bd-b985-4cf9-a736-b1919998bfb8",
                                "sense_id": "e385bacd-b1e3-343e-902e-1cb913ab38c1",
                                "text": "Der Nikolausbrauch des Einlegens, bei dem der Nikolaus seine Gaben in die bereitgestellten Schuhe von Kindern legt, ist seit Beginn des 16. Jahrhunderts bekannt und entwickelte sich aus der Legende von den drei armen Jungfrauen, die durch ein Geschenk des Nikolaus vor der Prostitution bewahrt blieben."
                            },
                            {
                                "example_id": "5d6fb5a5-257b-4b38-aa43-fb011644a51e",
                                "sense_id": "e385bacd-b1e3-343e-902e-1cb913ab38c1",
                                "text": "„Und mit Nikolausbräuchen kannte er sich genauso wenig aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
