                                ]
                            },
                            {
                                "target_word": "abstractionniste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "769a4bd8-e9a6-3987-b729-5aaef262166e",
                                        "entry_id": "a78bd660-3835-368f-a644-b34078abdcf5",
                                        "glosses": [
                                            "Tenant de l’abstractionnisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7d739bb-8134-4990-a634-a31d34e71dae",
