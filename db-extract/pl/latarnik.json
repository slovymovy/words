                    {
                        "translation_id": "69f0b2f8-d194-4aa4-92bf-78e2a1a5e00e",
                        "source_entry_id": "0b87fb4a-68ca-3d80-93b3-cb756cde80a5",
                        "source_sense_id": "d3cbfe52-b807-3acf-b960-e021efe605f3",
                        "target_lang_word": "lighthousekeeper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lighthousekeeper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d95c2b9-98c7-366f-9351-3980d2adeccf",
                                        "entry_id": "111b8c91-9f8a-3022-89fd-71c380b19772",
                                        "glosses": [
                                            "Alternative form of lighthouse keeper."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72fd78cb-b571-49f4-aa86-507332095478",
                                                "sense_id": "3d95c2b9-98c7-366f-9351-3980d2adeccf",
                                                "text": "Because she was from the Alentejo, remarked the Lighthousekeeper's Wife, that's why she could do sopa alentejana."
                                            },
                                            {
                                                "example_id": "95b531b0-06bc-45fd-bef9-982101a86e71",
                                                "sense_id": "3d95c2b9-98c7-366f-9351-3980d2adeccf",
                                                "text": "After this sparkling gambit, Wilson tells Holmes he has taken up the job of lighthouse-keeper at Little-Tooting-by-the-Sea, which illuminates a passage between the mainland and the island of Uffa, [...]"
                                            },
                                            {
                                                "example_id": "5f0c5b91-8ed7-44d8-a368-36f24dfb690a",
                                                "sense_id": "3d95c2b9-98c7-366f-9351-3980d2adeccf",
                                                "text": "Lighthouse keeping is narrated by an orphan named Silver, who on the death of her parents is adopted by Pew, a blind lighthousekeeper in the imaginary Scottish town of Salts."
                                            },
                                            {
                                                "example_id": "ccb2d804-a9fe-4c1e-9fbc-e9b93a2cbb38",
                                                "sense_id": "3d95c2b9-98c7-366f-9351-3980d2adeccf",
                                                "text": "But I heroworship lighthousekeepers. No. Envy is closer. Or maybe jealousy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
