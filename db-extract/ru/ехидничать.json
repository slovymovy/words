                    },
                    {
                        "translation_id": "82669fc0-2450-499f-91cf-782cd98af606",
                        "source_entry_id": "a1ea0411-dd92-359e-b94a-acb854b7fbd2",
                        "source_sense_id": "1177b0f4-ceab-3ae9-9e33-4d5095aa7fa4",
                        "target_lang_word": "sticheln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sticheln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4397be88-f484-323c-b7a9-5b2bdc2764ca",
                                        "entry_id": "ab65eaa5-fe4a-3fc3-b410-006ead4683ae",
                                        "glosses": [
                                            "mit einem spitzen Instrument in etwas einstechen"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f633df9-c383-426f-a0fd-f026ddbb6ae6",
                                                "sense_id": "4397be88-f484-323c-b7a9-5b2bdc2764ca",
                                                "text": "„Meister Marks hatte kein Wort der Entgegnung, er stichelte so heftig mit der Nadel in seine Arbeit, daß man hätte meinen sollen, es stünde Einer mit der Peitsche hinter ihm.“ (1857)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "21de4be0-ac29-3f6a-bc77-c3f95b6bab3a",
                                        "entry_id": "ab65eaa5-fe4a-3fc3-b410-006ead4683ae",
                                        "glosses": [
                                            "jemanden durch Spitzen, spitze Bemerkungen oder boshafte Anspielungen verspotten und ärgern"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77fef11a-82e0-4032-80bc-1575837f227f",
                                                "sense_id": "21de4be0-ac29-3f6a-bc77-c3f95b6bab3a",
                                                "text": "Mein Bruder stichelte so lange gegen mich, bis ich ihm eine scheuerte. Dann war Ruhe!"
                                            },
                                            {
                                                "example_id": "7bb79a16-9c2e-4513-b61b-5158dabf4c11",
                                                "sense_id": "21de4be0-ac29-3f6a-bc77-c3f95b6bab3a",
                                                "text": "Deutsche sogenannte Fußballfans sticheln gerne gegen holländische und englische Mannschaften. Da sollten sie sich nach \"Leistungen\" deutscher Schützen in Elfmeterschießen lieber vorsehen."
                                            },
                                            {
                                                "example_id": "85f26290-5463-4560-8c93-b6da844b77db",
                                                "sense_id": "21de4be0-ac29-3f6a-bc77-c3f95b6bab3a",
                                                "text": "Rakitin hatte schon früher Pjiotr Iljitsch bei mir getroffen, und immer stichelte und stichelte er gegen ihn und brummte ihn wegen irgend etwas an."
                                            },
                                            {
                                                "example_id": "77bd4854-961f-416c-80a1-90841a5eb2bb",
                                                "sense_id": "21de4be0-ac29-3f6a-bc77-c3f95b6bab3a",
                                                "text": "„In weiteren ca. 80 Prozent der Fälle werden die Opfer“ [von Mobbing] „gestichelt und gehänselt oder als unfähig dargestellt.“"
                                            },
                                            {
                                                "example_id": "da134112-0453-4ab7-bbf1-aacd207679aa",
                                                "sense_id": "21de4be0-ac29-3f6a-bc77-c3f95b6bab3a",
                                                "text": "„»Die stärkste Macht der EU“ [Deutschland] „unterhält anscheinend eine Armee, die weder fahren noch fliegen noch schwimmen kann«, stichelte die renommierte \"Neue Zürcher Zeitung\".“"
                                            },
                                            {
