        "fr-extract.jsonl": [
            {
                "entry_id": "3969603e-b74e-3c57-a4e5-c279e3e8425d",
                "word": "Galopin",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2e6b8b9a-cd9e-30df-8619-488d9b5abfe7",
                        "entry_id": "3969603e-b74e-3c57-a4e5-c279e3e8425d",
                        "glosses": [
                            "Nom de famille, notamment connu par le romancier Arnould Galopin (1863-1934)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79431355-9b97-4156-ac9b-10f9320ac1c5",
                                "sense_id": "2e6b8b9a-cd9e-30df-8619-488d9b5abfe7",
                                "text": "Un peu plus tard, je dévorerai les récits d’Arnould Galopin, parus en feuilleton dans les années trente : Le Petit Chasseur de la Pampa et Le Petit Chasseur de panthères."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "27934001-d5c5-3979-bcea-e3e2aa65d0a5",
                "word": "galopin",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a9e2a0a9-8e45-45ca-8171-2d0ff4d2d4ff",
                        "entry_id": "27934001-d5c5-3979-bcea-e3e2aa65d0a5",
                        "tags": [
                            "plural"
                        ],
                        "form": "galopins"
                    },
                    {
                        "form_id": "6afe2150-0d7a-4c64-a95a-5173852448ed",
                        "entry_id": "27934001-d5c5-3979-bcea-e3e2aa65d0a5",
                        "tags": [
                            "feminine"
                        ],
                        "form": "galopine"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "970a131d-c349-32c0-80f2-abf2b1657a8b",
                        "entry_id": "27934001-d5c5-3979-bcea-e3e2aa65d0a5",
                        "glosses": [
                            "Jeune garçon employé dans un atelier pour faire différentes courses."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "b6ff6334-90ac-488f-bd3e-d24cab395794",
                                "sense_id": "970a131d-c349-32c0-80f2-abf2b1657a8b",
                                "text": "Renverrez-vous vos ouvriers ?… Mon avis est de laisser les choses comme elles sont, et d'avoir un galopin le plus tôt que vous pourrez ; car je regrette le temps perdu de Nicolas."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c6c498d-6e11-38e4-a5d3-a6eaaca7d920",
                        "entry_id": "27934001-d5c5-3979-bcea-e3e2aa65d0a5",
                        "glosses": [
                            "Petit garçon qui polissonne, principalement dans les rues."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a2f9410-a8a1-491b-9561-919749bf3110",
                                "sense_id": "2c6c498d-6e11-38e4-a5d3-a6eaaca7d920",
                                "text": "Invariablement les fonctionnaires, arrivés récemment ici des autres parties de la France, éprouvent de l’étonnement en voyant ces classes drues, ces hordes de galopins qui déambulent par les routes."
                            },
                            {
                                "example_id": "5ab29965-ad93-457d-afec-c51f597e9b9b",
                                "sense_id": "2c6c498d-6e11-38e4-a5d3-a6eaaca7d920",
                                "text": "Comme un seul homme, ils sautent sur leurs mobs et pèsent sur les pédales à grands coups de reins et de jarrets.\nIls n’ont qu’une idée, les petits galopins : déguerpir."
                            }
                        ]
                    },
                    {
                        "sense_id": "a9e156b7-a757-3176-b5ac-0d621c8108ad",
                        "entry_id": "27934001-d5c5-3979-bcea-e3e2aa65d0a5",
                        "glosses": [
                            "Petit garçon quelconque qui a donné un sujet de mécontentement."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "fdb89b53-5d77-43d6-b338-c4903da888f7",
                                "sense_id": "a9e156b7-a757-3176-b5ac-0d621c8108ad",
                                "text": "Mais il ne s’était résigné au désir d’Angèle qu’à la condition d’oublier au collège de Plassans leur fils Maxime, un galopin de onze ans, sur lequel sa grand-mère avait promis de veiller."
                            }
                        ]
                    },
                    {
                        "sense_id": "ed350844-f5db-394d-8b54-f41a8371733f",
                        "entry_id": "27934001-d5c5-3979-bcea-e3e2aa65d0a5",
                        "glosses": [
                            "Enfant (garçon ou fille)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4a653e2-eea6-4144-84d3-1457f4e2fad1",
                                "sense_id": "ed350844-f5db-394d-8b54-f41a8371733f",
                                "text": "Et il voyait clair, brusquement, il voyait la femme qu’elle était devenue, lorsque, du galopin sans sexe, s’était dégagée cette créature de charme et d’amour, avec ses jambes longues et fuselées, son torse élancé et fort, à la poitrine ronde, au cou rond, aux bras ronds et souples."
                            }
                        ]
                    },
                    {
                        "sense_id": "bed84556-a64d-348e-9095-4a466ec233d5",
                        "entry_id": "27934001-d5c5-3979-bcea-e3e2aa65d0a5",
                        "glosses": [
                            "Garçon qui sert dans les cuisines."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "eedc7893-ea7a-328a-87c4-75044761ffb1",
                        "entry_id": "27934001-d5c5-3979-bcea-e3e2aa65d0a5",
                        "glosses": [
                            "Moitié d’un demi de bière, soit 12,5 centilitres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23af7f50-0d24-46de-a891-264d00b6d859",
                                "sense_id": "eedc7893-ea7a-328a-87c4-75044761ffb1",
                                "text": "Le Balzar m’attirait ; je me rappelais que mon grand-père – mort depuis – m’y avait amené quelquefois, en 1913 : nous nous asseyions côte à côte sur la banquette, tout le monde nous regardait d’un air de connivence, il commandait un bock et, pour moi, un galopin de bière, je me sentais aimé. Donc, quinquagénaire et nostalgique, je poussais la porte de la brasserie et je me faisais servir un galopin."
                            }
                        ]
                    },
                    {
                        "sense_id": "9510606d-63fc-39d7-8c14-82bd793f0a9d",
                        "entry_id": "27934001-d5c5-3979-bcea-e3e2aa65d0a5",
                        "glosses": [
                            "Spécialité culinaire de la Picardie à base de brioche."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "33a0a66a-1110-4070-a592-372ebc5f394d",
                        "source_entry_id": "27934001-d5c5-3979-bcea-e3e2aa65d0a5",
                        "target_lang_word": "caddie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caddie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40a65820-4e9d-38b6-9296-ea3be7e557c8",
                                        "entry_id": "eacbbe50-e3d2-3fbd-a16a-bebcac2441d3",
                                        "glosses": [
                                            "Synonym of cadet (“a gentleman (often a younger son from a noble family) who joined the military without a commission as a career”)."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "also",
                                            "attributive",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b76af762-03cd-3fb6-a81a-74fe4220dc9a",
                                        "entry_id": "eacbbe50-e3d2-3fbd-a16a-bebcac2441d3",
                                        "glosses": [
                                            "A young man; a boy, a lad; specifically (derogatory), one regarded as of low social status; a ragamuffin."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "archaic",
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e06ad347-b442-4a00-8630-c29fac997719",
                                                "sense_id": "b76af762-03cd-3fb6-a81a-74fe4220dc9a",
                                                "text": "But gie him't het, my hearty cocks! / E'en cowe the cadie!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a411e3ed-b00b-3d03-8170-6f1004ba278e",
                                        "entry_id": "eacbbe50-e3d2-3fbd-a16a-bebcac2441d3",
                                        "glosses": [
                                            "A person engaged to run errands such as carrying goods and messages; a commissionaire, an errand boy or errand girl, a gofer; specifically, a member of an organized group of such persons working in large Scottish cities and towns in the early 18th century."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "broadly",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "225b500e-4168-415a-8daf-640c2e0bc319",
                                                "sense_id": "a411e3ed-b00b-3d03-8170-6f1004ba278e",
                                                "text": "A tattered cadie, or errand porter, whom David Deans had jostled in his attempt to extricate himself from the vicinity of the scorners, exclaimed in a strong north-country tone, \"Ta de'il ding out her Cameronian een—what gi'es her titles to dunch gentlemans about?\""
                                            },
                                            {
                                                "example_id": "bd715b45-df7b-49cf-b238-078f8c0b8374",
                                                "sense_id": "a411e3ed-b00b-3d03-8170-6f1004ba278e",
                                                "text": "There would be a prosperity such as might seem fabulous, a prosperity of which every Scotchman, from the peer to the cadie, would partake."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cb9f3a5-03d4-32af-872f-b32b31cd8e95",
                                        "entry_id": "eacbbe50-e3d2-3fbd-a16a-bebcac2441d3",
                                        "glosses": [
                                            "A person hired to assist a golfer by carrying their golf clubs and providing advice."
                                        ],
                                        "tags": [
                                            "also",
                                            "attributive",
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "766b7691-ed30-4e8e-bd74-3fa40270e48d",
                                                "sense_id": "7cb9f3a5-03d4-32af-872f-b32b31cd8e95",
                                                "text": "As caddy I had to carry the clubs, for there are four varieties almost everyone used, and some used more. Besides doing this, the caddy has to keep score of the number of strokes used, and watch and find each ball."
                                            },
                                            {
                                                "example_id": "ab9037bf-0e16-4a3a-bebb-404daa63fffa",
                                                "sense_id": "7cb9f3a5-03d4-32af-872f-b32b31cd8e95",
                                                "text": "Then Carter Chapman picked out his putter, stepped confidently up to the ball, sighted once along the ground, and made his stroke. The ball rolled straight as a die toward the caddy who was holding the flag, and tinkled into the cup for a birdie three!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "caddie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aeac9591-def6-31f1-9eec-c553c7cb06c5",
                                        "entry_id": "639cfc58-6088-3159-878f-bbf84a74e5c6",
                                        "glosses": [
                                            "Chiefly followed by for: to serve as a caddie (noun sense 2) for a golfer."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7a1926c-1d49-4675-9bcc-50f7d28cb421",
                                                "sense_id": "aeac9591-def6-31f1-9eec-c553c7cb06c5",
                                                "text": "We took turns caddying, one caddying, two playing. We went out across the river to the teeing ground of the first hole."
                                            },
                                            {
                                                "example_id": "88e7f996-325d-4019-a54f-16db8af6fe2a",
                                                "sense_id": "aeac9591-def6-31f1-9eec-c553c7cb06c5",
                                                "text": "The next day the thirty-two qualifying players were paired off into sixteen sets of opponents. Charlotte was matched against a girl from California. After the first few minutes, the result was never in doubt. \"Take it easy, miss,\" said the highly gratified Mr. Ogilvie, who was caddying for Charlotte. \"You hold her in the hollow of your hand.\""
                                            },
                                            {
                                                "example_id": "51b64d25-1ce2-43a9-bc26-027a262e5abd",
                                                "sense_id": "aeac9591-def6-31f1-9eec-c553c7cb06c5",
                                                "text": "The scheme had been, if I remember, that after lunch I should go off and caddy for Honoria on a shopping tour down Regent Street; but when she got up and started collecting me and the rest of her things, Aunt Agatha stopped her."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "caddie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d385802a-b71e-3fbd-8bdc-63cc33eb5cbd",
                                        "entry_id": "4082588d-f4a7-380d-92fb-d9d20023b513",
                                        "glosses": [
                                            "Alternative spelling of caddy."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7c88465e-93dc-465e-8f2a-5e45fb6c0d86",
