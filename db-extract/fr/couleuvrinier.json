                        "glosses": [
                            "Soldat chargé de manœuvrer les couleuvrines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "041c107a-15dd-419e-9fac-cb8395f0e54b",
                                "sense_id": "a22577aa-23bf-3de1-a87e-d5ded3b5e206",
                                "text": "Un couleuvrinier, natif de Lorraine et demeurant à Angers, avait été envoyé par le roi à Orléans où il recevait douze livres de solde par mois. Il avait nom Jean de Montesclère; tenu pour le meilleur maître qui fût alors de son métier, il gouvernait une grosse couleuvrine qui causait grand dommage aux Anglais."
                            },
                            {
                                "example_id": "f70a487e-4de5-45c8-8689-e19d5a83d180",
                                "sense_id": "a22577aa-23bf-3de1-a87e-d5ded3b5e206",
                                "text": "Autour des bâtards, les couleuvriniers, bien serrés et pareils à des écrevisses de fer, faisaient les cent pas."
                            }
                        ]
                    }
