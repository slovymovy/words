                        "sense_id": "e97b78bd-4173-3fa9-99e3-2148d76a9dca",
                        "entry_id": "02b7bc57-f8d5-3113-94a1-c2d928d7a458",
                        "glosses": [
                            "An antelope of either of the genera Gazella (mostly native to Africa), Procapra (native to Asia), Eudorcas, or Nanger, capable of running at high speeds for long periods."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba21da58-8f2f-422e-8de3-63e80304c875",
                                "sense_id": "e97b78bd-4173-3fa9-99e3-2148d76a9dca",
                                "text": "“One does not judge the gazelle by the lions that attack it,” replied Tarzan."
                            }
                        ]
                    }
                ],
