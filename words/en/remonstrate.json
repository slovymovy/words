{
    "word_family": [
        "remonstrance",
        "remonstrant",
        "remonstration",
        "remonstrative"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "66d2eeff-13c0-3a3e-9a09-492834b81b8b",
                    "sense_definition": "To make a forceful, disapproving protest, objection, or complaint.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "protest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry customer began to <w>remonstrate</w> with the manager about the poor service.",
                            "target_lang_translations": {
                                "zh": "愤怒的顾客开始就糟糕的服务向经理<w>抗议</w>。"
                            }
                        },
                        {
                            "text": "Several players ran over to <w>remonstrate</w> with the referee after the controversial red card.",
                            "target_lang_translations": {
                                "zh": "争议红牌出现后，几名球员跑过去向裁判<w>抗议</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "expostulate",
                        "demur"
                    ],
                    "common_phrases": [
                        "remonstrate with",
                        "remonstrate against"
                    ],
                    "target_lang_definitions": {
                        "zh": "抗议；抱怨；规劝；强烈反对"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "抗议",
                                "target_lang_sense_clarification": "对某事强烈反对或提出异议"
                            },
                            {
                                "target_lang_word": "规劝",
                                "target_lang_sense_clarification": "力争、劝诫某人"
                            },
                            {
                                "target_lang_word": "抱怨",
                                "target_lang_sense_clarification": "对不满之处进行交涉或发牢骚"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70f87322-d4b2-3b78-95df-8bbb50f6f23d",
                    "sense_definition": "To say or state something as an objection or protest.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "protest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "\"You cannot change the rules now,\" she <w>remonstrated</w> before walking out of the room.",
                            "target_lang_translations": {
                                "zh": "“你现在不能更改规则，”她在走出房间前<w>抗辩道</w>。"
                            }
                        },
                        {
                            "text": "He gently <w>remonstrated</w> that the budget was already stretched far beyond its limits.",
                            "target_lang_translations": {
                                "zh": "他温和地<w>反驳道</w>，预算早已远远超出了极限。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "抗辩道；反对说（用作引述动词）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "抗辩",
                                "target_lang_sense_clarification": "作为引述动词，表达反对或异议"
                            },
                            {
                                "target_lang_word": "反对说",
                                "target_lang_sense_clarification": "提出异议并说明原因"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3d1f2fe-c819-3668-b29e-0e19491c7acd",
                    "sense_definition": "To formally present or lodge an official objection or grievance, especially to a governing body or ruler.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "protest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The assembly chose to <w>remonstrate</w> to the crown regarding the newly imposed taxes.",
                            "target_lang_translations": {
                                "zh": "议会决定就新征税款向王室提出<w>进谏</w>。"
                            }
                        },
                        {
                            "text": "Representatives arrived at the court intending to <w>remonstrate</w> against the monarch's latest decrees.",
                            "target_lang_translations": {
                                "zh": "代表们来到宫廷，意欲就君主的最新法令提出<w>正式抗议</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used in historical or formal political contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（尤指正式向统治者或管理机构）进谏；正式抗议；上书陈情"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "进谏",
                                "target_lang_sense_clarification": "向君主、统治者或当局正式提出批评劝诫"
                            },
                            {
                                "target_lang_word": "上书抗议",
                                "target_lang_sense_clarification": "正式递交申诉或抗议书"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef32b5ad-c587-3673-804c-e55e07619f5d",
                    "sense_definition": "To point out, demonstrate, or make something plain and manifest.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scholar sought to <w>remonstrate</w> the truth of the ancient scripture to his listeners.",
                            "target_lang_translations": {
                                "zh": "这位学者试图向听众<w>阐明</w>古代经典的真实性。"
                            }
                        },
                        {
                            "text": "He attempted to <w>remonstrate</w> how the proposed strategy would inevitably lead to failure.",
                            "target_lang_translations": {
                                "zh": "他试图<w>指出</w>提议的策略将如何不可避免地导致失败。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Rarely used in this sense today"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指出；证明；使显明（现已罕用）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "证明",
                                "target_lang_sense_clarification": "指明、阐明事实或道理"
                            },
                            {
                                "target_lang_word": "指出",
                                "target_lang_sense_clarification": "明确说明、使显现"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}