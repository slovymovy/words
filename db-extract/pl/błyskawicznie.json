        "pl-extract.jsonl": [
            {
                "entry_id": "bcfe0573-3afc-326f-8336-6f613a490028",
                "word": "błyskawicznie",
                "pos": "adv",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2fe6501f-3f60-39f5-a1ee-e9af493c3d22",
                        "entry_id": "bcfe0573-3afc-326f-8336-6f613a490028",
                        "glosses": [
                            "bardzo szybko, prędko"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bd70202-aac6-462b-b394-b6ffee8d027f",
                                "sense_id": "2fe6501f-3f60-39f5-a1ee-e9af493c3d22",
                                "text": "Mały wąsik pod kulfoniastym nosem poruszył się na boki, a ręka poprawiła błyskawicznie monokl i wygładziła siwiejące baki. Szczupaczyńska dostrzegła, że łysinę zasłaniała pożyczka, finezyjna wprawdzie, lecz dalece niewystarczająca."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39183ef8-fe54-4259-b150-3f908cf468bc",
                        "source_entry_id": "bcfe0573-3afc-326f-8336-6f613a490028",
                        "source_sense_id": "2fe6501f-3f60-39f5-a1ee-e9af493c3d22",
                        "target_lang_word": "instantly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "instantly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "901039a3-7ce2-3caa-9db2-d11bee87b86c",
                                        "entry_id": "9fb7c001-3eed-33a8-b9db-d293bdb9b3fb",
                                        "glosses": [
                                            "At once; without delay."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7dbbe4fe-c6f4-4d73-bb8d-203e0763abac",
                                                "sense_id": "901039a3-7ce2-3caa-9db2-d11bee87b86c",
                                                "text": "When the neighbours' dog barked, ours instantly replied with a howl."
                                            },
                                            {
                                                "example_id": "4ae2c204-4ac7-453b-a208-b8fa6f357cb0",
                                                "sense_id": "901039a3-7ce2-3caa-9db2-d11bee87b86c",
                                                "text": "Then we relapsed into a discomfited silence, and wished we were anywhere else. But Miss Thorn relieved the situation by laughing aloud, and with such a hearty enjoyment that instead of getting angry and more mortified we began to laugh ourselves, and instantly felt better."
                                            },
                                            {
                                                "example_id": "9349c36a-fb4f-4761-9ef7-1856fe301210",
                                                "sense_id": "901039a3-7ce2-3caa-9db2-d11bee87b86c",
                                                "text": "The most persistent tormentor was Alex Oxlade-Chamberlain, who scored a hat-trick in last month’s corresponding fixture in Iceland. His ability to run at defences is instantly striking, but it is his clever use of possession that has persuaded some shrewd judges that he is an even better prospect than Theo Walcott."
                                            },
                                            {
                                                "example_id": "4611fc62-9406-4408-b923-401316f3da8d",
                                                "sense_id": "901039a3-7ce2-3caa-9db2-d11bee87b86c",
                                                "text": "But signalman Bridges was never to answer driver Gimbert's desperate question. A deafening, massive blast blew the wagon to shreds, the 44 high-explosive bombs exploding like simultaneous hits from the aircraft they should have been dropped from. The station was instantly reduced to bits of debris, and the line to a huge crater."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d369402-314a-3bdc-a4ed-a102d0fadc78",
                                        "entry_id": "9fb7c001-3eed-33a8-b9db-d293bdb9b3fb",
                                        "glosses": [
                                            "Urgently; with insistence."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "900f91af-61dd-45bd-9c78-ad26729c6bf4",
                                                "sense_id": "2d369402-314a-3bdc-a4ed-a102d0fadc78",
                                                "text": "Sir, my lord would instantly speak with you."
                                            },
                                            {
                                                "example_id": "9574b77c-f7a4-40d3-ba32-d95b887e5c23",
                                                "sense_id": "2d369402-314a-3bdc-a4ed-a102d0fadc78",
                                                "text": "Theoxena although she were instantly urged thereunto, could never be induced to marry againe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b35bb64-8168-3d4a-a57e-3a89f0152efe",
                                        "entry_id": "9fb7c001-3eed-33a8-b9db-d293bdb9b3fb",
                                        "glosses": [
                                            "At the same time."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c1356c6-5e50-4411-96be-d5838ecd66a6",
                                                "sense_id": "2b35bb64-8168-3d4a-a57e-3a89f0152efe",
                                                "text": "As if he mastred there a double spirit\nOf teaching, and of learning instantly"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "instantly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "882aa7d3-72cd-3f12-b068-859e7bea983a",
                                        "entry_id": "1d3ee2f0-128a-33c6-9729-7a16cb2c5e81",
                                        "glosses": [
                                            "As soon as, directly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a16a3c95-e0b6-4b96-a123-22ee09f61f59",
                                                "sense_id": "882aa7d3-72cd-3f12-b068-859e7bea983a",
                                                "text": "I phoned instantly I heard you were back."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8431290-c4c5-4d2d-8e1d-58c4ec422e24",
