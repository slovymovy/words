                    },
                    {
                        "form_id": "e3ee4f2f-2f02-4937-b70c-8e577aed8ee0",
                        "entry_id": "0cb6140d-c11f-3475-a160-ab78b3974af7",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "anarchistjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1f105ff8-b01f-383c-a377-dc0aabc5be61",
                        "entry_id": "0cb6140d-c11f-3475-a160-ab78b3974af7",
                        "glosses": [
                            "aanhanger van het anarchisme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa62c930-8c6f-4cf5-b3ea-6f2a13fb1263",
                                "sense_id": "1f105ff8-b01f-383c-a377-dc0aabc5be61",
                                "text": "Ze vroeg of ik het erg zou vinden als zij zich uitkleedde. Ik zei dat ze vooral moest doen wat ze niet kon laten. Ze begon zich uit te kleden en ik knikte haar bemoedigend toe. Een naakte anarchist en een oude communist in drie lagen. Maar ik vond het niet erg."
                            }
                        ]
                    },
                    {
                        "sense_id": "38551cae-91d8-3a3f-89fd-f2bb7686910c",
                        "entry_id": "0cb6140d-c11f-3475-a160-ab78b3974af7",
                        "glosses": [
                            "iemand die zich niet aan de algemeen geldende regels houdt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "922cd66f-9e23-4627-810d-e896a4e0b63f",
                                "sense_id": "38551cae-91d8-3a3f-89fd-f2bb7686910c",
                                "text": "Je kunt hem een excentrieke kunstenaar noemen, een anarchist, een oldskool-bohemien, die begin jaren zestig zijn homoseksualiteit exposeerde, terwijl de Engelse wet het nog verbood."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3811878a-8d32-48f0-a09f-2d73dfc9c8fc",
                        "source_entry_id": "0cb6140d-c11f-3475-a160-ab78b3974af7",
                        "target_lang_word": "Anarchist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anarchist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8cb4976a-c5b1-33de-bbc5-75126e749606",
                                        "entry_id": "423e857f-e24c-319a-bbb8-ee1b8d76bcac",
                                        "glosses": [
                                            "Vertreter oder Anhänger des Anarchismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8988ffe4-4914-45e3-a474-62ef59b13e87",
                                                "sense_id": "8cb4976a-c5b1-33de-bbc5-75126e749606",
                                                "text": "Ein Anarchist hat dem Zaren eine Bombe vor die Kutsche geworfen!"
                                            },
                                            {
                                                "example_id": "0b1431c9-8f6e-4506-9e4c-7fa278f1d9a7",
                                                "sense_id": "8cb4976a-c5b1-33de-bbc5-75126e749606",
                                                "text": "„Man hatte jüdische Anarchisten dieses Mordes bezichtigt (was jeder Grundlage entbehrte) und dadurch Wellen der blutigsten Pogrome in der Geschichte ausgelöst.“"
                                            },
                                            {
                                                "example_id": "9187b8c4-d03c-4965-856d-8897adae4511",
                                                "sense_id": "8cb4976a-c5b1-33de-bbc5-75126e749606",
                                                "text": "„Unter den Verhafteten war der Anarchist Erich Mühsam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4da2cfe-a82f-4743-9569-969221a11b21",
                        "source_entry_id": "0cb6140d-c11f-3475-a160-ab78b3974af7",
                        "target_lang_word": "anarchist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anarchist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0686eef8-8e61-3bc9-b985-c15101e61504",
                                        "entry_id": "b2c8e785-2aab-3fff-9592-cb493598876e",
                                        "glosses": [
                                            "One who believes in or advocates the absence of hierarchy and authority in most forms (compare anarchism), especially one who works toward the realization of such."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65835d05-f8e0-4ffe-bb19-8a436959238e",
                                                "sense_id": "0686eef8-8e61-3bc9-b985-c15101e61504",
                                                "text": "Eh bien ! vous êtes démocrate ? — Non. — Quoi ! vous seriez monarchique ? — Non. — Constitutionnel ? — Dieu m’en garde. — Vous êtes donc aristocrate ? — Point du tout. — Vous voulez un gouvernement mixte ? — Encore moins. — Qu’êtes-vous donc ? — Je suis anarchiste."
                                            },
                                            {
                                                "example_id": "09380134-69c7-44b7-b56a-29d6b924ef31",
                                                "sense_id": "0686eef8-8e61-3bc9-b985-c15101e61504",
                                                "text": "But nothing has revived anarchism like globalization. Anarchists are now battling what they see as a concentration of power in multinational corporations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "084634e7-6a79-3f85-bfe5-355e6021fd74",
                                        "entry_id": "b2c8e785-2aab-3fff-9592-cb493598876e",
                                        "glosses": [
                                            "One who disregards laws and social norms as a form of rebellion against authority."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ca5b168d-c90a-3bd7-9c36-a056098015c4",
                                        "entry_id": "b2c8e785-2aab-3fff-9592-cb493598876e",
                                        "glosses": [
                                            "One who promotes chaos and lawlessness."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43d9a1ea-42c8-4a64-97ea-b04114db1108",
                                                "sense_id": "ca5b168d-c90a-3bd7-9c36-a056098015c4",
                                                "text": "You have heard that Anarchists throw bombs, that they believe in violence, and that Anarchy means disorder and chaos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9760fa71-28f9-399e-89ed-3eb695f4907f",
                                        "entry_id": "b2c8e785-2aab-3fff-9592-cb493598876e",
                                        "glosses": [
                                            "One who resents outside control or influence on their life, in particular a government, and therefore desires the absence of political control."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "anarchist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9efce88-c4ec-303e-ace5-1eb90566cc61",
                                        "entry_id": "fcbe0200-f688-387d-9678-e0808558d242",
                                        "glosses": [
                                            "Relating to anarchism or to anarchists; anarchistic."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
