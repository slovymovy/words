                "senses": [
                    {
                        "sense_id": "f3fb9a45-f9ef-3aa2-9a53-374d9ffb8a65",
                        "entry_id": "42ceeb13-61e6-3324-aa2c-6748d2a8b3e5",
                        "glosses": [
                            "Être atteint d’érotomanie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "322845fd-9383-4f89-81fc-06c2c0134f73",
                                "sense_id": "f3fb9a45-f9ef-3aa2-9a53-374d9ffb8a65",
                                "text": "Poussons le bouchon : vous auriez donc une manière tout univoque de draguer, de baratiner, d’enlacer, d’embrasser, de rompre, d’érotomaniser, de divorcer, de fuir, de rencontrer, de faire l’amour, une manière tout univoque de vous positionner."
                            },
                            {
                                "example_id": "ed185c45-841b-4bfd-8376-482d789ffcbb",
                                "sense_id": "f3fb9a45-f9ef-3aa2-9a53-374d9ffb8a65",
                                "text": "Je ne sais pas si la vendeuse est amoureuse de moi ou si j'érotomanise, mais en tout cas l'accueil est très très sympa."
                            }
                        ]
                    }
