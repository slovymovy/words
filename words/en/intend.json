{
    "word_family": [
        "intention",
        "intentional",
        "intentionally",
        "intent",
        "intently",
        "unintentional",
        "unintentionally",
        "intended"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ca50dadd-0925-3196-ba22-088bbaebe5b7",
                    "sense_definition": "To have a plan or purpose in mind; to mean to do something.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "purpose",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>intends</w> to go to university after he finishes high school.",
                            "target_lang_translations": {
                                "ru": "Он <w>намеревается</w> поступить в университет после окончания школы."
                            }
                        },
                        {
                            "text": "I <w>intend</w> to finish this project by the end of the week.",
                            "target_lang_translations": {
                                "ru": "Я <w>собираюсь</w> закончить этот проект к концу недели."
                            }
                        }
                    ],
                    "synonyms": [
                        "mean",
                        "plan",
                        "propose",
                        "purpose"
                    ],
                    "common_phrases": [
                        "intend to finish",
                        "fully intend",
                        "originally intend"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь план или цель в уме; намереваться сделать что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "намереваться",
                                "target_lang_sense_clarification": "иметь замысел или желание совершить что-либо"
                            },
                            {
                                "target_lang_word": "собираться",
                                "target_lang_sense_clarification": "иметь намерение сделать что-либо в ближайшее время"
                            },
                            {
                                "target_lang_word": "планировать",
                                "target_lang_sense_clarification": "составлять план действий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "93775d3b-671c-3c2a-a834-3e510add017e",
                    "sense_definition": "To design or destine something for a particular purpose or person.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "design",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This gift was <w>intended</w> for your sister, not for you.",
                            "target_lang_translations": {
                                "ru": "Этот подарок <w>предназначался</w> для твоей сестры, а не для тебя."
                            }
                        },
                        {
                            "text": "The new law is <w>intended</w> for use in emergency situations only.",
                            "target_lang_translations": {
                                "ru": "Новый закон <w>предназначен</w> для использования только в чрезвычайных ситуациях."
                            }
                        }
                    ],
                    "synonyms": [
                        "design"
                    ],
                    "common_phrases": [
                        "intended for use",
                        "originally intended for"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предназначать что-либо для определенной цели или человека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предназначаться",
                                "target_lang_sense_clarification": "быть предназначенным для кого-то или чего-то"
                            },
                            {
                                "target_lang_word": "планироваться",
                                "target_lang_sense_clarification": "быть задуманным для определенного использования"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a8b69ac-0bf9-30c2-a96f-5012ad3d0474",
                    "sense_definition": "To take care of or supervise something; to attend to.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "supervise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager must <w>intend</w> the daily operations of the factory.",
                            "target_lang_translations": {
                                "ru": "Менеджер должен <w>надзирать</w> за повседневной деятельностью завода."
                            }
                        },
                        {
                            "text": "He was hired to <w>intend</w> the gardens while the owners were away.",
                            "target_lang_translations": {
                                "ru": "Его наняли <w>присматривать</w> за садами, пока владельцы были в отъезде."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заботиться о чем-либо или надзирать; присматривать за чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "надзирать",
                                "target_lang_sense_clarification": "осуществлять надзор или руководство"
                            },
                            {
                                "target_lang_word": "присматривать",
                                "target_lang_sense_clarification": "заботиться или наблюдать за порядком"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "620004ed-1bf1-319f-8da9-5c6e5cd3ee27",
                    "sense_definition": "To stretch out or extend; to make tense.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "stretch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The muscles <w>intend</w> as the athlete prepares for the sprint.",
                            "target_lang_translations": {
                                "ru": "Мышцы <w>напрягаются</w>, когда атлет готовится к спринту."
                            }
                        },
                        {
                            "text": "The surgeon had to <w>intend</w> the skin carefully during the procedure.",
                            "target_lang_translations": {
                                "ru": "Хирургу пришлось осторожно <w>растянуть</w> кожу во время процедуры."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "related to the Latin root meaning to stretch"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Растягивать или расширять; приводить в напряжение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напрягать",
                                "target_lang_sense_clarification": "делать натянутым или тугим"
                            },
                            {
                                "target_lang_word": "растягивать",
                                "target_lang_sense_clarification": "увеличивать в длину или ширину"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9a2323c-c6b7-3fd3-bc88-0ee0676ccbbf",
                    "sense_definition": "To pretend, simulate, or counterfeit.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pretend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spy would <w>intend</w> a foreign accent to hide his true identity.",
                            "target_lang_translations": {
                                "ru": "Шпион <w>имитировал</w> иностранный акцент, чтобы скрыть свою истинную личность."
                            }
                        },
                        {
                            "text": "She did not feel ill but chose to <w>intend</w> a headache to leave early.",
                            "target_lang_translations": {
                                "ru": "Она не чувствовала себя больной, но решила <w>притвориться</w>, что у неё болит голова, чтобы уйти пораньше."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "no longer used in this sense"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Притворяться, симулировать или подделывать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "притворяться",
                                "target_lang_sense_clarification": "создавать ложное впечатление"
                            },
                            {
                                "target_lang_word": "симулировать",
                                "target_lang_sense_clarification": "прикидываться кем-либо или имитировать состояние"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}