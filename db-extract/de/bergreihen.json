                "senses": [
                    {
                        "sense_id": "897348c1-ed3e-3c49-bc7b-1a580a71bb43",
                        "entry_id": "6b138f0f-06a9-3f45-ae0b-b729059f6e56",
                        "glosses": [
                            "Volkslieder der Bergleute aus dem 16. bis 18. Jahrhundert, die diese öffentlich auf Märkten, Jahrmärkten etc. vortrugen. Bergreihen waren vor allem in Böhmen, der Steiermark und im Erzgebirge verbreitet."
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "65de0b77-18c6-44f1-9ee7-7294cf8621da",
                                "sense_id": "897348c1-ed3e-3c49-bc7b-1a580a71bb43",
                                "text": "\"Vor allem in wirtschaftlichen Krisenzeiten waren Bergleute gezwungen, als wandernde Bergreyer (nach Johann Fischart, 1572) oder „Bergsinger“ ihren Lebensunterhalt zu verdienen. Sie trugen ihre Lieder, die Bergreihen, auf Messen in Städten und Dörfern der Bergbauregionen vor.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
