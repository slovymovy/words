{
    "word_family": [
        "funereal",
        "funerary"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "df65c748-87c9-3a2e-b07b-6de657f1bb5d",
                    "sense_definition": "A ceremony to honor and remember a deceased person, often distinguished from a memorial service by the presence of the body.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ceremony",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many friends and family members gathered for the <w>funeral</w> to say their last goodbyes.",
                            "target_lang_translations": {
                                "ru": "Многие друзья и члены семьи собрались на <w>похороны</w>, чтобы проститься в последний раз.",
                                "zh": "许多亲友聚集在<w>葬礼</w>上，做最后的告别。"
                            }
                        },
                        {
                            "text": "The <w>funeral</w> service was held at the local church on a rainy afternoon.",
                            "target_lang_translations": {
                                "ru": "Церемония <w>похорон</w> состоялась в местной церкви дождливым днем.",
                                "zh": "在一个下雨的午后，当地教堂举行了<w>葬礼</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "burial",
                        "interment"
                    ],
                    "common_phrases": [
                        "funeral service",
                        "state funeral",
                        "funeral home",
                        "funeral procession",
                        "attend a funeral"
                    ],
                    "target_lang_definitions": {
                        "ru": "Церемония прощания с умершим человеком перед погребением или кремацией.",
                        "zh": "为纪念逝者而举行的仪式，通常指有遗体在场的告别仪式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "похороны",
                                "target_lang_sense_clarification": "церемония прощания и захоронения"
                            },
                            {
                                "target_lang_word": "погребение",
                                "target_lang_sense_clarification": "процесс предания тела земле; более формальный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "葬礼",
                                "target_lang_sense_clarification": "指为逝者举行的正式告别仪式"
                            },
                            {
                                "target_lang_word": "出殡",
                                "target_lang_sense_clarification": "指将灵柩送往墓地或火葬场的仪式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "272ba5b9-e2ff-3a5c-8387-ee7471d5f11d",
                    "sense_definition": "A funeral sermon.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sermon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The minister delivered a solemn <w>funeral</w> that comforted the grieving congregation.",
                            "target_lang_translations": {
                                "ru": "Священник произнес торжественную <w>надгробную проповедь</w>, которая утешила скорбящих прихожан.",
                                "zh": "牧师发表了一篇庄重的<w>悼词</w>，安慰了悲痛的会众。"
                            }
                        },
                        {
                            "text": "He published the <w>funeral</w> he had written for the late duke.",
                            "target_lang_translations": {
                                "ru": "Он опубликовал <w>надгробную речь</w>, которую написал для покойного герцога.",
                                "zh": "他发表了为已故公爵所写的<w>悼词</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sermon",
                        "eulogy"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Modern English typically uses 'eulogy' or 'funeral sermon' instead."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проповедь или речь, произносимая во время похоронной церемонии.",
                        "zh": "在葬礼上发表的悼词或布道。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "надгробная проповедь",
                                "target_lang_sense_clarification": "речь священнослужителя"
                            },
                            {
                                "target_lang_word": "надгробная речь",
                                "target_lang_sense_clarification": "торжественная речь в память об умершем"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "悼词",
                                "target_lang_sense_clarification": "在葬礼上对逝者表示哀悼的演讲"
                            },
                            {
                                "target_lang_word": "葬礼布道",
                                "target_lang_sense_clarification": "葬礼上由宗教人士发表的讲道"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6c07c695-0466-35bf-82ed-a285b8372b3d",
                    "sense_definition": "Alternative spelling of <w>funereal</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gloomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The procession moved through the streets at a slow, <w>funeral</w> pace.",
                            "target_lang_translations": {
                                "ru": "Процессия двигалась по улицам медленным, <w>похоронным</w> шагом.",
                                "zh": "队伍以缓慢而<w>阴沉的</w>步伐穿过街道。"
                            }
                        },
                        {
                            "text": "A <w>funeral</w> gloom settled over the house after the tragic news arrived.",
                            "target_lang_translations": {
                                "ru": "<w>Похоронный</w> мрак опустился на дом после того, как пришли трагические новости.",
                                "zh": "悲剧消息传来后，整个房子笼罩在<w>哀伤的</w>阴霾中。"
                            }
                        }
                    ],
                    "synonyms": [
                        "funereal",
                        "gloomy",
                        "somber",
                        "dismal"
                    ],
                    "antonyms": [
                        "cheerful",
                        "festive"
                    ],
                    "common_phrases": [
                        "funeral pace"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мрачный, печальный; напоминающий атмосферу похорон.",
                        "zh": "形容像葬礼一样阴沉、悲伤或缓慢的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "похоронный",
                                "target_lang_sense_clarification": "напоминающий похороны; очень медленный или мрачный"
                            },
                            {
                                "target_lang_word": "траурный",
                                "target_lang_sense_clarification": "скорбный, выражающий печаль"
                            },
                            {
                                "target_lang_word": "мрачный",
                                "target_lang_sense_clarification": "темный, унылый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阴沉的",
                                "target_lang_sense_clarification": "形容气氛压抑、不愉快"
                            },
                            {
                                "target_lang_word": "哀伤的",
                                "target_lang_sense_clarification": "形容带有悲痛或葬礼般的氛围"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}