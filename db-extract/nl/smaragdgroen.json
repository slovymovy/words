                                    {
                                        "sense_id": "47cf2987-9a4a-3a5b-9a8b-4ce97e09c988",
                                        "entry_id": "cc5b31b5-62bd-300d-805b-78e3160e54b5",
                                        "glosses": [
                                            "D’une teinte de vert bleuté un peu foncé, possiblement transparent, couleur de l’émeraude. #1E865B"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8078ffc6-d848-449f-b64d-37672524800d",
                                                "sense_id": "47cf2987-9a4a-3a5b-9a8b-4ce97e09c988",
                                                "text": "Mlahfa violettes, vert émeraude, rose vif, jaune citron, grenat, bleu de ciel, orange, rouges ou blanches brodées de fleurs et d’étoiles multicolores… Têtes coiffées du lourd édifice de la coiffure saharienne, composée de tresses, de mains d’or ou d’argent, de chaînettes, de petits miroirs et d’amulettes, ou couronnées de diadèmes ornés de plumes noires. Tout cela passe, chatoie au soleil, les groupes se forment et se déforment en un arc-en-ciel sans cesse changeant, comme des essaims de papillons charmants."
                                            },
                                            {
                                                "example_id": "84e1d67a-fe7f-4716-a517-23e07040449c",
                                                "sense_id": "47cf2987-9a4a-3a5b-9a8b-4ce97e09c988",
                                                "text": "Les oiseaux aussi me paraissent particulièrement gentils et familiers. Voici, posé au bord du champ, le joli « mangeur d’abeilles » tout vert émeraude (Merops viridis), qui se transforme en un petit nuage bronzé au moment où il s’envole, […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vert émeraude",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "151a0205-b7bd-3852-89d5-452ef9bd0b79",
                                        "entry_id": "b99a6cba-e29c-3f71-b88c-7664298af808",
                                        "glosses": [
                                            "Teinte de vert bleuté un peu foncé, possiblement transparent, couleur de l’émeraude. #1E865B"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fea0499d-b4c5-4af3-8783-cc4652ef3e3e",
                                                "sense_id": "151a0205-b7bd-3852-89d5-452ef9bd0b79",
                                                "text": "Tons alpestres dans les montagnes : sur frottis de noir, blanc et bleu de Prusse, quelques tons de vert émeraude fin et blanc, ou le ton de vert émeraude, bleu de Prusse et blanc. Mettre du rose dans les tons très lointains."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
