                        "glosses": [
                            "deel van een gebouw dat direct onder het dak ligt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "147ec877-af4d-4fe9-8944-89e75c06b1cc",
                                "sense_id": "26941116-f1d6-3797-95ab-c883005df3a6",
                                "text": "Een kind dat op de zolder lag te slapen, ontdekte de brand en alarmeerde zijn moeder. Vanwege de sterke rookontwikkeling zijn beiden ter observatie meegenomen naar het ziekenhuis. Volgens een woordvoerder van de brandweer bleef de schade van de brand beperkt tot de zolderverdieping en was het vuur snel onder controle."
                            },
                            {
                                "example_id": "733f6367-0bd5-4827-8af6-bee06c101d26",
                                "sense_id": "26941116-f1d6-3797-95ab-c883005df3a6",
                                "text": "Een paar jaar geleden trok hij op de zolderverdieping boven De Duitse Keizer in."
                            }
                        ]
                    }
                ],
