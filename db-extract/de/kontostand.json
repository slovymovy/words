                                        "glosses": [
                                            "To make (concepts) agree."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d2d41b6-7097-4572-9387-358c4415911e",
                                                "sense_id": "e0e42967-a489-3cb0-bbbd-49392da7e386",
                                                "text": "the Proteus Principle helps to qualify and balance the concepts of narrators and of narrative situations as previously developed in classical studies by G erard Genette and Franz Stanzel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2202865a-4275-31d6-a4d5-c99041b1588b",
                                        "entry_id": "1d99375d-fb2a-337d-be24-a066e2434c9a",
                                        "glosses": [
                                            "To hold (an object or objects) precariously; to support on a narrow base, so as to keep from falling."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "930b6f8d-e73a-455a-a90f-6e08f6db8742",
                                                "sense_id": "2202865a-4275-31d6-a4d5-c99041b1588b",
                                                "text": "I balanced my mug of coffee on my knee."
                                            },
                                            {
                                                "example_id": "e00e926f-a07d-4a92-bb57-43af12ddf38e",
                                                "sense_id": "2202865a-4275-31d6-a4d5-c99041b1588b",
                                                "text": "The circus performer balances a plate on the end of a baton."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7759ca57-d736-36d3-8f97-47251b2b4c83",
                                        "entry_id": "1d99375d-fb2a-337d-be24-a066e2434c9a",
                                        "glosses": [
                                            "To compare in relative force, importance, value, etc.; to estimate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b131851-8bf8-4af0-8e2c-55053a185164",
                                                "sense_id": "7759ca57-d736-36d3-8f97-47251b2b4c83",
                                                "text": "Ballance the Good and Evil of Things."
                                            },
                                            {
                                                "example_id": "083f2cea-0206-4609-9d7c-24a2957afbaf",
                                                "sense_id": "7759ca57-d736-36d3-8f97-47251b2b4c83",
                                                "text": "Mr. Morrison's ruling to reopen the station as a shelter was given after he had balanced the relative dangers of flooding and bombing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "944dd35c-a59a-33b9-9355-1d13e3c67115",
                                        "entry_id": "1d99375d-fb2a-337d-be24-a066e2434c9a",
                                        "glosses": [
                                            "To move toward, and then back from, reciprocally."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
