                    },
                    {
                        "translation_id": "f314836c-cd89-4c9c-850c-27109ab8baa3",
                        "source_entry_id": "9ab8b929-7e42-3328-a525-5d208a6332ca",
                        "source_sense_id": "9953ca14-a458-377e-93ea-49314f9065cc",
