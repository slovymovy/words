                                        "sense_id": "f28c41b9-a75d-3e28-9918-9eb928a6caff",
                                        "entry_id": "deeaed98-9d85-3219-a347-fe5fb98d95f8",
                                        "glosses": [
                                            "Someone who does not conform to generally accepted beliefs or practices."
                                        ],
