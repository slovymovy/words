                "senses": [
                    {
                        "sense_id": "bd573a3f-7c65-3515-b9ed-a0380099131f",
                        "entry_id": "a2a2bb43-e1f7-351e-826c-797bc5e5b7f1",
                        "glosses": [
                            "nie od razu, lecz po trochu, krok za krokiem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c35e23e-4597-4a54-b70c-e20c06ac3faf",
                                "sense_id": "bd573a3f-7c65-3515-b9ed-a0380099131f",
                                "text": "Pacjent stopniowo wraca do zdrowia."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aaa968f5-afab-4f31-a727-172c88644aaf",
                        "source_entry_id": "a2a2bb43-e1f7-351e-826c-797bc5e5b7f1",
                        "source_sense_id": "bd573a3f-7c65-3515-b9ed-a0380099131f",
                        "target_lang_word": "gradually",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gradually",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eec6e14a-1959-368c-9a1b-b5198a61ff54",
                                        "entry_id": "25f36aaa-9e42-3396-9ad5-d738c1270ce9",
                                        "glosses": [
                                            "In a gradual manner; making slow progress; slowly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc3386cf-1314-417c-98e4-c47b4e80980f",
                                                "sense_id": "eec6e14a-1959-368c-9a1b-b5198a61ff54",
                                                "text": "The most likely conclusion, the researchers say, is that the Levallois method was not taken to Eurasia by African migrants, but evolved there gradually and independently."
                                            },
                                            {
                                                "example_id": "8e59594e-b4da-44f4-879f-a59203f643f4",
                                                "sense_id": "eec6e14a-1959-368c-9a1b-b5198a61ff54",
                                                "text": "The instrument of this dumbing down in Nineteen Eighty-Four was Newspeak, the official language of the English Socialist Party (Ingsoc). Newspeak was a sort of Totalitarian Esperanto that sought gradually to diminish the range of what was thinkable by eliminating, contracting and manufacturing words."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e084c4a-2d17-32b5-b669-3da6bc41128a",
                                        "entry_id": "25f36aaa-9e42-3396-9ad5-d738c1270ce9",
                                        "glosses": [
                                            "by degrees"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "291a7cab-11fc-4167-afc0-f69d0bf0d090",
                                                "sense_id": "9e084c4a-2d17-32b5-b669-3da6bc41128a",
                                                "text": "Horns, upon the due accession of Moisture, doth gradually become Soft."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f1a7460-7ec5-45a7-bca9-b27039a25321",
                        "source_entry_id": "a2a2bb43-e1f7-351e-826c-797bc5e5b7f1",
                        "source_sense_id": "bd573a3f-7c65-3515-b9ed-a0380099131f",
                        "target_lang_word": "step by step",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "step by step",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "891d06f4-dcbd-390c-abeb-5454940a8759",
                                        "entry_id": "0fb59fe5-20f4-3f05-a0fc-e84cfe7820e2",
                                        "glosses": [
                                            "From one stage to the next in sequence."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5aabcc8a-b217-4481-ba89-fdd3b8afd113",
                                                "sense_id": "891d06f4-dcbd-390c-abeb-5454940a8759",
                                                "text": "She assembled the toy step by step, following the instructions carefully."
                                            },
                                            {
                                                "example_id": "15937239-d41c-475a-bb65-1238ae7715f2",
                                                "sense_id": "891d06f4-dcbd-390c-abeb-5454940a8759",
                                                "text": "We were shown the process step by step."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53475612-4cc8-32b8-bad4-6ce0285f1c03",
                                        "entry_id": "0fb59fe5-20f4-3f05-a0fc-e84cfe7820e2",
                                        "glosses": [
                                            "Gradually and steadily."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab891489-04ac-4e93-9f2a-c6639f2e8695",
                                                "sense_id": "53475612-4cc8-32b8-bad4-6ce0285f1c03",
                                                "text": "Like many a successful YouTuber, she built up her following step by step, amassing subscribers as her video library grew."
                                            },
                                            {
                                                "example_id": "52d7096e-bef4-4a7c-ac40-6480d23053e5",
                                                "sense_id": "53475612-4cc8-32b8-bad4-6ce0285f1c03",
                                                "text": "Rail technology advanced step by step - albeit electrification was a good stride, rather than a short step."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0984b49-739b-4bc6-81a0-05379335a2e2",
                        "source_entry_id": "a2a2bb43-e1f7-351e-826c-797bc5e5b7f1",
                        "source_sense_id": "bd573a3f-7c65-3515-b9ed-a0380099131f",
                        "target_lang_word": "bit by bit",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
