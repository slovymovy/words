                "senses": [
                    {
                        "sense_id": "c5097bf8-d0db-38fa-a3b1-b4a7cee7c556",
                        "entry_id": "c15d3b7a-2702-3cae-bdd0-063f679d0ec2",
                        "glosses": [
                            "Rétrécissement d'un tube engendrant une augmentation de la vitesse d'écoulement du fluide y circulant conjointement à une diminution de la pression."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "62cf8a56-39fc-416d-b7a6-053482f345cb",
                                "sense_id": "c5097bf8-d0db-38fa-a3b1-b4a7cee7c556",
                                "text": "Le liquide est injecté au moyen d'une ou plusieurs buses, soit juste avant le col d'un venturi, soit à la paroi du venturi à la hauteur du col. Dans tous les cas , le liquide se trouve pulvérisé en fines gouttelettes par la suite de la grande vitesse du gaz au col du venturi."
                            }
                        ]
                    },
                    {
                        "sense_id": "20740f31-372f-34c3-8ab8-b9e49609825a",
                        "entry_id": "c15d3b7a-2702-3cae-bdd0-063f679d0ec2",
                        "glosses": [
                            "Rétrécissement de la buse entourant le gicleur dans un carburateur."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "7fd13147-8bc6-4be0-a369-a513b9a50ea1",
                                "sense_id": "20740f31-372f-34c3-8ab8-b9e49609825a",
                                "text": "Le système automatique du carburateur Cozette est constitué par un venturi, ou émulsionneur, placé perpendiculairement à la base principale jouant le rôle de multiplicateur de dépression."
                            }
                        ]
                    },
                    {
                        "sense_id": "4c3e5c88-0ebb-34b3-879e-c6726eed2907",
                        "entry_id": "c15d3b7a-2702-3cae-bdd0-063f679d0ec2",
                        "glosses": [
                            "Tube servant à mesurer la vitesse d’un fluide ou son débit par mesure de la dépression."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "b8eb021d-6719-419a-b723-dde4ff4e6184",
                                "sense_id": "4c3e5c88-0ebb-34b3-879e-c6726eed2907",
                                "text": "Comme anémomètre, le venturi est utilisé uniquement sur les avions lents et les planeurs."
                            }
                        ]
                    }
