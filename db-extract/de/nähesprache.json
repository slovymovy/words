                "senses": [
                    {
                        "sense_id": "1232e250-0e2f-3de7-babb-cfb058ced29d",
                        "entry_id": "0adef500-21de-3965-b615-5666bbfbf874",
                        "glosses": [
                            "Sprachformen, mit denen Personen untereinander Nähe/Vertrautheit signalisieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a503aad-c52e-40ef-9449-f64641a46ab5",
                                "sense_id": "1232e250-0e2f-3de7-babb-cfb058ced29d",
                                "text": "„Daher ist es auch richtiger, statt einfach von gesprochener Sprache zu reden, den genaueren Ausdruck zu gebrauchen, der sich in der Sprachwissenschaft nun einigermaßen durchgesetzt hat: »Nähesprache« im Unterschied zu dem, was als Gegenbegriff »Distanzsprache« genannt wird.“"
                            },
                            {
                                "example_id": "b03fcef1-84d7-4064-9dff-95d3369fd0ce",
                                "sense_id": "1232e250-0e2f-3de7-babb-cfb058ced29d",
                                "text": "„Das Ruhrdeutsche ist eine „Nähesprache“ – und wird als solche von den Menschen im Ruhrgebiet geschätzt. “"
                            },
                            {
                                "example_id": "e7a54439-d0e4-4984-946d-f9ff7ee565a3",
                                "sense_id": "1232e250-0e2f-3de7-babb-cfb058ced29d",
                                "text": "„Ausgewertet wird ein Korpus historischer Nähesprache des Deutschen mit ca. 3,5 Mio Wortformen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
