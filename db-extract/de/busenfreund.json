                "senses": [
                    {
                        "sense_id": "93969a02-af5a-3a2e-9d8a-c11055db5309",
                        "entry_id": "fc02fc19-4b7e-3e05-b748-34b1e3634e18",
                        "glosses": [
                            "besonders enger Freund"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "f38865d2-1292-41fb-8cb0-64d64f3efcc1",
                                "sense_id": "93969a02-af5a-3a2e-9d8a-c11055db5309",
                                "text": "Jeden August schauen mein Busenfreund und ich nachts gemeinsam nach Sternschnuppen."
                            },
                            {
                                "example_id": "8b805c62-7427-4bea-a51d-c47f7f45f432",
                                "sense_id": "93969a02-af5a-3a2e-9d8a-c11055db5309",
                                "text": "„Nein, lieber Freund, mein frommer Oheim hat neuerdings meine Schulden gezahlt, so dass ich seit der Einlösung meines letzten Wechsels keinen Busenfreund mehr habe, der Abraham heisst […].“"
                            },
                            {
                                "example_id": "61a065b7-00b7-40c9-a247-064abda36b18",
                                "sense_id": "93969a02-af5a-3a2e-9d8a-c11055db5309",
                                "text": "„Er war mit dem Kommodore, der sein besonderer Busenfreund war, zum See gekommen und hatte sich an allen bisherigen Kämpfen und Feldzügen beteiligt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2af5bb8-7359-4901-b876-d147aa2ea838",
                        "source_entry_id": "fc02fc19-4b7e-3e05-b748-34b1e3634e18",
                        "source_sense_id": "93969a02-af5a-3a2e-9d8a-c11055db5309",
                        "source_sense_description": "veraltend, oft spöttisch: besonders enger Freund",
                        "target_lang_word": "bosom friend",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bosom friend",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b8d1d73e-8e3f-3fb2-9374-5a42227a9cbf",
                                        "entry_id": "ece3ab5d-6edb-3a3b-b742-311ea7a65890",
                                        "glosses": [
                                            "A very close friend."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64fed2aa-602b-4163-a665-8765f1a040a5",
                                                "sense_id": "b8d1d73e-8e3f-3fb2-9374-5a42227a9cbf",
                                                "text": "I pour you the farewell wine as you set out from the capital—\nSoon I shall be left behind here by my bosom-friend.\nIn your sail-boat of sweet cinnamon-wood\nYou will float again toward your own thatch door"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec21a540-0f6e-41f4-b9ad-71fd00f55049",
                        "source_entry_id": "fc02fc19-4b7e-3e05-b748-34b1e3634e18",
                        "source_sense_id": "93969a02-af5a-3a2e-9d8a-c11055db5309",
                        "source_sense_description": "veraltend, oft spöttisch: besonders enger Freund",
                        "target_lang_word": "bosom buddy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bosom buddy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3cddf4b1-f5d1-34f2-b779-13347fadc5e9",
                                        "entry_id": "7afb183a-7594-3da2-a2ea-7ef9be414b85",
                                        "glosses": [
                                            "A very close friend."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66d1962f-a7ed-4a14-8f74-2e9afc76d7a8",
                                                "sense_id": "3cddf4b1-f5d1-34f2-b779-13347fadc5e9",
                                                "text": "He made a telephone call to his bosom buddy, drinking companion and confidant, CBS Sports Director Bill MacPhail."
                                            },
                                            {
                                                "example_id": "aa24d140-f714-4668-a070-2af921ad2d8f",
                                                "sense_id": "3cddf4b1-f5d1-34f2-b779-13347fadc5e9",
                                                "text": "Although they were far from bosom buddies, she liked Mary Jackson as much as anyone on the street."
                                            },
                                            {
                                                "example_id": "77aae9ba-3039-47d4-9cfe-77c22b611e7b",
                                                "sense_id": "3cddf4b1-f5d1-34f2-b779-13347fadc5e9",
                                                "text": "Campaigning together frequently this fall, the former rivals became, if not bosom buddies, closer than either ever expected."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bdeea3cc-1742-41f4-bde5-47c4dab6bb1d",
                        "source_entry_id": "fc02fc19-4b7e-3e05-b748-34b1e3634e18",
                        "source_sense_id": "93969a02-af5a-3a2e-9d8a-c11055db5309",
                        "source_sense_description": "veraltend, oft spöttisch: besonders enger Freund",
                        "target_lang_word": "boezemvriend",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boezemvriend",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "31775526-65af-341c-a385-fda8cd08deea",
                                        "entry_id": "38c5d391-e7fb-376c-bd70-83a4c8796694",
                                        "glosses": [
                                            "een persoon met wie men een diepe verwantschap ervaart op het gebied van vriendschap."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9000fcc8-739e-4414-878e-1a67b93cd2a8",
                                                "sense_id": "31775526-65af-341c-a385-fda8cd08deea",
                                                "text": "Zij was niet getrouwd met haar boezemvriend."
                                            },
                                            {
                                                "example_id": "ece9a5fc-e94c-41be-bc24-94593d438a4f",
                                                "sense_id": "31775526-65af-341c-a385-fda8cd08deea",
                                                "text": "Voor de zoveelste maal maakte hij een saluutgebaar naar Teun, die in acht dagen tijd van een volstrekt onbekende tot een boezemvriend was uitgegroeid."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
