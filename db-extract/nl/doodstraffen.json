                "senses": [
                    {
                        "sense_id": "a1e8033d-e3b1-3a07-84f1-8893b09cb3a1",
                        "entry_id": "45f9e2b0-c035-325b-bbf5-2febeaf42efb",
                        "glosses": [
                            "to execute, to kill to conclude a death penalty"
                        ],
                        "tags": [
                            "rare",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "90587e96-dc6f-4210-89d1-38ad59929edf",
                                "sense_id": "a1e8033d-e3b1-3a07-84f1-8893b09cb3a1",
                                "text": "1745, Ary Wys, ’s Heilands kruisgeschiedenis, publ. by Nikolaes Smithof, page 125.\n[…] Welke aan een' doemeling, gedoodstraft, geenszins voegt.",
                                "translation": "[…] which is not meet for a condemnee, executed, at all.",
                                "english": "[…] which is not meet for a condemnee, executed, at all."
                            },
                            {
                                "example_id": "b15a5c29-8010-4d0a-a904-3231f17ef8ee",
                                "sense_id": "a1e8033d-e3b1-3a07-84f1-8893b09cb3a1",
                                "text": "In het volgende gedeelte der regeringe van de Koninginne, werd de wet ſomtyds uitgevoerd door het doodſtraffen van Priesteren; […]",
                                "translation": "In the following part of the Queen's rule, the law was sometimes put into practice by the executing of priests; […]",
                                "english": "In the following part of the Queen's rule, the law was sometimes put into practice by the executing of priests; […]"
                            }
                        ]
                    }
