                "senses": [
                    {
                        "sense_id": "64acaf0e-ebdb-3fda-8c98-b502a676622f",
                        "entry_id": "88781be3-3f2c-345c-9aec-061a70e9533c",
                        "glosses": [
                            "Beschreibung von zu erbringenden Leistungen und zu erfüllender Pflichten bei einem technischen oder betriebswirtschaftlichen Projekt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d2fc0c4-4014-442a-b80b-40c8b71bd228",
                                "sense_id": "64acaf0e-ebdb-3fda-8c98-b502a676622f",
                                "text": "Es wird nur geleistet, was in der Leistungsbeschreibung verankert ist."
                            },
                            {
                                "example_id": "d845fe90-f582-425c-8a5d-87121b68dba2",
                                "sense_id": "64acaf0e-ebdb-3fda-8c98-b502a676622f",
                                "text": "„Es wird unterschieden zwischen Leistungsbeschreibungen mit Leistungsverzeichnis und Leistungsbeschreibungen mit Leistungsprogramm (Funktionalausschreibung).“"
                            },
                            {
                                "example_id": "98870e5c-e95c-4382-8495-fd74d855c059",
                                "sense_id": "64acaf0e-ebdb-3fda-8c98-b502a676622f",
                                "text": "„Neben dem Leistungsverzeichnis ist die Leistungsbeschreibung die Grundlage für die Vergabe von Bauleistungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
