                "senses": [
                    {
                        "sense_id": "ade6db5e-bce2-3d5f-9b8a-0064ef521f6e",
                        "entry_id": "491755d6-2a73-3988-8b5e-3440dcc32b2e",
                        "glosses": [
                            "Needed; necessary; mandatory; requisite; indispensable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ab05785-ee6b-4324-a269-2f8f7d7516eb",
                                "sense_id": "ade6db5e-bce2-3d5f-9b8a-0064ef521f6e",
                                "text": "And be it further Enacted by the Authority aforeſaid, That in every Town in the Colony, where Bread is Baken for Sale, there ſhall be Choſen one Clerk of the Market, or more, as each Town ſhall find needful, at their Annual Election of Town Officers, who ſhall duly be Engaged, to the faithful performance of ſaid Office, as other Town Officers are ;[…]"
                            },
                            {
                                "example_id": "c65a13eb-7b56-4e1e-a843-e772f1d40328",
                                "sense_id": "ade6db5e-bce2-3d5f-9b8a-0064ef521f6e",
                                "text": "So I went to keep house with him at the Why Not? and my aunt sent down my bag of clothes, and would have made over to Elzevir the pittance that my father left for my keep, but he said it was not needful, and he would have none of it."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb002e24-e92c-3649-8767-216f7cf1dc43",
                        "entry_id": "491755d6-2a73-3988-8b5e-3440dcc32b2e",
                        "glosses": [
                            "Needy; in need."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "aaafd699-3f3a-49c5-9641-e18b2551014e",
                                "sense_id": "eb002e24-e92c-3649-8767-216f7cf1dc43",
                                "text": "[…] where his active benevolence was ever found in cheerful co-operation for the cause of the humble & needful orphan […]"
                            }
                        ]
                    }
                ],
