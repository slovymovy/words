                "senses": [
                    {
                        "sense_id": "17c6b859-6cdc-3146-8072-747d06574a37",
                        "entry_id": "05a32531-8f91-3b63-92b2-fb04c19d9313",
                        "glosses": [
                            "op een wijze die in overeenstemming met het eergevoel is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97ba043f-b6a6-4211-86c1-5392bd4212a0",
                                "sense_id": "17c6b859-6cdc-3146-8072-747d06574a37",
                                "text": "De plechtigheid werd op waardige wijze besloten."
                            },
                            {
                                "example_id": "19006764-d9d5-4476-ba73-a81b4ef01dfb",
                                "sense_id": "17c6b859-6cdc-3146-8072-747d06574a37",
                                "text": "Mirren bedankte de koningin \"uit naam van al uw trouwe onderdanen\" en sprak bewondering uit voor haar \"onwankelbare hoop, ondersteuning en leiderschap\" in de afgelopen zeventig jaar. \"We prijzen en bewonderen de manier waarop u vaardig en waardig staatszaken verricht.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0db8b7b1-18b9-44a0-81b5-d94b596f5c24",
                        "source_entry_id": "05a32531-8f91-3b63-92b2-fb04c19d9313",
                        "source_sense_id": "17c6b859-6cdc-3146-8072-747d06574a37",
                        "source_sense_description": "op een wijze die in overeenstemming met het eergevoel is",
                        "target_lang_word": "würdevoll",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "würdevoll",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b494c859-81a5-358b-a611-3bbefc99fb80",
                                        "entry_id": "06c133fb-fde0-3f74-9b51-7f5243034dc8",
                                        "glosses": [
                                            "Würde zeigend; den Wert oder die Besonderheit von jemandem oder etwas anerkennend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2fa7794-979e-428c-8cc0-75ff9328e9b6",
                                                "sense_id": "b494c859-81a5-358b-a611-3bbefc99fb80",
                                                "text": "„Auch wenn diese Menschen im Einzelfall womöglich nicht den gleichen Lebensschutz genießen, sie alle sind stets würdevoll zu behandeln.“"
                                            },
                                            {
                                                "example_id": "e60ba4f2-64c2-4e5e-a44d-23fed72e89e5",
                                                "sense_id": "b494c859-81a5-358b-a611-3bbefc99fb80",
                                                "text": "„Viele Menschen erleben und achten die Kirche bis heute als besonderen Ort und würdevollen Raum.“"
                                            },
                                            {
                                                "example_id": "6cda10c1-4522-4378-9edc-bbdd6e202422",
                                                "sense_id": "b494c859-81a5-358b-a611-3bbefc99fb80",
                                                "text": "„Der Ford Falcon ist seit fünfzig Jahren der Star auf den Straßen Argentiniens. Gebaut wird er seit zwei Jahrzehnten nicht mehr, ein Hingucker bleibt er allemal. Auch wenn er schon Rost angesetzt hat, strahlt er noch immer würdevolle Eleganz aus.“"
                                            },
                                            {
                                                "example_id": "eee9c879-92f7-4781-9efe-1115e656a9f8",
                                                "sense_id": "b494c859-81a5-358b-a611-3bbefc99fb80",
                                                "text": "„Ein Bestattungsdienstleister mag in diesem Sinne handeln und einen ‚würdevollen Umgang mit dem Verstorbenen‘ sowie eine ‚würdevolle Bestattung‘ arrangieren können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eeb49204-9a5f-4209-bde2-07ce2c3f4032",
                        "source_entry_id": "05a32531-8f91-3b63-92b2-fb04c19d9313",
                        "source_sense_id": "17c6b859-6cdc-3146-8072-747d06574a37",
