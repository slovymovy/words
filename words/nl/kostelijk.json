                                "target_lang_sense_clarification": "figuré, réjouissant ou savoureux"
                            },
                            {
                                "target_lang_word": "impayable",
                                "target_lang_sense_clarification": "particulièrement drôle ou divertissant"
                            },
                            {
                                "target_lang_word": "amusant",
                                "target_lang_sense_clarification": "divertissant"
