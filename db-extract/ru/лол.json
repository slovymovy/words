                            {
                                "target_word": "LOL",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca63bf5f-24f6-37d4-85af-85f7d8420d19",
                                        "entry_id": "522b9d66-1ce1-38a1-bf0f-02df52a9a538",
                                        "glosses": [
                                            "Loyal Orange Lodge, a prefix given to all branches of the Loyal Orange Order. For example, LOL 1 is Portadown branch."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3a91483e-b94a-307d-bdb9-382e0819ef39",
                                        "entry_id": "522b9d66-1ce1-38a1-bf0f-02df52a9a538",
                                        "glosses": [
                                            "Little old lady."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fe67c90-bdc3-4e05-96cc-49b9ee7ec506",
                                                "sense_id": "3a91483e-b94a-307d-bdb9-382e0819ef39",
                                                "text": "We've got an LOL in the emergency department who seems a bit confused."
                                            },
                                            {
                                                "example_id": "68c76a6d-6e1c-49c9-b3e2-4cccfd09ce7f",
                                                "sense_id": "3a91483e-b94a-307d-bdb9-382e0819ef39",
                                                "text": "L.O.L.: little old lady. (Oddly, there is no male equivalent.) / N.A.D.: no apparent distress. The classic description of a patient in a state of well-being: L.O.L. in N.A.D."
                                            },
                                            {
                                                "example_id": "f4918177-da55-48fe-8c16-29c8dbf7e8fd",
                                                "sense_id": "3a91483e-b94a-307d-bdb9-382e0819ef39",
                                                "text": "Then he started with his LOLs. The Little Old Ladies who needed help with daily chores."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26110384-e63c-3f4e-b1f3-994f826a60db",
                                        "entry_id": "522b9d66-1ce1-38a1-bf0f-02df52a9a538",
                                        "glosses": [
                                            "An instance of the interjection \\\"LOL\\\"."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5f3faf9-201e-4a51-b47d-4a662a12a3dc",
                                                "sense_id": "26110384-e63c-3f4e-b1f3-994f826a60db",
                                                "text": "YouTube comments are rough. They dabble in all forms of trolling, bullying, racism, sexism and other offensive -isms, interspersed with endless spurts of nonsensical chatter. Any thoughtful comments are typically lost in a roiling sea of “LOLs,” insults and spam."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
