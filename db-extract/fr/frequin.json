                "senses": [
                    {
                        "sense_id": "5a80a242-3bd3-31e3-975e-7a0d15c6926a",
                        "entry_id": "d5c56d77-d522-383a-bf63-2959f7b7169f",
                        "glosses": [
                            "Sorte de futaille qui servait à entonner les sucres, les sirops et les autres marchandises (beurre, savon, harengs, ale, bière, saumure, saindoux, chandelle) sujettes à couler, et qui pèse plus de 25 kg."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "5715e612-c02e-4bdb-a039-3e556d451eda",
                                "sense_id": "5a80a242-3bd3-31e3-975e-7a0d15c6926a",
                                "text": "Des vergues coupées par les rochers, du filin, des poulies, des ferrures de gouvernail, des pièces vides, la cloche du navire, la lettre B en cuivre de son nom , un bucaut de biscuit et un frequin de beurre, sont les principaux objets recueillis"
                            },
                            {
                                "example_id": "4f3e9fb8-39e2-4ecd-a40e-12f4c57e9031",
                                "sense_id": "5a80a242-3bd3-31e3-975e-7a0d15c6926a",
                                "text": "[…] quatre-vingt dix-neuf planches, trois bariques d’oignons, trois barils de pommes qui se trouvent gâtées, trente petits barils de sindoux, quinze frequins de beurre, quinze petis barils de poids (six), deux barils de fromage, et deux de jambon"
                            }
                        ]
                    },
                    {
                        "sense_id": "bb95d0b3-afc4-3748-9f29-52a52da2737e",
                        "entry_id": "d5c56d77-d522-383a-bf63-2959f7b7169f",
                        "glosses": [
                            "Variété de pomme dont on se sert pour faire du cidre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d74bc362-00b8-4645-ae01-9ea4d6b514c1",
                                "sense_id": "bb95d0b3-afc4-3748-9f29-52a52da2737e",
                                "text": "Le meilleur que j’aie bu était de couleur de clairet, rougeâtre ou brun la pomme dont on le tire s’appelle Fréquin, est ronde et jaune, mais si amère qu’elle n’est pas mangeable & cependant le cidre qui en venait était aussi doux que le vin pris sous le pressoir"
                            }
                        ]
                    }
                ],
