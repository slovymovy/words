                        "translation_id": "d0713d38-b0af-428b-82ee-250c47f2ff74",
                        "source_entry_id": "c81dfe26-bf0e-3d0e-aa23-830d699b90af",
                        "source_sense_id": "9855a285-45ed-3008-929b-66edbbddab87",
                        "source_sense_description": "aanhanger van het chassidisme",
                        "target_lang_word": "Chassid",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Chassid",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bec32202-f59a-3f3a-85fe-cb5597640a3b",
                                        "entry_id": "24598bf8-a693-3da9-af90-0877867bc26e",
                                        "glosses": [
                                            "Anhänger des Chassidismus"
                                        ],
                                        "tags": [
                                            "jüdische Religion; zumeist im Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d1a3e3a-91ab-44ff-a2f4-bd6bd4db7063",
                                                "sense_id": "bec32202-f59a-3f3a-85fe-cb5597640a3b",
                                                "text": "„Die polnisch-jüdische Gemeinschaft des 18. Jahrhunderts war gespalten in die mystische und volkstümliche Strömung der Chassidim und in jene der jüdischen Aufklärung, der Haskala.[…]Die Chassidim hingegen - die in den unteren Schichten und auf dem Lande verbreitet waren - lebten weiterhin in ihrer Gemeinschaft und hielten die religiösen und kulturellen Riten ein.“"
                                            },
                                            {
                                                "example_id": "2f556118-4bd6-46bf-bf2d-19b65723257f",
                                                "sense_id": "bec32202-f59a-3f3a-85fe-cb5597640a3b",
                                                "text": "„Der bekannte Kabbala-Forscher G. Scholem hat in einem Aufsatz über drei Typen jüdischer Frömmigkeit (abgedruckt in seinem Sammelband »Judaica 4«, Frankfurt 1984) festgestellt: »In der ethischen Literatur des Judentums und anderen Stellen, wo die Begriffe mit einer gewissen Genauigkeit und Sinn für Unterscheidung verwendet werden, nimmt der Zaddik eine eindeutig geringere Position ein als der Chassid. Während der Zaddik das Ideal der Norm bildet, ist der Chassid das Ideal der Ausnahme.“"
                                            },
                                            {
                                                "example_id": "0046f0af-4543-4fa0-8155-8fcae1c11e30",
                                                "sense_id": "bec32202-f59a-3f3a-85fe-cb5597640a3b",
                                                "text": "„Er war überzeugt, dass man - so wie die Nibelungensage oder die Märchen der Brüder Grimm, die ein Stück des kulturellen Fundaments der deutschen Identität ausmachten - ein ähnlich bedeutsames Werk für den Zionismus in der hebräischen Dichtung des 6. oder vielleicht auch des 10. Jahrhunderts, in der Kabbala oder in den Legenden der Chassidim finden könnte.“"
                                            },
                                            {
                                                "example_id": "8ca9d5e5-d13d-4a43-a943-1c6eb02e4f06",
                                                "sense_id": "bec32202-f59a-3f3a-85fe-cb5597640a3b",
                                                "text": "„Ein Chassid ist im Hebräischen ein ehrlicher und mildtätiger Mensch, und so wünschte sich Ben-Elieser seine Anhänger. Die Chassidim bestehen heute aus verschiedenen Gruppen.“"
                                            },
                                            {
                                                "example_id": "7da4e287-a4d1-45eb-bf09-3d4c4431f68b",
                                                "sense_id": "bec32202-f59a-3f3a-85fe-cb5597640a3b",
                                                "text": "„Warum bleibt Asher weiterhin Chassid, ja wird desto mehr Chassid je mehr er in die Malerei eintaucht?“"
                                            },
                                            {
                                                "example_id": "0d562a86-1c1c-45a7-be0b-a94eeb25553e",
                                                "sense_id": "bec32202-f59a-3f3a-85fe-cb5597640a3b",
                                                "text": "„Die Rabbis, um die sich die Chassiden scharten, leisteten dem Wunderglauben des einfachen Volkes Vorschub und nutzten ihn pfiffig zu ihrem eigenen Vorteil aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "56ee0641-0210-3a61-86df-6cea9a285fe4",
                                        "entry_id": "24598bf8-a693-3da9-af90-0877867bc26e",
                                        "glosses": [
                                            "jemand, der vor und während der Erhebung der Makkabäer im 2. Jahrhundert vor Christus gegen die Hellenisten feindlich gesinnt war (und diese bekämpfte)"
                                        ],
                                        "tags": [
                                            "jüdische Religion; historisch; zumeist im Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9078496e-1ea4-49fc-86f5-95832f413b9b",
                                                "sense_id": "56ee0641-0210-3a61-86df-6cea9a285fe4",
                                                "text": "„\"[…]Wenn Galiläer aus dem Bauern- und Tagelöhnermilieu, hellenistisch-urbane Handwerker, 'gescheiterte' und absolut marginalisierte Existenzen, ehemalige zelotische Freiheitskämpfer (Lk 6,15f), pharisäisch-torabeflissene Chassidim und rabbinisch Gebildete die Versammlungen bevölkerten, erstehen blasse Ahnungen von einer multikulturell durchmischten und hinsichtlich ihrer religiösen Vorprägung ökumenischen Gemeinde.\"“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
