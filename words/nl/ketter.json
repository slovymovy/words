{
    "word_family": [
        "ketterij",
        "ketteren",
        "ketters"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "da6403a7-dbe8-32c2-8114-2e713f1105c7",
                    "sense_definition": "Iemand die een leer aanhangt die afwijkt van de officiële geloofsleer van een kerk of gemeenschap.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de middeleeuwen werd een <w>ketter</w> vaak streng gestraft door de kerkelijke autoriteiten.",
                            "target_lang_translations": {
                                "en": "In the Middle Ages, a <w>heretic</w> was often severely punished by the church authorities."
                            }
                        },
                        {
                            "text": "Hij werd als <w>ketter</w> bestempeld omdat hij openlijk twijfelde aan de heilige geschriften.",
                            "target_lang_translations": {
                                "en": "He was labeled a <w>heretic</w> because he openly doubted the holy scriptures."
                            }
                        }
                    ],
                    "synonyms": [
                        "dwaalleer",
                        "afvallige"
                    ],
                    "antonyms": [
                        "gelovige"
                    ],
                    "common_phrases": [
                        "verbranden als ketter"
                    ],
                    "target_lang_definitions": {
                        "en": "Someone who holds a belief that deviates from the official doctrine of a church or community."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "heretic",
                                "target_lang_sense_clarification": "religious context"
                            },
                            {
                                "target_lang_word": "dissenter",
                                "target_lang_sense_clarification": "someone who disagrees with official views"
                            },
                            {
                                "target_lang_word": "nonconformist",
                                "target_lang_sense_clarification": "someone who does not follow established customs"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4421ac1a-2380-355f-ae7e-9b993038e8eb",
                    "sense_definition": "Iemand die door de katholieke kerk als misdadiger werd beschouwd vanwege afwijkende religieuze opvattingen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>ketters</w> werden op het marktplein levend verbrand voor de ogen van het volk.",
                            "target_lang_translations": {
                                "en": "The <w>heretics</w> were burned alive in the market square before the eyes of the people."
                            }
                        },
                        {
                            "text": "De inquisitie spoorde elke <w>ketter</w> op die de pauselijke macht niet erkende.",
                            "target_lang_translations": {
                                "en": "The Inquisition tracked down every <w>heretic</w> who did not recognize papal power."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historische context van de inquisitie"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Someone who was considered a criminal by the Catholic Church due to deviating religious views."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "heretic",
                                "target_lang_sense_clarification": "historical/religious criminal"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c6789736-2a95-3e48-a3bb-e2ae99d0d8f2",
                    "sense_definition": "De eerste persoon enkelvoud tegenwoordige tijd van <w>ketteren</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>ketter</w> de hele dag tegen de nieuwe regels van het bestuur.",
                            "target_lang_translations": {
                                "en": "I <w>rail</w> all day against the board's new rules."
                            }
                        },
                        {
                            "text": "Als ik zo <w>ketter</w>, bedoel ik dat ik het er absoluut niet mee eens ben.",
                            "target_lang_translations": {
                                "en": "When I <w>rant</w> like that, I mean that I absolutely do not agree with it."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoeging van ketteren"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First person singular present tense of 'ketteren' (to rail against or complain loudly)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rail",
                                "target_lang_sense_clarification": "to complain or protest strongly"
                            },
                            {
                                "target_lang_word": "rant",
                                "target_lang_sense_clarification": "to speak loudly and angrily"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07f58da9-28cd-3a66-bc74-06245592f1ea",
                    "sense_definition": "De gebiedende wijs van <w>ketteren</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Ketter</w> niet zo op je collega's, want dat verpest de sfeer op kantoor.",
                            "target_lang_translations": {
                                "en": "Don't <w>rail</w> against your colleagues like that, because it ruins the atmosphere at the office."
                            }
                        },
                        {
                            "text": "Houd op met dat geklaag en <w>ketter</w> ergens anders over je problemen.",
                            "target_lang_translations": {
                                "en": "Stop that complaining and <w>rant</w> about your problems somewhere else."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "gebiedende wijs"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The imperative form of 'ketteren' (to rail against or complain loudly)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rail",
                                "target_lang_sense_clarification": "to complain or protest strongly"
                            },
                            {
                                "target_lang_word": "rant",
                                "target_lang_sense_clarification": "to speak loudly and angrily"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}