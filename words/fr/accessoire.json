                    ],
                    "common_phrases": [
                        "accessoires de mode",
                        "accessoire pour téléphone"
                    ]
                },
                {
                    "sense_id": "0f009330-77e8-32f0-981a-90f84ebc3b34",
                    "sense_definition": "Objet utilisé par un acteur ou placé sur scène lors d'une représentation théâtrale ou d'un tournage.",
