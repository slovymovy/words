                        "sense_id": "f3569f48-8a78-35f2-86b4-15bb6d265d1d",
                        "entry_id": "091416a1-4675-30d0-9e0d-bb9f29a23c60",
                        "glosses": [
                            "derjenige Bereich der Theologie, der sich mit der Verhältnisbestimmung der eigenen Religion (und ihrer Wahrheitsansprüche) zu den anderen Religionen verhält"
                        ],
                        "tags": [
                            "Theologie",
                            "Religionsphilosophie"
                        ],
                        "examples": [
                            {
                                "example_id": "981ace08-fbbf-43a5-b3cb-f7331e54fdca",
                                "sense_id": "f3569f48-8a78-35f2-86b4-15bb6d265d1d",
                                "text": "„Die pluralistische Religionstheologie geht noch einen Schritt weiter und behauptet, dass die verschiedenen Religionen gleichermaßen wahr sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
