        "nl-extract.jsonl": [
            {
                "entry_id": "89ce6b28-ada3-3015-8902-ca8f18e050f2",
                "word": "loei",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "db0a7ea7-19f2-398d-a17c-b11f93992c53",
                        "entry_id": "89ce6b28-ada3-3015-8902-ca8f18e050f2",
                        "glosses": [
                            "één keer voortgebracht loeiend geluid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4b0e6d3-6fe4-4da7-aa0c-55fe6181c950",
                                "sense_id": "db0a7ea7-19f2-398d-a17c-b11f93992c53",
                                "text": "Hij prevelde enkele goedmoedig klinkende woorden, waarvan Bob niets verstond, nam de trombone over, hief die schuin omhoog naar het bordje dat aangaf waar zich in deze trein de w.c. bevond en gaf een loei op het instrument die een seinhuiswachter, wiens huisje zij op dat moment passeerden, van schrik de pijp uit de mond liet vallen."
                            }
                        ]
                    },
                    {
                        "sense_id": "3c5aff94-a033-3036-a4fb-815c681f6c6f",
                        "entry_id": "89ce6b28-ada3-3015-8902-ca8f18e050f2",
                        "glosses": [
                            "harde slag"
                        ],
                        "tags": [
                            "vernacular"
                        ],
                        "examples": [
                            {
                                "example_id": "cb8b41d9-5387-4edb-a0b6-e00f9f9d69c7",
                                "sense_id": "3c5aff94-a033-3036-a4fb-815c681f6c6f",
                                "text": "Toen papa ons vandaag in de Bremstraat, waar Daniël woont, toevallig tegenkwam, kreeg ik een ongenadige loei voor mijn kop."
                            }
                        ]
                    },
                    {
                        "sense_id": "2ba2357c-5f62-3f1a-99eb-320e74ed5232",
                        "entry_id": "89ce6b28-ada3-3015-8902-ca8f18e050f2",
                        "glosses": [
                            "zeer hard schot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6eee0918-0638-404f-9044-cbfd43859cfc",
                                "sense_id": "2ba2357c-5f62-3f1a-99eb-320e74ed5232",
                                "text": "Teunis houdt van voetbal. Maar als hij de bal een loei geeft, komt die terecht in een vijver."
                            }
                        ]
                    },
                    {
                        "sense_id": "6ee9110e-2b57-35a8-9d0e-1113c4ec61fb",
                        "entry_id": "89ce6b28-ada3-3015-8902-ca8f18e050f2",
                        "glosses": [
                            "buitengewoon groot exemplaar, vaak gebruikt als eerste deel van een samenstellingen als versterking van het tweede deel"
                        ],
                        "tags": [
                            "intensifier",
                            "prefix",
                            "vernacular"
                        ],
                        "examples": [
                            {
                                "example_id": "174814fa-6bb6-4129-ab7f-d71888edf849",
                                "sense_id": "6ee9110e-2b57-35a8-9d0e-1113c4ec61fb",
                                "text": "Je maakt een loei van een fout, maar je komt pas echt in actie nadat mensen boos worden om die loei van een fout."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
