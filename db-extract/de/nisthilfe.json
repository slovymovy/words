                "senses": [
                    {
                        "sense_id": "f82037b3-4cef-3f5d-a384-fc153881165a",
                        "entry_id": "ab74825e-12ee-362c-8cfd-d9c94ba0a86c",
                        "glosses": [
                            "Kasten oder andere künstliche Einrichtung, in der bestimmte wildlebende Tiere (zum Beispiel Vögel) nisten können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef2f3a13-466b-4a86-819c-ca4270b234be",
                                "sense_id": "f82037b3-4cef-3f5d-a384-fc153881165a",
                                "text": "„Vögel flogen quer durch den Garten, und ich sah aus dem Augenwinkel, wie ein Rotschwanzpapa mit einem dicken Wurm in einer Nisthilfe verschwand.“"
                            },
                            {
                                "example_id": "59cb016d-3f4f-40fe-b735-334355709110",
                                "sense_id": "f82037b3-4cef-3f5d-a384-fc153881165a",
                                "text": "„Meine Schwester kam letztes Jahr zu meinem Geburtstag mit einer armlangen Röhre mit Löchern an: einer Nisthilfe.“"
                            },
                            {
                                "example_id": "9ca8f350-e356-4049-adab-f96582a43d0f",
                                "sense_id": "f82037b3-4cef-3f5d-a384-fc153881165a",
                                "text": "„Dort brütet seit Jahren ein Steinkauzpaar in einer extra angebrachten Nisthilfe.“"
                            },
                            {
                                "example_id": "e27b093e-2eef-4174-91a1-b82cf04939d4",
                                "sense_id": "f82037b3-4cef-3f5d-a384-fc153881165a",
                                "text": "„Mit einem Insektenhotel bekommen Wildbienen und andere Nützlinge im Garten und auf dem Balkon eine Nisthilfe, die den Kreislauf der Natur unterstützt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
