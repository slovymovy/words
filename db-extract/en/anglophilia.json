    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "9dbdec10-fb76-3688-970c-da51337d8b9b",
                "word": "Anglophilia",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "741576e3-10b5-331b-bd4f-80e0dfc6c103",
                        "entry_id": "9dbdec10-fb76-3688-970c-da51337d8b9b",
                        "glosses": [
                            "The love of the country, culture or people of England."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "42e177f2-8478-40ce-8aec-d4662367ba4b",
                                "sense_id": "741576e3-10b5-331b-bd4f-80e0dfc6c103",
                                "text": "Perhaps Anglophilia continues to play its part, but if I were one of the few surviving teachers of Anglo-Saxon I would rejoice at the way in which such terms as muggle and Wizengamot, and such names as Godric, Wulfric and Dumbledore, had become common currency."
                            },
                            {
                                "example_id": "ae2e09b3-ee61-48c4-ac49-26a9bf06140f",
                                "sense_id": "741576e3-10b5-331b-bd4f-80e0dfc6c103",
                                "text": "But now, as a company with the word \"British\" in its name pisses apocalyptic quantities of oil into the ocean, and CEO Tony Hayward pops up on the news to make tactless statements in a British accent, anglophilia is shrivelling."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0896e467-7c4b-46ae-a422-c4c22f54b4bf",
                        "source_entry_id": "9dbdec10-fb76-3688-970c-da51337d8b9b",
                        "source_sense_id": "741576e3-10b5-331b-bd4f-80e0dfc6c103",
                        "source_sense_description": "the love of the country, culture or people of England",
                        "target_lang_word": "anglophilie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anglophilie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "59ea81a1-0293-3075-a2b0-7c6915a32001",
                                        "entry_id": "6d616df8-223c-393f-b7cb-a24339621523",
                                        "glosses": [
                                            "Attrait pour le Royaume-Uni et tout ce qui le concerne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4316a085-41ca-41e4-9c71-02f464475e45",
                                                "sense_id": "59ea81a1-0293-3075-a2b0-7c6915a32001",
                                                "text": "Jules Verne, dans cet ouvrage, semble se tenir à égale distance de l’anglophilie, décelable chez Michel Auvray, et de l’anglophobie, qui reste malgré tout une tendance notable chez certains auteurs français jusqu’au début du xxᵉ siècle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48225a40-f260-4f25-8aeb-d25825777de2",
                        "source_entry_id": "9dbdec10-fb76-3688-970c-da51337d8b9b",
                        "source_sense_id": "741576e3-10b5-331b-bd4f-80e0dfc6c103",
                        "source_sense_description": "the love of the country, culture or people of England",
                        "target_lang_word": "Anglophilie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anglophilie",
