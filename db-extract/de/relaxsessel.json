                ],
                "senses": [
                    {
                        "sense_id": "4583bb7f-3200-33e4-a7b4-8066d09881c3",
                        "entry_id": "8e5795b2-b51b-3a9a-8515-ed1f689df0b8",
                        "glosses": [
                            "besonders bequemer Sessel, der zur Entspannung einlädt, häufig mit Neigefunktion, verstellbarem Kopf- und Fußteil und ähnlichen Funktionen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0412986-03c6-4b67-9c96-5220ae3f4c1f",
                                "sense_id": "4583bb7f-3200-33e4-a7b4-8066d09881c3",
                                "text": "„Man kann die vorgeklappte Beifahrersitzlehne aber auch ganz anders nutzen – zum Beispiel, um auf dem Fondplatz einmal für einige Zeit die Beine komplett auszustrecken und wie auf einem Relaxsessel auszuruhen.“"
                            },
                            {
                                "example_id": "d706493d-a261-4b8f-8be2-1cc1defbfef6",
                                "sense_id": "4583bb7f-3200-33e4-a7b4-8066d09881c3",
                                "text": "„Das wesentliche Konzept des neuen Relaxsessels ist die Form und Funktion einer Orangenschale, meint sein Designer Olav Eldøy.“"
                            },
                            {
                                "example_id": "8201be2c-4bed-4bf0-8769-cc07cc87fb8c",
                                "sense_id": "4583bb7f-3200-33e4-a7b4-8066d09881c3",
                                "text": "„Pompöse und technisch raffinierte Sitzmöbel helfen bei der Entspannung und Erholung - besonders der Fernseh-, Ruhe- und Relaxsessel.“"
                            },
                            {
                                "example_id": "b4b57b75-bd56-4211-b4ab-5ca2a697a0b1",
                                "sense_id": "4583bb7f-3200-33e4-a7b4-8066d09881c3",
                                "text": "„Aus der Couch kann auch ein Relaxsessel oder eine breite Liege werden, aus dem kleinen Tisch wird ein großer, Schranksysteme beinhalten auch einen Computerarbeitsplatz.“"
                            },
                            {
                                "example_id": "dd7cb510-6d26-4ac6-a27f-6ee97a1c04f1",
                                "sense_id": "4583bb7f-3200-33e4-a7b4-8066d09881c3",
                                "text": "„Oma und Opa haben einen Relaxsessel: Abends wird das Fußteil hochgeklappt, die Lehne geht nach hinten, gemütlich ist es, ruhig, beschaulich..“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
