                "senses": [
                    {
                        "sense_id": "e46c131d-de58-3b91-a336-9ee585ef3201",
                        "entry_id": "f00d167c-996a-3368-95f2-37480caf1213",
                        "glosses": [
                            "Offizier eines Militärs, den Rang eines Offiziers innehabender Angehöriger einer Streitkraft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec96ffab-f219-4e5c-96b7-154900165575",
                                "sense_id": "e46c131d-de58-3b91-a336-9ee585ef3201",
                                "text": "„Aber der verantwortliche Militäroffizier vor Ort, Eitan Ben Moshe, der kurzerhand eine Gruppe Jerusalemer Bauunternehmer für den Abriss mobilisierte, sorgte dafür, dass - bis auf eine Häusergruppe südlich der Klagemauer, die drei Jahre später abgerissen wurde - sämtliche Bauten dem Erdboden gleichgemacht wurden.“"
                            },
                            {
                                "example_id": "3b375c69-d1c1-4a72-b95f-d64bbf4eb624",
                                "sense_id": "e46c131d-de58-3b91-a336-9ee585ef3201",
                                "text": "„‹Es gibt ein spezielles Programm für Militäroffiziere, die zur Agency wechseln wollen.›“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
