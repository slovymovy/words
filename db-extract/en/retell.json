                    }
                ],
                "senses": [
                    {
                        "sense_id": "6fdabf1d-f796-3af9-b805-a690cdc92fb9",
                        "entry_id": "4b309265-3dd6-3382-8fbd-e7c85431e878",
                        "glosses": [
                            "To tell again, often differently, what one has read or heard; to paraphrase."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54b64275-4849-45c4-935b-f2e982304646",
                                "sense_id": "6fdabf1d-f796-3af9-b805-a690cdc92fb9",
                                "text": "She will retell the story from her perspective in the next meeting."
                            },
                            {
                                "example_id": "7fcf9493-403a-4cb4-ba1f-6c8f172ba64b",
                                "sense_id": "6fdabf1d-f796-3af9-b805-a690cdc92fb9",
                                "text": "He had to retell the story several times before it was understood."
                            },
                            {
                                "example_id": "3e8a8131-eb21-4baf-b138-9cf23188a6cf",
                                "sense_id": "6fdabf1d-f796-3af9-b805-a690cdc92fb9",
                                "text": "The author decided to retell the classic fairy tale with a modern twist."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "188a5b3f-f7a8-4b25-9252-9d8436c6f621",
                        "source_entry_id": "4b309265-3dd6-3382-8fbd-e7c85431e878",
                        "source_sense_id": "6fdabf1d-f796-3af9-b805-a690cdc92fb9",
                        "source_sense_description": "to tell again",
                        "target_lang_word": "raconter de nouveau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "17d3001c-0f85-4ebe-b6d9-bbc9b6aa4d5e",
                        "source_entry_id": "4b309265-3dd6-3382-8fbd-e7c85431e878",
                        "source_sense_id": "6fdabf1d-f796-3af9-b805-a690cdc92fb9",
                        "source_sense_description": "to tell again",
                        "target_lang_word": "redire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "redire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "033d8900-e672-3e41-85ef-7d3662827ce2",
                                        "entry_id": "28b81c0e-9a68-3730-8578-5924a7a4a1bc",
                                        "glosses": [
                                            "Répéter, dire une même chose plusieurs fois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee8c092b-5202-4e46-901f-480de3056ec3",
                                                "sense_id": "033d8900-e672-3e41-85ef-7d3662827ce2",
                                                "text": "Nous l’avons dit au début de ces pages et nous le redisons plus catégoriquement encore […]"
                                            },
                                            {
                                                "example_id": "d66465f6-45c1-4750-af53-e6e6206e7250",
                                                "sense_id": "033d8900-e672-3e41-85ef-7d3662827ce2",
                                                "text": "Héloïse dit et redit son chapelet. Les grains cliquettent de minute en minute et sans relâche, le chuchotement rapide des oraisons s’allonge."
                                            },
                                            {
                                                "example_id": "ec9c8d8e-26c1-4490-927a-545c0ffd9549",
                                                "sense_id": "033d8900-e672-3e41-85ef-7d3662827ce2",
                                                "text": "Elle ne voulait plus faire de photos, voilà tout, elle le redirait à sa mère."
                                            },
                                            {
                                                "example_id": "7f957c95-6619-429b-99cd-f8620f1d5205",
                                                "sense_id": "033d8900-e672-3e41-85ef-7d3662827ce2",
                                                "text": "Je ne vous le redirai pas deux fois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0adce17-d106-3f84-9adf-3591c3e481b3",
                                        "entry_id": "28b81c0e-9a68-3730-8578-5924a7a4a1bc",
                                        "glosses": [
                                            "Répéter, dire à son tour ce qu’un autre a dit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ee1f6bd-f34d-4610-aeee-2d001b2c6ade",
                                                "sense_id": "e0adce17-d106-3f84-9adf-3591c3e481b3",
                                                "text": "Le héraut redit à Rébecca les paroles du grand maître ; […]."
                                            },
                                            {
                                                "example_id": "49c3c2df-959a-412f-bbb0-9c7aa336d50c",
                                                "sense_id": "e0adce17-d106-3f84-9adf-3591c3e481b3",
                                                "text": "[…] et les bergers conduisant les troupeaux, et les bœufs couchés dans la prairie, redisaient la chanson, l’épouvantable, la suppliciante chanson de Carmen."
                                            },
                                            {
                                                "example_id": "adf8aaf5-598e-416c-9896-4cdb3c7ed5ef",
                                                "sense_id": "e0adce17-d106-3f84-9adf-3591c3e481b3",
                                                "text": "Et sur ce boulevard de Clichy, ainsi modernisé, une femme arrivait à chaque fin d'après-midi, et de vieux Montmartrois se redisaient son nom à son passage : La Goulue !"
                                            },
                                            {
                                                "example_id": "d76f8262-b8ec-4e1b-a9f1-f6b1a20e01f5",
                                                "sense_id": "e0adce17-d106-3f84-9adf-3591c3e481b3",
                                                "text": "La quakeresse répéta en détail la conversation qu'elle avait entendue la veille. Sa mémoire était excellente et elle put redire mot pour mot les propos des officiers britanniques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67e71042-b180-3935-9494-5f69157cee07",
                                        "entry_id": "28b81c0e-9a68-3730-8578-5924a7a4a1bc",
                                        "glosses": [
                                            "Révéler ce qu’on a appris de quelqu’un en confidence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fa89b85-4478-409d-b841-2904842b0489",
                                                "sense_id": "67e71042-b180-3935-9494-5f69157cee07",
                                                "text": "Il va redire tout ce qu’on lui dit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c841e4c-b0d3-3d18-8092-fe82f1008ecc",
                                        "entry_id": "28b81c0e-9a68-3730-8578-5924a7a4a1bc",
                                        "glosses": [
                                            "Retracer, célébrer."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cffad72-6fb2-4820-b500-a7512ef2993c",
                                                "sense_id": "3c841e4c-b0d3-3d18-8092-fe82f1008ecc",
                                                "text": "L’histoire et la poésie redisent les exploits d’Alexandre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1982990f-18fb-39c7-8faf-a1045d5405ba",
                                        "entry_id": "28b81c0e-9a68-3730-8578-5924a7a4a1bc",
                                        "glosses": [
                                            "Reprendre, blâmer, censurer."
                                        ],
                                        "tags": [],
                                        "note": "En ce sens, il ne s’emploie qu’à l’infinitif",
                                        "examples": [
                                            {
                                                "example_id": "f10b6f52-b1ce-472c-90a3-d0d851ff6dbd",
                                                "sense_id": "1982990f-18fb-39c7-8faf-a1045d5405ba",
                                                "text": "Je n’ai rien trouvé à redire dans cet ouvrage."
                                            },
                                            {
                                                "example_id": "4de4b8ce-2dbc-47e4-840c-3116a4cf5466",
                                                "sense_id": "1982990f-18fb-39c7-8faf-a1045d5405ba",
                                                "text": "Il trouve à redire à tout ce qu’on fait."
                                            },
                                            {
                                                "example_id": "1397807c-9086-4557-a5ba-6feba1984d61",
                                                "sense_id": "1982990f-18fb-39c7-8faf-a1045d5405ba",
                                                "text": "Il n’y a rien à redire à sa conduite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe7214bf-0e98-3e09-840f-25fd3f7e3c55",
                                        "entry_id": "28b81c0e-9a68-3730-8578-5924a7a4a1bc",
                                        "glosses": [
                                            "Confirmer."
                                        ],
                                        "tags": [
                                            "Belgique",
                                            "Suisse"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32f955ca-67a6-4839-968e-1d25f045bc49",
                                                "sense_id": "fe7214bf-0e98-3e09-840f-25fd3f7e3c55",
                                                "text": "Je te redis quoi pour jeudi soir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d49fac7-a6e6-3eaa-bca6-584eb112a1e9",
                                        "entry_id": "28b81c0e-9a68-3730-8578-5924a7a4a1bc",
                                        "glosses": [
                                            "Tenir au courant."
                                        ],
                                        "tags": [
                                            "Belgique",
                                            "Suisse"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
