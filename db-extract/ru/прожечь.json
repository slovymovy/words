                    }
                ],
                "senses": [
                    {
                        "sense_id": "6378d9e0-4d8e-3c3f-8e65-370278afd4e5",
                        "entry_id": "03322ba7-4b7a-379a-860c-734eff7c42fa",
                        "glosses": [
                            "проделать в чём-либо дыру огнём, чем-либо едким"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "02af212c-1633-413e-9666-909e030122c9",
                        "source_entry_id": "03322ba7-4b7a-379a-860c-734eff7c42fa",
                        "source_sense_id": "6378d9e0-4d8e-3c3f-8e65-370278afd4e5",
                        "target_lang_word": "brûler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brûler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "849cb7ba-56aa-34ba-9c1d-c92109564672",
                                        "entry_id": "0d45fce7-c803-3146-8208-70f738a1de54",
                                        "glosses": [
                                            "Consumer, corroder ou endommager par le feu, ou par produits chimiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3661a6a2-703a-4b19-92e3-e6b420f057d9",
                                                "sense_id": "849cb7ba-56aa-34ba-9c1d-c92109564672",
                                                "text": "Nulle main laborieuse ne relèvera les toitures enfoncées ; nulle flamme ne brûlera plus aux âtres désertés."
                                            },
                                            {
                                                "example_id": "8bbae9ab-0ae6-4927-848b-a14ac9e4a920",
                                                "sense_id": "849cb7ba-56aa-34ba-9c1d-c92109564672",
                                                "text": "Hippocrate sauva Athènes de la peste en brûlant dans les rues des bois aromatiques et en faisant suspendre partout des paquets de fleurs parfumées."
                                            },
                                            {
                                                "example_id": "69d3eb7e-2fc5-48c1-b02f-89c3daca2141",
                                                "sense_id": "849cb7ba-56aa-34ba-9c1d-c92109564672",
                                                "text": "Des stères à brûler, des fagots de rondins, des bourrées de coupilles, des tas d’ételles et des « carottes » d’épicéas s’y empilent."
                                            },
                                            {
                                                "example_id": "41a52034-ecbf-420f-853a-c6fae77cdc1f",
                                                "sense_id": "849cb7ba-56aa-34ba-9c1d-c92109564672",
                                                "text": "Après un certains laps de temps, les femmes brûlent les défrichements au feu courant. Ensuite elles ramassent les débris et les réincinèrent en petits tas."
                                            },
                                            {
                                                "example_id": "826d7081-a796-41fc-89d5-53c46f77d9ef",
                                                "sense_id": "849cb7ba-56aa-34ba-9c1d-c92109564672",
                                                "text": "La température à laquelle le kérosène brûle est suffisante pour faire perdre à l’acier environ 75 % de sa force."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "def70241-3517-331b-a062-11d8cc6cda52",
                                        "entry_id": "0d45fce7-c803-3146-8208-70f738a1de54",
                                        "glosses": [
                                            "Faire du feu de quelque matière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84cc5454-dbd4-41cf-b981-0c42283f5a76",
                                                "sense_id": "def70241-3517-331b-a062-11d8cc6cda52",
                                                "text": "Dans ce pays, on ne brûle que du charbon de terre, que de la tourbe."
                                            },
                                            {
                                                "example_id": "db653671-da6a-449b-b75a-d64147fae60e",
                                                "sense_id": "def70241-3517-331b-a062-11d8cc6cda52",
                                                "text": "Brûler de la cire, de la chandelle, de l’huile, du pétrole : Se servir de bougie, de chandelle, d’une lampe à huile ou à pétrole pour éclairer."
                                            },
                                            {
                                                "example_id": "7bcca77c-8a43-44c4-8b6e-308f0a47ba25",
                                                "sense_id": "def70241-3517-331b-a062-11d8cc6cda52",
                                                "text": "De l’huile à brûler. — Brûler du bois, de la paille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a38058d-7b4d-31c8-9064-7b1d00a8bf1d",
                                        "entry_id": "0d45fce7-c803-3146-8208-70f738a1de54",
                                        "glosses": [
                                            "Subir l’action trop vive ou trop prolongée du feu qui donne une couleur rousse ou noire et un goût désagréable aux mets."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4538293-5033-4291-bcd6-3076a69270d7",
                                                "sense_id": "0a38058d-7b4d-31c8-9064-7b1d00a8bf1d",
                                                "text": "Vous avez laissé brûler ce rôti."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2bca4507-fff9-3fe2-b39d-97394b067c36",
                                        "entry_id": "0d45fce7-c803-3146-8208-70f738a1de54",
                                        "glosses": [
                                            "Échauffer excessivement, causer une violente chaleur, dessécher par une chaleur excessive."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ffbd9ee-a805-413d-a925-ef68a9098d47",
                                                "sense_id": "2bca4507-fff9-3fe2-b39d-97394b067c36",
                                                "text": "Le soleil lui a brûlé le teint."
                                            },
                                            {
                                                "example_id": "bca41c15-bfaf-49a9-af9a-9a296ceebc53",
                                                "sense_id": "2bca4507-fff9-3fe2-b39d-97394b067c36",
                                                "text": "Cette liqueur me brûle le palais, le gosier, l’estomac."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbaaea91-d525-38b8-b45c-c5dfcbe4e413",
                                        "entry_id": "0d45fce7-c803-3146-8208-70f738a1de54",
                                        "glosses": [
                                            "Échauffer excessivement, causer une violente chaleur, dessécher par une chaleur excessive.",
                                            "Causer une douleur vive."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively",
                                            "hyperbole"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a64da02-07d9-4a91-973a-773803dcb68e",
                                                "sense_id": "fbaaea91-d525-38b8-b45c-c5dfcbe4e413",
                                                "text": "J’avais comme une barre à l’estomac, et dans le cerveau quelque chose qui me brûlait. Je fus près de défaillir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "610a6812-b88c-33e7-b667-e88b8c8dd9d9",
                                        "entry_id": "0d45fce7-c803-3146-8208-70f738a1de54",
                                        "glosses": [
                                            "Être dévoré d’une passion pressante."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6f76eeb-7915-4ed4-b2ee-eb1ed022433d",
                                                "sense_id": "610a6812-b88c-33e7-b667-e88b8c8dd9d9",
                                                "text": "La dame brûlait du désir d’ébruiter une nouvelle dont elle venait d’avoir la primeur."
                                            },
                                            {
                                                "example_id": "33bf75dc-2bfc-43fe-951b-6c210ce530ad",
                                                "sense_id": "610a6812-b88c-33e7-b667-e88b8c8dd9d9",
                                                "text": "Doña Luz est on ne peut pas plus inquiète de son oncle, elle brûle de le revoir."
                                            },
                                            {
                                                "example_id": "ed9584c9-6649-4186-8f87-508127f596f2",
                                                "sense_id": "610a6812-b88c-33e7-b667-e88b8c8dd9d9",
                                                "text": "Les artilleurs, qui, à la capitulation, avaient reçu l’ordre de cesser le feu, n’avaient pas quitté leur poste […] Les soldats déclarèrent qu’ils n’avaient pas eu une seule occasion de tirer, et ils brûlaient du désir de montrer ce qu’ils savaient faire."
                                            },
                                            {
                                                "example_id": "b40d998d-68cc-4e3a-a9ce-20cc4462218c",
                                                "sense_id": "610a6812-b88c-33e7-b667-e88b8c8dd9d9",
                                                "text": "Sa froideur a, pour moi, tant d’attraits, qu’elle me brûle et me glace. J’ai beau savoir qu’au fond de ce regard, tout est calcul et complaisance, où qu’il m’entraîne, je le suivrai."
                                            },
                                            {
                                                "example_id": "157dd543-7af4-4fe8-8947-491f0b2cbbc8",
                                                "sense_id": "610a6812-b88c-33e7-b667-e88b8c8dd9d9",
                                                "text": "Une question me brûle les lèvres, je ne peux pas m’empêcher de la poser."
                                            },
                                            {
                                                "example_id": "40766d50-9209-493b-835e-1507c3c9609c",
                                                "sense_id": "610a6812-b88c-33e7-b667-e88b8c8dd9d9",
                                                "text": "Les mains lui brûlent : Il est impatient d’agir."
                                            },
                                            {
                                                "example_id": "e420c611-97e4-4b8a-ac6d-a4da2621e7f2",
                                                "sense_id": "610a6812-b88c-33e7-b667-e88b8c8dd9d9",
                                                "text": "Les pieds lui brûlent : Il est impatient de sortir, de s’en aller."
                                            },
                                            {
                                                "example_id": "ddb35b2c-a388-4824-933a-1d91bf3d08c7",
                                                "sense_id": "610a6812-b88c-33e7-b667-e88b8c8dd9d9",
                                                "text": "Un mois avant les journées de février, Eugène devint inquiet ; un flair particulier lui fit deviner la crise. Dès lors, le pavé de Plassans lui brûla les pieds. On le vit rôder sur les promenades comme une âme en peine. Puis il se décida brusquement, il partit pour Paris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35b243e4-9e17-3ff3-aa61-ee91e99a38ea",
                                        "entry_id": "0d45fce7-c803-3146-8208-70f738a1de54",
                                        "glosses": [
                                            "Ignorer un obstacle ou une étape pour atteindre un objectif."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e5ae56a-fb6b-4fd3-8a33-e434f4d38b42",
                                                "sense_id": "35b243e4-9e17-3ff3-aa61-ee91e99a38ea",
                                                "text": "Cette marche ressemblait à une fuite. Troppmann marchait devant nous […] Il se hâtait, évidemment, et nous autres nous nous hâtions à sa suite. […] Ainsi, nous brûlâmes le corridor, nous descendîmes un autre escalier."
                                            },
                                            {
                                                "example_id": "cc580f72-001d-4afe-9e4d-5fe807b79947",
                                                "sense_id": "35b243e4-9e17-3ff3-aa61-ee91e99a38ea",
                                                "text": "Lorsque notre train « brûle » les petites stations qu’il n’honore que d’un coup de sifflet au passage, le major m’eût dit si telle ou telle n’avait point été le théâtre de faits de guerre."
                                            },
                                            {
                                                "example_id": "9748f300-939b-4163-8de2-c92bcf077bd7",
                                                "sense_id": "35b243e4-9e17-3ff3-aa61-ee91e99a38ea",
                                                "text": "Toujours aimable, Manilov expliqua au cocher — à qui dans son zèle il donna même du vous — qu’il fallait brûler deux chemins de traverse et s’engager dans un troisième."
                                            },
                                            {
                                                "example_id": "58e5fecc-14a9-4b72-836c-fbec4e30374c",
                                                "sense_id": "35b243e4-9e17-3ff3-aa61-ee91e99a38ea",
                                                "text": "Essoufflé, haletant, on remarquait qu’il avait gravi l’escalier en courant et en brûlant la moitié des degrés."
                                            },
                                            {
                                                "example_id": "728d6f27-6273-4606-8216-df1e1f787a4b",
                                                "sense_id": "35b243e4-9e17-3ff3-aa61-ee91e99a38ea",
                                                "text": "Un autre courrier monté partit immédiatement pour Rabat et brûla, en moins de six heures, les 90 kilomètres qui séparent les deux villes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc4d25d9-66ea-3bb3-9ac2-3e7eee122492",
                                        "entry_id": "0d45fce7-c803-3146-8208-70f738a1de54",
                                        "glosses": [
                                            "Être consumé par le feu."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afca8a82-1209-4687-b3e8-41fcdfa8c29a",
                                                "sense_id": "bc4d25d9-66ea-3bb3-9ac2-3e7eee122492",
                                                "text": "Pendant de longs siècles, la maison resta bien fragile. A peine différente d'une cabane de bois dans les forêts, bicoque de limon très souvent, elle brûlait ou elle fondait pour un rien."
                                            },
                                            {
                                                "example_id": "965d7bab-d6d0-4ae0-96c4-3b3addd21b90",
                                                "sense_id": "bc4d25d9-66ea-3bb3-9ac2-3e7eee122492",
                                                "text": "Et ils s'en retournent dans leur pays, admirant la longanimité d'Allah qui permet à une race aussi dévergondée d'opprimer les croyants, mais consolés par la certitude qu'au jugement dernier les infidèles n'échapperont pas à leur juste châtiment, qu'ils seront la proie de Chaïtân et brûleront éternellement en enfer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9e1ae43-364b-31e1-9a2f-d98cc7ceda62",
                                        "entry_id": "0d45fce7-c803-3146-8208-70f738a1de54",
                                        "glosses": [
                                            "Être fort chaud."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c433cde9-867b-4b77-b52e-87271fc1c2fd",
                                                "sense_id": "f9e1ae43-364b-31e1-9a2f-d98cc7ceda62",
                                                "text": "Touchez ses mains, elles brûlent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90cefbb2-b113-3af8-8e6d-145d20fe0260",
                                        "entry_id": "0d45fce7-c803-3146-8208-70f738a1de54",
                                        "glosses": [
                                            "Briller, luire."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2ed0c18-f8c2-4696-a6f8-58b80bc81b14",
                                                "sense_id": "90cefbb2-b113-3af8-8e6d-145d20fe0260",
                                                "text": "Une ampoule brûlait à l’extrémité du passage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87d78bbc-ad86-3362-8d29-63a26e738bd6",
                                        "entry_id": "0d45fce7-c803-3146-8208-70f738a1de54",
                                        "glosses": [
                                            "Être près d’un objectif, toucher au but."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f21c031e-a522-45fa-80a5-55b2a29cd980",
                                                "sense_id": "87d78bbc-ad86-3362-8d29-63a26e738bd6",
                                                "text": "La solution n’est pas loin, nous brûlons."
                                            },
                                            {
                                                "example_id": "8b1986a1-7c37-4b99-ab5a-c9a729f5a807",
                                                "sense_id": "87d78bbc-ad86-3362-8d29-63a26e738bd6",
                                                "text": "[…] si l’on s’en rapporte à toutes les recherches que M. Vulfran fait faire, fiévreusement, comme s’il brûlait sur une bonne piste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07ce3ce7-1513-399e-a8fa-c990924f5f66",
                                        "entry_id": "0d45fce7-c803-3146-8208-70f738a1de54",
                                        "glosses": [
                                            "Subir le feu."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f52d8ab-0ce9-3a3e-9246-a4ac3aa23a41",
                                        "entry_id": "0d45fce7-c803-3146-8208-70f738a1de54",
                                        "glosses": [
                                            "Traverser une frontière illégalement au risque de mourir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2361227-4ca9-47ea-9f28-735dd39d39c0",
                                                "sense_id": "2f52d8ab-0ce9-3a3e-9246-a4ac3aa23a41",
                                                "text": "Je pensais que mon fils allait partir de façon légale et j’en étais fier. Mais des gens, des trafiquants, des assassins, lui ont fait croire qu’il était plus rapide et moins cher de brûler."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f0bdd00-93b5-3c4b-896c-4feedddb9287",
                                        "entry_id": "0d45fce7-c803-3146-8208-70f738a1de54",
                                        "glosses": [
                                            "Rendre insupportable le contact avec quelque chose ou le séjour dans un certain endroit."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1396663-1208-40a3-a3ea-772b641bd62c",
                                                "sense_id": "2f0bdd00-93b5-3c4b-896c-4feedddb9287",
                                                "text": "L’argent lui brûle les doigts."
                                            },
                                            {
                                                "example_id": "ceaa81d4-a72b-484f-8f02-3124f88ced8d",
                                                "sense_id": "2f0bdd00-93b5-3c4b-896c-4feedddb9287",
                                                "text": "Maintenant, qu’il n’avait plus rien à craindre pour sa petite-fille, Paris lui brûlait les pieds, comme il disait lui-même."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2098781e-c9cc-309a-bc6a-767a5be80182",
                                        "entry_id": "0d45fce7-c803-3146-8208-70f738a1de54",
                                        "glosses": [
                                            "Utiliser un transport sans avoir de billet, sans payer. On retrouve cette acception dans des expressions comme brûler le dur (prendre le train ou le métro sans payer), brûler le bateau (naviguer clandestinement)."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d88e911a-248b-30ad-a4e0-73d17d6fb178",
                                        "entry_id": "0d45fce7-c803-3146-8208-70f738a1de54",
                                        "glosses": [
                                            "Tuer d'un coup de feu."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf2aa3be-91b1-420a-b084-5638826c06e5",
                                                "sense_id": "d88e911a-248b-30ad-a4e0-73d17d6fb178",
                                                "text": "– Si tu bouges, je te brûle…"
                                            },
                                            {
                                                "example_id": "e7631103-5b76-4838-9f44-e22944f176cb",
                                                "sense_id": "d88e911a-248b-30ad-a4e0-73d17d6fb178",
                                                "text": "« Écoute bien, Frédéric, si tu fais un geste, si tu dis un mot, c’est toi que je brûle. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
