                    {
                        "translation_id": "500dccc2-7a0d-435e-a3f8-ebc5a7119e7c",
                        "source_entry_id": "1625617f-b252-3896-8f56-e6077170d4be",
                        "source_sense_id": "b6ddd17f-67f2-3c77-8332-f7ae472d5c4e",
                        "source_sense_description": "the ability to cope with situations",
                        "target_lang_word": "Einfallsreichtum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einfallsreichtum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c9ac02cd-bffc-386d-acd4-6a79d6d8ef50",
                                        "entry_id": "cecfbfaf-8f59-3ce2-a52c-df636974b75b",
                                        "glosses": [
                                            "Vorhandensein vieler Einfälle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "844a60da-80cd-4b87-b078-b6bc87b2a92a",
                                                "sense_id": "c9ac02cd-bffc-386d-acd4-6a79d6d8ef50",
                                                "text": "„Nur wird fantasievoller und witziger geschimpft - und man hat den Eindruck, dem Einfallsreichtum der Schimpfenden sind keine Grenzen gesetzt.“"
                                            },
                                            {
                                                "example_id": "80e67d5a-65d7-481b-9bc1-70e41380840f",
                                                "sense_id": "c9ac02cd-bffc-386d-acd4-6a79d6d8ef50",
                                                "text": "„Was sie auszeichnete, war einzig ein gewisser Einfallsreichtum an Verwahrlosung, der sich bis auf die Straßen und in die Hinterhöfe fortsetzte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "644f0351-53c1-463c-879a-20cbed014b13",
                        "source_entry_id": "1625617f-b252-3896-8f56-e6077170d4be",
                        "source_sense_id": "b6ddd17f-67f2-3c77-8332-f7ae472d5c4e",
                        "source_sense_description": "the ability to cope with situations",
                        "target_lang_word": "Findigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Findigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3cf1aee8-0f23-3563-9e64-b9e3d22029cb",
                                        "entry_id": "307d745d-c1ee-3ec3-b62f-7539219a7d4f",
                                        "glosses": [
                                            "die Eigenschaft, findig zu sein"
                                        ],
                                        "tags": [
                                            "meist Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6436fd17-3589-4896-9f9e-6862ae958d06",
                                                "sense_id": "3cf1aee8-0f23-3563-9e64-b9e3d22029cb",
                                                "text": "„Am meisten faszinierte ihn die Findigkeit der Arbeiter beim Diebstahl.“"
                                            },
                                            {
                                                "example_id": "1508c1f2-2775-4645-88b3-ff20fa5692c1",
                                                "sense_id": "3cf1aee8-0f23-3563-9e64-b9e3d22029cb",
                                                "text": "„Das alles soll in diesem kurzen Strich stecken, auch der für seine Tüchtigkeit, seine Findigkeit und Fertigkeit gerühmte Fischer, dem vor keinem Wetter bange war, der zu viel trank, zugleich aber über einen unstillbaren Wissensdurst verfügte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de8aa032-7759-4377-b93a-0b97e90f6301",
                        "source_entry_id": "1625617f-b252-3896-8f56-e6077170d4be",
                        "source_sense_id": "b6ddd17f-67f2-3c77-8332-f7ae472d5c4e",
                        "source_sense_description": "the ability to cope with situations",
                        "target_lang_word": "Genialität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Genialität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2568e574-614a-37bc-8bf1-68577dc8bab5",
                                        "entry_id": "0c9821dd-1ae7-36d0-8082-3d945aebfd4c",
                                        "glosses": [
                                            "Eigenschaft, in höchstem Maße begabt zu sein"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80286b4c-887e-42a4-83df-023d14f99162",
                                                "sense_id": "2568e574-614a-37bc-8bf1-68577dc8bab5",
                                                "text": "„Sie bewunderte seine Genialität als Komponist und liebte seine Stücke, als wären es Gaben eigens für sie.“"
                                            },
                                            {
                                                "example_id": "d617354e-2428-4802-8122-f26796ece1a7",
                                                "sense_id": "2568e574-614a-37bc-8bf1-68577dc8bab5",
                                                "text": "„Kein Mobiltelefon, kein Notebook, kein GPS wäre je erfunden worden, wenn nicht Querdenker wie Einstein, Bohr oder Planck ihre Genialität darauf verwendet hätten, jahrhundertealte Vorstellungen über Raum und Zeit umzustürzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9af43c0b-2439-3e12-8e20-c10928de2a5d",
                                        "entry_id": "0c9821dd-1ae7-36d0-8082-3d945aebfd4c",
                                        "glosses": [
                                            "das Sein, die Eigenschaft, der Gedanke, die Handlung, die das Geniale widerspiegelt"
                                        ],
                                        "tags": [
                                            "mit Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50efe993-5d16-4740-a475-f4929283b01c",
                                                "sense_id": "9af43c0b-2439-3e12-8e20-c10928de2a5d",
                                                "text": "„Gauss hat gezeigt, daß einzelne Zahlen eigentümliche Genialitäten besitzen, so die 17, die 257. Die große Masse der Zahlen verliert sich bestimmten Anforderungen gegenüber in der Herde, während andere sich auszeichnen.“"
                                            },
                                            {
                                                "example_id": "446a50a6-712d-4888-8f10-c9237aa0145e",
                                                "sense_id": "9af43c0b-2439-3e12-8e20-c10928de2a5d",
                                                "text": "„Sie nimmt die heftigsten Genialitäten Regers mit in den Kauf, da sie doch immerhin überzeugt ist, daß der Mann viel studiert, seinen Bach im kleinen Finger hat und nur etwas Rechtes, Gerades in der Welt beabsichtigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
