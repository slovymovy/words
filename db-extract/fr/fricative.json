                "senses": [
                    {
                        "sense_id": "14f1a693-7725-37ef-8c64-2a87ff2da3d4",
                        "entry_id": "ba7d133d-3b3a-3246-9368-a07580a07b73",
                        "glosses": [
                            "Classe de consonnes dont le mode d’articulation est la frication."
                        ],
                        "tags": [
                            "generically"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "59491128-7ac9-3ba9-8548-14cde1f8cc54",
                        "entry_id": "ba7d133d-3b3a-3246-9368-a07580a07b73",
                        "glosses": [
                            "Consonne fricative."
                        ],
                        "tags": [
                            "ellipsis",
                            "specifically"
                        ],
                        "examples": [
                            {
                                "example_id": "585b389c-0c70-45cf-b6a4-61615a129ff5",
                                "sense_id": "59491128-7ac9-3ba9-8548-14cde1f8cc54",
                                "text": "Le consonantisme français contient, en particulier, la nasale palatale, la fricative ou vibrante uvulaire, l'articulation dentale des [t d n]. L'anglais a des fricatives dentales, la nasale vélaire, les affriquées, les [p t k] aspirés sous accent, l'assibilation des [s z t d]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57787c45-86c6-4409-9f13-818ab43dd4f5",
                        "source_entry_id": "ba7d133d-3b3a-3246-9368-a07580a07b73",
                        "target_lang_word": "Frikativ",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frikativ",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "38159255-3121-37a4-83e5-d9b06bb65b75",
                                        "entry_id": "cb4e4c3d-edd0-35c2-889d-48163962f272",
                                        "glosses": [
                                            "Laut, der durch Reibung mittels Verengung des Artikulationskanals erzeugt wird. Eine besondere Untergruppe sind die so genannten Zischlaute (Sibilanten) wie [s] und [z]."
                                        ],
                                        "tags": [
                                            "speziell Phonetik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf75e961-5ab6-4695-b5b1-9aad4223a995",
                                                "sense_id": "38159255-3121-37a4-83e5-d9b06bb65b75",
                                                "text": "Im Deutschen gibt es folgende Frikative: [ç]/stimmlos/Licht, König/ch, g (nur in der Verbindung -ig); [f]/stimmlos/Fisch, Affe, Vogel, Alphabet/f, ff, v, ph; [h]/stimmlos/Hand/h; [j]/stimmhaft/Jacke, Jacht/j, y; [v]/stimmhaft/Wand, Vase/w, v; [χ]/stimmlos/Kuchen/ch; [s]/stimmlos/Bus, Tasse, Straße, City/s, ss, ß, c; [ʃ]/stimmlos/Schaufel, Stein, Spinne, Shampoo, Chance/sch, s(t), s(p), sh, ch; [z]/stimmhaft/Saft, Rose/s; [ʒ]/stimmhaft/Garage, Jalousie/g, j"
                                            },
                                            {
                                                "example_id": "22d11048-0080-4709-802a-76544855ca19",
                                                "sense_id": "38159255-3121-37a4-83e5-d9b06bb65b75",
                                                "text": "„Die übrigen betroffenen Konsonanten verteilen sich auf vier weitere Frikative, drei Plosive und einen Nasallaut.“"
                                            },
                                            {
                                                "example_id": "c4a97918-07e6-4414-8f0d-4f1ad3ef1562",
                                                "sense_id": "38159255-3121-37a4-83e5-d9b06bb65b75",
                                                "text": "„Die Analyse wurde dabei auf die Untersuchungsdaten oraler Plosive und Frikative beschränkt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48cfe8c6-1741-48fa-8665-ab417381ea7b",
                        "source_entry_id": "ba7d133d-3b3a-3246-9368-a07580a07b73",
