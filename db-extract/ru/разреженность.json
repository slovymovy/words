                                        "sense_id": "f6036a59-f86a-3309-8cc3-63f717219479",
                                        "entry_id": "3d32c2e1-6556-3b20-a537-1a0924a2a446",
                                        "glosses": [
                                            "A reduction in the density of a material, especially that of a fluid."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f38e3883-1f8f-4de2-897b-6d5c843a5360",
                                                "sense_id": "f6036a59-f86a-3309-8cc3-63f717219479",
                                                "text": "[T]his ſeal'd vial, being broken under water, ſuck'd in a conſiderable quantity of it, whether, becauſe of ſome little rarefaction of the Air included in the ſealing, or becauſe of the infrigidation of that Air by the ſnow, or for both theſe Reaſons, or any other, I ſhall not Now diſpute."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c28ca97-3b2a-4946-a1a2-dc845bc1ea04",
                        "source_entry_id": "018a7f8f-32e9-3c98-8988-0ade73c01a6e",
                        "source_sense_id": "075e3502-9d40-31d6-9c53-872fd4fb37d0",
                        "target_lang_word": "rarity",
