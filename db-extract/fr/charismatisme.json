                "senses": [
                    {
                        "sense_id": "b0ebcbfc-ba45-3aff-a130-43ec1e098086",
                        "entry_id": "bc3f9f8d-7d43-34ae-9276-c9aff2850cc2",
                        "glosses": [
                            "Ensemble de dons surnaturels que l'Esprit-Saint confère à chaque croyant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dd091726-4ab0-4840-be2c-65ec720e8d94",
                                "sense_id": "b0ebcbfc-ba45-3aff-a130-43ec1e098086",
                                "text": "Les personnes sont multiples et ne doivent pas se dissoudre. Le Christ intègre tous ses membres dans l'unité de son corps et l'Esprit Saint fait s'épanouir chacun dans son charismatisme personnel."
                            },
                            {
                                "example_id": "628abb09-8440-4059-8ce3-948d49762fd9",
                                "sense_id": "b0ebcbfc-ba45-3aff-a130-43ec1e098086",
                                "text": "La hiérarchie est le seul service charismatique dans l'Église, dont la valeur demeure et qui compense par sa réalité l'absence d'un charismatisme extraordinaire, encore qu'il ne l'exclut point."
                            }
                        ]
                    },
                    {
                        "sense_id": "2e38cb32-246f-3b47-bf13-027d993da502",
                        "entry_id": "bc3f9f8d-7d43-34ae-9276-c9aff2850cc2",
                        "glosses": [
                            "Mouvement charismatique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c400e9a-4011-41e4-8eff-f4977d668d71",
                                "sense_id": "2e38cb32-246f-3b47-bf13-027d993da502",
                                "text": "…une volonté de contrer l'attirance de nombreux chrétiens américains, en particulier en provenance d'Afrique et d'Amérique latine, pour des formes de croyances moins établies, comme le pentecôtisme et le charismatisme."
                            }
                        ]
                    }
