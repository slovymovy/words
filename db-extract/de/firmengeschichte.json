                        "examples": [
                            {
                                "example_id": "70a773f1-c2e4-45f2-b567-9efaaaa3c8ea",
                                "sense_id": "c69eaf08-7f30-3059-be6b-f75898424399",
                                "text": "„Ich möchte euch hier einen Einblick in die Firmengeschichte von Clinique gewähren.“"
                            },
                            {
                                "example_id": "21150bd7-1440-4d7b-8b95-fc64690c65f8",
                                "sense_id": "c69eaf08-7f30-3059-be6b-f75898424399",
                                "text": "„Wir unterstützen die Marketingaktivität von Unternehmen; wir recherchieren und schreiben Firmengeschichten, realisieren Ausstellungen, gestalten Apps, richten Archive ein und beraten Unternehmensleitungen sowie Kommunikationsabteilungen.“"
                            },
                            {
                                "example_id": "a0871d77-95b6-489a-8a5b-380a4495fd52",
                                "sense_id": "c69eaf08-7f30-3059-be6b-f75898424399",
                                "text": "„Unsere Firmengeschichte ist den meisten von euch schon bekannt, ein Familienbetrieb der 1906 von meinem Urgroßvater gegründet wurde und seinen Sitz im schönen Lungau hat.“"
                            }
                        ],
