                        "source_sense_id": "bae6251f-52d6-3562-bbf7-b26833487a5e",
                        "source_sense_description": "jemand, der dasselbe Ziel verfolgt wie ein anderer, so dass beide zusammen für dieses Ziel kämpfen",
                        "target_lang_word": "mededinger",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mededinger",
