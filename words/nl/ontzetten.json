{
    "word_family": [
        "ontzetting",
        "ontzettend"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2bc83b4f-7cb7-3718-8bad-fc893724cf8c",
                    "sense_definition": "iemand hevig doen schrikken of verbijsteren",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ben zwaar <w>ontzet</w> door wat er gisteren is gebeurd.",
                            "target_lang_translations": {
                                "en": "I am deeply <w>appalled</w> by what happened yesterday.",
                                "ru": "Я глубоко <w>потрясен</w> тем, что произошло вчера."
                            }
                        },
                        {
                            "text": "Het nieuws over het ongeluk zal de hele familie <w>ontzetten</w>.",
                            "target_lang_translations": {
                                "en": "The news of the accident will <w>dismay</w> the entire family.",
                                "ru": "Новости об аварии <w>ужаснут</w> всю семью."
                            }
                        }
                    ],
                    "synonyms": [
                        "verbijsteren",
                        "onthutsen",
                        "ontstellen"
                    ],
                    "common_phrases": [
                        "zwaar ontzet"
                    ],
                    "target_lang_definitions": {
                        "en": "to shock, appall, or dismay someone greatly",
                        "ru": "сильно напугать, шокировать или привести в замешательство"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "appall",
                                "target_lang_sense_clarification": "to fill with horror or indignation"
                            },
                            {
                                "target_lang_word": "dismay",
                                "target_lang_sense_clarification": "to cause to feel apprehension or great sadness"
                            },
                            {
                                "target_lang_word": "shock",
                                "target_lang_sense_clarification": "to cause a sudden feeling of horror or surprise"
                            },
                            {
                                "target_lang_word": "alarm",
                                "target_lang_sense_clarification": "to fill with anxiety or sudden fear"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "ужасать",
                                "target_lang_sense_clarification": "приводить в состояние глубокого потрясения"
                            },
                            {
                                "target_lang_word": "шокировать",
                                "target_lang_sense_clarification": "вызывать сильное потрясение"
                            },
                            {
                                "target_lang_word": "приводить в замешательство",
                                "target_lang_sense_clarification": "сбивать с толку и пугать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "703c6c8a-f880-3034-a9ab-bbcd1e5e7258",
                    "sense_definition": "iemand uit een officiële functie of waardigheid ontnemen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "functie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De priester werd na het schandaal direct uit zijn ambt <w>ontzet</w>.",
                            "target_lang_translations": {
                                "en": "The priest was immediately <w>dismissed</w> from his office after the scandal.",
                                "ru": "Сразу после скандала священник был <w>отстранен</w> от должности."
                            }
                        },
                        {
                            "text": "De rechter kan iemand officieel uit de voogdij <w>ontzetten</w>.",
                            "target_lang_translations": {
                                "en": "The judge can officially <w>remove</w> someone from guardianship.",
                                "ru": "Судья может официально <w>лишить</w> кого-либо прав опеки."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontslaan",
                        "royeren",
                        "afzetten"
                    ],
                    "common_phrases": [
                        "uit ambt ontzetten",
                        "uit voogdij ontzetten"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak in juridische of formele context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to remove someone from an official position, office, or legal capacity",
                        "ru": "лишить кого-либо официальной должности, звания или прав"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dismiss",
                                "target_lang_sense_clarification": "to end the employment or service of"
                            },
                            {
                                "target_lang_word": "discharge",
                                "target_lang_sense_clarification": "to relieve of an office or employment"
                            },
                            {
                                "target_lang_word": "remove",
                                "target_lang_sense_clarification": "to take away from a position or office"
                            },
                            {
                                "target_lang_word": "sack",
                                "target_lang_sense_clarification": "to fire from a job (informal)"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "отстранять",
                                "target_lang_sense_clarification": "временно или окончательно лишать должности"
                            },
                            {
                                "target_lang_word": "смещать",
                                "target_lang_sense_clarification": "лишать высокого поста или сана"
                            },
                            {
                                "target_lang_word": "лишать",
                                "target_lang_sense_clarification": "отнимать права или полномочия (например, родительские)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d43a93de-7923-3c9e-9ba9-cbd46bf36e00",
                    "sense_definition": "een belegering van een stad of vesting opheffen door hulp te bieden",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "militair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De troepen wisten de stad na maanden eindelijk te <w>ontzetten</w>.",
                            "target_lang_translations": {
                                "en": "The troops finally managed to <w>relieve</w> the city after months.",
                                "ru": "Спустя месяцы войскам наконец удалось <w>деблокировать</w> город."
                            }
                        },
                        {
                            "text": "Het leger probeerde de omsingelde vesting te <w>ontzetten</w> voor de winter.",
                            "target_lang_translations": {
                                "en": "The army tried to <w>liberate</w> the surrounded fortress before winter.",
                                "ru": "Армия пыталась <w>освободить</w> осажденную крепость до наступления зимы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stad ontzetten"
                    ],
                    "target_lang_definitions": {
                        "en": "to relieve a city or fortress from a siege by providing military aid",
                        "ru": "снять осаду с города или крепости, оказав военную помощь"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "relieve",
                                "target_lang_sense_clarification": "to bring military aid to a besieged place"
                            },
                            {
                                "target_lang_word": "liberate",
                                "target_lang_sense_clarification": "to set free from enemy control"
                            },
                            {
                                "target_lang_word": "raise the siege",
                                "target_lang_sense_clarification": "to end a blockade of a city"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "деблокировать",
                                "target_lang_sense_clarification": "снимать блокаду или осаду"
                            },
                            {
                                "target_lang_word": "освобождать",
                                "target_lang_sense_clarification": "вызволять из окружения или осады"
                            },
                            {
                                "target_lang_word": "снимать осаду",
                                "target_lang_sense_clarification": "прекращать окружение города войсками"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6066aff5-9882-30c8-b422-f8f79629fc88",
                    "sense_definition": "uit de juiste vorm of verband raken waardoor iets bezwijkt",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "constructie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de grote klap raakte een muur volledig <w>ontzet</w>.",
                            "target_lang_translations": {
                                "en": "Due to the heavy impact, a wall became completely <w>distorted</w>.",
                                "ru": "Из-за сильного удара стена полностью <w>перекосилась</w>."
                            }
                        },
                        {
                            "text": "De houten deur was door de vochtigheid helemaal <w>ontzet</w>.",
                            "target_lang_translations": {
                                "en": "The wooden door was completely <w>warped</w> due to the humidity.",
                                "ru": "Деревянную дверь совсем <w>покоробило</w> от влажности."
                            }
                        }
                    ],
                    "common_phrases": [
                        "muur ontzet"
                    ],
                    "target_lang_definitions": {
                        "en": "to become warped, distorted, or out of alignment, causing a structure to fail",
                        "ru": "деформироваться или выйти из правильного положения, нарушая целостность конструкции"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "warp",
                                "target_lang_sense_clarification": "to become twisted or bent out of shape"
                            },
                            {
                                "target_lang_word": "distort",
                                "target_lang_sense_clarification": "to pull or twist out of a natural shape"
                            },
                            {
                                "target_lang_word": "buckle",
                                "target_lang_sense_clarification": "to bend or give way under pressure"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "перекашиваться",
                                "target_lang_sense_clarification": "терять правильную форму или положение"
                            },
                            {
                                "target_lang_word": "деформироваться",
                                "target_lang_sense_clarification": "изменять форму под воздействием внешних сил"
                            },
                            {
                                "target_lang_word": "коробиться",
                                "target_lang_sense_clarification": "искривляться (обычно о дереве от влаги)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
