                                "target_senses": [
                                    {
                                        "sense_id": "1f751797-973b-346e-8181-2b913cac3234",
                                        "entry_id": "31a32364-1c63-3540-9fd6-d899eb2f09fb",
                                        "glosses": [
                                            "Of or characteristic of the philosopher Socrates or his philosophical methods and/or views."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0e81f49-b419-4dad-9e78-813ef338527f",
                                                "sense_id": "1f751797-973b-346e-8181-2b913cac3234",
                                                "text": "His closest companions were handsome young boys who worshipped him and his game, whom Bill sought to remake in his own image. He had no family, no real heirs, and so his boys were his spiritual sons as well as his heirs in tennis. They were his lovers as well. Theirs was a relationship of a Socratic sort, a pedagogical eroticism between an adolescent protege which ingaged them in a mutual project of spiritual and physical development."
                                            }
                                        ]
                                    }
                                ]
