                            {
                                "example_id": "c20c1c26-f0dc-4b21-a959-db74039cd7b7",
                                "sense_id": "b5a9dfe1-41f4-3836-a748-4393b3b6a9f9",
                                "text": "De brandende lampion die de kinderen, op de avond van Sint Maarten, zingend langs de huizen dragen, de kerstboom, de suizende lichtpijlen als het nieuwe jaar begint en de hoge sprong over het vuur op het zomerfeest van Sint Jan."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d587da9-e692-320c-973c-bb27902b76bf",
                        "entry_id": "9c3c16dc-df76-357c-88d6-92395c05c621",
                        "glosses": [
                            "van iets dat het licht en hitte uitstraalt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fda81a4-d65e-48fb-84ea-5c425629b624",
                                "sense_id": "6d587da9-e692-320c-973c-bb27902b76bf",
                                "text": "Na dagen in de brandende zon gelopen te hebben, verliet ik de trail om bij het hostel Burney Mountain Guest Ranch een dag goed bij te slapen."
                            }
                        ]
                    },
                    {
