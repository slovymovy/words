                        "sense_id": "9ac19f36-8220-34f0-b5e3-e02761504915",
                        "entry_id": "be344a4b-d131-3414-a533-f544f52be013",
                        "glosses": [
                            "Ensemble des traces laissées par l’impact d’une météorite ou d’un astéroïde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5a7107b-7b02-45fb-8550-9d02cf836515",
                                "sense_id": "9ac19f36-8220-34f0-b5e3-e02761504915",
                                "text": "L’astroblème caché sous la glace a été révélé indirectement par les données du satellite Grace, sensible aux anomalies locales du champ de gravité."
                            },
                            {
                                "example_id": "464e705c-20b9-4e10-973f-9cab80a043ea",
                                "sense_id": "9ac19f36-8220-34f0-b5e3-e02761504915",
                                "text": "Nous avons aussi au Québec l’« astroblème de Charlevoix », un ancien cratère d’impact météoritique d’un diamètre de 54 km."
                            }
                        ]
                    }
                ],
