                        "cross_references": [
                            {
                                "target_word": "phrénologue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "191a02ee-2da7-3194-bdde-566ae271e701",
                                        "entry_id": "642b0c87-f1cc-300d-b7fa-8b4b15901a7d",
                                        "glosses": [
                                            "Spécialiste de phrénologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5440a728-e4e3-4d68-b3ae-9c7d5590758c",
                                                "sense_id": "191a02ee-2da7-3194-bdde-566ae271e701",
                                                "text": "« Ma chère miss Jane, depuis quelques mois j’ai pris la résolution de me marier ; et comme j’ai la prétention d’être bon phrénologue et bon physionomiste, j’ai toujours compté obéir à la première sympathie bien franche et bien vive qu’une belle figure me ferait éprouver. »"
                                            },
                                            {
                                                "example_id": "89b2f9fd-df35-452e-aea6-5bb11e1d75df",
                                                "sense_id": "191a02ee-2da7-3194-bdde-566ae271e701",
                                                "text": "On répétait les détails du crime, on se demandait quelles seraient les opinions des phrénologues sur Troppmann."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26929e33-9775-3761-b7f2-3356ff7f4aa3",
                                        "entry_id": "642b0c87-f1cc-300d-b7fa-8b4b15901a7d",
                                        "glosses": [
                                            "Partisan du système phrénologique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a80d7dd3-5597-4c34-8f79-18a58e9621d3",
                                                "sense_id": "26929e33-9775-3761-b7f2-3356ff7f4aa3",
                                                "text": "Ô phrénologues ! L’inéducabilité érigée en principe ? quel inhominalisme ! La sublime créature est éducable, voyante et libre, criminelle ou vertueuse à son choix, responsable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
