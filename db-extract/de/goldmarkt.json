                "senses": [
                    {
                        "sense_id": "92669f81-3559-3464-a252-cffd6dccc8df",
                        "entry_id": "e9fdee16-e6f4-329c-bd31-274a37f62331",
                        "glosses": [
                            "Gesamtheit von Angeboten und Nachfrage das Edelmetall Gold betreffend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d71f08e-6696-480d-ae7b-ed54a2d907d9",
                                "sense_id": "92669f81-3559-3464-a252-cffd6dccc8df",
                                "text": "„Auch die Goldmärkte wurden durch die Transaktionen nicht beeinflusst.“"
                            },
                            {
                                "example_id": "99894b34-fee7-4594-920e-a383632c1595",
                                "sense_id": "92669f81-3559-3464-a252-cffd6dccc8df",
                                "text": "„Da auch Konkurrenzprodukte wie sichere Staatsanleihen oder Sparbücher de facto keine oder sogar negative Zinsen einbringen und gleichzeitig die Inflation in der Eurozone bei 1,4 Prozent liegt, bringen Anleger ihre Schäfchen nun am Goldmarkt ins Trockene – in der Hoffnung, dort der Kaufkraftentwertung entfliehen zu können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
