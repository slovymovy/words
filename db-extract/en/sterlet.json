                ],
                "senses": [
                    {
                        "sense_id": "b8b7468d-197b-375a-b134-2173f9926a64",
                        "entry_id": "5699dad8-10c4-3ca1-9c36-f4b5989e316f",
                        "glosses": [
                            "A smaller, common Eurasian sturgeon, of the species Acipenser ruthenus."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70b6a6d7-aaf6-4072-9356-c4b912be210c",
                        "source_entry_id": "5699dad8-10c4-3ca1-9c36-f4b5989e316f",
                        "source_sense_id": "b8b7468d-197b-375a-b134-2173f9926a64",
                        "source_sense_description": "species of sturgeon",
                        "target_lang_word": "Stör",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stör",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07248b96-4392-302f-a838-b2db42e87d0b",
                                        "entry_id": "88cce1a2-8481-3759-8106-7704cd968762",
                                        "glosses": [
                                            "ein Knochenfisch mit der Gattungsbezeichnung Acipenser, Lieferant von Kaviar (Rogen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ea2e044-a803-4c77-b2f9-49bdf31f8387",
                                                "sense_id": "07248b96-4392-302f-a838-b2db42e87d0b",
                                                "text": "Der Stör kam früher in der Elbe vor."
                                            },
                                            {
                                                "example_id": "da411594-a500-426f-9509-39e21b037907",
                                                "sense_id": "07248b96-4392-302f-a838-b2db42e87d0b",
                                                "text": "Es gibt mehrere Arten des Störs, die sowohl in reinem Süßwasser als auch in Salzwasser leben."
                                            },
                                            {
                                                "example_id": "6585beb4-6078-44ff-be3a-655ce7d02ebb",
                                                "sense_id": "07248b96-4392-302f-a838-b2db42e87d0b",
                                                "text": "„Zwischendurch gehen sie angeln und bringen ein paar Störe auf die Märkte der nordkaukasischen Städte, zum Beispiel nach Pjatigorsk, zu Deutsch Fünfberg.“"
                                            },
                                            {
                                                "example_id": "3913094a-017e-47cf-b468-5706791abc72",
                                                "sense_id": "07248b96-4392-302f-a838-b2db42e87d0b",
                                                "text": "„Roosa führte mich zu einem Becken, in dem Störe schwammen, die in Imatra gezüchtet wurden.“"
                                            },
                                            {
                                                "example_id": "62969bbd-85e2-4c07-a19e-e0823a6175ce",
                                                "sense_id": "07248b96-4392-302f-a838-b2db42e87d0b",
                                                "text": "„Die Wirtin, die mich als freigebig kennengelernt hatte, gab mir Wildpret und Stör.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Stör",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "abede736-201c-348e-a4a5-c4ca99c72c70",
                                        "entry_id": "ad87ac49-81ef-345b-8306-cde42521b3e0",
                                        "glosses": [
                                            "deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e088467b-48b9-402d-8ea2-78264395d98a",
                                                "sense_id": "abede736-201c-348e-a4a5-c4ca99c72c70",
                                                "text": "Frau Stör ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "c70aa893-4e22-4dc9-9db1-beff691edd93",
                                                "sense_id": "abede736-201c-348e-a4a5-c4ca99c72c70",
                                                "text": "Herr Stör wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "6a959f2e-1ae2-451f-93f4-1ba9b4716a76",
                                                "sense_id": "abede736-201c-348e-a4a5-c4ca99c72c70",
                                                "text": "Die Störs fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "fa197369-c8dc-45a0-8106-bf0f4a134cf7",
                                                "sense_id": "abede736-201c-348e-a4a5-c4ca99c72c70",
                                                "text": "Der Stör trägt nie die Schals, die die Stör ihm strickt."
                                            },
                                            {
                                                "example_id": "464d8a9e-0908-460c-96dd-4610ed6b97a4",
                                                "sense_id": "abede736-201c-348e-a4a5-c4ca99c72c70",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Stör kommt, geht der Herr Stör.“"
                                            },
                                            {
                                                "example_id": "3b7ac259-0590-4898-8643-81658319a660",
                                                "sense_id": "abede736-201c-348e-a4a5-c4ca99c72c70",
                                                "text": "Stör kommt und geht."
                                            },
                                            {
                                                "example_id": "1d6ee567-c0ee-4524-9c60-db3c3efc8b8e",
                                                "sense_id": "abede736-201c-348e-a4a5-c4ca99c72c70",
                                                "text": "Störs kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Stör",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2c83a3de-f146-3e9a-8f25-d8ca5929e84e",
                                        "entry_id": "4a2e3efb-8a1d-31c4-9fa2-7a8ace8f4ce3",
                                        "glosses": [
                                            "rechter Nebenfluss der Elbe in Schleswig-Holstein, einst kam der Stör hier vor"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61ffcf7c-400f-48db-a2d7-96a4bb134286",
                                                "sense_id": "2c83a3de-f146-3e9a-8f25-d8ca5929e84e",
                                                "text": "„Die Temperatur der Stör steige maximal um unbedenkliche 1,5 Grad“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b160dc7-af91-404c-86f7-9499d18fd393",
                        "source_entry_id": "5699dad8-10c4-3ca1-9c36-f4b5989e316f",
                        "source_sense_id": "b8b7468d-197b-375a-b134-2173f9926a64",
