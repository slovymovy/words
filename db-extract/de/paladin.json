                ],
                "senses": [
                    {
                        "sense_id": "cfa25eb8-c24c-3be6-8d73-96d9f8309b0b",
                        "entry_id": "ef583cbe-1953-3076-8e67-8d26e589b2bf",
                        "glosses": [
                            "hochgestellte Person aus dem Gefolge eines Kaisers, Königs, Fürsten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04c91260-bd61-4042-84df-83fc8a105833",
                                "sense_id": "cfa25eb8-c24c-3be6-8d73-96d9f8309b0b",
                                "text": "„Überhaupt sind alle Fürsten und ihre Paladine, die auf jener Seite stehen, von beneidenswerter Schönheit, lauter Adonisse, Lohengrine oder Siegfriede.“"
                            },
                            {
                                "example_id": "ef3931d1-d046-4ea9-b1cc-3da880cbc533",
                                "sense_id": "cfa25eb8-c24c-3be6-8d73-96d9f8309b0b",
                                "text": "„Man sieht seine Paladine Rudolf Heß, Walther Darré, Robert Ley, Fritz Todt, Viktor Lutze (Nachfolger des ermordeten Ernst Röhm), diverse Gauleiter, die ihn ankündigen, alle exakt im selben Gestus und Tonfall wie er selbst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "779fe0d5-5fe6-3162-b242-77259cb78185",
                        "entry_id": "ef583cbe-1953-3076-8e67-8d26e589b2bf",
                        "glosses": [
                            "abwertend: jemand, der einem Höhergestellten bedingungslos Gefolgschaft leistet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5458541-2386-4141-8642-9df0705e0fff",
                                "sense_id": "779fe0d5-5fe6-3162-b242-77259cb78185",
                                "text": "„Selbst den jedoch hielten nicht wenige anfänglich für unschuldig, ein ahnungsloses Opfer seiner Paladine.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
