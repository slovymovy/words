                                "nl": "Deze tragische gebeurtenis had de bevolking enkele weken lang <w>verschrikt</w>.",
                                "de": "Dieses tragische Ereignis hatte die Bevölkerung mehrere Wochen lang <w>entsetzt</w>.",
                                "pl": "To tragiczne wydarzenie przez kilka tygodni <w>przerażało</w> ludność.",
                                "it": "Quell'evento tragico aveva <w>atterrito</w> la popolazione per diverse settimane.",
                                "cs": "Tato tragická událost <w>zděsila</w> obyvatelstvo několik týdnů.",
                                "tr": "Bu trajik olay halkı birkaç hafta boyunca <w>dehşete düşürmüştü</w>.",
                                "es": "Aquel trágico suceso había <w>aterrorizado</w> a la población durante varias semanas.",
                                "zh": "这起悲惨事件曾<w>惊吓</w>全体居民长达数周。"
                            }
