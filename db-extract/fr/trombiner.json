                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf4dabc2-b072-4ce7-8b57-b7f64b25ad7d",
                                "sense_id": "003e6752-8a9c-3c53-ae67-fcb09331bb7f",
                                "text": "La Sophie va rapidement se faire trombiner par Aloïs, le cousin suisse lourdeau, et se tirer avec."
                            },
                            {
                                "example_id": "09409ad3-6daa-45fa-be6d-867ba736f623",
                                "sense_id": "003e6752-8a9c-3c53-ae67-fcb09331bb7f",
                                "text": "Moi je l’ai croisée un jour où je trombinais sa copine Aziya."
                            },
                            {
                                "example_id": "2147a2bc-7f20-42c6-8a6f-912b3ebc22b2",
                                "sense_id": "003e6752-8a9c-3c53-ae67-fcb09331bb7f",
                                "text": "Une bonne femme se fait trombiner sur la table en rentrant du boulot par son mec qui a besoin de sexe."
                            }
                        ]
                    }
