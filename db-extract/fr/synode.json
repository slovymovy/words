                                    {
                                        "sense_id": "22907727-3ac6-34c8-b055-25706f8b6b3c",
                                        "entry_id": "63327ef2-6127-37a4-af6d-ec91f92cb20c",
                                        "glosses": [
                                            "τακτική ή έκτακτη συνάντηση των ηγετών ή των αντιπροσώπων χωρών που μετέχουν σε ένα διεθνή οργανισμό"
                                        ],
                                        "tags": [],
