                        "gesetzliche Ordnung"
                    ]
                },
                {
                    "sense_id": "411e6490-59ed-31b9-be41-fa53fd96628e",
                    "sense_definition": "Strukturiertes und gesetzmäßiges Gefüge von Elementen in einem System.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "system",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In der Physik beschreibt die Entropie das Maß für fehlende <w>Ordnung</w>."
                        },
                        {
                            "text": "Wissenschaftler suchen nach der grundlegenden <w>Ordnung</w> in der Natur."
