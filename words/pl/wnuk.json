                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "family",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój najstarszy <w>wnuk</w> właśnie skończył szkołę.",
                            "target_lang_translations": {
                                "ru": "Мой старший <w>внук</w> только что окончил школу.",
                                "en": "My oldest <w>grandson</w> has just graduated from school.",
                                "nl": "Mijn oudste <w>kleinzoon</w> is net klaar met school.",
                                "de": "Mein ältester <w>Enkel</w> hat gerade die Schule beendet.",
                                "fr": "Mon <w>petit-fils</w> aîné vient de terminer ses études.",
                                "it": "Il mio <w>nipote</w> più grande ha appena finito la scuola.",
                                "cs": "Můj nejstarší <w>vnuk</w> právě dokončil školu.",
                                "tr": "En büyük <w>erkek torunum</w> okulu yeni bitirdi.",
                                "es": "Mi <w>nieto</w> mayor acaba de terminar la escuela.",
                                "zh": "我的大<w>孙子</w>刚毕业。"
                            }
                        },
                        {
                            "text": "Dziadek często zabiera swojego <w>wnuka</w> na długie spacery.",
                            "target_lang_translations": {
                                "ru": "Дедушка часто берет своего <w>внука</w> на долгие прогулки.",
                                "en": "Grandfather often takes his <w>grandson</w> for long walks.",
                                "nl": "Opa neemt zijn <w>kleinzoon</w> vaak mee voor lange wandelingen.",
                                "de": "Der Großvater nimmt seinen <w>Enkel</w> oft zu langen Spaziergängen mit.",
                                "fr": "Le grand-père emmène souvent son <w>petit-fils</w> faire de longues promenades.",
                                "it": "Il nonno porta spesso suo <w>nipote</w> a fare lunghe passeggiate.",
                                "cs": "Dědeček často bere svého <w>vnuka</w> na dlouhé procházky.",
                                "tr": "Dede sık sık <w>torununu</w> uzun yürüyüşlere çıkarır.",
                                "es": "El abuelo a menudo lleva a su <w>nieto</w> a dar largos paseos.",
                                "zh": "爷爷经常带他的<w>孙子</w>去长途散步。"
                            }
                        }
