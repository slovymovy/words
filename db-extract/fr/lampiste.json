        "fr-extract.jsonl": [
            {
                "entry_id": "c86facd3-f4f2-3f49-9bd4-5cc6283f2761",
                "word": "lampiste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "151fd350-30dc-4ebb-a5ec-c22ac821ff55",
                        "entry_id": "c86facd3-f4f2-3f49-9bd4-5cc6283f2761",
                        "tags": [
                            "plural"
                        ],
                        "form": "lampistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e72bed23-40eb-35df-a952-e91d3fe15853",
                        "entry_id": "c86facd3-f4f2-3f49-9bd4-5cc6283f2761",
                        "glosses": [
                            "Ouvrier qui fabrique ou personne qui vend des lampes à réservoir."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8b6e44e3-78a2-3a57-9292-aa1967146156",
                        "entry_id": "c86facd3-f4f2-3f49-9bd4-5cc6283f2761",
                        "glosses": [
                            "Celui qui les entretient."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edfac8b8-5a18-4da2-a50b-ba70c70cc61d",
                                "sense_id": "8b6e44e3-78a2-3a57-9292-aa1967146156",
                                "text": "Il en connaissait le personnel jusqu’au dernier des lampistes, et les paperasses jusqu’aux notes des blanchisseuses."
                            },
                            {
                                "example_id": "bc9bcab5-c464-4647-ade9-9fd51c2a4b25",
                                "sense_id": "8b6e44e3-78a2-3a57-9292-aa1967146156",
                                "text": "S’il vient quelqu’un, c’est le lampiste qui n’aime pas mon père non plus, je ne sais pourquoi : un vieux qui a une loupe, une casquette de peau de bête et une veste grise comme celle des prisonniers ; il sent l’huile, marmotte toujours entre ses dents, me regarde d’un œil dur, m’ôte brutalement ma chaise de dessous moi, sans m’avertir, met le quinquet sur mes cahiers, jette à terre mon petit paletot, me pousse de côté comme un chien, et sort sans dire un mot."
                            }
                        ]
                    },
                    {
                        "sense_id": "f33c3f7d-20b3-3047-913b-c2ba0bf1e41f",
                        "entry_id": "c86facd3-f4f2-3f49-9bd4-5cc6283f2761",
                        "glosses": [
                            "Employé des chemins de fer qui s'occupait des lampes et lanternes de la gare, de la signalisation pour les trains."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aaca7a1f-f8fb-4d9e-80ce-49fc290fc52a",
                                "sense_id": "f33c3f7d-20b3-3047-913b-c2ba0bf1e41f",
                                "text": "On arriva à la gare sans anicroche. Grâce à l’obligeant concours d’un lampiste qui avait servi aux hussards, les chevaux furent bientôt installés dans le wagon, dotés de paille fraîche, et solidement amarrés."
                            },
                            {
                                "example_id": "e29526c9-5815-4af8-8ee6-53c147334b19",
                                "sense_id": "f33c3f7d-20b3-3047-913b-c2ba0bf1e41f",
                                "text": "Un lampiste, oui, Madame, un lampiste ! Nous vivons à une époque inouïe ! Ces gens-là ont toutes les prétentions… Oh ! mais, n’ayez crainte, moi vivante on ne donnera pas Gaston à un lampiste !"
                            },
                            {
                                "example_id": "fb97bcd0-5f92-4816-b827-b8ecf9d09de3",
                                "sense_id": "f33c3f7d-20b3-3047-913b-c2ba0bf1e41f",
                                "text": "Avec les témoignages des corps de métiers, du lampiste au conducteur, du contrôleur à l'aiguilleur,...."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e92b8f1-5b8f-3de6-a872-2cff07baf293",
                        "entry_id": "c86facd3-f4f2-3f49-9bd4-5cc6283f2761",
                        "glosses": [
                            "Ouvrier chargé d’entretenir et de distribuer les lampes."
                        ],
                        "tags": [
                            "Industrie minière"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "901b004c-94f9-3c30-acf4-69250ac22e50",
                        "entry_id": "c86facd3-f4f2-3f49-9bd4-5cc6283f2761",
                        "glosses": [
                            "Subalterne que l’on fait passer pour responsable d’une faute, d’une erreur commise par un de ses supérieurs."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "a0a98653-9a5d-476f-a89c-3503bfb03a86",
                                "sense_id": "901b004c-94f9-3c30-acf4-69250ac22e50",
                                "text": "Ne cherchez pas, dans cette affaire, c’est encore moi qui serai le lampiste !"
                            },
                            {
                                "example_id": "ccbfb7da-28e9-42c2-a370-9662e1aed7ce",
                                "sense_id": "901b004c-94f9-3c30-acf4-69250ac22e50",
                                "text": "Tous étaient donc complices. […] Que faire, pour se sauver, sauver son ministère où régnait le mensonge et le faux […] ? Que faire sinon […] reporter la responsabilité sur le lampiste Henry et mettre tout le monde dans cette nouvelle combinaison : les coupables pardonnés, Boisdeffre, Gonse, Gribelin, et les nouveaux tenants de l’accusation, Roget et Cuignet, qui seront les garants de la version « officielle » […] ?"
                            },
                            {
                                "example_id": "65c2a76a-f980-454b-8726-bba84454c9c6",
                                "sense_id": "901b004c-94f9-3c30-acf4-69250ac22e50",
                                "text": "S’ouvre ce lundi le procès de la SNCF pour l’accident ferroviaire de 2013 en gare de Brétigny. Outre l’entreprise, personne morale, un jeune cheminot en charge de la maintenance est renvoyé en correctionnelle. Au vu des invraisemblables « défaillances organisationnelles » pointées par l’enquête, un lampiste ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9b01540-edee-46be-9625-24695363c1d6",
                        "source_entry_id": "c86facd3-f4f2-3f49-9bd4-5cc6283f2761",
                        "source_sense_id": "f33c3f7d-20b3-3047-913b-c2ba0bf1e41f",
                        "source_sense_description": "Subalterne qu’on fait passer pour responsable d’une faute",
                        "target_lang_word": "patsy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "patsy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d60ebb23-535e-30c2-9ea2-18036c283bc0",
                                        "entry_id": "c81a0aa8-526a-3223-bb38-28f3664a5f78",
                                        "glosses": [
                                            "A person who is taken advantage of, especially by being cheated or blamed for something."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13c81796-f922-431e-9d8e-00ade5674b87",
                                                "sense_id": "d60ebb23-535e-30c2-9ea2-18036c283bc0",
                                                "text": "And now it's quite obvious that instead of Mr Rumsfeld and Mr. Cheney listening attentively to Mr Blair's sage advice, they've simply been using him as a patsy—a convenient fig-leaf."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e808cde7-7923-48ca-a31e-d45db3a2c126",
                        "source_entry_id": "c86facd3-f4f2-3f49-9bd4-5cc6283f2761",
                        "source_sense_id": "f33c3f7d-20b3-3047-913b-c2ba0bf1e41f",
                        "source_sense_description": "Subalterne qu’on fait passer pour responsable d’une faute",
                        "target_lang_word": "fall guy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fall guy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "627b1514-4e67-36a6-983d-921d8a3e317d",
                                        "entry_id": "56548c2f-bf9a-3150-83fe-fd832f9ba92d",
                                        "glosses": [
                                            "One who is gullible and easily duped."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal",
                                            "sometimes"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eeed8f38-5770-3878-aeda-a84e4fbc2cc5",
                                        "entry_id": "56548c2f-bf9a-3150-83fe-fd832f9ba92d",
                                        "glosses": [
                                            "A scapegoat."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e8673c7-894f-470e-aacc-b2700896cce3",
                                                "sense_id": "eeed8f38-5770-3878-aeda-a84e4fbc2cc5",
                                                "text": "Clemons's supporters have over the years given a different rendition of events. In the racially heated atmosphere of St Louis in the early 1990s, they say, Clemons was made the fall guy. Of the four men who were charged with the murders, the three black men were all put on death row while the one white man is now free on parole."
                                            },
                                            {
                                                "example_id": "67ccdfd6-f172-41cd-852f-c8a3233df7d2",
                                                "sense_id": "eeed8f38-5770-3878-aeda-a84e4fbc2cc5",
                                                "text": "Marples, who later fled to Monaco to escape prosecution for fraud, was the driving force behind The Reshaping of British Railways report published on March 27 1963. Dr Richard Beeching [who wrote the report] was just his fall guy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6208068-5f0b-4de6-a61c-c19c23fbe0ff",
                        "source_entry_id": "c86facd3-f4f2-3f49-9bd4-5cc6283f2761",
                        "source_sense_id": "f33c3f7d-20b3-3047-913b-c2ba0bf1e41f",
                        "source_sense_description": "Subalterne qu’on fait passer pour responsable d’une faute",
                        "target_lang_word": "whipping boy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "whipping boy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55651e62-8de7-3168-9cbc-389c955f0648",
                                        "entry_id": "61c2f7b0-69d7-3273-94e4-c72ae9ecb4df",
                                        "glosses": [
                                            "A boy who was whipped in the stead of a misbehaving prince in early modern Europe."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d698f96a-bdad-48ab-8370-9b28dee27e60",
                                                "sense_id": "55651e62-8de7-3168-9cbc-389c955f0648",
                                                "text": "As the whipping boy, he must take the whippings for the royal heir, Prince Brat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71aca038-26bd-36ae-b026-90a05fb8e1d7",
                                        "entry_id": "61c2f7b0-69d7-3273-94e4-c72ae9ecb4df",
                                        "glosses": [
                                            "Someone punished for the errors of others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e124e753-fc60-4cdf-9e9a-1edc01cb3395",
                                                "sense_id": "71aca038-26bd-36ae-b026-90a05fb8e1d7",
                                                "text": "Once upon a time there was a little Power, the half-bankrupt wreck of a once great empire, that lost its temper with England, the whipping-boy of all the world, and behaved, as every one knows, most scandalously."
                                            },
                                            {
                                                "example_id": "1cdb6a0d-3084-4bcc-a2bd-a844c544b5a0",
                                                "sense_id": "71aca038-26bd-36ae-b026-90a05fb8e1d7",
                                                "text": "In others he denounces it as rank Judaism, the Jew having at that time become for him the whipping boy for all modern humanity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
