                        "entry_id": "62ef7526-f4f1-3a29-8f6f-79cef0e02ced",
                        "glosses": [
                            "To make illegal; to prohibit by law, to criminalize."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c87646f8-5e71-4d37-8db3-7f443b4d0ab4",
                                "sense_id": "29bf5864-a531-3268-b402-7bd16ad57cc1",
                                "text": "Only as recently as 1991 was the rape by a husband of his wife illegalised."
                            },
                            {
                                "example_id": "d47c4411-761b-432d-b3d5-fa6244c4da26",
                                "sense_id": "29bf5864-a531-3268-b402-7bd16ad57cc1",
                                "text": "A 1908 Act illegalised the teagle, a particularly nasty snare of baited hooks joined by strings which was put out to attract birds during hard weather."
                            },
                            {
                                "example_id": "32f431af-baa5-4229-bd77-78c9aad8f7da",
                                "sense_id": "29bf5864-a531-3268-b402-7bd16ad57cc1",
                                "text": "Although slavery had been illegalized by 1870, fundamental prejudice could not be legislated away."
                            }
                        ]
                    }
                ],
