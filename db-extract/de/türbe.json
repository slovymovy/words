                        "sense_id": "76694332-556b-3044-b960-909df32a4c64",
                        "entry_id": "ed7bfcd8-a452-35d0-b9ab-29a326606984",
                        "glosses": [
                            "ein islamischer, besonders in der Türkei vorkommender, Grabbau in Form eines Turmes mit Kegel- oder Kuppeldach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cfad79e-2b98-47bc-833c-ce078536d9ea",
                                "sense_id": "76694332-556b-3044-b960-909df32a4c64",
                                "text": "„Eine besondere Gattung der Fremdwörter bilden die so genannten Bezeichnungsexotismen, Wörter, die auf Sachen, Personen und Begriffe der fremdsprachigen Umwelt beschränkt bleiben, wie z. B. Bagno, Garrotte, Iglu, Kreml, Torero, Türbe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
