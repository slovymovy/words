{
    "word_family": [
        "percent",
        "percentile"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f8bfcc87-c27e-32bc-b945-8ea0ff05b42c",
                    "sense_definition": "The amount, number, or rate of something, regarded as part of a total of 100.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "math_ratio",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A high <w>percentage</w> of students passed the final exam.",
                            "target_lang_translations": {
                                "ru": "Высокий <w>процент</w> студентов сдал выпускной экзамен.",
                                "zh": "有很高<w>比例</w>的学生通过了期末考试。"
                            }
                        },
                        {
                            "text": "Only a small <w>percentage</w> of the population voted in the election.",
                            "target_lang_translations": {
                                "ru": "Лишь небольшой <w>процент</w> населения проголосовал на выборах.",
                                "zh": "只有一小<w>部分</w>人口在选举中投了票。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "high percentage",
                        "small percentage",
                        "large percentage",
                        "percentage of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Количество или доля чего-либо, выраженная как часть от ста",
                        "zh": "指占总数百分之多少的比例、数量或比率。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "процент",
                                "target_lang_sense_clarification": "доля, часть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "百分比",
                                "target_lang_sense_clarification": "表示比例的通用术语"
                            },
                            {
                                "target_lang_word": "百分率",
                                "target_lang_sense_clarification": "侧重于比率"
                            },
                            {
                                "target_lang_word": "比例",
                                "target_lang_sense_clarification": "指部分占整体的份额"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eaa511b3-3d25-3b5a-98de-b276c1f1bc19",
                    "sense_definition": "A share of sales, profits, or earnings.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "math_ratio",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gets a <w>percentage</w> for every vacuum cleaner she sells.",
                            "target_lang_translations": {
                                "ru": "Она получает <w>процент</w> за каждый проданный ею пылесос.",
                                "zh": "她每卖出一台吸尘器都能拿到<w>提成</w>。"
                            }
                        },
                        {
                            "text": "The agent takes a <w>percentage</w> of the actor's earnings.",
                            "target_lang_translations": {
                                "ru": "Агент берет <w>процент</w> от заработка актера.",
                                "zh": "经纪人会从演员的收入中抽取<w>佣金</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "get a percentage",
                        "take a percentage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Доля от продаж, прибыли или заработка",
                        "zh": "从销售额、利润或收入中提取的份额或佣金。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "процент",
                                "target_lang_sense_clarification": "комиссионные"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "提成",
                                "target_lang_sense_clarification": "从销售额中提取的报酬"
                            },
                            {
                                "target_lang_word": "分成",
                                "target_lang_sense_clarification": "按比例分配的利润或收入"
                            },
                            {
                                "target_lang_word": "佣金",
                                "target_lang_sense_clarification": "代理人收取的服务费用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3107a7f-4d5b-3b22-a6b7-0714d1fdb0db",
                    "sense_definition": "A benefit or advantage gained from an action.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is no <w>percentage</w> in arguing with him about the rules.",
                            "target_lang_translations": {
                                "ru": "Нет никакой <w>выгоды</w> спорить с ним о правилах.",
                                "zh": "跟他争论这些规则根本没<w>好处</w>。"
                            }
                        },
                        {
                            "text": "He realized there was no <w>percentage</w> in staying at home all day.",
                            "target_lang_translations": {
                                "ru": "Он понял, что нет никакой <w>выгоды</w> сидеть дома весь день.",
                                "zh": "他意识到整天待在家里毫无<w>意义</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "no percentage in"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in negative contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выгода или преимущество, получаемое от какого-либо действия",
                        "zh": "从某项行动中获得的利益或好处。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выгода",
                                "target_lang_sense_clarification": "польза, смысл"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "好处",
                                "target_lang_sense_clarification": "指做某事带来的益处"
                            },
                            {
                                "target_lang_word": "意义",
                                "target_lang_sense_clarification": "指做某事的价值或必要性"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}