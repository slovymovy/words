                                "target_senses": [
                                    {
                                        "sense_id": "473e5dc7-73bb-3121-bed3-35d03a3223b2",
                                        "entry_id": "a55e525e-ec8e-3c6d-9cba-649d999a3599",
                                        "glosses": [
                                            "Personne en tant que porteuse d’un nom. Cette manière de parler implique l’idée que celui qu’on désigne ainsi est un individu sans notoriété, dont on ne connaît que le nom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72831576-ac40-42e5-b79c-00368fbb1ac2",
                                                "sense_id": "473e5dc7-73bb-3121-bed3-35d03a3223b2",
                                                "text": "La maison Pinaud et Amour se composait, à cette époque, comme l’indique son nom, d’un nommé Pinaud et d’un nommé Amour."
                                            },
                                            {
                                                "example_id": "3e12f477-533d-4c91-9035-3eb56b34e0a1",
                                                "sense_id": "473e5dc7-73bb-3121-bed3-35d03a3223b2",
                                                "text": "1929 : Delteil devient représentant en blanquette de Limoux, plus précisément de la bien nommée maison Génie."
                                            },
                                            {
                                                "example_id": "ae45ea8b-6a23-4c31-8515-c0ff130e1ff9",
                                                "sense_id": "473e5dc7-73bb-3121-bed3-35d03a3223b2",
                                                "text": "Sur ces entrefaites elle a rencontré par hasard une de ses anciennes copines, une nommée Suzanne, une brune en minijupe, une sorte de grande sauterelle à la voix nasillarde."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nommé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "56988e30-37f8-39f4-9f40-9b44a42ef607",
                                        "entry_id": "b921b430-3941-32a2-ade4-3a3583611f28",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe nommer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c2ebbe9-044e-4c7c-bf29-a4513d313aa7",
                                                "sense_id": "56988e30-37f8-39f4-9f40-9b44a42ef607",
                                                "text": "Aussi ce petit enfant fut-il nommé Jésus, qui voulait dire, dans la langue des Juifs, sauveur des hommes."
                                            }
                                        ]
                                    }
                                ]
                            }
