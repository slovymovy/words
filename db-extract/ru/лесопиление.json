                "senses": [
                    {
                        "sense_id": "969ca721-0742-3cc0-be74-0a969530119a",
                        "entry_id": "5dec252c-3fcd-3027-a498-caceb245ffb8",
                        "glosses": [
                            "обработка, разделка лесоматериалов пилением"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "febf4546-f3b2-4138-acb1-b176ad281d63",
                                "sense_id": "969ca721-0742-3cc0-be74-0a969530119a",
                                "text": "Одностороннее развитие лесной промышленности — использование ею крупномерного леса для лесопиления — при царизме привело лесное хозяйство севера к упадку."
                            },
                            {
                                "example_id": "2771bba0-7523-4018-ae48-1f0860046185",
                                "sense_id": "969ca721-0742-3cc0-be74-0a969530119a",
                                "text": "Стремление сократить до минимума любые потери поставило под сомнение совершенство даже такого традиционного оборудования, как лесопильные рамы. Когда брёвна на них распиливаются на доски, значительная часть древесного сырья превращается в отходы — горбыли, рейки и горы опилок, которые потом трудно использовать. Учитывая это, наши специалисты предложили заменить процесс лесопиления принципиально новым, агрегатным способом переработки брёвен."
                            }
                        ]
                    }
