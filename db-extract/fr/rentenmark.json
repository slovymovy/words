                "senses": [
                    {
                        "sense_id": "ca19c25e-8c96-3340-ac95-7c8290c0d9ac",
                        "entry_id": "9a66a3b5-300d-3589-a2f3-75e0be6f2ec0",
                        "glosses": [
                            "Monnaie allemande qui a eu cours officiel en 1925 et 1924, et jusque 1939 dans la pratique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7b38a40-1cb3-4c2f-a39a-947d24e90a62",
                                "sense_id": "ca19c25e-8c96-3340-ac95-7c8290c0d9ac",
                                "text": "Le capital et les réserves de la nouvelle banque d’émission sont fixés (art.2), à 3.200 millions de rentenmarks ; le montant en sera fourni par une contribution établie sur l'agriculture d'une part, et d'autre part sur l'industrie, le commerce et les banques."
                            },
                            {
                                "example_id": "48e090a6-ea33-418b-91da-9de4187d0bd2",
                                "sense_id": "ca19c25e-8c96-3340-ac95-7c8290c0d9ac",
                                "text": "On évaluait le montant du vol à quatre millions de rentenmarks, soit environ seize millions de francs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e6965dc-ce9c-408a-8860-006ac7694a66",
                        "source_entry_id": "9a66a3b5-300d-3589-a2f3-75e0be6f2ec0",
                        "source_sense_id": "ca19c25e-8c96-3340-ac95-7c8290c0d9ac",
                        "target_lang_word": "Rentenmark",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rentenmark",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b0235d9d-1b79-3253-9922-b4d156d8c813",
                                        "entry_id": "5a4318f3-7fcd-3f76-bbc3-91dfbd2c3937",
                                        "glosses": [
                                            "Übergangswährung in Deutschland von 1923 bis 1948, eingeführt auf dem Höhepunkt der damaligen Inflation"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c4adbbb-8d7b-4632-9092-0e3c2d926480",
                                                "sense_id": "b0235d9d-1b79-3253-9922-b4d156d8c813",
                                                "text": "Die Rentenmark sollte die Geldinflation in Deutschland stoppen."
                                            },
                                            {
                                                "example_id": "fc00512b-b5e3-441e-9aae-df1c7fc84605",
                                                "sense_id": "b0235d9d-1b79-3253-9922-b4d156d8c813",
                                                "text": "„Die Rentenmark war gekommen, die Flut verrann, und wie es ja meistens nach einer Flut ist: Sie hinterließ Schlamm, Zerstörung.“"
                                            },
                                            {
                                                "example_id": "b2392b8a-e36a-49d9-9c04-94a4462d640b",
                                                "sense_id": "b0235d9d-1b79-3253-9922-b4d156d8c813",
                                                "text": "„Für eine Billion Papiermark erhielten die Menschen nun eine Rentenmark - die dem Wert von 15,4 Pfennigen des Jahres 1914 entsprach.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
