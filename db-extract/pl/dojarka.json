                                                "sense_id": "fba2705b-d107-3feb-adc9-45370743aede",
                                                "text": "„Melkmaschinen erleichtern die Arbeit, setzen aber ein völlig gesundes Euter voraus und werden nicht von allen Kühen ertragen.“"
                                            },
                                            {
                                                "example_id": "63b9d8bc-afd9-4f02-9083-9f833e850479",
                                                "sense_id": "fba2705b-d107-3feb-adc9-45370743aede",
                                                "text": "„Sie sind an einer besseren Melkmaschine interessiert, wir an besseren Kühen. Das ist der Unterschied.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
