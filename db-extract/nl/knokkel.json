                "senses": [
                    {
                        "sense_id": "6ab3f9ab-6052-38ac-99dd-8ebe74507c78",
                        "entry_id": "dd50cd92-32e8-39cb-83a5-338dc25fc69b",
                        "glosses": [
                            "het gewricht dat de vingers met de hand verbindt, vooral zichtbaar als men de vingers buigt"
                        ],
                        "tags": [],
