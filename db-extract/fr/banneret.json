                    },
                    {
                        "translation_id": "f26cb6a5-e4cd-4354-bfd9-f7d2ab8eb50a",
                        "source_entry_id": "020ae6db-697c-39da-b58c-0977fb172732",
                        "source_sense_id": "89f80de5-805f-3372-a61b-790dee0144c7",
