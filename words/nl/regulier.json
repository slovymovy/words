                {
                    "sense_id": "ebca2945-e322-3d74-bb55-894b6f2574ae",
                    "sense_definition": "volgens de gewone regels of de normale gang van zaken",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij heeft gewerkt binnen het <w>reguliere</w> onderwijs. ",
                            "target_lang_translations": {
                                "en": "He worked within <w>mainstream</w> education."
                            }
                        },
                        {
                            "text": "De arts verwees de patiënt door naar de <w>reguliere</w> gezondheidszorg.",
                            "target_lang_translations": {
                                "en": "The doctor referred the patient to <w>conventional</w> healthcare."
                            }
                        }
                    ],
                    "synonyms": [
                        "regelmatig"
                    ],
                    "common_phrases": [
                        "reguliere gezondheidszorg",
                        "regulier onderwijs"
                    ],
                    "target_lang_definitions": {
                        "en": "according to normal rules or the standard way of doing things"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "regular",
                                "target_lang_sense_clarification": "standard, conventional, or normal"
                            },
                            {
                                "target_lang_word": "mainstream",
                                "target_lang_sense_clarification": "pertaining to established, conventional institutions"
                            },
                            {
                                "target_lang_word": "conventional",
                                "target_lang_sense_clarification": "following accepted standards or customs"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e862a6a4-f93c-3d69-8443-28860f1038a0",
