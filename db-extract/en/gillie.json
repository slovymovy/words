                        "entry_id": "973b8e5f-bf14-3634-8797-51c3a8b4389c",
                        "glosses": [
                            "A gill of an alcoholic drink."
                        ],
                        "tags": [
                            "Scotland"
                        ],
                        "examples": [
                            {
                                "example_id": "9dd128a8-e76f-4553-ae77-2787d8429674",
                                "sense_id": "fe11c0d3-c60a-33fe-a2ed-a66f1920b87e",
                                "text": "Fareweel, my rhyme-compoſing billie! / Your native ſoil was right ill-willie; / But may ye flouriſh like a lily, / Now bonilie! / I'll toaſt ye in my hindmoſt gillie, / Tho' owre the Sea!"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
