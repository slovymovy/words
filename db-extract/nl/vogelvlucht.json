        "nl-extract.jsonl": [
            {
                "entry_id": "1d354a60-d90d-3fbe-b379-88723d59c5a3",
                "word": "vogelvlucht",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4b6aa861-2593-3335-b301-19841bd22df3",
                        "entry_id": "1d354a60-d90d-3fbe-b379-88723d59c5a3",
                        "glosses": [
                            "een weergave van een voorwerp of gebied alsof je erboven vliegt, perspectief van boven"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63f7f279-94d9-4f82-9c5b-a63abcaf763d",
                                "sense_id": "4b6aa861-2593-3335-b301-19841bd22df3",
                                "text": "De lift strekt zich uit tot zijn maximale hoogte en nu lijkt het alsof je de gotische bovenramen van de Oude Kerk in Amsterdam - want daar ben je - kunt aanraken. Alles wat zich beneden op de kerkvloer afspeelt en wat je in vogelvlucht bekijkt - de buurtbewoners die op verzoek van de kunstenaar de plattegrond van de kerk borduren, de toeristen, kunstliefhebbers én de kunst - lijken totaal nietig. Aan de zuil voor je neus hangt een spiegel met een boodschap van de kunstenaar erop. Die blijft nog even geheim."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d85d1ba-6e32-3292-a798-921ad9eff6eb",
                        "entry_id": "1d354a60-d90d-3fbe-b379-88723d59c5a3",
                        "glosses": [
                            "een snel alles omvattend overzicht van iets"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "1fe33253-4db1-4645-add4-af2bc42fa428",
                                "sense_id": "3d85d1ba-6e32-3292-a798-921ad9eff6eb",
                                "text": "Via het Residentie Orkest, De Filharmonie in Antwerpen en het Radio Filharmonisch Orkest klom hij op naar chef-dirigentschappen bij het Dallas Symphony Orchestra en het Hong Kong Philharmonic. Met dat laatste, zijn gekoesterde „oosterse kind”, bracht hij net een prachtige opname uit van Wagners opera Die Walküre: subtiel en gloedvol gespeeld; een visitekaartje van Van Zwedens kwaliteiten als orkestbouwer die weet hoe je van goed veel beter maakt. Daarop berust, in vogelvlucht, zijn carrière. Alle orkesten waar hij chef was, liet hij beter achter. Ross Perot noemde hem daarom „het mooiste dat het Dallas Symphony ooit is overkomen”, maar Van Zwedens perfectionisme is niet gratis. Figuurlijk, want sommige musici verdroegen zijn explosieve intolerantie voor imperfectie slecht, wat leidde tot de nodige strubbelingen. Letterlijk, want Van Zweden was vorig jaar met een salaris van 5 miljoen dollar de best verdienende Amerikaanse chef ever."
                            }
                        ]
                    },
                    {
                        "sense_id": "b685364c-9e49-3887-8d36-dda6e8d03e8a",
                        "entry_id": "1d354a60-d90d-3fbe-b379-88723d59c5a3",
                        "glosses": [
                            "als het vliegen van een vogel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b7b7311-8dbd-4fcb-92e3-6b64113b1f27",
                                "sense_id": "b685364c-9e49-3887-8d36-dda6e8d03e8a",
                                "text": "Plantenkweker Jan Brugmans uit Bergeijk kijkt beteuterd. Op het scherm achter hem in de studio van Omroep Brabant komen de beelden voorbij die een drone in vogelvlucht over zijn kassen maakte. „Dit was onze kwekerij, het is gatenkaas geworden”, zo omschrijft hij zijn door de hagel kapotgeslagen kassendaken treffend."
                            }
                        ]
                    },
                    {
                        "sense_id": "0eb4edb1-d971-3fe3-a284-7811817b7245",
                        "entry_id": "1d354a60-d90d-3fbe-b379-88723d59c5a3",
                        "glosses": [
                            "afstand in vogelvlucht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5180cfd-671d-45cb-a646-71db35b63bb0",
                                "sense_id": "0eb4edb1-d971-3fe3-a284-7811817b7245",
                                "text": "De afstand in vogelvlucht, dit is de kortste afstand tussen 2 punten, wordt berekend via de boog met bol- of geoïde-coördinaten of benaderend met de regel van Pythagoras op een vlakke kaartprojectie"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8bcd9e5c-312c-4b1e-b3eb-c6b1c2978484",
                        "source_entry_id": "1d354a60-d90d-3fbe-b379-88723d59c5a3",
                        "source_sense_id": "4b6aa861-2593-3335-b301-19841bd22df3",
                        "source_sense_description": "perspectief van boven",
                        "target_lang_word": "Vogelperspektive",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vogelperspektive",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f86502ec-1e97-3fd5-87ee-7755493f4857",
                                        "entry_id": "5bb88b0e-fb86-34a2-8da3-9e124304cb9e",
                                        "glosses": [
                                            "Betrachtung eines Gegenstandes von einem schräg über demselben gelegenen Augenpunkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21360343-fb24-4694-9c83-9684622fd07e",
                                                "sense_id": "f86502ec-1e97-3fd5-87ee-7755493f4857",
                                                "text": "Mit einer Drohne kann man Photos aus der Vogelperspektive schießen."
                                            },
                                            {
                                                "example_id": "9a9abe2e-ac92-438e-93be-1056953176f2",
                                                "sense_id": "f86502ec-1e97-3fd5-87ee-7755493f4857",
                                                "text": "Im Heißluftballon hat man einen tollen Blick auf die Landschaft aus der Vogelperspektive."
                                            },
                                            {
                                                "example_id": "f97e1fca-39e4-4721-b7ea-127acc83d9a8",
                                                "sense_id": "f86502ec-1e97-3fd5-87ee-7755493f4857",
                                                "text": "„… aus der Vogelperspektive wirken die Dächer der Gebäude wie ein großes Muster abstrakter westafrikanischer Kunst.“"
                                            },
                                            {
                                                "example_id": "131f5b3a-a304-4326-ae23-15df26dcad6f",
                                                "sense_id": "f86502ec-1e97-3fd5-87ee-7755493f4857",
                                                "text": "„Nach dem köstlichen Frühstück erklimme ich den 91 Meter hohen Belfried, einen der drei Türme Gents. Von hier aus betrachte ich die Stadt und die berühmte St. Bavo-Kathedrale aus der Vogelperspektive […]“"
                                            },
                                            {
                                                "example_id": "6c599111-2766-425e-87ff-74f1bf202897",
                                                "sense_id": "f86502ec-1e97-3fd5-87ee-7755493f4857",
                                                "text": "„Ein durchschnittlicher deutscher Privatgarten ist 150 Quadratmeter groß. Wenn aus der Vogelperspektive sich diese insektenfreundlichen Oasen aneinanderreihen, ist für den Insektenschutz und die Artenvielfalt schon viel gewonnen, sagt die Insektenexpertin Berit Philipp vom NABU […].“"
                                            },
                                            {
                                                "example_id": "626064e3-2127-4dd3-850d-fb660dfea1b7",
                                                "sense_id": "f86502ec-1e97-3fd5-87ee-7755493f4857",
                                                "text": "„[Der Dokumentarfilm „Find Fix Finish“] ermöglicht Einblicke in die Arbeit der US-Drohnenpiloten und zeigt Aufnahmen von dem grausamen Krieg ausschließlich aus der Vogelperspektive.“"
                                            },
                                            {
                                                "example_id": "436ae048-b364-4730-8674-301270bf0b19",
                                                "sense_id": "f86502ec-1e97-3fd5-87ee-7755493f4857",
                                                "text": "„Die Vogelperspektive löst vertraute Dimensionen auf, irritiert Auge und Geist. Doch Bekanntes auf ungewohnte Weise zu sehen fasziniert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33defbfb-0266-4baa-bc6e-bbf65b1a8297",
                        "source_entry_id": "1d354a60-d90d-3fbe-b379-88723d59c5a3",
                        "source_sense_id": "0eb4edb1-d971-3fe3-a284-7811817b7245",
                        "source_sense_description": "afstand in vogelvlucht",
                        "target_lang_word": "Luftlinie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Luftlinie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "84a1bc87-bf97-35f3-b8ee-290f1443491a",
                                        "entry_id": "d6139321-7eff-34a0-bf60-9372b6657ce6",
                                        "glosses": [
                                            "gedachte Linie; kürzeste Entfernung zwischen zwei Orten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc96a662-0b41-42a9-b07a-90bdc62cac80",
                                                "sense_id": "84a1bc87-bf97-35f3-b8ee-290f1443491a",
                                                "text": "Die Entfernung beträgt nur 300 m Luftlinie."
                                            },
                                            {
                                                "example_id": "26782eb7-bc1c-4895-9b96-51653848b127",
                                                "sense_id": "84a1bc87-bf97-35f3-b8ee-290f1443491a",
                                                "text": "„750 Kilometer Luftlinie trennen die beiden Orte, die Reise birgt viele Gefahren, und so engagiert Tobit, der Vater des Tobias, den Mann Asarja als Reisebegleiter.“"
                                            },
                                            {
                                                "example_id": "73d1daeb-60e8-4de2-b8d5-e760fa665725",
                                                "sense_id": "84a1bc87-bf97-35f3-b8ee-290f1443491a",
                                                "text": "„Vom Kallisaw-Sund zum Rainbow-Fishing-Camp sind's bloß anderthalb Meilen, das heißt, in der Luftlinie.“"
                                            },
                                            {
                                                "example_id": "fdf1f0be-cb10-4641-ac79-0131caa6f8eb",
                                                "sense_id": "84a1bc87-bf97-35f3-b8ee-290f1443491a",
                                                "text": "„Die ganze Grenze war abgeriegelt, selbst hier im Nirgendwo, 15 Kilometer Luftlinie vom offiziellen Grenzübergang entfernt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cb19b3b7-049b-368d-9e62-3ce7d6c5161b",
                                        "entry_id": "d6139321-7eff-34a0-bf60-9372b6657ce6",
                                        "glosses": [
                                            "Unternehmen, das Flugverkehr betreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21d4f3b1-5ab3-45b4-a7c5-7f14ac1451f0",
                                                "sense_id": "cb19b3b7-049b-368d-9e62-3ce7d6c5161b",
                                                "text": "„Der Aufsichtsrat der Luftlinie hat das neue Konzept für Eurowings genehmigt.“"
                                            },
                                            {
                                                "example_id": "3783b45e-1eae-412e-9291-ad8c304a7b55",
                                                "sense_id": "cb19b3b7-049b-368d-9e62-3ce7d6c5161b",
                                                "text": "„Am Flughafen Düsseldorf sind am Dienstag mehr als zwei Dutzend Flüge der Luftlinie Eurowings am Boden geblieben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e88ad3ab-4680-4e2f-9585-c2c76b9582cf",
                        "source_entry_id": "1d354a60-d90d-3fbe-b379-88723d59c5a3",
                        "source_sense_id": "0eb4edb1-d971-3fe3-a284-7811817b7245",
                        "source_sense_description": "afstand in vogelvlucht",
                        "target_lang_word": "as the crow flies",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "as the crow flies",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "688f1fb1-3445-3d28-9158-ad29a99fd789",
                                        "entry_id": "8f425ce2-f18f-34fd-913a-c37add1faeb0",
                                        "glosses": [
                                            "In a straight line distance between two locations, as opposed to the road distance or over land distance."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2e47f06-65b1-4c3e-b92f-bb7f9b1ab3c2",
                                                "sense_id": "688f1fb1-3445-3d28-9158-ad29a99fd789",
                                                "text": "ʽFire,ʼ said Bill, ʽin the form of a common cowshed, is burnin' about nor'-nor'-east as the crow flies.ʼ"
                                            },
                                            {
                                                "example_id": "49d951a4-0cfd-4306-b442-b4f51f3a3452",
                                                "sense_id": "688f1fb1-3445-3d28-9158-ad29a99fd789",
                                                "text": "It is 15 kilometers as the crow flies."
                                            },
                                            {
                                                "example_id": "143f1a61-143f-4e0a-b487-31194b2c47be",
                                                "sense_id": "688f1fb1-3445-3d28-9158-ad29a99fd789",
                                                "text": "The distance from Sarajevo to Ploce is 75 miles as the crow flies, but because of the difficult terrain the new line is 120 miles long."
                                            },
                                            {
                                                "example_id": "5b75002c-5af4-4015-97e4-d94a00c8b761",
                                                "sense_id": "688f1fb1-3445-3d28-9158-ad29a99fd789",
                                                "text": "Then it told me the distance between the two is 331 miles, which is totally irrelevant as that's as the crow flies and not the 393 miles of the rail route."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
