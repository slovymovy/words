                "senses": [
                    {
                        "sense_id": "dada0e61-b653-3298-a7cf-5872c5f77f8e",
                        "entry_id": "9eac5087-7fad-3ad5-a9a8-04612ef6de82",
                        "glosses": [
                            "Faire quitter son travail à quelqu’un qui avait été embauché."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "030ff1f2-2ae2-40a1-8608-2ce247f8c751",
                                "sense_id": "dada0e61-b653-3298-a7cf-5872c5f77f8e",
                                "text": "Tout aspirant qui dans le courant d’une maladie serait désembauché, son tour d’appel datera du premier jour de sa maladie ; et les arrivants seront embauchés avant ceux qui seront désembauchés du jour de leur arrivée."
                            },
                            {
                                "example_id": "bd0a1f51-5c7d-4e87-90a6-f21796ed46f1",
                                "sense_id": "dada0e61-b653-3298-a7cf-5872c5f77f8e",
                                "text": "Les maîtres ne pouvaient désembaucher ni les apprentis ni les compagnons, non plus que ceux-ci quitter leurs maîtres pour aller chez d’autres avant que leur ouvrage ou leur tems ne fût achevé."
                            },
                            {
                                "example_id": "b4c234d7-2453-4bd2-812a-75a45dc95847",
                                "sense_id": "dada0e61-b653-3298-a7cf-5872c5f77f8e",
                                "text": "On est bientôt fatigué de s’embaucher et de se désembaucher sans cesse ; en portant ses outils d’un quartier de Paris à un autre, on se rappelle encore les beaux travaux que l’on exécute en province et cela achève de vous décider à y retourner et à dire adieu à la capitale."
                            }
                        ]
                    }
