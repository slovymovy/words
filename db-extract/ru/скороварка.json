                    {
                        "translation_id": "e08f7b51-4c2a-41d9-8b8a-cfef800ce7e2",
                        "source_entry_id": "f42f3689-19a2-392d-94d6-db0e5a76bd4e",
                        "source_sense_id": "79cbfc66-0504-3cf6-a480-fb9acf4da183",
                        "target_lang_word": "pressure cooker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pressure cooker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44b2dfe3-0d0e-3dd6-9a26-e7fe8c35219a",
                                        "entry_id": "d281bed0-7eb8-3ddd-bc02-683e81c2f627",
                                        "glosses": [
                                            "A sealed cooking vessel that allows cooking in greater than atmospheric pressure and at a temperature above the boiling point of water."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2e202585-8a08-36b4-88b2-b1c73d118b90",
                                        "entry_id": "d281bed0-7eb8-3ddd-bc02-683e81c2f627",
                                        "glosses": [
                                            "A stressful situation that is liable to erupt."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "562b3697-13a6-4fe3-91b9-06eee2aa3d34",
                                                "sense_id": "2e202585-8a08-36b4-88b2-b1c73d118b90",
                                                "text": "Look, I had a pressure cooker of a job along with more responsibility that any one person should have. I had an office of twenty-five people under me all needing help like little birds in a nest."
                                            },
                                            {
                                                "example_id": "7b075e5a-140a-47c3-8e67-aba193cb64a3",
                                                "sense_id": "2e202585-8a08-36b4-88b2-b1c73d118b90",
                                                "text": "Wall Street hopes that economic deprivation will turn up the pressure cooker on internal relations."
                                            },
                                            {
                                                "example_id": "da2ae028-7219-4640-af94-e159428bdc01",
                                                "sense_id": "2e202585-8a08-36b4-88b2-b1c73d118b90",
                                                "text": "Humanity lives in a pressure cooker of stress because of the ruthless way in which we compete, because of our lack of respect for the international rules of commerce, because of social conflicts, because of the devastation to the environment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b94d1ce8-c411-4801-9e2a-793586072a80",
                        "source_entry_id": "f42f3689-19a2-392d-94d6-db0e5a76bd4e",
                        "source_sense_id": "79cbfc66-0504-3cf6-a480-fb9acf4da183",
                        "target_lang_word": "olla a presión",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "olla a presión",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "cdbecd1c-5770-3483-821e-fd856f45cd73",
                                        "entry_id": "0b962f3e-9e91-3c5a-a1a4-a66d6a7541ea",
                                        "glosses": [
                                            "Recipiente para cocinar, que tiene la particularidad de contar con un cierre hermético que retiene y controla el vapor. Este vapor hace que aumenten tanto la presión como la ebullición, consiguiendo una mayor rapidez en la cocción de los alimentos. Lleva incorporada una válvula de seguridad que deja escapar el vapor cuando se ha alcanzado una presión determinada; de esta manera se evita que el exceso de presión pudiera hacer estallar la olla."
                                        ],
                                        "tags": [
                                            "Gastronomía",
                                            "utensilios"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
