                                "ru": "Они знают друг друга с детства и наконец решили <w>пожениться</w> прошлым летом.",
                                "nl": "Ze kennen elkaar sinds hun kindertijd en hebben vorige zomer eindelijk besloten <w>te trouwen</w>.",
                                "de": "Sie kennen sich seit ihrer Kindheit und haben sich letzten Sommer endlich entschlossen, <w>zu heiraten</w>.",
                                "pl": "Znają się od dzieciństwa i zeszłego lata w końcu postanowili <w>pobrać się</w>.",
                                "it": "Si conoscono fin dall'infanzia e alla fine hanno deciso di <w>sposarsi</w> l'estate scorsa.",
                                "cs": "Znají se od dětství a loni v létě se konečně rozhodli <w>vzít</w>.",
                                "tr": "Çocukluklarından beri birbirlerini tanıyorlar ve geçen yaz nihayet <w>evlenmeye</w> karar verdiler.",
                                "es": "Se conocen desde la infancia y finalmente decidieron <w>casarse</w> el verano pasado.",
                                "zh": "他们从童年起就彼此认识，去年夏天终于决定<w>结婚</w>。"
                            }
                        }
