                                        "entry_id": "65409f31-0e8b-3bc7-bc2c-7efab88bbd89",
                                        "glosses": [
                                            "Initialism of Atlantic meridional overturning circulation."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "initialism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90e859b9-cd2e-4d57-a81f-a46227f598b4",
                                                "sense_id": "8001907d-ce98-3280-9248-337644c2fe50",
                                                "text": "The AMOC is thus a poster child for the idea of climatic “tipping points”—of hard-to-predict thresholds in Earth’s climate system that, once crossed, have rapid, cascading effects far beyond the corner of the globe where they occur."
                                            }
