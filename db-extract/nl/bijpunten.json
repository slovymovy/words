                                                "sense_id": "7a39e6cb-d054-3014-8efe-fa2153cf025a",
                                                "text": "The hermit trimmed his little fire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd714076-a734-3987-8a3d-4e1d9ace9fe4",
                                        "entry_id": "8353e400-6a31-31b2-974b-ce3acf460f8c",
