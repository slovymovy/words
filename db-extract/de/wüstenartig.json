                ],
                "senses": [
                    {
                        "sense_id": "6afa68bd-3462-36b8-9aa2-4bfd8a219d91",
                        "entry_id": "1ab32604-fa3a-34f9-bdb8-d3e29a70ac62",
                        "glosses": [
                            "die Merkmale einer Wüste zeigend, beispielsweise Trockenheit, ohne oder mit wenig Vegetation, sandig oder steinig, sehr geringe Niederschläge"
                        ],
                        "tags": [
                            "Geographie"
                        ],
                        "examples": [
                            {
                                "example_id": "fb079452-4c02-4c9e-ae5a-bd1e736044c2",
                                "sense_id": "6afa68bd-3462-36b8-9aa2-4bfd8a219d91",
                                "text": "[Fruchtbarer Halbmond:] „Die Gebiete außerhalb der bewässerten Flussebenen sind heute wüstenartig.“"
                            },
                            {
                                "example_id": "c3c91a57-64c2-4964-ad32-9607d935f5fa",
                                "sense_id": "6afa68bd-3462-36b8-9aa2-4bfd8a219d91",
                                "text": "„Lebensraum der Sandrasselottern sind trockene wüstenartige Gebiete Indiens, Sri Lankas, Arabiens und Nordostafrikas.“"
                            },
                            {
                                "example_id": "223ad1bd-8785-45f7-9f87-ea71d6d37fbd",
                                "sense_id": "6afa68bd-3462-36b8-9aa2-4bfd8a219d91",
                                "text": "„Da Gila-Krustenechsen nur eine dünne Haut besitzen, sind sie nicht besonders gut an ihren wüstenartigen, heißen Lebensraum angepasst.“"
                            },
                            {
                                "example_id": "08a2f5a9-1461-419a-b3c7-95e37eb9a0eb",
                                "sense_id": "6afa68bd-3462-36b8-9aa2-4bfd8a219d91",
                                "text": "[Chihuahua (Bundesstaat)/Mexiko:] „Der Staat wird von einem wüstenartigen Hochplateau eingenommen, das nach Westen hin stark abfällt.“"
                            },
                            {
                                "example_id": "80a5fbd6-4ab7-4b7d-bb93-626cb954bb04",
                                "sense_id": "6afa68bd-3462-36b8-9aa2-4bfd8a219d91",
                                "text": "„Eine Stadt wie Phoenix in den USA könnte hingegen durch gezielte Bepflanzung relativ einfach kühlere Temperaturen erreichen als in der wüstenartigen Umgebung.“"
                            },
                            {
                                "example_id": "430f308e-af03-4ad3-93c1-25fba008ba83",
                                "sense_id": "6afa68bd-3462-36b8-9aa2-4bfd8a219d91",
                                "text": "„Die Sternbergia kommt in Israel im Negev und auf den Golanhöhen vor. Die Pflanzen wachsen in der wüstenartigen Umgebung oft auf magerem Untergrund auf Felsbändern, wo die gelb-orangen Blüten zwischen den Felsen auszumachen sind.“"
                            },
                            {
                                "example_id": "efb4a3b8-49d3-460b-ae1d-e8cdf6d74176",
                                "sense_id": "6afa68bd-3462-36b8-9aa2-4bfd8a219d91",
                                "text": "„Insbesondere im nördlichen Afrika wechselten die Klimaphasen: Es war zeitweise eher grün und zeitweise wüstenartig, so wie heute.“"
                            },
                            {
                                "example_id": "389905eb-7709-4def-8cc0-2f9bee866bc7",
                                "sense_id": "6afa68bd-3462-36b8-9aa2-4bfd8a219d91",
                                "text": "„Wie in Mali hat auch in Niger die Regierung kaum Kontrolle über die wüstenartigen Weiten ausserhalb der Städte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
