                        "entry_id": "32e3f1ff-c5ad-3bfe-b620-3a937556bdff",
                        "glosses": [
                            "Nestor."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "305dff38-143e-4bfb-a70d-8d0ac0ca876b",
                                "sense_id": "13d0fd8d-50f1-3386-a378-b0b5d3562f44",
                                "text": "When all his brothers were slain by Heracles, in consequence of the refusal of Neleus to purify him for the murder of Iphitus, Nestor alone escaped, being absent at Gerenia — hence his epithet Gerenios in Homer (Apollodorus i. 9). He is the old warrior of the Iliad and the wise counsellor of the Greeks before Troy."
                            }
                        ]
                    }
