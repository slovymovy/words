                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1ca4e345-5b4c-3ecc-89b9-6f11fccf5371",
                                        "entry_id": "cfd261ea-a34e-3bca-bc58-7c426826afb6",
                                        "glosses": [
                                            "sich behäbig und schaukelnd fortbewegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96c75873-5d31-46d3-9e46-b46bc06f691d",
                                                "sense_id": "1ca4e345-5b4c-3ecc-89b9-6f11fccf5371",
                                                "text": "„Blood erhob sich geräuschvoll und watschelte aus dem Raum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d06bfba-3bc4-42d4-81d7-fef2f2265a31",
                        "source_entry_id": "0daf809e-7a27-3aa9-89f2-e91b22a9cc92",
                        "source_sense_description": "walk unsteadily",
                        "target_lang_word": "patschen",
                        "target_lang_code": "de",
                        "note": "with bare feet",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "patschen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81a6f7c0-1f8b-3e84-9be2-589b7f5c4544",
                                        "entry_id": "e7d69d25-6732-31ea-aad5-ec5fb1238747",
                                        "glosses": [
                                            "mit etwas (meist der Hand) (auf eine Flüssigkeit, zum Beispiel Wasser) schlagen, so dass ein klatschendes Geräusch erklingt"
                                        ],
                                        "tags": [
                                            "auxiliary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea277873-7775-4361-b516-7b6b77554f85",
                                                "sense_id": "81a6f7c0-1f8b-3e84-9be2-589b7f5c4544",
                                                "text": "„Klatschen und Patschen sind perfekte Geschicklichkeitsübungen, die oft einfacher aussehen, als sie sind.“"
                                            },
                                            {
                                                "example_id": "8396d80c-07b9-4110-9de5-8bcec838f055",
                                                "sense_id": "81a6f7c0-1f8b-3e84-9be2-589b7f5c4544",
                                                "text": "Er patschte mit der flachen Hand auf seinen feisten Wanst."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6aeb7db4-5934-346b-9756-42a7033fd4e8",
                                        "entry_id": "e7d69d25-6732-31ea-aad5-ec5fb1238747",
                                        "glosses": [
                                            "mit einem klatschenden Geräusch irgendwo aufschlagen/hineinfallen"
                                        ],
                                        "tags": [
                                            "auxiliary verb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c90d7224-9d1c-4356-a2ca-aa9743addd4c",
                                                "sense_id": "6aeb7db4-5934-346b-9756-42a7033fd4e8",
                                                "text": "Steine patschten ins Wasser oder landeten mit einem dumpfen Plopp auf dem Kiesstrand."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "777b86d5-060f-337b-8559-a2292f5a9c59",
                                        "entry_id": "e7d69d25-6732-31ea-aad5-ec5fb1238747",
                                        "glosses": [
                                            "mit einem klatschenden Geräusch durch etwas Feuchtes (zum Beispiel Schneematsch) hindurchgehen"
                                        ],
                                        "tags": [
                                            "auxiliary verb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "369af422-3e96-4ff2-b14f-059c2485b5cf",
                                                "sense_id": "777b86d5-060f-337b-8559-a2292f5a9c59",
                                                "text": "„Die Fußgänger patschten durch das Wasser und die Pferde und Wagen patschten durch den Schmutz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "885db644-7a90-3d72-8445-5912b7464841",
                                        "entry_id": "e7d69d25-6732-31ea-aad5-ec5fb1238747",
                                        "glosses": [
                                            "ein klatschendes Geräusch von sich geben"
                                        ],
                                        "tags": [
                                            "auxiliary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48ededdf-8e03-4117-bb9a-f45fbae1ce17",
                                                "sense_id": "885db644-7a90-3d72-8445-5912b7464841",
                                                "text": "„Schlamm schmatzt und patscht unter meinen Sohlen, als ich schnell durch den Zaun klettere."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
