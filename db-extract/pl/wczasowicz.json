                                        "entry_id": "371d3185-af58-36b4-b0ea-4c6856a7978e",
                                        "glosses": [
                                            "Vacancier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e37786c4-f08c-4b01-b479-5d022e316b6e",
                                                "sense_id": "9bb12eab-ae20-3cf5-983d-0bdb962f93dc",
                                                "text": "M. de S… est venu jeter le trouble dans ce groupe de villégiateurs qui respiraient le frais à l’ombre des forêts ou sur le bord de la mer."
                                            },
                                            {
                                                "example_id": "0c50f30c-1e0a-4603-8fa9-07119a79523b",
                                                "sense_id": "9bb12eab-ae20-3cf5-983d-0bdb962f93dc",
                                                "text": "Nous sommes une ville d'environ 12 000 personnes en hiver et 20 000 personnes en été avec tous les villégiateurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
