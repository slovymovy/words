                                                "sense_id": "92846393-650a-38b7-90f9-ffc0a2955d96",
                                                "text": "Mit dem Jeep Grand Cherokee hat der Hersteller ein Modell der Oberen Mittelklasse gebaut."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
