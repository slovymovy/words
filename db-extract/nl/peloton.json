                                    {
                                        "sense_id": "d4d188bb-8965-3057-a6f0-6c7c34298362",
                                        "entry_id": "a3b6a3ad-e682-3eab-8b17-4a35dd4bbc89",
                                        "glosses": [
                                            "A unit of thirty to forty soldiers typically commanded by a lieutenant and forming part of a company."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "367de44b-1d50-4bc0-9814-7dc100cf58db",
                                                "sense_id": "d4d188bb-8965-3057-a6f0-6c7c34298362",
                                                "text": "Needless to say, one's seat must be booked in advance and a platoon of urbane officials, one to each door of the train, awaits passengers to usher them to their seats and relieve them of their bulkier baggage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65eac3bb-a6b7-305a-8a8a-fc0b968e81b7",
                                        "entry_id": "a3b6a3ad-e682-3eab-8b17-4a35dd4bbc89",
                                        "glosses": [
                                            "A subdivision of a fire company, led by a captain or lieutenant."
                                        ],
                                        "tags": [],
