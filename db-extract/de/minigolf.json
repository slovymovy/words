                "senses": [
                    {
                        "sense_id": "fd8d4056-b896-3952-b3ea-12d444cfcb31",
                        "entry_id": "daf1ddbf-6ec4-3858-8b14-12c489205019",
                        "glosses": [
                            "kleinere Variante des Golfspiels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b610173-d66d-429e-b103-57fa75ebab03",
                                "sense_id": "fd8d4056-b896-3952-b3ea-12d444cfcb31",
                                "text": "Jeden Donnerstag geht er mit seinen Freunden Minigolf spielen."
                            },
                            {
                                "example_id": "9b6d7a4c-704c-4619-87d4-2d462bccf04d",
                                "sense_id": "fd8d4056-b896-3952-b3ea-12d444cfcb31",
                                "text": "Als Kompromiss für einen Ausflug schlug der Lehrer Minigolf vor."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0382b686-725d-48c4-b62a-f6774ecafec7",
                        "source_entry_id": "daf1ddbf-6ec4-3858-8b14-12c489205019",
                        "source_sense_id": "fd8d4056-b896-3952-b3ea-12d444cfcb31",
                        "source_sense_description": "Sport: kleinere Variante des Golfspiels",
                        "target_lang_word": "minigolf",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "minigolf",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5fbd8f06-ced1-33db-b203-332e04be8d93",
                                        "entry_id": "70e70eef-75a8-3f19-8544-a00a627dadf2",
                                        "glosses": [
                                            "Miniature golf."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36e2ac60-44c4-4662-8b69-077d7d619162",
                                                "sense_id": "5fbd8f06-ced1-33db-b203-332e04be8d93",
                                                "text": "Despite his fame, he's a humble, laid-back guy, more than willing to teach me a thing or two about minigolf. We're definitely in the right city for the lesson. With more than 50 courses in a 96-kilometre radius, some argue that the area, whose population is just over 200,000 year-round, is the minigolf capital of the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f91fa94-dd1d-3bc4-9281-a7ce512d947c",
                                        "entry_id": "70e70eef-75a8-3f19-8544-a00a627dadf2",
                                        "glosses": [
                                            "A course for playing miniature golf."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5340474e-4c6c-4e43-9bac-02cc7f98b2c6",
                                                "sense_id": "7f91fa94-dd1d-3bc4-9281-a7ce512d947c",
                                                "text": "The commercial strips of the mid-twentieth century lined with minigolfs, kiddie parks, drive-in theaters, and shopping."
                                            },
                                            {
                                                "example_id": "b722aacf-7d97-4c1a-89e5-2c6d2fa3eb7f",
                                                "sense_id": "7f91fa94-dd1d-3bc4-9281-a7ce512d947c",
                                                "text": "[…] the hotels have overgrown granite minigolfs with little pink granite megaliths as obstacles […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "841c80ff-c5c0-4c44-9c8e-84498c125865",
                        "source_entry_id": "daf1ddbf-6ec4-3858-8b14-12c489205019",
                        "source_sense_id": "fd8d4056-b896-3952-b3ea-12d444cfcb31",
                        "source_sense_description": "Sport: kleinere Variante des Golfspiels",
                        "target_lang_word": "minigolf",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "minigolf",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7ff030ac-4fd4-3d48-996f-88b0c78d6f3a",
                                        "entry_id": "4c86e47b-0143-36cb-89e1-6712c5809cd4",
                                        "glosses": [
                                            "Golf miniature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1764c30f-dde7-4ae7-a938-47aa666717c1",
                                                "sense_id": "7ff030ac-4fd4-3d48-996f-88b0c78d6f3a",
                                                "text": "Dès son arrivée, nous l’avons embarqué sur le tout récent minigolf, en terre battue rouge bien roulée, dont s’occupait méticuleusement madame Malanias, la femme du pâtissier."
                                            },
                                            {
                                                "example_id": "c12d1bc4-2559-4269-a95d-ce5c0764b892",
                                                "sense_id": "7ff030ac-4fd4-3d48-996f-88b0c78d6f3a",
                                                "text": "Le minigolf casteloléronais s’est offert une cure de jeunesse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
