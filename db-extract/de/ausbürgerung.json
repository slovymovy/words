                ],
                "senses": [
                    {
                        "sense_id": "2649e7a8-d1f0-3f3d-8c44-e1e465c6ff2e",
                        "entry_id": "43475f29-79ed-3ba3-bc2b-9a79427f75c8",
                        "glosses": [
                            "Entzug der Staatsbürgerschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c51a3f1b-2a72-4a2b-ac4b-b5661d58cdc9",
                                "sense_id": "2649e7a8-d1f0-3f3d-8c44-e1e465c6ff2e",
                                "text": "„Die Ausbürgerung sollte natürlich nicht nach Parteiwillkür aussehen, sondern so, als hätte das Volk der DDR diese Nestbeschmutzer nicht länger dulden wollen.“"
                            },
                            {
                                "example_id": "ad08daa3-fe72-4cdb-b6c7-91f254adaa9a",
                                "sense_id": "2649e7a8-d1f0-3f3d-8c44-e1e465c6ff2e",
                                "text": "„Es war der Auftritt, der zu seiner Ausbürgerung aus der DDR führte.“"
                            },
                            {
                                "example_id": "ea683523-d48d-45a5-8541-d3913bd40d83",
                                "sense_id": "2649e7a8-d1f0-3f3d-8c44-e1e465c6ff2e",
                                "text": "„Tucholskys Name stand auf der ersten Ausbürgerungsliste des Dritten Reichs, inzwischen ist die Ausbürgerung erfolgt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
