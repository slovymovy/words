                "senses": [
                    {
                        "sense_id": "924bc2d2-4ad1-32c0-9cce-1d8b1b05121f",
                        "entry_id": "a69bb6f6-08af-3c31-b9a1-70f63103f4b5",
                        "glosses": [
                            "Energie, die für die Ionisation mindestens aufgewendet werden muss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60c50e0d-f776-40c0-9c5e-92a2af543687",
                                "sense_id": "924bc2d2-4ad1-32c0-9cce-1d8b1b05121f",
                                "text": "„Ionisierungsenergien für einfache Ionisation reichen von 3,9 eV (Caesium) über 13,6 eV (Wasserstoff) bis 24,6 eV (Helium). Die Ionisierungsenergie für vollständige Ionisation steigt proportional zum Quadrat der Kernladungszahl an.“"
                            },
                            {
                                "example_id": "a852010f-b22a-4695-bbdb-5f30aa28d7dc",
                                "sense_id": "924bc2d2-4ad1-32c0-9cce-1d8b1b05121f",
                                "text": "„Die Ionisierungsenergie (IE) ist die Energie die aufgewendet werden muss um ein Elektron aus der Hülle eines Atoms bzw. Ions heraus zu lösen. Die Ionisierungsenergie wird meist in Elektronenvolt angegeben.“"
                            },
                            {
                                "example_id": "60a1fc5d-fa46-48b4-b94c-0649d8c0aa5c",
                                "sense_id": "924bc2d2-4ad1-32c0-9cce-1d8b1b05121f",
                                "text": "„Zahlenwerte für die Ionisationsenergie für praktisch alle Elemente finden sich über die Links, die vom Modul Periodensystem ausgehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
