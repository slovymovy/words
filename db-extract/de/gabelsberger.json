                "senses": [
                    {
                        "sense_id": "ee7c8f44-0658-39a7-ad8c-bacf6a6c68eb",
                        "entry_id": "3e44421e-221b-3c79-a7f1-37a117c77161",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f186f97f-1e70-4225-afcf-326f72c1527e",
                                "sense_id": "ee7c8f44-0658-39a7-ad8c-bacf6a6c68eb",
                                "text": "Frau Gabelsberger ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "db41d223-6e69-4d11-87bc-6a47f9ea6f7d",
                                "sense_id": "ee7c8f44-0658-39a7-ad8c-bacf6a6c68eb",
                                "text": "Herr Gabelsberger wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "18188510-3e2f-423e-8692-d374fd724e48",
                                "sense_id": "ee7c8f44-0658-39a7-ad8c-bacf6a6c68eb",
                                "text": "Die Gabelsbergers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "ea3049b1-ffb7-475a-baed-5dd537bf00bd",
                                "sense_id": "ee7c8f44-0658-39a7-ad8c-bacf6a6c68eb",
                                "text": "Der Gabelsberger trägt nie die Schals, die die Gabelsberger ihm strickt."
                            },
                            {
                                "example_id": "623fbc5c-7978-4403-8452-646dd680dd92",
                                "sense_id": "ee7c8f44-0658-39a7-ad8c-bacf6a6c68eb",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gabelsberger kommt, geht der Herr Gabelsberger.“"
                            },
                            {
                                "example_id": "4ad96efd-7fd5-4c77-9fd7-58e4ccd15ba1",
                                "sense_id": "ee7c8f44-0658-39a7-ad8c-bacf6a6c68eb",
                                "text": "Gabelsberger kommt und geht."
                            },
                            {
                                "example_id": "96824dc1-49c5-47f0-81d1-f6de8713afcd",
                                "sense_id": "ee7c8f44-0658-39a7-ad8c-bacf6a6c68eb",
                                "text": "Gabelsbergers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
