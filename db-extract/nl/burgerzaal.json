                        "examples": [
                            {
                                "example_id": "ece78a42-937b-49dc-b065-d73b70cf8824",
                                "sense_id": "77512931-e953-30b1-bac7-e0de388f6286",
                                "text": "Koning Willem-Alexander zei \"bijzonder verheugd\" te zijn om Xi te mogen ontvangen. Hij sprak over de Burgerzaal in het voormalige stadhuis van Amsterdam, waar het banket werd gegeven, als 'de Grote Hal van het Volk'. Dat was een verwijzing naar de gelijknamige hal in Peking."
                            },
                            {
                                "example_id": "634ac391-5398-4d5b-ae10-ffa1f110569e",
                                "sense_id": "77512931-e953-30b1-bac7-e0de388f6286",
                                "text": "Bezoekers kunnen ook toegang krijgen tot de pui, vanwaar het koninklijk gezelschap het balkon betrad. Ook te bewonderen is de Burgerzaal. Na de inhuldiging van koning Willem-Alexander in de Nieuwe Kerk was daar de receptie voor de prominente genodigden."
                            }
                        ]
                    }
