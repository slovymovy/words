                                "target_senses": [
                                    {
                                        "sense_id": "73359b03-26ba-3394-b188-9a0d30f8d1be",
                                        "entry_id": "b07a5d1e-e7bf-3aa9-ade3-7dcc9d39b878",
                                        "glosses": [
                                            "Any extrasolar rocky planet several times larger than Earth, especially such a planet detected as it transits its star."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05d502e4-9e4a-45fc-a6fd-a4d3f648bbf1",
                                                "sense_id": "73359b03-26ba-3394-b188-9a0d30f8d1be",
                                                "text": "Researchers had been hoping to spot water vapor in the atmosphere of a more Earth-like planet, especially one in its star’s habitable zone, but these worlds are relatively small, making observations of their atmospheres extraordinarily difficult. The larger the planet, the easier the detection, so researchers focused their efforts on super-Earths: planets with masses up to 10 times that of our home planet, which means they might also sport rocky surfaces."
                                            }
                                        ]
                                    }
