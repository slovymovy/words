                        "examples": [
                            {
                                "example_id": "6be0d6ca-8bdb-4f97-b59f-648447cb10dd",
                                "sense_id": "9030038e-895f-32af-8ff6-30ec3c5315d1",
                                "text": "Le cheminement d’avérage est semblable, du terme « avoir » possession, à la signification spécialisée, en provençal du terme avérage = bétail menu, ovin ou caprin."
                            },
                            {
                                "example_id": "435fe56f-c4c3-4d6b-83aa-b04c4b298370",
                                "sense_id": "9030038e-895f-32af-8ff6-30ec3c5315d1",
                                "text": "« L’avérage cabrun » est placé entre les « bestes lainues » et la dernière des bêtes à poil : le porc."
                            },
                            {
                                "example_id": "9d1073ce-2c56-4a4f-b262-af26ef621b65",
                                "sense_id": "9030038e-895f-32af-8ff6-30ec3c5315d1",
                                "text": "Or, beaucoup de particuliers, toujours au mépris des anciennes capitulations, ont pris silencieusement « l’habitude d’introduire divers troupeaux d’avérages étrangers qu’ils font dépaître durant l’été aux herbages communs, au détriment du public et du particulier »."
                            }
                        ]
