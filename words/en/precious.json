{
    "word_family": [
        "preciously",
        "preciousness",
        "semiprecious"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c4e1c128-cb20-3e32-820a-d41afbea3c2d",
                    "sense_definition": "Of high financial value, great worth, or importance.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "value_worth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gold and silver are examples of <w>precious</w> metals.",
                            "target_lang_translations": {
                                "ru": "Золото и серебро — это примеры <w>драгоценных</w> металлов.",
                                "tr": "Altın ve gümüş <w>değerli</w> metallere örnektir.",
                                "zh": "黄金和白银是<w>珍贵</w>金属的例子。"
                            }
                        },
                        {
                            "text": "We should not waste our <w>precious</w> time on trivial matters.",
                            "target_lang_translations": {
                                "ru": "Мы не должны тратить наше <w>драгоценное</w> время на пустяки.",
                                "tr": "<w>Değerli</w> zamanımızı önemsiz meselelerle harcamamalıyız.",
                                "zh": "我们不应该把<w>宝贵</w>的时间浪费在琐事上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "valuable",
                        "dear",
                        "prized",
                        "treasured"
                    ],
                    "antonyms": [
                        "worthless",
                        "cheap"
                    ],
                    "common_phrases": [
                        "precious metal",
                        "precious stone",
                        "precious time",
                        "precious resource"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий высокую финансовую стоимость, большую ценность или важность.",
                        "tr": "Yüksek maddi değere, büyük kıymete veya öneme sahip olan.",
                        "zh": "指具有高昂的经济价值、重要性或意义。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "драгоценный",
                                "target_lang_sense_clarification": "о металлах, камнях или времени"
                            },
                            {
                                "target_lang_word": "ценный",
                                "target_lang_sense_clarification": "имеющий высокую значимость или стоимость"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "değerli",
                                "target_lang_sense_clarification": "yüksek değere veya öneme sahip"
                            },
                            {
                                "target_lang_word": "kıymetli",
                                "target_lang_sense_clarification": "maddi veya manevi değeri yüksek olan"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "珍贵",
                                "target_lang_sense_clarification": "指价值高、意义重大"
                            },
                            {
                                "target_lang_word": "贵重",
                                "target_lang_sense_clarification": "指物品价值高"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8355c347-8580-39ba-a925-6bf059039b0d",
                    "sense_definition": "Regarded with deep love, tenderness, or affection.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "affection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her children are very <w>precious</w> to her.",
                            "target_lang_translations": {
                                "ru": "Дети ей очень <w>дороги</w>.",
                                "tr": "Çocukları onun için çok <w>değerli</w>.",
                                "zh": "孩子们对她来说非常<w>宝贵</w>。"
                            }
                        },
                        {
                            "text": "I keep all my <w>precious</w> memories in this photo album.",
                            "target_lang_translations": {
                                "ru": "Я храню все свои <w>драгоценные</w> воспоминания в этом фотоальбоме.",
                                "tr": "Tüm <w>kıymetli</w> anılarımı bu fotoğraf albümünde saklıyorum.",
                                "zh": "我把所有<w>珍贵</w>的回忆都保存在这本相册里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dear",
                        "valuable"
                    ],
                    "common_phrases": [
                        "precious memory",
                        "precious gift"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любимый, дорогой сердцу, вызывающий глубокую нежность.",
                        "tr": "Derin bir sevgi, şefkat veya bağlılıkla el üstünde tutulan.",
                        "zh": "指因深爱、疼爱或依恋而倍加珍惜。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дорогой",
                                "target_lang_sense_clarification": "близкий сердцу, любимый"
                            },
                            {
                                "target_lang_word": "драгоценный",
                                "target_lang_sense_clarification": "в переносном смысле: очень важный и любимый"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "değerli",
                                "target_lang_sense_clarification": "sevilen, el üstünde tutulan"
                            },
                            {
                                "target_lang_word": "kıymetli",
                                "target_lang_sense_clarification": "manevi olarak çok özel ve önemli olan"
                            },
                            {
                                "target_lang_word": "sevgili",
                                "target_lang_sense_clarification": "çok sevilen, aziz"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宝贵",
                                "target_lang_sense_clarification": "指极具价值或令人珍惜"
                            },
                            {
                                "target_lang_word": "亲爱",
                                "target_lang_sense_clarification": "指关系亲密、深爱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c8bde72-af6f-3152-b63a-235f49af0b41",
                    "sense_definition": "Extremely protective, strict, or sensitive about something, often unreasonably so.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude_protective",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Artists can sometimes be very <w>precious</w> about their work.",
                            "target_lang_translations": {
                                "ru": "Художники иногда бывают очень <w>щепетильны</w> в отношении своих работ.",
                                "tr": "Sanatçılar bazen eserleri konusunda çok <w>titiz</w> olabiliyorlar.",
                                "zh": "艺术家有时会对自己的作品非常<w>挑剔</w>。"
                            }
                        },
                        {
                            "text": "He is too <w>precious</w> about his car and won't let anyone else drive it.",
                            "target_lang_translations": {
                                "ru": "Он слишком <w>трясется</w> над своей машиной и никому не дает ее водить.",
                                "tr": "Arabası konusunda fazla <w>korumacı</w> ve kimsenin onu sürmesine izin vermiyor.",
                                "zh": "他太<w>宝贝</w>他的车了，不让任何人开。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "precious about"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезмерно щепетильный, требовательный или обидчивый в отношении чего-либо.",
                        "tr": "Bir şey konusunda genellikle makul olmayan derecede korumacı, hassas veya titiz olan.",
                        "zh": "指对某事过于保护、挑剔或敏感，通常是不合理的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щепетильный",
                                "target_lang_sense_clarification": "чрезмерно заботящийся о деталях или своем статусе"
                            },
                            {
                                "target_lang_word": "трепетный",
                                "target_lang_sense_clarification": "относящийся с излишним волнением или заботой"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "titiz",
                                "target_lang_sense_clarification": "aşırı hassas veya sakınan"
                            },
                            {
                                "target_lang_word": "aşırı korumacı",
                                "target_lang_sense_clarification": "bir şeyin üzerine fazla düşen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挑剔",
                                "target_lang_sense_clarification": "指对细节过于苛求"
                            },
                            {
                                "target_lang_word": "过分敏感",
                                "target_lang_sense_clarification": "指对某事反应过度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4c4f9db-f55e-3f86-9866-c8660e3df8dd",
                    "sense_definition": "Artificial, affected, or contrived to be cute or charming in a way that seems insincere.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "attitude_style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie's dialogue was a bit <w>precious</w> and did not sound natural.",
                            "target_lang_translations": {
                                "ru": "Диалоги в фильме были немного <w>манерными</w> и звучали неестественно.",
                                "tr": "Filmin diyalogları biraz <w>yapmacıktı</w> ve doğal durmuyordu.",
                                "zh": "电影里的对白有点<w>做作</w>，听起来不自然。"
                            }
                        },
                        {
                            "text": "She found the decor too <w>precious</w> for her simple taste.",
                            "target_lang_translations": {
                                "ru": "Она сочла декор слишком <w>вычурным</w> для своего простого вкуса.",
                                "tr": "Dekorasyonu kendi sade zevkine göre fazla <w>abartılı</w> buldu.",
                                "zh": "她觉得这种装饰对于她朴素的品味来说太<w>矫揉造作</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "twee",
                        "saccharine",
                        "syrupy"
                    ],
                    "common_phrases": [
                        "a bit precious"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неестественный, манерный, нарочито изысканный, кажущийся неискренним.",
                        "tr": "Samimiyetsiz görünecek şekilde sevimli veya çekici olmaya çalışan, yapmacık veya abartılı.",
                        "zh": "指刻意表现出的可爱或迷人，显得不自然或虚伪。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "манерный",
                                "target_lang_sense_clarification": "о поведении или речи"
                            },
                            {
                                "target_lang_word": "вычурный",
                                "target_lang_sense_clarification": "о стиле или декоре"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yapmacık",
                                "target_lang_sense_clarification": "doğal olmayan, aşırı süslü"
                            },
                            {
                                "target_lang_word": "abartılı",
                                "target_lang_sense_clarification": "zorlama bir şirinliğe veya üsluba sahip"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "做作",
                                "target_lang_sense_clarification": "指行为不自然、虚假"
                            },
                            {
                                "target_lang_word": "矫揉造作",
                                "target_lang_sense_clarification": "指风格或言行过于刻意"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "06f6260d-a2f1-3f74-881e-f4dc1cd7c878",
                    "sense_definition": "Used ironically to express annoyance or disdain for something the speaker considers worthless or annoying.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "attitude_ironic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can keep your <w>precious</w> advice to yourself.",
                            "target_lang_translations": {
                                "ru": "Можешь оставить свои <w>драгоценные</w> советы при себе.",
                                "tr": "O <w>kıymetli</w> tavsiyelerini kendine saklayabilirsin.",
                                "zh": "你可以把你那<w>宝贵</w>的建议留给自己。"
                            }
                        },
                        {
                            "text": "I don't want his <w>precious</w> money if it comes with conditions.",
                            "target_lang_translations": {
                                "ru": "Мне не нужны его <w>драгоценные</w> деньги, если они даются с условиями.",
                                "tr": "Şartlarla gelecekse onun o <w>değerli</w> parasını istemiyorum.",
                                "zh": "如果他的钱附带条件，我才不稀罕他那<w>宝贵</w>的钱。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used to express irony or annoyance"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется иронично для выражения пренебрежения к тому, что говорящий считает бесполезным или раздражающим.",
                        "tr": "Konuşanın değersiz veya can sıkıcı bulduğu bir şeye yönelik küçümseme veya ironi ifade etmek için kullanılır.",
                        "zh": "用于讽刺，表达对说话者认为无价值或令人讨厌的事物的蔑视。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "драгоценный",
                                "target_lang_sense_clarification": "ироничное использование"
                            },
                            {
                                "target_lang_word": "хвалёный",
                                "target_lang_sense_clarification": "иронично о чем-то переоцененном"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "kıymetli",
                                "target_lang_sense_clarification": "ironik anlamda, 'çok değerli sandığın'"
                            },
                            {
                                "target_lang_word": "değerli",
                                "target_lang_sense_clarification": "sitem veya ironi içeren kullanım"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "所谓的",
                                "target_lang_sense_clarification": "用于讽刺，表示不屑"
                            },
                            {
                                "target_lang_word": "宝贵",
                                "target_lang_sense_clarification": "反语，用于讽刺"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "709fdd51-50ff-3beb-8639-140117fb9ffa",
                    "sense_definition": "Very; used as an intensifier, typically with words indicating a small amount.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is <w>precious</w> little time left to finish the project.",
                            "target_lang_translations": {
                                "ru": "Осталось <w>очень</w> мало времени, чтобы закончить проект.",
                                "tr": "Projeyi bitirmek için <w>çok</w> az zaman kaldı.",
                                "zh": "完成这个项目剩下的时间<w>极</w>少。"
                            }
                        },
                        {
                            "text": "We have <w>precious</w> few opportunities to meet these days.",
                            "target_lang_translations": {
                                "ru": "В наши дни у нас <w>крайне</w> мало возможностей видеться.",
                                "tr": "Bu günlerde görüşmek için <w>son derece</w> az fırsatımız var.",
                                "zh": "这些天我们见面的机会<w>极</w>少。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "precious little",
                        "precious few"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень, крайне; используется для усиления значения, обычно с указанием на малое количество.",
                        "tr": "Çok; genellikle az miktar belirten kelimelerle pekiştirici olarak kullanılır.",
                        "zh": "非常；用作强调，通常用于表示数量极少。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очень",
                                "target_lang_sense_clarification": "усилительная частица"
                            },
                            {
                                "target_lang_word": "крайне",
                                "target_lang_sense_clarification": "в значении чрезвычайно"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "çok",
                                "target_lang_sense_clarification": "az miktar belirten yapılarla vurgu için"
                            },
                            {
                                "target_lang_word": "son derece",
                                "target_lang_sense_clarification": "kısıtlı miktarları vurgulamak için"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "极",
                                "target_lang_sense_clarification": "用作强调，表示“非常”"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "4efc02be-dd44-34a2-936f-c52ae8756137",
                    "sense_definition": "A female given name.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "name_given",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My friend <w>Precious</w> is coming to visit tomorrow.",
                            "target_lang_translations": {
                                "ru": "Моя подруга <w>Прешес</w> приедет в гости завтра.",
                                "tr": "Arkadaşım <w>Precious</w> yarın ziyarete geliyor.",
                                "zh": "我的朋友<w>普雷舍斯</w>明天要来拜访。"
                            }
                        },
                        {
                            "text": "She named her daughter <w>Precious</w> because she was a miracle baby.",
                            "target_lang_translations": {
                                "ru": "Она назвала дочь <w>Прешес</w>, потому что та была чудо-ребенком.",
                                "tr": "Kızına mucize bir bebek olduğu için <w>Precious</w> adını verdi.",
                                "zh": "她给女儿取名<w>普雷舍斯</w>，因为她是一个奇迹宝宝。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское имя.",
                        "tr": "Bir kadın ismi.",
                        "zh": "女性名字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Прешес",
                                "target_lang_sense_clarification": "транслитерация имени"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "Precious",
                                "target_lang_sense_clarification": "özel isim"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "普雷舍斯",
                                "target_lang_sense_clarification": "音译名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2fa1c6a-b290-3b89-a1ae-e67c74bff52f",
