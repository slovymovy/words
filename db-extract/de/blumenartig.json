                "senses": [
                    {
                        "sense_id": "bedeefba-abb3-3ee9-9c33-c8a049098c5a",
                        "entry_id": "e08f150f-f3b9-3ce5-928d-379adce14a56",
                        "glosses": [
                            "wie eine Blume (aussehend); einer Blume ähnelnd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aee8fc65-9c67-4bb1-82cc-f6cfc9297c1e",
                                "sense_id": "bedeefba-abb3-3ee9-9c33-c8a049098c5a",
                                "text": "„Außerdem hat Leo die ganze Stunde lang blumenartige Krickelkrakel ins Heft gemalt.“"
                            },
                            {
                                "example_id": "864ead05-57a5-4a6d-96d6-0cf2e5472454",
                                "sense_id": "bedeefba-abb3-3ee9-9c33-c8a049098c5a",
                                "text": "„Wiederum andere Bauten schienen gewachsene Kristalle oder blumenartige Korallen zu sein.“"
                            },
                            {
                                "example_id": "30fd7bcd-8edc-428c-b314-430521e4b936",
                                "sense_id": "bedeefba-abb3-3ee9-9c33-c8a049098c5a",
                                "text": "„Der blumenartige Kelch besteht aus 5 verkehrt eirunden, glänzend goldgelben Blättern, die Blumenkrone fehlt.“"
                            }
                        ],
