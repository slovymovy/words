                            {
                                "example_id": "05232f9f-0e05-45b1-93e6-7f46fdba3d1a",
                                "sense_id": "166c3ad2-f450-331e-96d3-a23093b03f3f",
                                "text": "In de video kijken de leden van CMon & Kypski aanvankelijk in de camera alsof het een spiegel is. Ze frummelen aan hun colbert, modelleren hun kuif en strikken een dasje."
                            }
                        ]
