                                        "glosses": [
                                            "nicht der Ethik und Moral entsprechend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96e01cf6-c8ec-4419-9439-ecb2afc7b779",
                                                "sense_id": "122a105c-fa34-3cd7-9000-76cd8cd25a42",
                                                "text": "„Es sei zwar unethisch, das Recht auf Leben eines potentiellen Kindes an dessen Geschlecht festzumachen. Es sei aber auch nicht möglich, Menschen, die so etwas unbedingt wollten, das Recht auf Freizügigkeit zu nehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
