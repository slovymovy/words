                "senses": [
                    {
                        "sense_id": "486501ab-4c11-3a94-8161-c29d5b5bc5ee",
                        "entry_id": "28662c95-10fd-32be-9929-21de951dc12e",
                        "glosses": [
                            "ununterbrochenes Schießen mit einem Maschinengewehr"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21ffff8c-0b21-4535-b389-898ec3de47e4",
                                "sense_id": "486501ab-4c11-3a94-8161-c29d5b5bc5ee",
                                "text": "„Sie hatten die Attacke querfeldein geführt, waren durch Maschinengewehrfeuer von der tief gelegenen Straße und den Bauernhäusern her aufgehalten worden, waren dann im Ort auf keinerlei Widerstand gestoßen und hatten das Flussufer erreicht.“"
                            },
                            {
                                "example_id": "1a8c0931-d6a0-4a50-b7cf-2b95c307e82d",
                                "sense_id": "486501ab-4c11-3a94-8161-c29d5b5bc5ee",
                                "text": "„Das Maschinengewehrfeuer ließ allmählich nach.“"
                            },
                            {
                                "example_id": "c5acda57-44ef-4822-9a6d-ee2e29ad53cc",
                                "sense_id": "486501ab-4c11-3a94-8161-c29d5b5bc5ee",
                                "text": "„Heute früh wurden wir durch Maschinengewehrfeuer geweckt.“"
                            },
                            {
                                "example_id": "a1713258-f3da-438e-9c1d-4dc27f10ca69",
                                "sense_id": "486501ab-4c11-3a94-8161-c29d5b5bc5ee",
                                "text": "„Seitdem lag das von unseren Truppen zurückeroberte Schloß mitten im Kriegsgebiet und war ständig plötzlichen Überfällen mit Maschinengewehrfeuer ausgesetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
