                "senses": [
                    {
                        "sense_id": "d95796f8-8d52-3cf8-b4de-08cb6fcdb300",
                        "entry_id": "59e8e360-090b-3b6f-8997-754a3aeb3647",
                        "glosses": [
                            "Donner un caractère de plasma à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5887e30-21dd-4114-ae0d-d194c00b7bdb",
                                "sense_id": "d95796f8-8d52-3cf8-b4de-08cb6fcdb300",
                                "text": "Ce procédé est caractérisé en ce qu'il comprend les étapes consistant à réduire une pression à l'intérieur du conteneur en plastique ou à réduire une pression de toute la partie du conteneur en plastique, à écouler du gaz sec comme gaz de fuite lorsque le vide est libéré en vue de remplir l'intérieur du conteneur avec le gaz sec pour sécher le conteneur en plastique, à remplacer le gaz à l'intérieur du conteneur en plastique un gaz matériel ou un gaz contenant du gaz matériel, et à plasmatiser le gaz matériel afin de former un film à perméabilité au gaz sur la surface interne du conteneur en plastique par le biais d'une méthode de dépôt chimique en phase vapeur."
                            },
                            {
                                "example_id": "0a8c29aa-4f76-495c-8200-571570806384",
                                "sense_id": "d95796f8-8d52-3cf8-b4de-08cb6fcdb300",
                                "text": "Les dreads se retournent et avoinent les termicides, n'en laissant qu'un qui se fait plasmatiser la gueule par l'escouade dans la ruine."
                            },
                            {
                                "example_id": "080573ce-4f3a-41d5-9504-708086c06af4",
                                "sense_id": "d95796f8-8d52-3cf8-b4de-08cb6fcdb300",
                                "text": "Naître, aimer, rire, s'egotiser, détester, se planter, baiser, se plasmatiser, mourir, rire de soi et des autres, etc."
                            }
                        ]
                    }
                ],
