                    {
                        "sense_id": "b7f1a91a-2812-388a-afce-1eff6aad2935",
                        "entry_id": "0b046ea1-3e15-3c81-9c68-265f3294366a",
                        "glosses": [
                            "Bubo bubo een van de grootste uilen ter wereld, en vermoedelijk de op een na grootste uilensoort na de Blakistons visuil. De wetenschappelijke naam van de soort werd als Strix bubo in 1758 gepubliceerd door Carl Linnaeus. De vogel heeft zijn naam te danken aan zijn roep. Vooral in de late winter laat het mannetje zijn imposante \\\"oehoe\\\"-roep horen"
                        ],
                        "tags": [
                            "uilen"
                        ],
                        "examples": [
                            {
                                "example_id": "4192cbd0-7cde-4d2c-87bd-2461d4cacec1",
                                "sense_id": "b7f1a91a-2812-388a-afce-1eff6aad2935",
                                "text": "Een oehoe kan muizen vangen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b9b8f9d1-dd27-4975-9544-064872cc71f1",
                        "source_entry_id": "0b046ea1-3e15-3c81-9c68-265f3294366a",
                        "source_sense_id": "b7f1a91a-2812-388a-afce-1eff6aad2935",
                        "target_lang_word": "Uhu",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Uhu",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "33286fd4-f6d5-3a5b-8f9b-dc3e94c4240c",
                                        "entry_id": "97cc310b-b46f-3339-823e-5a6944c189da",
                                        "glosses": [
                                            "größte, in der Dämmerung jagende Eule, speziell der Eurasische Uhu , mit auffälligen Federohren, orangeroten Augen und dunkelbraun geflecktem Gefieder, die in waldigen Vorgebirgen lebt"
                                        ],
                                        "tags": [
                                            "Bubo bubo"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "406cc355-2d3f-4eec-85d4-1784434df00c",
                                                "sense_id": "33286fd4-f6d5-3a5b-8f9b-dc3e94c4240c",
                                                "text": "Der Uhu ist Vogel des Jahres 2005."
                                            },
                                            {
                                                "example_id": "edebcbbd-dcf6-490a-88de-5f2f7fd505ea",
                                                "sense_id": "33286fd4-f6d5-3a5b-8f9b-dc3e94c4240c",
                                                "text": "„Draußen aber heulte der Uhu sein monotones, schauriges Morgenlied, ein paar Wölfe antworteten aus weiter Ferne, und ein mattes Licht, das von dem östlichen Himmel ausging, kündeten den nahenden Morgen.“"
                                            },
                                            {
                                                "example_id": "fab88c60-d0eb-4322-8b1d-1e912a5878fb",
                                                "sense_id": "33286fd4-f6d5-3a5b-8f9b-dc3e94c4240c",
                                                "text": "„Er fuhr mit quietschenden Reifen davon, um den verletzten Uhu schnellstmöglich zur Tierärztin in der Wildauffangstation zu bringen, während Jean den Kopf schüttelte und französische Flüche vor sich hin murmelte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "15ed35a9-f38b-3617-8c50-aeb68c3ed417",
                                        "entry_id": "97cc310b-b46f-3339-823e-5a6944c189da",
                                        "glosses": [
                                            "Universalkleber"
                                        ],
                                        "tags": [
                                            "meist männlich",
                                            "bisweilen sächlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e7913d4-0c95-4ab1-ab28-0c416c6e75c8",
                                                "sense_id": "15ed35a9-f38b-3617-8c50-aeb68c3ed417",
                                                "text": "Reich mir bitte mal den/das Uhu rüber!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
