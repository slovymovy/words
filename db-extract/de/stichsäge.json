                        "entry_id": "0b03a3b4-4279-3517-9993-a23e2fd8df57",
                        "glosses": [
                            "Säge mit spitz zulaufendem, freistehendem Blatt zum Einsägen von Löchern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37492b39-6912-456e-880e-b05ad8d26693",
                                "sense_id": "c3b18454-7041-3080-a96e-c3665419c155",
                                "text": "„Die Stichsäge durchtrennt Paneelbretter; Männer hieven dicke Balken auf Wände: In mehreren Wochenendeinsätzen besorgen Sportler einen Teil des Innenausbaus der neuen Hülseder Sporthalle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
