                    {
                        "translation_id": "a081858c-6646-43f2-b79b-aa37adef4bc4",
                        "source_entry_id": "5809e75d-e602-3fb6-81f4-08cd672d93ab",
                        "source_sense_id": "40af1d97-1811-39f3-ab0c-1a721b98c4df",
                        "target_lang_word": "А́льпы",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "А́льпы",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c88ec941-a0b1-3c94-9e45-9a540428c3de",
                                        "entry_id": "a9a3ed16-d088-30d9-baa6-e7de518fca7a",
                                        "glosses": [
                                            "геогр. горная система в Западной Европе, проходящая по территории восьми государств: Франции, Монако, Италии, Швейцарии, Германии, Австрии, Лихтенштейна, Словении; наивысшая точка — гора Монблан (4808 метров)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6520185-aa6b-44fb-bdb6-0991854b2007",
                                                "sense_id": "c88ec941-a0b1-3c94-9e45-9a540428c3de",
                                                "text": "Флорентийские Альпы проезжали мы в такой темноте, что зажигали факелы, которые от преужасного вихря и дождя гасли."
                                            },
                                            {
                                                "example_id": "c1aea518-4fb6-41d9-8ad0-f1ed4ae17d20",
                                                "sense_id": "c88ec941-a0b1-3c94-9e45-9a540428c3de",
                                                "text": "Вскоре перешли они границу, перебрались чрез грозные Альпы и очутились во Франции."
                                            },
                                            {
                                                "example_id": "50365a89-9bde-4f0e-9985-3eda8915d610",
                                                "sense_id": "c88ec941-a0b1-3c94-9e45-9a540428c3de",
                                                "text": "Во время захождения солнца снега Альп покрываются тонким розовым и огненным светом."
                                            },
                                            {
                                                "example_id": "37fce2b8-45b8-41fd-9b3b-f73d71961701",
                                                "sense_id": "c88ec941-a0b1-3c94-9e45-9a540428c3de",
                                                "text": "Он долго бродил в Альпах, пока не набрел на небольшой монастырь францисканцев."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
