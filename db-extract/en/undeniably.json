    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b3165dcb-4db1-31ce-9488-72ee7fe496b1",
                "word": "undeniably",
                "pos": "adv",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "bd2418bd-575b-4d40-b8e0-a1f0cb5fdb79",
                        "entry_id": "b3165dcb-4db1-31ce-9488-72ee7fe496b1",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more undeniably"
                    },
                    {
                        "form_id": "4ed59794-cdf8-4e7a-a2ef-2a7177bf8d97",
                        "entry_id": "b3165dcb-4db1-31ce-9488-72ee7fe496b1",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most undeniably"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "13906b8a-feb2-3506-800a-bdef505d7a60",
                        "entry_id": "b3165dcb-4db1-31ce-9488-72ee7fe496b1",
                        "glosses": [
                            "In an undeniable manner, or to an undeniable extent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea50f2e1-a2f7-42b8-ad5e-ed6b7144157f",
                                "sense_id": "13906b8a-feb2-3506-800a-bdef505d7a60",
                                "text": "[A]nd gaunt though his figure, and far from elegant though his dressing-robe, there was that about him which spoke undeniably of the grand seigneur— [...]"
                            },
                            {
                                "example_id": "a2dbeef0-1510-4d1a-9ffd-bd782575180c",
                                "sense_id": "13906b8a-feb2-3506-800a-bdef505d7a60",
                                "text": "It created inter-city and intermodal services, which were genuinely world leading. And it undeniably pushed British Railways into the modern era."
                            }
                        ]
                    },
                    {
                        "sense_id": "465750b6-3e34-3a27-bbbe-57b8b989ec7e",
                        "entry_id": "b3165dcb-4db1-31ce-9488-72ee7fe496b1",
                        "glosses": [
                            "Used as a modal adverb to assert that that the indicated statement is undeniable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15aee179-ba9a-4590-b25d-871ecfb52087",
                                "sense_id": "465750b6-3e34-3a27-bbbe-57b8b989ec7e",
                                "text": "The third movie was undeniably the best."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "26e67c57-844b-410f-b79b-a96d8209fb94",
                        "source_entry_id": "b3165dcb-4db1-31ce-9488-72ee7fe496b1",
                        "source_sense_description": "in an undeniable manner",
                        "target_lang_word": "incontestablement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "incontestablement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bfb1f60e-3089-3cbe-a543-408bcc8ad43d",
                                        "entry_id": "c7d6c007-123d-3de5-bfd7-f6b4ffc610c4",
                                        "glosses": [
                                            "D’une manière incontestable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bde5aa5-c37e-43f5-94ad-800c280ece78",
                                                "sense_id": "bfb1f60e-3089-3cbe-a543-408bcc8ad43d",
                                                "text": "Montesquieu reproche à Dubos qu’il ne saurait montrer l’existence de la république armorique : cependant Dubos l’a prouvée incontestablement par plusieurs monuments et surtout par cette citation exacte de l’historien Zozime."
                                            },
                                            {
                                                "example_id": "7f6fd90d-ede9-49c9-82a9-94f3d88802d6",
                                                "sense_id": "bfb1f60e-3089-3cbe-a543-408bcc8ad43d",
                                                "text": "Un enfant, dépourvu de force et d’intelligence, a incontestablement un droit naturel à la subsistance, fondé sur le devoir prescrit par la nature au pere et à la mere."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b78b2621-f4b3-3810-9c6e-fd6044363144",
                                        "entry_id": "c7d6c007-123d-3de5-bfd7-f6b4ffc610c4",
                                        "glosses": [
                                            "Sans conteste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dfcb867-fb79-4111-aa53-9fc5cf4d79c6",
                                                "sense_id": "b78b2621-f4b3-3810-9c6e-fd6044363144",
                                                "text": "S’il est un pays le mieux préparé que tout autre pour entreprendre cette tâche et la mener à bonne fin, c’est incontestablement la France."
                                            },
                                            {
                                                "example_id": "b667bfe0-cc56-452f-b44a-a888f274a4b1",
                                                "sense_id": "b78b2621-f4b3-3810-9c6e-fd6044363144",
                                                "text": "L’origine des bauxites, dit M. Coquand, se rattache incontestablement à l’intervention de sources minérales qui ont apporté, soit dans les lacs, soit à la surface des sols immergés, les aluminates de fer et les diaspores qui constituent les minerais de bauxite."
                                            },
                                            {
                                                "example_id": "dfe868b9-69ec-47c1-b9d7-43db21481a2d",
                                                "sense_id": "b78b2621-f4b3-3810-9c6e-fd6044363144",
                                                "text": "Charles le Bel, qui s’était opposé à la loi salique, prit incontestablement la couronne et exclut les filles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d607650-a299-441a-800f-75d324d62ced",
                        "source_entry_id": "b3165dcb-4db1-31ce-9488-72ee7fe496b1",
                        "source_sense_description": "in an undeniable manner",
                        "target_lang_word": "indéniablement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indéniablement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f953a54f-7a70-3d1c-a8e2-258624e97da5",
                                        "entry_id": "5543414e-5b87-3612-ba4c-692f62fe854b",
                                        "glosses": [
                                            "D'une manière indéniable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b75f36e0-6b93-4c25-9dd6-fdefeb243680",
                                                "sense_id": "f953a54f-7a70-3d1c-a8e2-258624e97da5",
                                                "text": "Le sénateur Bruno Retailleau fait indéniablement partie de cette droite qui en pince pour Thatcher, souhaite la suppression de dizaines de milliers de postes de fonctionnaire dans les années qui viennent et jetterait le mariage pour tous aux orties si elle en avait le pouvoir."
                                            },
                                            {
                                                "example_id": "d40ac1f4-98e3-4d06-b080-7941a0abbecd",
                                                "sense_id": "f953a54f-7a70-3d1c-a8e2-258624e97da5",
                                                "text": "Si la baisse par rapport à 2022 est indéniablement un phénomène positif, les statistiques révèlent quelques tendances inquiétantes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
