                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "media_production",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The film crew will begin <w>shooting</w> on location in Paris next month.",
                            "target_lang_translations": {
                                "ru": "Съемочная группа начнет <w>съемки</w> на натуре в Париже в следующем месяце."
                            }
                        },
                        {
                            "text": "They had to delay the <w>shooting</w> schedule because of the heavy rain.",
                            "target_lang_translations": {
                                "ru": "Им пришлось отложить график <w>съемок</w> из-за сильного дождя."
                            }
