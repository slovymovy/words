{
    "word_family": [
        "assoupissant",
        "assoupissement"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "443af988-0ac4-35bf-94f4-bedf917ded49",
                    "sense_definition": "Endormir à demi ou plonger dans une douce somnolence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sommeil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La chaleur étouffante de l'après-midi a fini par <w>assoupir</w> les enfants dans le salon."
                        },
                        {
                            "text": "Ce trajet monotone en train a eu pour effet de m'<w>assoupir</w> profondément."
                        }
                    ],
                    "synonyms": [
                        "endormir",
                        "engourdir"
                    ],
                    "antonyms": [
                        "réveiller",
                        "stimuler"
                    ],
                    "common_phrases": [
                        "assoupir les sens"
                    ]
                },
                {
                    "sense_id": "e88df64f-381d-3077-b306-3fc2908aa886",
                    "sense_definition": "Atténuer, calmer ou suspendre momentanément une souffrance, une douleur ou une inquiétude.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attenuation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin lui a prescrit une potion pour <w>assoupir</w> la douleur pendant la nuit."
                        },
                        {
                            "text": "Cette douce mélodie semblait <w>assoupir</w> ses angoisses et apaiser son esprit tourmenté."
                        }
                    ],
                    "synonyms": [
                        "apaiser",
                        "atténuer",
                        "calmer"
                    ],
                    "antonyms": [
                        "aviver",
                        "raviver"
                    ],
                    "common_phrases": [
                        "assoupir la douleur"
                    ]
                },
                {
                    "sense_id": "88a110da-62d1-33f9-9bcc-b2cf458442a4",
                    "sense_definition": "Étouffer ou faire cesser une querelle, un conflit ou un scandale avant qu'il ne prenne de l'ampleur.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attenuation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les diplomates ont tout fait pour <w>assoupir</w> un différend qui menaçait la paix."
                        },
                        {
                            "text": "Le directeur a tenté d'<w>assoupir</w> l'affaire pour éviter des poursuites judiciaires."
                        }
                    ],
                    "synonyms": [
                        "étouffer",
                        "apaiser"
                    ],
                    "antonyms": [
                        "attiser",
                        "envenimer"
                    ],
                    "common_phrases": [
                        "assoupir un différend",
                        "assoupir une querelle"
                    ]
                },
                {
                    "sense_id": "b6904246-153a-3415-9d03-26c0ff0f1204",
                    "sense_definition": "Perdre progressivement de son intensité, faiblir ou s'apaiser avec le temps.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attenuation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après la tempête matinale, la violence des vents a fini par s'<w>assoupir</w> vers le soir."
                        },
                        {
                            "text": "Avec les années qui passent, les vieilles rancunes finissent par s'<w>assoupir</w>."
                        }
                    ],
                    "synonyms": [
                        "s'apaiser",
                        "s'atténuer",
                        "faiblir"
                    ],
                    "antonyms": [
                        "s'intensifier",
                        "redoubler"
                    ]
                }
            ]
        }
    ]
}