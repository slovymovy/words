                    },
                    {
                        "sense_id": "57b10e2d-81a8-303f-990a-8324c356122e",
                        "entry_id": "49352448-ae38-391e-a51b-34bb1047f0f6",
                        "glosses": [
                            "An instrument made for detecting and measuring vibrations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cd5a45b-33d1-4297-9b73-e8524afca713",
                                "sense_id": "57b10e2d-81a8-303f-990a-8324c356122e",
                                "text": "Near-synonym: vibrometer"
                            },
                            {
                                "example_id": "147c2f63-ef53-45c4-8802-b4866ce5b844",
                                "sense_id": "57b10e2d-81a8-303f-990a-8324c356122e",
                                "text": "Working with NR, ScotRail and Porterbrook, Perpetuum has fitted sensors with gyroscopes and accelerometers to trains that are already in passenger service."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf825c5b-4a4e-461f-bdd0-5d57760e8da5",
                        "source_entry_id": "49352448-ae38-391e-a51b-34bb1047f0f6",
                        "source_sense_description": "instrument for measuring acceleration",
                        "target_lang_word": "versnellingsmeter",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "versnellingsmeter",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c5c5e864-9fd0-3808-bc5c-c8eab69e0cb6",
                                        "entry_id": "2df9896a-c401-3cca-99d4-75cbd0468a43",
                                        "glosses": [
                                            "toestel dat versnellingen kan meten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "952c7fac-e8fa-4a19-80b9-9c4c3e439282",
                                                "sense_id": "c5c5e864-9fd0-3808-bc5c-c8eab69e0cb6",
                                                "text": "De vanaf morgen verkrijgbare iPhone 6, maar ook de Apple Watch en de Simband van Samsung, zijn allemaal gefocust op gezondheid. De nieuwe iPhone heeft een metertje dat kan berekenen of je aan het traplopen bent of aan het fietsen. In combinatie met de Apple Watch wordt je hartslag continu gemeten. De versnellingsmeter telt de stappen die je loopt en rekent uit hoeveel calorieën je verbrandt."
                                            },
                                            {
                                                "example_id": "6ad134da-d858-4cb2-a447-5a2af16d16d3",
                                                "sense_id": "c5c5e864-9fd0-3808-bc5c-c8eab69e0cb6",
                                                "text": "Het leer- en ontwikkelingscentrum op Schiphol is nu officieel open. Een feest voor de tientallen aanwezige kinderen, die gelijk enthousiast aan de slag gaan met hun minicomputer die eruit ziet als een printplaatje. Deze ‘micro:bit’ heeft een LED-lichtdisplay met 25 lampjes, twee knoppen en sensoren. Op het machientje van 20 euro zit een versnellingsmeter, een kompas en een radio- en Bluetooth-zender die met andere apparaten kan praten. En al die dingen kan de leerling zelf laten werken via simpele programmeersoftware."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "768cd001-2f01-4bd9-8d6d-4d07d9ce1871",
                        "source_entry_id": "49352448-ae38-391e-a51b-34bb1047f0f6",
                        "source_sense_description": "instrument for measuring acceleration",
                        "target_lang_word": "accéléromètre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accéléromètre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "63aae66d-6d77-37d1-adbc-bf2f737704fa",
                                        "entry_id": "8a634e5a-4049-38cf-a09d-8e02389980f8",
                                        "glosses": [
                                            "Instrument donnant un enregistrement proportionnel à l’accélération d’un mouvement."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb941bbe-2552-43d6-bd5d-59667c3b53c6",
                                                "sense_id": "63aae66d-6d77-37d1-adbc-bf2f737704fa",
                                                "text": "Grâce à un accéléromètre, dispositif qui mesure l’accélération, c’est-à-dire les variations de vitesse au cours du temps, sans référence externe, on peut, connaissant notre vitesse et notre position initiales, déduire notre vitesse et notre position à chaque instant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "483cde78-97b4-34e7-8478-5970092d3b4e",
                                        "entry_id": "8a634e5a-4049-38cf-a09d-8e02389980f8",
                                        "glosses": [
                                            "Capteur qui transforme une accélération en un signal, souvent électrique, qui lui est proportionnel. — (Jean-Michel Courty et Édouard Kierlik, La Physique buissonnière, Éditions Belin – Pour la science, Paris, 2010, page 40)"
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "653746d9-70a7-4ffc-9ec9-2b4849da130a",
                                                "sense_id": "483cde78-97b4-34e7-8478-5970092d3b4e",
                                                "text": "Le système est couplé avec des données de gyroscope et d’accéléromètre pour le haut, le bas et la ligne d’horizon, développe Thomas Dexmier, vice-président associé EMEA chargé des solutions entreprise chez HTC Vive."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
