                "senses": [
                    {
                        "sense_id": "68681bf2-53fc-380e-9bd0-ae66499fda66",
                        "entry_id": "2a6edc6c-89b0-3a01-845b-94541e3e68a1",
                        "glosses": [
                            "rodzaj komizmu oparty na przejaskrawieniach i zestawieniu kontrastów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b6f1ad7-7499-4722-a8ef-eeec494e17d5",
                                "sense_id": "68681bf2-53fc-380e-9bd0-ae66499fda66",
                                "text": "Kategorie cudowności, fantazji, tajemniczości, grozy i czarnego humoru, charakterystyczne dla surrealizmu, cechują także groteskę, szerszą kategorię artystyczną, obejmującą również ten styl."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "5158d185-75d4-33e3-89ce-e333fc131e7d",
                        "entry_id": "2a6edc6c-89b0-3a01-845b-94541e3e68a1",
                        "glosses": [
                            "utwór literacki, muzyczny lub plastyczny cechujący się silną deformacją i skarykaturyzowaniem świata przedstawionego, niejednolitością, absurdalnością, czy wreszcie mieszaniem fantastyki z rzeczywistością"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "e137b721-4d5d-39db-b048-c5b9bf6bff74",
                        "entry_id": "2a6edc6c-89b0-3a01-845b-94541e3e68a1",
                        "glosses": [
                            "ornament roślinny, w który wplecione są inne elementy, takie jak: postacie ludzkie, zwierzęta, części uzbrojenia, obrazy lub owoce"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    },
                    {
                        "sense_id": "4a715841-a61c-3842-8ff2-ceb0bb443a37",
                        "entry_id": "2a6edc6c-89b0-3a01-845b-94541e3e68a1",
                        "glosses": [
                            "absurdalne wydarzenie, sytuacja"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.4\""
                    },
                    {
                        "sense_id": "4a17d25c-5183-3d60-b59e-5019d8cfbfdb",
                        "entry_id": "2a6edc6c-89b0-3a01-845b-94541e3e68a1",
                        "glosses": [
                            "krój pisma, w którym linie, z których zbudowane są znaki, mają tę samą szerokość i nie mają szeryfów"
                        ],
                        "tags": [],
