            {
                "entry_id": "d34ff52b-fc7e-37c8-8efc-6102cb85eff6",
                "word": "chills",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c4369445-77d0-3453-9570-c2e831f9e20e",
                        "entry_id": "d34ff52b-fc7e-37c8-8efc-6102cb85eff6",
                        "glosses": [
                            "A biological response to being tickled; being cold; or experiencing fear, euphoria or sexual arousal in which the person forms goose bumps."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "e29b02a0-9084-4142-b049-5f32ae484d6e",
                                "sense_id": "c4369445-77d0-3453-9570-c2e831f9e20e",
                                "text": "I get chills every time I hear that song."
                            },
                            {
                                "example_id": "e298b9eb-c0f2-44b9-839f-06a8d68c27b9",
                                "sense_id": "c4369445-77d0-3453-9570-c2e831f9e20e",
                                "text": "That feathery touch on my neck gave me the chills."
                            },
                            {
                                "example_id": "17a6f735-9c8f-468a-9fd5-3b80be2de825",
                                "sense_id": "c4369445-77d0-3453-9570-c2e831f9e20e",
                                "text": "Being under dressed for this weather has given me the chills."
                            },
                            {
                                "example_id": "526130f7-9ae4-43ca-bffc-072034939f63",
                                "sense_id": "c4369445-77d0-3453-9570-c2e831f9e20e",
                                "text": "When I tripped so close to the edge of the cliff, I felt chills across my whole body."
                            },
                            {
                                "example_id": "249016a1-7328-4249-93e5-b98f25c7cbc3",
                                "sense_id": "c4369445-77d0-3453-9570-c2e831f9e20e",
                                "text": "When we made eye contact, my heart fluttered and chills ran down my spine."
                            }
                        ]
                    },
                    {
                        "sense_id": "c7bfc90b-99d5-3efa-8874-fb4e053b273c",
                        "entry_id": "d34ff52b-fc7e-37c8-8efc-6102cb85eff6",
                        "glosses": [
                            "A feeling of being cold, a symptom of many conditions."
