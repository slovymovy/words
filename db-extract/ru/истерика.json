                                    {
                                        "sense_id": "9e0006b9-ac72-3f64-9247-605b7ae662b7",
                                        "entry_id": "ab42d7f7-d56b-3fc6-838d-03535ca73a9d",
                                        "glosses": [
                                            "The art of acting and stagecraft."
                                        ],
                                        "tags": [
                                            "plural",
                                            "singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbd9e2ef-8291-4de6-85fc-58f09b82e6af",
                                                "sense_id": "9e0006b9-ac72-3f64-9247-605b7ae662b7",
                                                "text": "By providing opportunities, time, and props, teachers can help children achieve the theatre standards of participating in sociodramatic playgroups and taking on roles of others in creative dramatics."
