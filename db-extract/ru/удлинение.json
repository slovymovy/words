                ],
                "translations": [
                    {
                        "translation_id": "0b7ba6b3-a88a-4626-bd85-67c903e12031",
                        "source_entry_id": "860f6bfd-f652-3313-b741-a63e9215d541",
                        "source_sense_id": "810dd519-218b-3dc2-a3a2-e9e53fc4ec6e",
                        "target_lang_word": "allongement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "allongement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee52faaa-31df-3614-910d-336facda4574",
                                        "entry_id": "53baf2b0-5fb5-339b-9078-3cfa760f9069",
                                        "glosses": [
                                            "Action d’allonger, ou résultat de cette action (augmentation de la longueur, rallongement)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f3f73f48-c356-424d-b2a3-3dcfe695b4f7",
                                                "sense_id": "ee52faaa-31df-3614-910d-336facda4574",
                                                "text": "L’allongement d’un canal, d’un jardin, d’une allée, d’une avenue."
                                            },
                                            {
                                                "example_id": "4155a276-8eab-4b52-ab61-cd1697b10c6b",
                                                "sense_id": "ee52faaa-31df-3614-910d-336facda4574",
                                                "text": "Les colleurs d’affiches après avoir enduit de colle très liquide le panneau d’affichage appliquent leur papier en le noyant littéralement de colle pour que l’allongement soit rapide et le glissement facile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44fa6f8a-b462-39be-a79b-1ee0f8868c36",
                                        "entry_id": "53baf2b0-5fb5-339b-9078-3cfa760f9069",
                                        "glosses": [
                                            "Allongement relatif, augmentation relative de la longueur d’un matériau."
                                        ],
                                        "tags": [
                                            "ellipsis",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1197935f-5d25-46e2-a1dd-e675a3bf059a",
                                                "sense_id": "44fa6f8a-b462-39be-a79b-1ee0f8868c36",
                                                "text": "Un métal ayant un allongement de plus de 5 % est considéré comme ductile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9589e4b-8973-3806-b79b-36126f8b94bc",
                                        "entry_id": "53baf2b0-5fb5-339b-9078-3cfa760f9069",
                                        "glosses": [
                                            "Caractéristique géométrique de la voilure d′un aéronef. L′allongement est égal au ratio de l′envergure au carré sur la surface portante de l'aile."
                                        ],
                                        "tags": [
                                            "Aérodynamique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfefdfa7-c015-4f7e-9108-3f657131e48e",
                                                "sense_id": "d9589e4b-8973-3806-b79b-36126f8b94bc",
                                                "text": "Les planeurs les plus performants ont un grand allongement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2110a84b-7173-31db-a937-5589653b16d1",
                                        "entry_id": "53baf2b0-5fb5-339b-9078-3cfa760f9069",
                                        "glosses": [
                                            "Sensation visuelle que l'objet est plus long ou filiforme qu'il ne l'est."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81f7ba7e-cfd6-4dd8-a68c-9c848d5af89b",
                                                "sense_id": "2110a84b-7173-31db-a937-5589653b16d1",
                                                "text": "La jupe est droite avec une pièce décorative sur le devant. Au dos un pli creux et un pli couché contribuent à l’allongement de la silhouette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bd62bff-0b0e-3867-ba78-f3b562e52a60",
                                        "entry_id": "53baf2b0-5fb5-339b-9078-3cfa760f9069",
                                        "glosses": [
                                            "Lenteurs affectées et recherchées que certaines gens mettent dans les affaires."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d353832-a707-44f2-a25b-b99e4fa62917",
                                                "sense_id": "7bd62bff-0b0e-3867-ba78-f3b562e52a60",
                                                "text": "C’est un homme qui cherche, qui trouve toujours des allongements."
                                            },
                                            {
                                                "example_id": "6dd5acf3-a373-4914-a4db-bd14ac061742",
                                                "sense_id": "7bd62bff-0b0e-3867-ba78-f3b562e52a60",
                                                "text": "Ce ne sont qu’allongements."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "353683c9-2480-4575-b3a7-ff0f5ea0032d",
                        "source_entry_id": "860f6bfd-f652-3313-b741-a63e9215d541",
                        "source_sense_id": "810dd519-218b-3dc2-a3a2-e9e53fc4ec6e",
                        "target_lang_word": "prolongement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prolongement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "33659f6b-1aa2-39e7-b117-0cc7bf7850f6",
                                        "entry_id": "8796e96b-36a6-3c13-a2b5-8a3d7ee391e4",
                                        "glosses": [
                                            "Extension ou continuation de quelque portion d’étendue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7674fd72-e0e5-43aa-8d15-c284ea6d1a01",
                                                "sense_id": "33659f6b-1aa2-39e7-b117-0cc7bf7850f6",
                                                "text": "Avant 1987, la route pavée en provenance de Stephenville s'arrêtait à Lourdes, tandis que ses prolongements vers La Grand’Terre au sud et L’Anse-à-Canards au nord n'étaient que des chemins de terre, parfois goudronnés, toujours pleins d'ornières."
                                            },
                                            {
                                                "example_id": "0b0e50a4-45e7-494a-b498-ae2ddef1dbe5",
                                                "sense_id": "33659f6b-1aa2-39e7-b117-0cc7bf7850f6",
                                                "text": "Mais cette capture économique n'a pas de prolongement politique fonctionnel. Au contraire, la société urbaine, telle que nous l'avons décrite, échappe à l'emprise politique de l'État."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f09d9636-7048-32ec-ae09-92304af830bc",
                                        "entry_id": "8796e96b-36a6-3c13-a2b5-8a3d7ee391e4",
                                        "glosses": [
                                            "Continuation dans le temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfbcd683-ea9b-47a3-ad06-4664babe5a07",
                                                "sense_id": "f09d9636-7048-32ec-ae09-92304af830bc",
                                                "text": "L'attentat qui s'est produit le 18 septembre 1931 à Moukden, une ville de Mandchourie, est l'un de ces événements oubliés qui ont pourtant changé le monde. En pratique, il fut insignifiant. Mais ses prolongements ont eu des répercussions jusqu'à Hiroshima et Nagasaki les 6 et 9 août 1945."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af65d074-45df-44db-9802-876d9219c538",
                        "source_entry_id": "860f6bfd-f652-3313-b741-a63e9215d541",
                        "source_sense_id": "810dd519-218b-3dc2-a3a2-e9e53fc4ec6e",
                        "target_lang_word": "rallongement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rallongement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eaa847c1-a456-3de0-b68c-103b0e1e9823",
                                        "entry_id": "85e57998-9957-31bb-b927-0f1b49fa607d",
                                        "glosses": [
                                            "Action de rallonger ou résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37febebc-1af3-4af9-84b7-d7d2444f4bc2",
                                                "sense_id": "eaa847c1-a456-3de0-b68c-103b0e1e9823",
                                                "text": "Depuis des années, les associations de lutte contre les violences sexuelles demandent donc un rallongement des délais de prescription, et c’est également une recommandation du HCE."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3cdcc77-6801-42ab-9d97-b136c46c77d0",
                        "source_entry_id": "860f6bfd-f652-3313-b741-a63e9215d541",
                        "source_sense_id": "810dd519-218b-3dc2-a3a2-e9e53fc4ec6e",
                        "target_lang_word": "élongation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "élongation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "279c6dbb-c4c2-3712-8f80-664dc96a0c75",
                                        "entry_id": "f76b23f8-1f64-33cc-984b-49a2d140bf98",
                                        "glosses": [
                                            "Angle apparent, mesuré en degrés, qui sépare deux objets sur la sphère céleste. Presque toujours employé pour décrire la séparation, vu depuis la Terre, entre une planète du système solaire et le Soleil."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4f4f8381-d7dc-37a3-aa91-7f2c28ea01e5",
                                        "entry_id": "f76b23f8-1f64-33cc-984b-49a2d140bf98",
                                        "glosses": [
                                            "Élongation cellulaire, état de plasticité ou d’élasticité de la membrane primaire d’une cellule."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b37e2f46-0072-4d95-8ee9-becd6de71455",
                                                "sense_id": "4f4f8381-d7dc-37a3-aa91-7f2c28ea01e5",
                                                "text": "L’élongation cellulaire est un processus complexe qui fait intervenir une absorption d’eau, l’extension de la paroi sous l’effet de la turgescence, et l’incorporation de nouveaux composés entre les mailles de fibrilles de cellulose ainsi distendues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c4e1dd4-517a-3645-8860-5a4b21a4903a",
                                        "entry_id": "f76b23f8-1f64-33cc-984b-49a2d140bf98",
                                        "glosses": [
                                            "Addition successive d’acides aminés liés par des liaisons peptidiques, au cours de la synthèse naturelle des protéines."
                                        ],
