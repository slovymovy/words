                                "target_senses": [
                                    {
                                        "sense_id": "4298bab0-4aa5-3f0a-83bc-5b28422e01c1",
                                        "entry_id": "afc9f7a9-cac5-3778-8b4b-6d7dcf259b04",
                                        "glosses": [
                                            "sporadische Erscheinung am Himmel, in der Atmosphäre oder an der Erdoberfläche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b7a16ce-15c2-484f-9b1a-cbafba119f98",
                                                "sense_id": "4298bab0-4aa5-3f0a-83bc-5b28422e01c1",
                                                "text": "Meteore können auf unterschiedliche Weise entstehen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "025da8e6-f9eb-39de-ba5b-0ce229c78206",
                                        "entry_id": "afc9f7a9-cac5-3778-8b4b-6d7dcf259b04",
                                        "glosses": [
                                            "Leuchterscheinung durch in die Atmosphäre eintretende Partikel"
                                        ],
                                        "tags": [
                                            "special"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8bc74ea-99ea-410d-b89c-97d0218bb2ec",
                                                "sense_id": "025da8e6-f9eb-39de-ba5b-0ce229c78206",
                                                "text": "Meteore, die auf die auf die Erdoberfläche treffen, nennt man Meteorite."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87798af8-ed1e-4d41-b3f4-8f9ea362e241",
                        "source_entry_id": "27abf076-9a4b-387f-b49f-c5a51bd82ec6",
                        "target_lang_word": "meteor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meteor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d213b97-7329-3bc7-9475-c27e54559267",
                                        "entry_id": "3a4b996d-6375-35dd-b713-6fdca6b3ab8f",
                                        "glosses": [
                                            "An atmospheric or meteorological phenomenon. These were sometimes classified as aerial or airy meteors (winds), aqueous or watery meteors (hydrometeors: clouds, rain, snow, hail, dew, frost), luminous meteors (rainbows and aurora), and igneous or fiery meteors (lightning and shooting stars)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f40a82a-27d1-4dcc-820c-7eb32617ddf5",
                                                "sense_id": "7d213b97-7329-3bc7-9475-c27e54559267",
                                                "text": "Europe, where the Sun dares ſcarce appeare,\nFor freezing Meteors and congealed cold: […]"
                                            },
                                            {
                                                "example_id": "8101ff6c-69fe-4f02-b445-1e4760a7bf7e",
                                                "sense_id": "7d213b97-7329-3bc7-9475-c27e54559267",
                                                "text": "The twilight, the meteors call'd fire-balls, or flying dragons, and the northern lights, inhabit the higher regions of the atmosphere."
                                            },
                                            {
                                                "example_id": "db0f0c48-cbc4-4105-8d3f-c9d1eb8ae9ae",
                                                "sense_id": "7d213b97-7329-3bc7-9475-c27e54559267",
                                                "text": "A meteor in the hazy air / Play’d before his path; / Before him now it roll’d / A globe of livid fire […] Anon to Thalaba it mov’d, / And wrapt him in its pale innocuous fire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d503f69-1d79-35ee-8200-daad0c149c9a",
                                        "entry_id": "3a4b996d-6375-35dd-b713-6fdca6b3ab8f",
                                        "glosses": [
                                            "A fast-moving streak of light in the night sky caused by the entry of extraterrestrial matter into the earth's atmosphere; a shooting star or falling star."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3a71e4bc-7523-3c96-bb7d-9979e6a70762",
                                        "entry_id": "3a4b996d-6375-35dd-b713-6fdca6b3ab8f",
                                        "glosses": [
                                            "A prop similar to poi balls, in that it is twirled at the end of a cord or cable."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c045e76f-e7f3-393b-8360-44923d278639",
                                        "entry_id": "3a4b996d-6375-35dd-b713-6fdca6b3ab8f",
                                        "glosses": [
                                            "A striking weapon resembling a track and field hammer consisting of a weight swung at the end of a cable or chain."
                                        ],
                                        "tags": [],
