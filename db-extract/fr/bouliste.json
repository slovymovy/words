            {
                "entry_id": "6fbe586c-afe6-3a8d-9f5b-640dce9181e1",
                "word": "bouliste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cd7d9204-7cb2-48ee-bac9-88087c79f7a5",
                        "entry_id": "6fbe586c-afe6-3a8d-9f5b-640dce9181e1",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "boulistes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d07a1e00-e964-321d-b9cc-501249524357",
                        "entry_id": "6fbe586c-afe6-3a8d-9f5b-640dce9181e1",
                        "glosses": [
                            "Joueur de boules."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ada51f49-af56-4dfc-a2a6-ca1e6137a8ff",
                                "sense_id": "d07a1e00-e964-321d-b9cc-501249524357",
                                "text": "Le pointage était assuré par ce M. Nivelle, vainqueur des vainqueurs de tous les boulistes de la plaine."
                            },
                            {
                                "example_id": "b2143bf4-6488-4ee1-bdca-a715d8c89e3a",
                                "sense_id": "d07a1e00-e964-321d-b9cc-501249524357",
                                "text": "On raconte que le terrain de boules du Club de boulistes de Southampton remonte au règne d’Édouard 1ᵉʳ (1272-1307), ce qui n'est pas impossible car ce jeu existait certainement au XIIIᵉ siècle."
                            },
                            {
                                "example_id": "8629261d-9d97-4baa-bc9e-cee74065c6fa",
                                "sense_id": "d07a1e00-e964-321d-b9cc-501249524357",
                                "text": "Si l'essor du phénomène associatif (loto des pompiers, des musiciens à la Sainte-Cécile, du club du troisième âge, des parents d'élèves, des anciens combattants, des boulistes, de la paroisse, des chasseurs...) atteste de mutations sociales et favorise des ambiances particulières, il montre aussi la permanence des besoins de la communauté."
                            },
                            {
                                "example_id": "9475f1b2-f4b6-467e-b854-5320b37b9edb",
                                "sense_id": "d07a1e00-e964-321d-b9cc-501249524357",
                                "text": "Toujours souriant, le visage éternellement bronzé, cet ancien boucher mesure à peine un mètre cinquante mais donne bien du fil à retordre à des boulistes au palmarès déjà bien étoffé."
                            }
                        ]
                    },
                    {
                        "sense_id": "0f97db01-180b-3db6-95d9-4f02c9f1a2ca",
                        "entry_id": "6fbe586c-afe6-3a8d-9f5b-640dce9181e1",
                        "glosses": [
                            "Personne chargée de la boulisterie."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "8f386a12-1bb2-484d-85da-26432b7b0dfb",
                                "sense_id": "0f97db01-180b-3db6-95d9-4f02c9f1a2ca",
                                "text": "Les autres copies pour les bureaux électriques arrivent à la Bourse, au contrôle, par le même procédé du tube. Après le contrôle, les boulistes les portent devant les appareils pour la transmission dans chaque quartier. Puis l’expédition est remise aux facteurs."
                            }
                        ]
                    }
                ],
