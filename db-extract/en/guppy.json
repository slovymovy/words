                        "entry_id": "d3b89e93-3f41-3a94-931f-b31433953de4",
                        "glosses": [
                            "A tiny freshwater fish, Poecilia reticulata, popular in home aquariums, that usually has a plain body and black or dark blue tail for the females and a more colorful tail for the males. The guppies can vary in size, but males are 4 cm (1.6”) and females are 7 cm (2.8”)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc9a36d7-5ccb-4b09-a31d-4127d488d944",
                                "sense_id": "4c1af11b-6298-33f3-b63c-965ee8dfa502",
                                "text": "Fred kept a tank of guppies by the windowsill."
                            }
                        ]
                    },
                    {
                        "sense_id": "208347fc-0242-3199-9a11-29dc991303d5",
                        "entry_id": "d3b89e93-3f41-3a94-931f-b31433953de4",
                        "glosses": [
                            "Any tiny fish."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "c5edf8fb-31be-424f-ae58-fff28297cc34",
                                "sense_id": "208347fc-0242-3199-9a11-29dc991303d5",
                                "text": "Throw that one back; it’s just a guppy!"
                            }
                        ]
                    },
                    {
                        "sense_id": "130c0b02-938b-3970-ac9b-af5d60502aef",
                        "entry_id": "d3b89e93-3f41-3a94-931f-b31433953de4",
                        "glosses": [
                            "A tube holding paintballs before they are loaded into the gun."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d66594cc-90f3-4982-aef7-ab944ffdda40",
                                "sense_id": "130c0b02-938b-3970-ac9b-af5d60502aef",
                                "text": "I reached into my pack and grabbed a guppy to reload. Pouring in the contents, I kept my eyes ahead as I was supposed to do."
                            }
