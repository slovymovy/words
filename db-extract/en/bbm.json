                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4f952ac2-e074-32ca-8ef4-a6c9384afd89",
                        "entry_id": "3b948aba-dc49-36ba-9211-d1afc06ef2e8",
                        "glosses": [
                            "Initialism of BlackBerry Messenger."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "initialism"
                        ],
                        "examples": [
                            {
                                "example_id": "861c92e3-f0ca-4ddb-b551-ce3e0c01f6e3",
                                "sense_id": "4f952ac2-e074-32ca-8ef4-a6c9384afd89",
                                "text": "The police, who have already been combing through public social media postings for suspects, are working to locate others who may have posted messages via BBM, Blackberry’s private messaging service."
                            },
                            {
                                "example_id": "3c006690-ec26-4730-a9b5-2a031d49cb7e",
                                "sense_id": "4f952ac2-e074-32ca-8ef4-a6c9384afd89",
                                "text": "The company said it hopes to release a BBM app for the two operating systems this summer, granted they receive approval by Google Play and the Apple App Store."
                            },
                            {
                                "example_id": "032f20f1-4599-4f13-9e22-564e829c563f",
                                "sense_id": "4f952ac2-e074-32ca-8ef4-a6c9384afd89",
                                "text": "BlackBerry Messenger, or BBM, will be coming to phones that support Apple’s iOS 6 platform and Android’s Ice Cream Sandwich. BlackBerry chief executive Thorsten Heins said that the BBM apps for those platforms will come this summer and will be available for free."
                            }
                        ]
                    }
