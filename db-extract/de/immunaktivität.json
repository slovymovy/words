                "senses": [
                    {
                        "sense_id": "0b34b8a4-c111-3a05-9515-edde5e6d7122",
                        "entry_id": "221f6f53-4d42-32de-b7b6-736fcde46656",
                        "glosses": [
                            "Arbeit des Immunsystems, Reaktion der Immunzellen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fde15590-9fc3-4f79-9971-4a8b0e02e0f1",
                                "sense_id": "0b34b8a4-c111-3a05-9515-edde5e6d7122",
                                "text": "„Bei der ganzheitlichen Behandlung des Reizdarm-Syndroms ist es wichtig, die gestörte Immunaktivität der Darmschleimhaut wieder ins Gleichgewicht zu bringen.“"
                            },
                            {
                                "example_id": "f4564bd5-e38c-4ceb-9e96-f1bfe766e16c",
                                "sense_id": "0b34b8a4-c111-3a05-9515-edde5e6d7122",
                                "text": "„Ist auf dieser Basis aber auch eine gezielte Beeinflussung der Immunaktivität durch psychologische und psychotherapeutische Interventionen möglich?“"
                            },
                            {
                                "example_id": "b1e6ae45-aac9-4114-ab2c-102f2423b54d",
                                "sense_id": "0b34b8a4-c111-3a05-9515-edde5e6d7122",
                                "text": "„So gesehen, können die derzeitigen Quarantäne-Maßnahmen auch kontraproduktiv sein, etwa, wenn Menschen dabei depressiv werden oder eine Angsterkrankung entwickeln und die antivirale Immunaktivität unterdrückt wird […].“"
                            },
                            {
                                "example_id": "35b10599-0529-4739-a2bd-2e9f7e643d90",
                                "sense_id": "0b34b8a4-c111-3a05-9515-edde5e6d7122",
                                "text": "„Während des Fieberschubs von meist 3 bis 4 Stunden kommt es zu einer Mobilisierung sämtlicher Immunaktivitäten im Organismus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
