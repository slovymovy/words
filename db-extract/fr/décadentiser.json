                "senses": [
                    {
                        "sense_id": "4af20181-bc3e-3779-81d3-5d1ea993dbd0",
                        "entry_id": "44db1b42-cc37-3118-b03b-de0278beb504",
                        "glosses": [
                            "Donner un caractère décadent à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af1d6451-6b84-46fd-ac86-f3504385f7b7",
                                "sense_id": "4af20181-bc3e-3779-81d3-5d1ea993dbd0",
                                "text": "Il y a parfums et parfums et vous entendez bien que nous examinons ici lesquels conviennent à l’athlète et si même l’athlète doit jamais en faire usage sous peine de se féminiser et se décadentiser."
                            },
                            {
                                "example_id": "ec79a969-f660-415c-9e20-bcc64a6d0500",
                                "sense_id": "4af20181-bc3e-3779-81d3-5d1ea993dbd0",
                                "text": "Il s'est décadentisé sous Ancelotti, pas nouveau."
                            },
                            {
                                "example_id": "783c0c72-0b05-4840-82ab-137d0d441e5a",
                                "sense_id": "4af20181-bc3e-3779-81d3-5d1ea993dbd0",
                                "text": "Je déteste par-dessus tout les théories de la décadence, forcément fausses puisque le monde décadentise dangereusement dès avant l'apparition du langage, mais je n'ai pas de réponses à toutes ces questions, qui se reposent avec insistance à chaque fois que j'assiste à un concert de musique d'aujourd'hui."
                            },
                            {
                                "example_id": "240985de-cd00-497a-b6e9-b1a24e0f9f51",
                                "sense_id": "4af20181-bc3e-3779-81d3-5d1ea993dbd0",
                                "text": "Je continue à décadentiser ?"
                            }
                        ]
                    }
