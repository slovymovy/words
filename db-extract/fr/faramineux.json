        "fr-extract.jsonl": [
            {
                "entry_id": "e0e8c9fa-5f0a-39c1-88c2-b40da96ab63a",
                "word": "faramineux",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "51bed53f-0477-41a8-a37e-07ed3881f0ca",
                        "entry_id": "e0e8c9fa-5f0a-39c1-88c2-b40da96ab63a",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "faramineuse"
                    },
                    {
                        "form_id": "b10b0875-a7eb-43eb-ba13-872e48c1d321",
                        "entry_id": "e0e8c9fa-5f0a-39c1-88c2-b40da96ab63a",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "faramineuses"
                    },
                    {
                        "form_id": "b4ae6c5f-28d0-4e42-8a05-41c238db2817",
                        "entry_id": "e0e8c9fa-5f0a-39c1-88c2-b40da96ab63a",
                        "tags": [],
                        "form": "pharamineux"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4767b955-5763-39f6-8424-cdabbdaefa51",
                        "entry_id": "e0e8c9fa-5f0a-39c1-88c2-b40da96ab63a",
                        "glosses": [
                            "Extraordinaire, énorme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "218209f9-fc71-46ff-9538-ce09e9e9021f",
                                "sense_id": "4767b955-5763-39f6-8424-cdabbdaefa51",
                                "text": "Quand je l’ai connu, je battais encore la dèche, lui arrivait chez moi, comme un spadassin moderne, au volant de bolides faramineux."
                            },
                            {
                                "example_id": "c1e5be09-240d-45f5-9208-5a268a50765b",
                                "sense_id": "4767b955-5763-39f6-8424-cdabbdaefa51",
                                "text": "Le menu est copieux, et l’addition faramineuse pour faire intimiste. Si vous n’êtes pas blanc de col et de patte, aucune chance d’être admis."
                            },
                            {
                                "example_id": "ce2ce955-1c6a-4e22-8a96-e20f46c2d5ce",
                                "sense_id": "4767b955-5763-39f6-8424-cdabbdaefa51",
                                "text": "Au Vietnam, les américains envoyèrent un millier de drones sur le terrain et en perdirent la moitié… Cela ne les a pas empêché de poursuivre. Les premiers drones Predator avaient un taux de panne faramineux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2644d9d1-7a78-46f4-82f9-f7bbe1bf441a",
                        "source_entry_id": "e0e8c9fa-5f0a-39c1-88c2-b40da96ab63a",
                        "source_sense_id": "4767b955-5763-39f6-8424-cdabbdaefa51",
                        "target_lang_word": "fantastic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fantastic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "13935912-4cec-344c-ad69-fc0b6dbc363f",
                                        "entry_id": "be82cb03-1793-39b8-a505-adabe33f79b7",
                                        "glosses": [
                                            "Wonderful; marvelous; excellent; extraordinarily good or great (used especially as an intensifier)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc012c8e-07d5-4f65-885c-0e04d055fd64",
                                                "sense_id": "13935912-4cec-344c-ad69-fc0b6dbc363f",
                                                "text": "\"I had a simply fantastic vacation, and I can't wait to tell you all about it!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9edaafd-089b-32bd-a938-e932a59de410",
                                        "entry_id": "be82cb03-1793-39b8-a505-adabe33f79b7",
                                        "glosses": [
                                            "Existing in or constructed from fantasy; of or relating to fantasy; fanciful."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e364d8a-b0ba-4337-bcd6-43a22a6b8ab2",
                                                "sense_id": "b9edaafd-089b-32bd-a938-e932a59de410",
                                                "text": "He told fantastic stories of dragons and goblins."
                                            },
                                            {
                                                "example_id": "e761d26d-98bc-44f0-86c3-a9b32139df4e",
                                                "sense_id": "b9edaafd-089b-32bd-a938-e932a59de410",
                                                "text": "His fantastic post-college plans had all collapsed within a year of graduation."
                                            },
                                            {
                                                "example_id": "507bcc24-5a15-48a8-8da4-1580272484d6",
                                                "sense_id": "b9edaafd-089b-32bd-a938-e932a59de410",
                                                "text": "She had a fantastic view of her own importance that none of her colleagues shared."
                                            },
                                            {
                                                "example_id": "b77289d4-910c-4739-b9e2-1356ff2afb4d",
                                                "sense_id": "b9edaafd-089b-32bd-a938-e932a59de410",
                                                "text": "At the base of the whole process by which divinities and demons were created, and rites for their propitiation and placation established, lay Fear - fear stimulating the imagination to fantastic activity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f63e263e-3eb2-310d-b5f8-22571536d7f1",
                                        "entry_id": "be82cb03-1793-39b8-a505-adabe33f79b7",
                                        "glosses": [
                                            "Not believable; implausible; seemingly only possible in fantasy."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee9d5d48-037a-4dc7-829a-5734bbd1d66f",
                                                "sense_id": "f63e263e-3eb2-310d-b5f8-22571536d7f1",
                                                "text": "And indeed, when in the writings of Paracelſus I meet with ſuch Phantaſtick and Un-intelligible Diſcourſes as that Writer often puzzels and tyres his Reader with, father'd upon ſuch excellent Experiments, as though he ſeldom clearly teaches, I often find he knew ; me thinks the Chymiſts, in their ſearches after truth, are not unlike the Navigators of Solomons Tarſhiſh Fleet, who brought home from their long and tedious Voyages, not only Gold, and Silver, and Ivory, but Apes and Peacocks too ; For ſo the Writings of ſeveral (for I ſay not, all) of your Hermetick Philoſophers preſent us, together with divers Subſtantial and noble Experiments, Theories, which either like Peacocks feathers make a great ſhew, but are neither ſolid nor uſeful ; or elſe like Apes, if they have ſome appearance of being rational, are blemiſh'd with ſome abſurdity or other, that when they are Attentively conſider'd, makes them appear Ridiculous."
                                            },
                                            {
                                                "example_id": "16c4de4c-1786-4688-9bbf-cdbf1a2c58d8",
                                                "sense_id": "f63e263e-3eb2-310d-b5f8-22571536d7f1",
                                                "text": "Since 1 part in 100,000 would imply that one could put a Shuttle up each day for 300 years expecting to lose only one, we could properly ask \"What is the cause of management's fantastic faith in the machinery?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04a3a993-ce86-334a-b417-685358846bda",
                                        "entry_id": "be82cb03-1793-39b8-a505-adabe33f79b7",
                                        "glosses": [
                                            "Resembling fantasies in irregularity, caprice, or eccentricity; irregular; grotesque."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "126ab851-c36d-4690-a299-1bfa3864bd39",
                                                "sense_id": "04a3a993-ce86-334a-b417-685358846bda",
                                                "text": "There at the foot of yonder nodding beech, / That wreathes its old fantastic roots so high."
                                            },
                                            {
                                                "example_id": "b478165c-a15d-4f04-984f-e30c08747108",
                                                "sense_id": "04a3a993-ce86-334a-b417-685358846bda",
                                                "text": "[…]This round of green, this orb of flame,\nFantastic beauty; such as lurks\n⁠In some wild Poet, when he works\nWithout a conscience or an aim."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fantastic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "700d9d55-3817-3681-a2f8-cec6d146e4a1",
                                        "entry_id": "2ff5854e-6238-360c-a4ee-94a799c4850e",
                                        "glosses": [
                                            "A fanciful or whimsical person."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b74b590-8527-4c4a-b2a1-b20ade3be036",
                        "source_entry_id": "e0e8c9fa-5f0a-39c1-88c2-b40da96ab63a",
                        "source_sense_id": "4767b955-5763-39f6-8424-cdabbdaefa51",
                        "target_lang_word": "colossal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "colossal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22b6cbda-48d0-32b9-b31b-579148a9371f",
                                        "entry_id": "5f056fa4-88d5-3c84-80e2-2876c8809d66",
                                        "glosses": [
                                            "Extremely large or on a great scale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72454110-5d2b-4d10-8578-17265690b6f4",
                                                "sense_id": "22b6cbda-48d0-32b9-b31b-579148a9371f",
                                                "text": "A single puppy can make a colossal mess."
                                            },
                                            {
                                                "example_id": "b1b65ea9-eac6-4c08-93e3-3929f3a7de0b",
                                                "sense_id": "22b6cbda-48d0-32b9-b31b-579148a9371f",
                                                "text": "Private-equity nabobs bristle at being dubbed mere financiers.[…]Much of their pleading is public-relations bluster. Clever financial ploys are what have made billionaires of the industry’s veterans. “Operational improvement” in a portfolio company has often meant little more than promising colossal bonuses to sitting chief executives if they meet ambitious growth targets. That model is still prevalent today."
                                            },
                                            {
                                                "example_id": "7c26a2ae-992b-4886-9bc1-5010e0f05976",
                                                "sense_id": "22b6cbda-48d0-32b9-b31b-579148a9371f",
                                                "text": "What is wrong with you, you colossal fucking creep⁉ You found the only possible wrong answer to that question! “What’s your favorite color? Hitler.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9421876-b10e-32e3-8e6d-a9cd231461d7",
                                        "entry_id": "5f056fa4-88d5-3c84-80e2-2876c8809d66",
                                        "glosses": [
                                            "Amazingly spectacular; extraordinary; epic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37153e2a-c473-48a5-a43e-6ee174b171be",
                                                "sense_id": "a9421876-b10e-32e3-8e6d-a9cd231461d7",
                                                "text": "\"It's just the very biggest thing that I ever heard of!\" said I, though it was my journalistic rather than my scientific enthusiasm that was roused. \"It is colossal. You are a Columbus of science who has discovered a lost world.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a115e5eb-5619-4bfc-b774-cae2dd64b3a4",
                        "source_entry_id": "e0e8c9fa-5f0a-39c1-88c2-b40da96ab63a",
