                ],
                "senses": [
                    {
                        "sense_id": "ca6fc007-27e9-32a2-8e9f-a36dd7e6eeb5",
                        "entry_id": "e54e70a6-1dd9-3467-95ad-3bc9d0e7b7ef",
                        "glosses": [
                            "weibliche Person mit der Hauptaufgabe, sich um Fragen und Belange der Integration von Zuwanderern in die Gesellschaft zu befassen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24408a18-b522-44e6-afb3-ca3128973910",
                                "sense_id": "ca6fc007-27e9-32a2-8e9f-a36dd7e6eeb5",
                                "text": "„Die neue Integrationsbeauftragte der Landesregierung, die SPD-Politikerin Dagmar Kaselitz, hat am Donnerstag ihr Amt im Schweriner Sozialministerium angetreten.“"
                            },
                            {
                                "example_id": "3cf9a0ac-8514-4ec1-b66d-0ef08aca494e",
                                "sense_id": "ca6fc007-27e9-32a2-8e9f-a36dd7e6eeb5",
                                "text": "„Neu ist dieses Mal, dass ausgerechnet Integrationsbeauftragte die Ursachenforschung rundweg verweigern, an ihrer Spitze die Integrationsministerin von Schleswig-Holstein, die ‚dämliche Metadebatten über Integration‘ ablehnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
