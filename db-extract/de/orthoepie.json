                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wymowa",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "90e2164b-f5d0-31ec-8ab7-aca73a9e5b18",
                                        "entry_id": "cef8ec49-0dd8-3a9b-9770-f8dddb8291a8",
                                        "glosses": [
                                            "sposób artykulacji dźwięków mowy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d313c390-3b7a-4de6-aa2c-ba1dd6dd3d91",
                                                "sense_id": "90e2164b-f5d0-31ec-8ab7-aca73a9e5b18",
                                                "text": "Dzieci błyskawicznie się uczą, jeśli ktoś wpoi im błędną wymowę, nie można już tego naprawić […]."
                                            },
                                            {
                                                "example_id": "7b7915bf-58e3-44e9-bcac-a4e599c3999e",
                                                "sense_id": "90e2164b-f5d0-31ec-8ab7-aca73a9e5b18",
                                                "text": "Słowniki czasami dopuszczają różne wymowy i różne zapisy."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "f4d7d2de-0fc0-38e6-ba34-67eea1c92250",
                                        "entry_id": "cef8ec49-0dd8-3a9b-9770-f8dddb8291a8",
                                        "glosses": [
                                            "wydźwięk, rodzaj wniosków lub odczuć, jakie z czegoś wynikają"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34bc7c82-d609-4017-b4de-0eddeefd0bee",
                                                "sense_id": "f4d7d2de-0fc0-38e6-ba34-67eea1c92250",
                                                "text": "Dziś słowo wiedźma ma wybitnie pejoratywną wymowę, ale słychać w nim jeszcze źródłosłów: ta, która wie."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7b9d1db-44ea-43c3-be33-53232078790e",
                        "source_entry_id": "1237a20d-3043-33ac-a5d7-3e0e4f9dd500",
                        "source_sense_id": "4bc40ffa-52e6-3dca-ad87-c2c75a52dfab",
                        "source_sense_description": "normgerechte Aussprache, Lautung; korrekte Standardlautung",
                        "target_lang_word": "выговор",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "выговор",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "03845de9-9c05-330a-8904-a126ab1623f2",
                                        "entry_id": "b25ecff5-1851-31e5-a649-d6cc9e40774d",
                                        "glosses": [
                                            "манера, характер произношения звуков, слов языка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54d80d3e-2689-4ab1-9ecd-257f0edf5b48",
                                                "sense_id": "03845de9-9c05-330a-8904-a126ab1623f2",
                                                "text": "Сверх того, Глафира завидовала брату; он так был образован, так хорошо говорил по-французски, с парижским выговором, а она едва умела сказать «бонжур» да «коман ву порте ву?»"
                                            },
                                            {
                                                "example_id": "f94fc46a-ba4c-4adb-a168-42cbcc20e8be",
                                                "sense_id": "03845de9-9c05-330a-8904-a126ab1623f2",
                                                "text": "— Ясно, останемся! — восторженно глядя на старика, воскликнул молодой парень; у него был окающий волжский выговор."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ace2774d-ed44-3245-959b-07966c44b6c6",
                                        "entry_id": "b25ecff5-1851-31e5-a649-d6cc9e40774d",
                                        "glosses": [
                                            "порицание, выражение неудовольствия чьим-либо поведением, поступками и т. п. || Официальная отрицательная оценка чьего-л. поступка, отношения к работе и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b5ef288-525d-467c-8491-4c9e843f411a",
                                                "sense_id": "ace2774d-ed44-3245-959b-07966c44b6c6",
                                                "text": "Чуть кто-нибудь стукнет, громко заговорит, сейчас, как раздраженная львица, являлась Анна Павловна и наказывала неосторожного строгим выговором, обидным прозвищем, а иногда, по мере гнева и сил своих, и толчком."
                                            },
                                            {
                                                "example_id": "58f5e226-0dac-4169-ab14-858ea314a378",
                                                "sense_id": "ace2774d-ed44-3245-959b-07966c44b6c6",
                                                "text": "Через несколько дней она брату принесла бельё и сделала ему выговор за то, что он слишком небрежно относится к одежде."
                                            },
                                            {
                                                "example_id": "9d14e7fb-ccd3-4c80-8a5f-b43e0d4f100f",
                                                "sense_id": "ace2774d-ed44-3245-959b-07966c44b6c6",
                                                "text": "Выговор с предупреждением."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
