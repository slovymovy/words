            {
                "entry_id": "fb9ba46e-3a67-3e69-a930-74e21970b74d",
                "word": "perestrojka",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "1522fa05-05e3-46d3-97c4-c8af1123bc14",
                        "entry_id": "fb9ba46e-3a67-3e69-a930-74e21970b74d",
                        "tags": [
                            "plural"
                        ],
                        "form": "perestrojka's"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1d562235-e1f8-3a97-af8d-93c24cca0828",
                        "entry_id": "fb9ba46e-3a67-3e69-a930-74e21970b74d",
                        "glosses": [
                            "hervormingen zoals deze door Gorbatsjov werden voorgesteld in de Sovjet-Unie van de jaren 80 van de twintigste eeuw"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd5dd735-e2d4-48fb-af18-b75f6fc8b201",
                                "sense_id": "1d562235-e1f8-3a97-af8d-93c24cca0828",
                                "text": "Visjnevskaja was van 1955 tot diens dood in 2007 getrouwd met de wereldberoemde cellist Mstislav Rostropovitsj. In 1974 verliet het echtpaar de toenmalige Sovjet-Unie, om tijdens het perestrojka-tijdperk weer terug te keren."
                            },
                            {
                                "example_id": "ff220f25-78bf-4e84-9bc8-76f11d59ac5f",
                                "sense_id": "1d562235-e1f8-3a97-af8d-93c24cca0828",
                                "text": "Berezovski was een van de eerste zakenlieden van de Sovjet-Unie. Zijn vlotte babbel, uitgebreide netwerk en energieke houding zorgden ervoor dat hij in de tijd van perestrojka, in de jaren 80 en 90, onder Gorbatsjov en Jeltsin miljoenen verdiende. Berezovski kocht de grootste autofabriek van Rusland: AvtoVAZ - bekend van de Lada - en het grootste Russische televisiekanaal ORT."
                            },
                            {
                                "example_id": "c7546c3d-b7bf-4f8d-abfb-61ef5dd6e065",
                                "sense_id": "1d562235-e1f8-3a97-af8d-93c24cca0828",
                                "text": "Gorbatsjov zei dat het perestrojka-beleid, dat hij ziet als zijn belangrijkste prestatie, vrijheid en democratie bracht voor Rusland en Centraal- en Oost-Europa. Ook prees hij zichzelf voor de terugtrekking van de Sovjettroepen uit Afghanistan in 1989."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7140a7e3-d6f2-4bd1-94b9-9cad9d7e6356",
                        "source_entry_id": "fb9ba46e-3a67-3e69-a930-74e21970b74d",
                        "source_sense_id": "1d562235-e1f8-3a97-af8d-93c24cca0828",
                        "source_sense_description": "hervormingen zoals deze door Gorbatsjov werden voorgesteld in de Sovjet-Unie",
                        "target_lang_word": "Perestroika",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Perestroika",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4979c95d-511a-3cf0-a3ca-0eaa43e9789c",
                                        "entry_id": "f12dbfab-f55e-31fd-aa7a-fe169a9d995b",
                                        "glosses": [
                                            "Schlagwort des früheren sowjetischen Staatschefs Michael Gorbatschow, die auf die Reform des Staats- und Wirtschaftssystems der damaligen UdSSR abzielte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36cefff4-51bb-4960-9c0e-f48c726ca325",
                                                "sense_id": "4979c95d-511a-3cf0-a3ca-0eaa43e9789c",
                                                "text": "Erst Gorbatschows Perestroika führte Mitte der Achtziger dazu, dass nicht mehr von oben entschieden wurde, wer zu welchem Turnier fährt, und dass das Preisgeld bei den Spielern blieb."
                                            },
                                            {
                                                "example_id": "22223c4a-5252-4b91-a005-87d3542fd75c",
                                                "sense_id": "4979c95d-511a-3cf0-a3ca-0eaa43e9789c",
                                                "text": "„Seit Beginn der »Perestroika« wurde das Verbot, sich mit der Vorkriegsgeschichte der Region zu beschäftigen, schrittweise aufgehoben.“"
                                            },
                                            {
                                                "example_id": "11c08ecb-c38d-4922-aee4-f79f8750d82b",
                                                "sense_id": "4979c95d-511a-3cf0-a3ca-0eaa43e9789c",
                                                "text": "„Mit der Perestroika begann schließlich eine neue Zeitrechnung.“"
                                            },
                                            {
                                                "example_id": "ec04982c-e57c-4dce-ace5-919adc2b5ae0",
                                                "sense_id": "4979c95d-511a-3cf0-a3ca-0eaa43e9789c",
                                                "text": "„Mein Begleiter zeigte mir die Stadt, in deren Straßen der Frühlingshauch der Perestroika wehte.“"
                                            },
                                            {
                                                "example_id": "1ee70601-8465-4bd2-8f88-65269bb87b3b",
                                                "sense_id": "4979c95d-511a-3cf0-a3ca-0eaa43e9789c",
                                                "text": "„Es ist aber längst an der Zeit, daß die Perestroika den Frauen ihr Gesicht zuwendet. Es wird Zeit, daß man auch weibliche Gesichter unter den Führern des Landes erblickt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "346fe983-0a3b-4178-b2f8-7e60ed61000a",
                        "source_entry_id": "fb9ba46e-3a67-3e69-a930-74e21970b74d",
                        "source_sense_id": "1d562235-e1f8-3a97-af8d-93c24cca0828",
                        "source_sense_description": "hervormingen zoals deze door Gorbatsjov werden voorgesteld in de Sovjet-Unie",
                        "target_lang_word": "Perestrojka",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Perestrojka",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ad79c320-fdf3-34f6-8289-9e8d88c3fe23",
                                        "entry_id": "46930b07-753a-3c96-b044-55bce8371ab1",
                                        "glosses": [
                                            "Schlagwort des früheren sowjetischen Staatschefs Michael Gorbatschow, die auf die Reform des Staats- und Wirtschaftssystems der damaligen UdSSR abzielte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "472df8d4-361e-4979-a007-e4feea70602b",
                                                "sense_id": "ad79c320-fdf3-34f6-8289-9e8d88c3fe23",
                                                "text": "„Und es waren aufregende Zeiten: Glasnost und Perestrojka prägten die Weltpolitik.“"
                                            },
                                            {
                                                "example_id": "68d9f702-0fcf-4176-924b-0aada6662298",
                                                "sense_id": "ad79c320-fdf3-34f6-8289-9e8d88c3fe23",
                                                "text": "„Dann kam die Perestrojka, die Preise wuchsen wie die Riesen in unseren Märchen, und Rosas Ersparnisse wurden zunichte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f84d3a2d-cbab-4089-a2fa-d2444d2f4c39",
