                    {
                        "translation_id": "8c57bcf5-de54-4c5c-81d3-e8c639043a92",
                        "source_entry_id": "83469461-d098-3cb1-b515-3afae2216ebd",
                        "source_sense_id": "bf1c67b3-7cf9-3544-9838-bf0a3e00a60a",
                        "target_lang_word": "программистка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "программистка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "968a20d2-a228-3990-84bf-5f53e9edf7a4",
                                        "entry_id": "e73f0f9b-bfa6-3182-bab7-cb3923303748",
                                        "glosses": [
                                            "женск. к программист"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6cee431-9976-46f8-9b82-897162cb2873",
                                                "sense_id": "968a20d2-a228-3990-84bf-5f53e9edf7a4",
                                                "text": "― Программистка набирала на компьютере линию на этот матч и перепутала плюс с минусом, ― говорил мне Гена, сидя в своей крошечной комнатке в холле кинотеатра."
                                            },
                                            {
                                                "example_id": "8bf18765-e9bd-4b04-8a97-3e6bf4d675f1",
                                                "sense_id": "968a20d2-a228-3990-84bf-5f53e9edf7a4",
                                                "text": "Семья жила в основном на зарплату Ольги, программистки, а также на фуд-стэмпы, что получала Фрида Гершелевна по восьмой программе для престарелых иммигрантов."
                                            },
                                            {
                                                "example_id": "52acd6e8-59bb-4e6d-95ec-f6d0ea6dbc6a",
                                                "sense_id": "968a20d2-a228-3990-84bf-5f53e9edf7a4",
                                                "text": "А потом формирующаяся женственность подсказала юным программисткам следующую тему ― алгоритм знакомства Ее и Его."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
