{
    "word_family": [
        "real",
        "realtor",
        "reality",
        "realize",
        "realism",
        "realistic"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b9ece2e6-248e-3257-a0c8-84cea0d8a7e3",
                    "sense_definition": "Real estate or a piece of real property, such as land or buildings.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "property",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The investor decided to diversify his portfolio by purchasing commercial <w>realty</w> in the city center.",
                            "target_lang_translations": {
                                "ru": "Инвестор решил диверсифицировать свой портфель, купив коммерческую <w>недвижимость</w> в центре города."
                            }
                        },
                        {
                            "text": "She works for a large <w>realty</w> company that specializes in luxury residential homes.",
                            "target_lang_translations": {
                                "ru": "Она работает в крупной компании по операциям с <w>недвижимостью</w>, которая специализируется на элитном жилье."
                            }
                        }
                    ],
                    "synonyms": [
                        "real estate",
                        "property",
                        "land"
                    ],
                    "common_phrases": [
                        "commercial realty",
                        "residential realty",
                        "realty company"
                    ],
                    "target_lang_definitions": {
                        "ru": "Недвижимое имущество или объект недвижимости, такой как земля или здания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "недвижимость",
                                "target_lang_sense_clarification": "общий термин для зданий и земли"
                            },
                            {
                                "target_lang_word": "объекты недвижимости",
                                "target_lang_sense_clarification": "конкретные единицы имущества"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0ed1a77-39d1-351d-b2ad-7d0d6e83abd7",
                    "sense_definition": "Property consisting of land and buildings that passes to heirs, as opposed to personal belongings.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal_inheritance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In legal terms, the <w>realty</w> was divided among the children while the cash went to the executor.",
                            "target_lang_translations": {
                                "ru": "С юридической точки зрения, <w>недвижимое имущество</w> было разделено между детьми, в то время как наличные деньги перешли к исполнителю завещания."
                            }
                        },
                        {
                            "text": "The lawyer explained the distinction between <w>realty</w> and personalty during the probate hearing.",
                            "target_lang_translations": {
                                "ru": "Адвокат объяснил различие между <w>недвижимым</w> и движимым имуществом во время слушания по делу о наследстве."
                            }
                        }
                    ],
                    "synonyms": [
                        "real property"
                    ],
                    "antonyms": [
                        "personalty"
                    ],
                    "common_phrases": [
                        "realty and personalty"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имущество, состоящее из земли и построек, которое переходит к наследникам, в отличие от личных вещей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "недвижимое имущество",
                                "target_lang_sense_clarification": "в юридическом контексте наследования"
                            },
                            {
                                "target_lang_word": "реальная собственность",
                                "target_lang_sense_clarification": "юридический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f942092e-9d5e-31c7-a472-6fb9f8a92bca",
                    "sense_definition": "The quality of being loyal or faithful.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "loyalty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight swore an oath of <w>realty</w> to his lord before the battle began.",
                            "target_lang_translations": {
                                "ru": "Рыцарь принес клятву <w>верности</w> своему господину перед началом битвы."
                            }
                        },
                        {
                            "text": "In the ancient text, the poet laments a world where faith and <w>realty</w> no longer remain.",
                            "target_lang_translations": {
                                "ru": "В древнем тексте поэт оплакивает мир, в котором больше не осталось веры и <w>преданности</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "loyalty",
                        "faithfulness",
                        "fealty"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество преданности или верности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "верность",
                                "target_lang_sense_clarification": "преданность сюзерену или долгу"
                            },
                            {
                                "target_lang_word": "преданность",
                                "target_lang_sense_clarification": "архаичное значение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a42311b-77bc-3367-beb4-4084072caa0e",
                    "sense_definition": "An archaic or rare variant of the word <w>reality</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "existence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The philosopher explored the <w>realty</w> of the physical world in his early manuscripts.",
                            "target_lang_translations": {
                                "ru": "Философ исследовал <w>реальность</w> физического мира в своих ранних рукописях."
                            }
                        },
                        {
                            "text": "It is difficult to distinguish between dream and <w>realty</w> in this surrealist novel.",
                            "target_lang_translations": {
                                "ru": "В этом сюрреалистическом романе трудно отличить сон от <w>реальности</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "reality"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Архаичный или редкий вариант написания слова reality (реальность)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реальность",
                                "target_lang_sense_clarification": "устаревшая форма написания"
                            },
                            {
                                "target_lang_word": "действительность",
                                "target_lang_sense_clarification": "в историческом контексте"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d0a06b9-8ee6-3d6f-9a6c-f6a1ce6aaf4d",
                    "sense_definition": "An archaic form of the word <w>royalty</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "monarchy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The visiting dignitaries were treated with the respect usually reserved for <w>realty</w>.",
                            "target_lang_translations": {
                                "ru": "К приехавшим высокопоставленным лицам относились с уважением, обычно предназначенным для <w>особ королевской крови</w>."
                            }
                        },
                        {
                            "text": "Old chronicles often used the term <w>realty</w> when referring to the king's sovereign power.",
                            "target_lang_translations": {
                                "ru": "В старых хрониках часто использовался термин <w>realty</w> при упоминании суверенной власти короля."
                            }
                        }
                    ],
                    "synonyms": [
                        "royalty"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical variant"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Архаичная форма слова royalty (королевское достоинство, члены королевской семьи)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "королевское достоинство",
                                "target_lang_sense_clarification": "архаичный вариант"
                            },
                            {
                                "target_lang_word": "члены королевской семьи",
                                "target_lang_sense_clarification": "устаревшее собирательное значение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
