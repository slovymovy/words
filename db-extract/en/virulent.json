                    {
                        "translation_id": "0d623241-3bad-49e5-b4ef-448061fbff44",
                        "source_entry_id": "0be827bc-e266-3855-b8bf-5d305aeb5ab4",
                        "source_sense_description": "malignant, able to cause damage to the host",
                        "target_lang_word": "virulent",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "virulent",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ba4dc56e-fe91-3fa7-9aeb-0ad2c188d28a",
                                        "entry_id": "3a57f4e7-951e-37dc-b090-6f25f36c3ede",
                                        "glosses": [
                                            "ansteckend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2e31f98-aac0-42e4-9dc9-a05dbb817e90",
                                                "sense_id": "ba4dc56e-fe91-3fa7-9aeb-0ad2c188d28a",
                                                "text": "Die virulenten Salmonellen nisten sich zuerst im Darm ein."
                                            },
                                            {
                                                "example_id": "c05d235e-ec1a-4321-ac8e-7f4b0d08b895",
                                                "sense_id": "ba4dc56e-fe91-3fa7-9aeb-0ad2c188d28a",
                                                "text": "„Wenn ein Erreger besonders leicht an Zellen haften bleibt, in Zellen eindringen kann, sich schnell vermehrt und dabei das Gewebe nachhaltig zerstört, ist er besonders virulent.“"
                                            },
                                            {
                                                "example_id": "d5e4d9ef-1ee3-4001-89c4-4c45c5df6253",
                                                "sense_id": "ba4dc56e-fe91-3fa7-9aeb-0ad2c188d28a",
                                                "text": "[Dengue-Fieber:] „Warum sind die Viren gerade in Asien so aggressiv? – […] weil die asiatischen Viren weitaus virulenter sind als ihre amerikanischen Verwandten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0e2f6a31-eef3-3b7d-9f00-16b7c3f31565",
                                        "entry_id": "3a57f4e7-951e-37dc-b090-6f25f36c3ede",
                                        "glosses": [
                                            "in Unruhe, in Aufruhr befindlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1eb6034f-40d0-4013-8c35-25cca4db1f0b",
                                                "sense_id": "0e2f6a31-eef3-3b7d-9f00-16b7c3f31565",
                                                "text": "Die Verhältnisse auf dem Balkan sind immer noch virulent."
                                            },
                                            {
                                                "example_id": "24dfe001-d3db-4492-9228-c1ebcac8a933",
                                                "sense_id": "0e2f6a31-eef3-3b7d-9f00-16b7c3f31565",
                                                "text": "„Dass Antisemitismus auch heute virulent ist, sieht Bodo Gideon Riethmüller daran, dass immer wieder Gräber geschändet werden, indem Unbekannte Gräber umwerfen oder sie mit Hakenkreuzen beschmieren.“"
                                            },
                                            {
                                                "example_id": "a1286d62-ba37-4c38-9402-dff174546dc3",
                                                "sense_id": "0e2f6a31-eef3-3b7d-9f00-16b7c3f31565",
                                                "text": "„»Die Bedrohung von rechts ist virulent und sie wächst«, sagt Münch.“"
                                            },
                                            {
                                                "example_id": "c263f0ea-d48c-4e15-a1a5-489f4452b536",
                                                "sense_id": "0e2f6a31-eef3-3b7d-9f00-16b7c3f31565",
                                                "text": "„Um der auch damals [Anmerkung: in 1970ern] virulenten Wohnungsnot zu begegnen, scheute man sich nicht, dicht und stark in die Höhe zu bauen.“"
                                            },
                                            {
                                                "example_id": "a1977740-7966-42d5-96bb-a0a31c175b1b",
                                                "sense_id": "0e2f6a31-eef3-3b7d-9f00-16b7c3f31565",
                                                "text": "„Wenn ich so in meiner Redaktion mich umschaue bei den über 50-Jährigen …, […] das Problem, was passiert mit meinen Eltern, wird immer virulenter.“"
                                            },
                                            {
                                                "example_id": "2ae47aad-81e6-4dd9-a9f8-a36604ff15b4",
                                                "sense_id": "0e2f6a31-eef3-3b7d-9f00-16b7c3f31565",
                                                "text": "[Stefan Lehne:] „»Es gibt eine unglaubliche Konzentration auf dieses Thema. Ich glaube, die meisten Leute in Österreich oder Deutschland sind unmittelbar von der Präsenz von Flüchtlingen oder Migranten nur sehr wenig betroffen. Aber die mediale Konzentration auf dieses Thema macht es halt unheimlich virulent in der Gesellschaft.«“"
                                            },
                                            {
                                                "example_id": "d77113a8-1e47-42b3-9678-1725abd9a7b5",
                                                "sense_id": "0e2f6a31-eef3-3b7d-9f00-16b7c3f31565",
                                                "text": "„Insgesamt ist die Neuproduktion von Kompositionen für Klavier zu vier Händen oder für zwei Klaviere in den letzten Jahrzehnten nicht mehr so virulent wie noch zu Beginn des letzten Jahrhunderts oder gar im 19. Jahrhundert.“"
                                            },
                                            {
