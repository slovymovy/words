                "senses": [
                    {
                        "sense_id": "5badadde-9b9e-337a-8e49-50beae59373a",
                        "entry_id": "13f7f0dd-61ae-3821-a90e-c37f01f066c5",
                        "glosses": [
                            "eine größere Änderung, eine Reform, des Hochschulwesens eines Staats"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f0723a5-6bf1-42fa-9869-ce7b2d3e3264",
                                "sense_id": "5badadde-9b9e-337a-8e49-50beae59373a",
                                "text": "„Die Verbindung von Hochschulreform und Gleichstellungsfortschritt stellt ein hochschulpolitisches Ziel dar, über dessen Realisierungswege die Meinungen nach wie vor weit auseinander gehen.“"
                            },
                            {
                                "example_id": "7b533aff-25dc-4d5c-86bb-c15aabe7aa29",
                                "sense_id": "5badadde-9b9e-337a-8e49-50beae59373a",
                                "text": "„Doch zehn Jahre nach Beginn des Bologna-Prozesses, der größten Hochschulreform Europas, ist die Liste der Klagen lang: Studenten und Professoren in Deutschland stöhnen unter der Prüfungslast, Studieninhalte sind dicht gedrängt, Auslandsaufenthalte und Praktika entfallen, und selbst innerhalb Deutschlands ist der Wechsel von einer Hochschule zur anderen schwierig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
