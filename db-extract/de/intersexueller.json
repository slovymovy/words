                "senses": [
                    {
                        "sense_id": "6ea82721-fed1-3611-b15c-0304fd70b389",
                        "entry_id": "d33c3625-4dac-3bd1-ac40-fdc344134d12",
                        "glosses": [
                            "Person, deren Geschlechtszugehörigkeit weder eindeutig männlich noch weiblich ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e93ff76b-ca9a-4969-8ea6-37b4ec268741",
                                "sense_id": "6ea82721-fed1-3611-b15c-0304fd70b389",
                                "text": "„Die Staatsanwaltschaft Tirana lehnte eine Anzeige von Organisationen für Lesben, Schwule, Bisexuelle, Transgender und Intersexuelle gegen den stellvertretenden Verteidigungsminister Ekrem Spahiu wegen dessen homophober Äußerungen zur Parade ab.“"
                            },
                            {
                                "example_id": "1609ca52-82f4-4e96-bf15-398bd2990d4b",
                                "sense_id": "6ea82721-fed1-3611-b15c-0304fd70b389",
                                "text": "„Es gibt rund 85.000 bis 120.000 so genannte Intersexuelle in Deutschland.“"
                            },
                            {
                                "example_id": "d51ad67b-dce7-4e66-b987-eb01a84086a1",
                                "sense_id": "6ea82721-fed1-3611-b15c-0304fd70b389",
                                "text": "„Von Intersexuellen oder Zwittern spricht man, wenn das Geschlecht eines Menschen nicht eindeutig als männlich oder weiblich festgelegt werden kann.“"
                            },
                            {
                                "example_id": "4b0f1035-88cc-4e8c-8265-4250678f7233",
                                "sense_id": "6ea82721-fed1-3611-b15c-0304fd70b389",
                                "text": "„Interessenvertreter von Intersexuellen wollen erreichen, dass Ärzte und Eltern zumindest so lange warten, bis das Kind seine Geschlechtszugehörigkeit mitteilen (normalerweise etwa im Alter von drei Jahren) oder bis es sogar selbst über eine Operation entscheiden kann.“"
                            },
                            {
                                "example_id": "882c055d-11c7-4acf-8a1a-9abbfcb3cefc",
                                "sense_id": "6ea82721-fed1-3611-b15c-0304fd70b389",
                                "text": "„80.000 Menschen leben als so genannte Intersexuelle mit sowohl weiblichem als auch männlichem Chromosomensatz: Die gar nicht so seltene Diagnose ist ein Tabuthema - und fast immer löst sie bei jungen Eltern einen Schock aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
