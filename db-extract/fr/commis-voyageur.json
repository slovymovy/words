                                            {
                                                "example_id": "4335978a-c5b3-4c52-9f63-84476e5701aa",
                                                "sense_id": "b3e26fbc-757b-3769-afec-7efad9930d96",
                                                "text": "Acima da mesa, na qual estava desempacotada e espalhada uma série de amostras de tecidos - Samsa era caixeiro-viajante -, pendia a imagem, que ele havia recortado há pouco tempo de uma revista ilustrada e que a havia encaixado numa bela moldura dourada."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd4dc0c8-50f5-3356-a2bb-476f275ae6a2",
                                        "entry_id": "27c86633-55f8-353f-8e88-80d3d6ff0151",
                                        "glosses": [
                                            ", pessoa que viaja para a divulgação de um produto, ideia, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecb41c62-dcce-45d9-97c9-9632b2267dae",
                                                "sense_id": "fd4dc0c8-50f5-3356-a2bb-476f275ae6a2",
                                                "text": "Prometeu também que trabalhará como um caixeiro-viajante convencendo outros países a apoiarem o nome do Brasil para sediar a Olimpíada de 2016."
                                            }
                                        ]
                                    }
