                        "entry_id": "cacc3b8b-c9d6-30d9-98ba-cfff9fd51694",
                        "glosses": [
                            "The quality of being averse; opposition of mind."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "666c257c-367e-4528-a073-fca6fae81baa",
                                "sense_id": "7d4470b7-2f91-335b-ac7a-e20827165ed8",
                                "text": "Oh the stubburnnesse of iniquitie, and mans auersenesse from his maker."
                            },
                            {
                                "example_id": "8ef1c6f0-fc09-4974-95a4-91015ab01f03",
                                "sense_id": "7d4470b7-2f91-335b-ac7a-e20827165ed8",
                                "text": "[…] the Fondness or Averseness of the Child to some Servants […] will at any time let one know, whether their Love to the Baby is uniform and the same, when one is absent, as present."
                            },
                            {
                                "example_id": "7ff16665-63b6-4295-9eff-fb43703126be",
                                "sense_id": "7d4470b7-2f91-335b-ac7a-e20827165ed8",
                                "text": "There were tones in it [his fiddling] which bred the immediate conviction that indolence and averseness to systematic application were all that lay between 'Mop' and the career of a second [Niccolò] Paganini."
                            }
                        ]
                    }
