                "senses": [
                    {
                        "sense_id": "d4d0ab9c-6299-3f1a-8798-30d8762aa1ae",
                        "entry_id": "3fb9cf99-1601-3cb0-9e31-09b3fcdaf801",
                        "glosses": [
                            "Moor, das vom Grundwasserstand abhängig ist und sich bei der Verlandung nährstoffreicher Seen, Teiche und Flussläufe bildet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f3a3ac4-505b-495b-9843-ddf93ab283f2",
                                "sense_id": "d4d0ab9c-6299-3f1a-8798-30d8762aa1ae",
                                "text": "„Das Flachmoor […] ist vom Grundwasserstand abhängig und bildet sich bei der Verlandung nährstoffreicher Seen, Teiche und Flussläufe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa089705-9d58-40d8-9c80-865ccfcd3a57",
                        "source_entry_id": "3fb9cf99-1601-3cb0-9e31-09b3fcdaf801",
                        "source_sense_id": "d4d0ab9c-6299-3f1a-8798-30d8762aa1ae",
                        "target_lang_word": "swamp",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "swamp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4adcd753-2844-34ef-bda4-180c02f218b6",
                                        "entry_id": "644538c5-21a1-3911-969d-5862d7d390a4",
                                        "glosses": [
                                            "An area of wet (water-saturated), spongy (soft) land, often with trees, generally a rich ecosystem for certain plants and animals but ill-suited for many agricultural purposes. (A type of wetland. Compare marsh, bog, fen.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0618604-4a7a-48ff-8c44-ffafe32cab34",
                                                "sense_id": "4adcd753-2844-34ef-bda4-180c02f218b6",
                                                "text": "Some small Marshes and Swamps there are, but more profitable than hurtfull."
                                            },
                                            {
                                                "example_id": "c80115ed-8399-4dd7-b5fa-b10cacbf5d61",
                                                "sense_id": "4adcd753-2844-34ef-bda4-180c02f218b6",
                                                "text": "The vast swamps of Southern Ontario proved a grim nightmare to the construction gangs. Treacherous and seemingly bottomless, the swamps swallowed thousands of tons of timber and debris, yet still afforded no firm surface on which the track could be laid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eec4057f-3471-31b7-af51-e837cde44d83",
                                        "entry_id": "644538c5-21a1-3911-969d-5862d7d390a4",
                                        "glosses": [
                                            "A place or situation that is foul or where progress is difficult."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "965791e6-1acb-4441-86ba-431ddea5b8ce",
                                                "sense_id": "eec4057f-3471-31b7-af51-e837cde44d83",
                                                "text": "We two...in this swamp of iniquity...together we can bring redress to an unjust world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1aabd5c-99db-3242-b39f-cd7d51cd6ce0",
                                        "entry_id": "644538c5-21a1-3911-969d-5862d7d390a4",
                                        "glosses": [
                                            "The alleged corruption, cronyism, inefficiency, and entrenched interests in the federal government, especially in Washington, DC."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e065bc5-d222-44e7-8db3-bf09c1fc4da7",
                                                "sense_id": "a1aabd5c-99db-3242-b39f-cd7d51cd6ce0",
                                                "text": "On InfoWars, Alex Jones told his audience, \"This is over the top sickening. Next they'll say Jeffrey Epstein never even existed. This is the swamp winning. No one is buying this.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "swamp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7615a29b-e030-381c-93a7-fd8c241d8345",
                                        "entry_id": "e66fb2a7-99cb-366a-8904-3fe9da9a84ce",
                                        "glosses": [
                                            "To drench or fill with water."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "184d4cc7-6705-4e82-9245-51fe8bf7919b",
                                                "sense_id": "7615a29b-e030-381c-93a7-fd8c241d8345",
                                                "text": "The boat was swamped in the storm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95538c6f-2fce-3a26-86cd-70db626e6e77",
                                        "entry_id": "e66fb2a7-99cb-366a-8904-3fe9da9a84ce",
                                        "glosses": [
                                            "To overwhelm; to make too busy, or overrun the capacity of."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d352697-7973-4b6d-a071-fd3264f3d6ea",
                                                "sense_id": "95538c6f-2fce-3a26-86cd-70db626e6e77",
                                                "text": "I have been swamped with paperwork ever since they started using the new system."
                                            },
                                            {
                                                "example_id": "317f7d27-6b02-4a53-b369-c16ca49f541d",
                                                "sense_id": "95538c6f-2fce-3a26-86cd-70db626e6e77",
                                                "text": "\"I'm being swamped now with calls from parents and young people who are upset that there are not many options for employment this summer,\" he said."
                                            },
                                            {
                                                "example_id": "1f12e9ce-536d-492f-8659-3adfbf521384",
                                                "sense_id": "95538c6f-2fce-3a26-86cd-70db626e6e77",
                                                "text": "Mr. Spitzer’s defeat of his Democratic opponent […] ended a primary season in which Hillary Rodham Clinton swamped an antiwar challenger for renomination to the Senate."
                                            },
                                            {
                                                "example_id": "eb541ca9-2407-4f28-9c0b-08698aeb8181",
                                                "sense_id": "95538c6f-2fce-3a26-86cd-70db626e6e77",
                                                "text": "It was only the outstanding Cech that stood between Arsenal and a second-half rout as Spurs simply swamped their opponents after the break with a formidable display of power, pace and sheer intensity."
                                            },
                                            {
                                                "example_id": "8bb11fe8-7f59-4949-8ccc-f8cb6cff9e18",
                                                "sense_id": "95538c6f-2fce-3a26-86cd-70db626e6e77",
                                                "text": "All is well until Treorchy, where the platform is swamped by teenagers who have been attending an event. Around four dozen unescorted 12 to 16 year-olds swarm aboard and begin to run riot through the train. Their behaviour is appalling and the presence of CCTV no deterrent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ddef03c-6a7d-37e5-9a43-aaf5649e0fef",
                                        "entry_id": "e66fb2a7-99cb-366a-8904-3fe9da9a84ce",
                                        "glosses": [
                                            "To plunge into difficulties and perils; to overwhelm; to ruin; to wreck."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccbe348b-1dc0-4ee2-8f4b-4346c84dc06b",
                                                "sense_id": "7ddef03c-6a7d-37e5-9a43-aaf5649e0fef",
                                                "text": "The Whig majority of the house of Lords was swamped by the creation of twelve Tory peers."
                                            },
                                            {
                                                "example_id": "6097ddee-67e5-43ec-84e6-836d33da7659",
                                                "sense_id": "7ddef03c-6a7d-37e5-9a43-aaf5649e0fef",
                                                "text": "Having swamped himself in following the ignis fatuus of a theory[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccc9416e-2e63-30bd-8759-850b6e21ebd0",
                                        "entry_id": "e66fb2a7-99cb-366a-8904-3fe9da9a84ce",
                                        "glosses": [
                                            "To clear (a road or an area) of brush, particularly so as to create a path for loggers to be able to access trees."
                                        ],
                                        "tags": [
                                            "Appalachia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f2a02ba-7a2e-47f0-a883-73ebddd2c873",
                                                "sense_id": "ccc9416e-2e63-30bd-8759-850b6e21ebd0",
                                                "text": "Nothing to it but clearing out underbrush and limbs so teams can get to the logs. […] If anyone asks, just tell him you've swamped roads ever since you was big enough to lift a hatchet."
                                            },
                                            {
                                                "example_id": "e1b05b4e-ca0a-4832-ba66-30638d5e0e20",
                                                "sense_id": "ccc9416e-2e63-30bd-8759-850b6e21ebd0",
                                                "text": "I guess I've done it all. Drove teams, drove grabs (device used to fasten a trail of logs together), swamped (cleared the ground of underbrush and fallen trees for road construction)."
                                            },
                                            {
                                                "example_id": "ca4866e7-230f-46bd-a673-6d440ed31855",
                                                "sense_id": "ccc9416e-2e63-30bd-8759-850b6e21ebd0",
                                                "text": "\"Hayburners,\" or horses, their \"teamsters,\" and oxen driven by their \"bullwhackers,\" all became outmoded, as did \"crosspoling\" logs across trails to make them sturdy and \"swamping,\" or cutting, new trails to \"snake\" logs out of the forest."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4ec94a1-4cce-422a-afd3-8bd3c9e9cef4",
                        "source_entry_id": "3fb9cf99-1601-3cb0-9e31-09b3fcdaf801",
                        "source_sense_id": "d4d0ab9c-6299-3f1a-8798-30d8762aa1ae",
                        "target_lang_word": "fen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d3ba139-07a8-3224-ab96-7743bb9f79e3",
                                        "entry_id": "3b80d4d6-7471-3a65-a04b-1c006aff7519",
                                        "glosses": [
                                            "A type of wetland fed by ground water and runoff, containing peat below the waterline, characteristically alkaline."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02e152d5-e458-4ad2-a567-55a50e31b85e",
                                                "sense_id": "4d3ba139-07a8-3224-ab96-7743bb9f79e3",
                                                "text": "Near-synonyms: marsh, swamp, bog, mire"
                                            },
                                            {
                                                "example_id": "b326359f-7b8e-4c9d-ad6b-964024e85c0b",
                                                "sense_id": "4d3ba139-07a8-3224-ab96-7743bb9f79e3",
                                                "text": "Bogs are acidic, nutrient poor, and have a low species diversity, whereas fens are less acidic and have higher nutrient levels and species diversity."
                                            },
                                            {
                                                "example_id": "3d803765-535c-474c-9d88-e047d64e58b6",
                                                "sense_id": "4d3ba139-07a8-3224-ab96-7743bb9f79e3",
                                                "text": "Bogs are acidic peatlands, while fens are non-acidic peatlands."
                                            },
                                            {
                                                "example_id": "996369dc-ec1b-4da5-97ae-328c805b3953",
                                                "sense_id": "4d3ba139-07a8-3224-ab96-7743bb9f79e3",
                                                "text": "[...] fens are alkaline. In fact, the precise acidity of a fen depends on the soil through which in-seeping waters have percolated. Northeastern fens vary from somewhat acidic to highly basic (Johnson, 1985, p. 27)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b436c5d-7e9f-39b1-9d44-7e04ecfe6708",
                                        "entry_id": "3b80d4d6-7471-3a65-a04b-1c006aff7519",
                                        "glosses": [
                                            "Any swamp or mire (especially with negative connotations)."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b32b222-8953-4993-b772-e56b62c19e90",
                                                "sense_id": "9b436c5d-7e9f-39b1-9d44-7e04ecfe6708",
                                                "text": "Caliban: As wicked dewe, as ere my mother bruſh'd / With Rauens feather from vnwholeſome Fen / Drop on you both : A Southweſt blow on yee, / And bliſter you all ore."
                                            },
                                            {
                                                "example_id": "42d09d2d-7366-4194-a875-4e3f0fe4d3d1",
                                                "sense_id": "9b436c5d-7e9f-39b1-9d44-7e04ecfe6708",
                                                "text": "Milton! thou shouldst be living at this hour: / England hath need of thee: she is a fen / Of stagnant waters […]"
                                            },
                                            {
                                                "example_id": "879afec5-6c81-426b-8b4e-ae380404ffc2",
                                                "sense_id": "9b436c5d-7e9f-39b1-9d44-7e04ecfe6708",
                                                "text": "In dark fens of the Dismal Swamp / The hunted Negro lay; …"
                                            },
                                            {
                                                "example_id": "c8e5fd82-5edf-421b-a7c6-f98fa4044070",
                                                "sense_id": "9b436c5d-7e9f-39b1-9d44-7e04ecfe6708",
                                                "text": "As the sob of the breeze/Sweeps over the trees/And the mists lie low on the fen..."
                                            },
                                            {
                                                "example_id": "0a8d74ac-ec2d-4279-b8b8-879578dc8cf4",
                                                "sense_id": "9b436c5d-7e9f-39b1-9d44-7e04ecfe6708",
                                                "text": "He was freezing to death in the flat mud of the Suffolk fens, too proud to go home without a catch."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "afa85356-1d0a-3093-874f-4a20dffc5807",
                                        "entry_id": "28a35db1-0cb8-3a8c-88c9-a8c5f596d17b",
                                        "glosses": [
                                            "A unit of currency in China, one-hundredth of a yuan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de4cd1c5-5efc-4162-87a3-0d5f339ee0de",
                                                "sense_id": "afa85356-1d0a-3093-874f-4a20dffc5807",
                                                "text": "One poster, which appeared on the Barkhor on 20 May, ridiculed the way neighbourhood committees were recruiting participants: “We paid 30 fen for one stone, but you hire people for 30 yuan for the picnic in the Norbulingka” (“30 fen” — one hundred fen is one yuan — is a joking reference to Chinese accusations that Tibetans were paid 30 fen by splittists for each stone thrown on 1 October 1987)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "78438ceb-1f5c-3dd6-b0d6-b784d7dd96df",
                                        "entry_id": "53f0e106-66f7-3cd7-b55d-1e7e95c4fa5a",
                                        "glosses": [
                                            "a plural of fan used by enthusiasts of science fiction, fantasy, and anime, partly from whimsy and partly to distinguish themselves from fans of sport, etc."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b770987-5bce-4411-9aee-4f2d86fc0c43",
                                                "sense_id": "78438ceb-1f5c-3dd6-b0d6-b784d7dd96df",
                                                "text": "Sad to relate, some of the European delegates were probably insurgents rather than true fen. […] But the Europeans could be counted on to take the long view, and many of them would probably turn out to be real fen and fenne after all."
                                            },
                                            {
                                                "example_id": "829fe3ee-aa6c-438c-8190-371d01a0d646",
