                        "examples": [
                            {
                                "example_id": "2c15aedc-82c3-4ee4-922a-9f1e40c19200",
                                "sense_id": "8431ebd9-b67f-3def-a311-91c973c79432",
                                "text": "In der Sportstunde spielen wir Zweifelderball."
                            },
                            {
                                "example_id": "8414afba-3e34-4cbe-b8c3-923e41f2ad0f",
                                "sense_id": "8431ebd9-b67f-3def-a311-91c973c79432",
                                "text": "Es galt wegen seiner kriegerischen Spielphilosophie noch einige Jahre nach dem Krieg eher als unerwünscht oder gar verboten. In der DDR taufte man es in „Zweifelderball“ um."
                            },
                            {
                                "example_id": "8e7c3859-6d5a-43c7-bac4-3578521fdf4b",
                                "sense_id": "8431ebd9-b67f-3def-a311-91c973c79432",
                                "text": "Zum Ausklang kann es mit einem Ballspiel wieder etwas intensiver zugehen, beispielsweise Zombie oder Zweifelderball nach Zeit."
                            }
                        ],
