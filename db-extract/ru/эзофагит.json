                                    {
                                        "sense_id": "99589d7d-dc80-3302-b377-aba6c2d53d30",
                                        "entry_id": "c1f89a60-8a5c-34ca-8db2-dd3244191c4f",
                                        "glosses": [
                                            "akut oder chronisch auftretende Entzündung der Schleimhaut der Speiseröhre"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18fb61ec-d4df-4106-a9e3-694a820326e5",
                                                "sense_id": "99589d7d-dc80-3302-b377-aba6c2d53d30",
                                                "text": "Die Ösophagitis als Folge einer gastroösophagealen Refluxkrankheit ist zu einer der häufigsten Erkrankungen in den westlichen Ländern geworden."
                                            },
                                            {
                                                "example_id": "d423598e-e992-433f-926f-c4f0534afb5f",
                                                "sense_id": "99589d7d-dc80-3302-b377-aba6c2d53d30",
                                                "text": "Leichtgradige Ösophagitiden können der Diagnostik entgehen."
                                            },
                                            {
                                                "example_id": "ff177ed2-21b2-4a1c-96bd-a2ab6a3d992c",
                                                "sense_id": "99589d7d-dc80-3302-b377-aba6c2d53d30",
                                                "text": "Habe auch Dr. B. gesehen, einen Gastroenterologen, Praxis Kurfürstendamm, viel Geld durch marode, perforierte und entzündete Mägen und Därme, Spezialist für Ösophagitis."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
