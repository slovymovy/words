{
    "word_family": [
        "cuteness",
        "cutely",
        "cutie"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c37333c4-4dab-35d3-a66f-d91951ba8c55",
                    "sense_definition": "Lovable, charming, or attractive, especially in a youthful, sweet, or dainty way.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "pleasing_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Look at that <w>cute</w> puppy playing in the garden.",
                            "target_lang_translations": {
                                "ru": "Посмотри на этого <w>милого</w> щенка, играющего в саду.",
                                "it": "Guarda quel <w>carino</w> cagnolino che gioca in giardino.",
                                "zh": "看那只在花园里玩耍的<w>可爱</w>小狗。"
                            }
                        },
                        {
                            "text": "She wore a <w>cute</w> dress with flowers on it to the party.",
                            "target_lang_translations": {
                                "ru": "Она надела на вечеринку <w>хорошенькое</w> платье в цветочек.",
                                "it": "Ha indossato un <w>grazioso</w> vestito a fiori per la festa.",
                                "zh": "她穿了一件<w>漂亮</w>的花裙子去参加聚会。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pretty",
                        "adorable",
                        "sweet"
                    ],
                    "antonyms": [
                        "ugly"
                    ],
                    "common_phrases": [
                        "so cute",
                        "cute baby",
                        "cute little",
                        "very cute"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очаровательный, привлекательный или вызывающий умиление, особенно если речь идет о чем-то маленьком, юном или нежном.",
                        "it": "Amabile, affascinante o attraente, specialmente in modo giovanile, dolce o grazioso.",
                        "zh": "指人或事物可爱、讨人喜欢，尤指外表年轻、甜美或精致。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "милый",
                                "target_lang_sense_clarification": "вызывающий умиление"
                            },
                            {
                                "target_lang_word": "хорошенький",
                                "target_lang_sense_clarification": "привлекательный (часто о детях или женщинах)"
                            },
                            {
                                "target_lang_word": "симпатичный",
                                "target_lang_sense_clarification": "приятный на вид"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "carino",
                                "target_lang_sense_clarification": "che suscita tenerezza o è piacevole alla vista"
                            },
                            {
                                "target_lang_word": "grazioso",
                                "target_lang_sense_clarification": "che ha un aspetto leggiadro e delicato"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可爱",
                                "target_lang_sense_clarification": "讨人喜欢，令人喜爱"
                            },
                            {
                                "target_lang_word": "讨人喜欢",
                                "target_lang_sense_clarification": "招人喜爱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d3f7822-acaf-373a-bd82-beda086ba983",
                    "sense_definition": "Sexually attractive or good-looking.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pleasing_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I met a really <w>cute</w> guy at the coffee shop yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера в кофейне я встретила очень <w>симпатичного</w> парня.",
                                "it": "Ieri ho incontrato un ragazzo davvero <w>carino</w> al bar.",
                                "zh": "我昨天在咖啡店遇见了一个非常<w>帅气</w>的男生。"
                            }
                        },
                        {
                            "text": "She thinks the lead singer of the band is very <w>cute</w>.",
                            "target_lang_translations": {
                                "ru": "Она считает солиста группы очень <w>симпатичным</w>.",
                                "it": "Lei pensa che il cantante della band sia molto <w>carino</w>.",
                                "zh": "她觉得那个乐队的主唱非常<w>好看</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pretty",
                        "attractive",
                        "handsome"
                    ],
                    "antonyms": [
                        "ugly"
                    ],
                    "common_phrases": [
                        "cute guy",
                        "cute girl"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Common in casual conversation."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сексуально привлекательный или красивый (обычно о людях).",
                        "it": "Attraente dal punto di vista sessuale o di bell'aspetto.",
                        "zh": "指人外表有吸引力，长得好看。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "симпатичный",
                                "target_lang_sense_clarification": "привлекательный внешне"
                            },
                            {
                                "target_lang_word": "милый",
                                "target_lang_sense_clarification": "нравящийся, приятный"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "carino",
                                "target_lang_sense_clarification": "di bell'aspetto, attraente"
                            },
                            {
                                "target_lang_word": "attraente",
                                "target_lang_sense_clarification": "che esercita un fascino fisico"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "帅气",
                                "target_lang_sense_clarification": "指男性外表英俊"
                            },
                            {
                                "target_lang_word": "漂亮",
                                "target_lang_sense_clarification": "指女性外表美丽"
                            },
                            {
                                "target_lang_word": "好看",
                                "target_lang_sense_clarification": "外表美观，有吸引力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf5c6440-c3d3-3f42-8e39-ffc81001341d",
                    "sense_definition": "Trying to be clever or charming in a way that is annoying, disrespectful, or contrived.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cleverness_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't get <w>cute</w> with me when I ask you a serious question.",
                            "target_lang_translations": {
                                "ru": "Не <w>умничай</w>, когда я задаю тебе серьезный вопрос.",
                                "it": "Non <w>fare lo spiritoso</w> con me quando ti faccio una domanda seria.",
                                "zh": "当我问你正经问题时，别跟我<w>自作聪明</w>。"
                            }
                        },
                        {
                            "text": "He thought he was being <w>cute</w> by hiding my keys, but I was not amused.",
                            "target_lang_translations": {
                                "ru": "Он думал, что это <w>остроумно</w> — спрятать мои ключи, но мне было не смешно.",
                                "it": "Pensava di essere <w>furbo</w> nascondendo le mie chiavi, ma non l'ho trovato divertente.",
                                "zh": "他以为藏起我的钥匙很<w>有趣</w>，但我一点也不觉得好笑。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "don't get cute",
                        "trying to be cute"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пытающийся казаться остроумным или хитрым, но выглядящий при этом раздражающе, неуважительно или неестественно.",
                        "it": "Cercare di sembrare astuti o affascinanti in modo fastidioso, irrispettoso o artificioso.",
                        "zh": "指试图表现得聪明或迷人，但方式令人反感、无礼或做作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "умничающий",
                                "target_lang_sense_clarification": "пытающийся казаться умным (негативно)"
                            },
                            {
                                "target_lang_word": "дерзкий",
                                "target_lang_sense_clarification": "нахальный"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "fare il furbo",
                                "target_lang_sense_clarification": "comportarsi in modo astuto ma irritante"
                            },
                            {
                                "target_lang_word": "fare lo spiritoso",
                                "target_lang_sense_clarification": "cercare di essere divertenti in modo inopportuno"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "自作聪明",
                                "target_lang_sense_clarification": "自以为聪明，令人讨厌"
                            },
                            {
                                "target_lang_word": "油嘴滑舌",
                                "target_lang_sense_clarification": "说话轻浮，不庄重"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bec0a885-b76a-315a-8bb8-62041ef39f71",
                    "sense_definition": "Clever, elegant, or interesting, often referring to a solution, trick, or idea.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "cleverness_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mathematician found a <w>cute</w> way to solve the complex equation.",
                            "target_lang_translations": {
                                "ru": "Математик нашел <w>изящный</w> способ решения сложного уравнения.",
                                "it": "Il matematico ha trovato un <w>ingegnoso</w> modo per risolvere l'equazione complessa.",
                                "zh": "数学家找到了一种<w>巧妙</w>的方法来解这个复杂的方程。"
                            }
                        },
                        {
                            "text": "It was a <w>cute</w> trick, but it won't work in every situation.",
                            "target_lang_translations": {
                                "ru": "Это был <w>хитрый</w> трюк, но он сработает не в каждой ситуации.",
                                "it": "È stato un <w>brillante</w> trucco, ma non funzionerà in ogni situazione.",
                                "zh": "那是个<w>精巧</w>的把戏，但并不是在任何情况下都管用。"
                            }
                        }
                    ],
                    "synonyms": [
                        "clever"
                    ],
                    "common_phrases": [
                        "cute trick",
                        "cute solution"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изобретательный, элегантный или интересный (часто о решении, трюке или идее).",
                        "it": "Ingegnoso, elegante o interessante, spesso riferito a una soluzione, un trucco o un'idea.",
                        "zh": "指方法、技巧或主意巧妙、精巧或有趣。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изящный",
                                "target_lang_sense_clarification": "элегантный (о решении)"
                            },
                            {
                                "target_lang_word": "остроумный",
                                "target_lang_sense_clarification": "изобретательный"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "ingegnoso",
                                "target_lang_sense_clarification": "che denota inventiva e intelligenza"
                            },
                            {
                                "target_lang_word": "brillante",
                                "target_lang_sense_clarification": "riferito a un'idea o soluzione efficace"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "巧妙",
                                "target_lang_sense_clarification": "方法或技巧精巧"
                            },
                            {
                                "target_lang_word": "精巧",
                                "target_lang_sense_clarification": "构思精细巧妙"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47bb8775-0d58-33bd-83aa-72d3a43569ac",
                    "sense_definition": "Mentally keen, shrewd, or discerning.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cleverness_behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The merchant was <w>cute</w> enough to hide his money before the thieves arrived.",
                            "target_lang_translations": {
                                "ru": "Торговец был достаточно <w>сообразителен</w>, чтобы спрятать деньги до прихода воров.",
                                "it": "Il mercante è stato abbastanza <w>scaltro</w> da nascondere i suoi soldi prima dell'arrivo dei ladri.",
                                "zh": "商人足够<w>精明</w>，在强盗到来之前就把钱藏了起来。"
                            }
                        },
                        {
                            "text": "He is a <w>cute</w> observer of human nature and notices everything.",
                            "target_lang_translations": {
                                "ru": "Он <w>проницательный</w> наблюдатель человеческой натуры и замечает всё.",
                                "it": "È un <w>perspicace</w> osservatore della natura umana e nota tutto.",
                                "zh": "他是一个<w>敏锐</w>的人性观察者，什么都能注意到。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shrewd",
                        "clever"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Short for 'acute'; rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проницательный, сообразительный или догадливый (устаревшее значение).",
                        "it": "Mentalmente acuto, scaltro o perspicace (termine arcaico).",
                        "zh": "指思维敏锐、精明或有洞察力（旧用法）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проницательный",
                                "target_lang_sense_clarification": "наблюдательный"
                            },
                            {
                                "target_lang_word": "сообразительный",
                                "target_lang_sense_clarification": "догадливый"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "perspicace",
                                "target_lang_sense_clarification": "dotato di intuito e capacità di osservazione"
                            },
                            {
                                "target_lang_word": "scaltro",
                                "target_lang_sense_clarification": "astuto e capace di capire le situazioni"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "敏锐",
                                "target_lang_sense_clarification": "感觉或思维灵敏"
                            },
                            {
                                "target_lang_word": "精明",
                                "target_lang_sense_clarification": "眼光独到，善于判断"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}