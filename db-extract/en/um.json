                "pos": "particle",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "138fbd15-ee00-3316-b9b0-26258deb74f0",
                        "entry_id": "5c222598-d37d-39e3-aac1-2b7c8a1790ca",
                        "glosses": [
                            "An undifferentiated determiner or article; a miscellaneous linking word, or filler with nonspecific meaning; representation of broken English stereotypically or comically attributed to Native Americans."
                        ],
                        "tags": [
                            "dated",
                            "humorous",
                            "offensive",
                            "often",
                            "sometimes"
                        ],
                        "examples": [
                            {
                                "example_id": "a8dd6def-c44b-4053-8a22-6b51f58da382",
                                "sense_id": "138fbd15-ee00-3316-b9b0-26258deb74f0",
                                "text": "Me be Injun. Him um Growling Bear. Him um heap big chief."
                            },
                            {
                                "example_id": "97b46ffa-dc56-461b-9bf0-9b2a08e6e8d4",
                                "sense_id": "138fbd15-ee00-3316-b9b0-26258deb74f0",
                                "text": "“me heap brave—me talk to um white man so[…] me good injun, like um white man, mebbe so, ugh!”"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
