                                            {
                                                "example_id": "2981468c-96a5-4715-a0ed-8e68fe2f0f8f",
                                                "sense_id": "c86a188d-19a5-3533-a1bb-0931d1fc6fec",
                                                "text": "Ma mère, quant à elle, avec une inconscience qui n’avait d’égale que sa radicale inculture en matière de patronymie juive, s’appelait Aïcha Bensoussan. Aïcha sonnait peut-être arabe, mais tous les Bensoussan sont juifs."
                                            },
                                            {
                                                "example_id": "085f0856-506e-4fdc-a500-b8f78adfb8da",
                                                "sense_id": "c86a188d-19a5-3533-a1bb-0931d1fc6fec",
                                                "text": "Une fille d’environ vingt-cinq ans, de type nord-africain, se tenait dans l’entrée. « Je m’appelle Aïcha, dit-elle. Je faisais le ménage chez monsieur Renault deux fois par semaine. Je suis venue récupérer mes affaires. »"
                                            }
                                        ]
                                    }
                                ]
