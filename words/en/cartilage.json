{
    "word_family": [
        "cartilaginous"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4067d99a-a73e-3674-b7ce-686f80b66e2e",
                    "sense_definition": "A firm, flexible, and elastic type of connective tissue found in joints, the ear, and the nose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cartilage_anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tough <w>cartilage</w> in your joints protects bones from rubbing directly against each other.",
                            "target_lang_translations": {
                                "ru": "Прочный <w>хрящ</w> в суставах предохраняет кости от трения друг о друга."
                            }
                        },
                        {
                            "text": "Unlike bone, <w>cartilage</w> contains no blood vessels and heals much more slowly after injury.",
                            "target_lang_translations": {
                                "ru": "В отличие от кости, <w>хрящевая ткань</w> не содержит кровеносных сосудов и восстанавливается после травм гораздо медленнее."
                            }
                        }
                    ],
                    "synonyms": [
                        "gristle"
                    ],
                    "common_phrases": [
                        "articular cartilage",
                        "loss of cartilage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прочная, гибкая и эластичная соединительная ткань, находящаяся в суставах, ушах и носу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хрящ",
                                "target_lang_sense_clarification": "соединительная ткань"
                            },
                            {
                                "target_lang_word": "хрящевая ткань",
                                "target_lang_sense_clarification": "анатомический термин"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6baea7a6-5177-3215-bf7c-ad0bd87b8e9c",
                    "sense_definition": "A specific bodily part or structure that consists of cartilage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cartilage_anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tore a <w>cartilage</w> in his knee during a soccer match yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера во время футбольного матча он порвал <w>хрящ</w> в колене."
                            }
                        },
                        {
                            "text": "The surgeon repaired the damaged <w>cartilage</w> using a minimally invasive procedure.",
                            "target_lang_translations": {
                                "ru": "Хирург восстановил поврежденный <w>хрящ</w> с помощью малоинвазивной процедуры."
                            }
                        }
                    ],
                    "common_phrases": [
                        "torn cartilage",
                        "knee cartilage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельная анатомическая структура или часть тела, состоящая из хрящевой ткани (например, мениск)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хрящ",
                                "target_lang_sense_clarification": "отдельный анатомический элемент"
                            },
                            {
                                "target_lang_word": "мениск",
                                "target_lang_sense_clarification": "хрящ коленного сустава"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}