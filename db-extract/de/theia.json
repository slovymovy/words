                                        "tags": [
                                            "Divinité"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "90dd6ba1-ac86-3d53-ad4c-bc7ee606663f",
                                        "entry_id": "4adec759-87c0-36c4-bf7e-0ef36c27f76b",
                                        "glosses": [
                                            "Nom donné à la planète hypothétique qui aurait heurté la Terre pour donner naissance à la Lune."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7aa7b1d-4637-45cc-9fe2-70d302e68f76",
                                                "sense_id": "90dd6ba1-ac86-3d53-ad4c-bc7ee606663f",
                                                "text": "Selon les simulations, entre 70 et 90 % de la masse de Théia aurait été éjectée lors de la collision et ferait partie de la Lune."
                                            }
                                        ]
                                    }
                                ]
                            }
