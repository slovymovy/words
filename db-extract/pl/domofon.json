                    }
                ],
                "translations": [
                    {
                        "translation_id": "790834b8-7101-4d48-8934-2fd6c77a68c9",
                        "source_entry_id": "decc209f-91aa-327f-a879-1e041cb87a4b",
                        "source_sense_id": "960c38db-61f1-3849-a52c-570d3d0d697f",
                        "target_lang_word": "entry phone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entry phone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "611a11c5-0c4d-3e7f-ae37-a44a5780ecae",
                                        "entry_id": "eb2cc482-088e-3220-b218-881cdd5bdcd8",
                                        "glosses": [
                                            "Alternative form of entryphone."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d225902e-d9ad-4d7a-b0cb-e9eb74e2c9b1",
                                                "sense_id": "611a11c5-0c4d-3e7f-ae37-a44a5780ecae",
                                                "text": "Her third-floor flat in the old Edwardian house had no entry phone or intercom system."
                                            },
                                            {
                                                "example_id": "9c995085-cc65-43f5-b7f8-7f728ceb12ed",
                                                "sense_id": "611a11c5-0c4d-3e7f-ae37-a44a5780ecae",
                                                "text": "There was the sound of buzzing, an entry phone maybe, then the lift doors droned."
                                            },
                                            {
                                                "example_id": "05cb15b2-6bcc-4c3c-b556-182e741015e6",
                                                "sense_id": "611a11c5-0c4d-3e7f-ae37-a44a5780ecae",
                                                "text": "I rang the entry phone and gave my name; the lock was released and I was told to go to the first floor, where her housekeeper, Carmen Vargas, met me and led the way to the drawing room."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cae321b6-4d24-4792-852d-654c3d039673",
                        "source_entry_id": "decc209f-91aa-327f-a879-1e041cb87a4b",
                        "source_sense_id": "960c38db-61f1-3849-a52c-570d3d0d697f",
                        "target_lang_word": "house telephone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "84b6a63d-7eea-4309-9efa-e7d239ec7038",
                        "source_entry_id": "decc209f-91aa-327f-a879-1e041cb87a4b",
                        "source_sense_id": "960c38db-61f1-3849-a52c-570d3d0d697f",
                        "target_lang_word": "interphone",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interphone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a5e563f5-4052-3113-9787-33588687af3e",
                                        "entry_id": "ceb50abf-bc05-3d47-9f8f-e653769dfe6d",
                                        "glosses": [
                                            "Téléphone connecté à un réseau intérieur à un immeuble, hôtel, etc., souvent équipé d’un haut-parleur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41228d28-cb85-4fb9-baef-5e33a191b6da",
                                                "sense_id": "a5e563f5-4052-3113-9787-33588687af3e",
                                                "text": "Tant pis! dit le Président avant d’appuyer sur l’interphone : Caroline, allez-y, faites entrer."
                                            },
                                            {
                                                "example_id": "ce996ab6-d253-4554-96e1-ce739b26fc8c",
                                                "sense_id": "a5e563f5-4052-3113-9787-33588687af3e",
                                                "text": "Ainsi, c’est après avoir appelé sa secrétaire sur l’interphone que Stahr apprend la tentative de suicide d’un de ses caméramen, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47da2244-fbcc-387d-856c-ced329bfbf3d",
                                        "entry_id": "ceb50abf-bc05-3d47-9f8f-e653769dfe6d",
                                        "glosses": [
                                            "Dispositif acoustique électronique interne à un immeuble, placé à l’entrée et dans un ou plusieurs pièces de celui-ci, afin d’en contrôler l’accès à l’aide d’un ouvre-porte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f819e5a1-3449-44d6-b70c-f42877850504",
                                                "sense_id": "47da2244-fbcc-387d-856c-ced329bfbf3d",
                                                "text": "Notre interphone permet non seulement d’accueillir les visiteurs, mais également de commander à distance l’ouverture de la porte."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "interphone",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
