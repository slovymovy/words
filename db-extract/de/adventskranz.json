                ],
                "senses": [
                    {
                        "sense_id": "99760039-a72f-3851-9038-f832f2dce29d",
                        "entry_id": "b04c075b-56b4-3940-a97f-81b8babb6931",
                        "glosses": [
                            "ein mit vier Kerzen bestückter, verzierter Kranz aus geflochtenen Nadelzweigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6183546-f420-4b0f-80e6-8ba2485decd1",
                                "sense_id": "99760039-a72f-3851-9038-f832f2dce29d",
                                "text": "Den in Betrieb befindlichen Adventskranz niemals unbeaufsichtigt lassen!"
                            },
                            {
                                "example_id": "d3292cb7-6791-464d-8a25-1dfd9de40c5d",
                                "sense_id": "99760039-a72f-3851-9038-f832f2dce29d",
                                "text": "„Drei Tage vor dem ersten Advent ging der Direktor nach Schulschluss durchs Viertel, um im Auftrag seiner Frau einen Adventskranz zu kaufen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2174494-f627-4c63-b436-b38781d92091",
                        "source_entry_id": "b04c075b-56b4-3940-a97f-81b8babb6931",
                        "source_sense_id": "99760039-a72f-3851-9038-f832f2dce29d",
                        "source_sense_description": "ein mit vier Kerzen bestückter, verzierter Kranz aus geflochtenen Nadelzweigen",
                        "target_lang_word": "Advent wreath",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Advent wreath",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f6790cad-d821-3ca1-ab2a-00a1def2987c",
                                        "entry_id": "6e2a9c05-a46d-3657-9310-6e82df244d97",
                                        "glosses": [
                                            "A usually evergreen wreath adorned with four (or sometimes five) candles, the first of which is lit on Advent Sunday, followed by the lighting of an additional candle on each subsequent Sunday."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4eb2406b-846c-47eb-b371-b3031d0f95c2",
                                                "sense_id": "f6790cad-d821-3ca1-ab2a-00a1def2987c",
                                                "text": "Local custom gives us an “Advent Tree” or “Advent Wreath”: the trees are diminutive Christmas trees, which bear one candle for each Sunday in Advent; the wreaths are wooden rings with as many holes as there are days before Christmas Eve, decorated with fir green, and gay ribbons, and hung up over the dining-table, one candle being added every night till the circle is complete."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "faf2ed74-232a-4e2d-b039-2ca8258942b3",
                        "source_entry_id": "b04c075b-56b4-3940-a97f-81b8babb6931",
                        "source_sense_id": "99760039-a72f-3851-9038-f832f2dce29d",
                        "source_sense_description": "ein mit vier Kerzen bestückter, verzierter Kranz aus geflochtenen Nadelzweigen",
                        "target_lang_word": "couronne de l’Avent",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "couronne de l’Avent",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "42cbe85d-7620-3043-b629-cccd5bafa5ac",
                                        "entry_id": "834679f6-ca62-3852-b03c-be0a85e34e11",
                                        "glosses": [
                                            "Décoration de table pendant la période de l’Avent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c159c8a-d19c-4f5c-ac04-744c8a238e7b",
                                                "sense_id": "42cbe85d-7620-3043-b629-cccd5bafa5ac",
                                                "text": "De nombreuses traditions populaires accompagnent cette période de l'Avent. Une des plus en vogue actuellement est certainement la couronne de l’Avent. Elle semble avoir une origine nordique ou germanique, en lien avec d'anciens cultes […]."
                                            },
                                            {
                                                "example_id": "91404734-1de7-41b0-93db-3c4db7db9166",
                                                "sense_id": "42cbe85d-7620-3043-b629-cccd5bafa5ac",
                                                "text": "Michael Sullivan officiait ce jour-là ; il est venu et m'a demandé si je me sentais capable d'allumer la deuxième bougie sur la couronne de l’avent. Je ne le souhaitais pas, […]."
                                            },
                                            {
                                                "example_id": "4f4d9c0e-60aa-42e1-85c5-ce5abf645659",
                                                "sense_id": "42cbe85d-7620-3043-b629-cccd5bafa5ac",
                                                "text": "Aujourd'hui, les couronnes de l’Avent sont faites de branches de sapin parmi lesquelles on place quatre bougies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1665f9a9-8131-4893-8ec3-02c95cf4e235",
                        "source_entry_id": "b04c075b-56b4-3940-a97f-81b8babb6931",
