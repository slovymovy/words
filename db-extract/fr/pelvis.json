                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "eda113c1-ca5a-348b-9ff7-52b447b2fe84",
                        "entry_id": "9c5a3103-f6ec-3943-a397-197523c2d975",
                        "glosses": [
                            "Bassin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fc2273d-e53e-4362-b45f-0be235f533fc",
                                "sense_id": "eda113c1-ca5a-348b-9ff7-52b447b2fe84",
                                "text": "Les nerfs autonomes de la région crânienne et de la région du pelvis s'appellent parasympathiques."
                            },
                            {
                                "example_id": "b3786887-3215-4fc8-b93c-8a213a079ae9",
                                "sense_id": "eda113c1-ca5a-348b-9ff7-52b447b2fe84",
                                "text": "Les garçons passaient et repassaient devant l’écran, mais ce soir-là tous ceux qui se trouvaient dans le salon furent immobilisés par l’apparition du chanteur dont il ne fallait pas montrer le pelvis."
                            },
                            {
                                "example_id": "a7245c6e-b865-403b-9db1-1f095ce0a994",
                                "sense_id": "eda113c1-ca5a-348b-9ff7-52b447b2fe84",
                                "text": "Un prolapsus c'est une ptôse, une descente d'organes. Tous les organes de son pelvis sont descendus, l'utérus en premier. Ça a lâché."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3444ac2f-14e6-40b5-8999-f08d78c8f639",
                        "source_entry_id": "9c5a3103-f6ec-3943-a397-197523c2d975",
                        "source_sense_id": "eda113c1-ca5a-348b-9ff7-52b447b2fe84",
                        "target_lang_word": "Becken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Becken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3e4b5804-efa1-3d9b-a60d-3f3349b4e354",
                                        "entry_id": "56c98aa0-a7ed-31e0-bd57-dfbeae1a240c",
                                        "glosses": [
                                            "derjenige Körperabschnitt, der unterhalb des Bauchs und oberhalb der Beine gelegen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0739b60-8b6c-4afe-9880-676630896a8d",
                                                "sense_id": "3e4b5804-efa1-3d9b-a60d-3f3349b4e354",
                                                "text": "Bei diesem Sturz hat er sich einen Bruch des Beckens zugezogen."
                                            },
                                            {
                                                "example_id": "a057fe2d-64eb-4551-a7dd-e255abb2022c",
                                                "sense_id": "3e4b5804-efa1-3d9b-a60d-3f3349b4e354",
                                                "text": "„Mit beiden Händen wippte ich sie auf und ab und ließ ihr Becken rotieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bff5085c-df7d-352d-a341-ca3a0ed2f51a",
                                        "entry_id": "56c98aa0-a7ed-31e0-bd57-dfbeae1a240c",
                                        "glosses": [
                                            "flacher, oben offener, oft fest installierter Behälter für Wasser oder eine andere Flüssigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80b631e3-8b82-4e23-8a46-2085ce45a62d",
                                                "sense_id": "bff5085c-df7d-352d-a341-ca3a0ed2f51a",
                                                "text": "Er sprang vom 1-Meter-Brett ins Becken."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "046dd7d2-a848-34ba-b21e-d66e49380d23",
                                        "entry_id": "56c98aa0-a7ed-31e0-bd57-dfbeae1a240c",
                                        "glosses": [
                                            "großer natürlicher oder künstlicher Behälter für Wasser in der Landschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9027bdc-5682-4de2-9385-4decab9d2b8a",
                                                "sense_id": "046dd7d2-a848-34ba-b21e-d66e49380d23",
                                                "text": "Dieses Becken ist für große Schiffe nicht tief genug."
                                            },
                                            {
                                                "example_id": "abc09e0c-a02f-42e4-a1a7-3f6b2374bcc5",
                                                "sense_id": "046dd7d2-a848-34ba-b21e-d66e49380d23",
                                                "text": "„Wir erreichten den Rand des Beckens auf seiner Westseite und wateten durch das Wasser hindurch zu dem Schotterhaufen auf der Leeseite des Felsens.“"
                                            },
                                            {
                                                "example_id": "e1b9a485-f01b-4a32-a3b2-65dd3570b134",
                                                "sense_id": "046dd7d2-a848-34ba-b21e-d66e49380d23",
                                                "text": "„Sein Becken mit Hunderten Nebenflüssen und Seitenarmen misst rund 3,5 Millionen Quadratkilometer – ein Gebiet größer als Indien.“"
                                            },
                                            {
                                                "example_id": "8ec32196-dd53-48d1-b374-1db051912b3f",
                                                "sense_id": "046dd7d2-a848-34ba-b21e-d66e49380d23",
                                                "text": "„Daneben kommt zuerst ein aus Kalkstein fein gearbeitetes, sechseckiges Becken in Sicht, daneben die Ruinen von mindestens drei Tempeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "bb5fb479-62a2-3cfb-91ba-745191643908",
                                        "entry_id": "56c98aa0-a7ed-31e0-bd57-dfbeae1a240c",
                                        "glosses": [
                                            "ausgedehnte landschaftliche Einsenkung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41ee3845-c9c0-4856-8216-6908d98e5992",
                                                "sense_id": "bb5fb479-62a2-3cfb-91ba-745191643908",
                                                "text": "Am Grund des Beckens hat sich eine typische Flora entwickelt."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "0b590346-c492-396e-a9f6-fcc8c1f2129c",
                                        "entry_id": "56c98aa0-a7ed-31e0-bd57-dfbeae1a240c",
                                        "glosses": [
                                            "Musikinstrument, bei dem eine tellerförmige Metallscheibe geschlagen bzw. ein Paar von Metallscheiben gegeneinander geschlagen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d37bf3bd-132c-4c48-96d0-33d5cf772d2f",
                                                "sense_id": "0b590346-c492-396e-a9f6-fcc8c1f2129c",
                                                "text": "Das Becken hat einen feinen Riss und muss noch vor dem Konzert ausgetauscht werden."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            },
