                "senses": [
                    {
                        "sense_id": "e70715b5-2ddd-31a0-a5f1-9e7606d1c7a6",
                        "entry_id": "636e20f9-7934-3d6c-80f9-a6168eca0dd9",
                        "glosses": [
                            "диал. устар. находящийся за речкой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "164f2d84-4d8b-4893-b253-83417e6160c7",
                                "sense_id": "e70715b5-2ddd-31a0-a5f1-9e7606d1c7a6",
                                "text": "Надо было перейти речку от одного до другого зарецкого брега."
                            }
                        ]
                    },
                    {
                        "sense_id": "e9e78ed9-2a75-355a-ab38-068c758fc508",
                        "entry_id": "636e20f9-7934-3d6c-80f9-a6168eca0dd9",
                        "glosses": [
                            "относящийся к Зарецку"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55e0fab6-bc75-4aa6-92ca-dee900e5a9f5",
                                "sense_id": "e9e78ed9-2a75-355a-ab38-068c758fc508",
                                "text": "Путешествие по зарецким просторам."
                            }
                        ]
                    },
                    {
                        "sense_id": "f69dc6b5-a58b-35d9-9f66-4985bc376cc3",
                        "entry_id": "636e20f9-7934-3d6c-80f9-a6168eca0dd9",
                        "glosses": [
                            "относящийся к Зарецким"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6b3b491-6ade-4605-bbf6-52345a31ebc9",
                                "sense_id": "f69dc6b5-a58b-35d9-9f66-4985bc376cc3",
                                "text": "Пойду попробую вина зарецкого из барских закромов."
                            },
                            {
                                "example_id": "641defbb-022e-44e6-8365-c5fde6d4a664",
                                "sense_id": "f69dc6b5-a58b-35d9-9f66-4985bc376cc3",
                                "text": "Зарецкий княжич опять озорничал."
                            }
                        ]
                    }
                ],
