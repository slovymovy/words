                            },
                            {
                                "target_lang_word": "fidelity",
                                "target_lang_sense_clarification": "faithfulness to a person, cause, or belief"
                            },
                            {
                                "target_lang_word": "allegiance",
                                "target_lang_sense_clarification": "loyalty or commitment to a superior or group"
                            }
                        ],
                        "it": [
