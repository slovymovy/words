                    {
                        "sense_id": "4dc91e4f-aea6-397c-9e96-4868dd34bf14",
                        "entry_id": "0b6b54ab-7d56-3041-88c8-62bf12e0f51b",
                        "glosses": [
                            "Petit squale, largement répandu sur les côtes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "619d32d3-044e-42dc-8faa-fb1850a29f52",
                                "sense_id": "4dc91e4f-aea6-397c-9e96-4868dd34bf14",
                                "text": "les chiens de mer, horribles, avec leurs têtes rondes, leurs bouches largement fendues d’idoles chinoises, leurs courtes ailes de chauves-souris charnues, monstres qui doivent garder de leurs abois les trésors des grottes marines.."
                            },
                            {
                                "example_id": "5cd52d43-e5d8-4e8d-8fdd-b5fa118664cb",
                                "sense_id": "4dc91e4f-aea6-397c-9e96-4868dd34bf14",
                                "text": "Rappelle-toi ce chien de mer\nQue nous libérions sur parole\nEt qui gueule dans le désert\nDes goémons de nécropole."
                            }
                        ]
                    },
                    {
                        "sense_id": "3fbc9a96-d940-3426-addf-0146426a7922",
