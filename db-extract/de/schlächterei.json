                "senses": [
                    {
                        "sense_id": "dc802be3-fde3-396b-b61d-0417a86e612b",
                        "entry_id": "018d9af5-9012-3268-8ab1-fc97e105c477",
                        "glosses": [
                            "Betrieb, in dem Fleisch- und Wurstwaren hergestellt und verkauft werden"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "01ccc453-d0a3-4123-b77d-7313fbb8d003",
                                "sense_id": "dc802be3-fde3-396b-b61d-0417a86e612b",
                                "text": "„Zu ebener Erde lag eine Schlächterei, in der eine mächtige Frau das Beil schwang und Fleisch verkaufte.“"
                            },
                            {
                                "example_id": "c0a93534-e541-40ea-8310-fc3943b4a7f1",
                                "sense_id": "dc802be3-fde3-396b-b61d-0417a86e612b",
                                "text": "„Dann aber begann der Tanz der Käseräder, die von einem Haus ins andere rollten, und der Fleischstücke, die aus geheimen Schlächtereien in die Restaurants geschafft wurden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "578e73f3-2b22-3e22-9fe3-958f2aa62924",
                        "entry_id": "018d9af5-9012-3268-8ab1-fc97e105c477",
                        "glosses": [
                            "grausames Töten von Mensch und Tier in großer Anzahl"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "5f65ad60-0f4b-43d1-923c-0a3c7b1395da",
                                "sense_id": "578e73f3-2b22-3e22-9fe3-958f2aa62924",
                                "text": "„Die vor- und nachreformatorische Kirchengeschichte ist randvoll mit gottgefälliger Schlächterei, wie bereits das Alte Testament.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
