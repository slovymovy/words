                ],
                "senses": [
                    {
                        "sense_id": "645712ef-9f5c-3b94-9f1b-b7d6355a861f",
                        "entry_id": "ca26ce01-9be1-3f2e-8af0-0fc8fa2eda69",
                        "glosses": [
                            "(kurze) Textstelle in der Bibel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75bfc6c4-cec6-4074-a6f1-4494f2385926",
                                "sense_id": "645712ef-9f5c-3b94-9f1b-b7d6355a861f",
                                "text": "„Für ihn war dieser Bibelabschnitt eine Beschreibung der verschiedenen Stufen, die ein Gläubiger auf dem Weg zur evangelischen Freiheit und Erlösung durchlaufen müsse.“"
                            },
                            {
                                "example_id": "abbc30ba-7462-40dd-aec6-9a303663eaab",
                                "sense_id": "645712ef-9f5c-3b94-9f1b-b7d6355a861f",
                                "text": "„Der Bibelabschnitt, von dem ich spreche, bildet nach allgemeiner bibelwissenschaftlicher Überzeugung das Zentrum der vier Evangelien.“"
                            },
                            {
                                "example_id": "b82b6311-1951-4923-b732-64cd4a6cc0d0",
                                "sense_id": "645712ef-9f5c-3b94-9f1b-b7d6355a861f",
                                "text": "„Herr Kabis las einen Bibelabschnitt, ein Gebet aus Stark und dann beteten wir das Vaterunser gemeinsam, beim Segen gedachte wohl jeder seiner fernen Lieben und Liebsten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
