                ],
                "senses": [
                    {
                        "sense_id": "4aae56cf-74a5-3cfb-9d52-58d1825a452d",
                        "entry_id": "621411b8-22e2-3b5a-8c30-b4275a3bb567",
                        "glosses": [
                            "Person, die ein Unternehmen von einem Verstorbenem erbt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f26ea24-36e3-43f3-8bfc-80c93edf7e71",
                                "sense_id": "4aae56cf-74a5-3cfb-9d52-58d1825a452d",
                                "text": "„1989, als die Firmenerben verkaufen wollten, wurde Heinz Thiele Alleineigentümer, wobei er die Übernahme durch Kredite finanzierte.“"
                            },
                            {
                                "example_id": "e126271f-4ca9-4d16-8481-c48234e499e5",
                                "sense_id": "4aae56cf-74a5-3cfb-9d52-58d1825a452d",
                                "text": "„Nach seinem Tod übertrug seine Witwe Friedel Schopf 1935 die Generalvollmacht über die Eduscho Kaffeerösterei und die Vormundschaft über den damals sechsjährigen Firmenerben Rolf Schopf auf seinen Geschäftspartner Bernhard Rothfos.“"
                            },
                            {
                                "example_id": "fd714059-8994-4414-9bdb-0cc73a8860a1",
                                "sense_id": "4aae56cf-74a5-3cfb-9d52-58d1825a452d",
                                "text": "„Wie wächst man eigentlich als Junior, als Firmenerbe auf?“"
                            },
                            {
                                "example_id": "f9343173-737b-432d-8fd2-f4a59d127c17",
                                "sense_id": "4aae56cf-74a5-3cfb-9d52-58d1825a452d",
                                "text": "„Alfried traf es am härtesten: Er wurde mit besonderer Strenge auf seine Rolle als Firmenerbe vorbereitet.“"
                            },
                            {
                                "example_id": "560c44fb-f95c-4002-951b-771d36f450ad",
                                "sense_id": "4aae56cf-74a5-3cfb-9d52-58d1825a452d",
                                "text": "„Hanno ist von seinem Vater nicht als Firmenerbe bestimmt worden.“"
                            },
                            {
                                "example_id": "dafbc983-b6b6-4372-8e34-6fa66db88396",
                                "sense_id": "4aae56cf-74a5-3cfb-9d52-58d1825a452d",
                                "text": "„Zuerst stirbt Erich, der Lieblingssohn von Emil Rathenau, praktisch begabt, aber von schwacher Gesundheit - und eigentlich als Firmenerbe vorgesehen.“"
                            },
                            {
                                "example_id": "bc1e3cbc-3a25-4e20-91cc-448ab5907678",
                                "sense_id": "4aae56cf-74a5-3cfb-9d52-58d1825a452d",
                                "text": "„Der Vater findet sich damit ab, dass sein Erstgeborener nicht Kaufmann und damit auch nicht der Firmenerbe werden wird.“"
                            },
                            {
                                "example_id": "e9b7ab4b-9d6f-4df5-877a-e0672adabcf3",
                                "sense_id": "4aae56cf-74a5-3cfb-9d52-58d1825a452d",
                                "text": "„Im Jahr“ […] „1970 übernimmt der Firmenerbe Michael Wirtz die Leitung von Grünenthal.“"
                            },
                            {
                                "example_id": "5662b90f-ddfa-4545-9600-b4f2e5e433fb",
                                "sense_id": "4aae56cf-74a5-3cfb-9d52-58d1825a452d",
                                "text": "„Evan Adams, der reiche Firmenerbe, macht Gladys zunehmend den Hof.“"
                            },
                            {
                                "example_id": "5f625c69-4eca-4a11-91e8-e53ee3a50881",
                                "sense_id": "4aae56cf-74a5-3cfb-9d52-58d1825a452d",
                                "text": "[Erbschaftssteuer:] „Heraus kam indes eine Steuerreform, bei der Firmenerben ihr Betriebsvermögen nach zehn Jahren steuerfrei versilbern können.“"
                            },
                            {
                                "example_id": "fa18a230-33e0-4723-b361-225d7e08a138",
                                "sense_id": "4aae56cf-74a5-3cfb-9d52-58d1825a452d",
                                "text": "[Erbschaftsteuergesetz:] „Görke: »Durch das Verhalten von Bayern droht eine Privilegierung von bayerischen Firmenerben, die nicht akzeptabel ist.“ […]«"
                            },
                            {
                                "example_id": "5fe55f08-eae7-4d99-8022-78eb208cf6dd",
                                "sense_id": "4aae56cf-74a5-3cfb-9d52-58d1825a452d",
                                "text": "„Dem Staat fehlt Geld, etwa für eine Kindergrundsicherung. SPD-Politiker wollen Ausnahmen für Firmenerben streichen – die größte Steuersubvention.“"
                            },
                            {
                                "example_id": "5062680c-70d7-4d67-8fdc-ef471b65b406",
                                "sense_id": "4aae56cf-74a5-3cfb-9d52-58d1825a452d",
                                "text": "„Firmenerben müssen in Zukunft genauso behandelt werden wie die Erben anderer beträchtlicher Vermögenswerte.“"
                            },
                            {
                                "example_id": "70a536a8-1ceb-4435-8e1a-997d0bf216e9",
                                "sense_id": "4aae56cf-74a5-3cfb-9d52-58d1825a452d",
                                "text": "„Begründet wird die Begünstigung von Firmenerben üblicherweise damit, dass wegen deren Steuerbelastung die Insolvenz von Betrieben und der Verlust von Arbeitsplätzen drohe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
