{
    "word_family": [
        "magnet",
        "magnetism",
        "magnetize",
        "magnetization",
        "magnetically"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dc339b8b-b284-345f-b6e9-66034f88a8f1",
                    "sense_definition": "Having the properties of a magnet, especially the ability to attract iron or steel.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The refrigerator door stays closed because of a <w>magnetic</w> strip.",
                            "target_lang_translations": {
                                "ru": "Дверца холодильника остается закрытой благодаря <w>магнитной</w> ленте.",
                                "zh": "冰箱门能保持关闭是因为有一条<w>磁性</w>封条。"
                            }
                        },
                        {
                            "text": "Iron is a <w>magnetic</w> material that sticks to magnets.",
                            "target_lang_translations": {
                                "ru": "Железо — это <w>магнитный</w> материал, который прилипает к магнитам.",
                                "zh": "铁是一种能吸附在磁铁上的<w>磁性</w>材料。"
                            }
                        }
                    ],
                    "synonyms": [
                        "magnetized"
                    ],
                    "antonyms": [
                        "non-magnetic",
                        "nonmagnetic"
                    ],
                    "common_phrases": [
                        "magnetic strip",
                        "magnetic material",
                        "magnetic force"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий свойствами магнита, особенно способностью притягивать железо или сталь",
                        "zh": "具有磁铁的特性，特别是吸引铁或钢的能力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "магнитный",
                                "target_lang_sense_clarification": "обладающий свойствами магнита"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "磁性的",
                                "target_lang_sense_clarification": "具有磁铁的物理特性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "443bb025-e1dd-34a3-9cb8-0230b7b280a8",
                    "sense_definition": "Of, relating to, operating by, or caused by magnetism.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The earth is surrounded by a strong <w>magnetic</w> field that protects us from radiation.",
                            "target_lang_translations": {
                                "ru": "Земля окружена сильным <w>магнитным</w> полем, которое защищает нас от радиации.",
                                "zh": "地球被一层强大的<w>磁</w>场包围，保护我们免受辐射伤害。"
                            }
                        },
                        {
                            "text": "Old cassette players used <w>magnetic</w> tape to record music.",
                            "target_lang_translations": {
                                "ru": "Старые кассетные плееры использовали <w>магнитную</w> ленту для записи музыки.",
                                "zh": "旧式卡带播放器使用<w>磁</w>带录制音乐。"
                            }
                        }
                    ],
                    "antonyms": [
                        "antimagnetic"
                    ],
                    "common_phrases": [
                        "magnetic field",
                        "magnetic tape",
                        "magnetic resonance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к магнетизму, действующий посредством него или вызванный им",
                        "zh": "与磁性有关、由磁性引起或通过磁性运作的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "магнитный",
                                "target_lang_sense_clarification": "относящийся к физическому явлению"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "磁性的",
                                "target_lang_sense_clarification": "与磁现象或磁场相关"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b473d11-d09f-3e9c-af19-526cf7ae5f3b",
                    "sense_definition": "Having an extraordinary ability to attract interest, affection, or admiration.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has a <w>magnetic</w> personality that draws people to him wherever he goes.",
                            "target_lang_translations": {
                                "ru": "У него <w>магнетическая</w> личность, которая притягивает к нему людей, куда бы он ни пошел.",
                                "zh": "他有着一种<w>富有魅力</w>的个性，无论走到哪里都能吸引人们靠近。"
                            }
                        },
                        {
                            "text": "The speaker's <w>magnetic</w> charm held the audience's attention for hours.",
                            "target_lang_translations": {
                                "ru": "<w>Магнетическое</w> обаяние оратора удерживало внимание аудитории часами.",
                                "zh": "演讲者那<w>极具吸引力</w>的魅力让听众聚精会神地听了几个小时。"
                            }
                        }
                    ],
                    "synonyms": [
                        "charismatic",
                        "captivating",
                        "alluring",
                        "fascinating",
                        "charming",
                        "enchanting",
                        "inviting",
                        "seductive"
                    ],
                    "antonyms": [
                        "repulsive"
                    ],
                    "common_phrases": [
                        "magnetic personality",
                        "magnetic charm",
                        "magnetic attraction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий необычайной способностью вызывать интерес, привязанность или восхищение",
                        "zh": "具有非凡的吸引力，能引起他人的兴趣、喜爱或钦佩。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "магнетический",
                                "target_lang_sense_clarification": "необычайно притягательный, гипнотический"
                            },
                            {
                                "target_lang_word": "притягательный",
                                "target_lang_sense_clarification": "очаровывающий, привлекательный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有吸引力的",
                                "target_lang_sense_clarification": "形容人具有魅力"
                            },
                            {
                                "target_lang_word": "富有魅力的",
                                "target_lang_sense_clarification": "形容人极具感染力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ab5e4af-421c-347b-8375-a726ba0dbcfe",
                    "sense_definition": "Determined by the earth's magnetic fields rather than geographic coordinates.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hikers should know that a compass points to <w>magnetic</w> north, not true north.",
                            "target_lang_translations": {
                                "ru": "Туристы должны знать, что компас указывает на <w>магнитный</w> север, а не на истинный.",
                                "zh": "徒步旅行者应该知道指南针指向的是<w>磁</w>北，而不是真北。"
                            }
                        },
                        {
                            "text": "The pilot adjusted the flight path to account for the <w>magnetic</w> pole.",
                            "target_lang_translations": {
                                "ru": "Пилот скорректировал траекторию полета с учетом <w>магнитного</w> полюса.",
                                "zh": "飞行员调整了航线以应对<w>磁</w>极的影响。"
                            }
                        }
                    ],
                    "antonyms": [
                        "geographic"
                    ],
                    "common_phrases": [
                        "magnetic north",
                        "magnetic pole"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определяемый магнитными полями Земли, а не географическими координатами",
                        "zh": "由地球磁场决定，而非地理坐标。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "магнитный",
                                "target_lang_sense_clarification": "связанный с магнитным полем Земли"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "磁的",
                                "target_lang_sense_clarification": "与地磁场相关"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}