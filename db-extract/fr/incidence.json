                                "target_senses": [
                                    {
                                        "sense_id": "f5360c28-ee14-3957-959c-e5feb3de234b",
                                        "entry_id": "3708e67a-155e-35d3-9e4a-2978647754bb",
                                        "glosses": [
                                            "poslední fáze pádu, kdy se padající těleso dotkne povrchu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2acc06b9-c692-4ef9-864a-865780ab21b2",
                                                "sense_id": "f5360c28-ee14-3957-959c-e5feb3de234b",
                                                "text": "Dopad pouzdra se vzorky byl velmi tvrdý."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0da9a7c3-eac3-3ee6-b0d7-6c1ae7d45cb0",
                                        "entry_id": "3708e67a-155e-35d3-9e4a-2978647754bb",
                                        "glosses": [
                                            "následek vyvolaný nějakou příčinou"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d28da680-8e7a-4ae1-baf9-f0e39ae2e62a",
                                                "sense_id": "0da9a7c3-eac3-3ee6-b0d7-6c1ae7d45cb0",
                                                "text": "Prognóza předpokládá, že toto opatření bude mít velmi negativní dopady na celé odvětví."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
