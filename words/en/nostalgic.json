{
    "word_family": [
        "nostalgia"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bb2bdb40-f83d-3e0c-9f0b-1c0e2241c3ca",
                    "sense_definition": "Feeling a sentimental longing or wistful affection for the past.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old music made him feel <w>nostalgic</w> for his childhood days.",
                            "target_lang_translations": {
                                "zh": "那段老音乐让他对童年时光感到<w>怀旧</w>。"
                            }
                        },
                        {
                            "text": "She felt a <w>nostalgic</w> ache when she looked at the old family photos.",
                            "target_lang_translations": {
                                "zh": "看着那些旧家庭照片，她心中泛起一阵<w>怀旧的</w>酸楚。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "nostalgic feeling",
                        "nostalgic mood"
                    ],
                    "target_lang_definitions": {
                        "zh": "对过去产生怀念、留恋或伤感的情绪。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "怀旧的",
                                "target_lang_sense_clarification": "形容对过去的事物感到怀念的。"
                            },
                            {
                                "target_lang_word": "怀念的",
                                "target_lang_sense_clarification": "形容对往事或故人有深切的思念。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e5817ae9-d2c4-362c-a611-a90971618a26",
                    "sense_definition": "A person who feels or displays nostalgia.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum exhibit was designed specifically for <w>nostalgics</w> who miss the 1980s.",
                            "target_lang_translations": {
                                "zh": "这个博物馆展览是专门为那些怀念20世纪80年代的<w>怀旧者</w>设计的。"
                            }
                        },
                        {
                            "text": "Many <w>nostalgics</w> gather online to discuss classic films from their youth.",
                            "target_lang_translations": {
                                "zh": "许多<w>怀旧者</w>在网上聚在一起，讨论他们年轻时的经典电影。"
                            }
                        }
                    ],
                    "synonyms": [
                        "nostalgist"
                    ],
                    "target_lang_definitions": {
                        "zh": "怀旧的人，指经常沉浸在对过去回忆中的人。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "怀旧者",
                                "target_lang_sense_clarification": "指代那些喜欢怀念过去的人。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}