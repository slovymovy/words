                "senses": [
                    {
                        "sense_id": "cc3fa617-e030-3531-b185-3be4c213cdaa",
                        "entry_id": "80802256-44e7-352f-b3c8-78567dc41554",
                        "glosses": [
                            "aus Saarbrücken stammend, kommend, zu Saarbrücken gehörig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b16d8906-9320-4c39-9df4-bb6a5128fce9",
                                "sense_id": "cc3fa617-e030-3531-b185-3be4c213cdaa",
                                "text": "Mir gefällt die Saarbrücker Innenstadt."
                            },
                            {
                                "example_id": "091d1e7e-2545-4c53-9894-9b07d4ac6632",
                                "sense_id": "cc3fa617-e030-3531-b185-3be4c213cdaa",
                                "text": "So soll die Burg Dagstuhl einst durch einen Saarbrücker Ritter namens Boemund erbaut worden sein, der hier rastete und einschlummerte."
                            },
                            {
                                "example_id": "66b02a89-1de1-425a-999a-5c7be9e759a8",
                                "sense_id": "cc3fa617-e030-3531-b185-3be4c213cdaa",
                                "text": "Viel lieber wollte sie die Gunst des schönen Wetters nutzen und zusammen mit Robert in der Saarbrücker Altstadt auf ein Bier einkehren."
                            },
                            {
                                "example_id": "429ec127-ffcd-452f-af96-bec4e0a4fbc0",
                                "sense_id": "cc3fa617-e030-3531-b185-3be4c213cdaa",
                                "text": "Am 30. November 1815 erfolgte durch einen offiziellen Festakt der preußischen Regierung in der Saarbrücker Ludwigskirche die feierliche Besitzergreifung Saarbrückens und der übrigen Saarorte durch den königlich-preußischen Kommissarius Mathias Simon im Auftrag König Friedrich Wilhelms III."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
