                    "frequency": "Middle",
                    "semantic_group_id": "Einzelwesen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jeder Mensch ist ein einzigartiges <w>Individuum</w> mit eigenen Wünschen und Vorstellungen vom Leben."
                        },
                        {
                            "text": "In einer freien Gesellschaft müssen die Rechte des <w>Individuums</w> stets geachtet werden."
                        }
                    ],
