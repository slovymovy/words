                        "examples": [
                            {
                                "example_id": "d5c29baa-d50f-465e-9d3e-1c55c24c89ce",
                                "sense_id": "f3096cc7-f738-3f43-93a4-4d89f0f1ad67",
                                "text": "I loathe the snails, but from loathing to actual butchery, trucidation of multitudes, there is still a step that I hesitate to take."
                            },
                            {
                                "example_id": "80159786-5938-4c96-85e9-3979fe9cfe8c",
                                "sense_id": "f3096cc7-f738-3f43-93a4-4d89f0f1ad67",
                                "text": "Gillet: They hate me as much as I hate them. And that's saying a good deal. Girdlestone may deal with Walker's … trucidations of a dead and revered language. I shall begin to live!"
                            },
                            {
                                "example_id": "fd9e583e-f53c-4da4-9cd2-6c6f950319e8",
                                "sense_id": "f3096cc7-f738-3f43-93a4-4d89f0f1ad67",
                                "text": "Labour, which had started the disasters of Cyprus by denying it any decolonisation after 1945, had now completed them, abandoning it to trucidation."
                            }
                        ]
                    }
