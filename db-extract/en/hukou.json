                        "examples": [
                            {
                                "example_id": "04e176c7-b33e-4828-93d8-28487a020882",
                                "sense_id": "31a4a890-b1f3-3ac2-b981-cc18b4ae6a46",
                                "text": "Taxis arrive to pick up passengers cleared to leave the centralized quarantine facility in Hukou township in Hsinchu county in Northern Taiwan on Monday, Aug. 31, 2020."
                            },
                            {
                                "example_id": "d0241633-dac6-4cf7-bd1e-7c86eab8d8f8",
                                "sense_id": "31a4a890-b1f3-3ac2-b981-cc18b4ae6a46",
                                "text": "Police tracked down a 32-year-old wanted man, surnamed Dang (鄧), to a dormitory in Hsinchu County's Hukou Township, reported TVBS."
                            },
                            {
                                "example_id": "1e0722be-8b1f-4881-b20b-f5a2f61c24f1",
                                "sense_id": "31a4a890-b1f3-3ac2-b981-cc18b4ae6a46",
                                "text": "According to the MNA, the Taipei-based 202nd Military Police Command's Quick Response Company will showcase its new Indian Challenger motorcycles at the Sept. 24 opening of the army base in Hukou Township, Hsinchu County."
                            }
                        ]
                    }
