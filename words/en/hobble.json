{
    "word_family": [
        "hobbler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5e98b2e7-5d01-3135-ae5b-b0dc92058a80",
                    "sense_definition": "To walk with a limp or in an awkward, uneven way, typically due to injury or pain.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After twisting his ankle during the game, he had to <w>hobble</w> off the field with help.",
                            "target_lang_translations": {
                                "ru": "Подвернув лодыжку во время игры, ему пришлось с посторонней помощью <w>ковылять</w> с поля."
                            }
                        },
                        {
                            "text": "The old man began to <w>hobble</w> painfully toward the door using his wooden cane.",
                            "target_lang_translations": {
                                "ru": "Старик, превозмогая боль, начал <w>ковылять</w> к двери, опираясь на свою деревянную трость."
                            }
                        }
                    ],
                    "synonyms": [
                        "hirple"
                    ],
                    "antonyms": [
                        "stride",
                        "run"
                    ],
                    "common_phrases": [
                        "hobble painfully",
                        "hobble along"
                    ],
                    "target_lang_definitions": {
                        "ru": "Идти прихрамывая или неуклюже, обычно из-за травмы или боли."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ковылять",
                                "target_lang_sense_clarification": "идти медленно и с трудом"
                            },
                            {
                                "target_lang_word": "прихрамывать",
                                "target_lang_sense_clarification": "слегка хромать"
                            },
                            {
                                "target_lang_word": "хромать",
                                "target_lang_sense_clarification": "припадать на ногу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f270efc-2737-312f-aacf-1198b3c03208",
                    "sense_definition": "To restrict the progress or development of something; to hamper or hinder.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "New government regulations could <w>hobble</w> the growth of small businesses in this sector.",
                            "target_lang_translations": {
                                "ru": "Новые правительственные постановления могут <w>сковать</w> рост малого бизнеса в этом секторе."
                            }
                        },
                        {
                            "text": "The team's efforts were <w>hobbled</w> by a lack of funding and poor management.",
                            "target_lang_translations": {
                                "ru": "Усилия команды были <w>парализованы</w> нехваткой финансирования и плохим управлением."
                            }
                        }
                    ],
                    "synonyms": [
                        "hirple"
                    ],
                    "antonyms": [
                        "assist",
                        "facilitate",
                        "encourage"
                    ],
                    "common_phrases": [
                        "hobble the economy",
                        "severely hobbled"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ограничивать прогресс или развитие чего-либо; мешать или препятствовать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сковывать",
                                "target_lang_sense_clarification": "ограничивать развитие или действия"
                            },
                            {
                                "target_lang_word": "тормозить",
                                "target_lang_sense_clarification": "замедлять процесс"
                            },
                            {
                                "target_lang_word": "препятствовать",
                                "target_lang_sense_clarification": "создавать помехи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a109e6fd-6266-3b3c-9b3b-9c6d8acef168",
                    "sense_definition": "To tie the legs of a horse or other animal together to prevent it from straying.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "animal_restraint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rider decided to <w>hobble</w> his horse before setting up camp for the night.",
                            "target_lang_translations": {
                                "ru": "Всадник решил <w>спутать</w> лошадь перед тем, как разбивать лагерь на ночь."
                            }
                        },
                        {
                            "text": "It is common practice to <w>hobble</w> livestock in open pastures without fences.",
                            "target_lang_translations": {
                                "ru": "На открытых пастбищах без ограждений принято <w>треножить</w> скот."
                            }
                        }
                    ],
                    "synonyms": [
                        "tether"
                    ],
                    "antonyms": [
                        "unleash",
                        "free"
                    ],
                    "common_phrases": [
                        "hobble a horse"
                    ],
                    "target_lang_definitions": {
                        "ru": "Связывать ноги лошади или другого животного, чтобы оно не убежало."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "треножить",
                                "target_lang_sense_clarification": "связывать ноги животному"
                            },
                            {
                                "target_lang_word": "путать",
                                "target_lang_sense_clarification": "надевать путы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11d71633-94d2-3a3a-b023-3f7eff825598",
                    "sense_definition": "To move or proceed in an irregular, rough, or uneven manner, often referring to rhythm or flow.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poem's rhythm seemed to <w>hobble</w> along due to the inconsistent meter.",
                            "target_lang_translations": {
                                "ru": "Ритм стихотворения казался <w>хромающим</w> из-за непоследовательного размера."
                            }
                        },
                        {
                            "text": "The narrative began to <w>hobble</w> as the author introduced too many unnecessary subplots.",
                            "target_lang_translations": {
                                "ru": "Повествование начало <w>спотыкаться</w>, когда автор ввел слишком много ненужных побочных сюжетов."
                            }
                        }
                    ],
                    "antonyms": [
                        "flow"
                    ],
                    "common_phrases": [
                        "hobbling rhythm"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in literary criticism"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться или развиваться неровно, прерывисто (о ритме или повествовании)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хромать",
                                "target_lang_sense_clarification": "о ритме или стиле"
                            },
                            {
                                "target_lang_word": "быть неровным",
                                "target_lang_sense_clarification": "о слоге или течении"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e3d567c8-b863-3545-a38b-6591e77cb80e",
                    "sense_definition": "An uneven or unsteady way of walking.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She walked with a slight <w>hobble</w> for several weeks after the surgery.",
                            "target_lang_translations": {
                                "ru": "В течение нескольких недель после операции она ходила с легким <w>прихрамыванием</w>."
                            }
                        },
                        {
                            "text": "The detective noticed the suspect had a distinctive <w>hobble</w> in his step.",
                            "target_lang_translations": {
                                "ru": "Детектив заметил, что у подозреваемого была характерная <w>хромота</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "tether"
                    ],
                    "common_phrases": [
                        "distinctive hobble",
                        "slight hobble"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неровная или неуверенная походка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ковыляние",
                                "target_lang_sense_clarification": "неуклюжая ходьба"
                            },
                            {
                                "target_lang_word": "хромота",
                                "target_lang_sense_clarification": "дефект походки"
                            },
                            {
                                "target_lang_word": "прихрамывание",
                                "target_lang_sense_clarification": "легкая хромота"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6bc90928-0f3b-35f3-a27c-55bd3dd0fb5f",
                    "sense_definition": "A strap or rope used to tie an animal's legs together to restrict movement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "animal_restraint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cowboy reached for a leather <w>hobble</w> to secure the pony near the stream.",
                            "target_lang_translations": {
                                "ru": "Ковбой потянулся за кожаными <w>путами</w>, чтобы закрепить пони у ручья."
                            }
                        },
                        {
                            "text": "Make sure the <w>hobble</w> is not too tight to avoid injuring the animal's skin.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что <w>путы</w> не слишком тугие, чтобы не повредить кожу животного."
                            }
                        }
                    ],
                    "synonyms": [
                        "tether"
                    ],
                    "common_phrases": [
                        "leather hobble"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ремень или веревка, используемая для связывания ног животного."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "путы",
                                "target_lang_sense_clarification": "веревки для ног"
                            },
                            {
                                "target_lang_word": "тренога",
                                "target_lang_sense_clarification": "вид пут для лошадей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c31d02da-d1af-313f-840e-6ea9db2ad706",
                    "sense_definition": "A difficult or embarrassing situation; a predicament.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "difficulty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He found himself in quite a <w>hobble</w> after losing his passport in a foreign country.",
                            "target_lang_translations": {
                                "ru": "Он оказался в довольно <w>затруднительном положении</w>, потеряв паспорт в чужой стране."
                            }
                        },
                        {
                            "text": "It took a lot of clever thinking to get the family out of that financial <w>hobble</w>.",
                            "target_lang_translations": {
                                "ru": "Потребовалось немало смекалки, чтобы вытащить семью из этой финансовой <w>передряги</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "in a hobble"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "less common in modern usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Трудная или неловкая ситуация; затруднительное положение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затруднение",
                                "target_lang_sense_clarification": "сложная ситуация"
                            },
                            {
                                "target_lang_word": "неловкое положение",
                                "target_lang_sense_clarification": "предикамент"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f50f3f35-585a-3df0-b7c0-ef0b8fd694d7",
                    "sense_definition": "A casual or irregular piece of work; an odd job.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He earned a bit of extra cash by doing a quick <w>hobble</w> for the neighbor.",
                            "target_lang_translations": {
                                "ru": "Он заработал немного лишних денег, выполнив небольшую <w>подработку</w> для соседа."
                            }
                        },
                        {
                            "text": "The handyman was always looking for a small <w>hobble</w> to fill his weekends.",
                            "target_lang_translations": {
                                "ru": "Мастер на все руки всегда искал какую-нибудь мелкую <w>халтуру</w>, чтобы занять свои выходные."
                            }
                        }
                    ],
                    "common_phrases": [
                        "odd hobble"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "primarily British regional usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Случайная или нерегулярная работа; подработка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подработка",
                                "target_lang_sense_clarification": "небольшое задание"
                            },
                            {
                                "target_lang_word": "халтура",
                                "target_lang_sense_clarification": "разг. мелкая работа"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}