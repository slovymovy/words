{
    "word_family": [
        "tufted",
        "tufty"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0aa073d8-54dd-3ca7-9202-9eb7e704488b",
                    "sense_definition": "A small bunch of feathers, grass, or hair held together at the base.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bunch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bird had a small <w>tuft</w> of bright feathers on its head.",
                            "target_lang_translations": {
                                "cs": "Pták měl na hlavě malou <w>chocholku</w> jasných per."
                            }
                        },
                        {
                            "text": "She pulled a <w>tuft</w> of grass from the ground.",
                            "target_lang_translations": {
                                "cs": "Vytáhla ze země <w>trs</w> trávy."
                            }
                        }
                    ],
                    "synonyms": [
                        "bunch",
                        "clump",
                        "cluster"
                    ],
                    "common_phrases": [
                        "tuft of grass",
                        "tuft of hair"
                    ],
                    "target_lang_definitions": {
                        "cs": "Malý svazek peří, trávy nebo vlasů držený pohromadě u základny."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "chomáč",
                                "target_lang_sense_clarification": "obecné označení pro shluk vláken, vlasů nebo peří"
                            },
                            {
                                "target_lang_word": "trs",
                                "target_lang_sense_clarification": "používá se zejména pro trávu nebo rostliny rostoucí v hustých skupinách"
                            },
                            {
                                "target_lang_word": "chocholka",
                                "target_lang_sense_clarification": "používá se specificky pro peří na hlavě ptáků"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf6c9e4c-d172-3577-b5a3-b0ea61e2d749",
                    "sense_definition": "A small clump of trees or bushes.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bunch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We rested in the shade of a small <w>tuft</w> of trees.",
                            "target_lang_translations": {
                                "cs": "Odpočívali jsme ve stínu malého <w>shluku</w> stromů."
                            }
                        },
                        {
                            "text": "A thick <w>tuft</w> of bushes hid the entrance to the cave.",
                            "target_lang_translations": {
                                "cs": "Hustý <w>shluk</w> keřů zakrýval vchod do jeskyně."
                            }
                        }
                    ],
                    "synonyms": [
                        "clump",
                        "thicket"
                    ],
                    "target_lang_definitions": {
                        "cs": "Malá skupina stromů nebo keřů."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "shluk",
                                "target_lang_sense_clarification": "skupina věcí nebo rostlin blízko u sebe"
                            },
                            {
                                "target_lang_word": "skupinka",
                                "target_lang_sense_clarification": "malý počet stromů nebo keřů rostoucích pohromadě"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad1febca-609d-35a9-858c-348943442e4e",
                    "sense_definition": "A cluster of threads drawn through a mattress or quilt to secure the padding.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mattress was held together by a decorative <w>tuft</w>.",
                            "target_lang_translations": {
                                "cs": "Matrace byla držena pohromadě ozdobným <w>prošitím</w>."
                            }
                        },
                        {
                            "text": "The quilt had a <w>tuft</w> in the center to keep the filling in place.",
                            "target_lang_translations": {
                                "cs": "Deka měla uprostřed <w>prošití</w>, aby výplň držela na místě."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Svazek nití protažený matrací nebo prošívanou dekou pro upevnění výplně."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "prošití",
                                "target_lang_sense_clarification": "technika upevnění výplně matrace nebo deky"
                            },
                            {
                                "target_lang_word": "všívaný knoflík",
                                "target_lang_sense_clarification": "ozdobný prvek, který drží výplň matrace"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4fa7a8e8-0317-353c-8809-7d9dcb67c35a",
                    "sense_definition": "A gold tassel on a cap worn by titled students at certain English universities.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student wore a cap with a gold <w>tuft</w> to show his status.",
                            "target_lang_translations": {
                                "cs": "Student měl na čepici zlatý <w>střapec</w>, aby ukázal své postavení."
                            }
                        },
                        {
                            "text": "Only the noble students were allowed to wear the <w>tuft</w> on their caps.",
                            "target_lang_translations": {
                                "cs": "Pouze šlechtičtí studenti směli nosit na čepicích <w>střapec</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "tassel"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to historical university customs."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Zlatý střapec na čepici nošené studenty šlechtického původu na některých anglických univerzitách."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "střapec",
                                "target_lang_sense_clarification": "ozdobný prvek na pokrývce hlavy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "862e3000-f12c-304e-b20f-fbaa42ed04d5",
                    "sense_definition": "A person entitled to wear a gold tassel on their university cap.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wealthy <w>tuft</w> was often treated differently by the other students.",
                            "target_lang_translations": {
                                "cs": "S bohatým <w>studentem se zlatým střapcem</w> ostatní studenti často zacházeli jinak."
                            }
                        },
                        {
                            "text": "He was known as a <w>tuft</w> because of his noble family background.",
                            "target_lang_translations": {
                                "cs": "Byl známý jako <w>student se zlatým střapcem</w> kvůli svému šlechtickému původu."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Historical term for a specific class of student."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Historický termín pro studenta šlechtického původu na anglické univerzitě, který měl právo nosit zlatý střapec."
                    },
                    "translations": {
                        "cs": []
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "16e3c6c6-bbfd-300c-96a5-0e0f5bd90f1a",
                    "sense_definition": "To decorate or provide with a tuft or tufts.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The designer decided to <w>tuft</w> the cushions for a more elegant look.",
                            "target_lang_translations": {
                                "cs": "Návrhář se rozhodl <w>opatřit</w> polštáře <w>střapci</w> pro elegantnější vzhled."
                            }
                        },
                        {
                            "text": "They <w>tufted</w> the fabric to create a textured pattern.",
                            "target_lang_translations": {
                                "cs": "Látku <w>prošili</w>, aby vytvořili texturovaný vzor."
                            }
                        }
                    ],
                    "synonyms": [
                        "adorn",
                        "decorate"
                    ],
                    "target_lang_definitions": {
                        "cs": "Ozdobit nebo opatřit střapci či chomáčky."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "opatřit střapci",
                                "target_lang_sense_clarification": "přidat ozdobné střapce"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3479a2a9-8eef-3974-b874-f525740db169",
                    "sense_definition": "To secure and strengthen a mattress or quilt with tufts to keep the stuffing in place.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is important to <w>tuft</w> the mattress so the filling does not shift.",
                            "target_lang_translations": {
                                "cs": "Je důležité matraci <w>prošít</w>, aby se výplň neposouvala."
                            }
                        },
                        {
                            "text": "The worker began to <w>tuft</w> the heavy quilt by hand.",
                            "target_lang_translations": {
                                "cs": "Dělník začal těžkou deku <w>prošívat</w> ručně."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Zajistit a zpevnit matraci nebo deku prošitím, aby výplň zůstala na místě."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "prošít",
                                "target_lang_sense_clarification": "technika upevnění výplně matrace"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4fd58b59-c04c-378d-bc31-235f9a2a42f4",
                    "sense_definition": "To form into tufts.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wool began to <w>tuft</w> after many years of heavy use.",
                            "target_lang_translations": {
                                "cs": "Vlna začala po mnoha letech intenzivního používání <w>žmolkovatět</w>."
                            }
                        },
                        {
                            "text": "The fibers will <w>tuft</w> if you wash them in hot water.",
                            "target_lang_translations": {
                                "cs": "Vlákna začnou <w>žmolkovatět</w>, pokud je vyperete v horké vodě."
                            }
                        }
                    ],
                    "synonyms": [
                        "clump"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vytvářet chomáčky nebo shluky."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "žmolkovatět",
                                "target_lang_sense_clarification": "tvorba malých chomáčků vláken na látce"
                            },
                            {
                                "target_lang_word": "shlukovat se",
                                "target_lang_sense_clarification": "tvorba shluků"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47516777-104b-3d11-aa8f-9750c8522567",
                    "sense_definition": "To be formed into tufts.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old carpet started to <w>tuft</w> in the high-traffic areas.",
                            "target_lang_translations": {
                                "cs": "Starý koberec začal v místech s vysokým provozem <w>žmolkovatět</w>."
                            }
                        },
                        {
                            "text": "The fabric will <w>tuft</w> if it is not handled with care.",
                            "target_lang_translations": {
                                "cs": "Látka začne <w>žmolkovatět</w>, pokud s ní nebudete zacházet opatrně."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Být formován do chomáčků."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "žmolkovatět",
                                "target_lang_sense_clarification": "tvorba žmolků na povrchu materiálu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "6a8f96fd-40a8-3f47-9a8c-75ecfa6ab6f7",
                    "sense_definition": "A surname.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "no",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Tuft</w> is our new neighbor.",
                            "target_lang_translations": {
                                "cs": "Pan <w>Tuft</w> je náš nový soused."
                            }
                        },
                        {
                            "text": "The research was conducted by Dr. <w>Tuft</w>.",
                            "target_lang_translations": {
                                "cs": "Výzkum vedl Dr. <w>Tuft</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Příjmení."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "Tuft",
                                "target_lang_sense_clarification": "příjmení"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}