                "senses": [
                    {
                        "sense_id": "7a4ce9ef-194e-3ca0-a921-15c14316f3d1",
                        "entry_id": "0dfa3c12-32ef-37ef-b3c5-7d16d425cd96",
                        "glosses": [
                            "однокр. к давить"
