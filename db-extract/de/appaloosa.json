                "senses": [
                    {
                        "sense_id": "ebeb18bf-36cd-32d3-8609-1c8563199912",
                        "entry_id": "652cb9d1-f890-3819-8567-69c80adac61f",
                        "glosses": [
                            "eine Pferderasse mit geschecktem Fell und marmorierter Haut, die von den Nez Percé entwickelt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14b21f1b-e3be-4330-bd24-90915152f1a1",
                                "sense_id": "ebeb18bf-36cd-32d3-8609-1c8563199912",
                                "text": "Die Crème de la Crème sind, auf alle Fälle aussehensmäßig, die Appaloosas. Sie stammen aus der Zucht der Nec-Perece-Indianer."
                            },
                            {
                                "example_id": "dc6e0bfb-9332-4941-a6a0-c46db8c85e64",
                                "sense_id": "ebeb18bf-36cd-32d3-8609-1c8563199912",
                                "text": "Pferderassen mit getupftem Fell wie etwa die Appaloosas haben gestreifte Hufe."
                            },
                            {
                                "example_id": "a4138217-99b8-4730-bc2f-e8f20397b67c",
                                "sense_id": "ebeb18bf-36cd-32d3-8609-1c8563199912",
                                "text": "Plötzlich warf der Appaloosa den Kopf nach hinten, wieherte laut und lief Corinna entgegen, als habe er eine alte Bekannte wiedergetroffen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
