                                                "example_id": "bc4a6394-0bda-41d3-9b7d-41837ea30041",
                                                "sense_id": "f755915d-fc31-3cc3-abe1-7c2370848018",
                                                "text": "„Er jagte die Mannschaft in die Takelage, befahl Segel zu setzen, in den Wind zu drehen und die auffrischende Brise auszunutzen.“"
                                            },
                                            {
                                                "example_id": "c1545ba4-94de-45e9-b574-4c745fadf9d8",
                                                "sense_id": "f755915d-fc31-3cc3-abe1-7c2370848018",
                                                "text": "„Einige Schoner kämpften sich in der frischen Brise die Bucht entlang, und ein köstlicher Salzgeschmack lag in der Luft.“"
                                            },
                                            {
                                                "example_id": "2831c449-341c-4066-91f6-ae1071797124",
                                                "sense_id": "f755915d-fc31-3cc3-abe1-7c2370848018",
                                                "text": "„Die Brise spielte mit dem Kragen seines weißen Hemds und blies ihm die Kravatte unter den erhobenen Arm.“"
                                            },
                                            {
                                                "example_id": "35e22931-f303-46cd-b2bd-d365e531caad",
                                                "sense_id": "f755915d-fc31-3cc3-abe1-7c2370848018",
                                                "text": "„Als wir uns vom Tisch erhoben, schickte ich Felipe fort, und wir setzten uns auf den Balkon, um Don Diego zu erwarten und die leichte, bei der Hitze höchst angenehme Brise zu genießen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f657fda-6469-4548-bfdc-6fd22514cffd",
                        "source_entry_id": "f4dfde30-227e-3293-a385-7b82438fa42b",
                        "source_sense_id": "c42f91e7-ecb7-3811-affb-583ee1f4409d",
                        "target_lang_word": "bryza",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bryza",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "d682614a-8c8d-3ecb-811d-c74e9fde159d",
                                        "entry_id": "d7b2ea0b-5dad-3ce2-b2af-870a5af34e0c",
                                        "glosses": [
                                            "lekki wiatr wiejący między lądem a morzem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fdfce2c1-6452-452c-b25c-c38706b157c8",
                                                "sense_id": "d682614a-8c8d-3ecb-811d-c74e9fde159d",
                                                "text": "Korzystając z leciutkiej bryzy żaglówka sunęła dalej na zachód unoszona prądem."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4a5de48e-bd86-4eb1-86f8-a0a3828f45e3",
                        "source_entry_id": "f4dfde30-227e-3293-a385-7b82438fa42b",
                        "source_sense_id": "c42f91e7-ecb7-3811-affb-583ee1f4409d",
                        "target_lang_word": "brise",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brise",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f1c1ded3-5626-3c8b-ba1a-7f1dcc1a0daf",
                                        "entry_id": "ec5aacb1-5f4e-37b0-a09a-0df6d7df306f",
                                        "glosses": [
                                            "Vent doux, léger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d33507f3-9896-4fce-9c32-c4ea1abaaeb3",
                                                "sense_id": "f1c1ded3-5626-3c8b-ba1a-7f1dcc1a0daf",
                                                "text": "Puis, l’influence du printemps se faisait sentir, et chacun aspirait avec une véritable ivresse les brises plus tièdes qu'il apportait."
                                            },
                                            {
                                                "example_id": "810a1334-fec6-4f3c-9fa6-9bf592aa6f8a",
                                                "sense_id": "f1c1ded3-5626-3c8b-ba1a-7f1dcc1a0daf",
                                                "text": "La mer était belle, et ses vagues allongées fuyaient devant une légère brise du nord-est. Nous sortîmes sans peine du Sound et fûmes bientôt en pleine mer."
                                            },
                                            {
                                                "example_id": "4958a93d-cbf2-431f-aedd-2a0882d1ec82",
                                                "sense_id": "f1c1ded3-5626-3c8b-ba1a-7f1dcc1a0daf",
                                                "text": "Les goélands à l'aile grise\n Les hirondelles de la mer\nÀ leurs petits les jours de brise\nApprennent le chemin de l'air."
                                            },
                                            {
                                                "example_id": "52c631b9-d76b-4a18-a6b6-941696bcee71",
                                                "sense_id": "f1c1ded3-5626-3c8b-ba1a-7f1dcc1a0daf",
                                                "text": "Pendant la première semaine, la brise fut très légère et excessivement variable, tournant constamment du Nord au Suroit, en passant par l’Est."
                                            },
                                            {
                                                "example_id": "46baeef6-a968-4119-81e1-ac2cafc8c9d6",
                                                "sense_id": "f1c1ded3-5626-3c8b-ba1a-7f1dcc1a0daf",
                                                "text": "Vers le soir, il entre dans un champ de blé, de blés hauts et mûrs, dont la brise balance mollement les beaux épis d’or."
                                            },
                                            {
                                                "example_id": "533b27c6-f435-4477-94ab-711134fd0259",
                                                "sense_id": "f1c1ded3-5626-3c8b-ba1a-7f1dcc1a0daf",
                                                "text": "La brise fraîchissante du soir avait séché et soulevé ses cheveux, donnait à son visage un désordre à travers lequel apparaissait de la brutalité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "648dff07-3fa7-3902-9172-fb28161c63d0",
                                        "entry_id": "ec5aacb1-5f4e-37b0-a09a-0df6d7df306f",
                                        "glosses": [
                                            "Vent doux et irrégulier qui se fait sentir sur les bords de la mer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1947dbf3-2359-44bc-956b-d6a03fa17acb",
                                                "sense_id": "648dff07-3fa7-3902-9172-fb28161c63d0",
                                                "text": "Il n’y avait pas un bateau de pêche en vue. Seulement, au large et déjà coupé à demi par la ligne de l’horizon, un navire, toutes voiles déployées, attendait le retour de la brise de terre, et s’y préparait, comme un oiseau de grand vol, en ouvrant ses hautes ailes blanches."
                                            },
                                            {
                                                "example_id": "36666569-6d06-4c6f-9083-548ac329b194",
                                                "sense_id": "648dff07-3fa7-3902-9172-fb28161c63d0",
                                                "text": "Dès qu'il fait beau, la moindre brise soulève une fine poussière basaltique qui noircit tous les objets et pénètre dans les habitations les mieux closes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ec54336-855f-3c8a-995e-25946588f0bf",
                                        "entry_id": "ec5aacb1-5f4e-37b0-a09a-0df6d7df306f",
                                        "glosses": [
                                            "Tout vent qui souffle sans violence."
                                        ],
                                        "tags": [
                                            "literary",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c1e340a1-811f-4585-8b04-42262887e34b",
                                                "sense_id": "9ec54336-855f-3c8a-995e-25946588f0bf",
                                                "text": "Dans les forêts que leur souffle balance,\nLes brises du matin célèbrent son retour."
                                            },
                                            {
                                                "example_id": "21302604-5977-474a-863a-55eab7d6a336",
                                                "sense_id": "9ec54336-855f-3c8a-995e-25946588f0bf",
                                                "text": "Les jours filent clairs parmi le friselis des feuilles, le froufroutement des brises, les odeurs âpres des humus, le parfum des sèves, entouré d'oiseaux et d'abeilles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cec8872-b8d5-3a52-954c-4e9b0ecdb2da",
                                        "entry_id": "ec5aacb1-5f4e-37b0-a09a-0df6d7df306f",
                                        "glosses": [
                                            "Poutre en bascule."
                                        ],
                                        "tags": [
                                            "dated",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "brise",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "269b4ae2-52f6-3e60-8cdc-d533c558f568",
                                        "entry_id": "8064a76f-c17b-3a51-92a9-5e1c16397395",
                                        "glosses": [
                                            "Première personne du singulier de l’indicatif présent du verbe briser."
