                "entry_id": "4c4a47e3-a6a9-3a78-9886-c9a8cf700798",
                "word": "сапсан",
                "pos": "noun",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "05a6fc98-e0f8-3faf-a6be-d6b3d49cb336",
                        "entry_id": "4c4a47e3-a6a9-3a78-9886-c9a8cf700798",
                        "glosses": [
                            "Faucon pèlerin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c66fa5e-0798-4e57-9f3e-0d1c3052532b",
                                "sense_id": "05a6fc98-e0f8-3faf-a6be-d6b3d49cb336",
                                "text": "Сапсан (Falco peregrinus), вид соколов, по всему сев. полушарию в лесистых местностях; питается птицами, особ. голубями (местами наз. голубятником).",
                                "translation": "Le faucon pèlerin (Falco peregrinus) est une espèce de faucon que l'on trouve dans tout l'hémisphère nord, dans les zones boisées ; il se nourrit d'oiseaux, en particulier de pigeons (d’où son nom de \"pigeonnier\")."
                            },
                            {
                                "example_id": "7724eeb2-4b43-4796-95bf-9af9c407cd1d",
                                "sense_id": "05a6fc98-e0f8-3faf-a6be-d6b3d49cb336",
                                "text": "Охота с сапсаном.",
                                "translation": "Chasse au faucon pélerin."
                            }
                        ]
                    }
