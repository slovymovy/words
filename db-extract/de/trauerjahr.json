                        "entry_id": "62aa08a8-7381-3ce7-b9eb-f03d0c147a9a",
                        "glosses": [
                            "year of mourning, the first year after a person’s death, during which remarriage has traditionally been considered unbeseeming (and was formerly forbidden by law)"
                        ],
                        "tags": [
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "70db9fd4-a6f4-4437-83c3-6eb7e16f9970",
                                "sense_id": "4343e7ee-a528-34d4-a6c9-7f31bdf1d2c5",
                                "text": "Er hat schon eine Neue, will aber noch das Trauerjahr abwarten.",
                                "translation": "He has a new girlfriend already, but he wants to wait until the year of mourning has passed.",
                                "english": "He has a new girlfriend already, but he wants to wait until the year of mourning has passed."
                            }
                        ]
                    }
