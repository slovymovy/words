                "senses": [
                    {
                        "sense_id": "f9048b76-0272-3566-b7ab-cd81d3da1f9d",
                        "entry_id": "fd2bd87b-e80f-37b7-881a-10eab48e4bc2",
                        "glosses": [
                            "Juron (de vaudeville) attribué aux Auvergnats → voir Fouchtra."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "704967e4-5e8a-4d89-a2d8-38e44846263b",
                                "sense_id": "f9048b76-0272-3566-b7ab-cd81d3da1f9d",
                                "text": "Lenglumé.– Ah çà ! est-ce que nous aurions fraternisé cette nuit avec des charbonniers ?"
                            },
                            {
                                "example_id": "91d29c65-c3ef-4606-89a2-169fb7e3cd20",
                                "sense_id": "f9048b76-0272-3566-b7ab-cd81d3da1f9d",
                                "text": "Ainsi pour commencer, savez-vous parler fouchtra et vougri ?"
                            },
                            {
                                "example_id": "bc5b5f0d-2a6f-4dfc-ac89-020e1a8f8eed",
                                "sense_id": "f9048b76-0272-3566-b7ab-cd81d3da1f9d",
                                "text": "Mistingue.– Fouchtra de la Catarina !"
                            },
                            {
                                "example_id": "e7be0571-14bd-414f-9af0-feb1a438704d",
                                "sense_id": "f9048b76-0272-3566-b7ab-cd81d3da1f9d",
                                "text": "Elle les imitait [les paysans] avec leurs gestes […] leurs fouchtra."
                            }
                        ]
                    },
                    {
                        "sense_id": "d1c928fc-7afd-335d-b04d-ce5c5fbbdd70",
                        "entry_id": "fd2bd87b-e80f-37b7-881a-10eab48e4bc2",
                        "glosses": [
                            "Auvergnat."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "1e151f26-949b-4661-a2af-acd6df5f9395",
                                "sense_id": "d1c928fc-7afd-335d-b04d-ce5c5fbbdd70",
                                "text": "Tout enfant, j’avais été mené en consultation, 21, place Vendôme, chez le chirurgien Péan. J’avais gardé une impression profonde de son fouchtra de domestique, qu’amadouait un petit pourboire, de ses immenses salons peuplés de stropiats de tout âge, de sa personnalité géante, solide, carrée, de sa large tête à favoris noirs, de sa voix pâteuse et robuste."
                            }
                        ]
                    }
                ],
