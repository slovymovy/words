                "senses": [
                    {
                        "sense_id": "21c5126c-efd6-3bb5-b491-0690f128a177",
                        "entry_id": "36d85350-c85a-3f08-bfbc-b5b403fdc95f",
                        "glosses": [
                            "狩獵期間捕殺的獵物總和，按物種等級進行排列或懸掛"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5259c61b-9961-420a-bd11-b5214db10061",
                                "sense_id": "21c5126c-efd6-3bb5-b491-0690f128a177",
                                "text": "Całość tradycji związanych z dniem św. Huberta dopełnili myśliwi z Koła Łowieckiego Bielsko, którzy po polowaniu przed pałacem złożyli swój pokot i nagrodzili najlepszych strzelców.",
                                "translation": "與聖胡伯特節相關的所有傳統由別爾斯科狩獵協會的獵人們共同完成，他們在狩獵結束後，於宮殿前將捕獲的獵物陳列出來，並頒獎給最優秀的射手。"
                            }
                        ]
                    },
                    {
                        "sense_id": "a59adb70-a668-3b9c-9610-cb0474243e50",
                        "entry_id": "36d85350-c85a-3f08-bfbc-b5b403fdc95f",
                        "glosses": [
                            "狩獵結束儀式，在該儀式中會清點獵物數量，以上述方式將獵物陳列於地上，吹奏特定的信號，並宣告狩獵之王"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28816d02-2f1f-4dbe-9cec-ba6f07e2acb5",
                                "sense_id": "a59adb70-a668-3b9c-9610-cb0474243e50",
                                "text": "Tym razem zamiast pokotu było ognisko, a polowanie przełożono na inny termin.",
                                "translation": "這次沒有舉行狩獵結束儀式，而是點燃了營火，狩獵活動則延期至其他時間。"
                            }
                        ]
                    }
                ],
