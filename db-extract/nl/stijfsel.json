                    },
                    {
                        "translation_id": "9ded9b3e-14b4-4dba-bd79-b5f59f24f4c1",
                        "source_entry_id": "4db50184-437e-3788-a361-1bcb703a6a07",
                        "source_sense_id": "c8090747-e575-3634-8e28-4d52e709454d",
                        "target_lang_word": "amidon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amidon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "18e0e293-4809-3555-81f5-eec1679a3925",
                                        "entry_id": "40f9c63d-0774-3a78-af51-0912da418779",
                                        "glosses": [
                                            "Polysaccharide composé de chaînes de molécules de D-glucose nommées amylose et amylopectine qu’on retire des organes de réserves de nombreuses plantes comme le tubercule de la pomme de terre ou les grains de maïs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad9a63d8-1e9c-4268-b3bb-63393539b7ae",
                                                "sense_id": "18e0e293-4809-3555-81f5-eec1679a3925",
                                                "text": "Pour qu’elle ne semble pas être dans une cloche de carton, Arlette a brisé les plis lourds d’amidon de sa jupe."
                                            },
                                            {
                                                "example_id": "cc3a27b4-6f62-4758-88f9-2e0429f6243c",
                                                "sense_id": "18e0e293-4809-3555-81f5-eec1679a3925",
                                                "text": "Les insectes sont attirés par la présence de l’amidon, aussi les bambous qui ont été trempés dans l’eau résistent mieux à leur attaque."
                                            },
                                            {
                                                "example_id": "e7e51274-1f3f-4ff9-9ae3-05fa3785172a",
                                                "sense_id": "18e0e293-4809-3555-81f5-eec1679a3925",
                                                "text": "Le principal composant chimique du grain de maïs est l’amidon, qui constitue de 72 à 73 pour cent de son poids."
                                            },
                                            {
                                                "example_id": "aa54dcc6-93a3-4aee-8d2b-a6ac368bac61",
                                                "sense_id": "18e0e293-4809-3555-81f5-eec1679a3925",
                                                "text": "Dans un système lexical où les fibres sont les os, l’amidon est littéralement la substantifique moelle du manioc."
                                            },
                                            {
                                                "example_id": "c4741278-3cd7-49d8-b157-2343dd0d20de",
                                                "sense_id": "18e0e293-4809-3555-81f5-eec1679a3925",
                                                "text": "Certaines colles naturelles restent utilisées : […], les amidons et la caséine pour l’étiquetage de bouteilles en verre, l’amidon pour fermer les fonds de sacs en papier, carton ondulé, etc. et pour l’industrie graphique, …."
                                            },
                                            {
                                                "example_id": "6fc62059-4db0-4d03-ac5f-1b2576902345",
                                                "sense_id": "18e0e293-4809-3555-81f5-eec1679a3925",
                                                "text": "Afin d’entrer dans la glycolyse les carbones des glucides de réserve comme l’amidon, le saccharose ou les fructosanes, doit d'abord être hydrolysé sous forme de glucose ou de fructose puis converti en fructose-1,6-biphosphate."
                                            },
                                            {
                                                "example_id": "8847ebba-a073-4a4e-8c7e-85fc446a351c",
                                                "sense_id": "18e0e293-4809-3555-81f5-eec1679a3925",
                                                "text": "Riche en amidon mais pauvre en protéines, le taro s’apparente à la pomme de terre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
