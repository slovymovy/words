                        "translation_id": "6b322406-1b91-408a-b733-667896c90b21",
                        "source_entry_id": "a9708230-7cad-39e5-b59e-00d467b063c3",
                        "target_lang_word": "Nachtschwärmer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachtschwärmer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3b78e566-1273-3cd2-8c04-f56ecb3423cb",
                                        "entry_id": "d96bbd75-b997-3464-b983-9a52546d1289",
                                        "glosses": [
                                            "jemand, der nachts oft ausgeht, z.B. in Diskos oder Lokale"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58169758-c7ff-4dc5-8e18-dd648d4dfa0b",
                                                "sense_id": "3b78e566-1273-3cd2-8c04-f56ecb3423cb",
                                                "text": "„Die Nachtschwärmer ändern nichts an ihren Gewohnheiten, nur die Mafia lernt sehr schnell, sich auf den Handel mit harten Drogen umzustellen.“"
                                            },
                                            {
                                                "example_id": "2a90c15f-1165-4a4e-9a88-4d580ddd25c8",
                                                "sense_id": "3b78e566-1273-3cd2-8c04-f56ecb3423cb",
                                                "text": "„Die Nachtschwärmer kann den Plot, also die Prosodie der Ereignisse, die Zuckungen der Umstände, die düsteren Prozessionen ins Ungewisse.“"
                                            },
                                            {
                                                "example_id": "0d697bd4-5f39-4132-b2b9-c30f89df4818",
                                                "sense_id": "3b78e566-1273-3cd2-8c04-f56ecb3423cb",
                                                "text": "„Die Nachtschwärmer standen bis zur Kreuzung.“"
                                            },
                                            {
                                                "example_id": "4a7c994a-63d5-4438-8123-c7e2dc2d867e",
                                                "sense_id": "3b78e566-1273-3cd2-8c04-f56ecb3423cb",
                                                "text": "„Wir nahmen in der Nähe der place Pigalle einen Bissen zu uns, umgeben von allerlei Nachtschwärmern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
