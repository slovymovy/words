                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "radio",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ce2822bd-e880-3b11-9ae6-b147f47caa7a",
                                        "entry_id": "3306a094-8aae-32b9-994e-ae2e509e0ce0",
                                        "glosses": [
                                            "The technology that allows for the transmission of sound or other signals by modulation of electromagnetic waves."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65d67e11-fbe2-4767-ae5d-023a541ed550",
                                                "sense_id": "ce2822bd-e880-3b11-9ae6-b147f47caa7a",
                                                "text": "send a message by radio"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a76484e1-fd99-3113-8a30-bd660c5d730f",
                                        "entry_id": "3306a094-8aae-32b9-994e-ae2e509e0ce0",
                                        "glosses": [
                                            "A device that can capture (receive) the signal sent over radio waves and render the modulated signal as sound."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ffee69c-074c-4ac4-86d5-6a79274f8a3b",
                                                "sense_id": "a76484e1-fd99-3113-8a30-bd660c5d730f",
                                                "text": "We heard a lovely song on the radio."
                                            },
                                            {
                                                "example_id": "b071bd6b-455c-4182-bf76-4a6300271d7f",
                                                "sense_id": "a76484e1-fd99-3113-8a30-bd660c5d730f",
                                                "text": "She was listening to the radio when he knocked on the door."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5cf2c5a-7d05-3470-bd1b-121834d70fbc",
                                        "entry_id": "3306a094-8aae-32b9-994e-ae2e509e0ce0",
                                        "glosses": [
                                            "Any audio playing device, such as the on-board entertainment system in a car, usually including a radio receiver as well as the capability to play audio from recorded media; see also car radio."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d13f29ad-eb4f-40fa-a8af-e4f9ce7cfd62",
                                                "sense_id": "a5cf2c5a-7d05-3470-bd1b-121834d70fbc",
                                                "text": "David Bowie's classic hit Space Oddity will be looping on the radio as the car is hurled into an elliptical orbit that stretches out to Mars' orbit around the Sun."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5b2411a-b68d-3331-a3cd-096cf34bfb6b",
                                        "entry_id": "3306a094-8aae-32b9-994e-ae2e509e0ce0",
                                        "glosses": [
                                            "A device that can transmit radio signals."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8838a72b-39ff-37c3-8fdd-2ef6dcf82790",
                                        "entry_id": "3306a094-8aae-32b9-994e-ae2e509e0ce0",
                                        "glosses": [
                                            "The continuous broadcasting of sound via the Internet in the style of traditional radio."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "radio",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff7ed4c1-773b-360b-9215-663a227dae9e",
                                        "entry_id": "8d1d29b1-c179-32d0-b1bb-1be3f424151a",
                                        "glosses": [
                                            "To use two-way radio to transmit (a message) (to another radio or other radio operator)."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3ae42e5-187a-4f90-a461-4936f86a0565",
                                                "sense_id": "ff7ed4c1-773b-360b-9215-663a227dae9e",
                                                "text": "I think the boat is sinking; we'd better radio for help. / I radioed him already. / Radio the coordinates this time. / OK. I radioed them the coordinates."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc99dd20-c6c1-33c9-808a-111487b96937",
                                        "entry_id": "8d1d29b1-c179-32d0-b1bb-1be3f424151a",
                                        "glosses": [
                                            "To order or assist (to a location), using telecommunications."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "89b5fc0d-15ec-4e30-97ad-60a23346389c",
                                                "sense_id": "dc99dd20-c6c1-33c9-808a-111487b96937",
                                                "text": "“Could you call them here? I'd like to talk to them. Or if they're out in the field, radio them in.”"
                                            },
                                            {
                                                "example_id": "4ddd9533-708d-40ce-a60f-ec4692c0f47b",
                                                "sense_id": "dc99dd20-c6c1-33c9-808a-111487b96937",
                                                "text": "When I told him that they weren't back yet, he asked if we could radio them back early […] Radioing them in was fine with me."
                                            },
                                            {
                                                "example_id": "4e04199f-75e1-4eda-9162-15185fa79551",
                                                "sense_id": "dc99dd20-c6c1-33c9-808a-111487b96937",
                                                "text": "When she arrived, she was told that Tad wasn't there and to have a seat and wait while they radioed him in."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd468d5a-a044-447f-8ddf-aa09eed3f08b",
                        "source_entry_id": "ce2cf208-571f-36af-99f4-b2b92205f8f5",
                        "target_lang_word": "Radio",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Radio",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e21b6899-7ac6-373c-b40b-4aca19fd6c85",
                                        "entry_id": "1dbe4352-227b-3bb8-916d-11206c049cf7",
                                        "glosses": [
                                            "ein elektronisches Gerät, mit dem Hörfunkprogramme empfangen werden können, beispielsweise Nachrichten- oder Musikkanäle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a29405a7-978d-4410-ac42-9bbdfee2652c",
                                                "sense_id": "e21b6899-7ac6-373c-b40b-4aca19fd6c85",
                                                "text": "Ich kam in Paris an und schaltete als erstes das Radio an."
                                            },
                                            {
                                                "example_id": "fde86a21-de02-4410-9236-22526ca88932",
                                                "sense_id": "e21b6899-7ac6-373c-b40b-4aca19fd6c85",
                                                "text": "„Manche Nachrichten stammen aus dem Radio, obwohl der Besitz von Radiogeräten weiter offiziell verboten bleibt.“"
                                            },
                                            {
                                                "example_id": "6a1f2156-2490-4f22-84c9-b222d8e4523d",
                                                "sense_id": "e21b6899-7ac6-373c-b40b-4aca19fd6c85",
                                                "text": "„Doch nicht jeder konnte sich ein Radio leisten.“"
                                            },
                                            {
                                                "example_id": "fbeace54-f461-4576-95df-f619606c496c",
                                                "sense_id": "e21b6899-7ac6-373c-b40b-4aca19fd6c85",
                                                "text": "Das Radio wurde in der Geschichte häufig als ein Propagandainstrument missbraucht."
                                            },
                                            {
                                                "example_id": "5e4c2822-5df5-4cce-9922-9f1a957014d7",
                                                "sense_id": "e21b6899-7ac6-373c-b40b-4aca19fd6c85",
                                                "text": "„Für sie ist das Radio die wichtigste Verbindung zur Außenwelt.“"
                                            },
                                            {
                                                "example_id": "85b64f1c-6972-4720-bee6-968d0e8849d9",
                                                "sense_id": "e21b6899-7ac6-373c-b40b-4aca19fd6c85",
                                                "text": "„Aus dem Radio kam folkloristische Musik, sehr dezent.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "76d89a76-cfd6-3cd4-b936-e02b9964e388",
                                        "entry_id": "1dbe4352-227b-3bb8-916d-11206c049cf7",
                                        "glosses": [
                                            "Programme, die mit einem Radio empfangen werden können"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e2e0ad5-0dd3-475f-9d2d-4c33aaeb5784",
                                                "sense_id": "76d89a76-cfd6-3cd4-b936-e02b9964e388",
                                                "text": "Um sechs Uhr kommt meine Lieblingssendung im Radio."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "62c660e7-c14a-32c4-8cac-84953fe36209",
                                        "entry_id": "1dbe4352-227b-3bb8-916d-11206c049cf7",
                                        "glosses": [
                                            "eine Organisation, die Radioprogramme produziert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "880abbb3-1b99-44e6-af25-5380c47a6abb",
                                                "sense_id": "62c660e7-c14a-32c4-8cac-84953fe36209",
                                                "text": "Sie arbeitet beim Radio."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04f52247-a541-47fb-b06d-e7f6d08b32fc",
                        "source_entry_id": "ce2cf208-571f-36af-99f4-b2b92205f8f5",
                        "target_lang_word": "radio",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "radio",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "84cbb357-4c49-3776-b1fa-df01ec44ed1b",
                                        "entry_id": "cbe28d5d-d882-307d-b042-ca21e0c9b36b",
                                        "glosses": [
                                            "Appareil émetteur et récepteur de radiocommunication."
                                        ],
                                        "tags": [
                                            "Électroménager"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85e427ee-85cc-4192-ab72-639c7dbf89e2",
                                                "sense_id": "84cbb357-4c49-3776-b1fa-df01ec44ed1b",
                                                "text": "À la radio crachotante, on entend la voix de l’éclusier du port : « Monsieur, vous pouvez avancer doucement »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78b201ad-74fb-3147-a701-87fad7192252",
                                        "entry_id": "cbe28d5d-d882-307d-b042-ca21e0c9b36b",
                                        "glosses": [
                                            "Récepteur d’émissions radiophoniques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9dec212-2dc3-47b2-a36a-a2500a0ff7ca",
                                                "sense_id": "78b201ad-74fb-3147-a701-87fad7192252",
                                                "text": "Écouter la radio."
                                            },
                                            {
                                                "example_id": "ee227b94-95db-441e-9e78-1a6cb1d4c5ff",
                                                "sense_id": "78b201ad-74fb-3147-a701-87fad7192252",
                                                "text": "J’ai essayé tous les fauteuils, avant de choisir celui que j’ai poussé près de la radio. J’écoute toutes les émissions, c’est passionnant, dans ma petite maison j’étais si privée de cette drogue qu’est la radio."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4afb7b93-3e7b-3a4b-910a-bdef4f33ea6b",
                                        "entry_id": "cbe28d5d-d882-307d-b042-ca21e0c9b36b",
                                        "glosses": [
                                            "Média de communication passant par la radiodiffusion, caractérisé par l’utilisation du son sans image, par opposition aux journaux (écrit) et à la télévision (son et image)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f6ed4ef-4a35-4456-813d-2382b7143427",
                                                "sense_id": "4afb7b93-3e7b-3a4b-910a-bdef4f33ea6b",
                                                "text": "Il peut devenir un homme de radio de premier ordre."
                                            },
                                            {
                                                "example_id": "e9297ae7-ff3e-48c6-b067-8ca9262d2a6e",
                                                "sense_id": "4afb7b93-3e7b-3a4b-910a-bdef4f33ea6b",
                                                "text": "Si la majorité des pubs radio sont plates, c’est parce que les rédacteurs ne comprennent pas ce média magnifique. La radio est la descendante de la tradition orale."
                                            },
                                            {
                                                "example_id": "58e15e8a-4027-40aa-b57c-d8f14d0d6cc8",
                                                "sense_id": "4afb7b93-3e7b-3a4b-910a-bdef4f33ea6b",
                                                "text": "Elle a en effet mis les trois moyens d’information d’accord en commençant par occuper la radio, puis en mettant la main sur la télévision, tuant au passage une quatorzaine de Lituaniens indépendantistes et sans armes."
                                            },
                                            {
                                                "example_id": "c936a075-b2cb-448e-88e4-da2b042af14b",
                                                "sense_id": "4afb7b93-3e7b-3a4b-910a-bdef4f33ea6b",
                                                "text": "… même si on l'oublie parfois, la radio est un travail d'équipe, personne ne prend le micro complètement seul. Il y a quelqu'un qui réalise, il y a les collaborateurs, les recherchistes... bref, tout ce qu'on entend en ondes est comme le suc distillé de tout un processus en amont."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c8d2aa8-d9e8-3071-93a9-9631ea2c1322",
                                        "entry_id": "cbe28d5d-d882-307d-b042-ca21e0c9b36b",
                                        "glosses": [
                                            "Radiotélégraphie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a311f57f-fc87-490b-acb7-7962c345dc47",
                                                "sense_id": "6c8d2aa8-d9e8-3071-93a9-9631ea2c1322",
                                                "text": "Lancer un appel, transmettre des ordres par radio."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54edd239-48e0-33f9-845c-3c3e099b2fdd",
                                        "entry_id": "cbe28d5d-d882-307d-b042-ca21e0c9b36b",
                                        "glosses": [
                                            "Société généralement commerciale diffusant des émissions radiophoniques à l’aide d’un ou de plusieurs émetteurs radioélectriques."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dcb2e8a7-c569-3b78-81b9-fc8b92e5ff36",
                                        "entry_id": "cbe28d5d-d882-307d-b042-ca21e0c9b36b",
                                        "glosses": [
                                            "Radiographie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e291d1a3-5218-47ff-8ce1-9c919cf67e9f",
                                                "sense_id": "dcb2e8a7-c569-3b78-81b9-fc8b92e5ff36",
                                                "text": "Un matin, elle assista à une scène qui la bouleversa. Un patient attendait son tour afin de passer une radio. Assis sur un chariot, il lisait un policier de la collection le Masque."
                                            },
                                            {
                                                "example_id": "8c302383-d773-4f47-8d0a-c1efedf84866",
                                                "sense_id": "dcb2e8a7-c569-3b78-81b9-fc8b92e5ff36",
                                                "text": "Le docteur T. déchiffrait mal les clichés communiqués par le docteur D. et on devait le lendemain procéder à une nouvelle radio des intestins : « On me fera un lavement au baryte : c’est douloureux : » me dit maman."
                                            },
                                            {
                                                "example_id": "1dc97e26-66f2-467e-92c8-f0829829636b",
                                                "sense_id": "dcb2e8a7-c569-3b78-81b9-fc8b92e5ff36",
                                                "text": "J'ai réalisé une radio mais cela n'a rien montré."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41d26452-9ad0-3ab7-a5ec-c588aa3acda0",
                                        "entry_id": "cbe28d5d-d882-307d-b042-ca21e0c9b36b",
                                        "glosses": [
                                            "Radioélectricité."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d112c33e-109c-3606-bf09-c87bbe26302d",
                                        "entry_id": "cbe28d5d-d882-307d-b042-ca21e0c9b36b",
                                        "glosses": [
                                            "Radioguidage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf4a0212-bc93-4125-aad3-aef0b5f1f4b3",
                                                "sense_id": "d112c33e-109c-3606-bf09-c87bbe26302d",
                                                "text": "Guider par radio des avions."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "radio",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "daa71112-6fde-317d-9d2c-6b02ca3dbb34",
                                        "entry_id": "5d0b7243-ce63-39da-9806-feb37715566e",
                                        "glosses": [
                                            "Radiotélégramme, radiogramme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90b9e925-9ea8-4c15-98b5-99b3359ed592",
                                                "sense_id": "daa71112-6fde-317d-9d2c-6b02ca3dbb34",
                                                "text": "Envoyer, expédier, recevoir un radio."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "320ac1f8-4432-3342-aa3f-77be2db73269",
                                        "entry_id": "5d0b7243-ce63-39da-9806-feb37715566e",
                                        "glosses": [
                                            "Opérateur radiotélégraphiste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "081fa253-b325-42b6-942a-7622d534f646",
                                                "sense_id": "320ac1f8-4432-3342-aa3f-77be2db73269",
                                                "text": "Presque minute par minute, le radio du Phocée nous passa notre relèvement."
                                            },
                                            {
                                                "example_id": "13d932a6-a38f-455e-b670-efd5e8437587",
                                                "sense_id": "320ac1f8-4432-3342-aa3f-77be2db73269",
                                                "text": "Ils sortirent le matériel, branchèrent la gégène que René enfourcha pour pédaler. Le courant passait. L’opérateur radio pouvait émettre le message que lui avait donné Gaëtan. La communication était mauvaise et le radio dut changer de fréquence."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "radio",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f88aa562-24fe-3c85-84a2-cc981a57bfa5",
                                        "entry_id": "4d18c8bd-3290-353a-8b07-843b23963d7f",
                                        "glosses": [
                                            "Relatif à la radiocommunication."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db1853dc-b144-43c2-b111-a2c5e78a2378",
                                                "sense_id": "f88aa562-24fe-3c85-84a2-cc981a57bfa5",
                                                "text": "Les appels radio des tankistes réclamant de l’essence se faisaient entendre sans cesse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d48eb5b-aa26-3f01-be58-bdb1f13e116e",
                                        "entry_id": "4d18c8bd-3290-353a-8b07-843b23963d7f",
                                        "glosses": [
                                            "Radiotéléphonique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e69e1a95-6e5c-4dab-a074-e1507a9e2265",
                                                "sense_id": "4d48eb5b-aa26-3f01-be58-bdb1f13e116e",
                                                "text": "Ils sortirent le matériel, branchèrent la gégène que René enfourcha pour pédaler. Le courant passait. L’opérateur radio pouvait émettre le message que lui avait donné Gaëtan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
