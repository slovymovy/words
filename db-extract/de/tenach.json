                "senses": [
                    {
                        "sense_id": "57b9aa2e-eb9d-39c3-8a38-151e9d5abcc2",
                        "entry_id": "42ac0c39-b34c-3bdd-b267-bf5df92aa6bd",
                        "glosses": [
                            "normative Bibeltexte"
                        ],
                        "tags": [
                            "jüdische Religion"
                        ],
                        "examples": [
                            {
                                "example_id": "424970e3-ce00-4190-b37d-843602a238bd",
                                "sense_id": "57b9aa2e-eb9d-39c3-8a38-151e9d5abcc2",
                                "text": "„Deshalb blättere ich im Tenach wie im täglichen Leben.“"
                            },
                            {
                                "example_id": "3af8c694-a5d3-47f2-8a6e-8caa77c38c0e",
                                "sense_id": "57b9aa2e-eb9d-39c3-8a38-151e9d5abcc2",
                                "text": "„Daher die vielen Zitate aus dem Tenach. Der Tenach, das ist unsere hebräische Bibel und das, was die nichtjüdischen Völker in ihren Bibeln als 'Altes Testament' bezeichnen.“"
                            },
                            {
                                "example_id": "6bf82766-ab60-4fd6-b18e-8c88ae68f1a5",
                                "sense_id": "57b9aa2e-eb9d-39c3-8a38-151e9d5abcc2",
                                "text": "„Es entspricht, abgesehen von den Apokryphen, dem Kanon heiliger Texte, die im Judentum mit dem Akronym ‚Tenach‘ bezeichnet werden.“"
                            },
                            {
                                "example_id": "92d2037d-61a2-4c46-94f4-3b470bb45fb2",
                                "sense_id": "57b9aa2e-eb9d-39c3-8a38-151e9d5abcc2",
                                "text": "„Während die Christen in der Bibel das Alte Testament und das Neue Testament haben, so gründet der Glaube der Juden auf dem Tenach.“"
                            },
                            {
                                "example_id": "0218b925-dd56-4d14-9da7-11d4a0e4b466",
                                "sense_id": "57b9aa2e-eb9d-39c3-8a38-151e9d5abcc2",
                                "text": "„Die hebräische Bibel wird Tenach oder auch Tanach genannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
