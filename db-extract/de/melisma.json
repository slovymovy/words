                        "cross_references": [
                            {
                                "target_word": "melisma",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0188db5c-3a0f-3dc4-af5e-f5ddcf8b595e",
                                        "entry_id": "da773387-cae3-32c6-8af3-cf126dab9b98",
                                        "glosses": [
                                            "A passage of several notes sung to one syllable of text."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "081249ca-ef29-48fd-b604-981adda9ca03",
                                                "sense_id": "0188db5c-3a0f-3dc4-af5e-f5ddcf8b595e",
                                                "text": "A choir sang one of the Lamentations of Jeremiah. The mournful melisma accompanied the slow procession to the palace built by Herod the Great, at present untenanted."
                                            },
                                            {
                                                "example_id": "c66d6955-59e9-41da-850e-98261cbdf707",
                                                "sense_id": "0188db5c-3a0f-3dc4-af5e-f5ddcf8b595e",
                                                "text": "At the top of the hill in the archway of the main house, an eyeless old man sat on a bucket, scratching at a two-stringed gourd, warbling weird melismas on a madman's text."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e77fae1-d09a-3ee8-80de-6ea499b9f7a5",
                                        "entry_id": "da773387-cae3-32c6-8af3-cf126dab9b98",
                                        "glosses": [
                                            "The use of such passages."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54faff79-8f80-48b4-b26d-5ffab7155650",
                                                "sense_id": "1e77fae1-d09a-3ee8-80de-6ea499b9f7a5",
                                                "text": "A subsequent generation of singers, including Ms. Aguilera, Jennifer Hudson and Beyoncé, built their careers around melisma."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de1f4986-88bb-4ad2-8938-0b1b29cd66b9",
                        "source_entry_id": "e794ecba-f262-3851-a078-a79e5a8338ee",
                        "source_sense_id": "54bfaa08-81c5-3dcf-9fa6-e3d97c2bc382",
                        "target_lang_word": "mélisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mélisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5b5bf995-0fae-338f-92fb-b823f495abea",
                                        "entry_id": "9f42d849-dbc6-37b7-b80e-708b8ed3fdc2",
                                        "glosses": [
                                            "Modulation de plusieurs notes sur la même syllabe d’un mot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "733b2fb1-272a-4df2-86d6-861423992187",
                                                "sense_id": "5b5bf995-0fae-338f-92fb-b823f495abea",
                                                "text": "Il en résulte que la nasalité semble s’installer au centre de l’argumentation pro-arabo-andalouse, aux côtés d’un autre marqueur d’origine : le mélisme."
                                            },
                                            {
                                                "example_id": "2a79c394-4c8f-47ef-8410-369f8c6a8182",
                                                "sense_id": "5b5bf995-0fae-338f-92fb-b823f495abea",
                                                "text": "Aux variantes mélodiques, rythmiques et dynamiques, dévolues à cette voix de commentaire, s'ajoute la vocation de l'ornementation, dont elle n'a cependant pas le monopole – mais celle du bassu reste si discrète qu'elle ne peut soutenir la comparaison avec l'exubérance des voix les plus hautes, et particulièrement de la terza, dont les mélismes dépassent en virtuosité et en éclat ceux de la secunda."
                                            },
                                            {
                                                "example_id": "5c700613-0e71-4e32-bfd8-bfbdc962ac6c",
                                                "sense_id": "5b5bf995-0fae-338f-92fb-b823f495abea",
                                                "text": "Esther Lamandier s’accompagne elle-même sur les instruments les plus divers ; sa voix ravissante se joue de tous les mélismes avec une virtuosité diabolique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
