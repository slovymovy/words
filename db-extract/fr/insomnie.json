        "fr-extract.jsonl": [
            {
                "entry_id": "8b8e0e2e-0b81-3cc7-adb9-9ae01bb8acee",
                "word": "insomnie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "2f30ac26-c8f5-4674-a84e-e81843f1994a",
                        "entry_id": "8b8e0e2e-0b81-3cc7-adb9-9ae01bb8acee",
                        "tags": [
                            "plural"
                        ],
                        "form": "insomnies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eed6321e-13c1-3b23-bc25-dfa7224f8d40",
                        "entry_id": "8b8e0e2e-0b81-3cc7-adb9-9ae01bb8acee",
                        "glosses": [
                            "Absence involontaire de sommeil, difficulté à s’endormir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d891626-bfc0-4448-aedd-df49806de83f",
                                "sense_id": "eed6321e-13c1-3b23-bc25-dfa7224f8d40",
                                "text": "Elle était sujette à de fréquentes insomnies et prenait régulièrement un ou deux cachets de théralène qu’elle faisait dissoudre dans un verre d’eau."
                            },
                            {
                                "example_id": "7eac1990-7356-4a80-8f98-14812028be9f",
                                "sense_id": "eed6321e-13c1-3b23-bc25-dfa7224f8d40",
                                "text": "Pendant ses nuits d’insomnie et de fièvre, il en était arrivé à prendre des résolutions extrêmes : […]."
                            },
                            {
                                "example_id": "a18cdc91-657f-4839-87ee-488a2ce892d8",
                                "sense_id": "eed6321e-13c1-3b23-bc25-dfa7224f8d40",
                                "text": "Le plus accablant, c’est l’insomnie chronique. Il y avait là des énervés paroxystiques qui ne dormaient – et encore à l’aide du chloral – que deux heures par nuit. Ils essayaient de tout, du silence, de l’immobilité, de la numération intérieure, puis se levaient, arpentaient les corridors, marchaient dans la cour, remontaient, se recouchaient."
                            },
                            {
                                "example_id": "f55c8876-09e6-4319-acc8-76ed65fae096",
                                "sense_id": "eed6321e-13c1-3b23-bc25-dfa7224f8d40",
                                "text": "Elle ne voulait pas être seule. Elle sentait déjà l’horreur de sa solitude, l’insomnie prolongée, le tête-à-tête décevant avec Dieu."
                            }
                        ]
                    },
                    {
                        "sense_id": "125c2e90-d8a9-340a-a4fe-ba63f15cea84",
                        "entry_id": "8b8e0e2e-0b81-3cc7-adb9-9ae01bb8acee",
                        "glosses": [
                            "Nuit d’insomnie."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "e0401018-3b9b-4e49-b276-8e439308ce39",
                                "sense_id": "125c2e90-d8a9-340a-a4fe-ba63f15cea84",
                                "text": "Elle a recroisé son violeur et en a fait une insomnie."
                            }
                        ]
                    },
                    {
                        "sense_id": "815acfd6-0a28-3cae-b5eb-2b2b3d773977",
                        "entry_id": "8b8e0e2e-0b81-3cc7-adb9-9ae01bb8acee",
                        "glosses": [
                            "Nuit à ne pas dormir, y compris de façon volontaire et délibérée."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "ae9d07fc-942f-4dbb-83f8-f9cfa7143bc7",
                                "sense_id": "815acfd6-0a28-3cae-b5eb-2b2b3d773977",
                                "text": "Je songeais assez amèrement qu’il allait falloir consacrer à mes examens une semaine d’insomnies."
                            }
                        ]
                    },
                    {
                        "sense_id": "b576b647-9713-3de7-8a30-64cae29287f1",
                        "entry_id": "8b8e0e2e-0b81-3cc7-adb9-9ae01bb8acee",
                        "glosses": [
                            "Période nocturne où l'on ne dort pas tout en restant couché, sans forcément chercher à dormir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4091db9-5e8e-42a5-ac80-6d48affd274e",
                                "sense_id": "b576b647-9713-3de7-8a30-64cae29287f1",
                                "text": "Après deux heures de douce insomnie, je m'endors paisiblement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f34f882b-1df2-4603-b039-72d6cb132dba",
                        "source_entry_id": "8b8e0e2e-0b81-3cc7-adb9-9ae01bb8acee",
                        "source_sense_description": "privation de sommeil",
                        "target_lang_word": "Insomnie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Insomnie",
