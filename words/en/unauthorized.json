{
    "word_family": [
        "authorize",
        "authorization",
        "authority",
        "authoritative",
        "authorized"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cf372f08-db68-34df-aa9f-27b99bd3bc01",
                    "sense_definition": "Done or occurring without official permission or legal approval.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "lack of permission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company faced heavy fines for dumping hazardous waste in an <w>unauthorized</w> location.",
                            "target_lang_translations": {
                                "ru": "Компания столкнулась с крупными штрафами за сброс опасных отходов в <w>несанкционированном</w> месте."
                            }
                        },
                        {
                            "text": "Security guards were hired to prevent <w>unauthorized</w> access to the private construction site.",
                            "target_lang_translations": {
                                "ru": "Были наняты охранники для предотвращения <w>несанкционированного</w> доступа на частную строительную площадку."
                            }
                        }
                    ],
                    "synonyms": [
                        "unapproved",
                        "unsanctioned",
                        "unlicensed",
                        "illegal"
                    ],
                    "antonyms": [
                        "authorized",
                        "approved",
                        "official",
                        "permitted"
                    ],
                    "common_phrases": [
                        "unauthorized access",
                        "unauthorized use",
                        "unauthorized entry",
                        "unauthorized disclosure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или событие, совершенное без официального разрешения или законного одобрения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "несанкционированный",
                                "target_lang_sense_clarification": "проведенный без официального разрешения"
                            },
                            {
                                "target_lang_word": "неразрешенный",
                                "target_lang_sense_clarification": "не имеющий формального согласия"
                            },
                            {
                                "target_lang_word": "самовольный",
                                "target_lang_sense_clarification": "сделанный по собственной инициативе без права на это"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9fefdc76-5180-37e6-8fe6-4a876e53e9c0",
                    "sense_definition": "Not having the power, right, or authority to perform a specific task.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "lack of power",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The junior clerk was <w>unauthorized</w> to sign the legal documents on behalf of the director.",
                            "target_lang_translations": {
                                "ru": "Младший клерк <w>не был уполномочен</w> подписывать юридические документы от имени директора."
                            }
                        },
                        {
                            "text": "He felt <w>unauthorized</w> to speak for the entire group without consulting them first.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал, что <w>не вправе</w> говорить от имени всей группы, не посоветовавшись с ними сначала."
                            }
                        }
                    ],
                    "synonyms": [
                        "unempowered"
                    ],
                    "antonyms": [
                        "empowered",
                        "authorized"
                    ],
                    "common_phrases": [
                        "unauthorized personnel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отсутствие полномочий, прав или власти для выполнения конкретной задачи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "не уполномоченный",
                                "target_lang_sense_clarification": "не имеющий официального права действовать"
                            },
                            {
                                "target_lang_word": "не имеющий полномочий",
                                "target_lang_sense_clarification": "без юридического или административного права"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}