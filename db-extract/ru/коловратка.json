                "senses": [
                    {
                        "sense_id": "068bc15a-8e8b-3340-8a78-fc7ecd9f013c",
                        "entry_id": "ae0d6501-4f69-308b-a426-48980dd4aed6",
                        "glosses": [
                            "зоол. микроскопическое многоклеточное животное первичнополостных, с вращающимися ресничками вокруг ротового отверстия для передвижения и втягивания пищи"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de7ff3f5-fba9-44bc-9caf-4e41b597fc45",
                                "sense_id": "068bc15a-8e8b-3340-8a78-fc7ecd9f013c",
                                "text": "В водоёмах умеренного пояса время массового размножения коловраток происходит обычно в весенне-летний период, когда вода прогреется."
                            }
                        ]
                    }
                ],
