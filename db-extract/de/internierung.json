                "senses": [
                    {
                        "sense_id": "e18d69c6-0ba4-3c64-a96e-6a1c23289fe7",
                        "entry_id": "114b8390-2f1a-3ba6-9d7f-3536d7ec9a2b",
                        "glosses": [
                            "Unterbringung von gegnerischen Personen in einem Lager"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6c22bc5-db5c-483d-90cf-9ab55cd5e7a1",
                                "sense_id": "e18d69c6-0ba4-3c64-a96e-6a1c23289fe7",
                                "text": "„Wie immer, wenn ich das Netz öffne, kommt zuerst mein Vater zum Vorschein, der Polizeiposten Rugbüll, der, nachdem sie ihn aus der Internierung entlassen hatten, wieder wurde, was er gewesen war und was jeder auch von ihm erwartet hätte zwischen Glüserup und der Husumer Chaussee.“"
                            },
                            {
                                "example_id": "6d38ed0a-0bbb-4dc9-9b85-4dc235839c91",
                                "sense_id": "e18d69c6-0ba4-3c64-a96e-6a1c23289fe7",
                                "text": "„Přemysl Pitter hat über vierhundert deutsche Kinder aus der Internierung gerettet.“"
                            },
                            {
                                "example_id": "10ee0195-c081-485b-8957-71f0dcda9451",
                                "sense_id": "e18d69c6-0ba4-3c64-a96e-6a1c23289fe7",
                                "text": "„Damit blieb ihr das Schicksal einer Internierung erspart.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
