                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "edab5512-b801-4fc6-86ea-05a447cb5094",
                                "sense_id": "d2ff01d4-bfe4-314d-828e-de9ad228ff58",
                                "text": "I haven't seen Emily since I dormed with her in our student days."
                            },
                            {
                                "example_id": "bd9a54e7-4836-4527-9ff3-419fa8e7b091",
                                "sense_id": "d2ff01d4-bfe4-314d-828e-de9ad228ff58",
                                "text": "He spent a year at Wayne State University before transferring to Stanford to be with Chase. They dormed together at Crothers Hall, studied together at William Gould Hall and came home on vacations together."
                            }
                        ]
                    }
