                ],
                "senses": [
                    {
                        "sense_id": "695ca0a3-c826-305c-bf7e-e299b6703354",
                        "entry_id": "70099240-323f-305c-8657-ee82119493a4",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89d078ae-82a6-43b3-885e-a3eb33de2c55",
                                "sense_id": "695ca0a3-c826-305c-bf7e-e299b6703354",
                                "text": "Frau Illig ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "583f3367-fa67-4f24-9911-2f12c77e4ed7",
                                "sense_id": "695ca0a3-c826-305c-bf7e-e299b6703354",
                                "text": "Herr Illig wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "38ac1fec-3644-43df-88cb-b808c83db02e",
                                "sense_id": "695ca0a3-c826-305c-bf7e-e299b6703354",
                                "text": "Die Illigs kommen heute aus dem Werratal."
                            },
                            {
                                "example_id": "02bc061a-17c9-4fd8-8ea4-289b7e68ad7f",
                                "sense_id": "695ca0a3-c826-305c-bf7e-e299b6703354",
                                "text": "Der Illig trägt nie die Schals, die die Illig ihm strickt."
                            },
                            {
                                "example_id": "fb26d3bc-eb0b-42ef-a8d1-59d5b4cf7f01",
                                "sense_id": "695ca0a3-c826-305c-bf7e-e299b6703354",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Illig kommt, geht der Herr Illig.“"
                            },
                            {
                                "example_id": "cb174bda-be3a-45e6-a2fe-e613bfe7ce4c",
                                "sense_id": "695ca0a3-c826-305c-bf7e-e299b6703354",
                                "text": "Illig kommt und geht."
                            },
                            {
                                "example_id": "fa62c15c-7e4c-4e72-8ff4-18a4d165511f",
                                "sense_id": "695ca0a3-c826-305c-bf7e-e299b6703354",
                                "text": "Illigs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
