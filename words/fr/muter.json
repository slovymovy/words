                    "frequency": "High",
                    "semantic_group_id": "emploi",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après cinq ans dans cette agence, la direction a décidé de le <w>muter</w> à Lyon."
                        },
                        {
                            "text": "Mon collègue a demandé à être <w>muté</w> dans le sud pour se rapprocher de sa famille."
                        }
