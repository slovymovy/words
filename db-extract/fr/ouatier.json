                        "entry_id": "50c0ba87-1adf-32b6-b099-60d024e1d457",
                        "glosses": [
                            "Appareil employé pour la fabrication de ouate."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "21356ef6-1faa-3b66-b252-9d629f1b310c",
                        "entry_id": "50c0ba87-1adf-32b6-b099-60d024e1d457",
                        "glosses": [
                            "Arbre tropical également appelé fromager ou kapokier, produisant la fibre ouateuse appelée kapok."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ede9565b-12e0-4094-bd31-4676a3215f45",
                                "sense_id": "21356ef6-1faa-3b66-b252-9d629f1b310c",
                                "text": "L’ouatier de la seconde, ou pour mieux dire, de la troisième espèce, est beaucoup plus petit que les deux autres."
                            },
                            {
                                "example_id": "b425b77b-3175-4bd2-8456-62bc856a2866",
                                "sense_id": "21356ef6-1faa-3b66-b252-9d629f1b310c",
                                "text": "Comme les gousses du « Tulipier du Gabon », les gousses du « Ouatier » laissent échapper leur contenu."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "86ef9447-fe89-4434-b9d6-5beba37d0ad6",
                        "source_entry_id": "50c0ba87-1adf-32b6-b099-60d024e1d457",
                        "source_sense_description": "Arbre tropical",
                        "target_lang_word": "Kapokbaum",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kapokbaum",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "91ac280a-5f65-3d59-9664-ff6edf977844",
                                        "entry_id": "39c6d8aa-b94c-3a20-9191-598591f70ca3",
                                        "glosses": [
                                            "tropischer Baum aus der Ordnung der Malvenartigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "187bed04-c9e3-49ed-b605-37f97a334619",
                                                "sense_id": "91ac280a-5f65-3d59-9664-ff6edf977844",
                                                "text": "„An die vielen gnomartigen Gesichter seiner schattenhaften Bewohner kann ich mich nicht mehr erinnern, nur noch an einen uralten Kapokbaum, und bis auf dieses unheilvolle Negativ ist mein Geist blank.“"
                                            },
                                            {
                                                "example_id": "53a19b0b-a2f6-4d53-8c80-74cd9d9fed00",
                                                "sense_id": "91ac280a-5f65-3d59-9664-ff6edf977844",
                                                "text": "„Gentry fand eine dicke Ranke, die zu seiner Linken diagonal aus dem Fluss ragte, sich über das Ufer erstreckte und mit dem höchsten, am weitesten ausgestreckten Ast eines 60 Meter großen Kapokbaums verbunden war, der wie ein großer Arm über dem Fluss hing.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
