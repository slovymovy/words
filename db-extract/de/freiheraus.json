                                                "example_id": "d20de880-e623-4025-bcba-1eeabb11df4d",
                                                "sense_id": "182d1a54-46a4-3937-a90c-78e4ed72766e",
                                                "text": "With little effort they found dozens of outright lies."
                                            },
                                            {
                                                "example_id": "64fa9854-aa28-4e57-b323-a4cf848cb202",
                                                "sense_id": "182d1a54-46a4-3937-a90c-78e4ed72766e",
                                                "text": "He found a pattern of non-transparency and outright deception."
                                            }
                                        ]
