                        "examples": [
                            {
                                "example_id": "c23a02be-c181-4a3e-8cb3-71083aeb8736",
                                "sense_id": "9cd612c9-6db3-37e6-9af5-cd8b375779c8",
                                "text": "Die Airline steht wegen nicht ausreichender Sicherheitsstandards in der Kritik."
                            },
                            {
                                "example_id": "1a8897f4-4d44-447b-b091-3ec6a9a97de6",
                                "sense_id": "9cd612c9-6db3-37e6-9af5-cd8b375779c8",
                                "text": "„Also rief er doch nicht an und suchte stattdessen die Nummer der Airline raus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
