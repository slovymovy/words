                        "sense_id": "dae85281-ddec-30ef-ba8e-edf0e266e29b",
                        "entry_id": "133a701c-7fdf-3108-8141-bf2b1746a271",
                        "glosses": [
                            "über einen längeren Zeitraum anhaltende Hitze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "488d79f9-12d8-4a09-bdc3-e15b94c535cc",
                                "sense_id": "dae85281-ddec-30ef-ba8e-edf0e266e29b",
                                "text": "„Dauerhitze lässt Italiens Wasservorräte schwinden.“"
                            },
                            {
                                "example_id": "8f27767e-3fe1-4869-ab2c-ba95fbf29633",
                                "sense_id": "dae85281-ddec-30ef-ba8e-edf0e266e29b",
                                "text": "„Längere und häufigere Phasen von Dauerhitze und Starkregen sind für die betroffenen Regionen und Länder, für die dort lebenden Menschen, eine Herausforderung.“"
                            },
                            {
                                "example_id": "de8bccf1-9266-480c-b28c-7b7a12a1888e",
                                "sense_id": "dae85281-ddec-30ef-ba8e-edf0e266e29b",
                                "text": "„Die Dauerhitze im ganzen Gebäude im Winter wie im Sommer traf mich wie ein Schlag.“"
                            },
                            {
                                "example_id": "1b67d8a7-6800-4b7e-9e8e-33c19024ed5e",
                                "sense_id": "dae85281-ddec-30ef-ba8e-edf0e266e29b",
                                "text": "„Die Dauerhitze hat sich heute Nacht mit Blitz, Donner und Regen entladen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
