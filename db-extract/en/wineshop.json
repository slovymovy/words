                                            {
                                                "example_id": "c177ad3d-8a55-4b03-bf46-8de25dd663e7",
                                                "sense_id": "f3092029-5d88-3bc1-8808-55438acef238",
                                                "text": "„In einem Weinladen sitzt eine junge Frau und tippt eine Nachricht in ihr Smartphone.“"
                                            },
                                            {
                                                "example_id": "960cf433-3f27-45da-be7a-ce563d6ccc4c",
                                                "sense_id": "f3092029-5d88-3bc1-8808-55438acef238",
                                                "text": "„Wer im Mairais-Viertel den Blick offenhält, wird die Hauszeichen über den Geschäften bemerken: über dem Weinladen ein Bacchus, über dem Fleischerladen ein Ochsenkopf und so weiter, alles gearbeitet aus Kupfer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
