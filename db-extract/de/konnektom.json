                "senses": [
                    {
                        "sense_id": "2aa64250-d5da-3b43-9685-304ad66320c7",
                        "entry_id": "6c4c1230-b147-3bfc-87e1-5a9e57cf236c",
                        "glosses": [
                            "Gesamtheit aller Nervenverbindungen eines Lebewesens"
                        ],
                        "tags": [
                            "Neurowissenschaften"
                        ],
                        "examples": [
                            {
                                "example_id": "3e8e67a2-6030-43f7-83dc-ef73e2a1f33a",
                                "sense_id": "2aa64250-d5da-3b43-9685-304ad66320c7",
                                "text": "In seinem Buch „Das Konnektom''“ beschreibt der Informatiker und Neurowissenschaftler von der Princeton University den majestätischen Wald in unserem Schädel und behauptet: „Du bist dein Konnektom“."
                            },
                            {
                                "example_id": "109334b5-86a5-4f9f-95f0-3e4acc22a901",
                                "sense_id": "2aa64250-d5da-3b43-9685-304ad66320c7",
                                "text": "Ein Team der Connectomics-Abteilung am Frankfurter Max-Planck-Institut für Hirnforschung hat jetzt ein Verfahren namens SegEM entwickelt, mit dem die Analyse von Konnektomen um das mehr als Zehnfache beschleunigt wird."
                            },
                            {
                                "example_id": "3fb39875-cc95-444e-9cd1-c2a814007dba",
                                "sense_id": "2aa64250-d5da-3b43-9685-304ad66320c7",
                                "text": "Zudem entwickelten die Forscher das Spiel Brainflight, um beliebig vielen Menschen zu ermöglichen, an der Datenanalyse fürs Konnektom der Großhirnrinde teilzunehmen."
                            },
                            {
                                "example_id": "afa362df-cf25-4d7d-b354-bf1e943c75ae",
                                "sense_id": "2aa64250-d5da-3b43-9685-304ad66320c7",
                                "text": "„Wir haben es noch nicht geschafft, das menschliche Konnektom zu entschlüsseln, aber spezifische technische Entwicklungen in der Magnetresonanztomografie und Bildgebungssoftware stimmen uns zuversichtlich. … Es ist nun möglich, das Konnektom eines individuellen Patienten nicht-invasiv und äußerst schnell auf Millimeter-Ebene darzustellen“, führt Dr. Hagmann weiter aus."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "240ff3c7-0106-4757-89d4-ac34facb60a1",
                        "source_entry_id": "6c4c1230-b147-3bfc-87e1-5a9e57cf236c",
                        "source_sense_id": "2aa64250-d5da-3b43-9685-304ad66320c7",
                        "source_sense_description": "Gesamtheit aller Nervenverbindungen eines Lebewesens",
                        "target_lang_word": "connectome",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "connectome",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7598909e-fc2d-3e1b-b41f-d3e20082152a",
                                        "entry_id": "fc63ec5f-f54e-35a5-a152-d302647ce62c",
                                        "glosses": [
                                            "The complete mapping of the structural links in an organism's neural circuitry."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afd79ad8-65df-4143-bc4d-8cfb557ef0a6",
                                                "sense_id": "7598909e-fc2d-3e1b-b41f-d3e20082152a",
                                                "text": "The tools Seung and his colleagues have developed to map the connectome are beginning to offer important insights into these previously baffling conditions."
                                            },
                                            {
                                                "example_id": "016bb7c1-9950-437d-9348-a10d37c3a917",
                                                "sense_id": "7598909e-fc2d-3e1b-b41f-d3e20082152a",
                                                "text": "Creating a complete map of the human connectome would therefore be a monumental milestone but not the end of the journey to understanding how our brains work."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9484e57-81f9-401f-890f-2c4625c8de62",
                        "source_entry_id": "6c4c1230-b147-3bfc-87e1-5a9e57cf236c",
                        "source_sense_id": "2aa64250-d5da-3b43-9685-304ad66320c7",
                        "source_sense_description": "Gesamtheit aller Nervenverbindungen eines Lebewesens",
                        "target_lang_word": "connectome",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "connectome",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fe4fd166-d9bb-39b0-b8df-3062d8c9bbe1",
                                        "entry_id": "bcaf5081-7182-3242-991c-0511b0321f1f",
                                        "glosses": [
                                            "Plan complet des connexions neuronales dans un cerveau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78980cb3-e80e-42cc-9ecd-7b0e0884b3a1",
                                                "sense_id": "fe4fd166-d9bb-39b0-b8df-3062d8c9bbe1",
                                                "text": "La plastination de son cerveau vise à le fixer tel qu’il est à un instant T pour en dresser un connectome complet."
                                            },
                                            {
                                                "example_id": "6dbc1a79-523c-4cd4-bf2d-f26ab660ba4a",
                                                "sense_id": "fe4fd166-d9bb-39b0-b8df-3062d8c9bbe1",
                                                "text": "Très rapidement : on a une connexion, un connectome ; par exemple dans votre cerveau vous avez un connectome, Charline, maintenant, et là vous êtes dans un état… vous êtes consciente, vous êtes drôle, pleine d’esprit, marrante, et cétéra ; mais vous aurez le même quand vous serez en sommeil profond, totalement inconsciente cette nuit. Ce que je veux dire par là, c’est que le connectome ne suffit pas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
