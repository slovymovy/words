                ],
                "senses": [
                    {
                        "sense_id": "cd8e2988-cca5-3560-8448-82ba771b31fe",
                        "entry_id": "8529de73-c116-317a-a3d0-2623da693868",
                        "glosses": [
                            "Boire à son litron, s’enivrer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9bf6a86-bd61-4591-b32e-9803f0eebfef",
                                "sense_id": "cd8e2988-cca5-3560-8448-82ba771b31fe",
                                "text": "Elle, même si c'est triste et pas reluisant, elle pense souvent à la poussière de chez elle, à ses hortensias, à Maman Cox en train de litroner sous la véranda."
                            },
                            {
                                "example_id": "cc0f51cb-be62-4cd5-8ca2-c7c3eeb2ba59",
                                "sense_id": "cd8e2988-cca5-3560-8448-82ba771b31fe",
                                "text": "Je profite de cette information pour m’éclipser, aller prendre une bonne douche, me faire dégueuler et m’envoyer un verre de whisky tourbé afin de faire disparaître de mon palais le goût écœurant et salé des saloperies que je viens de litroner."
                            }
                        ]
                    }
                ],
