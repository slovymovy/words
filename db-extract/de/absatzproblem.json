                "senses": [
                    {
                        "sense_id": "5ba4cafe-6b29-3b3e-987c-4ac32bf294f4",
                        "entry_id": "c8066e23-63e6-354c-9260-1af3ce24848a",
                        "glosses": [
                            "die Schwierigkeit ein Produkt zu verkaufen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "448b0952-bce5-4a52-acdd-a41d7ba99dfb",
                                "sense_id": "5ba4cafe-6b29-3b3e-987c-4ac32bf294f4",
                                "text": "„Die amerikanischen Firmen hatten starke Absatzprobleme, es erschienen einige „Mutationsgeräte“, die versuchten, Flipper und Bildschirmspiel zu kombinieren.“"
                            },
                            {
                                "example_id": "492c4dd6-4002-4e48-bd2e-9891a137659a",
                                "sense_id": "5ba4cafe-6b29-3b3e-987c-4ac32bf294f4",
                                "text": "„Mit dem Ölpreisschock war eine enorme Steigerung der Energiekosten verbunden, die der Stahlindustrie zusätzliche Probleme bereitete. […] Der zunehmende Einsatz von Ersatzmaterialien, etwa keramische Werkstoffe oder Kunststoffe, steigerte das Absatzproblem noch.“"
                            },
                            {
                                "example_id": "840e6b5e-6bc8-4ed3-957b-9822a3bcc9a1",
                                "sense_id": "5ba4cafe-6b29-3b3e-987c-4ac32bf294f4",
                                "text": "„Die Tankstellen haben derzeit massive Absatzprobleme bei E10, stattdessen tanken die Autofahrer teureres Super Plus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
