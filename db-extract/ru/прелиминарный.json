                                                "example_id": "1ee4f125-a349-4b4b-8871-cdd2d294b18f",
                                                "sense_id": "7f37c5d2-6902-3cb6-87a3-981b74e6b1bd",
                                                "text": "Préliminaire de conciliation : essai de conciliation prescrit par la loi avant de commencer un procès."
