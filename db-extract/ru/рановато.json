                        "examples": [
                            {
                                "example_id": "b3ccd4d2-71fe-4ebc-b22f-8f8a2e33b93a",
                                "sense_id": "bd78e104-f75e-32ad-933c-8fd7df21c0b4",
                                "text": "Исчез стиснувший ухо капкан, и пёс счёл, что рановато признал себя побеждённым."
                            }
                        ]
                    },
                    {
