                "senses": [
                    {
                        "sense_id": "f32111df-a56a-3994-9dd1-c3657f4b5712",
                        "entry_id": "ee9ea7c1-45b0-3926-9729-34bf453494f7",
                        "glosses": [
                            "onrust veroorzakend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f27bf7f2-15fa-4d5f-9d02-80f23e3dc355",
                                "sense_id": "f32111df-a56a-3994-9dd1-c3657f4b5712",
                                "text": "Ik vind dat toch wel een verontrustende ontwikkeling."
                            },
                            {
                                "example_id": "31f57828-b525-4537-86bd-4151263643db",
                                "sense_id": "f32111df-a56a-3994-9dd1-c3657f4b5712",
                                "text": "Ik slaap al een hele poos niet goed, niet meer dan een paar rusteloze uren per nacht. Ik lig wakker in het donker, omgeven door een knisperende stilte, nee geen stilte, maar een verontrustende rust."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c87041ab-4e9a-4039-b4e2-5ea82c631874",
                        "source_entry_id": "ee9ea7c1-45b0-3926-9729-34bf453494f7",
                        "source_sense_id": "f32111df-a56a-3994-9dd1-c3657f4b5712",
                        "source_sense_description": "onrust veroorzakend",
                        "target_lang_word": "inquietante",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inquietante",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "92d3e901-1450-3273-89fa-ab5783e2742f",
                                        "entry_id": "bec1634a-c8bd-3b0b-b43a-ad85d0022aa8",
                                        "glosses": [
                                            "Que inquieta."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5736cdd6-46ab-42d3-bceb-69b2321f8ced",
                                                "sense_id": "92d3e901-1450-3273-89fa-ab5783e2742f",
                                                "text": "«Las nuevas que Lucía le daba eran en sustancia siempre las mismas, si bien más inquietantes cada vez»."
                                            },
                                            {
                                                "example_id": "3f4a3c4d-516d-4428-b1cd-faedf581288c",
                                                "sense_id": "92d3e901-1450-3273-89fa-ab5783e2742f",
                                                "text": "«El tratado de Berlín había devuelto a la Inglaterra su vieja preponderancia en el continente. Fue un triunfo diplomático capital de lord Beaconsfield. La Rusia satisfizo todas sus exigencias; la Turquía abandonó su actitud inquietante. Los negocios políticos y militares de la India recibieron el impulso enérgico de un espíritu valiente que conocía el pueblo que gobernaba, parecía que la Inglaterra volvía por sus tradiciones»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
