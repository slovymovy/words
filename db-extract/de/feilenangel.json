                        "entry_id": "5a33ff34-74bc-3438-817c-c09a816a8fb8",
                        "glosses": [
                            "spitz zulaufender Teil eines Feilen-Rohlings, der der Befestigung im Feilenheft (Griff) dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e82d94a5-b8cf-467c-b6de-7ace81f253e4",
                                "sense_id": "1ce1bdd6-e8fd-3822-924c-dddde1a20c40",
                                "text": "Der Feilenrohling besteht aus [dem] gehärteten Feilenblatt und der spitz auslaufenden Feilenangel."
                            },
                            {
                                "example_id": "728af4a5-b0ad-40b0-800b-e0928a8b0b9c",
                                "sense_id": "1ce1bdd6-e8fd-3822-924c-dddde1a20c40",
                                "text": "Die Feilen haben eine Angel, deren Spitze zur Befestigung im Feilenheft dient, das für die Angel vorgebohrt ist. In der Regel ist dieses Loch aber für die Feilenangel viel zu klein."
                            }
                        ],
