                ],
                "senses": [
                    {
                        "sense_id": "67c73bfb-7df4-3659-ae17-22f0fe340c34",
                        "entry_id": "ede094b2-1b30-352c-999f-d59d6496c802",
                        "glosses": [
                            "einer bestimmten Krone (König- oder Kaisertum) zugehöriges Land"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b81fe4a8-003a-4224-bacf-2ca80da1ce11",
                                "sense_id": "67c73bfb-7df4-3659-ae17-22f0fe340c34",
                                "text": "„Die erste Wenzelsbad-Veranstaltung ging sofort auf die nationalen Ziele der Tschechen los, indem sie die Sicherstellung der böhmischen Nationalität in allen Kronländern Böhmens und vor allem die vollkommene Gleichstellung beider Sprachen in Schule und Amt zur Forderung erhob.“"
                            },
                            {
                                "example_id": "93670dc4-ae77-4f6f-aacc-9370ae5cdb27",
                                "sense_id": "67c73bfb-7df4-3659-ae17-22f0fe340c34",
                                "text": "„Österreich erhielt durch die Teilungen Polens mit den neu geschaffenen Kronländern Galizien und Lodomerien Gebiete mit einer starken jüdischen Bevölkerung, die die Zahl der in den anderen Reichsteilen ansässigen Juden bei weitem überstieg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cb18647d-871c-4d49-8013-1b9a964bba4e",
                        "source_entry_id": "ede094b2-1b30-352c-999f-d59d6496c802",
                        "source_sense_id": "67c73bfb-7df4-3659-ae17-22f0fe340c34",
                        "source_sense_description": "einer bestimmten Krone (König- oder Kaisertum) zugehöriges Land",
                        "target_lang_word": "royaume",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "royaume",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b6da921d-c158-34fa-81f1-d6c71a57d6f6",
                                        "entry_id": "e7155aa7-67b4-3211-ba15-d433aa6c9043",
                                        "glosses": [
                                            "Pays dirigé par un roi ou une reine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5eefff2f-61cc-4c77-93f4-8da746b6fd06",
                                                "sense_id": "b6da921d-c158-34fa-81f1-d6c71a57d6f6",
                                                "text": "Si vous l’eussiez voulu, pour vous, j’aurais pu conquérir des royaumes."
                                            },
                                            {
                                                "example_id": "2bd7108f-6cf0-4d3e-83df-c5d28332c8e3",
                                                "sense_id": "b6da921d-c158-34fa-81f1-d6c71a57d6f6",
                                                "text": "Si le déporté rentre sur le territoire du Royaume, il sera, sur la seule preuve de son identité, condamné aux travaux forcés à perpétuité."
                                            },
                                            {
                                                "example_id": "cd01c989-7f9e-45ed-a0f4-db5702b3804c",
                                                "sense_id": "b6da921d-c158-34fa-81f1-d6c71a57d6f6",
                                                "text": "Le tarif des droits à percevoir sur les marchandises transportées par le Rhin , sera réglé de manière , que la totalité du droit à payer entre Strasbourg et la frontière du Royaume des Pays-Bas soit , en remontant, de deux francs , et en descendant, d'un franc trente-trois centimes par quintal, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71d6f8e1-c560-311d-b1bb-92ff0cf8f179",
                                        "entry_id": "e7155aa7-67b4-3211-ba15-d433aa6c9043",
                                        "glosses": [
                                            "Régime politique d'un tel pays."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c30d2488-780e-4ab8-a4b6-c8f96858dd89",
                                                "sense_id": "71d6f8e1-c560-311d-b1bb-92ff0cf8f179",
                                                "text": "Selon la Charte, le royaume constitutionnel a seul des droits de cité. Ses colonies sont toutes des États, sujets du royaume constitutionnel ; elles sont toutes soumises à l'autorité législative absolue du Roi et des deux Chambres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59e3a72c-ad76-39cc-b329-51678945ad18",
                                        "entry_id": "e7155aa7-67b4-3211-ba15-d433aa6c9043",
                                        "glosses": [
                                            "Lieu de béatitude posthume ; paradis."
                                        ],
                                        "tags": [],
                                        "note": "Il reçoit alors toujours un qualificatif désignant une personne de grande sainteté (Le royaume des cieux, de Dieu, de Jésus-Christ, des saints, etc",
                                        "examples": [
                                            {
                                                "example_id": "9bec5a45-c179-4c74-9f20-884f265cea83",
                                                "sense_id": "59e3a72c-ad76-39cc-b329-51678945ad18",
                                                "text": "Les premiers chrétiens attendaient le retour du Christ et la ruine totale du monde païen, avec l'instauration du royaume des saints, pour la fin de la première géné­ration. La catastrophe ne se produisit pas, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48dd99ec-a342-3d03-a4d7-258e10daaf38",
                                        "entry_id": "e7155aa7-67b4-3211-ba15-d433aa6c9043",
                                        "glosses": [
                                            "Domaine ou endroit propre à une personne, à un animal, à une chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "695e988b-46ac-41da-9df4-a207ac33c735",
                                                "sense_id": "48dd99ec-a342-3d03-a4d7-258e10daaf38",
                                                "text": "Véritablement, on se trouvait ici bien en retrait du monde, dans un royaume de silence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7b54604-a579-315e-bc9f-0ebdd76f950e",
                                        "entry_id": "e7155aa7-67b4-3211-ba15-d433aa6c9043",
                                        "glosses": [
                                            "Brioche aux fruits confits, en forme de couronne, traditionnellement consommée à l’Épiphanie."
                                        ],
                                        "tags": [
                                            "Midi de la France"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
