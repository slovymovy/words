    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "689356ca-f942-3217-bd58-11fd3a55c524",
                    "sense_definition": "Partie courbée d'une route ou d'une voie de circulation qui impose un changement de direction.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "route",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La voiture a ralenti avant d'aborder un <w>virage</w> particulièrement serré."
                        },
                        {
                            "text": "Faites attention sur cette route de montagne, car chaque <w>virage</w> manque de visibilité."
                        }
                    ],
                    "synonyms": [
                        "tournant"
                    ],
                    "common_phrases": [
                        "virage serré",
                        "virage dangereux",
                        "prendre un virage"
                    ]
                },
                {
                    "sense_id": "37f178a8-c24e-3e0e-92ac-0d9b719f0243",
                    "sense_definition": "Mouvement par lequel un conducteur ou un pilote fait changer de direction à son véhicule.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le motard a parfaitement négocié son <w>virage</w> pour dépasser ses concurrents."
                        },
                        {
                            "text": "Le conducteur a raté son <w>virage</w> et a terminé sa course sur le bas-côté."
                        }
                    ],
                    "common_phrases": [
                        "rater son virage",
                        "négocier un virage"
                    ]
                },
                {
                    "sense_id": "4622514c-e9e6-302a-9ea5-b69a3fcbfe12",
                    "sense_definition": "Changement notable et souvent soudain d'orientation, de ligne politique ou de stratégie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "changement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette entreprise a amorcé un <w>virage</w> stratégique vers les technologies vertes."
                        },
                        {
                            "text": "Le gouvernement a opéré un <w>virage</w> inattendu dans sa politique budgétaire."
                        }
                    ],
                    "synonyms": [
                        "tournant"
                    ],
                    "common_phrases": [
                        "virage à 180 degrés",
                        "virage stratégique",
                        "amorcer un virage"
                    ]
                },
                {
                    "sense_id": "2491aa95-0ed7-31dd-902b-cdbad9d72ddc",
                    "sense_definition": "Partie incurvée des tribunes d'un stade, située derrière les buts.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les supporters les plus fervents s'étaient rassemblés dans le <w>virage</w> sud du stade."
                        },
                        {
                            "text": "Des chants continus montaient du <w>virage</w> pour encourager les joueurs locaux."
                        }
                    ],
                    "common_phrases": [
                        "virage sud",
                        "virage nord"
                    ]
                },
                {
                    "sense_id": "5ff099be-833e-3ec4-ac24-93ed2397c570",
                    "sense_definition": "Traitement chimique d'une épreuve photographique visant à en modifier la teinte ou à en assurer la conservation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artiste a choisi un <w>virage</w> à l'or pour rehausser les contrastes de sa photographie."
                        },
                        {
                            "text": "L'étape du <w>virage</w> permet d'obtenir des tons sépia très recherchés."
                        }
                    ],
                    "common_phrases": [
                        "virage sépia",
                        "virage à l'or"
                    ]
                }
            ]
        }
    ]
