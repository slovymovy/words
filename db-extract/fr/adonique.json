                                        "entry_id": "d53e2615-94fc-307d-aaa6-6b50fcb707ce",
                                        "glosses": [
                                            "Que pertenece o concierne a Adonis o a los adonis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f16db92-175c-4873-8cd9-29059e3d347b",
