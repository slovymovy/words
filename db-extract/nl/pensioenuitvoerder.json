                        "examples": [
                            {
                                "example_id": "0f552b23-78cc-4397-889a-941b0eb10f77",
                                "sense_id": "f39b5af6-d4c2-3fec-a063-71b2e99643e9",
                                "text": "Zo is pensioenuitvoerder Syntrus Achmea - die voor verschillende institutionele partijen beleggingen doet - eigenaar van het studiocomplex Villa Mokum in Amsterdam en het studentencomplex De Next Level in Delft."
                            },
                            {
                                "example_id": "7c9d23e4-32b1-4bac-a0f6-ab3d6dfd86d0",
                                "sense_id": "f39b5af6-d4c2-3fec-a063-71b2e99643e9",
                                "text": "ABP heeft een vermogen van 381 miljard euro. Pensioenuitvoerder APG beheert dat vermogen en belegt een deel."
                            },
                            {
                                "example_id": "e8b8c604-0892-4e56-9e1b-1b5927afd0a7",
                                "sense_id": "f39b5af6-d4c2-3fec-a063-71b2e99643e9",
                                "text": "Zo'n 1400 zaken zijn door institutionele beleggers als pensioenfondsen en kleine beleggers uit zowel Duitsland als het buitenland aangespannen tegen de autofabrikant. De beleggers zeggen veel geld te hebben verloren door het schandaal. Ook pensioenuitvoerder APG heeft zich gemeld bij de rechter."
                            }
                        ]
                    }
