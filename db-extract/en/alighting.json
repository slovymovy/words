                        "examples": [
                            {
                                "example_id": "619639a9-c6b4-4106-98d0-a9c849f54c4e",
                                "sense_id": "3992205d-8c3d-39bd-b3ca-bfd1ec61752c",
                                "text": "The Eagles are a dangerous 'machine'. I have used them sparingly, and that is the absolute limit of their credibility or usefulness. The alighting of a Great Eagle of the Misty Mountains in the Shire is absurd; it also makes the later capture of G. by Saruman incredible, and spoils the account of his escape."
                            },
                            {
                                "example_id": "ac3e7005-0087-46ec-9afc-c37f9de9cda0",
                                "sense_id": "3992205d-8c3d-39bd-b3ca-bfd1ec61752c",
                                "text": "We compared the frequencies of alightings on hosts with those predicted from random transect data."
                            },
                            {
                                "example_id": "99327b06-934e-4481-8ef1-435c5c0414a7",
                                "sense_id": "3992205d-8c3d-39bd-b3ca-bfd1ec61752c",
                                "text": "Load profiles are a standard analysis tool showing passenger activity (boardings, alightings) and passenger load at each stop along a route in a single direction."
                            }
                        ]
                    }
