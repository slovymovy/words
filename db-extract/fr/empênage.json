                        "entry_id": "36a95ceb-31d5-3606-9ffe-ea5927bb8887",
                        "glosses": [
                            "Mortaise ou ouverture dans une gâche qui reçoit le pêne d’une serrure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2d12236-b206-48c4-a488-68409c34585b",
                                "sense_id": "2fd19d9d-7bcb-31f1-9805-77021417b40a",
                                "text": "Gâche, s. f. — Pièce de fer que l’on fixe sur un bâti ou au chambranle d’une porte pour recevoir, dans un trou qu’on appelle empênage, le péne d’une serrure, d’un verrou, d’une targette, etc."
                            },
                            {
                                "example_id": "ba98d3bf-4b78-42b6-ad09-1d83d5fdf302",
                                "sense_id": "2fd19d9d-7bcb-31f1-9805-77021417b40a",
                                "text": "Arrivé à la porte, j’écoutais un instant avant de sonner ; la porte ayant du jeu dans l’empênage de la serrure, bougeait."
                            },
                            {
                                "example_id": "4988acaa-c93e-4f6f-a88e-68c334313142",
                                "sense_id": "2fd19d9d-7bcb-31f1-9805-77021417b40a",
                                "text": "Une gâche à double empênage."
                            },
                            {
                                "example_id": "faaf7b96-b187-4a35-b23d-4c6becc7b6b1",
                                "sense_id": "2fd19d9d-7bcb-31f1-9805-77021417b40a",
                                "text": "Une gâche à empênage central."
                            }
                        ]
                    }
