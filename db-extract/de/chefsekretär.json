                        "cross_references": [
                            {
                                "target_word": "secrétaire de direction",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "175ec54c-ce78-3d42-8aa6-a9fd2ae5fab6",
                                        "entry_id": "65aa5ed6-9f92-3b83-a295-aaf3a3f7b1f8",
                                        "glosses": [
                                            "Personne chargée d’assister dans sa fonction de direction un chef d’entreprise ou un cadre supérieur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ffdd7b2-3f7b-45dc-83a2-9a35d98cd752",
                                                "sense_id": "175ec54c-ce78-3d42-8aa6-a9fd2ae5fab6",
                                                "text": "En janvier 1893, George Auriol est encore secrétaire de direction, puis rédacteur en chef sous l’autorité d’un nouveau directeur, Émile Boucher, qui vient d’acheter le Chat noir."
                                            },
                                            {
                                                "example_id": "a481fc0a-3df9-4b05-875f-aeb4b4cf5ac2",
                                                "sense_id": "175ec54c-ce78-3d42-8aa6-a9fd2ae5fab6",
                                                "text": "Plus diplômé et expérimenté que les autres secrétaires, le secrétaire de direction ou asistant(e) de direction est la personne de confiance d’un ou de plusieurs directeurs."
                                            },
                                            {
                                                "example_id": "de450d1e-5b7a-425a-8afb-c47c031e77a1",
                                                "sense_id": "175ec54c-ce78-3d42-8aa6-a9fd2ae5fab6",
                                                "text": "Le métier d’assistant de direction ou secrétaire de direction, consiste à assurer le fonctionnement administratif d'une structure. Il s’agit du bras droit du boss !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
