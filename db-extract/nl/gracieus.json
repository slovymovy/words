                "senses": [
                    {
                        "sense_id": "c757b789-a705-3f92-8bed-425a0019f83c",
                        "entry_id": "00d40f42-6eeb-39ba-bc7a-fbe671e98c01",
                        "glosses": [
                            "sierlijk, elegant, bekoorlijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2abebe99-1194-470f-b5e9-a05170787306",
                                "sense_id": "c757b789-a705-3f92-8bed-425a0019f83c",
                                "text": "De mannequin werd direct herkend aan haar gracieuze manier van lopen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61a74373-cf6d-4977-80c1-df2b5053d35a",
                        "source_entry_id": "00d40f42-6eeb-39ba-bc7a-fbe671e98c01",
                        "source_sense_id": "c757b789-a705-3f92-8bed-425a0019f83c",
                        "target_lang_word": "graceful",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "graceful",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be110a37-88f6-3787-b1d4-aa4fbd632f8e",
                                        "entry_id": "abae5bbb-b114-3337-9d3d-1945240c5d90",
                                        "glosses": [
                                            "Having or showing grace in movement, shape, or proportion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "963ae05c-65c8-43df-abdc-c0ab7fc39abf",
                                                "sense_id": "be110a37-88f6-3787-b1d4-aa4fbd632f8e",
                                                "text": "She is a graceful dancer."
                                            },
                                            {
                                                "example_id": "81e27dfb-f8f9-489e-a011-5c0d51f8c609",
                                                "sense_id": "be110a37-88f6-3787-b1d4-aa4fbd632f8e",
                                                "text": "The half-dozen pieces […] were painted white and carved with festoons of flowers, birds and cupids. […] The bed was the most extravagant piece. Its graceful cane halftester rose high towards the cornice and was so festooned in carved white wood that the effect was positively insecure, as if the great couch were trimmed with icing sugar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da074836-c5f3-37c0-9933-ce50e91594ed",
                                        "entry_id": "abae5bbb-b114-3337-9d3d-1945240c5d90",
                                        "glosses": [
                                            "Magnanimous, lacking arrogance or complaint; gracious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d800f4d1-c283-436a-9b54-59dede20b837",
                                                "sense_id": "da074836-c5f3-37c0-9933-ce50e91594ed",
                                                "text": "The athlete's graceful acceptance of the controversial second-place finish won the admiration of the spectators."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76fbaf14-6bf5-3592-af3f-57ec6ba32c06",
                                        "entry_id": "abae5bbb-b114-3337-9d3d-1945240c5d90",
                                        "glosses": [
                                            "Gradual and non-disruptive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db2cb6c6-f573-46fe-aa1e-a439ec2b9fe7",
                                                "sense_id": "76fbaf14-6bf5-3592-af3f-57ec6ba32c06",
                                                "text": "Bringing a system down cleanly will preserve the operating system and some log files, but again will destroy the contents of the RAM (the volatile data). Windows and Linux are two operating systems that require a graceful shutdown."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "037d437e-e482-4df8-8058-e62649eabb28",
                        "source_entry_id": "00d40f42-6eeb-39ba-bc7a-fbe671e98c01",
                        "source_sense_id": "c757b789-a705-3f92-8bed-425a0019f83c",
                        "target_lang_word": "gracieux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gracieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "55793a06-90ee-3940-b085-4f67ec4b27eb",
                                        "entry_id": "9bc660a4-54ec-3bde-9878-91992b1c0756",
                                        "glosses": [
                                            "Qui a beaucoup de grâce et d’agrément."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3532bc76-a2e8-4ebd-96c5-90d84aceb987",
                                                "sense_id": "55793a06-90ee-3940-b085-4f67ec4b27eb",
                                                "text": "Rien de gracieux comme ses mouvements d’épaules, lorsqu’elle attire le menton pour se cacher entièrement la figure, qui, par instants, se montre à la dérobée."
                                            },
                                            {
                                                "example_id": "ca8338c1-ebbc-433b-a00e-7421c49a1659",
                                                "sense_id": "55793a06-90ee-3940-b085-4f67ec4b27eb",
                                                "text": "Au reste, tout ce que j’aperçus de sa personne était gracieux et distingué."
                                            },
                                            {
                                                "example_id": "fbe90285-db44-49f8-8f1f-04dd6ec9f95e",
                                                "sense_id": "55793a06-90ee-3940-b085-4f67ec4b27eb",
                                                "text": "La profusion de détails gracieux ne nuit en rien à l’ensemble qui conserve toute sa majesté."
                                            },
                                            {
                                                "example_id": "dbee7484-c281-41c5-b686-2b2686616083",
                                                "sense_id": "55793a06-90ee-3940-b085-4f67ec4b27eb",
                                                "text": "On pourra songer aussi au déhanché gracieux que Musset arbore, par exemple, dans le célèbre dessin de Devéria […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74b19a5f-8a2b-3a2d-aec4-8df561de7ce2",
                                        "entry_id": "9bc660a4-54ec-3bde-9878-91992b1c0756",
                                        "glosses": [
                                            "Qui est agréable, aimable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6413596-3e34-4f05-985a-480a5ef92eea",
                                                "sense_id": "74b19a5f-8a2b-3a2d-aec4-8df561de7ce2",
                                                "text": "On ne pouvait rien voir de plus gracieux que cette svelte blondine, jeune, gaie, folâtre ; pas un homme qui eût résisté à ses agaceries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3d4521d-bfe7-31cd-804f-673177fc29e8",
                                        "entry_id": "9bc660a4-54ec-3bde-9878-91992b1c0756",
                                        "glosses": [
                                            "Qui est accordé bénévolement sans exiger aucune rétribution en retour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a6df2ae-20df-4c3e-8489-dd8087fa77d8",
                                                "sense_id": "c3d4521d-bfe7-31cd-804f-673177fc29e8",
                                                "text": "Ces acteurs ont prêté un concours gracieux à cette fête de charité. - Il a joué, il a chanté à titre gracieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c847577-290f-33e4-abf3-0555543752e1",
                                        "entry_id": "9bc660a4-54ec-3bde-9878-91992b1c0756",
                                        "glosses": [
                                            "Relatif à Grâces, commune française située dans le département des Côtes-d’Armor."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
