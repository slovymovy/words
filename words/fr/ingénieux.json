            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1a0506b6-b47f-373b-a3d9-faf1c1b55b18",
                    "sense_definition": "Qui témoigne d'une grande inventivité, d'adresse ou d'originalité dans sa conception.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "inventivité",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artisan a mis au point un système <w>ingénieux</w> pour recycler l'eau de pluie dans son atelier."
                        },
                        {
                            "text": "Elle a proposé une solution <w>ingénieuse</w> pour réorganiser facilement les petits espaces de travail."
                        }
                    ],
                    "synonyms": [
                        "astucieux",
                        "inventif",
                        "habile"
                    ],
                    "antonyms": [
                        "maladroit",
                        "rudimentaire"
                    ],
                    "common_phrases": [
                        "système ingénieux",
                        "idée ingénieuse",
                        "solution ingénieuse"
                    ]
                },
                {
                    "sense_id": "008b7f8e-d952-38a4-9f6d-8cfdc43f76df",
                    "sense_definition": "Qui a l'esprit inventif et fait preuve de ressource ou d'adresse face aux difficultés.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "inventivité",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet élève très <w>ingénieux</w> trouve toujours une méthode originale pour surmonter les problèmes techniques."
                        },
                        {
                            "text": "Face au manque d'outils adaptés, le mécanicien s'est montré particulièrement <w>ingénieux</w> pour réparer la machine."
                        }
                    ],
                    "synonyms": [
                        "astucieux",
                        "débrouillard",
                        "inventif"
                    ],
                    "antonyms": [
                        "borné",
                        "maladroit"
                    ],
                    "common_phrases": [
                        "esprit ingénieux"
                    ]
                },
                {
                    "sense_id": "f3f34950-c6f5-3181-b314-146a15812b43",
                    "sense_definition": "Qui déploie une habileté subtile, parfois retorse, pour parvenir à un but particulier.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "habileté",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat s'est montré très <w>ingénieux</w> à déceler les contradictions dans les dépositions des témoins."
                        },
                        {
                            "text": "Ce débatteur redoutable est particulièrement <w>ingénieux</w> à détourner les critiques de ses adversaires."
