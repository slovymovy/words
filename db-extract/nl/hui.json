                                "sense_id": "3fe1b914-dcd7-32b3-8842-e841f4f97c66",
                                "text": "Hui is een bijproduct van het maken van kaas.",
                                "translation": "Whey is a side product of cheese production.",
                                "english": "Whey is a side product of cheese production."
                            },
                            {
                                "example_id": "12d9925d-e977-4cf0-b647-781356eb0f03",
                                "sense_id": "3fe1b914-dcd7-32b3-8842-e841f4f97c66",
                                "text": "Wy aten een potje karmelck …, en droncken een toochje huy…",
                                "translation": "We ate a jar of buttermilk porridge…, and drank a swig of whey…",
                                "english": "We ate a jar of buttermilk porridge…, and drank a swig of whey…"
                            },
                            {
