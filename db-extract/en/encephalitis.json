                    {
                        "translation_id": "3b4916dc-ebfb-43de-b004-54687e5ad0e7",
                        "source_entry_id": "520034d3-af3a-3a9d-9056-b25206f63967",
                        "source_sense_id": "0540b83f-d2b2-3ffa-8755-616dc7748d36",
                        "source_sense_description": "inflammation of the brain",
                        "target_lang_word": "encéphalite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "encéphalite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b1a9e2d1-cebb-3b66-8ba8-8ac7bb2260da",
                                        "entry_id": "efddc66e-b9d8-3fe4-8ef0-f8ab7591f97c",
                                        "glosses": [
                                            "Maladie inflammatoire de l’encéphale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89ecab35-266b-477e-85bb-28230cd02d09",
                                                "sense_id": "b1a9e2d1-cebb-3b66-8ba8-8ac7bb2260da",
                                                "text": "Telles furent ces deux années de travail intérieur, que je ne peux comparer qu’à une violente encéphalite, durant laquelle toutes les autres fonctions de la vie furent suspendues en moi."
                                            },
                                            {
                                                "example_id": "893c49b0-3ba6-499b-ba67-02d5dd3793bf",
                                                "sense_id": "b1a9e2d1-cebb-3b66-8ba8-8ac7bb2260da",
                                                "text": "[…] retrouvant mes premières sensations de jeune étudiant, cette griserie de la connaissance que Renan, qui l’a bien décrite, appelait plaisamment son « encéphalite »."
                                            },
                                            {
                                                "example_id": "b816d497-c736-44d2-b541-3ccace0abdc1",
                                                "sense_id": "b1a9e2d1-cebb-3b66-8ba8-8ac7bb2260da",
                                                "text": "Les médecins parlèrent de méningite, d’encéphalite, on ne sut rien de précis."
                                            },
                                            {
                                                "example_id": "4752ecdc-6de1-4aaf-b47d-fd5ef85c53d8",
                                                "sense_id": "b1a9e2d1-cebb-3b66-8ba8-8ac7bb2260da",
                                                "text": "On connaît plus de 300 arbovirus, et on en isole toujours de nouveaux. […]. Parmi les infections qu'ils provoquent, il faut citer à cause de leur grande incidence et de leur gravité la fièvre jaune, les méningo-encéphalites américaines, l’encéphalite japonaise B."
                                            },
                                            {
                                                "example_id": "752c1171-d4e0-49ef-a52c-48805d976eda",
                                                "sense_id": "b1a9e2d1-cebb-3b66-8ba8-8ac7bb2260da",
                                                "text": "Résultat des courses : en France, 24 000 cas officiellement déclarés, sans doute le double en réalité, 1 000 pneumonies, plus de 30 encéphalites rougeoleuses et 10 décès, peut-être 15."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f5ea2fff-3bb5-40d6-b40d-6348b6ba6de2",
                        "source_entry_id": "520034d3-af3a-3a9d-9056-b25206f63967",
                        "source_sense_id": "0540b83f-d2b2-3ffa-8755-616dc7748d36",
                        "source_sense_description": "inflammation of the brain",
                        "target_lang_word": "Enzephalitis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Enzephalitis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "88359f96-8928-3ddb-bca5-fe804dd381b0",
                                        "entry_id": "34cc6abb-776a-33a4-9a57-7c2362bc50ad",
                                        "glosses": [
                                            "Entzündung, Erkrankung des Gehirns"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "419548d5-93a4-40b3-8c02-01be3e2e0d95",
                                                "sense_id": "88359f96-8928-3ddb-bca5-fe804dd381b0",
                                                "text": "Er ist an Enzephalitis erkrankt."
                                            },
                                            {
                                                "example_id": "6601f62f-7cb2-4289-b5bd-c4f3898c939d",
                                                "sense_id": "88359f96-8928-3ddb-bca5-fe804dd381b0",
                                                "text": "„Der Doktor erklärte uns heute bei der Visite, wie die Zunge bei dieser Enzephalitis aussieht.“"
                                            },
                                            {
                                                "example_id": "1e538d48-9949-4a4a-90cf-ddef95802842",
                                                "sense_id": "88359f96-8928-3ddb-bca5-fe804dd381b0",
                                                "text": "„Kurz danach traf Mugabe ein Schicksalsschlag, als Ende 1966 sein dreijähriger Sohn Nhamodzenyika in Ghana plötzlich an Enzephalitis starb.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9317a31-2ebc-44c2-a8d9-888df124bcaf",
                        "source_entry_id": "520034d3-af3a-3a9d-9056-b25206f63967",
