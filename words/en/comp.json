                {
                    "sense_id": "70ca2b29-73a8-3092-9292-675dab9c307a",
                    "sense_definition": "Clipping of <w>compensation</w>, especially financial payment for injury or loss.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "compensation_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He received payments from workers' <w>comp</w> while he recovered from his back injury.",
