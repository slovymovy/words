                                        "entry_id": "bedf1ac5-74ee-36b2-9bad-3fe0a14359e3",
                                        "glosses": [
                                            "A thing on which something turns; specifically a metal pointed pin or short shaft in machinery, such as the end of an axle or spindle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a8f4efc-19bc-4ee6-95af-122e70e54b4f",
                                                "sense_id": "8b517850-2f36-3042-9b86-f6508c137039",
                                                "text": "The weight of the body and the traction and braking forces are taken by the conventional dished bogie centre pivot with phosphor-bronze liner; this type of centre pivot facilitates passage over marshalling yard humps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5856c10-86dd-3670-940f-bded194722ff",
                                        "entry_id": "bedf1ac5-74ee-36b2-9bad-3fe0a14359e3",
                                        "glosses": [
                                            "Something or someone having a paramount significance in a certain situation."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31f50e3d-7e65-49d4-8e68-e19a8d8811be",
                                                "sense_id": "a5856c10-86dd-3670-940f-bded194722ff",
                                                "text": "“The story of this adoption is, of course, the pivot round which all the circumstances of the mysterious tragedy revolved. Mrs. Yule had an only son, namely, William, to whom she was passionately attached ; but, like many a fond mother, she had the desire of mapping out that son's future entirely according to her own ideas.[…]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3b58447-7cb0-3730-a207-a81c7765694f",
                                        "entry_id": "bedf1ac5-74ee-36b2-9bad-3fe0a14359e3",
                                        "glosses": [
                                            "Act of turning on one foot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24ccee2c-ffd0-45d1-a419-ebf315228aee",
                                                "sense_id": "b3b58447-7cb0-3730-a207-a81c7765694f",
                                                "text": "Sandy Weill was the man who stitched Citigroup together in the 1990s and in the process helped bury the Glass-Steagall act, a Depression-era law separating retail and investment banking. Last month he performed a perfect pivot: he now wants regulators to undo his previous work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b887044-3d28-3425-a12b-93f8158cce25",
                                        "entry_id": "bedf1ac5-74ee-36b2-9bad-3fe0a14359e3",
                                        "glosses": [
                                            "The officer or soldier who simply turns in his place while the company or line moves around him in wheeling."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dda6a3d3-f5e5-31e9-9f38-2e1e62e5f387",
                                        "entry_id": "bedf1ac5-74ee-36b2-9bad-3fe0a14359e3",
                                        "glosses": [
                                            "A player with responsibility for co-ordinating their team in a particular jam."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d44d6bc1-6f8d-3ef7-9624-ea7b68a4c39c",
                                        "entry_id": "bedf1ac5-74ee-36b2-9bad-3fe0a14359e3",
                                        "glosses": [
                                            "An element of a set to be sorted that is chosen as a midpoint, so as to divide the other elements into two groups to be dealt with recursively."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
