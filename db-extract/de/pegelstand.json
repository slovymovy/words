                        "cross_references": [
                            {
                                "target_word": "water level",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f4f3271-7a6f-374f-a0a7-614ff7f917e3",
                                        "entry_id": "ebcc236f-2d3c-3120-8cdf-72b48990f196",
                                        "glosses": [
                                            "The level of a body of water, especially when measured above a datum line."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc150de3-ac4e-4376-875c-f29f01a1b3f3",
                                                "sense_id": "2f4f3271-7a6f-374f-a0a7-614ff7f917e3",
                                                "text": "There is one feature of interest: at Rendsburg after a not too-easily graded ascent from the plain by means of an embankment, the train crosses the Kiel Canal by a double-track steel bridge 138 ft. above water-level, with, on a clear day, magnificent views over the countryside, and then loops round right, descending to canal level and, parallel with the canal, crossing under the bridge over which it passed a few minutes previously."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7eb0aaf7-4cba-36a0-b1d8-23e58e30a0be",
                                        "entry_id": "ebcc236f-2d3c-3120-8cdf-72b48990f196",
                                        "glosses": [
                                            "The level of the water table below ground."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "40cbfcfe-b393-3a23-b624-87f773b016e3",
                                        "entry_id": "ebcc236f-2d3c-3120-8cdf-72b48990f196",
                                        "glosses": [
                                            "The waterline of a ship."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5d5e720c-6f9e-3378-9586-5bdb398192ea",
                                        "entry_id": "ebcc236f-2d3c-3120-8cdf-72b48990f196",
                                        "glosses": [
                                            "(Relating to) an instrument to show the level by means of the surface of water in a trough, or in upright tubes connected by a pipe."
                                        ],
                                        "tags": [
                                            "also",
                                            "attributive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98666d75-457a-40a9-86db-f516fb468243",
                                                "sense_id": "5d5e720c-6f9e-3378-9586-5bdb398192ea",
                                                "text": "A water level indicator of the float type is provided."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5df4004-f78a-3ae9-b40c-f000f845b2a0",
                                        "entry_id": "ebcc236f-2d3c-3120-8cdf-72b48990f196",
                                        "glosses": [
                                            "Of a route that follows a riverbank or shoreline."
                                        ],
                                        "tags": [
                                            "attributive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b84c333-3fb1-47d5-8a27-ca9e3d1665e6",
                                                "sense_id": "b5df4004-f78a-3ae9-b40c-f000f845b2a0",
                                                "text": "The water-level route, the whistle and the loud staccato exhaust of this great engine recalled most vividly memories of the New York Central Hudsons highballing along the Hudson River between Harmon and Albany!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
