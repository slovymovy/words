                                    {
                                        "sense_id": "e7a1f160-5cb7-3ca9-ad0d-807f8ea3963a",
                                        "entry_id": "adc0c82a-7b73-32cb-bc63-9fd1bd1b008b",
                                        "glosses": [
                                            "A tobacconist's shop."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b20e89a9-55bd-46fa-bf61-c8d972248820",
                                                "sense_id": "e7a1f160-5cb7-3ca9-ad0d-807f8ea3963a",
                                                "text": "This historic and fragrant tobacconist of old still today is decorated with team pictures and other Harvardiana […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fa8f939-3960-3dde-8b60-dab45218beca",
                                        "entry_id": "adc0c82a-7b73-32cb-bc63-9fd1bd1b008b",
