                                "target_senses": [
                                    {
                                        "sense_id": "721155a7-1747-3dcc-9923-5aa0aa04f1c5",
                                        "entry_id": "3c1e38fa-3899-3a05-a276-dcfb287e003c",
                                        "glosses": [
                                            "To cook (something) in simmering or very hot liquid (usually water; sometimes wine, broth, or otherwise)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23131f6e-57b2-41e9-a499-1ba6c0acd189",
                                                "sense_id": "721155a7-1747-3dcc-9923-5aa0aa04f1c5",
                                                "text": "Eldridge closed the despatch-case with a snap and, rising briskly, walked down the corridor to his solitary table in the dining-car. Mulligatawny soup, poached turbot, roast leg of lamb—the usual railway dinner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdc02aff-99bd-3295-b7c4-e502a1ea6e49",
                                        "entry_id": "3c1e38fa-3899-3a05-a276-dcfb287e003c",
                                        "glosses": [
                                            "To be cooked in such manner."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f913b94-6f8b-46f5-9fa9-aefce26d5731",
                                                "sense_id": "fdc02aff-99bd-3295-b7c4-e502a1ea6e49",
                                                "text": "The white of an egg with spirit of wine, doth bake the egg into clots, as if it began to poach."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "poach",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95b5c2a1-36c5-3e0a-a0ab-2b421ac2327f",
                                        "entry_id": "91178e24-33b0-3ecd-8f01-242c559c2d22",
                                        "glosses": [
                                            "The act of cooking in simmering liquid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f32f126b-5c37-4c00-b868-70d88e8de894",
                                                "sense_id": "95b5c2a1-36c5-3e0a-a0ab-2b421ac2327f",
                                                "text": "Peaches are so perfect they need very little to make them extra special—just a quick poach in basil-scented rosé wine and a few adoring strawberries."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "poach",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eec15b37-fd66-3ff2-b673-4c058f368d37",
                                        "entry_id": "69d97f61-6f93-3e5c-a961-d54cef72e1d9",
                                        "glosses": [
                                            "To trespass on another's property to take fish or game."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eaff05e2-d790-3f3c-a781-fb6eed7d24b2",
                                        "entry_id": "69d97f61-6f93-3e5c-a961-d54cef72e1d9",
                                        "glosses": [
                                            "To take game or fish illegally."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c29ce7c5-485e-49b1-9cad-4f39cf16b688",
                                                "sense_id": "eaff05e2-d790-3f3c-a781-fb6eed7d24b2",
                                                "text": "A 2016 study using carbon dating of more than 200 tusks from seizures spanning nine countries suggested that illegal ivory originates from elephants poached recently, instead of being pilfered from aging stockpiles kept by various nations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d036a5a7-1720-3818-8eba-a094e380a073",
                                        "entry_id": "69d97f61-6f93-3e5c-a961-d54cef72e1d9",
                                        "glosses": [
                                            "To take anything illegally or unfairly."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f0c3817-70f2-4ed1-8b31-13e2ee229019",
                                                "sense_id": "d036a5a7-1720-3818-8eba-a094e380a073",
                                                "text": "Chelsea's embarrassment was symbolised by Ross Barkley's inexplicable header straight to the feet of Aguero to poach his second and Ilkay Gundogan capped that early blitz with a low drive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4f4fb92-eb4e-318c-b1dc-6c0720c57ddf",
                                        "entry_id": "69d97f61-6f93-3e5c-a961-d54cef72e1d9",
                                        "glosses": [
                                            "To intrude; to interfere; to get involved inappropriately, without welcome."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "777b9962-ebc3-480b-92a1-789c5fc8cf72",
                                                "sense_id": "a4f4fb92-eb4e-318c-b1dc-6c0720c57ddf",
                                                "text": "to poach in foreign academic disciplines"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50fa96d6-e91d-3e85-9772-54f57e71d266",
                                        "entry_id": "69d97f61-6f93-3e5c-a961-d54cef72e1d9",
                                        "glosses": [
                                            "To entice (an employee or customer) to switch from a competing company to one's own."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec50b44f-2228-4964-b156-30bf1f58b1d5",
                                                "sense_id": "50fa96d6-e91d-3e85-9772-54f57e71d266",
                                                "text": "EBay has accused three Amazon managers of illegally conspiring to poach its sellers, escalating a monthslong feud between two of the country’s largest e-commerce companies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a260ecdc-5ee8-3c44-b1bd-b38d38e7d325",
                                        "entry_id": "69d97f61-6f93-3e5c-a961-d54cef72e1d9",
                                        "glosses": [
                                            "To make soft or muddy by trampling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6d6f2c1-48b6-4ed4-a9da-a1ce624962f4",
                                                "sense_id": "a260ecdc-5ee8-3c44-b1bd-b38d38e7d325",
                                                "text": "Cattle coming to drink had punched and poached the river bank into a mess of mud."
                                            },
                                            {
                                                "example_id": "14aa614b-62c5-41f8-82cd-8ab27393af51",
                                                "sense_id": "a260ecdc-5ee8-3c44-b1bd-b38d38e7d325",
                                                "text": "the poach'd filth that floods the middle street"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b524be0-f621-39cc-8995-01dd2a001005",
                                        "entry_id": "69d97f61-6f93-3e5c-a961-d54cef72e1d9",
                                        "glosses": [
                                            "To become soft or muddy by being trampled on."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6fc4f8f-992e-4d18-bcd9-36a43f114e58",
                                                "sense_id": "9b524be0-f621-39cc-8995-01dd2a001005",
                                                "text": "Chalky and clay lands […] chap in summer, and poach in winter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7a43da8-47f6-3ad3-8ae5-35f17d7322de",
                                        "entry_id": "69d97f61-6f93-3e5c-a961-d54cef72e1d9",
                                        "glosses": [
                                            "To stab; to pierce; to spear or drive or plunge into something."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc775042-0bfc-4190-84a2-1c2d69a0b2bc",
                                                "sense_id": "e7a43da8-47f6-3ad3-8ae5-35f17d7322de",
                                                "text": "They vse alſo to poche them with an instrument somewhat like the Sammon-speare"
                                            },
                                            {
                                                "example_id": "95d59b79-2e60-4215-ab26-a12350d076b0",
                                                "sense_id": "e7a43da8-47f6-3ad3-8ae5-35f17d7322de",
                                                "text": "his horse poching one of his legs into some hollow ground"
                                            },
                                            {
                                                "example_id": "1c581f20-2d31-479a-ae52-b3edbde71dac",
                                                "sense_id": "e7a43da8-47f6-3ad3-8ae5-35f17d7322de",
                                                "text": "And the laws of your wrastling are that neither shall strangle his adversary with his hands, nor bite him, nor claw nor scratch his flesh, nor poach out his eyes, nor smite him with his fists, nor do any other unfair thing against him, but in all other respects ye shall wrastle freely together."
                                            },
                                            {
                                                "example_id": "7b52e8a7-8ea0-4db4-bcde-bcf5ea2d9cc1",
                                                "sense_id": "e7a43da8-47f6-3ad3-8ae5-35f17d7322de",
                                                "text": "Mutt Malvern stands with a wicked blade in one hand and, in the other, a three-pronged leister spear of the sort used to poach fish or birds."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "poach",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "391c0c7a-3050-3676-ba9c-fd8ac968411c",
                                        "entry_id": "f814ebb4-38be-3e72-a545-f9ff6e7613ff",
                                        "glosses": [
                                            "The act of taking something unfairly, as in tennis doubles where one player returns a shot that their partner was better placed to return."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
