                                        "examples": [
                                            {
                                                "example_id": "fe337582-cfbd-4267-8e6b-40bc6d9249ea",
                                                "sense_id": "eb52ab77-3fd2-3a4c-939a-d6fed587af25",
                                                "text": "...who hate living in camp (though they have a club-house), and miss the billiard-rooms, flirtations with pretty confectioneresses and milliners..."
                                            },
                                            {
                                                "example_id": "a65099b7-c248-4cc1-9d3a-c93ea46f704e",
                                                "sense_id": "eb52ab77-3fd2-3a4c-939a-d6fed587af25",
                                                "text": "The cook smiled and remarked to the confectioneress who was sifting flour in the kitchen, that that was a smart baba."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
