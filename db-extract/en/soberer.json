                "senses": [
                    {
                        "sense_id": "dc6358c1-845a-3297-9dea-63c13d6f01d5",
                        "entry_id": "892a8f4c-1ffd-3ee3-8318-2b1ac22f51d8",
                        "glosses": [
                            "Something that makes a person sober."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea94cff0-b347-4987-946b-9a0c49c0ea20",
                                "sense_id": "dc6358c1-845a-3297-9dea-63c13d6f01d5",
                                "text": "I was once very mischievous—I am not so now, age is a sad soberer of frolic fancies […]"
                            },
                            {
                                "example_id": "5f85ec86-c2af-4bcb-b36c-0c0a9970e322",
                                "sense_id": "dc6358c1-845a-3297-9dea-63c13d6f01d5",
                                "text": "[…] business, as we know, is the great soberer of theorists, no matter on what side they theorize."
                            },
                            {
                                "example_id": "e59f831d-1919-48ea-b999-1203d3f86848",
                                "sense_id": "dc6358c1-845a-3297-9dea-63c13d6f01d5",
                                "text": "[…] love is an intoxicant, marriage the most effective of soberers."
                            },
                            {
                                "example_id": "ce9852fd-3cc7-4e36-b3cd-f74dcf49f1e2",
                                "sense_id": "dc6358c1-845a-3297-9dea-63c13d6f01d5",
                                "text": "One evening I stayed with him very late to celebrate the birthday of his favorite actress, and for once he was slightly the worse for liquor. […] We drove off together, arranging that I should drop him at his flat and drive on to my house. When we reached Haymarket I suggested that we should stop at one of the all-night chemists and buy him one of the mixtures known as “soberers.”"
                            }
                        ]
                    }
