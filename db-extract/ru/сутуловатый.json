                        "cross_references": []
                    },
                    {
                        "translation_id": "11aa20dd-3ac1-4cbd-8153-0ba59046de43",
                        "source_entry_id": "04f6e02b-89fd-321c-8868-3eb13c516bfd",
                        "source_sense_id": "602ce95b-8ebf-3f47-adeb-1d1367810689",
                        "target_lang_word": "bossu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bossu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b3408d6e-fac7-3812-bb6a-b9433b2412e9",
                                        "entry_id": "44a5a50c-1b2c-3d4f-9cd9-7a6df7713ecd",
                                        "glosses": [
                                            "Qui a une ou plusieurs bosses au dos ou à la poitrine, par un vice de conformation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87c048d3-16a7-4135-b1d9-1a338e9b4955",
                                                "sense_id": "b3408d6e-fac7-3812-bb6a-b9433b2412e9",
                                                "text": "Vers la fin du siècle dernier, le vélocifère, prédécesseur de la diligence et des messageries, débarquait à Paris un provençal, plein de verve et d'entrain, né dans la ville d'Aix, et bossu, comme Ésope, par devant et par derrière."
                                            },
                                            {
                                                "example_id": "4835649a-76ee-4f05-aba4-92f47ef76ddc",
                                                "sense_id": "b3408d6e-fac7-3812-bb6a-b9433b2412e9",
                                                "text": "Courtois le cadet, que tout le monde appelait laconiquement Tole, car il portait le prénom que commençait à peine d'illustrer M. France, Courtois le cadet était bossu d'une manière complexe et si j'ose dire, selon tous les méridiens."
                                            },
                                            {
                                                "example_id": "83ab2997-8304-4a8e-89fb-4c66776d3739",
                                                "sense_id": "b3408d6e-fac7-3812-bb6a-b9433b2412e9",
                                                "text": "Au milieu du fleuve, un train de péniches nageait à la queue leu leu, bossues de charbon."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bossu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6bf186b5-8b64-3ee2-8ddf-8cf774ca5872",
                                        "entry_id": "ef11e327-f9e2-3854-9363-e832333a2b0e",
                                        "glosses": [
                                            "Celui qui a une ou plusieurs bosses"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddab4fd0-ab5e-46f1-b8ed-0c55d32ef23d",
                                                "sense_id": "6bf186b5-8b64-3ee2-8ddf-8cf774ca5872",
                                                "text": "C’est Quasimodo, le bossu de Notre-Dame ! Quasimodo le borgne ! Quasimodo le bancal !"
                                            },
                                            {
                                                "example_id": "b6fa0c86-1eb5-4b5c-9067-d62a07d1adfd",
                                                "sense_id": "6bf186b5-8b64-3ee2-8ddf-8cf774ca5872",
                                                "text": "Les bossus sont des créations merveilleuses, entièrement dues d’ailleurs à la Société ; […]. La courbure ou la torsion de la colonne vertébrale produit chez ces hommes, en apparence disgraciés, comme un regard où les fluides nerveux s’amassent en de plus grandes quantités que chez les autres, …."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
