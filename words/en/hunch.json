{
    "word_family": [
        "hunchback",
        "huncher"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6e99a1d5-eb6d-38f8-aa56-53bbe8f70d42",
                    "sense_definition": "An intuitive feeling or a guess that something is true or will happen, even without proof.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "intuition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I had a <w>hunch</w> that the surprise party was for me, even though nobody said a word.",
                            "target_lang_translations": {
                                "ru": "У меня было <w>предчувствие</w>, что вечеринка-сюрприз была для меня, хотя никто не проронил ни слова."
                            }
                        },
                        {
                            "text": "Following a strong <w>hunch</w>, the detective decided to check the old warehouse for clues.",
                            "target_lang_translations": {
                                "ru": "Следуя сильной <w>догадке</w>, детектив решил проверить старый склад в поисках улик."
                            }
                        }
                    ],
                    "synonyms": [
                        "inkling",
                        "suspicion",
                        "feeling."
                    ],
                    "common_phrases": [
                        "strong hunch",
                        "follow a hunch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Интуитивное чувство или предположение о том, что что-то является правдой или произойдет, даже без доказательств."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предчувствие",
                                "target_lang_sense_clarification": "интуитивное ощущение"
                            },
                            {
                                "target_lang_word": "догадка",
                                "target_lang_sense_clarification": "предположение, основанное на вероятности"
                            },
                            {
                                "target_lang_word": "чутьё",
                                "target_lang_sense_clarification": "интуиция"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "360575fc-4f62-31b1-830b-7c2c3de3b87c",
                    "sense_definition": "A physical posture where the back and shoulders are curved forward.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man walked with a <w>hunch</w> that made him look much shorter than he was.",
                            "target_lang_translations": {
                                "ru": "Старик шел с такой <w>сутулостью</w>, что казался гораздо ниже своего роста."
                            }
                        },
                        {
                            "text": "Years of sitting at a desk had given him a slight <w>hunch</w> in his upper back.",
                            "target_lang_translations": {
                                "ru": "Годы сидения за столом привели к небольшой <w>сутулости</w> в верхней части спины."
                            }
                        }
                    ],
                    "synonyms": [
                        "slouch",
                        "stoop"
                    ],
                    "common_phrases": [
                        "walk with a hunch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическая поза, при которой спина и плечи изогнуты вперед."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сутулость",
                                "target_lang_sense_clarification": "состояние спины"
                            },
                            {
                                "target_lang_word": "горб",
                                "target_lang_sense_clarification": "сильный изгиб спины"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20368dd0-ef9a-3347-b97b-034470db8281",
                    "sense_definition": "A large, thick piece or lump of something, especially food.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "piece",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He cut a thick <w>hunch</w> of bread and spread it with a generous layer of butter.",
                            "target_lang_translations": {
                                "ru": "Он отрезал толстый <w>ломоть</w> хлеба и намазал его щедрым слоем масла."
                            }
                        },
                        {
                            "text": "The traveler carried a <w>hunch</w> of cheese in his bag for the long journey ahead.",
                            "target_lang_translations": {
                                "ru": "Путешественник нес в сумке <w>кусок</w> сыра для предстоящего долгого пути."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hunch of bread"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большой, толстый кусок или ломоть чего-либо, особенно еды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ломоть",
                                "target_lang_sense_clarification": "большой кусок хлеба или сыра"
                            },
                            {
                                "target_lang_word": "кусок",
                                "target_lang_sense_clarification": "толстая часть чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7bf8dbb1-f904-34da-aee3-9f464b893003",
                    "sense_definition": "A physical push or thrust, often delivered with the elbow.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "push",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave his friend a sharp <w>hunch</w> to get his attention during the quiet ceremony.",
                            "target_lang_translations": {
                                "ru": "Он резко <w>толкнул</w> друга локтем, чтобы привлечь его внимание во время тихой церемонии."
                            }
                        },
                        {
                            "text": "The crowd was so thick that every step required a <w>hunch</w> to move forward.",
                            "target_lang_translations": {
                                "ru": "Толпа была такой плотной, что каждый шаг требовал <w>толчка</w>, чтобы продвинуться вперед."
                            }
                        }
                    ],
                    "synonyms": [
                        "nudge",
                        "elbow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физический толчок или удар, часто наносимый локтем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "толчок",
                                "target_lang_sense_clarification": "резкое движение рукой или локтем"
                            },
                            {
                                "target_lang_word": "тычок",
                                "target_lang_sense_clarification": "удар локтем"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "aadffeff-7b12-31c9-8138-486bf9aeec3f",
                    "sense_definition": "To bend the upper body forward and raise the shoulders, often due to cold, fatigue, or concentration.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Try not to <w>hunch</w> over your computer for too long or your neck will start to ache.",
                            "target_lang_translations": {
                                "ru": "Старайтесь не <w>сутулиться</w> над компьютером слишком долго, иначе у вас начнет болеть шея."
                            }
                        },
                        {
                            "text": "She would <w>hunch</w> over her desk for hours while working on her detailed drawings.",
                            "target_lang_translations": {
                                "ru": "Она часами <w>горбилась</w> над столом, работая над своими детальными рисунками."
                            }
                        }
                    ],
                    "synonyms": [
                        "slouch",
                        "stoop",
                        "lean"
                    ],
                    "common_phrases": [
                        "hunch over",
                        "hunch forward"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наклонять верхнюю часть тела вперед и поднимать плечи, часто из-за холода, усталости или концентрации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сутулиться",
                                "target_lang_sense_clarification": "держать спину непрямой"
                            },
                            {
                                "target_lang_word": "горбиться",
                                "target_lang_sense_clarification": "сильно изгибать спину"
                            },
                            {
                                "target_lang_word": "сгибаться",
                                "target_lang_sense_clarification": "наклоняться вперед"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5d4b6b24-720d-3e37-8ac0-2f829ab1731d",
                    "sense_definition": "To pull one's shoulders up and head down, typically to protect oneself or hide.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "posture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children would <w>hunch</w> their shoulders against the cold wind as they waited for the bus.",
                            "target_lang_translations": {
                                "ru": "Дети <w>втягивали</w> плечи, спасаясь от холодного ветра, пока ждали автобус."
                            }
                        },
                        {
                            "text": "He had to <w>hunch</w> up his shoulders to fit through the tiny doorway of the cabin.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось <w>сжать</w> плечи, чтобы пролезть в крошечный дверной проем хижины."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hunch your shoulders",
                        "hunch up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поднимать плечи и опускать голову, обычно чтобы защитить себя или спрятаться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "втягивать",
                                "target_lang_sense_clarification": "втягивать голову в плечи"
                            },
                            {
                                "target_lang_word": "ёжиться",
                                "target_lang_sense_clarification": "сжиматься от холода или страха"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c189ed6-4e5e-371c-b73b-44eabc119c86",
                    "sense_definition": "To push or jostle someone, especially using the elbow or shoulder.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "push",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>hunched</w> me with her elbow to point out the celebrity sitting across the room.",
                            "target_lang_translations": {
                                "ru": "Она <w>толкнула</w> меня локтем, чтобы указать на знаменитость, сидящую в другом конце комнаты."
                            }
                        },
                        {
                            "text": "The players began to <w>hunch</w> and jostle each other as they fought for the ball.",
                            "target_lang_translations": {
                                "ru": "Игроки начали <w>толкаться</w> и пихаться, борясь за мяч."
                            }
                        }
                    ],
                    "synonyms": [
                        "nudge",
                        "elbow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Толкать или пихать кого-то, особенно используя локоть или плечо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "толкать",
                                "target_lang_sense_clarification": "пихать локтем"
                            },
                            {
                                "target_lang_word": "пихать",
                                "target_lang_sense_clarification": "расталкивать локтями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e15ee3e-da92-365a-a87c-e4cc0b5d03b7",
                    "sense_definition": "To move or walk while maintaining a bent or stooped posture.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tired hikers <w>hunched</w> up the steep trail, exhausted by the heavy packs on their backs.",
                            "target_lang_translations": {
                                "ru": "Усталые туристы <w>плелись</w> вверх по крутой тропе, измученные тяжелыми рюкзаками за спиной."
                            }
                        },
                        {
                            "text": "He <w>hunched</w> across the room, trying to stay out of sight of the windows.",
                            "target_lang_translations": {
                                "ru": "Он <w>прокрался</w> через комнату, согнувшись, стараясь не попадаться на глаза из окон."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться или идти, сохраняя согнутую или сгорбленную позу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брести",
                                "target_lang_sense_clarification": "идти сгорбившись"
                            },
                            {
                                "target_lang_word": "плестись",
                                "target_lang_sense_clarification": "медленно идти согнувшись"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1b0b508-3751-3bb7-95c2-6470f97b2a75",
                    "sense_definition": "To form an intuitive guess or to act based on a feeling rather than certain knowledge.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intuition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Experienced investors often <w>hunch</w> when they see a pattern that others might miss.",
                            "target_lang_translations": {
                                "ru": "Опытные инвесторы часто <w>полагаются на интуицию</w>, когда видят закономерность, которую другие могут упустить."
                            }
                        },
                        {
                            "text": "I am just <w>hunching</w> here, but I suspect the market will recover by next month.",
                            "target_lang_translations": {
                                "ru": "Я просто <w>предполагаю</w>, но подозреваю, что рынок восстановится к следующему месяцу."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Формировать интуитивную догадку или действовать на основе чувства, а не точных знаний."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предполагать",
                                "target_lang_sense_clarification": "основываться на интуиции"
                            },
                            {
                                "target_lang_word": "чуять",
                                "target_lang_sense_clarification": "чувствовать интуитивно"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}