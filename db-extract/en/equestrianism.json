                    {
                        "translation_id": "83262230-3dd2-426a-9042-1d7f8b40856d",
                        "source_entry_id": "7364bae9-10cf-3fd1-933d-dc61bfedc636",
                        "source_sense_id": "1478c0ac-b342-32a2-8c63-ac6bfda9ae87",
                        "source_sense_description": "the art or sport of riding horses",
                        "target_lang_word": "paardrijden",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paardrijden",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6409df74-dc02-317d-b23d-f675d06ecae9",
                                        "entry_id": "9b98b67c-d6f6-3378-9ceb-934af4b9f6d9",
                                        "glosses": [
                                            "zich, zittend op de rug van een paard, verplaatsen"
                                        ],
                                        "tags": [
                                            "paardrijden"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bf5a374-acb9-4f84-97c6-c11ddd8f1d4b",
                                                "sense_id": "6409df74-dc02-317d-b23d-f675d06ecae9",
                                                "text": "Voordat ze ging paardrijden, zadelde ze het paard op."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "paardrijden",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c3d76f4c-a499-3df2-ae49-15a57ddb856f",
                                        "entry_id": "fdd2e0a8-acf0-3466-803c-8cd0211858dc",
                                        "glosses": [
                                            "het rijden te paard, ter ontspanning of als sportbeoefening"
                                        ],
                                        "tags": [
                                            "paardrijden"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e17c02e-7486-472b-b7b2-a3fbc7f61b20",
                                                "sense_id": "c3d76f4c-a499-3df2-ae49-15a57ddb856f",
                                                "text": "Paarden, houdt men in Engeland te veel, tot nadeel van den Landbouw, door dien het Paardrijden eene aloude Engelsche gewoonte is."
                                            },
                                            {
                                                "example_id": "635ff392-9aad-4ff1-a695-b44e710103b0",
                                                "sense_id": "c3d76f4c-a499-3df2-ae49-15a57ddb856f",
                                                "text": "'Jullie hebben hier iemand nodig, señorita,' zei ze. 'Dit is Londen niet.\nKunnen jullie koken?'\n'Nee.'\n'Schoonmaken?'\n 'Nee.'\n'Paardrijden?'\n 'Nee!'\n 'Ik help wel.'\n'Hoe oud ben jij dan?'\n'Achttien,' loog Teresa, want in werkelijkheid was ze pas zestien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e0e551c-d772-4202-8411-c9a86093fba1",
                        "source_entry_id": "7364bae9-10cf-3fd1-933d-dc61bfedc636",
                        "source_sense_id": "1478c0ac-b342-32a2-8c63-ac6bfda9ae87",
                        "source_sense_description": "the art or sport of riding horses",
                        "target_lang_word": "équitation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "équitation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "77f3bc65-2ecf-3071-a4a4-dd5cbde23694",
                                        "entry_id": "bcef8eee-01cd-3c35-abdf-99a229890f62",
                                        "glosses": [
                                            "Action ou fait de monter à cheval."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ba58f8f-be58-4e1a-a924-6444097316f3",
                                                "sense_id": "77f3bc65-2ecf-3071-a4a4-dd5cbde23694",
                                                "text": "J'ai chevauché dans bien des pays, mais nulle part l’équitation ne m'a paru aussi pénible qu'en Islande ; la faute en est moins aux chevaux qu'au pays même, dont le sol rude et inégal, absolument dépourvu de routes, ne permet que rarement un changement d'allure; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b9116f0-937a-363a-a139-96199c278a8d",
                                        "entry_id": "bcef8eee-01cd-3c35-abdf-99a229890f62",
                                        "glosses": [
                                            "Art de monter à cheval."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a127fe2-1067-4f1e-ba27-3c397fb276ab",
                                                "sense_id": "9b9116f0-937a-363a-a139-96199c278a8d",
                                                "text": "[…] il fit descendre à reculons à son cheval la pente qu’il avait gravie, et traversa la lice de la même manière, […]. Cette nouvelle preuve d’adresse en équitation lui valut les applaudissements de la multitude."
                                            },
                                            {
                                                "example_id": "667d837d-9bb6-49d1-801a-ca5384a744f8",
                                                "sense_id": "9b9116f0-937a-363a-a139-96199c278a8d",
                                                "text": "Enguerrand Lorien, l'ami intime de mon défunt mari, Perrot Travigny, et l'ancien écuyer des comtes de Vimoutiers, nos voisins, vous instruisirent aux armes, au maniement de la lance et de l'épée, à l’équitation, enfin à toutes les choses de la chevalerie, […]."
                                            },
                                            {
                                                "example_id": "96cbec79-3940-4765-b3a8-52ff2bdab0e1",
                                                "sense_id": "9b9116f0-937a-363a-a139-96199c278a8d",
                                                "text": "Le goût de l’équitation, autrefois si prononcé en France, est aujourd’hui en partie perdu où tout le monde préfère monter en voiture ; aussi le cheval de selle est-il presque délaissé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f9adc87-a2e0-4d32-a84b-3695a8b9b14d",
                        "source_entry_id": "7364bae9-10cf-3fd1-933d-dc61bfedc636",
                        "source_sense_id": "1478c0ac-b342-32a2-8c63-ac6bfda9ae87",
                        "source_sense_description": "the art or sport of riding horses",
                        "target_lang_word": "Reitsport",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reitsport",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "383c67b2-956c-3fb7-b427-083e228c9ac9",
                                        "entry_id": "007c8521-c82b-3c82-a9c8-22499f6b2794",
                                        "glosses": [
                                            "Sport, bei dem der Sportler auf dem Rücken eines Pferdes sitzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60485093-7d9c-4b50-ad10-8c621636f1bd",
                                                "sense_id": "383c67b2-956c-3fb7-b427-083e228c9ac9",
                                                "text": "„Dem Reitsport ist er bis zuletzt treu geblieben, noch im hohen Alter war er Gast bei den großen Veranstaltungen in Hamburg und Aachen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da3840cd-54ed-476b-b525-f26d2042a7c8",
                        "source_entry_id": "7364bae9-10cf-3fd1-933d-dc61bfedc636",
                        "source_sense_id": "1478c0ac-b342-32a2-8c63-ac6bfda9ae87",
                        "source_sense_description": "the art or sport of riding horses",
                        "target_lang_word": "Pferdesport",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pferdesport",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0fad0360-1eab-3843-963a-4c28d6ad6139",
                                        "entry_id": "974fb55b-972c-3cbc-9165-bda14bb75eab",
                                        "glosses": [
                                            "Gesamtheit aller Sportarten, bei denen Mensch und Pferd als Partner zusammenarbeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b1522c3-79de-4fb7-8268-f7993d660d69",
                                                "sense_id": "0fad0360-1eab-3843-963a-4c28d6ad6139",
                                                "text": "Der Pferdesport erfreut sich anhaltender Beliebtheit."
                                            },
                                            {
                                                "example_id": "cdbf371c-d4ec-4eb4-bbb3-941396a28019",
                                                "sense_id": "0fad0360-1eab-3843-963a-4c28d6ad6139",
                                                "text": "„Die Geschichte des Pferdesports in Hongkong ist auch eine Geschichte des Kolonialismus.“"
                                            },
                                            {
                                                "example_id": "2f01167b-8ab7-4a83-a645-69ef524a30d6",
                                                "sense_id": "0fad0360-1eab-3843-963a-4c28d6ad6139",
                                                "text": "„Am 20. August bat Thomas Lieven den Oberst um Verständnis dafür, daß er nach allen Anstrengungen trotz der angespannten Weltlage mit Mimi zur Erholung nach Chantilly fahren wolle, dem Zentrum des Pferdesports und Ausflugsort der Pariser.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5802f814-0f86-4628-87f7-6450b2dc7e87",
                        "source_entry_id": "7364bae9-10cf-3fd1-933d-dc61bfedc636",
                        "source_sense_id": "1478c0ac-b342-32a2-8c63-ac6bfda9ae87",
                        "source_sense_description": "the art or sport of riding horses",
                        "target_lang_word": "Reiten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reiten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "78c5d536-d102-3cd1-82b5-68bc68b0a839",
                                        "entry_id": "e6f9b838-d413-3e89-8e9c-5f49479b44e8",
                                        "glosses": [
                                            "Fortbewegung auf dem Rücken eines Pferdes (Reittiers)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73e61ce0-cb03-4e62-a6db-b4aa87a88dd0",
                                                "sense_id": "78c5d536-d102-3cd1-82b5-68bc68b0a839",
                                                "text": "„So entziehen sich ausgereifte Sports wie das Bungeespringen, Reiten, Tauchen oder Drachenfliegen dieser Subsumierung als Risikosport, sobald objektivierende Beweisforderungen und wissenschaftliche Maßstäbe an die Zuordnung gelegt werden.“"
                                            },
                                            {
                                                "example_id": "5b3095e2-f72b-4ab3-92c9-7f56db5e9328",
                                                "sense_id": "78c5d536-d102-3cd1-82b5-68bc68b0a839",
                                                "text": "„Denn für das Reiten gab es keine bessere Jahreszeit als den späten Sommer, wenn die Ernte schon fast eingefahren war.“"
                                            },
                                            {
                                                "example_id": "15f1a76e-277d-4a8c-bf27-baccf62a3714",
                                                "sense_id": "78c5d536-d102-3cd1-82b5-68bc68b0a839",
                                                "text": "Beim Reiten ist es wichtig, das Gleichgewicht zu halten."
                                            },
                                            {
                                                "example_id": "de8fa961-716d-4bd2-8f51-b6ba04b518e9",
                                                "sense_id": "78c5d536-d102-3cd1-82b5-68bc68b0a839",
                                                "text": "Das Reiten auf dem Elefanten ist natürlich nicht kostenlos."
                                            },
                                            {
                                                "example_id": "44c1f630-ccfd-44a0-bfea-8deaefa75150",
                                                "sense_id": "78c5d536-d102-3cd1-82b5-68bc68b0a839",
                                                "text": "Im Reiten schnitt die deutsche Mannschaft bei Olympia besser ab als beim Segeln."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
