{
    "word_family": [
        "sundown"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d0e14af3-7534-317d-ae4a-1212d674ba53",
                    "sense_definition": "An alcoholic drink enjoyed at sunset or at the end of the day",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "social_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We enjoyed a refreshing <w>sundowner</w> while watching the sun disappear over the horizon.",
                            "target_lang_translations": {
                                "zh": "我们一边看着太阳消失在地平线上，一边享用着清爽的<w>日落酒</w>。"
                            }
                        },
                        {
                            "text": "After a long day of safari, the group gathered for a <w>sundowner</w> at the lodge.",
                            "target_lang_translations": {
                                "zh": "在漫长的游猎之旅后，团队聚集在旅馆享用<w>傍晚酒</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cocktail",
                        "aperitif"
                    ],
                    "common_phrases": [
                        "enjoy a sundowner"
                    ],
                    "target_lang_definitions": {
                        "zh": "日落时分饮用的酒精饮料"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "日落酒",
                                "target_lang_sense_clarification": "指在日落时分享用的饮品"
                            },
                            {
                                "target_lang_word": "傍晚酒",
                                "target_lang_sense_clarification": "指在一天结束时享用的饮品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b7f3feef-962e-3f70-bec6-b35d48ec5e18",
                    "sense_definition": "A social gathering held in the early evening",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "social_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel hosts a weekly <w>sundowner</w> on the terrace for all its guests.",
                            "target_lang_translations": {
                                "zh": "酒店每周在露台上为所有客人举办一次<w>傍晚酒会</w>。"
                            }
                        },
                        {
                            "text": "We were invited to a lovely <w>sundowner</w> by the river to celebrate the end of the conference.",
                            "target_lang_translations": {
                                "zh": "我们受邀参加了河边一场愉快的<w>傍晚酒会</w>，以庆祝会议圆满结束。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cocktail party"
                    ],
                    "common_phrases": [
                        "attend a sundowner"
                    ],
                    "target_lang_definitions": {
                        "zh": "傍晚举行的社交聚会"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "傍晚酒会",
                                "target_lang_sense_clarification": "指在日落时分举办的社交活动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27288855-32a2-30e3-8b4e-a2b6684e1f90",
                    "sense_definition": "A patient who experiences increased confusion or agitation during the evening hours",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nursing staff is trained to manage the specific needs of a <w>sundowner</w> in the memory care unit.",
                            "target_lang_translations": {
                                "zh": "护理人员受过专门培训，以应对记忆护理病房中<w>日落综合征患者</w>的特殊需求。"
                            }
                        },
                        {
                            "text": "Caregivers often find it challenging when a <w>sundowner</w> becomes restless as the sun begins to set.",
                            "target_lang_translations": {
                                "zh": "当<w>日落综合征患者</w>在日落时分变得焦躁不安时，护理人员往往会感到棘手。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指在傍晚时分出现认知混乱或躁动症状的患者"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "日落综合征患者",
                                "target_lang_sense_clarification": "指患有日落综合征的病人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8c4d08c-94f4-3e59-bff4-dc55a8d3ebf2",
                    "sense_definition": "A person who performs private work for payment outside of their regular official working hours",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company policy strictly forbids employees from acting as <w>sundowners</w> for private clients.",
                            "target_lang_translations": {
                                "zh": "公司政策严禁员工为私人客户<w>兼职</w>。"
                            }
                        },
                        {
                            "text": "Some technicians work as <w>sundowners</w> on weekends to earn extra income.",
                            "target_lang_translations": {
                                "zh": "一些技术人员周末会<w>打私活</w>以赚取额外收入。"
                            }
                        }
                    ],
                    "synonyms": [
                        "moonlighter"
                    ],
                    "target_lang_definitions": {
                        "zh": "指在正式工作时间之外从事私活以赚取额外收入的人"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "兼职者",
                                "target_lang_sense_clarification": "指利用业余时间做私活的人"
                            },
                            {
                                "target_lang_word": "打私活的人",
                                "target_lang_sense_clarification": "指在正职之外从事额外工作的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "49ffdae0-b514-33ca-8122-8c3362fbda94",
                    "sense_definition": "A historical term for a traveler who arrives at a farm late in the day to request food and shelter",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "historical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the Australian outback, a <w>sundowner</w> would often rely on the hospitality of remote homesteads.",
                            "target_lang_translations": {
                                "zh": "在澳大利亚内陆地区，<w>流浪汉</w>经常依赖偏远农庄的款待。"
                            }
                        },
                        {
                            "text": "The life of a <w>sundowner</w> was characterized by constant travel and a lack of permanent employment.",
                            "target_lang_translations": {
                                "zh": "<w>流浪汉</w>的生活特点是不断迁徙且没有固定工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "swagman",
                        "tramp"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Australia"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "历史用语，指傍晚时分到达农场寻求食物和住所的流浪者"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "流浪汉",
                                "target_lang_sense_clarification": "指四处漂泊寻求救济的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d905557c-6471-3c15-b198-e5db14e52991",
                    "sense_definition": "A ship captain who enforces strict discipline by requiring the crew to be on board by sunset",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crew feared the captain, who was known as a <w>sundowner</w> for his rigid rules.",
                            "target_lang_translations": {
                                "zh": "船员们很怕这位船长，他因规矩严苛而被视为<w>严厉的船长</w>。"
                            }
                        },
                        {
                            "text": "Life on the ship was difficult under such a strict <w>sundowner</w>.",
                            "target_lang_translations": {
                                "zh": "在这样一位<w>严厉的船长</w>手下，船上的生活十分艰难。"
                            }
                        }
                    ],
                    "synonyms": [
                        "disciplinarian"
                    ],
                    "target_lang_definitions": {
                        "zh": "指要求船员在日落前必须登船的严厉船长"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "严厉的船长",
                                "target_lang_sense_clarification": "指以纪律严明著称的船长"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}