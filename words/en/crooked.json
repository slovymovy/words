{
    "word_family": [
        "crook"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "eefbaf8a-fd8a-38a0-8e28-ee93af817612",
                    "sense_definition": "Not straight; having one or more bends or angles.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We walked up the <w>crooked</w> path to the top of the hill.",
                            "target_lang_translations": {
                                "de": "Wir gingen den <w>krummen</w> Pfad bis zur Spitze des Hügels hinauf."
                            }
                        },
                        {
                            "text": "The old tree had a <w>crooked</w> branch that hung over the river.",
                            "target_lang_translations": {
                                "de": "Der alte Baum hatte einen <w>krummen</w> Ast, der über den Fluss hing."
                            }
                        }
                    ],
                    "synonyms": [
                        "bent",
                        "curved",
                        "twisted"
                    ],
                    "antonyms": [
                        "straight"
                    ],
                    "common_phrases": [
                        "crooked path",
                        "crooked line"
                    ],
                    "target_lang_definitions": {
                        "de": "Nicht gerade; mit einer oder mehreren Biegungen oder Winkeln versehen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "krumm",
                                "target_lang_sense_clarification": "allgemein für nicht gerade Formen"
                            },
                            {
                                "target_lang_word": "schief",
                                "target_lang_sense_clarification": "oft für Dinge, die nicht in der korrekten Ausrichtung sind"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5da491dd-3f4d-316f-89bb-34886dfe85cd",
                    "sense_definition": "Set at an angle; not vertical or square.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That picture is <w>crooked</w> - could you straighten it up for me?",
                            "target_lang_translations": {
                                "de": "Das Bild hängt <w>schief</w> – könntest du es für mich gerade rücken?"
                            }
                        },
                        {
                            "text": "He wore his hat <w>crooked</w> on his head.",
                            "target_lang_translations": {
                                "de": "Er trug seinen Hut <w>schief</w> auf dem Kopf."
                            }
                        }
                    ],
                    "synonyms": [
                        "askew",
                        "tilted"
                    ],
                    "antonyms": [
                        "straight"
                    ],
                    "common_phrases": [
                        "hang crooked"
                    ],
                    "target_lang_definitions": {
                        "de": "In einem Winkel stehend; nicht vertikal oder rechtwinklig."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "schief",
                                "target_lang_sense_clarification": "nicht gerade hängend oder stehend"
                            },
                            {
                                "target_lang_word": "schräg",
                                "target_lang_sense_clarification": "in einem Winkel zur Horizontalen oder Vertikalen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5e873a6-0e4a-33c4-bb13-7aebc375a65d",
                    "sense_definition": "Dishonest or illegal; corrupt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "morality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was trying to interest me in another one of his <w>crooked</w> deals.",
                            "target_lang_translations": {
                                "de": "Er versuchte, mich für eines seiner weiteren <w>krummen</w> Dinger zu interessieren."
                            }
                        },
                        {
                            "text": "The police officer was fired for being <w>crooked</w> and taking bribes.",
                            "target_lang_translations": {
                                "de": "Der Polizist wurde entlassen, weil er <w>betrügerisch</w> war und Bestechungsgelder annahm."
                            }
                        }
                    ],
                    "synonyms": [
                        "corrupt",
                        "dishonest",
                        "fraudulent"
                    ],
                    "antonyms": [
                        "honest",
                        "upright"
                    ],
                    "common_phrases": [
                        "crooked deal",
                        "crooked politician"
                    ],
                    "target_lang_definitions": {
                        "de": "Unehrlich oder illegal; korrupt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "krumm",
                                "target_lang_sense_clarification": "figurativ für illegale Machenschaften"
                            },
                            {
                                "target_lang_word": "betrügerisch",
                                "target_lang_sense_clarification": "mit der Absicht zu betrügen"
                            },
                            {
                                "target_lang_word": "unehrlich",
                                "target_lang_sense_clarification": "allgemein unaufrichtig oder unredlich"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a257405-6228-32aa-9795-7d0fe1a93dd8",
                    "sense_definition": "Ill-tempered; grumpy; cranky.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is feeling quite <w>crooked</w> after a long day of work.",
                            "target_lang_translations": {
                                "de": "Er fühlt sich nach einem langen Arbeitstag ziemlich <w>mürrisch</w>."
                            }
                        },
                        {
                            "text": "Don't mind him, he is just a bit <w>crooked</w> this morning.",
                            "target_lang_translations": {
                                "de": "Beachte ihn nicht, er ist heute Morgen nur ein bisschen <w>gereizt</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "cranky",
                        "grumpy",
                        "irritable"
                    ],
                    "antonyms": [
                        "cheerful",
                        "pleasant"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Used in Newfoundland English"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Übellaunig; mürrisch; gereizt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "mürrisch",
                                "target_lang_sense_clarification": "schlechte Laune zeigend"
                            },
                            {
                                "target_lang_word": "gereizt",
                                "target_lang_sense_clarification": "schnell verärgert"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "96d99888-0142-3f63-9258-b8509a443a31",
                    "sense_definition": "Simple past and past participle of <w>crook</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>crooked</w> his finger to signal for me to come closer.",
                            "target_lang_translations": {
                                "de": "Er <w>krümmte</w> seinen Finger, um mir zu signalisieren, dass ich näher kommen sollte."
                            }
                        },
                        {
                            "text": "She had <w>crooked</w> her arm to hold the heavy basket.",
                            "target_lang_translations": {
                                "de": "Sie hatte ihren Arm <w>gekrümmt</w>, um den schweren Korb zu halten."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Vergangenheitsform von 'krümmen' (etwas biegen)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "krümmte",
                                "target_lang_sense_clarification": "Präteritum von krümmen"
                            },
                            {
                                "target_lang_word": "gekrümmt",
                                "target_lang_sense_clarification": "Partizip Perfekt von krümmen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}