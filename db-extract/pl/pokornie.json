                "forms": [],
                "senses": [
                    {
                        "sense_id": "04945d6f-64fd-3f92-b98e-551a0b394afb",
                        "entry_id": "fa57d56f-d170-384e-9015-0e882233c06e",
                        "glosses": [
                            "w sposób pokorny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f688477e-d788-4062-8178-08d2ad85c90a",
                                "sense_id": "04945d6f-64fd-3f92-b98e-551a0b394afb",
                                "text": "Poproś pokornie, a zobaczysz, że skruszeje jego serce."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "ffdf861e-d54d-3803-8979-78241c2b1a5a",
                        "entry_id": "fa57d56f-d170-384e-9015-0e882233c06e",
                        "glosses": [
                            "skromnie, ubogo"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e5c042bf-b9e3-4165-b7e7-3049559136aa",
                        "source_entry_id": "fa57d56f-d170-384e-9015-0e882233c06e",
                        "source_sense_id": "04945d6f-64fd-3f92-b98e-551a0b394afb",
                        "target_lang_word": "humbly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "humbly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e00abc74-5ba7-3554-acd9-6afaf04679fc",
                                        "entry_id": "d456bd91-a217-3536-8e1b-6b21820b4e07",
                                        "glosses": [
                                            "In a humble manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a7fc29b-af93-4149-99f7-07963297a9be",
                                                "sense_id": "e00abc74-5ba7-3554-acd9-6afaf04679fc",
                                                "text": "I humbly accept this award."
                                            },
                                            {
                                                "example_id": "2a5d0123-00af-4256-9492-c16040970c1f",
                                                "sense_id": "e00abc74-5ba7-3554-acd9-6afaf04679fc",
                                                "text": "Hee hath shewed thee, O man, what is good; and what doeth the Lord require of thee, but to do iustly, and to loue mercy, and to walke humbly with thy God?"
                                            },
                                            {
                                                "example_id": "0ad3b61a-4168-43b5-9f71-d5aeaa0b2bc0",
                                                "sense_id": "e00abc74-5ba7-3554-acd9-6afaf04679fc",
                                                "text": "At the end of a week, she could bear the suspense no longer, and so went humbly to her old home and sought forgiveness."
                                            },
                                            {
                                                "example_id": "40aee1e6-b726-4abd-a277-ca4d813cd01e",
                                                "sense_id": "e00abc74-5ba7-3554-acd9-6afaf04679fc",
                                                "text": "The greatest difficulty is to do great things humbly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28dfe81a-dabd-472d-a7db-46bb8fdd3718",
                        "source_entry_id": "fa57d56f-d170-384e-9015-0e882233c06e",
                        "source_sense_id": "04945d6f-64fd-3f92-b98e-551a0b394afb",
                        "target_lang_word": "humblement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "humblement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1e1c753f-d74c-3380-8bdd-3babb91f4b7d",
                                        "entry_id": "e90c84ae-3551-355e-b2bf-0f8710d56a0f",
                                        "glosses": [
                                            "Avec des sentiments d’humilité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f71f4f5e-6bb4-4c09-b924-5fecb1f9e114",
                                                "sense_id": "1e1c753f-d74c-3380-8bdd-3babb91f4b7d",
                                                "text": "Je vous salue très humblement."
                                            },
                                            {
                                                "example_id": "a6f1affe-d644-4b22-9073-77882abe6ad6",
                                                "sense_id": "1e1c753f-d74c-3380-8bdd-3babb91f4b7d",
                                                "text": "Il faisait des soupirs, de grands élancements, Et baisait humblement la terre à tous moments."
                                            },
                                            {
                                                "example_id": "60cbc906-ac28-4f6d-ac1b-4b2469f292d9",
                                                "sense_id": "1e1c753f-d74c-3380-8bdd-3babb91f4b7d",
                                                "text": "Je me confie pour Madame en cette miséricorde [de Dieu] qu’elle a si sincèrement et si humblement réclamée."
                                            },
                                            {
                                                "example_id": "43916fc7-1ac3-49bb-b286-2ccd2d826c7f",
                                                "sense_id": "1e1c753f-d74c-3380-8bdd-3babb91f4b7d",
                                                "text": "Combien de fois a-t-elle en ce lieu remercié Dieu humblement de deux grandes grâces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cba65600-16e8-32b3-9b8b-0def0c778b7a",
                                        "entry_id": "e90c84ae-3551-355e-b2bf-0f8710d56a0f",
                                        "glosses": [
                                            "Avec respect et soumission."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc469251-857b-4f84-9aa1-a92e98e28cd2",
                                                "sense_id": "cba65600-16e8-32b3-9b8b-0def0c778b7a",
                                                "text": "Je supplie humblement Votre Majesté. S’incliner humblement."
                                            },
                                            {
                                                "example_id": "b2637dc1-fa9a-4387-b261-14bce890d03f",
                                                "sense_id": "cba65600-16e8-32b3-9b8b-0def0c778b7a",
                                                "text": "Toutes les nations voisines étaient effrayées, et lui envoyaient des députés sur sa route pour lui demander humblement la paix."
                                            },
                                            {
                                                "example_id": "ff23dc5f-b2d0-4b24-8381-42efe096aac7",
                                                "sense_id": "cba65600-16e8-32b3-9b8b-0def0c778b7a",
                                                "text": "Le noble […] Humblement du faquin rechercha l’alliance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "165e41ef-4e71-3e27-b82d-cb2afcf8041f",
                                        "entry_id": "e90c84ae-3551-355e-b2bf-0f8710d56a0f",
                                        "glosses": [
                                            "Modestement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54538515-db93-443a-9cd2-a0e49fe23515",
                                                "sense_id": "165e41ef-4e71-3e27-b82d-cb2afcf8041f",
                                                "text": "La violette qui se cache humblement sous les bois."
                                            },
                                            {
                                                "example_id": "56f540e7-b9c0-4cee-a9fc-98671795a3ee",
                                                "sense_id": "165e41ef-4e71-3e27-b82d-cb2afcf8041f",
                                                "text": "Elle a vécu humblement et est morte oubliée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83798daa-ef5a-452b-a79b-13c17038b11e",
                        "source_entry_id": "fa57d56f-d170-384e-9015-0e882233c06e",
                        "source_sense_id": "04945d6f-64fd-3f92-b98e-551a0b394afb",
                        "target_lang_word": "demütig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demütig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a32714d0-0501-38e9-9d34-f4d8658609b7",
                                        "entry_id": "ff712fd0-539f-316d-bff1-e2e00d3a4567",
                                        "glosses": [
                                            "sich selbst nicht über andere stellend; sich zurücknehmend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61148ccc-714c-4c95-9b61-3d91f03e0c8d",
                                                "sense_id": "a32714d0-0501-38e9-9d34-f4d8658609b7",
                                                "text": "Er sprach mit demütiger Stimme."
                                            },
                                            {
                                                "example_id": "f49c8b65-0c47-4b73-a6b5-1a6c0c4895e5",
                                                "sense_id": "a32714d0-0501-38e9-9d34-f4d8658609b7",
                                                "text": "„Es macht nachdenklich und auch ein bisschen demütig, wenn man leibhaftig miterlebt, wie ganze Deichabschnitte mit jahrhundertealten Eichen binnen Sekunden weggespült werden — nicht anders als Streichhölzer im Strudel der Badewanne.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "demütig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "44504e63-0ff4-300a-b12b-89b33302105a",
