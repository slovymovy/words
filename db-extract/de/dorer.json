                ],
                "senses": [
                    {
                        "sense_id": "b23c7ae0-1bdc-39af-a33c-e5df64d02499",
                        "entry_id": "63d40200-ca8b-3216-8a24-dc844b83496d",
                        "glosses": [
                            "(männliche) altgriechisch sprechende Person, deren Vorfahren in den Nordwesten des Sprachraums eingewandert waren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30d0c65d-8aaa-4cab-b61a-4d57c7b013b6",
                                "sense_id": "b23c7ae0-1bdc-39af-a33c-e5df64d02499",
                                "text": "„Überall in Griechenland wurde meist von den gleichen Künstlern in Marmor und in Bronze gearbeitet, doch haben augenscheinlich von Anfang an die beweglichen Ionier den anmutigen Marmor, die bedächtigen Dorer die ernsthafte Bronze vorgezogen.“"
                            },
                            {
                                "example_id": "afa5ba3d-3e30-41ec-aea6-d9f94fad0f78",
                                "sense_id": "b23c7ae0-1bdc-39af-a33c-e5df64d02499",
                                "text": "Die dorische Ordnung, eine der klassischen Säulenordnungen, wurde nach dem altgriechischen Stamm der Dorer benannt."
                            },
                            {
                                "example_id": "a14c0763-5556-4b21-b859-d8f9f960bb81",
                                "sense_id": "b23c7ae0-1bdc-39af-a33c-e5df64d02499",
                                "text": "„Tatsächlich sahen sich die Griechen überwiegend als Abkömmlinge von Invasoren, den von den Herakleiden angeführten Dorern und Äölern, welche die einheimischen Pelasger, Achäer und Ionier verdrängt hätten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
