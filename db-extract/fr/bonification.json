                "senses": [
                    {
                        "sense_id": "3bdc9ec2-f9ff-3949-b655-782bd466f6b4",
                        "entry_id": "42bf84b9-7f9f-38ae-847f-637b231250ea",
                        "glosses": [
                            "Amélioration d’un produit ou d’une qualité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cb00b72-22c3-486e-ad42-8058ccc0601d",
                                "sense_id": "3bdc9ec2-f9ff-3949-b655-782bd466f6b4",
                                "text": "La bonification d’un vin."
                            },
                            {
                                "example_id": "f3bbf407-526d-465b-adb9-5bbf61eb79df",
                                "sense_id": "3bdc9ec2-f9ff-3949-b655-782bd466f6b4",
                                "text": "Cette affaire est susceptible d’une bonification notable."
                            },
                            {
                                "example_id": "3722e183-e0e6-405d-a66a-ee1f24f93941",
                                "sense_id": "3bdc9ec2-f9ff-3949-b655-782bd466f6b4",
                                "text": "« J’ai constaté que jamais les convertis ne sont meilleurs qu’avant leur conversion. L’orgueilleux demeure orgueilleux, etc. Il n’y pas de bonification. »"
                            }
                        ]
                    },
                    {
                        "sense_id": "9595d1c7-6e46-3f91-a901-4330d41c0595",
                        "entry_id": "42bf84b9-7f9f-38ae-847f-637b231250ea",
                        "glosses": [
                            "Avantage accordé à un concurrent (en points, en temps…) dans un concours, une épreuve sportive, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40f20af4-5b83-4c3a-b5dc-d23281874a9b",
                                "sense_id": "9595d1c7-6e46-3f91-a901-4330d41c0595",
                                "text": "La victoire d’étape, avec sa minute de bonification, permettrait à Poulidor d’endosser le maillot jaune."
                            }
                        ]
                    }
                ],
