                "senses": [
                    {
                        "sense_id": "20579f56-5bfd-3718-9d07-d52670336c43",
                        "entry_id": "56d0f2d6-9645-3b18-920a-9bc5ce79cad4",
                        "glosses": [
                            "Qualifie la matière en plaque (cuir ou métal), que l’on a décoré en le travaillant à l’envers, au marteau ou avec des instruments spéciaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35421339-3678-4658-8de2-8f43fbb7f0f4",
                                "sense_id": "20579f56-5bfd-3718-9d07-d52670336c43",
                                "text": "Cuir repoussé, cuivre, métal repoussé."
                            },
                            {
                                "example_id": "375bd9d6-c771-4f9e-b3b9-f91e99b77459",
                                "sense_id": "20579f56-5bfd-3718-9d07-d52670336c43",
                                "text": "Le chœur, où sont les stalles, qu’on appelle silleria, est fermé par des grilles en fer repoussé d’un travail inconcevable."
                            },
                            {
                                "example_id": "3378d99c-b12d-4766-a31c-d0525527ed57",
                                "sense_id": "20579f56-5bfd-3718-9d07-d52670336c43",
                                "text": "M. Hyacinthe tire de la poche de son pantalon un porte-monnaie vaste, dont le cuir repoussé garde les traces dorées d’une tour Eiffel au-dessus d’une inscription : Souvenir de l’Exposition de 1900."
                            }
                        ]
                    }
                ],
