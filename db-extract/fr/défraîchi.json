                    {
                        "form_id": "c5215d5b-3a80-49c5-b69f-286d1d1b9920",
                        "entry_id": "2d8c32c1-2aaa-3830-92f6-98fd83262fef",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "défraîchies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3eb5d628-480a-37b4-8801-2eb5efc988d7",
                        "entry_id": "2d8c32c1-2aaa-3830-92f6-98fd83262fef",
                        "glosses": [
                            "Qui a perdu son apparence primitive, sa fraîcheur, son éclat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "972dd8e7-1af0-4748-84e6-8aadb1390d98",
                                "sense_id": "3eb5d628-480a-37b4-8801-2eb5efc988d7",
                                "text": "Il habitait un vieil hôtel particulier qui était maintenant assez défraîchi."
                            },
                            {
                                "example_id": "a9faab75-9bbd-4c28-a3ff-5106a0b4b219",
                                "sense_id": "3eb5d628-480a-37b4-8801-2eb5efc988d7",
                                "text": "Ils arriveront vers onze heures, comme à Paris, et nous serons déjà défraîchies de danser."
                            },
                            {
                                "example_id": "f007530f-bdff-41e8-910a-8564a3cb9887",
                                "sense_id": "3eb5d628-480a-37b4-8801-2eb5efc988d7",
                                "text": "L’année où il achevait son doctorat en droit à Bordeaux, il avait connu cette fille déjà défraîchie, à peine moins âgée que lui, dont il subissait le pouvoir sans en chercher la raison."
                            },
                            {
                                "example_id": "96606345-c91f-412b-85fd-cc2634dcb48d",
                                "sense_id": "3eb5d628-480a-37b4-8801-2eb5efc988d7",
                                "text": "Rien ne subsistait plus, aux yeux de Janine, qu’un mâle déjà un peu défraîchi, enclin à préférer l’alcool à tout le reste et à considérer l’amour comme un travail, un devoir, une fatigue… Quelle misère !"
                            },
                            {
                                "example_id": "d3e9f699-d7a0-4d19-9e76-0fcad2d95f68",
                                "sense_id": "3eb5d628-480a-37b4-8801-2eb5efc988d7",
                                "text": "31 janvier 1941 – Flora a seize ans, il n’y a pas péril en la demeure. Mais moi je serai une femme sans avoir été une jeune fille, défraîchie sans avoir fleuri, comme ces boutons de camélia malade qui se fanent encore fermés, clos sur un secret que personne ne déchiffrera."
                            }
                        ]
                    }
