    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "b016cafc-2a0b-3f03-9a43-533bbb0e0349",
                    "sense_definition": "met de binnenkant naar buiten gekeerd",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "fysieke_toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je draagt je trui <w>binnenstebuiten</w> en iedereen kan het labeltje zien.",
                            "target_lang_translations": {
                                "en": "You are wearing your sweater <w>inside out</w> and everyone can see the label.",
                                "ru": "Ты носишь свитер <w>наизнанку</w>, и все видят этикетку."
                            }
                        },
                        {
                            "text": "Je moet deze spijkerbroek altijd <w>binnenstebuiten</w> wassen om de kleur te behouden.",
                            "target_lang_translations": {
                                "en": "You should always wash these jeans <w>inside out</w> to preserve the color.",
                                "ru": "Эти джинсы всегда нужно стирать <w>наизнанку</w>, чтобы сохранить цвет."
                            }
                        }
                    ],
                    "common_phrases": [
                        "binnenstebuiten wassen",
                        "binnenstebuiten dragen"
                    ],
                    "target_lang_definitions": {
                        "en": "with the inside facing outwards",
                        "ru": "внутренней стороной наружу"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "inside out",
                                "target_lang_sense_clarification": "referring to clothing or objects"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "наизнанку",
                                "target_lang_sense_clarification": "об одежде или предметах"
                            },
                            {
                                "target_lang_word": "вывернутый",
                                "target_lang_sense_clarification": "о состоянии вещи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2347a3aa-51aa-3aad-a35b-fa5479cd6f8a",
                    "sense_definition": "iets heel grondig en tot in de kleinste details onderzoeken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onderzoek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De rechercheurs besloten het hele huis <w>binnenstebuiten</w> te keren op zoek naar bewijs.",
                            "target_lang_translations": {
                                "en": "The detectives decided to turn the whole house <w>upside down</w> in search of evidence.",
                                "ru": "Детективы решили перевернуть весь дом <w>вверх дном</w> в поисках улик."
                            }
                        },
                        {
                            "text": "De accountant gaat de administratie van het bedrijf volledig <w>binnenstebuiten</w> keren.",
                            "target_lang_translations": {
                                "en": "The accountant is going to examine the company's administration <w>inside out</w>.",
                                "ru": "Бухгалтер собирается <w>досконально</w> проверить всю отчетность компании."
                            }
                        }
                    ],
                    "synonyms": [
                        "grondig",
                        "uitvoerig"
                    ],
                    "common_phrases": [
                        "binnenstebuiten keren"
                    ],
                    "target_lang_definitions": {
                        "en": "to examine something very thoroughly and in the smallest detail",
                        "ru": "исследовать что-либо очень тщательно и до мельчайших деталей"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "inside out",
                                "target_lang_sense_clarification": "knowing or examining something thoroughly"
                            },
                            {
                                "target_lang_word": "upside down",
                                "target_lang_sense_clarification": "searching a place very thoroughly"
                            },
                            {
                                "target_lang_word": "thoroughly",
                                "target_lang_sense_clarification": "in a very detailed manner"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "вверх дном",
                                "target_lang_sense_clarification": "при тщательном обыске или поиске"
                            },
                            {
                                "target_lang_word": "вдоль и поперек",
                                "target_lang_sense_clarification": "знать или изучить что-то досконально"
                            },
                            {
                                "target_lang_word": "досконально",
                                "target_lang_sense_clarification": "очень подробно и глубоко"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}