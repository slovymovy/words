                ],
                "senses": [
                    {
                        "sense_id": "0d474702-b4ef-37b6-9818-33579d6dbf04",
                        "entry_id": "4e21d443-460e-37eb-b51b-99de4cfd2455",
                        "glosses": [
                            "Bad luck, misfortune."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a6d3b77e-5f4a-49eb-9b1d-afe28477fcaa",
                                "sense_id": "0d474702-b4ef-37b6-9818-33579d6dbf04",
                                "text": "But let this same be presently perform'd / Even when men's minds are wild, lest more mischance / On plots and errors happen."
                            },
                            {
                                "example_id": "22ad2c1d-b8ec-469d-b7f0-24201cc4f779",
                                "sense_id": "0d474702-b4ef-37b6-9818-33579d6dbf04",
                                "text": "I write gaily enough, for there is no use in bewailing such a hopeless mischance."
                            }
                        ]
                    },
                    {
                        "sense_id": "4b66d5d1-a26d-3c3b-9a53-e7e6b294e323",
                        "entry_id": "4e21d443-460e-37eb-b51b-99de4cfd2455",
                        "glosses": [
                            "A mishap, an unlucky circumstance."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "78798637-94b7-443a-974e-a1f5a8242cc8",
                                "sense_id": "4b66d5d1-a26d-3c3b-9a53-e7e6b294e323",
                                "text": "He doth miraculously protect from thieves, incursions, sword, fire, and all violent mischances […]"
                            }
                        ]
                    }
                ],
