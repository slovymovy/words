                        "glosses": [
                            "Agent des services d’intelligence ou soldat qui quitte son pays et trouve refuge dans un pays adverse souvent, mais pas nécessairement, en échange de renseignements, celui qui fait défection."
                        ],
                        "tags": [],
                        "examples": [
