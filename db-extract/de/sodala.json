                            {
                                "example_id": "a72960ab-c544-4fc5-bf7e-83fc57291dc7",
                                "sense_id": "96effe65-350a-3d50-8140-ee30dfb146af",
                                "text": "Hier sind Ihre Schwammerl, sodala! Darf's sonst noch was sein?"
                            },
                            {
                                "example_id": "93406bd4-ed70-4cf0-94f5-456af2ab7250",
                                "sense_id": "96effe65-350a-3d50-8140-ee30dfb146af",
                                "text": "„Nach seinem Triumph bei der Landtagswahl stand Ministerpräsident Horst Seehofer den Journalisten vor der CSU-Zentrale freudig Rede und Antwort. Am Schluss rundete er seine Stellungnahme mit einem herzhaften »Alright!« ab. Das ist Globalisierungsdeutsch. Früher hätte ein bayerischer Politiker bei solchen Anlässen sodala gesagt […].“"
                            },
                            {
                                "example_id": "baaa287f-f95b-4cda-82dd-c3141870e652",
                                "sense_id": "96effe65-350a-3d50-8140-ee30dfb146af",
                                "text": "„»Sodala, Härr, also da drüben, ham S' g'sagt, wohnt s', oder vielleicht net – und Mosbacher hoaßt s', ham S' g'sagt, oder vielleicht net?« Und schon stiegen wir die Treppe hinauf zu der Frau Mosbacher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
