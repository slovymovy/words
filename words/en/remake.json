                },
                {
                    "sense_id": "af5164e0-19da-35ca-83fc-3885a77331b7",
                    "sense_definition": "To produce a new, especially updated, version of a film, video game, or similar work.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "media_version",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director wanted to <w>remake</w> some of his favourite films.",
                            "target_lang_translations": {
                                "ru": "Режиссер хотел <w>переснять</w> некоторые из своих любимых фильмов.",
                                "zh": "导演想<w>翻拍</w>几部他最喜欢的电影。",
                                "es": "El director quería <w>volver a filmar</w> algunas de sus películas favoritas."
                            }
                        },
                        {
                            "text": "They plan to <w>remake</w> the popular video game with better graphics.",
                            "target_lang_translations": {
                                "ru": "Они планируют <w>сделать римейк</w> популярной видеоигры с улучшенной графикой.",
                                "zh": "他们计划用更好的画质来<w>重制</w>这款热门电子游戏。",
                                "es": "Planean <w>hacer un remake</w> del popular videojuego con mejores gráficos."
                            }
                        }
                    ],
                    "synonyms": [
                        "re-create"
                    ],
                    "common_phrases": [
                        "remake a movie",
                        "remake a classic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Создать новую, обычно обновленную версию фильма, видеоигры или подобного произведения.",
                        "zh": "制作电影、电子游戏等作品的翻拍或重制版本。",
                        "es": "Producir una versión nueva, especialmente actualizada, de una película, videojuego u obra similar."
