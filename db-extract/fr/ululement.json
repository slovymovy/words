        "fr-extract.jsonl": [
            {
                "entry_id": "c9f6ffd4-6cf0-3200-93c8-d43a76204131",
                "word": "ululement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "33716ed6-a8c7-4bfd-90d1-f9510403db96",
                        "entry_id": "c9f6ffd4-6cf0-3200-93c8-d43a76204131",
                        "tags": [
                            "plural"
                        ],
                        "form": "ululements"
                    },
                    {
                        "form_id": "7ce66aca-5ef2-4eb6-8419-8841c57b6b2b",
                        "entry_id": "c9f6ffd4-6cf0-3200-93c8-d43a76204131",
                        "tags": [],
                        "form": "hululement"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ab0c4e7f-716b-301d-a994-ea77e206f2b2",
                        "entry_id": "c9f6ffd4-6cf0-3200-93c8-d43a76204131",
                        "glosses": [
                            "Cri des oiseaux de nuit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69b1aa53-b7a4-4a24-9b8e-f44a66fd6d93",
                                "sense_id": "ab0c4e7f-716b-301d-a994-ea77e206f2b2",
                                "text": "« Que l’ululement du hibou coule ses ou de velours dans le souffle doux de ton cou. »"
                            },
                            {
                                "example_id": "43d5b0c5-ea41-4a17-a725-49fd64c19cb2",
                                "sense_id": "ab0c4e7f-716b-301d-a994-ea77e206f2b2",
                                "text": "De temps à autre seulement, on entendait le hurlement lointain d’un loup, ou, ponctuant le silence funèbre, le ululement du hibou blanc que Kazan avait chassé et qui, du sapin sur lequel il était perché, susurrait sa protestation. — (James Oliver Curwood, Kazan, 1914, traduit de l’anglais par P. Gruyer et L. Postif, Hachette, 1937, page 150)"
                            }
                        ]
                    },
                    {
                        "sense_id": "20b3e6c6-26e2-3432-ab01-8a030acbcef6",
                        "entry_id": "c9f6ffd4-6cf0-3200-93c8-d43a76204131",
                        "glosses": [
                            "Cri ressemblant à celui des oiseaux."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "2fb94afe-fbac-45d7-8a01-ded8f0c6af14",
                                "sense_id": "20b3e6c6-26e2-3432-ab01-8a030acbcef6",
                                "text": "Au cours de ma dernière visite dans la salle des cages, je me suis aperçu d'un changement notable parmi les hommes. Il semble qu’un instinct mystérieux les ait avertis de la naissance miraculeuse. Ils ont salué ma présence par un concert de longs ululements."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b475f036-f7df-4d6b-ac4d-714a34439551",
                        "source_entry_id": "c9f6ffd4-6cf0-3200-93c8-d43a76204131",
                        "target_lang_word": "hoot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hoot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "784f38b8-2925-3439-94a3-570424b46277",
                                        "entry_id": "0591e0ee-d0e9-3de6-baf2-fe1f5a3be010",
                                        "glosses": [
                                            "A derisive cry or shout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6502584-4343-4e2f-9dc4-0096cc02767b",
                                                "sense_id": "784f38b8-2925-3439-94a3-570424b46277",
                                                "text": "My performance drew hoots of derision from the crowd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af5a113b-1fcb-3fb9-bc8f-ba31d0c53bf8",
                                        "entry_id": "0591e0ee-d0e9-3de6-baf2-fe1f5a3be010",
                                        "glosses": [
                                            "The cry of an owl."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e96b4e65-a35b-4355-938e-28c5841ccd4c",
                                                "sense_id": "af5a113b-1fcb-3fb9-bc8f-ba31d0c53bf8",
                                                "text": "I heard the hoot of an owl."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46445963-5688-3a0b-a4fa-f729a806d480",
                                        "entry_id": "0591e0ee-d0e9-3de6-baf2-fe1f5a3be010",
                                        "glosses": [
                                            "A fun event or person."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "979f7562-a75d-41c4-809d-e056119b6614",
                                                "sense_id": "46445963-5688-3a0b-a4fa-f729a806d480",
                                                "text": "The party at the weekend was such a hoot! Thanks for the invite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e66ef91-2231-3ef1-a748-b15a11bbf45e",
                                        "entry_id": "0591e0ee-d0e9-3de6-baf2-fe1f5a3be010",
                                        "glosses": [
                                            "A small particle; a whit or jot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "666dc589-7b3e-4b83-9d70-91a13c740684",
                                                "sense_id": "7e66ef91-2231-3ef1-a748-b15a11bbf45e",
                                                "text": "We don't care a hoot about what you think."
                                            },
                                            {
                                                "example_id": "97a494a5-5ea0-4163-a507-08f6d91cdf20",
                                                "sense_id": "7e66ef91-2231-3ef1-a748-b15a11bbf45e",
                                                "text": "Well, it was Sunday morning, and the wheat nothing like ripe; but it was a chance, and I got onto my reaper and banged down every hoot of it before Monday night."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hoot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "45fe110e-2b67-3cfd-b863-02ac2bff47c1",
                                        "entry_id": "a80ae3c3-e67c-3213-a938-c42264cfa9ee",
                                        "glosses": [
                                            "To cry out or shout in contempt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f04217e-d192-4332-841d-7d42f065e227",
                                                "sense_id": "45fe110e-2b67-3cfd-b863-02ac2bff47c1",
                                                "text": "Matrons and girls shall hoot at thee no more,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "481f4280-1bdf-3acb-b740-83d27ac12c5d",
                                        "entry_id": "a80ae3c3-e67c-3213-a938-c42264cfa9ee",
                                        "glosses": [
                                            "To make a hoo, the cry of an owl."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "942cb9ea-9287-4b83-807b-705135270aeb",
                                                "sense_id": "481f4280-1bdf-3acb-b740-83d27ac12c5d",
                                                "text": "The clamorous owl that nightly hoots and wonders / At our quaint spirits."
                                            },
                                            {
                                                "example_id": "34a1ffa7-17de-442d-997d-327aaecaf3a0",
                                                "sense_id": "481f4280-1bdf-3acb-b740-83d27ac12c5d",
                                                "text": "Outside an owl was hooting most dismally in the darkness. The villa was on a by-road, and there was no human sound to link them up with life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6659eb12-73f9-39d0-ab38-a9603bd8b554",
                                        "entry_id": "a80ae3c3-e67c-3213-a938-c42264cfa9ee",
                                        "glosses": [
                                            "To assail with contemptuous cries or shouts; to follow with derisive shouts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43754eb0-fb66-4666-92dc-fa9b1cfd903b",
                                                "sense_id": "6659eb12-73f9-39d0-ab38-a9603bd8b554",
                                                "text": "Mary felt extremely offended when the workers hooted at her."
                                            },
                                            {
                                                "example_id": "02b8c251-6c79-489e-9da5-ef86277e579a",
                                                "sense_id": "6659eb12-73f9-39d0-ab38-a9603bd8b554",
                                                "text": "And I will be content, that Partridge, and the rest of his Clan, may hoot me for a Cheat and Impostor, if I fail in any single Particular of Moment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "480b7818-90c5-32a0-98f3-adbc0d52ccd0",
                                        "entry_id": "a80ae3c3-e67c-3213-a938-c42264cfa9ee",
                                        "glosses": [
                                            "To sound the horn of a vehicle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff9f7257-30d2-4128-ac02-c5167cb9257a",
                                                "sense_id": "480b7818-90c5-32a0-98f3-adbc0d52ccd0",
                                                "text": "When you arrive to pick me up, hoot, and I'll come outside."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hoot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2098afaf-6408-30b0-b9f5-6a1b76efcdfc",
                                        "entry_id": "48fe111a-4060-3f9e-8fab-7dc39efe86bf",
                                        "glosses": [
                                            "Money, especially in the form of cash given as payment."
                                        ],
                                        "tags": [
                                            "New-Zealand",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a848ad1-5976-4b35-96a7-732271bfcab5",
                                                "sense_id": "2098afaf-6408-30b0-b9f5-6a1b76efcdfc",
                                                "text": "On the construction you could make a pot of hoot in no time. You oughter be able to get two or three quid a day when things is busy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
