                    },
                    {
                        "translation_id": "62b44dae-3019-4669-b5e6-2ed40a2f5e5d",
                        "source_entry_id": "0b1f63f7-3ca9-33f3-bf4e-c64478e021a9",
                        "source_sense_id": "2994ed74-1d76-3875-bd1d-cc98deaa2a22",
                        "target_lang_word": "opstand",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "opstand",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4aea71f6-8f74-3c30-a666-9aadeb16011f",
                                        "entry_id": "c3a87cd9-b4b6-3248-a57b-56b7e5b85b44",
                                        "glosses": [
                                            "een massale, vaak gewelddadige, poging om het heersende gezag omver te werpen"
                                        ],
                                        "tags": [
                                            "maatschappij"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06204d52-cbdd-4f1d-80a0-605c37b429cd",
                                                "sense_id": "4aea71f6-8f74-3c30-a666-9aadeb16011f",
                                                "text": "De opstand die al enige tijd woedde werd gewelddadig onderdrukt."
                                            },
                                            {
                                                "example_id": "8c43612f-6305-406a-a905-2694bdb3e602",
                                                "sense_id": "4aea71f6-8f74-3c30-a666-9aadeb16011f",
                                                "text": "Maar nadat Boedapest zijn equivalent van het Slânsky-proces had doorgemaakt, werden de demonstraties steeds oncontroleerbaarder en ontwikkelden zich tot een opstand tegen alles waar de partij en regering voor stonden, geleidelijk aan met gewapende groepen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53084108-2a6b-344e-8198-2b4c569203cc",
                                        "entry_id": "c3a87cd9-b4b6-3248-a57b-56b7e5b85b44",
                                        "glosses": [
                                            "staande bomen of struiken, ter onderscheiding van aangrenzende begroeiing"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bee8f3c7-6a13-4233-8495-9bc9540f45f9",
                                                "sense_id": "53084108-2a6b-344e-8198-2b4c569203cc",
                                                "text": "Rond 1976 kwam Heinrich Reininger op het idee om de eindkap niet meer per opstand te bepalen maar individueel van de beste bomen."
                                            }
                                        ]
                                    },
                                    {
