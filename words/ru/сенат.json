                {
                    "sense_id": "a48f56c0-259d-3857-a2d6-effec3a47067",
                    "sense_definition": "Высшая палата парламента в ряде государств.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "political_body",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Американский <w>сенат</w> одобрил новый законопроект о налогах.",
                            "target_lang_translations": {
                                "en": "The US <w>Senate</w> approved the new tax bill.",
                                "fr": "Le <w>Sénat</w> américain a approuvé le nouveau projet de loi sur les impôts."
                            }
                        },
                        {
                            "text": "Чтобы стать законом, документ должен пройти через <w>сенат</w>.",
                            "target_lang_translations": {
                                "en": "To become law, the document must pass through the <w>senate</w>.",
                                "fr": "Pour devenir une loi, le document doit passer par le <w>sénat</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "верхняя палата"
                    ],
                    "antonyms": [
                        "нижняя палата"
                    ],
                    "common_phrases": [
                        "американский сенат",
                        "член сената",
                        "выборы в сенат",
                        "заседание сената"
                    ],
                    "target_lang_definitions": {
                        "en": "The upper house of parliament in a number of states.",
                        "fr": "Chambre haute du parlement dans un certain nombre d'États."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "senate",
                                "target_lang_sense_clarification": "legislative body"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "sénat",
                                "target_lang_sense_clarification": "organe législatif"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7d1a7d5-aa48-35fa-b07a-9cb595ff693d",
                    "sense_definition": "Высший государственный совет старейшин в Древнем Риме.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "political_body",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Римский <w>сенат</w> часто вступал в конфликты с императорами.",
                            "target_lang_translations": {
                                "en": "The Roman <w>Senate</w> often came into conflict with the emperors.",
                                "fr": "Le <w>Sénat</w> romain entrait souvent en conflit avec les empereurs."
                            }
                        },
                        {
                            "text": "Консул обратился к собравшимся, когда <w>сенат</w> начал своё заседание.",
                            "target_lang_translations": {
                                "en": "The consul addressed the gathering when the <w>senate</w> began its session.",
                                "fr": "Le consul s'est adressé à l'assemblée lorsque le <w>sénat</w> a commencé sa séance."
                            }
                        }
                    ],
                    "common_phrases": [
                        "римский сенат"
                    ],
                    "target_lang_definitions": {
                        "en": "The supreme state council of elders in Ancient Rome.",
                        "fr": "Conseil supérieur des anciens dans la Rome antique."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "senate",
                                "target_lang_sense_clarification": "ancient Roman council"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "sénat",
                                "target_lang_sense_clarification": "assemblée de la Rome antique"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "223767dd-151b-3565-9b84-5f7f5778acda",
                    "sense_definition": "Высший орган государственной власти и законодательства в Российской империи (с 1711 по 1917 год).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "political_body",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Император подписал указ, который был немедленно направлен в <w>сенат</w>.",
                            "target_lang_translations": {
                                "en": "The emperor signed a decree which was immediately sent to the <w>Senate</w>.",
                                "fr": "L'empereur signa un décret qui fut immédiatement transmis au <w>Sénat</w>."
                            }
                        },
                        {
                            "text": "Правительствующий <w>сенат</w> следил за исполнением законов по всей стране.",
                            "target_lang_translations": {
                                "en": "The Governing <w>Senate</w> monitored the execution of laws throughout the country.",
                                "fr": "Le <w>Sénat</w> dirigeant veillait à l'application des lois dans tout le pays."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Правительствующий сенат",
                        "здание сената"
                    ],
                    "target_lang_definitions": {
                        "en": "The supreme body of state power and legislation in the Russian Empire (from 1711 to 1917).",
                        "fr": "Organe suprême du pouvoir d'État et de la législation dans l'Empire russe (de 1711 à 1917)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Senate",
                                "target_lang_sense_clarification": "historical Russian institution"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "Sénat",
                                "target_lang_sense_clarification": "institution historique russe"
                            }
                        ]
                    }
                }
            ]
        },
