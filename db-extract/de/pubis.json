                "senses": [
                    {
                        "sense_id": "69dda576-db46-3417-a776-f4704e564e60",
                        "entry_id": "31221b16-3c08-3faa-a9b0-23360418be7c",
                        "glosses": [
                            "ein flacher, winkelförmiger Knochen und Teil des Beckens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d99da5bb-8ab8-4174-b232-d75ffae0d909",
                                "sense_id": "69dda576-db46-3417-a776-f4704e564e60",
                                "text": "„Dieses Becken mit seinem nach hinten zeigendem Schambein (Pubis) und dem nach vorn ragendem Präpubis war typisch für die Ornithischier.“"
                            },
                            {
                                "example_id": "89153a2f-53a6-46b8-abe1-3304458857ec",
                                "sense_id": "69dda576-db46-3417-a776-f4704e564e60",
                                "text": "„Die Beckenknochen der Saurischier – auch Echsenbecken-Dinosaurier genannt – sind wie bei anderen Landreptilien angeordnet. Das heißt, der so genannte Pubis – ein Vorderknochen im Hüftgürtel – zeigt nach vorne. Bei den Ornithischier zeigt dieser Knochen dagegen nach hinten und ähnelt so dem Skelettaufbau der Vögel – daher auch der Name Vogelbecken-Dinosaurier.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
