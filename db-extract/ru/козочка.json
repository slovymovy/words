                    {
                        "translation_id": "4769c1af-1afc-4c0c-b159-4fb3bfffde4c",
                        "source_entry_id": "f73dcb45-49f0-3313-82cd-81684ee727b8",
                        "source_sense_id": "3dfbd820-9bbd-3828-acb8-00c9f286227f",
                        "target_lang_word": "Zicklein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zicklein",
