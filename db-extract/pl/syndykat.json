                    },
                    {
                        "sense_id": "8b1a92b9-ddb1-3ed0-9f44-cc07ee4772f7",
                        "entry_id": "ecd284cd-45df-3269-a4e6-5beafda6337e",
                        "glosses": [
                            "związek zawodowy – we Francji, Hiszpanii i niektórych innych krajach"
                        ],
                        "tags": [],
