{
    "word_family": [
        "receive",
        "receiver",
        "receipt",
        "reception",
        "receptive"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7c9791cd-0667-3c6a-921e-1f67431f646c",
                    "sense_definition": "A person or entity that receives or is awarded something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "group_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My e-mail never reached the intended <w>recipient</w>.",
                            "target_lang_translations": {
                                "ru": "Мое электронное письмо так и не дошло до предполагаемого <w>получателя</w>.",
                                "nl": "Mijn e-mail heeft de beoogde <w>ontvanger</w> nooit bereikt."
                            }
                        },
                        {
                            "text": "She was the proud <w>recipient</w> of the prestigious award.",
                            "target_lang_translations": {
                                "ru": "Она стала гордым <w>получателем</w> престижной награды.",
                                "nl": "Zij was de trotse <w>ontvanger</w> van de prestigieuze prijs."
                            }
                        }
                    ],
                    "synonyms": [
                        "receiver",
                        "addressee"
                    ],
                    "antonyms": [
                        "giver"
                    ],
                    "common_phrases": [
                        "intended recipient",
                        "award recipient",
                        "grant recipient",
                        "recipient of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или организация, которые получают что-либо (почту, деньги, награду).",
                        "nl": "Een persoon of entiteit die iets ontvangt of krijgt toegewezen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "получатель",
                                "target_lang_sense_clarification": "общий смысл: тот, кто получает что-либо"
                            },
                            {
                                "target_lang_word": "адресат",
                                "target_lang_sense_clarification": "получатель письма или сообщения"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "ontvanger",
                                "target_lang_sense_clarification": "iemand aan wie iets wordt overhandigd of gegeven"
                            },
                            {
                                "target_lang_word": "geadresseerde",
                                "target_lang_sense_clarification": "specifiek voor post of berichten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b1c3638-e7fe-3dcf-ad4a-02d7497419ef",
                    "sense_definition": "A patient who receives a donated organ or tissue.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "group_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heart transplant <w>recipient</w> is recovering well in the hospital.",
                            "target_lang_translations": {
                                "ru": "<w>Реципиент</w> донорского сердца хорошо восстанавливается в больнице.",
                                "nl": "De <w>ontvanger</w> van de harttransplantatie herstelt goed in het ziekenhuis."
                            }
                        },
                        {
                            "text": "Doctors must ensure the donor matches the <w>recipient</w> to prevent rejection.",
                            "target_lang_translations": {
                                "ru": "Врачи должны убедиться, что донор подходит <w>реципиенту</w>, чтобы предотвратить отторжение.",
                                "nl": "Artsen moeten ervoor zorgen dat de donor past bij de <w>ontvanger</w> om afstoting te voorkomen."
                            }
                        }
                    ],
                    "synonyms": [
                        "receiver"
                    ],
                    "common_phrases": [
                        "transplant recipient",
                        "organ recipient"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пациент, которому пересаживают донорский орган или ткани.",
                        "nl": "Een patiënt die een gedoneerd orgaan of weefsel ontvangt."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реципиент",
                                "target_lang_sense_clarification": "медицинский термин"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "ontvanger",
                                "target_lang_sense_clarification": "algemene term voor iemand die een orgaan ontvangt"
                            },
                            {
                                "target_lang_word": "recipiënt",
                                "target_lang_sense_clarification": "medische term voor de ontvanger van een transplantatie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4abcdb57-229a-3d88-b4a3-2bc1d8d3e207",
                    "sense_definition": "A vessel used in distillation to collect the liquid.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The distilled liquid slowly dripped into the glass <w>recipient</w>.",
                            "target_lang_translations": {
                                "ru": "Дистиллированная жидкость медленно капала в стеклянный <w>приёмник</w>.",
                                "nl": "De gedestilleerde vloeistof druppelde langzaam in het glazen <w>opvangvat</w>."
                            }
                        },
                        {
                            "text": "He carefully attached the <w>recipient</w> to the apparatus.",
                            "target_lang_translations": {
                                "ru": "Он осторожно присоединил <w>приёмник</w> к аппарату.",
                                "nl": "Hij bevestigde het <w>opvangvat</w> voorzichtig aan het apparaat."
                            }
                        }
                    ],
                    "synonyms": [
                        "receiver"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical chemistry context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сосуд, используемый при дистилляции для сбора жидкости.",
                        "nl": "Een vat dat bij destillatie wordt gebruikt om de vloeistof op te vangen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приёмник",
                                "target_lang_sense_clarification": "химический термин: сосуд для сбора"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "opvangvat",
                                "target_lang_sense_clarification": "chemisch instrument voor het verzamelen van vloeistof"
                            },
                            {
                                "target_lang_word": "ontvanger",
                                "target_lang_sense_clarification": "technische term voor een opvangreservoir"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c06f4b01-f0da-3567-80d6-290142c5e50a",
                    "sense_definition": "Functioning to receive something; receptive.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>recipient</w> country benefited greatly from the foreign aid.",
                            "target_lang_translations": {
                                "ru": "Страна-<w>получатель</w> получила значительную выгоду от иностранной помощи.",
                                "nl": "Het <w>ontvangende</w> land profiteerde enorm van de buitenlandse hulp."
                            }
                        },
                        {
                            "text": "We need to identify the <w>recipient</w> bank account for the transfer.",
                            "target_lang_translations": {
                                "ru": "Нам нужно определить банковский счет <w>получателя</w> для перевода.",
                                "nl": "We moeten de <w>ontvangende</w> bankrekening identificeren voor de overboeking."
                            }
                        }
                    ],
                    "common_phrases": [
                        "recipient country",
                        "recipient account"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполняющий функцию получения чего-либо; принимающий.",
                        "nl": "Functionerend om iets te ontvangen; ontvangend."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "получатель",
                                "target_lang_sense_clarification": "в составе устойчивых сочетаний (напр. страна-получатель)"
                            },
                            {
                                "target_lang_word": "принимающий",
                                "target_lang_sense_clarification": "прилагательное/причастие"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "ontvangend",
                                "target_lang_sense_clarification": "bijvoeglijk naamwoord voor iets dat ontvangt"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}