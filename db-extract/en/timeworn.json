                    },
                    {
                        "translation_id": "a55e4848-88a6-4643-bbea-1dda3431790f",
                        "source_entry_id": "df778733-3053-30a6-93f9-b9d660b3fb55",
                        "source_sense_description": "showing the effects of wear",
                        "target_lang_word": "abgenutzt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abgenutzt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1c8ff14e-31cd-369d-86ce-207db1a6521b",
                                        "entry_id": "2cb4b01f-aea9-361f-9af9-b66d2d403b6d",
                                        "glosses": [
                                            "durch häufige Benutzung verschlissen, aufgetragen, starke Gebrauchsspuren habend/aufweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acf8926d-d697-4934-9b25-701a02bef3b7",
                                                "sense_id": "1c8ff14e-31cd-369d-86ce-207db1a6521b",
                                                "text": "„Den Küchentisch haben wir schon so lange, die Oberfläche ist total abgenutzt. Den müßten wir mal schleifen und lackieren, dann sieht er wieder wie neu aus.“"
                                            },
                                            {
                                                "example_id": "ae413667-812c-4822-9324-ba7be7c16d28",
                                                "sense_id": "1c8ff14e-31cd-369d-86ce-207db1a6521b",
                                                "text": "„Mit dem abgenutzten Anzug kannst Du nicht zum Vorstellungsgespräch gehen. Was meinst Du, was Du da für einen Eindruck machst?“"
                                            },
                                            {
                                                "example_id": "690401f9-d1f6-4363-bcff-a6e5eb01089a",
                                                "sense_id": "1c8ff14e-31cd-369d-86ce-207db1a6521b",
                                                "text": "„Meine Bandscheiben sind völlig abgenutzt, ich muß unters Messer.“ (= mich einer Operation unterziehen)"
                                            },
                                            {
                                                "example_id": "f7f4c879-d66a-4147-96b1-f5ba4d7dfb44",
                                                "sense_id": "1c8ff14e-31cd-369d-86ce-207db1a6521b",
                                                "text": "„Gott sei Dank habe ich das Auto vorgestern in die Werkstatt gebracht, der Mechaniker erzählte mir von den völlig abgenutzten Bremsbelägen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "da041ef4-e7e2-3a70-a02c-00a741735684",
                                        "entry_id": "2cb4b01f-aea9-361f-9af9-b66d2d403b6d",
                                        "glosses": [
                                            "durch häufigen öffentlichen Gebrauch eines Wortes oder einer Phrase als formelhaft oder inhaltsleer wahrgenommen"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46570f61-7a38-4d48-8ea5-1740ae23ebfe",
                                                "sense_id": "da041ef4-e7e2-3a70-a02c-00a741735684",
                                                "text": "Nicht mehr ganz frisch, aber noch genießbar: Markus Lanz [Anm.: im ZDF-Fernsehen als neuer Moderator] präsentiert abgenutzte Witze und aufgewärmte Wetten."
                                            },
                                            {
                                                "example_id": "4c5ab77a-a752-443a-a2f0-05e11c5ddece",
                                                "sense_id": "da041ef4-e7e2-3a70-a02c-00a741735684",
                                                "text": "Abgenutzte Worte wie „Traumreise“, „Insel der Sehnsucht“, „Reise des Jahres“ scheinen doch noch Wirkung zu haben, und manche Ankündigungen geben weniger Auskunft über den Wert der angepriesenen Reisen als über den Geist des Unternehmens und die Interessen und Emotionen der Angesprochenen, der Konsumenten."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "abgenutzt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3fd39571-f37c-3a5d-9410-a2a1dd7748f4",
                                        "entry_id": "21800a4a-9404-35b8-9ca2-40150c0039bc",
