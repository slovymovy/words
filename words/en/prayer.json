                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "spiritual_communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every night before bed, the child recites a short <w>prayer</w>.",
                            "target_lang_translations": {
                                "ru": "Каждую ночь перед сном ребенок читает короткую <w>молитву</w>.",
                                "zh": "每天晚上睡觉前，孩子都会诵读一段简短的<w>祷文</w>。",
                                "nl": "Elke avond voor het slapengaan zegt het kind een kort <w>gebed</w> op.",
                                "pl": "Każdego wieczoru przed snem dziecko odmawia krótką <w>modlitwę</w>.",
                                "de": "Jeden Abend vor dem Schlafengehen spricht das Kind ein kurzes <w>Gebet</w>.",
                                "fr": "Chaque soir avant de se coucher, l'enfant récite une courte <w>prière</w>.",
                                "it": "Ogni sera prima di andare a dormire, il bambino recita una breve <w>preghiera</w>.",
                                "cs": "Každý večer před spaním dítě odříká krátkou <w>modlitbu</w>.",
                                "tr": "Çocuk her gece yatmadan önce kısa bir <w>dua</w> okur.",
                                "es": "Cada noche antes de dormir, el niño recita una breve <w>oración</w>."
                            }
                        },
                        {
                            "text": "The priest read a <w>prayer</w> from the ancient book.",
                            "target_lang_translations": {
                                "ru": "Священник прочитал <w>молитву</w> из древней книги.",
                                "zh": "牧师从那本古书中读了一段<w>祷文</w>。",
                                "nl": "De priester las een <w>gebed</w> voor uit het oude boek.",
                                "pl": "Ksiądz odczytał <w>modlitwę</w> ze starej księgi.",
                                "de": "Der Priester las ein <w>Gebet</w> aus dem alten Buch vor.",
                                "fr": "Le prêtre a lu une <w>prière</w> tirée du livre ancien.",
                                "it": "Il sacerdote ha letto una <w>preghiera</w> dal libro antico.",
                                "cs": "Kněz přečetl <w>modlitbu</w> ze staré knihy.",
                                "tr": "Rahip, eski kitaptan bir <w>dua</w> okudu.",
                                "es": "El sacerdote leyó una <w>oración</w> del libro antiguo."
                            }
                        }
