                "senses": [
                    {
                        "sense_id": "34b99dc8-cf59-3258-b672-0b947fa87b2e",
                        "entry_id": "76ec18f3-4463-3f69-b60e-5e09eb5ec10f",
                        "glosses": [
                            "Öl, das aus den Blüten des Lavendels gewonnen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cac456a-8bd5-4cf0-ade3-e148ff5cf7b3",
                                "sense_id": "34b99dc8-cf59-3258-b672-0b947fa87b2e",
                                "text": "„Lavendelöl hat eine kühlende Wirkung und ist deshalb bei leichten Verbrennungen ebenso geeignet wie zur Nachbehandlung bei einem Sonnenbrand.“"
                            },
                            {
                                "example_id": "479a4e37-89f2-4daa-93f2-09bbc100b6d4",
                                "sense_id": "34b99dc8-cf59-3258-b672-0b947fa87b2e",
                                "text": "„Lavendel ist eine lila Blume, die zur Herstellung von Lavendelöl und Naturkosmetik angebaut wird.“"
                            },
                            {
                                "example_id": "e427aee9-df03-4f8a-a56e-eb6fa3094099",
                                "sense_id": "34b99dc8-cf59-3258-b672-0b947fa87b2e",
                                "text": "„Reines Lavendelöl, das für den menschlichen Verzehr geeignet ist, hat seinen Preis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
