                ],
                "senses": [
                    {
                        "sense_id": "d6155e22-8b3e-3958-81ac-526cb02b9155",
                        "entry_id": "3554a653-150f-3fa9-bb82-ea2b5202a797",
                        "glosses": [
                            "мелкая, как правило, медная монета"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3442a958-5378-4da6-8aaa-9901ba74fc50",
                                "sense_id": "d6155e22-8b3e-3958-81ac-526cb02b9155",
                                "text": "Он бросил тогда в сияющую синюю воду тёплый жёлтый медяк, и странно было думать: вот, сейчас я держу его в кулаке, пока еще держу, а в следующий миг он полетит в воду, и никто не возьмет его уже никогда… но вот он решился, и медяк с весёлым всплеском, не жалея о своей участи, стал медленно опускаться и отсвечивать зелёным."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f4e2074b-1070-41d5-8ec1-81b5a0b2ee0d",
                        "source_entry_id": "3554a653-150f-3fa9-bb82-ea2b5202a797",
                        "source_sense_id": "d6155e22-8b3e-3958-81ac-526cb02b9155",
                        "target_lang_word": "copper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "copper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2cddf249-2eda-3b42-8a72-dd0b67ba0596",
                                        "entry_id": "7e66b5e5-40bf-38db-9c42-c1d3ed0ee6d8",
                                        "glosses": [
                                            "A reddish-brown, malleable, ductile metallic element with high electrical and thermal conductivity, symbol Cu, and atomic number 29."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ead8c89d-48bd-4723-9b23-d1cd47c6564c",
                                                "sense_id": "2cddf249-2eda-3b42-8a72-dd0b67ba0596",
                                                "text": "Trump’s July 8 announcement of a 50% tariff on copper imports beginning August 1 sent prices surging 13% in one day, up to a record high of $5.69 per pound."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e000818b-d8a7-3b50-a62e-fef03fcda3d5",
                                        "entry_id": "7e66b5e5-40bf-38db-9c42-c1d3ed0ee6d8",
                                        "glosses": [
                                            "The reddish-brown colour / color of copper."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "42e05720-32f4-3220-aa7b-c481aec7bd40",
                                        "entry_id": "7e66b5e5-40bf-38db-9c42-c1d3ed0ee6d8",
                                        "glosses": [
                                            "Any of various specialized items that are made of copper, where the use of copper is either traditional or vital to the function of the item."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c30014f1-ddb2-435e-838e-13a1373122dd",
                                                "sense_id": "42e05720-32f4-3220-aa7b-c481aec7bd40",
                                                "text": "Coppers are generally good for a year, if the battery is carefully attended […]"
                                            },
                                            {
                                                "example_id": "22ade99d-a92c-4d1d-ab3f-6008a2e2de19",
                                                "sense_id": "42e05720-32f4-3220-aa7b-c481aec7bd40",
                                                "text": "Some coppers come already tinned. I didn't buy mine, so they surely were not tinned."
                                            },
                                            {
                                                "example_id": "af82ab8e-d54a-45ac-a116-20d0854627b9",
                                                "sense_id": "42e05720-32f4-3220-aa7b-c481aec7bd40",
                                                "text": "Coppers are not consumed, and their life depends largely on the manner in which they are used."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a205e76-d6d8-399e-b5d5-819ce7ee3ec3",
                                        "entry_id": "7e66b5e5-40bf-38db-9c42-c1d3ed0ee6d8",
                                        "glosses": [
                                            "Any of various specialized items that are made of copper, where the use of copper is either traditional or vital to the function of the item.",
                                            "A copper coin, typically of a small denomination, such as a penny."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad303da7-675f-43d8-a8c7-1e7bde49880f",
                                                "sense_id": "2a205e76-d6d8-399e-b5d5-819ce7ee3ec3",
                                                "text": "I had in my pocket a handful of copper money, three or four silver dollars, and five pistoles in gold. As he proceeded I began to soften, and concluded to give the coppers."
                                            },
                                            {
                                                "example_id": "2fcb908d-5292-4926-a878-332b9ab25ae6",
                                                "sense_id": "2a205e76-d6d8-399e-b5d5-819ce7ee3ec3",
                                                "text": "\"I don't want to spoil any comparison you are going to make,\" said Jim, \"but I was at Winchester and New College.\" ¶ \"That will do,\" said Mackenzie. \"I was dragged up at the workhouse school till I was twelve. Then I ran away and sold papers in the streets, and anything else that I could pick up a few coppers by—except steal.[…].\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16814dda-66d5-3661-82c3-9d925305e09f",
                                        "entry_id": "7e66b5e5-40bf-38db-9c42-c1d3ed0ee6d8",
                                        "glosses": [
                                            "Any of various specialized items that are made of copper, where the use of copper is either traditional or vital to the function of the item.",
                                            "A large pot, often used for heating water or washing clothes over a fire. In Australasia at least, it could also be a fixed installation made of copper, with a fire underneath and its own chimney. Generally made redundant by the advent of the washing machine."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "UK",
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5b66996-04ff-48bb-be02-8fbf41a27c88",
                                                "sense_id": "16814dda-66d5-3661-82c3-9d925305e09f",
                                                "text": "Mum would heat the water in a copper in the kitchen and transfer it to the tin bath."
                                            },
                                            {
                                                "example_id": "85775f66-df31-47f0-91e0-5387cebbc524",
                                                "sense_id": "16814dda-66d5-3661-82c3-9d925305e09f",
                                                "text": "I explain that socks can’t be boiled up in the copper with the sheets and towels or they shrink."
                                            },
                                            {
                                                "example_id": "29abcaea-4371-4594-971d-d5b25c8a48ed",
                                                "sense_id": "16814dda-66d5-3661-82c3-9d925305e09f",
                                                "text": "When the water in the copper boils, the arsenic and tartar, well pounded, is put into it, and kept boiling till the liquor is reduced to about half."
                                            },
                                            {
                                                "example_id": "7a6ac196-dbe8-4b25-879a-cf41fb4eb920",
                                                "sense_id": "16814dda-66d5-3661-82c3-9d925305e09f",
                                                "text": "'You had better mind you don't get up too early, and you mustn't put any fire under the copper before two o'clock.'"
                                            },
                                            {
                                                "example_id": "851563ad-3fe1-46bd-ab71-15bf00db631a",
                                                "sense_id": "16814dda-66d5-3661-82c3-9d925305e09f",
                                                "text": "He rose to his knees, for he had been sitting in the darkness near the copper."
                                            },
                                            {
                                                "example_id": "cb36c60a-06e8-4ffe-8f8e-383165e0f5d9",
                                                "sense_id": "16814dda-66d5-3661-82c3-9d925305e09f",
                                                "text": "'Vot game now she play?' he asked himself, as he distinguished his wife near one of the pig-scalding coppers."
                                            },
                                            {
                                                "example_id": "affca340-8f7a-4633-b622-b1566f20f21d",
                                                "sense_id": "16814dda-66d5-3661-82c3-9d925305e09f",
                                                "text": "The wet laundry's stove had a long vent in the ceiling which helped to release the steam from the coppers in which the clothes and bed linen were boiled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d07c7a56-1a58-3f4d-9b7b-df05da3fda7b",
                                        "entry_id": "7e66b5e5-40bf-38db-9c42-c1d3ed0ee6d8",
                                        "glosses": [
                                            "Any of various lycaenid butterflies with copper-coloured upperwings, especially those of the genera Lycaena and Paralucia."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "copper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "629ced26-c735-3407-8109-118b0217bc68",
                                        "entry_id": "8af00822-cdb1-38a4-8c6c-68f08946e0d4",
                                        "glosses": [
                                            "Made of copper."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd6d01e2-faf4-31f1-8b0f-7717a601ad29",
                                        "entry_id": "8af00822-cdb1-38a4-8c6c-68f08946e0d4",
                                        "glosses": [
                                            "Having the reddish-brown colour/color of copper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "391abcba-efc6-4f05-bc37-705eea67beec",
                                                "sense_id": "fd6d01e2-faf4-31f1-8b0f-7717a601ad29",
                                                "text": "All in a hot and copper sky, / The bloody Sun, at noon, / Right up above the mast did stand, / No bigger than the Moon."
                                            },
                                            {
                                                "example_id": "cb6e21e7-df27-4990-8a14-ad4dcbb438c4",
                                                "sense_id": "fd6d01e2-faf4-31f1-8b0f-7717a601ad29",
                                                "text": "She seemed so alive, with her shining eyes and her copper hair and her jokes and funny stories, but there was always a mystery at the center of her life, the sound of wild sobbing my mother said she heard coming through the floor."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "copper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ad21a6b-3990-31d6-93cb-9ed90c1c81be",
                                        "entry_id": "0509cfc7-8e09-3d25-b72e-19ded06650f6",
                                        "glosses": [
                                            "To sheathe or coat with copper."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "copper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd1459d2-d3d7-3eb2-a2b0-89ac69a98f55",
                                        "entry_id": "87f7a4b0-faa5-30e2-b8ba-fed4f6443514",
                                        "glosses": [
                                            "A police officer."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d63bf80e-c6e1-4ddf-a3c1-0fc09864bbff",
                                                "sense_id": "dd1459d2-d3d7-3eb2-a2b0-89ac69a98f55",
                                                "text": "One evening as I was lying down in Leicester Square / I was picked up by the coppers and kicked in the balls"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "871b3bfe-1ea9-4967-931a-9fd1e9574d52",
                        "source_entry_id": "3554a653-150f-3fa9-bb82-ea2b5202a797",
                        "source_sense_id": "d6155e22-8b3e-3958-81ac-526cb02b9155",
                        "target_lang_word": "Kupfermünze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kupfermünze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d24dbd42-be1e-34ad-aeae-41f414ee95a1",
                                        "entry_id": "8812a09e-c41c-3a04-992d-b217bdcecdc5",
                                        "glosses": [
                                            "Münze, die aus Kupfer oder einer Legierung mit Kupferanteil besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30084bf1-a262-469e-8c47-4cd0ba5074b7",
                                                "sense_id": "d24dbd42-be1e-34ad-aeae-41f414ee95a1",
                                                "text": "„Val schob vier Kupfermünzen auf ihrer Handfläche hin und her.“"
                                            },
                                            {
                                                "example_id": "ea5ee3b3-422e-40e9-931b-4ef46a02bc73",
                                                "sense_id": "d24dbd42-be1e-34ad-aeae-41f414ee95a1",
                                                "text": "Ich lasse die Kinder das Pferd halten und stecke ihnen dafür ein paar Kupfermünzen zu.“"
                                            },
                                            {
                                                "example_id": "dac25376-9d3c-4a3d-8f66-48eb14cbdbfb",
                                                "sense_id": "d24dbd42-be1e-34ad-aeae-41f414ee95a1",
                                                "text": "„Ein paar Kupfermünzen rasseln in das Boot.“"
                                            },
                                            {
                                                "example_id": "d4134107-bd06-43dc-9e9f-1c39b06ebf07",
                                                "sense_id": "d24dbd42-be1e-34ad-aeae-41f414ee95a1",
                                                "text": "„Jing Bo-djau schenkte ein Bündel bunter Fäden, an denen etwa zehn langes Leben verheißende Kupfermünzen befestigt waren.“"
                                            },
                                            {
                                                "example_id": "9911ece4-0861-4826-b5b1-9b17f860c2dd",
                                                "sense_id": "d24dbd42-be1e-34ad-aeae-41f414ee95a1",
                                                "text": "„Experimente wie die, die der Sultan Tughluk mit den Kupfermünzen gemacht hatte, leisteten sich die Großmoguln nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae921f79-82b4-4c73-8dee-7f78ffb43246",
                        "source_entry_id": "3554a653-150f-3fa9-bb82-ea2b5202a797",
                        "source_sense_id": "d6155e22-8b3e-3958-81ac-526cb02b9155",
                        "target_lang_word": "Kleingeld",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kleingeld",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a1b1393c-fa59-3e65-b7d1-c759fa9cc5fe",
                                        "entry_id": "ba02658d-d022-324e-a153-43853d20d67a",
                                        "glosses": [
                                            "Geldstück beziehungsweise Münzgeld von geringem Wert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0fa5c01-314b-471c-aab2-534ec0594d6e",
                                                "sense_id": "a1b1393c-fa59-3e65-b7d1-c759fa9cc5fe",
                                                "text": "„Es muss einen Extrembergsteiger schon frustrieren, wenn die Regionen, in die er vorgedrungen ist, heutzutage sogar von kletternden Hausfrauen erreicht werden - wenn sie denn genügend Kleingeld haben.“"
                                            },
                                            {
                                                "example_id": "1533f705-46c7-4156-9b65-e73045d75f5b",
                                                "sense_id": "a1b1393c-fa59-3e65-b7d1-c759fa9cc5fe",
                                                "text": "Kleingeld, das ich übrig habe, tue ich in mein Sparschwein."
                                            },
                                            {
                                                "example_id": "36ce1d68-8a13-4722-8078-a52893a907d5",
                                                "sense_id": "a1b1393c-fa59-3e65-b7d1-c759fa9cc5fe",
                                                "text": "„Das moralische Skandalon ihres amoralischen Lebensstils ist längst konsensfähig geworden, vorausgesetzt, man verfügt über das nötige Kleingeld.“"
                                            },
                                            {
                                                "example_id": "d2c90335-1bf7-45b0-8f26-15e8b8b7cc85",
                                                "sense_id": "a1b1393c-fa59-3e65-b7d1-c759fa9cc5fe",
                                                "text": "„Ich dankte für die Einladung und sammelte das nötige Kleingeld aus meinen Taschen, um die Rechnung zu begleichen.“"
                                            },
                                            {
                                                "example_id": "ca986bf8-9085-48ef-b78e-288b5edc1b1c",
                                                "sense_id": "a1b1393c-fa59-3e65-b7d1-c759fa9cc5fe",
                                                "text": "„Er wühlt in seinen roten Haaren, er klappert mit dem Kleingeld in der Tasche.“"
                                            },
                                            {
                                                "example_id": "5b0a811c-d7a2-461e-aea5-22af0239b980",
                                                "sense_id": "a1b1393c-fa59-3e65-b7d1-c759fa9cc5fe",
                                                "text": "„Dann flüchtete Paweł durch ein Loch im Zaun, mit dem letzten bisschen Kleingeld in der Hosentasche.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
