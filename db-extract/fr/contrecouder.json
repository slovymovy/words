                "senses": [
                    {
                        "sense_id": "20a1f8c5-72c3-3c2b-8a19-014cd666b3e9",
                        "entry_id": "3aa9d26d-8797-34fa-858c-816e3bbf2572",
                        "glosses": [
                            "Couder dans le sens opposé (ce qu’on a déjà coudé dans un sens)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2db81b09-d8f6-4801-966f-0a888162f6a2",
                                "sense_id": "20a1f8c5-72c3-3c2b-8a19-014cd666b3e9",
                                "text": "Les pièces à cintrer ou à contrecouder, les cornières à ouvrir ou à fermer doivent avoir, après le travail, exactement la courbure et la forme prescrite sans présenter aucune crique, fente ni gerçure."
                            },
                            {
                                "example_id": "322ebe43-09be-4472-88a1-75cecd2fb2b5",
                                "sense_id": "20a1f8c5-72c3-3c2b-8a19-014cd666b3e9",
                                "text": "On peut légèrement contrecouder l'extrémité du crochet du trombone pour l'émousser afin de le rendre moins traumatisant."
                            }
                        ]
                    }
