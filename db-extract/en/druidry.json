                        "sense_id": "824338ad-a809-3f81-bfa6-8679c27d9080",
                        "entry_id": "a6835707-230b-3ec1-9332-67874984e6b8",
                        "glosses": [
                            "A religion and philosophy which promotes harmony with nature, and draws on the practices of the druids."
                        ],
