                "senses": [
                    {
                        "sense_id": "23449d96-8fc8-3b74-ac0a-41de876050cd",
                        "entry_id": "1faa566d-2e9c-3f8a-9995-f4fdb4c6af13",
                        "glosses": [
                            "Person, die stehend uriniert"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "52e85e7e-9a71-4334-8dd9-c6d72ebc688a",
                                "sense_id": "23449d96-8fc8-3b74-ac0a-41de876050cd",
                                "text": "Diese Stehpinkler machen den Reinigungskräften des Bürogebäudes die Arbeit zur Hölle!"
                            },
                            {
                                "example_id": "912ee690-81e2-4f2e-9ab5-762a9bffedbc",
                                "sense_id": "23449d96-8fc8-3b74-ac0a-41de876050cd",
                                "text": "„Vermieter müssen an der mitvermieteten Keramik mit Stehpinklern rechnen – diese aber nicht mit Böden, die dafür ungeeignet sind. So begründete das Gericht am Donnerstag sein Urteil, wies die Berufung der Vermieterin zurück und ließ keine Revision zu.“"
                            },
                            {
                                "example_id": "dda382c0-0302-4e1a-be24-41f3e6fd3ba4",
                                "sense_id": "23449d96-8fc8-3b74-ac0a-41de876050cd",
                                "text": "„In den Toiletten des Holzwickeder Clara-Schumann-Gymnasiums tobt der Kampf gegen die Stehpinkler.“"
                            },
                            {
                                "example_id": "4b2265b4-a6cf-4219-8ef4-a8be5c9811b2",
                                "sense_id": "23449d96-8fc8-3b74-ac0a-41de876050cd",
                                "text": "„Das bestätigte auch ein Sachverständiger. Es seien zwar nicht sämtliche Geräusche aus dem Sanitärbereich der anderen Wohnung laut hörbar, aber das Urinstrahlgeräusch eines \"Stehpinklers\" sei akustisch deutlich auffällig zu vernehmen gewesen.“"
                            },
                            {
                                "example_id": "1917e38e-3ce7-43a2-ae7e-af737b2affaf",
                                "sense_id": "23449d96-8fc8-3b74-ac0a-41de876050cd",
                                "text": "„A propos: Sind sie eigentlich Sitzpinkler oder Stehpinkler?“"
                            },
                            {
                                "example_id": "552e8857-bd1a-4f0c-a73b-08410030892a",
                                "sense_id": "23449d96-8fc8-3b74-ac0a-41de876050cd",
                                "text": "„Wieder on the road folgt rechter Hand die „Bunte Ecke“ mit sichtgeschütztem Pissoir für Stehpinkler. Es ist empfehlenswert, dies bei drängendem Bedürfnis zu nutzen, um den Platz für den sonnabendlichen Kleinflohmarkt geruchsneutral zu halten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
