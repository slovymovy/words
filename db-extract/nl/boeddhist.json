                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "474ef4c5-f496-431e-9b30-57d4ff45b5ba",
                                "sense_id": "637f1eba-28b0-31b5-b0fe-fe9a9c5bbb69",
                                "text": "De dalai lama is het hoofd van de boeddhisten in Tibet."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57468830-6b56-45cb-ac4b-238005ffebca",
                        "source_entry_id": "19bcce9a-4f51-3b00-991e-0a1b82db3a16",
                        "source_sense_id": "637f1eba-28b0-31b5-b0fe-fe9a9c5bbb69",
                        "source_sense_description": "volger van de leer van Boeddha",
                        "target_lang_word": "Buddhist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Buddhist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e7605a0b-2e34-3803-86a2-c3e7bae6f959",
                                        "entry_id": "d5961ff0-44be-3d99-9931-61ca8c28165a",
                                        "glosses": [
                                            "Anhänger des Buddhismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ef6fed4-7646-4842-ad7d-b5a7715728a8",
                                                "sense_id": "e7605a0b-2e34-3803-86a2-c3e7bae6f959",
                                                "text": "Er ist übergewechselt und nun Buddhist."
                                            },
                                            {
                                                "example_id": "2f6d3c7c-d6df-4ec8-bcd6-2d491b422c16",
                                                "sense_id": "e7605a0b-2e34-3803-86a2-c3e7bae6f959",
                                                "text": "„Der Sohn des Majors war ein ganz normaler, ein traditioneller Buddhist auf dem Weg zur Erleuchtung.“"
                                            },
                                            {
                                                "example_id": "6eb813d7-da42-4aaf-8cef-19f59bd42a89",
                                                "sense_id": "e7605a0b-2e34-3803-86a2-c3e7bae6f959",
                                                "text": "„In jener Zelle in Zangla verloren sich alle noch verbliebenen Spuren des Europäers Csoma, und der Buddhist Csoma wurde geboren.“"
                                            },
                                            {
                                                "example_id": "0971a8b3-0018-417e-8637-729cead8a96f",
                                                "sense_id": "e7605a0b-2e34-3803-86a2-c3e7bae6f959",
                                                "text": "„Vielleicht sollten wir uns ja mehr an den Buddhisten orientieren.“"
                                            },
                                            {
                                                "example_id": "2e7cf23e-665c-4d68-b173-78dc59dc0e69",
                                                "sense_id": "e7605a0b-2e34-3803-86a2-c3e7bae6f959",
                                                "text": "„Haben Sie je ein »Wort zum Sonntag« von einem esoterischen Guru, einem muslimischen Imam oder den Gemeinschaften der Zeugen Jehovas, der Mennoniten, der Juden, der orthodoxen Christen, der Buddhisten, der Hindus oder der Sikhs gesehen?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ac7a0eb-f0bb-4356-8891-8f83e2e8cfc7",
