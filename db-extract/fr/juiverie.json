        "fr-extract.jsonl": [
            {
                "entry_id": "7b80a7c1-8455-3ec5-b00f-efa66ed37a19",
                "word": "juiverie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "637c431f-044e-492a-aa36-4f8037b0fff5",
                        "entry_id": "7b80a7c1-8455-3ec5-b00f-efa66ed37a19",
                        "tags": [
                            "plural"
                        ],
                        "form": "juiveries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0671539e-10c0-3ff2-9fb0-032b2920a01e",
                        "entry_id": "7b80a7c1-8455-3ec5-b00f-efa66ed37a19",
                        "glosses": [
                            "Quartier d’une ville habité par les Juifs."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "81aaf74a-e0f5-4d65-8ef9-5cc16eeb1088",
                                "sense_id": "0671539e-10c0-3ff2-9fb0-032b2920a01e",
                                "text": "Maxence est bien décidément dans une juiverie."
                            },
                            {
                                "example_id": "b2122fd6-fa2d-4a92-bd86-41bfd1ef9241",
                                "sense_id": "0671539e-10c0-3ff2-9fb0-032b2920a01e",
                                "text": "C’est ainsi que, le 21 adar 4996 (1236), un pêcheur chrétien étant mort des coups que lui avait portés un juif au cours d’une rixe, la foule envahit la juiverie vicomtale, avec l’intention de la mettre à sac."
                            }
                        ]
                    },
                    {
                        "sense_id": "3e8c2dd2-87a7-3f6b-abea-518ad3253e09",
                        "entry_id": "7b80a7c1-8455-3ec5-b00f-efa66ed37a19",
                        "glosses": [
                            "Marché usuraire."
                        ],
                        "tags": [
                            "dated",
                            "pejorative"
                        ],
                        "note": "Le terme a une forte connotation antisémite",
                        "examples": []
                    },
                    {
                        "sense_id": "8e136cb5-dea6-399a-a1ae-8e91ec5c3cb3",
                        "entry_id": "7b80a7c1-8455-3ec5-b00f-efa66ed37a19",
                        "glosses": [
                            "La société juive."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "16b4f625-27fa-4451-97d0-dbf0fe5a3adb",
                                "sense_id": "8e136cb5-dea6-399a-a1ae-8e91ec5c3cb3",
                                "text": "Elle reconnaît à une empreinte d'ongle sur un parchemin la différence qui sépare la juiverie de la Judengasse de la juiverie du Ghetto."
                            },
                            {
                                "example_id": "a615d5b1-2855-4648-b1af-62d7b9df4182",
                                "sense_id": "8e136cb5-dea6-399a-a1ae-8e91ec5c3cb3",
                                "text": "Il y avait là, en un groupe tumultueux, toute une juiverie malpropre, de grasses faces luisantes, des profils desséchés d’oiseaux voraces, une extraordinaire réunion de nez typiques, rapprochés les uns des autres, ainsi que sur une proie, s’acharnant au milieu de cris gutturaux, et comme près de se dévorer entre eux."
                            },
                            {
                                "example_id": "492f1587-34ca-4dd1-9f04-024a813891ce",
                                "sense_id": "8e136cb5-dea6-399a-a1ae-8e91ec5c3cb3",
                                "text": "Je conclus mon intervention en appelant à la formation de véritables « brigades internationales de la juiverie, ou de la juiverie internationale, au choix ! », péroraison qui fut saluée d’applaudissements nourris."
                            }
                        ]
                    },
                    {
                        "sense_id": "25a9bd14-e418-3b6d-9571-55c2b2d2f63b",
                        "entry_id": "7b80a7c1-8455-3ec5-b00f-efa66ed37a19",
                        "glosses": [
                            "Terme de mépris pour un groupe de gens, sans qu’ils soient particulièrement juifs."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "9db0ad8e-69c5-447a-8b8a-0930c126bbe4",
                                "sense_id": "25a9bd14-e418-3b6d-9571-55c2b2d2f63b",
                                "text": "[…] il finit par comprendre que c’étaient là de ces rôdeurs qui suivaient les armées allemandes, des détrousseurs de cadavres, toute une basse juiverie de proie, venue à la suite de l’invasion."
                            }
                        ]
                    },
                    {
                        "sense_id": "41529953-902b-3644-9cfd-5a93f560be5a",
                        "entry_id": "7b80a7c1-8455-3ec5-b00f-efa66ed37a19",
                        "glosses": [
                            "Fait, manière d'être juif."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "435d0e06-2c18-4acf-9e51-72388331495b",
                                "sense_id": "41529953-902b-3644-9cfd-5a93f560be5a",
                                "text": "Il espérait se débarbouiller un peu (...) de sa juiverie honteuse dans les eaux de ce baptême."
                            }
                        ]
                    },
                    {
                        "sense_id": "c6d501c7-e453-3a19-9d45-f95e499286d2",
                        "entry_id": "7b80a7c1-8455-3ec5-b00f-efa66ed37a19",
                        "glosses": [
                            "Histoire juive."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "d78edcd1-b7e0-42fc-9aa3-648e24ee80bf",
                                "sense_id": "c6d501c7-e453-3a19-9d45-f95e499286d2",
                                "text": "Une juiverie contée ce soir par Hervieu."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8886a40f-8638-46af-9637-9a63b71db038",
                        "source_entry_id": "7b80a7c1-8455-3ec5-b00f-efa66ed37a19",
                        "target_lang_word": "Judenviertel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Judenviertel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9daccafe-d7e8-3e1d-b4d0-ab71baa06227",
                                        "entry_id": "e92274b4-2365-31d6-9102-0b8375c1af7f",
                                        "glosses": [
                                            "Wohnbezirk, in dem Juden leben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cff1dbcf-e297-496e-ad35-6d6c09dc31d8",
                                                "sense_id": "9daccafe-d7e8-3e1d-b4d0-ab71baa06227",
                                                "text": "„Canettis Besuch des Judenviertels von Marrakesch wird als Heimkehr ins spaniolische Judentum erzählt, eine Heimkehr sowohl zur eigenen spaniolischen Familie als auch zu den Ursprüngen der Spaniolen aus der Zeit vor der Vertreibung von 1492.“"
                                            },
                                            {
                                                "example_id": "40c027e3-b403-4ff7-b759-039c5b4907d2",
                                                "sense_id": "9daccafe-d7e8-3e1d-b4d0-ab71baa06227",
                                                "text": "„Man zerstörte die Häuser des Judenviertels, für dessen Grundstücke sich die reichen Regensburger interessierten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95baa8d8-2019-460c-a3c6-04d9dee5eb8d",
                        "source_entry_id": "7b80a7c1-8455-3ec5-b00f-efa66ed37a19",
                        "target_lang_word": "Judengasse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8d48b3a5-b3e4-4e24-90f4-f2fe4505f327",
                        "source_entry_id": "7b80a7c1-8455-3ec5-b00f-efa66ed37a19",
                        "target_lang_word": "Getto",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Getto",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d4f9f1d5-cb18-37a2-90ee-77d4d92d3c03",
                                        "entry_id": "ac126eb3-6d8b-3b58-928b-3c06159a00ad",
                                        "glosses": [
                                            "von der jüdischen Bevölkerung (anfänglich freiwillig, später zwangsweise) bewohntes, von den übrigen Stadtvierteln (durch Mauern oder Ähnliches) abgetrenntes Viertel"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cee10c0-fd09-4cd7-9f09-74535586048d",
                                                "sense_id": "d4f9f1d5-cb18-37a2-90ee-77d4d92d3c03",
                                                "text": "„Ich sage die Auffindung, denn die Juden, die dasselbe aus dem großen Brande des zweiten Tempels gerettet, und es im Exile gleichsam wie ein portatives Vaterland mit sich herumschleppten, das ganze Mittelalter hindurch, sie hielten diesen Schatz sorgsam verborgen in ihrem Getto, wo die deutschen Gelehrten, Vorgänger und Beginner der Reformation, hinschlichen um Hebräisch zu lernen, um den Schlüssel zu der Truhe zu gewinnen, welche den Schatz barg.“"
                                            },
                                            {
                                                "example_id": "0e65ec90-f34a-470f-ad83-94e21f6f78a6",
                                                "sense_id": "d4f9f1d5-cb18-37a2-90ee-77d4d92d3c03",
                                                "text": "„Überall die Schranken des Gettos, die noch lange nicht beseitigt sind in unseren Tagen, und die um so drückender und erniedrigender wirken, weil sie nicht mehr als eine weithin sichtbare Mauer, sondern mehr wie eine gläserne Wand Mensch von Menschen, Rasse von Rasse scheiden.“"
                                            },
                                            {
                                                "example_id": "0fd27224-d692-4798-84fc-d952e51a42bb",
                                                "sense_id": "d4f9f1d5-cb18-37a2-90ee-77d4d92d3c03",
                                                "text": "„Die These von der Autorschaft Goethes kann sich sowohl auf sein durch die Jugendschriften bezeugtes intensives Interesse am Studium des Alten Testaments und des Hebräischen als auch auf die gut belegten Kontakte mit dem Frankfurter Judentum und dem im Getto gesprochenen Jiddisch stützen, das sich zum Teil mit dem Frankfurter Lokaldialekt vermischt hatte.“"
                                            },
                                            {
                                                "example_id": "9b2d2810-0cf1-4411-8bd9-938202ea6347",
                                                "sense_id": "d4f9f1d5-cb18-37a2-90ee-77d4d92d3c03",
                                                "text": "„Hier stehen Ludwig Börne und Heinrich Heine, zwei Juden, die Protagonisten des ‚Jungen Deutschland‘, wir schreiben das Jahr 1827, Börne macht den Stadtführer und zeigt dem Besucher nach dem Palais Thurn und Taxis - dem Sitz des Bundestags - den Römer und schließlich die Judengasse, das Frankfurter Getto, das erst sechzehn Jahre zuvor mehr schlecht als recht aufgelöst worden war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "feff7036-245c-3c52-a0b3-869480296cef",
                                        "entry_id": "ac126eb3-6d8b-3b58-928b-3c06159a00ad",
                                        "glosses": [
                                            "(militärisch streng bewachtes) isoliertes Stadtviertel, in dem die jüdische Bevölkerung gezwungenermaßen abgesondert von der übrigen Stadtbevölkerung (in unmenschlichen Lebensverhältnissen) leben musste"
                                        ],
                                        "tags": [
                                            "früher",
                                            "besonders in der Zeit des Nationalsozialismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "938dc980-75b4-473b-9073-2953ec7c73ce",
                                                "sense_id": "feff7036-245c-3c52-a0b3-869480296cef",
                                                "text": "„Wenig später ergibt sich daraus eine längere Tätigkeit: Der das Getto verwaltende ‚Judenrat‘ ernennt ihn zum Chef des ‚Übersetzungs- und Korrespondenzbüros‘. Von November 1940 bis Februar 1943 lebt Reich-Ranicki im Getto.“"
                                            },
                                            {
                                                "example_id": "834d02d6-cd0d-48db-acdc-a8b9c862707d",
                                                "sense_id": "feff7036-245c-3c52-a0b3-869480296cef",
                                                "text": "„Im Oktober wurde das alte Judenviertel zum Getto deklariert und ca. 45.000 Juden auf engstem Raum zusammengepfercht.“"
                                            },
                                            {
                                                "example_id": "808553b7-afe8-4378-8dba-b539a5f57f67",
                                                "sense_id": "feff7036-245c-3c52-a0b3-869480296cef",
                                                "text": "„Am 20. Dezember musste die jüdische Bevölkerung ohne Vorankündigung der deutschen Behörden sofort in einen kleinen Teil der Stadt umziehen, der seitdem bei der Bevölkerung Getto hieß.[…]Dieses Getto hatte weder Zäune noch Mauern; nur deutsche oder polnische Polizisten standen an der Gettogrenze.[…] Aus dem Baltikum und der Ukraine kamen auch Hilfswillige, die der SS bei der Deportation aus den Gettos im besetzten Polen halfen.“"
                                            },
                                            {
                                                "example_id": "cbb254d6-691f-4cb8-ac8f-706256f4e645",
                                                "sense_id": "feff7036-245c-3c52-a0b3-869480296cef",
                                                "text": "„Es folgten erste Gerüchte über die Errichtung eines Gettos.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ae44680d-c490-3ff3-9032-65e86d36b023",
                                        "entry_id": "ac126eb3-6d8b-3b58-928b-3c06159a00ad",
                                        "glosses": [
                                            "von diskriminierten Minderheiten, Ausländern oder auch privilegierten Bevölkerungsgruppen bewohnter Bezirk beziehungsweise Viertel einer Stadt"
                                        ],
                                        "tags": [
                                            "zumeist abwertend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cdb1b07-8905-4087-ba7f-362a6e63c68f",
                                                "sense_id": "ae44680d-c490-3ff3-9032-65e86d36b023",
                                                "text": "„Ihre einzige Reaktion auf eine Negerkrise ist, die Polizeimacht im Getto zu verstärken, und je mehr die Polizeimacht verstärkt wird, um so mehr wird das Getto gedemütigt und um so feindseliger wird es.“"
                                            },
                                            {
                                                "example_id": "531a449e-8f4b-49ec-8c38-23e7922e82b8",
                                                "sense_id": "ae44680d-c490-3ff3-9032-65e86d36b023",
                                                "text": "„In diesem Getto wohnen nur Schwarze, aber Weiße unterhalten zahlreiche der ärmlichen Drugstores, Pfandhäuser, Schnaps- und Möbelläden.“"
                                            },
                                            {
                                                "example_id": "c8befe3b-c580-4a2b-8550-12900e7177ac",
                                                "sense_id": "ae44680d-c490-3ff3-9032-65e86d36b023",
                                                "text": "„Der Film zeigt die winterliche Slum-Landschaft der Süd-Bronx und gibt einen Einblick in die desolaten Lebensumstände der Menschen, die ihr Dasein im Getto fristen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "ee1a66a9-a18d-3227-9ea5-53932aa84e6c",
                                        "entry_id": "ac126eb3-6d8b-3b58-928b-3c06159a00ad",
                                        "glosses": [
                                            "bestimmte (soziale, wirtschaftliche oder dergleichen) mentale oder psychische Sphäre, der sich jemand nicht entziehen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae0f7460-f79f-4521-b8b7-fb770de75243",
                                                "sense_id": "ee1a66a9-a18d-3227-9ea5-53932aa84e6c",
                                                "text": "„Ich bin gegen eine solche Selbstisolation der Kirche und gegen eine Einschränkung der Gesprächsbereitschaft. Dieses Getto hat der Kirche noch nie gutgetan.“"
                                            },
                                            {
                                                "example_id": "3a781bb7-ac13-4f28-9ccd-9ee0ccbcb3b2",
                                                "sense_id": "ee1a66a9-a18d-3227-9ea5-53932aa84e6c",
                                                "text": "„Mit all jenen Ausländerjugendlichen, die sich von der Gesellschaft abgemeldet haben, sich mit Gewalt durchs Leben schlagen und bei denen sämtliche Anstrengungen, sie aus ihrem inneren Getto herauszuholen, nichts genützt haben?“"
                                            },
                                            {
                                                "example_id": "dc499351-f8b7-4689-88b1-4b2a1c1e1091",
                                                "sense_id": "ee1a66a9-a18d-3227-9ea5-53932aa84e6c",
                                                "text": "„Immer wieder finden sich Bonhoeffers Warnungen vor der Flucht in ein spirituelles, selbstbeschauliches Getto.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
