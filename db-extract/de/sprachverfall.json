                "senses": [
                    {
                        "sense_id": "54e8917a-1d92-32fc-9124-82da05c809c0",
                        "entry_id": "ff325bd4-bdab-3a5b-ad15-51f1eb818b55",
                        "glosses": [
                            "Verlust wesentlicher Bestandteile einer Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f63a5c9-bac9-49fc-8b6a-07adb290020c",
                                "sense_id": "54e8917a-1d92-32fc-9124-82da05c809c0",
                                "text": "„Der Einfluss des Englischen auf das Deutsche wird mit Sprachverfall gleichgesetzt.“"
                            },
                            {
                                "example_id": "77bd80f5-8497-48b1-97ad-9a02926841ac",
                                "sense_id": "54e8917a-1d92-32fc-9124-82da05c809c0",
                                "text": "„33 Prozent der Befragten gaben an, die Medien seien ursächlich für Sprachverfall, 48 Prozent nannten SMS und E-Mails als Ursache.“"
                            },
                            {
                                "example_id": "16f9effb-573a-4203-88c4-4290d3833827",
                                "sense_id": "54e8917a-1d92-32fc-9124-82da05c809c0",
                                "text": "„Man interessiert sich für vieles: für die Sprache der Medien oder der Politiker oder der Jugend, für Namen und Dialekte, für Wörter und Unwörter, vor allem aber für zwei Themenkomplexe: für den sogenannten Sprachverfall, für Veränderungen in der Gegenwartssprache, die man negativ bewertet, etwa den vermeintlichen Rückgang des Genitivs oder des Konjunktivs oder den angeblichen Verlust sprachlicher Fähigkeiten einzelner Gruppen, besonders der Jugendlichen.“"
                            },
                            {
                                "example_id": "06c8de5f-11dc-4c5d-bf7a-41bf98d95e7d",
                                "sense_id": "54e8917a-1d92-32fc-9124-82da05c809c0",
                                "text": "„Die Frage, ob es sich um progressive Tendenzen in der Sprachentwicklung oder Sprachverfall handelt und inwieweit diese Erscheinungen ihren Platz im Sprachunterricht finden sollten, wurde dann zur Diskussion gestellt.“"
                            },
                            {
                                "example_id": "eec1087f-2297-4645-b4ac-e15494b5f1b5",
                                "sense_id": "54e8917a-1d92-32fc-9124-82da05c809c0",
                                "text": "„Die Sprachwissenschaft sieht sich dem Vorurteil gegenüber, ihre Aussagen zum öffentlich gefühlten Sprachverfall seien nichts als Beschwichtigungen, die dazu dienten, im Sinne von politischer Überkorrektheit abweichendes Deutsch zur guten Sprache schönzureden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
