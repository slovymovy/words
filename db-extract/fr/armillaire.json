                        "cross_references": [
                            {
                                "target_word": "honey fungus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "75da6498-c111-3d11-87a8-a9059a939f47",
                                        "entry_id": "c1463c8c-7319-3424-8c8c-7af62df009f3",
                                        "glosses": [
                                            "A parasitic mushroom of the genus Armillaria that lives on trees and shrubs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00d02605-6a05-4d8b-b76b-4909bdd20e70",
                                                "sense_id": "75da6498-c111-3d11-87a8-a9059a939f47",
                                                "text": "The common edible Mushroom or Honey-fungus (Agaricus melleus) is also a very common, and in many places a very dangerous, parasite in young crops of conifers, which, however, also occurs extensively as a saprophyte on dead stools and roots of old trees, especially of Beeches."
                                            },
                                            {
                                                "example_id": "4216e353-e85b-473c-831b-dfda6bdec7a9",
                                                "sense_id": "75da6498-c111-3d11-87a8-a9059a939f47",
                                                "text": "Zhu ling grows on honey fungi (Armelliaria mellea) rhizomorph for nutrients, leading to a unique cultivation process (Huang 1993, Yao & Huang 1993)."
                                            },
                                            {
                                                "example_id": "e04d6c62-bd78-486e-b070-8d08e1e55ea4",
                                                "sense_id": "75da6498-c111-3d11-87a8-a9059a939f47",
                                                "text": "Honey fungus (Armillaria mellea) is most obvious when, in autumn, clumps of honey-coloured, pale-stemmed toadstools appear at the base of a tree."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
