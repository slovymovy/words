                            }
                        },
                        {
                            "text": "If no one <w>seconds</w> the motion, we cannot vote on it.",
                            "target_lang_translations": {
                                "ru": "Если никто не <w>поддержит</w> предложение, мы не сможем проголосовать за него.",
