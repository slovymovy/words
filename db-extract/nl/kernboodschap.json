                        "examples": [
                            {
                                "example_id": "03637fc6-326e-4642-a13e-b673b10bc603",
                                "sense_id": "5184f825-85e6-3ba0-9867-962b6f360b08",
                                "text": "\"Liefde is de kernboodschap van ieder geloof, ook van de islam. Kwaadaardige mensen zijn er ook onder boeddhisten, christenen, joden en hindoes. De droevige daden van een klein aantal moslims mag geen reden zijn voor het veroordelen van de hele islamitische wereld.\""
                            },
                            {
                                "example_id": "104a1468-eedf-4198-b926-571263b50819",
                                "sense_id": "5184f825-85e6-3ba0-9867-962b6f360b08",
                                "text": "\"Voor de meeste moslims zijn aanslagen tijdens de ramadan misschien het beste bewijs dat organisaties als IS on-islamitisch zijn en dat ze de kernboodschap van de islam verdraaien. Voor IS-strijders en hun aanhang leveren aanslagen tijdens de ramadan juist een grotere beloning op in het hiernamaals.\""
                            }
                        ]
