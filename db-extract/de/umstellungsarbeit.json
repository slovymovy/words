                ],
                "senses": [
                    {
                        "sense_id": "22657620-b86a-3987-907b-1daed596fa94",
                        "entry_id": "fc5a150a-fd12-37e0-bf83-5b8d993eb1a7",
                        "glosses": [
                            "Handlungen/Tätigkeiten, mit dem Zweck, etwas an neue Verhältnisse oder Erfordernisse anzupassen"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "f98f7725-7289-4cea-a2ed-9639864c7e56",
                                "sense_id": "22657620-b86a-3987-907b-1daed596fa94",
                                "text": "„Nach Einschätzung der Unternehmensberatung Gartner-Group ist Deutschland, was die Umstellungsarbeiten der Informationstechnologie (IT) angeht, auf dem Stand von Entwicklungsländern.“"
                            },
                            {
                                "example_id": "33df061b-fbac-41b2-ba36-406540155fdf",
                                "sense_id": "22657620-b86a-3987-907b-1daed596fa94",
                                "text": "„Am Dienstag, 12. Mai, und Mittwoch, 13. Mai, bleibt das Gewerbeamt in Winsen aufgrund von Umstellungsarbeiten an der EDV und Schulungen der Mitarbeiter komplett geschlossen.“"
                            },
                            {
                                "example_id": "6d1c2860-0d0c-4fbe-befc-9a9ea8a0bb0f",
                                "sense_id": "22657620-b86a-3987-907b-1daed596fa94",
                                "text": "„Durch das Streichen zweier Nullen, so die Argumentation der Befürworter, gewinne die Landeswährung nicht allein an internationalem Ansehen; die für die Redenomination notwendigen Umstellungsarbeiten kämen auch einem kleineren Stimulierungspaket gleich.“"
                            },
                            {
                                "example_id": "64cc8da9-b085-4df1-8645-f0707e089668",
                                "sense_id": "22657620-b86a-3987-907b-1daed596fa94",
                                "text": "„Im Frühjahr 2005 sollen mit Zehlendorf und Resten von Wilmersdorf die Umstellungsarbeiten in Berlin beendet sein, sagte der Sprecher von Kabel Deutschland, Marco Gasser.“"
                            },
                            {
                                "example_id": "143af49b-ca16-49f5-8cc8-870ef6e085b4",
                                "sense_id": "22657620-b86a-3987-907b-1daed596fa94",
                                "text": "„Die Umstellungsarbeiten für eine saubere Stichprobe beim Statistischen Bundesamt in Wiesbaden sind zwar fast abgeschlossen; doch die ersten praktischen Resultate werden frühestens in zwei bis drei Jahren auf dem Tisch des Landwirtschaftsministers liegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
