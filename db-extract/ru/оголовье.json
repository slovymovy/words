                    {
                        "translation_id": "6b4ca3d0-9f19-4263-86ed-8b1da7677412",
                        "source_entry_id": "af1d47db-47ba-3412-b06a-3698a96ed5f2",
                        "source_sense_id": "dafe8ff8-7761-3c76-b84b-123c78efe170",
