                "senses": [
                    {
                        "sense_id": "3cd794d3-49c3-3e1f-9f06-464e8cfbe10b",
                        "entry_id": "95d1c2bf-0c1f-38f4-beac-800367d084df",
                        "glosses": [
                            "pogodny krótki liryk idealizujący życie na wsi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e54404c-1acf-4b91-b5a0-c90e858e60dc",
                                "sense_id": "3cd794d3-49c3-3e1f-9f06-464e8cfbe10b",
                                "text": "W literaturze polskiej ekloga uprawiana była w baroku."
                            },
                            {
                                "example_id": "0966e763-4521-41fc-a167-5c7488d2a17d",
                                "sense_id": "3cd794d3-49c3-3e1f-9f06-464e8cfbe10b",
                                "text": "Eklogi pisał Wergiliusz."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "e06d143e-e4c7-3169-a1eb-7a6c39837528",
                        "entry_id": "95d1c2bf-0c1f-38f4-beac-800367d084df",
                        "glosses": [
                            "niewielki zbiór szeregu urywków z różnych autorów"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "382f7dc1-8813-38a2-b7f9-83ba8c4e645c",
