                ],
                "senses": [
                    {
                        "sense_id": "02dd667f-bf5f-3eb0-909e-8671122fb925",
                        "entry_id": "9e4bfb4b-523d-3a2d-a6df-252367ef41cd",
                        "glosses": [
                            "Wort, mit dem die angesprochene Sache oder Person auf verletzende Weise verächtlich gemacht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "baf773b0-57a7-4fa5-b949-5e6be0897077",
                                "sense_id": "02dd667f-bf5f-3eb0-909e-8671122fb925",
                                "text": "Ladendorf (1906) nennt unter anderen „Freigeist“ und „Reaktionär“ als Schmähworte: „Freigeist, ein altes Schmähwort der Ketzer und Religionsverächter…“"
                            },
                            {
                                "example_id": "ab4ed33d-61bc-4a60-b80a-f65c395d5c77",
                                "sense_id": "02dd667f-bf5f-3eb0-909e-8671122fb925",
                                "text": "Moderne Schmähwörter sind Beschimpfungen wie „Käsköpfe“ und „Spaghettifresser“."
                            },
                            {
                                "example_id": "35832c15-4b09-485e-ba88-9515d80377b7",
                                "sense_id": "02dd667f-bf5f-3eb0-909e-8671122fb925",
                                "text": "„Ich las einige Zeilen, es war das Gewohnte, jedes einzelne dieser klischierten Schmähworte war mir seit Jahren bis zum Überdruß bekannt.“"
                            },
                            {
                                "example_id": "1b38726b-3519-4bc4-a8b1-f9b85119d2c0",
                                "sense_id": "02dd667f-bf5f-3eb0-909e-8671122fb925",
                                "text": "„Der Zürcher Reformator Ulrich Zwingli (1484-1531) wandte das Schmähwort auch auf die mit Öl gesalbten Priester an.“"
                            },
                            {
                                "example_id": "427f823c-4188-496b-9f07-0db9f5147751",
                                "sense_id": "02dd667f-bf5f-3eb0-909e-8671122fb925",
                                "text": "„Die Medien aber kolportierten nichts anderes aus meiner Rede als dieses nebensächliche Schmähwort.“"
                            },
                            {
                                "example_id": "72dca218-9b17-44ec-b9d6-60f2064292d7",
                                "sense_id": "02dd667f-bf5f-3eb0-909e-8671122fb925",
                                "text": "„Ganz besonders aber enthält sich der Gesittete aller gemeinen F l ü c h e und S c h m ä h w ö r t e r, die unter der Würde der edleren Sprache sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "944f46b2-cdaa-39fc-87a6-fd06ccaf70ec",
                        "entry_id": "9e4bfb4b-523d-3a2d-a6df-252367ef41cd",
                        "glosses": [
                            "Ausspruch verletzenden Inhalts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7419463-4c7e-4e32-8899-2224f86130a2",
                                "sense_id": "944f46b2-cdaa-39fc-87a6-fd06ccaf70ec",
                                "text": "„Schmähwort, ein schmähendes Wort, und in der Mehrheit, in weiterer Bedeutung, Schmähwort, schmähende Rede, Schmähreden.“"
                            },
                            {
                                "example_id": "f70c4772-aa7b-4f56-98b3-c760d0258a97",
                                "sense_id": "944f46b2-cdaa-39fc-87a6-fd06ccaf70ec",
                                "text": "„Hier entgeht der BWV nur knapp einer Katastrophe. Während sich die müden Wandersleut bei Hirschgulasch und Gambrinus von den Mühen der ersten Tourstunden erholen, muss der StellVoz aus Richtung Nachbartisch die groben Schmähworte: „Dynamo Dresden ist die Schande Sachsens!“ hören, die dort von einem schnauzbärtigen Ureinwohner des Freistaates abgesondert werden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
