                "translations": [
                    {
                        "translation_id": "a4c882c6-5552-4fbb-80ca-18d5ed1114db",
                        "source_entry_id": "16389c10-d7e6-3758-b903-927641ccad0f",
                        "source_sense_id": "7393d8fb-d5a3-373f-862c-d76401fee34d",
                        "source_sense_description": "Иноязычные аналоги",
                        "target_lang_word": "Beatrice",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beatrice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8800e89c-4b05-3793-92ca-7076e3fd3201",
                                        "entry_id": "f9f5643b-68b8-3b35-bc24-e58d366c36fd",
                                        "glosses": [
                                            "A female given name from Latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37c6b2c1-fb6f-47ca-97d2-d4d43d0daf3e",
                                                "sense_id": "8800e89c-4b05-3793-92ca-7076e3fd3201",
                                                "text": "I, with your two helps, will so practise on Benedick that, in despite of his quick wit and his queasy stomach, he shall fall in love with Beatrice."
                                            },
                                            {
                                                "example_id": "586c5bea-0f5f-479e-9901-a0b173563f70",
                                                "sense_id": "8800e89c-4b05-3793-92ca-7076e3fd3201",
                                                "text": "Petrarca had his Laura, and Dante his Beatrice, but Lorenzo has studiously concealed the name of the sovereign of his affections."
                                            },
                                            {
                                                "example_id": "f62f7af3-a44b-4255-b173-72ca8881e7b6",
                                                "sense_id": "8800e89c-4b05-3793-92ca-7076e3fd3201",
                                                "text": "\"Seventeen years old - a senior in high school. Beatrice, her name is.\"\nBeatrice! Rebecca was struck dumb with admiration. Beatrice would be a female version of Tristram. Rebecca pictured her in a modest muslin dress from the nineteeth century, although she knew that was unlikely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d67d9775-02a7-3446-abb4-e45ac2055f2e",
                                        "entry_id": "f9f5643b-68b8-3b35-bc24-e58d366c36fd",
                                        "glosses": [
                                            "A city, the county seat of Gage County, Nebraska, United States."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
