                        "entry_id": "357bdb8b-87aa-3f87-9626-de9a74058ed4",
                        "glosses": [
                            "Doctrine ou attitude (d’une personne) exprimant la haine ou le mépris à l’égard du genre masculin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d5a3676-7be7-4bbb-a49e-ca546e596044",
                                "sense_id": "717c2fd5-1321-37e1-8af6-799d2aaf96e5",
                                "text": "J’ai commencé par féminisme et mysandrie et j’ai continué lorsque j'ai compris que J'ADORE aligner les hommes sous mes pieds"
                            },
                            {
                                "example_id": "3ba24f26-56f4-44ca-9da6-316ad8469946",
                                "sense_id": "717c2fd5-1321-37e1-8af6-799d2aaf96e5",
                                "text": "PRUNE ET TOXIKGIRL VERSUS CERISE ET MYSANDRIE QUI HULULE DANS UN COIN"
                            },
                            {
                                "example_id": "c2d29cef-4fe9-4232-af36-492e289ae48c",
                                "sense_id": "717c2fd5-1321-37e1-8af6-799d2aaf96e5",
                                "text": "mysandrie et envie de castration"
                            }
                        ]
                    }
                ],
                "translations": [
