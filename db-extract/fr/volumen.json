                                                "sense_id": "480f3590-f085-39ea-a55f-c5fd8868e01d",
                                                "text": "She scrolled the offending image out of view."
                                            },
                                            {
                                                "example_id": "f1a37820-9054-45cb-a931-64de184d5da5",
                                                "sense_id": "480f3590-f085-39ea-a55f-c5fd8868e01d",
                                                "text": "She kept scrolling until she found the desired paragraph."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a054d476-2913-336f-9c86-02f0f3650d85",
                                        "entry_id": "f5b70b2e-8285-3939-b7bd-61385a8cf2e5",
                                        "glosses": [
                                            "To move in or out of view horizontally or vertically."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "783c6b6d-e5fc-4cf5-b8f8-614f6f03701d",
                                                "sense_id": "a054d476-2913-336f-9c86-02f0f3650d85",
                                                "text": "The rising credits slowly scrolled off the screen."
                                            },
                                            {
                                                "example_id": "1612254d-4ef1-44a4-afbb-316e5e29db8c",
                                                "sense_id": "a054d476-2913-336f-9c86-02f0f3650d85",
                                                "text": "The piano plays on. I watch those little rectangles as they scroll down from the top."
                                            },
                                            {
                                                "example_id": "a8786f82-0b4b-4dfd-bc4b-96847a35fdcb",
                                                "sense_id": "a054d476-2913-336f-9c86-02f0f3650d85",
                                                "text": "Pavement scrolled beneath the headlight beams, reminding Emma of a conveyor belt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "684b2011-6ef5-3a12-b5c8-d2f229f73a8e",
                                        "entry_id": "f5b70b2e-8285-3939-b7bd-61385a8cf2e5",
                                        "glosses": [
                                            "To flood a chat system with numerous lines of text, causing legitimate messages to scroll out of view before they can be read."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "dated",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "892bebef-31a6-4bc4-868d-fd3ca3ca6760",
                                                "sense_id": "684b2011-6ef5-3a12-b5c8-d2f229f73a8e",
                                                "text": "Hey, stop scrolling!"
                                            },
                                            {
                                                "example_id": "0b9c60a0-2225-4331-a81f-5955c6fb72d5",
                                                "sense_id": "684b2011-6ef5-3a12-b5c8-d2f229f73a8e",
                                                "text": "It's cool but i know why I prefer newsgroups : I just got banned for scrolling or summat : i was typing one word in each message so pppl^([sic]) could read it cos it was going so fast - geez."
                                            },
                                            {
                                                "example_id": "7ab8563e-249a-4f23-ba72-8249ce0dc1a6",
                                                "sense_id": "684b2011-6ef5-3a12-b5c8-d2f229f73a8e",
                                                "text": "If you want to join this riot, we urge you to! You wont have to worry about being TOSed or reported because there will be no Guides online! So do whatever you want—punt, scroll, tos, just turn AOL into a war zone!"
                                            }
                                        ]
                                    },
