                "senses": [
                    {
                        "sense_id": "ea561a4f-8dfe-321e-b7a0-f5178f20d6d4",
                        "entry_id": "f4fb3cd6-9e15-31a5-bfd6-685c8fab0186",
                        "glosses": [
                            "(männliche^☆) Person, die beruflich Lüftungsanlagen oder Teile davon zeichnet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a50c493-b77b-4390-a2f5-ad29697a46f3",
                                "sense_id": "ea561a4f-8dfe-321e-b7a0-f5178f20d6d4",
                                "text": "„Dank dem internen Wechsel in die Lüftungsabteilung habe ich die Lehre als Lüftungszeichner bei der Firma Sulzer in Luzern abgeschlossen.“"
                            },
                            {
                                "example_id": "c6740eb4-86c6-47f6-afbb-f112666c05f5",
                                "sense_id": "ea561a4f-8dfe-321e-b7a0-f5178f20d6d4",
                                "text": "„Der gelernte Lüftungszeichner setzt sich seit rund sechs Jahren für Kinderrechte und gegen «willkürliche Entscheide von Vormundschafts- und Sozialbehörden» ein.“"
                            },
                            {
                                "example_id": "17dfc151-88be-46c6-a498-31adeeb48cc8",
                                "sense_id": "ea561a4f-8dfe-321e-b7a0-f5178f20d6d4",
                                "text": "„Dad Fernsehelektriker, Mum Apothekerhelferin, Schwester Bäckerin mit dem Herzenswunsch, eines Tages im Zoo zu arbeiten, der sechs Jahre jüngere Bruder absolviert dieser Tage die LAP als Lüftungszeichner: „Ich bin in der Familie weit und breit der einzige Akademiker.““"
                            },
                            {
                                "example_id": "bb00e66d-92ed-4e4f-977b-e43dacf33239",
                                "sense_id": "ea561a4f-8dfe-321e-b7a0-f5178f20d6d4",
                                "text": "„Nach einer «Schnupperstifti» begann Jürg Sidler 1975 seine Lehre als Lüftungszeichner in der Firma Luwa AG.“"
                            },
                            {
                                "example_id": "c881c333-1c78-4b4e-8734-9117c81c7774",
                                "sense_id": "ea561a4f-8dfe-321e-b7a0-f5178f20d6d4",
                                "text": "„ Und der Lüftungszeichner hätte - würde er denn informiert - auch noch was zu sagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
