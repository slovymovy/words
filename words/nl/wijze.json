                    "sense_id": "a6748060-868a-3e7d-8a54-9aac142b5703",
                    "sense_definition": "Verbogen vorm van de stellende trap van <w>wijs</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het waren mooie, <w>wijze</w> woorden die me veel steun gaven.",
                            "target_lang_translations": {
                                "en": "They were beautiful, <w>wise</w> words that gave me a lot of support.",
                                "ru": "Это были прекрасные, <w>мудрые</w> слова, которые дали мне большую поддержку."
                            }
                        },
                        {
                            "text": "Zij kreeg <w>wijze</w> raad van haar ervaren advocaat.",
                            "target_lang_translations": {
                                "en": "She received <w>sage</w> advice from her experienced lawyer.",
                                "ru": "Она получила <w>мудрый</w> совет от своего опытного адвоката."
                            }
                        }
                    ],
                    "synonyms": [
                        "verstandige"
                    ],
                    "antonyms": [
                        "onwijze"
                    ],
                    "common_phrases": [
                        "wijze raad",
                        "wijze woorden",
                        "wijze lessen"
                    ],
                    "target_lang_definitions": {
                        "en": "Inflected form of the adjective 'wijs' (wise).",
                        "ru": "Склоняемая форма прилагательного «wijs» (мудрый)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wise",
                                "target_lang_sense_clarification": "having or showing experience, knowledge, and good judgment"
                            },
                            {
                                "target_lang_word": "sensible",
                                "target_lang_sense_clarification": "chosen in accordance with wisdom or prudence"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "мудрый",
                                "target_lang_sense_clarification": "обладающий большим умом и опытом"
                            },
                            {
                                "target_lang_word": "разумный",
                                "target_lang_sense_clarification": "основанный на здравом смысле"
                            }
                        ]
