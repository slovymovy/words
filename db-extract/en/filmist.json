                        "glosses": [
                            "A filmmaker."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54d2ae62-dce8-4e41-b443-84eb1c6f7913",
                                "sense_id": "a68fe6ca-2c07-3ec9-bfd9-042cde10feef",
                                "text": "Painters, composers, writers, choreographers, and even filmists are becoming less contentious. They are not concerned about attributing values to things. Their presentation of things is direct, without exterior significance."
                            }
                        ]
                    },
                    {
                        "sense_id": "630b3ff5-cc42-35e8-87a1-3a796474e974",
                        "entry_id": "09f5d2df-bc2b-376b-9763-3a1c21932e87",
                        "glosses": [
                            "One who watches or studies films."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea66abaa-d79b-4af9-b866-fe6b13ce5235",
                                "sense_id": "630b3ff5-cc42-35e8-87a1-3a796474e974",
                                "text": "Devoted filmists are still jealous of the medium they admire, especially jealous because, even after films assumed a secure place as a medium of human expression, the arrival of the soundtrack made words into a major element of film, […]"
                            },
                            {
                                "example_id": "b2bc0920-5a43-469c-ba0a-ba2b9cf9e8c0",
                                "sense_id": "630b3ff5-cc42-35e8-87a1-3a796474e974",
                                "text": "Using special guidelines outlined within this introduction, filmists relax, focus, and afterward discuss with others their reactions to magnify the value of film viewing."
                            }
                        ]
                    }
