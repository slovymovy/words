                        "glosses": [
                            "S’étriper mutuellement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93c85278-9fff-482e-9fe3-002172f91851",
                                "sense_id": "8bf12d80-5a89-328e-ab87-6925f08be115",
                                "text": "Ces gens-là passaient leur temps à s’assiéger mutuellement, à s’entre-étriper et à se re-voler leurs trésors volés."
                            },
                            {
                                "example_id": "f1a4ee39-f221-47d4-9ffb-82a01b5e3e01",
                                "sense_id": "8bf12d80-5a89-328e-ab87-6925f08be115",
                                "text": "Faut-il, au lendemain de la guerre, bazarder l'humanisme sous prétexte que culottes de peau, traîneurs de sabres et autres marchands de canon ont fait s'entre-étriper des prolétaires qui, paraît-il, n'ont pas de patrie ?"
                            }
                        ]
                    }
