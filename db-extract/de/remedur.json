                                "sense_id": "25285350-2c4f-3c18-91d2-e7223519fc29",
                                "text": "Alle menschlichen Institutionen, wie die Ehe, gestatten nur einen mässigen Grad von praktischer Idealisirung, widrigenfalls sofort grobe Remeduren nöthig werden.",
                                "translation": "Human, All Too Human",
                                "english": "Human, All Too Human"
                            },
                            {
                                "example_id": "b54da746-2bee-46df-b965-34a7ef24414e",
                                "sense_id": "25285350-2c4f-3c18-91d2-e7223519fc29",
                                "text": "Der sei ein Hauptkerl und werde schon Remedur schaffen.",
                                "translation": "The Magic Mountain",
                                "english": "The Magic Mountain"
                            }
                        ]
