{
    "word_family": [
        "wry",
        "wryness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ff1193e9-1280-3f96-b30d-8efe80d4ad63",
                    "sense_definition": "In an ironically humorous, dry, or sarcastic manner.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He observed <w>wryly</w> that the new computer system caused more problems than it solved.",
                            "target_lang_translations": {
                                "ru": "Он <w>с иронией</w> заметил, что новая компьютерная система создала больше проблем, чем решила."
                            }
                        },
                        {
                            "text": "She smiled <w>wryly</w> as she remembered how confident they had been before the exam.",
                            "target_lang_translations": {
                                "ru": "Она <w>криво</w> усмехнулась, вспомнив, насколько уверенными они были перед экзаменом."
                            }
                        }
                    ],
                    "synonyms": [
                        "ironically",
                        "sardonically",
                        "dryly"
                    ],
                    "antonyms": [
                        "earnestly",
                        "seriously"
                    ],
                    "common_phrases": [
                        "smile wryly",
                        "grin wryly",
                        "observe wryly",
                        "note wryly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иронично, с сарказмом или с горьким юмором."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иронично",
                                "target_lang_sense_clarification": "с мягкой насмешкой или тонкой иронией"
                            },
                            {
                                "target_lang_word": "криво",
                                "target_lang_sense_clarification": "с кривой, скептической ухмылкой"
                            },
                            {
                                "target_lang_word": "саркастически",
                                "target_lang_sense_clarification": "с язвительной насмешкой"
                            },
                            {
                                "target_lang_word": "с иронией",
                                "target_lang_sense_clarification": "в насмешливой или скептической манере"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6cf95772-de10-356d-9bb8-b15e73e52a96",
                    "sense_definition": "In a twisted, crooked, or contorted manner.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His mouth twisted <w>wryly</w> to one side when he tried to hide his disappointment.",
                            "target_lang_translations": {
                                "ru": "Его рот <w>криво</w> скривился набок, когда он попытался скрыть разочарование."
                            }
                        },
                        {
                            "text": "She tilted her head <w>wryly</w> while examining the strange abstract painting on the wall.",
                            "target_lang_translations": {
                                "ru": "Она <w>набок</w> наклонила голову, разглядывая странную абстрактную картину на стене."
                            }
                        }
                    ],
                    "synonyms": [
                        "crookedly",
                        "askew"
                    ],
                    "antonyms": [
                        "straightly",
                        "symmetrically"
                    ],
                    "common_phrases": [
                        "twisted wryly"
                    ],
                    "target_lang_definitions": {
                        "ru": "Криво, косо, с искажением или перекосом формы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "криво",
                                "target_lang_sense_clarification": "неровно, набок, асимметрично"
                            },
                            {
                                "target_lang_word": "набок",
                                "target_lang_sense_clarification": "с наклоном в одну сторону"
                            },
                            {
                                "target_lang_word": "косо",
                                "target_lang_sense_clarification": "криво или с перекосом"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}