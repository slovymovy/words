                        "peine de réclusion",
                        "réclusion à perpétuité"
                    ]
                },
                {
                    "sense_id": "770f48e4-b072-3dca-ab18-92713ab4e348",
                    "sense_definition": "Fait ou état de vivre à l'écart du monde et de la société, enfermé volontairement ou involontairement dans un lieu.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "isolement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après ce drame personnel, l'écrivain a choisi de vivre dans une totale <w>réclusion</w>."
                        },
                        {
                            "text": "Elle ne supportait plus cette longue <w>réclusion</w> forcée entre les quatre murs de sa chambre."
                        }
                    ],
                    "synonyms": [
