                ],
                "senses": [
                    {
                        "sense_id": "736f6a9b-9860-3f38-a010-520a81ec0a13",
                        "entry_id": "94d61ee8-d2b1-3c4c-b2d9-098de2f07343",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c12906d3-086d-46e5-b94b-7db79a2bc1eb",
                                "sense_id": "736f6a9b-9860-3f38-a010-520a81ec0a13",
                                "text": "Frau Rieger ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "80dd856e-83be-48d9-bb1f-797af3414e2a",
                                "sense_id": "736f6a9b-9860-3f38-a010-520a81ec0a13",
                                "text": "Herr Rieger wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "28eee1e4-36a3-4d35-ac80-a6373dbc5f10",
                                "sense_id": "736f6a9b-9860-3f38-a010-520a81ec0a13",
                                "text": "Die Riegers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "233fbd99-cb9a-40b8-ac4b-8737bf004835",
                                "sense_id": "736f6a9b-9860-3f38-a010-520a81ec0a13",
                                "text": "Der Rieger trägt nie die Schals, die die Rieger ihm strickt."
                            },
                            {
                                "example_id": "9488d12d-64c8-40e3-995b-d388266e21b6",
                                "sense_id": "736f6a9b-9860-3f38-a010-520a81ec0a13",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Rieger kommt, geht der Herr Schoch.“"
                            },
                            {
                                "example_id": "6da44001-cbf9-4908-8edf-9021404c2b4e",
                                "sense_id": "736f6a9b-9860-3f38-a010-520a81ec0a13",
                                "text": "Rieger kommt und geht."
                            },
                            {
                                "example_id": "5235be37-31b9-4f97-8b0c-aa7ec83ac2e6",
                                "sense_id": "736f6a9b-9860-3f38-a010-520a81ec0a13",
                                "text": "Riegers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
