                        ],
                        "form": "о́тыгрыше"
                    },
                    {
                        "form_id": "51a5a51b-8ac4-4d06-98ac-8b8c299f2d63",
                        "entry_id": "96134797-3e94-3c20-850d-c78894836f0c",
                        "tags": [
                            "plural",
