                    "frequency": "Middle",
                    "semantic_group_id": "representation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist chose to <w>depict</w> the rural landscape using vibrant colors and bold brushstrokes.",
                            "target_lang_translations": {
                                "ru": "Художник решил <w>изобразить</w> сельский пейзаж, используя яркие цвета и смелые мазки."
                            }
                        },
                        {
                            "text": "The novel's opening chapters <w>depict</w> life in a small town during the early twentieth century.",
                            "target_lang_translations": {
                                "ru": "Первые главы романа <w>описывают</w> жизнь в маленьком городке в начале двадцатого века."
                            }
                        }
                    ],
                    "synonyms": [
                        "portray",
                        "show",
                        "describe",
                        "render",
                        "draw"
                    ],
                    "common_phrases": [
