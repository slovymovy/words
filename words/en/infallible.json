{
    "word_family": [
        "infallibility",
        "infallibly",
        "fallible",
        "fallibility"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e341f439-98ef-3b34-8031-2a9909c5da86",
                    "sense_definition": "Certain to produce the intended effect or result; completely reliable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reliability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor recommended an <w>infallible</w> cure for hiccups that has worked for every patient.",
                            "target_lang_translations": {
                                "ru": "Врач порекомендовал <w>верное</w> средство от икоты, которое помогало каждому пациенту.",
                                "tr": "Doktor, her hastada işe yaramış olan <w>şaşmaz</w> bir hıçkırık tedavisi önerdi."
                            }
                        },
                        {
                            "text": "Following this <w>infallible</w> method will ensure that your cake rises perfectly every single time.",
                            "target_lang_translations": {
                                "ru": "Следование этому <w>безошибочному</w> методу гарантирует, что ваш торт будет идеально подниматься каждый раз.",
                                "tr": "Bu <w>şaşmaz</w> yöntemi izlemek, kekinizin her seferinde kusursuz biçimde kabarmasını sağlayacaktır."
                            }
                        }
                    ],
                    "synonyms": [
                        "perfect",
                        "faultless"
                    ],
                    "antonyms": [
                        "faulty",
                        "defective",
                        "imperfect"
                    ],
                    "common_phrases": [
                        "infallible cure",
                        "infallible method",
                        "infallible sign"
                    ],
                    "target_lang_definitions": {
                        "ru": "Гарантированно дающий желаемый эффект или результат; полностью надежный.",
                        "tr": "İstenen etkiyi veya sonucu kesinlikle veren; tamamen güvenilir ve asla aksamayan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безошибочный",
                                "target_lang_sense_clarification": "о методе или способе"
                            },
                            {
                                "target_lang_word": "верный",
                                "target_lang_sense_clarification": "о средстве или способе"
                            },
                            {
                                "target_lang_word": "надежный",
                                "target_lang_sense_clarification": "о результате или средстве"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "şaşmaz",
                                "target_lang_sense_clarification": "yöntem, çare veya sonuç hakkında"
                            },
                            {
                                "target_lang_word": "kesin",
                                "target_lang_sense_clarification": "kesin sonuç veren yöntem veya tedavi"
                            },
                            {
                                "target_lang_word": "yanılmaz",
                                "target_lang_sense_clarification": "güvenilir gösterge veya yöntem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "96505dbd-fed7-3b27-8040-994b3f78df0f",
                    "sense_definition": "Incapable of making mistakes or being wrong.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "perfection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Even the most experienced experts are not <w>infallible</w> and can occasionally make a mistake.",
                            "target_lang_translations": {
                                "ru": "Даже самые опытные эксперты не <w>непогрешимы</w> и могут время от времени совершать ошибки.",
                                "tr": "En deneyimli uzmanlar bile <w>yanılmaz</w> değildir ve ara sıra hata yapabilirler."
                            }
                        },
                        {
                            "text": "The scientist admitted that his memory was not an <w>infallible</w> source of information for the study.",
                            "target_lang_translations": {
                                "ru": "Ученый признал, что его память не была <w>безошибочным</w> источником информации для исследования.",
                                "tr": "Bilim insanı, hafızasının çalışma için <w>şaşmaz</w> bir bilgi kaynağı olmadığını kabul etti."
                            }
                        }
                    ],
                    "synonyms": [
                        "inerrant",
                        "faultless",
                        "perfect"
                    ],
                    "antonyms": [
                        "fallible",
                        "error-prone"
                    ],
                    "common_phrases": [
                        "not infallible",
                        "infallible memory",
                        "infallible guide"
                    ],
                    "target_lang_definitions": {
                        "ru": "Неспособный совершать ошибки или заблуждаться.",
                        "tr": "Hata yapma veya yanılma ihtimali bulunmayan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непогрешимый",
                                "target_lang_sense_clarification": "не совершающий ошибок"
                            },
                            {
                                "target_lang_word": "безошибочный",
                                "target_lang_sense_clarification": "о памяти или суждениях"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yanılmaz",
                                "target_lang_sense_clarification": "insan, zihin veya hafıza hakkında"
                            },
                            {
                                "target_lang_word": "hata yapmaz",
                                "target_lang_sense_clarification": "kusursuz kişi veya merci"
                            },
                            {
                                "target_lang_word": "şaşmaz",
                                "target_lang_sense_clarification": "hata yapmayan rehber veya kaynak"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1ae24349-23f4-3a55-ab7a-bc150ceda975",
                    "sense_definition": "A person who, or an object or process that, is considered to be <w>infallible</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "perfection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the eyes of his devoted followers, the leader was seen as one of the few <w>infallibles</w> in history.",
                            "target_lang_translations": {
                                "ru": "В глазах своих преданных последователей лидер считался одним из немногих <w>непогрешимых</w> в истории.",
                                "tr": "Sadık takipçilerinin gözünde lider, tarihteki birkaç <w>yanılmaz kişiden</w> biri olarak görülüyordu."
                            }
                        },
                        {
                            "text": "The ancient text was treated as an <w>infallible</w> by the scholars who studied it daily.",
                            "target_lang_translations": {
                                "ru": "Ученые, изучавшие этот древний текст ежедневно, относились к нему как к <w>непогрешимой истине</w>.",
                                "tr": "Kadim metin, onu her gün inceleyen akademisyenler tarafından <w>şaşmaz bir otorite</w> olarak kabul edildi."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, предмет или процесс, который считается непогрешимым или безошибочным.",
                        "tr": "Asla yanılmadığı veya hata yapmadığı kabul edilen kişi, nesne ya da süreç."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непогрешимый",
                                "target_lang_sense_clarification": "о человеке"
                            },
                            {
                                "target_lang_word": "непогрешимая истина",
                                "target_lang_sense_clarification": "об объекте или тексте"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yanılmaz kişi",
                                "target_lang_sense_clarification": "hata yapmadığı düşünülen kimse"
                            },
                            {
                                "target_lang_word": "şaşmaz merci",
                                "target_lang_sense_clarification": "kesin ve kusursuz kabul edilen kaynak"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}