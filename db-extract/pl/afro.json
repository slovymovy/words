                                    {
                                        "sense_id": "fe0af420-4e0c-3ff9-be27-5561411ddeb9",
                                        "entry_id": "d2f1acef-1fc7-39e5-a5aa-24fcdbb96915",
                                        "glosses": [
                                            "hairstyle characterized by tightly curled locks and a rounded shape."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28a113c1-6c38-41bb-b6f3-a911923dd6af",
                                                "sense_id": "fe0af420-4e0c-3ff9-be27-5561411ddeb9",
                                                "text": "sheʼd been unmissable sitting in the front row of the lecture theatre with a crazy-ass afro and stunning face"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bd2e033-15b4-3675-9c7e-f84393b06345",
                                        "entry_id": "d2f1acef-1fc7-39e5-a5aa-24fcdbb96915",
                                        "glosses": [
                                            "A person of African ancestry"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce6d02c0-59e7-4c7d-9957-88359a22c178",
                                                "sense_id": "0bd2e033-15b4-3675-9c7e-f84393b06345",
                                                "text": "The Ghanaian government employed several Afros, as many of the expatriates called themselves, downplaying their Americanness, in ideological and infrastructure-building occupations."
                                            },
                                            {
                                                "example_id": "8b6e459b-ecd7-470a-99be-db0a13f2db48",
                                                "sense_id": "0bd2e033-15b4-3675-9c7e-f84393b06345",
                                                "text": "At the height of the American civil rights agitation, a number of members of the Black Panther movement moved to Tanzania, and lived outside Arusha where they formed a community, calling themselves ‘’Afros.’’"
                                            },
                                            {
                                                "example_id": "304e0482-e0ee-4a84-aed2-38b39a01f380",
                                                "sense_id": "0bd2e033-15b4-3675-9c7e-f84393b06345",
                                                "text": "Afrodescendants (or simply Afros) are the descendants of Africans who were dispersed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "371ffbe3-a754-4f46-90b2-9e6d857559c5",
                        "source_entry_id": "36c5897c-aff7-3131-b137-a9daffdfca8a",
