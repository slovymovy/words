                                        "glosses": [
                                            "zodiakalny gwiazdozbiór nieba południowego, w Polsce widoczny częściowo latem, nisko nad horyzontem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea848f90-9400-4331-abd8-b525df697a06",
                                                "sense_id": "b4b05661-2eff-32bb-8af6-54faa85b0a62",
                                                "text": "Skorpion bywa w legendach identyfikowany ze skorpionem, który na polecenie Artemidy uśmiercił Oriona."
                                            },
                                            {
                                                "example_id": "4de978ab-149d-4828-adaf-d83f220728e8",
                                                "sense_id": "b4b05661-2eff-32bb-8af6-54faa85b0a62",
                                                "text": "Najjaśniejszą gwiazdą w gwiazdozbiorze Skorpiona jest Antares, zwany też Sercem Skorpiona."
                                            },
                                            {
                                                "example_id": "06e6b9f9-3802-4821-8cd4-9def65cf0b20",
                                                "sense_id": "b4b05661-2eff-32bb-8af6-54faa85b0a62",
                                                "text": "Konstelacja Skorpiona góruje o północy w czerwcu."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "4d3763c7-4349-3f9b-91ed-5e8c9f4549bb",
                                        "entry_id": "83158767-8e21-3263-a79d-0dcbc9e9192a",
                                        "glosses": [
                                            "ósmy znak zodiaku, w którym Słońce znajduje się od 23 października do 21 listopada"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32ee66d5-1a6c-4485-a318-07a8ae28c88a",
                                                "sense_id": "4d3763c7-4349-3f9b-91ed-5e8c9f4549bb",
                                                "text": "Skorpion to jeden ze znaków zodiaku, który występuje po Wadze, a przed Strzelcem."
                                            },
                                            {
                                                "example_id": "49c0b366-11a8-4140-b64a-203a05e3d772",
                                                "sense_id": "4d3763c7-4349-3f9b-91ed-5e8c9f4549bb",
                                                "text": "Pod koniec października Słońce wchodzi w znak Skorpiona."
                                            },
                                            {
                                                "example_id": "21161e35-9e7d-438f-bed7-409092f6232b",
                                                "sense_id": "4d3763c7-4349-3f9b-91ed-5e8c9f4549bb",
                                                "text": "Skorpionem, jednym z jesiennych, wodnych i stałych znaków zodiaku, rządzi planeta Mars."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            },
