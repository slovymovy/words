                                    {
                                        "sense_id": "1355d8ad-545f-3287-bc4a-7259e54897e2",
                                        "entry_id": "72f103db-472d-3d1c-b845-1bc544957477",
                                        "glosses": [
                                            "Ouvrage imprimé qui a peu d’étendue et qui n’est que broché."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b95de46d-95fa-465d-9069-b58d126f1817",
                                                "sense_id": "1355d8ad-545f-3287-bc4a-7259e54897e2",
                                                "text": "Cette fin de l'année 1871 ne fut signalée que par la propagande des partis ; un grand nombre des brochures bonapartistes et légitimistes se distribuèrent en province."
                                            },
                                            {
                                                "example_id": "354cbec0-2e98-4550-abd9-dd54ccd49ff5",
                                                "sense_id": "1355d8ad-545f-3287-bc4a-7259e54897e2",
                                                "text": "Dans une brochure qui a fait quelque scandale, le général Donop […] voudrait, comme Bugeaud et Dragomiroff, que chacun dans la bataille connût exactement le plan de ses chefs."
                                            },
                                            {
                                                "example_id": "779337cd-4ec0-4064-8c9b-d46ea23657c4",
                                                "sense_id": "1355d8ad-545f-3287-bc4a-7259e54897e2",
                                                "text": "Quant aux installations coopératives de la maison Michelin, elles sont un État dans l'État; elles constituent un monde dont la description nécessiterait une brochure spéciale."
                                            },
                                            {
                                                "example_id": "1f74b566-74e1-4830-9633-a67300948f98",
                                                "sense_id": "1355d8ad-545f-3287-bc4a-7259e54897e2",
                                                "text": "Il s'agissait de conférences et de parlottes défaitistes, au cours desquelles il était donné lecture de fragments de séances parlementaires en comité secret, considérés comme aptes à démoraliser les auditeurs, et aussi de tracts et de brochures progermaniques."
                                            }
                                        ]
                                    }
