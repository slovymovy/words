                "senses": [
                    {
                        "sense_id": "7e8bd5e2-f92a-3340-9d32-359788ba925a",
                        "entry_id": "7013d7d6-36a8-3eb4-8417-1cd261c78c53",
                        "glosses": [
                            "Tissus inventé par l’entreprise Burberry et qui est utilisé, entre autres, à la confection d’imperméables."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6ec6c02-6066-4b22-b855-3b48dd5affb9",
                                "sense_id": "7e8bd5e2-f92a-3340-9d32-359788ba925a",
                                "text": "[…] une veste pyjama le tout recouvert par un bourgeron et un pantalon en burberry."
                            },
                            {
                                "example_id": "e0ce5f46-8ffb-40bf-9546-57a29ada82be",
                                "sense_id": "7e8bd5e2-f92a-3340-9d32-359788ba925a",
                                "text": "[…] mais pendant les raids, l’étoffe, connue sous le nom de burberry, par sa légèreté et par son imperméabilité absolue au vent et à la neige, est certainement ce que l’on peut désirer de mieux."
                            }
                        ]
                    },
                    {
                        "sense_id": "20971f7c-4d63-31d3-bfe3-092fff15dec1",
                        "entry_id": "7013d7d6-36a8-3eb4-8417-1cd261c78c53",
                        "glosses": [
                            "Désigne actuellement un type de dessin écossais (et des déclinaisons) dans les tons beige, camel, fauve à fines raies rouges, mis à la mode par l’entreprise Burberry."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "34be5b6e-4402-3f58-ae0a-83c40ffe22d3",
                        "entry_id": "7013d7d6-36a8-3eb4-8417-1cd261c78c53",
                        "glosses": [
                            "Imperméable conçu par Thomas Burberry ou son entreprise, qui porte son nom."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac4a4d40-eefa-41fa-b5b3-3c792a56818d",
                                "sense_id": "34be5b6e-4402-3f58-ae0a-83c40ffe22d3",
                                "text": "Le BURBERRY -un pardessus- a crée la mode en Angleterre et est devenu un vêtement d’utilité internationale. Remarquable par son extraordinaire légèreté et l’ampleur de sa coupe, il constitue une révélation d’allure confortable."
                            },
                            {
                                "example_id": "ee83167a-83c3-4980-ba64-0d392e3041bc",
                                "sense_id": "34be5b6e-4402-3f58-ae0a-83c40ffe22d3",
                                "text": "Les pieds, complètement mouillés, devenaient tout raides ; les vêtements faisaient carapace. J’étais vêtu de mon burberry, que j’ai gardé jusqu’à présent, chaussé de bottes avec, sur la tête, un bonnet de fourrure."
                            },
                            {
                                "example_id": "f83d55b2-9ee2-4ca4-86d5-b1c05866a637",
                                "sense_id": "34be5b6e-4402-3f58-ae0a-83c40ffe22d3",
                                "text": "À mi-chemin, le vent vire au Sud-Ouest ou à l’Ouest-Sud-Ouest ; il passe maintenant à travers nos burberrys et nos moufles."
                            }
                        ]
                    }
                ],
