                        "source_sense_id": "3417f973-4b94-3869-b453-90c1e5ae6263",
                        "source_sense_description": "Medizin: Mediziner, der sich mit Erkrankungen des Herzens beschäftigt",
                        "target_lang_word": "cardiologue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cardiologue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "283d1765-dc1c-363a-8a67-d74898c30e66",
                                        "entry_id": "1599a80f-5194-3e67-be67-59d4cfa892a4",
                                        "glosses": [
                                            "Médecin spécialiste du cœur et de ses maladies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0a5d989-4531-45ae-85e5-67d06b70f3e7",
                                                "sense_id": "283d1765-dc1c-363a-8a67-d74898c30e66",
                                                "text": "Ils sont suivis, semble-t-il depuis longtemps, par le même médecin généraliste ainsi que par un cardiologue."
                                            },
                                            {
                                                "example_id": "9240b4c7-71e2-4e9d-8095-f5ad44badb2a",
                                                "sense_id": "283d1765-dc1c-363a-8a67-d74898c30e66",
                                                "text": "Oui, tout va bien, madame Deck, vous pouvez arrêter les anticoagulants, c’est à cause d’eux que vous avez ce vilain saignement sous-cutané, de toute façon vous avez rendez-vous avec la cardiologue la semaine prochaine pour faire le point."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
