{
    "word_family": [
        "herringbone"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2a3770b6-c681-3d2b-a44a-5462a971e954",
                    "sense_definition": "A small, oily fish of the genus Clupea, found in temperate waters and widely used as food.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "For breakfast, they served traditional pickled <w>herring</w> with onions and rye bread.",
                            "target_lang_translations": {
                                "ru": "На завтрак подали традиционную маринованную <w>селёдку</w> с луком и ржаным хлебом."
                            }
                        },
                        {
                            "text": "The fishermen returned to the harbor with a large catch of fresh <w>herring</w>.",
                            "target_lang_translations": {
                                "ru": "Рыбаки вернулись в гавань с большим уловом свежей <w>сельди</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pickled herring",
                        "red herring"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая жирная рыба рода Clupea, обитающая в умеренных водах и широко используемая в пищу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сельдь",
                                "target_lang_sense_clarification": "официальное и биологическое название рыбы"
                            },
                            {
                                "target_lang_word": "селёдка",
                                "target_lang_sense_clarification": "разговорное название рыбы или блюда из неё"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e88050a6-c6f2-33f9-b666-e3cc787a36bc",
                    "sense_definition": "Any fish belonging to the family Clupeidae or the order Clupeiformes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Marine biologists are studying the migration patterns of various species of <w>herring</w> in the North Sea.",
                            "target_lang_translations": {
                                "ru": "Морские биологи изучают пути миграции различных видов <w>сельди</w> в Северном море."
                            }
                        },
                        {
                            "text": "The family Clupeidae includes not only the Atlantic <w>herring</w> but also sardines and shad.",
                            "target_lang_translations": {
                                "ru": "Семейство сельдевых включает в себя не только атлантическую <w>сельдь</w>, но также сардины и алозу."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific classification"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Любая рыба, принадлежащая к семейству сельдевых (Clupeidae) или отряду сельдеобразных (Clupeiformes)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сельдевая рыба",
                                "target_lang_sense_clarification": "представитель семейства сельдевых"
                            },
                            {
                                "target_lang_word": "сельдь",
                                "target_lang_sense_clarification": "в широком биологическом смысле"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "78ff069a-4abd-3631-8469-495204b9af8d",
                    "sense_definition": "A English surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local library was named after Arthur <w>Herring</w>, a prominent historical figure in the town.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь Артура <w>Херринга</w>, видного исторического деятеля города."
                            }
                        },
                        {
                            "text": "We invited Mr. <w>Herring</w> to speak at the annual conference about his research.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили господина <w>Херринга</w> выступить на ежегодной конференции с докладом о его исследовании."
                            }
                        }
                    ],
                    "traits": [
