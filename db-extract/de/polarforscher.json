                "senses": [
                    {
                        "sense_id": "ed078245-262a-3ba6-8c52-0c2688c39ca9",
                        "entry_id": "aa6d87e8-2609-3986-9726-951ea67c53d5",
                        "glosses": [
                            "Forscher, der sich mit der Erforschung der Polargebiete beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a5d4b5c6-d13b-4cca-bb71-bba2606a6c80",
                                "sense_id": "ed078245-262a-3ba6-8c52-0c2688c39ca9",
                                "text": "„Denn obwohl der Region durch den Klimawandel und wegen reicher Vorkommen an Rohstoffen zunehmend wirtschaftliches wie politisches Interesse zukommt, kommen die Polarforscher in der Öffentlichkeit kaum zu Wort.“"
                            },
                            {
                                "example_id": "a23df732-3489-46fc-8ff7-aa84a46fcccb",
                                "sense_id": "ed078245-262a-3ba6-8c52-0c2688c39ca9",
                                "text": "„Von einem Tag auf den anderen durfte Charles Monnett sein Büro nicht mehr betreten: Das US-Innenministerium warf dem Polarforscher vor, Daten für einen Artikel gefälscht zu haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
