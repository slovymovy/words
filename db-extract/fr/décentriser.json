                "senses": [
                    {
                        "sense_id": "62ed68e5-2b69-38d7-94a6-8038342c01e2",
                        "entry_id": "81b88086-f2a6-3e9d-9c13-cafda8036498",
                        "glosses": [
                            "Enlever son caractère centriste à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c60aae6-3968-4725-b2b2-cccd2823609a",
                                "sense_id": "62ed68e5-2b69-38d7-94a6-8038342c01e2",
                                "text": "Si l’on ajoute à cela le fait que Bayrou est en train de rassembler le centre et se met à rêver d’un second tour, Dominique de Villepin se doit de « décentriser » son discours."
                            },
                            {
                                "example_id": "1f46723e-e9b8-436b-bda5-0198fbf0151d",
                                "sense_id": "62ed68e5-2b69-38d7-94a6-8038342c01e2",
                                "text": "Car au final la société francaise se droitise (enfin en tout cas se « décentrise »), donc on verra bien."
                            },
                            {
                                "example_id": "90dd52d8-d26d-43e6-8e72-e03870abb265",
                                "sense_id": "62ed68e5-2b69-38d7-94a6-8038342c01e2",
                                "text": "Je ne sais pas si la France vire à droite, mais en tout cas elle se \"décentrise\", les Français désertent les centres c'est sûr!"
                            }
                        ]
                    }
