                "senses": [
                    {
                        "sense_id": "f8ab9dee-5900-3a52-af1e-6e5d08be316b",
                        "entry_id": "52f9a33e-6a23-3dea-8098-1bce44b19e72",
                        "glosses": [
                            "spezifische Art der Guerilla, ihre Gegner zu bekämpfen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "044bbb68-6a07-4895-a263-bdca080962ec",
                                "sense_id": "f8ab9dee-5900-3a52-af1e-6e5d08be316b",
                                "text": "„Da die Buren ihre Gegner erfolgreich mit einer Guerillataktik bekämpfen, machen die britischen Offiziere bald kaum noch einen Unterschied zwischen Milizen und Zivilisten: Feind ist, wer auf gegnerischem Gebiet lebt.“"
                            },
                            {
                                "example_id": "2fb7bce7-bdbd-4ff7-91fb-af07bb1fa42b",
                                "sense_id": "f8ab9dee-5900-3a52-af1e-6e5d08be316b",
                                "text": "„Weil ihre Gegner besser bewaffnet sind, wenden die Rebellen Guerillataktiken an.“"
                            },
                            {
                                "example_id": "de3e1b8c-f5bb-4926-b735-9be7abbcc83f",
                                "sense_id": "f8ab9dee-5900-3a52-af1e-6e5d08be316b",
                                "text": "„Nach gut hundert Jahren Emanzipationsbewegung haben Frauen zwar nicht die Hälfte der Chefposten inne, dennoch ist es ihnen mit einer Art Guerillataktik gelungen, die westliche Kultur nachhaltig zu feminisieren.“"
                            },
                            {
                                "example_id": "d5008534-f8c5-4a2e-8f42-8e192f6e1288",
                                "sense_id": "f8ab9dee-5900-3a52-af1e-6e5d08be316b",
                                "text": "„Erst langsam lernten die Briten, mit dieser Guerillataktik umzugehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
