    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "636847a6-f7ef-31a2-af6d-69cac9d04f6e",
                "word": "baht",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "11ea1e72-ab9e-36ac-83e5-14ab992c9c36",
                        "entry_id": "636847a6-f7ef-31a2-af6d-69cac9d04f6e",
                        "glosses": [
                            "Without."
                        ],
                        "tags": [
                            "Yorkshire",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "2ceff726-93c9-4f3f-931b-cbf70c936e5b",
                                "sense_id": "11ea1e72-ab9e-36ac-83e5-14ab992c9c36",
                                "text": "c. 1850s–70s, On Ilkla Moor Baht 'at (song)"
                            },
                            {
                                "example_id": "faa576ea-f9c9-48c6-97ba-807eea018ca7",
                                "sense_id": "11ea1e72-ab9e-36ac-83e5-14ab992c9c36",
                                "text": "Thear's boan-idle nowbles, baht hahses an' lands, 'at al walk on a carpeted path, an' nivver do nowt wi' ther lily-white hands bud lift uther fowk's jock to ther maath."
                            },
                            {
                                "example_id": "f4e7697c-09a0-40d9-98d5-56c323309f4a",
                                "sense_id": "11ea1e72-ab9e-36ac-83e5-14ab992c9c36",
                                "text": "Hah's a growing lad to thrive baht jock?"
                            },
                            {
                                "example_id": "24075a15-7f42-4cf2-a21c-dca76893f233",
                                "sense_id": "11ea1e72-ab9e-36ac-83e5-14ab992c9c36",
                                "text": "Jud put'em i' his poke baht sayingk owt. \"Nay, mon!\" ses Jock, \"tha winnat goo hwon baht gieingk me th' brass for th' pattens, wilt a? Thah'rt welly drunk!\""
                            },
                            {
                                "example_id": "10df4613-9345-45f1-9e4b-77608cef2020",
                                "sense_id": "11ea1e72-ab9e-36ac-83e5-14ab992c9c36",
                                "text": "\"Ho'd thi din,\" cried Dave Berry, thickly. \"Ther's noise enew baht thy blether."
                            }
                        ]
                    }
                ],
