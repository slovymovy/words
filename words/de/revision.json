                    "frequency": "Middle",
                    "semantic_group_id": "aenderung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach einer ausführlichen Diskussion beschloss das Komitee die <w>Revision</w> des bisherigen Entwurfs."
