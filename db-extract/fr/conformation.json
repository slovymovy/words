            {
                "entry_id": "f10ad8c1-a622-3a36-bd9c-86923991df9d",
                "word": "conformation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3aee700c-5d92-484b-b8ed-6453fa123b1f",
                        "entry_id": "f10ad8c1-a622-3a36-bd9c-86923991df9d",
                        "tags": [
                            "plural"
                        ],
                        "form": "conformations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "67e03cc7-6e4b-3a49-8e94-a84050bc8379",
                        "entry_id": "f10ad8c1-a622-3a36-bd9c-86923991df9d",
                        "glosses": [
                            "Manière dont une chose est conformée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "352c9ccf-bd5d-4f16-8b3d-58a0354bdba1",
                                "sense_id": "67e03cc7-6e4b-3a49-8e94-a84050bc8379",
                                "text": "Les glaciers du Spitzberg, bien que très importants, ne débitent pas d’icebergs ; leur conformation ainsi que les fonds réduits de la mer à leur base, ne permettent pas le vêlage d’ice-blocs."
                            }
                        ]
                    },
                    {
                        "sense_id": "2246561d-0370-300c-a2a8-f5d4abf3a8b9",
                        "entry_id": "f10ad8c1-a622-3a36-bd9c-86923991df9d",
                        "glosses": [
                            "Disposition des parties d'un corps, d'un organisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "333050fb-b9aa-44f6-bcec-7e9a1ce234a4",
                                "sense_id": "2246561d-0370-300c-a2a8-f5d4abf3a8b9",
                                "text": "[…], les moutons sont l'objet de toute la sollicitude des cultivateurs, et l'on y voit de grands troupeaux de mérinos, remarquables par leur bonne conformation et l'abondance et la finesse de leurs toisons […]."
                            },
                            {
                                "example_id": "8a6b056d-0c5c-49a1-81bc-5c43b18d0c1d",
                                "sense_id": "2246561d-0370-300c-a2a8-f5d4abf3a8b9",
                                "text": "Si l’anus est trop en avant, la partie supérieure de la vulve bascule horizontalement sur le bassin. Ce défaut de conformation ou le manque de tonus des lèvres vulvaires favorisent la pénétration permanente d'air dans le vagin (pneumovagin) entraînant vaginites (inflammation du vagin) et endométrites (inflammation de l'utérus)."
                            },
                            {
                                "example_id": "2cdb5f17-169a-4491-a532-73df02789aae",
                                "sense_id": "2246561d-0370-300c-a2a8-f5d4abf3a8b9",
                                "text": "Il est né avec un vice de conformation."
                            }
                        ]
                    },
                    {
                        "sense_id": "5d6c3acc-5bc3-33d8-802c-20739f9891dc",
                        "entry_id": "f10ad8c1-a622-3a36-bd9c-86923991df9d",
                        "glosses": [
                            "Disposition spatiale des atomes ou des groupes d'atomes d'une entité moléculaire s'appliquant à des structures stéréo-isomères qui peuvent être interconverties par des rotations autour de liaisons simples."
                        ],
                        "tags": [
                            "Stéréochimie"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "87e0792c-7b40-4576-8380-9542a66b89ce",
                        "source_entry_id": "f10ad8c1-a622-3a36-bd9c-86923991df9d",
                        "target_lang_word": "conformation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conformation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6dc34c39-5283-3481-8902-3831a7e3ec68",
                                        "entry_id": "b30231e0-4a15-30fe-bcab-878b7d7f04bb",
                                        "glosses": [
                                            "The act of conforming; the act of producing conformity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ef41008c-41b2-323c-a9c6-989253c7ae8a",
                                        "entry_id": "b30231e0-4a15-30fe-bcab-878b7d7f04bb",
                                        "glosses": [
                                            "The state of being conformed; agreement"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f46d38e1-ee90-43ab-8a87-b1a7a242e046",
                                                "sense_id": "ef41008c-41b2-323c-a9c6-989253c7ae8a",
                                                "text": "I was much struck with the gaiety of the creoles , whose exterior told a stranger that education had been doing something among them in these solitudes ; and as all the parties kissed the Bible in conformation with the law of England"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8cb1dc42-95a4-3663-a1e1-51db268ff104",
                                        "entry_id": "b30231e0-4a15-30fe-bcab-878b7d7f04bb",
                                        "glosses": [
                                            "Structure, the arrangement of parts of some thing; form; arrangement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c7c57d8-df78-443b-befd-3b0c5b17a743",
                                                "sense_id": "8cb1dc42-95a4-3663-a1e1-51db268ff104",
                                                "text": "One may see well the advantages of this form from the coach - box of our heavily - loaded public vehicles , where animals of different conformation are yoked together"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "953027d9-a211-3460-8fd1-c20fb4747f6f",
                                        "entry_id": "b30231e0-4a15-30fe-bcab-878b7d7f04bb",
                                        "glosses": [
                                            "The spatial arrangement of a group of atoms in a molecule as a result of rotation about a covalent bond which remains unbroken."
                                        ],
                                        "tags": [
                                            "countable",
                                            "physical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "973afde9-8bd1-4669-8e7e-886a78732c21",
                                                "sense_id": "953027d9-a211-3460-8fd1-c20fb4747f6f",
                                                "text": "The more stable conformation has the methyl group in an equatorial position , since this minimizes repulsions between axial substituents"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1002b8f7-19a8-41cc-bf60-25371d55fc64",
