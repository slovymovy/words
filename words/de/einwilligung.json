                    "sense_definition": "Zustimmung oder Einverständnis zu einer Handlung oder einem Vorhaben, das die eigene Person betrifft",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zustimmung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ohne die schriftliche <w>Einwilligung</w> der Eltern dürfen die Schüler nicht an dem Ausflug teilnehmen."
                        },
                        {
                            "text": "Der Arzt benötigt vor der Operation die ausdrückliche <w>Einwilligung</w> des Patienten."
                        }
                    ],
                    "synonyms": [
                        "Einverständnis",
                        "Erlaubnis",
                        "Zustimmung"
                    ],
                    "common_phrases": [
                        "schriftliche Einwilligung",
                        "Einwilligung der Eltern",
                        "ohne meine Einwilligung"
                    ]
                },
                {
                    "sense_id": "dcbd7b3a-204c-3d8b-8508-fc1f2c415eeb",
                    "sense_definition": "im juristischen Sinne die im Voraus erteilte Zustimmung zu einem Rechtsgeschäft",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "recht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Im Zivilrecht bezeichnet die <w>Einwilligung</w> die vorherige Zustimmung zu einem Rechtsgeschäft."
                        },
                        {
                            "text": "Wurde keine vorherige <w>Einwilligung</w> erteilt, kann das Geschäft nachträglich genehmigt werden."
                        }
                    ],
                    "synonyms": [
                        "Zustimmung"
                    ],
                    "antonyms": [
