                "senses": [
                    {
                        "sense_id": "a2c4fa0b-2dec-31ef-b6af-cd42912e9c7f",
                        "entry_id": "2847247a-451c-3639-8da9-d6c7888ad50b",
                        "glosses": [
                            "Relatif à la Lydie, ses habitants et leur culture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee215e49-4c58-414f-97ff-58672dba52c2",
                                "sense_id": "a2c4fa0b-2dec-31ef-b6af-cd42912e9c7f",
                                "text": "Selon Homère, le nom des Lydiens vient de Lydos, fils d'Attis. Après la chute de la Phrygie, ils repoussent les Cimmériens au VIᵉ siècle av. J.-C. C'est le début de l'empire lydien, qui culmine avec le règne de Crésus."
                            }
                        ]
                    },
                    {
                        "sense_id": "012a174b-d747-3137-ae28-42d3fdd2866d",
                        "entry_id": "2847247a-451c-3639-8da9-d6c7888ad50b",
                        "glosses": [
                            "Qui concerne le quatrième mode issu de la gamme grégorienne. Qualifie le ton aigu (ton des lamentations) de la musique grecque ancienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "119aad9b-ba97-4159-9032-5e8a26cfb732",
                                "sense_id": "012a174b-d747-3137-ae28-42d3fdd2866d",
                                "text": "Mode lydien."
                            },
                            {
                                "example_id": "0b16cbc4-869d-466e-9306-7838bf38e003",
                                "sense_id": "012a174b-d747-3137-ae28-42d3fdd2866d",
                                "text": "[Beethoven] sut ouvrir à la Variation une voie nouvelle qui se révèle à nous (…) dans le sublime Adagio, en « mode lydien », du XVᵉ [Quatuor], op. 132."
                            }
                        ]
                    }
                ],
