                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5bd70c0-f485-4079-a1f5-3c4ad9654951",
                                "sense_id": "5ab46278-85f2-3b3e-96fa-a9dd45ac22a4",
                                "text": "„Da saß er im Schneidersitz im Sand, keine drei Meter entfernt, nippte ein Bier und unterhielt sich anscheinend ganz vernünftig mit so einem Trekkie Nerd.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0258663d-cf93-4dd5-a0a9-719cb93cf548",
