                "senses": [
                    {
                        "sense_id": "16ae12dd-b208-3777-b093-48b4e39ca3d8",
                        "entry_id": "211d3f16-8349-3c7a-a797-7a6034d9189d",
                        "glosses": [
                            "Zelle, in der Betrunkene ihren Rausch ausschlafen können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15fdafc4-80d9-4a66-a8ca-31dbb3599016",
                                "sense_id": "16ae12dd-b208-3777-b093-48b4e39ca3d8",
                                "text": "„Vor dem Revier kneifen Betrunkene, die die Nacht in den Ausnüchterungszellen verbracht haben, die Augen gegen die strahlende Sonne zu.“"
                            },
                            {
                                "example_id": "c2ffad52-db39-448e-8e26-f629fe0470f1",
                                "sense_id": "16ae12dd-b208-3777-b093-48b4e39ca3d8",
                                "text": "„›Und Carroll hatte Berichte aus drei Bundesstaaten über Dulanges Verbleib zwischen dem 10. und 17. Januar - Ausnüchterungszellen, Krankenhäuser, Polizeireviere.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
