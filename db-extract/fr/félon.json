                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "felonious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e9ed2b9-5b5e-3241-9ba3-42410aaab5c4",
                                        "entry_id": "2a40c5bc-5225-36c5-88b0-f1b36eef4f22",
                                        "glosses": [
                                            "Of, relating to, being, or having the quality of felony."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9374ba80-f5da-4723-bea5-125886ac064e",
                                                "sense_id": "9e9ed2b9-5b5e-3241-9ba3-42410aaab5c4",
                                                "text": "The defendant must show that any bail money he hopes to post did not come from the felonious means."
                                            },
                                            {
                                                "example_id": "68ff2214-925c-4e01-ada2-4d9fbafe24a0",
                                                "sense_id": "9e9ed2b9-5b5e-3241-9ba3-42410aaab5c4",
                                                "text": "O thievish Night, / Why should'st thou, but for some felonious end, / In thy dark lantern thus close up the stars?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89739d2e-0161-349f-ad33-02d0db13aba8",
                                        "entry_id": "2a40c5bc-5225-36c5-88b0-f1b36eef4f22",
                                        "glosses": [
                                            "Done with intent to commit a crime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30583049-2735-4b6a-af90-b8d03d1c1d70",
                                                "sense_id": "89739d2e-0161-349f-ad33-02d0db13aba8",
                                                "text": "felonious homicide"
                                            },
                                            {
                                                "example_id": "05ad4dab-1fac-407b-8512-4ebeb76d945f",
                                                "sense_id": "89739d2e-0161-349f-ad33-02d0db13aba8",
                                                "text": "First, as felony prosecutor, I prosecute high-level felonies including homicides; sexual assaults; child endangerings; shootings and other felonious assaults; and media cases."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
