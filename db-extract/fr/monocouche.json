                        "entry_id": "c7ed69cf-a225-38c1-8e8d-7f13cdfb2219",
                        "glosses": [
                            "Qui est constitué d’une seule couche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f6581d2-8ef9-43bb-aaa7-780262398818",
                                "sense_id": "881e3d9a-ff0c-38dd-b8c8-b3bbae0fffb3",
                                "text": "Membranes monocouches sélectives aux ions."
                            },
                            {
                                "example_id": "4749c01d-584c-48e2-9784-cf47aed7d0e4",
                                "sense_id": "881e3d9a-ff0c-38dd-b8c8-b3bbae0fffb3",
                                "text": "L'enduit monocouche à double gravillonnage, qui comporte une couche de liant et deux couches de granulats, la seconde étant de classe granulaire inférieure à celle de la première."
                            }
                        ]
                    }
