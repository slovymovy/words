                        "sense_id": "61f9259c-dcd7-3eb0-a46e-50f7b49bc3d2",
                        "entry_id": "68d0e9e0-5e56-3512-84e9-06eb61b47215",
                        "glosses": [
                            "szkodliwy duch domowy przybierający postać maleńkiej kobiety, czasem niewidzialny"
                        ],
                        "tags": [
                            "Slavic"
                        ],
                        "examples": [
                            {
                                "example_id": "2d99ff58-62ca-4fd2-80b6-8926143ddfc2",
                                "sense_id": "61f9259c-dcd7-3eb0-a46e-50f7b49bc3d2",
                                "text": "Aby ochronić się przed kikimorą, wystarczyło położyć się odwrotnie na łóżku (nogi na zagłówek, głowa tam, gdzie nogi) lub skrzyżować nogi podczas snu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
