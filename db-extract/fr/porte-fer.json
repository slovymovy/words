                    {
                        "translation_id": "dd2c1f3b-9177-4101-8feb-8b3044ddff7e",
                        "source_entry_id": "5d7ab08d-0505-3772-ad9b-721d961f6a6b",
                        "source_sense_id": "c5d5b159-ab2e-3e2b-82ca-5027c8b492b6",
