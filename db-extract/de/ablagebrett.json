                ],
                "senses": [
                    {
                        "sense_id": "a9353d99-c1a7-3407-98cd-f451fabaa529",
                        "entry_id": "e91d9b81-dd05-36cd-b6fd-107af1235812",
                        "glosses": [
                            "längliches, breites Stück Holz zum Abstellen von Sachen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6c1b5ee-5bf8-4f00-af57-932eced04bac",
                                "sense_id": "a9353d99-c1a7-3407-98cd-f451fabaa529",
                                "text": "„Auf dem Lenker hat er ein Ablagebrett mit zwei Schalen angebracht - für Futter und Wasser.“"
                            },
                            {
                                "example_id": "e3e7ae3d-49fd-4a4e-bc91-3c285fc5d353",
                                "sense_id": "a9353d99-c1a7-3407-98cd-f451fabaa529",
                                "text": "„Es gibt einen Schreibtisch und ein Ablagebrett, auf dem er Recherchematerial und Fotos auslegt.“"
                            },
                            {
                                "example_id": "985f9f61-e3a6-4cf0-9f41-9c03438a6f91",
                                "sense_id": "a9353d99-c1a7-3407-98cd-f451fabaa529",
                                "text": "„Die Männer gehen kurz nochmal die Liste für heute durch: Unter anderem muss ein neues Bett in Garching auf- und das alte abgebaut, in einer Küche ein Ablagebrett befestigt, bei einer Dame der Herd angeschlossen werden.“"
                            },
                            {
                                "example_id": "06624560-1527-4fc6-a2f7-58f4ceea5e2f",
                                "sense_id": "a9353d99-c1a7-3407-98cd-f451fabaa529",
                                "text": "„Der wachsende Bücherbestand zwang hier und da zur Anbringung zusätzlicher Ablagebretter.“"
                            },
                            {
                                "example_id": "069d7dfb-c342-4824-8c0a-ced2a7e86977",
                                "sense_id": "a9353d99-c1a7-3407-98cd-f451fabaa529",
                                "text": "„Unterhalb dieser Haken sind aus Karraramarmor schmale Ablagebretter auf Aluminiumfüßen für die Schulsachen aufmontiert, welche mit Schirmständern aus Porzellannägeln kombiniert sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
