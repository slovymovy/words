                ],
                "translations": [
                    {
                        "translation_id": "0126c766-89ca-43af-bf97-978fa7fdff5d",
                        "source_entry_id": "51dd9028-35c6-3d46-a446-cd511eaa05c8",
                        "source_sense_id": "fc22aa88-338f-305b-9a98-23a6b13b3376",
                        "target_lang_word": "speculative",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "speculative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc0e891f-4dfb-346c-b3c7-eafbdc8a91f3",
                                        "entry_id": "6f2ee8af-7ac2-39a7-977a-0c2a730ba1e7",
                                        "glosses": [
                                            "Characterized by speculation; based on guessing, unfounded opinions, or extrapolation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8860b5b5-a930-4171-9404-7447ddc7b4a6",
                                                "sense_id": "bc0e891f-4dfb-346c-b3c7-eafbdc8a91f3",
                                                "text": "Like The Handmaid's Tale, Oryx and Crake is a speculative fiction, not a science fiction proper."
                                            },
                                            {
                                                "example_id": "59990fad-1d38-44fe-8b82-0c41687a49de",
                                                "sense_id": "bc0e891f-4dfb-346c-b3c7-eafbdc8a91f3",
                                                "text": "When not inaccurate, much commentary on the contents of Hobson-Jobson is couched in hedges or relies on speculative estimates in the absence of exact information."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccba3dbb-d54e-3b4d-ade4-f935b915b8f3",
                                        "entry_id": "6f2ee8af-7ac2-39a7-977a-0c2a730ba1e7",
                                        "glosses": [
                                            "Pursued as a gamble, with possible large profits or losses; risky."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3831429b-23ff-4f64-931c-c725f747f345",
                                                "sense_id": "ccba3dbb-d54e-3b4d-ade4-f935b915b8f3",
                                                "text": "Tranquillo Barnetta was the grateful beneficiary of uncertain England defending and poor goalkeeping from Joe Hart as he twice saw speculative free-kicks end in the back of the net in the first half."
                                            },
                                            {
                                                "example_id": "d572e1aa-7f40-40d7-bbc7-6dc4ce7b76f2",
                                                "sense_id": "ccba3dbb-d54e-3b4d-ade4-f935b915b8f3",
                                                "text": "Little seemed on when Sánchez cut in from the left and sent a speculative low shot through a crowd of players, but though Federici had it covered he could not hold on to the ball and it squirmed over the line through his legs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecd460a5-ae39-354f-9bb6-d70e97d89664",
                                        "entry_id": "6f2ee8af-7ac2-39a7-977a-0c2a730ba1e7",
                                        "glosses": [
                                            "Pertaining to financial speculation; Involving or resulting from high-risk investments or trade."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc276337-b14a-4dc4-ae0f-52ec1a63dd4d",
                                                "sense_id": "ecd460a5-ae39-354f-9bb6-d70e97d89664",
                                                "text": "\"Don't dare laugh at us!\" smiled his sister. \"I wish we were back in Tenth Street. But so many children came[…]and the Tenth Street house wasn't half big enough; and a dreadful speculative builder built this house and persuaded Austin to buy it. Oh, dear, and here we are among the rich and great; and the steel kings and copper kings and oil kings and their heirs and dauphins. Do you like the house?\""
                                            },
                                            {
                                                "example_id": "7c6f1b36-b601-442c-a24f-731138cce6c0",
                                                "sense_id": "ecd460a5-ae39-354f-9bb6-d70e97d89664",
                                                "text": "In other words, it is critical to know whether a currency is under high speculative pressure for every month in the sample."
                                            },
                                            {
                                                "example_id": "3fde59a9-2c19-4f5e-82d5-f09268fabbb4",
                                                "sense_id": "ecd460a5-ae39-354f-9bb6-d70e97d89664",
                                                "text": "It was written between 1929 and 1930 and deals with a famine caused by speculative investments of the Meat King of Chicago, Pierpont Mauler."
                                            },
                                            {
                                                "example_id": "bb2820dd-1c61-44e1-a617-87e5767774d9",
                                                "sense_id": "ecd460a5-ae39-354f-9bb6-d70e97d89664",
                                                "text": "Empirical tests of speculative bubbles, including those assessing early warning indicators in the context of financial crises, are forced to contend with other difficult measurement and inference issues."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d9c9058-cfe4-4266-971b-1c0739003c35",
                        "source_entry_id": "51dd9028-35c6-3d46-a446-cd511eaa05c8",
                        "source_sense_id": "fc22aa88-338f-305b-9a98-23a6b13b3376",
                        "target_lang_word": "spéculatif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spéculatif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3e4b03a1-83ce-3dd0-bc6e-2d1dc6e36a3e",
                                        "entry_id": "6a5d3c02-fe76-3f50-bc38-7b7643b5488c",
                                        "glosses": [
                                            "Qui s’attache à la spéculation, pensée abstraite, sans avoir la pratique pour objet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "783e4135-11b0-47d2-b751-9acacc61a5a7",
                                                "sense_id": "3e4b03a1-83ce-3dd0-bc6e-2d1dc6e36a3e",
                                                "text": "Il fit la carrière scientifique de son fils en lui permettant de se livrer, jusqu’à l’âge de plus de trente ans, à ses recherches spéculatives, sans fonction, ni concours, ni école, ni travail rémunérateur."
                                            },
                                            {
                                                "example_id": "ad11b9ab-b4fc-4fb9-934a-0d652f7065fb",
                                                "sense_id": "3e4b03a1-83ce-3dd0-bc6e-2d1dc6e36a3e",
                                                "text": "Mais au fur et à mesure que les inductions spéculatives deviennent plus sincères, la forme narrative se fait plus incommode."
                                            },
                                            {
                                                "example_id": "c1d77c12-e0cd-4861-bc74-af538c711e4e",
                                                "sense_id": "3e4b03a1-83ce-3dd0-bc6e-2d1dc6e36a3e",
                                                "text": "De façon spéculative, nous pourrions conclure que les conspirationnistes accordent une grande valeur aux réponses qui correspondent à leurs espoirs, à leurs convictions ou à leurs préjugés."
                                            },
                                            {
                                                "example_id": "4b75ebb0-fee2-422e-b7bf-5513e32d8609",
                                                "sense_id": "3e4b03a1-83ce-3dd0-bc6e-2d1dc6e36a3e",
                                                "text": "Elena était un vrai enfant qui n’avait pas une tournure d’esprit spéculative."
                                            },
                                            {
                                                "example_id": "e073bf83-eae9-4b8f-8602-0ec63d9c2bd5",
                                                "sense_id": "3e4b03a1-83ce-3dd0-bc6e-2d1dc6e36a3e",
                                                "text": "Lorsqu'un savant annonce au public une découverte purement spéculative, il ne saurait agir avec assez de prudence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d25b21be-45a9-3fc2-9f5f-6a4d710304be",
                                        "entry_id": "6a5d3c02-fe76-3f50-bc38-7b7643b5488c",
                                        "glosses": [
                                            "En rapport avec les opérations financières d’achat et de vente de produits financiers pour tirer profit des variations des cours du marché."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac8cb289-f7d4-4723-a34a-ff3b014d65b3",
                                                "sense_id": "d25b21be-45a9-3fc2-9f5f-6a4d710304be",
                                                "text": "Je me devais par contrat de donner chaque mois à Stolfzer quinze dessins, eaux-fortes ou peintures que celui-ci gardait pour la plupart dans ses greniers dans un but spéculatif."
                                            },
                                            {
                                                "example_id": "ea3a2613-d9b9-4193-8ede-505870232992",
                                                "sense_id": "d25b21be-45a9-3fc2-9f5f-6a4d710304be",
                                                "text": "Une bulle est alimentée par des comportements spéculatifs : lorsque des agents économiques anticipent, de manière exagérément optimiste, que les prix de certains actifs vont continuer d’augmenter, ils investissent dans ces actifs dans l’espoir de les revendre plus cher et de réaliser un profit."
                                            },
                                            {
                                                "example_id": "c25c10e0-543f-4fde-a38e-5d9b86b42325",
                                                "sense_id": "d25b21be-45a9-3fc2-9f5f-6a4d710304be",
                                                "text": "On parle de bulle spéculative lorsque le prix d’un actif, par exemple l’immobilier ou les actions, augmente de manière excessive, au-delà de sa valeur intrinsèque (valeur qui, il faut le noter, est difficilement mesurable avec certitude)."
                                            },
                                            {
                                                "example_id": "c2de22c0-f117-4082-b951-3afd41b22cea",
                                                "sense_id": "d25b21be-45a9-3fc2-9f5f-6a4d710304be",
                                                "text": "La reine des cryptomonnaies est récemment devenue un produit d'épargne comme les autres. Une onction difficilement compréhensible qui doit davantage à son attrait spéculatif qu'à sa valeur réelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "828976f5-92d5-3446-86af-b3a91dce0d11",
                                        "entry_id": "6a5d3c02-fe76-3f50-bc38-7b7643b5488c",
                                        "glosses": [
                                            "Lié à l’investissement personnel destiné à profiter d’une situation."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "spéculatif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7780cae2-5eb8-334b-be5d-0d305449b9ec",
                                        "entry_id": "d0d1958b-bc43-373e-b4f6-86aed10ca656",
                                        "glosses": [
                                            "Personne qui spécule intellectuellement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
