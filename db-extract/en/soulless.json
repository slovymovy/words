                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b97fa30c-5200-3d85-9ae7-3fcf34e2ea9c",
                                        "entry_id": "c92596d8-0f62-3e7e-8087-d8551b992d48",
                                        "glosses": [
                                            "ohne Seele, keine warmen und positiven Gefühle ausstrahlend; trostlos und wenig einladend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8923f4ac-c28b-468d-9158-32e505cbaef7",
                                                "sense_id": "b97fa30c-5200-3d85-9ae7-3fcf34e2ea9c",
                                                "text": "„Etliche Auswanderer berichten über eine drückende, seelenlose Atmosphäre bei der Abfertigung und über die Freude, endlich das Schiff besteigen zu dürfen.“"
                                            },
                                            {
                                                "example_id": "3d8ac6d4-bffb-4795-bc04-3ed715398c99",
                                                "sense_id": "b97fa30c-5200-3d85-9ae7-3fcf34e2ea9c",
                                                "text": "„Dies war der sauberste, seelenloseste Raum, den Clemmie jemals gesehen hatte. Sie hätte ihren letzten Penny darauf gewettet, dass noch nie jemand vor dem eleganten, aber wenig einladenden Marmorkamin gesessen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
