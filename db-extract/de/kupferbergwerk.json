                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b58e0c3-ac1a-4a04-8fe2-38d590237d84",
                                "sense_id": "611a79ad-6e43-3c74-8144-f5144b091eef",
                                "text": "Wegen unerfüllbarer Umweltschutzauflagen wurde das Kupferbergwerk geschlossen."
                            },
                            {
                                "example_id": "57524dbe-6648-43c7-9b56-ea792a4fcc7f",
                                "sense_id": "611a79ad-6e43-3c74-8144-f5144b091eef",
                                "text": "„Das Gold aber sieht man nicht. Etwa vier Gramm pro Tonne gibt es hier, im Kupferbergwerk Larzenbach.“"
                            }
                        ],
