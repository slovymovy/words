                ],
                "senses": [
                    {
                        "sense_id": "37e0aebc-74df-3b0d-a7bd-3b35292efaae",
                        "entry_id": "5d5f7aae-903e-3c72-b84b-ab818cb77ce4",
                        "glosses": [
                            "Relatif au tifinagh."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a1c8a63-881a-4e51-8c97-19992bd509e9",
                                "sense_id": "37e0aebc-74df-3b0d-a7bd-3b35292efaae",
                                "text": "Un alphabet utilisant les caractères tifinagh est encore en usage de nos jours chez les Touareg, dans la vie quotidienne et la correspondance, alors que la culture et la littérature sont orales."
                            },
                            {
                                "example_id": "381162ae-6c0b-4306-a70b-a3b479e4ecfb",
                                "sense_id": "37e0aebc-74df-3b0d-a7bd-3b35292efaae",
                                "text": "L’alphabet libyque, préfigurant les actuels caractères tifinaghs, n’apparaît probablement pas au Sahara avant les Vᵉ-VIᵉ siècles avant J.-C."
                            },
                            {
                                "example_id": "eaf2527a-174d-4f22-9979-c21f0f151eb2",
                                "sense_id": "37e0aebc-74df-3b0d-a7bd-3b35292efaae",
                                "text": "Ces couleurs, cette figure du Z en alphabet tifinagh, je les reconnais. Elles dorment au creux des vieilles couvertures gafsiennes de mes grands-parents à présent disparus."
                            }
                        ]
                    }
                ],
