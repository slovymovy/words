                            {
                                "example_id": "aee9c9e4-a062-44e8-b58c-f856921a0fa2",
                                "sense_id": "3b71d258-e2f0-3d27-84c2-bbb234efdb3f",
                                "text": "Oto atmosfera poczdamska jest świadomie na wskroś odmienna, niż berlińska. Poczdamczycy dumni są z tego, że nie przyczepiła się do nich choroba berlińskich czułostek humanitarnych"
                            }
                        ],
