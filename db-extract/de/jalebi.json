                "senses": [
                    {
                        "sense_id": "2a9b22f1-e4b5-366e-8a6a-f785cdf9abb9",
                        "entry_id": "66a696d6-8e33-3726-87df-1c7dd8cac830",
                        "glosses": [
                            "Dessert, bestehend aus frittierten Weizenmehlkringeln, die mit Zuckersirup getränkt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b7112cd-34f7-4f74-96e3-969d7e11d676",
                                "sense_id": "2a9b22f1-e4b5-366e-8a6a-f785cdf9abb9",
                                "text": "„Sartaj dachte voll Ehrfurcht daran, wieviel dieser riesenhafte Sardar gegessen hatte, Brathuhn zum Frühstück, mittags ein fettes Lammcurry und danach frische Jalebis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "80802ef9-06d7-4688-b66b-aa654c7e1a83",
                        "source_entry_id": "66a696d6-8e33-3726-87df-1c7dd8cac830",
                        "source_sense_id": "2a9b22f1-e4b5-366e-8a6a-f785cdf9abb9",
                        "source_sense_description": "frittierte Weizenmehlkringel",
                        "target_lang_word": "jalebi",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jalebi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62bfa16e-d7f1-3ad8-8a13-9b5d28d588fc",
                                        "entry_id": "6d6aab08-29de-3e2f-90a7-62c0fc5b4ece",
                                        "glosses": [
                                            "A sweet popular in the Indian subcontinent, made by deep-frying a maida flour batter and soaking it in sugar syrup."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df894613-f536-46d9-938c-654ad9676f4d",
                                                "sense_id": "62bfa16e-d7f1-3ad8-8a13-9b5d28d588fc",
                                                "text": "You will not believe how quickly jalebis can be made. I have used yeast to ferment the jalebi batter quickly and so it does not require to be left for a day to ferment. The trick here is to immediately start frying the jalebis once the batter has rested for 10 minutes."
                                            },
                                            {
                                                "example_id": "291d3574-05f6-4492-aba9-b28c6d0971bb",
                                                "sense_id": "62bfa16e-d7f1-3ad8-8a13-9b5d28d588fc",
                                                "text": "On the way he saw a sweetmeat seller making jalebis (spiral sweet). He was tempted. In his mind he thought he'd have some jalebis."
                                            },
                                            {
                                                "example_id": "249aa630-15bf-464b-a59d-2beeab370942",
                                                "sense_id": "62bfa16e-d7f1-3ad8-8a13-9b5d28d588fc",
                                                "text": "But Bhole refused to listen. He became very angry and started to scream, “I want jalebis! Give me jalebis! I want them now!”"
                                            },
                                            {
                                                "example_id": "8a0b8ae5-00bf-4bf6-b904-136ca190a2cc",
                                                "sense_id": "62bfa16e-d7f1-3ad8-8a13-9b5d28d588fc",
                                                "text": "Mr. Alam and his staff often insist that visitors enjoy a free treat like chocolate barfi, condensed milk mixed with chocolate, or jalebis, deep fried rice flour coated in a sugary syrup, while they shop. “I want my customers to feel welcome and offering mithai is a way to show hospitality,” Mr. Alam said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
