                "senses": [
                    {
                        "sense_id": "ea9cb873-e0be-3cb9-8e2a-6d578b4b9fb8",
                        "entry_id": "08ef1820-e329-3d59-aa65-f56aea11dd5c",
                        "glosses": [
                            "verteren van voedsel in het spijsverteringskanaal"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "cd7ad7df-11d6-3a6e-9e44-8918c0fcfc24",
                        "entry_id": "08ef1820-e329-3d59-aa65-f56aea11dd5c",
                        "glosses": [
                            "geestelijk verdragen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "66e38dd2-e638-41b3-a664-434be40ce947",
                                "sense_id": "cd7ad7df-11d6-3a6e-9e44-8918c0fcfc24",
                                "text": "Als hij Hoofts ”Nederlandse Historiën” gelezen heeft -dat krijgt hij binnen een week voor elkaar- schrijft hij dat het hem toch niet lukt om „alles te verduwen (…) wat ik zo gezwind heb ingezwolgen. Veel immers laat een pijnlijk brandend gevoel na, voornamelijk wat op de overtuiging en de dienst van God ziet.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "300b43e5-201c-4e99-9cc8-66b16ab72288",
                        "source_entry_id": "08ef1820-e329-3d59-aa65-f56aea11dd5c",
                        "source_sense_id": "ea9cb873-e0be-3cb9-8e2a-6d578b4b9fb8",
                        "source_sense_description": "verteren van voedsel in het spijsverteringskanaal",
                        "target_lang_word": "digest",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "digest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f80db556-fef0-3d2e-900e-fb7bf8a93b39",
                                        "entry_id": "dc576e1f-9f3c-32dc-af3f-81711398bb1e",
                                        "glosses": [
                                            "To distribute or arrange methodically; to work over and classify; to reduce to portions for ready use or application."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1a0636a-a4ab-4708-8f4b-d710e77d8f59",
                                                "sense_id": "f80db556-fef0-3d2e-900e-fb7bf8a93b39",
                                                "text": "We have cause to be glad that matters are so well digested."
                                            },
                                            {
                                                "example_id": "f49ed5a4-50b5-4d1e-8aa4-012e3507c78c",
                                                "sense_id": "f80db556-fef0-3d2e-900e-fb7bf8a93b39",
                                                "text": "to digest laws"
                                            },
                                            {
                                                "example_id": "564e5204-75bb-4c4d-9085-9a16bed64833",
                                                "sense_id": "f80db556-fef0-3d2e-900e-fb7bf8a93b39",
                                                "text": "joining them together and digesting them into order"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "291f11a8-7f8b-342b-b2fb-0644b671cd35",
                                        "entry_id": "dc576e1f-9f3c-32dc-af3f-81711398bb1e",
                                        "glosses": [
                                            "To separate (the food) in its passage through the alimentary canal into the nutritive and nonnutritive elements; to prepare, by the action of the digestive juices, for conversion into blood; to convert into chyme."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6ac4d3ce-2456-3b83-9874-b2c7d9e00ef2",
                                        "entry_id": "dc576e1f-9f3c-32dc-af3f-81711398bb1e",
                                        "glosses": [
                                            "To think over and arrange methodically in the mind; to reduce to a plan or method; to receive in the mind and consider carefully; to get an understanding of; to comprehend."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ef38d6a-0c82-454b-b796-458482d78dd8",
                                                "sense_id": "6ac4d3ce-2456-3b83-9874-b2c7d9e00ef2",
                                                "text": "Feelingly digest the words you speak in prayer."
                                            },
                                            {
                                                "example_id": "e5639e21-b726-4218-a53c-f28157135c2e",
                                                "sense_id": "6ac4d3ce-2456-3b83-9874-b2c7d9e00ef2",
                                                "text": "How shall this bosom multiplied digest / The senate's courtesy?"
                                            },
                                            {
                                                "example_id": "f024c0f0-699a-47cb-8ded-657fb343773f",
                                                "sense_id": "6ac4d3ce-2456-3b83-9874-b2c7d9e00ef2",
                                                "text": "Grant that we may in such wise hear them [the Scriptures], read, mark, learn, and inwardly digest them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55825388-332f-36b9-bf94-5ad37ace6e7b",
                                        "entry_id": "dc576e1f-9f3c-32dc-af3f-81711398bb1e",
                                        "glosses": [
                                            "To bear comfortably or patiently; to be reconciled to; to brook."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8647daa3-5391-4d13-88a2-f894379166a9",
                                                "sense_id": "55825388-332f-36b9-bf94-5ad37ace6e7b",
                                                "text": "I never can digest the loss of most of Origen's works."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94297d6a-722c-3adc-a8f4-53147bd68b64",
                                        "entry_id": "dc576e1f-9f3c-32dc-af3f-81711398bb1e",
                                        "glosses": [
                                            "To expose to a gentle heat in a boiler or matrass, as a preparation for chemical operations."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "869ef890-ba9e-379c-9675-a9f15719061a",
                                        "entry_id": "dc576e1f-9f3c-32dc-af3f-81711398bb1e",
                                        "glosses": [
                                            "To undergo digestion."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd69aba6-b718-4091-8236-09e931ae8862",
                                                "sense_id": "869ef890-ba9e-379c-9675-a9f15719061a",
                                                "text": "I just ate an omelette and I'm waiting for it to digest."
                                            },
                                            {
                                                "example_id": "d1382cee-88b8-491a-a9de-390bf4c92cda",
                                                "sense_id": "869ef890-ba9e-379c-9675-a9f15719061a",
                                                "text": "I was at the Mathematical School, where the Maſter taught his Pupils after a Method ſcarce imaginable to us in Europe. The Propoſition and Demonſtration were fairly written on a thin Wafer, with Ink compoſed of a Cephalick Tincture. This the Student was to ſwallow upon a faſting Stomach, and for three days following eat nothing but Bread and Water. As the Wafer digeſted, the Tincture mounted to his Brain, bearing the Propoſition along with it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35b42c74-82fb-3078-99d2-6d2bcf1b520b",
                                        "entry_id": "dc576e1f-9f3c-32dc-af3f-81711398bb1e",
                                        "glosses": [
                                            "To suppurate; to generate pus, as an ulcer."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfae7000-3a06-4c47-b157-f2557c6c6a60",
                                                "sense_id": "35b42c74-82fb-3078-99d2-6d2bcf1b520b",
                                                "text": "The Lips of the Abſceſs digeſted vvell, but from vvithin it onely gleeted, and thruſt out Fat, vvhich vve daily cut off vvithout the loſs of a drop of blood, and dreſſed up the Abſceſs vvith mundif. ex apio, continuing the uſe of diſcutient Fomentations and Cataplaſins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ecaa537-4dc7-30a8-80fa-2ff4caa4e44d",
                                        "entry_id": "dc576e1f-9f3c-32dc-af3f-81711398bb1e",
                                        "glosses": [
                                            "To cause to suppurate, or generate pus, as an ulcer or wound."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4d38f870-e222-3aa6-bf4f-28ee343e7d34",
                                        "entry_id": "dc576e1f-9f3c-32dc-af3f-81711398bb1e",
                                        "glosses": [
                                            "To ripen; to mature."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b16c5de6-f0a4-49ca-87a5-8e30179488f6",
                                                "sense_id": "4d38f870-e222-3aa6-bf4f-28ee343e7d34",
                                                "text": "well-digested fruits"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8d12b75-9904-3e3d-a9e7-802081d4d118",
                                        "entry_id": "dc576e1f-9f3c-32dc-af3f-81711398bb1e",
                                        "glosses": [
                                            "To quieten or reduce (a negative feeling, such as anger or grief)."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "digest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a815af1c-54ee-3bca-b17c-2350d6668304",
                                        "entry_id": "d5afa807-9e4b-3183-8c85-9017befe006d",
                                        "glosses": [
                                            "That which is digested; especially, that which is worked over, classified, and arranged under proper heads or titles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "790dc2f0-8985-4d78-87f7-d84dcc6aa4f5",
                                                "sense_id": "a815af1c-54ee-3bca-b17c-2350d6668304",
                                                "text": "By also relating the tales included in the anthology to various facts of that development, he leaves no doubt that this volume constitutes a veritable digest of the remarkable strides made by the genre in recent years."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ec87b25-acde-38ae-9a99-c6d9d3bc59cc",
                                        "entry_id": "d5afa807-9e4b-3183-8c85-9017befe006d",
                                        "glosses": [
                                            "A compilation of statutes or decisions analytically arranged; a summary of laws."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7685df3a-ae57-490b-b6df-6d70df7dd4f4",
                                                "sense_id": "1ec87b25-acde-38ae-9a99-c6d9d3bc59cc",
                                                "text": "Comyn's Digest"
                                            },
                                            {
                                                "example_id": "69c60bc8-5dde-4340-91e2-2a02c6d06313",
                                                "sense_id": "1ec87b25-acde-38ae-9a99-c6d9d3bc59cc",
                                                "text": "the United States Digest"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fae06d2-ed85-3fd3-b780-381acada019c",
                                        "entry_id": "d5afa807-9e4b-3183-8c85-9017befe006d",
                                        "glosses": [
                                            "Any collection of articles, as an Internet mailing list including a week's postings, or a magazine arranging a collection of writings."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4127dca4-0bb2-4789-8565-16c230a873cd",
                                                "sense_id": "0fae06d2-ed85-3fd3-b780-381acada019c",
                                                "text": "Reader's Digest is published monthly."
                                            },
                                            {
                                                "example_id": "b7e0012f-1373-4e50-b341-46e6721b5385",
                                                "sense_id": "0fae06d2-ed85-3fd3-b780-381acada019c",
                                                "text": "The weekly email digest contains all the messages exchanged during the past week."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ac19695-d49e-3235-b00e-6e1f82f9aa5b",
                                        "entry_id": "d5afa807-9e4b-3183-8c85-9017befe006d",
