                    {
                        "translation_id": "dade7fb8-479c-4636-b99c-2bb5761cbe7f",
                        "source_entry_id": "6cc20a13-7661-3d2b-8ed6-04e594df46a5",
                        "source_sense_id": "b9d6a00c-136d-3cea-8e49-2bf865d305fe",
                        "source_sense_description": "Nordamerika: ein Gebäck",
                        "target_lang_word": "Gebäck",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gebäck",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "728bdc90-6785-3356-8482-18a8cd831a82",
                                        "entry_id": "a0e334f1-cbd6-3798-8f38-0f507e322fbe",
                                        "glosses": [
                                            "Speise auf Mehlbasis, welche auf einem Backblech oder in einer Form in einem Ofen oder in Fett in einer Pfanne eine ausreichend lange Zeit ausgebacken wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cea96b6e-b556-48af-96f2-a34d6b177add",
                                                "sense_id": "728bdc90-6785-3356-8482-18a8cd831a82",
                                                "text": "„Ach, wenn meine Gattin aufwacht, nimmt sie gern eine Tasse Tee mit etwas Gebäck.“ (Loriot)"
                                            },
                                            {
                                                "example_id": "e321bece-d9ee-4ec1-9251-bef85c87d686",
                                                "sense_id": "728bdc90-6785-3356-8482-18a8cd831a82",
                                                "text": "„Der Verein für Konsumenteninformation hat rechtzeitig zur Krapfen-Hochsaison das beliebte Gebäck unter die Lupe genommen. 13 Faschingskrapfen in der gängigsten Variante, also mit Füllung aus Marillenmarmelade, wurden untersucht.“"
                                            },
                                            {
                                                "example_id": "ca7c4605-01d7-4e2d-a2bb-7d7429935734",
                                                "sense_id": "728bdc90-6785-3356-8482-18a8cd831a82",
                                                "text": "„Die Pizza ist doch ein sonderbares Gebäck.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb39adb1-14d5-4706-8f02-c19a8b27fc52",
                        "source_entry_id": "6cc20a13-7661-3d2b-8ed6-04e594df46a5",
                        "source_sense_id": "8f5689da-70fe-3775-bb9b-693230fd0bb0",
                        "source_sense_description": "ein mit Konfitüre gefülltes, rundes (in Fett ausgebackenes) Hefegebäck",
                        "target_lang_word": "Berliner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Berliner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "43ec62a0-28b1-330f-99fd-1ac828466364",
                                        "entry_id": "17c96d90-91cc-3706-8a66-02bd31e554c7",
                                        "glosses": [
                                            "Einwohner, Bewohner der Stadt Berlin, eine in Berlin geborene Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fab9ae58-9b57-42c1-8ea3-be25047aa933",
                                                "sense_id": "43ec62a0-28b1-330f-99fd-1ac828466364",
                                                "text": "Er ist gebürtiger Berliner."
                                            },
                                            {
                                                "example_id": "0511bc26-2611-4548-89e7-894911dc2959",
                                                "sense_id": "43ec62a0-28b1-330f-99fd-1ac828466364",
                                                "text": "„Sonderbarerweise sind sehr wenig Berliner hier, meist Hamburger, Bremenser, Mecklenburger, Anhaltiner, und Sachsen. Ich bin sehr zufrieden damit; der Durchschnitts-Berliner ist unausstehlich und doppelt auf Reisen; er ist immer laut, eitel und zudringlich, nicht mir seiner Person, aber durch seine Manieren. ([Anmerkung: Theodor Fontane,] An Frau Emilie, Thale, 1877)“"
                                            },
                                            {
                                                "example_id": "8fa4d35b-4667-4d6e-b9d1-8188fb80f928",
                                                "sense_id": "43ec62a0-28b1-330f-99fd-1ac828466364",
                                                "text": "„Ich kannte einen Bühnenarbeiter, der einmal von einem Berliner beim Militär betrogen worden war und seitdem jeden Berliner und jede Berlinerin wie persönliche Feinde behandelte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Berliner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "016cd99a-5b0b-3f04-be27-25c542b9b238",
                                        "entry_id": "a6382c4b-02bd-3632-97f9-10310b838dca",
                                        "glosses": [
                                            "Berliner Pfannkuchen; ein in Fett ausgebackenes, mit Zuckerguss, Zucker oder Puderzucker bestreutes und mit Marmelade oder Konfitüre gefülltes, rundes Hefegebäck"
                                        ],
                                        "tags": [
                                            "South-German",
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35c4cef0-bc30-4be5-b68f-5e1de0b4d442",
                                                "sense_id": "016cd99a-5b0b-3f04-be27-25c542b9b238",
                                                "text": "Der geborene Berliner sagt „Pfannkuchen“ zum gebackenen Berliner."
                                            },
                                            {
                                                "example_id": "1b002611-d618-4d40-9ac6-5ecfb40da374",
                                                "sense_id": "016cd99a-5b0b-3f04-be27-25c542b9b238",
                                                "text": "„Rund 200.000 deutsche Haushalte essen an Silvester Krapfen, Berliner oder auch Kräppel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Berliner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8af3c955-f8ac-306c-b84d-23649d26b985",
