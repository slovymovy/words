    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c60712ed-ebd9-3813-b9a1-ae35b6f3068b",
                    "sense_definition": "Organisme ou assemblée qui dispose d'un pouvoir de décision, de contrôle ou de concertation.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "institution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le projet a été validé à l'unanimité par les <w>instances</w> dirigeantes de l'entreprise."
                        },
                        {
                            "text": "Cette commission consultative constitue une <w>instance</w> essentielle pour le dialogue social."
                        }
                    ],
                    "synonyms": [
                        "autorité",
                        "organe",
                        "organisme"
                    ],
                    "common_phrases": [
                        "instances dirigeantes",
                        "instance de décision",
                        "instances représentatives"
                    ]
                },
                {
                    "sense_id": "2d46ab8f-c7b8-34de-b9b7-3ff2bb5f408d",
                    "sense_definition": "Suite d'actes d'une procédure judiciaire engagée devant un tribunal jusqu'au jugement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jugement rendu en première <w>instance</w> a été confirmé par la cour d'appel."
                        },
                        {
                            "text": "Le dossier de succession est toujours en <w>instance</w> devant le tribunal civil."
                        }
                    ],
                    "synonyms": [
                        "litige",
                        "procédure",
                        "procès"
                    ],
                    "common_phrases": [
                        "première instance",
                        "en instance de divorce"
                    ]
                },
                {
                    "sense_id": "0a8d8984-dafe-3015-a4ca-31627e805ead",
