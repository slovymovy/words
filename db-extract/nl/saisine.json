    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [],
        "ru-extract.jsonl": [],
        "nl-extract.jsonl": [
            {
                "entry_id": "ee69c1e3-2ec8-38fc-b4d5-4c776ff4971e",
                "word": "saisine",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f2841d9f-d74c-3f63-9c5e-6f3b420c1554",
                        "entry_id": "ee69c1e3-2ec8-38fc-b4d5-4c776ff4971e",
                        "glosses": [
                            "onmiddellijke overgang van een onverdeelde nalatenschap onder algemene titel na overlijden van de erflater aan de erfgenamen, waarna zij de erflater opvolgen in zijn vererfbare rechten en verplichtingen en in zijn bezit en houderschap"
                        ],
                        "tags": [
                            "erfrecht"
                        ],
                        "examples": [
                            {
                                "example_id": "33695223-d5f3-4a38-ae94-94f30270c6a5",
                                "sense_id": "f2841d9f-d74c-3f63-9c5e-6f3b420c1554",
                                "text": "En als een erfgenaam – goed bedoeld – ‘te veel’ regelt of al wat spullen meeneemt uit de boedel, dan moet hij uit eigen middelen bijdragen aan de schulden van de erflater als de boedel negatief blijkt te zijn. Dit is een belangrijk erfrechtelijk uitgangspunt: de saisine."
                            },
                            {
                                "example_id": "d05ad548-0d93-431b-b27f-4da830d0377e",
                                "sense_id": "f2841d9f-d74c-3f63-9c5e-6f3b420c1554",
                                "text": "De saisine is één van de kernwaarden en kernbeginselen van ons erfrecht. Iedere practicus in de familiepraktijk zal dit beamen. De regel dat de erfgenamen in beginsel de positie van de erflater ‘voortzetten’, hoort zowat tot de eerste lessen van iedere cursus erfrecht."
                            }
                        ]
                    },
                    {
                        "sense_id": "5567c0f3-55aa-3caf-97e1-901599033744",
                        "entry_id": "ee69c1e3-2ec8-38fc-b4d5-4c776ff4971e",
                        "glosses": [
                            "inroeping van de bevoegdheid van de rechter of rechtbank"
                        ],
                        "tags": [
                            "procesrecht"
                        ],
                        "examples": [
                            {
                                "example_id": "49a4cdfd-21bc-4def-83d0-8be8b9807961",
                                "sense_id": "5567c0f3-55aa-3caf-97e1-901599033744",
                                "text": "De Fransen doen alles wat we willen dus ik hoef de saisine van het Hof niet door te zetten. Dat kunnen de Fransen gezien hun voorzitterschap niet gebruiken."
                            }
                        ]
                    },
                    {
                        "sense_id": "3829d8de-455c-3de0-86e2-ee113837ca8f",
                        "entry_id": "ee69c1e3-2ec8-38fc-b4d5-4c776ff4971e",
                        "glosses": [
                            "recht op de heerschappij (beheer, genot of bewoning) over goederen, ambten en mensen (onvrije dienaren) die wel of niet aan een ander toebehoren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a726bc62-54de-45dd-83c8-70ad2ed58246",
                                "sense_id": "3829d8de-455c-3de0-86e2-ee113837ca8f",
                                "text": "⧖ Bij den overgang van „roturier” land betaalde de tijnsman een zeker bedrag. Daarvoor vergunde hem de leen- en grondheer dan de „saisine”, d.i. het volledig bezitrecht. In werkelijkheid is hier slechts sprake van een investituur (Verlei) een bevestiging van het reeds bestaande recht, een erkenning der van elders aanwezige saisine, een soort van kwitantie der honorifieke en fiscale verplichtingen, die den titel zelf onbeoordeeld liet."
                            },
                            {
                                "example_id": "8a144270-3a1f-46b4-9cb7-13ba1e751ac5",
                                "sense_id": "3829d8de-455c-3de0-86e2-ee113837ca8f",
                                "text": "⧖ In zijn tweede deel behandelt de heer L. de Nederlandsche bezitactiën, en begint daarbij met een geschiedkundig overzigt [sic!] te geven van de wijze, waarop zich in de latere middeleeuwen uit de gewere of saisine eene eigenaardige bezitactie ontwikkeld heeft, die, onder den naam van complainte in Frankrijk ontstaan, naderhand ook in ons vaderland werd overgenomen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba354c1b-6590-4ae4-a543-70d3e1d86caa",
                        "source_entry_id": "ee69c1e3-2ec8-38fc-b4d5-4c776ff4971e",
                        "source_sense_id": "f2841d9f-d74c-3f63-9c5e-6f3b420c1554",
                        "source_sense_description": "directe eigendomsovergang onder algemene titel op de erfgenamen",
                        "target_lang_word": "Vonselbsterwerb",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d2e684b1-b31f-45b0-b14e-ce981301fb5e",
                        "source_entry_id": "ee69c1e3-2ec8-38fc-b4d5-4c776ff4971e",
                        "source_sense_id": "f2841d9f-d74c-3f63-9c5e-6f3b420c1554",
                        "source_sense_description": "directe eigendomsovergang onder algemene titel op de erfgenamen",
                        "target_lang_word": "Besitzergreifung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Besitzergreifung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1c7237ae-18dc-3ba6-b8fa-e025a81dda55",
                                        "entry_id": "44f15d18-689f-3687-a89a-61c9a60f5071",
                                        "glosses": [
                                            "Aneignung einer Sache, eines Gebietes; Inbesitznahme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65bba645-626a-4d3d-a062-b5904a68fe1f",
                                                "sense_id": "1c7237ae-18dc-3ba6-b8fa-e025a81dda55",
                                                "text": "„So setzte die Schlussbestimmung des Protokolls über die Besitzergreifung des Königreichs Bayern an der Reichsstadt Nürnberg fest, dass eine Abschrift des Dokuments ‚in dem Archiv zu hinterlegen‘ sei – unterzeichnet in München am 8.“"
                                            },
                                            {
                                                "example_id": "fe099336-17cb-41e0-b1e8-00168287db7b",
                                                "sense_id": "1c7237ae-18dc-3ba6-b8fa-e025a81dda55",
                                                "text": "„Von Marokko sind genaue Ziffern nicht bekannt, doch ist die Stellung der Franzosen dort noch weit unsicherer, da sie mit der wirklichen Besitzergreifung des Gebiets noch lange nicht fertig geworden sind.“"
                                            },
                                            {
                                                "example_id": "cbed8dcc-e80b-4e8e-b93d-9aa3aca4d7c4",
                                                "sense_id": "1c7237ae-18dc-3ba6-b8fa-e025a81dda55",
                                                "text": "„‚Das erneute Auftauchen von Männern mit speziellen russischen Waffen und identischen Uniformen ohne Abzeichen, wie sie während Russlands illegaler Besitzergreifung der Krim getragen wurden, ist eine sehr ernste Entwicklung‘, erklärte Nato-Generalsekretär Anders Fogh Rasmussen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "832bc5bd-cebd-415b-8b34-243410aef877",
                        "source_entry_id": "ee69c1e3-2ec8-38fc-b4d5-4c776ff4971e",
                        "source_sense_id": "f2841d9f-d74c-3f63-9c5e-6f3b420c1554",
                        "source_sense_description": "directe eigendomsovergang onder algemene titel op de erfgenamen",
                        "target_lang_word": "saisine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "saisine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6d717367-b0f2-3645-b178-6ee74e856351",
                                        "entry_id": "a6fbec73-d5be-3ee6-a8a1-5c49002bc83e",
                                        "glosses": [
                                            "Appel ou recours à une juridiction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b11413f-3eda-4d0e-a1a1-68b4e050be65",
                                                "sense_id": "6d717367-b0f2-3645-b178-6ee74e856351",
                                                "text": "La résolution rédigée par l’Allemagne ne demande pas expressément la saisine du Conseil de sécurité à ce stade, mais elle établit les conditions d’un transfert ultérieur."
                                            },
                                            {
                                                "example_id": "50278794-3d59-4e96-9cbd-810d2cb5553d",
                                                "sense_id": "6d717367-b0f2-3645-b178-6ee74e856351",
                                                "text": "Furieux de la désinvolture de sa future ministre et de celle de Jean-Paul Capitani, l’architecte des Bâtiments de France leur avait envoyé — il y a trois ans — un courrier récapitulant toutes les infractions qu’il leur reprochait, non sans transmettre une copie de cette odieuse missive au préfet de Paca pour une éventuelle saisine du procureur de la République."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83016f6e-9f94-3d30-a2b0-439b8e7af6d2",
                                        "entry_id": "a6fbec73-d5be-3ee6-a8a1-5c49002bc83e",
                                        "glosses": [
                                            "Se dit de la possession – d’un bien immeuble en général – qui appartient de plein droit à un héritier, par opposition à l’« envoi en possession »."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b964b3fe-2073-4bba-a519-fe5d505c2679",
                                                "sense_id": "83016f6e-9f94-3d30-a2b0-439b8e7af6d2",
                                                "text": "Les créanciers d’une succession doivent s’adresser à celui qui en a la saisine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14e3a6b9-5b9a-3f29-997a-236b756e56fc",
                                        "entry_id": "a6fbec73-d5be-3ee6-a8a1-5c49002bc83e",
                                        "glosses": [
                                            "Sous la tenure féodale, le droit à la jouissance précaire (possession ou occupation) d’un bien-fonds tenu en fief."
                                        ],
                                        "tags": [
                                            "Droit féodal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb732f51-e688-4787-bfc4-a16be6f8e237",
                                                "sense_id": "14e3a6b9-5b9a-3f29-997a-236b756e56fc",
                                                "text": "Une fois le fief concédé à un censitaire, le seigneur n’a plus la saisine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed31e4ec-2eee-3359-909b-cf7988518d3e",
                                        "entry_id": "a6fbec73-d5be-3ee6-a8a1-5c49002bc83e",
                                        "glosses": [
                                            "Cordage servant à saisir, à fixer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d2dfafd-9e62-4286-8b78-c302e2965a1f",
                                                "sense_id": "ed31e4ec-2eee-3359-909b-cf7988518d3e",
                                                "text": "Les saisines du canot sont larguées, et il est repoussé en dehors."
                                            },
                                            {
                                                "example_id": "61addc29-e482-47b5-b9db-33fb6ab474c5",
                                                "sense_id": "ed31e4ec-2eee-3359-909b-cf7988518d3e",
                                                "text": "Ce fut un miracle si la petite goélette ne chavira pas.Deux fois elle fut engagée ,et tout aurait été enlevé à bord si les saisines eussent manqué."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
