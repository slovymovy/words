                "translations": [
                    {
                        "translation_id": "86c336f3-9dbc-4c6d-8554-7a7a1b5103b1",
                        "source_entry_id": "92acf972-151d-3ee6-a5d0-956ab0b178b4",
                        "source_sense_id": "f92c5fd2-8955-36cc-9e50-c0f42c16b7ce",
                        "target_lang_word": "nutrition",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nutrition",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9f7639db-b1d6-3761-8cd7-206e4bb66e0a",
                                        "entry_id": "782dcb15-d323-3e2f-99ad-f7a285c84e87",
                                        "glosses": [
                                            "The organic process by which an organism assimilates food and uses it for growth and maintenance."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef8c416e-dfaf-48bd-8129-0a7aa9954c11",
                                                "sense_id": "9f7639db-b1d6-3761-8cd7-206e4bb66e0a",
                                                "text": "In the dead state all is apparently without motion. No agent within indicates design, intelligence, or foresight: there is no respiration; no digestion, circulation, or nutrition; […]"
                                            },
                                            {
                                                "example_id": "3b951b93-095c-4b73-9741-ed3967df4b8b",
                                                "sense_id": "9f7639db-b1d6-3761-8cd7-206e4bb66e0a",
                                                "text": "Proper nutrition – and even more important, proper hydration – is crucial in preventing and recovering from both fevers and colds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6bb2a26-2a1e-3d55-a335-217ebe5d00f8",
                                        "entry_id": "782dcb15-d323-3e2f-99ad-f7a285c84e87",
                                        "glosses": [
                                            "That which nourishes; nutriment."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c75bc30c-06c0-4d4c-9ab0-e42d362fdb52",
                                                "sense_id": "b6bb2a26-2a1e-3d55-a335-217ebe5d00f8",
                                                "text": "I accidentally ate a worm which was in my apple - my uncle said the extra nutrition would do me good."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb8f5f02-3753-4b60-9f21-b380bbfcf25d",
                        "source_entry_id": "92acf972-151d-3ee6-a5d0-956ab0b178b4",
                        "source_sense_id": "f92c5fd2-8955-36cc-9e50-c0f42c16b7ce",
                        "target_lang_word": "nutrition",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nutrition",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aae94c2b-353c-3c92-82e1-db1c8b9b5ac9",
                                        "entry_id": "4e7fca23-2572-3ae0-bf6e-9c352048bff3",
                                        "glosses": [
                                            "Métabolisation des nutriments en vue de leur assimilation pour la croissance, l'entretien, le fonctionnement de l'organisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abe494a2-eb90-478f-a78b-1449a870d9c5",
                                                "sense_id": "aae94c2b-353c-3c92-82e1-db1c8b9b5ac9",
                                                "text": "L’alimentation a pour but de faire pénétrer dans l’organisme animal les matériaux nécessaires à la nutrition."
                                            },
                                            {
                                                "example_id": "3b9e7d18-09bb-43a3-957c-c833b90ac351",
                                                "sense_id": "aae94c2b-353c-3c92-82e1-db1c8b9b5ac9",
                                                "text": "Cet ouvrage présente les connaissances actuelles sur l’écophysiologie du pois protéagineux : développement végétatif et reproducteur, croissance en condition non limitante, nutrition azotée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ecb546bb-27ac-3fa0-8cf4-d69599e3e87b",
                                        "entry_id": "4e7fca23-2572-3ae0-bf6e-9c352048bff3",
                                        "glosses": [
                                            "Science qui analyse les rapports entre la nourriture et la santé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95e866b7-d666-42fa-9802-faf22342cdd9",
                                                "sense_id": "ecb546bb-27ac-3fa0-8cf4-d69599e3e87b",
                                                "text": "La nutrition joue un rôle essentiel dans la prévention de nombreuses maladies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "178e3ba2-ce2a-4274-aa1b-904b43f61e29",
                        "source_entry_id": "92acf972-151d-3ee6-a5d0-956ab0b178b4",
                        "source_sense_id": "f92c5fd2-8955-36cc-9e50-c0f42c16b7ce",
                        "target_lang_word": "alimentation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alimentation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25dea49d-7b42-3f7f-aba8-c5dc5ec99708",
                                        "entry_id": "4ad2e6ce-a590-3640-b2ad-65bc927325a1",
                                        "glosses": [
                                            "Action d’alimenter ou de s’alimenter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49ec423d-6de9-4fde-a55a-93c76b398989",
                                                "sense_id": "25dea49d-7b42-3f7f-aba8-c5dc5ec99708",
                                                "text": "L’alimentation a pour but de faire pénétrer dans l’organisme animal les matériaux nécessaires à la nutrition."
                                            },
                                            {
                                                "example_id": "5f9f676f-6f97-41be-aba6-170c57bca773",
                                                "sense_id": "25dea49d-7b42-3f7f-aba8-c5dc5ec99708",
                                                "text": "Naturellement, de tout l'hiver, le crapaud ne prend aucune nourriture. Une abondante alimentation estivale a entreposé dans son organisme quantité de matériaux nutritifs."
                                            },
                                            {
                                                "example_id": "0db147eb-8637-4dbf-b5ce-cc7cfaaf483e",
                                                "sense_id": "25dea49d-7b42-3f7f-aba8-c5dc5ec99708",
                                                "text": "[…]: l'abatage des animaux destinés à l’alimentation de la population se faisait encore en ville où chaque boucher possédait son écorcherie particulière; […]."
                                            },
                                            {
                                                "example_id": "36d330b8-2b73-4207-b6a6-ad5cf9c91a19",
                                                "sense_id": "25dea49d-7b42-3f7f-aba8-c5dc5ec99708",
                                                "text": "Par exemple, de la folle-avoine sera plus inacceptable dans une production de céréales destinée à la panification, que une céréale destinée à l’alimentation du bétail."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fc614bc-497f-3093-9e75-5fce1be17d70",
                                        "entry_id": "4ad2e6ce-a590-3640-b2ad-65bc927325a1",
                                        "glosses": [
                                            "Magasin d'aliments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee94d778-6a19-44de-a26b-20bbf0674788",
                                                "sense_id": "2fc614bc-497f-3093-9e75-5fce1be17d70",
                                                "text": "Il y avait plusieurs cafés proches du sien, mais pas d'autre alimentation. … les belles épiceries d'avant-guerre campaient dans des baraquements jaunes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "161ab3d0-a3d9-3a3a-a6b8-768190ca5c20",
                                        "entry_id": "4ad2e6ce-a590-3640-b2ad-65bc927325a1",
                                        "glosses": [
                                            "Domaine de tout ce qui se rapporte à l’apport de nourriture permettant à un organisme vivant de fonctionner."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b2a343cb-8905-3390-ae12-0a4d2da8fdef",
                                        "entry_id": "4ad2e6ce-a590-3640-b2ad-65bc927325a1",
                                        "glosses": [
                                            "Système secondaire, qui assure l’apport d’éléments de base et d’énergie à un système principal qui dépend du premier pour son fonctionnement."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c7cf2d4-312f-4b08-b71d-e65b3c48afd8",
                                                "sense_id": "b2a343cb-8905-3390-ae12-0a4d2da8fdef",
                                                "text": "— Les organes qui concourent à l'alimentation sont : Les cylindres alimentaires, les pressions, les guide-fils, les tambours entraîneurs d'ensouple et les supports d'ensouple."
                                            },
                                            {
                                                "example_id": "59287221-0e01-40c5-b04b-dca4c063fe74",
                                                "sense_id": "b2a343cb-8905-3390-ae12-0a4d2da8fdef",
                                                "text": "Le système d’alimentation en carburant d’un moteur."
                                            },
                                            {
                                                "example_id": "e899d998-1010-43e8-a676-cff5100faf80",
                                                "sense_id": "b2a343cb-8905-3390-ae12-0a4d2da8fdef",
                                                "text": "Les alimentations des microordinateurs utilisent depuis longtemps un système à découpage qui leur épargne les lourds transformateurs fonctionnant à cinquante hertz qui seraient, sinon, nécessaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
