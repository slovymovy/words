                    }
                ],
                "senses": [
                    {
                        "sense_id": "51ba1d03-583e-3c0c-9996-1425284e8095",
                        "entry_id": "b7c7671d-539a-35ef-beb4-69b390258e7a",
                        "glosses": [
                            "iets dat heel normaal is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "898dd718-2590-4a29-87ab-fc64f764da8b",
                                "sense_id": "51ba1d03-583e-3c0c-9996-1425284e8095",
                                "text": "Saaiheid is zijn handelsmerk. Af en toe slaat de balans door en wordt zijn gewoonheid haast ondragelijk. Misschien wel daarom heeft een goede vriend van Hollande een boekje geschreven over die andere François. Want die bestaat. Het blijkt een man die met een glas bier in de hand midden in de de kroeg kwinkslagen verkoopt en moppen tapt."
                            },
                            {
                                "example_id": "84799df0-0346-4865-af13-8d0fe227fba2",
                                "sense_id": "51ba1d03-583e-3c0c-9996-1425284e8095",
                                "text": "Op Prinsjesdag krijgt de sacrale kant van de koning ruimte en op Koningsdag wordt \"de gewoonheid\" van de koning en de \"geringe afstand tussen vorst en onderdaan\" geaccentueerd. Maar in allebei de gevallen moet je een beetje door de 'kleren van de koning' heen kijken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "59b69c90-1a3f-47e5-bdf3-0d1be4945a97",
                        "source_entry_id": "b7c7671d-539a-35ef-beb4-69b390258e7a",
                        "source_sense_id": "51ba1d03-583e-3c0c-9996-1425284e8095",
                        "target_lang_word": "ordinariness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ordinariness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "496fee4c-225d-30c8-b310-64b57f39b1c6",
                                        "entry_id": "b2041963-2770-3b51-ade5-281f8aebdf9f",
                                        "glosses": [
                                            "The quality or condition of being ordinary."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63f187b6-39d6-4705-9db0-f8c6e240820f",
                                                "sense_id": "496fee4c-225d-30c8-b310-64b57f39b1c6",
                                                "text": "What links the kids in most of these games is their relative ordinariness, forcing us to face their perils without special powers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b33c85bb-b66b-44e3-b407-3b92695c8218",
                        "source_entry_id": "b7c7671d-539a-35ef-beb4-69b390258e7a",
                        "source_sense_id": "51ba1d03-583e-3c0c-9996-1425284e8095",
                        "target_lang_word": "plainness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plainness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28ac3932-893a-3664-b960-bdb61d53b0f0",
                                        "entry_id": "4b56080f-78d2-3418-aac2-4633109afe71",
                                        "glosses": [
                                            "The condition of being plain (in all senses)"
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cf79b55-945c-472f-9f27-1f4355a0398f",
                                                "sense_id": "28ac3932-893a-3664-b960-bdb61d53b0f0",
                                                "text": "Thy plainness moves me more than eloquence\nAnd here choose I. Joy be the consequence!"
                                            },
                                            {
                                                "example_id": "989028dd-3ac6-43f6-af1e-d858a421b9b6",
                                                "sense_id": "28ac3932-893a-3664-b960-bdb61d53b0f0",
                                                "text": "Yet her beauty clung to her like an identity she was trying to deny and her plainness kept slipping like a bad disguise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05ec47d2-5efa-30d8-acf7-1495eeff0833",
                                        "entry_id": "4b56080f-78d2-3418-aac2-4633109afe71",
                                        "glosses": [
                                            "The product or result of being plain"
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "801cfa21-f042-446d-a027-6f7220d50eaa",
                        "source_entry_id": "b7c7671d-539a-35ef-beb4-69b390258e7a",
                        "source_sense_id": "51ba1d03-583e-3c0c-9996-1425284e8095",
                        "target_lang_word": "commonness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "commonness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "055e5c19-cbac-3841-aa35-0665600e0c48",
                                        "entry_id": "18e2fb43-72a8-3692-bba1-7211c24f196e",
                                        "glosses": [
                                            "The quality of being common in the sense of ordinary, usual or mundane."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fde53e9-09cc-4607-96e5-a953c20130c3",
                                                "sense_id": "055e5c19-cbac-3841-aa35-0665600e0c48",
                                                "text": "So she is returning to her parents, where she will work at a corner store and save up money to move to New York. The commonness is so maddening to her. Everyone moves to New York."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f7e2dda-c605-3377-bb81-ed731c44b8b6",
                                        "entry_id": "18e2fb43-72a8-3692-bba1-7211c24f196e",
                                        "glosses": [
                                            "The quality of being common in the sense of vulgar, coarse or low class."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ddae594-e78b-42ec-81af-9adc59e31756",
                                                "sense_id": "0f7e2dda-c605-3377-bb81-ed731c44b8b6",
                                                "text": "‘Dem wuzn’t no high muckty mucks. Dem wuz railroad hands and dey womenfolks. You ain’t usetuh folks lak dat and Ah wuz skeered you might git all mad and quit me for takin’ you ’mongst ’em […] Befo’ us got married Ah made up mah mind not tuh let you see no commonness in me.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
