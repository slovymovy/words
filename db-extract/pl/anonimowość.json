                                            {
                                                "example_id": "fe2d7d15-ee14-4be7-b13e-ac9bfb0d0953",
                                                "sense_id": "8c8c0a32-37ce-3419-9e79-999b3d2883e1",
                                                "text": "„Das Allgemeine Persönlichkeitsrecht beinhaltet unter anderem ein Recht auf Anonymität.“"
                                            },
                                            {
                                                "example_id": "1db50104-666f-4ec5-a664-ba909e59231f",
                                                "sense_id": "8c8c0a32-37ce-3419-9e79-999b3d2883e1",
                                                "text": "„Während das Internet bislang eher ein Meer der Anonymität war, aus dem lediglich Inseln mit namentlicher Nutzernennung ragten, kehrt sich dieses Verhältnis derzeit um.“"
                                            },
                                            {
                                                "example_id": "5498d4e0-6323-420e-8570-c2f8440966c1",
                                                "sense_id": "8c8c0a32-37ce-3419-9e79-999b3d2883e1",
                                                "text": "„Über Nacht wurde ich aus der Vertrautheit des Dorfes in die Anonymität des Molochs entlassen.“"
                                            },
                                            {
                                                "example_id": "f961fa44-749b-431f-925e-b07e403e6cb5",
                                                "sense_id": "8c8c0a32-37ce-3419-9e79-999b3d2883e1",
                                                "text": "„Damals waren Rezensionen grundsätzlich unsigniert, weil man fand, dass Anonymität dem Kritiker die Freiheit der unverblümten Äußerung gewährte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ff8eef8-c8cd-4d1e-a821-e738ad1eeb80",
                        "source_entry_id": "c3457090-f81c-3351-a348-2b0fdf4c25d0",
                        "source_sense_id": "5c295730-837d-3c14-8300-62e5eb30f4d8",
                        "target_lang_word": "анонимность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "анонимность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "04ba222e-af00-340a-b4ff-51277bf99250",
                                        "entry_id": "1c4a1f94-76d1-3552-bbc4-e6d4880f904d",
                                        "glosses": [
                                            "свойство или состояние по значению прилагательного анонимный; отсутствие указания имени, отсутствие сведений об имени; также сокрытие человеком своего имени"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4380ce4e-8fb0-4eb1-b10f-4b79cd9f31da",
                                                "sense_id": "04ba222e-af00-340a-b4ff-51277bf99250",
                                                "text": "Какие-то французские и английские стихи ходили в списках по рукам и списывались снова, не без искажений, причем имя автора незаметно выпадало, так что они совершенно случайно приобретали соблазнительную анонимность, да и вообще, их странствования забавно сопоставить с подпольным списыванием крамольных стишков, практиковавшимся в других кругах."
                                            },
                                            {
                                                "example_id": "ca8758e7-0ebc-4310-b02f-cbbf4910cb43",
                                                "sense_id": "04ba222e-af00-340a-b4ff-51277bf99250",
                                                "text": "Соображения конспирации окутывают всю историю передачи документов покровом анонимности."
                                            },
                                            {
                                                "example_id": "a970e7db-d903-4fd0-ae7c-f07c86e69259",
                                                "sense_id": "04ba222e-af00-340a-b4ff-51277bf99250",
                                                "text": "В наше время все новые социально-политические устройства, как демократические, так и авторитарные, уводят все дальше от духа индивидуализма, к стадному натиску масс. Идея экзистенциальной исключительности человека заменяется идеей анонимности."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
