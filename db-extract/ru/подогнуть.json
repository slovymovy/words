                    }
                ],
                "translations": [
                    {
                        "translation_id": "143089e2-2f17-4bf4-809e-d247773ed701",
                        "source_entry_id": "1bf52c8a-569a-3cfd-a253-b04940898b56",
                        "target_lang_word": "replier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "replier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e9060ab6-992a-35b0-8dc6-e9ac3355fbe2",
                                        "entry_id": "6e11741e-acb7-3139-a32f-2a8a4fe1e1ce",
                                        "glosses": [
                                            "Plier une chose qui avait été dépliée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2220385-952c-4c36-a5c8-f07a02b94973",
                                                "sense_id": "e9060ab6-992a-35b0-8dc6-e9ac3355fbe2",
                                                "text": "Denise dépliait les vêtements, les repliait, sans se permettre un geste d’humeur."
                                            },
                                            {
                                                "example_id": "dfa47816-f9da-4cde-8140-84342becd6e6",
                                                "sense_id": "e9060ab6-992a-35b0-8dc6-e9ac3355fbe2",
                                                "text": "Posément le uhlan avait replié sa carte, ressanglé, puis enfourché sa bête. Il disparut."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a4dc21a-fc13-3fb6-b14a-6848c5cebf6a",
                                        "entry_id": "6e11741e-acb7-3139-a32f-2a8a4fe1e1ce",
                                        "glosses": [
                                            "Plier plusieurs fois."
                                        ],
                                        "tags": [],
                                        "note": "dans cette acception, on l’emploie surtout avec le pronom personnel",
                                        "examples": [
                                            {
                                                "example_id": "7666c7cb-c13e-426f-94f1-054870b3e5ce",
                                                "sense_id": "1a4dc21a-fc13-3fb6-b14a-6848c5cebf6a",
                                                "text": "Voyez comme ce serpent se replie."
                                            },
                                            {
                                                "example_id": "fc853660-09c0-4c4c-a798-b0e88c30afe5",
                                                "sense_id": "1a4dc21a-fc13-3fb6-b14a-6848c5cebf6a",
                                                "text": "Se replier en tous sens."
                                            },
                                            {
                                                "example_id": "757f3f1b-c5fd-4cde-8088-836acbfe0b05",
                                                "sense_id": "1a4dc21a-fc13-3fb6-b14a-6848c5cebf6a",
                                                "text": "En cet endroit, le fleuve se replie tout à coup et se dirige vers l’est."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b46344de-8916-3465-b176-d04a23f26bfa",
                                        "entry_id": "6e11741e-acb7-3139-a32f-2a8a4fe1e1ce",
                                        "glosses": [
                                            "…"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db876f54-b8fe-4740-bf0b-ee07ff74008a",
                                                "sense_id": "b46344de-8916-3465-b176-d04a23f26bfa",
                                                "text": "Se replier sur soi-même, Se recueillir, réfléchir."
                                            },
                                            {
                                                "example_id": "930ec4e9-f18c-457e-991b-feafe6c9cf5e",
                                                "sense_id": "b46344de-8916-3465-b176-d04a23f26bfa",
                                                "text": "La réflexion est l’action de l’âme qui se replie sur elle-même."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adb65d42-f404-3ebc-b767-75c314d9acd6",
                                        "entry_id": "6e11741e-acb7-3139-a32f-2a8a4fe1e1ce",
                                        "glosses": [
                                            "Ramener en bon ordre un corps de troupes en arrière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d68dae70-8a09-45ed-ac6d-bc23503a565f",
                                                "sense_id": "adb65d42-f404-3ebc-b767-75c314d9acd6",
                                                "text": "La bataille s’est livrée avant qu'il y arrivât. Il a échappé au désastre et il s’est replié sur Paris, où il est rentré, trois jours avant que l’investissement fût complet."
                                            },
                                            {
                                                "example_id": "990dea33-2b38-4bae-bbfb-f179d26fc663",
                                                "sense_id": "adb65d42-f404-3ebc-b767-75c314d9acd6",
                                                "text": "L'ennemi prend du mordant et tente de tourner une position qui ne s'appuie sur rien. […]. On se replie avec méthode."
                                            },
                                            {
                                                "example_id": "9a190acb-d9cd-4eeb-9a0e-cfcb435e597c",
                                                "sense_id": "adb65d42-f404-3ebc-b767-75c314d9acd6",
                                                "text": "Le 12ᵉ corps se repliera de même dans la clairière Florenville, Fontenoille, puis, au sud de la zone boisée, sur la ligne Puilly, Les Deux Villes, Matton."
                                            },
                                            {
                                                "example_id": "fb116d91-7877-4603-bd1d-743e365c54c9",
                                                "sense_id": "adb65d42-f404-3ebc-b767-75c314d9acd6",
                                                "text": "Se replier en bon ordre se dit figurément de Quelqu’un qui, voyant que sa demande n’a pas chance de réussir, sa proposition d’être agréée, se retire avec tact et habileté."
                                            },
                                            {
                                                "example_id": "cbf0993e-86ea-41c1-aabd-7be98b018558",
                                                "sense_id": "adb65d42-f404-3ebc-b767-75c314d9acd6",
                                                "text": "Je me replie dans ma chambre, après être redescendue dans le salon où j’ai trouvé Papa, Henri et Mayeul en plein fou-rire […], et après avoir tenté de m’insérer dans le jeu de Jean-Baptiste et Diane qui jouaient au papa et à la maman, mais qui voulaient que je fasse le chien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
