                        "glosses": [
                            "Eigenschaft/Umstand, erschöpfend, vollständig (exhaustiv) zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3be19d3a-17f8-4bf3-b56f-cf3b2fa26919",
                                "sense_id": "448286cd-5d91-305c-8d38-bdfe220158f5",
                                "text": "„Bei Persönlichkeitstests müssen die Antwortalternativen zudem auf Exhaustivität (Vollständigkeit) gerichtet sein, d. h. mit den Antwortalternativen sind alle Verhaltensvarianten abzubilden.“"
                            },
                            {
                                "example_id": "f3ff6d3b-26bd-47f8-8bda-93c81f9da386",
                                "sense_id": "448286cd-5d91-305c-8d38-bdfe220158f5",
                                "text": "„Durch das Einführen von Restkategorien ist Exhaustivität grundsätzlich gegeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
