                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "923eed84-b224-4a31-9c03-45dde9117bec",
                                "sense_id": "eecc0d8a-9051-390c-8404-dc9538145110",
                                "text": "You must pay your dues.",
                                "translation": "Sie müssen die Gebühr bezahlen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f1f275fe-9524-3d24-9684-3bf9f4e8ca06",
                        "entry_id": "5f277ccc-8a70-3d30-8105-0309c3d80ac0",
                        "glosses": [
                            "Beitrag, Beiträge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a906eb8-947f-46ed-99c6-ea5a4d81350c",
                                "sense_id": "f1f275fe-9524-3d24-9684-3bf9f4e8ca06",
                                "text": "You must pay your dues.",
                                "translation": "Du musst deinen Beitrag bezahlen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "17a5a59d-1836-4a26-9f0d-b09105ef7200",
                        "source_entry_id": "5f277ccc-8a70-3d30-8105-0309c3d80ac0",
                        "source_sense_id": "eecc0d8a-9051-390c-8404-dc9538145110",
                        "source_sense_description": "Gebühr(en)",
                        "target_lang_word": "Gebühr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gebühr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cbed3713-f50e-3838-bc9a-ad4270481414",
                                        "entry_id": "c7a34d95-f93a-3dae-bd71-0e656f95ced5",
                                        "glosses": [
                                            "eine Geldsumme, die für eine Dienstleistung oder die Benutzung einer Sache zu entrichten ist; das Zugebühren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bab5b5c-7c0a-4f26-9dba-7a82c881e8d4",
                                                "sense_id": "cbed3713-f50e-3838-bc9a-ad4270481414",
                                                "text": "Die Gebühr für die Ausstellung eines Reisepasses beträgt 69 Euro."
                                            },
                                            {
                                                "example_id": "024471e8-e076-40ff-97a1-ca9c0826707b",
                                                "sense_id": "cbed3713-f50e-3838-bc9a-ad4270481414",
                                                "text": "Für die Bearbeitung des Antrags erhebt das Amt eine Gebühr von 4 Euro."
                                            },
                                            {
                                                "example_id": "c36cf5d3-1eaf-48d3-8526-2234832ba220",
                                                "sense_id": "cbed3713-f50e-3838-bc9a-ad4270481414",
                                                "text": "„Inzwischen war er hier zu Hause, hatte seinen eigenen Platz, für den er Gebühren bezahlte, und stand mit den Markthändlern auf Du und Du.“"
                                            },
                                            {
                                                "example_id": "12f47127-ceb6-4f28-9602-8c232e214bd1",
                                                "sense_id": "cbed3713-f50e-3838-bc9a-ad4270481414",
                                                "text": "„Die Gebühr war eigentlich zu hoch für die Familie, 3000 Drachmen im Monat würde sie bestimmt nicht bekommen, klagte Chrissi schon im Vorhinein.“"
                                            },
                                            {
                                                "example_id": "ffe00076-352b-4ea1-ab46-9f7aa754b19f",
                                                "sense_id": "cbed3713-f50e-3838-bc9a-ad4270481414",
                                                "text": "„Die Wirtin rechnete mir noch die Gebühren für ein Telegramm an, das ich abends nach Bonn an Monika Silvs aufgegeben, das Kostert zu bezahlen sich geweigert hatte.“"
                                            },
                                            {
                                                "example_id": "d4b52ef1-efb5-490a-bf7e-60bda4f84dfd",
                                                "sense_id": "cbed3713-f50e-3838-bc9a-ad4270481414",
                                                "text": "„Die Bürgerschaft hatte nach langen Gesuchen und mit hohen Gebühren vom Burgherrn die Erlaubnis bekommen, ihre Schafe auf den Wiesen außerhalb der Mauer weiden zu lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8262cddf-0abf-32f5-86e0-d8f9dbf0bc67",
                                        "entry_id": "c7a34d95-f93a-3dae-bd71-0e656f95ced5",
                                        "glosses": [
                                            "die Ehre, die einem seinem Stande nach gebührt; das Sichgebühren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ebfe1cb-3a7b-485e-a31b-84e8f33f4579",
                                                "sense_id": "8262cddf-0abf-32f5-86e0-d8f9dbf0bc67",
                                                "text": "In Deutschland gebührt es sich, dass junge Leute im Bus aufstehen und einem Älteren den Sitzplatz anbieten; in Russland ist es die Gebühr der Alten gegenüber den Jungen aufzustehen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Gebühr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d8b847c6-0e03-3112-95ee-088fed8b8bc3",
                                        "entry_id": "0bb2bf15-4a78-3caa-bb25-9d25e330e4d2",
                                        "glosses": [
                                            "deutscher Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73f21a64-115a-4330-853d-7dbf653f865d",
                                                "sense_id": "d8b847c6-0e03-3112-95ee-088fed8b8bc3",
                                                "text": "„Hilde Gebühr (* 28. Juni 1910 in Dresden; † 26. April 1945 in Schlehdorf am Kochelsee) war eine deutsche Schauspielerin.“"
                                            },
                                            {
                                                "example_id": "32495c2f-003d-46b4-bbb5-67725d911f49",
                                                "sense_id": "d8b847c6-0e03-3112-95ee-088fed8b8bc3",
                                                "text": "„ 29. Mai: Otto Gebühr wird in Kettwig/Ruhr als Sohn des Kaufmanns Otto Gebühr und dessen Frau Fanny Mathilde (geb. Moll) geboren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da8eeff1-7108-4956-b080-5e74a1221fc8",
                        "source_entry_id": "5f277ccc-8a70-3d30-8105-0309c3d80ac0",
                        "source_sense_id": "f1f275fe-9524-3d24-9684-3bf9f4e8ca06",
                        "source_sense_description": "Beitrag, Beiträge",
                        "target_lang_word": "Beitrag",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beitrag",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "15b39827-bbe7-33fb-969f-b636cbf09926",
                                        "entry_id": "5bffe407-73e6-3a5f-ad3f-60b58712f538",
                                        "glosses": [
                                            "Geldbetrag, der für die Mitgliedschaft in einem Verein, die Teilnahme an einer Veranstaltung (zum Beispiel an einer Tagung) oder dergleichen gezahlt werden muss"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "032484c3-7eaa-4694-ad4d-2566012db3a2",
                                                "sense_id": "15b39827-bbe7-33fb-969f-b636cbf09926",
                                                "text": "Der Beitrag für den Schützenverein beträgt 40 € jährlich."
                                            },
                                            {
                                                "example_id": "b6c4bb5d-b469-4442-b4bb-2ad217b54554",
                                                "sense_id": "15b39827-bbe7-33fb-969f-b636cbf09926",
                                                "text": "„Dem Angebot für die Reparatur wurde zugestimmt, was bedeutete, dass sich die Beiträge in die Hauskasse eine Zeit lang um zehntausend Kronen erhöhten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "ed7dd2bf-1516-33f8-8884-bf13a827e989",
                                        "entry_id": "5bffe407-73e6-3a5f-ad3f-60b58712f538",
                                        "glosses": [
                                            "Geldbetrag, der vom Versicherten und seinem Arbeitgeber für die Mitgliedschaft beziehungsweise die Versicherung bei einem Sozialversicherungsträger gezahlt werden muss; Sozialversicherungsbeiträge"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b60ce6ea-a994-42f2-abaa-22afce6ebf1c",
                                                "sense_id": "ed7dd2bf-1516-33f8-8884-bf13a827e989",
                                                "text": "Die Beiträge zur gesetzlichen Krankenversicherung sind am Anfang des Monats erhöht worden."
                                            }
                                        ],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "faa1910a-7b37-30ce-8c41-7cced9d44e0a",
                                        "entry_id": "5bffe407-73e6-3a5f-ad3f-60b58712f538",
                                        "glosses": [
                                            "jemandes Anteil an einem bestimmten Werk oder einer bestimmten Entwicklung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99c5d134-092f-406a-8447-d3bf865ff18b",
                                                "sense_id": "faa1910a-7b37-30ce-8c41-7cced9d44e0a",
                                                "text": "Brigitte B. leistet heute einen wesentlichen Beitrag zum Schutz der Tiere."
                                            },
                                            {
                                                "example_id": "f8eca107-67f0-4f8d-8c44-133530758c2c",
                                                "sense_id": "faa1910a-7b37-30ce-8c41-7cced9d44e0a",
                                                "text": "„Einen effektiven Beitrag zur Bekämpfung des Klimawandels kann die Speicherung von CO₂ nur leisten, wenn das eingelagerte CO₂ dauerhaft und vollständig in den Speichern verbleibt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "eeaefe77-1504-356f-907e-2c02f086b786",
                                        "entry_id": "5bffe407-73e6-3a5f-ad3f-60b58712f538",
                                        "glosses": [
                                            "Veröffentlichung in den Medien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4828d1a0-6ffc-47c1-b4d4-cc2ca391f472",
                                                "sense_id": "eeaefe77-1504-356f-907e-2c02f086b786",
                                                "text": "Für jede Dekade stehen im SPIEGEL herausragende Ereignisse, bedeutsame Themen, wichtige Beiträge."
                                            },
                                            {
                                                "example_id": "0468f25c-56e9-44e2-b423-bc2e8af5a49e",
                                                "sense_id": "eeaefe77-1504-356f-907e-2c02f086b786",
                                                "text": "„Eine endgültige Entscheidung stand jedoch zum Zeitpunkt der Drucklegung dieses Beitrags noch aus.“"
                                            },
                                            {
                                                "example_id": "02587ded-c5dd-41cf-966c-32d3503601f3",
                                                "sense_id": "eeaefe77-1504-356f-907e-2c02f086b786",
                                                "text": "„Das ist sein journalistisches Credo, alle Beiträge des »Merkur«, nicht nur die literarischen Rezensionen betreffend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
