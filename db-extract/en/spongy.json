    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "198752fd-4655-3697-ad46-f6fd9eba4827",
                "word": "spongy",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "57e509ec-76b0-4d2e-88d6-dd03caf6f467",
                        "entry_id": "198752fd-4655-3697-ad46-f6fd9eba4827",
                        "tags": [
                            "comparative"
                        ],
                        "form": "spongier"
                    },
                    {
                        "form_id": "31a6214f-3410-4974-bea2-7763457b5e00",
                        "entry_id": "198752fd-4655-3697-ad46-f6fd9eba4827",
                        "tags": [
                            "superlative"
                        ],
                        "form": "spongiest"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7275e113-3b6d-32a2-9fe0-9d3ca4a06025",
                        "entry_id": "198752fd-4655-3697-ad46-f6fd9eba4827",
                        "glosses": [
                            "Having the characteristics of a sponge, namely being absorbent, squishy or porous."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34608bb4-e1fc-4b4f-88b6-4238cc4b519a",
                                "sense_id": "7275e113-3b6d-32a2-9fe0-9d3ca4a06025",
                                "text": "spongy earth; spongy cake; spongy bones"
                            },
                            {
                                "example_id": "98f5ff96-6332-4034-b121-f8062e1b76bf",
                                "sense_id": "7275e113-3b6d-32a2-9fe0-9d3ca4a06025",
                                "text": "Though no man lesser fears the Greeks than I\nAs far as toucheth my particular,\nYet, dread Priam,\nThere is no lady of more softer bowels,\nMore spongy to suck in the sense of fear,\nMore ready to cry out 'Who knows what follows?'\nThan Hector is:"
                            },
                            {
                                "example_id": "f5f44891-0a1c-4e94-b621-13e858287af1",
                                "sense_id": "7275e113-3b6d-32a2-9fe0-9d3ca4a06025",
                                "text": "[…] there were times when she would lie looking at her, with such a still, watchful, almost dangerous expression, that Helen would sigh, and change her place, as persons do whose breath some cunning orator had been sucking out of them with his spongy eloquence, so that, when he stops, they must get some air and stir about, or they feel as if they should be half-smothered and palsied."
                            },
                            {
                                "example_id": "e31fc182-2c50-4769-aa03-ce900a5f63b7",
                                "sense_id": "7275e113-3b6d-32a2-9fe0-9d3ca4a06025",
                                "text": "It was easy to realise, too, the need for the overall 40 m.p.h. speed limit; apart from the spongy nature of much of the track bed, the [West Highland] line suffered considerably in the Arctic conditions of last winter, from which it has not yet fully recovered."
                            }
                        ]
                    },
                    {
                        "sense_id": "c06da4de-65c1-3cca-803b-704370cc5cb2",
                        "entry_id": "198752fd-4655-3697-ad46-f6fd9eba4827",
                        "glosses": [
                            "Wet; drenched; soaked and soft, like sponge; rainy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0a95d0c-6312-412f-bf6a-a7e09d2d7809",
                                "sense_id": "c06da4de-65c1-3cca-803b-704370cc5cb2",
                                "text": "Thy banks with pioned and twilled brims,\nWhich spongy April at thy hest betrims,"
                            },
                            {
                                "example_id": "bfcd65cb-5cee-4b56-b940-72b3c63e0c52",
                                "sense_id": "c06da4de-65c1-3cca-803b-704370cc5cb2",
                                "text": "Her who still weepes with spungie eyes,\nAnd her who is dry corke, and never cries;\nI can love her, and her, and you and you,\nI can love any, so she be not true."
                            },
                            {
                                "example_id": "38604d50-e7a8-4882-b661-66ef818178d1",
                                "sense_id": "c06da4de-65c1-3cca-803b-704370cc5cb2",
                                "text": "[…] I was quite tired, and very glad, when we saw Yarmouth. It looked rather spongy and soppy, I thought, as I carried my eye over the great dull waste that lay across the river […]"
                            },
                            {
                                "example_id": "1d440564-345f-4d22-a591-fda0d87b30cb",
                                "sense_id": "c06da4de-65c1-3cca-803b-704370cc5cb2",
                                "text": "It rains […] most of the fall and winter and much of the spring. It’s a spongy sky you’ll be wearing on your head."
                            }
                        ]
                    },
                    {
                        "sense_id": "abd31aac-bdba-34d4-ad75-5268af6473d7",
                        "entry_id": "198752fd-4655-3697-ad46-f6fd9eba4827",
                        "glosses": [
                            "Drunk."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6cbe993c-fc50-4d38-939a-ccbf720d2c91",
                        "source_entry_id": "198752fd-4655-3697-ad46-f6fd9eba4827",
                        "source_sense_description": "absorbent, squishy, porous",
                        "target_lang_word": "spongieux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spongieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6cbcabaf-73b4-3329-b127-24904ed18a6d",
                                        "entry_id": "7bae724c-a9f3-35e4-b185-1793c72c36be",
                                        "glosses": [
                                            "Qui est poreux ; qui est de la nature de l’éponge ; qui est semblable à l’éponge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70c6ca71-11fa-43dc-b4a1-922f0b75d298",
                                                "sense_id": "6cbcabaf-73b4-3329-b127-24904ed18a6d",
                                                "text": "Le sol spongieux tremblait autour de nous, et à chaque instant nous étions près d’être engloutis dans des fondrières."
                                            },
                                            {
                                                "example_id": "e64b34e7-6e9a-43d2-a66f-2af181a959e0",
                                                "sense_id": "6cbcabaf-73b4-3329-b127-24904ed18a6d",
                                                "text": "Nous campons sur sa rive droite, dans un terrain spongieux, où chaque pas laisse une empreinte profonde qui se remplit d’eau, où les piquets des tentes ne tiennent pas […]"
                                            },
                                            {
                                                "example_id": "0904e36b-c06c-4a86-96fb-3c1d527ee958",
                                                "sense_id": "6cbcabaf-73b4-3329-b127-24904ed18a6d",
                                                "text": "Vêtu d’un chandail humide et porteur d’une casquette spongieuse, déformée, d’un pantalon trop court et de godillots à clous, le gars tétait un authentique brûle-gueule de terre-neuva."
                                            },
                                            {
                                                "example_id": "4e9fb589-8a32-418b-891d-5dc7269addb7",
                                                "sense_id": "6cbcabaf-73b4-3329-b127-24904ed18a6d",
                                                "text": "La bruyère spongieuse à Erica Tetralix ^([sic : tetralix]) est souvent en continuité avec des petits îlots de l’association à Schœnus établis dans la zone des marnes supra-gypseuses et l’on constate alors, à la marge des deux groupements, un mélange de leurs éléments respectifs."
                                            },
                                            {
                                                "example_id": "5fc3de63-df07-4bcd-8b0c-74756db7bd68",
                                                "sense_id": "6cbcabaf-73b4-3329-b127-24904ed18a6d",
                                                "text": "Ainsi, Rhynchospora alba forme encore des peuplements importants dans certaines prairies spongieuses assez loin des stations où il s’établit normalement […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6d83de4-3800-37ec-9d7a-e1141d2e8657",
                                        "entry_id": "7bae724c-a9f3-35e4-b185-1793c72c36be",
                                        "glosses": [
                                            "Plein d’humidité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "588f636c-0920-4ab5-b98e-c48e94535207",
                                                "sense_id": "f6d83de4-3800-37ec-9d7a-e1141d2e8657",
                                                "text": "Croyez-vous que je sois vraiment réduite à votre compagnie, à vos regards « compatissants », vos regards humides, spongieux, à votre bavardage plein de ménagements…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95df9353-1b03-4087-af75-33fb2e16afa5",
                        "source_entry_id": "198752fd-4655-3697-ad46-f6fd9eba4827",
                        "source_sense_description": "absorbent, squishy, porous",
                        "target_lang_word": "schwammartig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schwammartig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "62318521-a139-338b-a15c-f3736d900851",
                                        "entry_id": "30bdb92c-4848-3236-bcce-52c6507205d4",
                                        "glosses": [
                                            "einem Schwamm ähnelnd, an einen Schwamm erinnernd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa10073d-34b5-446d-b725-cddd7c76c1fb",
                                                "sense_id": "62318521-a139-338b-a15c-f3736d900851",
                                                "text": "„Der ovale Kopf saß direkt auf dem Rumpf und hatte keine Augen, sondern etwa in der Mitte ein abscheuliches, schwammartiges, kreisrundes Organ; darüber wucherte etwas, das auf grässliche Weise an ein Spinnennetz erinnerte.“"
                                            },
                                            {
                                                "example_id": "889f9ccc-bbc5-47b3-b486-7507353749c4",
                                                "sense_id": "62318521-a139-338b-a15c-f3736d900851",
                                                "text": "„An einigen Stellen waren die Wände über die Türen gewachsen, und auch der Eingang zu Ians Büro war schon fast ganz von schwammartigen Gebilden verdeckt, aber Jim und Ian schafften es, hindurchzukriechen.“"
                                            },
                                            {
                                                "example_id": "cfad2354-9f63-4c68-b6cb-ae6ff6e9ad62",
                                                "sense_id": "62318521-a139-338b-a15c-f3736d900851",
                                                "text": "„Howard hatte die Pflanze mit dem schwammartigen Zweig eines abgestorbenen Buschs angestupst und sich gefragt, wie er sie klassifizieren sollte, als er aufblickte und sich von den merkurianischen Wilden umringt fand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "433406e1-2d21-4648-b647-d3f7c67aa117",
                        "source_entry_id": "198752fd-4655-3697-ad46-f6fd9eba4827",
                        "source_sense_description": "absorbent, squishy, porous",
                        "target_lang_word": "schwammig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schwammig",
