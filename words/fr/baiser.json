    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "af3bd0c0-029b-35e9-8d12-f6dedf8bfbcd",
                    "sense_definition": "Contact des lèvres sur le visage, sur la bouche ou sur une autre partie du corps d'une personne, par amour, par amitié, par désir ou par respect.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "baiser (geste d'affection)",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle m'a donné un <w>baiser</w> sur la joue avant de partir au travail."
                        },
                        {
                            "text": "Les deux amoureux ont échangé un long <w>baiser</w> sous la pluie."
                        },
                        {
                            "text": "Le petit garçon a reçu un <w>baiser</w> de sa grand-mère avant de s'endormir."
                        }
                    ],
                    "synonyms": [
                        "bisou",
                        "bécot"
                    ],
                    "common_phrases": [
                        "donner un baiser",
                        "un baiser sur la joue",
                        "un baiser sur la bouche",
                        "un long baiser"
                    ]
                },
                {
                    "sense_id": "92db7a31-cfa1-3bb2-b135-464ada102d0d",
                    "sense_definition": "Geste qui consiste à porter la main à ses lèvres puis à l'écarter vers une ou plusieurs personnes pour simuler un baiser à distance.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "baiser (geste d'affection)",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chanteur a envoyé un <w>baiser</w> au public avant de quitter la scène."
                        },
                        {
                            "text": "Depuis le quai, elle m'envoyait des <w>baisers</w> de la main jusqu'au départ du train."
                        }
                    ],
                    "common_phrases": [
                        "envoyer un baiser",
                        "envoyer des baisers"
                    ]
                },
                {
                    "sense_id": "2430b4a8-767c-39f8-bce8-c8ebb48d55b4",
                    "sense_definition": "Pâtisserie faite de deux meringues superposées, spécialité de la ville belge de Malmedy, en Wallonie.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À Malmedy, nous avons goûté un <w>baiser</w> avec un café dans une pâtisserie du centre."
                        },
                        {
                            "text": "Le <w>baiser</w> est une spécialité belge que les touristes achètent souvent en souvenir."
                        }
                    ],
                    "common_phrases": [
                        "baiser de Malmedy"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Belgique, spécialité de Malmedy en Wallonie"
                        }
                    ]
                }
            ]
        },
        {
