                ],
                "senses": [
                    {
                        "sense_id": "e782c19d-6583-3fe1-95f8-a36ca83e718e",
                        "entry_id": "c87c3458-7362-325c-b9f5-3cd03cfab6bf",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3af5474a-2f3f-4db6-8c4c-dacf77d6fcad",
                                "sense_id": "e782c19d-6583-3fe1-95f8-a36ca83e718e",
                                "text": "Frau Stelzle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "27342839-ab1b-4fd9-8af3-df6871e35a18",
                                "sense_id": "e782c19d-6583-3fe1-95f8-a36ca83e718e",
                                "text": "Herr Stelzle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "4afe6434-0948-47c6-a2be-0a5ab2ec7304",
                                "sense_id": "e782c19d-6583-3fe1-95f8-a36ca83e718e",
                                "text": "Die Stelzles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "af9ae27e-54d3-4571-a8b7-514fb6fe0a03",
                                "sense_id": "e782c19d-6583-3fe1-95f8-a36ca83e718e",
                                "text": "Der Stelzle trägt nie die Schals, die die Stelzle ihm strickt."
                            },
                            {
                                "example_id": "1faf0c41-94e5-40f1-91b8-796bcc431ddb",
                                "sense_id": "e782c19d-6583-3fe1-95f8-a36ca83e718e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Stelzle kommt, geht der Herr Stelzle.“"
                            },
                            {
                                "example_id": "6a5f2b71-2f94-4f09-af1c-c3b16984a1bd",
                                "sense_id": "e782c19d-6583-3fe1-95f8-a36ca83e718e",
                                "text": "Stelzle kommt und geht."
                            },
                            {
                                "example_id": "8810eaec-4da2-4c1c-b9b8-6550ef25f022",
                                "sense_id": "e782c19d-6583-3fe1-95f8-a36ca83e718e",
                                "text": "Stelzles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
