                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Terminologie"
                    },
                    {
                        "form_id": "4d23e531-326a-4139-af53-0dea362e2515",
                        "entry_id": "7d7b3596-d7a3-3d7a-86e7-ebbbab3ac313",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Terminologien"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fd927c73-8cde-34b9-99ab-9bc52d0a9cdc",
                        "entry_id": "7d7b3596-d7a3-3d7a-86e7-ebbbab3ac313",
                        "glosses": [
                            "System von Begriffen und/oder Termini eines bestimmten Fachgebiets oder einer Wissenschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57ff7bcd-4dc3-4c8f-bf3c-e13500886922",
                                "sense_id": "fd927c73-8cde-34b9-99ab-9bc52d0a9cdc",
                                "text": "Jedes Fachgebiet hat seine eigene Terminologie."
                            },
                            {
                                "example_id": "cbfcd97e-1a64-4014-b12b-efa3cc050b9a",
                                "sense_id": "fd927c73-8cde-34b9-99ab-9bc52d0a9cdc",
                                "text": "Die Terminologie ist ein wesentlicher Teil jeder Fachsprache."
                            },
                            {
                                "example_id": "58aac05d-43ab-4b9d-b74c-0ed9c0f8eca8",
                                "sense_id": "fd927c73-8cde-34b9-99ab-9bc52d0a9cdc",
                                "text": "„Diese Terminologie spiegelt einerseits die Ausrichtung der gesamten herkömmlichen Wortforschung auf den Rahmen Sprache-Sachwelt.“"
                            },
                            {
                                "example_id": "7bd05b3e-9034-4b41-8d82-db439ea7cd62",
                                "sense_id": "fd927c73-8cde-34b9-99ab-9bc52d0a9cdc",
                                "text": "„Die französische Psychiatrie kapselte sich weitgehend auch gegenüber Impulsen aus anderen Ländern ab und pflegte ihre eigene Nosologie und Terminologie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d081a443-c2d2-496f-a01f-dff966e97b64",
                        "source_entry_id": "7d7b3596-d7a3-3d7a-86e7-ebbbab3ac313",
                        "source_sense_id": "fd927c73-8cde-34b9-99ab-9bc52d0a9cdc",
                        "source_sense_description": "System von Begriffen und/oder Termini eines bestimmten Fachgebiets oder einer Wissenschaft",
                        "target_lang_word": "terminology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "terminology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e54f1fb9-9133-3c32-8c06-f1fab4b6e2a4",
                                        "entry_id": "e0a4d490-c233-3c7a-8334-aa517ffe52f3",
                                        "glosses": [
                                            "A treatise on terms, especially those used in a specialised field."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "40bb22fb-4df3-3f19-abac-d9b6f2207c73",
                                        "entry_id": "e0a4d490-c233-3c7a-8334-aa517ffe52f3",
                                        "glosses": [
                                            "The set of terms actually used in any business, art, science, or the like; nomenclature; technical terms."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b497db8f-124f-4d49-a62e-5fb132e0384f",
                                                "sense_id": "40bb22fb-4df3-3f19-abac-d9b6f2207c73",
                                                "text": "Ad for advertisement is struggling hard for general recognition; some of its compounds, e. g., ad-writer, want-ad, display-ad, ad-card, ad-rate, column-ad and ad-man, are already accepted in technical terminology."
                                            },
                                            {
                                                "example_id": "d562cd69-ddd3-4c6a-b6f1-8cf6e67f975f",
                                                "sense_id": "40bb22fb-4df3-3f19-abac-d9b6f2207c73",
                                                "text": "[The researchers] noticed many of their pieces of [plastic marine] debris sported surface pits around two microns across.[…]Closer examination showed that some of these pits did, indeed, contain bacteria, and that in several cases these bacteria were dividing and thus, by the perverse arithmetic of biological terminology, multiplying."
                                            },
                                            {
                                                "example_id": "3e15a64a-11b4-4af3-a571-7116fdca4297",
                                                "sense_id": "40bb22fb-4df3-3f19-abac-d9b6f2207c73",
                                                "text": "Language is always changing — but it shouldn’t become inflexible, especially when new terminologies, in the name of inclusion, sometimes wind up making others feel excluded."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "031c56ce-bec8-336f-bdc5-3bc18ebf30f6",
                                        "entry_id": "e0a4d490-c233-3c7a-8334-aa517ffe52f3",
                                        "glosses": [
                                            "The scientific study of such terms."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d184d2a-dbae-4797-a78c-350897f62095",
                        "source_entry_id": "7d7b3596-d7a3-3d7a-86e7-ebbbab3ac313",
                        "source_sense_id": "fd927c73-8cde-34b9-99ab-9bc52d0a9cdc",
                        "source_sense_description": "System von Begriffen und/oder Termini eines bestimmten Fachgebiets oder einer Wissenschaft",
                        "target_lang_word": "terminologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "terminologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8e57684b-e9b7-3c79-b918-5ac4849a0db6",
                                        "entry_id": "08a39fe8-a9ab-3b84-9141-9a998ed86f7d",
                                        "glosses": [
                                            "Ensemble des termes techniques, d’une science, d’un art ou d’un domaine donné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a16fbf82-4c35-4e1e-8b36-12ac5f1139de",
                                                "sense_id": "8e57684b-e9b7-3c79-b918-5ac4849a0db6",
                                                "text": "Il nous a semblé superflu, au début de ce chapitre, de rappeler la terminologie employée par l’École zuricho-montpelliéraine […]"
                                            },
                                            {
                                                "example_id": "c1f4b848-42e6-4686-a2d1-4ecd4b89e96e",
                                                "sense_id": "8e57684b-e9b7-3c79-b918-5ac4849a0db6",
                                                "text": "La philosophie de Scot Érigène fut mal accueillie. La nouveauté et l’incertitude de sa terminologie néo-platonicienne le firent prendre pour un panthéiste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87bade8f-6681-3291-82c6-f0db9cc59ca6",
                                        "entry_id": "08a39fe8-a9ab-3b84-9141-9a998ed86f7d",
                                        "glosses": [
                                            "Art de repérer, d’analyser et, au besoin, de créer (→ voir néologie) le vocabulaire pour une technique donnée, dans une situation concrète de fonctionnement de façon à répondre aux besoins d’expression de l’usager."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96dc1c3b-f471-44b3-8db8-14a8e5428ba6",
                                                "sense_id": "87bade8f-6681-3291-82c6-f0db9cc59ca6",
                                                "text": "Les besoins de description relient la terminologie au discours didactique sur chaque domaine et donc à la science, à la technologie […] ceux de diffusion aussi, ainsi qu’à la pédagogie, à la traduction ; ceux de normalisation aux théories de la connaissance, à la sociolinguistique, et encore à la traduction et à la lexicographie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a95016f2-0f03-3113-837e-5b620b6511c7",
                                        "entry_id": "08a39fe8-a9ab-3b84-9141-9a998ed86f7d",
                                        "glosses": [
                                            "Idiolecte spécifique à un auteur, à un penseur, à un courant de pensée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "155341dd-5a2f-48e6-9f97-40d36430c3bf",
                                                "sense_id": "a95016f2-0f03-3113-837e-5b620b6511c7",
                                                "text": "Tout le monde se plaint de ce que les discussions relatives au socialisme soient généralement fort obscures ; cette obscurité tient, pour une grande partie, à ce que les écrivains socialistes actuels emploient une terminologie qui ne correspond plus généralement à leurs idées."
                                            },
                                            {
                                                "example_id": "197692dd-2a3a-47ca-83cc-840773f18d26",
                                                "sense_id": "a95016f2-0f03-3113-837e-5b620b6511c7",
                                                "text": "Dans le premier cas, on parlera de pathologie de l'administration, de bureaupathologie ou, pour emprunter la terminologie de K. MERTON, de dysfonctions administratives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de33cf7f-0aee-3d2c-a610-744ef3617ae8",
                                        "entry_id": "08a39fe8-a9ab-3b84-9141-9a998ed86f7d",
                                        "glosses": [
                                            "Sociolecte, ensemble des termes, des expressions propres à une région, à un groupe social."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f343c3fe-ea18-4781-b5a3-efbe2d4ea89f",
                                                "sense_id": "de33cf7f-0aee-3d2c-a610-744ef3617ae8",
                                                "text": "Terminologie populaire."
                                            },
                                            {
                                                "example_id": "2f5d5a52-8c5a-46ac-9f3a-2d4fc66fc84b",
                                                "sense_id": "de33cf7f-0aee-3d2c-a610-744ef3617ae8",
                                                "text": "Marat […] avait loué dès 42, lorsqu’il commençait à « faire de la résistance », une maison de maître accotée à une ferme, un château selon la terminologie de la région."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
