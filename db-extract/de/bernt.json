                ],
                "senses": [
                    {
                        "sense_id": "3f0bcc00-62e5-3ffe-804a-201d1b2057df",
                        "entry_id": "6edafd60-fa20-3145-ab07-7b932efe3c63",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6d2d5a4-7ba7-4ee6-a2c5-f41d183fe07a",
                                "sense_id": "3f0bcc00-62e5-3ffe-804a-201d1b2057df",
                                "text": "Frau Bernt ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "252040b0-257a-4594-9ed9-999c2c7b0c85",
                                "sense_id": "3f0bcc00-62e5-3ffe-804a-201d1b2057df",
                                "text": "Herr Bernt wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b5e0e92f-1c5c-4eee-9f82-a76f38a3fce2",
                                "sense_id": "3f0bcc00-62e5-3ffe-804a-201d1b2057df",
                                "text": "Die Bernts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "6c816f38-eacc-450b-bd47-dfb35e904dfe",
                                "sense_id": "3f0bcc00-62e5-3ffe-804a-201d1b2057df",
                                "text": "Der Bernt trägt nie die Schals, die die Bernt ihm strickt."
                            },
                            {
                                "example_id": "19b88927-9789-42a6-a4c9-84b32f896ae0",
                                "sense_id": "3f0bcc00-62e5-3ffe-804a-201d1b2057df",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bernt kommt, geht der Herr Bernt.“"
                            },
                            {
                                "example_id": "4046716b-098a-4c6c-9def-d2be9fb3b43c",
                                "sense_id": "3f0bcc00-62e5-3ffe-804a-201d1b2057df",
                                "text": "Bernt kommt und geht."
                            },
                            {
                                "example_id": "b238910e-6521-40c9-9cc1-34e8d7e1cac2",
                                "sense_id": "3f0bcc00-62e5-3ffe-804a-201d1b2057df",
                                "text": "Bernts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
