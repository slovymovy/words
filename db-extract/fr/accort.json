                ],
                "senses": [
                    {
                        "sense_id": "4eef0618-35a4-3476-8aa4-b1b885df52a1",
                        "entry_id": "96c71dce-0ce8-33a4-bfff-02fb915a0698",
                        "glosses": [
                            "Qui est avenant, qui agrée."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "83e6ac34-1a00-445e-852e-3a6143c162c9",
                                "sense_id": "4eef0618-35a4-3476-8aa4-b1b885df52a1",
                                "text": "Un homme de village est toujours mal accort."
                            },
                            {
                                "example_id": "acd064c2-8527-449f-9115-2c486f422ff8",
                                "sense_id": "4eef0618-35a4-3476-8aa4-b1b885df52a1",
                                "text": "Une servante accorte avait apporté le thé."
                            },
                            {
                                "example_id": "8f8c6b71-1790-4bc9-a0ed-801250b2f4b0",
                                "sense_id": "4eef0618-35a4-3476-8aa4-b1b885df52a1",
                                "text": "Rigott était une petite vieille accorte, un peu grasse, aux splendides bandeaux d'argent ; éternellement vêtue d'une robe de surah noir, copieusement blindée de passementeries anciennes."
                            },
                            {
                                "example_id": "bf4241f6-d418-4c7f-9d10-dd44e5c9b302",
                                "sense_id": "4eef0618-35a4-3476-8aa4-b1b885df52a1",
                                "text": "A peine entré dans le commerce, c’est comme si une alarme retentissait dans l’esprit de l’accorte boulangère. Ses cervicales gyroscopiques se tournent alors vers nous et, avec un grand sourire, elle émet généralement une phrase du type : « Ohoho, je crois qu’il y a des enfants par ici ! Vous voulez une chouquette, les loulous ? »"
                            }
                        ]
                    },
                    {
                        "sense_id": "7bd7fe2a-7f01-3889-a141-aa5fb13b797c",
                        "entry_id": "96c71dce-0ce8-33a4-bfff-02fb915a0698",
                        "glosses": [
                            "Habile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a0e7453-027d-4de3-b995-145e4fe7ec96",
                                "sense_id": "7bd7fe2a-7f01-3889-a141-aa5fb13b797c",
                                "text": "il estoit si accort & si inuentif, qu'incontinent qu'il fut à deux ietz d'arc de la ville, trouua façon d'auoir vne iument"
                            }
                        ]
                    }
                ],
