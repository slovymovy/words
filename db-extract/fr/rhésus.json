                "senses": [
                    {
                        "sense_id": "a66d9e39-5da3-3861-8197-2a74bff325a2",
                        "entry_id": "c2bbc5fe-7cef-3a46-acca-0c0b323d7b4d",
                        "glosses": [
                            "Dieu-fleuve de la mythologie grecque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62929b4b-64ac-466b-93dc-f5be5aad1f67",
                                "sense_id": "a66d9e39-5da3-3861-8197-2a74bff325a2",
                                "text": "Téthys donna à l’Océan des Fleuves au cours sinueux, le Nil, l’Alphée, l’Éridan aux gouffres profonds, le Strymon, le Méandre, l’Ister aux belles eaux, le Phase, le Rhésus, l’Achéloüs aux flots argentés, le Nessus, le Rhodius, l’Haliacmon, l’Heptapore, le Granique, l’Ésépus, le divin Simoïs, le Pénée, l’Hermus, le Caïque aux ondes gracieuses, le large Sangarius, le Ladon, le Parthénius, l’Événus, l’Ardesque et le divin Scamandre."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "34b1c8be-c6e0-3931-84c4-372c29d5962e",
                "word": "rhésus",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6b1bb85c-7617-3201-99cf-b486f807193a",
                        "entry_id": "34b1c8be-c6e0-3931-84c4-372c29d5962e",
                        "glosses": [
                            "Macaque rhésus (Macaca mulatta) ou singe rhésus ou bandar, l’une des espèces de singes les plus connues de l’Ancien monde, commune en Afghanistan, Inde septentrionale et Chine méridionale, et souvent utilisée comme animal de laboratoire."
                        ],
                        "tags": [
                            "Primatologie"
                        ],
                        "examples": [
                            {
                                "example_id": "906aede7-2d26-4aef-b2a5-4ba3b510b8bc",
                                "sense_id": "6b1bb85c-7617-3201-99cf-b486f807193a",
                                "text": "ANDi, rhésus porteur d’un gène (protéine vert fluorescent) emprunté à la méduse, d’où son nom ANDi pour ADN inséré, est le premier primate transgénique."
                            }
                        ]
                    },
                    {
                        "sense_id": "782dcd6f-e198-3e67-ab3a-b7954436747c",
                        "entry_id": "34b1c8be-c6e0-3931-84c4-372c29d5962e",
                        "glosses": [
                            "Antigène présent (rhésus positif, symbole Rh+) ou absent (rhésus négatif, symbole Rh-) dans les globules rouges du sang, ce qui détermine le groupe sanguin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d521485-cd62-4f08-8e71-6103b323d6df",
                                "sense_id": "782dcd6f-e198-3e67-ab3a-b7954436747c",
                                "text": "Une femme de rhésus négatif élabore un anticorps anti-rhésus (agglutinine irrégulière) si l’enfant qu’elle porte est de rhésus positif."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b0806045-4671-45fd-bbc2-a46a02baeabc",
                        "source_entry_id": "34b1c8be-c6e0-3931-84c4-372c29d5962e",
                        "source_sense_description": "Macaque",
                        "target_lang_word": "Rhesusaffe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rhesusaffe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2f47e113-b065-3c7c-93f8-a34aa115d7af",
                                        "entry_id": "81f7bedb-851d-378b-a314-3d329debe859",
                                        "glosses": [
                                            "eine Art der Makaken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69981c66-4065-4feb-a95f-d700bc494aaa",
                                                "sense_id": "2f47e113-b065-3c7c-93f8-a34aa115d7af",
                                                "text": "„Jetzt sind es bereits drei: Nach Mensch und Schimpanse liegt mit dem Rhesusaffen das dritte entzifferte Erbgut eines Primaten vor. Es gewährt nicht nur Einblicke in die Evolution dieser Säugetierordnung, sondern zeigt auch, was den Mensch zum Menschen macht.“"
                                            },
                                            {
                                                "example_id": "425fc733-a9cf-4915-aaba-9a49349dccde",
                                                "sense_id": "2f47e113-b065-3c7c-93f8-a34aa115d7af",
                                                "text": "„Dass dieses Charakteristikum des menschlichen Blutes auf Erkenntnisse aus Tierversuchen mit Affen zurückgeht, sagt schon der Name: Rhesusfaktor leitet sich vom Rhesusaffen (Macaca mulatta) ab. Diese Affen weisen den Faktor ebenfalls auf und der Name geht auf die Verwendung von Erythrozyten (rote Blutkörperchen) aus dem Blut von Rhesusaffen für die Gewinnung der ersten Testseren zurück“"
                                            },
                                            {
                                                "example_id": "20fa5dc3-e6fd-4907-af2a-268b184bfd07",
                                                "sense_id": "2f47e113-b065-3c7c-93f8-a34aa115d7af",
                                                "text": "„Am selben Forschungsinstitut gelang es, einen geklonten Rhesusaffen gesund auf die Welt zu bringen. Das teilte die Forschungsgruppe nun im Fachblatt Nature Communications mit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
