                        "sense_id": "de465f5f-db41-3db3-803e-f7a7f5c5ade3",
                        "entry_id": "cb13f05f-7dc9-3fd6-b60f-8c1ea0f0e50a",
                        "glosses": [
                            "besonders widerstandsfähiger, PVC-beschichteter Stoff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c41d24ee-2d04-4308-ab89-166363e9c157",
                                "sense_id": "de465f5f-db41-3db3-803e-f7a7f5c5ade3",
                                "text": "Der blaue Planenstoff dort drüben mit glatter Oberfläche hat eine Kunststoffbeschichtung und besteht zu 100% aus Polyester. Er weist eine hohe Reißfestigkeit auf."
                            },
                            {
                                "example_id": "7ff287e6-100d-4d77-a3a0-54ad39f38a24",
                                "sense_id": "de465f5f-db41-3db3-803e-f7a7f5c5ade3",
                                "text": "„Alles verloren: Er und seine Geschwister trugen Hosen, die ihre Mutter aus selbstgeklauten Planenstoffen der englischen Militärlastwagen genäht hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
