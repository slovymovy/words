                "senses": [
                    {
                        "sense_id": "f6ae83b0-6eb9-3425-88c0-156be0b5cbab",
                        "entry_id": "6f34fc6c-d6a8-38f7-a88d-fdfd6ea123e4",
                        "glosses": [
                            "Haus, das in der Fabrik vorgefertigt und auf der Baustelle nur noch montiert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ce27bd9-87bc-43ed-9970-04816aa5c7ec",
                                "sense_id": "f6ae83b0-6eb9-3425-88c0-156be0b5cbab",
                                "text": "„Ein Fertighaus zeichnet sich dadurch aus, dass es aus Einzelbauteilen besteht, die industriell in einem Werk vorgefertigt werden.“"
                            },
                            {
                                "example_id": "7dcc2452-c254-4525-aae2-b186c662b39a",
                                "sense_id": "f6ae83b0-6eb9-3425-88c0-156be0b5cbab",
                                "text": "Gespräche mit 69 potenziellen Investoren haben nicht geholfen: Der Fertighaus-Hersteller Kampa ist insolvent."
                            },
                            {
                                "example_id": "578b5f2b-6027-4fc4-9a44-b0f8fed4e7f9",
                                "sense_id": "f6ae83b0-6eb9-3425-88c0-156be0b5cbab",
                                "text": "Bei deutschen Häuslebauern stehen Fertighäuser aus Polen derzeit hoch im Kurs."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
