{
    "word": "stirrer",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "275f4196-4422-3cc2-aa16-dccf5a226481",
                "word": "stirrer",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ad2d6680-f012-412c-9739-952738cb66fb",
                        "entry_id": "275f4196-4422-3cc2-aa16-dccf5a226481",
                        "tags": [
                            "plural"
                        ],
                        "form": "stirrers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ef9e6740-e2a5-3c4a-93e3-7a9bba807b03",
                        "entry_id": "275f4196-4422-3cc2-aa16-dccf5a226481",
                        "glosses": [
                            "A device used to stir. (Cardinal types include wood or plastic strips (for beverages) and magnetic objects that react to a spinning magnet nearby (for chemistry beakers)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ca2aea1-3f2c-4917-af9e-07d9f0595334",
                                "sense_id": "ef9e6740-e2a5-3c4a-93e3-7a9bba807b03",
                                "text": "We're out of coffee stirrers again and I'm not using my finger!"
                            }
                        ]
                    },
                    {
                        "sense_id": "cd44997c-41f7-3ae5-80b5-02e73316cee0",
                        "entry_id": "275f4196-4422-3cc2-aa16-dccf5a226481",
                        "glosses": [
                            "A person who stirs something."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "086ccdfc-8c56-4ab3-9672-fd4df82063fb",
                                "sense_id": "cd44997c-41f7-3ae5-80b5-02e73316cee0",
                                "text": "The stirrers in the chocolate factory often get chocolate all over their uniforms."
                            }
                        ]
                    },
                    {
                        "sense_id": "c82afb97-0c1c-3281-a8e5-140b2152f50d",
                        "entry_id": "275f4196-4422-3cc2-aa16-dccf5a226481",
                        "glosses": [
                            "A person who spreads rumours or causes agitation."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "0838e2da-052d-4a03-9723-85c273497c0b",
                                "sense_id": "c82afb97-0c1c-3281-a8e5-140b2152f50d",
                                "text": "Near-synonyms: (vulgar) shit-stirrer, shit disturber, shitmonger"
                            },
                            {
                                "example_id": "c76478bd-fdd6-4f00-ac04-55795d8dfdf2",
                                "sense_id": "c82afb97-0c1c-3281-a8e5-140b2152f50d",
                                "text": "Why would you say something so hurtful? God, you are such a stirrer!"
                            }
                        ]
                    },
                    {
                        "sense_id": "382ada44-d570-3f51-ad1d-25de01258e37",
                        "entry_id": "275f4196-4422-3cc2-aa16-dccf5a226481",
                        "glosses": [
                            "One who stirs or moves about, as after sleep."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee97972f-f683-4269-b9bc-9de145af479f",
                                "sense_id": "382ada44-d570-3f51-ad1d-25de01258e37",
                                "text": "I heard some early stirrers in the kitchen at dawn, but I saw no reason to get up yet."
                            },
                            {
                                "example_id": "59a1ad3e-dd16-494f-b06e-2acfa8f5a9dd",
                                "sense_id": "382ada44-d570-3f51-ad1d-25de01258e37",
                                "text": "An early stirrer, by the rood!"
                            }
                        ]
                    }
                ],
                "translations": [],
