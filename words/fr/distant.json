                {
                    "sense_id": "761abdba-c63e-3a61-a629-d16b3e4d6f53",
                    "sense_definition": "Qui est situé sur un autre site géographique et accessible par un réseau informatique ou de télécommunication.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "informatique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'employé s'est connecté à un serveur <w>distant</w> pour récupérer ses fichiers.",
                            "target_lang_translations": {
                                "en": "The employee logged in to a <w>remote</w> server to retrieve their files.",
                                "ru": "Сотрудник подключился к <w>удалённому</w> серверу, чтобы получить свои файлы.",
                                "de": "Der Angestellte hat sich mit einem <w>entfernten</w> Server verbunden, um seine Dateien abzurufen.",
                                "es": "El empleado se conectó a un servidor <w>remoto</w> para recuperar sus archivos.",
                                "zh": "这名员工登录了一台<w>远程</w>服务器，以便取回他的文件。"
                            }
                        },
                        {
                            "text": "La sauvegarde automatique des données est effectuée sur un site <w>distant</w>.",
                            "target_lang_translations": {
                                "en": "Automatic data backup is carried out at a <w>remote</w> site.",
                                "ru": "Автоматическое резервное копирование данных выполняется на <w>удалённом</w> сайте.",
                                "de": "Die automatische Datensicherung erfolgt auf einem <w>entfernten</w> Standort.",
                                "es": "La copia de seguridad automática de los datos se realiza en un sitio <w>remoto</w>.",
                                "zh": "数据的自动备份是在<w>异地</w>站点上进行的。"
                            }
                        }
