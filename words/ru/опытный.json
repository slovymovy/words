            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f8f100aa-4edd-3681-8634-f6a4ae353975",
                    "sense_definition": "Обладающий большим опытом, делающий что-либо не в первый раз.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "experienced",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "При слабом свете на короткой дистанции <w>опытный</w> стрелок с лёгкостью поражает цель размером с человеческий силуэт."
                        },
                        {
                            "text": "Наш <w>опытный</w> врач быстро поставил правильный диагноз и назначил лечение."
                        }
                    ],
                    "synonyms": [
                        "бывалый",
                        "искушённый",
                        "матёрый",
                        "тёртый",
                        "умудрённый"
                    ],
                    "antonyms": [
                        "неопытный",
                        "начинающий"
                    ],
                    "common_phrases": [
                        "опытный специалист",
                        "опытный мастер",
                        "опытный водитель"
                    ]
                },
                {
                    "sense_id": "fdec4e22-6ccd-3bbf-ba71-c0f26aaecc91",
                    "sense_definition": "Относящийся к проведению экспериментов или научных опытов.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "experimental",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Сочинская сельскохозяйственная <w>опытная</w> станция занимается изучением новых сортов растений."
                        },
                        {
                            "text": "На этом <w>опытном</w> участке учёные проверяют эффективность новых удобрений."
                        }
                    ],
                    "synonyms": [
                        "экспериментальный"
                    ],
                    "antonyms": [
                        "производственный",
                        "промышленный",
                        "поточный",
                        "серийный"
                    ],
                    "common_phrases": [
                        "опытная станция",
                        "опытный участок"
                    ]
                },
                {
                    "sense_id": "bd40122d-ea71-37e9-9109-d569faa7224f",
                    "sense_definition": "Пробный, предназначенный для испытаний или проверки в действии.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "experimental",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Менее чем за три месяца <w>опытный</w> образец танка был собран и испытан на полигоне."
                        },
                        {
                            "text": "Инженеры представили <w>опытный</w> двигатель для проверки его мощности в экстремальных условиях."
                        }
                    ],
                    "synonyms": [
                        "пробный",
                        "тестовый",
                        "экспериментальный"
                    ],
                    "antonyms": [
                        "серийный"
                    ],
                    "common_phrases": [
