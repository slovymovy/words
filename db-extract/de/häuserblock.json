                    }
                ],
                "senses": [
                    {
                        "sense_id": "0a566208-75ae-3e30-8b1a-4886925b7e34",
                        "entry_id": "1dfe1fcc-0449-3c2b-8ccc-3bf5bb7e57f4",
                        "glosses": [
                            "Ensemble zusammenstehender Häuser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f13ad19f-90c1-46a4-9045-54347bdf577a",
                                "sense_id": "0a566208-75ae-3e30-8b1a-4886925b7e34",
                                "text": "„Er strömte von einem kleinen Seitenschacht her, der auf die leeren Grundmauern eines Häuserblocks mündete.“"
                            },
                            {
                                "example_id": "470735ce-b975-4bf9-b7cd-9b54b9b49583",
                                "sense_id": "0a566208-75ae-3e30-8b1a-4886925b7e34",
                                "text": "„Die Türen der Häuser durften nicht abgeschlossen sein, damit der Blockwart, eine Art Hausmeister mit Aufsichtspflichten, der meistens für mehrere Häuser oder einen ganzen Häuserblock zuständig war, überall Zutritt hatte.“"
                            },
                            {
                                "example_id": "4ec2335b-08b0-4a3a-a488-6de1fef34fc2",
                                "sense_id": "0a566208-75ae-3e30-8b1a-4886925b7e34",
                                "text": "„Ihr Zufluchtsort lag nur zwei Häuserblöcke weiter, und doch schien die Entfernung unüberwindlich.“"
                            },
                            {
                                "example_id": "586c3d2f-c36d-42d2-a966-f40713228a52",
                                "sense_id": "0a566208-75ae-3e30-8b1a-4886925b7e34",
                                "text": "„In vielen Fällen war sogar das Hauptrohr, das den ganzen Häuserblock mit Wasser versorgte, zugefroren oder geplatzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b2c8671-0a6f-4102-821c-59592d1fc12f",
                        "source_entry_id": "1dfe1fcc-0449-3c2b-8ccc-3bf5bb7e57f4",
                        "source_sense_id": "0a566208-75ae-3e30-8b1a-4886925b7e34",
                        "source_sense_description": "Ensemble zusammenstehender Häuser",
                        "target_lang_word": "pâté de maisons",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pâté de maisons",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cbd319af-0fd6-32a0-b3c8-aa8107bb1f2f",
                                        "entry_id": "d00524d9-8b8e-3a8d-988c-0742ea65c01a",
                                        "glosses": [
                                            "Petit groupe de maisons ou d’autres bâtiments, délimité par une ou plusieurs voiries, ou d’autres éléments urbanistiques."
                                        ],
                                        "tags": [
                                            "Urbanisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ef3f829-afce-4329-a4c5-46c9fa9480a0",
                                                "sense_id": "cbd319af-0fd6-32a0-b3c8-aa8107bb1f2f",
                                                "text": "Ce programme de politique publique, – le Plan Vida – a été mis en œuvre avec l’aide bénévole de femmes habitant dans les quartiers concernés par le programme, qui distribuent une aide sociale aux familles de leur pâté de maisons, d’où le nom qui leur a été donné : les « manzaneras »."
                                            },
                                            {
                                                "example_id": "79651987-f82f-419d-8dd1-8e0b60018b0a",
                                                "sense_id": "cbd319af-0fd6-32a0-b3c8-aa8107bb1f2f",
                                                "text": "Le capricieux ravin des rues ne coupait pas ce pâté de maisons en tranches trop disproportionnées."
                                            },
                                            {
                                                "example_id": "ab5e7b0d-9d65-4acd-8c24-d32340b0340b",
                                                "sense_id": "cbd319af-0fd6-32a0-b3c8-aa8107bb1f2f",
                                                "text": "Ce pâté de maisons s’écroula en partie au commencement de 1795 ; personne ne périt, mais un jeune homme infirme et valétudinaire y courut le plus grand danger ; …"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
