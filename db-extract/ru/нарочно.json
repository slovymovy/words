                ],
                "senses": [
                    {
                        "sense_id": "cc367ac2-1b6d-34d7-9d0d-98c1d02a67c6",
                        "entry_id": "c104ff34-0e63-3946-8b37-57d706436b57",
                        "glosses": [
                            "умышленно, с определённой целью"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e31b573-2151-421e-bc1c-2d3c2de0a61f",
                                "sense_id": "cc367ac2-1b6d-34d7-9d0d-98c1d02a67c6",
                                "text": "Мы нарочно не указываем названия магазинов, упомянутых нашими корреспондентами: подобных нареканий со стороны покупателей не избежал ни один из крупных российских магазинов."
                            }
                        ]
                    },
                    {
                        "sense_id": "5ffa8b54-144a-3d50-8c49-5e1ca6adb074",
                        "entry_id": "c104ff34-0e63-3946-8b37-57d706436b57",
                        "glosses": [
                            "устар. исключительно ради кого-либо, чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39649d32-f913-48ba-959d-7c89e23366a6",
                                "sense_id": "5ffa8b54-144a-3d50-8c49-5e1ca6adb074",
                                "text": "Отсюда князь Пожарский и Косма Минин нарочно отправились в Борисоглебский монастырь, чтобы лично получить благословение от старца Иринарха."
                            }
                        ]
                    },
                    {
                        "sense_id": "71919072-601b-3aad-99a2-d3dbf0d3a1e8",
                        "entry_id": "c104ff34-0e63-3946-8b37-57d706436b57",
                        "glosses": [
                            "вопреки желанию кого-либо; назло"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "34072ac8-fc8a-3b3c-a61f-2ca1c59c426d",
                        "entry_id": "c104ff34-0e63-3946-8b37-57d706436b57",
                        "glosses": [
                            "разг. для вида, для видимости, не всерьёз"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "18d2d253-8e1f-4f4f-b9ea-d9e3ca0a8e74",
                        "source_entry_id": "c104ff34-0e63-3946-8b37-57d706436b57",
                        "source_sense_description": "с целью",
                        "target_lang_word": "vorsätzlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vorsätzlich",
