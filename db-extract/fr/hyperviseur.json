                "senses": [
                    {
                        "sense_id": "d9a34612-8972-3bc5-ba1b-1e9e397342f5",
                        "entry_id": "0b5aa3a9-8a5a-3df1-a6c5-a24e07bbe4fd",
                        "glosses": [
                            "Plate-forme de virtualisation qui permet à plusieurs systèmes d’exploitation de travailler sur une ou plusieurs machines physiques en même temps, et qui assume également les fonctions de gestion de réseau de base entre eux, et prend en charge des logiciels d’administration tiers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1783c95-8739-446a-a763-66fb4d75e3f9",
                                "sense_id": "d9a34612-8972-3bc5-ba1b-1e9e397342f5",
                                "text": "Un hyperviseur est une couche logicielle située entre le matériel et les systèmes d'exploitation des machines invitées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
