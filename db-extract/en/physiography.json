                "senses": [
                    {
                        "sense_id": "7dc3b5cf-78ef-3fef-b558-e88c03d14fcf",
                        "entry_id": "1bdaa98a-78a1-3144-8c1c-5161006f0ba6",
                        "glosses": [
                            "The subfield of geography that studies physical patterns and processes of the Earth. It aims to understand the forces that produce and change rocks, oceans, weather, and global flora and fauna patterns."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b6bf0e5d-52d9-40b1-ace5-4015423c9953",
                                "sense_id": "7dc3b5cf-78ef-3fef-b558-e88c03d14fcf",
                                "text": "Questions that bewilder the globe student of seasons are easily answered by pupils who have been taught seasons by the globeless method, as the writer knows from experience with three classes, two in astronomy and one in physiography."
                            }
                        ]
                    },
                    {
                        "sense_id": "fb666911-918b-34d1-b796-3ccb316ead1f",
                        "entry_id": "1bdaa98a-78a1-3144-8c1c-5161006f0ba6",
                        "glosses": [
                            "The descriptive part of a natural science as distinguished from the explanatory or theoretical part."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "757f3f0b-a09c-41dd-93cd-a8496ce59cc0",
                                "sense_id": "fb666911-918b-34d1-b796-3ccb316ead1f",
                                "text": "mineral physiography"
                            }
                        ]
                    }
                ],
                "translations": [
