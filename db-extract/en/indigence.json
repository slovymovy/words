                "senses": [
                    {
                        "sense_id": "a6ab48fb-b41b-3d0d-a567-f83809baee58",
                        "entry_id": "2f061f31-8fea-3792-91f6-8cebe2f42999",
                        "glosses": [
                            "Extreme poverty or destitution."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d0e86081-9777-4d53-b205-951e44e1f4fa",
                                "sense_id": "a6ab48fb-b41b-3d0d-a567-f83809baee58",
                                "text": "On Professor Solanka’s street, well-heeled white youths lounged in baggy garments on roseate stoops, stylishly simulating indigence while they waited for the billionairedom that would surely be along sometime soon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d42dd0ec-839b-431f-9cd3-6973ea47420e",
                        "source_entry_id": "2f061f31-8fea-3792-91f6-8cebe2f42999",
                        "source_sense_id": "a6ab48fb-b41b-3d0d-a567-f83809baee58",
                        "source_sense_description": "poverty",
                        "target_lang_word": "behoeftigheid",
