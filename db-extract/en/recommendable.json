                    {
                        "translation_id": "c5f14560-b924-4e9b-acf4-64fd37b7f51d",
                        "source_entry_id": "d7fe13e0-b14e-3bca-86f5-477f831ce955",
                        "source_sense_id": "41cbcb07-ad15-366b-b084-fd62610a9b08",
