{
    "word_family": [
        "ladleful"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3f9b60fe-788a-379a-9029-f8daf4fd3260",
                    "sense_definition": "A deep-bowled spoonlike utensil with a long, usually curved, handle.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "kitchen_utensils",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She used a large <w>ladle</w> to serve the hot vegetable soup into the bowls.",
                            "target_lang_translations": {
                                "ru": "Она использовала большой <w>половник</w>, чтобы разлить горячий овощной суп по тарелкам."
                            }
                        },
                        {
                            "text": "Please leave the <w>soup</w> <w>ladle</w> in the pot so everyone can help themselves.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, оставь <w>половник</w> в кастрюле, чтобы каждый мог налить себе сам."
                            }
                        }
                    ],
                    "synonyms": [
                        "dipper"
                    ],
                    "common_phrases": [
                        "soup ladle",
                        "wooden ladle",
                        "stainless steel ladle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кухонная принадлежность в виде большой глубокой ложки с длинной ручкой для разливания жидкой пищи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "половник",
                                "target_lang_sense_clarification": "основное название кухонной принадлежности"
                            },
                            {
                                "target_lang_word": "черпак",
                                "target_lang_sense_clarification": "более грубое или техническое название большой ложки"
                            },
                            {
                                "target_lang_word": "поварёшка",
                                "target_lang_sense_clarification": "разговорное название"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c738ea16-2147-382c-b126-40958cd1dab0",
                    "sense_definition": "A container used in a foundry to transport and pour out molten metal.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "industrial_containers",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers carefully moved the <w>ladle</w> filled with glowing molten iron across the factory floor.",
                            "target_lang_translations": {
                                "ru": "Рабочие осторожно перемещали по цеху <w>ковш</w>, наполненный раскаленным расплавленным железом."
                            }
                        },
                        {
                            "text": "A mechanical arm tilted the <w>ladle</w> to pour the liquid steel into the mold.",
                            "target_lang_translations": {
                                "ru": "Механическая рука наклонила <w>ковш</w>, чтобы залить жидкую сталь в форму."
                            }
                        }
                    ],
                    "common_phrases": [
                        "foundry ladle",
                        "casting ladle"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Специальный огнеупорный сосуд, используемый в металлургии для транспортировки и разливки расплавленного металла."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ковш",
                                "target_lang_sense_clarification": "сталеразливочный или литейный"
                            },
                            {
                                "target_lang_word": "черпак",
                                "target_lang_sense_clarification": "в контексте ручного перемещения металла"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48137bd6-6380-30cd-981f-76b1b78bf49f",
                    "sense_definition": "The float or board of a mill wheel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mill_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The water hit each <w>ladle</w> of the wheel, providing the power needed to grind the grain.",
                            "target_lang_translations": {
                                "ru": "Вода ударяла в каждую <w>лопасть</w> колеса, обеспечивая энергию, необходимую для помола зерна."
                            }
                        },
                        {
                            "text": "The old mill's <w>ladle</w> board was starting to rot after decades of constant use.",
                            "target_lang_translations": {
                                "ru": "Доска <w>лопасти</w> старой мельницы начала гнить после десятилетий постоянного использования."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ladle board"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "mechanical engineering"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лопасть или доска водяного колеса мельницы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лопасть",
                                "target_lang_sense_clarification": "часть колеса, на которую падает вода"
                            },
                            {
                                "target_lang_word": "ковш",
                                "target_lang_sense_clarification": "углубление на колесе для воды"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2a0c85d4-30e4-3dc6-8d15-e8d60c2af3f4",
                    "sense_definition": "To pour or serve something with a ladle.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "serving_actions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The host <w>ladled</w> the soup into her guests' bowls while it was still steaming.",
                            "target_lang_translations": {
                                "ru": "Хозяйка <w>разливала</w> суп по тарелкам гостей, пока он еще дымился."
                            }
                        },
                        {
                            "text": "He began to <w>ladle</w> <w>out</w> the stew for the hungry children standing in line.",
                            "target_lang_translations": {
                                "ru": "Он начал <w>раскладывать</w> рагу голодным детям, стоящим в очереди."
                            }
                        }
                    ],
                    "common_phrases": [
                        "ladle out",
                        "ladle into"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наливать или подавать еду с помощью половника."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разливать",
                                "target_lang_sense_clarification": "суп или другую жидкость по тарелкам"
                            },
                            {
                                "target_lang_word": "черпать",
                                "target_lang_sense_clarification": "набирать что-либо жидкое"
                            },
                            {
                                "target_lang_word": "накладывать",
                                "target_lang_sense_clarification": "подавать густую еду половником"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}