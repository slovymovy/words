                "entry_id": "be8a5765-f542-39f2-87eb-a592b8735f54",
                "word": "patronnesse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5af03f09-1d1f-48df-93d4-6c2c42a31c8b",
                        "entry_id": "be8a5765-f542-39f2-87eb-a592b8735f54",
