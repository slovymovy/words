                "senses": [
                    {
                        "sense_id": "c02b96d4-2e61-34ae-80b2-3b7cd6c1d74e",
                        "entry_id": "4dfdcce1-9d62-3115-8cab-c56fd872f5f1",
                        "glosses": [
                            "Donner un caractère connectif à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b99eda6f-ced7-43aa-a9e2-0f3a5c3f1e56",
                                "sense_id": "c02b96d4-2e61-34ae-80b2-3b7cd6c1d74e",
                                "text": "Deuxièmement, l’ordinateur lié au téléphone (donc la possibilité de communiquer) a fait que le traitement de l'information est à la fois individualisé par le rapport à l'écran et connectivisé du fait de la dimension collective et relationnelle."
                            },
                            {
                                "example_id": "b47b0384-3ad6-4f20-9813-766663c83dfe",
                                "sense_id": "c02b96d4-2e61-34ae-80b2-3b7cd6c1d74e",
                                "text": "Les technologies permettent à la fois d’individualiser mais aussi de « connectiviser » et d'échanger."
                            },
                            {
                                "example_id": "6303cb50-bd82-4592-8d5c-c414d9d017c7",
                                "sense_id": "c02b96d4-2e61-34ae-80b2-3b7cd6c1d74e",
                                "text": "Les progrès technologiques réalisés ces vingt dernières années ont «connectivisé» notre société."
                            }
                        ]
                    }
                ],
