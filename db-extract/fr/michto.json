                        "sense_id": "fc2be4b6-177a-3bbd-9add-18c22ca0ec0c",
                        "entry_id": "f45932cb-6364-3aff-a6c8-47e93f1f0c6e",
                        "glosses": [
                            "Plaisant ; bien ; super."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "d71014fe-ac43-4e8c-8920-f532104ba2c1",
                                "sense_id": "fc2be4b6-177a-3bbd-9add-18c22ca0ec0c",
                                "text": "Une meuf michto, grande blonde sexy, jean et veste en cuir, traverse au loin un passage clouté."
                            },
                            {
                                "example_id": "aebd4dc5-63c1-430c-80e0-c4907dffe666",
                                "sense_id": "fc2be4b6-177a-3bbd-9add-18c22ca0ec0c",
                                "text": "J'ai failli lâcher une portée dans mon froc tellement elle était michto : une pelure métissée, des quenottes aussi blanches que le marbre de la White House, des yeux de chat, le tout sur une jolie frimousse, des petits nichons et une taille de guêpe."
                            },
                            {
                                "example_id": "bfd3dc18-dcaf-4df3-9111-31d2998ebf91",
                                "sense_id": "fc2be4b6-177a-3bbd-9add-18c22ca0ec0c",
                                "text": "Un carbu comm’ça, c’est michto."
                            },
                            {
                                "example_id": "1f00bbab-4ac3-40ff-8fd6-fd215fcc999b",
                                "sense_id": "fc2be4b6-177a-3bbd-9add-18c22ca0ec0c",
                                "text": "La France qui perd aux pénos c’est pas michto […]."
                            }
                        ]
                    }
                ],
