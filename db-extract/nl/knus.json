                    {
                        "sense_id": "3c0b9a30-6b45-3ff5-bf82-b0d79139fd41",
                        "entry_id": "957a9b85-c73c-3461-a5ed-ce2bd26a0f08",
                        "glosses": [
                            "aangenaam van gezelschap en enigszins intiem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a596fd7f-32df-4a9a-b697-3e70adcf9780",
                                "sense_id": "3c0b9a30-6b45-3ff5-bf82-b0d79139fd41",
                                "text": "We hebben een avond in het knuste restaurantje van de stad doorgebracht."
                            },
                            {
                                "example_id": "7575054f-8b92-4e29-aebd-d5ed32cca717",
                                "sense_id": "3c0b9a30-6b45-3ff5-bf82-b0d79139fd41",
                                "text": "Ik zou de manor alleen maar mogen verlaten op heiligendagen en andere feestdagen, en zou nooit meer knus wakker worden tegen de warme rug van mijn zus."
                            }
                        ]
                    }
                ],
