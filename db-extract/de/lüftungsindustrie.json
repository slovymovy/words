                "senses": [
                    {
                        "sense_id": "b3de6c24-bd0a-3aff-b14e-e3f3fe40f175",
                        "entry_id": "0d0ab8dc-f527-3fca-a1de-0be3dee55308",
                        "glosses": [
                            "Gesamtheit aller Betriebe und Firmen im Bereich der lüftungstechnischen Warenproduktion"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c2e532b-4aa6-40a6-97c0-869fc4574615",
                                "sense_id": "b3de6c24-bd0a-3aff-b14e-e3f3fe40f175",
                                "text": "„EVIA, der Verband, der die Interessen der Lüftungsindustrie in Europa vertritt, wurde im Jahre 2010 gegründet und umfasst 36 Mitgliedsunternehmen, welche zusammen einen Umsatz von über € 7 Milliarden erzielen und mehr als 45000 Menschen beschäftigen.“"
                            },
                            {
                                "example_id": "b70eeef4-59a2-4a13-8b69-3b86b8af488d",
                                "sense_id": "b3de6c24-bd0a-3aff-b14e-e3f3fe40f175",
                                "text": "„Seit April 2011 ist TROX Mitglied im europäischen Verband der Lüftungsindustrie EVIA (European Ventilation Industry Association).“"
                            },
                            {
                                "example_id": "47e31c60-2cf3-4296-930d-c99b06cc470f",
                                "sense_id": "b3de6c24-bd0a-3aff-b14e-e3f3fe40f175",
                                "text": "„Unsere Produkte aus hochwertigem Kunststoff für die Lüftungsindustrie kommen hauptsächlich in stationärer Klimatechnik sowie im Automobilbau zum Einsatz.“"
                            },
                            {
                                "example_id": "11fc0455-28dc-442e-84b6-22ad6ceb307f",
                                "sense_id": "b3de6c24-bd0a-3aff-b14e-e3f3fe40f175",
                                "text": "„Im Jahr 1996 wurde zusätzlich in Österreich mit der Fertigung von Produkten für die Lüftungsindustrie sowie dem Handel, Service und Reparatur von Hydraulikkomponenten, der Betrieb aufgenommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
