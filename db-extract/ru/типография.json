                    {
                        "translation_id": "38b5ce98-0bc3-4a49-9662-1fa9cd0ec5eb",
                        "source_entry_id": "a264b5c3-9ceb-3147-880a-8ddf42a21cba",
                        "source_sense_id": "9f612065-85dc-3c4f-abb4-06a88dd347dc",
                        "target_lang_word": "imprimerie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imprimerie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1a801cab-7832-3b79-a78c-b59ac9e9b8e4",
                                        "entry_id": "3fd82f50-f93d-341c-a06b-439dfade83bf",
                                        "glosses": [
                                            "Art d’imprimer, techniques d’impression permettant la reproduction, à un nombre quelconque d'exemplaires, de textes, de signes ou d’images sur un support (papier, textile, etc.)"
                                        ],
                                        "tags": [
                                            "Imprimerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d00f813-ae85-46b8-b97a-50966d00e69b",
                                                "sense_id": "1a801cab-7832-3b79-a78c-b59ac9e9b8e4",
                                                "text": "L’imprimerie est le télescope de l'âme […] ; ainsi l'imprimerie rapproche et met en communication immédiate, continue, perpétuelle, la pensée de l'homme isolé avec toutes les pensées du monde invisible, dans le passé, dans le présent, dans l'avenir."
                                            },
                                            {
                                                "example_id": "ab01b7ff-f13b-4459-9225-0b6675490f8a",
                                                "sense_id": "1a801cab-7832-3b79-a78c-b59ac9e9b8e4",
                                                "text": "L’invention de l’imprimerie est le plus grand événement de l’histoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b41c97a4-14c0-33b7-9f26-45e43ea83447",
                                        "entry_id": "3fd82f50-f93d-341c-a06b-439dfade83bf",
                                        "glosses": [
                                            "Établissement où l’on imprime."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb794e63-c64a-4917-809f-42c0db6ace0a",
                                                "sense_id": "b41c97a4-14c0-33b7-9f26-45e43ea83447",
                                                "text": "Il était le gendre de l’imprimeur Plantin qu’il remplaça à Anvers avant de diriger, à partir de 1585, une imprimerie à Leyde."
                                            },
                                            {
                                                "example_id": "f4ccc092-b191-4009-a908-4a5291a74aac",
                                                "sense_id": "b41c97a4-14c0-33b7-9f26-45e43ea83447",
                                                "text": "L’imprimerie nationale, établissement chargé de l'impression des actes officiels, des imprimés administratifs, d'ouvrages publiés par l'État."
                                            },
                                            {
                                                "example_id": "6179c5b9-7883-41b5-ae16-75ba016603c6",
                                                "sense_id": "b41c97a4-14c0-33b7-9f26-45e43ea83447",
                                                "text": "Les ouvriers, le prote d’une imprimerie."
                                            },
                                            {
                                                "example_id": "163113bb-1b5b-4d09-bbb3-5e0eeeafd04e",
                                                "sense_id": "b41c97a4-14c0-33b7-9f26-45e43ea83447",
                                                "text": "Un imprimerie lithographique, établissement, lieu où l’on imprime des lithographies."
                                            },
                                            {
                                                "example_id": "31c15eeb-024c-4def-b217-0e2ef44ff24d",
                                                "sense_id": "b41c97a4-14c0-33b7-9f26-45e43ea83447",
                                                "text": "Le journaliste nous mène un soir à l’imprimerie, dans le rez-de-chaussée noir où le journal se tire ; il est l’ami d’un des ouvriers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6d632e7-35f7-3106-896c-ee3e71d1d063",
                                        "entry_id": "3fd82f50-f93d-341c-a06b-439dfade83bf",
                                        "glosses": [
                                            "Industrie de l’impression, collectif des imprimeurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1af1577e-fe96-4f6d-b9f5-5e6f38a7392f",
                                                "sense_id": "a6d632e7-35f7-3106-896c-ee3e71d1d063",
                                                "text": "Travailler dans l’imprimerie."
                                            },
                                            {
                                                "example_id": "d2ac5640-2cfd-46ec-901d-25506963485c",
                                                "sense_id": "a6d632e7-35f7-3106-896c-ee3e71d1d063",
                                                "text": "Le décret du 5 février 1810 contenant règlement sur l’imprimerie et la librairie supprima la liberté de la profession d'imprimeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f31d40f-1010-3929-b697-9319f517d1f5",
                                        "entry_id": "3fd82f50-f93d-341c-a06b-439dfade83bf",
                                        "glosses": [
                                            "Ce qui sert à imprimer, imprimante, imprimeuse."
                                        ],
                                        "tags": [],
                                        "examples": [
