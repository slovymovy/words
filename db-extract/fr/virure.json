        "fr-extract.jsonl": [
            {
                "entry_id": "ede88631-2a8a-3aec-a35b-d8e6e58f432f",
                "word": "virure",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b633d2c8-ed12-4089-b7ad-fc2c006a4de7",
                        "entry_id": "ede88631-2a8a-3aec-a35b-d8e6e58f432f",
                        "tags": [
                            "plural"
                        ],
                        "form": "virures"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3d8d3b5c-3725-3d87-95cb-ae0c694d4bd8",
                        "entry_id": "ede88631-2a8a-3aec-a35b-d8e6e58f432f",
                        "glosses": [
                            "Ligne de bordages mis bout à bout allant de l’avant à l’arrière d’un navire et démarrant à partir de la quille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef5104c7-f909-4f50-8f8b-946f270472ba",
                                "sense_id": "3d8d3b5c-3725-3d87-95cb-ae0c694d4bd8",
                                "text": "Presque accroupi, Ryota laisse aller sa main le long d’une virure, jusqu’à l’étrave."
                            },
                            {
                                "example_id": "a8f27e91-135b-4043-bc9b-6b4441a08ecb",
                                "sense_id": "3d8d3b5c-3725-3d87-95cb-ae0c694d4bd8",
                                "text": "Extérieurement, les membres sont réunis par une tôle de quille, une virure de bouchain, une virure de préceinte en tôle, et généralement deux plan de lattes diagonales, allant de la préceinte au bouchain, et rivées avec ces virures longitudinales."
                            },
                            {
                                "example_id": "d8ed483c-a083-49d6-abea-762235ea44ee",
                                "sense_id": "3d8d3b5c-3725-3d87-95cb-ae0c694d4bd8",
                                "text": "Il y a autant de virures sur les membres d’un bâtiment que de largeur de bordage, c’est à dire que chaque suite de bordage mis bout à bout fait une virure."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a937462d-a4f7-4976-b6fc-68fc51c7b8c1",
                        "source_entry_id": "ede88631-2a8a-3aec-a35b-d8e6e58f432f",
                        "source_sense_id": "3d8d3b5c-3725-3d87-95cb-ae0c694d4bd8",
                        "target_lang_word": "Planke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Planke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "09ed8c6a-835b-3907-a8d2-26c42cb3032a",
                                        "entry_id": "7cce2e9d-6c90-3f10-904b-040f18a03204",
                                        "glosses": [
                                            "starkes, schweres Brett"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eab4bb37-27f6-4cdf-b069-2f27db017547",
                                                "sense_id": "09ed8c6a-835b-3907-a8d2-26c42cb3032a",
                                                "text": "Die Planken müssen mal wieder gereinigt werden."
                                            },
                                            {
                                                "example_id": "ed01b590-1c5f-47c7-b02e-cb7f34ba8bd5",
                                                "sense_id": "09ed8c6a-835b-3907-a8d2-26c42cb3032a",
                                                "text": "„Erst danach werden weitere Planken angebracht, die die Handwerker ebenfalls mit Querstreben verstärken - bis die Bordwand fertig ist.“"
                                            },
                                            {
                                                "example_id": "3301520c-b13f-444c-8eeb-04b3eca53c94",
                                                "sense_id": "09ed8c6a-835b-3907-a8d2-26c42cb3032a",
                                                "text": "„Zwischen den Planken der Bordwand sickerten Wasserfäden wie Tränen über das Holz.“"
                                            },
                                            {
                                                "example_id": "8b6ce24e-ca50-43ec-867d-dd52bb1036d4",
                                                "sense_id": "09ed8c6a-835b-3907-a8d2-26c42cb3032a",
                                                "text": "„Zu beiden Seiten einer ungeheuren Säge stehen zwei Männer und schneiden Planken.“"
                                            },
                                            {
                                                "example_id": "3617ca3b-3080-44af-b073-dc7a98ede94e",
                                                "sense_id": "09ed8c6a-835b-3907-a8d2-26c42cb3032a",
                                                "text": "„Sie schlug die Augen auf und fand sich auf den Planken eines Segelboots, auf Philips Mantel, der sie vor Flugsand schützte, vor Wassertropfen und Insekten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "492b637a-cb0e-40f1-b50b-0e4a9e14245f",
                        "source_entry_id": "ede88631-2a8a-3aec-a35b-d8e6e58f432f",
                        "source_sense_id": "3d8d3b5c-3725-3d87-95cb-ae0c694d4bd8",
                        "target_lang_word": "strake",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "strake",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22c1ab0c-9dc1-3fe5-9c4c-c0cf2c569db9",
                                        "entry_id": "cc86d0a3-3469-3351-94ae-3640191c661d",
                                        "glosses": [
                                            "An iron fitting of a traditional wooden wheel, such as a hub component or bearing (e.g., box, bushel), a cleat, or a rim covering."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92373b0c-6157-4254-83e6-0e899885d701",
                                                "sense_id": "22c1ab0c-9dc1-3fe5-9c4c-c0cf2c569db9",
                                                "text": "The separate pieces of iron, forming together the fitting of the wheel, are called strakes, and the great nails by which they are fastened to the woodwork, and which had thick projecting heads, are called strake-nails and occasionally, it seems, cart-nails, great nails, or frets."
                                            },
                                            {
                                                "example_id": "a9a2bd76-1f52-4d49-a806-c92ccaa5f561",
                                                "sense_id": "22c1ab0c-9dc1-3fe5-9c4c-c0cf2c569db9",
                                                "text": "Iron strakes were the separate plates fitted to a cart wheel before the use of the iron ring or tyre. [Evans was glossing the term as encountered in a ledger entry of 1827.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f194da13-3815-3cca-b8f6-e207114f2142",
                                        "entry_id": "cc86d0a3-3469-3351-94ae-3640191c661d",
                                        "glosses": [
                                            "A type of aerodynamic surface mounted on an aircraft fuselage to fine-tune the airflow."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a81a3e55-393e-371b-9815-196db5e7682a",
                                        "entry_id": "cc86d0a3-3469-3351-94ae-3640191c661d",
                                        "glosses": [
                                            "Also used more generally to regulate fluid flow in pipes or vents to prevent turbulence or vortexes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fee8f490-5fe2-3ccf-ba13-dba8a8c488ce",
                                        "entry_id": "cc86d0a3-3469-3351-94ae-3640191c661d",
                                        "glosses": [
                                            "A continuous line of plates or planks running from bow to stern that contributes to a vessel's skin. (FM 55-501)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2927ef7-d174-4b7f-8e2c-c2612cb0e06d",
                                                "sense_id": "fee8f490-5fe2-3ccf-ba13-dba8a8c488ce",
                                                "text": "With regard to materials, all the frames should be of oak and so should the stem piece, stern post, upper portion of dead woods, knight heads, apron, beams, shelf clamp, bilge strakes, and keelson; the keel will generally be found to be either English or American elm. The garboard strakes are generally of American elm, and it is best that the planking above should be of American elm or oak to within a foot or so of the load water-line, and teak above to the covering board or deck edge."
                                            },
                                            {
                                                "example_id": "b25811a1-da67-4791-b2a8-442dfaef3202",
                                                "sense_id": "fee8f490-5fe2-3ccf-ba13-dba8a8c488ce",
                                                "text": "You felt the power of the Olympic's twenty-nine boilers transmitted upward through the strakes of the hull."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ff9236c-7acc-36ef-b38a-457a9498c0dd",
                                        "entry_id": "cc86d0a3-3469-3351-94ae-3640191c661d",
                                        "glosses": [
                                            "A shaped piece of wood used to level a bed or contour the shape of a mould, as for a bell"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc299795-486d-3ded-93ea-fa066a76c1cc",
                                        "entry_id": "cc86d0a3-3469-3351-94ae-3640191c661d",
                                        "glosses": [
                                            "A trough for washing broken ore, gravel, or sand; a launder."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "953455c8-6d8e-3aee-9c5d-d3462e33a8dc",
                                        "entry_id": "cc86d0a3-3469-3351-94ae-3640191c661d",
                                        "glosses": [
                                            "A streak."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9de85bae-59e3-4dfb-b8e8-65def00297de",
                                                "sense_id": "953455c8-6d8e-3aee-9c5d-d3462e33a8dc",
                                                "text": "And Jacob took him rods of green poplar, and of the hazel and chesnut^([sic]) tree; and pilled white strakes in them, and made the white appear which was in the rods."
                                            },
                                            {
                                                "example_id": "6bee5ff7-a215-41f2-8035-d586dc86762e",
                                                "sense_id": "953455c8-6d8e-3aee-9c5d-d3462e33a8dc",
                                                "text": "His burning eyen, whom bloody strakes did staine"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "strake",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2b3285e-101b-33d2-8377-785851067147",
                                        "entry_id": "2f1a444d-5732-3eb2-88e2-23a6b7a5b3b6",
                                        "glosses": [
                                            "To stretch."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "strake",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a39ef6b3-7daa-38d6-bc80-2ff3b18c5ff5",
                                        "entry_id": "5739021e-8163-3e4f-98b9-0e40b09cc3d4",
                                        "glosses": [
                                            "simple past of strike"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "obsolete",
                                            "past"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8908ef4-a77c-43fa-a4fa-d2589c202d90",
                                                "sense_id": "a39ef6b3-7daa-38d6-bc80-2ff3b18c5ff5",
                                                "text": "Hayle Groome; didst not thou see a bleeding Hind, / Whose right haunch earst my stedfast arrow strake?"
                                            },
                                            {
                                                "example_id": "70070e6d-e55c-49d6-8e5e-277f2adf0c25",
                                                "sense_id": "a39ef6b3-7daa-38d6-bc80-2ff3b18c5ff5",
                                                "text": "But, when he strake — which came so thick as if every blow would strive to be foremost — his arm seemed still a postillion of death.",
                                                "translation": "The New Arcadia",
                                                "english": "The New Arcadia"
                                            },
                                            {
                                                "example_id": "61eef132-c0df-4f1d-86fd-0f92c108bcbc",
                                                "sense_id": "a39ef6b3-7daa-38d6-bc80-2ff3b18c5ff5",
                                                "text": "But when of Eglantine he spake, / His strings melodiously he strake."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
