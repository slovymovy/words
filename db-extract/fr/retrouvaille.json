                                "target_senses": [
                                    {
                                        "sense_id": "d487e215-9a5d-322f-933b-3a3df35f5764",
                                        "entry_id": "1880916e-a943-3290-aa6d-2aad48b6ff14",
                                        "glosses": [
                                            "The process or act of reuniting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "399d8200-805d-4f09-b0a7-746db39d6ee5",
                                                "sense_id": "d487e215-9a5d-322f-933b-3a3df35f5764",
                                                "text": "The reunion took forever, but it was worth it."
                                            },
                                            {
                                                "example_id": "6108cf64-4ef2-4915-b99f-11d182de4599",
                                                "sense_id": "d487e215-9a5d-322f-933b-3a3df35f5764",
                                                "text": "It was a tearful and heartfelt reunion as the trapped miners finally saw their dear loved ones again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f8d1e0d-73cc-38da-b1bf-472d887bf321",
                                        "entry_id": "1880916e-a943-3290-aa6d-2aad48b6ff14",
                                        "glosses": [
                                            "A planned event at which members of a dispersed group meet together."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
