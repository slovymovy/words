                ],
                "senses": [
                    {
                        "sense_id": "def3d47c-d747-3a85-bc6c-acc5102d06ec",
                        "entry_id": "ddf3c2d0-a35a-31fd-a3eb-a630c4258d8d",
                        "glosses": [
                            "Eigenschaft, sich dem sittlichen Empfinden (der Moral) entsprechend zu verhalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c29c2d71-09d7-487d-abb9-2ae471885cde",
                                "sense_id": "def3d47c-d747-3a85-bc6c-acc5102d06ec",
                                "text": "„Schopenhauers Ethik ist bekanntermaßen eine Mitleidsethik, weil sie die Quelle von Moral und Moralität im Gefühl des Mitleids erblickt.“"
                            },
                            {
                                "example_id": "3e4cfc8c-a748-465b-b601-cec3327afed4",
                                "sense_id": "def3d47c-d747-3a85-bc6c-acc5102d06ec",
                                "text": "„Der Begriff der Strafe, der strafenden im Unterschied zur rächenden Gerechtigkeit, ist der Ausgangspunkt des Übergangs zur Moralität, zum „moralischen Standpunkt“, in § 104.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1618348e-b29c-3840-9f15-7582d373d5cb",
                        "entry_id": "ddf3c2d0-a35a-31fd-a3eb-a630c4258d8d",
                        "glosses": [
                            "(historische) Form des Dramas, das mit dem Stilmittel der Personifizierung moralischer Begrifflichkeiten belehrend wirken will"
                        ],
                        "tags": [
                            "Literaturwissenschaft",
                            "Genre"
                        ],
                        "examples": [
                            {
                                "example_id": "fcd356d2-e39a-41f1-bd0b-0149ab89cdbe",
                                "sense_id": "1618348e-b29c-3840-9f15-7582d373d5cb",
                                "text": "„Gegenwärtig versteht der Literarhistoriker unter Moralitäten Dramen des ausgehenden Mittelalters und der Reformationszeit, in denen die Handlung in der Hauptsache von personifizierten Begriffen und Eigenschaften getragen wird.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
