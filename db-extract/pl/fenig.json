                "senses": [
                    {
                        "sense_id": "5080cd31-cc82-3847-a4c0-567de717ad7d",
                        "entry_id": "24611e43-a718-3854-9317-0b6d01341b79",
                        "glosses": [
                            "setna część marki niemieckiej"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "90c7103b-f6f7-4e3b-a76e-06259d764e8f",
                                "sense_id": "5080cd31-cc82-3847-a4c0-567de717ad7d",
                                "text": "Na wycieczce do NRD kupiłem za dziewięćdziesiąt dziewięć fenigów singla Neny z piosenką o dziewięćdziesięciu dziewięciu balonach."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "1deb350c-5d4a-3603-a1dd-2ea47c9c5431",
                        "entry_id": "24611e43-a718-3854-9317-0b6d01341b79",
                        "glosses": [
                            "potoczna nazwa denara w krajach germańskich od VIII do X wieku"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "b705487d-692b-35b8-b9da-6e03e18fee44",
                        "entry_id": "24611e43-a718-3854-9317-0b6d01341b79",
                        "glosses": [
                            "setna część marki polskiej w latach 1917-1924"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "00fc2f96-3a08-40e8-9cd2-7c1c8b24190b",
                                "sense_id": "b705487d-692b-35b8-b9da-6e03e18fee44",
                                "text": "Handlarz z Woli orzekł, że za tę starzyznę nie dałby nawet pół feniga."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93ca8aa7-3372-4bd4-8dee-54ed4991f318",
                        "source_entry_id": "24611e43-a718-3854-9317-0b6d01341b79",
