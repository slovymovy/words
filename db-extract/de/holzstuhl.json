                "senses": [
                    {
                        "sense_id": "a81b5b9b-89cd-3778-878c-61e19ad9fa34",
                        "entry_id": "964ba782-5a79-3603-bdf1-220f75e30708",
                        "glosses": [
                            "Stuhl aus Holz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f62a8b2-49ad-462f-85a4-b68d9d319fee",
                                "sense_id": "a81b5b9b-89cd-3778-878c-61e19ad9fa34",
                                "text": "„Schwere Holzstühle mit fluffigen Bezügen, kleine runde Tische mit spitzenverzierten Decken und goldenen Kerzenständern luden zum Verweilen ein.“"
                            },
                            {
                                "example_id": "47b29c1f-1d84-4e45-8ad3-4eff76e2460e",
                                "sense_id": "a81b5b9b-89cd-3778-878c-61e19ad9fa34",
                                "text": "„So saßen sie eine Zeit lang still auf den rohen Holzstühlen.“"
                            },
                            {
                                "example_id": "9695d2cb-90e5-45df-b6bc-88549ef1c9bc",
                                "sense_id": "a81b5b9b-89cd-3778-878c-61e19ad9fa34",
                                "text": "„Ihr warmes gelbes Licht fiel auf den dunkelblauen Teppich, den breiten altflämischen Tisch, die bequemen Holzstühle mit den Bastlehnen, die große altflämische Anrichte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
