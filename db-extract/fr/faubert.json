                                                "sense_id": "21cf1725-bde3-3137-bbc2-b3dfeea9951a",
                                                "text": "What mops and mowes it makes! --"
                                            },
                                            {
                                                "example_id": "5ff348ce-5203-4094-8872-f23dd22cc08a",
