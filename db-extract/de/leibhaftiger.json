                "senses": [
                    {
                        "sense_id": "f17d3c28-026b-3b49-9dcd-72a76f980435",
                        "entry_id": "50e0d27d-4d5d-3858-92ae-2f8edc63e68d",
                        "glosses": [
                            "the Devil"
                        ],
                        "tags": [
                            "adjectival",
                            "definite",
                            "euphemistic",
                            "masculine",
                            "proper-noun",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "f5910313-9163-43a2-911f-e75f82fe263f",
                                "sense_id": "f17d3c28-026b-3b49-9dcd-72a76f980435",
                                "text": "Ja, sie ist die Schlange (der Leibhaftige selbst), die zu dem Menschen spricht: Erkenne Dich, Du bist Gott, und es ist kein Gott außer Dir.",
                                "translation": "Yes, it is the serpent (the Devil himself), who said to the people: Know yourself, you are God and there is no other God but you.",
                                "english": "Yes, it is the serpent (the Devil himself), who said to the people: Know yourself, you are God and there is no other God but you."
                            },
                            {
                                "example_id": "92540dc1-69e8-4ec3-beee-32a4cec7c7ab",
                                "sense_id": "f17d3c28-026b-3b49-9dcd-72a76f980435",
                                "text": "»Selbstverständlich«, sagte Staatsanwalt Ranelid, »solange es der Wahrheitsfindung dient, dürfte sich der Leibhaftige selbst dazu äußern.«",
                                "translation": "\"Of course\", said Prosecutor Ranelid, \"as long as it served the truth, even the Devil himself would be allowed to speak out.\"",
                                "english": "\"Of course\", said Prosecutor Ranelid, \"as long as it served the truth, even the Devil himself would be allowed to speak out.\""
                            },
                            {
                                "example_id": "f698fc12-798e-46da-938c-05ce6c1f37e4",
                                "sense_id": "f17d3c28-026b-3b49-9dcd-72a76f980435",
                                "text": "Bei gewissen Kreisen bin ich gehasst wie der Leibhaftige persönlich!",
                                "translation": "In certain circles, I am personally hated like the Devil!",
                                "english": "In certain circles, I am personally hated like the Devil!"
                            }
                        ]
                    }
