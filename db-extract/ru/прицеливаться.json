                "senses": [
                    {
                        "sense_id": "2bff7bb3-1a17-31ec-8dc0-79489ac930a2",
                        "entry_id": "f4ffc4e8-4ab8-3f5b-b232-b87866870f85",
                        "glosses": [
                            "наводить оружие точно на цель"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afdf0564-c20c-4c73-91ee-9d88df7d5c24",
                                "sense_id": "2bff7bb3-1a17-31ec-8dc0-79489ac930a2",
                                "text": "Покончив с альбомом, фон Корен брал с этажерки пистолет и, прищурив левый глаз, долго прицеливался в портрет князя Воронцова или же становился перед зеркалом и рассматривал своё смуглое лицо, большой лоб и чёрные, курчавые, как у негра, волоса, и свою рубаху из тусклого ситца с крупными цветами, похожего на персидский ковёр, и широкий кожаный пояс вместо жилетки."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48f4f9ed-c893-485e-b41b-1b387f14bb7a",
                        "source_entry_id": "f4ffc4e8-4ab8-3f5b-b232-b87866870f85",
                        "source_sense_id": "2bff7bb3-1a17-31ec-8dc0-79489ac930a2",
                        "target_lang_word": "sight",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6b5a0361-1071-3fc8-bfb7-f11e213f9a72",
                                        "entry_id": "5efe692d-2362-3502-b417-585983fab8df",
                                        "glosses": [
                                            "The ability to see."
                                        ],
                                        "tags": [
                                            "countable",
                                            "singular",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a40def5a-9a25-4832-affc-ebf49fb5e13b",
                                                "sense_id": "6b5a0361-1071-3fc8-bfb7-f11e213f9a72",
                                                "text": "He is losing his sight and now can barely read."
                                            },
                                            {
                                                "example_id": "3a68cd7e-fcf5-4b7f-83b2-a08f3cac0fb8",
                                                "sense_id": "6b5a0361-1071-3fc8-bfb7-f11e213f9a72",
                                                "text": "Thy sight is young, / And thou shalt read when mine begin to dazzle."
                                            },
                                            {
                                                "example_id": "7bdd8616-b99b-473d-99c6-97c1736fdbbc",
                                                "sense_id": "6b5a0361-1071-3fc8-bfb7-f11e213f9a72",
                                                "text": "O loſs of ſight, of thee I moſt complain!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69fb3b7d-5ef5-3137-b085-251987c4fd9b",
                                        "entry_id": "5efe692d-2362-3502-b417-585983fab8df",
                                        "glosses": [
                                            "The act of seeing; perception of objects by the eye; view."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17c76a62-4826-461f-a427-217452c721ad",
                                                "sense_id": "69fb3b7d-5ef5-3137-b085-251987c4fd9b",
                                                "text": "to gain sight of land"
                                            },
                                            {
                                                "example_id": "57391729-7f76-43c3-a021-5f212b27c3d2",
                                                "sense_id": "69fb3b7d-5ef5-3137-b085-251987c4fd9b",
                                                "text": "And when hee had spoken these things, while they beheld, hee was taken vp, and a cloud receiued him out of their sight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4c6116a-c53b-3c5b-846b-93e75fe21c1a",
                                        "entry_id": "5efe692d-2362-3502-b417-585983fab8df",
                                        "glosses": [
                                            "Something seen."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcee1c2d-8308-40b0-bd06-e7b587753e24",
                                                "sense_id": "e4c6116a-c53b-3c5b-846b-93e75fe21c1a",
                                                "text": "He's a really remarkable man and it's very hard to get him in one's sights; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "633bd489-63ff-33c0-867e-17475dfc7ecd",
                                        "entry_id": "5efe692d-2362-3502-b417-585983fab8df",
                                        "glosses": [
                                            "Something worth seeing; a spectacle, either good or bad."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34e6c997-19b7-4636-b468-814d091eaf9b",
                                                "sense_id": "633bd489-63ff-33c0-867e-17475dfc7ecd",
                                                "text": "We went to London and saw all the sights – Buckingham Palace, Tower Bridge, and so on."
                                            },
                                            {
                                                "example_id": "f62dacce-5bc9-4293-aa41-a139f81fa811",
                                                "sense_id": "633bd489-63ff-33c0-867e-17475dfc7ecd",
                                                "text": "You really look a sight in that ridiculous costume!"
                                            },
                                            {
                                                "example_id": "c2f55ab9-db46-4d65-9395-7d7d9b713792",
                                                "sense_id": "633bd489-63ff-33c0-867e-17475dfc7ecd",
                                                "text": "And Moses saide, I will nowe turne aside, and see this great sight, why the bush is not burnt."
                                            },
                                            {
                                                "example_id": "ff0a0501-0e80-4b58-a728-d1006984597d",
                                                "sense_id": "633bd489-63ff-33c0-867e-17475dfc7ecd",
                                                "text": "They never saw a sight so fair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27dedb3b-e93a-3a78-b2dc-19fdd109fdef",
                                        "entry_id": "5efe692d-2362-3502-b417-585983fab8df",
                                        "glosses": [
                                            "A device used in aiming a projectile, through which the person aiming looks at the intended target."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "often",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "276e9133-e23c-3e13-8f63-143032f2be4e",
                                        "entry_id": "5efe692d-2362-3502-b417-585983fab8df",
                                        "glosses": [
                                            "A small aperture through which objects are to be seen, and by which their direction is settled or ascertained."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07d5d308-7cc2-48a2-85c5-5772ccf6c37b",
                                                "sense_id": "276e9133-e23c-3e13-8f63-143032f2be4e",
                                                "text": "the sight of a quadrant"
                                            },
                                            {
                                                "example_id": "bdee3d74-cf02-45d1-a063-ed8ea73348b8",
                                                "sense_id": "276e9133-e23c-3e13-8f63-143032f2be4e",
                                                "text": "their eyes of fire sparking through sights of steel"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ac6f565-f69a-317e-bbfc-4668f5b1b805",
                                        "entry_id": "5efe692d-2362-3502-b417-585983fab8df",
                                        "glosses": [
                                            "a great deal, a lot; frequently used to intensify a comparative."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db1dc0bd-b2da-49c5-8bf7-3d9bb23dfa72",
                                                "sense_id": "7ac6f565-f69a-317e-bbfc-4668f5b1b805",
                                                "text": "a sight of money"
                                            },
                                            {
                                                "example_id": "514c5439-b3ba-4c77-8399-ff80290a7b13",
                                                "sense_id": "7ac6f565-f69a-317e-bbfc-4668f5b1b805",
                                                "text": "This is a darn sight better than what I'm used to at home!"
                                            },
                                            {
                                                "example_id": "b3fc07a5-4e32-41df-a059-a643a5fe1a2d",
                                                "sense_id": "7ac6f565-f69a-317e-bbfc-4668f5b1b805",
                                                "text": "\"If your mother put you in the pit at twelve, it's no reason why I should do the same with my lad.\"\n\"Twelve! It wor a sight afore that!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73e574ba-61a7-34a4-84f2-6e9804f77b37",
                                        "entry_id": "5efe692d-2362-3502-b417-585983fab8df",
                                        "glosses": [
                                            "In a drawing, picture, etc., that part of the surface, as of paper or canvas, which is within the frame or the border or margin. In a frame, the open space, the opening."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1a42881e-859f-3cc7-81ce-dcc5352e3d00",
                                        "entry_id": "5efe692d-2362-3502-b417-585983fab8df",
                                        "glosses": [
                                            "The instrument of seeing; the eye."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de04fe83-5823-442b-8f63-2129e397bde0",
                                                "sense_id": "1a42881e-859f-3cc7-81ce-dcc5352e3d00",
                                                "text": "Why cloude they not their ſights perpetually,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1137306a-ecd8-35f1-8565-ce8127a3229d",
                                        "entry_id": "5efe692d-2362-3502-b417-585983fab8df",
                                        "glosses": [
                                            "Mental view; opinion; judgment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c1a5351-ec20-4a15-9ebf-3ce5b12082fd",
                                                "sense_id": "1137306a-ecd8-35f1-8565-ce8127a3229d",
                                                "text": "a very heinous Sin in the Sight of God"
                                            },
                                            {
                                                "example_id": "19678ec3-cf97-4126-9f2e-818c0d00c6c0",
                                                "sense_id": "1137306a-ecd8-35f1-8565-ce8127a3229d",
                                                "text": "In their sight it was harmless."
                                            },
                                            {
                                                "example_id": "52eba4ef-193f-45d6-b81c-8eeea47b96c9",
                                                "sense_id": "1137306a-ecd8-35f1-8565-ce8127a3229d",
                                                "text": "That which is highly esteemed among men is abomination in the sight of God."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b8b3d9b5-ae64-38eb-8010-1c0d4dc68d22",
                                        "entry_id": "9f0a52da-a2d2-36d5-8235-f1076252d5be",
                                        "glosses": [
                                            "To see; to get sight of (something); to register visually."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3783e24c-aa8a-4004-85d8-628eb874fee8",
                                                "sense_id": "b8b3d9b5-ae64-38eb-8010-1c0d4dc68d22",
                                                "text": "I was on my way to the door, but all at once, through the fog in my head, I began to sight one reef that I hadn't paid any attention to afore."
                                            },
                                            {
                                                "example_id": "07e37883-3fbc-478f-b47c-3638720f9308",
                                                "sense_id": "b8b3d9b5-ae64-38eb-8010-1c0d4dc68d22",
                                                "text": "to sight land from a ship"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6fd155f-eb5e-32f9-83e0-0c9d2baab20c",
                                        "entry_id": "9f0a52da-a2d2-36d5-8235-f1076252d5be",
                                        "glosses": [
                                            "To see; to get sight of (something); to register visually.",
                                            "To observe through, or as if through, a sight, to check the elevation, direction, levelness, or other characteristics of, especially when surveying or navigating."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ff6c1ed-f7f4-4dd6-a200-4c26b536339e",
                                                "sense_id": "e6fd155f-eb5e-32f9-83e0-0c9d2baab20c",
                                                "text": "Next a point of known elevation, preferably one of the triangulation stations, is sighted; the vertical angle is read and the horizontal distance is scaled from the point of the setup on the map to the point sighted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90335246-5e62-3846-b1aa-1a9c9b220da7",
                                        "entry_id": "9f0a52da-a2d2-36d5-8235-f1076252d5be",
                                        "glosses": [
                                            "To apply sights to; to adjust the sights of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6dffaa8-98bb-4a67-893e-cdb63e0fd67f",
                                                "sense_id": "90335246-5e62-3846-b1aa-1a9c9b220da7",
                                                "text": "to sight a rifle or a cannon"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48c9fbd7-b7f8-32e6-b79f-8a74cedfa8cd",
                                        "entry_id": "9f0a52da-a2d2-36d5-8235-f1076252d5be",
                                        "glosses": [
                                            "To observe or aim (at something) using a (gun) sight."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6c69c32-dff4-4f3a-a942-8beb6409cd2d",
                                                "sense_id": "48c9fbd7-b7f8-32e6-b79f-8a74cedfa8cd",
                                                "text": "Jim braced the gun and sighted, tried to pull the trigger. Beside him a body collapsed, limp. It was Max. A shot had gone through his brain. Jim stared down at him, numb with horror."
                                            },
                                            {
                                                "example_id": "2dce566a-fd47-4e52-8d07-b8612138ff51",
                                                "sense_id": "48c9fbd7-b7f8-32e6-b79f-8a74cedfa8cd",
                                                "text": "So I sighted the deer with my .30—30 and fired at him. The bullet hit about ten yards below the deer. I realized that I had a problem with the gun so I aimed about ten yards above the deer as he was running and he dropped dead on the [spot]."
                                            },
                                            {
                                                "example_id": "abad76ed-1651-402d-936e-10c92b443270",
                                                "sense_id": "48c9fbd7-b7f8-32e6-b79f-8a74cedfa8cd",
                                                "text": "This buck was finally mine. I had spent hours shooting at moving targets with that rifle and there was no way I could miss. I raised my gun and sighted through the scope."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
