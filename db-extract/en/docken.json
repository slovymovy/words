                        ],
                        "examples": [
                            {
                                "example_id": "9e3a62a9-696a-48e8-9c78-e24d7c587e9f",
                                "sense_id": "19ef62e4-704a-3032-a071-3a02d7a05ed5",
                                "text": "\"But the docken, man,\" said I— \"fusionless as a docken—how classic! what an exclamation to proceed from the mouth of a solemn Don!\"\n\"No gibes regarding the docken,\" promptly chimed in Bang; \"it is a highly respectable vegetable, let me tell you, and useful on occasion, which is more.\""
                            },
                            {
                                "example_id": "7f7f88f2-f931-441b-b782-a9adf0d528cf",
                                "sense_id": "19ef62e4-704a-3032-a071-3a02d7a05ed5",
                                "text": "The leaves are accounted an antidote for the pricking of a stinging nettle. Children rub the sting with a docken leaf, repeating the words, \"Nettle oot; docken in.\""
                            }
                        ]
                    }
