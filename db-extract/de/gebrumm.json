                                        "entry_id": "5fde8382-0661-3cf2-8f1b-c84b27d40b6d",
                                        "glosses": [
                                            "A phenomenon, or collection of phenomena, involving widespread reports of a persistent and invasive low-frequency humming, rumbling, or droning noise not audible to all people."
                                        ],
                                        "tags": [
                                            "with article"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9636adfc-f534-4428-82b9-f42af8879775",
                                                "sense_id": "8b8efe92-c5c1-30f0-9dbf-1ff102f95297",
                                                "text": "There is a range of theories from farm or factory machinery to conspiracy theories such as flying saucers. And yet, \"the hum\" remains an unsolved case."
                                            }
                                        ]
                                    }
                                ]
                            },
