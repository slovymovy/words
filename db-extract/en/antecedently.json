                "senses": [
                    {
                        "sense_id": "712be289-e0ca-3e43-b787-5cede1ff93e0",
                        "entry_id": "0f71527d-ae89-3258-a021-e8f1e6859e38",
                        "glosses": [
                            "At an earlier time."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b23ea35c-b658-4a28-bf50-9c9438b6e0d1",
                                "sense_id": "712be289-e0ca-3e43-b787-5cede1ff93e0",
                                "text": "The History of Brute and the Brutans setteth forth. Principally and antecedently their persons, & in them sheweth the geneallogy or issue which they had, artes which they studied, actes which they did."
                            },
                            {
                                "example_id": "fab9eb6d-5737-4d60-8c60-3acdbd9140e0",
                                "sense_id": "712be289-e0ca-3e43-b787-5cede1ff93e0",
                                "text": "[…] it does not at all appear, that all Mixtures must be of Elementary Bodies; but it seems farr more probable, that there are divers sorts of compound Bodies, even in regard of all or some of their Ingredients, consider’d Antecedently to their Mixture."
                            },
                            {
                                "example_id": "6b60b52a-30ec-424e-bcba-af057b854a32",
                                "sense_id": "712be289-e0ca-3e43-b787-5cede1ff93e0",
                                "text": "[…] nothing is ever present to the mind but perceptions, and […] all ideas are deriv’d from something antecedently present to the mind;"
                            },
                            {
                                "example_id": "f8a64ecf-fe36-4e8b-95b5-fb9bdf241335",
                                "sense_id": "712be289-e0ca-3e43-b787-5cede1ff93e0",
                                "text": "She had never antecedently regarded this occupation of his as any objection to having him for a husband."
                            },
                            {
                                "example_id": "da593c84-ebaf-4627-841d-358445f042e3",
                                "sense_id": "712be289-e0ca-3e43-b787-5cede1ff93e0",
                                "text": "The case of envy just described is one in which we feel joy or sadness at the sadness or joy of one we antecedently hate."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "430093f9-4f4c-42a6-ae3b-89e2c0b4f67f",
                        "source_entry_id": "0f71527d-ae89-3258-a021-e8f1e6859e38",
                        "source_sense_id": "712be289-e0ca-3e43-b787-5cede1ff93e0",
                        "source_sense_description": "in an antecedent manner",
                        "target_lang_word": "antécédemment",
