                "senses": [
                    {
                        "sense_id": "16a98172-10f6-3666-837a-d64831cc19cf",
                        "entry_id": "6b779cca-a8ea-3dde-a74e-f36bdcdb7f4b",
                        "glosses": [
                            "Zimmer, das sich direkt unter dem Dach befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dba0734-8f35-4a6c-83f3-6fecfa95d405",
                                "sense_id": "16a98172-10f6-3666-837a-d64831cc19cf",
                                "text": "„Eine Weile geschieht dar nicht, wird es im Dachzimmer nur verdächtig ruhig.“"
                            },
                            {
                                "example_id": "6231df0e-e6e9-441b-88b5-2308e553ed6d",
                                "sense_id": "16a98172-10f6-3666-837a-d64831cc19cf",
                                "text": "„Die Sonne schien in das kleine Dachzimmer und malte goldgelbe Kringel auf den Fußboden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9fae696e-383b-40f5-85e1-0976719cba4e",
