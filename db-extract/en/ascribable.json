                        "examples": [
                            {
                                "example_id": "cf4ea587-f9f3-43c7-a0d3-bac8b876c8f8",
                                "sense_id": "5582be0f-1ce8-3b46-b6ed-720a485665b5",
                                "text": "A death, a drought ascribable to the sorcery of a weathermaker, a cyclone and so forth could always excite the natives to acts of revenge, and consequently no man could leave his district unarmed […]"
                            },
                            {
                                "example_id": "3cc27dda-cb70-4b86-bc4a-d84ff8770e2f",
                                "sense_id": "5582be0f-1ce8-3b46-b6ed-720a485665b5",
                                "text": "The Soviet Union apparently took the U.S.— Japanese political-military alliance quite seriously—probably more seriously than we might imagine. The Soviet Union’s reluctance to return the Northern Territories to Japan, even at the expense of the bilateral relationship, is ascribable to the global confrontation between the USSR and the United States."
                            }
                        ]
                    }
