                "senses": [
                    {
                        "sense_id": "68499570-7219-35ba-afc4-77e8d7cbff67",
                        "entry_id": "e6234d6a-864c-3a1f-80b4-4ac41fbed7d4",
                        "glosses": [
                            "unterwerfen, unterordnen"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "6b0812e4-5eed-4f3d-b3ed-7448dca8a1d9",
                                "sense_id": "68499570-7219-35ba-afc4-77e8d7cbff67",
                                "text": "„No, this thrice-worthy and right valiant lord",
                                "translation": "Jetzt zum Achill zu gehn.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d9621d95-cf5d-4d47-8c63-6c9824ce221e",
                        "source_entry_id": "e6234d6a-864c-3a1f-80b4-4ac41fbed7d4",
                        "source_sense_id": "68499570-7219-35ba-afc4-77e8d7cbff67",
                        "source_sense_description": "veraltet: unterwerfen, unterordnen",
                        "target_lang_word": "unterwerfen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unterwerfen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c6c073ef-96e8-3642-8e53-815053ab8dd7",
                                        "entry_id": "b86f3655-7b70-318d-8259-32ba9c17c49a",
                                        "glosses": [
                                            "fremde Gebiete, Völker mit Gewalt sich eigen machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1b1fc03-f5ed-4f24-90a6-32389d5a20bb",
                                                "sense_id": "c6c073ef-96e8-3642-8e53-815053ab8dd7",
                                                "text": "„Albrecht baute die landesfürstliche Macht in Österreich konsequent aus; 1380 unterwarf er die Grafen von Schaunberg, die sich zwischen Wittelsbachern und Habsburgern mit Unterstützung der ersteren ein eigenes Territorium schaffen wollten.“"
                                            },
                                            {
                                                "example_id": "e7125f86-5f1a-44d8-877b-716c232695c7",
                                                "sense_id": "c6c073ef-96e8-3642-8e53-815053ab8dd7",
                                                "text": "„Zugleich fand und unterwarf Agricola Inseln, die bis dahin unbekannt waren und Orkaden genannt werden.“"
                                            },
                                            {
                                                "example_id": "d77d8af2-7e42-4416-a427-025c6d4c85a6",
                                                "sense_id": "c6c073ef-96e8-3642-8e53-815053ab8dd7",
                                                "text": "„Russland will die Ukraine unterwerfen, […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1891b5ee-5a33-3d2c-a217-c92d9453859a",
                                        "entry_id": "b86f3655-7b70-318d-8259-32ba9c17c49a",
                                        "glosses": [
                                            "sich einer fremden Gewalt unterordnen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f5d5049-255c-4881-90ae-868957e17b07",
                                                "sense_id": "1891b5ee-5a33-3d2c-a217-c92d9453859a",
                                                "text": "„Obwohl die Stadt militärisch nicht einnehmbar war, musste sich Ottokar dennoch den Habsburgern unterwerfen und muss sich in ein Gebiet nördlich der Donau zurückziehen.“"
                                            },
                                            {
                                                "example_id": "526524b6-5f12-42ba-891c-de9ba2482e00",
                                                "sense_id": "1891b5ee-5a33-3d2c-a217-c92d9453859a",
                                                "text": "„Freiwillig wollten sich die Britannier der angelsächsischen Koalition nicht unterwerfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f14400e7-92d9-3a9f-af39-ba1d472d6b7e",
                                        "entry_id": "b86f3655-7b70-318d-8259-32ba9c17c49a",
                                        "glosses": [
                                            "eine Bedingung oder Prüfung akzeptieren; eine Bedingung oder Prüfung auferlegen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccdaf17f-5859-4827-8236-f12f08dbf809",
                                                "sense_id": "f14400e7-92d9-3a9f-af39-ba1d472d6b7e",
                                                "text": "„In der zweiten Kategorie herrschte dagegen ‚Industrialfreiheit‘, das heißt sie waren nicht den genannt zünftigen Beschränkungen unterworfen; […].“"
                                            },
                                            {
                                                "example_id": "56b3064f-4fa4-41e1-acf6-56947679431a",
                                                "sense_id": "f14400e7-92d9-3a9f-af39-ba1d472d6b7e",
                                                "text": "„In jedem derartigen Zusammenhang muss der GH jedoch alle Umstände des Falles, insbesondere die persönliche Situation des Bf. im ausweisenden Staat, einer strengen Prüfung unterwerfen.“"
                                            },
                                            {
                                                "example_id": "aeaedbbc-6f36-4d1b-8b13-06b132d77231",
                                                "sense_id": "f14400e7-92d9-3a9f-af39-ba1d472d6b7e",
                                                "text": "„Hat der Eigentümer seinen Wohnsitz oder Hauptsitz in einem Land, das noch keine Vorschriften hinsichtlich der Überprüfung von Containern erlassen hat, so kann er sich den Bestimmungen dieses Paragraphen unterwerfen und ist insoweit einem Eigentümer mit Wohnsitz oder Hauptsitz im Inland gleichzuhalten.“"
                                            },
                                            {
                                                "example_id": "fe38335a-c3f1-4847-a3de-04fff6f772a0",
                                                "sense_id": "f14400e7-92d9-3a9f-af39-ba1d472d6b7e",
                                                "text": "„Unterwirft man einen paramagnetischen Körper einem starken magnetischen Felde, so wird der spontane Magnetismus, der in den einzelnen Volumelementen des Körpers vorhanden ist, gleichgerichtet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83df9477-b5e7-4f7d-92fb-365b2a19300f",
                        "source_entry_id": "e6234d6a-864c-3a1f-80b4-4ac41fbed7d4",
                        "source_sense_id": "68499570-7219-35ba-afc4-77e8d7cbff67",
