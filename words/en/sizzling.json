                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "heat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The waiter brought out the <w>sizzling</w> fajitas while they were still popping.",
                            "target_lang_translations": {
                                "cs": "Číšník přinesl <w>syčící</w> fajitas, zatímco ještě prskaly.",
                                "zh": "服务员端上还在噼啪作响的<w>铁板</w>法吉塔。"
                            }
                        },
                        {
                            "text": "We ordered the <w>sizzling</w> steak, which arrived at the table still cooking.",
                            "target_lang_translations": {
                                "cs": "Objednali jsme si <w>syčící</w> steak, který dorazil ke stolu ještě v procesu přípravy.",
                                "zh": "我们点了<w>铁板</w>牛排，端上桌时肉还在滋滋作响地煎着。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sizzling steak",
                        "sizzling fajitas"
                    ],
                    "target_lang_definitions": {
                        "cs": "Servírovaný na horké pánvi, stále syčící.",
                        "zh": "（菜肴）盛在滚烫铁盘中端上桌、滋滋作响的；铁板的"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "syčící",
                                "target_lang_sense_clarification": "přímo z pánve"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "铁板",
                                "target_lang_sense_clarification": "放在铁盘中上桌作响的"
                            },
                            {
                                "target_lang_word": "滋滋作响的",
                                "target_lang_sense_clarification": "端上桌时冒着热气发出响声"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aaabb847-44e9-32c3-b95f-f33e8249af1f",
                    "sense_definition": "A hissing sound.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>sizzling</w> of the bacon woke everyone up in the morning.",
                            "target_lang_translations": {
                                "cs": "<w>Syčení</w> slaniny ráno všechny probudilo.",
                                "zh": "早晨培根煎出的<w>滋滋声</w>把大家都叫醒了。"
                            }
                        },
                        {
                            "text": "I could hear the soft <w>sizzling</w> of the rain hitting the hot pavement.",
                            "target_lang_translations": {
                                "cs": "Slyšel jsem tiché <w>syčení</w> deště dopadajícího na horký chodník.",
                                "zh": "我能听见雨水打在滚烫路面上发出的微弱<w>嘶嘶声</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hiss"
                    ],
                    "target_lang_definitions": {
                        "cs": "Syčivý zvuk, který vzniká při smažení.",
                        "zh": "（煎炸或高温物体接触液体时发出的）滋滋声"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "syčení",
                                "target_lang_sense_clarification": "zvuk smažení"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "滋滋声",
                                "target_lang_sense_clarification": "高温或煎炸发出的声音"
                            },
                            {
                                "target_lang_word": "嘶嘶声",
                                "target_lang_sense_clarification": "热气或煎炸发出的声响"
                            }
                        ]
                    }
                }
            ]
        },
