                ],
                "senses": [
                    {
                        "sense_id": "1496e428-a7db-35b1-af4a-e47524b690d3",
                        "entry_id": "80e1b06b-7c11-39c6-b1d0-494193590c38",
                        "glosses": [
                            "ein, meist parlamentarischer, Ausschuss zur Untersuchung von Sachverhalten, deren Aufklärung im öffentlichen Interesse liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e359dea8-d5bd-42a6-a3fd-7dbff47c41a6",
                                "sense_id": "1496e428-a7db-35b1-af4a-e47524b690d3",
                                "text": "„Der Fall, der schon zwei Untersuchungsausschüsse beschäftigte, geht zurück auf eine Verfügung des Frankfurter Finanzamts V von 2001 …“"
                            },
                            {
                                "example_id": "08f3b165-8a3f-4975-8816-87a0adf123d4",
                                "sense_id": "1496e428-a7db-35b1-af4a-e47524b690d3",
                                "text": "„Vergangene Woche setzte der Kongress einen Untersuchungsausschuss ein.“"
                            },
                            {
                                "example_id": "3fc3f99b-59c8-4894-ac4b-c4685dbaffbc",
                                "sense_id": "1496e428-a7db-35b1-af4a-e47524b690d3",
                                "text": "„Ab Januar wird ein Untersuchungsausschuss im EU-Parlament der Frage nachgehen, warum das alles so lange gedauert hat.“"
                            },
                            {
                                "example_id": "7ef4d586-5e2a-4c88-8cf9-b1a9c008950c",
                                "sense_id": "1496e428-a7db-35b1-af4a-e47524b690d3",
                                "text": "„Das Ministerium hingegen fürchtete einen amtlichen Untersuchungsausschuss wie der Teufel das Weihwasser.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a0828b38-3d95-4acc-beea-5e721956fbcb",
                        "source_entry_id": "80e1b06b-7c11-39c6-b1d0-494193590c38",
                        "source_sense_id": "1496e428-a7db-35b1-af4a-e47524b690d3",
