                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc5f70de-6976-475f-998d-2c916ca0383e",
                                "sense_id": "09eb7e64-096a-3791-b8b0-648fce7e62ac",
                                "text": "„Vereinbarungsgemäß wird nachstehend eine Zusammenfassung des Gesprächs zwischen dem Bundeskanzler und dem portugiesischen Premierminister Balsemão am 15.6. in der Abfolge des Gesprächsverlaufs vorgelegt.“"
                            },
                            {
                                "example_id": "21f959a9-1f9c-462a-be84-a3df7aeed9e0",
                                "sense_id": "09eb7e64-096a-3791-b8b0-648fce7e62ac",
                                "text": "„Schon im vergangenen Monat hatte der ehemalige portugiesische Ministerpräsident und jetzige Chef des europäischen Verlegerrats EPC, Pinto Balsemão, gegenüber Reuters darauf hingewiesen, dass sich Internet-Suchmaschinen inzwischen 90 Prozent der Online-Anzeigenetats gesichert hätten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
