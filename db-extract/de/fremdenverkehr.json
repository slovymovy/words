                "senses": [
                    {
                        "sense_id": "b6d54388-82e0-34b5-923c-080ba7e6162e",
                        "entry_id": "dba9931c-26c6-3500-b9fa-c4d45d8486e3",
                        "glosses": [
                            "Reise-/Urlaubsverkehr von nicht Ortsansässigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1d721ff-ad24-4ba8-ba60-e87368742e10",
                                "sense_id": "b6d54388-82e0-34b5-923c-080ba7e6162e",
                                "text": "„In der Gegenwart wird die wirtschaftliche Struktur der Stadt Koblenz vor allem durch ein breites Spektrum von zum Teil hochrangigen Funktionen in den Bereichen Verwaltung, Handel und Dienstleistungen sowie Bildung, Kultur und Fremdenverkehr geprägt.“"
                            },
                            {
                                "example_id": "e10ccf44-da57-403a-8e1b-e9c224c374f4",
                                "sense_id": "b6d54388-82e0-34b5-923c-080ba7e6162e",
                                "text": "„Wo der Weinbau nicht mehr lohnte, wandte man sich gerne dem Fremdenverkehr zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
