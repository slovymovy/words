                                "sense_id": "c5e0ece1-1054-3428-b26c-49d26bb3e40e",
                                "text": "Ce cheval à un fer qui loche."
                            },
                            {
                                "example_id": "8b660e67-2147-439c-b384-af13c437f5f4",
                                "sense_id": "c5e0ece1-1054-3428-b26c-49d26bb3e40e",
                                "text": "Ça loche, ce manège !"
                            },
