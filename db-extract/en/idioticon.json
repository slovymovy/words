    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "fc0eea17-5bed-37b1-9c26-e1d1ba6d3bee",
                "word": "idioticon",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "71aeb0f4-f3d4-4fbc-b88e-52717a8e4a8b",
                        "entry_id": "fc0eea17-5bed-37b1-9c26-e1d1ba6d3bee",
                        "tags": [
