                                    },
                                    {
                                        "sense_id": "abe0e6cf-4974-3f53-a28d-0dd2a9d9f915",
                                        "entry_id": "15818eac-4591-3e5f-a66f-229905b3c502",
                                        "glosses": [
                                            "Première personne du singulier du subjonctif présent de paradoxer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
