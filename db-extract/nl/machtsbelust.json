                "senses": [
                    {
                        "sense_id": "f58f4f6a-5f83-3eec-a124-5f6fc411d869",
                        "entry_id": "7f11dc0a-ea11-32b6-8676-7c8f342cf5d7",
                        "glosses": [
                            "gedreven door een verlangen naar macht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14bdc069-1479-4589-b2ba-15146a33f01a",
                                "sense_id": "f58f4f6a-5f83-3eec-a124-5f6fc411d869",
                                "text": "Die machtsbeluste dictator is niet te vertrouwen."
                            },
                            {
                                "example_id": "0df01eaf-ca25-4182-99a5-1024f9127c48",
                                "sense_id": "f58f4f6a-5f83-3eec-a124-5f6fc411d869",
                                "text": "De founding fathers hadden deze situatie niet voorzien, zegt Wehle. „Het systeem is niet opgetuigd met het idee dat een machtsbeluste, crimineel ingestelde autocraat het Witte Huis zou bereiken, en dat een van de twee partijen fascistisch zou worden. De grondwet is niet waterdicht, en nu faalt hij”."
                            }
                        ]
                    }
