                    }
                ],
                "senses": [
                    {
                        "sense_id": "1494ce32-53dd-391e-93e1-65dcb1247f29",
                        "entry_id": "4e8de5d6-f992-348f-9628-18e3d37b4555",
                        "glosses": [
                            "Se dit d'une personne qui s'identifie habituellement comme hétérosexuelle ou homosexuelle, mais qui manifeste un certain intérêt ou entretient des fantasmes à l’idée d’avoir une expérience sexuelle avec une personne du sexe qu’elle ne favorise pas d’habitude, souvent en n’assumant pas ou en rejetant l’étiquette de bisexuelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3fe329b-d3ec-47a1-9c18-9791240f5500",
                                "sense_id": "1494ce32-53dd-391e-93e1-65dcb1247f29",
                                "text": "Si vous vous identifiez comme bi-curieux, vous apprenez probablement à vous connaître. Peut-être qu’avec le temps, vous découvrirez que vous êtes bisexuel ou que vous êtes vraiment homosexuel ou hétérosexuel."
                            },
                            {
                                "example_id": "c3591e29-d107-4010-ac54-0f4ff853548b",
                                "sense_id": "1494ce32-53dd-391e-93e1-65dcb1247f29",
                                "text": "Comme l’a dit Katy Perry, cette sage chanteuse, embrasser une fille et en profiter pourrait être un signe que vous êtes bi-curieux, surtout si vous ne voulez pas que le baiser s’arrête et si le baiser vous excite."
                            },
                            {
                                "example_id": "b80f435c-1d7e-462c-89b9-c54ae95c9b91",
                                "sense_id": "1494ce32-53dd-391e-93e1-65dcb1247f29",
                                "text": "Les mecs qui se savent bis (ou bi-curieux) devraient avoir la décence de prévenir leurs fiancées avant le mariage."
                            }
                        ]
                    },
                    {
                        "sense_id": "2fe0a92d-e03e-3a93-af92-9f2141c1fd45",
                        "entry_id": "4e8de5d6-f992-348f-9628-18e3d37b4555",
                        "glosses": [
                            "Se dit d’un comportement relatif à la bi-curiosité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2265b97-7740-4ced-a3e9-fadf57c6baff",
                                "sense_id": "2fe0a92d-e03e-3a93-af92-9f2141c1fd45",
                                "text": "Les comportements au moins bi-curieux sont beaucoup plus prononcés chez les femmes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc2d4342-3048-430c-9ede-d6c13bd709da",
                        "source_entry_id": "4e8de5d6-f992-348f-9628-18e3d37b4555",
                        "target_lang_word": "bi-curious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bi-curious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a3b2767d-6796-3b05-9f1c-3c15fdb29d0a",
                                        "entry_id": "ee56006d-acba-38a4-a804-f2873913f600",
                                        "glosses": [
                                            "Interested in having relationships with both men and women, curious about one's potential bisexuality; especially, of heterosexual people, considering a first sexual experience with a member of the same sex."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbef7333-2a84-435b-a0d6-08441ab9c22c",
                                                "sense_id": "a3b2767d-6796-3b05-9f1c-3c15fdb29d0a",
                                                "text": "Bi curious M/F or cpls."
                                            },
                                            {
                                                "example_id": "066798f5-666a-4d08-a6e0-151ac0b3572c",
                                                "sense_id": "a3b2767d-6796-3b05-9f1c-3c15fdb29d0a",
                                                "text": "\"Does this make us bi-curious, or are some dudes just that girly?\""
                                            },
                                            {
                                                "example_id": "7f3481ec-9e2d-47e5-8b15-44ac9d9045ac",
                                                "sense_id": "a3b2767d-6796-3b05-9f1c-3c15fdb29d0a",
                                                "text": "Skirt Club caters to bisexual or bicurious women. No men are allowed, but women with all levels of experience in same-sex sexuality, from bicurious to fully lesbian, are welcomed."
                                            },
                                            {
                                                "example_id": "65cbbec0-12f4-47bf-9db2-e15fc1f2edeb",
                                                "sense_id": "a3b2767d-6796-3b05-9f1c-3c15fdb29d0a",
                                                "text": "Although Katy has admitted to being bi-curious in the past, the reason a lot of fans wanted clarity on her sexuality was to ensure she wasn't queer-baiting and benefiting from a culture she isn't actually part of."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
