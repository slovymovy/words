                "senses": [
                    {
                        "sense_id": "4fd22a91-3852-3200-b1b4-88fd26890023",
                        "entry_id": "3001fc78-0dbb-3d55-9c2a-3fdb4502361c",
                        "glosses": [
                            "dotyczący ziemi falerneńskiej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7cfd042-6a1b-4545-8bc6-f58e7cedb273",
                                "sense_id": "4fd22a91-3852-3200-b1b4-88fd26890023",
                                "text": "Wszak wiesz… gdzie oliw czarny gaj i skała, / I srebrne, ogniem ozłocone wiosła; / Wszak wiesz… ta chata nasza bez zapory, / To falerneńskie wino… i amfory…"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bb99c3bc-bfd8-4cdf-a965-e800a8ae9314",
                        "source_entry_id": "3001fc78-0dbb-3d55-9c2a-3fdb4502361c",
                        "source_sense_id": "4fd22a91-3852-3200-b1b4-88fd26890023",
                        "target_lang_word": "Falernian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Falernian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c87813d1-f692-372c-a17b-3c63b821bdb1",
                                        "entry_id": "1d47b8a2-3e0a-35bf-a9de-947a4734d885",
                                        "glosses": [
                                            "Of, produced in, or pertaining to Mount Falernus, in Italy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "323c3c0c-111a-4c56-8847-289166534ddf",
                                                "sense_id": "c87813d1-f692-372c-a17b-3c63b821bdb1",
                                                "text": "Sandbanks, marshes, forests, savages, - precious little to eat fit for a civilised man, nothing but Thames water to drink. No Falernian wine here, no going ashore."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Falernian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d9a5ebf-f970-3c89-928d-4be2e9140bb4",
                                        "entry_id": "c287e437-9d6c-3cb5-bdfb-25fa58dd7a6e",
                                        "glosses": [
                                            "A wine produced from Aglianico grapes on the slopes of Mount Falernus, much esteemed in Ancient Rome."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de8413a1-dcfa-4ee1-8f86-59ca642fd827",
                                                "sense_id": "6d9a5ebf-f970-3c89-928d-4be2e9140bb4",
                                                "text": "What’s a Helen of Troy compared to a flask of this red Falernian? Why good wine gets better the longer you keep it, while woman loses her flavour year by year."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71c75a34-7074-4c72-9cfe-37129d061c3c",
                        "source_entry_id": "3001fc78-0dbb-3d55-9c2a-3fdb4502361c",
                        "source_sense_id": "4fd22a91-3852-3200-b1b4-88fd26890023",
                        "target_lang_word": "Falerner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Falerner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb60d5d3-ca10-372b-ba1f-16ee82b3f9f1",
                                        "entry_id": "8238ead8-4db4-3cd6-bd9f-7103f6e0c10b",
                                        "glosses": [
                                            "ein antiker Weiß- oder auch Rotwein, der von den Römern häufig als Tischwein getrunken wurde"
                                        ],
                                        "tags": [
                                            "römische Antike"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a65caaca-d55c-45db-a547-722edaa3f14c",
                                                "sense_id": "cb60d5d3-ca10-372b-ba1f-16ee82b3f9f1",
                                                "text": "„Der Falerner gehörte zu den beliebtesten Weinsorten des römischen Reichs und wird oft bei antiken Schriftstellern erwähnt.“"
                                            },
                                            {
                                                "example_id": "f5848d40-c97a-450f-981b-4e0a0c9d24fd",
                                                "sense_id": "cb60d5d3-ca10-372b-ba1f-16ee82b3f9f1",
                                                "text": "Falerner gab es als Weiß- und als Rotwein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
