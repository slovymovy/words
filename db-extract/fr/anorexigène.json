                                        "entry_id": "4f09eae7-b059-3838-86ca-66159d62a735",
                                        "glosses": [
                                            "Arzneistoff, der den Appetit verringert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0e0606a-ca7f-431b-908b-a006439c2604",
                                                "sense_id": "4481b6fa-21c3-37eb-b751-f9ca2b7cde6f",
                                                "text": "Anorektika wirken in der Regel nicht langfristig, haben aber erhebliche Nebenwirkungen."
                                            }
