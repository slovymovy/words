                "senses": [
                    {
                        "sense_id": "e211b670-bc30-3e84-bf92-3e71a9f0f31e",
                        "entry_id": "0eb5dc72-21f7-3939-ab86-46ef2e8868f5",
                        "glosses": [
                            "literarische Gattung: altisländische Prosaerzählung, deren Gegenstand die erste Zeit nach der Besiedlung Islands ist"
                        ],
                        "tags": [
                            "Literaturwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "0ef8a45e-f9de-4983-a2bd-134b22013162",
                                "sense_id": "e211b670-bc30-3e84-bf92-3e71a9f0f31e",
                                "text": "„Der Ausdruck kommt von einer Person in der Färingersaga, die als eine von den Isländersagas gilt.“"
                            },
                            {
                                "example_id": "f7c67b0e-8478-4a8d-b7a6-078ca1d85a7f",
                                "sense_id": "e211b670-bc30-3e84-bf92-3e71a9f0f31e",
                                "text": "„Weil aber die Isländersaga und die Fornaldarsaga einheimische Stoffe behandeln, werden sie auf älteren Grundlagen beruhen als die Übersetzungsliteratur.“"
                            },
                            {
                                "example_id": "e88e6e37-7f1d-4c97-9e0f-5169fb6a919c",
                                "sense_id": "e211b670-bc30-3e84-bf92-3e71a9f0f31e",
                                "text": "„Es sind knapp 40 Erzählungen, die man zu den Isländersagas zählt.“"
                            },
                            {
                                "example_id": "51f69d81-98a6-4b9a-af2f-54b922563ba0",
                                "sense_id": "e211b670-bc30-3e84-bf92-3e71a9f0f31e",
                                "text": "„Sie bilden im Reiche der Isländersagas die geschlossenste Provinz, zusammengehalten wie keine andere Gruppe durch den Schauplatz und durch die Personen.“"
                            },
                            {
                                "example_id": "558435ca-28f6-4a10-bc1d-f46a7fe54763",
                                "sense_id": "e211b670-bc30-3e84-bf92-3e71a9f0f31e",
                                "text": "„Den Kern der Sammlung bildet der Wortschatz der Isländersagas und der klassischen Werke der isländisch-norwegischen Geschichtsschreibung…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
