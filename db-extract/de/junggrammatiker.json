                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Junggrammatiker"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6068eb01-d9a7-388b-aa5e-4bf60c89abe0",
                        "entry_id": "61174a68-768d-3067-804e-a6fdb8c5bbde",
                        "glosses": [
                            "eine Gruppe von Linguisten des ausgehenden 19. und beginnenden 20. Jahrhunderts, die vornehmlich sprachhistorisch ausgerichtet waren und Sprachwandel durch Analogie, Entlehnung und vor allem Lautgesetz erklärten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59a548e9-7155-4442-a724-41be2fb3dae0",
                                "sense_id": "6068eb01-d9a7-388b-aa5e-4bf60c89abe0",
                                "text": "Für die Junggrammatiker war Sprachwissenschaft nur als historische Wissenschaft möglich."
                            },
                            {
                                "example_id": "913f7fb5-d15c-460d-9ed1-55dcd25a97fe",
                                "sense_id": "6068eb01-d9a7-388b-aa5e-4bf60c89abe0",
                                "text": "„Die Verdienste der Junggrammatiker bestehen 1) in der strengeren Fassung und Vollendung der Methoden der Komparatistik und ihrer erfolgreichen Anwendung…“"
                            },
                            {
                                "example_id": "17e59680-f618-47c6-8998-c234a7467ab8",
                                "sense_id": "6068eb01-d9a7-388b-aa5e-4bf60c89abe0",
                                "text": "„Unzweifelhaft haben die Methodologien und Analyseverfahren der Junggrammatiker nachhaltigen Einfluß auf spätere Entwicklungen der Sprachwissenschaft gehabt.“"
                            },
                            {
                                "example_id": "2cb75327-c852-4adc-864c-4a45c5c34d5e",
                                "sense_id": "6068eb01-d9a7-388b-aa5e-4bf60c89abe0",
                                "text": "„Die Junggrammatiker ließen somit den Sprachwandel von zwei Kräften beherrscht werden, den mit Naturnotwendigkeit herrschenden Lautgesetzen und der durchkreuzend von der Seele her eingreifenden Analogie, die freilich nur auftreten konnte, nicht mußte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
