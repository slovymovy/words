                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "floating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They pushed the heavy wooden boat into the lake to set it <w>afloat</w>.",
                            "target_lang_translations": {
                                "zh": "他们把沉重的木船推入湖中，使其<w>漂浮</w>起来。"
                            }
                        },
                        {
                            "text": "The rescue team worked quickly to get the stranded ship <w>afloat</w> again.",
                            "target_lang_translations": {
                                "zh": "救援队迅速行动，使搁浅的船只重新<w>漂浮</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "set afloat",
                        "get afloat"
                    ],
                    "target_lang_definitions": {
                        "zh": "使进入漂浮状态。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "使……漂浮",
                                "target_lang_sense_clarification": "指将物体放入水中使其浮起。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3127875f-20d4-336c-a262-47c5cd527dda",
