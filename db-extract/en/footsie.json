            {
                "entry_id": "2a297608-952b-343b-b8df-804eb789fcd7",
                "word": "footsie",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5cf0565d-e5e9-4260-8d4c-68278f8d1e66",
                        "entry_id": "2a297608-952b-343b-b8df-804eb789fcd7",
                        "tags": [
                            "plural"
                        ],
                        "form": "footsies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "241d8557-4c64-3e2c-a267-ce495839c59f",
                        "entry_id": "2a297608-952b-343b-b8df-804eb789fcd7",
                        "glosses": [
                            "A flirting game where two people touch their feet together, under a table or otherwise concealed, as a romantic prelude."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e3ef4d9a-dc37-4166-810e-78c0b78f9f10",
                                "sense_id": "241d8557-4c64-3e2c-a267-ce495839c59f",
                                "text": "Play “footsie” with him while dining out together."
                            },
                            {
                                "example_id": "6f066259-cb6c-458c-a0d0-a77a610078c0",
                                "sense_id": "241d8557-4c64-3e2c-a267-ce495839c59f",
                                "text": "The only downside to this is that you can’t play footsie. The table gets in the way. You'll have to come up with something fresh if you want to invite that wonderful person to finish the evening at your side for a stroll along the banks of the Seine."
                            }
                        ]
                    },
                    {
                        "sense_id": "59b988d1-e141-3f99-85b2-f509c8227f99",
                        "entry_id": "2a297608-952b-343b-b8df-804eb789fcd7",
                        "glosses": [
                            "A foot."
                        ],
                        "tags": [
                            "childish",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "861ae81d-3c3c-4502-8ae4-ccac2b158ff5",
                                "sense_id": "59b988d1-e141-3f99-85b2-f509c8227f99",
                                "text": "“Mother — Mother will you tie up my shoeies?” Susan’s lisping voice interrupted their conversation. / “Put a footsie up here,” Babs sang out. “’At’s a girl.”"
                            },
                            {
                                "example_id": "0cead84b-f42c-44b2-8f62-93172cb5e7ad",
                                "sense_id": "59b988d1-e141-3f99-85b2-f509c8227f99",
                                "text": "One of the boys was seated on my white chaise-lounge. I put my five foot five down on the end of the chaise and said, “Move your footsies, Honey, Mother needs to park her tired ass.”"
                            },
                            {
                                "example_id": "9f921ce0-d326-4833-a5a0-522b418ac5d2",
                                "sense_id": "59b988d1-e141-3f99-85b2-f509c8227f99",
                                "text": "Dear God, I am thankful for ears that can wiggle For lips that can pucker and bellies that jiggle. For legs that can gallop and gambol and mosey. And thanks for each hair and each footsie and toesie."
                            }
                        ]
                    },
                    {
                        "sense_id": "bea78244-f578-3bbc-9d68-e47248a68cef",
                        "entry_id": "2a297608-952b-343b-b8df-804eb789fcd7",
                        "glosses": [
                            "A selfie (self-taken photograph) of one's feet."
                        ],
                        "tags": [
                            "countable",
                            "slang",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4e9e3ff0-6ac0-4ca8-94b6-76f5bdb435b6",
                        "source_entry_id": "2a297608-952b-343b-b8df-804eb789fcd7",
                        "source_sense_description": "flirting game",
                        "target_lang_word": "voetjevrijen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voetjevrijen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "40a39a91-1a56-3196-9a13-c8b0f8417dd5",
                                        "entry_id": "a6b38df8-d92a-3a16-9665-eba1c1eb338d",
                                        "glosses": [
                                            "handeling waarbij twee (of meer) personen elkaar liefdevol en/of heimelijk met de (blote) voeten aanraken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0213382-95c7-457e-8777-1f46e716cafa",
                                                "sense_id": "40a39a91-1a56-3196-9a13-c8b0f8417dd5",
                                                "text": "Voetjevrijen is op zulke momenten meestal wel toegestaan, mits je tenminste niet probeert om op die manier haar benen uit elkaar te krijgen."
                                            },
                                            {
                                                "example_id": "26d13702-3390-4a83-91fb-e4b85e723140",
                                                "sense_id": "40a39a91-1a56-3196-9a13-c8b0f8417dd5",
                                                "text": "Punt in ons geval is dat ik een ‘nieuwe man’ ben in een, in seksueel opzicht, hartstikke traditionele relatie. Ik kan inmiddels zoenen, voetjevrijen, strelen, friemelen, tot tien tellen, aan wiskunde denken, en anderszins ‘niet op het kruis gericht zijn’ als de beste."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28f7854f-50a0-478d-a779-567aeab270e3",
                        "source_entry_id": "2a297608-952b-343b-b8df-804eb789fcd7",
