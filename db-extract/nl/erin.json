                    {
                        "sense_id": "e05b24d1-bf64-34bf-ab82-eb3e1b04a556",
                        "entry_id": "6aed3a05-b21f-33b4-931b-101218509151",
                        "glosses": [
                            "persoonlijk: *in+het, in+ze:"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6aae0d01-90fd-40be-9584-946c03cde9ec",
                                "sense_id": "e05b24d1-bf64-34bf-ab82-eb3e1b04a556",
                                "text": "Het zat erin verstopt."
                            },
                            {
                                "example_id": "af05ef01-d0a0-448a-9e5b-5fa90eaeb6e6",
                                "sense_id": "e05b24d1-bf64-34bf-ab82-eb3e1b04a556",
                                "text": "Er zat iets in verstopt."
                            },
                            {
                                "example_id": "c7a55e16-3ed6-4682-89e8-c4b185d143cf",
                                "sense_id": "e05b24d1-bf64-34bf-ab82-eb3e1b04a556",
                                "text": "Het verbaasde Teresa dat Sarah erin was geslaagd om zichzelf in Santa Justa in de waterput te zien."
                            },
                            {
                                "example_id": "16ef5172-d41f-48eb-9104-8e072db5ee98",
                                "sense_id": "e05b24d1-bf64-34bf-ab82-eb3e1b04a556",
                                "text": "Isaac slaagde erin om in Malaga een geweer te kopen van een vakbondsman die er prat op ging dat hij illegaal op wilde zwijnen joeg op het land van zijn baas."
                            }
                        ]
                    }
                ],
