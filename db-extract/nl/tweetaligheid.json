                                        "glosses": [
                                            "The condition of being bilingual; the ability to speak two languages."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b08961d-5922-4471-8142-0fee6ae3d065",
                                                "sense_id": "48c2ecb4-43f6-36ca-aa4d-6d6d1a6a6923",
                                                "text": "At Kingsbridge, the bilingualism of the Irish Republic was evident in the tickets, the station notices, and the neat destination boards on the 10.40 a.m. express to Cork."
                                            }
                                        ]
                                    }
                                ]
                            }
