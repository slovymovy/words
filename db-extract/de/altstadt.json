                "senses": [
                    {
                        "sense_id": "b907a48d-2b25-3320-b91b-d317f2e410a5",
                        "entry_id": "3e279ff0-19f6-3686-a990-d058b19c3664",
                        "glosses": [
                            "Vieille ville, centre ville historique."
                        ],
                        "tags": [
                            "Urbanisme"
                        ],
                        "examples": [
                            {
                                "example_id": "3af3fbdb-6408-4d77-b0cf-84a99273e32c",
                                "sense_id": "b907a48d-2b25-3320-b91b-d317f2e410a5",
                                "text": "In der Altstadt von Prag gibt es Gebäude aus dem 14. Jahrhundert.",
                                "translation": "Dans le centre ville historique de Prague, il y a des bâtiments datant du 14e siècle."
                            },
                            {
                                "example_id": "c1e3dcdc-ff3d-4ebe-878b-c6de2853d6fb",
                                "sense_id": "b907a48d-2b25-3320-b91b-d317f2e410a5",
                                "text": "In diesem Foto hebt sich die Silhouette der Altstadt wunderschön vom hellblauen Himmel ab.",
                                "translation": "Sur cette photo, la silhouette de la vieille ville se détache magnifiquement du le ciel bleu clair."
                            },
                            {
                                "example_id": "fd6850dd-0f97-4a9b-b32b-5e166fa2bae9",
                                "sense_id": "b907a48d-2b25-3320-b91b-d317f2e410a5",
                                "text": "In Quedlinburg werden wir haltmachen und uns auf einen zweistündigen Spaziergang in der malerischen Altstadt begeben.",
                                "translation": "Nous nous arrêterons à Quedlinburg et ferons une promenade de deux heures dans la vieille ville pittoresque."
                            },
                            {
                                "example_id": "b3e74d6e-e619-4d20-b93e-424a58004a28",
                                "sense_id": "b907a48d-2b25-3320-b91b-d317f2e410a5",
                                "text": "Bärlach war anfangs November 1948 ins Salem eingeliefert worden, in jenes Spital, von dem aus man die Altstadt Berns mit dem Rathaus sieht.",
                                "translation": "C’est au début de novembre 1948 que Baerlach avait été admis à l’hôpital Salem, dont les bâtiments donnent sur la vieille cité et l’hôtel de ville de Berne."
                            },
                            {
                                "example_id": "b2d00542-406d-4f7b-847d-81e4ab3fec54",
                                "sense_id": "b907a48d-2b25-3320-b91b-d317f2e410a5",
                                "text": "Neulich lief mir unter den Arkaden der mittelalterlichen Altstadt von Bern der sympathische Zürcher Nationalrat Peter Spaelti über den Weg, dessen gebräuntes Gesicht verrät, daß Leben und Regieren ihm Spaß machen.",
                                "translation": "Récemment, sous une arcade de la ville médiévale de Berne, je croisais le visage bronzé, heureux de vivre et de régner, de l’exubérant conseiller national zurichois Peter Spaelti."
                            }
                        ]
                    }
                ],
