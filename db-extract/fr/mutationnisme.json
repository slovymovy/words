                        "glosses": [
                            "Théorie des transformations spontanées et héréditaires des êtres vivants par mutations."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec182672-7e70-4fd2-a09d-7d449b606c19",
                                "sense_id": "e59f33ec-5005-33e0-a604-c1c511e7c51a",
                                "text": "Forme moderne de la théorie des variations fortuites imaginée au XVIIIᵉ siècle par Maupertuis, le mutationnisme se rattache directement aux idées soutenues, du temps de Darwin, par Huxley, Harvey, Meehan, etc... […]. A dater de de Vries, le mutationnisme gagnera promptement du terrain au détriment du lamarckisme et du darwinisme."
                            }
                        ]
                    }
