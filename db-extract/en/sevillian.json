                                        "sense_id": "b4be04ba-c7d1-3a33-83e2-7f1c2289a875",
                                        "entry_id": "3f5e1be8-305c-37bc-8c45-df49aecb16e0",
                                        "glosses": [
                                            "Habitant de Séville, en Espagne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1016dfb-fff2-4875-9e96-394c6c944866",
                                                "sense_id": "b4be04ba-c7d1-3a33-83e2-7f1c2289a875",
                                                "text": "Et l’autre était bien Sévillane avec sa manière de zézayer et d’avaler les s systématiquement, demandant à Concha : « ¿ Ere vaca ? » au lieu de « ¿ Eres vasca ? » qui aurait évité ce mauvais calembour."
                                            }
                                        ]
                                    }
                                ]
