                ],
                "senses": [
                    {
                        "sense_id": "84545f02-744c-35b2-b00b-9bce5ac480af",
                        "entry_id": "21c4dc77-fdef-32a6-ad0b-6907641e9404",
                        "glosses": [
                            "Verfechter, Profiteur des Kapitalismus beziehungsweise der freien Marktwirtschaft"
                        ],
                        "tags": [
                            "verächtlich"
                        ],
                        "examples": [
                            {
                                "example_id": "da41bc7f-2dfe-452a-9449-f4fc783002b4",
                                "sense_id": "84545f02-744c-35b2-b00b-9bce5ac480af",
                                "text": "„Am vierten Tag rief eine Frau an, beschimpfte uns als faule Kapitalistenschweine und legte wieder auf.“"
                            },
                            {
                                "example_id": "0dc0c63d-8c36-4cef-a896-b37a2aca1b44",
                                "sense_id": "84545f02-744c-35b2-b00b-9bce5ac480af",
                                "text": "„Sie zitiert aus Zeitungsartikeln, in denen \"Kapitalistenschweine\" den Finanzmarkt ruinieren, verweist auf Werbung, in der ein Schweinerüssel als Steckdose günstige Strompreise verspricht.“"
                            },
                            {
                                "example_id": "7d52cc5c-991d-4f6e-a446-2a5c5fb26ef0",
                                "sense_id": "84545f02-744c-35b2-b00b-9bce5ac480af",
                                "text": "„Nicht was geschrieben stand, ließ mich bald an der Zeitung zweifeln, sondern Bilder – politische Hetzkarikaturen, wie sie jedes SED-Blatt täglich auf Seite zwei darbot: Bonner Ultra-Wänste im Revanchistenfrack, Kapitalistenschweine mit Zigarre und Zylinder und was sich sonst noch suhlte im Koben des Klassenfeinds.“"
                            },
                            {
                                "example_id": "aa3c56f6-7d33-4d69-a8a5-6897c5c6337d",
                                "sense_id": "84545f02-744c-35b2-b00b-9bce5ac480af",
                                "text": "„In der Titelgeschichte hat ein starrsinniger Großvater seinen herrischen Auftritt, ein alter Kommunist, der den Enkel, der zum Studium nach Amerika geht, mit den Worten verabschiedet: ›Du mieses Kapitalistenschwein.‹“"
                            },
                            {
                                "example_id": "c5b42c46-151d-4e20-be9b-47d0f9818f9b",
                                "sense_id": "84545f02-744c-35b2-b00b-9bce5ac480af",
                                "text": "„Ich erinnere mich an seine Haare, wie Stahlwolle, kratzig und so viele, dass sein Gesicht unter all den Haaren klein und spitzig wirkte. Wasserblaue Augen, die treuherzig schauten, auch wenn er die sofortige Weltrevolution und die Liquidierung aller Kapitalistenschweine plante.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
