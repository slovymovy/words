                                    {
                                        "sense_id": "89f7aa88-d161-31a0-8a0d-1f6d5fb295e5",
                                        "entry_id": "b1699b00-0d3f-375c-868b-4f5e7f02e03c",
                                        "glosses": [
                                            "A container for arrows, crossbow bolts or darts, such as those fired from a bow, crossbow or blowgun."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91812c30-7fe8-4c00-85ac-583d930defd9",
                                                "sense_id": "89f7aa88-d161-31a0-8a0d-1f6d5fb295e5",
                                                "text": "Don Pedro: Nay, if Cupid have not spent all his quiver in Venice, thou wilt quake for this shortly."
                                            },
                                            {
                                                "example_id": "19b8b72b-436d-466b-be60-3c44d1e04f40",
                                                "sense_id": "89f7aa88-d161-31a0-8a0d-1f6d5fb295e5",
                                                "text": "Arrows were carried in quiver, called also an arrow case, which served for the magazine, arrows for immediate use were worn in the girdle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70fdfec9-d7c9-3de8-9135-1907801baf91",
                                        "entry_id": "b1699b00-0d3f-375c-868b-4f5e7f02e03c",
                                        "glosses": [
                                            "A ready storage location for figurative tools or weapons."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff1f61ef-94cf-49d9-8818-8caef4b4f948",
                                                "sense_id": "70fdfec9-d7c9-3de8-9135-1907801baf91",
                                                "text": "He's got lots of sales pitches in his quiver."
                                            }
                                        ]
