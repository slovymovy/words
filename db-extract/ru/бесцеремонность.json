                    }
                ],
                "senses": [
                    {
                        "sense_id": "0b415a4d-02f1-3504-800a-211a47382c86",
                        "entry_id": "5a5202c3-4c08-3da4-b85b-e4bcf54ed123",
                        "glosses": [
                            "свойство по значению прилагательного бесцеремонный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7582602-4834-4c8c-bf47-04726d2639d1",
                                "sense_id": "0b415a4d-02f1-3504-800a-211a47382c86",
                                "text": "Её поражали только глупость и бесцеремонность, но она сознавала себя настолько беззащитною, что мысль о жалобе даже не приходила ей в голову."
                            },
                            {
                                "example_id": "6da7c88b-c2c4-407c-988c-220739a7430c",
                                "sense_id": "0b415a4d-02f1-3504-800a-211a47382c86",
                                "text": "Бесцеремонность обвинений равнялась только их неожиданности."
                            },
                            {
                                "example_id": "f8c7c269-5af3-4260-89fd-4c1708d19d78",
                                "sense_id": "0b415a4d-02f1-3504-800a-211a47382c86",
                                "text": "Ни у кого не спросясь, по студенческой привычной бесцеремонности, я прямо пробрался к нему на квартиру."
                            },
                            {
                                "example_id": "7da8a8bd-daa8-428e-80fe-6e1859b89289",
                                "sense_id": "0b415a4d-02f1-3504-800a-211a47382c86",
                                "text": "Когда, знакомыми шагами простучав по коридору, вошёл Франц (с той резкой бесцеремонностью, с которой мы входим в собственную, заведомо пустую, комнату), она не улыбнулась."
                            },
                            {
                                "example_id": "c07dc258-e0a6-434e-a354-fc1933e22e0c",
                                "sense_id": "0b415a4d-02f1-3504-800a-211a47382c86",
                                "text": "Ровно и тихо выложил он, как претит ему бесцеремонность, с какой американцы торопятся захапать башковитых немцев, как грабят они интеллект этого и без того изуродованного народа."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c916137-3f1b-4f1b-b8d6-eb8b66667859",
                        "source_entry_id": "5a5202c3-4c08-3da4-b85b-e4bcf54ed123",
                        "source_sense_id": "0b415a4d-02f1-3504-800a-211a47382c86",
                        "target_lang_word": "bezceremonialność",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bezceremonialność",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "320ca442-fa30-32e1-8ea4-9f3d60981dfe",
                                        "entry_id": "87d82d41-13ec-38c4-a874-9c73a5f2a53b",
                                        "glosses": [
                                            "cecha tego, co jest bezceremonialne; cecha tych, którzy są bezceremonialni"
                                        ],
                                        "tags": [
                                            "deadjectival"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb74cb77-7873-45a6-98a6-d219695a3070",
                                                "sense_id": "320ca442-fa30-32e1-8ea4-9f3d60981dfe",
                                                "text": "W beletrystyczno-publicystycznej formie ukazał bezpośredniość i bezceremonialność Amerykanów, szybko rosnące miasta, rozległe przestrzenie kontynentu, który przemierzał koleją, konno i pieszo, żyzne doliny, skalne pustkowia i dzikie zwierzęta"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    }
