                    }
                ],
                "senses": [
                    {
                        "sense_id": "34fec26c-0f18-33a2-b0b0-e3d5ef54879a",
                        "entry_id": "b8d5c283-be20-336c-826f-27e01ae28455",
                        "glosses": [
                            "einer Spinne ähnelnd, wie eine Spinne aussehend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf923e3d-c3b6-43fd-8eb4-c85f58371622",
                                "sense_id": "34fec26c-0f18-33a2-b0b0-e3d5ef54879a",
                                "text": "„Spinnenartige grüne Muster krochen über den Himmel und brachten ihn zum Stottern.“"
                            },
                            {
                                "example_id": "a4e9c2f5-9cce-4d1f-8c58-69676dba8992",
                                "sense_id": "34fec26c-0f18-33a2-b0b0-e3d5ef54879a",
                                "text": "„Ich machte mich daran, einen Sinn aus der spinnenartigen Handschrift herauszulesen.“"
                            },
                            {
                                "example_id": "6ce0ecd4-f005-4627-bded-9c42ccf44aff",
                                "sense_id": "34fec26c-0f18-33a2-b0b0-e3d5ef54879a",
                                "text": "„Sie hatte spinnenartige Wimpern, große Hände und einen Revolver an der Hüfte.“"
                            },
                            {
                                "example_id": "764203c5-6bad-40a1-8bff-10d317ab0110",
                                "sense_id": "34fec26c-0f18-33a2-b0b0-e3d5ef54879a",
                                "text": "„Little Skag ließ den Hörer fallen, fuhr sich mit seinen spinnenartigen Fingern durchs fettige Haar und presste die Handballen gegen die Schläfen, als wollte er seine inneren Dämonen austreiben.“"
                            },
                            {
                                "example_id": "971eda4a-6e99-469f-91a0-4eabb42e03da",
                                "sense_id": "34fec26c-0f18-33a2-b0b0-e3d5ef54879a",
                                "text": "„Sie fand einen Dokumentarfilm über Raumstationen, stellte den Ton leise und betrachtete die spinnenartigen weißen Gebilde vor dem Hintergrund der Sterne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
