                "translations": [
                    {
                        "translation_id": "aa44e90d-b448-46bc-ae25-ef43c2700eb8",
                        "source_entry_id": "deaddd1e-c4dc-331c-8b92-720f05964a23",
                        "source_sense_id": "9e544e33-1f57-3a2b-bc49-75777a933bf3",
                        "target_lang_word": "Funkgerät",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Funkgerät",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "80618d16-e66d-3c7e-9a22-de49ac701fe9",
                                        "entry_id": "ba86cac8-ce3d-37ef-93cd-bff9c644349d",
                                        "glosses": [
                                            "Gerät, mit dem man über Funk verbreitete Nachrichten senden und/oder empfangen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb913344-08a8-43e7-9cc1-5aca5c52fa31",
                                                "sense_id": "80618d16-e66d-3c7e-9a22-de49ac701fe9",
                                                "text": "Die Feuerwehr ist mit Funkgeräten ausgestattet."
                                            },
                                            {
                                                "example_id": "f7724eda-1cdc-4676-9a4d-b0b675f0a013",
                                                "sense_id": "80618d16-e66d-3c7e-9a22-de49ac701fe9",
                                                "text": "„Das Funkgerät der Polizeibeamtin meldete sich letztendlich dann doch, aber erst, als die Sonne schon längst den Tag für sich erobert hatte.“"
                                            },
                                            {
                                                "example_id": "cbcc70cf-6ed1-4b75-a03f-e3ac4785f671",
                                                "sense_id": "80618d16-e66d-3c7e-9a22-de49ac701fe9",
                                                "text": "„Sékou rückte sein Bündel auf dem Rücken zurecht und setzte zu einer seiner Verrenkungen an, überlegte es sich dann aber anders, nahm sein Funkgerät aus dem Gürtel und sprach leise hinein.“"
                                            },
                                            {
                                                "example_id": "a6ab5226-22c0-4b89-af0f-9cc3b1378a5e",
                                                "sense_id": "80618d16-e66d-3c7e-9a22-de49ac701fe9",
                                                "text": "„Mit ihrem Funkgerät am breiten Gürtel sah sie aus wie von der Bergwacht.“"
                                            },
                                            {
                                                "example_id": "55455712-fb5b-4f4a-befc-4ae180cb475a",
                                                "sense_id": "80618d16-e66d-3c7e-9a22-de49ac701fe9",
                                                "text": "„Dieser Verband besaß ein Funkgerät und stand in Kontakt mit London.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
