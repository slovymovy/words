    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "09d39bb6-4dd0-3c82-b095-6ef4a6fd9ab8",
                    "sense_definition": "Relating to or used in a formal religious or public ceremony.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ceremony_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The priest performed the <w>ceremonial</w> rites of marriage in front of the guests."
                        },
                        {
                            "text": "The president arrived in a <w>ceremonial</w> car for the national holiday parade."
                        }
                    ],
                    "synonyms": [
                        "ritual"
                    ],
                    "common_phrases": [
                        "ceremonial rites",
                        "ceremonial car"
                    ]
                },
                {
                    "sense_id": "b833df27-f39c-3c84-975f-f33f1e7afd8b",
                    "sense_definition": "Used only for the purpose of ceremony; symbolic rather than functional.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ceremony_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king holds a <w>ceremonial</w> role with no real political power."
                        },
                        {
                            "text": "They used a <w>ceremonial</w> sword that was never meant for actual combat."
                        }
                    ],
                    "common_phrases": [
                        "ceremonial role"
                    ]
                },
                {
                    "sense_id": "db3f5c58-c9aa-3b8d-b67b-59b8dd0df4f5",
                    "sense_definition": "Fond of ceremony or ritual; observing strict etiquette or formality.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ceremony_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was a <w>ceremonial</w> man who insisted on following every social rule."
                        },
                        {
                            "text": "The <w>ceremonial</w> host greeted every guest with a formal bow."
                        }
                    ],
                    "synonyms": [
                        "ceremonious",
                        "formal",
                        "ritualistic"
                    ]
                }
            ]
        },
        {
