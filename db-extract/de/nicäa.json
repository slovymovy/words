                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ffc5b511-1a49-4e5a-bca4-4b2622b561c5",
                                "sense_id": "5f2adf02-db4c-367f-9836-bb21d4d4a4fa",
                                "text": "Nicäa hat heute etwa 20.000 Einwohner."
                            },
                            {
                                "example_id": "8c554bfa-239e-4c0e-a330-5d68683531fb",
                                "sense_id": "5f2adf02-db4c-367f-9836-bb21d4d4a4fa",
                                "text": "Nicäa ist für das Konzil im Jahre 325 bekannt geworden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6dd4a4da-c0b5-4f24-9a88-7842fa8337ce",
                        "source_entry_id": "52ebc620-770e-37a4-abb7-164f903dec55",
                        "source_sense_id": "5f2adf02-db4c-367f-9836-bb21d4d4a4fa",
