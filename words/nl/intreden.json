                {
                    "sense_id": "7398638e-9513-3205-b2c2-1795cdc3d861",
                    "sense_definition": "Beginnen te gebeuren of te heersen (van een toestand, seizoen of verschijnsel).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beginnen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De winter is vroeg <w>ingetreden</w> dit jaar.",
                            "target_lang_translations": {
                                "en": "Winter has <w>set in</w> early this year."
                            }
                        },
                        {
                            "text": "Zodra de rust is <w>ingetreden</w>, kunnen we eindelijk ontspannen.",
                            "target_lang_translations": {
                                "en": "As soon as peace has <w>settled in</w>, we can finally relax."
                            }
                        }
