                "senses": [
                    {
                        "sense_id": "f191231b-1c26-3d8f-a083-55d9651e870d",
                        "entry_id": "23d24626-02e4-3df6-97a1-ae324c19bfe7",
                        "glosses": [
                            "One of the tiny pores in the epidermis of a leaf or stem through which gases and water vapor pass."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2d005214-2b6c-3f45-a0ac-2558fa48d99a",
                        "entry_id": "23d24626-02e4-3df6-97a1-ae324c19bfe7",
                        "glosses": [
                            "A small opening in a membrane; a surgically constructed opening, especially one in the abdominal wall that permits the passage of waste after a colostomy or ileostomy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80e4ca13-7b2a-49e0-a2c6-b8561ea9a1e1",
                                "sense_id": "2d005214-2b6c-3f45-a0ac-2558fa48d99a",
                                "text": "From a large tote bag sat beside her, she takes out a Victoria Beckham makeup bag, which contains her urostomy night bag, which plugs into the bag on the stoma."
                            }
                        ]
                    },
                    {
                        "sense_id": "df83fea7-a6ec-31bd-97c3-d343a4889e92",
                        "entry_id": "23d24626-02e4-3df6-97a1-ae324c19bfe7",
                        "glosses": [
                            "A mouthlike opening, such as the oral cavity of a nematode."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "83ef4caf-87d4-3981-9e43-c8a25e967f33",
                        "entry_id": "23d24626-02e4-3df6-97a1-ae324c19bfe7",
                        "glosses": [
                            "An artificial anus."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8327d25a-019c-4ff2-a7b7-a131fb0b24eb",
                        "source_entry_id": "23d24626-02e4-3df6-97a1-ae324c19bfe7",
                        "source_sense_description": "botany: tiny pore in the epidermis of a leaf",
                        "target_lang_word": "stomate",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stomate",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8decbd53-08ff-35a8-a462-3a3cfce24058",
                                        "entry_id": "dc0083e0-0a78-38c3-a5b1-295cc2e0e6a7",
                                        "glosses": [
                                            "Pore microscopique situé dans l’épiderme des organes aériens des plantes, bordé par deux cellules de garde, permettant les échanges gazeux entre l’air et les tissus internes."
                                        ],
                                        "tags": [
                                            "Anatomie végétale",
                                            "Physiologie végétale"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d54fea08-cb91-476b-bd7f-499b77b5da3f",
                                                "sense_id": "8decbd53-08ff-35a8-a462-3a3cfce24058",
                                                "text": "Des chercheurs de l’Inra et de Montpellier SupAgro ont déjà commencé à sélectionner des cépages dont les stomates (petits trous à la surface des feuilles laissant passer les gaz et l’eau) se referment davantage la nuit, de façon à réduire la perte d’eau sans diminuer la production de raisins."
                                            },
                                            {
                                                "example_id": "e009654d-bb42-461d-b7a2-fcd8d9fbf373",
                                                "sense_id": "8decbd53-08ff-35a8-a462-3a3cfce24058",
                                                "text": "Ce phénomène conduit à une réduction de l’ouverture des stomates des feuilles et donc à une diminution de la photosynthèse."
                                            },
                                            {
                                                "example_id": "8f24e9a0-9df1-4332-b439-df449129f983",
                                                "sense_id": "8decbd53-08ff-35a8-a462-3a3cfce24058",
                                                "text": "Avec la sécheresse et le manque de pluies, l’arbre va donc adopter des stratégies pour s’économiser, comme la fermeture de ses stomates (pores à la surface des feuilles qui permettent les échanges gazeux de l’arbre) afin de moins transpirer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2821541-b851-437d-976c-e06e19c542d8",
                        "source_entry_id": "23d24626-02e4-3df6-97a1-ae324c19bfe7",
