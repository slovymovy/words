                    {
                        "translation_id": "0864bb6b-5436-46ef-9083-8f22ec60438f",
                        "source_entry_id": "b552d0e9-79b8-35fe-856f-fee41057822a",
                        "source_sense_id": "b701ad1a-7667-3174-bb65-ef375859c3a7",
