                    }
                ],
                "translations": [
                    {
                        "translation_id": "fbd56698-60f1-4a3d-8881-aa53ad9ecc78",
                        "source_entry_id": "636c5a9c-cbcc-3b5b-a2ea-403962425159",
                        "source_sense_id": "9d67cdd7-d22c-381a-85f6-50e6173930f7",
                        "target_lang_word": "Antikommunist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antikommunist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "36ddf2d6-075f-3142-b74c-c309f5c39b85",
                                        "entry_id": "2f2eb346-cc4f-30c7-ae9e-c4d88b36f5fc",
                                        "glosses": [
                                            "Vertreter des Antikommunismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ea0667f-c7a5-4995-8f81-8f0526284341",
                                                "sense_id": "36ddf2d6-075f-3142-b74c-c309f5c39b85",
                                                "text": "„Wie anhand mehrerer Fallbeispiele gezeigt wird, konkurrieren die beiden wichtigsten Elitenfraktionen nach 1989 – die Postkommunisten und die postkommunistischen Antikommunisten – auf unterschiedlichen Diskursfeldern um dieselbe Legitimationsressource: Dienst an der nationalen Sache.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4e9dc32-9a6f-4689-a632-3e084f84475c",
                        "source_entry_id": "636c5a9c-cbcc-3b5b-a2ea-403962425159",
                        "source_sense_id": "9d67cdd7-d22c-381a-85f6-50e6173930f7",
                        "target_lang_word": "Antikommunistin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antikommunistin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ffc9273d-1096-32ae-8732-3241b38138fb",
                                        "entry_id": "5f3d72f0-4a67-31e6-8df9-d5ce49d949df",
                                        "glosses": [
                                            "Vertreterin des Antikommunismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1173dcc-d00e-415e-8822-fb8cf354d418",
                                                "sense_id": "ffc9273d-1096-32ae-8732-3241b38138fb",
                                                "text": "„Und so verfiel sie dem Naturgesetz, dass man irgendwann anfängt, nach seinen Feinden zu stinken. Ausgerechnet Ayn Rand, die eine rabiate Antikommunistin, eine Gegnerin jeder Form des Kollektivismus war, wurde zum Boss einer fanatischen Politsekte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
