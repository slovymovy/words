                "senses": [
                    {
                        "sense_id": "3adef827-8774-349e-8810-b4518225da57",
                        "entry_id": "f0f57186-5e7b-3e4d-bb5c-b8a5d540b9bc",
                        "glosses": [
                            "das Einstudieren von neuen Stücken mit Hilfe des Klaviers an Stelle des gesamten Orchesters"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "01c6f4c2-21ec-4914-8fed-85c9e195ed1a",
                                "sense_id": "3adef827-8774-349e-8810-b4518225da57",
                                "text": "„Wir legen aber Wert darauf, dass Professoren für ihre Studenten ansprechbar sind, kontinuierlich unterrichten, wie engagiert sie Unterricht, Korrepetition oder Vorspiele organisieren.“"
                            },
                            {
                                "example_id": "e8054f45-4a98-4507-aa5c-f5e933eb95b4",
                                "sense_id": "3adef827-8774-349e-8810-b4518225da57",
                                "text": "„‚Werden‘ heißt hier zunächst: allgemeine musikalische Eigenschaften heranbilden, wie das Gehör schulen; dann Fähigkeiten weiterentwickeln: Klavierspiel, Schlagtechnik, Korrepetition, Partiturspiel, Harmonie- und Formenlehre und Kontrapunkt.“"
                            },
                            {
                                "example_id": "a02c8632-703a-4c9a-ad94-c35d2f198e88",
                                "sense_id": "3adef827-8774-349e-8810-b4518225da57",
                                "text": "„Die bei Meisterkursen unter anderem von Thomas Quasthoff gefragte Pianistin hat seit 2005 einen Lehrauftrag für Korrepetition an der Wiener Musikuniversität inne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
