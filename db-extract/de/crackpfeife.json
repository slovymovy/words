                            {
                                "example_id": "2bf725a8-30c7-4185-b3fc-434ac5c9ff06",
                                "sense_id": "408533e0-ce30-3005-bb87-4320ac2b5815",
                                "text": "„Auf dem Video, das am vergangenen Freitag aufgenommen worden sein soll, ist Winehouse beim Rauchen einer Crackpfeife zu sehen, nachdem sie zuvor offenbar Ecstasy und Kokain konsumiert hatte.“"
                            },
                            {
                                "example_id": "17912c5b-79f6-45a0-9fe8-32402583bbee",
                                "sense_id": "408533e0-ce30-3005-bb87-4320ac2b5815",
                                "text": "„Nach der erfolglosen Nacht im Casino hockt Travis in seinem Tunnel auf dem Bett und stopft seine Crackpfeife – den kleinen Trip braucht er jetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
