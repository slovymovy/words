                        "glosses": [
                            "Having insufficient capacity to meet the demand of those who are interested."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "22ffa427-0ef6-4b8a-b654-12a90bdb79b7",
                                "sense_id": "e337a1c5-d8c0-3e47-a338-03ed42bca9a0",
                                "text": "So the Swetmans were grateful to get an appointment at a temporary free clinic for their latest two puppies, even if there were no slots left in the oversubscribed five-day program for their eight older unspayed females."
                            },
                            {
                                "example_id": "4644eb60-544a-4188-be1f-46812c0233a5",
                                "sense_id": "e337a1c5-d8c0-3e47-a338-03ed42bca9a0",
                                "text": "QBE Insurance Group will sell about $115 million of new shares to its retail investors, after scaling back the oversubscribed purchase plan."
                            },
                            {
                                "example_id": "818b5c15-5dad-4da4-be27-679ae66355ad",
                                "sense_id": "e337a1c5-d8c0-3e47-a338-03ed42bca9a0",
                                "text": "And we know that because the organisers of the British Parking Association Awards, to be held at London's Dorchester in March, have just told the entrants that they are so heavily oversubscribed for tables that none can be allocated at this early stage."
                            },
                            {
                                "example_id": "726ab7af-91cb-4f11-9f68-c71e27092191",
                                "sense_id": "e337a1c5-d8c0-3e47-a338-03ed42bca9a0",
                                "text": "Reddit's (RDDT.N) initial public offering is currently between four and five times oversubscribed, people familiar with the matter said on Sunday, making it more likely the social media platform will attain the $6.5 billion valuation it seeks."
                            }
                        ]
