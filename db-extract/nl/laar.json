                    {
                        "translation_id": "bb29d53a-87fd-483e-9821-0221056d5f45",
                        "source_entry_id": "2b5d365b-532f-3fd6-9203-24c807896cf4",
                        "source_sense_id": "995a6179-f8f7-3133-b817-33ba935ba482",
                        "source_sense_description": "een open plek in een bos",
                        "target_lang_word": "clairière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clairière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "551fb403-49b9-3e9f-9748-b2cbe5992042",
                                        "entry_id": "55e38406-524c-3d51-bf46-11ff60aae06e",
                                        "glosses": [
                                            "Endroit d’une forêt dégarni d’arbres."
                                        ],
                                        "tags": [
                                            "Ethnobiologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef7c1aab-34c9-4b6f-a516-ec294548c762",
                                                "sense_id": "551fb403-49b9-3e9f-9748-b2cbe5992042",
                                                "text": "Le jour commençait à poindre sur les clairières de la forêt, chaque feuille rayonnait d’une perle de rosée."
                                            },
                                            {
                                                "example_id": "b476d5f4-7b1b-42f5-95b5-bbdd90b64d6c",
                                                "sense_id": "551fb403-49b9-3e9f-9748-b2cbe5992042",
                                                "text": "Les maringouins arrivaient en légions si nombreuses que leur bourdonnement formait une clameur, une vaste note basse qui emplissait la clairière comme un mugissement."
                                            },
                                            {
                                                "example_id": "9451bcdd-473f-4f08-88a6-12c6d7267eaf",
                                                "sense_id": "551fb403-49b9-3e9f-9748-b2cbe5992042",
                                                "text": "L’homme lutte difficilement contre la forêt équatoriale, il y ouvre seulement des clairières pour ses cultures et épuise vite l’humus accumulé."
                                            },
                                            {
                                                "example_id": "355f908b-8438-46d8-b111-6f18c33d66e7",
                                                "sense_id": "551fb403-49b9-3e9f-9748-b2cbe5992042",
                                                "text": "Il y avait là de hauts épilobes dans une clairière de quelques mètres carrés."
                                            },
                                            {
                                                "example_id": "aebbd7f3-675b-42f6-86c9-041c5123d98d",
                                                "sense_id": "551fb403-49b9-3e9f-9748-b2cbe5992042",
                                                "text": "L'ortie de Chine, qui n'est préférable au chanvre que pour la fabrication des vêtements, croît à l'état spontané dans toutes les forêts clairières du Laos supérieur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "368a3270-0432-3c7f-ba6b-e652a6216e40",
                                        "entry_id": "55e38406-524c-3d51-bf46-11ff60aae06e",
                                        "glosses": [
                                            "Passage entre la banquise et les gros amas de glaces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d4cd9fd-a2cf-4219-aef6-450753fbfd65",
                                                "sense_id": "368a3270-0432-3c7f-ba6b-e652a6216e40",
                                                "text": "Assez lâches pour être maniables, les glaces dans lesquelles nous avions pénétré étaient parsemées d’icebergs […] Quatre heures après nous stoppions dans une clairière, décidés à renouveler la provision d’eau de la chaudière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f87bf851-cb2d-39c8-a8f1-e637f9d094d3",
                                        "entry_id": "55e38406-524c-3d51-bf46-11ff60aae06e",
                                        "glosses": [
                                            "Lieu dégagé par rapport à son environnement immédiat."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6618b057-9929-4c08-9980-61c6313a061c",
                                                "sense_id": "f87bf851-cb2d-39c8-a8f1-e637f9d094d3",
                                                "text": "Il s’arrêta au centre de la place Saint-Henri, une vaste zone sillonnée du chemin de fer et de deux voies de tramways, carrefour planté de poteaux noirs et blancs et de barrières de sûreté, clairière de bitume et de neige salie, ouverte entre les clochers, les dômes, à l’assaut des locomotives hurlantes, aux volées de bourdons, aux timbres éraillés des trams et à la circulation incessante de la rue Notre-Dame et de la rue Saint-Jacques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e65a950d-9f25-3435-b4c4-b0e6a8370504",
                                        "entry_id": "55e38406-524c-3d51-bf46-11ff60aae06e",
                                        "glosses": [
                                            "Entre-bat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "240ac405-cd9a-42c3-99ad-e2fd3dc15f0d",
                                                "sense_id": "e65a950d-9f25-3435-b4c4-b0e6a8370504",
                                                "text": "Il y a des clairières dans cette toile."
                                            }
                                        ]
                                    }
                                ]
