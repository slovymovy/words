                    }
                ],
                "senses": [
                    {
                        "sense_id": "83617af7-0e39-3696-a6c8-ba85112e0e27",
                        "entry_id": "eedc1c10-9e70-3405-b1e6-912a6de60575",
                        "glosses": [
                            "een saus op basis van eieren met hierin minstens 70% olie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "21f6c751-37bf-4a51-8802-9a84d7bb1050",
                                "sense_id": "83617af7-0e39-3696-a6c8-ba85112e0e27",
                                "text": "Deze mayonaise vind ik eerlijk gezegd niet zo lekker."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce50d0ce-f2fc-4609-bfcf-a8656bd87997",
                        "source_entry_id": "eedc1c10-9e70-3405-b1e6-912a6de60575",
                        "source_sense_id": "83617af7-0e39-3696-a6c8-ba85112e0e27",
                        "source_sense_description": "een saus op basis van eieren",
                        "target_lang_word": "Majonäse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Majonäse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2755c590-163a-348b-8271-3162af79a80d",
                                        "entry_id": "e785163a-f7ff-3446-bf31-085005c12d7b",
                                        "glosses": [
                                            "eine dickflüssige, kalt hergestellte Soße auf der Basis von Eigelb und Öl"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4acada3-9da2-4457-85b9-81315b3202a6",
                                                "sense_id": "2755c590-163a-348b-8271-3162af79a80d",
                                                "text": "„Keine Angst, es ist ganz leicht eine Majonäse zu machen.“"
                                            },
                                            {
                                                "example_id": "26766d35-a32d-4bda-810e-012b0567cc34",
                                                "sense_id": "2755c590-163a-348b-8271-3162af79a80d",
                                                "text": "„Schnittlauch verfeinert mit seinem feinwürzigen Geschmack alle Fleisch-, Fisch- und Geflügelgerichte, Eierspeisen, Suppen, Soßen, Salate, Rohkost- und Käseplatten, Dressings, Majonäsen und Marinaden.“"
                                            },
                                            {
                                                "example_id": "51b614a0-9cc9-41ab-b71f-f5d446033aa8",
                                                "sense_id": "2755c590-163a-348b-8271-3162af79a80d",
                                                "text": "„Fliegenpilz[:] Tomaten waschen und abtrocknen – […] – auf die Spitze des Eis Majonäse aus der Tube drücken und das ausgehöhlte Tomatenstück daraufsetzen – den ‚Fliegenpilz‘ auf ein Salatblatt stellen und das Tomatenstück mit Majonäse betupfen“"
                                            },
                                            {
                                                "example_id": "8f149d65-44b5-42fc-aaad-7b4b348b3ec5",
                                                "sense_id": "2755c590-163a-348b-8271-3162af79a80d",
                                                "text": "„Wenn ich in der Cafeteria im Institut ein Baguette mit Salat, Majonäse und Käse esse, wobei ich mir die Majonäse eh immer abmache, weil die eklig aussieht, bezahle ich dafür ganze vier Euro!“"
                                            },
                                            {
                                                "example_id": "22dc63cf-c543-4a5d-b784-7e0347472327",
                                                "sense_id": "2755c590-163a-348b-8271-3162af79a80d",
                                                "text": "„Ein Sandwich wäre nett. Ein Sandwich mit Majonäse und sauren Gurken. Vielleicht auch mit Senf und Zwiebeln. Und wenn sie schon mal dabei war … mit weichem weißen Camembert.“"
                                            },
                                            {
                                                "example_id": "9b42034c-c2be-4c9b-978b-cd9c7c977fc4",
                                                "sense_id": "2755c590-163a-348b-8271-3162af79a80d",
                                                "text": "„Auch die Verwendung von Majonäse bei Salaten ist in den Blick zu nehmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf2ff459-c95e-4443-ae8e-134a2e2691d2",
                        "source_entry_id": "eedc1c10-9e70-3405-b1e6-912a6de60575",
                        "source_sense_id": "83617af7-0e39-3696-a6c8-ba85112e0e27",
                        "source_sense_description": "een saus op basis van eieren",
                        "target_lang_word": "mayonnaise",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mayonnaise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f753b645-73bf-3dca-b79f-cd00e27bde7b",
                                        "entry_id": "0ed00413-863b-3d26-9560-134ed0d6bc9a",
                                        "glosses": [
                                            "A dressing made from vegetable oil, raw egg yolks, vinegar or lemon juice, and seasoning, used on salads, with french fries, in sandwiches etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19103fb0-b44f-455a-b8ba-d1d156e00730",
                                                "sense_id": "f753b645-73bf-3dca-b79f-cd00e27bde7b",
                                                "text": "There are 250 foods, including mayonnaise, cheese and cocoa, that don't list ingredients at all."
                                            },
                                            {
                                                "example_id": "1c71294e-8061-47c8-af25-d8c3588beb0a",
                                                "sense_id": "f753b645-73bf-3dca-b79f-cd00e27bde7b",
                                                "text": "The FDA's original intent for foods included under \"standards of identity\" ensured that terms like \"mayonnaise\" or \"ice cream” would guarantee the same basic ingredients required in the government-established recipe no matter who manufactured it."
                                            },
                                            {
                                                "example_id": "c579dc63-75a3-4828-8f1e-fe8ea10407a8",
                                                "sense_id": "f753b645-73bf-3dca-b79f-cd00e27bde7b",
                                                "text": "I grew up thinking that the blue and white Miracle Whip salad dressing jar in the fridge held the same substance the rest of the world knew as mayonnaise. / Now I know that mayonnaise is something entirely different."
                                            },
                                            {
                                                "example_id": "de9868dc-4731-4295-b9e6-4f5426fc65b1",
                                                "sense_id": "f753b645-73bf-3dca-b79f-cd00e27bde7b",
                                                "text": "The oils in store-bought mayonnaise range from olive oil to sunflower oil to safflower oil and some less desirable oils!"
                                            },
                                            {
                                                "example_id": "e0b89571-e9d0-4221-a5b5-342a6cf9e5f3",
                                                "sense_id": "f753b645-73bf-3dca-b79f-cd00e27bde7b",
                                                "text": "Most store-bought mayonnaise contains ingredients (vinegar, lemonjuice, and salt) that actually slow bacterial growth"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e3121d7-2000-360c-a407-85f32da2b261",
                                        "entry_id": "0ed00413-863b-3d26-9560-134ed0d6bc9a",
                                        "glosses": [
                                            "Any cold dish with that dressing as an ingredient."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6268d762-4f7f-43ff-bc3e-ac08b960639e",
                                                "sense_id": "5e3121d7-2000-360c-a407-85f32da2b261",
                                                "text": "We served a lobster mayonnaise as a starter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "267e43f0-1728-3641-bfb5-eb1c2ce3aad1",
                                        "entry_id": "0ed00413-863b-3d26-9560-134ed0d6bc9a",
                                        "glosses": [
                                            "Any cream, for example for moisturizing the face or conditioning the hair, for which the base is egg yolks and oil."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ac3d5b4-e1c7-450c-929a-55eb3e35ab14",
                                                "sense_id": "267e43f0-1728-3641-bfb5-eb1c2ce3aad1",
                                                "text": "hair mayonnaise"
                                            },
                                            {
                                                "example_id": "89e2135a-fd11-40e1-87a4-0fb5802d571c",
                                                "sense_id": "267e43f0-1728-3641-bfb5-eb1c2ce3aad1",
                                                "text": "facial mayonnaise"
                                            },
                                            {
                                                "example_id": "a50c9493-c4e4-4b0c-a1af-0ed7923ef2c6",
                                                "sense_id": "267e43f0-1728-3641-bfb5-eb1c2ce3aad1",
                                                "text": "They include cider vinegar, two pre-shampoo products, shampoo, conditioner, hair mayonnaise, oil, leave-in conditioner, end protector, revitalising styling spray and filtered water."
                                            },
                                            {
                                                "example_id": "84207c73-1fad-41c5-b7dd-dbc5b978c811",
                                                "sense_id": "267e43f0-1728-3641-bfb5-eb1c2ce3aad1",
                                                "text": "Then I implemented a lighter protein conditioner – such as hair mayonnaise, which I learned about from my cousin Renee – for the off weeks. I used this hidden gem in combination with olive oil (yes, I bought a kitchen bottle of olive oil – the same kind my grandmother used in every single delicious dish she ever cooked – strictly for use in my hair)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6aa12b0c-9614-3cae-96eb-ccadb044cc8f",
                                        "entry_id": "0ed00413-863b-3d26-9560-134ed0d6bc9a",
                                        "glosses": [
                                            "Exaggeration."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fce23f6-f3c3-4f25-b8d2-d7ab14ba7a78",
                                                "sense_id": "6aa12b0c-9614-3cae-96eb-ccadb044cc8f",
                                                "text": "Rancey and our coach, Damien Hardwick, still both joke that \"Dimma\" tried to off-load him for a sixpack of beers and a bucket of chips in his first few years, but I think they both put some mayonnaise on the story these days."
                                            },
                                            {
                                                "example_id": "b92d7f65-7f02-4f3b-81bc-99ffd57ed974",
                                                "sense_id": "6aa12b0c-9614-3cae-96eb-ccadb044cc8f",
                                                "text": "If he had a reputation among supporters of playing for free kicks he wasn't aware of it and no one from the AFL or coaches spoke to him specifically about changing his style. But he admits, he would \"put some mayonnaise\" on top of what defenders had done to him to ensure the umpires were aware of what was happening."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mayonnaise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "912313e3-08dc-3073-86ef-9241a6495625",
                                        "entry_id": "0fe3e86b-9666-3e7a-a404-a829e1c019fd",
                                        "glosses": [
                                            "To cover or season with mayonnaise."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43830252-6397-4cdc-9ce5-59c0cc4c1841",
                                                "sense_id": "912313e3-08dc-3073-86ef-9241a6495625",
                                                "text": "Jones himself presided in the kitchen, mincing truffles, mayonnaising lobster, booting waiters out the door with tray after tray of steaming savories and teeth-numbing sweets, […]"
                                            },
                                            {
                                                "example_id": "6347e76d-0bb0-4eea-9b6a-d39671f88830",
                                                "sense_id": "912313e3-08dc-3073-86ef-9241a6495625",
                                                "text": "I thought of mayonnaising her racket handle or substituting it for sunblock, but decided against it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea1f48be-f3e6-496d-a004-1d8dd941ad28",
                        "source_entry_id": "eedc1c10-9e70-3405-b1e6-912a6de60575",
                        "source_sense_id": "83617af7-0e39-3696-a6c8-ba85112e0e27",
                        "source_sense_description": "een saus op basis van eieren",
                        "target_lang_word": "mayonnaise",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mayonnaise",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0ec8b29e-b6cd-38d2-b9cb-4791e06f111f",
                                        "entry_id": "4e46d605-a032-3ea4-830b-2a84715e3a14",
                                        "glosses": [
                                            "Sauce froide qui consiste en une émulsion d’huile et de jaune d’œuf, assaisonnée traditionnellement de vinaigre ou de jus de citron et plus récemment de moutarde, etc."
                                        ],
                                        "tags": [
                                            "Sauces"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c03bd98-91bf-4118-ac46-1bca06a4c563",
                                                "sense_id": "0ec8b29e-b6cd-38d2-b9cb-4791e06f111f",
                                                "text": "Mélangez bien le vinaigre et le sucre dans un cul-de-poule, puis ajoutez le jaune d’œuf et réalisez une mayonnaise."
                                            },
                                            {
                                                "example_id": "6fe2e8c8-1de2-4019-b8ac-dfb30178cff1",
                                                "sense_id": "0ec8b29e-b6cd-38d2-b9cb-4791e06f111f",
                                                "text": "On place ces petites bottes droites et en couronnes, au milieu desquelles vous versez une mayonnaise."
                                            },
                                            {
                                                "example_id": "f76f0f9f-1a19-4833-837a-5efc7128c7e7",
                                                "sense_id": "0ec8b29e-b6cd-38d2-b9cb-4791e06f111f",
                                                "text": "Quant au petit loup, elle donnait plutôt l’illusion d’une femelle de kanguroo dont on aurait craint, tout le temps, que les gros yeux tombassent dans la mayonnaise de sa langouste."
                                            },
                                            {
                                                "example_id": "90decaba-645f-4b52-8002-0f450f3f48b8",
                                                "sense_id": "0ec8b29e-b6cd-38d2-b9cb-4791e06f111f",
                                                "text": "Ils prirent possession du chalet et elle descendit au village les approvisionner en junk-food à prix d'or : frites au four, nuggets surgelés, glaces, sauces samouraï, ketchup et mayonnaise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "608f741f-0028-3e8c-afd1-ad808412fc60",
                                        "entry_id": "4e46d605-a032-3ea4-830b-2a84715e3a14",
                                        "glosses": [
                                            "Mets préparé avec cette sauce."
                                        ],
                                        "tags": [],
                                        "note": "Il est alors souvent usité en apposition",
                                        "examples": [
                                            {
                                                "example_id": "7dbc1c61-4207-4177-b49d-cadce4cfa7c5",
                                                "sense_id": "608f741f-0028-3e8c-afd1-ad808412fc60",
                                                "text": "Une mayonnaise de volaille."
                                            },
                                            {
                                                "example_id": "1f39ac0f-77a6-4207-a440-20f39f282404",
                                                "sense_id": "608f741f-0028-3e8c-afd1-ad808412fc60",
                                                "text": "Un poulet mayonnaise, des œufs mayonnaise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cfc15eb-581e-39dc-8d55-72e0ccef8223",
                                        "entry_id": "4e46d605-a032-3ea4-830b-2a84715e3a14",
                                        "glosses": [
                                            "Autres émulsions alimentaires."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "190dc289-506a-4058-ade3-7b2d79e27e18",
                                                "sense_id": "0cfc15eb-581e-39dc-8d55-72e0ccef8223",
                                                "text": "En catimini, elle triche et photographie aussi la recette de la mayonnaise au chocolat.\n– Merci maman, souffle Pierre, débordant de gratitude."
                                            },
                                            {
                                                "example_id": "5fbf4b81-1c62-4371-8f9c-51613de4d110",
                                                "sense_id": "0cfc15eb-581e-39dc-8d55-72e0ccef8223",
                                                "text": "Une entrée graphique et végétarienne : pressé de poireaux et mayonnaise d'avocat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2792c1c8-776e-30ae-8671-60c16de70d68",
                                        "entry_id": "4e46d605-a032-3ea4-830b-2a84715e3a14",
                                        "glosses": [
                                            "Préparation identique à la précédente avec de l’huile de lin."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bb31603-5a0d-4f23-b550-fa2d7b2ee2df",
                                                "sense_id": "2792c1c8-776e-30ae-8671-60c16de70d68",
                                                "text": "Peinture à la mayonnaise, peinture à l’œuf."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4fc8298-ad42-301e-be6c-4c8ddbd78057",
                                        "entry_id": "4e46d605-a032-3ea4-830b-2a84715e3a14",
                                        "glosses": [
                                            "Émulsion imprévue d’huile et d’eau dans un moteur."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0ed51dd-ffff-4c31-896c-ca91d2060926",
                                                "sense_id": "b4fc8298-ad42-301e-be6c-4c8ddbd78057",
                                                "text": "Cette mayonnaise sous le bouchon d’huile, ou sur la jauge, indique que le joint de culasse est fendu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45b016f7-d0ea-39e6-8d5d-e8e55c26d716",
                                        "entry_id": "4e46d605-a032-3ea4-830b-2a84715e3a14",
                                        "glosses": [
                                            "Pot-pourri, méli-mélo, mélange."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05f7681d-40e8-40c4-b16e-dd7e435eda13",
                                                "sense_id": "45b016f7-d0ea-39e6-8d5d-e8e55c26d716",
                                                "text": "Quelle mayonnaise !"
                                            },
                                            {
                                                "example_id": "95753362-e76f-4b34-acf4-4b99c7a4c9a4",
                                                "sense_id": "45b016f7-d0ea-39e6-8d5d-e8e55c26d716",
                                                "text": "Il était écœuré par la platitude des pensées, la lourdeur incolore et barbare de l’expression, les généralités vagues, la logique enfantine, cette mayonnaise mal battue d’abstractions et de faits sans liaison."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35f43e42-31d0-3cd2-88be-f41a7ac029f7",
                                        "entry_id": "4e46d605-a032-3ea4-830b-2a84715e3a14",
                                        "glosses": [
                                            "Assemblage réussi d’éléments."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6c4a5fa-c7f2-43d7-8ad2-4a9644f83a05",
                                                "sense_id": "35f43e42-31d0-3cd2-88be-f41a7ac029f7",
                                                "text": "Or, précisément, ce sont les processus de “fabrication” de ces civilisations qui sont captivants car c’est le moment où tout se joue, où “la mayonnaise prend”."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mayonnaise",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2ab2dc8b-2276-3e3e-992d-c2e6aedafc7b",
                                        "entry_id": "13a3ecc5-fa63-324f-9aae-6026438c56eb",
                                        "glosses": [
                                            "Féminin singulier de mayonnais."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d54b7e4-c50e-4140-847e-9e4f0a88e195",
                        "source_entry_id": "eedc1c10-9e70-3405-b1e6-912a6de60575",
                        "source_sense_id": "83617af7-0e39-3696-a6c8-ba85112e0e27",
                        "source_sense_description": "een saus op basis van eieren",
                        "target_lang_word": "mayonesa",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mayonesa",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "9bee9f9f-0eaa-3e73-a45e-1273a97f7c86",
                                        "entry_id": "33e196ba-6896-3c51-bae6-5424dc5adb85",
                                        "glosses": [
                                            "Salsa emulsionada a base de huevo crudo, aceite, sal y algún líquido ácido (jugo de limón o vinagre)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27b5c76c-8026-4c7a-945c-171d80c3fc5b",
                                                "sense_id": "9bee9f9f-0eaa-3e73-a45e-1273a97f7c86",
                                                "text": "No excluyo de la batería de cocina la variedad de herramientas cortantes, punzantes, compresoras, etc., para moldear y dar o quitar formas a las legumbres y a otras cosas de comer con que se guarnecen y adornan los platos -generalmente mal condimentados- como no me es lícito privar a nadie del aparato para hacer huevos pasados por agua, de la maquinilla para batir huevos, del embudo mecánico para el aceite en la salsa mayonesa, del reloj de arena y de un centenar más de chismes que convierten una cocina en bazar de a real y medio la pieza."
                                            },
                                            {
                                                "example_id": "552bd167-ca76-4222-a23f-48a031ef8256",
                                                "sense_id": "9bee9f9f-0eaa-3e73-a45e-1273a97f7c86",
                                                "text": "En un mortero de palo se machacan tres dientes de ajo, dos docenas de almendras mondadas o de habas frescas, y se trabaja todo con una tacilla de aceite y otra de vinagre, que se van añadiendo alternando y muy poco a poco, como se hace en la salsa mayonesa. Cuando forma una masa compacta y crecida, se le añade un huevo entero, y después, agua y pan a pizcos."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f57c26f3-0311-3595-aea7-335fbf800d79",
                                        "entry_id": "33e196ba-6896-3c51-bae6-5424dc5adb85",
                                        "glosses": [
                                            "Manjar ligado con mayonesa₁."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5fc3eb0-a528-4f50-92d5-94fefc2846dc",
                                                "sense_id": "f57c26f3-0311-3595-aea7-335fbf800d79",
                                                "text": "Esta señora, madre de preciosas hijas que allí estaban, se entretenía en comerse medio budín, como postre de una piernita de pavo y de una tierna pechuga de gallina, que había saboreado para quitar de sus labios el gusto salado que habían dejado en ellos dos o tres rebanadas de jamón, con que la señora quiso neutralizar el gusto a manteca que había dejado en su boca un plato de mayonesa con que había empezado a preparar su apetito."
                                            },
                                            {
                                                "example_id": "9bf525d8-b2e4-4da9-8e6f-ad2eb5a19e52",
                                                "sense_id": "f57c26f3-0311-3595-aea7-335fbf800d79",
                                                "text": "La presencia del mozo apresuró la elección de Diego, que pidió mayonesa de ave mirando la lista sin leer. En sus pocas cenas de compañerismo ésa había sido la apertura obligada."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
