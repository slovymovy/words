{
    "word_family": [
        "leaf",
        "leafing",
        "leafy",
        "leafless",
        "leafleter"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "62322fe2-c547-30e1-8d21-248c4e424294",
                    "sense_definition": "A small printed sheet of paper, often folded, containing information or advertising and usually distributed free.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "printed_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The charity handed out an informative <w>leaflet</w> about the importance of recycling.",
                            "target_lang_translations": {
                                "ru": "Благотворительная организация раздавала информационную <w>листовку</w> о важности переработки отходов."
                            }
                        },
                        {
                            "text": "I found a colorful <w>leaflet</w> under the car windshield wiper advertising a new local gym.",
                            "target_lang_translations": {
                                "ru": "Под дворником автомобиля я нашел красочную <w>листовку</w> с рекламой нового местного тренажерного зала."
                            }
                        }
                    ],
                    "synonyms": [
                        "flyer",
                        "pamphlet",
                        "handbill",
                        "folder"
                    ],
                    "common_phrases": [
                        "informative leaflet",
                        "advertising leaflet",
                        "hand out leaflets"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой печатный лист бумаги, часто сложенный, содержащий информацию или рекламу и обычно распространяемый бесплатно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "листовка",
                                "target_lang_sense_clarification": "информационный или рекламный листок"
                            },
                            {
                                "target_lang_word": "флаер",
                                "target_lang_sense_clarification": "рекламная листовка, часто дающая скидку"
                            },
                            {
                                "target_lang_word": "буклет",
                                "target_lang_sense_clarification": "сброшюрованное или сложенное печатное издание"
                            },
                            {
                                "target_lang_word": "памятка",
                                "target_lang_sense_clarification": "краткая инструкция или информация"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "542d9d5d-b901-3420-9bb6-af035a6b9e3c",
                    "sense_definition": "One of the individual leaf-like parts that make up a compound leaf.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The clover leaf is typically composed of three small <w>leaflets</w> attached to a single stem.",
                            "target_lang_translations": {
                                "ru": "Лист клевера обычно состоит из трех маленьких <w>листочков</w>, прикрепленных к одному стеблю."
                            }
                        },
                        {
                            "text": "You can identify the plant by counting the number of <w>leaflets</w> on each branch.",
                            "target_lang_translations": {
                                "ru": "Вы можете идентифицировать растение, посчитав количество <w>листочков</w> на каждой ветке."
                            }
                        }
                    ],
                    "common_phrases": [
                        "compound leaf leaflet"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in botany"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Одна из отдельных листовидных частей, составляющих сложный лист растения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "листочек",
                                "target_lang_sense_clarification": "часть сложного листа в ботанике"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d6353e2-9ffa-3fd1-ae21-c11b453c0f00",
                    "sense_definition": "A thin flap of tissue that forms part of a valve in the heart or a blood vessel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeon carefully repaired the damaged <w>leaflet</w> of the mitral valve.",
                            "target_lang_translations": {
                                "ru": "Хирург осторожно восстановил поврежденную <w>створку</w> митрального клапана."
                            }
                        },
                        {
                            "text": "If a heart valve <w>leaflet</w> does not close properly, it can cause blood to flow backward.",
                            "target_lang_translations": {
                                "ru": "Если <w>створка</w> сердечного клапана не закрывается должным образом, это может привести к обратному току крови."
                            }
                        }
                    ],
                    "common_phrases": [
                        "valve leaflet",
                        "mitral valve leaflet"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "medical terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкая складка ткани, образующая часть клапана в сердце или кровеносном сосуде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "створка",
                                "target_lang_sense_clarification": "подвижная часть сердечного клапана"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2eeb4bba-9e07-3619-b103-403e8a009442",
                    "sense_definition": "To distribute printed sheets of information to people or at specific locations.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "distribution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The political activists spent the entire afternoon <w>leafleting</w> outside the train station.",
                            "target_lang_translations": {
                                "ru": "Политические активисты провели весь день, <w>раздавая листовки</w> у железнодорожного вокзала."
                            }
                        },
                        {
                            "text": "During the summer, Peter earned extra cash by <w>leafleting</w> for a local pizza delivery restaurant.",
                            "target_lang_translations": {
                                "ru": "Летом Питер подрабатывал, <w>раздавая листовки</w> местной службы доставки пиццы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "leafleting for a restaurant",
                        "start leafleting"
                    ],
                    "target_lang_definitions": {
                        "ru": "Раздавать печатные листы с информацией людям или в определенных местах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздавать листовки",
                                "target_lang_sense_clarification": "заниматься распространением печатной продукции"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}