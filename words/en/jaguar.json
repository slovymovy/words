                    "frequency": "Low",
                    "semantic_group_id": "vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He saved for years to finally buy a classic <w>Jaguar</w>.",
                            "target_lang_translations": {
                                "zh": "他攒了多年的钱，终于买下了一辆经典的<w>捷豹汽车</w>。"
                            }
                        },
                        {
                            "text": "The sleek <w>Jaguar</w> drove past us on the highway.",
                            "target_lang_translations": {
                                "zh": "那辆线条流畅的<w>捷豹汽车</w>从高速公路上飞驰而过。"
                            }
