                        "entry_id": "99905574-57bb-3aec-9ada-455b729ab39d",
                        "glosses": [
                            "Difficulté ou incapacité à effectuer certains gestes caractéristique d'une atteinte des lobes cérébraux pariétaux"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23c1cb8d-be1a-46a8-a6a8-d73245c1c9cc",
                                "sense_id": "ec063de5-a6bb-3117-8e6b-8c536ce82f97",
                                "text": "L’apraxie peut survenir à la suite de nombreuses affections : infection, tumeur, maladies neuro-dégénératives, traumatisme crânien."
                            }
                        ]
                    },
                    {
                        "sense_id": "5b8a8862-8927-39e2-b25b-1c085f699795",
                        "entry_id": "99905574-57bb-3aec-9ada-455b729ab39d",
                        "glosses": [
                            "Impossibilité d’utiliser des objets usuels, suite à une affection neurologique."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
