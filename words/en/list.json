                            {
                                "target_lang_word": "коварство",
                                "target_lang_sense_clarification": "устаревшее значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "机敏",
                                "target_lang_sense_clarification": "形容人聪明灵巧"
                            },
                            {
                                "target_lang_word": "狡黠",
                                "target_lang_sense_clarification": "形容人狡猾"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "06315280-8bb6-33f6-810a-8e2b2ea78159",
                    "sense_definition": "To write down items or names in a list; to include something in a record.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "record_series",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>list</w> all the ingredients you need for the recipe.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>перечислите</w> все ингредиенты, необходимые для рецепта.",
                                "zh": "请把做这个菜谱所需的所有配料都<w>列出</w>来。"
                            }
                        },
                        {
                            "text": "The teacher will <w>list</w> the names of the students who passed the exam.",
                            "target_lang_translations": {
                                "ru": "Учитель <w>перечислит</w> имена студентов, сдавших экзамен.",
                                "zh": "老师会把通过考试的学生名单<w>列出</w>来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tabulate",
                        "write down",
                        "record"
                    ],
                    "common_phrases": [
                        "list alphabetically",
                        "list below",
                        "list in order"
                    ],
                    "target_lang_definitions": {
                        "ru": "Записывать пункты или имена в список; включать что-либо в запись.",
                        "zh": "将项目或名字写成列表；将某事包含在记录中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перечислять",
                                "target_lang_sense_clarification": "называть или записывать по порядку"
                            },
                            {
                                "target_lang_word": "составлять список",
                                "target_lang_sense_clarification": "делать список"
                            },
                            {
                                "target_lang_word": "вносить в список",
                                "target_lang_sense_clarification": "регистрировать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "列出",
                                "target_lang_sense_clarification": "把项目逐一写出来"
                            },
                            {
                                "target_lang_word": "列入",
                                "target_lang_sense_clarification": "将某项内容加入到记录中"
                            }
                        ]
                    }
