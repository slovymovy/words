                        "sense_id": "d3ab8388-0eef-3d9b-b305-a86f1fd8b011",
                        "entry_id": "932e06b1-0303-3bf0-b12e-fa9bd0dd91cd",
                        "glosses": [
                            "dziś członek obcego plemienia, człowiek innego pochodzenia i narodowości"
                        ],
                        "tags": [
                            "literary",
