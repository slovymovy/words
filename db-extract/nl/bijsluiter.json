                    {
                        "sense_id": "cb8606e6-daaf-3c4b-94ee-f72a8f9a58d9",
                        "entry_id": "9eaee419-cb76-3af8-b938-f6b7c95671fe",
                        "glosses": [
                            "een bijgeleverde folder met informatie over een geneesmiddel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb3b1563-20de-4fbc-b6fa-048161a144ea",
                                "sense_id": "cb8606e6-daaf-3c4b-94ee-f72a8f9a58d9",
                                "text": "Eigenlijk zou je de bijsluiter helemaal moeten lezen voordat je het geneesmiddel gaat gebruiken maar nog beter is het omdat helemaal niet te doen ter vermijding van het nocebo-effect"
                            }
                        ]
