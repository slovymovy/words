                                "target_senses": [
                                    {
                                        "sense_id": "feeb9ea5-5b73-3019-988f-b9db8135c269",
                                        "entry_id": "32139e37-2eb5-31d9-86c8-a7f3f836e4bf",
                                        "glosses": [
                                            "Action de préserver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48dade56-f82b-4363-a43c-13097e9998ac",
                                                "sense_id": "feeb9ea5-5b73-3019-988f-b9db8135c269",
                                                "text": "Veiller à la préservation des droits, des intérêts de quelqu’un."
                                            },
                                            {
                                                "example_id": "1665ec45-9dba-4d56-abd6-657284dd9b4c",
                                                "sense_id": "feeb9ea5-5b73-3019-988f-b9db8135c269",
                                                "text": "Conservation et préservation des races. On parle de préservation lorsqu’il s’agit de sauver des races dont les effectifs sont déjà si réduits que les processus de reproduction habituels ne peuvent pratiquement plus suffire et que des mesures spéciales s’imposent. — (Wiener Gerald, Rouvier Roger, Amélioration génétique animale, 280 p., page 231, 2009, Quae/ CTA/ Presses agronomiques de Gembloux, Agricultures en poche, présentation)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
