                ],
                "senses": [
                    {
                        "sense_id": "dbcb4447-b109-3153-bf1d-ab6e926e3d3d",
                        "entry_id": "fb2bd755-aa7c-3230-a2cb-37abdba041fb",
                        "glosses": [
                            "Person, die in idealistischer oder träumerischer Weise die Welt verbessern möchte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cc1c1e8-6e19-45ed-a0f0-3361efad82f1",
                                "sense_id": "dbcb4447-b109-3153-bf1d-ab6e926e3d3d",
                                "text": "„Als Weltverbesserer sehen die meisten sich nicht, eher als Leute mit guten Ideen. Der Public Policy Student Christoph Glaser aus Basel hat aber tatsächlich einmal einen Club der Weltverbesserer gegründet und öffentliche Lachclubs auf Marktplätzen organisiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f120b018-ea8a-4ead-a0f5-a7fc024bf4dd",
                        "source_entry_id": "fb2bd755-aa7c-3230-a2cb-37abdba041fb",
                        "source_sense_id": "dbcb4447-b109-3153-bf1d-ab6e926e3d3d",
                        "source_sense_description": "Person, die in idealistischer oder träumerischer Weise die Welt verbessern möchte",
                        "target_lang_word": "do-gooder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "do-gooder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "827bdaba-97e3-3a2c-99a6-de8934c6a186",
                                        "entry_id": "6030ce0c-cb11-3253-91c6-152f43502ce3",
                                        "glosses": [
                                            "One who advocates a certain course of action, often of political or social concern, and often with the naive conviction of their own moral superiority."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca996449-8b0a-443a-91cb-fe4bcf2edbad",
                                                "sense_id": "827bdaba-97e3-3a2c-99a6-de8934c6a186",
                                                "text": "Prohibition in the United States was an unsuccessful attempt by do-gooders to save people from the dangers of alcohol, whether they wanted to be saved or not."
                                            },
                                            {
                                                "example_id": "9a06c997-5246-4877-a20e-63a7b1cae2a5",
                                                "sense_id": "827bdaba-97e3-3a2c-99a6-de8934c6a186",
                                                "text": "I was hopping along, minding my own business. All of a sudden, up he comes, cures me. One minute I'm a leper with a trade, next minute my livelihood's gone. Not so much as a by-your-leave! “You're cured mate.” Bloody do-gooder."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
