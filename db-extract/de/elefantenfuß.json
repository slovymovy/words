                ],
                "senses": [
                    {
                        "sense_id": "7b425fd5-0ac6-32cc-bce1-828d9c4a61fe",
                        "entry_id": "629adc7c-bc5c-3817-83d8-6cac21f2c3d6",
                        "glosses": [
                            "große Pflanze aus der Familie der Spargelgewächse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8eda3d15-6e05-46fa-807c-48439059fe2c",
                                "sense_id": "7b425fd5-0ac6-32cc-bce1-828d9c4a61fe",
                                "text": "Auf ihrer Reise nach Mexiko sahen sie viele Elefantenfüße."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "545ce8e1-8273-38c0-8274-352036f3bd73",
                        "entry_id": "629adc7c-bc5c-3817-83d8-6cac21f2c3d6",
                        "glosses": [
                            "Steighilfe, um höher liegende Gegenstände zu erreichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ffe0db2-796d-414b-b811-498c896ef5f7",
                                "sense_id": "545ce8e1-8273-38c0-8274-352036f3bd73",
                                "text": "Sie nahm sich einen Elefantenfuß, um die Bücher von dem hohen Schrank herunter zu holen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "288904d3-2aef-307f-afca-03f048400dc0",
                        "entry_id": "629adc7c-bc5c-3817-83d8-6cac21f2c3d6",
                        "glosses": [
                            "Krankheitsbild der Elephantiasis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cab4f83e-ba9b-4764-bf38-0d71a5ac2fac",
                                "sense_id": "288904d3-2aef-307f-afca-03f048400dc0",
                                "text": "„Die andere Krankheit, von den arabischen Ärzten E. genannt, ist eine Entartung der Haut, die sich mehr auf einen einzelnen Theil, besonders die Hände oder die Füße, beschränkt und nicht Beulen, wie jene, sondern eine mehr verbreitete gleichmäßige Anschwellung und Verhärtung der Haut und des Zellgewebes unter derselben herbeiführt und den befallenen Theil zuletzt auf eine außerordentliche Art entstellt. Daher auch der Name Elefantenfuß.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "989eb804-fe36-39fb-bcf4-e32829d4dca8",
                        "entry_id": "629adc7c-bc5c-3817-83d8-6cac21f2c3d6",
                        "glosses": [
                            "Fuß eines Elefanten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da5986b2-0709-4f02-bf60-1e640f11e565",
                                "sense_id": "989eb804-fe36-39fb-bcf4-e32829d4dca8",
                                "text": "„Zwischen allen diesen auch der Ausdehnung nach unendlich variierenden Formen, von denen der Elefantenfuß verhältnismäßig zum Schenkelknochen der kleinste, der der Robben und der Ein- und Zweihufer in eben dieser Beziehung der größte ist, steht die Größe des menschlichen Fußes, welcher in seiner Sohle um einen ganzen Modul kürzer als das Oberschenkelbein bleibt, abermals genau in der Mitte.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
