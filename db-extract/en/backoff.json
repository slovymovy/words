                        "entry_id": "251e366f-2253-3300-9aa3-26d8c8c52ffb",
                        "glosses": [
                            "The situation where an incoming wave passes from shallower water to a deeper area, making the wave less steep and potentially unsurfable."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
