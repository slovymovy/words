    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bbba7a9e-de53-3c69-8c43-086ad478ff53",
                    "sense_definition": "de neiging hebbend tot iets of bereid om iets te doen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bereidheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij was niet <w>genegen</w> om zijn excuses aan te bieden na het incident.",
                            "target_lang_translations": {
                                "en": "He was not <w>inclined</w> to apologize after the incident."
                            }
                        },
                        {
                            "text": "Zij toonde zich wel <w>genegen</w> om het bestuur hierbij te ondersteunen.",
                            "target_lang_translations": {
                                "en": "She showed herself quite <w>willing</w> to support the board in this matter."
                            }
                        }
                    ],
                    "synonyms": [
                        "bereid",
                        "geneigd"
                    ],
                    "antonyms": [
                        "ongenegen"
                    ],
                    "common_phrases": [
                        "genegen zijn om"
                    ],
                    "target_lang_definitions": {
                        "en": "inclined towards something or willing to do something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "inclined",
                                "target_lang_sense_clarification": "having a willingness or tendency to do something"
                            },
                            {
                                "target_lang_word": "willing",
                                "target_lang_sense_clarification": "ready or prepared to do something"
                            },
                            {
                                "target_lang_word": "disposed",
                                "target_lang_sense_clarification": "favorably inclined to do something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8f9f7c2-5807-3f43-bb16-443ace50ef70",
                    "sense_definition": "een welwillende of vriendschappelijke houding hebbend tegenover iemand",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "welwillendheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude heer was de jonge kunstenaar bijzonder goed <w>genegen</w>.",
                            "target_lang_translations": {
                                "en": "The old gentleman was particularly <w>well-disposed towards</w> the young artist."
                            }
                        },
                        {
                            "text": "De docent bleef al haar studenten altijd zeer <w>genegen</w>.",
                            "target_lang_translations": {
                                "en": "The teacher always remained very <w>fond of</w> all her students."
                            }
                        }
                    ],
                    "synonyms": [
                        "toegenegen",
                        "welgezind"
                    ],
                    "common_phrases": [
                        "iemand goed genegen zijn"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Vaak in formele of verouderde contexten gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "having a benevolent, affectionate, or friendly attitude towards someone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fond of",
                                "target_lang_sense_clarification": "having affection or goodwill towards someone"
                            },
                            {
                                "target_lang_word": "well-disposed towards",
                                "target_lang_sense_clarification": "favorably or kindly inclined towards someone"
                            },
                            {
                                "target_lang_word": "affectionate towards",
                                "target_lang_sense_clarification": "showing warm regard or liking"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7dfdc5d5-9ef5-3d29-ac3e-111a2d334789",
                    "sense_definition": "voltooid deelwoord van <w>nijgen</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De danseres heeft diep voor het publiek <w>genegen</w> na afloop van het optreden.",
                            "target_lang_translations": {
                                "en": "The dancer <w>curtsied</w> deeply to the audience after the performance."
                            }
                        },
                        {
                            "text": "Zij had hoffelijk <w>genegen</w> toen de koning de zaal binnenkwam.",
                            "target_lang_translations": {
                                "en": "She had <w>curtsied</w> courteously when the king entered the room."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Sterke vorm van het voltooid deelwoord, thans zeldzaam"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "past participle of 'nijgen' (to curtsy or bow)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "curtsied",
                                "target_lang_sense_clarification": "past participle of curtsy"
                            },
                            {
                                "target_lang_word": "bowed",
                                "target_lang_sense_clarification": "past participle of bow"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}