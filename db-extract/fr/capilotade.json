                        "glosses": [
                            "Sorte de ragoût fait de plusieurs morceaux de viandes déjà cuites."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e571a94e-ad57-423e-95a1-b4da26bc90ca",
                                "sense_id": "84978eca-16ef-34dc-98c0-d750b47e016c",
                                "text": "Faire une capilotade de perdrix, de poulets."
                            }
                        ]
                    },
                    {
                        "sense_id": "61f4ab90-d8a7-3484-b5a1-e6bbed825ca6",
                        "entry_id": "aa42cc85-22de-3aa2-849b-e87c991c30cb",
                        "glosses": [
                            "Très mauvaise situation, à la suite d'une série de coups, d’attaques médisantes."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "7c866128-0afe-44dd-af7f-42aa0dd835f5",
                                "sense_id": "61f4ab90-d8a7-3484-b5a1-e6bbed825ca6",
                                "text": "[…] ; sur cette ligne étroite, à une seule voie, le train longeait, d’un côté, les quartiers accumulés de pierre et, de l’autre, le vide. Seigneur ! si l’on déraillait ! Quelle capilotade ! se disait-il."
                            },
                            {
                                "example_id": "fb39ee63-9bb8-4068-b76d-231b49a1e23b",
                                "sense_id": "61f4ab90-d8a7-3484-b5a1-e6bbed825ca6",
                                "text": "Ils étaient là une vingtaine de solides quadragénaires et, profitant de la capilotade généralisée, ils avaient pris les choses en main."
                            }
                        ]
                    }
