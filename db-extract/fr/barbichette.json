                    }
                ],
                "senses": [
                    {
                        "sense_id": "63592f95-a71a-3296-ba28-504cf6a9abed",
                        "entry_id": "267c3a4b-508a-3913-890a-c3ccb27542e0",
                        "glosses": [
                            "Petite barbiche, barbichon."
                        ],
                        "tags": [
                            "Barbe"
                        ],
                        "examples": [
                            {
                                "example_id": "8dde3248-45fa-41f8-8816-f9e96d75fa62",
                                "sense_id": "63592f95-a71a-3296-ba28-504cf6a9abed",
                                "text": "« Je te tiens, tu me tiens, par la barbichette\nLe premier de nous deux qui rira\nAura une tapette\nAu bout de trois\nUn ! Deux ! Trois ! » (Comptine populaire qui se joue en tenant le menton de l'autre)"
                            },
                            {
                                "example_id": "4419f032-28db-4845-81ee-30a4d2fcc230",
                                "sense_id": "63592f95-a71a-3296-ba28-504cf6a9abed",
                                "text": "— Sa barbichette lui donne un faux air de Méphisto. Je comprends que ses élèves se moquent de lui."
                            },
                            {
                                "example_id": "39d695c5-5358-481f-a8e3-8a1875b09e2e",
                                "sense_id": "63592f95-a71a-3296-ba28-504cf6a9abed",
                                "text": "[Pierre Dac] Avec ses collaborateurs, dans l’Os à moelle, il introduisait chaque semaine l’anarchie dans le vocabulaire, la logique dans la folie et tirait sans aucun respect la barbichette de Descartes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b3b8f8e-ecb4-4036-8263-e6a21404a285",
                        "source_entry_id": "267c3a4b-508a-3913-890a-c3ccb27542e0",
                        "source_sense_id": "63592f95-a71a-3296-ba28-504cf6a9abed",
                        "target_lang_word": "Spitzenbärtchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3da4a03a-98e1-487d-a110-accab817d6d7",
                        "source_entry_id": "267c3a4b-508a-3913-890a-c3ccb27542e0",
                        "source_sense_id": "63592f95-a71a-3296-ba28-504cf6a9abed",
                        "target_lang_word": "Ziegenbärtchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ziegenbärtchen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "656fbc92-c80a-3c74-9cf8-641aaadd55b7",
                                        "entry_id": "96d8b95d-23ca-3279-bc10-f2e9fa26f3e3",
                                        "glosses": [
                                            "kleiner Ziegenbart, langes Kinnbärtchen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd682209-66bc-4cbd-a63c-49859e073b77",
                                                "sense_id": "656fbc92-c80a-3c74-9cf8-641aaadd55b7",
                                                "text": "„Der große Muskelmann im Anzug fiel als Erster ins Auge, der hinter dem kleineren Mann mit dem Ziegenbärtchen aufragte, doch als dieser Kleinere ihm die Hand entgegenstreckte, sah Kent ihm ins Gesicht und streckte seine ebenfalls aus.“"
                                            },
                                            {
                                                "example_id": "0d59eb28-2782-4d37-80ca-0f6a3658fa89",
                                                "sense_id": "656fbc92-c80a-3c74-9cf8-641aaadd55b7",
                                                "text": "„Mehdi hielt inne und strich sich wieder über sein Ziegenbärtchen.“"
                                            },
                                            {
                                                "example_id": "a1d4a33d-382c-47e4-ba17-9d25aa0c26e6",
                                                "sense_id": "656fbc92-c80a-3c74-9cf8-641aaadd55b7",
                                                "text": "„Diese Hippie-Erdmütter mit ihren Dreadlocks und diese Skaterpunks mit ihren Ziegenbärtchen, du hörst, wie sie ihren Börsenmaklern telefonisch Verkaufsaufträge erteilen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e8093f9-a86d-411d-82a7-cdce6eae244c",
                        "source_entry_id": "267c3a4b-508a-3913-890a-c3ccb27542e0",
                        "source_sense_id": "63592f95-a71a-3296-ba28-504cf6a9abed",
                        "target_lang_word": "goatee",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "goatee",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d70c983-e00f-30b4-a82e-2846d4c48f43",
                                        "entry_id": "9314755d-ebe7-389e-8632-969da9879782",
                                        "glosses": [
                                            "A beard trimmed to grow only at the center of the chin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88f2ed6a-2f10-4000-94ed-892738607bb7",
                                                "sense_id": "0d70c983-e00f-30b4-a82e-2846d4c48f43",
                                                "text": "One person sports a goatee, the hair refusing to grow on the sides of his physiognomy; the chin of another is as smooth as a baby's cheek,—he contents himself with a modest moustache and a faint attempt at an imperial; while a few of the upper classes rejoice in all the varieties."
                                            },
                                            {
                                                "example_id": "0b355618-bad3-4a21-8764-539e5e9b1ce2",
                                                "sense_id": "0d70c983-e00f-30b4-a82e-2846d4c48f43",
                                                "text": "The terrorist, as he called himself, was old and bald, with a narrow, snow-white wisp of a goatee hanging limply from his chin."
                                            },
                                            {
                                                "example_id": "3fc0bbb0-9e71-45c1-8c15-49038ba41d42",
                                                "sense_id": "0d70c983-e00f-30b4-a82e-2846d4c48f43",
                                                "text": "\"Yes, sir, behind you. He is a man of middle size, rather inclined to shortness. He is old, over sixty, with white hair, curved nose and a white, small beard of the variety that is called goatee.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
