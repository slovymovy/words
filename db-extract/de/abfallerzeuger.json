                    {
                        "sense_id": "11c7aba9-d47b-3b05-98b8-1dc97b4cb071",
                        "entry_id": "be1695af-500c-3211-b72b-6a69269fbc5a",
                        "glosses": [
                            "jemand (oder etwas), der Abfall erzeugt"
