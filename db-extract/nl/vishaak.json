                        "sense_id": "17b22710-7770-346c-8dcf-6e78f912cbef",
                        "entry_id": "08899658-09bc-39a9-a2b2-7526232eb023",
                        "glosses": [
                            "een meestal metalen haak bevestigd aan een lijn waarmee gevist wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd4840ec-ec6b-414e-844a-d9aa9c683c42",
                                "sense_id": "17b22710-7770-346c-8dcf-6e78f912cbef",
                                "text": "Doe even wat aas op die vishaak!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dbcf7811-1729-4a26-ab09-bc269a32b5a2",
                        "source_entry_id": "08899658-09bc-39a9-a2b2-7526232eb023",
                        "source_sense_id": "17b22710-7770-346c-8dcf-6e78f912cbef",
                        "target_lang_word": "Angelhaken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Angelhaken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cb5c64c2-7565-3f05-b6c5-06aba8c8d154",
                                        "entry_id": "b6a5e5a9-a687-3d57-885d-a20d4c828946",
                                        "glosses": [
                                            "gekrümmtes Metallteilchen am Ende der Angelschnur befestigt, um damit Fische zu fangen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "327d55f9-5a95-456e-9978-5ae1cbbead00",
                                                "sense_id": "cb5c64c2-7565-3f05-b6c5-06aba8c8d154",
                                                "text": "Er befestigte einen Köder am Angelhaken und warf die Schnur aus."
                                            },
                                            {
                                                "example_id": "cabfefdc-710d-46fc-a17d-789a60575f80",
                                                "sense_id": "cb5c64c2-7565-3f05-b6c5-06aba8c8d154",
                                                "text": "„Das Wort Häme (von ahd. ‚hamo’) bedeutet ursprünglich Angelhaken, Angelrute. Es hat mit dem ‚Hamen’ zu tun, einem Fangnetz mit Stiel […], das zum Fischefangen dient.“"
                                            },
                                            {
                                                "example_id": "0e3fb6c3-63d7-4e0b-8ed0-6027c8cc8aad",
                                                "sense_id": "cb5c64c2-7565-3f05-b6c5-06aba8c8d154",
                                                "text": "„»Anfüttern« wird das genannt, man gewöhnt die extrem vorsichtigen Karpfen auf diese Weise an bestimmte Futterplätze, damit sie später den Köder samt Angelhaken nicht verschmähen.“"
                                            },
                                            {
                                                "example_id": "0a5f5290-091e-4385-8d63-f05978a630e2",
                                                "sense_id": "cb5c64c2-7565-3f05-b6c5-06aba8c8d154",
                                                "text": "„Sie glotzten herüber wie Fische, die plötzlich überrascht entdecken, daß sie den Angelhaken schon lange verschluckt haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "250bc9c4-9d42-4e90-8f0f-59fe497b9ae1",
                        "source_entry_id": "08899658-09bc-39a9-a2b2-7526232eb023",
