                                        "glosses": [
                                            "allgemein: Substanz, mit der Materialien aufgehellt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e0e8435-eeb0-45e9-8545-46bb447c4bf1",
                                                "sense_id": "9f0648fe-9f67-3d9d-9e0d-678466405cfa",
                                                "text": "„Das vom Aesculin abgeleitete Methylumbelliferon war der erste industriell hergestellte Aufheller.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c7da3973-2457-393b-a4c2-42d533cad63b",
                                        "entry_id": "f881d9a7-fe82-3102-bc23-32c69199376b",
                                        "glosses": [
                                            "zusätzliche Lichtquelle zur Beleuchtung von Objekten"
                                        ],
                                        "tags": [
                                            "Photographie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63b88aa1-ce0b-4f0a-bb24-051139c1c1a9",
                                                "sense_id": "c7da3973-2457-393b-a4c2-42d533cad63b",
                                                "text": "„Ein Aufheller (engl.: Bouncer) besteht aus reflektierendem Material und wird so platziert, dass das einfallende Licht auf das Objekt geworfen wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "875cff0b-6260-3013-9315-297ec557b8cf",
                                        "entry_id": "f881d9a7-fe82-3102-bc23-32c69199376b",
                                        "glosses": [
                                            "kurz für Stimmungsaufheller"
                                        ],
                                        "tags": [
                                            "Psychiatrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49e60036-e021-4b20-92a9-9024e5d61d92",
                                                "sense_id": "875cff0b-6260-3013-9315-297ec557b8cf",
                                                "text": "„„Man setzte Medikamente ein – Antidepressiva, Beruhigungsmittel, Aufheller – und machte mit den Patienten zusätzlich eine Psychoanalyse“, berichtet Hypochondrieexperte Detlev O. Nutzinger.“"
                                            }
                                        ],
