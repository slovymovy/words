{
    "word_family": [
        "griezelen",
        "griezelig",
        "afgrijzen"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4a333be6-b5f9-39af-90cc-7239775f50af",
                    "sense_definition": "Heel erg lelijk of onaantrekkelijk om te zien.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lelijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat een <w>afgrijselijke</w> kleur is dat, zeg!",
                            "target_lang_translations": {
                                "en": "What a <w>hideous</w> color that is, I must say!"
                            }
                        },
                        {
                            "text": "Zij droeg een <w>afgrijselijke</w> jas die totaal niet bij haar paste.",
                            "target_lang_translations": {
                                "en": "She wore a <w>hideous</w> coat that didn't suit her at all."
                            }
                        }
                    ],
                    "synonyms": [
                        "afzichtelijk",
                        "afschuwelijk"
                    ],
                    "antonyms": [
                        "prachtig",
                        "mooi"
                    ],
                    "common_phrases": [
                        "afgrijselijke kleur",
                        "afgrijselijke kleding"
                    ],
                    "target_lang_definitions": {
                        "en": "Very ugly or unattractive to look at."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hideous",
                                "target_lang_sense_clarification": "extremely ugly"
                            },
                            {
                                "target_lang_word": "horrible",
                                "target_lang_sense_clarification": "very unpleasant or ugly"
                            },
                            {
                                "target_lang_word": "dreadful",
                                "target_lang_sense_clarification": "extremely disagreeable or ugly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1106f342-d0c2-3536-858a-3c5a7ea52a3c",
                    "sense_definition": "Verschrikkelijk, afschuwelijk of angstaanjagend; moreel verwerpelijk of heel erg naar.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verschrikkelijkheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij maakte laatst een <w>afgrijselijke</w> gebeurtenis mee.",
                            "target_lang_translations": {
                                "en": "He recently went through a <w>horrific</w> event."
                            }
                        },
                        {
                            "text": "Het nieuws over het ongeluk was werkelijk een <w>afgrijselijke</w> ervaring.",
                            "target_lang_translations": {
                                "en": "The news about the accident was truly a <w>dreadful</w> experience."
                            }
                        }
                    ],
                    "synonyms": [
                        "afschuwelijk"
                    ],
                    "antonyms": [
                        "geweldig",
                        "fijn"
                    ],
                    "common_phrases": [
                        "afgrijselijke gebeurtenis",
                        "afgrijselijke misdaad"
                    ],
                    "target_lang_definitions": {
                        "en": "Terrible, horrific, or terrifying; morally reprehensible or very unpleasant."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "horrific",
                                "target_lang_sense_clarification": "causing horror or dread"
                            },
                            {
                                "target_lang_word": "terrible",
                                "target_lang_sense_clarification": "extremely bad or distressing"
                            },
                            {
                                "target_lang_word": "awful",
                                "target_lang_sense_clarification": "very bad or unpleasant"
                            },
                            {
                                "target_lang_word": "dreadful",
                                "target_lang_sense_clarification": "extremely disagreeable or shocking"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "90dddb8d-fbbc-3965-a868-ff564dee133f",
                    "sense_definition": "In zeer hoge mate; buitengewoon of heel erg (gebruikt als versterking van een negatieve eigenschap).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "versterking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat is echt een <w>afgrijselijk</w> nare gebeurtenis.",
                            "target_lang_translations": {
                                "en": "That is really a <w>terribly</w> unpleasant event."
                            }
                        },
                        {
                            "text": "Het was die middag <w>afgrijselijk</w> koud buiten.",
                            "target_lang_translations": {
                                "en": "It was <w>dreadfully</w> cold outside that afternoon."
                            }
                        }
                    ],
                    "synonyms": [
                        "afschuwelijk"
                    ],
                    "common_phrases": [
                        "afgrijselijk koud",
                        "afgrijselijk duur"
                    ],
                    "target_lang_definitions": {
                        "en": "To a very high degree; extremely or terribly (used to intensify a negative quality)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "terribly",
                                "target_lang_sense_clarification": "extremely, in a negative context"
                            },
                            {
                                "target_lang_word": "awfully",
                                "target_lang_sense_clarification": "very, extremely"
                            },
                            {
                                "target_lang_word": "dreadfully",
                                "target_lang_sense_clarification": "extremely, to a great degree"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}