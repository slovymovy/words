                                "target_senses": [
                                    {
                                        "sense_id": "48edf59c-e568-3911-aa02-13c6783b3d38",
                                        "entry_id": "bdbccfb0-6fcc-3814-aa6a-e412f3c84703",
                                        "glosses": [
                                            "dünn, dürr"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e50a9f9f-443f-4d95-a3ee-a27a09b8b36e",
                                                "sense_id": "48edf59c-e568-3911-aa02-13c6783b3d38",
                                                "text": "Sie ist sehr mager geworden."
                                            },
                                            {
                                                "example_id": "0a9dfdcf-e24b-4b18-953c-f6690b41653c",
                                                "sense_id": "48edf59c-e568-3911-aa02-13c6783b3d38",
                                                "text": "„Hoffmann ist 52 und sieht aus, als liefe er Marathon oder betriebe Höhenbergsteigen: fast mager, immer ein bisschen durch den Wind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cb0bca50-a13c-3fc1-8850-465e3950f6d3",
                                        "entry_id": "bdbccfb0-6fcc-3814-aa6a-e412f3c84703",
                                        "glosses": [
                                            "arm an Fett"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "684c9741-b9df-4ac6-b13e-f5f31ee4a86e",
                                                "sense_id": "cb0bca50-a13c-3fc1-8850-465e3950f6d3",
                                                "text": "„Ich hätte gern ein mageres Stück Fleisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c7d92261-8179-347d-84d4-b5aa337cedb4",
                                        "entry_id": "bdbccfb0-6fcc-3814-aa6a-e412f3c84703",
                                        "glosses": [
                                            "wenig ertragreich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "756d44fd-1d08-4a24-a998-cda3271fe4e5",
                                                "sense_id": "c7d92261-8179-347d-84d4-b5aa337cedb4",
                                                "text": "Es war ein mageres Jahr für die Wirtschaft."
                                            },
                                            {
                                                "example_id": "5730a4ff-2a10-4b8b-8495-4bef54adec94",
                                                "sense_id": "c7d92261-8179-347d-84d4-b5aa337cedb4",
                                                "text": "„Das Wirtschaftswachstum, das 2010 mit 7,5 Prozent seinen Höhepunkt erreichte, ist fast zum Erliegen gekommen. Im zweitgrößten Schwellenland der Erde dürfte es dieses Jahr um magere zwei Prozent zulegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
