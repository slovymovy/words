                "senses": [
                    {
                        "sense_id": "cf6f28c2-8318-320b-a0a2-ad9a5ea224e0",
                        "entry_id": "8968fa8a-a3c9-38ab-87be-75d7e1c31063",
                        "glosses": [
                            "Professorin an einer Hochschule"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be5038fe-ceb6-4e3e-b503-4c818eff1def",
                                "sense_id": "cf6f28c2-8318-320b-a0a2-ad9a5ea224e0",
                                "text": "„Und die in San Diego lebende australische Hochschulprofessorin Michellie Jones erschien in Seefeld schon traditionell in Jeans.“"
                            },
                            {
                                "example_id": "80d446cd-20d2-4041-a028-e147d3ae281b",
                                "sense_id": "cf6f28c2-8318-320b-a0a2-ad9a5ea224e0",
                                "text": "„Maria Böhmer (CDU, Ludwigshafen-Frankenthal): Hochschulprofessorin, Vize-Vorsitzende ZDF-Fernsehrat, Schirmfrau Dialysepatienten Deutschland.“"
                            },
                            {
                                "example_id": "3a829b0c-469c-4e82-bce5-8fe8659fd39b",
                                "sense_id": "cf6f28c2-8318-320b-a0a2-ad9a5ea224e0",
                                "text": "„\"ich bin\", sagt die 48jährige Hochschulprofessorin der Erziehungswissenschaft, \"über die Familienforschung zur Frauenforschung gekommen. […]\"“"
                            },
                            {
                                "example_id": "42591dd7-4916-4b4c-a66b-146ed2878020",
                                "sense_id": "cf6f28c2-8318-320b-a0a2-ad9a5ea224e0",
                                "text": "„Der Rat der Hochschulprofessorin an Marie und alle anderen, die sich nur so viel wie nötig bewegen: ‚Man muss sich nur bewusst werden, wie viel man sich eigentlich schon bewegt. […]‘“"
                            },
                            {
                                "example_id": "6ca81950-72f4-483a-9419-6d199e06457c",
                                "sense_id": "cf6f28c2-8318-320b-a0a2-ad9a5ea224e0",
                                "text": "„\"Jetzt kommen nach und nach die Ergebnisse aus der Hirnforschung dazu, die dies bestätigen\", sagte die Hochschulprofessorin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
