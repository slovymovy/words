                        ],
                        "examples": [
                            {
                                "example_id": "de41e2d0-2ddd-447e-871a-9918d0ca61b1",
                                "sense_id": "665a0b0f-7e93-3ff5-a082-dc92ed827a58",
                                "text": "ædopsophie, s. f., ædopsophia, de αιδοια, parties génitales, ψοφειν, faire du bruit. Émission de gaz s’échappant de la vessie par le canal de l’urètre, la matrice ou le vagin. Il ne faut pas confondre l’ædopsophie qui ne s’entend que des émanations aériformes venant de la matrice et de la vessie, avec la flatulence, dont le caractère est de laisser échapper du canal alimentaire, soit par son extrémité œsophagienne ou par l’anus, des gaz et notamment de l’hydrogène."
                            }
                        ]
                    }
