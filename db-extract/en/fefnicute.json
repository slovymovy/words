                        "glosses": [
                            "A two-faced, sneaky person."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f48eefa2-5fa1-4256-8739-c86074671b5b",
                                "sense_id": "aea5c1be-8905-3094-8dfe-051463ad33d2",
                                "text": "Aw’v no payshuns we um un ther kaps o liberte; ther naut but o parsel o feffnecutes, powsedurts us they r."
                            },
                            {
                                "example_id": "bea29ad4-162d-4ff3-9292-ebae22e628d3",
                                "sense_id": "aea5c1be-8905-3094-8dfe-051463ad33d2",
                                "text": "\"What mak o' lennock faffnecutes an' ricklin bandyhewits are they? Tell me some sthrong words, Weighver; aw've noane 'at con do justice to sich heighvy-keighvy pickhawms!\""
                            },
                            {
                                "example_id": "b670b8b2-d35b-4855-9724-81f8461994e5",
                                "sense_id": "aea5c1be-8905-3094-8dfe-051463ad33d2",
                                "text": "Just prior to V-J (Victory over Japan) Day, this fefnicute Lin Piao visited Chungking to pay respects to his Commandant and preceptor."
                            },
                            {
                                "example_id": "81adcb11-c83b-4d2a-b2c9-b2f6a8f41c7f",
                                "sense_id": "aea5c1be-8905-3094-8dfe-051463ad33d2",
                                "text": "Later that evening she rang me, calling the locum some choice names, including fefnicute. The fefnicute had refused to put a filling in her painful tooth, because, he said, she was under the weather.\nShe said that the word meant a miserable git, a mean, sneaking fellow. It was a Lancashire word she remembered from childhood."
                            }
                        ]
                    }
