                "senses": [
                    {
                        "sense_id": "70a07bde-ec04-3a18-823c-b74780a8a8c8",
                        "entry_id": "ef855374-d612-34bd-a06c-82f75af5b83c",
                        "glosses": [
                            "Gymnastique traditionnelle chinoise et méthode de respiration, fondée sur la connaissance et la maîtrise du qi (l’énergie vitale), et associant mouvements lents, exercices respiratoires et concentration."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ba85e1d-212e-43e4-9a2a-c80b2c677572",
                                "sense_id": "70a07bde-ec04-3a18-823c-b74780a8a8c8",
                                "text": "Au choix, une dizaine d’activités différentes : fitness, Zumba, Pilates, yoga, stretching, longe-côte, aéro-boxe, taï-chi, qigong…"
                            },
                            {
                                "example_id": "3a027541-ce31-45ce-9fd5-10960481f64f",
                                "sense_id": "70a07bde-ec04-3a18-823c-b74780a8a8c8",
                                "text": "L’Association planifiait aussi de subventionner la recherche scientifique sur le qigong, de faire disparaître les éléments de la « superstition » qui s’y sont rattachés et de systématiser la connaissance et la pratique du qigong."
                            },
                            {
                                "example_id": "311915fb-9655-4639-93ab-6e047831c554",
                                "sense_id": "70a07bde-ec04-3a18-823c-b74780a8a8c8",
                                "text": "En plus des méthodes de cultivation interne, il y a encore le qigong des arts martiaux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8218fbc9-1e68-4e5b-baf2-29af8603562d",
                        "source_entry_id": "ef855374-d612-34bd-a06c-82f75af5b83c",
                        "source_sense_id": "70a07bde-ec04-3a18-823c-b74780a8a8c8",
                        "target_lang_word": "qigong",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "qigong",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e78c3546-0ef9-31e4-b66c-d4bb3649ca30",
                                        "entry_id": "27201964-eaa0-3c5c-a12e-4c076f1b0321",
                                        "glosses": [
                                            "A Chinese system of breathing control, physical exercise and meditation."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6816c636-2c8e-4032-be5c-d9b04cfa84b8",
                                                "sense_id": "e78c3546-0ef9-31e4-b66c-d4bb3649ca30",
                                                "text": "Some people may suddenly speak a language and speak it quite fluently. However, it is not a language of human society. What can it be called? It can be called \"cosmic language\" (宇宙語). Actually it is nothing but a language of subtle beings in a space only a little bit higher than ours. Now quite a few of qigong practitioners in China have had such an experience. Some can even speak several such languages."
                                            },
                                            {
                                                "example_id": "f39abfc4-56f0-4099-be4d-5541b3374aa2",
                                                "sense_id": "e78c3546-0ef9-31e4-b66c-d4bb3649ca30",
                                                "text": "My patients laud qigong as a stressbuster and cure for pesky chronic symptoms that baffle doctors."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e858335d-aad8-4d3d-9320-8670fa739ec1",
                        "source_entry_id": "ef855374-d612-34bd-a06c-82f75af5b83c",
                        "source_sense_id": "70a07bde-ec04-3a18-823c-b74780a8a8c8",
