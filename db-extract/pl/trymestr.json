                                "target_senses": [
                                    {
                                        "sense_id": "120d5edd-d4e6-3b42-9994-d966e96f11cb",
                                        "entry_id": "43a15119-1e43-31fd-b5f9-a99c8bf808a9",
                                        "glosses": [
                                            "A period of three months or about three months; (financial): quarter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ecf6583-a6b4-4551-ba9e-a22d342ff9f1",
                                                "sense_id": "120d5edd-d4e6-3b42-9994-d966e96f11cb",
                                                "text": "She is in the second trimester of her first pregnancy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75fc8a48-c556-33a0-96a0-9d2d24f80580",
                                        "entry_id": "43a15119-1e43-31fd-b5f9-a99c8bf808a9",
                                        "glosses": [
                                            "One of the terms of an academic year in those learning institutions that divide their teaching in three roughly equal terms, each about three months long. Compare semester."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a37bbe7-7de8-4f93-b045-7b1294e803f2",
                                                "sense_id": "75fc8a48-c556-33a0-96a0-9d2d24f80580",
                                                "text": "The school operates on a trimester schedule."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ebab0040-0d4d-4982-a886-dfafa3b21793",
                        "source_entry_id": "1e3e7b6f-beaf-381b-b99e-0b5a0bea1b09",
                        "source_sense_id": "af5a38c9-8aa0-3f27-8094-5a958474007d",
                        "target_lang_word": "trimestre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trimestre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "55da83b6-ccc4-3487-8990-3c9df9b4dbc7",
                                        "entry_id": "1835b50e-994f-3761-a22b-9717dd45c939",
                                        "glosses": [
                                            "Espace de trois mois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20e493c2-c055-4c49-a79f-60368ebf74c0",
                                                "sense_id": "55da83b6-ccc4-3487-8990-3c9df9b4dbc7",
                                                "text": "Des intérêts payés par trimestre."
                                            },
                                            {
                                                "example_id": "50281637-48dd-450e-86b1-fcf053544d93",
                                                "sense_id": "55da83b6-ccc4-3487-8990-3c9df9b4dbc7",
                                                "text": "Le premier trimestre de l’année."
                                            },
                                            {
                                                "example_id": "b7a0b105-5354-4662-992c-38c77df83b74",
                                                "sense_id": "55da83b6-ccc4-3487-8990-3c9df9b4dbc7",
                                                "text": "Il fallait adopter l’agenda qui retenait le temps : « l’Agenda Mignon ».\nSes fabricants étaient de grands psychologues. Ils l’avaient divisé en quatre carnets, correspondant aux quatre trimestres. Ainsi on ne pouvait pas avaler toute l’année d’un seul coup. Chaque trimestre se prélassait avec la carrure d’une vraie petite année, munie de son Premier de l’an, de ses Pâques, de sa Noël."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e1b02d6-c6a0-3d46-9be1-c8e68a98f2c9",
                                        "entry_id": "1835b50e-994f-3761-a22b-9717dd45c939",
                                        "glosses": [
                                            "Ce que l’on paie à quelqu’un au commencement ou à la fin de chaque trimestre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2c5e01c-3958-4a15-9574-654696e110c6",
                                                "sense_id": "1e1b02d6-c6a0-3d46-9be1-c8e68a98f2c9",
                                                "text": "Il a touché le premier trimestre."
                                            },
                                            {
                                                "example_id": "f9a6ec94-d418-4c46-8b54-c430960a55df",
                                                "sense_id": "1e1b02d6-c6a0-3d46-9be1-c8e68a98f2c9",
                                                "text": "Payer le trimestre échu."
                                            },
                                            {
                                                "example_id": "36bbe361-6d15-4258-bcb1-b57bbf53ca5b",
                                                "sense_id": "1e1b02d6-c6a0-3d46-9be1-c8e68a98f2c9",
                                                "text": "Voici le premier trimestre de cette année, ajouta-t-il en caressant une pile d’or, comme pour vérifier la somme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10375e55-6353-3878-8953-efcbe4738b40",
                                        "entry_id": "1835b50e-994f-3761-a22b-9717dd45c939",
                                        "glosses": [
                                            "Élément de calcul de la retraite."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
