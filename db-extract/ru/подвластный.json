                            {
                                "example_id": "9f4288f4-1274-4c62-a36a-3e7072017740",
                                "sense_id": "964970d4-7b35-39dd-965f-b008847806ff",
                                "text": "ему́ э́то вряд ли подвла́стно",
                                "translation": "it is hardly within his power/control",
                                "english": "it is hardly within his power/control"
                            },
                            {
                                "example_id": "9cf9baad-e9ff-4920-8cd7-d247af896aca",
                                "sense_id": "964970d4-7b35-39dd-965f-b008847806ff",
                                "text": "В не́которой благослове́нной и цвету́щей стране́, на высо́ких берега́х у прекра́сной реки́, теку́щей с уве́нчанных ве́чным сне́гом ю́жных гор к вели́кому Се́верному мо́рю, лежа́ли обши́рные зе́мли, подвла́стные могу́чему владе́льцу.",
                                "translation": "Fyodor Sologub",
                                "english": "Fyodor Sologub"
                            }
                        ]
