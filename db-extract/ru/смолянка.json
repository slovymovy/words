                        "glosses": [
                            "женск. к смолянин; жительница или уроженка Смоленска"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86ace197-f3ca-45af-bb49-a74bde84f639",
                                "sense_id": "50399f45-6f8c-3506-bb74-a40ddfe7e29d",
                                "text": "Она происходит не отсюда. Бабушка у нее, сказала, смолянка. Видимо, из Смоленска все барахло вывезли."
                            }
                        ]
                    },
