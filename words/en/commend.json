{
    "word_family": [
        "commendable",
        "commendation",
        "commendatory",
        "recommending",
        "recommendation"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "21df648d-8501-31ce-98a7-5c4718851aec",
                    "sense_definition": "To praise or express approval of someone or something formally.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "praise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee decided to <w>commend</w> the officer for his exceptional bravery during the crisis.",
                            "target_lang_translations": {
                                "ru": "Комитет решил <w>отметить</w> офицера за его исключительную храбрость во время кризиса."
                            }
                        },
                        {
                            "text": "While the report is detailed, there is very little to <w>commend</w> in its final conclusions.",
                            "target_lang_translations": {
                                "ru": "Хотя отчет подробный, в его окончательных выводах очень мало того, что можно было бы <w>одобрить</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "praise",
                        "acclaim",
                        "laud",
                        "extol"
                    ],
                    "antonyms": [
                        "criticize",
                        "condemn",
                        "reprimand"
                    ],
                    "common_phrases": [
                        "highly commend",
                        "little to commend"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально хвалить или выражать одобрение кому-либо или чему-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хвалить",
                                "target_lang_sense_clarification": "высказывать одобрение"
                            },
                            {
                                "target_lang_word": "одобрять",
                                "target_lang_sense_clarification": "выражать положительное мнение"
                            },
                            {
                                "target_lang_word": "отмечать",
                                "target_lang_sense_clarification": "официально выделять заслуги"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "90d26613-77c8-3b8d-b1f0-d72eeb0e4c0b",
                    "sense_definition": "To formally reward or congratulate someone for a specific achievement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "praise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The schoolboy was <w>commended</w> for raising the alarm about the burning building.",
                            "target_lang_translations": {
                                "ru": "Школьнику <w>выразили благодарность</w> за то, что он поднял тревогу из-за горящего здания."
                            }
                        },
                        {
                            "text": "The mayor will <w>commend</w> the volunteers at a special ceremony held next week.",
                            "target_lang_translations": {
                                "ru": "Мэр <w>наградит</w> волонтеров на специальной церемонии, которая состоится на следующей неделе."
                            }
                        }
                    ],
                    "synonyms": [
                        "congratulate",
                        "honor"
                    ],
                    "common_phrases": [
                        "commend for bravery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Формально награждать или поздравлять кого-либо за конкретное достижение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поздравлять",
                                "target_lang_sense_clarification": "выражать признание заслуг"
                            },
                            {
                                "target_lang_word": "выносить благодарность",
                                "target_lang_sense_clarification": "официально поощрять"
                            },
                            {
                                "target_lang_word": "награждать",
                                "target_lang_sense_clarification": "отмечать почестями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5f9478d-7bf6-3a61-8515-4bba99a16d11",
                    "sense_definition": "To present as suitable for approval or acceptance; to <w>recommend</w>.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "recommendation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>commend</w> this book to anyone interested in the history of ancient Rome.",
                            "target_lang_translations": {
                                "ru": "Я <w>рекомендую</w> эту книгу всем, кто интересуется историей Древнего Рима."
                            }
                        },
                        {
                            "text": "The new strategy should <w>commend</w> itself to the board of directors immediately.",
                            "target_lang_translations": {
                                "ru": "Новая стратегия должна сразу <w>понравиться</w> совету директоров."
                            }
                        }
                    ],
                    "synonyms": [
                        "recommend",
                        "advocate"
                    ],
                    "common_phrases": [
                        "commend itself to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Представлять как подходящее для одобрения или принятия; рекомендовать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рекомендовать",
                                "target_lang_sense_clarification": "советовать как подходящее"
                            },
                            {
                                "target_lang_word": "предлагать",
                                "target_lang_sense_clarification": "выносить на рассмотрение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40961083-69ca-3e44-a2f7-66ccb5658ad3",
                    "sense_definition": "To entrust or commit someone or something to the care of another.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "entrust",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After being imprisoned, I had to <w>commend</w> my kids to my mom's safekeeping.",
                            "target_lang_translations": {
                                "ru": "После того как меня посадили в тюрьму, мне пришлось <w>вверить</w> детей заботам моей матери."
                            }
                        },
                        {
                            "text": "The dying man chose to <w>commend</w> his soul to a higher power.",
                            "target_lang_translations": {
                                "ru": "Умирающий решил <w>предать</w> свою душу высшим силам."
                            }
                        }
                    ],
                    "synonyms": [
                        "entrust",
                        "commit",
                        "assign"
                    ],
                    "common_phrases": [
                        "commend to safekeeping"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in formal or religious contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вверять или передавать кого-либо или что-либо под чью-то опеку или заботу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вверять",
                                "target_lang_sense_clarification": "отдавать под опеку или на хранение"
                            },
                            {
                                "target_lang_word": "поручать",
                                "target_lang_sense_clarification": "передавать заботу о ком-либо"
                            },
                            {
                                "target_lang_word": "предавать",
                                "target_lang_sense_clarification": "в религиозном контексте, например, душу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "720ebd57-2ab8-3382-84eb-d4e3c8e43cfc",
                    "sense_definition": "To deliver greetings or regards from one person to another.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "greetings",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>commend</w> me to your brother when you see him tomorrow.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>передай привет</w> своему брату, когда увидишь его завтра."
                            }
                        },
                        {
                            "text": "He asked that I <w>commend</w> him to the family before I left the city.",
                            "target_lang_translations": {
                                "ru": "Он попросил, чтобы я <w>засвидетельствовал его почтение</w> семье перед моим отъездом из города."
                            }
                        }
                    ],
                    "synonyms": [
                        "remember",
                        "greet"
                    ],
                    "common_phrases": [
                        "commend me to"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in older literature or very formal speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Передавать приветствия или пожелания от одного человека другому."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "передавать привет",
                                "target_lang_sense_clarification": "засвидетельствовать почтение"
                            },
                            {
                                "target_lang_word": "рекомендоваться",
                                "target_lang_sense_clarification": "устаревшая форма приветствия"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cba12f83-e0a5-3580-98d6-3e4302ff70a5",
                    "sense_definition": "An act of praise or a formal expression of approval.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "praise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier's actions were beyond any <w>commend</w> that words could provide.",
                            "target_lang_translations": {
                                "ru": "Действия солдата были выше любой <w>похвалы</w>, которую можно выразить словами."
                            }
                        },
                        {
                            "text": "He spoke in his just <w>commend</w> to ensure the truth was known.",
                            "target_lang_translations": {
                                "ru": "Он высказался в его справедливое <w>оправдание</w>, чтобы правда стала известна."
                            }
                        }
                    ],
                    "synonyms": [
                        "praise",
                        "commendation"
                    ],
                    "antonyms": [
                        "criticism"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used as a noun in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт похвалы или формальное выражение одобрения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "похвала",
                                "target_lang_sense_clarification": "выражение одобрения"
                            },
                            {
                                "target_lang_word": "одобрение",
                                "target_lang_sense_clarification": "признание заслуг"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1cdee99c-bcae-30db-ad31-6536fc596a92",
                    "sense_definition": "Formal greetings or compliments sent to someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "greetings",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please accept my hearty <w>commends</w> and much endeared love unto you.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, примите мои сердечные <w>приветствия</w> и искреннюю любовь к вам."
                            }
                        },
                        {
                            "text": "The letter concluded with warm <w>commends</w> to all the members of the household.",
                            "target_lang_translations": {
                                "ru": "Письмо заканчивалось теплыми <w>пожеланиями</w> всем домочадцам."
                            }
                        }
                    ],
                    "synonyms": [
                        "greetings",
                        "compliments",
                        "regards"
                    ],
                    "common_phrases": [
                        "hearty commends"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "found in historical correspondence"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальные приветствия или комплименты, направленные кому-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приветствия",
                                "target_lang_sense_clarification": "выражение почтения в письме"
                            },
                            {
                                "target_lang_word": "поклоны",
                                "target_lang_sense_clarification": "устаревшая форма передачи привета"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}