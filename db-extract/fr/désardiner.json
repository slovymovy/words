                "senses": [
                    {
                        "sense_id": "cf62ed4a-da34-36ba-a826-f03377574e7d",
                        "entry_id": "7db86f84-1ee1-30ef-b04e-4955fb8b6f62",
                        "glosses": [
                            "Retirer les sardines qui fixaient quelque chose au sol."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5cc60e6-71cb-44b5-a93f-4378f6009df7",
                                "sense_id": "cf62ed4a-da34-36ba-a826-f03377574e7d",
                                "text": "Dormir dans une tente inondée? porter des habits humides? se laver dans une douche crade? courir pieds nus dans l'herbe trempée? sortir en caleçon ridicule? s'immiscer dans la conversation de nos voisins de tente? se prendre les pieds dans les fils des tentes et les désardiner?"
                            },
                            {
                                "example_id": "462a31d5-da97-49b7-9c9f-127603068b8f",
                                "sense_id": "cf62ed4a-da34-36ba-a826-f03377574e7d",
                                "text": "Mais c’est sans compter sur Taranis et son cousin Eole, qui prennent un malin plaisir à 'désardiner' puis inonder une tente pourtant réputée insubmersible..."
                            },
                            {
                                "example_id": "add426dd-8dab-4fd6-be4a-69882109774f",
                                "sense_id": "cf62ed4a-da34-36ba-a826-f03377574e7d",
                                "text": "Désardiner la moitié des tentes se trouvant dans notre passage."
                            }
                        ]
                    }
                ],
