                "senses": [
                    {
                        "sense_id": "f78295cc-62fb-3384-a826-2f79aa85c736",
                        "entry_id": "06298eeb-39d1-3c0d-9d7c-c0855d30caa7",
                        "glosses": [
                            "weibliche Form von Gevatter: Patin; Nachbarin, Verwandte und Ähnliches"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6de0da8-6296-4f10-a92c-581b2892cdaf",
                                "sense_id": "f78295cc-62fb-3384-a826-2f79aa85c736",
                                "text": "„Die Gevatterin Süeh begab sich geradewegs zum Ladeneingange, hob den Türvorhang empor, und bewog Simen Tjing, der mit dem Geschäftsführer abrechnete, durch Kopfnicken, herauszukommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "09830248-e440-42ef-b9a3-d63d068eebc1",
                        "source_entry_id": "06298eeb-39d1-3c0d-9d7c-c0855d30caa7",
                        "source_sense_id": "f78295cc-62fb-3384-a826-2f79aa85c736",
                        "source_sense_description": "weibliche Form von Gevatter: Patin; Nachbarin, Verwandte und Ähnliches",
                        "target_lang_word": "godmother",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "godmother",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "446714e3-44cc-397e-b55a-26b2b73acabd",
                                        "entry_id": "c5323110-0d3a-3a7e-a7eb-ddc27041a966",
                                        "glosses": [
                                            "A woman present at the christening of a baby who promises to help raise the child in a Christian manner; a female godparent who sponsors the baptism of a child."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "godmother",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de8c5612-7ea2-3eef-9962-b786efa8777d",
                                        "entry_id": "c07e8985-5c79-33e6-8765-d83fcf8fc4e2",
                                        "glosses": [
                                            "To act as godmother to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f01b5620-7949-4588-8d5d-2c99e7287704",
                                                "sense_id": "de8c5612-7ea2-3eef-9962-b786efa8777d",
                                                "text": "The servants took to her – as they say – she godmothered three Susans during her rule, the coachman's, the gardener's and the Up Hill gamekeeper's."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "791e6ff4-5227-49f7-8717-102cc730bd7d",
                        "source_entry_id": "06298eeb-39d1-3c0d-9d7c-c0855d30caa7",
                        "source_sense_id": "f78295cc-62fb-3384-a826-2f79aa85c736",
                        "source_sense_description": "weibliche Form von Gevatter: Patin; Nachbarin, Verwandte und Ähnliches",
                        "target_lang_word": "neighbour",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neighbour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aa013db3-a806-3d09-b24e-ad657a35ba22",
                                        "entry_id": "f179321d-ac79-32b0-8dd2-697b08bfd0ee",
                                        "glosses": [
                                            "A person living on adjacent or nearby land; a person situated adjacently or nearby; anything (of the same type of thing as the subject) in an adjacent or nearby position."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4af89625-e428-4792-9b8e-eef47275bc9c",
                                                "sense_id": "aa013db3-a806-3d09-b24e-ad657a35ba22",
                                                "text": "My neighbour has two noisy cats."
                                            },
                                            {
                                                "example_id": "4745bc75-a99e-46e2-912b-dbb01f6ee5fe",
                                                "sense_id": "aa013db3-a806-3d09-b24e-ad657a35ba22",
                                                "text": "They′re our neighbours across the street."
                                            },
                                            {
                                                "example_id": "8860afad-74d5-490f-aa35-f3afcd63ab95",
                                                "sense_id": "aa013db3-a806-3d09-b24e-ad657a35ba22",
                                                "text": "1660, Hugh Peters, The Tales and Jests of Mr. Hugh Peters, reprinted 1807, page 10,\nBeing at his own house in the country, when a great tempest of wind rose, he takes an occasion to visit a neighbour by him, and being somewhat merily disposed, quoth he Oh neighbour, did you not see what a wind there was the other day?"
                                            },
                                            {
                                                "example_id": "13f8f59d-8fb4-4430-a575-2a58586027b3",
                                                "sense_id": "aa013db3-a806-3d09-b24e-ad657a35ba22",
                                                "text": "Undine at length shrank back with an unrecognizing face; but her movement made her opera-glass slip to the floor, and her neighbour bent down and picked it up."
                                            },
                                            {
                                                "example_id": "db47d6ee-92df-4b50-9938-7138e0c6d066",
                                                "sense_id": "aa013db3-a806-3d09-b24e-ad657a35ba22",
                                                "text": "Neighbours enact their substantive noun when there′s a neighbour′s sickness in the night; as friends do theirs, the cindered and the green times through."
                                            },
                                            {
                                                "example_id": "8f27c985-d1b2-4631-ba6d-01446a195aac",
                                                "sense_id": "aa013db3-a806-3d09-b24e-ad657a35ba22",
                                                "text": "2009, D. Staufer, Classical Percolation, Asok K. Sen, Kamal K. Bardhan, Bikas K. Chakrabarti (editors), Quantum and Semi-Classical Percolation and Breakdown in Disordered Solids, Springer, Lecture Notes in Physics 762, page 4,\nThen a cluster is grown by letting each empty neighbour of an already occupied cluster site decide once and for all, whether it is occupied or empty. One needs to keep and to update a perimeter list of empty neighbours."
                                            },
                                            {
                                                "example_id": "65ec95b5-9e63-44dc-8439-83e56fee003e",
                                                "sense_id": "aa013db3-a806-3d09-b24e-ad657a35ba22",
                                                "text": "2011, Richard Jensen, Chris Cornelis, \"Fuzzy-Rough Nearest Neighbour Classification\", James F. Peters, Andrzej Skowron (editors-in-chief), Transactions on Rough Sets XIII, Springer, Lecture Notes in Computing Science 6499, page 56,\nBy contrast to the latter, our method uses the nearest neighbours to construct lower and upper approximations of decision classes, and classifies test instances based on their membership to these approximations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c058bea-2537-320b-829d-e1e86a7e3576",
                                        "entry_id": "f179321d-ac79-32b0-8dd2-697b08bfd0ee",
                                        "glosses": [
                                            "One who is near in sympathy or confidence."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
