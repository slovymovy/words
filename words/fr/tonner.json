                {
                    "sense_id": "45554272-997b-3690-b87b-5d19ca228795",
                    "sense_definition": "S'exprimer ou protester avec force, colère et véhémence contre quelque chose ou quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "parole",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le responsable n'a pas hésité à <w>tonner</w> contre les retards répétés de l'équipe.",
                            "target_lang_translations": {
                                "en": "The manager did not hesitate to <w>rail</w> against the team's repeated delays.",
                                "ru": "Руководитель не постеснялся <w>обличать</w> повторяющиеся задержки команды.",
                                "nl": "De verantwoordelijke aarzelde niet om <w>tekeer</w> te <w>gaan</w> tegen de herhaalde vertragingen van het team.",
                                "de": "Der Verantwortliche zögerte nicht, gegen die wiederholten Verspätungen des Teams zu <w>wettern</w>.",
                                "pl": "Kierownik nie wahał się <w>grzmieć</w> przeciwko powtarzającym się opóźnieniom zespołu.",
                                "it": "Il responsabile non ha esitato a <w>tuonare</w> contro i ripetuti ritardi della squadra.",
                                "cs": "Vedoucí neváhal <w>hřímat</w> proti opakovaným zpožděním týmu.",
                                "tr": "Sorumlu, ekibin tekrar tekrar yaşanan gecikmelerine karşı hiç çekinmeden <w>çıkıştı</w>.",
                                "es": "El responsable no dudó en <w>tronar</w> contra los reiterados retrasos del equipo.",
                                "zh": "负责人毫不犹豫地<w>怒斥</w>团队屡次延误的行为。"
                            }
                        },
                        {
                            "text": "« C'est inadmissible ! », a <w>tonné</w> le directeur en réunion.",
                            "target_lang_translations": {
                                "en": "'This is unacceptable!' <w>thundered</w> the director during a meeting.",
                                "ru": "«Это недопустимо!» — <w>загремел</w> директор на совещании.",
                                "nl": "„Dit is onaanvaardbaar!” <w>donderde</w> de directeur tijdens de vergadering.",
                                "de": "„Das ist inakzeptabel!“, <w>donnerte</w> der Direktor in der Besprechung.",
                                "pl": "„To niedopuszczalne!” — <w>zagrzmiał</w> dyrektor na zebraniu.",
                                "it": "«È inammissibile!», ha <w>tuonato</w> il direttore durante la riunione.",
                                "cs": "„To je nepřípustné!“ <w>hromoval</w> ředitel na poradě.",
                                "tr": "“Bu kabul edilemez!” diye toplantıda müdür <w>gürledi</w>.",
                                "es": "«¡Es inadmisible!», <w>tronó</w> el director en la reunión.",
                                "zh": "“这是不能容忍的！”经理在会议上<w>怒斥</w>道。"
                            }
                        }
