                "forms": [],
                "senses": [
                    {
                        "sense_id": "833b0972-ab0c-3ee5-a5ce-060498e2bc48",
                        "entry_id": "b5baed0d-5fa0-31ac-a07c-c3c035b4aaed",
                        "glosses": [
                            "Abréviation de médecine fondée sur des données probantes."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "dc58dfea-5d33-3825-a592-540beaa6da65",
                        "entry_id": "b5baed0d-5fa0-31ac-a07c-c3c035b4aaed",
                        "glosses": [
                            "Sigle d'un adjuvant vaccinal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4b886c6-b9e0-42c8-a08b-f72b089425b0",
                                "sense_id": "dc58dfea-5d33-3825-a592-540beaa6da65",
                                "text": "Les essais biologiques réalisés par notre équipe à Pasteur démontrèrent que cette molécule synthétique était plus active que le bacille entier et totalement débarrassée de ses effets secondaires. […]. Cet adjuvant, composé d'un sucre (l'acide muramique) et de deux acides aminés, fut baptisé MDP, le sigle de muramyl dipeptide, son nom chimique abrégé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7320e5f-a25a-4aca-82dd-e6f60a3fec10",
                        "source_entry_id": "b5baed0d-5fa0-31ac-a07c-c3c035b4aaed",
                        "target_lang_word": "evidence-based medicine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "evidence-based medicine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8fc51714-847a-3290-b04b-5c79c9bc84ce",
                                        "entry_id": "83119b9c-ec41-3b4f-8d38-a5197d481931",
                                        "glosses": [
                                            "Health care whose policies and practices are derived from the systematic, scientific study of the effectiveness of various treatments."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d93b3291-b0b5-4d14-85d8-7bcd998c9cec",
                                                "sense_id": "8fc51714-847a-3290-b04b-5c79c9bc84ce",
                                                "text": "In the last decade, the health care field has been under the spell of evidence-based medicine—a social movement aimed to strengthen the scientific base of health care and determine the effectiveness of clinical interventions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
