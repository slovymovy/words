                "senses": [
                    {
                        "sense_id": "acdc259d-8791-3f1c-8e62-648a9d70c406",
                        "entry_id": "8eaa1865-1041-3c90-aac7-a5790b6d04f1",
                        "glosses": [
                            "мн. ч. парные усики на голове насекомых, орган обоняния и осязания"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "82f8e35d-c9ac-41b7-9d86-42b92baee2b6",
                        "source_entry_id": "8eaa1865-1041-3c90-aac7-a5790b6d04f1",
                        "source_sense_id": "acdc259d-8791-3f1c-8e62-648a9d70c406",
                        "target_lang_word": "antenna",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antenna",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21cb8c31-908e-3dbc-a28a-0b6a2d32de6e",
                                        "entry_id": "66d3e881-ccfb-3026-8be1-ec16bd95d83a",
                                        "glosses": [
                                            "An appendage used for sensing on the head of an insect, crab, or other animal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d020c7e-329e-4ee8-85ff-7f3eeee96256",
                                                "sense_id": "21cb8c31-908e-3dbc-a28a-0b6a2d32de6e",
                                                "text": "The overall shape of most insect antennae is elongate and cylindrical, although elaborations into plumose, lamellate, or pectinate forms have arisen many times in different insect lineages."
                                            },
                                            {
                                                "example_id": "7d3f8b8c-0d0c-4b53-bae7-fc8c2cc35942",
                                                "sense_id": "21cb8c31-908e-3dbc-a28a-0b6a2d32de6e",
                                                "text": "He put his fingers over his head like two antennas, crossed his eyes, and waggled his tongue like some kind of insect.\nIn the same work, Brown uses antennae to refer to both aerials and feelers during more technical descriptions."
                                            },
                                            {
                                                "example_id": "3406a603-a7db-4f1a-ad33-a3c8561b8cfe",
                                                "sense_id": "21cb8c31-908e-3dbc-a28a-0b6a2d32de6e",
                                                "text": "The basis of these relationships lies in the olfactory chemoreceptors of insect antennas..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00a69c3c-1432-3735-9d1a-55a779cf1ade",
                                        "entry_id": "66d3e881-ccfb-3026-8be1-ec16bd95d83a",
                                        "glosses": [
                                            "An apparatus to receive or transmit electromagnetic waves and convert respectively to or from an electrical signal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b5b64bb1-196f-3887-940a-ecf87aff27e9",
                                        "entry_id": "66d3e881-ccfb-3026-8be1-ec16bd95d83a",
                                        "glosses": [
                                            "The faculty of intuitive astuteness."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de35c38f-01e6-4098-adb2-33d7ebb78e0b",
                                                "sense_id": "b5b64bb1-196f-3887-940a-ecf87aff27e9",
                                                "text": "Most nurses believe they are born with an antenna of sorts, which is able to guide them through clinical practice and help them determine what is right and what is not..."
                                            },
                                            {
                                                "example_id": "31dc1bf6-98bb-4b85-9284-756bb025e9ed",
                                                "sense_id": "b5b64bb1-196f-3887-940a-ecf87aff27e9",
                                                "text": "Obama is astute. He approaches things with the help of a sensitive antenna."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "beddd1c0-e94e-36a7-b466-a306bb4ca266",
                                        "entry_id": "66d3e881-ccfb-3026-8be1-ec16bd95d83a",
                                        "glosses": [
                                            "A fragment of an oligosaccharide"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2e0ec5f5-bffa-356c-9218-521fa102e7b4",
                                        "entry_id": "66d3e881-ccfb-3026-8be1-ec16bd95d83a",
                                        "glosses": [
                                            "The spar to which a lateen sail is attached, which is then hoisted up the mast."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
