                        "examples": [
                            {
                                "example_id": "201fa502-b55a-451c-937d-7d67eb87be75",
                                "sense_id": "bdca998e-a4cb-3a97-938b-fe79398a5b7c",
                                "text": "Ogromne znaczenie w popieraniu odrodzenia islamskiego ma fanatyzm wahabicki promowany przez Saudyjczyków."
                            }
