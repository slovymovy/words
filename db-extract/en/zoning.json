                        "target_lang_word": "Bebauungsplan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bebauungsplan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "45e39616-01ee-3306-9cef-a267fec8315e",
                                        "entry_id": "890ef950-5739-38e1-94f0-2691ea7e9880",
                                        "glosses": [
                                            "rechtsverbindliche Festlegung der Nutzung von Grundstücksflächen insbesondere in Hinsicht auf die Art und das Ausmaß der baulichen Nutzung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e96a6bf-a431-428d-ac78-4d882e66c681",
                                                "sense_id": "45e39616-01ee-3306-9cef-a267fec8315e",
                                                "text": "„Der Begriff Bebauungsplan … hat in Deutschland und Österreich ähnliche, aber nicht deckungsgleiche Bedeutungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1062e89b-7a3b-4718-a3fa-748f4d75863e",
                        "source_entry_id": "44fe38b6-6ae4-3903-b2f9-5030bb6a37b8",
                        "source_sense_description": "legal: regulation of property use and construction",
                        "target_lang_word": "Bauordnung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bauordnung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aa3f2974-e0c2-3eeb-8d48-ea6433c4ca4b",
                                        "entry_id": "fbb6d8cb-8a20-320f-a7ba-c82025c10bd3",
                                        "glosses": [
                                            "Rechtsvorschrift, in der alle Regeln für das Bauwesen einer Region festgelegt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52ae4353-c7c3-4074-92a3-72fefdea06b5",
                                                "sense_id": "aa3f2974-e0c2-3eeb-8d48-ea6433c4ca4b",
                                                "text": "„Nach § 58 der Niedersächsischen Bauordnung (NBauO) ist das Bauordnungsamt als untere Bauaufsichtsbehörde für das Einhalten des öffentlichen Baurechts hinsichtlich baulicher Anlagen, Grundstücke und Baumaßnahmen zuständig, soweit nicht ausdrücklich etwas anderes bestimmt ist.“"
                                            },
                                            {
                                                "example_id": "c03becba-2a36-4a44-817f-c52c61c1cd58",
                                                "sense_id": "aa3f2974-e0c2-3eeb-8d48-ea6433c4ca4b",
                                                "text": "„Das Baurecht hat sich in den letzten Jahren weiterentwickelt, was eine Anpassung der Bauordnung für Berlin hinsichtlich dieser Entwicklungen erforderlich macht.“"
                                            },
                                            {
                                                "example_id": "a73c0636-35c9-4fe7-b8eb-7ce1cff8fcb4",
                                                "sense_id": "aa3f2974-e0c2-3eeb-8d48-ea6433c4ca4b",
                                                "text": "„Das Bauordnungsamt ist für den Vollzug der Bauordnung sowie anderer öffentlich-rechtlicher Vorschriften für die Errichtung, die Änderung, die Instandhaltung die Nutzung oder die Beseitigung baulicher Anlagen sowie anderer Anlagen zuständig.“"
                                            },
                                            {
                                                "example_id": "2bdfc308-cc38-4559-938f-05aff55d71b8",
                                                "sense_id": "aa3f2974-e0c2-3eeb-8d48-ea6433c4ca4b",
                                                "text": "„Die Ziele des Kleingartenwesens werden durch das Bundeskleingartengesetz vom 28. Februar 1983 definiert und sind Grundlage der neuen Garten- und Bauordnung des Stadtverbandes.“"
                                            },
                                            {
                                                "example_id": "e33168ac-3afa-4f69-817a-74b6ad434a1a",
                                                "sense_id": "aa3f2974-e0c2-3eeb-8d48-ea6433c4ca4b",
                                                "text": "„Dabei prüft die Bauaufsicht, ob durch die Teilung Verhältnisse geschaffen würden, die nicht den Anforderungen der Bauordnung genügen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "85a145d8-d3f3-3ba9-8702-ae692b718b34",
                                        "entry_id": "fbb6d8cb-8a20-320f-a7ba-c82025c10bd3",
                                        "glosses": [
                                            "Amt, das [1] durchsetzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b32f8e9b-a046-461c-8ffe-5335543c89fa",
                                                "sense_id": "85a145d8-d3f3-3ba9-8702-ae692b718b34",
                                                "text": "„Dabei prüft die Bauaufsicht, ob durch die Teilung Verhältnisse geschaffen würden, die nicht den Anforderungen der Bauordnung genügen.“"
                                            },
                                            {
                                                "example_id": "e1bd7844-0970-4fa7-a0f0-ada242d8210a",
                                                "sense_id": "85a145d8-d3f3-3ba9-8702-ae692b718b34",
                                                "text": "„Neben der Bauberatung ist das Baugenehmigungsverfahren eine der Hauptaufgaben der Bauordnung.“"
                                            },
                                            {
                                                "example_id": "284d278a-d12c-4c12-ac3a-6e5a0a402061",
                                                "sense_id": "85a145d8-d3f3-3ba9-8702-ae692b718b34",
                                                "text": "„Der Bereich Baugenehmigung und Bauordnung ist zuständig für alle nach der Landesbauordnung genehmigungspflichtigen Bauvorhaben.“"
                                            },
                                            {
                                                "example_id": "9153574b-db6a-44c4-97b0-bfdf7b07dcf8",
                                                "sense_id": "85a145d8-d3f3-3ba9-8702-ae692b718b34",
                                                "text": "„Bei der Realisierung des Wunsches nach einem eigenen Haus sind Gesetze, Verordnungen, Erlasse, DIN-Vorschriften und technische Baubestimmungen zu beachten, für deren Einhaltung der Bereich Bauordnung zuständig ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
