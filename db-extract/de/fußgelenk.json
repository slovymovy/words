                                    }
                                ]
                            },
                            {
                                "target_word": "ankle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "38889dc6-dc09-3897-9d61-cc56bda3dc52",
                                        "entry_id": "5bc43059-9f96-363f-bf06-52ca0682975c",
                                        "glosses": [
                                            "To walk."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be84fcbb-c4e2-457c-803b-6767cf185fd0",
                                                "sense_id": "38889dc6-dc09-3897-9d61-cc56bda3dc52",
                                                "text": "Arvay’s tearful speech followed the usual pattern, and everybody said it was just fine. There had been nothing about the heathens of China, India and Africa wallowing around on the heavenly chairs, nor ankling up and down the golden streets."
                                            },
                                            {
                                                "example_id": "94fa361c-a450-4a27-942f-7cf23989982a",
                                                "sense_id": "38889dc6-dc09-3897-9d61-cc56bda3dc52",
                                                "text": "1951, Anthony Buckeridge, Jennings’ Little Hut, London: Collins, 1973, Chapter 15, p. 178,\nSupposing we all ankled over to the huts […]"
                                            },
                                            {
                                                "example_id": "cfde6769-31a9-4810-973d-9dc80bc7da43",
                                                "sense_id": "38889dc6-dc09-3897-9d61-cc56bda3dc52",
                                                "text": "1966, P. G. Wodehouse, Plum Pie, London: Everyman, 2007, Chapter 6, p. 158,\nHe ankled round, accordingly, to her house and his ring at the bell was answered by Wilberforce, her butler […]"
                                            },
                                            {
                                                "example_id": "8707edaa-c03f-46bf-8e81-d70440aa4db2",
                                                "sense_id": "38889dc6-dc09-3897-9d61-cc56bda3dc52",
                                                "text": "After a while he got up and ankled his way down the corridor and met Penny coming out of the toilet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62babd6f-1771-341b-888e-2b5799014630",
                                        "entry_id": "5bc43059-9f96-363f-bf06-52ca0682975c",
                                        "glosses": [
                                            "To cyclically angle the foot at the ankle while pedaling, to maximize the amount of work applied to the pedal during each revolution."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "00d6a0a4-d0af-434b-9df3-1c164d8a1604",
                        "source_entry_id": "b56f9888-6850-340c-8339-857be8daaa3c",
                        "source_sense_id": "1ca7befb-2bdf-3d71-b59a-37ab56f1cd96",
                        "source_sense_description": "Gelenk, das die Fuß- und Unterschenkelknochen verbindet",
                        "target_lang_word": "cheville",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cheville",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0e405a38-fcbd-3a7a-8b07-e583ec33a04b",
                                        "entry_id": "96f717ef-d08f-312f-8821-598eeef8d476",
                                        "glosses": [
                                            "Morceau de bois ou de métal qu’on fait entrer dans un trou pour le boucher, pour faire des assemblages ou pour d’autres usages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f447079-96ed-4cb7-80c7-803416111959",
                                                "sense_id": "0e405a38-fcbd-3a7a-8b07-e583ec33a04b",
                                                "text": "Quand on veut que la cheville fasse tirage, on perce d’abord la mortaise de part en part, le tenon n’y étant pas ; on met le tenon en place, on marque les trous, on retire le tenon, on perce les trous un peu plus haut qu’ils ne doivent l’être ; […]."
                                            },
                                            {
                                                "example_id": "1ea415b5-da96-48d3-94c0-2efa4f701c3c",
                                                "sense_id": "0e405a38-fcbd-3a7a-8b07-e583ec33a04b",
                                                "text": "Le plus rigolo, c’était les chariots des gens de ce pays-là. Pas un clou, pas un brin de fer ! les roues, les jantes, le timon, tout était en bois, attaché avec des chevilles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bd26cf3-4638-3a4e-8dbd-f990c30b9569",
                                        "entry_id": "96f717ef-d08f-312f-8821-598eeef8d476",
                                        "glosses": [
                                            "Définition manquante ou à compléter. (Ajouter)"
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "431c373a-4057-4891-b4f8-74333fe3cc8b",
                                                "sense_id": "0bd26cf3-4638-3a4e-8dbd-f990c30b9569",
                                                "text": "Il fallait que cette créature eût dans l’âme toutes les chevilles de l’amour ou du désespoir, car nous ne pouvions comprendre où elle prenait la force de n’être jamais abattue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "528bc43a-92e8-38af-a957-0174c1092c28",
                                        "entry_id": "96f717ef-d08f-312f-8821-598eeef8d476",
                                        "glosses": [
                                            "Unité de mesure du bois de charpente."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf31dda5-ce7a-43c8-962a-a2501f6ccda3",
                                                "sense_id": "528bc43a-92e8-38af-a957-0174c1092c28",
                                                "text": "La cheville, encore usitée aujourd’hui au Havre, fait la 144ᵉ partie du pied métrique cube ou la 300ᵉ de la marque, et vaut 12 pouces cubes métriques = 257 centimètres cubes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57fc50b8-9e73-30a2-acb1-d37e9f81decc",
                                        "entry_id": "96f717ef-d08f-312f-8821-598eeef8d476",
                                        "glosses": [
                                            "Pièce, souvent en plastique que l’on enfonce dans un mur avant de fixer une vis."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4aa540b7-643a-3fa4-8b47-3a9131104bca",
                                        "entry_id": "96f717ef-d08f-312f-8821-598eeef8d476",
                                        "glosses": [
                                            "Principal mobile, du principal agent d’une affaire."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "59afacfe-89d3-30f5-925f-55fd8beca6b1",
                                        "entry_id": "96f717ef-d08f-312f-8821-598eeef8d476",
                                        "glosses": [
                                            "Petit morceau de bois ou de métal qui, dans les instruments à cordes, servent à tendre ou à détendre les cordes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8343371-088e-4ada-bc41-35fc56fa8a8c",
                                                "sense_id": "59afacfe-89d3-30f5-925f-55fd8beca6b1",
                                                "text": "Il manque une cheville à ce violon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8ef0e4c-07a4-32fa-ae2e-cf27624dc59a",
                                        "entry_id": "96f717ef-d08f-312f-8821-598eeef8d476",
                                        "glosses": [
                                            "Articulation qui relie la jambe et le pied, formant une saillie osseuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "411fd7dc-716f-40bb-ae83-fabb0479e369",
                                                "sense_id": "a8ef0e4c-07a4-32fa-ae2e-cf27624dc59a",
                                                "text": "Dès le premier jour, les chevilles tuméfiées par la pression du fer se déchirèrent. Une plaie se forma, sanieuse, putride, entourée d'une auréole d’inflammation violente."
                                            },
                                            {
                                                "example_id": "d0629166-eefc-4611-9554-f74ca71b911a",
                                                "sense_id": "a8ef0e4c-07a4-32fa-ae2e-cf27624dc59a",
                                                "text": "Il pressentait que l’eau triompherait des semelles sans résistance, et, sournoisement, s’infiltrerait jusqu’aux chevilles."
                                            },
                                            {
                                                "example_id": "4dec6369-1475-4b68-88d7-07ed3a9ac609",
                                                "sense_id": "a8ef0e4c-07a4-32fa-ae2e-cf27624dc59a",
                                                "text": "Lo…, aidé d’un autre, m’attacha par les poignets et les chevilles avec des lanières de cuir fixées au bois."
                                            },
                                            {
                                                "example_id": "862b9a74-f41f-4a04-ab9b-57c5923be5ea",
                                                "sense_id": "a8ef0e4c-07a4-32fa-ae2e-cf27624dc59a",
                                                "text": "Sa silhouette montrait les contours d’une longue robe descendant jusqu’aux chevilles, une écharpe autour du cou et une épaisse tignasse tombant sur les épaules."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b6b7377-1b9b-3335-a768-41338303ab7a",
                                        "entry_id": "96f717ef-d08f-312f-8821-598eeef8d476",
                                        "glosses": [
                                            "Apophyse osseuse qui supporte les cornes chez les animaux."
                                        ],
                                        "tags": [
                                            "Médecine vétérinaire"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c5f7cd71-3fe1-3f88-bd72-4a9005a3fa60",
                                        "entry_id": "96f717ef-d08f-312f-8821-598eeef8d476",
                                        "glosses": [
                                            "Mots inutiles au vers que l’on rajoute pour obtenir le bon nombre de pieds ou la rime."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ccd7e08a-a2c1-478d-bc63-fe12f69a91c1",
                                                "sense_id": "c5f7cd71-3fe1-3f88-bd72-4a9005a3fa60",
                                                "text": "Vers les âpres couloirs marchent d’un pas égal\nCes héros au front pur en quête du Graal,\nMontagnes ! Regardez passer là vos vainqueurs\nTout (1) animés du feu d’une splendide ardeur…\n(1) C’est ce que nous autres appelons : une cheville."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74075f87-cf09-3bb1-b725-ee4fba8bedac",
                                        "entry_id": "96f717ef-d08f-312f-8821-598eeef8d476",
                                        "glosses": [
                                            "Petit mot inventé permettant au verbicruciste de finir sa grille de mots-croisés."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aea83f52-d679-3811-ad48-4186ecf113d1",
                                        "entry_id": "96f717ef-d08f-312f-8821-598eeef8d476",
                                        "glosses": [
                                            "Industrie, activité du chevillard."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c7c19923-a50e-37ac-b93f-2f3103fe32f4",
                                        "entry_id": "96f717ef-d08f-312f-8821-598eeef8d476",
                                        "glosses": [
                                            "Andouillers."
                                        ],
                                        "tags": [
                                            "dated",
                                            "plural"
                                        ],
                                        "examples": []
