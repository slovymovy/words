                "senses": [
                    {
                        "sense_id": "9d1172bc-a562-3f4b-8421-58b0893f248c",
                        "entry_id": "642ca45d-400d-333a-bd18-6c7edc40afb1",
                        "glosses": [
                            "van het verstand beroofd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a997b775-7842-4d32-b378-bbd6428fe69b",
                                "sense_id": "9d1172bc-a562-3f4b-8421-58b0893f248c",
                                "text": "Na een scheiding bewoont Rob Spithorst nu al vijftien jaar zijn 32 vierkante meter in de Joannes Reddingiusstraat\n('Grimmig waait de wond, ontzind\nschudt het kreunend loof der bomen')\nin de Dichtersbuurt."
                            },
                            {
                                "example_id": "c5339e7a-bb4e-4574-a3c6-1915763008d0",
                                "sense_id": "9d1172bc-a562-3f4b-8421-58b0893f248c",
                                "text": "‘Wil, wereld, mij ontzien mijn Musa, blind.\nZij droomt voorwoordelijk in gedachtekrocht\nwaar woord om woord mijn oordeel haar bevocht\ndie onbetwijfelbaar is maar ontzind.\n Hoe luid en onwelluidend uw geluid!\nOnhoorbaar, ongezien haar spraak van puur\ncerebrum in formules van azuur,\ndie het metrum van het bloed der mieren duldt.’"
                            }
                        ]
                    }
