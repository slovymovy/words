                    }
                ],
                "senses": [
                    {
                        "sense_id": "1d388988-c5f3-3a58-a453-79c8656383d0",
                        "entry_id": "620c511a-ba51-3da8-bf4c-84fe188ec4c1",
                        "glosses": [
                            "To bring to life; to enliven."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "74ab67b7-0078-42a4-b4ac-b34285bfaafc",
                                "sense_id": "1d388988-c5f3-3a58-a453-79c8656383d0",
                                "text": "She seemed molded from fire and air, and vivified at some Voltaic pile of August thunder-clouds heaped against the sunset."
                            },
                            {
                                "example_id": "7f6823e3-c52b-41c8-ba2f-4cc87bdaccca",
                                "sense_id": "1d388988-c5f3-3a58-a453-79c8656383d0",
                                "text": "[T]he sculptor lifted it [a round block of stone], turned it hither and thither in his hands, brushed off the clinging soil, and finally placed it on the slender neck of the newly discovered statue. The effect was magical. It immediately lighted up and vivified the whole figure, endowing it with personality, soul, and intelligence."
                            }
                        ]
                    },
                    {
                        "sense_id": "5fb49061-5182-3154-9c39-9ba358121e62",
                        "entry_id": "620c511a-ba51-3da8-bf4c-84fe188ec4c1",
                        "glosses": [
                            "To impart vitality to."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e99a834-a50a-490e-b8ff-2ba859bd32c7",
                        "source_entry_id": "620c511a-ba51-3da8-bf4c-84fe188ec4c1",
                        "source_sense_description": "to bring to life",
                        "target_lang_word": "vivifier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vivifier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d274771f-abfb-366a-ac13-3af86a6a5add",
                                        "entry_id": "391ebde3-b905-3f94-883f-83d49dae575d",
                                        "glosses": [
                                            "Donner la vie et la conserver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7aa05de-54de-4467-880c-49905dbe0802",
                                                "sense_id": "d274771f-abfb-366a-ac13-3af86a6a5add",
                                                "text": "C’est Dieu seul qui vivifie toutes choses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4538ea25-fb77-33d0-ba82-c2228141ff86",
                                        "entry_id": "391ebde3-b905-3f94-883f-83d49dae575d",
                                        "glosses": [
                                            "Donner de la vigueur, de la force."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd4766c7-90d9-435e-b4fb-36ec0b0d7dd9",
                                                "sense_id": "4538ea25-fb77-33d0-ba82-c2228141ff86",
                                                "text": "Le repos sans la prière qui vivifiait les monastères, sans la méditation qui peuplait les thébaïdes, devient une maladie, dit sentencieusement M. Joseph."
                                            },
                                            {
                                                "example_id": "fb02ea7c-83e4-49cb-8211-329cc16b8a21",
                                                "sense_id": "4538ea25-fb77-33d0-ba82-c2228141ff86",
                                                "text": "Pour accueillir le mois de septembre et sa cohorte de flâneurs bronzés, vivifiés par le repos et l’oisiveté estivaux, et déjà désireux de s’offrir un supplément d’évasion par une exposition, le musée Jaquemart-André (Paris 8ᵉ) a pris un parti audacieux : une rétrospective sur le peintre helvético-britannique Heinrich Füssli (1741-1825), l’ange noir du romantisme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1230b480-7400-3de0-b452-35176d22c6c5",
                                        "entry_id": "391ebde3-b905-3f94-883f-83d49dae575d",
                                        "glosses": [
                                            "Effets que Dieu produit dans l’âme par la grâce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "326bd18f-1a48-464d-b53f-5a43c8d436c2",
                                                "sense_id": "1230b480-7400-3de0-b452-35176d22c6c5",
                                                "text": "La grâce vivifie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82fcf85f-352b-356a-a331-8a99410adc58",
                                        "entry_id": "391ebde3-b905-3f94-883f-83d49dae575d",
                                        "glosses": [
                                            "…"
                                        ],
                                        "tags": [
                                            "Proverbial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4441c4f8-34c7-4cf7-8742-9e6c43bb7b2e",
                                                "sense_id": "82fcf85f-352b-356a-a331-8a99410adc58",
                                                "text": "La lettre tue et l’esprit vivifie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b2e1e1d-a33d-4c62-88d2-4cb590aa5d97",
