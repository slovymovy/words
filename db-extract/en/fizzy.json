                                "target_senses": [
                                    {
                                        "sense_id": "7f3b526f-c212-38eb-8cf6-155b9048e78f",
                                        "entry_id": "5e3a6956-f5d7-39d0-9f8c-055f864a2f9e",
                                        "glosses": [
                                            "fris en levendig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68665c35-14e0-42f3-b457-381b80280066",
                                                "sense_id": "7f3b526f-c212-38eb-8cf6-155b9048e78f",
                                                "text": "Van der Horst en Van Hanegem speelden ooit (in de jaren tachtig) samen bij AZ’67. Het verzoek om eens te komen kijken wat hem opvalt bij FC Den Bosch nu het elftal na een sprankelende eerste seizoenshelft veel stroever is gaan draaien, zei Van Hanegem zijn maatje niet te hebben kunnen weigeren."
                                            },
                                            {
                                                "example_id": "41bd9071-cf8a-4b25-aa1d-462eb8fe5d5e",
                                                "sense_id": "7f3b526f-c212-38eb-8cf6-155b9048e78f",
                                                "text": "Van Moll pioniert met een sprankelende saison (seizoensbier) die een tijdje heeft liggen kabbelen in vaten waarin eerder witte wijn wegdommelde. Een meesterzet, vindt het panel. Het frisse doch droge karakter van de druiven galmt feilloos door in de blonde dorstlesser."
                                            },
                                            {
                                                "example_id": "90f1a06c-c4b7-4df7-b9f2-6896d31c5ca4",
                                                "sense_id": "7f3b526f-c212-38eb-8cf6-155b9048e78f",
                                                "text": "'s Ochtends was ze sprankelend vrolijk, verzekerde hem dat hij de beste minnaar was die ze in haar hele leven was tegengekomen, hoewel dat er natuurlijk niet zoveel waren geweest, corrigeerde ze blozend en ze giechelde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
