                    {
                        "translation_id": "0a47ee53-4465-4ff0-9ccb-877638696786",
                        "source_entry_id": "5dcfd35a-fce2-3376-92df-42bd4c2dcf8b",
                        "source_sense_id": "26a86875-65bb-3514-9b8f-b0d895da3d2d",
                        "source_sense_description": "een land in het Midden-Oosten, officieel het Sultanaat Oman",
                        "target_lang_word": "Oman",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Oman",
