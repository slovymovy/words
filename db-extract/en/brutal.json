                                    },
                                    {
                                        "sense_id": "c0b4cbe3-6d02-3649-9803-64a7226df65d",
                                        "entry_id": "bdc25b16-9463-39e1-b4b2-2670fab51382",
                                        "glosses": [
                                            "rücksichtslos, übermäßig und unangebracht gewalttätig, verletzend und quälerisch"
                                        ],
                                        "tags": [
                                            "Handlungen",
                                            "Taten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6405bcc-5c51-4e56-b956-061e38a0fe0d",
                                                "sense_id": "c0b4cbe3-6d02-3649-9803-64a7226df65d",
                                                "text": "„Viele Szenen der aufgefundenen Drehbuchfassung zeigen das brutale Verhalten weißer Großgrundbesitzer Sklaven gegenüber, unter anderem Schläge und emotionale Gewalt.“"
                                            },
                                            {
                                                "example_id": "218544c1-17da-4c15-82a6-efeb6ad93a73",
                                                "sense_id": "c0b4cbe3-6d02-3649-9803-64a7226df65d",
                                                "text": "„Die schmale Allee wird nach zwei Kilometern von Stacheldraht und Betonklötzen brutal durchtrennt.“"
                                            },
                                            {
                                                "example_id": "50ba45e2-3674-4cdb-9d7d-10dda8d39a09",
                                                "sense_id": "c0b4cbe3-6d02-3649-9803-64a7226df65d",
                                                "text": "Der Aufstand wurde brutal niedergeworfen."
                                            },
                                            {
                                                "example_id": "847bcf67-5ddb-4996-a5d2-7ab56cb7b7ad",
                                                "sense_id": "c0b4cbe3-6d02-3649-9803-64a7226df65d",
                                                "text": "Er war bekannt für seine brutalen Methoden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
