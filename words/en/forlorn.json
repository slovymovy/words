{
    "word_family": [
        "forlornly",
        "forlornness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3ee8d317-8516-39ac-bb4e-69a8f95df6e0",
                    "sense_definition": "Pitifully sad, wretched, or lonely, often due to feeling abandoned or forsaken.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "sadness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>forlorn</w> child sat alone on the park bench waiting for her parents to return.",
                            "target_lang_translations": {
                                "tr": "<w>Kimsesiz</w> çocuk anne babasının dönmesini beklerken parktaki bankta tek başına oturuyordu."
                            }
                        },
                        {
                            "text": "He felt <w>forlorn</w> after his best friend moved to another country without saying goodbye.",
                            "target_lang_translations": {
                                "tr": "En iyi arkadaşı vedalaşmadan başka bir ülkeye taşındıktan sonra kendini <w>yapayalnız</w> hissetti."
                            }
                        }
                    ],
                    "synonyms": [
                        "miserable",
                        "sad",
                        "lonely",
                        "desolate",
                        "disconsolate"
                    ],
                    "antonyms": [
                        "cheerful",
                        "happy"
                    ],
                    "common_phrases": [
                        "forlorn look",
                        "forlorn figure"
                    ],
                    "target_lang_definitions": {
                        "tr": "Genellikle terk edilmiş veya kimsesiz kalmış hissetmekten kaynaklanan acınası derecede üzgün, perişan veya yalnız."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "kimsesiz",
                                "target_lang_sense_clarification": "yapayalnız ve sahipsiz hisseden"
                            },
                            {
                                "target_lang_word": "garip",
                                "target_lang_sense_clarification": "boynu bükük, yalnız ve kederli"
                            },
                            {
                                "target_lang_word": "çaresiz",
                                "target_lang_sense_clarification": "üzgün ve ne yapacağını bilemeyen"
                            },
                            {
                                "target_lang_word": "perişan",
                                "target_lang_sense_clarification": "acınası derecede üzgün ve harap"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "361d1feb-177d-3c42-90ab-9a0720720599",
                    "sense_definition": "Abandoned, deserted, or left behind in a neglected state.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "neglect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>forlorn</w> house stood empty at the end of the street for many years.",
                            "target_lang_translations": {
                                "tr": "<w>Metruk</w> ev, sokağın sonunda yıllarca boş durdu."
                            }
                        },
                        {
                            "text": "We walked past the <w>forlorn</w> garden, which was completely overgrown with weeds and thorns.",
                            "target_lang_translations": {
                                "tr": "Tamamen yabani otlar ve dikenlerle kaplanmış <w>kendi haline terk edilmiş</w> bahçenin yanından geçtik."
                            }
                        }
                    ],
                    "synonyms": [
                        "abandoned",
                        "deserted",
                        "neglected"
                    ],
                    "antonyms": [
                        "occupied",
                        "cared-for"
                    ],
                    "common_phrases": [
                        "forlorn building",
                        "forlorn place"
                    ],
                    "target_lang_definitions": {
                        "tr": "Terk edilmiş, ıssız veya bakımsız bir durumda bırakılmış (yer veya nesne)."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "terk edilmiş",
                                "target_lang_sense_clarification": "kendi haline bırakılmış, ıssız"
                            },
                            {
                                "target_lang_word": "ıssız",
                                "target_lang_sense_clarification": "kimsenin yaşamadığı veya uğramadığı"
                            },
                            {
                                "target_lang_word": "metruk",
                                "target_lang_sense_clarification": "bakımsız ve terkedilmiş binalar için"
                            },
                            {
                                "target_lang_word": "virane",
                                "target_lang_sense_clarification": "harap ve ıssız kalmış yer"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "154b922a-de9b-369a-b9ea-c0ddb60160cc",
                    "sense_definition": "Unlikely to succeed or achieve a desired outcome; hopeless.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "hopelessness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Searching for the lost keys in the dark forest was a <w>forlorn</w> hope.",
                            "target_lang_translations": {
                                "tr": "Karanlık ormanda kayıp anahtarları aramak <w>boş</w> bir umuttu."
                            }
                        },
                        {
                            "text": "The team made a <w>forlorn</w> attempt to win the game in the final seconds.",
                            "target_lang_translations": {
                                "tr": "Takım son saniyelerde maçı kazanmak için <w>nafile</w> bir girişimde bulundu."
                            }
                        }
                    ],
                    "synonyms": [
                        "hopeless",
                        "futile",
                        "vain"
                    ],
                    "antonyms": [
                        "promising",
                        "hopeful"
                    ],
                    "common_phrases": [
                        "forlorn hope",
                        "forlorn attempt"
                    ],
                    "target_lang_definitions": {
                        "tr": "Başarıya ulaşma veya istenen sonucu verme ihtimali çok düşük olan; beyhude, umutsuz."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "umutsuz",
                                "target_lang_sense_clarification": "sonuç vermesi imkânsız veya beklenmeyen"
                            },
                            {
                                "target_lang_word": "boş",
                                "target_lang_sense_clarification": "beyhude ve nafile"
                            },
                            {
                                "target_lang_word": "nafile",
                                "target_lang_sense_clarification": "başarısızlığa mahkûm girişim veya çaba"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5cb6efa1-985e-3460-8352-0963a7af2d18",
                    "sense_definition": "A group of soldiers or individuals sent on a dangerous or desperate mission.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>forlorns</w> were the first to charge toward the enemy fortifications.",
                            "target_lang_translations": {
                                "tr": "Düşman tahkimatlarına doğru ilk hücum edenler <w>serdengeçtiler</w> oldu."
                            }
                        },
                        {
                            "text": "History books describe how the <w>forlorns</w> faced almost certain death during the siege.",
                            "target_lang_translations": {
                                "tr": "Tarih kitapları, kuşatma sırasında <w>fedai birliklerinin</w> neredeyse kesin bir ölümle nasıl yüzleştiklerini anlatır."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used primarily in historical military contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Çok tehlikeli veya intihar niteliğindeki bir göreve gönderilen asker veya kişi grubu; serdengeçtiler."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "serdengeçti",
                                "target_lang_sense_clarification": "canını tehlikeye atarak ön saflarda savaşan fedai asker"
                            },
                            {
                                "target_lang_word": "fedai kıtası",
                                "target_lang_sense_clarification": "intihar niteliğinde öncü göreve gönderilen asker grubu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}