                                "target_senses": [
                                    {
                                        "sense_id": "702105d7-3a61-34e3-a10a-e7e9c9992b96",
                                        "entry_id": "02ccb870-0b9a-3a91-b31c-09bc05151fed",
                                        "glosses": [
                                            "Unsteady, random; prone to unexpected changes; not consistent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0939f58e-e2cc-400d-bf01-4561a6cd6d26",
                                                "sense_id": "702105d7-3a61-34e3-a10a-e7e9c9992b96",
                                                "text": "Henry has been getting erratic scores on his tests: 40% last week, but 98% this week."
                                            },
                                            {
                                                "example_id": "319dbae5-e13d-41ec-a0a6-43b0d397f1d8",
                                                "sense_id": "702105d7-3a61-34e3-a10a-e7e9c9992b96",
                                                "text": "The V-2's directional system was notoriously erratic. In May 1947, a V-2 launched from White Sands Proving Ground headed south instead of north, missing downtown Juarez, Mexico, by 3 miles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e712705-6764-39b3-b0b1-8a4e436d810c",
                                        "entry_id": "02ccb870-0b9a-3a91-b31c-09bc05151fed",
                                        "glosses": [
                                            "Deviating from normal opinions or actions; eccentric; odd."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2064979-5bb1-4765-a5a7-0635da25c8f7",
                                                "sense_id": "0e712705-6764-39b3-b0b1-8a4e436d810c",
                                                "text": "erratic conduct"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "erratic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d21c48c9-67df-3891-9763-d7cb84e3087c",
                                        "entry_id": "7fa35eac-a56a-3a2a-b99c-0c568dbf2bdf",
                                        "glosses": [
                                            "A rock moved from one location to another, usually by a glacier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "504cdee8-2b51-4567-8c67-f43efa4e6dfd",
                                                "sense_id": "d21c48c9-67df-3891-9763-d7cb84e3087c",
                                                "text": "The term for a displaced boulder is an erratic, but in the nineteenth century the expression seemed to apply more often to the theories than to the rocks."
                                            },
                                            {
                                                "example_id": "6a4d60a8-31e0-4e3f-8025-04eb577db482",
                                                "sense_id": "d21c48c9-67df-3891-9763-d7cb84e3087c",
                                                "text": "During the last ice-age, massive stones were carried for miles by the scouring glaciers, only to be left, like passengers at the end of the line, when the glaciers retreated. Stranded in their new surroundings with rocks with which they share no common geology, their out-of-place-ness is evoked by their name: “erratics”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4e732f7-ba71-3732-abd1-5409ff6e5fae",
                                        "entry_id": "7fa35eac-a56a-3a2a-b99c-0c568dbf2bdf",
                                        "glosses": [
                                            "Anything that has erratic characteristics."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "655b351e-29b0-433d-8517-b55ea7019775",
                        "source_entry_id": "c7218122-551b-37c7-a74b-53af358339ef",
                        "target_lang_word": "errático",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "errático",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "7f7a70a3-0e6d-33f3-8a38-189dccd10f09",
                                        "entry_id": "8ab50a28-a6ac-3a6f-9043-14682478bf0b",
                                        "glosses": [
                                            "Que varía de sitio."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ef2308d-1f7d-4090-8932-b90c3cb22e63",
                                                "sense_id": "7f7a70a3-0e6d-33f3-8a38-189dccd10f09",
                                                "text": "Como acontece a todos los caminantes cuando ven que termina su carrera el astro del día, nosotros recogimos en aquel momento nuestra imaginación, apartándola de erráticos devaneos, de antisociales correrías por el tiempo y el espacio y de aventureras excursiones por las soledades del campo, del mar y del firmamento, para fijarla en el mundo social, en el tiempo presente, en el objeto de nuestro viaje, en la expectativa del lugar en que íbamos a hacer noche."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bbbe491f-3efc-3e66-b433-c09e28c123aa",
                                        "entry_id": "8ab50a28-a6ac-3a6f-9043-14682478bf0b",
                                        "glosses": [
                                            "Dicho de un síntoma, que no tiene localización o periodicidad fija."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84faba6b-1626-45e3-b637-1773669f9333",
                                                "sense_id": "bbbe491f-3efc-3e66-b433-c09e28c123aa",
                                                "text": "los escalofríos vagos y erráticos varían de sitio con la mayor facilidad y producen en el enfermo la sensacion de un chorro de agua fría que le echasen por el dorso y pecho."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "51618a35-5587-3ec3-aee9-e08b4be5daec",
                                        "entry_id": "8ab50a28-a6ac-3a6f-9043-14682478bf0b",
                                        "glosses": [
                                            "Inconstante o irregular en sus hábitos y formas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdb6ccce-87e1-4b94-bf15-4f19eaded719",
                                                "sense_id": "51618a35-5587-3ec3-aee9-e08b4be5daec",
                                                "text": "En el alma de Charito se avivaron. con la prosperidad, todas las pasiones y todos los resabios: se avivó el cariño, se agravó la ligereza de cascos, cobró fuerza la imaginación errática y dislocada como una cabra montaraz, y tomaron cuerpo los proyectos locos, inverosímiles y novelescos que habían sido el principal pasto de su fantasía en los tiempos de la decadencia."
                                            },
                                            {
                                                "example_id": "8041bdc5-7b40-4228-93b0-d8491f51c995",
                                                "sense_id": "51618a35-5587-3ec3-aee9-e08b4be5daec",
                                                "text": "Los despachos de este último le divertían tanto por su espíritu burlón bajo el que se disimulaba una finura de intención cuidadosamente dosificada, como por lo errático de su mecanografía."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
