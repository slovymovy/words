                "senses": [
                    {
                        "sense_id": "62a9a670-2943-30e8-833d-e23009e703e1",
                        "entry_id": "27a819fe-786e-3a29-9b45-a590dfd919a1",
                        "glosses": [
                            "ворчание, брюзжание"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2f84e5a-5c5d-48a9-961e-12dd61150619",
                                "sense_id": "62a9a670-2943-30e8-833d-e23009e703e1",
                                "text": "Раньше не обращал внимания — некогда было, теперь вот сижу да поглядываю, да бабушкину воркотню слушаю."
                            }
                        ]
                    },
                    {
                        "sense_id": "b2d796e8-f5e4-3740-baf0-f6ae97e62b48",
                        "entry_id": "27a819fe-786e-3a29-9b45-a590dfd919a1",
                        "glosses": [
                            "переливчатые звуки, издаваемые голубями; воркование"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dabf7eb6-dcd8-47c7-9dfe-7be6c941852b",
                                "sense_id": "b2d796e8-f5e4-3740-baf0-f6ae97e62b48",
                                "text": "Чуть окрасится небо полоской огня // И сквозь стекла рассвет забелеет, — // Воркотнёю своей они [голуби] будят меня: // Посмотри, мол, как зорька алеет. И. С. Никитин Первый гром прогремел..."
                            }
                        ]
                    }
