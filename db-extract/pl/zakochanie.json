                                        "sense_id": "2f11b021-4d30-3bad-a783-98453f40ee93",
                                        "entry_id": "0073a0fe-5303-32ec-96a9-d21fae4af721",
                                        "glosses": [
                                            "A group or gang."
                                        ],
                                        "tags": [
