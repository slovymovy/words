                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "787e8dfc-8b3c-44a1-ba6d-752137ac1909",
                                                "sense_id": "8a865fd1-ff51-33f7-80f2-48853d7438b1",
                                                "text": "John Johnson wrote this term paper and the editor was Joan Johnson."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ed172b4-eb18-337a-ad6b-00e38c8f72be",
