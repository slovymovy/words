                                        "entry_id": "abd7b2fa-69c7-3d51-967c-87b7155915b6",
                                        "glosses": [
                                            "The quality of being hoarse, of having a dry harsh voice."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73f150e0-ea0f-401f-bf84-c8da05f55f3a",
                                                "sense_id": "8c71ecb9-7e56-34f2-b24b-2d6e5a57ca9c",
                                                "text": "The hoarseness of her voice was caused by years of smoking."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e292102d-0cfd-4878-adaa-bc8624a1c547",
                        "source_entry_id": "a4029e5d-5ca5-3352-a80d-a3ef0a973a17",
