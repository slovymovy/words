    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "754163cb-92c4-33f0-a859-69c68ef0cc35",
                    "sense_definition": "iets of iemand zichtbaar maken door middel van een tekening, schilderij, foto of andere kunstvorm",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "visuele weergave",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Op dit oude schilderij staan meerdere historische verhalen <w>afgebeeld</w>.",
                            "target_lang_translations": {
                                "en": "Several historical stories are <w>depicted</w> in this old painting."
                            }
                        },
                        {
                            "text": "De kunstenaar probeerde de emotie van het model zo realistisch mogelijk <w>af</w> te <w>beelden</w>.",
                            "target_lang_translations": {
                                "en": "The artist tried to <w>portray</w> the model's emotion as realistically as possible."
                            }
                        },
                        {
                            "text": "Op de Nederlandse euromunten staat het staatshoofd duidelijk <w>afgebeeld</w>.",
                            "target_lang_translations": {
                                "en": "The head of state is clearly <w>shown</w> on the Dutch euro coins."
                            }
                        }
                    ],
                    "synonyms": [
                        "portretteren",
                        "weergeven",
                        "uitbeelden",
                        "schilderen"
                    ],
                    "common_phrases": [
                        "realistisch afbeelden",
                        "duidelijk afgebeeld",
                        "grafisch afbeelden"
                    ],
                    "target_lang_definitions": {
                        "en": "to make something or someone visible by means of a drawing, painting, photograph, or other art form"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "depict",
                                "target_lang_sense_clarification": "to represent in a work of art"
                            },
                            {
                                "target_lang_word": "portray",
                                "target_lang_sense_clarification": "to create a likeness of someone or something"
                            },
                            {
                                "target_lang_word": "show",
                                "target_lang_sense_clarification": "to be visible in an image"
                            },
                            {
                                "target_lang_word": "picture",
                                "target_lang_sense_clarification": "to represent in a picture"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14b46475-5757-30a7-ad43-242e9547e225",
                    "sense_definition": "een visuele of figuurlijke gelijkenis maken om iets te verduidelijken, zoals in een diagram of schema",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "visuele weergave",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit complexe diagram is niet erg duidelijk <w>afgebeeld</w> in het tekstboek.",
                            "target_lang_translations": {
                                "en": "This complex diagram is not <w>represented</w> very clearly in the textbook."
                            }
                        },
                        {
                            "text": "De statistieken worden in deze grafiek op een overzichtelijke manier <w>afgebeeld</w>.",
                            "target_lang_translations": {
                                "en": "The statistics are <w>displayed</w> in a clear manner in this graph."
                            }
                        }
                    ],
                    "synonyms": [
                        "visualiseren",
                        "representeren",
                        "tonen"
                    ],
                    "common_phrases": [
                        "schematisch afbeelden"
                    ],
                    "target_lang_definitions": {
                        "en": "to create a visual or figurative likeness to clarify something, such as in a diagram or chart"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "represent",
                                "target_lang_sense_clarification": "to serve as a sign or symbol of"
                            },
                            {
                                "target_lang_word": "visualize",
                                "target_lang_sense_clarification": "to make something visible in a diagram"
                            },
                            {
                                "target_lang_word": "display",
                                "target_lang_sense_clarification": "to show data or information visually"
                            },
                            {
                                "target_lang_word": "illustrate",
                                "target_lang_sense_clarification": "to clarify using a visual aid"
                            }
                        ]
                    }
                }
            ]
        }
    ]
