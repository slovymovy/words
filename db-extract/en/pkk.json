    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "5ed3b254-7e4c-3b1b-a6a3-539047773be8",
                "word": "PKK",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3fd426c9-268c-32f8-8cd7-9ab190711afc",
                        "entry_id": "5ed3b254-7e4c-3b1b-a6a3-539047773be8",
                        "glosses": [
                            "Kurdistan Workers' Party."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c1b07db-30d4-47e6-a840-a4b9d67fb96f",
                                "sense_id": "3fd426c9-268c-32f8-8cd7-9ab190711afc",
                                "text": "‘Turkey is fighting with Kurdish people. PKK. The first day I came, some of their soldiers died.’"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b20766b2-b51d-4111-a813-5f0b623aca97",
                        "source_entry_id": "5ed3b254-7e4c-3b1b-a6a3-539047773be8",
                        "source_sense_id": "3fd426c9-268c-32f8-8cd7-9ab190711afc",
                        "source_sense_description": "Kurdistan Workers Party",
                        "target_lang_word": "PKK",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "PKK",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b724d49b-72cc-3689-a05c-47d1ebf5434a",
                                        "entry_id": "596eff18-26cd-319e-97d0-4a6e7bf1c86c",
                                        "glosses": [
                                            "Arbeiterpartei Kurdistans"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71df6a81-7f2b-4eda-a7ec-2bf0efc91c27",
                                                "sense_id": "b724d49b-72cc-3689-a05c-47d1ebf5434a",
                                                "text": "„Nach jüngst erschienenen Berichten in deutschen Medien soll die Türkei Giftgas gegen Kämpfer der kurdischen PKK eingesetzt haben.“"
                                            },
                                            {
                                                "example_id": "1d2f583b-2699-4d4b-936e-608de2453ee2",
                                                "sense_id": "b724d49b-72cc-3689-a05c-47d1ebf5434a",
                                                "text": "Jelpke setzt sich seit längerer Zeit dafür ein, dass die PKK in Deutschland nicht länger als kriminelle Organisation gilt."
                                            },
                                            {
                                                "example_id": "46a93dcd-d243-448c-b54d-be4a8f29916e",
                                                "sense_id": "b724d49b-72cc-3689-a05c-47d1ebf5434a",
                                                "text": "Die Türkei flog am 25. und 26. Dezember neue Angriffe auf die Stellungen der in der Türkei verbotenen und auch in den Vereinigten Staaten und der Europäischen Union als Terrororganisation angesehenen PKK (Arbeiterpartei Kurdistans)."
                                            },
                                            {
                                                "example_id": "17302f6c-2411-46ac-b4cd-c34daea8151b",
                                                "sense_id": "b724d49b-72cc-3689-a05c-47d1ebf5434a",
                                                "text": "„Ausdrücklich habe sich der BGH damit auseinandergesetzt, dass für die Straftaten, nämlich Mord und Totschlag, auf welche die Tätigkeit der PKK und ihrer Unterorganisationen gerichtet ist, kein Selbstverteidigungsrecht und kein völkerrechtlicher Rechtfertigungsgrund besteht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bb008556-26b0-3526-8a17-65a26de0302c",
                                        "entry_id": "596eff18-26cd-319e-97d0-4a6e7bf1c86c",
                                        "glosses": [
                                            "Parteikontrollkommission"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7a926ab-a771-4088-b274-9c6073a03635",
                                                "sense_id": "bb008556-26b0-3526-8a17-65a26de0302c",
                                                "text": "„Eine 1948 neu gebildete Parteikontrollkommission (PKK) übernahm die Funktionen eines innerparteilichen Repressionsorgans.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4902d60b-402f-3e6c-a8f4-89fa8a1a548c",
                                        "entry_id": "596eff18-26cd-319e-97d0-4a6e7bf1c86c",
                                        "glosses": [
                                            "Parlamentarische Kontrollkommission der Landtage Brandenburg, Hessen, Mecklenburg-Vorpommern, Rheinland-Pfalz, Sachsen, Sachsen-Anhalt und der Bremischen Bürgerschaft; wird medial auch für den Landtag Thüringens verwendet"
                                        ],
                                        "tags": [
                                            "Landesebene",
                                            "spez.",
                                            "Fachbegriff"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9388af39-351c-44e4-952d-5ee1ea6b614e",
                                                "sense_id": "4902d60b-402f-3e6c-a8f4-89fa8a1a548c",
                                                "text": "„Die Sammlung und vorübergehende Speicherung von Daten über AfD-Abgeordnete durch den sächsischen Verfassungsschutz war nach Ansicht der Parlamentarischen Kontrollkommission (PKK) rechtens.“"
                                            },
                                            {
                                                "example_id": "c4278ca1-365f-4e89-a1d2-a19dd6ef5282",
                                                "sense_id": "4902d60b-402f-3e6c-a8f4-89fa8a1a548c",
                                                "text": "„Auch die Wahl eines Linke-Kandidaten in die Parlamentarische Kontrollkommission (PKK) des Thüringer Landtages zur Kontrolle des Verfassungsschutzes scheiterte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
