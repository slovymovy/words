                "forms": [],
                "senses": [
                    {
                        "sense_id": "6ab30f39-6e7c-3dad-9acf-fad4bb5fa3b0",
                        "entry_id": "363f6b68-cde9-3d0a-8ae9-b1e62ee52ba2",
                        "glosses": [
                            "grecki filozof"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c173458-c80e-4bff-b60c-19f261b581d2",
                                "sense_id": "6ab30f39-6e7c-3dad-9acf-fad4bb5fa3b0",
                                "text": "Platon, który chciał ustanowić idealne państwo rządzone przez filozofów, uregulował wszystko – jak każdy totalitarysta – niezmiernie dokładnie"
                            }
                        ],
