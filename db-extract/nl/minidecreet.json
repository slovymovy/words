                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41eb3fd5-1e82-49b1-b070-5e975a00094d",
                                "sense_id": "25b620a9-e41a-3e01-a5ca-b93b31732ddd",
                                "text": "Vanmorgen kwam de commissie Media van het Vlaams Parlement in spoedzitting bijeen. CD&V'er Eric van Rompuy vond de beslissing over de benoeming van de VRT-top strijdig met het minidecreet van '96."
                            },
                            {
                                "example_id": "f19f4470-189a-4631-83cd-31aed4919401",
                                "sense_id": "25b620a9-e41a-3e01-a5ca-b93b31732ddd",
                                "text": "Het feit dat Vandenbroucke de coalitiepartners passeerde bij de totstandkoming van het decreet leidde er uiteindelijk toe dat het werd uitgesteld. Het minidecreet dat er vervolgens kwam, krijgt ook een onvoldoende."
                            },
                            {
                                "example_id": "b518eff2-6a60-4c85-a2c7-23f750a290b4",
                                "sense_id": "25b620a9-e41a-3e01-a5ca-b93b31732ddd",
                                "text": "Zo werd hij directeur-generaal van de toenmalige BRT Radio, directeur van de toenmalige Wereldomroep en daarna algemeen directeur Televisie tot hij in 1999 door het Minidecreet gedwongen werd om met pensioen te gaan."
                            }
                        ]
                    }
