                    }
                ],
                "translations": [
                    {
                        "translation_id": "f29722f6-b19b-402c-ba6b-46d2c9663760",
                        "source_entry_id": "5e65ff8a-f1a6-3b17-a9d0-6e5b8baeaa04",
                        "source_sense_id": "138fb63a-8f16-3105-a70e-b8ce6afea620",
                        "target_lang_word": "hydrometer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hydrometer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ec98f93-b0a3-3c8b-87a6-f7d706505ba9",
                                        "entry_id": "b42882dd-71e4-3d90-a61e-98d6fd68b26b",
                                        "glosses": [
                                            "An instrument that floats in a liquid and measures its specific gravity on a scale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6272e1f-7ddd-4bbe-b10d-512f6279aae4",
                                                "sense_id": "0ec98f93-b0a3-3c8b-87a6-f7d706505ba9",
                                                "text": "[E]ach degree of the hydrometer, when at or near proof, is about a quart in a hundred gallons stronger or weaker, as the hydrometer vibrates under or over the silver speck or sight on the index or upper stem; at the intermediate or strong overproofs, is about a pint in ditto; and at the low underproofs is about three pints in ditto."
                                            },
                                            {
                                                "example_id": "14acc4b5-6ec1-4c20-a4aa-55cee6f77957",
                                                "sense_id": "0ec98f93-b0a3-3c8b-87a6-f7d706505ba9",
                                                "text": "On the wall were hanging thermometers, barometers, and hydrometers, and every other sort of ometer, numberless, dusty, and mysterious; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a76e4c4-c0f1-467a-8ebe-67dcab2a57ea",
                        "source_entry_id": "5e65ff8a-f1a6-3b17-a9d0-6e5b8baeaa04",
                        "source_sense_id": "138fb63a-8f16-3105-a70e-b8ce6afea620",
                        "target_lang_word": "hydromètre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hydromètre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "68874e00-af2e-3022-b4d4-e9ad6e0f82da",
                                        "entry_id": "aa351f0c-97d9-3389-ac33-5de8922ae834",
                                        "glosses": [
                                            "Instrument qui sert à mesurer la pesanteur, la densité, la vitesse, la force, etc., des liquides."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fad6714f-8f61-4572-90e3-933fb638d370",
                                                "sense_id": "68874e00-af2e-3022-b4d4-e9ad6e0f82da",
                                                "text": "Un pluviomètre, un hygromètre, un densimètre ou encore une échelle hydrométrique utilisée pour suivre la variation du niveau d’un cours d’eau, sont des hydromètres."
                                            },
                                            {
                                                "example_id": "c0fd3b3c-2323-47ed-bc99-3f1de9915b62",
                                                "sense_id": "68874e00-af2e-3022-b4d4-e9ad6e0f82da",
                                                "text": "En haut de l’escalier du ponte Cavour, on voit encore les vestiges d’un hydromètre en marbre. C’est lui qui a enregistré le record de décembre 1870, plus de 17 mètres […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a45075fa-55f4-39ee-b4ca-be26ea314bc7",
                                        "entry_id": "aa351f0c-97d9-3389-ac33-5de8922ae834",
                                        "glosses": [
                                            "Instrument propre à mesurer l’épaisseur de la couche d’eau qui tombe chaque année sur la surface de la terre en un lieu donné."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d6dbd586-58e5-3d5c-ab19-f0f6df2e38f0",
                                        "entry_id": "aa351f0c-97d9-3389-ac33-5de8922ae834",
                                        "glosses": [
                                            "Échelle qui mesure la hauteur d'un cours d’eau."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7107fe1a-8f00-48fb-a0d1-73e61bf7dc14",
                                                "sense_id": "d6dbd586-58e5-3d5c-ab19-f0f6df2e38f0",
                                                "text": "Sur des fleuves très-importants, comme le Nil et le Rhône, l’hydromètre perd son nom générique pour emprunter celui du fleuve, et l'on dit alors nilomètre, rhonomètre, etc."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hydromètre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "77fafa28-d073-3895-94c3-460ca66c2442",
                                        "entry_id": "e80ad02a-ea9d-3b8d-b0c1-0dcc6e4d7d98",
                                        "glosses": [
                                            "Punaise de la famille des hydrométridés vivant en bordure de l’eau et s’aventurant parfois à la surface de celle-ci."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "461e6935-3f50-47e1-b230-3475c32b3197",
                                                "sense_id": "77fafa28-d073-3895-94c3-460ca66c2442",
                                                "text": "Des Hydromètres couraient sur la surface frémissante, couleur du ciel. Justin admira leur agilité et se demanda comment ces insectes pouvaient ainsi cheminer sur l’eau du bout des pattes. Il se rappela les mouches de l’école, qui marchaient le long des vitres de verre poli et reconnut qu’il y avait de vraiment curieuses bêtes dans la création."
                                            },
                                            {
                                                "example_id": "141d92d9-4f29-424c-b3dc-1b2ed51b9ee2",
                                                "sense_id": "77fafa28-d073-3895-94c3-460ca66c2442",
                                                "text": "Des hygromètres ^([sic]), plus simplement appelés « chèvres », glissaient prestement à la surface, par longs élans rectilignes ou roidement brisés en zigzags prudents ; et l'ombre de leurs pattes, dans le soleil, projetaient sur le fond de la source des espèces de petites feuilles de trèfle frémissantes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hydromètre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "34a840d5-b453-3f42-92f0-d57dd22959a8",
                                        "entry_id": "1ed9b1e6-527d-3580-8cdd-69f92e7da1ea",
