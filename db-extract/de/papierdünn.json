                ],
                "senses": [
                    {
                        "sense_id": "18cafbae-7269-3223-8c49-07e61990277a",
                        "entry_id": "f3c2dd14-09e8-315e-a808-c584ae48ef2d",
                        "glosses": [
                            "extrem dünn, so dünn wie ein Blatt Papier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a2c6fa6-b709-465e-b7c5-35e87cd57731",
                                "sense_id": "18cafbae-7269-3223-8c49-07e61990277a",
                                "text": "„Vor einem Himmel wie durchsichtige, papierdünne Jade zeichneten sich in sämtlichen Einzelheiten die Bäume ab.“"
                            },
                            {
                                "example_id": "18042392-d781-498e-bcf1-06e6a0b89cc3",
                                "sense_id": "18cafbae-7269-3223-8c49-07e61990277a",
                                "text": "„Unter der papierdünnen Haut ihres Gesichtes zeichneten sich die Knochen ab.“"
                            },
                            {
                                "example_id": "ba3e56b7-90f1-4d9a-9b7c-5a4f4ec0934e",
                                "sense_id": "18cafbae-7269-3223-8c49-07e61990277a",
                                "text": "„Im langsamen Dämmer bewegen sich Gestalten vor der sinkenden Sonne am papierdünnen Horizont entlang.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
