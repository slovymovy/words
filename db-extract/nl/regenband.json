                        "glosses": [
                            "een band met een profiel dat geschikt is om te rijden op een natte weg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9e12258-4689-459e-834d-e896c226fce1",
                                "sense_id": "8c0dd07c-15fc-3506-b2c5-46310e31616a",
                                "text": "Livio Loi verraste met zijn zege in de Moto3. Kort voor de race regende het en anders dan de meeste coureurs koos de Belg (RW Racing, Honda) niet voor regenbanden, maar voor slicks. En die keuze pakte goed uit. De Brit Danny Kent (Leopard Racing, Honda) werd 21ste, maar blijft leiden in het klassement."
                            },
                            {
                                "example_id": "fff43b6c-8740-4325-948e-861596f6d054",
                                "sense_id": "8c0dd07c-15fc-3506-b2c5-46310e31616a",
                                "text": "De wagens stonden op intermediates, maar al snel moesten de regenbanden omgelegd worden. Aquaplaning lag desondanks op de loer en na negen ronden besloot de jury de race stil te leggen en de bui uit te zitten. Na 52 minuten volgde eindelijk een herstart achter de safetycar."
                            }
                        ]
                    }
