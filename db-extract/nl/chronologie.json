                                        "sense_id": "d6989365-e093-323e-a0f7-7f31c7c6cb24",
                                        "entry_id": "9da85bdd-a36f-3483-8a62-9b41fa51a070",
                                        "glosses": [
                                            "An arrangement of events into chronological order; called a timeline when involving graphical elements."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66fba347-1401-457e-bf5a-33fab5bf6ee7",
                                                "sense_id": "d6989365-e093-323e-a0f7-7f31c7c6cb24",
                                                "text": "The film's chronology is not entirely obvious, but can be worked out by the clothes the characters are wearing in the scenes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4cf851f9-a77c-41e0-9728-7f09b55feccf",
                        "source_entry_id": "e19ec6e5-6160-3f5a-adc5-45ee1c1c1348",
                        "source_sense_id": "62f239ca-cb38-3040-a2e9-a2c94a42ac0e",
                        "source_sense_description": "de wetenschap die zich bezig houdt met het rangschikken in de tijd van historische gebeurtenissen",
                        "target_lang_word": "chronologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chronologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "12b7a586-e4f1-3c63-b7a4-9f8f6ab2179b",
                                        "entry_id": "7c56cf5e-34f9-31be-9e66-54208e2dadc1",
                                        "glosses": [
                                            "Science des temps ; connaissance des époques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95e1748a-0f52-4fc3-872e-b25a788e2ea0",
                                                "sense_id": "12b7a586-e4f1-3c63-b7a4-9f8f6ab2179b",
                                                "text": "Pour ce qui est de la forme à donner à cette étude, il apparaît que la chronologie impose quelques divisions principales."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e59e3a39-9622-39a7-b817-1b315544eb3d",
                                        "entry_id": "7c56cf5e-34f9-31be-9e66-54208e2dadc1",
                                        "glosses": [
                                            "Liste d’évènements classés suivant leur date, généralement du plus ancien au plus récent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1437d6b4-19e2-4f77-97a3-f442586ae900",
                                                "sense_id": "e59e3a39-9622-39a7-b817-1b315544eb3d",
                                                "text": "Un temps historique, une histoire dont la chronologie est aisément retraçable, sont le fait d'une classe dominante."
                                            },
                                            {
                                                "example_id": "0e045155-4166-40f1-923c-47818b0f6e16",
                                                "sense_id": "e59e3a39-9622-39a7-b817-1b315544eb3d",
                                                "text": "Malheureusement, le temps réel – toujours enregistrable sur machine – et le temps subjectif – souvent remémorable et restituable après réveil – du rêve sont deux chronologies neurophysiologique et psychologique que nous ne pouvons pas encore discerner objectivement et convenablement par voie expérimentale."
                                            },
                                            {
                                                "example_id": "b6a1868c-a474-494c-8f06-93c39f3af3ad",
                                                "sense_id": "e59e3a39-9622-39a7-b817-1b315544eb3d",
                                                "text": "Cette première esquisse d'une chronologie de l'art rupestre au Yémen est fondée sur une étude limitée géographiquement, essentiellement à la région de Saada, augmentée de quelques relevés aux alentours de Rad' et dans le Wadi Dahr (…)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
