                        "sense_id": "9f16f723-6cfd-307b-b776-05d03f24a247",
                        "entry_id": "48f0631d-9b8b-33ff-b91f-29b20f9906ef",
                        "glosses": [
                            "Dénomination d’un groupe par lui-même → voir exonyme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37f653ea-2846-4552-b208-263480d262bf",
                                "sense_id": "9f16f723-6cfd-307b-b776-05d03f24a247",
                                "text": "Uakambalelté est l’autodénomination du groupe : « ceux qui parlent waqha »"
                            },
                            {
                                "example_id": "94a3e6ba-9d2c-4d3b-9657-273ce32612ac",
                                "sense_id": "9f16f723-6cfd-307b-b776-05d03f24a247",
                                "text": "Si l’autodénomination syrien prévaut jusqu’aux années 1950, durant la période des mandats déjà on constate l’apparition du terme libanais."
                            },
                            {
                                "example_id": "25dece18-0003-47b8-a211-b32c2cbd531a",
                                "sense_id": "9f16f723-6cfd-307b-b776-05d03f24a247",
                                "text": "L’autodénomination homosexuelle : une caractérisation débattue et combattue."
                            },
                            {
                                "example_id": "786c8ba5-ad06-44d1-a76d-31cad50e74cd",
                                "sense_id": "9f16f723-6cfd-307b-b776-05d03f24a247",
                                "text": "Comme c’est assez classique de par le monde, l’autodénomination d’un groupe et la façon dont les autres le nomment (missionnaires, administration coloniale, chercheurs, autres groupes) ne concordent que fort rarement."
                            }
                        ]
                    }
