                                        "glosses": [
                                            "уменьш.-ласк. к облако; маленькое облако"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0956559d-d4c6-4481-9fcf-c90ae081dadd",
                                                "sense_id": "087c7bb5-cfdd-39b8-883f-52f5b5e40f7e",
                                                "text": "Ни ветра, ни бодрого, свежего звука, ни облачка."
                                            },
                                            {
                                                "example_id": "4ad918df-566e-4980-ab2c-27f81b2584fb",
                                                "sense_id": "087c7bb5-cfdd-39b8-883f-52f5b5e40f7e",
                                                "text": "Порой на луну, должно быть, набегали облачка, и в комнате становилось темней."
                                            },
                                            {
                                                "example_id": "db5aa688-f17e-4cdd-9312-6b064a00a026",
                                                "sense_id": "087c7bb5-cfdd-39b8-883f-52f5b5e40f7e",
                                                "text": "Небо потемнело, облачка из розовых превратились в серовато-лиловые."
                                            },
                                            {
                                                "example_id": "b4850cc8-0992-447e-bb7c-ef166a5721da",
                                                "sense_id": "087c7bb5-cfdd-39b8-883f-52f5b5e40f7e",
                                                "text": "Погода прежняя ― довольно тихая, ясная, если не считать тонко-тонкоперистых облачков, видимых лишь при солнце."
                                            }
                                        ]
                                    }
