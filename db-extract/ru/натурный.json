                            {
                                "example_id": "261aebd2-e5df-4ac7-8318-52bdaf0a711f",
                                "sense_id": "4e826667-a7c5-3bbb-97d0-9b403d16cf63",
                                "text": "Дополнительно к пенсии по первой категории он обеспечил себе и натурное продовольствие."
                            }
                        ]
                    },
                    {
                        "sense_id": "d0616623-b7a6-3ca0-9519-111160b9ce9d",
                        "entry_id": "a7a127bd-d6ad-3739-9f0b-73a66c12e2f7",
                        "glosses": [
                            "свойственный натуре, характерный для неё"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8841eb2-060a-41de-811f-8f3bebd2abe9",
                                "sense_id": "d0616623-b7a6-3ca0-9519-111160b9ce9d",
                                "text": "Во мне она прежде всего ценит (против Александра Михайловича) смелость обращения душой к душе и моё натурное стремление быть с нею везде вместе."
                            }
                        ]
                    },
                    {
                        "sense_id": "d03c36a6-abc5-3ac2-ae5e-7cc01d23e7f7",
                        "entry_id": "a7a127bd-d6ad-3739-9f0b-73a66c12e2f7",
                        "glosses": [
                            "связанный с рисованием, лепкой с натуры"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7deb9ab7-a34e-4221-b87a-4719db361d73",
                                "sense_id": "d03c36a6-abc5-3ac2-ae5e-7cc01d23e7f7",
                                "text": "В классах появлялся редко, к ученикам не подходил и только величественно проходил над амфитеатром натурного класса."
                            }
                        ]
                    },
                    {
                        "sense_id": "cbc204a8-5f2d-3298-80bc-19e536931a67",
                        "entry_id": "a7a127bd-d6ad-3739-9f0b-73a66c12e2f7",
                        "glosses": [
                            "производимый на натуре"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20813bfb-132e-4c99-a0b0-3f4560c436fe",
                                "sense_id": "cbc204a8-5f2d-3298-80bc-19e536931a67",
                                "text": "Провести натурный эксперимент в подтверждение сказанного в принципе всё же можно."
                            },
                            {
                                "example_id": "0cf57f83-1d04-4db5-aae5-eac5b92437dd",
                                "sense_id": "cbc204a8-5f2d-3298-80bc-19e536931a67",
                                "text": "Для этого не нужна была фантазия, нужны были натурные зарисовки…"
                            }
                        ]
                    }
                ],
