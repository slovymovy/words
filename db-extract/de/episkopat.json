                    },
                    {
                        "sense_id": "8d2313bc-08c6-3a18-95e9-e6dcdd9fff9f",
                        "entry_id": "95ddaaaf-34ee-3244-99f6-81a9988e2233",
                        "glosses": [
                            "Gesamtheit von Bischöfen (insbesondere eines Landes)"
                        ],
