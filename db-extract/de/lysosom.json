                        ],
                        "form": "das Lysosom"
                    },
                    {
                        "form_id": "1a423ce8-b1e2-4468-8741-c2fa2bb6a875",
                        "entry_id": "95e920c0-233d-33e1-97db-7b408b3727ce",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Lysosomen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b65366fe-f4eb-3630-8203-10e9221710ea",
                        "entry_id": "95e920c0-233d-33e1-97db-7b408b3727ce",
                        "glosses": [
                            "Zellorganelle mit Membran, die Enzyme enthält, die der Verdauung dienen"
                        ],
                        "tags": [
                            "Zellbiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "6206da82-5057-4ffa-b924-43bff393373e",
                                "sense_id": "b65366fe-f4eb-3630-8203-10e9221710ea",
                                "text": "„Als lysosomale Speicherkrankheiten werden vererbte Stoffwechselerkrankungen bezeichnet, bei denen Fehlfunktionen im Lysosom (Zellorganelle) vorliegen.“"
                            },
                            {
                                "example_id": "d79b78b4-f2ca-43d2-8ea8-7b8ad0f4d856",
                                "sense_id": "b65366fe-f4eb-3630-8203-10e9221710ea",
                                "text": "„Dafür besitzen nahezu alle Zellen in deinem Körper ein eingebautes Abfallentsorgungssystem, genannt Lysosom.“"
                            },
                            {
                                "example_id": "4b27b630-3f07-40c9-b438-ce51606ff442",
                                "sense_id": "b65366fe-f4eb-3630-8203-10e9221710ea",
                                "text": "„Die neu entstandenen (nativen) Lysosomen haben Durchmesser von 25–200 nm und werden als primäre Lysosomen bezeichnet.“"
                            },
                            {
                                "example_id": "ce3ff707-f9f3-4ff9-a80e-1843ec0e254a",
                                "sense_id": "b65366fe-f4eb-3630-8203-10e9221710ea",
                                "text": "„Endosomen und Lysosomen sind membranbegrenzte Zellorganellen mit unterschiedlich sauren pH-Werten, die alle dem Abbau organischer Strukturen dienen.“"
                            },
                            {
                                "example_id": "67e2c49d-1c62-48ee-8bbb-ac9bf7fb62ea",
                                "sense_id": "b65366fe-f4eb-3630-8203-10e9221710ea",
                                "text": "„Der nicht abgebaute Abfall sammelt sich im Lysosom, welches anschwillt und immer mehr Raum in der Zelle einnimmt, was den Transport von anderen Materialien im Hauptteil der Zelle behindert.“"
                            },
                            {
                                "example_id": "220082d8-62fd-48fd-9650-a6959c236c61",
                                "sense_id": "b65366fe-f4eb-3630-8203-10e9221710ea",
                                "text": "„Cholesterinester und Triglyzeride werden über Lipoproteinrezeptoren von Zellen aufgenommen und gelangen durch Endozytose in die Lysosomen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
