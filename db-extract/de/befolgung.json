                ],
                "senses": [
                    {
                        "sense_id": "d8b40696-78ca-39cc-9a09-1e1e5cbf84d4",
                        "entry_id": "fa7d3c93-2eb8-3eed-a504-5322c062dabe",
                        "glosses": [
                            "das Ausführen, Umsetzen von bestimmten Regeln, Befehlen oder Ähnlichem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8a4db4f-407e-4c42-90e3-433595502617",
                                "sense_id": "d8b40696-78ca-39cc-9a09-1e1e5cbf84d4",
                                "text": "„Christsein ist nicht die Befolgung von Geboten und Lehren, Christsein ist eine Kunst zu leben.“"
                            },
                            {
                                "example_id": "a3ff6586-1ade-4baf-a855-71c6d460853b",
                                "sense_id": "d8b40696-78ca-39cc-9a09-1e1e5cbf84d4",
                                "text": "„Tugend ist die moralische Stärke des Willens eines Menschen in der Befolgung seiner Pflicht.“"
                            },
                            {
                                "example_id": "658e6857-4e08-4c1c-bd22-7578313b452a",
                                "sense_id": "d8b40696-78ca-39cc-9a09-1e1e5cbf84d4",
                                "text": "„Er habe die Heiligung gemeint, das heißt die konsequente Befolgung der Gebote Gottes.“"
                            },
                            {
                                "example_id": "4c28928f-fc90-4cd0-9825-81e729b59e86",
                                "sense_id": "d8b40696-78ca-39cc-9a09-1e1e5cbf84d4",
                                "text": "„Nehmen an, dass das bestmögliche Ergebnis immer durch die Befolgung universeller moralischer Regeln erreicht werden kann.“"
                            },
                            {
                                "example_id": "62a5553c-b960-42df-894c-c0a30c349bb3",
                                "sense_id": "d8b40696-78ca-39cc-9a09-1e1e5cbf84d4",
                                "text": "„Denn ihre Befolgung hängt nicht nur von einem guten Willen der Normverpflichteten, sondern davon ab, dass ihnen die für die Hilfsleistungen nötigen Mittel und Möglichkeiten zur Verfügung stehen.“"
                            },
                            {
                                "example_id": "1d0c43ad-b70b-4e7a-82a2-9e83f43c0dca",
                                "sense_id": "d8b40696-78ca-39cc-9a09-1e1e5cbf84d4",
                                "text": "„Die mechanische Befolgung von Regeln, Ritualen und Sakramenten geht ohne eine spirituelle Transformation des Menschen ins Leere.“"
                            },
                            {
                                "example_id": "d3de8eb0-2e2e-4091-8be4-992bf6579691",
                                "sense_id": "d8b40696-78ca-39cc-9a09-1e1e5cbf84d4",
                                "text": "„Eine Instanz hat vielfältige Möglichkeiten, Einfluß auf die Interpretation und die Befolgung der vorgegebenen Normen zu nehmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
