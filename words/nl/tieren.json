    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5a2a3e93-1c98-3df4-aa46-6fd8f2eeb928",
                    "sense_definition": "luidkeels en heftig je woede uiten",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "woede",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boze buurman stond minutenlang te <w>tieren</w> in de gang.",
                            "target_lang_translations": {
                                "fr": "Le voisin furieux est resté pendant des minutes à <w>tempêter</w> dans le couloir."
                            }
                        },
                        {
                            "text": "Hij <w>tierde</w> van woede toen hij zag dat zijn auto beschadigd was.",
                            "target_lang_translations": {
                                "fr": "Il <w>fulminait</w> de rage en voyant que sa voiture était endommagée."
                            }
                        }
                    ],
                    "synonyms": [
                        "razen",
                        "briesen",
                        "tekeergaan"
                    ],
                    "antonyms": [
                        "bedaren"
                    ],
                    "common_phrases": [
                        "vloeken en tieren",
                        "briesen en tieren",
                        "razen en tieren"
                    ],
                    "target_lang_definitions": {
                        "fr": "Exprimer sa colère bruyamment et avec véhémence"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "tempêter",
                                "target_lang_sense_clarification": "manifester bruyamment sa fureur"
                            },
                            {
                                "target_lang_word": "pester",
                                "target_lang_sense_clarification": "manifester son mécontentement"
                            },
                            {
                                "target_lang_word": "éructer",
                                "target_lang_sense_clarification": "crier sous le coup de la colère"
                            },
                            {
                                "target_lang_word": "fulminer",
                                "target_lang_sense_clarification": "exploser de colère"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd0d4659-8366-3361-9815-dd380ebdbd19",
                    "sense_definition": "zeer goed groeien, bloeien of zich ontwikkelen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "groei",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de vele regenval <w>tiert</w> het onkruid welig in onze achtertuin.",
                            "target_lang_translations": {
                                "fr": "En raison des fortes pluies, les mauvaises herbes <w>prolifèrent</w> à foison dans notre jardin."
                            }
                        },
                        {
                            "text": "In die vochtige omstandigheden <w>tieren</w> schimmels en bacteriën bijzonder goed.",
                            "target_lang_translations": {
                                "fr": "Dans ces conditions humides, les moisissures et les bactéries <w>prospèrent</w> particulièrement bien."
                            }
                        }
                    ],
                    "synonyms": [
                        "gedijen",
                        "bloeien",
                        "woekeren"
                    ],
                    "antonyms": [
                        "kwijnen",
                        "verwelken"
                    ],
                    "common_phrases": [
                        "welig tieren"
                    ],
                    "target_lang_definitions": {
                        "fr": "Très bien se développer, croître ou prospérer vigoureusement"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "proliférer",
                                "target_lang_sense_clarification": "se multiplier ou croître abondamment"
                            },
                            {
                                "target_lang_word": "prospérer",
                                "target_lang_sense_clarification": "se développer avec force et vigueur"
                            },
                            {
                                "target_lang_word": "foisonner",
                                "target_lang_sense_clarification": "se développer en grand nombre"
                            }
                        ]
                    }
                }
            ]
        }
    ]
