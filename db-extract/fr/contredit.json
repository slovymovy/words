                        "entry_id": "34ffc6bc-2b4b-3cb3-898d-4ed979982a41",
                        "glosses": [
                            "Affirmation que l’on oppose contre ce qui a été dit."
                        ],
                        "tags": [
                            "dated",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "9f651684-7b96-4ad0-9273-be0908874ac9",
                                "sense_id": "e12547ad-a120-369f-807b-eab3e2d51b24",
                                "text": "Cette affirmation est sujette à contredit."
                            }
                        ]
                    },
                    {
                        "sense_id": "876841c0-90b3-3404-80b9-b8ece09c6d0b",
                        "entry_id": "34ffc6bc-2b4b-3cb3-898d-4ed979982a41",
                        "glosses": [
                            "En procédure civile française, voie de recours ouverte contre une décision de justice portant sur la compétence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a7052a3-af12-4cd7-ab7d-7d53777264c6",
                                "sense_id": "876841c0-90b3-3404-80b9-b8ece09c6d0b",
                                "text": "Lorsque le juge se prononce sur la compétence sans statuer sur le fond du litige, sa décision ne peut être attaquée que par la voie du contredit, quand bien même le juge aurait tranché la question de fond dont dépend la compétence."
                            }
                        ]
                    },
                    {
                        "sense_id": "6ccdb5fa-cea1-360e-9e61-7192044d871a",
                        "entry_id": "34ffc6bc-2b4b-3cb3-898d-4ed979982a41",
                        "glosses": [
                            "Les pièces que l’on fournit en opposition à celles de la partie adverse."
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "88aaf041-967e-4772-a8e1-ec1b6268da2d",
                                "sense_id": "6ccdb5fa-cea1-360e-9e61-7192044d871a",
                                "text": "Fournir des contredits."
                            },
                            {
                                "example_id": "68cb9b6b-a943-43ca-9556-49021fba94a1",
                                "sense_id": "6ccdb5fa-cea1-360e-9e61-7192044d871a",
                                "text": "Les dits et contredits."
                            }
                        ]
                    }
