                "senses": [
                    {
                        "sense_id": "d60e5a16-5651-3403-9673-f71e80e19fd5",
                        "entry_id": "5db5c0bb-f86b-3809-9bc4-28c6c1348d50",
                        "glosses": [
                            "wydruk kontrolny publikacji po wykonaniu impozycji składek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee1c6c5b-7a1c-445a-a2fc-99f376b6c45e",
                                "sense_id": "d60e5a16-5651-3403-9673-f71e80e19fd5",
                                "text": "Wykonawca musi dostarczyć wydruk próbny (ozalid kolorowy) oraz proof (cromalin) okładki."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c4060da-4b0f-43d4-9f1a-76bcdb66961f",
                        "source_entry_id": "5db5c0bb-f86b-3809-9bc4-28c6c1348d50",
                        "source_sense_id": "d60e5a16-5651-3403-9673-f71e80e19fd5",
                        "target_lang_word": "blueline",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blueline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ed474635-e525-384d-842a-875f300f987f",
                                        "entry_id": "11a49eec-6ae2-3c8e-ac94-2fa4ad5d1c53",
                                        "glosses": [
                                            "A reproduction of the material submitted for printing, computer-generated or printed from film, provided to the customer for approval before the material is printed."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "blueline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94bd774f-38cb-3ac2-a25c-df717a2f7c63",
                                        "entry_id": "16bffe5b-9366-31e6-bbdc-96d90a7eb50d",
                                        "glosses": [
                                            "To create the bluelines for material that is about to be printed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cf3344d-f0d8-4f36-805d-56576efcac7b",
                                                "sense_id": "94bd774f-38cb-3ac2-a25c-df717a2f7c63",
                                                "text": "It was decided to make the color separation in the plotting, in order to eliminate bluelining and redrafting."
                                            },
                                            {
                                                "example_id": "a2bc0f73-71f7-4995-bb95-d1150731baf5",
                                                "sense_id": "94bd774f-38cb-3ac2-a25c-df717a2f7c63",
                                                "text": "The data on these documents are qualified, reduced to chart scale and mosaicked together on the chart base. Next the mosaic is bluelined onto scribe coat and a manual selection of the data is made."
                                            },
                                            {
                                                "example_id": "6f57b89e-6a39-4e9d-8403-16bd29d4d338",
                                                "sense_id": "94bd774f-38cb-3ac2-a25c-df717a2f7c63",
                                                "text": "For example, with online publishing, many intermediary steps that are often used in the paper-based document production process are eliminated, such as paste-up, bluelining, and so on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57c7e8f3-d20a-325a-8eee-50e802a26c00",
                                        "entry_id": "16bffe5b-9366-31e6-bbdc-96d90a7eb50d",
                                        "glosses": [
                                            "To check the bluelines before printing material."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48031132-f729-4df3-ab51-a5f93ed7d1f0",
                                                "sense_id": "57c7e8f3-d20a-325a-8eee-50e802a26c00",
                                                "text": "Although claiming editorship, my involvement amounted to occasional 'bluelining', a deal of 'cutting-to-fit' and the general work required in designing and laying-out a book."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b5a99c2-876d-35f4-8906-93f2768fc85f",
                                        "entry_id": "16bffe5b-9366-31e6-bbdc-96d90a7eb50d",
                                        "glosses": [
                                            "To veto a portion of a budget."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37f30329-14ee-4f92-a2aa-f88fe342efa9",
                                                "sense_id": "8b5a99c2-876d-35f4-8906-93f2768fc85f",
                                                "text": "In 1961 the Governor bluelined the funds."
                                            },
                                            {
                                                "example_id": "dafa43c5-c7a1-413e-9bff-b6c5a173be26",
                                                "sense_id": "8b5a99c2-876d-35f4-8906-93f2768fc85f",
                                                "text": "lf our attitude is that, our program is going to be eliminated by someone who bluelines a budget."
                                            },
                                            {
                                                "example_id": "de14fe90-03a1-4b2c-97e9-23dff09f7c8a",
                                                "sense_id": "8b5a99c2-876d-35f4-8906-93f2768fc85f",
                                                "text": "Since the Pennsylvania Constitution requires a balanced budget, this necessitated the Governor's bluelining, or vetoeing out, $1.2 billion from the budget."
                                            },
                                            {
                                                "example_id": "92de3a53-0a81-40d8-900a-452367d88131",
                                                "sense_id": "8b5a99c2-876d-35f4-8906-93f2768fc85f",
                                                "text": "I sat down with the Governor we bluelined the budget down to a billion three and sent it back."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "494e3436-4479-3ec3-8bd4-52939f64ef61",
                                        "entry_id": "16bffe5b-9366-31e6-bbdc-96d90a7eb50d",
                                        "glosses": [
                                            "To edit a legal document."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79be513b-b952-4b97-bf87-1d0c40e65edf",
                                                "sense_id": "494e3436-4479-3ec3-8bd4-52939f64ef61",
                                                "text": "It seems sensible under a range of circumstances to have that power to be able to blueline them— or redline them, as the case may be— so that they are removed from the register."
                                            },
                                            {
                                                "example_id": "855bf550-d29e-44cd-9fa1-912e83467c7d",
                                                "sense_id": "494e3436-4479-3ec3-8bd4-52939f64ef61",
                                                "text": "California law allows a court to \"blueline\" an arbitration agreement to remove an element that renders it substantively unconscionable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52447336-cd32-3073-b3d3-69254bc88ffc",
                                        "entry_id": "16bffe5b-9366-31e6-bbdc-96d90a7eb50d",
                                        "glosses": [
                                            "To mark on a patient's body where the surgical incision is to be made."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e6e81af-0c3f-4856-bef7-ac1f5c994942",
                                                "sense_id": "52447336-cd32-3073-b3d3-69254bc88ffc",
                                                "text": "Bone removal was continued in order to \"blueline\" the vestibule and then extended superiorly over the vestibule until Bill's bar was exposed."
                                            },
                                            {
                                                "example_id": "1fa971ec-bb89-4fb0-8005-d5330bded784",
                                                "sense_id": "52447336-cd32-3073-b3d3-69254bc88ffc",
                                                "text": "After bluelining, the bony endostium is opened with a 90°-degree microhook; care must be taken to avoid suction of the perilymph; the membranous canal comes into view"
                                            },
                                            {
                                                "example_id": "ff0c9f5d-773c-4318-bd60-eb641289b835",
                                                "sense_id": "52447336-cd32-3073-b3d3-69254bc88ffc",
                                                "text": "The lateral canal is first bluelined, then opened with a cutting burr."
                                            },
                                            {
                                                "example_id": "57e1a8e0-72bd-48ef-b7ac-f29d14078603",
                                                "sense_id": "52447336-cd32-3073-b3d3-69254bc88ffc",
                                                "text": "Although this technique avoids the retrograde dissection of the facial nerve through the geniculate ganglion and labyrinthine segment, the obvious disadvantage of bluelining is that it carries a risk of fenestrating the superior semicircular canal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b27a0c5-91d4-3512-ba67-d6364590084e",
                                        "entry_id": "16bffe5b-9366-31e6-bbdc-96d90a7eb50d",
                                        "glosses": [
                                            "To designate a certain area as representing one in which investment is risky."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb70762b-22b1-4320-8585-73b43aaa66fe",
                                                "sense_id": "9b27a0c5-91d4-3512-ba67-d6364590084e",
                                                "text": "Not unlike the negative results of the bluelining and steering practices of many banks and real estate firms, such efforts leave bitterness in their wake and serve to bolster the worst fears and prejudices of both races."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
