                                    },
                                    {
                                        "sense_id": "be886b79-e70d-35f4-8d7e-d9c34e22baf3",
                                        "entry_id": "b05f88d6-80e6-31d4-845a-802062aacc9f",
                                        "glosses": [
                                            "accanimento terapeutico: verso un paziente in malattia, è il sopravvenire di una condizione senza effetti di miglioramento della salute ma addirittura con un peggioramento oltre la norma a causa delle cure mediche terapeutiche stesse, talvolta intendendo il superamento del limite etico-professionale (v biotestamento); altrimenti è \\\"una sorta di ostinazione\\\" nella ricerca, anche per \\\"singoli pazienti\\\" per esempio anche attraverso cure o visite troppo accurate quindi spesso eccessive o persino invasive"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26b44a02-fcb7-4a83-8992-8eb785a9fbac",
                                                "sense_id": "be886b79-e70d-35f4-8d7e-d9c34e22baf3",
                                                "text": "il medico, ormai abbandonato dal nostro paziente, operava con ineluttabile rigore estremo sino ad un accanimento terapeutico che causò danni permanenti"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aacd15b0-6aea-4901-afce-19ada15048a3",
                        "source_entry_id": "ded6ce78-2566-39f2-bbfd-27c1770dd7b3",
                        "source_sense_description": "результат такого действия; состояние крайней злобы",
                        "target_lang_word": "hargne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hargne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cfc9af80-b395-36a8-82a5-7d2dfb4463f9",
                                        "entry_id": "0f3b1ed6-c723-3514-8069-232159cabe6c",
                                        "glosses": [
                                            "Ténacité coléreuse ; acharnement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3715e8d5-a0d2-4c5c-a6dc-85921870e576",
                                                "sense_id": "cfc9af80-b395-36a8-82a5-7d2dfb4463f9",
                                                "text": "Mais il répondit seulement avec hargne : « Tu as raison, ce n’est pas fini, on te niquera la gueule. »"
                                            },
                                            {
                                                "example_id": "92d9acce-460f-468b-8c96-76492798c2a9",
                                                "sense_id": "cfc9af80-b395-36a8-82a5-7d2dfb4463f9",
                                                "text": "[…] vous aussi, par votre hargne réactionnaire, par votre racisme ordinaire, vous êtes typique de notre époque."
                                            },
                                            {
                                                "example_id": "7b0cab53-ac02-4b00-99fa-9d127a5e369c",
                                                "sense_id": "cfc9af80-b395-36a8-82a5-7d2dfb4463f9",
                                                "text": "Quand bien même seraient-ils cinq mille ! s'emporta le lieutenant qui, décidément, me surprenait par la hargne qu'il démontrait. On n'a point éprouvé deux jours d’emmouscaillement dans cette forêt du diable pour s'en retourner quinauds."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
