                        ],
                        "form": "more myopic"
                    },
                    {
                        "form_id": "6edf2cc6-76a7-4269-b19f-a16c045824c7",
                        "entry_id": "5b1584b6-3359-3bdc-81ca-9442a39f8667",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most myopic"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c473b901-0940-3b2c-9291-6c023f6a28b7",
                        "entry_id": "5b1584b6-3359-3bdc-81ca-9442a39f8667",
                        "glosses": [
                            "Near-sighted; unable to see distant objects unaided."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f46eec8-043a-468f-ae4e-946ef2626d18",
                                "sense_id": "c473b901-0940-3b2c-9291-6c023f6a28b7",
                                "text": "Corrective lenses compensate for the excessive positive diopters of the myopic eye."
                            },
                            {
                                "example_id": "872e84b0-ec23-40fe-ad0f-f2569ebd4d07",
                                "sense_id": "c473b901-0940-3b2c-9291-6c023f6a28b7",
                                "text": "A stronger prescription for myopic night drivers is often needed."
                            },
                            {
                                "example_id": "10b1f329-92ec-4632-a9f0-e64c12ba7b1e",
                                "sense_id": "c473b901-0940-3b2c-9291-6c023f6a28b7",
                                "text": "She yanked the paper from her motherʼs hands, bringing it very close to her myopic eyes."
                            }
                        ]
                    },
                    {
                        "sense_id": "f8f6a25b-1914-3b9b-951d-d7bf372467d6",
                        "entry_id": "5b1584b6-3359-3bdc-81ca-9442a39f8667",
                        "glosses": [
                            "Shortsighted; improvident."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "1d436a8b-1f15-4990-9fca-b7b0b2408e2c",
                                "sense_id": "f8f6a25b-1914-3b9b-951d-d7bf372467d6",
                                "text": "The real problem, he insists, is the myopic mentality that has failed to address climate change to date. The rich world’s indifference to the despoliation of the environment in pursuit of short-term economic gain is rooted in a wider problem."
                            },
                            {
                                "example_id": "41ffab55-3e97-485b-b28f-e35b2904be36",
                                "sense_id": "f8f6a25b-1914-3b9b-951d-d7bf372467d6",
                                "text": "His postwar roles, full of myopic obsession, stalkerish derangement, and a desire for vengeance, don't seem like ground Hanks is willing to cover."
                            }
                        ]
                    },
                    {
                        "sense_id": "a34f902b-62fa-35c3-bcb2-e45e81fe2b8b",
                        "entry_id": "5b1584b6-3359-3bdc-81ca-9442a39f8667",
                        "glosses": [
                            "Narrow-minded."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "370de97d-b684-46a2-8f74-7965de364455",
                                "sense_id": "a34f902b-62fa-35c3-bcb2-e45e81fe2b8b",
                                "text": "Scientific advances can draw us outside of our myopic comfort zone."
                            },
                            {
                                "example_id": "7c7ef5d8-506d-4210-96b1-3c39c15e9025",
                                "sense_id": "a34f902b-62fa-35c3-bcb2-e45e81fe2b8b",
                                "text": "Will you come testify in the court of myopic opinion / Or will you settle for oblivion?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cdef5f5c-31d0-44e2-b7b4-791a3a200495",
