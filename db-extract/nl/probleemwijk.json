                        "examples": [
                            {
                                "example_id": "6230913e-6d34-43dc-94d6-2f20c7f3bd0a",
                                "sense_id": "05e47b80-9eaf-342e-897e-29bbce06506a",
                                "text": "De deelnemers komen niet toevallig uit de zogenaamde probleemwijken van België (Borgerhout en Molenbeek) en Nederland (zoals Amsterdam-West). Sinds dit weekend staat Rotterdam vol met panelen met hun afbeeldingen."
                            },
                            {
                                "example_id": "4fd5a404-d16d-4d63-80be-d58912fcba66",
                                "sense_id": "05e47b80-9eaf-342e-897e-29bbce06506a",
                                "text": "‘In probleemwijken kunnen volkstuinen helpen om de criminaliteit te doen dalen’"
                            }
                        ]
