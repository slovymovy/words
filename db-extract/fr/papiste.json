                                        "sense_id": "7c93efe7-4a0e-3b1e-aba9-0bde7ae591d0",
                                        "entry_id": "a55c4879-8cd4-3a43-8c8e-811f6a542325",
                                        "glosses": [
                                            "A Roman Catholic, especially one whose loyalties are seen to be with the papacy in Rome."
                                        ],
