                                "sense_id": "3dd378cf-76ea-37a9-a90f-e1c282350447",
                                "text": "De uitvoer van het project heeft wat vertraging opgelopen.",
                                "translation": "The execution of the project has experienced some delays.",
                                "english": "The execution of the project has experienced some delays."
                            },
                            {
                                "example_id": "11cda043-7891-44f3-bd30-d5a496330514",
                                "sense_id": "3dd378cf-76ea-37a9-a90f-e1c282350447",
                                "text": "We zijn verantwoordelijk voor de uitvoer van dit plan.",
                                "translation": "We are responsible for the execution of this plan.",
                                "english": "We are responsible for the execution of this plan."
                            },
                            {
                                "example_id": "036c1805-dba1-4b64-adc6-48dec5e2b7f4",
                                "sense_id": "3dd378cf-76ea-37a9-a90f-e1c282350447",
                                "text": "De uitvoer van deze opdracht vereist nauwkeurige planning.",
                                "translation": "The execution of this assignment requires meticulous planning.",
                                "english": "The execution of this assignment requires meticulous planning."
                            }
                        ]
