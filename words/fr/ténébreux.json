                },
                {
                    "sense_id": "59f3c208-0a3f-3371-9447-4427e9a493f2",
                    "sense_definition": "Qui manifeste un caractère ou une humeur sombre, mélancolique ou tourmentée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "humeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il gardait un silence inhabituel et affichait un regard <w>ténébreux</w> tout au long du repas."
