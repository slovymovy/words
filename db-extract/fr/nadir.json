                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ca66902-8ea0-4bb4-b52e-b0e563b78e2d",
                                "sense_id": "82ba2b55-3be1-36f3-9451-b8670cbf8ad1",
                                "text": "Le record de Français appelés en une soirée devrait ensuite reposer sur le sort de Sidy Cissoko (1,98 m, 19 ans) et Nadir Hifi (1,84 m, 20 ans)."
                            }
                        ]
                    }
