                "translations": [
                    {
                        "translation_id": "33560288-9234-4a36-9702-777bb918f4fa",
                        "source_entry_id": "7966d4e9-1bc4-3256-89c6-2cc46dad164c",
                        "source_sense_description": "add a second signature",
                        "target_lang_word": "contresigner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contresigner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3e5c88f2-52fa-3fa1-9c1d-ef7d1a35bdcb",
                                        "entry_id": "c7c313fb-f00b-3572-8423-32a189863166",
                                        "glosses": [
                                            "Signer un acte, en vertu des fonctions qu’on exerce, après que celui dont cet acte émane y a lui-même apposé sa signature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd45bdad-727f-44c3-b20b-9b10bebe1a0d",
                                                "sense_id": "3e5c88f2-52fa-3fa1-9c1d-ef7d1a35bdcb",
                                                "text": "Le bourgeois est un grimaud\nQui prend sa pendule au mot\nChaque fois qu’elle retarde.\nIl contresigne en bâtarde\nCoups d’états, décrets, traités,\nEt toutes les lâchetés."
                                            },
                                            {
                                                "example_id": "c4f4675b-2c5d-45d2-bcf3-66dabd19ecea",
                                                "sense_id": "3e5c88f2-52fa-3fa1-9c1d-ef7d1a35bdcb",
                                                "text": "C’était comme si le destin lui-même eût pris parti pour Beautrelet et contresigné le bulletin de victoire."
                                            },
                                            {
                                                "example_id": "1fe54a04-9a86-4686-a99f-95d63b53a01b",
                                                "sense_id": "3e5c88f2-52fa-3fa1-9c1d-ef7d1a35bdcb",
                                                "text": "Il va sans dire que, dans ces conditions, nous approuvons pleinement et contresignons le manifeste lancé par le Comité d’action contre la guerre du Maroc, …."
                                            },
                                            {
                                                "example_id": "3756ca7f-cbdb-47f1-957d-1450ceceafd5",
                                                "sense_id": "3e5c88f2-52fa-3fa1-9c1d-ef7d1a35bdcb",
                                                "text": "« Lady Wynham est belle. Vous lui direz que les présents d’Artaxerxès me laissent froid et que je contresignerai les papiers de concession lorsque l’aurore l’aura surprise entre mes bras… »"
                                            },
                                            {
                                                "example_id": "0ab4aeae-28cf-48d0-9d15-22e197083a1d",
                                                "sense_id": "3e5c88f2-52fa-3fa1-9c1d-ef7d1a35bdcb",
                                                "text": "Pour éviter tout commentaire tendancieux, j'ai prié le Père Julien de m'assister et de contresigner les procès-verbaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5ff0052-8ead-3e19-b313-e4a7b4e9bccd",
                                        "entry_id": "c7c313fb-f00b-3572-8423-32a189863166",
                                        "glosses": [
                                            "Mettre la signature ou la griffe du ministre ou de l’administrateur sur l’enveloppe des lettres pour les envoyer en droit de franchise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66eb15c9-9c97-4317-8d99-a806a3fbf7ad",
                                                "sense_id": "f5ff0052-8ead-3e19-b313-e4a7b4e9bccd",
                                                "text": "Le secrétaire général a contresigné cette lettre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e1225e8d-b7c2-4904-b05a-944b611d24d7",
