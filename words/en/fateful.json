{
    "word_family": [
        "fate",
        "fated",
        "fatefully",
        "fatefulness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "53a403ac-1a6e-325e-8323-7f2abb07b0fd",
                    "sense_definition": "Having important, often disastrous or irrevocable, consequences; momentous.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It started with that <w>fateful</w> trip, and history was never the same afterwards.",
                            "target_lang_translations": {
                                "de": "Es begann mit jener <w>schicksalhaften</w> Reise, und danach war die Geschichte nie wieder dieselbe."
                            }
                        },
                        {
                            "text": "She regretted that <w>fateful</w> decision for the rest of her life.",
                            "target_lang_translations": {
                                "de": "Sie bereute diese <w>verhängnisvolle</w> Entscheidung für den Rest ihres Lebens."
                            }
                        }
                    ],
                    "synonyms": [
                        "consequential",
                        "critical",
                        "crucial",
                        "pivotal",
                        "momentous"
                    ],
                    "common_phrases": [
                        "fateful day",
                        "fateful decision",
                        "fateful night",
                        "fateful moment"
                    ],
                    "target_lang_definitions": {
                        "de": "Wichtige, oft unheilvolle oder unwiderrufliche Konsequenzen habend; folgenschwer oder bedeutsam."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "verhängnisvoll",
                                "target_lang_sense_clarification": "mit meist katastrophalen oder negativen Folgen"
                            },
                            {
                                "target_lang_word": "schicksalhaft",
                                "target_lang_sense_clarification": "von großer, weichenstellender Tragweite"
                            },
                            {
                                "target_lang_word": "folgenschwer",
                                "target_lang_sense_clarification": "weitreichende Konsequenzen nach sich ziehend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b66cb9c9-a5e4-3db9-9742-f2580807be4b",
                    "sense_definition": "Determined in advance by destiny; foreordained.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They felt a <w>fateful</w> attraction that seemed completely out of their control.",
                            "target_lang_translations": {
                                "de": "Sie spürten eine <w>schicksalhafte</w> Anziehungskraft, die sich ihrer Kontrolle völlig zu entziehen schien."
                            }
                        },
                        {
                            "text": "The prophet warned the king of his <w>fateful</w> encounter with the enemy army.",
                            "target_lang_translations": {
                                "de": "Der Prophet warnte den König vor seinem <w>vorbestimmten</w> Zusammentreffen mit der feindlichen Armee."
                            }
                        }
                    ],
                    "synonyms": [
                        "destined",
                        "fated",
                        "foreordained",
                        "predestined",
                        "preordained"
                    ],
                    "common_phrases": [
                        "fateful meeting",
                        "fateful encounter"
                    ],
                    "target_lang_definitions": {
                        "de": "Durch das Schicksal im Voraus bestimmt; vorherbestimmt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "schicksalhaft",
                                "target_lang_sense_clarification": "wie vom Schicksal gelenkt"
                            },
                            {
                                "target_lang_word": "vorbestimmt",
                                "target_lang_sense_clarification": "bereits im Vorhinein festgelegt"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}