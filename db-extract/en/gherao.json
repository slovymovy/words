                        "entry_id": "99a3daa4-88ce-3143-b640-2234997e4e7e",
                        "glosses": [
                            "A protest in which a group of people surrounds a politician, building, etc. until demands are met."
                        ],
                        "tags": [
                            "India"
                        ],
                        "examples": [
                            {
                                "example_id": "8ed4f5e9-29b0-4087-bfc0-99ae22c6b63c",
                                "sense_id": "444dc44c-2079-3cde-9c46-878b16bf0a7d",
                                "text": "They had done a gherao and trapped the manager in his office for a whole day."
                            },
                            {
                                "example_id": "a3f18485-5aee-4adf-9f72-35bf8ffbfd77",
                                "sense_id": "444dc44c-2079-3cde-9c46-878b16bf0a7d",
                                "text": "This was an invitation to strike: according to one estimate, there were more than 1,200 gheraos in the first six months of the first UF-LF government."
                            },
                            {
                                "example_id": "b6ce1b00-7ca9-4a2c-886e-f9e1723c1a35",
                                "sense_id": "444dc44c-2079-3cde-9c46-878b16bf0a7d",
                                "text": "They led us in a mob to the administrative office of the Patna University, blockaded the main entrance and besieged the vice chancellor's office in a gherao […]"
                            }
                        ]
                    }
