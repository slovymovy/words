                                        "glosses": [
                                            "Caffeine when present in tea."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff3ef7fb-010b-4ed3-8dc4-3a1a0ac0c49d",
                                                "sense_id": "f0dc9b9f-8255-30dd-8092-0422ba168c27",
                                                "text": "Caffeine is called guaranine when found in guarana, mateine when found in mate and theine when found in tea. There is far more caffeine in coffees than in teas."
                                            }
                                        ]
