                                        "glosses": [
                                            "Définition manquante ou à compléter. (Ajouter)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16500e5c-2eff-4101-8792-597223b9d428",
                                                "sense_id": "ec452bb9-e099-3d4c-9fc3-a667fccf7a6b",
                                                "text": "En haut de la butte, côté est, pris entre le grillage de sécurité et la paroi du Cœur, Alvid laisse reposer sa caméra sur son monopode."
                                            }
                                        ]
