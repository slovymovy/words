    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ef63b54b-d82f-353b-b3da-00847151e461",
                    "sense_definition": "A person who likes or tends to express a contradicting viewpoint, especially from one held by a majority of people, usually because of nonconformity or spite.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "contrarian person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is a natural <w>contrarian</w> who always argues against the popular opinion just for the sake of it.",
                            "target_lang_translations": {
                                "ru": "Он прирожденный <w>спорщик</w>, который всегда выступает против популярного мнения просто ради самого процесса."
                            }
                        },
                        {
                            "text": "The professor was known as a <w>contrarian</w> because he challenged every established theory in his field.",
                            "target_lang_translations": {
                                "ru": "Профессор был известен как <w>нонконформист</w>, потому что он оспаривал каждую устоявшуюся теорию в своей области."
                            }
                        }
                    ],
                    "synonyms": [
                        "nonconformist",
                        "dissenter",
                        "maverick"
                    ],
                    "common_phrases": [
                        "natural contrarian",
                        "born contrarian"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который склонен выражать мнение, противоположное общепринятому, часто из принципа или духа противоречия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "противоречивый человек",
                                "target_lang_sense_clarification": "тот, кто всегда спорит"
                            },
                            {
                                "target_lang_word": "нонконформист",
                                "target_lang_sense_clarification": "человек, идущий против течения"
                            },
                            {
                                "target_lang_word": "спорщик",
                                "target_lang_sense_clarification": "любитель возражать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "510f2a5a-6626-332c-a238-a6b2df9eca13",
                    "sense_definition": "A financial investor who tends to have an opinion of market trends at variance with most others.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "contrarian investor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a <w>contrarian</w>, she decided to buy stocks when everyone else was selling in a panic.",
                            "target_lang_translations": {
                                "ru": "Как <w>контрариан</w>, она решила покупать акции, когда все остальные в панике их продавали."
                            }
                        },
                        {
                            "text": "Successful <w>contrarians</w> often find the best opportunities by going against the market herd.",
                            "target_lang_translations": {
                                "ru": "Успешные <w>инвесторы-нонконформисты</w> часто находят лучшие возможности, идя против рыночной толпы."
                            }
                        }
                    ],
                    "antonyms": [
                        "slipstreamer"
                    ],
                    "common_phrases": [
                        "market contrarian",
                        "investment contrarian"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "finance"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Инвестор, чьи действия на рынке идут вразрез с поведением большинства участников."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "контрариан",
                                "target_lang_sense_clarification": "инвестор, идущий против тренда"
                            },
                            {
                                "target_lang_word": "инвестор-нонконформист",
                                "target_lang_sense_clarification": "действующий вопреки рыночной толпе"
                            }
                        ]
                    }
                }
            ]
        },
