                        "examples": [
                            {
                                "example_id": "489bc2a8-4d3b-4268-9c63-70f8de936421",
                                "sense_id": "d2a725ea-0575-3c9a-b8f0-5ededd6a9c7a",
                                "text": "Premier Mark Rutte is gasthoofdredacteur van het nummer van vrouwenblad Margriet dat deze week uitkomt. Hij geeft in die rol een inkijkje in zijn privéleven."
                            },
                            {
                                "example_id": "780249b6-3826-474f-8489-4c217b681f20",
                                "sense_id": "d2a725ea-0575-3c9a-b8f0-5ededd6a9c7a",
                                "text": "Ondanks de malaise in de bladenmarkt verschijnen maandelijks toch weer nieuwe tijdschriften die de gok wagen. Een van de opvallendste introducties is de nieuwe uitgave van het van oorsprong Amerikaanse vrouwenblad Harper's Bazaar. Vandaag verscheen het oudste modeblad ter wereld in Nederland."
                            },
                            {
                                "example_id": "9227e9c8-6d25-472f-bb6c-c4b9ac8c672b",
                                "sense_id": "d2a725ea-0575-3c9a-b8f0-5ededd6a9c7a",
                                "text": "Bij de redactie van Libelle verdwijnen ongeveer tien banen. Dat heeft uitgeverij Sanoma bekendgemaakt. Er werken nu 41 redacteuren bij het vrouwenblad. Sanoma maakte in oktober vorig jaar al bekend dat een reorganisatie nodig is om het bedrijf gezond te houden."
                            }
                        ]
                    }
