                "senses": [
                    {
                        "sense_id": "28060e97-c0c8-3e4c-9ed6-0a682150bff3",
                        "entry_id": "bc1a4012-ee4f-32a8-ad8a-c3c68c09315f",
                        "glosses": [
                            "One who qualifies for something, especially a contestant who qualifies for a stage in a competition."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d04e1b12-5a23-3d57-8746-ffe3e93aba21",
                        "entry_id": "bc1a4012-ee4f-32a8-ad8a-c3c68c09315f",
                        "glosses": [
                            "A preliminary stage of a competition."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d05afcae-a767-499c-a2a5-2ec7a7f918cd",
                                "sense_id": "d04e1b12-5a23-3d57-8746-ffe3e93aba21",
                                "text": "But England's final qualifier, played out in the hostile surroundings of Podgorica City Stadium, turned on two incidents that will have cast a cloud over Capello's delight at reaching another major tournament."
                            },
                            {
                                "example_id": "9f2cd225-5e21-435e-bcf8-e315a47f6e8a",
                                "sense_id": "d04e1b12-5a23-3d57-8746-ffe3e93aba21",
                                "text": "Rice is maturing at such a rate that he is now indispensable. Yes, these qualifiers may not be the most exacting examinations but he has also looked a class act at club level under manager David Moyes this season."
                            }
                        ]
                    },
                    {
                        "sense_id": "5320eb89-65a2-3c7b-a6d4-b2525035362f",
                        "entry_id": "bc1a4012-ee4f-32a8-ad8a-c3c68c09315f",
                        "glosses": [
                            "A word or phrase, such as an adjective or adverb, that describes or characterizes another word or phrase, such as a noun or verb; one that adds or subtracts attributes to another."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d5460c90-6488-3486-90dd-3b28f43d6c38",
                        "entry_id": "bc1a4012-ee4f-32a8-ad8a-c3c68c09315f",
                        "glosses": [
                            "A marker that qualifies or modifies another code element."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27737fc1-5f63-47b2-bc15-ca17f03cc29f",
                                "sense_id": "d5460c90-6488-3486-90dd-3b28f43d6c38",
                                "text": "The qualifier const may be prefixed to any declaration, and specifies that the value to which the data object is initialised cannot subsequently be changed."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76fa77ca-283d-402d-a23a-64647794dea8",
                        "source_entry_id": "bc1a4012-ee4f-32a8-ad8a-c3c68c09315f",
                        "source_sense_description": "one who qualifies",
                        "target_lang_word": "Qualifikant",
