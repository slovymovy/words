                                        "entry_id": "00910213-4fab-30b2-876c-1baf1d252c7f",
                                        "glosses": [
                                            "Beziehungen, in denen ein Text zu anderen Texten steht und die bei der Erstellung und dem Verstehen dieses Textes beachtet werden müssen"
                                        ],
                                        "tags": [
                                            "Literaturwissenschaft"
                                        ],
