                            {
                                "target_lang_word": "enragé",
                                "target_lang_sense_clarification": "pris d'une violente fureur"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "286555b9-db46-309d-980a-4dc3cbd4e7f9",
                    "sense_definition": "Ruig, wild en niet door mensen bewerkt of bewoond (van landschap of natuur).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wildness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We wandelden urenlang door het <w>woeste</w> landschap van de bergen.",
                            "target_lang_translations": {
                                "en": "We walked for hours through the <w>wild</w> landscape of the mountains.",
                                "ru": "Мы часами гуляли по <w>дикому</w> горному ландшафту.",
                                "fr": "Nous avons marché pendant des heures à travers le paysage <w>sauvage</w> des montagnes."
                            }
                        },
                        {
                            "text": "Het schip had moeite om door de <w>woeste</w> golven te varen.",
                            "target_lang_translations": {
                                "en": "The ship struggled to sail through the <w>wild</w> waves.",
                                "ru": "Кораблю было трудно плыть сквозь <w>бурные</w> волны.",
                                "fr": "Le navire avait du mal à naviguer à travers les vagues <w>démontées</w>."
                            }
