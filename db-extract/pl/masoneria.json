                    },
                    {
                        "translation_id": "71798726-7c7e-4fc9-b899-ef3b8fa5a344",
                        "source_entry_id": "75333ffd-cc42-3fad-9b18-8ae04d1430aa",
                        "source_sense_id": "a6f29e09-8ac0-39d4-8202-a22e2642113b",
                        "target_lang_word": "franc-maçonnerie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "franc-maçonnerie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c90e9a0c-8005-33b0-98f4-3eec1477bfe4",
                                        "entry_id": "dc81c2e9-6e50-30ac-9089-bd755adb158a",
                                        "glosses": [
                                            "Association philanthropique, autrefois secrète, qui fait un emploi symbolique des instruments à l'usage de l'architecte et du maçon, et dont les lieux de réunion sont appelés loges."
                                        ],
                                        "tags": [
                                            "Franc-maçonnerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8874160b-cf31-40dc-86af-9af5df3795e2",
                                                "sense_id": "c90e9a0c-8005-33b0-98f4-3eec1477bfe4",
                                                "text": "On a vu la Franc-Maçonnerie collaborer aux campagnes anti-conceptionnelles."
                                            },
                                            {
                                                "example_id": "d3f8afa7-e371-4bf1-9f3e-38c2bf7f1f60",
                                                "sense_id": "c90e9a0c-8005-33b0-98f4-3eec1477bfe4",
                                                "text": "J’avais promis à tes parents de ne rien faire pour te détourner des pratiques religieuses, mais ne m’étais engagé qu’à ne pas m’affilier à la franc-maçonnerie. D’ailleurs vous ne songiez à aucune autre exigence. En ces années-là, la religion ne concernait que les femmes."
                                            },
                                            {
                                                "example_id": "aa2acbc8-53ce-43b1-ac42-415c89958d50",
                                                "sense_id": "c90e9a0c-8005-33b0-98f4-3eec1477bfe4",
                                                "text": "Selon les versions, le chenal doit son nom aux petites huttes où les sauniers s’abritaient, qu’on appelle les cayennes ou à la franc-maçonnerie, le Cayenne étant la maison mère où étaient alors reçus les apprentis tailleurs de pierre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed17ccab-1500-3b52-9736-21a64563e565",
                                        "entry_id": "dc81c2e9-6e50-30ac-9089-bd755adb158a",
                                        "glosses": [
                                            "On le dit aussi des pratiques de cette association."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "000b0e66-bc52-4f1b-b190-b7201bc35c41",
                                                "sense_id": "ed17ccab-1500-3b52-9736-21a64563e565",
                                                "text": "Les rites, les emblèmes, les cérémonies, le secret de la franc-maçonnerie."
                                            },
                                            {
                                                "example_id": "8d1efc2a-d918-4a62-a7d3-84ab1286db2a",
                                                "sense_id": "ed17ccab-1500-3b52-9736-21a64563e565",
                                                "text": "L’action occulte de la franc-maçonnerie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17e4e101-ef9f-3d30-9538-81c19d632ac7",
                                        "entry_id": "dc81c2e9-6e50-30ac-9089-bd755adb158a",
                                        "glosses": [
                                            "Sentiment de sympathie qui naît facilement entre gens de même profession, de mêmes idées."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5911e88c-f428-40d4-a1f5-63ab9a0c3848",
                                                "sense_id": "17e4e101-ef9f-3d30-9538-81c19d632ac7",
                                                "text": "Il y a une sorte de franc-maçonnerie entre les artistes."
                                            },
                                            {
                                                "example_id": "a197af5f-5a71-44ed-a519-7e29ecd98b4b",
                                                "sense_id": "17e4e101-ef9f-3d30-9538-81c19d632ac7",
                                                "text": "Ce langage secret forme en quelque sorte la franc-maçonnerie des passions."
                                            },
                                            {
                                                "example_id": "6efaeaba-3e38-4d94-93b3-94ce5512ccf4",
                                                "sense_id": "17e4e101-ef9f-3d30-9538-81c19d632ac7",
                                                "text": "Il me semble sentir encore entre nous cette franc-maçonnerie de l’enfance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a2e06f9-e60b-4af8-8df9-f9cbef71101e",
                        "source_entry_id": "75333ffd-cc42-3fad-9b18-8ae04d1430aa",
                        "source_sense_id": "a6f29e09-8ac0-39d4-8202-a22e2642113b",
                        "target_lang_word": "maçonnerie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maçonnerie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f66ab04a-659b-308a-85cf-bd28474f7877",
                                        "entry_id": "df09abb9-b2ac-3191-8d8a-d95e9773daa9",
                                        "glosses": [
                                            "Ouvrage de construction où l’on emploie de la pierre, de la brique, du ciment, du mortier, du plâtre, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e24eabb-5662-4b55-b4c8-589ccce9f3f9",
                                                "sense_id": "f66ab04a-659b-308a-85cf-bd28474f7877",
                                                "text": "Au XVᵉ siècle, une fenêtre à meneaux fut ouverte dans cette abside, à travers la maçonnerie visigothe."
                                            },
                                            {
                                                "example_id": "e919f42e-3f83-4347-ba79-955be5ae3bd9",
                                                "sense_id": "f66ab04a-659b-308a-85cf-bd28474f7877",
                                                "text": "Le fossé est encombré de pierres roulantes, de menthes, de ronces, la lermuse glisse sur les gravois et s'y enfouit, la chèvre apparaît sur les blocs de maçonnerie comme sur un piédestal, les vénérables murs, que les enfants du prophète ne purent franchir, se couchent aujourd'hui par lambeaux dans le fossé, qu'ils comblent ; […]."
                                            },
                                            {
                                                "example_id": "4e31c8bf-a153-4ae8-a293-91d7d5fd44da",
                                                "sense_id": "f66ab04a-659b-308a-85cf-bd28474f7877",
                                                "text": "Dans certains cas, le corps du moulin est fixe et forme une tour en maçonnerie, sur laquelle peut tourner la toiture en entraînant avec elle l’arbre et les ailes."
                                            },
                                            {
                                                "example_id": "aade0cd1-d223-4ae0-8bc2-39e509fe9604",
                                                "sense_id": "f66ab04a-659b-308a-85cf-bd28474f7877",
                                                "text": "Un oratoire (msalla), simple mur en maçonnerie blanchi à la chaux, avait été construit à la hâte sur une colline voisine, toute blanche de pâquerettes."
                                            },
                                            {
                                                "example_id": "3f300c0a-9945-4fe1-85e6-6f5b225fc81e",
                                                "sense_id": "f66ab04a-659b-308a-85cf-bd28474f7877",
                                                "text": "Il est contenu dans des cuves en bois ou en maçonnerie cimentée qu’il est préférable de garnir de plomb."
                                            },
                                            {
                                                "example_id": "94afe919-67ae-468b-aebb-b831a58b90d6",
                                                "sense_id": "f66ab04a-659b-308a-85cf-bd28474f7877",
                                                "text": "Les fers du ciment armé apparaissaient ça et là dans la maçonnerie ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dee2fd6-4ebe-3b7e-b8d0-fea11492bd03",
                                        "entry_id": "df09abb9-b2ac-3191-8d8a-d95e9773daa9",
                                        "glosses": [
                                            "Art de cette construction."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ce866f39-b55e-365b-8c58-83ca60ed4f8a",
                                        "entry_id": "df09abb9-b2ac-3191-8d8a-d95e9773daa9",
                                        "glosses": [
                                            "Franc-maçonnerie."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab171881-0ba5-4c24-88e4-58b6d692b168",
                                                "sense_id": "ce866f39-b55e-365b-8c58-83ca60ed4f8a",
                                                "text": "Ce n'était pas sans une vive appréhension que le Grand Orient se voyait imposer un Grand Maitre absolument étranger à la Maçonnerie et qui ne devint Maçon qu'après sa haute investiture."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
