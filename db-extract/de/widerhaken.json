                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab498cc0-6e7e-31fd-ba6f-03aeb48eb98e",
                                        "entry_id": "32d4c02b-8398-3a24-a460-563986d4dbc3",
                                        "glosses": [
                                            "A barbiturate."
