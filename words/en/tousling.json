{
    "word_family": [
        "tousle",
        "tousled"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "88371d4c-b456-3d12-87fa-0692b5cef70c",
                    "sense_definition": "The <w>tousle</w> (present participle and gerund) of making hair messy or untidy.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "hair_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>tousling</w> his son's hair while they played in the park.",
                            "target_lang_translations": {
                                "cs": "Když si hráli v parku, <w>rozcuchával</w> synovi vlasy."
                            }
                        },
                        {
                            "text": "She kept <w>tousling</w> her hair to give it a more relaxed look.",
                            "target_lang_translations": {
                                "cs": "Neustále si <w>rozcuchávala</w> vlasy, aby vypadaly uvolněněji."
                            }
                        }
                    ],
                    "synonyms": [
                        "messing",
                        "ruffling",
                        "disheveling"
                    ],
                    "antonyms": [
                        "smoothing",
                        "combing"
                    ],
                    "common_phrases": [
                        "tousling hair"
                    ],
                    "target_lang_definitions": {
                        "cs": "Činnost, při které se někomu rozcuchávají nebo rozcuchávají vlasy."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "rozcuchávat",
                                "target_lang_sense_clarification": "aktivní proces dělání vlasů neupravenými"
                            },
                            {
                                "target_lang_word": "prohrabovat",
                                "target_lang_sense_clarification": "častý způsob rozcuchání vlasů rukou"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c0399545-89cc-3644-a153-7c99e1151ce3",
                    "sense_definition": "The act of making someone's hair messy or untidy.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hair_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The playful <w>tousling</w> of his hair made him feel like a child again.",
                            "target_lang_translations": {
                                "cs": "To hravé <w>rozcuchání</w> vlasů v něm vyvolalo pocit, že je zase dítětem."
                            }
                        },
                        {
                            "text": "She disliked the constant <w>tousling</w> of her carefully styled hair by her friends.",
                            "target_lang_translations": {
                                "cs": "Neměla ráda, když jí kamarádi neustále <w>rozcuchávali</w> pečlivě upravený účes."
                            }
                        }
                    ],
                    "synonyms": [
                        "ruffling"
                    ],
                    "target_lang_definitions": {
                        "cs": "Akt nebo proces, při kterém se někomu rozcuchávají vlasy."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "rozcuchání",
                                "target_lang_sense_clarification": "podstatné jméno vyjadřující děj rozcuchání"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}