                                "target_lang_word": "sinister",
                                "target_lang_sense_clarification": "dreigend en duister"
                            },
                            {
                                "target_lang_word": "omineus",
                                "target_lang_sense_clarification": "een slecht voorteken inhoudend"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e9c044e-7e67-3484-bb57-57ae80839514",
                    "sense_definition": "Extremely bad in quality; awful or terrible.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team's performance was <w>dire</w>, leading to a humiliating defeat.",
                            "target_lang_translations": {
                                "ru": "Игра команды была <w>ужасной</w>, что привело к унизительному поражению.",
                                "nl": "Het optreden van het team was <w>belabberd</w>, wat leidde tot een vernederende nederlaag."
                            }
                        },
                        {
                            "text": "I had to leave the theater because the acting was absolutely <w>dire</w>.",
                            "target_lang_translations": {
                                "ru": "Мне пришлось уйти из театра, потому что актерская игра была просто <w>отвратительной</w>.",
                                "nl": "Ik moest het theater verlaten omdat het acteerwerk werkelijk <w>verschrikkelijk</w> was."
                            }
                        }
