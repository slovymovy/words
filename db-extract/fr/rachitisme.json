        "fr-extract.jsonl": [
            {
                "entry_id": "c07de1a7-75f0-3cc4-b3a7-30bea01ab0ee",
                "word": "rachitisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a7e11d7e-73f8-40ec-8644-5b948885a8d1",
                        "entry_id": "c07de1a7-75f0-3cc4-b3a7-30bea01ab0ee",
                        "tags": [
                            "plural"
