                        "examples": [
                            {
                                "example_id": "6a5ef289-6ff1-475a-989e-60615b6b2530",
                                "sense_id": "d61db138-8563-3107-b4ba-ad4aab525b87",
                                "text": "Not using magic is what wizarding is all about!"
                            },
                            {
                                "example_id": "1a03d2d2-47c7-401d-b848-1c5f00437dec",
                                "sense_id": "d61db138-8563-3107-b4ba-ad4aab525b87",
                                "text": "And he said he knew the paper was but a forgery, my lord; that His Highness, Rechad Effendi, had never seen it; that his master the American knew this too; that he had learnt all my lord's plans by wizarding, and knew them..."
                            },
                            {
                                "example_id": "1990383c-de75-40a3-955b-6a02ed13d8e2",
                                "sense_id": "d61db138-8563-3107-b4ba-ad4aab525b87",
                                "text": "For instance, when Dumbledore offered to pay him ten Galleons a week — a standard wizarding wage, but for an elf an embarras de richesses..."
                            },
                            {
                                "example_id": "d7bcde2c-799b-49b2-bd91-9d7afcb359f6",
                                "sense_id": "d61db138-8563-3107-b4ba-ad4aab525b87",
                                "text": "You are already a real wizard, he says, and the only way you’ll get any better is by wizarding."
                            }
                        ]
                    }
