                    "sense_definition": "A male given name from Old English.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My uncle <w>Edward</w> lives in a small house near the river.",
                            "target_lang_translations": {
                                "ru": "Мой дядя <w>Эдуард</w> живет в маленьком домике у реки.",
                                "zh": "我的<w>爱德华</w>叔叔住在河边的一所小房子里。"
                            }
                        },
                        {
                            "text": "King <w>Edward</w> was known for his leadership during the war.",
                            "target_lang_translations": {
                                "ru": "Король <w>Эдуард</w> был известен своими лидерскими качествами во время войны.",
                                "zh": "<w>爱德华</w>国王因其在战争期间展现的领导才能而闻名。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "King Edward",
                        "Prince Edward"
