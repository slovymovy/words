                ],
                "senses": [
                    {
                        "sense_id": "c4638fa4-a1a6-3500-960c-34ec67722419",
                        "entry_id": "507c5f7f-b1a9-3eed-a2bb-7ce8c0bafcf3",
                        "glosses": [
                            "Besitz an Grund und Boden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd6f6e77-09cb-4f2b-9d9c-153a28e88489",
                                "sense_id": "c4638fa4-a1a6-3500-960c-34ec67722419",
                                "text": "„Erst 100 Jahre später hat Kaiser Ludwig der Fromme der Kirche den ehemaligen Grundbesitz auf dem Märtyrerberg zurückgegeben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "417754e2-2af3-4ff7-a957-7be74ad49c3a",
                        "source_entry_id": "507c5f7f-b1a9-3eed-a2bb-7ce8c0bafcf3",
                        "source_sense_id": "c4638fa4-a1a6-3500-960c-34ec67722419",
                        "source_sense_description": "Besitz an Grund und Boden",
                        "target_lang_word": "grondbezit",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grondbezit",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "02372c40-1cf1-3328-9343-3577832fe566",
                                        "entry_id": "667f3703-61ef-3a2a-8aa5-cc7be277fa0b",
                                        "glosses": [
                                            "het in eigendom hebben van een stuk van de aarde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99356a80-fa7e-439e-ae8d-6d789dfd7f2c",
                                                "sense_id": "02372c40-1cf1-3328-9343-3577832fe566",
                                                "text": "De gegevens die nodig zijn om een en ander nauwkeurig te berekenen zijn niet overal en altijd voorhanden. Hoe verder je teruggaat in de tijd, hoe fragmentarischer de gegevens zijn. Inkomstenbelastingen zijn al een zeldzaamheid vóór 1900. Vaak werkt Scheidel met guesstimates: schattingen op basis van de bronnen die wel beschikbaar zijn, zoals heffingen over luxe bezit in middeleeuwse steden, patronen van grondbezit, grondrentes in verhouding tot arbeidslonen, geregistreerde erfenissen en bruidsschatten. Voor prehistorische tijden werkt hij met archeologische data over de verspreiding van stenen werktuigen en de oppervlakte van huizen. Hij kijkt naar ongelijkheid binnen samenlevingen en staten; hij gaat niet in op ongelijkheid tussen landen."
                                            },
                                            {
                                                "example_id": "e8d1f679-b6ef-4960-ae89-8aa57ea3528c",
                                                "sense_id": "02372c40-1cf1-3328-9343-3577832fe566",
                                                "text": "Het Israëlische parlement, de Knesset, heeft maandagavond laat ingestemd met een omstreden wet die de bouw van vierduizend illegale woningen legaliseert op de bezette Westelijke Jordaanoever. De Knesset stemde met 60 stemmen voor en 52 tegen. De wet geeft de overheid het recht om privaat grondbezit van Palestijnen met terugwerkende kracht te onteigenen, daar waar al Joodse nederzettingen zijn verrezen zoals in Amona en delen van Ofra."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8d82c46-c724-3458-bacc-b31d0701d7cb",
                                        "entry_id": "667f3703-61ef-3a2a-8aa5-cc7be277fa0b",
                                        "glosses": [
                                            "de grond die men in eigendom heeft"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
