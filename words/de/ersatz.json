                },
                {
                    "sense_id": "1c75eecd-49f4-30ac-9fbb-dcba002a9317",
                    "sense_definition": "Der Vorgang des Auswechselns oder Ersetzens von Personen oder Dingen.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "austausch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der <w>Ersatz</w> alter Heizungsanlagen durch moderne Wärmepumpen spart langfristig viel Energie."
                        },
                        {
                            "text": "Nach dem plötzlichen Ausfall der Maschine mussten die Techniker schnell für <w>Ersatz</w> sorgen."
