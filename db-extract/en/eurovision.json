                                                "example_id": "59e975df-f2b4-442f-afce-16a3833da7cd",
                                                "sense_id": "0b1ac0de-e8d5-3095-91fd-1bf1e13b27ab",
                                                "text": "En tant que Canadienne, l’Eurovision, ça fait rêver, assure l’autrice, compositrice et interprète originaire de Longueuil, près de Montréal."
                                            }
                                        ]
                                    }
                                ]
