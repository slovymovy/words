                        "glosses": [
                            "Personne qui caillasse, qui jette des projectiles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83fb376e-fa35-4991-8011-1cb1dbfd37a5",
                                "sense_id": "9016054d-2f22-3e71-a180-106980855c3d",
                                "text": "Un peu plus loin, un autre jeune qui observe la scène commence à caillasser le véhicule de police et les fonctionnaires, rejoints par un second équipage qui interpelle également le caillasseur."
                            },
                            {
                                "example_id": "8dd4c1d6-a68a-4de8-86b7-b5368c0239f1",
                                "sense_id": "9016054d-2f22-3e71-a180-106980855c3d",
                                "text": "Les parebrises des voitures volent en éclats, il y a des blessés, on a même eu a déplorer des victimes, mais rien n’arrête l’ardeur des caillasseurs."
                            }
                        ]
                    }
