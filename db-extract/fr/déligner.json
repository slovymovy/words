                "senses": [
                    {
                        "sense_id": "789f2634-8519-3d16-8dda-cbc89f2656f9",
                        "entry_id": "10f20936-3d26-379e-b634-225896809463",
                        "glosses": [
                            "Scier dans le sens du fil du bois, en particulier pour dresser les bords d’une pièce et lui donner la largeur voulue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2328ba9-8ddf-4ed7-b3f0-00f2b8ff0ad0",
                                "sense_id": "789f2634-8519-3d16-8dda-cbc89f2656f9",
                                "text": "Yates, Fay-Egan, Smith, etc. en Amérique, Kiessling, Erfordia, etc. en Allemagne, construisent des scies à ruban à déligner se rapprochant beaucoup de la machine précédente."
                            },
                            {
                                "example_id": "9521a3cd-6d6b-4f09-ab9a-8813dd01b336",
                                "sense_id": "789f2634-8519-3d16-8dda-cbc89f2656f9",
                                "text": "Aidé par des bénévoles, la grosse grume, coupée en deux, a été installée sur le chariot à déligner. Jean-Claude retrouvant les gestes anciens, devant les yeux curieux, deux poutres ont pris forme."
                            }
                        ]
                    }
