                    "semantic_group_id": "verbaal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>eigen</w> mij deze methode langzaam maar zeker toe.",
                            "target_lang_translations": {
                                "en": "I am slowly but surely <w>mastering</w> this method.",
                                "ru": "Я медленно, но верно <w>осваиваю</w> этот метод."
