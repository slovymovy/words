                ],
                "senses": [
                    {
                        "sense_id": "06af0192-6c30-357a-a15f-aec088e85e46",
                        "entry_id": "7ee797b6-ee60-36e0-b144-99be5951f68c",
                        "glosses": [
                            "Enlever sa chemise à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95ec7c38-370e-4964-8b0a-0b6ed6e5b6f7",
                                "sense_id": "06af0192-6c30-357a-a15f-aec088e85e46",
                                "text": "Un inventaire minutieux fut dressé de tout ce qu'il possédait sur lui, on nota les pièces d'argent dans ses poches, on inscrivit le velours de son manteau, on porta mention des jabots de sa chemise, on le fit déchausser, déculotter, déchemiser, dénuder entièrement, une ordure entrouvrit l’orifice pour y chercher une pierre précieuse, Melchior lui aurait pété à la figure !"
                            },
                            {
                                "example_id": "388a8721-2e93-4b11-9510-8690d2ce8458",
                                "sense_id": "06af0192-6c30-357a-a15f-aec088e85e46",
                                "text": "Vous étiez d’abord apprehendé, ensuite fouillé, déboursé, puis de la tête aux pieds deshabillé, C’est à sçavoir, débonneté, décapuchonné, décaloté, décasaqué, désoutané, décamisolé, dépantalonné, déchemisé, débragué, décalsonné, débâté, enfin meurtri, contusionné, navré, occis, & en cet état votre ennemi vent coulis pouvant vous souffler au derriere en toute liberté."
                            },
                            {
                                "example_id": "db29e804-7f12-4a88-9583-8758580570ca",
                                "sense_id": "06af0192-6c30-357a-a15f-aec088e85e46",
                                "text": "Il gagne la véranda de la cour et se déchemise pour sa toilette."
                            }
                        ]
                    },
