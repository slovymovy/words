                                "en": "The old goat angrily shook his <w>beard</w>.",
                                "fr": "Le vieux bouc secouait sa <w>barbe</w> d'un air furieux."
                            }
                        },
                        {
                            "text": "У этой собаки смешная <w>борода</w> клином.",
                            "target_lang_translations": {
                                "en": "This dog has a funny wedge-shaped <w>beard</w>.",
                                "fr": "Ce chien a une drôle de <w>barbiche</w> en pointe."
                            }
                        }
                    ],
                    "common_phrases": [
                        "козлиная борода",
                        "трясти бородой"
                    ],
                    "target_lang_definitions": {
