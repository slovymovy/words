                                        "glosses": [
                                            "Any of a wide range of music and dance styles originating from Recife, Pernambuco, Brazil, and traditionally associated with Brazilian carnival."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
