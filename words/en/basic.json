{
    "word_family": [
        "base",
        "basis",
        "basically",
        "basal"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b11dde21-c37e-3fdd-a924-2f9578153cb0",
                    "sense_definition": "Elementary, simple, or merely functional without unnecessary extras.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "simple_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel room was very <w>basic</w> but clean and comfortable.",
                            "target_lang_translations": {
                                "ru": "Номер в отеле был очень <w>просты́м</w>, но чистым и уютным.",
                                "tr": "Otel odası oldukça <w>sadeydi</w> ama temiz ve konforluydu.",
                                "zh": "酒店房间非常<w>简单</w>，但干净舒适。"
                            }
                        },
                        {
                            "text": "He has a <w>basic</w> understanding of how the engine works.",
                            "target_lang_translations": {
                                "ru": "У него есть <w>ба́зовое</w> понимание того, как работает двигатель.",
                                "tr": "Motorun nasıl çalıştığına dair <w>temel</w> bir anlayışa sahip.",
                                "zh": "他对引擎的工作原理有<w>基础</w>的了解。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "basic skills",
                        "basic knowledge",
                        "basic understanding"
                    ],
                    "target_lang_definitions": {
                        "ru": "Элементарный, простой или чисто функциональный, без излишеств.",
                        "tr": "Gereksiz teferruatları olmayan, basit, temel veya yalın.",
                        "zh": "基础的、简单的，或者仅具备基本功能而没有多余装饰的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ба́зовый",
                                "target_lang_sense_clarification": "служащий основой; начальный"
                            },
                            {
                                "target_lang_word": "элемента́рный",
                                "target_lang_sense_clarification": "простейший, начальный"
                            },
                            {
                                "target_lang_word": "просто́й",
                                "target_lang_sense_clarification": "скромный, без излишеств"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "temel",
                                "target_lang_sense_clarification": "başlangıç düzeyinde, yalın"
                            },
                            {
                                "target_lang_word": "basit",
                                "target_lang_sense_clarification": "sade, karmaşık olmayan"
                            },
                            {
                                "target_lang_word": "sade",
                                "target_lang_sense_clarification": "gösterişsiz, ekstra özelliği olmayan"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "基础的",
                                "target_lang_sense_clarification": "作为起点的，入门级的"
                            },
                            {
                                "target_lang_word": "简单的",
                                "target_lang_sense_clarification": "朴素的，没有多余装饰的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69b832b5-f85e-36bc-ab92-eade6e676c58",
                    "sense_definition": "Necessary and essential for life or a specific process.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "essential_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Clean water is a <w>basic</w> human need.",
                            "target_lang_translations": {
                                "ru": "Чистая вода — это <w>ба́зовая</w> потребность человека.",
                                "tr": "Temiz su <w>temel</w> bir insani ihtiyaçtır.",
                                "zh": "清洁的饮用水是人类<w>基本</w>的需求。"
                            }
                        },
                        {
                            "text": "Freedom of speech is considered a <w>basic</w> right in many countries.",
                            "target_lang_translations": {
                                "ru": "Свобода слова считается <w>основны́м</w> правом во многих странах.",
                                "tr": "İfade özgürlüğü birçok ülkede <w>temel</w> bir hak olarak kabul edilir.",
                                "zh": "在许多国家，言论自由被视为一项<w>基本</w>权利。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "basic needs",
                        "basic human right",
                        "basic ingredient"
                    ],
                    "target_lang_definitions": {
                        "ru": "Необходимый и жизненно важный для жизни или определенного процесса.",
                        "tr": "Yaşam veya belirli bir süreç için gerekli ve hayati olan.",
                        "zh": "对生活或特定过程而言是必要且不可或缺的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "основно́й",
                                "target_lang_sense_clarification": "главный, наиболее важный"
                            },
                            {
                                "target_lang_word": "фундамента́льный",
                                "target_lang_sense_clarification": "являющийся основой, существенный"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "temel",
                                "target_lang_sense_clarification": "asli, vazgeçilmez"
                            },
                            {
                                "target_lang_word": "eski",
                                "target_lang_sense_clarification": "kökten gelen, ana unsura ait"
                            },
                            {
                                "target_lang_word": "ana",
                                "target_lang_sense_clarification": "en önemli, birincil"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "基本的",
                                "target_lang_sense_clarification": "核心的，不可或缺的"
                            },
                            {
                                "target_lang_word": "根本的",
                                "target_lang_sense_clarification": "具有决定性意义的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5c089f1-43c6-3a4b-876f-b41a8b3dac98",
                    "sense_definition": "Unremarkable, uninteresting, or unoriginal due to following mainstream trends.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "slang_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She thinks popular pop music is too <w>basic</w> and prefers indie bands.",
                            "target_lang_translations": {
                                "ru": "Она считает популярную поп-музыку слишком <w>примити́вной</w> и предпочитает инди-группы.",
                                "tr": "Popüler pop müziğin fazla <w>sıradan</w> olduğunu düşünüyor ve bağımsız grupları tercih ediyor.",
                                "zh": "她认为流行的流行音乐太<w>平庸</w>了，更喜欢独立乐队。"
                            }
                        },
                        {
                            "text": "Don't be so <w>basic</w>; try to develop your own unique style.",
                            "target_lang_translations": {
                                "ru": "Не будь таким <w>зауря́дным</w>; постарайся выработать свой собственный уникальный стиль.",
                                "tr": "Bu kadar <w>sıradan</w> olma; kendine has bir tarz geliştirmeye çalış.",
                                "zh": "别那么<w>俗气</w>；试着培养自己独特的风格。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "basic taste"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used pejoratively to describe someone or something as mainstream or boring."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ничем не примечательный, скучный или неоригинальный; следующий массовым трендам.",
                        "tr": "Popüler trendleri takip ettiği için sıradan, özgün olmayan veya sıkıcı.",
                        "zh": "因盲目追随主流趋势而显得平庸、无趣或缺乏原创性。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зауря́дный",
                                "target_lang_sense_clarification": "обыденный, ничем не выделяющийся"
                            },
                            {
                                "target_lang_word": "примити́вный",
                                "target_lang_sense_clarification": "слишком простой, неинтересный"
                            },
                            {
                                "target_lang_word": "посре́дственный",
                                "target_lang_sense_clarification": "неоригинальный, шаблонный"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sıradan",
                                "target_lang_sense_clarification": "özelliği olmayan, basmakalıp"
                            },
                            {
                                "target_lang_word": "sığ",
                                "target_lang_sense_clarification": "derinliği olmayan, klişe"
                            },
                            {
                                "target_lang_word": "basit",
                                "target_lang_sense_clarification": "yüzeysel, özgünlükten uzak"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "平庸的",
                                "target_lang_sense_clarification": "没有特点的，随大流的"
                            },
                            {
                                "target_lang_word": "俗气的",
                                "target_lang_sense_clarification": "缺乏品味的，大众化的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c3a6457-23bd-396a-beda-7838788838fa",
                    "sense_definition": "Relating to a chemical base; having a pH greater than 7.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "chemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Soap is a <w>basic</w> substance that feels slippery to the touch.",
                            "target_lang_translations": {
                                "ru": "Мыло — это <w>щелочно́е</w> вещество, скользкое на ощупь.",
                                "tr": "Sabun, dokunulduğunda kayganlık hissi veren <w>bazik</w> bir maddedir.",
                                "zh": "肥皂是一种<w>碱性</w>物质，摸起来滑滑的。"
                            }
                        },
                        {
                            "text": "The solution became <w>basic</w> after we added the ammonia.",
                            "target_lang_translations": {
                                "ru": "Раствор стал <w>щелочны́м</w> после того, как мы добавили аммиак.",
                                "tr": "Amonyak ekledikten sonra çözelti <w>bazik</w> hale geldi.",
                                "zh": "加入氨水后，溶液变成了<w>碱性</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "alkaline"
                    ],
                    "antonyms": [
                        "acidic"
                    ],
                    "common_phrases": [
                        "basic solution",
                        "basic compound"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к химическому основанию; имеющий pH больше 7.",
                        "tr": "Kimyasal bir bazla ilgili olan; pH değeri 7'den büyük olan.",
                        "zh": "与化学碱基有关；pH值大于7。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щелочно́й",
                                "target_lang_sense_clarification": "содержащий щелочь"
                            },
                            {
                                "target_lang_word": "осно́вный",
                                "target_lang_sense_clarification": "химический термин"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "bazik",
                                "target_lang_sense_clarification": "pH değeri 7'den büyük olan"
                            },
                            {
                                "target_lang_word": "alkali",
                                "target_lang_sense_clarification": "bazik özellik gösteren"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "碱性的",
                                "target_lang_sense_clarification": "化学术语，指碱性物质"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5a7bc32d-0d50-33c8-8095-cd812e482f48",
                    "sense_definition": "An elementary building block or fundamental piece of knowledge.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "noun_fundamentals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am learning the <w>basics</w> of computer programming.",
                            "target_lang_translations": {
                                "ru": "Я изучаю <w>осно́вы</w> компьютерного программирования.",
                                "tr": "Bilgisayar programlamanın <w>temellerini</w> öğreniyorum.",
                                "zh": "我正在学习计算机编程的<w>基础</w>。"
                            }
                        },
                        {
                            "text": "The coach spent the first week going over the <w>basics</w> of the game.",
                            "target_lang_translations": {
                                "ru": "Тренер потратил первую неделю на разбор <w>азо́в</w> игры.",
                                "tr": "Koç ilk haftayı oyunun <w>esaslarını</w> gözden geçirerek geçirdi.",
                                "zh": "教练花了一周时间讲解比赛的<w>入门</w>知识。"
                            }
                        }
                    ],
                    "common_phrases": [
