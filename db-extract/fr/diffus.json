                        "sense_id": "844e7868-2301-3fa6-af32-4028bbd2a347",
                        "entry_id": "39f18861-53b2-3f11-8676-f54d0a2a309b",
                        "glosses": [
                            "Qui se répand dans tous les sens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11b5d574-4dd9-4d79-900c-795db9b00713",
                                "sense_id": "844e7868-2301-3fa6-af32-4028bbd2a347",
                                "text": "Lumière diffuse, chaleur diffuse."
                            }
                        ]
                    },
                    {
                        "sense_id": "89b9fab5-9626-36dc-9066-ef5fe5d3a841",
                        "entry_id": "39f18861-53b2-3f11-8676-f54d0a2a309b",
                        "glosses": [
                            "Qui est renvoyé par réflexion irrégulière."
                        ],
                        "tags": [
                            "especially",
                            "physical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1a65e58c-f9ba-3e9d-a245-6448b2c9856c",
                        "entry_id": "39f18861-53b2-3f11-8676-f54d0a2a309b",
                        "glosses": [
                            "Dont les ramifications, naissant de tous côtés, s’étalent horizontalement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3066a949-c385-471a-986b-4affb100225e",
                                "sense_id": "1a65e58c-f9ba-3e9d-a245-6448b2c9856c",
                                "text": "La tige diffuse de la fumeterre."
                            },
                            {
                                "example_id": "55f297cc-5aae-49b0-8edd-cc8095b9b450",
                                "sense_id": "1a65e58c-f9ba-3e9d-a245-6448b2c9856c",
                                "text": "Des rameaux diffus."
                            }
                        ]
                    },
                    {
                        "sense_id": "95fecd16-f0de-3346-9252-132a41b95477",
                        "entry_id": "39f18861-53b2-3f11-8676-f54d0a2a309b",
                        "glosses": [
                            "Qualifie ce qui exprime la pensée avec trop d’abondance et sans ordre."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "2fb680b9-9b1a-418c-be04-2fe6d16144cc",
                                "sense_id": "95fecd16-f0de-3346-9252-132a41b95477",
                                "text": "Derrière l’amertume de ses renvois d'estomac, il ressentait comme un sentiment diffus de corruption."
                            },
                            {
                                "example_id": "85751529-3c0c-44e3-b10c-e4bc4fa312ec",
                                "sense_id": "95fecd16-f0de-3346-9252-132a41b95477",
                                "text": "Style diffus. — Langage diffus."
                            },
                            {
                                "example_id": "6ea46b77-38ed-4b09-a029-7555c9f07a56",
                                "sense_id": "95fecd16-f0de-3346-9252-132a41b95477",
                                "text": "Tout ce qu’il écrit est presque incompréhensible à force d’être diffus. — Un écrivain diffus."
                            },
                            {
                                "example_id": "00944437-f55f-49b9-8e8d-de25d3e1adc0",
                                "sense_id": "95fecd16-f0de-3346-9252-132a41b95477",
                                "text": "Corsi.– C’est le meilleur prince du monde.\nGuicciardini.– Hé ! hé ! pas tout à fait cela. Si vous disiez le plus diffus et le plus poli des princes, ce serait plus vrai."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d83cdf9-2b68-477d-a936-112dee467d9e",
                        "source_entry_id": "39f18861-53b2-3f11-8676-f54d0a2a309b",
