    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9b3cd0e0-16de-327e-ab69-279a7732abeb",
                    "sense_definition": "iets op een klagende of berustende toon uitspreken, vaak gepaard gaand met een zucht",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "manier van spreken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "\"Het is me wat\", <w>verzuchtte</w> hij terwijl hij naar de puinhoop keek.",
                            "target_lang_translations": {
                                "en": "\"It's quite something,\" he <w>sighed</w> while looking at the mess."
                            }
                        },
                        {
                            "text": "Eindelijk thuis, <w>verzuchtte</w> ze na een lange dag op kantoor.",
                            "target_lang_translations": {
                                "en": "Finally home, she <w>sighed</w> after a long day at the office."
                            }
                        }
                    ],
                    "common_phrases": [
                        "diep verzuchten",
                        "moedeloos verzuchten"
                    ],
                    "target_lang_definitions": {
                        "en": "To say something in a complaining or resigned tone, often accompanied by a sigh"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to sigh",
                                "target_lang_sense_clarification": "to say something while sighing"
                            },
                            {
                                "target_lang_word": "to utter with a sigh",
                                "target_lang_sense_clarification": "to speak in a weary or resigned manner"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c59e54dd-9184-3f65-94e1-ca342ef1fbbb",
                    "sense_definition": "iets op een smachtende of verlangende toon uitspreken",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "manier van spreken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "\"God, wat geweldig\", <w>verzucht</w> ze wanneer ze de prachtige zonsondergang ziet.",
                            "target_lang_translations": {
                                "en": "\"God, how wonderful,\" she <w>sighed</w> when she saw the beautiful sunset."
                            }
                        },
                        {
                            "text": "Hij <w>verzuchtte</w> haar naam in de hoop dat ze hem zou horen.",
                            "target_lang_translations": {
                                "en": "He <w>breathed</w> her name in the hope that she would hear him."
                            }
                        }
                    ],
                    "common_phrases": [
                        "verlangend verzuchten"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak in literaire context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To say something in a yearning or longing tone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to sigh",
                                "target_lang_sense_clarification": "to utter longingly"
                            },
                            {
                                "target_lang_word": "to breathe",
                                "target_lang_sense_clarification": "to say softly and longingly"
                            }
                        ]
                    }
                }
            ]
        }
    ]
