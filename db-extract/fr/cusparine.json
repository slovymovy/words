                "senses": [
                    {
                        "sense_id": "afd96d29-77b7-36f8-a9e8-1a0c284ce986",
                        "entry_id": "5c2f6d50-5408-3720-b6a5-bbc5e73a7535",
                        "glosses": [
                            "Alcaloïde extrait de l’écorce de l’angusture vraie (Angostura trifoliata), de formule C₁₉H₁₇NO₃."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ed6b45a-7a53-4b4d-bf70-9f689c870fb7",
                                "sense_id": "afd96d29-77b7-36f8-a9e8-1a0c284ce986",
                                "text": "Cette substance (que je nommerai Cusparine, de Cusparia), n’offre pas de réaction acide ni basique."
                            },
                            {
                                "example_id": "38e5946f-790f-4168-93b2-b9ee7c18ea6f",
                                "sense_id": "afd96d29-77b7-36f8-a9e8-1a0c284ce986",
                                "text": "La cusparine a été trouvée, en 1833, par M. Saladin, dans l’écorce d’angusture vraie."
                            },
                            {
                                "example_id": "745f4fe2-f0f4-4543-9444-5d3fb3128a04",
                                "sense_id": "afd96d29-77b7-36f8-a9e8-1a0c284ce986",
                                "text": "Il (= Saladin) lui a donné le nom de cusparine, de cusparia febrifuga, nom donné par Humboldt à la plante mère de l’écorce."
                            }
                        ]
                    }
                ],
