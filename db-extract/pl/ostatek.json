                "translations": [
                    {
                        "translation_id": "ea1ebac0-b9a5-4cbf-943d-0bcdd78f5c31",
                        "source_entry_id": "09973d9f-cf2b-32b1-a581-900fce6c369f",
                        "source_sense_id": "1222b83b-7db5-3de2-8bb9-371b6393b180",
                        "target_lang_word": "Rest",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rest",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9c400bfc-ebd6-393d-b661-c9651f5f0bec",
                                        "entry_id": "bd7465bb-4eab-3465-89d5-7d698db73391",
                                        "glosses": [
                                            "übrig bleibender Teil des Ganzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90e86f89-538f-4fdb-b3cc-f2929e76f5a0",
                                                "sense_id": "9c400bfc-ebd6-393d-b661-c9651f5f0bec",
                                                "text": "Auf seinem Teller blieb noch ein kleiner Rest Fleisch liegen."
                                            },
                                            {
                                                "example_id": "bcc663de-0b66-4244-ab68-939297e3ad65",
                                                "sense_id": "9c400bfc-ebd6-393d-b661-c9651f5f0bec",
                                                "text": "Ich möchte keine Reste essen, kannst du nicht was Ordentliches kochen?"
                                            },
                                            {
                                                "example_id": "ea455f32-2134-47f4-af18-a03e59d8e15b",
                                                "sense_id": "9c400bfc-ebd6-393d-b661-c9651f5f0bec",
                                                "text": "Und aus den Resten habe ich dann ein Faschingskostüm genäht."
                                            },
                                            {
                                                "example_id": "35013906-c32c-4d79-a37d-9fccddd38ab9",
                                                "sense_id": "9c400bfc-ebd6-393d-b661-c9651f5f0bec",
                                                "text": "„Die letzten Reste des Westjiddischen wurden von Wissenschaftlern nach den Zweiten Weltkrieg im Elsass, der Schweiz und in Südwestdeutschland aufgezeichnet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f3f9c706-c184-34c2-bfde-ae1dbbd4037a",
                                        "entry_id": "bd7465bb-4eab-3465-89d5-7d698db73391",
                                        "glosses": [
                                            "nicht ganzzahlig teilbarer Teil des Dividenden"
                                        ],
                                        "tags": [
                                            "Arithmetik",
                                            "Divison"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd664da8-1873-415e-8368-16c97640d394",
                                                "sense_id": "f3f9c706-c184-34c2-bfde-ae1dbbd4037a",
                                                "text": "5 : 4 = 1, Rest: 1"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4712c4d6-37d4-323f-94bf-025069f6a7e4",
                                        "entry_id": "bd7465bb-4eab-3465-89d5-7d698db73391",
                                        "glosses": [
                                            "funktionelle Gruppe an einem Molekülgerüst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ab1ee48-91ca-4acd-ba00-de92a207b2b9",
                                                "sense_id": "4712c4d6-37d4-323f-94bf-025069f6a7e4",
                                                "text": "Aminosäuren (AS) unterscheiden sich durch den organischen Rest (R), der an der Grundstruktur des Moleküls angebunden ist."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Rest",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6ebf6ca0-613f-3a96-8fa5-d656edae0716",
                                        "entry_id": "d2c11ef6-f7a8-3cde-8838-a5ef24c0ecfa",
                                        "glosses": [
                                            "deutscher Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ba4ed11-c631-47bc-b52e-b5d8a90a0e5e",
                                                "sense_id": "6ebf6ca0-613f-3a96-8fa5-d656edae0716",
                                                "text": "„Willkommen bei der Firma der Familie Rest einem der innovativsten Unternehmen der Branche in Deutschland.“"
                                            }
