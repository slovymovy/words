                                    {
                                        "sense_id": "cdc9f742-c76f-39f2-a160-5b5a686533ee",
                                        "entry_id": "5831b61f-0e6d-3972-b8ae-4a4c75542877",
                                        "glosses": [
                                            "To become brown."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b7682c8-99a4-4d37-82cb-dedb8b78f20d",
                                                "sense_id": "cdc9f742-c76f-39f2-a160-5b5a686533ee",
                                                "text": "Fry the onions until they brown."
                                            },
                                            {
                                                "example_id": "63077901-e329-4ed5-8262-f5b1bc79bcb2",
                                                "sense_id": "cdc9f742-c76f-39f2-a160-5b5a686533ee",
                                                "text": "The chicken was browning nicely, the skin beginning to crisp and take on the toasty tones of oiled wood."
                                            },
                                            {
                                                "example_id": "02c71f9f-e750-4ced-98e3-03557fff6a11",
                                                "sense_id": "cdc9f742-c76f-39f2-a160-5b5a686533ee",
                                                "text": "Don't microwave your milk too long\nIt browns and bubbles over"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9a3f0d6-ebdd-3d08-91ea-b0b2cccea1c7",
                                        "entry_id": "5831b61f-0e6d-3972-b8ae-4a4c75542877",
                                        "glosses": [
                                            "To cook something until it becomes brown."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b08acbd-5bc8-4d70-8863-fbfb5c966afe",
                                                "sense_id": "b9a3f0d6-ebdd-3d08-91ea-b0b2cccea1c7",
                                                "text": "Pound an onion, warm a spoonful of ghee and throw in the onion, brown it slightly, add your curry stuff, brown this till it smells pleasantly, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbfc58d4-553d-3e14-b744-4cf713911d83",
                                        "entry_id": "5831b61f-0e6d-3972-b8ae-4a4c75542877",
                                        "glosses": [
                                            "To tan."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bcc301e-4615-4971-9289-b898c6732893",
                                                "sense_id": "bbfc58d4-553d-3e14-b744-4cf713911d83",
                                                "text": "Light-skinned people tend to brown when exposed to the sun."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0411c9cd-1258-3ec1-9085-ee1e91adb402",
                                        "entry_id": "5831b61f-0e6d-3972-b8ae-4a4c75542877",
                                        "glosses": [
                                            "To make brown or dusky."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25588cb2-e3f1-43f9-9831-92c9b1c21a27",
                                                "sense_id": "0411c9cd-1258-3ec1-9085-ee1e91adb402",
                                                "text": "A trembling twilight o'er the welkin moves, / Browns the dim void and darkens deep the groves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c7f97e6-111d-3252-b816-33e017ba88ae",
                                        "entry_id": "5831b61f-0e6d-3972-b8ae-4a4c75542877",
                                        "glosses": [
                                            "To give a bright brown colour to, as to gun barrels, by forming a thin coating of oxide on their surface."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc273bcd-aafe-4123-a306-5453b50843f0",
                                                "sense_id": "1c7f97e6-111d-3252-b816-33e017ba88ae",
                                                "text": "It is mixed uniformly with olive oil, and rubbed upon the iron slightly heated, which is afterwards exposed to the air, till the wished-for degree of browning is produced."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14799da3-04eb-3840-8b6d-2072af92f513",
                                        "entry_id": "5831b61f-0e6d-3972-b8ae-4a4c75542877",
                                        "glosses": [
                                            "To turn progressively more Hispanic or Latino, in the context of the population of a geographic region."
                                        ],
