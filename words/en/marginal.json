                },
                {
                    "sense_id": "996cb116-48c6-3b39-a002-f444c584ca9b",
                    "sense_definition": "Excluded from or existing outside the main current of a society or group.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "social",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The charity provides support for <w>marginal</w> groups who are often ignored by the state.",
                            "target_lang_translations": {
                                "ru": "Благотворительная организация оказывает поддержку <w>маргинальным</w> группам, которые часто игнорируются государством.",
                                "zh": "这家慈善机构为常常被国家忽视的<w>边缘化的</w>群体提供支持。"
                            }
                        },
                        {
                            "text": "Being <w>marginal</w> in society makes it difficult to access basic healthcare services.",
                            "target_lang_translations": {
                                "ru": "Будучи <w>маргиналом</w> в обществе, трудно получить доступ к базовым медицинским услугам.",
                                "zh": "在社会中处于<w>边缘</w>地位，会让人难以获得基本医疗服务。"
                            }
