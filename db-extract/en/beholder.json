                                    {
                                        "sense_id": "0dbd2fbd-b927-3900-a731-dc2f4215ec3b",
                                        "entry_id": "cbda832a-cbb9-3a68-863f-ce4fe95edc6b",
                                        "glosses": [
                                            "jemand, der sich etwas anschaut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "706fcb70-9328-44aa-8b12-3c4a12d3d112",
                                                "sense_id": "0dbd2fbd-b927-3900-a731-dc2f4215ec3b",
                                                "text": "Der Betrachter sieht zunächst nur eines der zwei abgebildeten Gesichter."
                                            },
                                            {
                                                "example_id": "e4c34b6b-6cbc-4bb7-9a60-efd3a4c8d09f",
                                                "sense_id": "0dbd2fbd-b927-3900-a731-dc2f4215ec3b",
                                                "text": "„Ein Gran Eifersucht erhöht den Reiz, den der Betrachter empfindet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52237202-c955-46e5-abbe-e2cc00372394",
                        "source_entry_id": "442612b0-fc90-3274-8da6-fc342efa21cc",
                        "source_sense_description": "someone who observes or beholds; an observer or spectator",
                        "target_lang_word": "Beobachter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beobachter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5fb1fa8e-598c-354a-8206-fbb74d741015",
                                        "entry_id": "35e5682f-f462-3826-8a87-516fa5520537",
                                        "glosses": [
                                            "jemand, der eine Person oder Situation beobachtet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ecc58d3-e12d-4aba-8e58-fb7bf7998f32",
                                                "sense_id": "5fb1fa8e-598c-354a-8206-fbb74d741015",
                                                "text": "„Verteidigungsminister Abdul Rahim Wardak sagte in Kabul, die Armee solle sich auf 240.000 Mann vergrößern; derzeit stehen rund 93.000 Soldaten unter Waffen. Dieses Ziel wird nach Ansicht von Beobachtern nur durch jahrelange massive Investitionen in die Ausbildung erreicht werden können.“"
                                            },
                                            {
                                                "example_id": "7393316c-2628-4707-853a-226a8b55eb65",
                                                "sense_id": "5fb1fa8e-598c-354a-8206-fbb74d741015",
                                                "text": "„John Hammond, stets ein aufmerksamer Beobachter der Ereignisse seiner Zeit, erkennt sehr bald, welche Umwälzungen Homer Capeharts Erfindung der Jukebox für die Phono-Industrie bringen wird.“"
                                            },
                                            {
                                                "example_id": "d13ba32c-3502-475d-8312-57bb13f46ce8",
                                                "sense_id": "5fb1fa8e-598c-354a-8206-fbb74d741015",
                                                "text": "„Pückler ist ein glänzender Beobachter, was ihn zum vorzüglichen Prosaschriftsteller macht.“"
                                            },
                                            {
                                                "example_id": "dce8a1a6-b899-457f-b6ca-37bc7e7f45e9",
                                                "sense_id": "5fb1fa8e-598c-354a-8206-fbb74d741015",
                                                "text": "„Ein ungemein genauer Beobachter seiner Zeit wurde er, ein radikaler, aber unideologischer Deuter der Politik, ein Menschenfreund, der auf Distanz blieb.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
