                    {
                        "sense_id": "39c931d5-0ab9-32f3-b2c9-cd71eef351d7",
                        "entry_id": "086c1ddf-254f-3d29-bade-d6edef383e3d",
                        "glosses": [
                            "Not limited or restricted; unrestrained; limitless."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40db3c54-05f3-4624-b835-44d15d8c36a5",
                                "sense_id": "39c931d5-0ab9-32f3-b2c9-cd71eef351d7",
                                "text": "The vivid, untrammeled life appealed to him, and for a time he had found delight in it; but he was wise and knew that once peace was established there would be no room in Cuba for the Sin Verguenza."
                            },
                            {
                                "example_id": "87238103-6bf9-4efc-a403-2814ddc4b43e",
                                "sense_id": "39c931d5-0ab9-32f3-b2c9-cd71eef351d7",
                                "text": "A system of untrammeled discretion exists when there are no limits on what officials may consider in reaching a decision [..]"
                            },
                            {
                                "example_id": "9c93c5bf-5858-405a-b2f0-4dac46c8d4ee",
                                "sense_id": "39c931d5-0ab9-32f3-b2c9-cd71eef351d7",
                                "text": "The family thinks highly of the new king, though he wasn’t the reason they trekked all the way from England. They wanted untrammeled nature, and they found it in every direction they walked."
                            }
                        ]
                    }
                ],
