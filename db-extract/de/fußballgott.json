                "senses": [
                    {
                        "sense_id": "9ab26404-0cbd-38b6-9163-57fe9dfc63da",
                        "entry_id": "c5df86ae-2e3d-3eee-84bd-f280769cda89",
                        "glosses": [
                            "ein genialer Fußballspieler, der nahezu Übermenschliches zu leisten im Stande ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bf1a8ac-01e7-4dc9-a43d-692a1b847854",
                                "sense_id": "9ab26404-0cbd-38b6-9163-57fe9dfc63da",
                                "text": "Fußballgötter wie Uwe Seeler und Pele haben nie den Boden unter den Füßen verloren."
                            },
                            {
                                "example_id": "2c1de9bf-ce76-4fef-8a40-8319a271c420",
                                "sense_id": "9ab26404-0cbd-38b6-9163-57fe9dfc63da",
                                "text": "„Im WM-Halbfinale schauen gleich sechs Belgier etwas bang auf den argentinischen Fußballgott Diego Maradona.“"
                            },
                            {
                                "example_id": "7b99f4cb-52bd-4bd4-83b1-aacda1a187dc",
                                "sense_id": "9ab26404-0cbd-38b6-9163-57fe9dfc63da",
                                "text": "„Spötter rufen ihn Flohtaxi, für Millionen Schotten und Schweden ist er ein Fußballgott. […] Sein Name: Henrik Larsson.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "451dd19b-7332-3e68-a2d7-099b292573f8",
                        "entry_id": "c5df86ae-2e3d-3eee-84bd-f280769cda89",
                        "glosses": [
                            "eine erdachte gottähnliche Instanz, die das Fußballgeschehen mal gerecht, mal scheinbar willkürlich beeinflusst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "921ef997-9eb6-4f34-88a6-ebc1b90ac446",
                                "sense_id": "451dd19b-7332-3e68-a2d7-099b292573f8",
                                "text": "„Fußballer glauben an diverse Götter: an den Fußballgott, an Allah und Buddha.“"
                            },
                            {
                                "example_id": "35863467-d4e3-4626-a1d8-21ebab97067a",
                                "sense_id": "451dd19b-7332-3e68-a2d7-099b292573f8",
                                "text": "„Der späte und kuriose Ausgleichstreffer in Bielefeld kann kein Zufall gewesen sein. Vielmehr ist er der Beweis dafür, dass es den Fußballgott eben doch gibt.“"
                            },
                            {
                                "example_id": "3a1cd15e-5e51-4915-8436-e28303528adf",
                                "sense_id": "451dd19b-7332-3e68-a2d7-099b292573f8",
                                "text": "„Als würde der Fußballgott sich erinnern, dass er jene, denen er mal einen Gefallen getan hat, auch irgendwann wieder bestrafen muss. Sonst nimmt ihm die ganze Sache ja keiner mehr ab.“"
                            },
                            {
                                "example_id": "e6086a64-6a6f-4588-af7f-712069726772",
                                "sense_id": "451dd19b-7332-3e68-a2d7-099b292573f8",
                                "text": "„Die stets ergebnisoffene Suche nach dem Sinn macht diesen Sport ja gerade so faszinierend. Und der Fußballgott ist auch deshalb ein Weltstar, weil niemand weiß, was er als nächstes ausheckt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
