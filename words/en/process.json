    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1c4663ac-e00b-319d-b184-74c65b88765d",
                    "sense_definition": "A series of actions or steps taken in order to achieve a particular end.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "noun_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hiring <w>process</w> took much longer than we expected.",
                            "target_lang_translations": {
                                "ru": "<w>Процесс</w> найма занял гораздо больше времени, чем мы ожидали.",
                                "tr": "İşe alım <w>süreci</w> beklediğimizden çok daha uzun sürdü."
                            }
                        },
                        {
                            "text": "We are currently in the <w>process</w> of selling our house.",
                            "target_lang_translations": {
                                "ru": "Мы сейчас в <w>процессе</w> продажи нашего дома.",
                                "tr": "Şu anda evimizi satma <w>sürecindeyiz</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "procedure",
                        "operation",
                        "method",
                        "system"
                    ],
                    "common_phrases": [
                        "in the process",
                        "decision-making process",
                        "learning process",
                        "peace process"
                    ],
                    "target_lang_definitions": {
                        "ru": "Серия действий или шагов, предпринимаемых для достижения определенной цели.",
                        "tr": "Belirli bir amaca ulaşmak için yapılan eylemler veya adımlar dizisi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "процесс",
                                "target_lang_sense_clarification": "ход, развитие"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "süreç",
                                "target_lang_sense_clarification": "gelişme, olaylar dizisi"
                            },
                            {
                                "target_lang_word": "proses",
                                "target_lang_sense_clarification": "teknik veya sanayi süreçleri"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b44aadb-75fb-3296-ba3e-1c699c7ea50c",
                    "sense_definition": "An instance of a computer program that is being executed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should close any unnecessary background <w>process</w> to speed up your computer.",
                            "target_lang_translations": {
                                "ru": "Вам следует закрыть любой ненужный фоновый <w>процесс</w>, чтобы ускорить работу компьютера.",
                                "tr": "Bilgisayarınızı hızlandırmak için gereksiz tüm arka plan <w>işlemlerini</w> kapatmalısınız."
                            }
                        },
                        {
                            "text": "The operating system manages every <w>process</w> running on the CPU.",
                            "target_lang_translations": {
                                "ru": "Операционная система управляет каждым <w>процессом</w>, запущенным на процессоре.",
                                "tr": "İşletim sistemi, işlemcide çalışan her <w>işlemi</w> yönetir."
                            }
                        }
                    ],
                    "synonyms": [
                        "task",
                        "program",
                        "application"
                    ],
                    "common_phrases": [
                        "background process"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Экземпляр компьютерной программы, которая выполняется в данный момент.",
                        "tr": "Bilgisayarda işlemci tarafından yürütülmekte olan aktif bir program veya görev."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "процесс",
                                "target_lang_sense_clarification": "информатика"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "işlem",
                                "target_lang_sense_clarification": "bilgisayar bilimleri"
                            },
                            {
                                "target_lang_word": "proses",
                                "target_lang_sense_clarification": "yürütülen program görevi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b0b696e-0479-3b6a-b5b9-5119cdbe3a62",
                    "sense_definition": "A summons or writ requiring a person to appear in court.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "noun_legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer argued that the legal <w>process</w> had not been served correctly.",
                            "target_lang_translations": {
                                "ru": "Адвокат утверждал, что судебная <w>повестка</w> не была вручена должным образом.",
                                "tr": "Avukat, yasal <w>tebligatın</w> doğru bir şekilde iletilmediğini savundu."
                            }
                        },
                        {
                            "text": "Every citizen is entitled to due <w>process</w> under the law.",
                            "target_lang_translations": {
                                "ru": "Каждый гражданин имеет право на надлежащее <w>судопроизводство</w> по закону.",
                                "tr": "Her vatandaş, kanunlar çerçevesinde adil <w>yargılanma</w> hakkına sahiptir."
                            }
                        }
                    ],
                    "synonyms": [
                        "summons",
                        "writ"
                    ],
                    "common_phrases": [
                        "due process",
                        "service of process",
                        "legal process"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "law"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Судебная повестка или предписание, требующее явки лица в суд.",
                        "tr": "Bir kişinin mahkemeye çıkmasını gerektiren resmi çağrı veya hukuki emir."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "судебная повестка",
                                "target_lang_sense_clarification": "документ"
                            },
                            {
                                "target_lang_word": "судопроизводство",
                                "target_lang_sense_clarification": "юридическая процедура"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "dava süreci",
                                "target_lang_sense_clarification": "hukuki prosedür"
                            },
                            {
                                "target_lang_word": "mahkeme çağrısı",
                                "target_lang_sense_clarification": "resmi ihbarname"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "325dff0c-8949-3e13-a75e-88a3c17d2d18",
                    "sense_definition": "A natural appendage or outgrowth on or in an organism, such as a bone projection.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "noun_anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor examined the zygomatic <w>process</w> for signs of fracture.",
                            "target_lang_translations": {
                                "ru": "Врач осмотрел скуловой <w>отросток</w> на предмет признаков перелома.",
                                "tr": "Doktor, kırık belirtileri için elmacık <w>çıkıntısını</w> inceledi."
                            }
                        },
                        {
                            "text": "Nerve cells have a long <w>process</w> called an axon that transmits signals.",
                            "target_lang_translations": {
                                "ru": "Нервные клетки имеют длинный <w>отросток</w>, называемый аксоном, который передает сигналы.",
                                "tr": "Sinir hücreleri, sinyalleri ileten akson adlı uzun bir <w>uzantıya</w> sahiptir."
                            }
                        }
                    ],
                    "synonyms": [
                        "outgrowth",
                        "projection",
                        "appendage"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "anatomy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Естественный выступ или образование на или в организме, например, выступ кости.",
                        "tr": "Bir canlı organizmada bulunan doğal bir çıkıntı veya uzantı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отросток",
                                "target_lang_sense_clarification": "анатомия"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "çıkıntı",
                                "target_lang_sense_clarification": "anatomi, kemik veya doku uzantısı"
                            },
                            {
                                "target_lang_word": "uzantı",
                                "target_lang_sense_clarification": "hücresel veya anatomik parça"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a4975584-786d-3791-958a-94142bc96a36",
                    "sense_definition": "To deal with someone or something using an official procedure.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "verb_official",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The embassy will <w>process</w> your visa application within two weeks.",
                            "target_lang_translations": {
                                "ru": "Посольство <w>рассмотрит</w> ваше заявление на визу в течение двух недель.",
                                "tr": "Büyükelçilik vize başvurunuzu iki hafta içinde <w>işleme alacaktır</w>."
                            }
                        },
                        {
                            "text": "We need to <w>process</w> the payment before shipping the goods.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>обработать</w> платеж перед отправкой товара.",
                                "tr": "Malları göndermeden önce ödemeyi <w>işlememiz</w> gerekiyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "handle",
                        "deal with",
                        "attend to",
                        "manage"
                    ],
                    "common_phrases": [
                        "process an application",
                        "process a request",
                        "process an order"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь дело с кем-то или чем-то, используя официальную процедуру.",
                        "tr": "Resmi bir prosedür kullanarak bir işi veya kişiyi ele almak,leme koymak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оформлять",
                                "target_lang_sense_clarification": "документы, визы"
                            },
                            {
                                "target_lang_word": "обрабатывать",
                                "target_lang_sense_clarification": "заказы, заявки"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "işleme almak",
                                "target_lang_sense_clarification": "başvuru veya talep"
                            },
                            {
                                "target_lang_word": "işlemek",
                                "target_lang_sense_clarification": "ödeme veya belge"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c526adc1-dbcc-3d48-aae3-606fd4050054",
                    "sense_definition": "To perform operations on data, information, or materials to change or preserve them.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "verb_technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The computer <w>processes</w> millions of calculations per second.",
                            "target_lang_translations": {
                                "ru": "Компьютер <w>обрабатывает</w> миллионы вычислений в секунду.",
                                "tr": "Bilgisayar saniyede milyonlarca hesaplama <w>işler</w>."
                            }
                        },
                        {
                            "text": "This factory <w>processes</w> raw milk into cheese and yogurt.",
                            "target_lang_translations": {
                                "ru": "Этот завод <w>перерабатывает</w> сырое молоко в сыр и йогурт.",
                                "tr": "Bu fabrika ham sütü <w>işleyerek</w> peynir ve yoğurda dönüştürür."
                            }
                        }
                    ],
                    "synonyms": [
                        "compute",
                        "analyze",
                        "treat",
                        "refine"
                    ],
                    "common_phrases": [
                        "process data",
                        "process information",
                        "process food"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнять операции над данными, информацией или материалами для их изменения или сохранения.",
                        "tr": "Verileri, bilgileri veya maddeleri değiştirmek veya korumak amacıyla üzerlerinde işlem yapmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обрабатывать",
                                "target_lang_sense_clarification": "информацию, данные"
                            },
                            {
                                "target_lang_word": "перерабатывать",
                                "target_lang_sense_clarification": "сырье, материалы"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "işlemek",
                                "target_lang_sense_clarification": "veri veya bilgiyi analiz etmek"
                            },
                            {
                                "target_lang_word": "işlemden geçirmek",
                                "target_lang_sense_clarification": "hammaddeyi mamule dönüştürmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97120e2e-12f9-3894-a4ee-64635e055035",
                    "sense_definition": "To think about a piece of information in order to understand and accept it.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_cognitive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I need a moment to <w>process</w> what you just told me.",
                            "target_lang_translations": {
                                "ru": "Мне нужна минута, чтобы <w>осмыслить</w> то, что вы только что сказали.",
                                "tr": "Bana az önce söylediklerini <w>sindirmek</w> için biraz zamana ihtiyacım var."
                            }
                        },
                        {
                            "text": "It took her a long time to <w>process</w> the sudden loss of her job.",
                            "target_lang_translations": {
                                "ru": "Ей потребовалось много времени, чтобы <w>осознать</w> внезапную потерю работы.",
                                "tr": "İşini aniden kaybetmesini <w>k kavraması</w> uzun zaman aldı."
                            }
                        }
                    ],
                    "synonyms": [
                        "digest",
                        "absorb",
                        "comprehend",
                        "assimilate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обдумывать информацию, чтобы понять и принять её.",
                        "tr": "Bir bilgiyi anlamak ve kabullenmek için üzerinde düşünmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осмысливать",
                                "target_lang_sense_clarification": "понимать"
                            },
                            {
                                "target_lang_word": "переваривать",
                                "target_lang_sense_clarification": "усваивать информацию"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sindirmek",
                                "target_lang_sense_clarification": "zihnen kabullenmek"
                            },
                            {
                                "target_lang_word": "kavramak",
                                "target_lang_sense_clarification": "anlamak, idrak etmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "536c80e4-3e4d-3642-a0ff-4f7aa8e5b255",
                    "sense_definition": "To walk or move in a line or procession.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "verb_move",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The graduates will <w>process</w> into the auditorium at the start of the ceremony.",
                            "target_lang_translations": {
                                "ru": "Выпускники будут <w>шествовать</w> в аудиторию в начале церемонии.",
                                "tr": "Mezunlar törenin başında salona doğru <w>ilerleyecekler</w>."
                            }
                        },
                        {
                            "text": "The choir <w>processed</w> down the aisle singing a hymn.",
                            "target_lang_translations": {
                                "ru": "Хор <w>прошел</w> по проходу, распевая гимн.",
                                "tr": "Koro bir ilahi söyleyerek koridorda <w>ilerledi</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "march",
                        "parade"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Идти или двигаться линией или процессией.",
                        "tr": "Törensel veya resmi bir düzende, sıra halinde yürümek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шествовать",
                                "target_lang_sense_clarification": "идти торжественно"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "geçit yapmak",
                                "target_lang_sense_clarification": "törensel yürüyüş"
                            },
                            {
                                "target_lang_word": "düzenli yürümek",
                                "target_lang_sense_clarification": "sıra halinde ilerlemek"
                            }
                        ]
                    }
                }
            ]
        }
