                        "translation_id": "8a4f28ea-3652-49a8-9ebb-19409eb062c1",
                        "source_entry_id": "63644fc8-faef-3b3d-b591-7d9ca9c5959e",
                        "source_sense_id": "a1dcb66d-845e-3f61-bc74-a20133f1b1b2",
                        "source_sense_description": "in an academic style or way",
                        "target_lang_word": "akademisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
