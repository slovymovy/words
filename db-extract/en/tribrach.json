                    }
                ],
                "senses": [
                    {
                        "sense_id": "8f7223a4-849d-37fd-8d13-ae39feaaba5e",
                        "entry_id": "96dfe78d-ecae-3ad1-98e1-8e4da6157937",
                        "glosses": [
                            "A metrical foot consisting of three short syllables."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41bc5aa1-10d9-4bf6-806d-0307d991f8e4",
                                "sense_id": "8f7223a4-849d-37fd-8d13-ae39feaaba5e",
                                "text": "For your foote tribracchus of all three short, ye haue very few trissillables."
                            },
                            {
                                "example_id": "05e6c947-0433-4b94-86d5-cb0912b4ea9a",
                                "sense_id": "8f7223a4-849d-37fd-8d13-ae39feaaba5e",
                                "text": "We may vse a Spondee or Iambick and sometime a Tribrack or Dactile."
                            },
                            {
                                "example_id": "99c3f9de-039f-490a-8023-7663d65256ee",
                                "sense_id": "8f7223a4-849d-37fd-8d13-ae39feaaba5e",
                                "text": "Tribrachus or Tribrachys, (Gr[eek]) a Foot in Greek and Latin Verſe, conſiſting of three ſhort Syllables; as Pŏpŭlŭs."
                            },
                            {
                                "example_id": "d2dce3f5-b32a-472a-abbd-7c5200f9b327",
                                "sense_id": "8f7223a4-849d-37fd-8d13-ae39feaaba5e",
                                "text": "Of all the resolved feet, the Tribrach in Trochaic verse with its ictus on the first syllable ⏑́⏑⏑ is most readily recognised by the ear as equivalent to the Trochee."
                            },
                            {
                                "example_id": "3ff1f25b-cfc6-44a7-a159-e45b85b4fe6f",
                                "sense_id": "8f7223a4-849d-37fd-8d13-ae39feaaba5e",
                                "text": "If the range of pure tribrachic measure, or of tribrachs intermingled with trochees, appears much wider in our song-books than in volumes of poetry written to be read."
                            },
                            {
                                "example_id": "6b621a4d-43b9-4576-8545-748d90e2b590",
                                "sense_id": "8f7223a4-849d-37fd-8d13-ae39feaaba5e",
                                "text": "The plain tribrach is frequent in every one’s reading."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7eaf6ca5-0557-45e6-a92c-d7247658efa5",
                        "source_entry_id": "96dfe78d-ecae-3ad1-98e1-8e4da6157937",
                        "source_sense_id": "8f7223a4-849d-37fd-8d13-ae39feaaba5e",
