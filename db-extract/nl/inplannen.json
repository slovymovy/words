                                        "entry_id": "0910577b-6db8-3a4c-95df-142aaaa5361d",
                                        "glosses": [
                                            "To plan (an activity or event) for a specific date or time."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db98e10b-bc51-4848-b4d9-c9868fdb03df",
                                                "sense_id": "350064ba-bc93-37bf-83e3-37ea6c71412c",
                                                "text": "The next elections are scheduled on the twentieth of November."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fc6dea0-ae0c-3903-94ee-e0e417b1b7db",
                                        "entry_id": "0910577b-6db8-3a4c-95df-142aaaa5361d",
                                        "glosses": [
                                            "To add (a name) to the list of those participating in an event; to reserve a place or time for."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "170be9c2-a198-4b1c-8fee-f9ac2bf5eb43",
                                                "sense_id": "6fc6dea0-ae0c-3903-94ee-e0e417b1b7db",
                                                "text": "I am scheduled for classes next month."
                                            },
                                            {
                                                "example_id": "e81fd3bd-5c98-4de9-802c-91bef4f9f6b3",
                                                "sense_id": "6fc6dea0-ae0c-3903-94ee-e0e417b1b7db",
                                                "text": "I'll schedule you for three-o'clock then."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b7bb5c27-f905-3e19-b584-f7d6d79cc1f5",
                                        "entry_id": "0910577b-6db8-3a4c-95df-142aaaa5361d",
                                        "glosses": [
                                            "To admit (a person) to hospital as an involuntary patient under a schedule of the applicable mental health law."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "transitive"
                                        ],
                                        "examples": [
