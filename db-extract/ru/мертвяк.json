                        "glosses": [
                            "Mort, personne morte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2437c3a4-e07c-422f-a4e7-ae87d35f15b8",
                                "sense_id": "b61c094d-9241-382e-9166-9889a836b7c4",
                                "text": "Соскочил атаман, бинокль с убитого сдернул, глянул на ноги, дрожавшие мелким ознобом, оглянулся и присел сапоги снять хромовые с мертвяка.",
                                "translation": "Le chef sauta à terre, ôta les jumelles du mort, regarda ses jambes qui tremblaient d'un léger frisson, regarda autour de lui et s'assit pour retirer les bottes chromées du mort."
                            }
                        ]
                    }
