                        "sense_id": "0b6ae9d9-2f22-3720-a43e-72b91411ecc5",
                        "entry_id": "e643e444-8650-3b02-a4ea-d0ad598f4f1d",
                        "glosses": [
                            "laatste betoog van de advocaat in een rechtszaak; laatste verdedigingsrede"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "133d951a-7246-4b54-97b5-f2476c009d8f",
                                "sense_id": "0b6ae9d9-2f22-3720-a43e-72b91411ecc5",
                                "text": "Wel wordt het jaar huisarrest dat hij als onderdeel van deze zaak heeft gehad, afgetrokken van zijn tijd in gevangenschap. Daarop had de aanklager in haar slotpleidooi aangedrongen. Zijn advocaat heeft laten weten dat Navalny nog twee jaar en acht maanden moet uitzitten."
                            },
                            {
                                "example_id": "945e524f-290c-42d0-8978-1ae9c895d95c",
                                "sense_id": "0b6ae9d9-2f22-3720-a43e-72b91411ecc5",
                                "text": "De advocaten van Johnny Depp riepen in hun slotpleidooi de jury op om Depp \"zijn leven terug te geven\", die van Amber Heard gebruikten de tijd vooral om te zeggen dat er genoeg bewijs is dat Depp haar heeft mishandeld. Ze lieten expliciete sms'jes van de Pirates of the Caribbean-ster zien."
                            }
                        ]
                    }
