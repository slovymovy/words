                "senses": [
                    {
                        "sense_id": "1c2eaa91-9221-309e-b8e7-70a7dc94a6f6",
                        "entry_id": "2977636e-b9c7-3c0d-8302-cffcf99e79db",
                        "glosses": [
                            "A female given name from Ancient Greek."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d8105b4-46d5-4f5d-a545-4b97d4b09603",
                                "sense_id": "1c2eaa91-9221-309e-b8e7-70a7dc94a6f6",
                                "text": "\"I shall always think,\" said Zenobia, \"that Lord Liverpool went much too far, though I never said so in his time; for I always uphold my friends.\""
                            },
                            {
                                "example_id": "18117f3f-4628-460b-b62e-acbef93a13d1",
                                "sense_id": "1c2eaa91-9221-309e-b8e7-70a7dc94a6f6",
                                "text": "This Zenobia (\"Nobby\") Hopwood was old Worplesdon's ward, as I believe it is called. A pal of his, just before he stopped ticking over some years previously, had left him in charge of his daughter."
                            }
                        ]
                    }
                ],
