                        "glosses": [
                            "Fait de réfuter à des animaux des traits jugés proprement humains."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5183471-fedd-452e-9f13-0f1bd1608760",
                                "sense_id": "3cbfe731-26ab-3953-bcb8-b4d0ce133ae1",
                                "text": "Le chercheur parle à ce propos d’anthropodéni, concept qu’il définit comme “le rejet a priori de traits proches des humains chez d’autres animaux ou proches des animaux chez nous” (Waal 2016 : 40)."
                            },
                            {
                                "example_id": "30eb3ef3-eed3-4158-8287-000eb20faf87",
                                "sense_id": "3cbfe731-26ab-3953-bcb8-b4d0ce133ae1",
                                "text": "Toutefois, ce culte du dauphin nous ramène aux deux écueils que j'ai déjà cités : anthropomorphisme et anthropodéni."
                            }
                        ]
                    }
