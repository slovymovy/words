                ],
                "senses": [
                    {
                        "sense_id": "b4933ae9-01c3-3afe-b7e1-8192ebd93466",
                        "entry_id": "11af2b3e-6cb4-324d-b48d-9914340dc472",
                        "glosses": [
                            "отнестись к кому-либо, чему-либо с презрением, высокомерно, без уважения"
                        ],
                        "tags": [
                            "кем-чем"
                        ],
                        "examples": [
                            {
                                "example_id": "2e815ecf-9c51-4271-9a8f-82e99456b0b0",
                                "sense_id": "b4933ae9-01c3-3afe-b7e1-8192ebd93466",
                                "text": "Пренебречь чёрной работой."
                            },
                            {
                                "example_id": "c93ee791-ef3c-42ca-87bc-7d9631b00ac9",
                                "sense_id": "b4933ae9-01c3-3afe-b7e1-8192ebd93466",
                                "text": "Пренебречь старым товарищем."
                            }
                        ]
                    },
                    {
                        "sense_id": "21114193-81ad-3b0e-a4e5-dd23e7f59c54",
                        "entry_id": "11af2b3e-6cb4-324d-b48d-9914340dc472",
                        "glosses": [
                            "оставить что-либо без внимания как незначащее, несущественное"
                        ],
                        "tags": [
                            "кем-чем, кого-что и с инф. (устар.)"
                        ],
                        "examples": [
                            {
                                "example_id": "4fc5bf4a-970e-4004-b6a5-77fbaa984b7f",
                                "sense_id": "21114193-81ad-3b0e-a4e5-dd23e7f59c54",
                                "text": "Я жить спешил в былые годы, // Искал волнений и тревог, // Законы мудрые природы // Я безрассудно пренебрёг."
                            },
                            {
                                "example_id": "cf2c391c-0009-4b73-896a-345e1c9c7448",
                                "sense_id": "21114193-81ad-3b0e-a4e5-dd23e7f59c54",
                                "text": "Этот зайчий тулуп мог наконец не на шутку рассердить Пугачёва. К счастию, самозванец или не расслыхал или пренебрёг неуместным намёком."
                            }
                        ]
                    }
