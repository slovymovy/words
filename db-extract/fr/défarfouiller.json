                "senses": [
                    {
                        "sense_id": "cd76222c-3c12-3a41-88d2-8fd8f0a188b1",
                        "entry_id": "f502843e-7144-3342-beac-1041abd81d99",
                        "glosses": [
                            "Démêler."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "35f5dceb-aa76-4bb8-9b73-13562727070f",
                                "sense_id": "cd76222c-3c12-3a41-88d2-8fd8f0a188b1",
                                "text": "J’ai donc farfouillé, refarfouillé, défarfouillé' les joueurs libres et je n’ai pris que deux recrues, un prêt et un joueur libre, je vous les présente"
                            },
                            {
                                "example_id": "5f9b9edd-8714-4ec6-a6f1-e25f928ae799",
                                "sense_id": "cd76222c-3c12-3a41-88d2-8fd8f0a188b1",
                                "text": "Je la regarde en souriant niaisement et je me laisse tomber dans les coussins. Mais elle, dans le même temps, se met debout et je me retrouve comme un crétin, tout seul. Le temps que je me défarfouille du kapok, elle est déjà arrivée, en se déhanchant, à la porte de la salle de bains."
                            }
                        ]
                    }
