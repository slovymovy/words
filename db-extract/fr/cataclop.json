                    },
                    {
                        "translation_id": "ed4280a1-7177-4b86-aaa1-3b47971ec2f2",
                        "source_entry_id": "fc2147b5-91ad-35d0-846a-b36d89a19aad",
                        "source_sense_id": "290e81ad-7f71-3687-8ed8-421af0df6eec",
