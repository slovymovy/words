                ],
                "senses": [
                    {
                        "sense_id": "a021dcab-d9d1-3d02-aabb-ac6b6e8be6ec",
                        "entry_id": "852230bc-65e9-3cc1-bb1b-6806bfadedf7",
                        "glosses": [
                            "One involved in the formulation of policies, especially politicians, lobbyists, and activists."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4fc0a37-b96c-4a98-ad57-dc7a361a9c64",
                                "sense_id": "a021dcab-d9d1-3d02-aabb-ac6b6e8be6ec",
                                "text": "The choice for vice president is of much more than a junior campaign partner. The nation is deciding on a powerful leader and policymaker who will not be vetted by Congress."
                            },
                            {
                                "example_id": "55519c09-7173-4cc7-a161-1852b671dc6f",
                                "sense_id": "a021dcab-d9d1-3d02-aabb-ac6b6e8be6ec",
                                "text": "Major websites such as Facebook, Google and Netflix are speaking up today to oppose an effort by Republican policymakers who are seeking to undo the government's net neutrality regulations — those federal rules passed in 2015 aimed at making sure Internet providers like Verizon or AT&T can't manipulate what you can see online."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2b5254eb-e98f-4b4d-a41b-d6586c9d3da1",
                        "source_entry_id": "852230bc-65e9-3cc1-bb1b-6806bfadedf7",
                        "source_sense_id": "a021dcab-d9d1-3d02-aabb-ac6b6e8be6ec",
                        "source_sense_description": "one involved in the formulation of policies",
                        "target_lang_word": "beleidsmaker",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beleidsmaker",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "680bfe8c-52e5-30d3-842b-d08bbd1df1a7",
                                        "entry_id": "68d3b8b2-c14a-3d00-a2c2-edeca1e05e7d",
                                        "glosses": [
                                            "iemand die het beleid maakt"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d12adcbd-dbf1-4936-8b5b-757c1a3c0d34",
                                                "sense_id": "680bfe8c-52e5-30d3-842b-d08bbd1df1a7",
                                                "text": "Het doel van deze studie is om denkgereedschappen aan te reiken, waarmee professionals en beleidsmakers deze machtsprocessen kunnen analyseren."
                                            },
                                            {
                                                "example_id": "ce6eb211-e595-4f49-a592-094d08f72a21",
                                                "sense_id": "680bfe8c-52e5-30d3-842b-d08bbd1df1a7",
                                                "text": "De centrale bank van Zimbabwe heeft het belangrijkste rentetarief opgevoerd naar een recordhoogte. Dat doen de beleidsmakers om de torenhoge inflatie in het Afrikaanse land te beteugelen. Ook hopen ze de wisselkoers van de Zimbabwaanse dollar enigszins stabiel te krijgen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc775a98-4080-44cb-81ca-7911726006fd",
                        "source_entry_id": "852230bc-65e9-3cc1-bb1b-6806bfadedf7",
                        "source_sense_id": "a021dcab-d9d1-3d02-aabb-ac6b6e8be6ec",
                        "source_sense_description": "one involved in the formulation of policies",
                        "target_lang_word": "décideur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "décideur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6fde130b-f21d-35c8-a7dd-1cbcf95aae65",
                                        "entry_id": "52e04c9e-1b5e-34c1-b96d-96062f445f30",
                                        "glosses": [
                                            "Personne qui décide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebbebfc1-ac39-49d3-9c14-6b37dd09c9bc",
                                                "sense_id": "6fde130b-f21d-35c8-a7dd-1cbcf95aae65",
                                                "text": "M. de Vendôme répondit à Roquelaure qu’il était un mauvais décideur [au jeu] et qu’il se mêlait toujours de ce qu’il n’avait que faire."
                                            },
                                            {
                                                "example_id": "7d391061-4d37-4059-b860-a800726376d1",
                                                "sense_id": "6fde130b-f21d-35c8-a7dd-1cbcf95aae65",
                                                "text": "Et pour que les usagers de base puissent aider les décideurs à dissoudre les poches de résistance des corporatismes intermédiaires de tous poils ?"
                                            },
                                            {
                                                "example_id": "c9b1696b-1fdc-4e94-bafa-3ef42d3e73c5",
                                                "sense_id": "6fde130b-f21d-35c8-a7dd-1cbcf95aae65",
                                                "text": "Il faudra un certain temps pour abandonner cette recommandation car il semble que personne, parmi les décideurs, n’ait une vision lucide de ce qu’est la connaissance à ce moment-là de la littérature scientifique."
                                            },
                                            {
                                                "example_id": "d809343c-c132-4771-b9b4-280135c6971c",
                                                "sense_id": "6fde130b-f21d-35c8-a7dd-1cbcf95aae65",
                                                "text": "Pour Mᵉ Delaisement, la suite relève du projet politique du décideur public qui doit adapter ce qu’il a vu à la définition du bien commun de sa ville et de ses habitants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
