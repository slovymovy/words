                "translations": [
                    {
                        "translation_id": "7c5ef0e1-44ad-4a17-ab56-b850dd045ce0",
                        "source_entry_id": "cb3468d1-f166-3f13-b4a7-5af3b6dcf319",
                        "source_sense_id": "be65a5a3-b7ef-3325-a681-9333300a8784",
                        "source_sense_description": "Buch, mit dessen Hilfe Codes entschlüsselt werden können",
                        "target_lang_word": "codebook",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "codebook",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "097b7d22-f3dd-3847-8c6a-e94497ef7028",
                                        "entry_id": "47c0289f-214d-3d07-92a4-2fbe2c71052e",
                                        "glosses": [
                                            "A book, table, database, or other object that stores the mapping between plaintext words or phrases and their equivalents in a code."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46f2b907-ce6b-492b-81a8-2d0ff7c1174b",
                                                "sense_id": "097b7d22-f3dd-3847-8c6a-e94497ef7028",
                                                "text": "In the 19th century codebooks were used not so much for secrecy as for compression, to bring down the prohibitive cost of telegraph communication. […] But when Dr. Bellovin hunted though the card catalog, his interest was piqued by an 1882 codebook whose title included the word “secrecy.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe3836a3-274f-3256-b3b2-5f4bf052e69f",
                                        "entry_id": "47c0289f-214d-3d07-92a4-2fbe2c71052e",
                                        "glosses": [
                                            "A lookup table."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3667f6af-5356-41c8-a562-1e37e2f847d5",
                                                "sense_id": "fe3836a3-274f-3256-b3b2-5f4bf052e69f",
                                                "text": "We assume that DWT coefficients belong to a codeblock that is divided by its quantization step size in advance and the two codebooks, C⁰ and C¹, for the two quantizers can be defined as […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b503bd68-f74b-3b95-b9be-cc47e8302288",
                                        "entry_id": "47c0289f-214d-3d07-92a4-2fbe2c71052e",
                                        "glosses": [
                                            "A list of disorders or conditions and the codes that represent them."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a2797d5-0244-4b83-9239-c2ab12923841",
                                                "sense_id": "b503bd68-f74b-3b95-b9be-cc47e8302288",
                                                "text": "The change, which has so far been approved by each committee that has considered it, is under review for the next edition of the W.H.O. codebook, which classifies diseases and influences the treatment of patients worldwide."
                                            }
                                        ]
                                    }
                                ]
                            }
