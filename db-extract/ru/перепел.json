                "senses": [
                    {
                        "sense_id": "c0d9b5c1-e41e-3e90-8b01-316473c5ac5f",
                        "entry_id": "43181af0-37e9-3aea-9442-a79edcb3344e",
                        "glosses": [
                            "quail"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50ecac71-bf23-42a5-8de9-3d1bba876d39",
                                "sense_id": "c0d9b5c1-e41e-3e90-8b01-316473c5ac5f",
                                "text": "Как сча́стливы те, кото́рые, сняв свои́ тяжёлые вицмунди́ры, мо́гут сесть в коля́ску и полете́ть в по́ле, где крича́т перепела́ и па́хнет молоды́м се́ном.",
                                "translation": "How happy those who can take off their heavy uniforms, get into a carriage and fly off to the country where the quails are calling and there is the scent of fresh hay.",
                                "english": "How happy those who can take off their heavy uniforms, get into a carriage and fly off to the country where the quails are calling and there is the scent of fresh hay."
                            }
                        ]
                    }
