{
    "word_family": [
        "Canada",
        "Canadianism",
        "Canadianize"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9f8e1396-14b2-39ea-bc4e-0c830162d8a4",
                    "sense_definition": "Of, belonging to, or relating to Canada, its culture, or people.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She loves <w>Canadian</w> maple syrup on her pancakes.",
                            "target_lang_translations": {
                                "ru": "Она любит <w>канадский</w> кленовый сироп с блинами.",
                                "zh": "她喜欢在煎饼上淋上<w>加拿大</w>枫糖浆。"
                            }
                        },
                        {
                            "text": "The <w>Canadian</w> government announced new policies today.",
                            "target_lang_translations": {
                                "ru": "<w>Канадское</w> правительство объявило сегодня о новой политике.",
                                "zh": "<w>加拿大</w>政府今天宣布了新政策。"
                            }
                        }
                    ],
                    "antonyms": [
                        "non-Canadian"
                    ],
                    "common_phrases": [
                        "Canadian citizen",
                        "Canadian culture",
                        "Canadian dollar",
                        "Canadian flag"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к Канаде, её культуре или народу.",
                        "zh": "指加拿大的，或与加拿大及其文化、人民有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кана́дский",
                                "target_lang_sense_clarification": "относящийся к Канаде"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "加拿大的",
                                "target_lang_sense_clarification": "形容词，表示属于加拿大"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "41233422-a555-3cd6-98f2-7ad8cf8879e7",
                    "sense_definition": "A native or inhabitant of Canada.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many <w>Canadians</w> enjoy playing ice hockey in the winter.",
                            "target_lang_translations": {
                                "ru": "Многие <w>канадцы</w> любят играть в хоккей зимой.",
                                "zh": "许多<w>加拿大人</w>喜欢在冬天打冰球。"
                            }
                        },
                        {
                            "text": "He became a <w>Canadian</w> after living in Toronto for five years.",
                            "target_lang_translations": {
                                "ru": "Он стал <w>канадцем</w> после того, как прожил в Торонто пять лет.",
                                "zh": "他在多伦多住了五年后成为了<w>加拿大人</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Canuck"
                    ],
                    "common_phrases": [
                        "proud Canadian",
                        "native Canadian",
                        "average Canadian"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уроженец или житель Канады.",
                        "zh": "加拿大的原住民或居民。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кана́дец",
                                "target_lang_sense_clarification": "житель Канады (мужчина или общее)"
                            },
                            {
                                "target_lang_word": "кана́дка",
                                "target_lang_sense_clarification": "жительница Канады (женщина)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "加拿大人",
                                "target_lang_sense_clarification": "名词，指加拿大公民或居民"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "6483eb5e-5c0b-3bf7-8ce0-74fe353a4bcc",
                    "sense_definition": "The English language as used in Canada.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "Some words in <w>Canadian</w> are spelled differently than in American English.",
                            "target_lang_translations": {
                                "ru": "Некоторые слова в <w>канадском английском</w> пишутся иначе, чем в американском английском.",
                                "zh": "<w>加拿大英语</w>中有些词的拼写与美国英语不同。"
                            }
                        },
                        {
                            "text": "It can be hard to distinguish <w>Canadian</w> from General American speech.",
                            "target_lang_translations": {
                                "ru": "Бывает трудно отличить <w>канадский английский</w> от общеамериканской речи.",
                                "zh": "有时很难区分<w>加拿大英语</w>和通用美式英语。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Английский язык, используемый в Канаде.",
                        "zh": "在加拿大使用的英语语言。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кана́дский англи́йский",
                                "target_lang_sense_clarification": "диалект английского языка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "加拿大英语",
                                "target_lang_sense_clarification": "名词，指加拿大使用的英语变体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9732c86a-c491-3824-9f4a-a5c746fce05f",
                    "sense_definition": "A river in the United States that flows through New Mexico, Texas, and Oklahoma.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "The <w>Canadian</w> is a major tributary of the Arkansas River.",
                            "target_lang_translations": {
                                "ru": "<w>Канейдиан</w> — крупный приток реки Арканзас.",
                                "zh": "<w>加拿大人河</w>是阿肯色河的一条主要支流。"
                            }
                        },
                        {
                            "text": "Early explorers followed the <w>Canadian</w> westward across the plains.",
                            "target_lang_translations": {
                                "ru": "Ранние исследователи шли вдоль <w>Канейдиан</w> на запад через равнины.",
                                "zh": "早期的探险家沿着<w>加拿大人河</w>向西穿过平原。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Река в США, протекающая через Нью-Мексико, Техас и Оклахому.",
                        "zh": "美国的一条河流，流经新墨西哥州、德克萨斯州和俄克拉荷马州。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Кане́йдиан",
                                "target_lang_sense_clarification": "река"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "加拿大人河",
                                "target_lang_sense_clarification": "地理名称，指美国境内的河流"
                            }
                        ]
                    }
                }
            ]
        }
    ]
