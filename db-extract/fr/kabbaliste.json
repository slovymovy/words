                "translations": [
                    {
                        "translation_id": "56573f31-739f-477b-8af3-d3af3c52c7a8",
                        "source_entry_id": "70992cec-6f28-3519-9cdc-74fad49478bd",
                        "source_sense_id": "7fee4d52-d742-394d-b742-0c3c7c72e7e2",
                        "source_sense_description": "Religion, speziell Judentum: Kabbalist",
                        "target_lang_word": "Kabbalist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kabbalist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "021ed73e-64ac-3a2c-9326-d2c8785b2dd7",
                                        "entry_id": "ea19182b-9853-3900-98fb-a96c0f99ae9c",
                                        "glosses": [
                                            "Anhänger der Kabbala, der jüdischen Mystik"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f4b4478-1fde-4303-a4b2-70b927d1cabc",
                                                "sense_id": "021ed73e-64ac-3a2c-9326-d2c8785b2dd7",
                                                "text": "„Die Kabbalisten haben nun aber nicht nur mystisch-theoretische Schlüsse gezogen, sie haben auch angenommen, daß sich auf diese Weise geheime Formeln finden ließen, mit denen man auf die Realität, ja sogar auf das gesamte Weltgeschehen einwirken könnte.“"
                                            },
                                            {
                                                "example_id": "eecc72f2-c611-4eb8-8ae1-75c6906b6da1",
                                                "sense_id": "021ed73e-64ac-3a2c-9326-d2c8785b2dd7",
                                                "text": "„Daher betrachtet der Kabbalist den Text der Torah als einen symbolischen Apparat, der (hinter dem Buchstaben und den Ereignissen, die er erzählt, oder den Geboten, die er aufstellt) von diesen mystischen und metaphysischen Wirklichkeiten handelt und bei dessen Lektüre man vier Arten von Sinn unterscheiden muß: den buchstäblichen, den allegorisch-philosophischen, den hermeneutischen und den mystischen.“"
                                            },
                                            {
                                                "example_id": "c773a5a2-8714-40b8-9e40-4ef7c3a5f1fd",
                                                "sense_id": "021ed73e-64ac-3a2c-9326-d2c8785b2dd7",
                                                "text": "„Der Kabbalist fragte mich, wohin ich gehen wolle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
