                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4dd18e83-3f45-3471-a923-6456caa58588",
                        "entry_id": "e0f0f1c5-220e-33d8-bf41-ef2bf3f4f3c1",
                        "glosses": [
                            "evenzeer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13b5721a-87ce-4420-a8cf-95a07477bc10",
                                "sense_id": "4dd18e83-3f45-3471-a923-6456caa58588",
                                "text": "Hij woonde zowel in de stad als op het platteland."
                            },
                            {
                                "example_id": "cded7f5a-de66-4b1d-b05c-dfacb57d61fc",
                                "sense_id": "4dd18e83-3f45-3471-a923-6456caa58588",
                                "text": "Kinderen zijn, net als iedereen, gewoontedieren. De mijne waren inmiddels een beetje gewend aan het feit dat zowel ik als mijn vrouw af en toe een tijdje weg waren."
                            },
                            {
                                "example_id": "c81ef498-7349-4aab-a2d2-ba5612bb5851",
                                "sense_id": "4dd18e83-3f45-3471-a923-6456caa58588",
                                "text": "\"Dat wordt straks wel even wennen\", zegt machinist Jos van der Veen tegen RTV Noord. Hij had gisteravond zijn laatste rit naar het \"oude hoofdstation\"\". \"Ik vind het mooi om een stukje spoorweggeschiedenis mee te maken, zowel aan het einde van iets of het begin van iets. Nu mag ik het einde meemaken, hartstikke leuk.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6b6bccd-4e93-40ff-801d-73f94ef5dfa0",
