                            "komische Figur/Person"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "930c0832-dd4b-4d23-afa3-5695a705c861",
                                "sense_id": "0e1778c0-02cd-340a-a29a-8956fc07f41b",
                                "text": "Helmut Qualtinger ist ein Urviech des österreichischen Kabaretts."
                            }
                        ],
