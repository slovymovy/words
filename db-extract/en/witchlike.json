                        "glosses": [
                            "Resembling or characteristic of a witch."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e35abda2-9844-446e-8120-809225054298",
                                "sense_id": "63504472-9c86-3994-b36a-c9fac68d8d4c",
                                "text": "Her sharp immovable eyes with irregular pupils, her projecting chin, her broad nose, and her yellow complexion gave Bertha's face a strange, Oriental, almost witchlike appearance; and this was not to be wondered at, because she was considered the first wise woman for a good many miles around."
                            },
                            {
                                "example_id": "106c08a2-ebe8-4f4c-b848-ca1786ac331e",
                                "sense_id": "63504472-9c86-3994-b36a-c9fac68d8d4c",
                                "text": "Catholic polemicist Nicholas Sander's De origine et progressu schismatis Anglicani, first published in 1585, had gone through its sixth European edition in 1610: this work promotes a perception of Anne as witchlike, detailing her prodigious promiscuity as well as her physical disfigurements (Warnicke 247)."
                            },
                            {
                                "example_id": "e79ccbcf-81a4-419a-be55-8d58688be0b0",
                                "sense_id": "63504472-9c86-3994-b36a-c9fac68d8d4c",
                                "text": "The second, Madame Louise (Anjelica Huston in her grifter mode), is a haughty, witchlike peddler in a horse-drawn carriage, hawking an alcoholic cure-all."
                            }
                        ]
                    }
