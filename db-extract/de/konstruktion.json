                        ],
                        "form": "die Konstruktion"
                    },
                    {
                        "form_id": "5ade7e82-0009-44f9-8317-6b0eb4bd747e",
                        "entry_id": "710fe442-b543-3f7d-87a3-78cfa8bd5d11",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Konstruktionen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cd8907dd-70f3-3a85-83c8-23a764b3eedd",
                        "entry_id": "710fe442-b543-3f7d-87a3-78cfa8bd5d11",
                        "glosses": [
                            "das Entwerfen und Planen einer greifbaren Sache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "742af826-2ff7-4dd7-b458-7f688de626d9",
                                "sense_id": "cd8907dd-70f3-3a85-83c8-23a764b3eedd",
                                "text": "Er arbeitet gerade an der Konstruktion einer neuen Fertigungsstrasse."
                            },
                            {
                                "example_id": "e5a3958f-d696-4558-b6ec-f4308b3b0a50",
                                "sense_id": "cd8907dd-70f3-3a85-83c8-23a764b3eedd",
                                "text": "Diese Konstruktion wird nicht halten."
                            },
                            {
                                "example_id": "3ca96106-72fb-494c-96c5-418b57cbe6a8",
                                "sense_id": "cd8907dd-70f3-3a85-83c8-23a764b3eedd",
                                "text": "Wegen eines Fehlers in der Konstruktion ist die Brücke zusammengebrochen."
                            },
                            {
                                "example_id": "0af1beb2-fd5a-4654-9a6e-b60f5e24c0f5",
                                "sense_id": "cd8907dd-70f3-3a85-83c8-23a764b3eedd",
                                "text": "Die Konstruktion der Atommeiler in Deutschland hat Milliarden über Milliarden staatlicher Gelder verschlungen."
                            },
                            {
                                "example_id": "f4331507-aad5-4e74-9c4d-3d969d2bd02a",
                                "sense_id": "cd8907dd-70f3-3a85-83c8-23a764b3eedd",
                                "text": "Bei der Planung hat Gustave Eiffel seine Konstruktion [des Eiffelturms] gewissermaßen überdimensioniert angelegt: Er kalkulierte mit sehr großen Sicherheitsmargen."
                            },
                            {
                                "example_id": "91902d05-2051-4a69-a580-2ade831636bc",
                                "sense_id": "cd8907dd-70f3-3a85-83c8-23a764b3eedd",
                                "text": "Der 3D-Druck ermöglicht Ingenieuren und Designern ganz anders an die Konstruktion von Bauteilen heranzugehen."
                            },
                            {
                                "example_id": "db240f31-007d-4e6c-b804-aeb611d7322e",
                                "sense_id": "cd8907dd-70f3-3a85-83c8-23a764b3eedd",
                                "text": "[Segeln:] Als \"Aero-Rigg\" bezeichnen die Züricher Tüftler ihren neu entwickelten Antrieb. Dabei haben die Tüftler die herkömmliche Konstruktion aus fest verankertem Mast, flexiblem Großbaum und darin aufgespanntem Großsegel aufgeben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9a9bab65-7279-3620-a7ce-1a10bf2ef300",
                        "entry_id": "710fe442-b543-3f7d-87a3-78cfa8bd5d11",
                        "glosses": [
                            "aufgebaute Sache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd5fc03f-6269-4ea1-a655-1fe8f8074162",
                                "sense_id": "9a9bab65-7279-3620-a7ce-1a10bf2ef300",
                                "text": "Die Konstruktion ist wacklig."
                            },
                            {
                                "example_id": "96d945c2-0cfe-4818-a7b3-e410eef65339",
                                "sense_id": "9a9bab65-7279-3620-a7ce-1a10bf2ef300",
                                "text": "Menschen verwenden Bambus schon seit Jahrhunderten. Viele Völker kennen seine Eigenschaften und nutzen den \"pflanzlichen Stahl\" zur Konstruktion ihrer Häuser, auch heute noch."
                            },
                            {
                                "example_id": "f64fa4da-2108-4717-b468-24e1ebf8ebf4",
                                "sense_id": "9a9bab65-7279-3620-a7ce-1a10bf2ef300",
                                "text": "2005 ließ sie [die Stadt Köln] die verwinkelte Konstruktion aus Rolltreppen und tiefen Schächten durch eine großzügige Freitreppe ersetzen."
                            },
                            {
                                "example_id": "27e314d3-a271-4273-a088-da7cfba2a9eb",
                                "sense_id": "9a9bab65-7279-3620-a7ce-1a10bf2ef300",
                                "text": "„Von der Decke, dort wo die Rundungen des Gewölbes an ihrem höchsten Punkt einander berührten und die Statik der Konstruktion vollendeten, hing ein schwerer, gußeiserner Leuchter, der ein diffuses, schummriges Licht verbreitete.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "20358e5c-d3a1-3011-929b-7efed5a36b48",
                        "entry_id": "710fe442-b543-3f7d-87a3-78cfa8bd5d11",
                        "glosses": [
                            "gedanklicher Aufbau einer Sache, Errichten eines Gedankengebäudes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a09ed754-78a2-4412-9da4-d308609d8c00",
                                "sense_id": "20358e5c-d3a1-3011-929b-7efed5a36b48",
                                "text": "[Klaus Pokatzky:] „Wir selbst sind eine Konstruktion des Gehirns, die ununterbrochen verändert wird.“"
                            },
                            {
                                "example_id": "064bcb1f-ce72-4337-a791-3e303b091ba8",
                                "sense_id": "20358e5c-d3a1-3011-929b-7efed5a36b48",
                                "text": "Die Themen Frausein und Natur wurden in den vergangenen Monaten häufig diskutiert und wieder miteinander in Verbindung gebracht. Für Simone de Beauvoir war diese Kombination eine Konstruktion."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "889ee90d-37c3-397a-8fa7-cf8faad0a38d",
                        "entry_id": "710fe442-b543-3f7d-87a3-78cfa8bd5d11",
                        "glosses": [
                            "Zeichnen geometrischer Figuren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dce09f59-0145-4623-ba5f-36084672be21",
                                "sense_id": "889ee90d-37c3-397a-8fa7-cf8faad0a38d",
                                "text": "Die Konstruktion exakter Quadrate oder gleichseitiger Dreiecke gelingt sicher mit Zirkel und Lineal."
                            },
                            {
                                "example_id": "80d915ba-82aa-4ea6-91ff-2333c020c208",
                                "sense_id": "889ee90d-37c3-397a-8fa7-cf8faad0a38d",
                                "text": "In der euklidischen Geometrie versteht man unter einer Konstruktion mit Zirkel und Lineal die Entwicklung der exakten zeichnerischen Darstellung einer Figur auf der Grundlage vorgegebener Größen, wobei in der Regel nur Zirkel und Lineal verwendet werden dürfen."
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "2edc120b-8de7-3006-b069-a005560dc1ca",
                        "entry_id": "710fe442-b543-3f7d-87a3-78cfa8bd5d11",
                        "glosses": [
                            "Aufbau und Zusammensetzung von Worten oder Sätzen"
                        ],
                        "tags": [
                            "Sprachwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "a9e1f759-a9f8-410d-9d30-9a46fc247cbc",
                                "sense_id": "2edc120b-8de7-3006-b069-a005560dc1ca",
                                "text": "Die erste Äußerung … enthält ein doppeltes Perfekt, eine Konstruktion, die in der gesprochenen Sprache häufiger ist als in der geschriebenen."
                            }
                        ],
                        "sense_index_json": "\"5\""
                    }
                ],
