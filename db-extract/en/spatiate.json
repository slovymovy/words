                        ],
                        "examples": [
                            {
                                "example_id": "e72069ce-bb39-4740-a4a1-1682578b95a3",
                                "sense_id": "233e0c88-20c8-3e5f-ab52-ed1bcb7eb727",
                                "text": "For astonishment , it is caused by the fixing of the mind upon one object of cogitation , whereby it doth not spatiate and transcur, as it useth ; for in wonder the spirits fly not , as in fear ; but only settle , and are made less apt to move"
                            },
                            {
                                "example_id": "d952864a-feee-43a6-a08b-925655acf5a2",
                                "sense_id": "233e0c88-20c8-3e5f-ab52-ed1bcb7eb727",
                                "text": "My spirit feels her freedom, shakes her wings, / Exults and spatiates o'er a thousand scenes[…]"
                            },
                            {
                                "example_id": "254a80f0-60aa-4f68-b9cf-93e00ed6d2ac",
                                "sense_id": "233e0c88-20c8-3e5f-ab52-ed1bcb7eb727",
                                "text": "[…] spatiating, at their leisure, in shady walks and porticos […]"
                            }
                        ]
                    }
