                                    },
                                    {
                                        "sense_id": "9ef823e0-0d0c-3c84-a21b-b7d1e23eaf09",
                                        "entry_id": "ee12b591-0f59-34df-bbf8-6b9fd5ec247b",
                                        "glosses": [
                                            "(of two or more numbers) Divisible by the same number ᵂᴾ"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12f8dfce-abfa-45c8-9527-f2c94dcaa4ea",
                                                "sense_id": "9ef823e0-0d0c-3c84-a21b-b7d1e23eaf09",
                                                "text": "The numbers 12 and 18 are commensurable, as both are divisible by 6, while 12 and 19 are incommensurable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
