    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "dc7e4a40-6233-3bc2-9165-c03b4917f19f",
                "word": "negatively",
                "pos": "adv",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7c8351ba-03ba-4fdb-95be-a0e2d1d641a9",
                        "entry_id": "dc7e4a40-6233-3bc2-9165-c03b4917f19f",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more negatively"
                    },
                    {
                        "form_id": "7fa8bd06-051e-4b7e-8832-12326ea21c9c",
                        "entry_id": "dc7e4a40-6233-3bc2-9165-c03b4917f19f",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most negatively"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4ce2b919-2104-3895-8519-cc6fd728e308",
                        "entry_id": "dc7e4a40-6233-3bc2-9165-c03b4917f19f",
                        "glosses": [
                            "In a negative manner; so as to be damaging or not positive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36ccac49-9a70-4674-b4f1-c67149d370f0",
                                "sense_id": "4ce2b919-2104-3895-8519-cc6fd728e308",
                                "text": "How justly then might human law and Philosophy rise up against the righteousnesse of Moses, if this be true which our vulgar Divinity Fathers upon him, yeah upon God himselfe; not silently and only negatively to permit, but in his law to divulge a written and generall priviledge to commit and persist in unlawfull divorces with a high hand, with security and no ill fame […]"
                            },
                            {
                                "example_id": "5aae87db-74db-4542-89db-bb66fa046a32",
                                "sense_id": "4ce2b919-2104-3895-8519-cc6fd728e308",
                                "text": "1722, Daniel Defoe, Moll Flanders, London: J. Cooke, 1765, p. 17,\nAt last one of them asked me what a Gentlewoman was? that puzzled me much; but however, I explained myself negatively; that it was one that did not go to Service to do Housework […]"
                            },
                            {
                                "example_id": "07b8cb5a-455b-48fb-8878-2664e8c96fd2",
                                "sense_id": "4ce2b919-2104-3895-8519-cc6fd728e308",
                                "text": "Society is produced by our wants, and government by our wickedness; the former promotes our happiness positively, by uniting our affections; the latter negatively, by restraining our vices."
                            },
                            {
                                "example_id": "4628f380-d163-4728-808e-77f3908c12b8",
                                "sense_id": "4ce2b919-2104-3895-8519-cc6fd728e308",
                                "text": "Allow me to introduce myself—first, negatively. ¶ No landlord is my friend and brother, no chambermaid loves me, no waiter worships me, no boots admires and envies me."
                            },
                            {
                                "example_id": "d2df4c2c-37da-432b-a3e5-fe9c3ad6400c",
                                "sense_id": "4ce2b919-2104-3895-8519-cc6fd728e308",
                                "text": "Having the entire summer off from school negatively affects learning."
                            },
                            {
                                "example_id": "ccde4533-ca07-496f-a2b0-cf3342bd3f14",
                                "sense_id": "4ce2b919-2104-3895-8519-cc6fd728e308",
                                "text": "Tynesiders appear to be proud of their accents, according to the findings, but Brummies responded negatively to hearing their vowels on TV and radio, partly because they recognise they are ridiculed for them by some of their compatriots."
                            }
                        ]
                    },
                    {
                        "sense_id": "72e8d284-b1f8-3a47-aa54-1047d42c386b",
                        "entry_id": "dc7e4a40-6233-3bc2-9165-c03b4917f19f",
                        "glosses": [
                            "In the negative; with the answer “no.”"
                        ],
                        "tags": [
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "09e04b4b-7f4d-4dcb-92e0-887b7e1ebb6e",
                                "sense_id": "72e8d284-b1f8-3a47-aa54-1047d42c386b",
                                "text": "1683, Richard Browne (translator), The Cure of Old Age and Preservation of Youth by Roger Bacon, London: Tho. Flesher, Doubt VII, p. 83,\nI answer negatively:"
                            },
                            {
                                "example_id": "16c0e911-33e8-4926-81ad-b88c2f4e329e",
                                "sense_id": "72e8d284-b1f8-3a47-aa54-1047d42c386b",
                                "text": "Throttling his joy, Ahab negatively answered this unexpected question […]"
                            },
                            {
                                "example_id": "a47feeac-9fb4-4680-8ea4-9f04683fb0c5",
                                "sense_id": "72e8d284-b1f8-3a47-aa54-1047d42c386b",
                                "text": "Twelve States now in the affirmative column at one time or another in the past voted negatively."
                            },
                            {
                                "example_id": "90635ddc-36d8-415d-9040-03e1b45cb270",
                                "sense_id": "72e8d284-b1f8-3a47-aa54-1047d42c386b",
                                "text": "1983, Reuters, “Iran rebuffs Iraq on sparing civilians,” New York Times, 27 May, 1983,\nIran responded negatively today to a proposal by Iraq that the two countries agree to stop shelling each other’s towns and villages."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "68aab18f-0a57-443a-89ce-657251f79e23",
                        "source_entry_id": "dc7e4a40-6233-3bc2-9165-c03b4917f19f",
                        "source_sense_description": "in a negative manner",
                        "target_lang_word": "záporně",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "9169d950-e88e-4614-b196-237c0ca31a51",
                        "source_entry_id": "dc7e4a40-6233-3bc2-9165-c03b4917f19f",
                        "source_sense_description": "in a negative manner",
                        "target_lang_word": "negativ",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "negativ",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c7d3e911-59a8-388c-a506-5302519357ad",
                                        "entry_id": "533c3f56-4a33-3031-9b07-47fbdaf9027c",
                                        "glosses": [
                                            "ungünstig oder sogar deutlich schlecht"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "963c8622-55cd-4b03-856f-6f6ac6da0c65",
                                                "sense_id": "c7d3e911-59a8-388c-a506-5302519357ad",
                                                "text": "Das wird sich negativ auf ihre Zukunft auswirken."
                                            },
                                            {
                                                "example_id": "6dfbcf89-2056-404f-a2bf-c0a2d57b5304",
                                                "sense_id": "c7d3e911-59a8-388c-a506-5302519357ad",
                                                "text": "„Allerdings halten sich chinesische Investoren bislang zurück; sie befürchten negative Folgen durch die US-Sanktionen, wenn sie im Iran Geschäfte machen.“"
                                            },
                                            {
                                                "example_id": "7d2ca737-1173-4eb8-8be8-8ea42f8b0bf8",
                                                "sense_id": "c7d3e911-59a8-388c-a506-5302519357ad",
                                                "text": "„Da sie negative Konsequenzen für ihren laufenden Asylantrag befürchtet, will sie weder ihren echten Namen noch ihren exakten Aufenthaltsort preisgeben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5d2b9ff3-4f23-3f9b-ba29-7d5354672f20",
                                        "entry_id": "533c3f56-4a33-3031-9b07-47fbdaf9027c",
                                        "glosses": [
                                            "verneinend, ablehnend, pessimistisch betrachtend"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f1fc872-683a-4576-9bc4-0e83d4eaacd3",
                                                "sense_id": "5d2b9ff3-4f23-3f9b-ba29-7d5354672f20",
                                                "text": "Er stand dem Plan negativ gegenüber."
                                            },
                                            {
                                                "example_id": "284bbb0f-6516-4a3c-8677-da49f10bf3e9",
                                                "sense_id": "5d2b9ff3-4f23-3f9b-ba29-7d5354672f20",
                                                "text": "Denk doch nicht immer so negativ!"
                                            },
                                            {
                                                "example_id": "10224263-5bdc-405d-b3e6-7a4a39c1e8ba",
                                                "sense_id": "5d2b9ff3-4f23-3f9b-ba29-7d5354672f20",
                                                "text": "„Je ne comprends pas.“ – Hier handelt es sich um einen negativen Satz, da er eine Verneinung enthält."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3ae215e4-b4c8-38fb-aa4c-b4c547fc2ade",
                                        "entry_id": "533c3f56-4a33-3031-9b07-47fbdaf9027c",
                                        "glosses": [
                                            "sich unter Null befindend"
                                        ],
                                        "tags": [
                                            "keine Steigerung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07bdcf4f-41d5-4f8a-83cb-74c931908ab9",
                                                "sense_id": "3ae215e4-b4c8-38fb-aa4c-b4c547fc2ade",
                                                "text": "Wenn man zwei negative Zahlen multipliziert, kommt man auf ein positives Resultat."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "8f40e544-c7dd-30fe-81a1-13617588d3b3",
                                        "entry_id": "533c3f56-4a33-3031-9b07-47fbdaf9027c",
                                        "glosses": [
                                            "elektrische Ladung mit mehr Elektronen als Protonen"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45b3c04d-82fe-4e4a-8622-a3a8bdaee771",
                                                "sense_id": "8f40e544-c7dd-30fe-81a1-13617588d3b3",
                                                "text": "Der negative Pol heißt auch Kathode, der positive Anode."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "0465c0a8-2caf-3bd2-8dfd-111f694fe1fc",
                                        "entry_id": "533c3f56-4a33-3031-9b07-47fbdaf9027c",
                                        "glosses": [
                                            "nach einer Untersuchung nicht festgestellt, nicht vorhanden"
                                        ],
                                        "tags": [
                                            "keine Steigerung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59ad2528-1970-45f2-ba81-09262dc37617",
                                                "sense_id": "0465c0a8-2caf-3bd2-8dfd-111f694fe1fc",
                                                "text": "Herr XY, ich kann Sie beruhigen, der HIV-Test fiel negativ aus."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "6e96897d-d01d-3cbc-adf3-f31843133447",
                                        "entry_id": "533c3f56-4a33-3031-9b07-47fbdaf9027c",
                                        "glosses": [
                                            "von invertierter Helligkeit oder ungekehrten Farbwerten und seitenverkehrt"
                                        ],
                                        "tags": [
                                            "Fotografie",
                                            "keine Steigerung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83ae066e-4638-46e9-9a50-1e3935e26102",
                                                "sense_id": "6e96897d-d01d-3cbc-adf3-f31843133447",
                                                "text": "„Bei der Entscheidung zwischen beiden muss man sich vor Augen halten, dass man als erstes Ergebnis des Verfilmens einen negativen Film erhält, den man direkt und ohne weitere Herstellungskosten für ein Positiv verwenden kann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
