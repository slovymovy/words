                    {
                        "sense_id": "c29a08d1-c880-3f7a-a374-8eca6c05c0d7",
                        "entry_id": "17d9d097-4c1d-3562-82a9-a5503a144787",
                        "glosses": [
                            "to be misled, to get confused, to get mixed up"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89bf3617-d336-40c9-866d-850b916ef9b1",
                                "sense_id": "c29a08d1-c880-3f7a-a374-8eca6c05c0d7",
                                "text": "пу́таться в расска́зе",
                                "translation": "to give a confused account/story",
                                "english": "to give a confused account/story"
                            },
                            {
                                "example_id": "d8c61ca8-b560-4d34-b95b-1b9b892eea3f",
                                "sense_id": "c29a08d1-c880-3f7a-a374-8eca6c05c0d7",
                                "text": "пу́таться в показа́ниях",
                                "translation": "to be inconsistent in one's testimony; contradict oneself in one's evidence/statement",
                                "english": "to be inconsistent in one's testimony; contradict oneself in one's evidence/statement"
                            }
                        ]
                    },
                    {
                        "sense_id": "7daf33f0-315e-3d3f-841b-1e8434f15442",
                        "entry_id": "17d9d097-4c1d-3562-82a9-a5503a144787",
                        "glosses": [
                            "to interfere (in), to meddle (in)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "7ad82b1f-0e7a-48fb-8524-eee6f433e7e2",
                                "sense_id": "7daf33f0-315e-3d3f-841b-1e8434f15442",
                                "text": "пу́таться не в своё де́ло",
                                "translation": "to meddle in other people's affairs",
                                "english": "to meddle in other people's affairs"
                            },
                            {
                                "example_id": "9dd297f4-2246-49a2-aa0b-efbc1b193e06",
                                "sense_id": "7daf33f0-315e-3d3f-841b-1e8434f15442",
                                "text": "пу́таться под нога́ми у кого́-либо",
                                "translation": "to get under someone's feet",
                                "english": "to get under someone's feet"
                            },
                            {
                                "example_id": "569adb83-112a-4314-a1fe-3b422cb20afd",
                                "sense_id": "7daf33f0-315e-3d3f-841b-1e8434f15442",
                                "text": "не пу́тайся под нога́ми!",
                                "translation": "stay out of my way!",
                                "english": "stay out of my way!"
                            }
                        ]
                    },
                    {
                        "sense_id": "45e5c866-174f-34fc-ae0e-29ebc86df1a0",
                        "entry_id": "17d9d097-4c1d-3562-82a9-a5503a144787",
                        "glosses": [
                            "to keep company (with), to get mixed up (with)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
