                        "sense_id": "45f96f05-6e42-3e72-bcbb-736ca6f53a37",
                        "entry_id": "e8a67323-4d27-3854-bea9-0b45b1d8e3e5",
                        "glosses": [
                            "schriftelijke oproep om te gaan stemmen bij een verkiezing"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "683d574a-e4cf-44f5-9c65-4831ded7dbbe",
                                "sense_id": "45f96f05-6e42-3e72-bcbb-736ca6f53a37",
                                "text": "Naar schatting 10.000 tot 15.000 kiezers hebben hun oproepingsbrief voor de verkiezingen van 25 mei verloren. Zowat alle gemeenten in ons land moeten in ijltempo duplicaten van de kiesbrief aanmaken, zo schrijven Het Belang van Limburg en Gazet van Antwerpen."
                            },
                            {
                                "example_id": "8641348e-2ef2-4d8d-babe-a479900aa05e",
                                "sense_id": "45f96f05-6e42-3e72-bcbb-736ca6f53a37",
                                "text": "De inwoners wilden dat de rechtbank de beslissing om hun kiesbrief in het Nederlands te versturen onwettig zou verklaren. De rechter heeft het in zijn vonnis over een “zekere kwade trouw” vanwege het Vlaams gewest omdat die koppig “een verkeerde toepassing van een wettekst” blijft maken."
                            }
                        ]
                    },
