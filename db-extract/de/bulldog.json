                        "sense_id": "7165bbcf-4cb1-34d2-8703-3f7cc959b3bc",
                        "entry_id": "b0d0411b-7708-3a47-a815-6eb2482fe829",
                        "glosses": [
                            "landwirtschaftliche Zugmaschine"
