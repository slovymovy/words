                                "example_id": "12c7d54a-c5ce-4ce0-bc55-e2455081ff71",
                                "sense_id": "b961d50c-4734-337e-9462-a7fa43e0f3b1",
                                "text": "Donnez-moi le vingt-et-unième de ce gâteau."
                            }
                        ]
