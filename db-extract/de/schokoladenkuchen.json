                "senses": [
                    {
                        "sense_id": "6a4e3b8d-cf2c-3a5b-aa04-c62ef14e5036",
                        "entry_id": "749de11d-a485-3dd4-990c-54060610657a",
                        "glosses": [
                            "Backwerk aus süßem Teig und Schokolade"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d9fcb38-0b17-4b0c-8fa0-ba83866bdcd7",
                                "sense_id": "6a4e3b8d-cf2c-3a5b-aa04-c62ef14e5036",
                                "text": "Zu deinem Geburtstag backe ich dir einen leckeren Schokoladenkuchen."
                            },
                            {
                                "example_id": "2554b26d-896e-48ae-a376-0c4ba1e298a7",
                                "sense_id": "6a4e3b8d-cf2c-3a5b-aa04-c62ef14e5036",
                                "text": "„Einmal sahen sie Cindy, wie sie zusammen mit einer anderen Frau Kaffee trank und Schokoladenkuchen aß.“"
                            },
                            {
                                "example_id": "0483398c-6a24-4ede-9c7b-a079ca5ccb55",
                                "sense_id": "6a4e3b8d-cf2c-3a5b-aa04-c62ef14e5036",
                                "text": "„Satan kreierte den Schokoladenkuchen und nannte ihn Teufelszeug.“"
                            },
                            {
                                "example_id": "29bbb431-d1b6-48c9-9ff8-5841528a83c4",
                                "sense_id": "6a4e3b8d-cf2c-3a5b-aa04-c62ef14e5036",
                                "text": "„Aber jetzt wollen Eiríkur und ich Kuchen, sagte Páll und kletterte nach achtern zum Schapp, aus dem er drei dicke Scheiben von Hafrúns Schokoladenkuchen holte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
