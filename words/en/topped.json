    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c64ed03d-a942-3574-9656-4e44b6474df4",
                    "sense_definition": "Simple past and past participle of <w>top</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef <w>topped</w> the pizza with fresh basil and mozzarella.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар <w>покрыл</w> пиццу свежим базиликом и моцареллой.",
                                "pl": "Szef kuchni <w>posypał</w> pizzę świeżą bazylią i mozzarellą."
                            }
                        },
                        {
                            "text": "Her latest song <w>topped</w> the charts for three weeks in a row.",
                            "target_lang_translations": {
                                "ru": "Её последняя песня <w>возглавляла</w> чарты три недели подряд.",
                                "pl": "Jej najnowsza piosenka <w>była na szczycie</w> list przebojów przez trzy tygodnie z rzędu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "topped with",
                        "topped the list",
                        "topped off"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола top.",
                        "pl": "Forma czasu przeszłego i imiesłowu czasu przeszłego od czasownika top (przykryć wierzch, zwieńczyć, przewyższyć, być na czele)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возглавлять",
                                "target_lang_sense_clarification": "быть первым в списке или рейтинге"
                            },
                            {
                                "target_lang_word": "покрывать",
                                "target_lang_sense_clarification": "класть что-либо сверху, обычно о еде"
                            },
                            {
                                "target_lang_word": "завершать",
                                "target_lang_sense_clarification": "успешно заканчивать что-либо"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "przykryć",
                                "target_lang_sense_clarification": "położyć coś na wierzch (np. jedzenia)"
                            },
                            {
                                "target_lang_word": "zwieńczyć",
                                "target_lang_sense_clarification": "umieścić coś na samej górze"
                            },
                            {
                                "target_lang_word": "otwierać",
                                "target_lang_sense_clarification": "znajdować się na pierwszym miejscu, np. listy przebojów"
                            },
                            {
                                "target_lang_word": "przewyższyć",
                                "target_lang_sense_clarification": "być lepszym, pobić rekord"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1c113017-d6a0-3013-8506-59bcf3c22740",
                    "sense_definition": "Having or consisting of a top; covered with a top layer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We admired the snow-<w>topped</w> mountains from our hotel window.",
                            "target_lang_translations": {
                                "ru": "Мы любовались <w>покрытыми</w> снегом горами из окна нашего отеля.",
                                "pl": "Podziwialiśmy <w>pokryte</w> śniegiem góry z okna naszego hotelu."
                            }
                        },
                        {
                            "text": "The glass-<w>topped</w> table was easy to clean after dinner.",
                            "target_lang_translations": {
                                "ru": "Стол со стеклянным <w>верхом</w> было легко мыть после ужина.",
                                "pl": "Stół <w>ze szklanym blatem</w> był łatwy do wyczyszczenia po kolacji."
                            }
                        }
                    ],
                    "synonyms": [
                        "capped",
                        "crowned",
                        "covered"
                    ],
                    "common_phrases": [
                        "snow-topped",
                        "glass-topped",
                        "flat-topped"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий вершину или верхнюю часть; покрытый верхним слоем.",
                        "pl": "Mający wierzch, blat lub szczyt określonego rodzaju; pokryty warstwą na górze."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "с ... верхом",
                                "target_lang_sense_clarification": "имеющий верхнюю часть из определенного материала"
                            },
                            {
                                "target_lang_word": "увенчанный",
                                "target_lang_sense_clarification": "имеющий что-либо на вершине"
                            },
                            {
                                "target_lang_word": "покрытый",
                                "target_lang_sense_clarification": "имеющий слой чего-либо сверху"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "pokryty",
                                "target_lang_sense_clarification": "mający warstwę czegoś na wierzchu"
                            },
                            {
                                "target_lang_word": "zwieńczony",
                                "target_lang_sense_clarification": "mający coś na szczycie"
                            },
                            {
                                "target_lang_word": "z ... blatem",
                                "target_lang_sense_clarification": "o stole lub meblu mającym określoną powierzchnię górną"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}