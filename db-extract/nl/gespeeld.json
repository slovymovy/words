                    {
                        "sense_id": "11cf0909-cc9d-37fb-9d2d-fec3d58a5c35",
                        "entry_id": "6eff34da-a07b-38b1-9d46-6b221a67f4f8",
                        "glosses": [
                            "voltooid deelwoord van spelen"
