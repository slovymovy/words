                ],
                "senses": [
                    {
                        "sense_id": "35c4e5ed-a1ee-3307-b371-80cb13fb5a62",
                        "entry_id": "df169d50-2f92-364b-8199-de556eea7ab4",
                        "glosses": [
                            "speziell zum Laufen entwickeltes Oberbekleidungsstück – meistens ein Shirt, Longsleeve oder Top"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "f43ae4bc-329c-4df2-8b45-6fa7431985b9",
                                "sense_id": "35c4e5ed-a1ee-3307-b371-80cb13fb5a62",
                                "text": "„Ausgestattet ist das Laufoberteil mit der ACTIBREEZE Technologie für ein noch angenehmeres Laufgefühl.“"
                            },
                            {
                                "example_id": "daeae7b2-cf62-4ef8-8cad-de8f131a7ab9",
                                "sense_id": "35c4e5ed-a1ee-3307-b371-80cb13fb5a62",
                                "text": "„Langärmelige Laufoberteile können auch besonders nützlich sein, wenn du dich für Trailrunning interessierst, denn sie bieten zusätzlichen Schutz vor den Elementen und verhindern Kratzer durch tiefhängende Äste oder Sträucher.“"
                            },
                            {
                                "example_id": "b5ef0872-e644-4d3b-879a-97b1e12cd46b",
                                "sense_id": "35c4e5ed-a1ee-3307-b371-80cb13fb5a62",
                                "text": "„Mehr als ein kurzes Laufoberteil war in diesem Jahr auch nicht nötig, denn New York überraschte mit ungewöhnlichen warmen Temperaturen zwischen 20 und 25 Grad.“"
                            },
                            {
                                "example_id": "a3ff53ae-4a79-499d-98ab-80b1d59afaf6",
                                "sense_id": "35c4e5ed-a1ee-3307-b371-80cb13fb5a62",
                                "text": "„Die Damen Schwimmshorts ist Perfekt zum Kombinieren mit Schwimmoberteilen, Bikinis, Tankini Oberteilen, Rash Guard oder Laufoberteilen.“"
                            },
                            {
                                "example_id": "abc6622c-903a-4266-91de-2642f0b1e169",
                                "sense_id": "35c4e5ed-a1ee-3307-b371-80cb13fb5a62",
                                "text": "„Laufoberteile aus Merinowolle sind im Vergleich zu Oberteilen aus anderen Materialien besonders günstig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
