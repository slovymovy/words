                                            {
                                                "example_id": "cae31bab-32da-490f-8f0b-31053422c5ca",
                                                "sense_id": "b395e00c-3a8f-316a-a4d9-4f296e2dd8a2",
                                                "text": "Либертинский проповедник Антуан Пок отнюдь не невежда в теологии."
                                            },
                                            {
                                                "example_id": "9af18a95-3bd5-40a9-b3c6-427dc2dc19f2",
                                                "sense_id": "b395e00c-3a8f-316a-a4d9-4f296e2dd8a2",
                                                "text": "Усиление гедонистического, либертинского начала в культуре свидетельствовало о её отклике на всё более широкий круг человеческих настроений, эмоций."
                                            }
