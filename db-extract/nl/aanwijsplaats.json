                        "glosses": [
                            "plaats in de selectie zonder dat men daarvoor aan een selectieprocedure hoeft mee te doen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38093bd8-3277-4a6f-aaa8-82f6747cda3d",
                                "sense_id": "3ecf3364-e08e-3cb0-9c04-70ec7c361fa3",
                                "text": "De selectiecommissie beschouwt het voorval echter niet als 'calamiteit'. De schaatsbond liet weten dat Nauta niet tot de absolute wereldtop behoort op de drie kilometer en daarom niet in aanmerking komt voor een aanwijsplaats."
                            },
                            {
                                "example_id": "575ab6a7-e7b1-4e9c-9367-d84248858a3d",
                                "sense_id": "3ecf3364-e08e-3cb0-9c04-70ec7c361fa3",
                                "text": "Voor Sven Kramer, Jan Blokhuijsen, Koen Verweij, Ireen Wüst, Linda de Vries en Marrit Leenstra is plaatsing voor de Olympische Spelen weer een stap dichterbij. De zes kunnen naar Sotsji gestuurd worden, ook als ze zich eind december op het olympisch kwalificatietoernooi niet rechtstreeks weten te plaatsen. Schaatsbond KNSB heeft de zes op een lijst gezet met schaatsers die in aanmerking komen voor een aanwijsplaats voor de achtervolgingsploeg."
                            }
                        ]
                    }
