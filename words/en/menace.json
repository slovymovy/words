{
    "word_family": [
        "menacing",
        "menacingly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f86504c6-9354-300a-951c-379acb970a00",
                    "sense_definition": "A perceived threat or danger.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "threat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dark <w>menace</w> of the distant war made everyone in the small town feel anxious.",
                            "target_lang_translations": {
                                "ru": "Мрачная <w>угроза</w> далекой войны заставляла каждого в маленьком городке испытывать тревогу.",
                                "cs": "Temná <w>hrozba</w> vzdálené války vyvolávala v každém v malém městě úzkost."
                            }
                        },
                        {
                            "text": "Rising sea levels pose a constant <w>menace</w> to coastal communities around the world.",
                            "target_lang_translations": {
                                "ru": "Повышение уровня моря представляет собой постоянную <w>угрозу</w> для прибрежных сообществ по всему миру.",
                                "cs": "Stoupající hladina moří představuje stálou <w>hrozbu</w> pro pobřežní komunity po celém světě."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pose a menace",
                        "constant menace"
                    ],
                    "target_lang_definitions": {
                        "ru": "Воспринимаемая угроза или опасность.",
                        "cs": "Vnímaná hrozba nebo nebezpečí."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угроза",
                                "target_lang_sense_clarification": "возможная опасность, неприятность"
                            },
                            {
                                "target_lang_word": "опасность",
                                "target_lang_sense_clarification": "риск или угроза ущерба"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "hrozba",
                                "target_lang_sense_clarification": "situace, kdy existuje pravděpodobnost něčeho nepříjemného"
                            },
                            {
                                "target_lang_word": "nebezpečí",
                                "target_lang_sense_clarification": "stav, kdy hrozí škoda nebo újma"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a0c66b6-9ac8-325c-8c5d-972f625fba6d",
                    "sense_definition": "An annoying and bothersome person or thing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nuisance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That loud motorbike is a public <w>menace</w> when it speeds through the neighborhood at night.",
                            "target_lang_translations": {
                                "ru": "Этот громкий мотоцикл — настоящее <w>общественное бедствие</w>, когда он несется по району ночью.",
                                "cs": "Ta hlučná motorka je veřejným <w>postrachem</w>, když v noci projíždí čtvrtí."
                            }
                        },
                        {
                            "text": "The neighbor's dog became a real <w>menace</w> after it kept escaping and digging up our garden.",
                            "target_lang_translations": {
                                "ru": "Соседская собака стала <w>сущим наказанием</w> после того, как постоянно сбегала и перекапывала наш сад.",
                                "cs": "Sousedův pes se stal skutečnou <w>pohromou</w>, protože neustále utíkal a rozrýval nám zahradu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "public menace",
                        "real menace"
                    ],
                    "target_lang_definitions": {
                        "ru": "Раздражающий, надоедливый человек или предмет; источник неприятностей.",
                        "cs": "Otravná nebo obtěžující osoba či věc; zdroj nepříjemností."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угроза",
                                "target_lang_sense_clarification": "в значении общественной опасности или бича общества"
                            },
                            {
                                "target_lang_word": "наказание",
                                "target_lang_sense_clarification": "в переносном смысле о невыносимом человеке или явлении"
                            },
                            {
                                "target_lang_word": "сущее наказание",
                                "target_lang_sense_clarification": "о ком-то или чём-то крайне надоедливом"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "pohroma",
                                "target_lang_sense_clarification": "o něčem, co působí velké potíže"
                            },
                            {
                                "target_lang_word": "otrava",
                                "target_lang_sense_clarification": "o člověku, který je velmi obtěžující"
                            },
                            {
                                "target_lang_word": "postrach",
                                "target_lang_sense_clarification": "o někom nebo něčem, kdo budí obavy nebo obtěžuje okolí"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cff08de5-bbc9-3ab8-be0f-1f6f61804ef9",
                    "sense_definition": "The act of threatening.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "threat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spoke with a tone of quiet <w>menace</w> that made his intentions immediately clear.",
                            "target_lang_translations": {
                                "ru": "Он говорил тоном тихой <w>угрозы</w>, что сразу прояснило его намерения.",
                                "cs": "Mluvil tónem tiché <w>hrozby</w>, díky kterému byly jeho úmysly okamžitě jasné."
                            }
                        },
                        {
                            "text": "There was an air of <w>menace</w> in the room as the two rivals stared each other down.",
                            "target_lang_translations": {
                                "ru": "В комнате витала атмосфера <w>угрозы</w>, пока два соперника мерили друг друга взглядами.",
                                "cs": "V místnosti byla cítit <w>hrozba</w>, zatímco si dva rivalové měřili pohledy."
                            }
                        }
                    ],
                    "synonyms": [
                        "minacity",
                        "minacy"
                    ],
                    "common_phrases": [
                        "air of menace",
                        "tone of menace"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт угрозы; атмосфера или тон, выражающие угрозу.",
                        "cs": "Akt vyhrožování; atmosféra nebo tón vyjadřující hrozbu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угроза",
                                "target_lang_sense_clarification": "запугивание, враждебный тон или атмосфера"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "hrozba",
                                "target_lang_sense_clarification": "vyjádření úmyslu ublížit nebo zastrašit"
                            },
                            {
                                "target_lang_word": "zastrašování",
                                "target_lang_sense_clarification": "jednání, jehož cílem je vyvolat strach"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4c97e359-9058-3ec7-9afc-1d6dad5e8275",
                    "sense_definition": "To make threats against someone; to intimidate.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "to_threaten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dictator began to <w>menace</w> neighboring countries with military action.",
                            "target_lang_translations": {
                                "ru": "Диктатор начал <w>угрожать</w> соседним странам военными действиями.",
                                "cs": "Diktátor začal <w>vyhrožovat</w> sousedním zemím vojenskou akcí."
                            }
                        },
                        {
                            "text": "He tried to <w>menace</w> the witness into changing her story before the trial.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>запугать</w> свидетельницу, чтобы она изменила свои показания перед судом.",
                                "cs": "Snažil se <w>zastrašit</w> svědkyni, aby před soudem změnila svou výpověď."
                            }
                        }
                    ],
                    "common_phrases": [
                        "menace with violence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Угрожать кому-либо; запугивать.",
                        "cs": "Vyhrožovat někomu; zastrašovat."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угрожать",
                                "target_lang_sense_clarification": "произносить угрозы, запугивать"
                            },
                            {
                                "target_lang_word": "грозить",
                                "target_lang_sense_clarification": "обнаруживать враждебные намерения"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "vyhrožovat",
                                "target_lang_sense_clarification": "dávat najevo úmysl ublížit"
                            },
                            {
                                "target_lang_word": "zastrašovat",
                                "target_lang_sense_clarification": "nutit někoho k něčemu pomocí strachu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51f1770a-4111-357a-af6b-9426f1560a9b",
                    "sense_definition": "To endanger someone or something; to imperil or jeopardize.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "to_threaten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pollution continues to <w>menace</w> the delicate ecosystems of our oceans.",
                            "target_lang_translations": {
                                "ru": "Загрязнение окружающей среды продолжает <w>угрожать</w> хрупким экосистемам наших океанов.",
                                "cs": "Znečištění nadále <w>ohrožuje</w> křehké ekosystémy našich oceánů."
                            }
                        },
                        {
                            "text": "Extreme weather events increasingly <w>menace</w> global food security.",
                            "target_lang_translations": {
                                "ru": "Экстремальные погодные явления все больше <w>угрожают</w> глобальной продовольственной безопасности.",
                                "cs": "Extrémní výkyvy počasí stále více <w>ohrožují</w> globální potravinovou bezpečnost."
                            }
                        }
                    ],
                    "common_phrases": [
                        "menace the environment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подвергать опасности кого-либо или что-либо; ставить под удар.",
                        "cs": "Ohrožovat někoho nebo něco; vystavovat nebezpečí."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угрожать",
                                "target_lang_sense_clarification": "создавать риск для чего-либо, быть опасным"
                            },
                            {
                                "target_lang_word": "грозить",
                                "target_lang_sense_clarification": "внушать опасения, предвещать беду"
                            },
                            {
                                "target_lang_word": "подвергать опасности",
                                "target_lang_sense_clarification": "ставить под угрозу"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "ohrožovat",
                                "target_lang_sense_clarification": "vytvářet riziko pro někoho nebo něco"
                            },
                            {
                                "target_lang_word": "vystavovat nebezpečí",
                                "target_lang_sense_clarification": "dostávat do situace, kde hrozí újma"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0729dde7-3894-37f2-8016-99ec3b060b65",
                    "sense_definition": "To threaten an evil or negative outcome to be inflicted.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "to_threaten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dark clouds overhead seemed to <w>menace</w> a terrible storm.",
                            "target_lang_translations": {
                                "ru": "Темные тучи над головой, казалось, <w>предвещали</w> ужасную бурю.",
                                "cs": "Temné mraky nad hlavou jako by <w>věštily</w> strašlivou bouři."
                            }
                        },
                        {
                            "text": "By oath he <w>menaced</w> revenge upon his enemies.",
                            "target_lang_translations": {
                                "ru": "Клятвой он <w>грозил</w> отомстить своим врагам.",
                                "cs": "Přísahou <w>hrozil</w> svým nepřátelům pomstou."
                            }
                        }
                    ],
                    "common_phrases": [
                        "menace revenge"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often literary or formal in modern usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предвещать плохой или негативный исход; грозить неприятностями.",
                        "cs": "Předpovídat nebo naznačovat špatný či negativní výsledek; hrozit nepříjemnostmi."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "грозить",
                                "target_lang_sense_clarification": "предвещать беду или неприятные последствия"
                            },
                            {
                                "target_lang_word": "угрожать",
                                "target_lang_sense_clarification": "таить в себе возможную опасность"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "věštit",
                                "target_lang_sense_clarification": "předpovídat něco špatného"
                            },
                            {
                                "target_lang_word": "hrozit",
                                "target_lang_sense_clarification": "naznačovat blížící se nebezpečí"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}