                        ]
                    },
                    {
                        "translation_id": "2c203123-0ae7-466e-bbd0-8eded8e56a25",
                        "source_entry_id": "52584107-9696-338b-9c6f-0baf3eea2a86",
                        "target_lang_word": "charbonner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "charbonner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "09241e85-36f5-316a-b769-38ad90c966c9",
                                        "entry_id": "a69df230-7eee-3906-ad5c-c683f4ba54e1",
                                        "glosses": [
                                            "Noircir avec du charbon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41bb2ea9-7ffd-40e8-94a7-e6d32a828eee",
                                                "sense_id": "09241e85-36f5-316a-b769-38ad90c966c9",
                                                "text": "Charbonner le visage de quelqu’un."
                                            },
                                            {
                                                "example_id": "5f9d4225-f27a-4df8-8c06-627045ce0d91",
                                                "sense_id": "09241e85-36f5-316a-b769-38ad90c966c9",
                                                "text": "À l’intérieur de la tente, rien ne bougeait. Ni Jehol, endormi sur un flanc, ni la flamme de la lampe sous le verre enfumé. Ni les ombres comme charbonnées sur les parois de feutre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cf1af58-e456-3f20-a828-79888bfa08d9",
                                        "entry_id": "a69df230-7eee-3906-ad5c-c683f4ba54e1",
                                        "glosses": [
                                            "Dessiner ou écrire avec du charbon."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97315926-bd72-468a-81f3-f6814a52da86",
                                                "sense_id": "3cf1af58-e456-3f20-a828-79888bfa08d9",
                                                "text": "Te souviens-tu que sur chaque muraille\nChacun de nous a charbonné son nom ?"
                                            },
                                            {
                                                "example_id": "e6878692-6013-47a3-8ed0-a502e300a833",
                                                "sense_id": "3cf1af58-e456-3f20-a828-79888bfa08d9",
                                                "text": "Alors, Dieu n’existait plus ; la Propriété était le vol et l’on payait souvent son terme avec un drapeau tricolore ou en charbonnant une potence menaçante sur la porte de son propriétaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "160a080c-d30f-3d59-ba29-7f8e571dad4f",
                                        "entry_id": "a69df230-7eee-3906-ad5c-c683f4ba54e1",
                                        "glosses": [
                                            "Noircir."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40b76aa7-c92a-48ca-99cd-075ba1561df0",
                                                "sense_id": "160a080c-d30f-3d59-ba29-7f8e571dad4f",
                                                "text": "Brune, le teint olivâtre, sous le grand mouchoir blanc noué négligemment autour de sa tête et d’où s’échappaient les boucles azurées de sa chevelure, ses yeux de feu charbonnaient leurs orbites."
                                            },
                                            {
                                                "example_id": "6e6ad9e7-0b19-4987-a25d-8ce6320f55f4",
                                                "sense_id": "160a080c-d30f-3d59-ba29-7f8e571dad4f",
                                                "text": "Une troupe se charbonne le visage pour aller régaler des concitoyens d'un raffut dénonciateur agrémenté de chansons, de slogans et d'un tintamarre discordant au moyen d'instruments de fortune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9670da32-9514-335c-b2ad-64ae2055f782",
                                        "entry_id": "a69df230-7eee-3906-ad5c-c683f4ba54e1",
                                        "glosses": [
                                            "Maquiller d’une couleur foncée et d’une manière très voyante."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c41f7c7-27ad-4255-add1-62ac5a473769",
                                                "sense_id": "9670da32-9514-335c-b2ad-64ae2055f782",
                                                "text": "L’œil avivé de fard et les cils charbonnés, elles sourient, de leurs lèvres peintes, à l’amant inconnu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec8ae607-e03d-3412-9562-86fa125cefdf",
                                        "entry_id": "a69df230-7eee-3906-ad5c-c683f4ba54e1",
                                        "glosses": [
                                            "Allumer (séduire)."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fb18254-7e66-4082-a552-6926de58484b",
                                                "sense_id": "ec8ae607-e03d-3412-9562-86fa125cefdf",
                                                "text": "Joan se fait charbonner par Natasha."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1717bac6-4f44-3513-8ebf-b42bc1a00543",
                                        "entry_id": "a69df230-7eee-3906-ad5c-c683f4ba54e1",
                                        "glosses": [
                                            "Travailler."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a314a19-dcf7-4742-8250-ee6fd747e566",
                                                "sense_id": "1717bac6-4f44-3513-8ebf-b42bc1a00543",
                                                "text": "J’voudrais sortir la daronne de son HLM pourrave / Plus voir la p’tite sœur charbonner chez H&M : courage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b63039a-f49c-363b-bd7e-f9055eaad7c5",
                                        "entry_id": "a69df230-7eee-3906-ad5c-c683f4ba54e1",
                                        "glosses": [
                                            "Vendre de la drogue."
                                        ],
                                        "tags": [
                                            "especially",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efed1585-7468-4ad7-b831-5a3a8f47172d",
                                                "sense_id": "9b63039a-f49c-363b-bd7e-f9055eaad7c5",
                                                "text": "Vendre se dit « charbonner » en langage trafiquant. Et de fait, le vendeur est concrètement celui qui va au charbon. En première ligne lors des descentes de police, responsable de sa marchandise, du placement des guetteurs, de la recette du jour… Une sacrée pression pour un profil d'ordinaire plutôt jeune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4abba977-12a1-32b3-a857-7684e04eca7d",
                                        "entry_id": "a69df230-7eee-3906-ad5c-c683f4ba54e1",
                                        "glosses": [
                                            "Passer à l’état de charbon."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68112ac7-5a0f-4445-a309-272ca6df8b64",
                                                "sense_id": "4abba977-12a1-32b3-a857-7684e04eca7d",
                                                "text": "Leurs cigares charbonnaient et puaient comme des fumerons."
                                            },
                                            {
                                                "example_id": "700c721a-fb15-42f0-bae6-a0b2dd549455",
                                                "sense_id": "4abba977-12a1-32b3-a857-7684e04eca7d",
                                                "text": "Le feu s’était éteint, et ma lampe charbonnait ; un froid, léger comme une caresse, m’envahissait les jambes, courait sur mes reins avec de petits frissons délicieux."
                                            },
                                            {
                                                "example_id": "f1a3be9f-8004-47e6-84c9-c60cf82d8c35",
                                                "sense_id": "4abba977-12a1-32b3-a857-7684e04eca7d",
                                                "text": "Le petit jour le surprit, travaillant et songeant tour a tour ; sa lampe charbonna, fuma, s’éteignit."
                                            },
                                            {
                                                "example_id": "2db602b9-b63e-4138-97e8-5bbd75b2f095",
                                                "sense_id": "4abba977-12a1-32b3-a857-7684e04eca7d",
                                                "text": "Toujours, il y en avait une qui allait voir, tandis que l’autre s’impatientait dans la salle, où charbonnait une lampe."
                                            },
                                            {
                                                "example_id": "910387f2-52cc-4a3e-934d-84c1926d7230",
                                                "sense_id": "4abba977-12a1-32b3-a857-7684e04eca7d",
                                                "text": "[…] la vue des lavabos recouverts de serviettes, des lits transformés en vestiaires, sur le couvre-pied desquels s’entassaient les pardessus et les chapeaux lui donnait la même sensation d’étouffement que peut causer aujourd’hui à des gens habitués à vingt ans d’électricité l’odeur d’une lampe qui charbonne ou d’une veilleuse qui file."
                                            },
                                            {
                                                "example_id": "855854fa-0678-4a70-a2ad-c55b1683c205",
                                                "sense_id": "4abba977-12a1-32b3-a857-7684e04eca7d",
                                                "text": "C’était un vieux four à chaux dans la campagne de Kiew, à quelque distance des ruines d’un village ou, plutôt, du foyer éteint où charbonnaient encore quelques braises de l’énorme volute de feu qu’avait été, la veille, ce village."
                                            },
                                            {
                                                "example_id": "984ca291-74d2-41ec-8e2a-9d41e86e9829",
                                                "sense_id": "4abba977-12a1-32b3-a857-7684e04eca7d",
                                                "text": "La flamme bleuâtre de la lampe à essence vacillait au moindre coulis d’air. Déchaussés, nous tendions les pieds vers la bûche qui charbonnait, précieusement couverte de cendre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bc3dd43-93ee-3a1b-8379-f697ecac43e1",
                                        "entry_id": "a69df230-7eee-3906-ad5c-c683f4ba54e1",
                                        "glosses": [
                                            "S’approvisionner en charbon."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4889fde9-6527-4043-9779-2ce5864d0167",
                                                "sense_id": "0bc3dd43-93ee-3a1b-8379-f697ecac43e1",
                                                "text": "Ce navire nous apprit que, contrarié par le temps, il devait charbonner à Seydisfjard sur la côte Est d'Islande."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e31f523e-266f-304d-b068-3bd73ef63861",
                                        "entry_id": "a69df230-7eee-3906-ad5c-c683f4ba54e1",
                                        "glosses": [
                                            "Fumer la chicha."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1fbc1b99-1d77-4679-9c53-0e2af145bda7",
                                                "sense_id": "e31f523e-266f-304d-b068-3bd73ef63861",
                                                "text": "Pour ma part. Je charbonne. Chicha pomme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03986d21-d262-34ff-b9b9-c06ea0b5a127",
                                        "entry_id": "a69df230-7eee-3906-ad5c-c683f4ba54e1",
                                        "glosses": [
                                            "Passer à l’état de charbon."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c9fff62-225e-4eca-9bc7-40a60170af52",
                                                "sense_id": "03986d21-d262-34ff-b9b9-c06ea0b5a127",
                                                "text": "Le bois, plongé dans l’acide sulfurique concentré, se charbonne. Certains bois se charbonnent difficilement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6f3dba2-2ae5-4c24-82c5-b85e9288063b",
                        "source_entry_id": "52584107-9696-338b-9c6f-0baf3eea2a86",
                        "target_lang_word": "noircir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "noircir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8146bd0b-2390-342b-9691-dae4c84fa515",
                                        "entry_id": "44d2585e-7d24-3011-9266-45d722c03497",
                                        "glosses": [
                                            "Rendre noir, passer au noir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70ff6a36-adc8-4e0c-8684-ff1350f7a476",
                                                "sense_id": "8146bd0b-2390-342b-9691-dae4c84fa515",
                                                "text": "Dès qu'il fait beau, la moindre brise soulève une fine poussière basaltique qui noircit tous les objets et pénètre dans les habitations les mieux closes."
                                            },
                                            {
                                                "example_id": "436df92f-1379-4991-b2fd-893d599c3286",
                                                "sense_id": "8146bd0b-2390-342b-9691-dae4c84fa515",
                                                "text": "Ils portaient, sous la couche de huita qui les noircissait des pieds à la tête, des tatouages géométriques, et leurs oreilles étaient percées pour livrer passage à des petits bouts de bois."
                                            },
                                            {
                                                "example_id": "4f7643e5-9748-4977-a21a-e4805a9badc3",
                                                "sense_id": "8146bd0b-2390-342b-9691-dae4c84fa515",
                                                "text": "Elle dérobait du kohl à sa mère pour s’en noircir les cils et donner à ses yeux agrandis la langueur du regard des gazelles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12f87ff9-5de4-3a85-83e2-e4b0bde10f15",
                                        "entry_id": "44d2585e-7d24-3011-9266-45d722c03497",
                                        "glosses": [
                                            "Faire naître, dans l’esprit, des pensées tristes, sombres."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a152643d-74da-4127-a387-c85e7e12e8a2",
                                                "sense_id": "12f87ff9-5de4-3a85-83e2-e4b0bde10f15",
                                                "text": "Cette lecture m’a noirci l’esprit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eceb4993-f4aa-32a5-9d30-0b0440d4b5f3",
                                        "entry_id": "44d2585e-7d24-3011-9266-45d722c03497",
                                        "glosses": [
                                            "Diffamer, faire passer pour méchant, pour infâme."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4725e75e-d293-4be8-bfff-380ae1fa58ab",
                                                "sense_id": "eceb4993-f4aa-32a5-9d30-0b0440d4b5f3",
                                                "text": "La calomnie peut noircir l’homme le plus innocent, la conduite la plus pure."
                                            },
                                            {
                                                "example_id": "5acb0e78-7fb8-48c6-8526-5fa8f7fc15ce",
                                                "sense_id": "eceb4993-f4aa-32a5-9d30-0b0440d4b5f3",
                                                "text": "Noircir la réputation de quelqu’un."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8e38ab0-7c05-3b7c-b407-249cbb6b832e",
                                        "entry_id": "44d2585e-7d24-3011-9266-45d722c03497",
                                        "glosses": [
                                            "Remplir par l'écriture. → voir noircir du papier"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d691d56-0643-4824-9de5-4c8418b4fed9",
                                                "sense_id": "b8e38ab0-7c05-3b7c-b407-249cbb6b832e",
                                                "text": "Cependant, quand je regarde des carnets que je noircissais enfant, vers sept ou huit ans, c'était déjà sous forme poétique, en vers, en forme hachurée très graphique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "07c15e37-0f9c-301f-9da5-63cfe13cc016",
                                        "entry_id": "44d2585e-7d24-3011-9266-45d722c03497",
                                        "glosses": [
                                            "Devenir noir."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd044c33-b47f-486c-b4a7-24c8a79e8848",
                                                "sense_id": "07c15e37-0f9c-301f-9da5-63cfe13cc016",
                                                "text": "Je regarde noircir les arbres et verdir le ciel, Vénus y brille seule, je t’attends."
                                            },
                                            {
                                                "example_id": "426fb8fe-b213-4fe7-abde-d6ad34984263",
                                                "sense_id": "07c15e37-0f9c-301f-9da5-63cfe13cc016",
                                                "text": "Un teint, une peau qui noircit."
                                            },
                                            {
                                                "example_id": "363f306b-a828-4e88-8d3a-509af4f54db0",
                                                "sense_id": "07c15e37-0f9c-301f-9da5-63cfe13cc016",
                                                "text": "Ce bois ne brûle pas, il ne fait que noircir, il noircit au feu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b3f28286-0c9b-3740-8fe1-6315c432e432",
                                        "entry_id": "44d2585e-7d24-3011-9266-45d722c03497",
                                        "glosses": [
                                            "Se rendre odieux, infâme par quelque mauvaise action."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2786bdb-41c6-4918-9a84-9c6ac248708a",
                                                "sense_id": "b3f28286-0c9b-3740-8fe1-6315c432e432",
                                                "text": "Voudrait-il se noircir d’un tel crime ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49aaae67-337e-3c82-893d-566d49346ffd",
                                        "entry_id": "44d2585e-7d24-3011-9266-45d722c03497",
                                        "glosses": [
                                            "Devenir noir."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50808eca-8ae2-469c-99ed-9a63db4333a5",
                                                "sense_id": "49aaae67-337e-3c82-893d-566d49346ffd",
                                                "text": "Cela s’est noirci à la fumée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0246cc0-c301-3cdd-9750-926bcda57cf3",
                                        "entry_id": "44d2585e-7d24-3011-9266-45d722c03497",
                                        "glosses": [
                                            "Devenir obscur, se couvrir de nuages épais, en parlant du ciel."
                                        ],
                                        "tags": [
                                            "especially",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3307cec-ae2c-4161-b744-069672c87b99",
                                                "sense_id": "d0246cc0-c301-3cdd-9750-926bcda57cf3",
                                                "text": "Le temps se noircit, le ciel se noircit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "185f4e3b-0d28-36f8-a132-7cea60ffa6c3",
                                        "entry_id": "44d2585e-7d24-3011-9266-45d722c03497",
                                        "glosses": [
                                            "S’enivrer."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figuratively",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3af2f2e-99fc-44ea-a055-01a7bd229544",
                                                "sense_id": "185f4e3b-0d28-36f8-a132-7cea60ffa6c3",
                                                "text": "Elle ne veut pas comprendre que je vis là des journées confiantes et préservées, que si-je-n’en-fais-jamais-d’autres, du moins je ne fais rien de mal ; elle a peur que je me noircisse pendant qu’elle se brunit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
