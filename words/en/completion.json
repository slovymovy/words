{
    "word_family": [
        "complete",
        "completely",
        "completeness",
        "completer",
        "incompletion",
        "uncompleted"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "acaced75-defa-3880-9285-7a4de0b22354",
                    "sense_definition": "The act of finishing something or the state of being finished.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "finishing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project is nearing <w>completion</w> after months of hard work by the entire team.",
                            "target_lang_translations": {
                                "ru": "Проект близится к <w>завершению</w> после месяцев упорной работы всей команды."
                            }
                        },
                        {
                            "text": "We are waiting for the successful <w>completion</w> of the building before we can move in.",
                            "target_lang_translations": {
                                "ru": "Мы ждем успешного <w>окончания</w> строительства здания, прежде чем сможем въехать."
                            }
                        }
                    ],
                    "synonyms": [
                        "accomplishment",
                        "conclusion",
                        "fulfillment",
                        "realization"
                    ],
                    "antonyms": [
                        "incompletion"
                    ],
                    "common_phrases": [
                        "successful completion",
                        "near completion",
                        "awaiting completion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по завершению чего-либо или состояние завершенности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завершение",
                                "target_lang_sense_clarification": "окончание процесса или дела"
                            },
                            {
                                "target_lang_word": "окончание",
                                "target_lang_sense_clarification": "финальная стадия"
                            },
                            {
                                "target_lang_word": "выполнение",
                                "target_lang_sense_clarification": "реализация задачи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7120bbb0-d679-3459-8f69-b1cf40644bd0",
                    "sense_definition": "A software feature that finishes a word or phrase as the user types it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can use tab <w>completion</w> in the terminal to quickly find the right file name.",
                            "target_lang_translations": {
                                "ru": "Вы можете использовать <w>дополнение</w> через Tab в терминале, чтобы быстро найти нужное имя файла."
                            }
                        },
                        {
                            "text": "The code editor provides automatic <w>completion</w> for most programming languages.",
                            "target_lang_translations": {
                                "ru": "Редактор кода обеспечивает автоматическое <w>автодополнение</w> для большинства языков программирования."
                            }
                        }
                    ],
                    "synonyms": [
                        "autocomplete"
                    ],
                    "common_phrases": [
                        "tab completion",
                        "automatic completion",
                        "code completion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Функция программного обеспечения, которая дописывает слово или фразу по мере ввода пользователем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "автодополнение",
                                "target_lang_sense_clarification": "автоматическое завершение ввода"
                            },
                            {
                                "target_lang_word": "дополнение",
                                "target_lang_sense_clarification": "в контексте командной строки или кода"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "525e8b41-52a5-3b00-8638-a04fbd9b76b4",
                    "sense_definition": "In American football, a forward pass that is caught by a teammate.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The quarterback finished the game with a high <w>completion</w> rate and three touchdowns.",
                            "target_lang_translations": {
                                "ru": "Квотербек закончил игру с высоким процентом <w>завершенных пасов</w> и тремя тачдаунами."
                            }
                        },
                        {
                            "text": "That spectacular <w>completion</w> in the final seconds secured the win for the home team.",
                            "target_lang_translations": {
                                "ru": "Тот эффектный <w>прием</w> на последних секундах обеспечил победу домашней команде."
                            }
                        }
                    ],
                    "common_phrases": [
                        "completion rate",
                        "pass completion"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily US"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В американском футболе — пас вперед, пойманный игроком своей команды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прием",
                                "target_lang_sense_clarification": "успешная ловля паса"
                            },
                            {
                                "target_lang_word": "завершенный пас",
                                "target_lang_sense_clarification": "точная передача"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58902898-57fa-3456-a7df-bc679b3f759f",
                    "sense_definition": "The final stage of a property sale when ownership is legally transferred.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal_real_estate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The keys will be handed over to the new owners upon <w>completion</w> of the sale.",
                            "target_lang_translations": {
                                "ru": "Ключи будут переданы новым владельцам после <w>завершения сделки</w> купли-продажи."
                            }
                        },
                        {
                            "text": "The lawyer confirmed that the date of <w>completion</w> has been set for next Friday.",
                            "target_lang_translations": {
                                "ru": "Адвокат подтвердил, что дата <w>оформления</w> сделки назначена на следующую пятницу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "date of completion",
                        "completion of sale"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заключительный этап продажи недвижимости, когда право собственности юридически переходит к покупателю."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завершение сделки",
                                "target_lang_sense_clarification": "окончательный расчет и передача прав"
                            },
                            {
                                "target_lang_word": "оформление",
                                "target_lang_sense_clarification": "финализация договора купли-продажи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d5668b11-9cc9-31e4-b99d-f9e0dde21a21",
                    "sense_definition": "The mathematical process of making a metric space complete by adding missing points.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>completion</w> of the rational numbers results in the set of real numbers.",
                            "target_lang_translations": {
                                "ru": "<w>Пополнение</w> рациональных чисел приводит к множеству вещественных чисел."
                            }
                        },
                        {
                            "text": "In functional analysis, we often work with the <w>completion</w> of a normed vector space.",
                            "target_lang_translations": {
                                "ru": "В функциональном анализе мы часто работаем с <w>пополнением</w> нормированного векторного пространства."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Математический процесс превращения метрического пространства в полное путем добавления недостающих точек."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пополнение",
                                "target_lang_sense_clarification": "процесс расширения пространства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbc50ca9-2be5-3171-85c8-58dd84437738",
                    "sense_definition": "The resulting mathematical space after the process of making it complete.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every metric space has a unique <w>completion</w> up to isometry.",
                            "target_lang_translations": {
                                "ru": "Каждое метрическое пространство имеет единственное <w>пополнение</w> с точностью до изометрии."
                            }
                        },
                        {
                            "text": "We denote the <w>completion</w> of the space by adding a bar over the original symbol.",
                            "target_lang_translations": {
                                "ru": "Мы обозначаем <w>пополнение</w> пространства, добавляя черту над исходным символом."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Математическое пространство, полученное в результате процесса его пополнения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пополнение",
                                "target_lang_sense_clarification": "результирующее полное пространство"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}