                        "glosses": [
                            "een product kopen bij een partij om het met winst door te verkopen aan een andere partij"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62c7c2ad-09a3-43fa-9b62-1e223666b48f",
                                "sense_id": "cd52c855-9681-3ea0-be76-994cdeb218ea",
                                "text": "Philips schrijft in een reactie dat het bedrijf weet dat zijn lampen en componenten worden gebruikt voor de wietteelt. Volgens het concern is twee jaar geleden besloten om niet meer te leveren aan bedrijven die de lampen doorleveren aan de wietbranche."
                            },
                            {
                                "example_id": "c2930fc8-f05a-449d-9acd-70aae69a9ff9",
                                "sense_id": "cd52c855-9681-3ea0-be76-994cdeb218ea",
                                "text": "Nederland levert ook van alles aan landen die vaak ook weer doorleveren naar Rusland, zoals Polen, Estland, Letland en Litouwen. Het is niet duidelijk hoeveel geboycotte goederen uit Nederland via die landen in Rusland terecht komen, zegt het CBS."
                            },
                            {
                                "example_id": "9447e180-d925-47d3-9b0d-7547c1c4463a",
                                "sense_id": "cd52c855-9681-3ea0-be76-994cdeb218ea",
                                "text": "Militair Marco Kroon begint een rechtszaak tegen justitie. Hij werd verdacht van drugsbezit, maar de rechter sprak hem vrij. Kroon vroeg het OM om excuses, maar kreeg die niet. In de strafzaak werd hij wel veroordeeld voor het doorleveren van stroomstootwapens."
                            }
                        ]
                    }
