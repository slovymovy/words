                ],
                "senses": [
                    {
                        "sense_id": "5842aa6f-0184-314e-9f0a-eba98a66ed26",
                        "entry_id": "78a0ee60-c745-3892-99f2-5079a626b7a9",
                        "glosses": [
                            "An occasion on which one backslides, especially in a moral sense."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4063caab-cb88-4674-8628-f44ad86ad160",
                                "sense_id": "5842aa6f-0184-314e-9f0a-eba98a66ed26",
                                "text": "democratic backsliding"
                            },
                            {
                                "example_id": "2f6d8eb0-8e1a-42fa-b2dc-949ec0f9b2aa",
                                "sense_id": "5842aa6f-0184-314e-9f0a-eba98a66ed26",
                                "text": "We have had many stumblings and many backslidings."
                            },
                            {
                                "example_id": "2744e93c-76f3-460b-a0a0-85eb14dd4910",
                                "sense_id": "5842aa6f-0184-314e-9f0a-eba98a66ed26",
                                "text": "If their actions are bad, look back and inquire into the cause of their backslidings."
                            },
                            {
                                "example_id": "57f87cb2-1c47-4296-a303-7888dd7f8df9",
                                "sense_id": "5842aa6f-0184-314e-9f0a-eba98a66ed26",
                                "text": "All their struggles, disappointments, failures, backslidings, which made them unhappy here, because they could not perfectly do the will of God, are past and over for ever."
                            },
                            {
                                "example_id": "466d22c4-4331-410d-812a-ab3b748a9eb4",
                                "sense_id": "5842aa6f-0184-314e-9f0a-eba98a66ed26",
                                "text": "That is why any backsliding – disappearing to the toilet at last orders; ordering crazily expensive drinks on other people’s rounds; abruptly leaving after two pints – is sacrilege."
                            }
                        ]
                    }
                ],
