                "senses": [
                    {
                        "sense_id": "5309218b-5d27-35dc-90d2-99c1c1735bb5",
                        "entry_id": "0a6e2f49-2614-3921-872f-45f89561ff32",
                        "glosses": [
                            "Balluchonner à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7347efdf-5639-4907-a989-4b07c9fae6a5",
                                "sense_id": "5309218b-5d27-35dc-90d2-99c1c1735bb5",
                                "text": "Si j'ai bien compris, pour gratter \"en sécurité\", je vais devoir déballuchonner mes compos avec une première dla, déballuchonner mon parcho (2Pa), gratter (3Pa) et reballuchonner (1Pa) avec une seconde dla."
                            },
                            {
                                "example_id": "9fd510b2-cfa5-4575-896a-f226b3d70b82",
                                "sense_id": "5309218b-5d27-35dc-90d2-99c1c1735bb5",
                                "text": "Par contre on ne peut pas reballuchonner, car si tu tentes de balluchonner un objet déjà balluchonné, ça fait un débaluchonnage."
                            }
                        ]
                    }
                ],
