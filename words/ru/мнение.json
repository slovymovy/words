{
    "word_family": [
        "сомнение",
        "самомнение",
        "мнительный",
        "мнимый",
        "возомнить",
        "мнить"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e84dd0e3-6886-32ca-b7c8-113b851d679a",
                    "sense_definition": "Суждение, выражающее оценку чего-либо, отношение к кому-либо или чему-либо, взгляд на вещи.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "general_view",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "По моему <w>мнению</w>, этот фильм очень интересный и поучительный.",
                            "target_lang_translations": {
                                "en": "In my <w>opinion</w>, this film is very interesting and instructive.",
                                "zh": "在我的<w>意见</w>里，这部电影既有趣又有教育意义。"
                            }
                        },
                        {
                            "text": "У каждого человека должно быть своё личное <w>мнение</w>.",
                            "target_lang_translations": {
                                "en": "Every person should have their own personal <w>opinion</w>.",
                                "zh": "每个人都应该有自己的个人<w>看法</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "взгляд",
                        "точка зрения",
                        "суждение",
                        "оценка"
                    ],
                    "common_phrases": [
                        "по моему мнению",
                        "общественное мнение",
                        "личное мнение",
                        "высказывать мнение",
                        "менять мнение"
                    ],
                    "target_lang_definitions": {
                        "en": "A judgment expressing an evaluation, attitude, or view regarding something.",
                        "zh": "对某事物的评价、态度或看法。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "opinion",
                                "target_lang_sense_clarification": "personal belief or judgment"
                            },
                            {
                                "target_lang_word": "view",
                                "target_lang_sense_clarification": "perspective or way of thinking"
                            },
                            {
                                "target_lang_word": "point of view",
                                "target_lang_sense_clarification": "specific standpoint"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "意见",
                                "target_lang_sense_clarification": "个人对某事物的看法或想法"
                            },
                            {
                                "target_lang_word": "观点",
                                "target_lang_sense_clarification": "观察事物时所处的立场或态度"
                            },
                            {
                                "target_lang_word": "看法",
                                "target_lang_sense_clarification": "对事物的主观评价"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04d7db6f-5bcf-3377-ad3f-064450876ef9",
                    "sense_definition": "Официальное заключение специалиста или уполномоченного органа по какому-либо вопросу.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "official_judgment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Судья приобщил к делу особое <w>мнение</w> одного из членов комиссии.",
                            "target_lang_translations": {
                                "en": "The judge attached the dissenting <w>opinion</w> of one of the commission members to the case file.",
                                "zh": "法官将委员会成员之一的特别<w>意见</w>附在了案卷中。"
                            }
                        },
                        {
                            "text": "Мы ждём экспертное <w>мнение</w> специалиста, чтобы принять окончательное решение.",
                            "target_lang_translations": {
                                "en": "We are waiting for the expert <w>opinion</w> of a specialist to make a final decision.",
                                "zh": "我们正在等待专家的专业<w>意见</w>，以便做出最终决定。"
                            }
                        }
                    ],
                    "synonyms": [
                        "заключе́ние"
                    ],
                    "common_phrases": [
                        "особое мнение",
                        "мнение эксперта",
                        "мнение суда"
                    ],
                    "target_lang_definitions": {
                        "en": "An official conclusion provided by a specialist or authority on a matter.",
                        "zh": "专家或权威机构就某问题给出的正式结论。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "opinion",
                                "target_lang_sense_clarification": "formal or expert conclusion"
                            },
                            {
                                "target_lang_word": "judgment",
                                "target_lang_sense_clarification": "formal decision or ruling"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "意见",
                                "target_lang_sense_clarification": "正式的专业评估或结论"
                            },
                            {
                                "target_lang_word": "结论",
                                "target_lang_sense_clarification": "经过分析后得出的最终判断"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}