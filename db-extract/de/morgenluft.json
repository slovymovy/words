                ],
                "senses": [
                    {
                        "sense_id": "42b60b55-3563-3b44-8e9a-560312ede4aa",
                        "entry_id": "b5b62d2a-7edd-32ac-862b-0fb868cb77d6",
                        "glosses": [
                            "frische, noch relativ kühle und saubere Luft am Morgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "348e8e6a-cec2-40b2-b61e-b96c6fba6a9d",
                                "sense_id": "42b60b55-3563-3b44-8e9a-560312ede4aa",
                                "text": "„Ich roch die klare Morgenluft und die feuchte Wiese hinter der Straße.“"
                            },
                            {
                                "example_id": "a4753c08-15f1-4d5c-ac3d-004b3960033c",
                                "sense_id": "42b60b55-3563-3b44-8e9a-560312ede4aa",
                                "text": "„Dann ging ich die Straße hinunter und genoss die Morgenluft an meinem nackten Kopf.“"
                            },
                            {
                                "example_id": "d45fbb9c-cb09-4ab2-be84-3bd0bcd20961",
                                "sense_id": "42b60b55-3563-3b44-8e9a-560312ede4aa",
                                "text": "„Fontenelles Darstellung der kopernikanischen Wende atmet die Morgenluft einer neuen Zeit.“"
                            },
                            {
                                "example_id": "64717581-a573-473d-b730-d83160d8fb80",
                                "sense_id": "42b60b55-3563-3b44-8e9a-560312ede4aa",
                                "text": "„Die Fenster der Häuser stehen offen, um die warme Morgenluft hereinzulassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
