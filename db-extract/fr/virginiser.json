                "senses": [
                    {
                        "sense_id": "04e2e83f-efbf-3ee5-be6f-0695d1053d50",
                        "entry_id": "3a017e5c-ee1b-337b-bc0f-340e251bcd69",
                        "glosses": [
                            "Rendre vierge, ou en donner l’apparence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4f32d10-6140-4607-b8d6-cb4f3e2297b3",
                                "sense_id": "04e2e83f-efbf-3ee5-be6f-0695d1053d50",
                                "text": "N'est-il pas question d'alimenter le spirituel, de vivifier le spirituel, de virginiser toutes nos démarches."
                            },
                            {
                                "example_id": "813711d3-19e2-43a3-a9a8-b29891922852",
                                "sense_id": "04e2e83f-efbf-3ee5-be6f-0695d1053d50",
                                "text": "Elle a été si virginisante que ses noces même ont abouti à virginiser son époux et son beau-frère."
                            }
                        ]
                    },
