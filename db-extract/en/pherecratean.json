                "senses": [
                    {
                        "sense_id": "218dca5b-fb48-3a04-b508-4bff958994e5",
                        "entry_id": "0a48e77f-32e4-3cf2-96b3-083ef078dbd8",
                        "glosses": [
                            "Consisting of three prosodic feet, normally a spondee, dactyl, and spondee (or trochee), but admitting of some variations."
                        ],
                        "tags": [
                            "Ancient-Greek",
                            "Latin",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "92fc5293-f1ef-4821-82a4-d21294b78fe6",
                                "sense_id": "218dca5b-fb48-3a04-b508-4bff958994e5",
                                "text": "Pherecratean verses are sometimes combined in systems: but much more frequent are Glyconic systems closing with a Pherecratean."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "220fbd7f-0348-4af5-90f6-549b58a24739",
