                "senses": [
                    {
                        "sense_id": "2ec33e2f-a47a-3c9e-be00-90a1d6e85bcb",
                        "entry_id": "354f679a-9a1a-3259-8c4e-cca37f695c6a",
                        "glosses": [
                            "auf Jahrmärkten, Volksfesten oder in Vergnügungsparks anzutreffendes, elektrisch angetriebenes, autoähnliches, kleines zweisitziges, lenkbares Fahrzeug mit breitem, wulstartigem Gummirand (zum Schutz vor Zusammenstößen), das in einem Fahrgeschäft auf einer begrenzten Fahrfläche gesteuert wird"
                        ],
                        "tags": [
                            "westmitteldeutsch",
                            "(Moselgebiet)",
                            "Luxemburg"
                        ],
                        "examples": [
                            {
                                "example_id": "68c9a3bc-2116-45cc-8072-1fede0eb126f",
                                "sense_id": "2ec33e2f-a47a-3c9e-be00-90a1d6e85bcb",
                                "text": "„[‚]Ich bin schon sechs Mal Knuppauto gefahren‘, strahlte Lisa Blasius.“"
                            },
                            {
                                "example_id": "48563daa-bb5c-401f-8188-90e103a83664",
                                "sense_id": "2ec33e2f-a47a-3c9e-be00-90a1d6e85bcb",
                                "text": "„In den kleinen ‚Knuppautos‘ mit ihren langen Fahnenstangen am Heck kann der noch minderjährige Rennpilot schon mal seine Fahrkünste unter Beweis stellen und darf sogar die anderen ungestraft anrempeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
