                        "examples": [
                            {
                                "example_id": "016c06c6-b729-4be1-84ac-71fb4eb393a4",
                                "sense_id": "bf0e0df0-73b5-306b-8a6a-509fc5032ae9",
                                "text": "La réunionnite au sommet de son art. On n’entend pas une mouche voler : normal, elles savent qu’elles risquent de se faire violemment sodomiser."
                            },
                            {
                                "example_id": "42c5a386-cd1f-496e-9404-01ebc12353a6",
                                "sense_id": "bf0e0df0-73b5-306b-8a6a-509fc5032ae9",
                                "text": "Les enseignants des établissements les plus difficiles ayant le souhait, tout à fait légitime, d’éviter une accumulation de travail supplémentaire, comment leur faire admettre que les réunions peuvent ne pas dégénérer en réunionnite ?"
                            }
                        ]
