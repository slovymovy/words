                "senses": [
                    {
                        "sense_id": "06d41938-ca40-3512-86c7-79c1dfc05c2a",
                        "entry_id": "a278240f-d319-3442-b9b9-d71a81f15558",
                        "glosses": [
                            "Vergünstigung, Vorsprung gegenüber den Mitspielern beziehungsweise einer anderen Spielmannschaft oder Spielpartei hinsichtlich des Spielerfolgs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7299e809-cab0-4071-9f0d-f8b91bc3fb7a",
                                "sense_id": "06d41938-ca40-3512-86c7-79c1dfc05c2a",
                                "text": "„Die Spielenden sollten allerdings zwischen bewusstem Mogeln, das die Absicht verfolgt, sich regelwidrig gezielt unlautere Spielvorteile zu verschaffen und Spielfehlern, die aus Unkenntnis oder Ungeschicklichkeit, Versehen oder Spieleifer erwachsen, unterscheiden.“"
                            },
                            {
                                "example_id": "d9705ec2-b068-48dc-bb9c-141fd3b6eda7",
                                "sense_id": "06d41938-ca40-3512-86c7-79c1dfc05c2a",
                                "text": "„Der FCI erarbeitete sich immer mehr Spielvorteile - nur an der Chancenausbeute mangelte es.“"
                            },
                            {
                                "example_id": "20834e55-6d06-4c4a-837d-16d7303f057c",
                                "sense_id": "06d41938-ca40-3512-86c7-79c1dfc05c2a",
                                "text": "„Mit Robben ab der 55. Minute wollte Guardiola mehr Tempo und Zielstrebigkeit ins Münchner Spiel bringen - trotz klarer Spielvorteile blieb der Rekordpokalsieger aber weiter vieles schuldig.“"
                            },
                            {
                                "example_id": "b926a597-0de7-43e1-850e-ef952052b228",
                                "sense_id": "06d41938-ca40-3512-86c7-79c1dfc05c2a",
                                "text": "„Während bei den Gästen die Rückraum-Asse Filip Jicha und Pavel Horak sichtlich an Durchschlagskraft einbüßten, steigerte sich die deutsche Mannschaft in der Abwehr und verschaffte sich so Spielvorteile, musste aber bis zum Ende auf der Hut sein.“"
                            },
                            {
                                "example_id": "0a932f6d-e045-4212-bea9-dda0101d2c2a",
                                "sense_id": "06d41938-ca40-3512-86c7-79c1dfc05c2a",
                                "text": "„Seine erste Möglichkeit hatte der blasse HSV, der aus seinen Spielvorteilen vor 52523 Zuschauern zunächst kein Kapital schlagen konnte, durch seinen treffsichersten Torjäger.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
