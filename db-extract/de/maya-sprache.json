                "senses": [
                    {
                        "sense_id": "caa9d001-3e14-34b4-b52b-679c54161f86",
                        "entry_id": "d7811a5b-af2d-30b9-82f1-52f30e358ff0",
                        "glosses": [
                            "in Mittelamerika verbreitete Sprachfamilie"
                        ],
                        "tags": [
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "2feea8a8-3c04-4c5b-aa53-6ed66b8780cf",
                                "sense_id": "caa9d001-3e14-34b4-b52b-679c54161f86",
                                "text": "„Die modernen Maya-Sprachen sind im südlichen Mexiko, in Guatemala, Belize und im Nordwesten von Honduras verbreitet.“"
                            },
                            {
                                "example_id": "4474185c-5424-4201-8959-beea0a73fb76",
                                "sense_id": "caa9d001-3e14-34b4-b52b-679c54161f86",
                                "text": "„Da die Maya-Sprachen keinen morphologischen Kasus am Nomen kennen, muss die Kennzeichnung des jeweiligen Kasus von Subjekt und Objekt zwangsläufig am Verb stattfinden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2c3b6115-9758-3822-ab07-ec8c3ad41ddc",
                        "entry_id": "d7811a5b-af2d-30b9-82f1-52f30e358ff0",
                        "glosses": [
                            "Sprache, die Vertreter dieser Sprachfamilie ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b43fcd2b-e46c-4f87-b20f-e8f9756a9f84",
                                "sense_id": "2c3b6115-9758-3822-ab07-ec8c3ad41ddc",
                                "text": "„Wie aber kann die vereinigende Symbolkraft der Sprache in Guatemala zum Tragen kommen, in dem rund 22 verschiedene Maya-Sprachen mit einer Vielzahl von unterschiedlichen Dialekten gesprochen werden?“"
                            },
                            {
                                "example_id": "7f195bad-7938-49e2-8bee-c6dee05b3559",
                                "sense_id": "2c3b6115-9758-3822-ab07-ec8c3ad41ddc",
                                "text": "Quiché ist die meistgesprochene Maya-Sprache."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
