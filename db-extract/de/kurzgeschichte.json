                ],
                "senses": [
                    {
                        "sense_id": "8d6034f8-c2da-3e7c-8010-73d177146c0b",
                        "entry_id": "6f24f03d-01f7-309f-8fcb-0a04389a644f",
                        "glosses": [
                            "kurze, literarische Erzählung"
                        ],
                        "tags": [
                            "Literaturwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "eb604a7c-cec7-496a-89bd-31a7ca3b918a",
                                "sense_id": "8d6034f8-c2da-3e7c-8010-73d177146c0b",
                                "text": "„Ich hatte gerade beschlossen, den Nachmittag mit einer in arabischer Sprache verfassten Sammlung von Kurzgeschichten zu verbringen, die in den Gassen der Altstadt von Damaskus spielten.“"
                            },
                            {
                                "example_id": "7308cce8-f1f5-45f9-9a0b-88e363e3081c",
                                "sense_id": "8d6034f8-c2da-3e7c-8010-73d177146c0b",
                                "text": "„Erstaunlich viele unter diesen Kurzgeschichten gehören zu den Juwelen unserer Sprache.“"
                            },
                            {
                                "example_id": "fd1b9134-cdd2-4a99-bee9-ec886674c459",
                                "sense_id": "8d6034f8-c2da-3e7c-8010-73d177146c0b",
                                "text": "„Ihre Romane und Kurzgeschichten handeln von Frauen in Indien, von Hindu-Witwen und Schülerinnen, von tragischen Beziehungen.“"
                            },
                            {
                                "example_id": "4787240f-acfd-487b-8f86-4b601d0a99d1",
                                "sense_id": "8d6034f8-c2da-3e7c-8010-73d177146c0b",
                                "text": "„In diesen Kurzgeschichten lässt er fiktive Gestalten aus dem jüdischen Leben auftreten und wie in einem spontanen Gespräch von sich erzählen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
