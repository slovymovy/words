                                                "example_id": "25a83f99-ef59-46fe-8f67-8d79f30eda4d",
                                                "sense_id": "ed15b652-dcbc-3657-881b-2fa55d36d53e",
                                                "text": "a patchy performance"
                                            },
                                            {
                                                "example_id": "fe7046e2-b07c-4c76-9b64-db85268be5c2",
                                                "sense_id": "ed15b652-dcbc-3657-881b-2fa55d36d53e",
                                                "text": "Added to these woes was the Treasury's demands for across-the-board train operator cost-cutting of broadly 10%. Passenger rail's slow, patchy and fragile recovery had the stuffing knocked out of it once more."
                                            }
