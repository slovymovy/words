                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3d011d1-28f0-4d07-b27f-be8f4c20d4f1",
                                                "sense_id": "661e30e1-32ef-3dd6-9de3-eb77c169e3f4",
                                                "text": "While some of these moves will be prompted by, for instance, releasing equity to help children get on the property ladder, David Fell, Hamptons' senior analyst, says many will probably be downsizing to reduce mortgage payments to a more manageable level."
                                            }
                                        ]
