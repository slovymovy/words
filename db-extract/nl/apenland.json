                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd2e1754-86bf-4ac2-9b79-6ae439ed1267",
                                "sense_id": "9a48da22-d03e-3208-8b14-0591f59dd8b1",
                                "text": "Oeganda staat vooral bekend als apenland. Minder bekend is, dat het land ook een geweldige bestemming is voor wildsafari’s. Queen Elizabeth National Park is een van de pareltjes en het tweede bekende wildpark van Oeganda. Tijdens een gamedrive tref je onder andere kuddes olifanten, buffels, bavianen, leeuwen en vele antilopen, waaronder de Oeganda Kob."
                            }
