                        "glosses": [
                            "Variante orthographique de Nauru."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "d57ad164-d4af-4b86-a5e3-bd05d5b01254",
                                "sense_id": "4258684f-2f6d-3635-8502-578d6de5bbf7",
                                "text": "Les îlots élevés, Paanopa et Naourou, situés un peu en dehors et à l’ouest de la chaîne des attols ^([sic]) principaux, sont mieux partagés."
                            },
                            {
                                "example_id": "7e84afd9-27d0-485a-b63a-505133eb07db",
                                "sense_id": "4258684f-2f6d-3635-8502-578d6de5bbf7",
                                "text": "Les terres situées au sud (nord-est de la Nouvelle-Guinée, îles Bismarck, Salomon, etc.[)], soit par l'Australie (c'est le cas des terres indiquées), soit par la Nouvelle-Zélande (îles Samoa), soit directement par l'Angleterre (îles Naourou)."
                            },
                            {
                                "example_id": "b14e4a60-0e2b-42e5-a68e-73df859cdd25",
                                "sense_id": "4258684f-2f6d-3635-8502-578d6de5bbf7",
                                "text": "Dans le Pacifique sud, la Nouvelle-Guinée, les Archipels Bismarck et Salomon, remis à l’Australie ; les îles Naourou, à l’Angleterre ; les Samoa, à la Nouvelle-Zélande."
                            },
                            {
                                "example_id": "30c5b704-449b-4545-80ef-6d58c89ceb44",
                                "sense_id": "4258684f-2f6d-3635-8502-578d6de5bbf7",
                                "text": "L’île minuscule de Naourou tire des profits considérables de la vente de son phosphate, mais au prix de la dégradation de son sol et de la dislocation de son équilibre traditionnel."
                            }
                        ]
                    }
