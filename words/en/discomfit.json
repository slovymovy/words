{
    "word_family": [
        "discomfiture"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5798529e-1ae4-34a3-9851-1415e35f6ffb",
                    "sense_definition": "To cause someone to feel embarrassed, confused, or uneasy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "embarrassment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The unexpected question served to <w>discomfit</w> the speaker during the live interview.",
                            "target_lang_translations": {
                                "ru": "Неожиданный вопрос <w>смутил</w> оратора во время прямого эфира."
                            }
                        },
                        {
                            "text": "His rude comments were clearly intended to <w>discomfit</w> everyone at the dinner table.",
                            "target_lang_translations": {
                                "ru": "Его грубые замечания явно были направлены на то, чтобы <w>обескуражить</w> всех присутствующих за обеденным столом."
                            }
                        }
                    ],
                    "synonyms": [
                        "abash",
                        "disconcert",
                        "confuse",
                        "embarrass",
                        "mortify"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставить кого-либо чувствовать неловкость, смущение или замешательство."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смущать",
                                "target_lang_sense_clarification": "приводить в замешательство или неловкость"
                            },
                            {
                                "target_lang_word": "обескураживать",
                                "target_lang_sense_clarification": "лишать уверенности, озадачивать"
                            },
                            {
                                "target_lang_word": "конфузить",
                                "target_lang_sense_clarification": "вгонять в краску, ставить в неловкое положение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70869b56-9430-3162-8ca8-06edca22ab10",
                    "sense_definition": "To frustrate or prevent the success of someone's plans or hopes.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "frustration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden change in policy served to <w>discomfit</w> the opposition's long-term strategy.",
                            "target_lang_translations": {
                                "ru": "Внезапное изменение политики <w>расстроило</w> долгосрочную стратегию оппозиции."
                            }
                        },
                        {
                            "text": "New security measures were implemented to <w>discomfit</w> any potential criminal activity.",
                            "target_lang_translations": {
                                "ru": "Были введены новые меры безопасности, призванные <w>сорвать</w> любую потенциальную преступную деятельность."
                            }
                        }
                    ],
                    "synonyms": [
                        "foil",
                        "thwart"
                    ],
                    "target_lang_definitions": {
                        "ru": "Расстраивать или срывать чьи-либо планы, замыслы или надежды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "расстраивать",
                                "target_lang_sense_clarification": "срывать планы, нарушать порядок"
                            },
                            {
                                "target_lang_word": "срывать",
                                "target_lang_sense_clarification": "делать невозможным осуществление планов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0393ee6-b237-3c97-8816-6e80c799c597",
                    "sense_definition": "To defeat an opponent completely in a battle or conflict.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "defeat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The army managed to <w>discomfit</w> the invading forces in a decisive victory.",
                            "target_lang_translations": {
                                "ru": "Армии удалось <w>разгромить</w> силы вторжения и одержать решительную победу."
                            }
                        },
                        {
                            "text": "Historical accounts describe how the smaller unit managed to <w>discomfit</w> the larger enemy battalion.",
                            "target_lang_translations": {
                                "ru": "Исторические хроники описывают, как меньший отряд сумел <w>наголову разбить</w> превосходящий по численности батальон противника."
                            }
                        }
                    ],
                    "synonyms": [
                        "overthrow",
                        "vanquish"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Often used in historical or literary contexts regarding military conflict."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нанести сокрушительное поражение противнику в битве или войне (архаичное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разгромить",
                                "target_lang_sense_clarification": "нанести полное военное поражение"
                            },
                            {
                                "target_lang_word": "наголову разбить",
                                "target_lang_sense_clarification": "полностью победить в сражении"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}