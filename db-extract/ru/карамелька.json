                                                "example_id": "ca96fa91-d75e-47bc-8370-0f359073f12c",
                                                "sense_id": "164cf07e-6f2c-3f7e-890b-113d58a910fc",
                                                "text": "Il y a un chien devant la maison."
                                            },
                                            {
                                                "example_id": "9ce7ad26-7d0e-489e-b399-e136105ea193",
                                                "sense_id": "164cf07e-6f2c-3f7e-890b-113d58a910fc",
                                                "text": "Je cherche un livre sur tel sujet."
                                            },
                                            {
                                                "example_id": "7531a0a6-ad68-4977-858f-7e4a7fc1ea7f",
                                                "sense_id": "164cf07e-6f2c-3f7e-890b-113d58a910fc",
                                                "text": "C’est un César, un Cicéron, etc. : c’est un homme aussi intrépide que César, aussi éloquent que Cicéron, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d9bd5e1-46ab-3117-b35d-c8cd6225041b",
                                        "entry_id": "be87dd8d-ec95-3218-8cf0-a69d082c420b",
                                        "glosses": [
                                            "Tout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1e7f97f-a25d-41b5-b172-bc1133047f5e",
                                                "sense_id": "2d9bd5e1-46ab-3117-b35d-c8cd6225041b",
                                                "text": "Premier scénario, le plus optimiste : nous assisterions moins à la fin du monde qu’à la fin d’un monde, le nôtre, productiviste, consumériste, globalisé."
                                            },
                                            {
                                                "example_id": "59e57246-634f-4cf8-ac2d-8ea98fa49147",
                                                "sense_id": "2d9bd5e1-46ab-3117-b35d-c8cd6225041b",
                                                "text": "Un chrétien doit faire cela."
                                            },
                                            {
                                                "example_id": "de8c19e9-29d9-4176-a602-d0e593b52aa3",
                                                "sense_id": "2d9bd5e1-46ab-3117-b35d-c8cd6225041b",
                                                "text": "Un honnête homme n’a qu’une parole."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "124d1f8d-fec5-3cea-9f90-6cc5818dc907",
                                        "entry_id": "be87dd8d-ec95-3218-8cf0-a69d082c420b",
                                        "glosses": [
                                            "Devant un nom propre, sert à annoncer qu'on désignera un aspect de la personne dont il est question."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "312fdd12-964c-413b-bb06-39fc29c6ebca",
                                                "sense_id": "124d1f8d-fec5-3cea-9f90-6cc5818dc907",
                                                "text": "Voici un Zweig proche du journalisme."
                                            }
                                        ]
                                    }
                                ]
                            },
