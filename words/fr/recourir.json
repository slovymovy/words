                    "frequency": "Low",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Insatisfait du premier verdict, le prévenu a décidé de <w>recourir</w> en cassation."
                        },
                        {
                            "text": "Le demandeur peut <w>recourir</w> contre la décision administrative dans un délai de deux mois."
                        }
                    ],
                    "synonyms": [
