                "senses": [
                    {
                        "sense_id": "0c722be0-900f-3c61-89eb-4afa51f6bb01",
                        "entry_id": "81d28afa-c225-3c93-b3ab-24909bb412d7",
                        "glosses": [
                            "Transformer un endroit en chenal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68c0c027-8974-4702-9d5a-10da7f2106c2",
                                "sense_id": "0c722be0-900f-3c61-89eb-4afa51f6bb01",
                                "text": "Nous devons chenaliser le Couesnon de part et d’autre du mont Saint-Michel, à raison de 2/3 de ses eaux à l’ouest et 1/3 à l’est, grâce à un nouveau barrage."
                            },
                            {
                                "example_id": "445bc963-9d76-4056-ab3f-3210b15495e1",
                                "sense_id": "0c722be0-900f-3c61-89eb-4afa51f6bb01",
                                "text": "Le souci est de protéger les terrains des inondations et non de chenaliser le fleuve en corsetant le bourrelet de rive avec des levées."
                            },
                            {
                                "example_id": "2c4efa44-6ab9-46d0-b0f4-105269943845",
                                "sense_id": "0c722be0-900f-3c61-89eb-4afa51f6bb01",
                                "text": "Mais les ouvrages et leur finalité, loin de réhabiliter le val de Loire supérieur n’avaient que la hâte de chenaliser les eaux pour mieux servir un projet d’ensemble qui dépassait les ambitions locales."
                            }
                        ]
                    }
                ],
