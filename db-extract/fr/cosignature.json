                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc2b47f5-b2b4-4ad4-84a8-eef266698e6c",
                                "sense_id": "6feb5c28-e924-38ab-a05b-373cc87b397a",
                                "text": "Ce principe nouveau de la cosignature, appliqué à tous les actes importants de l’instruction aura pour effet d’impliquer davantage les juges opérant avec le juge initialement saisi."
                            },
                            {
                                "example_id": "a86a5b03-e8cd-4c47-9ddc-039cdaeb5b35",
                                "sense_id": "6feb5c28-e924-38ab-a05b-373cc87b397a",
                                "text": "D’autres plateformes ne prévoient tout simplement pas la possibilité de répondre en groupement ou dit autrement, la cosignature d’un même document par plusieurs entités."
                            },
                            {
                                "example_id": "4cbade6e-baa4-4e34-be77-08107a258f38",
                                "sense_id": "6feb5c28-e924-38ab-a05b-373cc87b397a",
                                "text": "Dans le cas d'une cosignature, les auteurs communs définissent un pourcentage de répartition des droits afférents à l’amiable."
                            }
                        ]
                    }
