    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8ee3d174-946a-3a24-b55e-f1b7a7cccb85",
                    "sense_definition": "Détacher des fruits, des fleurs ou des végétaux de leur tige ou de leur branche.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "recolte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants aiment <w>cueillir</w> des fleurs dans le pré pour faire un joli bouquet."
                        },
                        {
                            "text": "Nous irons <w>cueillir</w> des pommes au verger dès le début de l'automne."
                        }
                    ],
                    "synonyms": [
                        "ramasser",
                        "récolter"
                    ],
                    "common_phrases": [
                        "cueillir des fleurs",
                        "cueillir des fruits",
                        "cueillir des champignons"
                    ]
                },
                {
                    "sense_id": "ab4d2067-c3fe-3738-add2-d6b522706020",
                    "sense_definition": "Arrêter ou surprendre une personne au moment où elle s'y attend le moins.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "arrestation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les policiers ont réussi à le <w>cueillir</w> au saut du lit sans qu'il puisse réagir."
                        },
                        {
                            "text": "Le suspect pensait fuir à l'étranger, mais la douane l'a <w>cueilli</w> à la gare."
                        }
                    ],
                    "synonyms": [
                        "appréhender",
                        "arrêter",
                        "choper"
                    ],
                    "antonyms": [
                        "relâcher"
                    ],
                    "common_phrases": [
                        "se faire cueillir",
                        "cueillir au saut du lit"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ]
                },
                {
                    "sense_id": "6a91464e-138f-33e0-9f17-6ec8c1346a53",
                    "sense_definition": "Prendre ou dérober avec délicatesse, en passant.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "prendre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de partir, il s'est penché pour <w>cueillir</w> un baiser sur sa joue."
                        },
                        {
                            "text": "Le poète aimait <w>cueillir</w> les instants de bonheur éphémères du quotidien."
                        }
                    ],
                    "synonyms": [
                        "dérober",
                        "prendre"
                    ],
                    "common_phrases": [
                        "cueillir un baiser"
                    ]
                },
                {
                    "sense_id": "a0d5f4dc-44f8-3450-b931-31a297f37aa9",
                    "sense_definition": "Frapper ou atteindre brusquement un adversaire par surprise, en particulier dans un sport de combat.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "combat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le boxeur a baissé sa garde une seconde et l'autre l'a <w>cueilli</w> au menton."
                        },
                        {
                            "text": "Ce coup imprévu est venu le <w>cueillir</w> dès le premier round du combat."
                        }
                    ],
                    "synonyms": [
                        "frapper",
                        "toucher"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "terme familier de sport de combat"
                        }
                    ]
                }
            ]
        }
    ]
