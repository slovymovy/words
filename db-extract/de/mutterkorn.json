                ],
                "translations": [
                    {
                        "translation_id": "d866d25a-afef-472e-8bde-8c0062b82085",
                        "source_entry_id": "a9321840-7c35-30e8-a355-9ad88d3d3f6a",
                        "source_sense_id": "81dcbfc1-6094-3609-9bd9-4a0e4ab4500e",
