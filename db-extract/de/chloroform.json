                    {
                        "translation_id": "3548db3c-95e9-4e23-aa2f-e59e7f6ba66a",
                        "source_entry_id": "cb6d736b-8840-39a8-bc4e-1a896ec5b971",
                        "source_sense_id": "0dbc5361-7758-3be1-9238-47c9d78619d5",
                        "source_sense_description": "ein 1831 erstmals hergestellter chlorierter Kohlenwasserstoff",
                        "target_lang_word": "хлороформ",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "хлороформ",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "557e46cb-942d-34af-8786-f8940bd95265",
                                        "entry_id": "929b5eb2-46a1-38d0-8427-5d274fa7168e",
                                        "glosses": [
                                            "органическое соединение (хлорпроизводное метана), которое представляет собой бесцветную летучую жидкость с резким сладковатым запахом и используется в промышленности как растворитель и как сырьё для получения фреонов, а в специально очищенном виде применяется в качестве наркотического и анестезирующего средства"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "044ae86d-d6f8-4509-b011-bc667d6d866a",
                                                "sense_id": "557e46cb-942d-34af-8786-f8940bd95265",
                                                "text": "Теперь, ежели нервы ваши крепки, пройдите в дверь налево: в той комнате делают перевязки и операции. Вы увидите там докторов с окровавленными по локти руками и бледными угрюмыми физиономиями, занятых около койки, на которой, с открытыми глазами и говоря, как в бреду, бессмысленные, иногда простые и трогательные слова, лежит раненый, под влиянием хлороформа."
                                            },
                                            {
                                                "example_id": "4def3f4a-4d0d-4364-a386-dd716bb2e2d0",
                                                "sense_id": "557e46cb-942d-34af-8786-f8940bd95265",
                                                "text": "[Астров:] .. привезли с железной дороги стрелочника; положил я его на стол, чтобы ему операцию делать, а он возьми и умри у меня под хлороформом."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
