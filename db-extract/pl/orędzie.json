                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "888d163e-80dd-4f57-9676-e770d9c132f1",
                                "sense_id": "0055a099-1110-3169-86e7-e7a078d9072e",
                                "text": "W orędziu znalazły się odniesienia do katastrofy smoleńskiej."
                            },
                            {
                                "example_id": "5a8b5678-c292-4d6d-a439-cee0497fcf4d",
                                "sense_id": "0055a099-1110-3169-86e7-e7a078d9072e",
                                "text": "Burgrabia przysłał orędzie z napomnieniem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "69c7dafe-1f74-3ed0-9605-080ac02b4be3",
                        "entry_id": "bc247f96-f6dc-3a1d-af73-ca546f56ebf7",
                        "glosses": [
