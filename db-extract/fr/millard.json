                    {
                        "sense_id": "2f6be17a-eb8e-39a2-bbbf-f479e3173d9e",
                        "entry_id": "4a0c2a3d-5b10-3c8f-99be-30fb137df3f4",
                        "glosses": [
                            "Clafoutis, le plus souvent aux cerises non dénoyautées."
                        ],
                        "tags": [
                            "Auvergne"
                        ],
                        "examples": [
                            {
                                "example_id": "978bcdda-fecb-4dd8-be0e-86a417ee3497",
                                "sense_id": "2f6be17a-eb8e-39a2-bbbf-f479e3173d9e",
                                "text": "Les plus populaires sont la pompe aux pommes en hiver et le millard en été (sorte de clafoutis aux cerises noires non dénoyautées)."
                            },
                            {
                                "example_id": "5687c337-d7d6-4c87-a7b8-4522391c2dcd",
                                "sense_id": "2f6be17a-eb8e-39a2-bbbf-f479e3173d9e",
                                "text": "Elle sait qu’il n’y a rien à faire sauf à l’écouter ou à faire semblant jusqu’au moment où, voyant le soir tomber, il expédiera les deux filles dans leur ferme non sans leur avoir glissé dans un petit sac en papier deux grosses parts de millard, ce gâteau aux cerises noires qu’elles dégusteront dans leur lit le soir, dans le noir, en cachette."
                            },
                            {
                                "example_id": "8189bb15-fe64-449b-bba5-d084d3bfe999",
                                "sense_id": "2f6be17a-eb8e-39a2-bbbf-f479e3173d9e",
                                "text": "Ma grand-mère me préparait de délicieux millards avec les cerises de son jardin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
