                        "examples": [
                            {
                                "example_id": "3a4d76a3-a5a9-4df3-a1dc-d64a1240f90c",
                                "sense_id": "c75c8a2f-70ce-30b4-97b9-b4de576fe4a5",
                                "text": "„Über den Rang meines Vaters in dem Regiment kann ich nichts sagen, obwohl ich mir ziemlich sicher bin, dass er ein Offizierspatent besaß.“"
                            },
                            {
                                "example_id": "2354b40c-5727-4c5a-8634-e60c179819aa",
                                "sense_id": "c75c8a2f-70ce-30b4-97b9-b4de576fe4a5",
                                "text": "„Rund 8000 indische Offiziere hatten im Krieg ihr Offizierspatent erhalten.“"
                            }
                        ],
