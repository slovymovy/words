                        "glosses": [
                            "Action de décoller, de se décoller ou résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "741bd058-9819-4de7-8265-9c04624b3915",
                                "sense_id": "4364cdaa-a2d0-3e72-a6f0-9ab4c9d43d1d",
                                "text": "Ces salles d'apparat - qui n'ont pas été restaurées depuis cinquante ans - souffrent des mêmes maux: altération de la couche picturale, fissures des joints, décollement des enduits, repeints discordants et oxydation de l'armature des stucs."
                            }
                        ]
                    },
                    {
                        "sense_id": "aef50426-3c45-3d81-9178-d74ca1081148",
                        "entry_id": "3d537481-b38f-3f94-aa54-27fc7c05a10b",
                        "glosses": [
                            "Processus par lequel un organe ou un tissu se détache d’un autre auquel il était adhérent."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "23e91c27-938e-4e52-a542-65cb4fba3d70",
                                "sense_id": "aef50426-3c45-3d81-9178-d74ca1081148",
                                "text": "Dans certains abcès, il y a décollement de la peau."
                            },
                            {
                                "example_id": "82512491-45b3-4bb2-8385-2ff77207c836",
                                "sense_id": "aef50426-3c45-3d81-9178-d74ca1081148",
                                "text": "Elle souffre d'un décollement de la rétine."
                            }
                        ]
                    }
