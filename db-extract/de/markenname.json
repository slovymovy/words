                "senses": [
                    {
                        "sense_id": "b7cce830-e9bd-306d-8b2d-8792688f05c8",
                        "entry_id": "e68ef302-a8c5-3d3e-9487-79844e8225e5",
                        "glosses": [
                            "ein Eigenname eines Produktes, einer Ware, der in der Regel geschützt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57f2724b-ef2f-4ced-870b-d24e443ecab5",
                                "sense_id": "b7cce830-e9bd-306d-8b2d-8792688f05c8",
                                "text": "Der Markenname kann über Erfolg oder Misserfolg eines Produkts entscheiden."
                            },
                            {
                                "example_id": "9b606c54-aeb2-402b-8d33-957491546b09",
                                "sense_id": "b7cce830-e9bd-306d-8b2d-8792688f05c8",
                                "text": "„Für die Onomastik sind natürlich vor allem die Markennamen interessant.“"
                            },
                            {
                                "example_id": "76792280-81f9-4c46-90c2-5079109df79e",
                                "sense_id": "b7cce830-e9bd-306d-8b2d-8792688f05c8",
                                "text": "„Er ratterte einen Markennamen mit Nummer herunter, als müsse mich das beeindrucken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
