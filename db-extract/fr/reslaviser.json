                "senses": [
                    {
                        "sense_id": "29e03c8a-06fa-302a-87a6-39f7f54d8073",
                        "entry_id": "e58cae79-84d9-3a6a-a671-dc7d0cf95cd9",
                        "glosses": [
                            "Slaviser à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0387bc8-933b-4bf2-a0ba-1f9aa58532cc",
                                "sense_id": "29e03c8a-06fa-302a-87a6-39f7f54d8073",
                                "text": "En prenant le pouvoir après la Seconde Guerre mondiale, les communistes ont cherché, dans un premier temps, à reslaviser le roumain, comme y invitait le rapprochement avec l'URSS."
                            },
                            {
                                "example_id": "60755f3d-962e-4371-827f-6c3089fb7f21",
                                "sense_id": "29e03c8a-06fa-302a-87a6-39f7f54d8073",
                                "text": "En conséquence — c'est toujours le lecteur serbe qui parle — « notre devoir est de reslaviser l'histoire hongroise, comme nous avons (...) les territoires repris aux Hongrois. »"
                            }
                        ]
                    }
