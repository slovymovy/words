                    {
                        "sense_id": "62fc16c2-b7f7-3037-90ee-882dfb206f5b",
                        "entry_id": "46c3362f-cab9-3c3c-b93b-5c336b3a94cf",
                        "glosses": [
                            "Habitante ou originaire de la Nouvelle-Zélande."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e48dce8f-cb45-4d2f-ade3-985075148f41",
                                "sense_id": "62fc16c2-b7f7-3037-90ee-882dfb206f5b",
                                "text": "Sa nomination survient un peu plus d’une semaine après celles de la Néo-Zélandaise Hannah O’Neill et du Français Marc Moreau."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "185a26fa-c913-4bfe-943c-bbaf757a6d97",
                        "source_entry_id": "46c3362f-cab9-3c3c-b93b-5c336b3a94cf",
                        "source_sense_id": "62fc16c2-b7f7-3037-90ee-882dfb206f5b",
                        "target_lang_word": "Neuseeländerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Neuseeländerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d35413e5-7477-3e57-9102-cf031aa15cf4",
                                        "entry_id": "13c7acee-bee0-31bd-9c9d-707451b9837b",
                                        "glosses": [
                                            "Staatsbürgerin von Neuseeland"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4aea944f-8df1-48cd-9604-91a0ac545ab9",
                                                "sense_id": "d35413e5-7477-3e57-9102-cf031aa15cf4",
                                                "text": "„Ihre Energien steckt die 39-jährige Neuseeländerin lieber in den Tierschutz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "79c8b0c7-008f-4c2e-ab9e-72aeac2504d0",
                        "source_entry_id": "46c3362f-cab9-3c3c-b93b-5c336b3a94cf",
                        "source_sense_id": "62fc16c2-b7f7-3037-90ee-882dfb206f5b",
                        "target_lang_word": "New Zealander",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "New Zealander",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fe2d9ab2-7aa7-38a0-8905-69f14e92c458",
                                        "entry_id": "c61040b0-961d-3e0f-9e5b-b8dfed258f68",
                                        "glosses": [
                                            "A person from New Zealand or of New Zealand descent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25eb278d-31b7-4c4c-b86b-a63a32bf4a9e",
                                                "sense_id": "fe2d9ab2-7aa7-38a0-8905-69f14e92c458",
                                                "text": "There was a directional driller who I regularly ran into, a New Zealander by the name of Maurice."
                                            },
                                            {
                                                "example_id": "97c021bb-1e4e-477c-bb29-b820bb6cae18",
                                                "sense_id": "fe2d9ab2-7aa7-38a0-8905-69f14e92c458",
                                                "text": "The rate of arrivals fluctuates with the relative economic fortunes of each country, but since the late 1960s, faster growth, higher wages, greater job opportunities and a stronger dollar have been an economic magnet drawing New Zealanders across the ditch."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b88c7929-dedf-4d2f-bbd2-2c7a6643de8c",
                        "source_entry_id": "46c3362f-cab9-3c3c-b93b-5c336b3a94cf",
                        "source_sense_id": "62fc16c2-b7f7-3037-90ee-882dfb206f5b",
                        "target_lang_word": "New Zealandress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "New Zealandress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d2da473b-9457-3e3b-b87f-171a322de807",
                                        "entry_id": "22dfcc64-c132-38f4-8313-593973b7228a",
                                        "glosses": [
                                            "A female New Zealander."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d226240-b1a8-46b0-b634-01613fa02dbe",
                                                "sense_id": "d2da473b-9457-3e3b-b87f-171a322de807",
                                                "text": "…her last despairing, supplicating look, as she was taken a few yards off, and killed, by that virago, Mrs. Haupapa—the fiendish New Zealandress."
                                            },
                                            {
                                                "example_id": "6115d303-cc61-47ad-b459-ba726b40969a",
                                                "sense_id": "d2da473b-9457-3e3b-b87f-171a322de807",
                                                "text": "Being an easily enfranchised New Zealandress, I found myself lodged midway between the two camps…"
                                            },
                                            {
                                                "example_id": "66b97074-1904-4282-8e91-47c14029d7f1",
                                                "sense_id": "d2da473b-9457-3e3b-b87f-171a322de807",
                                                "text": "Neptunes in hempen wigs waltzed with the lean New Zealandress, who had stuck flowers from a hat into her fair hair, to impersonate Oceania."
                                            },
                                            {
                                                "example_id": "8982e771-88db-4042-812f-9d960109aba1",
                                                "sense_id": "d2da473b-9457-3e3b-b87f-171a322de807",
                                                "text": "The New Zealandress is as sports-minded as her brother…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
