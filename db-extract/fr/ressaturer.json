                ],
                "senses": [
                    {
                        "sense_id": "7fb5553b-9e31-3159-854b-0190a71cbd68",
                        "entry_id": "5d84a209-f39b-32e5-abb8-617eccbea92b",
                        "glosses": [
                            "Saturer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb65c7d5-5e0b-4ccd-87ec-5065f6c53b6d",
                                "sense_id": "7fb5553b-9e31-3159-854b-0190a71cbd68",
                                "text": "Car il y a plus fort que les rabbins, les lamas, les bonzes, les imams, les brahmanes dans ce moyen de déprécier la vie afin d’en ressaturer cet angle immonde appelé par les profiteurs de l’occulte : éternité et infini."
                            },
                            {
                                "example_id": "61cafe9c-eafa-43e2-a011-b2605b956010",
                                "sense_id": "7fb5553b-9e31-3159-854b-0190a71cbd68",
                                "text": "La solution salée arrive par le tube (S) et s’écoule par le tube (S₁), elle va se ressaturer dans un appareil annexe pour revenir à l’électrolyseur ; comme pour le mercure, sa circulation est continue."
                            },
                            {
                                "example_id": "b3c628c3-3a4f-45c3-aa03-5967a7c67242",
                                "sense_id": "7fb5553b-9e31-3159-854b-0190a71cbd68",
                                "text": "Ce liquide ne peut tenir en dissolution qu’une certaine quantité de sel d’argent, et il s’en ressature ainsi à mesure qu’elle lui a été enlevée."
                            }
                        ]
                    }
                ],
