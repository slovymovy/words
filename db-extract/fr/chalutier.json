                "senses": [
                    {
                        "sense_id": "f01ba8aa-9cb3-33dd-814f-29376abbf06e",
                        "entry_id": "f7574de2-ce31-3fd2-ab33-a0bf596bda3d",
                        "glosses": [
                            "Bateau qui traîne un chalut, par ellipse de « bateau chalutier »."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7674019c-7640-4a82-b11b-5a1c8cd2ee23",
                                "sense_id": "f01ba8aa-9cb3-33dd-814f-29376abbf06e",
                                "text": "On avait retrouvé le corps de Pete dans la cale d’un chalutier sur lequel il travaillait, apparemment."
                            },
                            {
                                "example_id": "d779b088-8de2-4b63-a220-3e8add3c9bf2",
                                "sense_id": "f01ba8aa-9cb3-33dd-814f-29376abbf06e",
                                "text": "Les marins, dont les chalutiers tossaient contre les quais les rares voiliers qui osaient s'aventurer dans le port, explosèrent de rire ; ils s'étaient tous retenus jusqu'à la dernière ânerie du voileux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe2b7755-0c0f-4999-b766-f4fd09c95af3",
                        "source_entry_id": "f7574de2-ce31-3fd2-ab33-a0bf596bda3d",
                        "source_sense_id": "f01ba8aa-9cb3-33dd-814f-29376abbf06e",
                        "source_sense_description": "Bateau de pêche (1):",
                        "target_lang_word": "Trawler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trawler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0c1e56eb-92e4-3a48-9bf6-ec96e830e458",
                                        "entry_id": "0e5bf91a-7943-3a42-9628-a9b6e7535714",
                                        "glosses": [
                                            "Fischereischiff, das Fische mit (Grund-)Schleppnetzen fängt (und in vielen Fällen an Bord verarbeitet)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a4fae1a-7161-490a-b1bb-6557de8afeab",
                                                "sense_id": "0c1e56eb-92e4-3a48-9bf6-ec96e830e458",
                                                "text": "„Während sich die beiden unterhielten, sah ich zu, wie die Seeleute den Trawler am Kai festmachten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "875a6af2-4398-4745-a002-88063fb1a712",
                        "source_entry_id": "f7574de2-ce31-3fd2-ab33-a0bf596bda3d",
                        "source_sense_id": "f01ba8aa-9cb3-33dd-814f-29376abbf06e",
