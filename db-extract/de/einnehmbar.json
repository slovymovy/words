                    }
                ],
                "senses": [
                    {
                        "sense_id": "c712af69-ed2a-3285-80a0-7669ced968c8",
                        "entry_id": "438b926b-7350-332d-b088-737085baf3dc",
                        "glosses": [
                            "so, dass es eingenommen werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afb992b9-0cbb-4da4-96e8-9e4770763642",
                                "sense_id": "c712af69-ed2a-3285-80a0-7669ced968c8",
                                "text": "„Diese Stadt, am Abhange eines Berges erbaut, schien kaum einnehmbar […]“"
                            },
                            {
                                "example_id": "11a40332-d989-4f1f-877a-b8d5532c4b06",
                                "sense_id": "c712af69-ed2a-3285-80a0-7669ced968c8",
                                "text": "„Mein Gedanke war, in einem Gefecht zu Wasser dermaßen zu siegen, daß die Mexikaner Achtung und Angst vor meinen Rennschiffen bekämen; denn die Stadt Temixtitan war einzig und allein vom See her einnehmbar.“"
                            },
                            {
                                "example_id": "33368be3-c308-4bb6-a790-8dc0ca26879d",
                                "sense_id": "c712af69-ed2a-3285-80a0-7669ced968c8",
                                "text": "„Er forderte die Götterburg Athen zur Ergebung an Christus auf, aber er erkannte, daß sie für den evangelischen Gedanken noch nicht einnehmbar sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
