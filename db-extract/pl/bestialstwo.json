                        ]
                    },
                    {
                        "translation_id": "b802d4a2-aad3-48a7-bab3-60e100c427ec",
                        "source_entry_id": "b1afd3b7-68f7-3e29-a640-2e03375df95a",
                        "source_sense_id": "077a571f-b48e-3210-8c76-9cf91edddc9d",
                        "target_lang_word": "atrocity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "atrocity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "faea433b-26d3-3b85-9985-aada8427b1bb",
                                        "entry_id": "35a41e01-ba4c-3a43-b3e4-6ca7f1a98403",
                                        "glosses": [
                                            "An extremely cruel act; a horrid act of injustice."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9e199cf-34a3-4a6b-820d-84d325055483",
                                                "sense_id": "faea433b-26d3-3b85-9985-aada8427b1bb",
                                                "text": "to carry out / commit / perpetrate an atrocity"
                                            },
                                            {
                                                "example_id": "ec7e0eba-d732-4f52-ae6a-ee53bb8f2512",
                                                "sense_id": "faea433b-26d3-3b85-9985-aada8427b1bb",
                                                "text": "The regime is guilty of mass atrocities including forced displacement and the use of chemical weapons."
                                            },
                                            {
                                                "example_id": "a5941f00-6ad7-40d9-9e0e-a54e06fae6f1",
                                                "sense_id": "faea433b-26d3-3b85-9985-aada8427b1bb",
                                                "text": "[…] it seemed an atrocity or cruelty to Narses a good General, to take punishment of innoxious Hostages:"
                                            },
                                            {
                                                "example_id": "3f74793e-1142-4466-b1c5-388825206b0a",
                                                "sense_id": "faea433b-26d3-3b85-9985-aada8427b1bb",
                                                "text": "It was impossible for the convention to suffer the crimes they had committed, and the still greater atrocities which they had meditated, to pass unnoticed."
                                            },
                                            {
                                                "example_id": "1eed3845-31a9-43a5-87c7-2759ca23cd69",
                                                "sense_id": "faea433b-26d3-3b85-9985-aada8427b1bb",
                                                "text": "This devilish outrage, this fiendish murder, produced, as it was well calculated to do, a tremendous sensation. […] The atrocity roused my old master, and he spoke out, in reprobation of it;"
                                            },
                                            {
                                                "example_id": "5c1b7ce1-2c7f-4b9b-a44b-fa5efbe963e2",
                                                "sense_id": "faea433b-26d3-3b85-9985-aada8427b1bb",
                                                "text": "“Any delay in arresting the assassin,” I observed, “might give him time to perpetrate some fresh atrocity.”"
                                            },
                                            {
                                                "example_id": "85f15751-bdfa-4716-b2a0-7d20be7ef6b1",
                                                "sense_id": "faea433b-26d3-3b85-9985-aada8427b1bb",
                                                "text": "The United Kingdom, the United States and the Soviet Union have received from many quarters evidence of atrocities, massacres and cold-blooded mass executions which are being perpetrated by Hitlerite forces in many of the countries they have overrun and from which they are now being steadily expelled."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6d86685-4aa8-35cc-91ff-4cb44ae9adfb",
                                        "entry_id": "35a41e01-ba4c-3a43-b3e4-6ca7f1a98403",
                                        "glosses": [
                                            "The quality or state of being atrocious; enormous wickedness; extreme criminality or cruelty."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e4d3dd5-9f70-40a0-b437-b22abd521723",
                                                "sense_id": "f6d86685-4aa8-35cc-91ff-4cb44ae9adfb",
                                                "text": "1553, John Bradford, letter, in Miles Coverdale (ed.), Certain Most Godly, Fruitful, and Comfortable letters, London: John Day, 1564, pp. 481-482,\nThys wil I muse on, & way with my self, [tha]t I may dulye knowe, both in me and in al other things, the atrocitie and bitternesse of synne which dwelleth in me, & so may the more hartely geue ouer my self wholy to [th]e lord Christ my Sauiour,"
                                            },
                                            {
                                                "example_id": "b5fbe989-9639-4b3c-bef1-946be2921154",
                                                "sense_id": "f6d86685-4aa8-35cc-91ff-4cb44ae9adfb",
                                                "text": "What character is so detestable as that of one who takes pleasure to sow dissention among friends, and to turn their most tender love into mortal hatred? Yet wherein does the atrocity of this so much abhorred injury consist? […] It is in depriving them of that friendship itself, in robbing them of each others affections […]"
                                            },
                                            {
                                                "example_id": "bb00af2e-dcc5-49cc-9622-2b87f5625c97",
                                                "sense_id": "f6d86685-4aa8-35cc-91ff-4cb44ae9adfb",
                                                "text": "an apology devised after the commission of the deed, to cover up its atrocity"
                                            },
                                            {
                                                "example_id": "45296e7b-8047-4eb1-aa37-748a4acb066f",
                                                "sense_id": "f6d86685-4aa8-35cc-91ff-4cb44ae9adfb",
                                                "text": "Here was one who had spent his life in lying to the world, and who was in his very heart shocked at the atrocity of a man who had lied to him!"
                                            },
                                            {
                                                "example_id": "4098df83-3af7-43ac-a911-796183cd44b1",
                                                "sense_id": "f6d86685-4aa8-35cc-91ff-4cb44ae9adfb",
                                                "text": "Hernandez […] had been an inoffensive, small ranchero, kidnapped with circumstances of peculiar atrocity from his home during one of the civil wars, and forced to serve in the army."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c3cc715-cc6d-338b-8db4-60956ef7a70c",
                                        "entry_id": "35a41e01-ba4c-3a43-b3e4-6ca7f1a98403",
                                        "glosses": [
                                            "An object considered to be extremely unattractive or undesirable."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63a3ab2f-543a-4f13-bdc5-5bba341be2b9",
                                                "sense_id": "3c3cc715-cc6d-338b-8db4-60956ef7a70c",
                                                "text": "[S]ome of the printers were good singers and others good performers on the guitar and on that atrocity the accordeon—[…]"
                                            },
                                            {
                                                "example_id": "c8a6e7d2-5870-47dc-b5ec-0d88afe81ca9",
                                                "sense_id": "3c3cc715-cc6d-338b-8db4-60956ef7a70c",
                                                "text": "The Pools had given them a “hanging lamp,” coveted by the farmer’s wife; a hideous atrocity in yellow, with pink roses on its shade and prisms dangling and tinkling all around the edge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
