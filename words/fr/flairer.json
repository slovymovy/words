    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f5ce20ef-74c8-3f4b-9671-6d8f58830b38",
                    "sense_definition": "Sentir ou renifler avec insistance pour découvrir, explorer ou identifier par l'odorat.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "percevoir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chien <w>flaire</w> chaque recoin du jardin pour retrouver sa balle perdue."
                        },
                        {
                            "text": "L'animal s'arrête un instant et commence à <w>flairer</w> la piste laissée par le gibier."
                        }
                    ],
                    "synonyms": [
                        "renifler",
                        "humer",
                        "sentir"
                    ],
                    "common_phrases": [
                        "flairer une piste",
                        "flairer le sol"
                    ]
                },
                {
                    "sense_id": "36786278-2fa9-3ec7-9973-7eeb51cef213",
                    "sense_definition": "Deviner à l'avance, pressentir ou soupçonner intuitivement quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intuition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce détective expérimenté a tout de suite su <w>flairer</w> le piège tendu par les malfaiteurs."
                        },
                        {
                            "text": "Le directeur commercial a réussi à <w>flairer</w> la bonne affaire avant tous ses concurrents."
                        }
                    ],
                    "synonyms": [
                        "pressentir",
                        "subodorer",
                        "deviner"
                    ],
                    "common_phrases": [
                        "flairer le danger",
                        "flairer le piège",
                        "flairer le bon coup"
                    ]
                },
                {
                    "sense_id": "81f1eed1-c8dd-3eb2-8f88-2ee85b5fb8f5",
                    "sense_definition": "Respirer ou humer attentivement une odeur, en particulier pour l'apprécier.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "percevoir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle s'approche du bouquet pour en <w>flairer</w> délicatement le parfum printanier."
                        },
                        {
                            "text": "Prenez le temps de <w>flairer</w> ce vin rouge avant de le déguster."
                        }
                    ],
                    "synonyms": [
                        "humer",
                        "respirer"
                    ]
                },
                {
                    "sense_id": "c41586d0-2057-397d-9578-e2a2e072a4ba",
                    "sense_definition": "Exhaler ou répandre une odeur agréable ou particulière.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "emanation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce vieux verger abandonné, les herbes sauvages <w>flairaient</w> bon la menthe."
                        },
                        {
                            "text": "Cette étrange liqueur <w>flairait</w> l'amande amère dès qu'on débouchait le flacon."
                        }
                    ],
                    "synonyms": [
                        "fleurer",
                        "embaumer"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Synonyme vieilli du verbe fleurer"
                        }
                    ]
                }
            ]
        },
        {
