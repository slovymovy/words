                ],
                "senses": [
                    {
                        "sense_id": "18455b96-cb25-349b-9f5f-5751d5e2a33e",
                        "entry_id": "7d28797d-e49a-3af7-810a-5d7fdb004b3d",
                        "glosses": [
                            "Handlung, Vorgang, etwas in seiner Qualität anzuheben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95484f09-2fba-4a41-b5ab-b5b80478dc47",
                                "sense_id": "18455b96-cb25-349b-9f5f-5751d5e2a33e",
                                "text": "„Heute lassen sich mit der Gravitationstheorie von Newton und ihrer Verfeinerung im Rahmen der Einstein’schen Relativitätstheorie alle bekannten gravitativen Kräfte auf großen und schweren Skalen hervorragend beschreiben.“"
                            },
                            {
                                "example_id": "a2662456-4b05-43b1-ac79-224d5cf2df0c",
                                "sense_id": "18455b96-cb25-349b-9f5f-5751d5e2a33e",
                                "text": "„Mit der Aufhübschung der Filialen, Ökostrom-Angeboten und der Verfeinerung des Sortiments geht es Richtung Supermarkt.“"
                            },
                            {
                                "example_id": "00821709-dc91-451b-838d-7ef22f9f653a",
                                "sense_id": "18455b96-cb25-349b-9f5f-5751d5e2a33e",
                                "text": "„Im zurückliegenden Jahrzehnt hatte Kenia freilich anderes zu tun, als über die Verfeinerungen seines Tourismus durch Wellness-Angebote nachzudenken.“"
                            },
                            {
                                "example_id": "1ca751b6-bfd0-4b54-9ab0-f2daa7d51735",
                                "sense_id": "18455b96-cb25-349b-9f5f-5751d5e2a33e",
                                "text": "„Vielmehr ist es das Resultat von Verfeinerungen der traditionellen Landschaftsmalerei und Ausdruck der Vielschichtigkeit des traditionellen Handwerks, das freilich, unter Zuhilfenahme des Zufalls, in Vorzeichnungen oder Aquarellskizzen alle nur denkbaren Abweichungen von der Konvention auslotet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7322f564-c8be-3e3f-bef8-b1d97f2887f9",
                        "entry_id": "7d28797d-e49a-3af7-810a-5d7fdb004b3d",
                        "glosses": [
                            "etwas, das an Qualität gewonnen hat, verbessert wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43f4d700-e607-43db-90c6-e37857c028d5",
                                "sense_id": "7322f564-c8be-3e3f-bef8-b1d97f2887f9",
                                "text": "„Im zurückliegenden Jahrzehnt hatte Kenia freilich anderes zu tun, als über die Verfeinerungen seines Tourismus durch Wellness-Angebote nachzudenken.“"
                            },
                            {
                                "example_id": "bbdedd38-1011-4dc0-9dd9-98146d5b9b43",
                                "sense_id": "7322f564-c8be-3e3f-bef8-b1d97f2887f9",
                                "text": "„Vielmehr ist es das Resultat von Verfeinerungen der traditionellen Landschaftsmalerei und Ausdruck der Vielschichtigkeit des traditionellen Handwerks, das freilich, unter Zuhilfenahme des Zufalls, in Vorzeichnungen oder Aquarellskizzen alle nur denkbaren Abweichungen von der Konvention auslotet.“"
                            },
                            {
                                "example_id": "3d62833f-69c5-48e0-96c2-2517c718769d",
                                "sense_id": "7322f564-c8be-3e3f-bef8-b1d97f2887f9",
                                "text": "„Deshalb hat die Finanzmathematik in den vergangenen drei Jahrzehnten ungezählte Verfeinerungen und Erweiterungen der ursprünglichen Modelle entwickelt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
