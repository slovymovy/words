                ],
                "senses": [
                    {
                        "sense_id": "ee40610d-8806-3dbc-8a82-bd7022c4b978",
                        "entry_id": "0d0bf988-8b73-327f-a365-8b6710bab904",
                        "glosses": [
                            "Erscheinung des 21. Jahrhunderts, bei der die Gewinnung von Erdöl und Gas aus Ölschiefer profitabel wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb262da0-1b13-4f68-8634-04313aca3902",
                                "sense_id": "ee40610d-8806-3dbc-8a82-bd7022c4b978",
                                "text": "„Zum anderen könnte die sogenannte Schieferrevolution die zentrale Position des Königreichs als weltweit führenden Energieerzeuger gefährden.“"
                            },
                            {
                                "example_id": "02ee64b6-c5cf-42cd-bcf0-5ff7f4e3584a",
                                "sense_id": "ee40610d-8806-3dbc-8a82-bd7022c4b978",
                                "text": "„Die Schieferrevolution ist essenzieller Bestandteil und Resultat der Energieunabhängigkeitsbestrebungen der US-Regierung zur Verbesserung der amerikanischen Energiesicherheit.“"
                            },
                            {
                                "example_id": "00ecc2b9-0d4d-459e-9c14-7b3d08bac0a6",
                                "sense_id": "ee40610d-8806-3dbc-8a82-bd7022c4b978",
                                "text": "„Die außen- und sicherheitspolitischen Folgen der Schieferrevolution lassen sich ebenfalls schwer abschätzen.“"
                            },
                            {
                                "example_id": "e77a5e3a-9420-43e7-a027-a51ae2c21f44",
                                "sense_id": "ee40610d-8806-3dbc-8a82-bd7022c4b978",
                                "text": "„Durch die von den USA ausgehende Schieferrevolution und die Krise in der Ukraine sind Energiepolitik, Energiesicherheit und Energieversorgung auf der Agenda der nationalen und internationalen Politik ganz nach oben gerückt.“"
                            },
                            {
                                "example_id": "29d24f50-b9a9-45fe-8d95-d8ae4ce19c73",
                                "sense_id": "ee40610d-8806-3dbc-8a82-bd7022c4b978",
                                "text": "„Dies hat neben vermehrter Energieeffizienz für Autos und Gebäude vor allem damit zu tun, dass die Schieferrevolution in den USA zunehmend die Kohle verdrängt - die inzwischen in Deutschland wieder vermehrt eingesetzt wird.“"
                            },
                            {
                                "example_id": "f4e2ccbb-653b-4acb-bc90-81a2628bd38b",
                                "sense_id": "ee40610d-8806-3dbc-8a82-bd7022c4b978",
                                "text": "„Die Schieferrevolution macht lange Gesichter in Moskau und Teheran. Dort hatte man erwartet, auf Jahrzehnte hinaus den Erdgasmarkt zu dominieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
