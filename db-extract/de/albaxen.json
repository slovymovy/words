                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d6885e0-2163-435d-9bd0-3053fc9d46fb",
                                "sense_id": "6ae34053-121a-373b-885e-c841b5d840b8",
                                "text": "Nach Albaxen führen viele Wege."
                            },
                            {
                                "example_id": "16050449-5f49-4061-bf89-f32a79e13208",
                                "sense_id": "6ae34053-121a-373b-885e-c841b5d840b8",
                                "text": "Albaxen liegt auf der Nordhalbkugel."
                            },
                            {
                                "example_id": "0b121cf8-e130-4210-b686-e74e56ec19a1",
                                "sense_id": "6ae34053-121a-373b-885e-c841b5d840b8",
                                "text": "Das Weserdorf Albaxen ist seit der Gebietsreform 1970 ein Ortsteil der nahe gelegenen Stadt Höxter."
                            },
                            {
                                "example_id": "03cf9ca7-668c-43ee-a122-c58a6d810709",
                                "sense_id": "6ae34053-121a-373b-885e-c841b5d840b8",
                                "text": "Ich bin in Albaxen geboren."
                            },
                            {
                                "example_id": "f51ee59e-dd02-4a6b-a979-6b2a57a96bdb",
                                "sense_id": "6ae34053-121a-373b-885e-c841b5d840b8",
                                "text": "Wir haben in Albaxen unseren Urlaub verbracht."
                            },
                            {
                                "example_id": "945f2169-d5b3-4c0a-b405-cfd22cb0b4fe",
                                "sense_id": "6ae34053-121a-373b-885e-c841b5d840b8",
                                "text": "Das Albaxen des 18. Jahrhunderts hinterließ noch einen ländlichen Eindruck."
