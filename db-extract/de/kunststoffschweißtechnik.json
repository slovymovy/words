                ],
                "senses": [
                    {
                        "sense_id": "e3c40985-9e6e-3fe9-a35d-adb79f37a93c",
                        "entry_id": "4ae371a6-f830-3bbd-98e8-4e2e33ee556e",
                        "glosses": [
                            "eine Schweißmethode und deren Anwendung bei Polymeren"
                        ],
                        "tags": [
                            "Kunststoffverarbeitung"
                        ],
                        "examples": [
                            {
                                "example_id": "cbba7ab2-cb57-4b04-9345-cc0316fc7a76",
                                "sense_id": "e3c40985-9e6e-3fe9-a35d-adb79f37a93c",
                                "text": "„Heute werden in der Kunststoffschweißtechnik die verschiedenen physikalischen Möglichkeiten genutzt um einen Kunststoff aufzuschmelzen.“"
                            },
                            {
                                "example_id": "7aabed4c-1193-499c-b8ce-7e4b4ae09691",
                                "sense_id": "e3c40985-9e6e-3fe9-a35d-adb79f37a93c",
                                "text": "„Die Kunststoffschweißtechnik ist ein Verfahren, mit dem mittels eines Heißluftschweißgerätes problemlos und kostengünstig Kunststoff repariert werden kann.“"
                            },
                            {
                                "example_id": "dd697cd3-67c8-41ce-9230-f6b74c34f427",
                                "sense_id": "e3c40985-9e6e-3fe9-a35d-adb79f37a93c",
                                "text": "„Im Maschinenbau werden hierzu Geräte entwickelt, die der Bearbeitung der Kunststoffe dienen und dabei beispielsweise die Kunststoffschweißtechnik verwenden. Bei thermoplastischen Kunststoffen ist eine dieser Kunststoffschweißtechniken das Ultraschallpressen oder auch Ultraschallschweißen.“"
                            },
                            {
                                "example_id": "8569e558-950b-486c-87f0-08ccb74107c2",
                                "sense_id": "e3c40985-9e6e-3fe9-a35d-adb79f37a93c",
                                "text": "„Seit 1996 ist BMA-SOFT auf Reibschweißen und Reibschweißmaschinen in verschiedenen Ausführungen im Bereich der Kunststoffschweißtechnik und Metallschweißen spezialisiert.“"
                            },
                            {
                                "example_id": "6518defd-fca3-4ce3-a816-56c42064549d",
                                "sense_id": "e3c40985-9e6e-3fe9-a35d-adb79f37a93c",
                                "text": "„Unter anderem wird in diesem Jahr zum ersten Mal der neue Musterkoffer inklusive Schulungs-CD für Kunststoffschweißtechnik der Handwerkskammer Koblenz vorgestellt. Dieser soll zukünftig bundesweit zur Schulung von Kunststoffschweißern eingesetzt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
