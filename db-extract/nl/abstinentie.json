                                                "sense_id": "0cf137d0-a8ab-3aff-9a6e-c126ce339cfe",
                                                "text": "Die katholische Kirche schreibt ihren Priestern Abstinenz vor."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "72cad659-8776-3430-907c-50766a165317",
                                        "entry_id": "e3e59139-a6d6-3cbd-8c05-7f440fa68e44",
                                        "glosses": [
                                            "Verzicht auf Alkohol"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51d224af-5b68-460f-bf37-67ed223b5eff",
                                                "sense_id": "72cad659-8776-3430-907c-50766a165317",
                                                "text": "Nach jahrelanger Abstinenz trinkt er jetzt wieder ab und zu ein Bier."
                                            },
                                            {
                                                "example_id": "2c031711-78ef-4add-9c3e-fb25cc528820",
                                                "sense_id": "72cad659-8776-3430-907c-50766a165317",
                                                "text": "„Mir hat der kleine Ausflug in die Abstinenz eher was anderes gebracht: die Erkenntnis, dass mein Griff zum Korkenzieher eher Gewohnheit als Bedürfnis ist, mein abendliches Glas Rotwein eher gedankenlos weggekippt wird und deshalb auch nicht so genussvoll ist, wie es sein könnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "922cfdd7-af54-32a3-8517-36f80827bd53",
                                        "entry_id": "e3e59139-a6d6-3cbd-8c05-7f440fa68e44",
                                        "glosses": [
                                            "Verzicht auf Fleisch beziehungsweise völliger Verzicht auf Tierprodukte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b056a60-e647-4baa-8f3b-9872a42d3b8f",
                                                "sense_id": "922cfdd7-af54-32a3-8517-36f80827bd53",
                                                "text": "Viele Menschen leben in freiwilliger Abstinenz und ernähren sich ausschließlich von pflanzlichen Produkten."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
