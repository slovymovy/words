                        "form": "scellés"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0457089c-2067-31d9-a15a-065e9afd45ec",
                        "entry_id": "c3d587f0-0869-3a13-8f75-145a2d7182bc",
                        "glosses": [
                            "Deux cachets de cire reliés par un ruban que l’on appose à des serrures, à des armoires, etc., par autorité de justice, pour empêcher de les ouvrir."
                        ],
                        "tags": [
                            "Justice"
                        ],
                        "examples": [
                            {
                                "example_id": "bbebe388-7ae4-4e72-a958-c14e04287273",
                                "sense_id": "0457089c-2067-31d9-a15a-065e9afd45ec",
                                "text": "Le même soir, quelques officiers de la commune enfoncèrent sa porte, visitèrent ses papiers, ses effets, harpèrent ce qui pouvait leur convenir et apposèrent les scellés sur les portes."
                            },
                            {
                                "example_id": "863b1a13-ebe1-4f8f-973d-744c3664853b",
                                "sense_id": "0457089c-2067-31d9-a15a-065e9afd45ec",
                                "text": "C’est au juge de paix à lever les scellés qu’il a apposés."
                            },
                            {
                                "example_id": "7c1d4d93-60cc-40dd-8a19-f1580913ef68",
                                "sense_id": "0457089c-2067-31d9-a15a-065e9afd45ec",
                                "text": "C’est un délit de forcer, de rompre, de briser les scellés."
                            },
                            {
                                "example_id": "135161f8-0f31-4679-8763-20f6ae479944",
                                "sense_id": "0457089c-2067-31d9-a15a-065e9afd45ec",
                                "text": "Le juge de paix a reconnu que son scellé était sain et entier."
                            }
                        ]
                    }
                ],
