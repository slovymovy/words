                        "target_lang_word": "amuse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amuse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dba8de73-ad17-311a-a6f8-3c1895871507",
                                        "entry_id": "267cfe7c-3e7a-3a51-8a69-d1f18f81f284",
                                        "glosses": [
                                            "To entertain or occupy (someone or something) in a pleasant manner; to stir (someone) with pleasing emotions."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd0362df-48cf-4099-a415-3b33f66be834",
                                                "sense_id": "dba8de73-ad17-311a-a6f8-3c1895871507",
                                                "text": "I watch these movies because they amuse me."
                                            },
                                            {
                                                "example_id": "89c5e72e-64e7-4848-8604-3613fb328a61",
                                                "sense_id": "dba8de73-ad17-311a-a6f8-3c1895871507",
                                                "text": "It always amuses me to hear the funny stories why people haven't got a ticket, but I never let them get in without paying."
                                            },
                                            {
                                                "example_id": "3b2a517e-6c42-4f7f-8246-a4bcdc960e84",
                                                "sense_id": "dba8de73-ad17-311a-a6f8-3c1895871507",
                                                "text": "A group of children amusing themselves with pushing stones from the top [of the cliff], and watching as they plunged into the lake."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed3cf042-781c-39fb-83ba-7049a86b72f0",
                                        "entry_id": "267cfe7c-3e7a-3a51-8a69-d1f18f81f284",
                                        "glosses": [
                                            "To cause laughter or amusement; to be funny."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3af425d-1f80-4056-875d-eda69bba9acf",
                                                "sense_id": "ed3cf042-781c-39fb-83ba-7049a86b72f0",
                                                "text": "His jokes rarely fail to amuse me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "064ed15a-4846-340e-acc2-f09df9598343",
                                        "entry_id": "267cfe7c-3e7a-3a51-8a69-d1f18f81f284",
                                        "glosses": [
                                            "To keep in expectation; to beguile; to delude."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "56e28f6a-23ef-3f09-b9a6-e3f3b14a4ce6",
                                        "entry_id": "267cfe7c-3e7a-3a51-8a69-d1f18f81f284",
                                        "glosses": [
                                            "To occupy or engage the attention of; to lose in deep thought; to absorb; also, to distract; to bewilder."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0aa8c94-5acb-41e5-9093-84af1a83ff61",
                                                "sense_id": "56e28f6a-23ef-3f09-b9a6-e3f3b14a4ce6",
                                                "text": "Being amused with grief, fear, and fright, he could not find the house."
                                            },
                                            {
                                                "example_id": "7713900c-21ef-48c3-9697-11b877d6e2c4",
                                                "sense_id": "56e28f6a-23ef-3f09-b9a6-e3f3b14a4ce6",
                                                "text": "the enemies were amused on the fires that our men made"
                                            },
                                            {
                                                "example_id": "de35defb-f365-4e1a-9a77-f7b06285b1e9",
                                                "sense_id": "56e28f6a-23ef-3f09-b9a6-e3f3b14a4ce6",
                                                "text": "Hairs which have most amused me have not been in the Face or Head, but on the Back, and not in Men but Children, as I long ago observed in that Endemial Distemper of little Children in Languedock, called the Morgellons, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
