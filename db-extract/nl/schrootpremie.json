                        "entry_id": "4ded4412-8169-3343-b96e-7c9d1e15c9c6",
                        "glosses": [
                            "een regeling vanwege de overheid die de eigenaren van een oude auto door middel van premies aanspoort om hun wagen versneld te laten slopen en in te ruilen voor een jongere"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09a1ef4e-ae75-4e56-afa8-783c19a55770",
                                "sense_id": "9d2ea0eb-5360-382a-bf0b-c4147983a0ee",
                                "text": "Met een schrootpremie proberen de overheden tegelijkertijd de economie te stimuleren en het wagenpark schoner te maken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
