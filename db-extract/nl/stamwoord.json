                    {
                        "sense_id": "42de44d6-4114-3746-a9e1-3bfe0f6dbb13",
                        "entry_id": "3016eb70-48f8-3dee-93bf-afc797e7445d",
                        "glosses": [
                            "een woordvorm die de basis is voor alle door middel van flexie, samenstelling en afleiding daaruit gevormde woorden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4ec698c0-9ce8-401c-956a-ac0e09fa4531",
                                "sense_id": "42de44d6-4114-3746-a9e1-3bfe0f6dbb13",
                                "text": "Nog voor zijn vijfde kon hij niet alleen vrijwel elk handschrift lezen, maar ook zelfstandige naamwoorden verbuigen en sterke en zwakke werkwoorden vervoegen, hij kende bijna alle Franse en Latijnse stamwoorden uit het hoofd, vertaalde van het Engels naar het Latijn en omgekeerd, kon uitleggen en becommentariëren wat hij las, maakte aanzienlijke vorderingen in Comenius'Janua, en had een sterke voorkeur voor het Grieks."
                            },
                            {
                                "example_id": "b2d35526-a9ab-4c56-9eb5-ec84994fa478",
                                "sense_id": "42de44d6-4114-3746-a9e1-3bfe0f6dbb13",
                                "text": "Waarschijnlijk heeft dus zowel 'brein'als 'bræn'hetzelfde stamwoord, maar komt 'brein'niet uit het Engels. Het is misschien een verrassing (een eyeopener zogezegd), maar sommige woorden zijn gewoon Nederlands."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a817417-d92e-44ee-b679-599d9c9d3379",
