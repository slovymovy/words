                        "glosses": [
                            "Veste portée autrefois par les laquais et les personnes de basse condition."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff3474b3-463f-447f-8b1f-d7db3b350574",
                                "sense_id": "2253d1d8-9193-33bb-9e1a-f456ce88b107",
                                "text": "Il porta jadis la mandille,\nEt maintenant chez lui tout brille."
                            },
                            {
                                "example_id": "b589f0cd-2c90-4f6c-9476-35a3e32ae649",
                                "sense_id": "2253d1d8-9193-33bb-9e1a-f456ce88b107",
                                "text": "Les batteurs de tambour, qui suivaient, ouvraient la marche aux porteurs d’enseigne, tout pleins de faste et d’arrogance sous leurs mandilles de velours, leurs morions damasquinés, leurs collerettes aux cent plis, les rubans de leur ceinture."
                            },
                            {
                                "example_id": "de5a0df7-a0e7-4907-8563-7f6f6ca569a7",
                                "sense_id": "2253d1d8-9193-33bb-9e1a-f456ce88b107",
                                "text": "Puis, tous assis, un des laquais à mandille orange offre d’abord à Maria-Belgia, l’héroïne de la fête, le somptueux bassin ciselé, au poinçon d’Amsterdam, signé de Jacques Bogaërt ; un autre laquais verse l’eau de l’aiguière et tend la serviette ornée de guipure."
                            }
                        ]
                    }
