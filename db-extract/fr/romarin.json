                        "translation_id": "53a9ca06-8a21-49d4-ac68-cc923912e329",
                        "source_entry_id": "1ed0158c-dc62-3244-9894-9e006294360d",
                        "source_sense_id": "563025ee-8707-3558-8146-7e76b23d0751",
