                                    {
                                        "sense_id": "cf010ad3-faca-3399-ab91-817da5973627",
                                        "entry_id": "e3abd4df-441e-3a24-9fcf-e5da7b20044f",
                                        "glosses": [
                                            "Transformation d’un phonème en [r]."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05796ef7-9263-4290-b86b-58b08c5e22b3",
                                                "sense_id": "cf010ad3-faca-3399-ab91-817da5973627",
                                                "text": "Le rhotacisme est un type d’évolution phonétique très fréquent en latin, par exemple honos a donné honor."
                                            },
                                            {
                                                "example_id": "e0e08bff-d42d-437a-a33d-e8262d3d7d0c",
                                                "sense_id": "cf010ad3-faca-3399-ab91-817da5973627",
                                                "text": "Le rhotacisme exista longtemps dans la prononciation latine avant de pénétrer dans l’orthographe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "83ee2025-675a-479a-9af3-ddd66d61b2a4",
                        "source_entry_id": "729332ce-3052-3356-b0f9-c9b203bc75f7",
                        "source_sense_description": "linguistic sound change",
                        "target_lang_word": "Rhotazismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rhotazismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a98c8222-dddc-36dc-af62-b9adc1a6d910",
                                        "entry_id": "a54a6944-f64f-3953-9769-e122bc794199",
                                        "glosses": [
                                            "Lautwandel eines beliebigen Konsonanten zu r. Betroffen sind meist Frikative wie das s oder der laterale Approximant l"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c6ceb9f-617b-4c4a-9903-8201b2cbad22",
                                                "sense_id": "a98c8222-dddc-36dc-af62-b9adc1a6d910",
                                                "text": "„Dass dieses erhaltene -s in betonter Silbe nach Vokal leicht zu -z, und, nach dem westgermanischen Rhotazismus zu -r werden konnte, soll uns nicht wundern.“"
                                            },
                                            {
                                                "example_id": "d7be4954-d1cf-4f95-9ef3-3ecab722bfd3",
                                                "sense_id": "a98c8222-dddc-36dc-af62-b9adc1a6d910",
                                                "text": "„Allerdings sind einige der markantesten unterscheidenden Kennzeichen der beiden Dialekte (Vorhandensein eines Infinitivs mit 'me' und von Nasalvokalen im Gegischen, Durchführung des Rhotazismus von intervokalischem n>r im Toskischen) bereits in diesen beiden Varietäten des Albanischen zu erkennen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
