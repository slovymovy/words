                                        "glosses": [
                                            "A hybrid cross between a polar bear and a grizzly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6703d4d1-23e7-4378-a709-4018cc4f1b6e",
                                                "sense_id": "3bca1d00-d804-3a88-9ef5-db482a87be36",
                                                "text": "Polar bears that spend more time on land as their sea ice habitat shrinks are coming into contact with grizzly bears that have wandered further north – resulting in “grolar” or “pizzly” bear hybrids."
                                            }
                                        ]
                                    }
                                ]
