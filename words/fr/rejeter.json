    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fdef610c-a64f-3272-a595-1904e0f06338",
                    "sense_definition": "Refuser d'admettre, d'approuver ou de recevoir une demande, une offre ou une proposition.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "refuser",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le comité a décidé de <w>rejeter</w> cette proposition de loi après un débat houleux."
                        },
                        {
                            "text": "Elle a immédiatement <w>rejeté</w> cette offre d'emploi car le salaire était insuffisant."
                        }
                    ],
                    "synonyms": [
                        "refuser",
                        "repousser",
                        "écarter"
                    ],
                    "antonyms": [
                        "accepter"
                    ],
                    "common_phrases": [
                        "rejeter une offre",
                        "rejeter une demande",
                        "rejeter un pourvoi"
                    ]
                },
                {
                    "sense_id": "084d13dc-c607-31ff-a037-f78733feab52",
                    "sense_definition": "Exclure ou repousser une personne d'un groupe social ou affectif.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "exclure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet adolescent avait peur que ses camarades de classe ne finissent par le <w>rejeter</w>."
                        },
                        {
                            "text": "Malgré ses efforts pour s'intégrer, il se sentait souvent <w>rejeté</w> par ses collègues de bureau."
                        }
                    ],
                    "synonyms": [
                        "exclure",
                        "bannir"
                    ],
                    "antonyms": [
                        "accepter",
                        "accueillir"
                    ],
                    "common_phrases": [
                        "rejeter un individu",
                        "être rejeté par le groupe"
                    ]
                },
                {
                    "sense_id": "775df7ef-3cd9-3712-968e-864ac097f1d0",
                    "sense_definition": "Faire retomber un blâme, une erreur ou une faute sur autrui.",
