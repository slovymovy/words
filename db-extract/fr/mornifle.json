                "senses": [
                    {
                        "sense_id": "43da435e-3c30-3222-893a-c1e525bf8acf",
                        "entry_id": "dc1f7e02-de36-3187-96ef-da79f877a6b6",
                        "glosses": [
                            "Coup du revers de la main sur le visage."
                        ],
                        "tags": [
                            "colloquial",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "11192049-c915-4d3a-86dc-45c2a6bb3337",
                                "sense_id": "43da435e-3c30-3222-893a-c1e525bf8acf",
                                "text": "Il lui a donné une mornifle."
                            },
                            {
                                "example_id": "1e31c20f-fc3b-4440-b293-150f73adde4f",
                                "sense_id": "43da435e-3c30-3222-893a-c1e525bf8acf",
                                "text": "L’enragé, comptant sur la bêtise de ses père et mère, lui a fait la grimace. Pierre, là-dessus, lui flanque une mornifle qui vous a mis Jacques au lit pour six mois."
                            },
                            {
                                "example_id": "48a19e57-d4ec-451e-aaf0-01c1256d7eec",
                                "sense_id": "43da435e-3c30-3222-893a-c1e525bf8acf",
                                "text": "La queue de la Noire fouette et se tord comme un serpent coupé : il s’élance, la capture, la mordille, et reçoit une demi-douzaine de mornifles, sèches et griffues, à le défigurer…"
                            },
                            {
                                "example_id": "b90fd019-733d-4acb-9b3e-d38863822716",
                                "sense_id": "43da435e-3c30-3222-893a-c1e525bf8acf",
                                "text": "En voilà du culot ! Il faudra qu’il s’explique et même il pourrait bien recevoir une mornifle."
                            },
                            {
                                "example_id": "5029bd63-cfe8-469e-ab21-c2ee0669ef43",
                                "sense_id": "43da435e-3c30-3222-893a-c1e525bf8acf",
                                "text": "Ça a pas claqué si féroce devant : une grosse mornifle, un pet de gonzesse, rien. Un rot."
                            }
                        ]
                    },
                    {
                        "sense_id": "e1ca47b5-2bcd-395d-900f-c5bee9149b51",
                        "entry_id": "dc1f7e02-de36-3187-96ef-da79f877a6b6",
                        "glosses": [
                            "Coup à l’amour-propre."
                        ],
                        "tags": [
                            "figuratively",
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7b0b4b24-f5d4-3ccf-96aa-45141467b3f0",
                        "entry_id": "dc1f7e02-de36-3187-96ef-da79f877a6b6",
                        "glosses": [
