{
    "word_family": [
        "favour",
        "favourite",
        "favourably",
        "unfavourable",
        "unfavourably",
        "favouritism"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "73e2b753-53c5-316b-920a-4e35dad8ee61",
                    "sense_definition": "Expressing approval, agreement, or support.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "approval",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee gave a <w>favourable</w> response to our request.",
                            "target_lang_translations": {
                                "ru": "Комитет дал <w>положительный</w> ответ на наш запрос.",
                                "zh": "委员会对我们的请求给予了<w>肯定</w>的答复。"
                            }
                        },
                        {
                            "text": "The movie received many <w>favourable</w> reviews from critics.",
                            "target_lang_translations": {
                                "ru": "Фильм получил много <w>положительных</w> отзывов от критиков.",
                                "zh": "这部电影收到了许多评论家<w>赞许</w>的评价。"
                            }
                        }
                    ],
                    "synonyms": [
                        "approving",
                        "encouraging",
                        "positive"
                    ],
                    "antonyms": [
                        "disapproving",
                        "discouraging",
                        "negative",
                        "unfavourable"
                    ],
                    "common_phrases": [
                        "favourable review",
                        "favourable response",
                        "favourable comment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражающий одобрение, согласие или поддержку.",
                        "zh": "表示赞同、同意或支持。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "положительный",
                                "target_lang_sense_clarification": "выражающий согласие или одобрение (напр. ответ, отзыв)"
                            },
                            {
                                "target_lang_word": "благоприятный",
                                "target_lang_sense_clarification": "общий термин для выражения одобрения"
                            },
                            {
                                "target_lang_word": "одобрительный",
                                "target_lang_sense_clarification": "содержащий похвалу или поддержку"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "肯定的",
                                "target_lang_sense_clarification": "表示赞同或支持的（如回答、评价）"
                            },
                            {
                                "target_lang_word": "赞许的",
                                "target_lang_sense_clarification": "含有称赞或支持意味的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ec5b6353-e785-3526-a855-90994ee04c0e",
                    "sense_definition": "Creating a good impression or pleasing to others.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "approval",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She made a <w>favourable</w> impression on the interviewers.",
                            "target_lang_translations": {
                                "ru": "Она произвела <w>благоприятное</w> впечатление на интервьюеров.",
                                "zh": "她给面试官留下了<w>良好</w>的印象。"
                            }
                        },
                        {
                            "text": "We hope for a <w>favourable</w> reaction from the public.",
                            "target_lang_translations": {
                                "ru": "Мы надеемся на <w>благоприятную</w> реакцию общественности.",
                                "zh": "我们希望得到公众<w>正面</w>的反应。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pleasing",
                        "good"
                    ],
                    "antonyms": [
                        "bad",
                        "displeasing",
                        "unfavourable"
                    ],
                    "common_phrases": [
                        "favourable impression",
                        "favourable opinion",
                        "favourable reaction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Производящий хорошее впечатление или нравящийся другим.",
                        "zh": "给人留下好印象或令他人感到愉悦。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "благоприятный",
                                "target_lang_sense_clarification": "создающий хорошее впечатление"
