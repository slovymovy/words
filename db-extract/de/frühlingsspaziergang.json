                "senses": [
                    {
                        "sense_id": "6405a153-3ee1-33b1-8911-a601e3c8c1f3",
                        "entry_id": "a623da89-2e45-392d-84a5-9ad3a95058b0",
                        "glosses": [
                            "Spaziergang im Frühling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "344eb057-3d20-4cb8-9cc9-71470d593ec1",
                                "sense_id": "6405a153-3ee1-33b1-8911-a601e3c8c1f3",
                                "text": "Wir genossen unseren Frühlingsspaziergang im Wald."
                            },
                            {
                                "example_id": "76936044-1be6-4bbb-ad76-3fd461ea36c1",
                                "sense_id": "6405a153-3ee1-33b1-8911-a601e3c8c1f3",
                                "text": "„Schönes und angenehmes Wetter sind natürlich Voraussetzungen für einen Frühlingsspaziergang.“"
                            },
                            {
                                "example_id": "7f6bb8d9-c75f-4141-a8c5-64b9ace41a71",
                                "sense_id": "6405a153-3ee1-33b1-8911-a601e3c8c1f3",
                                "text": "„Am 24. Mai wurde der Frühlingsspaziergang von den beiden oberen und den beiden unteren Klassen nach dem Victoria-Park und Eichwald, und gleichzeitig von den mittleren Klassen nach Naramowice unternommen […].“"
                            },
                            {
                                "example_id": "26df27b3-69b7-41e2-85b0-8d91f7c7e5ad",
                                "sense_id": "6405a153-3ee1-33b1-8911-a601e3c8c1f3",
                                "text": "„Auch Frühlingsspaziergänge durch einen Wald, wo es nach Blumen und Bäumen duftet, tun der Seele einfach gut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
