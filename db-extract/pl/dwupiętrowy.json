                        ]
                    },
                    {
                        "translation_id": "605bcbe1-2f1e-436c-8a82-46e7aded145e",
                        "source_entry_id": "6774cd30-aa7e-3aff-8ca0-5f01b1e6e4e7",
                        "source_sense_id": "9a2db7bf-733e-334f-a988-7d3f148525d2",
                        "target_lang_word": "трёхэтажный",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "трёхэтажный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "603902ee-41b1-3736-a320-8d4de672e7c8",
                                        "entry_id": "f2ed9cc6-e2fa-3129-805e-2dbcad23fa00",
                                        "glosses": [
                                            "имеющий три этажа"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f5127f0-71a3-4d6a-a30c-fad019d3ece3",
                                                "sense_id": "603902ee-41b1-3736-a320-8d4de672e7c8",
                                                "text": "Во взаимных услугах они дошли наконец до площади, где находились присутственные места: большой трёхэтажный каменный дом, весь белый, как мел, вероятно для изображения чистоты душ помещавшихся в нём должностей; прочие здания на площади не отвечали огромностию каменному дому."
                                            },
                                            {
                                                "example_id": "9e366c8b-0d05-4d29-88b0-018f8a7b0b08",
                                                "sense_id": "603902ee-41b1-3736-a320-8d4de672e7c8",
                                                "text": "Дом был трёхэтажный, старый и зелёного цвета."
                                            },
                                            {
                                                "example_id": "c1ab5796-acd9-4d59-8f09-9c37088d7ea6",
                                                "sense_id": "603902ee-41b1-3736-a320-8d4de672e7c8",
                                                "text": "Человек существо как бы трёхэтажное, жизнь его протекает на трех уровнях: телесном, эмоциональном и духовном."
                                            },
                                            {
                                                "example_id": "2a5ff178-d609-47e9-9a47-76207e287edf",
                                                "sense_id": "603902ee-41b1-3736-a320-8d4de672e7c8",
                                                "text": "К примеру, помню первого секретаря обкома КПСС, который страдал идеей фикс: он хотел построить трёхэтажный коровник."
                                            },
                                            {
                                                "example_id": "51bca9a0-f278-49c8-9a16-9ffdaabc21b8",
                                                "sense_id": "603902ee-41b1-3736-a320-8d4de672e7c8",
                                                "text": "Большой трёхэтажный ресторан с видом на порт, куда нас повел «Батону», оказался его собственностью."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8832c025-05b3-343f-8911-2b7e2587291e",
                                        "entry_id": "f2ed9cc6-e2fa-3129-805e-2dbcad23fa00",
                                        "glosses": [
                                            "разг. расположенный в три ряда один над другим"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a884ddec-e4be-4f1e-8c71-d3678fd3145b",
                                                "sense_id": "8832c025-05b3-343f-8911-2b7e2587291e",
                                                "text": "— Егор Яковлевич, ты на меня не сердит за что-нибудь? — Вопрос был необычным уже по одному тому, что майор обратился к старику на «ты». — Ну, может быть, я как-нибудь обидел тебя или что? — Нет, почему же так? — удивился тот и, точно впервые видя его, в свою очередь, осмотрел майора в его кителе с погонами и трёхэтажной колодкой орденов и медалей."
                                            },
                                            {
                                                "example_id": "fd7f5a8a-20e8-419a-9b1a-acdb35c6ad9c",
                                                "sense_id": "8832c025-05b3-343f-8911-2b7e2587291e",
                                                "text": "После этого мы снова вернулись к рисунку 2 и схеме В (рис. 2-1, слева), лицеистам был задан вопрос: «А всегда ли надо (пусть даже мысленно) целое заменять дробью со знаменателем 1, нельзя ли и здесь создать мини-алгоритм?» После обсуждения пришли к правилу преобразования трёхэтажной дроби."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6daeb744-3996-3b69-b757-2a1882a26163",
                                        "entry_id": "f2ed9cc6-e2fa-3129-805e-2dbcad23fa00",
                                        "glosses": [
                                            "высокий, большой, иногда более точно — имеющий высоту в три этажа"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a52b3c51-d8cc-4d65-8461-da0f02c2c47d",
                                                "sense_id": "6daeb744-3996-3b69-b757-2a1882a26163",
                                                "text": "Жена ― толстая, коротенькая, красная, рожа у неё трёхэтажная."
                                            },
                                            {
                                                "example_id": "5f93e35d-c291-427f-b89c-ef9a149af87b",
                                                "sense_id": "6daeb744-3996-3b69-b757-2a1882a26163",
                                                "text": "Уважаемый, покорнейше прошу пожаловать завтра к нам на трёхэтажное удовольствие"
                                            },
                                            {
                                                "example_id": "ee947940-cc17-48d6-9951-7a86435421a6",
                                                "sense_id": "6daeb744-3996-3b69-b757-2a1882a26163",
                                                "text": "В погребе было сумрачно; у входа цвела буржуйка ― железная печка, у меня в дневнике записано «трёхэтажная»."
                                            },
                                            {
                                                "example_id": "6053c211-6526-4a4b-98b2-e155b75f8b23",
                                                "sense_id": "6daeb744-3996-3b69-b757-2a1882a26163",
                                                "text": "Центральным элементом музея является трёхэтажное дерево, «растущее» через все уровни музея и видимое с любого из них."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5a319eb-b0eb-3fd6-ad57-b95c2e7c79c3",
                                        "entry_id": "f2ed9cc6-e2fa-3129-805e-2dbcad23fa00",
                                        "glosses": [
                                            "прост. очень неприличный; грубый"
                                        ],
                                        "tags": [
                                            "о многословной нецензурной брани"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8451417b-8962-4470-a64c-0053fe3204b4",
                                                "sense_id": "c5a319eb-b0eb-3fd6-ad57-b95c2e7c79c3",
                                                "text": "Снизу доносился трёхэтажный мат продажной мастерицы слова."
                                            },
                                            {
                                                "example_id": "6762d04b-38c7-472c-87af-d43660e69821",
                                                "sense_id": "c5a319eb-b0eb-3fd6-ad57-b95c2e7c79c3",
                                                "text": "Покрыть кого-либо трёхэтажным матом."
                                            },
                                            {
                                                "example_id": "0cfeaebd-9e03-4054-b561-a4543b9b0867",
                                                "sense_id": "c5a319eb-b0eb-3fd6-ad57-b95c2e7c79c3",
                                                "text": "\"Начальство встретило нас с первой же минуты самой отборной трёхэтажной руганью."
                                            },
                                            {
                                                "example_id": "d5b89963-9e78-4180-bea2-00dcf21e94b1",
                                                "sense_id": "c5a319eb-b0eb-3fd6-ad57-b95c2e7c79c3",
                                                "text": "― Часовой ещё что-то хотел сказать про своего начальника, но, видимо, не найдя крепче слов, жалобно протянул: ― Товарищи танкисты, дайте закурить! Щербак обложил солдата трёхэтажным матом. ― А он-то при чём?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
