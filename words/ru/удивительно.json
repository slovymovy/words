                {
                    "sense_id": "9c9f09fb-10a4-3822-ade1-4b4617b92509",
                    "sense_definition": "Оценка ситуации как вызывающей удивление; странно, неожиданно.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "predicative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Удивительно</w>, как я раньше этого не замечал.",
                            "target_lang_translations": {
                                "en": "<w>It is surprising</w> how I didn't notice this before.",
                                "nl": "<w>Het is verrassend</w> hoe ik dit eerder niet heb opgemerkt.",
                                "pl": "<w>To zadziwiające</w>, jak wcześniej tego nie zauważyłem.",
                                "de": "<w>Es ist erstaunlich</w>, wie ich das früher nicht bemerkt habe.",
                                "fr": "<w>C'est surprenant</w> comme je ne l'avais pas remarqué plus tôt.",
                                "it": "<w>È sorprendente</w> come non l'abbia notato prima.",
                                "cs": "<w>Je překvapivé</w>, jak jsem si toho dříve nevšiml.",
                                "tr": "<w>Şaşırtıcı ki</w>, bunu daha önce nasıl fark etmedim.",
                                "es": "<w>Es sorprendente</w> cómo no me había dado cuenta de esto antes.",
                                "zh": "<w>令人惊讶的是</w>，我以前怎么没注意到这一点。"
                            }
                        },
                        {
                            "text": "Всем было <w>удивительно</w>, что он пришёл вовремя.",
                            "target_lang_translations": {
                                "en": "It was <w>surprising</w> to everyone that he came on time.",
                                "nl": "Iedereen vond het <w>verrassend</w> dat hij op tijd kwam.",
                                "pl": "Dla wszystkich było <w>zaskakujące</w>, że przyszedł na czas.",
                                "de": "Es war für alle <w>überraschend</w>, dass er pünktlich kam.",
                                "fr": "Tout le monde a trouvé <w>étonnant</w> qu'il soit arrivé à l'heure.",
                                "it": "Per tutti <w>è stato sorprendente</w> che sia arrivato in orario.",
                                "cs": "Všem <w>přišlo překvapivé</w>, že přišel včas.",
                                "tr": "Onun zamanında gelmesi herkese <w>şaşırtıcı</w> geldi.",
                                "es": "A todos les <w>resultó sorprendente</w> que llegara a tiempo.",
                                "zh": "他能准时到达，大家都觉得<w>很奇怪</w>。"
                            }
                        }
