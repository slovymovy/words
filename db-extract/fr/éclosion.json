                "entry_id": "700e4da8-ef04-3b0a-aec9-2fa21d3367c0",
                "word": "éclosion",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "071b711d-2154-499a-b624-af71a0f37356",
                        "entry_id": "700e4da8-ef04-3b0a-aec9-2fa21d3367c0",
                        "tags": [
