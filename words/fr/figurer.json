                {
                    "sense_id": "0c74ab08-14b5-3da5-9bc3-975035a76e2a",
                    "sense_definition": "Représenter une idée ou une réalité abstraite sous une forme symbolique.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "symbolisme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans cette allégorie médiévale, la colombe blanche <w>figure</w> la pureté de l'âme face aux tentations."
