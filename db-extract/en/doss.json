            {
                "entry_id": "dd963df7-e2cb-3c2d-92a3-7757f5cf4c8a",
                "word": "doss",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8aadf5e0-468b-3cf0-8be2-afb98afa69f9",
                        "entry_id": "dd963df7-e2cb-3c2d-92a3-7757f5cf4c8a",
                        "glosses": [
                            "Useless or lazy. Generally combined with expletive noun, especially cunt."
                        ],
                        "tags": [
                            "Scotland",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "a95e2b4d-3d5e-4460-b299-1a30f640d9fc",
                                "sense_id": "8aadf5e0-468b-3cf0-8be2-afb98afa69f9",
                                "text": "Convinced it's no bullshit, the doss cunt dismisses the session. Ah walk tae freedom; perr auld Spud gits taken doon."
                            },
                            {
                                "example_id": "fafc12bc-8ba9-462f-b6f7-8d026f92dd76",
                                "sense_id": "8aadf5e0-468b-3cf0-8be2-afb98afa69f9",
                                "text": "Get a hauld o yersel, ya doss cunt!"
                            }
                        ]
                    },
                    {
                        "sense_id": "e8225db8-28fb-3b21-9f4d-3cc41d331b8d",
                        "entry_id": "dd963df7-e2cb-3c2d-92a3-7757f5cf4c8a",
                        "glosses": [
                            "Good, desirable."
                        ],
                        "tags": [
                            "Scotland",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "5e11f1db-b001-4863-b65d-aa23113013c5",
                                "sense_id": "e8225db8-28fb-3b21-9f4d-3cc41d331b8d",
                                "text": "The place is pure doss, like."
                            }
                        ]
                    }
                ],
