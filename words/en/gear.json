                        "zh": "飞机用于起飞和降落的轮子及机械结构。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шасси",
                                "target_lang_sense_clarification": "в авиации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "起落架",
                                "target_lang_sense_clarification": "航空术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3903230d-21f7-3a76-85eb-b4ad2ee0384f",
                    "sense_definition": "Illegal recreational drugs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police arrested a dealer who was selling <w>gear</w> in the club.",
                            "target_lang_translations": {
                                "ru": "Полиция арестовала дилера, который продавал <w>наркотики</w> в клубе.",
                                "zh": "警方逮捕了一名在俱乐部兜售<w>毒品</w>的贩子。"
                            }
                        },
                        {
                            "text": "He ruined his life by getting hooked on the <w>gear</w>.",
                            "target_lang_translations": {
                                "ru": "Он разрушил свою жизнь, подсев на <w>наркоту</w>.",
                                "zh": "他因为染上<w>毒品</w>而毁了自己的一生。"
                            }
                        }
                    ],
                    "synonyms": [
                        "drugs",
                        "dope"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нелегальные наркотические вещества.",
                        "zh": "非法娱乐性毒品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наркотики",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "дурь",
                                "target_lang_sense_clarification": "слэнг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "毒品",
                                "target_lang_sense_clarification": "非法药物"
                            }
                        ]
                    }
