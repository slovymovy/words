                ],
                "senses": [
                    {
                        "sense_id": "b7b6b32b-4d51-399a-8a37-c3284721c324",
                        "entry_id": "de8cfb84-832c-3319-8aa1-40672b15e52d",
                        "glosses": [
                            "S'occuper vaguement, jouer la montre. (Une note de bas de page de l'édition de 1844 indique : \\\"Muser, perdre du temps pour en gagner\\\")."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "5c050f18-e9a7-472a-9ec7-5fd2e13ba338",
                                "sense_id": "b7b6b32b-4d51-399a-8a37-c3284721c324",
                                "text": "Marsillat fit ses adieux, et alla détacher son cheval pour partir, mais il eut soin de casser une courroie, ce qui le força de demander une ficelle à la Gothe, un couteau à Jeanne, un mot à Claudie, et de bouriner et à fafioter, comme disait cette dernière, huit ou dix minutes autour de la maison."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6d18697-77dc-3397-8ff7-b05f7dff15f8",
                        "entry_id": "de8cfb84-832c-3319-8aa1-40672b15e52d",
                        "glosses": [
                            "Travailler, s’occuper, à des occupations diverses."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "c56e58d4-707f-4bf2-81fd-eaaa6d4b278e",
                                "sense_id": "f6d18697-77dc-3397-8ff7-b05f7dff15f8",
                                "text": "Maurice s’est blessé au doigt avec une alêne, on le soigne. Il bourine quand même."
                            },
                            {
                                "example_id": "a543a4f7-dc07-4445-9722-88c4fe444c91",
                                "sense_id": "f6d18697-77dc-3397-8ff7-b05f7dff15f8",
                                "text": "Putain, t’avais pas besoin de bouriner comme un taré !"
                            }
                        ]
                    }
                ],
