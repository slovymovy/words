                                                "example_id": "bf134018-ae39-4743-9b50-7d8eff3c16e3",
                                                "sense_id": "e8e20b11-da29-3621-9353-40aa2427d011",
                                                "text": "Ein Lichtstrahl geht nicht ungebrochen durch Wasser."
                                            }
