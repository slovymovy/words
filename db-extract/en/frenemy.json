                                        "sense_id": "c823f199-c900-3522-ba51-237797128bdc",
                                        "entry_id": "3e3b117c-e696-34bd-aeb1-2505a901f937",
                                        "glosses": [
                                            "Celui à la fois ami et ennemi de quelqu’un d’autre."
                                        ],
