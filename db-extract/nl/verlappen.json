                        "examples": [
                            {
                                "example_id": "da00d4ce-fb3a-45b8-ad7d-22b0c83b9daa",
                                "sense_id": "c5b656f7-0449-315f-b59e-d2ec2aef7411",
                                "text": "Nu willen enkele sluwe financiers de Belgische baggertrots Dredging International, de nummer twee op wereldvlak, verlappen aan een Nederlandse concurrent. Dat kunnen we toch niet laten gebeuren? Dat onze Noorderburen de Europese voetbalbeker komen halen, tot daar aan toe. Maar van onze baggeraars moeten ze afblijven. Is een confrontatie echt onvermijdelijk, laten we het dan in de modder uitvechten."
                            }
                        ]
