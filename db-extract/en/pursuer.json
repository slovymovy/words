                                                "example_id": "81f46cd7-f28e-4664-8423-e00556904598",
                                                "sense_id": "401b0b20-9a1a-3a21-8b16-39064081b32f",
                                                "text": "Créancier poursuivant, avoué poursuivant."
                                            },
                                            {
                                                "example_id": "8cdccc4b-43c2-4598-a9bf-2b64f0acc0d5",
