                        "examples": [
                            {
                                "example_id": "22bdd98c-b1d6-4880-960d-aedb8262bab9",
                                "sense_id": "71690a77-cf29-3ffb-89f5-3a9debe04db1",
                                "text": "[S]ome turne agayne by grace frõ their deadly hereſies into yͤ life of faith, ⁊ ſome be ſo ſore nowſeled in the falſe hereſies, ⁊ in their obſtinate frowardneſſe take ſuch a deueliſhe delight, yͭ finally thei die therin as did Baifield, Bainã, ⁊ Tewkeſbury."
                            },
                            {
                                "example_id": "67de725d-f61e-4f5f-9247-33ee75d0418a",
                                "sense_id": "71690a77-cf29-3ffb-89f5-3a9debe04db1",
                                "text": "[W]hereas Christian theology has always considered frowardness to be the essential vice of this part of human nature, the mind-curers say that the mark of the beast in it is fear; and this is what gives such an entirely new religious turn to their persuasion."
                            }
