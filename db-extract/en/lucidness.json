                    },
                    {
                        "translation_id": "720ed045-4b15-4e10-822a-724dcf243281",
                        "source_entry_id": "d83ab8b9-d3db-36c6-b933-b967391ed666",
                        "source_sense_id": "22727fe6-094a-3bfd-9f5b-6c449b23f63a",
                        "source_sense_description": "property of being lucid",
                        "target_lang_word": "klaarheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "klaarheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "437c87f7-091e-39bd-a170-713054ec17b5",
                                        "entry_id": "632c63ff-2ebc-3c82-a25b-f98e1e2531dc",
                                        "glosses": [
                                            "duidelijkheid, scherpheid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa8f8b22-6c23-4700-9869-b51cc6aa5de1",
                                                "sense_id": "437c87f7-091e-39bd-a170-713054ec17b5",
                                                "text": "De Onderzoeksraad voor Veiligheid (OVV) wint de Machiavelliprijs 2015. De raad krijgt de prijs omdat 'met het rapport over de ramp met de MH17 - waar mogelijk - klaarheid is gebracht voor de nabestaanden in het bijzonder en de wereld in het algemeen'. Daarnaast vindt de jury ook dat de OVV een schoolvoorbeeld is voor goede communicatie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e462caf4-a0e3-35f1-925d-5cfcee557944",
                                        "entry_id": "632c63ff-2ebc-3c82-a25b-f98e1e2531dc",
                                        "glosses": [
                                            "helderheid, transparantie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d49637fa-1122-4c73-be57-2498084a3d9f",
                                                "sense_id": "e462caf4-a0e3-35f1-925d-5cfcee557944",
                                                "text": "Ik zeg niet dat dit reden moet zijn om van bombarderen boven Syrië af te zien. Maar het onderstreept eens te meer dat oorlog zich lastig leent voor morele klaarheid. Wie opstaat tegen de slechteriken sluit bijna altijd bondjes met andere slechteriken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "18bbd425-354c-4f88-ac41-2d9955bf37d1",
                        "source_entry_id": "d83ab8b9-d3db-36c6-b933-b967391ed666",
                        "source_sense_id": "22727fe6-094a-3bfd-9f5b-6c449b23f63a",
                        "source_sense_description": "property of being lucid",
                        "target_lang_word": "lucidité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lucidité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bd7fe90e-f031-3d5d-8d27-4250d2942f34",
                                        "entry_id": "a39f3446-1737-3bbd-968e-f4e5c80bf54b",
                                        "glosses": [
                                            "Qualité, état de ce qui est lucide, ou de celui qui voit les choses nettement, qui conçoit clairement les questions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b6690e4-34bd-4fa3-bfc4-e218917a0fe7",
                                                "sense_id": "bd7fe90e-f031-3d5d-8d27-4250d2942f34",
                                                "text": "Les propos du gros garçon se mirent à charlestonner dans son cerveau où la lucidité s'insinuait souverainement."
                                            },
                                            {
                                                "example_id": "81f8149b-ef3a-4f0b-a7b1-1dc66069d19c",
                                                "sense_id": "bd7fe90e-f031-3d5d-8d27-4250d2942f34",
                                                "text": "Il la pénétrait bestialement, dans une hébétude sensuelle qui n'atteignait à la lucidité qu'à la minute où l'on voit, par une nuit d'été, la fusée d'un feu d'artifice fondre en un riche bouquet d'étoiles pâmées qui retombent au néant."
                                            },
                                            {
                                                "example_id": "6ac92127-118d-40e0-b9f4-e31876fc2498",
                                                "sense_id": "bd7fe90e-f031-3d5d-8d27-4250d2942f34",
                                                "text": "Et les intellectuels ? En France comme ailleurs, tous n'ont pas, loin s’en faut, une pleine lucidité sur cette précarité galopante. Les nuages sociaux qui s'accumulent les requièrent diversement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c59e945-360f-45b7-857e-7d755162ed02",
                        "source_entry_id": "d83ab8b9-d3db-36c6-b933-b967391ed666",
                        "source_sense_id": "22727fe6-094a-3bfd-9f5b-6c449b23f63a",
                        "source_sense_description": "property of being lucid",
                        "target_lang_word": "Deutlichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Deutlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "87ea2666-2ba8-3a54-bb5e-b65b850df824",
                                        "entry_id": "dc76afd7-8898-350c-84d7-9a212d5c9a73",
                                        "glosses": [
                                            "ohne Plural: Eigenschaft, sehr gut wahrnehmbar/verständlich zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb74d7be-2270-465d-8902-1c6110d0e808",
                                                "sense_id": "87ea2666-2ba8-3a54-bb5e-b65b850df824",
                                                "text": "„Er fühlte überhaupt alle Dinge in übergroßer Deulichkeit, so, als wäre seine Haut unermeßlich ausgebreitet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b140e3b9-bc19-31f6-a2f5-a89c3aed08f8",
                                        "entry_id": "dc76afd7-8898-350c-84d7-9a212d5c9a73",
                                        "glosses": [
                                            "ohne Plural: Eigenschaft, klar/unmissverständlich zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddbb591b-c069-460f-a50d-7f6a7546d5eb",
                                                "sense_id": "b140e3b9-bc19-31f6-a2f5-a89c3aed08f8",
                                                "text": "Seine Aussage ließ uns mit aller Deutlichkeit wissen, was er wirklich wollte."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "02084dd5-9403-3ed4-8b0f-959042a24f43",
                                        "entry_id": "dc76afd7-8898-350c-84d7-9a212d5c9a73",
                                        "glosses": [
                                            "mit Plural: Aussage/Handlung, die als grob, unverschämt empfunden wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13420f16-2ff2-4d40-9b00-776a541c2439",
                                                "sense_id": "02084dd5-9403-3ed4-8b0f-959042a24f43",
                                                "text": "Er warf ihm ein paar Deutlichkeiten an den Kopf."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb93fc1b-c247-43d3-a007-06b0e1ac6fef",
                        "source_entry_id": "d83ab8b9-d3db-36c6-b933-b967391ed666",
                        "source_sense_id": "22727fe6-094a-3bfd-9f5b-6c449b23f63a",
                        "source_sense_description": "property of being lucid",
                        "target_lang_word": "Klarheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klarheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6aa4ca32-d720-3015-b874-a75064e3558f",
                                        "entry_id": "5aff38c9-d02e-3a5c-8a70-65067efcce11",
                                        "glosses": [
                                            "Zustand der Durchsichtigkeit mangels Trübung, Verschmutzung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d166f2b-0df1-47a2-bd64-961152e6d06b",
                                                "sense_id": "6aa4ca32-d720-3015-b874-a75064e3558f",
                                                "text": "Die Klarheit des Wassers an diesem Tag war doch überraschend."
                                            },
                                            {
                                                "example_id": "22ad56bc-e04f-4903-a533-73927517276f",
                                                "sense_id": "6aa4ca32-d720-3015-b874-a75064e3558f",
                                                "text": "Die Klarheit ihres Blickes war betörend."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ac2a1cec-4d6f-3d03-b1b5-75c0fdf5ed04",
                                        "entry_id": "5aff38c9-d02e-3a5c-8a70-65067efcce11",
                                        "glosses": [
                                            "Verständlichkeit von Problemen, Verhältnissen oder Zuständen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a51c1fbc-86c5-43b0-a9f7-334f3192317e",
                                                "sense_id": "ac2a1cec-4d6f-3d03-b1b5-75c0fdf5ed04",
                                                "text": "Du solltest zunächst Klarheit über deine Ziele gewinnen."
                                            },
                                            {
                                                "example_id": "755e1503-feb7-482c-8e80-52be68062e51",
                                                "sense_id": "ac2a1cec-4d6f-3d03-b1b5-75c0fdf5ed04",
                                                "text": "Wir müssen uns zuerst Klarheit darüber verschaffen, worin eigentlich das Problem besteht."
                                            },
                                            {
                                                "example_id": "08ccd916-8bad-4080-b713-3ba61deeaf30",
                                                "sense_id": "ac2a1cec-4d6f-3d03-b1b5-75c0fdf5ed04",
                                                "text": "Ich muss Ihnen in aller Klarheit sagen, dass wir Ihnen den Kredit nicht geben werden."
                                            },
                                            {
                                                "example_id": "53c84d6b-4c77-4f61-a22c-c2e6e03b9ba8",
                                                "sense_id": "ac2a1cec-4d6f-3d03-b1b5-75c0fdf5ed04",
                                                "text": "In seine undurchsichtigen Geschäfte müssen wir erst einmal Klarheit bringen."
                                            },
                                            {
                                                "example_id": "e52ff9d2-5bc2-4136-856d-583cf8bd960a",
                                                "sense_id": "ac2a1cec-4d6f-3d03-b1b5-75c0fdf5ed04",
                                                "text": "Nachdem ich jetzt Klarheit über die finanzielle Situation habe, kann ich Kontakt zum Anwalt aufnehmen."
                                            },
                                            {
                                                "example_id": "09d6a5b6-17cc-4a52-a233-8659fded7491",
                                                "sense_id": "ac2a1cec-4d6f-3d03-b1b5-75c0fdf5ed04",
                                                "text": "Ich hoffe, dass ihre Aussage Klarheit in die Sache bringt."
                                            },
                                            {
                                                "example_id": "c2a6d6ea-5191-4e6b-9887-f7194b0e3d9a",
                                                "sense_id": "ac2a1cec-4d6f-3d03-b1b5-75c0fdf5ed04",
                                                "text": "„In ihm gibt er einem Französisch, das beispielhaft für die Klarheit und Deutlichkeit der Gedanken sein Verfassers ist, die Geschichte seiner geistigen Entwicklung wider; er schildert, wie er begann, das, was man ihn gelehrt hatte, zu bezweifeln und wie er weiter zweifelte bis er zu dem einfachen Schluß kam, alles sei zweifelhaft, nur nicht die Tatsache, daß es ihn, den Zweifler, gibt, weil er zweifelte (Dubito ergo sum — »Ich zweifle, deshalb bin ich«).“"
                                            },
                                            {
                                                "example_id": "15d4290b-33e8-4b3d-b41a-0d9931b4b298",
                                                "sense_id": "ac2a1cec-4d6f-3d03-b1b5-75c0fdf5ed04",
                                                "text": "„Rostow sah das mit einer Klarheit, als kenne er ihr ganzes Leben.“"
                                            },
                                            {
                                                "example_id": "e8b0be4c-354c-4e6b-ac82-75b9689aab80",
                                                "sense_id": "ac2a1cec-4d6f-3d03-b1b5-75c0fdf5ed04",
                                                "text": "„Aber da hatte sie ja zum Glück inzwischen auch Klarheit gefunden.“"
                                            },
                                            {
                                                "example_id": "0ae92353-6b56-498b-8bbb-1166d717e560",
                                                "sense_id": "ac2a1cec-4d6f-3d03-b1b5-75c0fdf5ed04",
                                                "text": "„Aber um Klarheit über die Todesursache zu bekommen, musste sie auf das Ergebnis der Obduktion warten, das am Tag darauf kommen sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
