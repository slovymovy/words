                    {
                        "translation_id": "b4277d7e-127a-4127-9447-c1520ffc9d56",
                        "source_entry_id": "e5f5a667-a15c-3787-b405-410f6c083e70",
                        "source_sense_id": "1c3582da-daa1-3da7-a818-cb93a6392d61",
