                    },
                    {
                        "translation_id": "d9c3a5a9-67ed-4b19-9fa2-1366c68e6d6b",
                        "source_entry_id": "7744d281-0e18-3aee-8609-cd38b95efc76",
                        "target_lang_word": "Intimität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Intimität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d6430d5f-7bfc-3beb-bd23-90d2d0fa0544",
                                        "entry_id": "98dd0171-8a58-34a8-aa6a-8a67dce19470",
                                        "glosses": [
                                            "Zustand tiefster Vertrautheit"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af3b6f8b-ec31-47c9-9563-f488a4b62bd4",
                                                "sense_id": "d6430d5f-7bfc-3beb-bd23-90d2d0fa0544",
                                                "text": "Die Intimität zwischen ihm und seiner Freundin konnte niemand zerstören."
                                            },
                                            {
                                                "example_id": "4fc4e77b-38f9-48d9-a4c5-84dfc319a237",
                                                "sense_id": "d6430d5f-7bfc-3beb-bd23-90d2d0fa0544",
                                                "text": "„Es gab keinen Platz für Geheimnisse und Intimität.“"
                                            },
                                            {
                                                "example_id": "d77fadcf-a98a-454f-9937-a4f5f13420b3",
                                                "sense_id": "d6430d5f-7bfc-3beb-bd23-90d2d0fa0544",
                                                "text": "„Sylvia wusste nicht, worum sie die beiden am meisten beneidete: die unkomplizierte, alltägliche Partnerschaft, die gemeinsame Liebe zu den Büchern oder die offensichtliche körperliche Intimität.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "00389afb-033a-315e-925c-ecd679dd40bf",
                                        "entry_id": "98dd0171-8a58-34a8-aa6a-8a67dce19470",
                                        "glosses": [
                                            "Vertraulichkeiten plumper Art"
                                        ],
                                        "tags": [
                                            "im Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7b5553b-fca0-4302-befa-34e64bb58239",
                                                "sense_id": "00389afb-033a-315e-925c-ecd679dd40bf",
                                                "text": "Solche Intimitäten dulde ich in meinem Hause nicht!"
