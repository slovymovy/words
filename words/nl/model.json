                    "sense_id": "84cce714-d06e-3c8d-8130-d3aa272bda85",
                    "sense_definition": "een persoon die beroepsmatig kleding presenteert of poseert voor foto's of kunstwerken",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "persoon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij werkt als een beroemd <w>model</w> dat in vele internationale modebladen te bewonderen is.",
                            "target_lang_translations": {
