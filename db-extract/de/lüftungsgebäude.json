                "senses": [
                    {
                        "sense_id": "7bd59356-21aa-3f8c-ace3-ba6c56db3eb4",
                        "entry_id": "da058174-5411-3879-83b2-30ccb5e81c85",
                        "glosses": [
                            "oberirdischer, separat errichteter Bau, in dem Lüftungstechnik steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f96fdfa5-44dc-458c-8f63-c050def8728f",
                                "sense_id": "7bd59356-21aa-3f8c-ace3-ba6c56db3eb4",
                                "text": "„Die Außenrampen des Knotens werden generell mit einer dichten Sichtschutzpflanzung „umhüllt“; sowohl das Gebäude der Portalluftabsaugung als auch das Lüftungsgebäude der Betriebsstation werden architektonisch gestaltet und fügen sich so bestmöglich in den Landschaftsraum ein.“"
                            },
                            {
                                "example_id": "e16577ca-83b1-415b-9917-0ac674d662b9",
                                "sense_id": "7bd59356-21aa-3f8c-ace3-ba6c56db3eb4",
                                "text": "„Städtebaulich problematische, weil dominierende Elemente wie das Lüftungsgebäude der Wiener Linien werden zum Kunsthalle Wien Schaufenster und halbjährlich mit einer künstlerischen Arbeit bespielt.“"
                            },
                            {
                                "example_id": "da1640ae-f0fa-4514-b585-a3bfacceab9c",
                                "sense_id": "7bd59356-21aa-3f8c-ace3-ba6c56db3eb4",
                                "text": "„Nachdem unter den Bezeichnungen XHM, XHEE, XHEIN u.a. eine Modulatorenhalle, ein Pumpenhaus, ein Rückkühlerhaus und eine Eingangshalle in Bahrenfeld für die überirdischen Ergänzungen zum European X-Ray Free-Electron Laser gebaut wurden, geht es jetzt am Osdorfer Born weiter mit XHE1: einer Kranhalle und LKW-Durchfahrtshalle mit 2 x 10 Tonnen Kranbahn, einer Schaltwarte und 6 Trafoboxen in Ortbeton und einem Lüftungsgebäude mit 750 m² Grundfläche.“"
                            },
                            {
                                "example_id": "f13736be-5221-4d31-b21f-68ba5fbf711f",
                                "sense_id": "7bd59356-21aa-3f8c-ace3-ba6c56db3eb4",
                                "text": "„Zur Aufnahme der betriebstechnischen Komponenten gibt es je ein Lüftungsgebäude auf der Nord- und Südseite.“"
                            },
                            {
                                "example_id": "f5658095-492e-49be-960d-bb2935b8f668",
                                "sense_id": "7bd59356-21aa-3f8c-ace3-ba6c56db3eb4",
                                "text": "„Das Lüftungsgebäude wird mit einem Netz, bestehend aus verschieden großen Kugeln, umhüllt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
