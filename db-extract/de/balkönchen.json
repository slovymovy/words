                ],
                "senses": [
                    {
                        "sense_id": "1f2f6ebb-adf2-3d21-b54d-3ac6006879c0",
                        "entry_id": "01d321e5-03c6-35cd-9848-4669be351d1e",
                        "glosses": [
                            "kleiner Balkon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "441f7d29-0a80-4406-af87-dd0d9994ee20",
                                "sense_id": "1f2f6ebb-adf2-3d21-b54d-3ac6006879c0",
                                "text": "„Er arrondierte acht unregelmäßige schmale Grundstücke im Halbkreis um eine Vorgartenfläche und baute durchweg dreistöckige, gleichwohl auch in der Höhe abgestufte, verschieden breite Häuser mit unterschiedlichsten Charakteristika – mal Mansarden und Gauben, mal Terrassen und Balkönchen, hier rechteckige, dort runde Fenster, mal ein paar Stufen, dann wieder gewendelte Treppen.“"
                            },
                            {
                                "example_id": "02b96c32-598e-46b9-96b2-91c0a1af4de3",
                                "sense_id": "1f2f6ebb-adf2-3d21-b54d-3ac6006879c0",
                                "text": "„Wo Bangkok an den Stadträndern ausfranst, führt das vierspurige Asphaltband an neu errichteten Wohnsiedlungen vorbei, an Reihenhäusern europäischen Stils mit Fachwerk und Balkönchen.“"
                            },
                            {
                                "example_id": "0912ea30-d2a0-449d-b3eb-5ae06947337f",
                                "sense_id": "1f2f6ebb-adf2-3d21-b54d-3ac6006879c0",
                                "text": "„Ausdruck des Homings sind Kochparties mit Freunden, Spieleabende, Themenfeste, eine bunte, lebensfrohe Einrichtung und, nicht zuletzt, die liebevolle und sehr individuelle Gestaltung des eigenen Gartens, der Terrasse oder des Balkönchens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db7280ba-fc94-4f54-8e54-90b1ebb7da3c",
                        "source_entry_id": "01d321e5-03c6-35cd-9848-4669be351d1e",
                        "source_sense_id": "1f2f6ebb-adf2-3d21-b54d-3ac6006879c0",
                        "source_sense_description": "kleiner Balkon",
                        "target_lang_word": "balcony",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "balcony",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e3e4bfe-c180-36fa-8625-7ec146e4b543",
                                        "entry_id": "4a7f9f20-c95b-3cb7-ad1e-663d58dd4a77",
                                        "glosses": [
                                            "An accessible structure extending from a building, especially outside a window."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4127001e-4f8d-4d0b-8a0f-26f0f748aa98",
                                                "sense_id": "7e3e4bfe-c180-36fa-8625-7ec146e4b543",
                                                "text": "I sprang a step forward; when two shadows were distinctly traced on the moonlit myrtle! Then two figures stood upon the balcony. A young cavalier jumped from the balustrade, and hurried down the path that led to the garden, where I well remember a gate opened on an unfrequented lane."
                                            },
                                            {
                                                "example_id": "c0e3782a-db62-4fb9-ac0d-00ce8b18043a",
                                                "sense_id": "7e3e4bfe-c180-36fa-8625-7ec146e4b543",
                                                "text": "The next day as the three travelers were approaching the town, Peter went out on the balcony to pray."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6febfc5c-8c47-3c34-8d6a-b91dd77b8522",
                                        "entry_id": "4a7f9f20-c95b-3cb7-ad1e-663d58dd4a77",
                                        "glosses": [
                                            "An accessible structure overlooking a stage or the like."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e81eab6-0dc4-40bd-8a5b-de26a7847782",
                                                "sense_id": "6febfc5c-8c47-3c34-8d6a-b91dd77b8522",
                                                "text": "Sepia Delft tiles surrounded the fireplace, their crudely drawn Biblical scenes in faded cyclamen blending with the pinkish pine, while above them, instead of a mantelshelf, there was an archway high enough to form a balcony with slender balusters and a tapestry-hung wall behind."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0c46a9b1-6e4a-4acb-8111-5a6abba7b49b",
                        "source_entry_id": "01d321e5-03c6-35cd-9848-4669be351d1e",
                        "source_sense_id": "1f2f6ebb-adf2-3d21-b54d-3ac6006879c0",
                        "source_sense_description": "kleiner Balkon",
                        "target_lang_word": "balconnet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "balconnet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d24dc242-dc81-3411-9c8e-0043892266a4",
                                        "entry_id": "7af172cb-7b1c-304c-a31f-bd2eea6e0f9b",
                                        "glosses": [
                                            "Garde-corps surmontant une allège basse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abe140c5-f3d4-4232-b4c1-7d6a1645fcad",
                                                "sense_id": "d24dc242-dc81-3411-9c8e-0043892266a4",
                                                "text": "On nous y ouvrit, pour ces quelques nuits, à Michel la grande chambre occupant tout le premier étage, à moi une sorte d’étroite alcôve prise dans toute la longueur de la pièce, et qui, par un balconnet, donnait aussi sur la mer."
                                            },
                                            {
                                                "example_id": "dfc039c9-a81e-4189-84a2-1eccdf3e1f59",
                                                "sense_id": "d24dc242-dc81-3411-9c8e-0043892266a4",
                                                "text": "Les fenêtres du premier comportent un balconnet à balustres en fer forgé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67a53b6c-189e-3da2-802c-af17af4b6f99",
                                        "entry_id": "7af172cb-7b1c-304c-a31f-bd2eea6e0f9b",
                                        "glosses": [
                                            "Balcon à très petite plate-forme."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c931813f-ccd8-3df2-87f7-f05322408759",
                                        "entry_id": "7af172cb-7b1c-304c-a31f-bd2eea6e0f9b",
                                        "glosses": [
                                            "Armature de soutien-gorge découvrant la poitrine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e002bc1b-1955-497e-a159-378e38f95006",
                                                "sense_id": "c931813f-ccd8-3df2-87f7-f05322408759",
                                                "text": "Ce string si incongru sur une plage au caractère familial bien connu, ce soutien gorge à balconnets ranimant le mythe d’une Ursula Andress sortant des ondes !"
                                            },
                                            {
                                                "example_id": "f2b2194d-537d-4e14-a4af-845d69416957",
                                                "sense_id": "c931813f-ccd8-3df2-87f7-f05322408759",
                                                "text": "Adieu baleines, bretelles, bonnets, balconnet ! Se délester de sa lingerie fine est devenu synonyme de liberté pour une communauté grandissante de femmes, adeptes du « No Bra » (« pas de soutien-gorge »)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac9760d7-2129-3b41-93e2-d30cc0a7b629",
                                        "entry_id": "7af172cb-7b1c-304c-a31f-bd2eea6e0f9b",
                                        "glosses": [
                                            "Type de soutien-gorge pigeonnant."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "640a190d-04c9-474b-b37b-50a9d6f7b17a",
                                                "sense_id": "ac9760d7-2129-3b41-93e2-d30cc0a7b629",
                                                "text": "Ton balconnet fait loucher tous les hommes !"
                                            },
                                            {
                                                "example_id": "66f38618-7e00-4faa-b9a5-49f0b286f7b6",
                                                "sense_id": "ac9760d7-2129-3b41-93e2-d30cc0a7b629",
                                                "text": "Dans la vitrine se déploient des caracos fleuris, des soutiens-gorge balconnets, des culottes échancrées dans des tons de fraîcheur, de pois de senteur mauves et bleus, quelques photos de modèles alanguis arborent des ensembles noirs plus sulfureux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
