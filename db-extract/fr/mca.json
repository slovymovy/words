            {
                "entry_id": "e2dc559d-026d-30ae-9cf2-939ac40187de",
                "word": "MCA",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "396fcfb3-df6d-33d6-9216-dd4fb4706481",
                        "entry_id": "e2dc559d-026d-30ae-9cf2-939ac40187de",
                        "glosses": [
                            "Ancien parti politique qui se réclamait du nationalisme corse et était considéré comme la vitrine légale du FLNC."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e926459c-ae7f-4c96-add0-4f6c4837886f",
                                "sense_id": "396fcfb3-df6d-33d6-9216-dd4fb4706481",
                                "text": "Après la dissolution par l’État de la CCN, le MCA (mouvement corse pour l’autodétermination) prend sa succession."
                            },
                            {
                                "example_id": "93cf5d03-847d-45cf-bd5d-939ec0c19aaf",
                                "sense_id": "396fcfb3-df6d-33d6-9216-dd4fb4706481",
                                "text": "La CCN (qui avait précédé le MCA) avait, à l’occasion des premières Journées internationales de Corte, noué des liens avec des Catalans et adhéré au Ciemen (Centre international pour les minorités)."
                            },
                            {
                                "example_id": "0434db91-ea77-48e7-bc9f-a944c2df2846",
                                "sense_id": "396fcfb3-df6d-33d6-9216-dd4fb4706481",
                                "text": "Et avec les félicitations d’une association légale, le MCA (Mouvement corse pour l’autodétermination) dont les dirigeants inculpés pour apologie de la violence sont arrêtés puis relâchés à condition de ne pas quitter l’île."
                            }
                        ]
                    }
