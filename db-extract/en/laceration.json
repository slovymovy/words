                ],
                "senses": [
                    {
                        "sense_id": "efae1d88-41ee-3ed6-8670-7401a8973330",
                        "entry_id": "84a4fa92-0327-3afa-8f6e-00f52b21d3fd",
                        "glosses": [
                            "An irregular open wound caused by a blunt impact to soft tissue."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "55175505-8648-43a3-9d26-29566b060185",
                                "sense_id": "efae1d88-41ee-3ed6-8670-7401a8973330",
                                "text": "The doctor sewed up the laceration in his arm."
                            },
                            {
                                "example_id": "d1b00ce9-51d3-4bda-a7fe-4ef571397c67",
                                "sense_id": "efae1d88-41ee-3ed6-8670-7401a8973330",
                                "text": "Survivors of the crash suffered injuries ranging from broken bones to lacerations, permanent disfigurements, and psychiatric trauma."
                            }
                        ]
                    },
                    {
                        "sense_id": "77ddf1dc-66cd-305f-be00-42f0f88b13e4",
                        "entry_id": "84a4fa92-0327-3afa-8f6e-00f52b21d3fd",
                        "glosses": [
                            "The act of lacerating or tearing."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
