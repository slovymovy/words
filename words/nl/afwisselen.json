                    "semantic_group_id": "alterneren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zonnige perioden <w>wisselden</w> <w>af</w> met lichte buien.",
                            "target_lang_translations": {
                                "en": "Sunny periods <w>alternated</w> with light showers."
                            }
                        },
                        {
