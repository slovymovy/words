                "senses": [
                    {
                        "sense_id": "2a6f169d-3c48-3cee-b195-2b78545d104a",
                        "entry_id": "a0e42f8f-95de-3c67-8299-af857d8d0f4f",
                        "glosses": [
                            "Konzentration von eingenommenen Medikamenten im Körper"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81cef303-c08b-4fef-a403-73b9bf1cdfe0",
                                "sense_id": "2a6f169d-3c48-3cee-b195-2b78545d104a",
                                "text": "„In besonderen Fällen kann durch eine Bestimmung der Medikamentenspiegel im Blutplasma festgestellt werden, ob Besonderheiten des Medikamentenstoffwechsels […] vorliegen.“"
                            },
                            {
                                "example_id": "1a8f59cf-700c-4480-a697-db84b874ab3d",
                                "sense_id": "2a6f169d-3c48-3cee-b195-2b78545d104a",
                                "text": "„Ein Plasmaaustausch beeinflusst die Medikamentenspiegel möglicherweise auch indirekt über Veränderungen der Konzentration und Zusammensetzung von beteiligten Transportproteinen und Enzymen […].“"
                            },
                            {
                                "example_id": "c936ba0f-bc59-4083-88f9-c9dbe183e6ed",
                                "sense_id": "2a6f169d-3c48-3cee-b195-2b78545d104a",
                                "text": "„Beim sogenannten „Drug Monitoring“ werden Medikamentenspiegel bestimmt, z. B. um festzustellen, ob die eingesetzte Dosis beim Patienten noch im therapeutischen Bereich liegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
