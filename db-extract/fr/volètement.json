                        "glosses": [
                            "Action de voleter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "187b6d99-a3fa-4631-8925-63f7f81917b3",
                                "sense_id": "9553c395-9154-32b7-bdcf-efa8094a3e3b",
                                "text": "Les yeux avaient gardé leur éclat, et la chevelure était toujours flamboyante sous le volètement des ailes blanches de la coiffe."
                            },
                            {
                                "example_id": "c0b7f196-af6f-4d42-bc46-f5717fc1d7f0",
                                "sense_id": "9553c395-9154-32b7-bdcf-efa8094a3e3b",
                                "text": "Dans son long peignoir gris et onduleux, elle avait le piétinement incertain et le volètement gauche d’un oiseau de passage abrité dans une grotte, qui cherche au réveil son sens et sa direction."
                            },
                            {
                                "example_id": "6a2b6757-f6b6-45a6-b4b5-efd8dc518ec1",
                                "sense_id": "9553c395-9154-32b7-bdcf-efa8094a3e3b",
                                "text": "Tout ce qui m'est resté, c'est la sensation d'être porté sur le sein houleux et gonflé d'un grand fleuve, de traverser le cœur d'une zone tropicale, dans un volètement de plumes éblouissantes."
                            }
                        ]
                    }
