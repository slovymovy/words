                    "frequency": "Low",
                    "semantic_group_id": "botany_and_food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer planted <w>buckwheat</w> to improve the soil quality between main crops.",
                            "target_lang_translations": {
