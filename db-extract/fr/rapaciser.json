                "senses": [
                    {
                        "sense_id": "e9418d74-1e00-3afa-aebc-42e173b3c2f4",
                        "entry_id": "e83c3e70-b816-3628-b46a-e93c466d1d91",
                        "glosses": [
                            "S’approprier quelque chose comme un rapace le ferait."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a08c6e9-caa0-4e6e-b4e2-4db9b8591b13",
                                "sense_id": "e9418d74-1e00-3afa-aebc-42e173b3c2f4",
                                "text": "Ils l'attaquent pour quelque chose qu'ils n'ont pas créé, qu'ils ont rapacisé, pour du fric !"
                            },
                            {
                                "example_id": "2b663bb4-d95f-4701-9700-cf55701eb2d9",
                                "sense_id": "e9418d74-1e00-3afa-aebc-42e173b3c2f4",
                                "text": "Parce que l'espace social du DIRE et de l'expression artistique est accaparé, rapacisé, par des élites politiques et culturelles qui ont fait main-basse, depuis la nuit des temps, sur toutes les activités valorisantes de la société."
                            }
                        ]
                    },
