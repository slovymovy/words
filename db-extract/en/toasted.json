                        "tags": [],
                        "examples": [
                            {
                                "example_id": "465d3a8a-5b69-4c17-945d-b02419d94456",
                                "sense_id": "bc0f0d1c-a9a1-3287-880c-e12918f15542",
                                "text": "Would you like a toasted sandwich?"
                            }
                        ]
                    },
                    {
                        "sense_id": "39acbfa2-1ecd-3169-ba19-e62ed0f63ab1",
                        "entry_id": "7863e762-133b-3954-a4bd-64933d56a6fc",
                        "glosses": [
                            "Very hot."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "9de8827b-a71f-498a-b284-fe9de9ec702a",
                                "sense_id": "39acbfa2-1ecd-3169-ba19-e62ed0f63ab1",
                                "text": "We got absolutely toasted on the beach today."
                            }
                        ]
                    },
                    {
                        "sense_id": "959866ce-61b8-3c29-b276-4996ecfd41e8",
                        "entry_id": "7863e762-133b-3954-a4bd-64933d56a6fc",
                        "glosses": [
                            "Drunk or stoned."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "67ea3614-1148-47c2-883d-3549c89dfaef",
                                "sense_id": "959866ce-61b8-3c29-b276-4996ecfd41e8",
                                "text": "Night after night we cheerfully drank, squinting there in the dark like bulb-eyed lemurs, and once or twice even got toasted, waking up the next day on a dark, cold morning with the numbed, palsied tongue of dead vodka."
                            }
                        ]
                    }
