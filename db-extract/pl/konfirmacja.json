                "senses": [
                    {
                        "sense_id": "d81ea24e-87ba-31e7-82ee-1ba3ffb3e7b7",
                        "entry_id": "08236120-307e-363e-a3d7-a134d608b1b4",
                        "glosses": [
                            "u protestantów: uroczyste przyjęcie do gminy kościelnej chłopców i dziewcząt połączone z egzaminem i błogosławieństwem pastora"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3328a652-0127-4107-8131-c6bdd8c121a6",
                                "sense_id": "d81ea24e-87ba-31e7-82ee-1ba3ffb3e7b7",
                                "text": "Dzisiaj odbędzie się konfirmacja."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c44eb4d1-fc0f-476c-accb-32548d96992d",
                        "source_entry_id": "08236120-307e-363e-a3d7-a134d608b1b4",
                        "source_sense_id": "d81ea24e-87ba-31e7-82ee-1ba3ffb3e7b7",
                        "target_lang_word": "Konfirmation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Konfirmation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "768fd144-acee-30a1-9e05-f836f52f3623",
                                        "entry_id": "25850ed0-3974-361b-9ed1-2718f5986660",
                                        "glosses": [
                                            "festlicher Eintritt eines Menschen in die christlich-evangelische Gemeinde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6cdc3005-d798-400d-be80-b562c82db96f",
                                                "sense_id": "768fd144-acee-30a1-9e05-f836f52f3623",
                                                "text": "Die Konfirmation entspricht der katholischen Kommunion und findet meist im 14. Lebensjahr statt."
                                            },
                                            {
                                                "example_id": "2ed651a4-d893-413b-aa90-e99f908683c4",
                                                "sense_id": "768fd144-acee-30a1-9e05-f836f52f3623",
                                                "text": "Die Konfirmation zu erteilen ist eine rituelle Handlung des Pfarrers einer evangelischen Gemeinde. Die aktive Handlung liegt ebenso beim Konfirmanden, er konfirmiert, statt fälschlich: wird beziehungsweise wurde konfirmiert."
                                            },
                                            {
                                                "example_id": "6eb6dd09-3efa-48dc-ab3f-833b7b7542e0",
                                                "sense_id": "768fd144-acee-30a1-9e05-f836f52f3623",
                                                "text": "Mir wurde letztes Jahr die Konfirmation erteilt, ich habe konfirmiert."
                                            },
                                            {
                                                "example_id": "1c955dd7-2da3-48d4-aae4-fcd3df064849",
                                                "sense_id": "768fd144-acee-30a1-9e05-f836f52f3623",
                                                "text": "„Für die Konfirmation mußte Volker sich in Schale werfen.“"
                                            },
                                            {
                                                "example_id": "26b16b02-4cb0-41bb-99bd-9a74dc23b97c",
                                                "sense_id": "768fd144-acee-30a1-9e05-f836f52f3623",
                                                "text": "„Den Anzug hatte er schon einen Monat zuvor zu seiner Konfirmation getragen, er und Vegard waren zusammen konfirmiert worden, beide in dunklen Anzügen und neuen blanken Schuhen.“"
                                            },
                                            {
                                                "example_id": "69b7b703-946b-42d2-9c4f-a6279bf20a9f",
                                                "sense_id": "768fd144-acee-30a1-9e05-f836f52f3623",
                                                "text": "„Dann, im Frühjahr 1950, stand die Konfirmation ihres Sohnes an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
