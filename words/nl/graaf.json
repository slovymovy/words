                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "waardering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die nieuwe film die we gisteren zagen was echt <w>graaf</w>.",
