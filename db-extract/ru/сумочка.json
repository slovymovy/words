                                        "sense_id": "2fb4d0ba-22e3-301e-9bba-35bb23a76053",
                                        "entry_id": "fe4883ed-628d-3e2c-8f48-1c30dd8eaea0",
                                        "glosses": [
                                            "A small book, particularly (US) a paperback or (UK) notebook able to fit into a pocket (of any genre, from reference work to fine art)."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc5b347d-948f-40da-9179-37898f9e9670",
                                                "sense_id": "2fb4d0ba-22e3-301e-9bba-35bb23a76053",
                                                "text": "The publishers brought out small format pocketbooks of the whole of their nature series."
                                            },
                                            {
                                                "example_id": "750f3826-704f-4550-a78a-3a46b3e6dafe",
                                                "sense_id": "2fb4d0ba-22e3-301e-9bba-35bb23a76053",
                                                "text": "The kit is produced in three parts including a pocket book designed to fit into a shirt pocket for everyday on-the-job use, a more detailed guide and a training CD. The kit includes a hazard reporting and feedback notebook and hazard management process prompt cards to remind workers of common hazards they may encounter in day-to-day operations."
                                            },
                                            {
                                                "example_id": "7511993a-deda-4e3e-95bb-ec7e169e553e",
                                                "sense_id": "2fb4d0ba-22e3-301e-9bba-35bb23a76053",
                                                "text": "\"I have now lost\", he wrote in his pocketbook, \"the last barrier between me and death...\""
                                            },
                                            {
                                                "example_id": "4d12ce62-ee86-4334-93c2-5fa5c4df4183",
                                                "sense_id": "2fb4d0ba-22e3-301e-9bba-35bb23a76053",
                                                "text": "Dave recorded the information in his pocketbook and looked Gibbs straight in the eye."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2cc7ac6-2677-31e4-a328-fb6008cb5f5a",
