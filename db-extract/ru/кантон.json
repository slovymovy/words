                                        "entry_id": "12b1faf3-3725-3b73-a227-a790e9c73070",
                                        "glosses": [
                                            "A division of a shield occupying one third of the chief, usually on the dexter side, formed by a perpendicular line from the top meeting a horizontal line from the side."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f50f73a-a63e-4853-9205-dc05bcc80d9d",
                                                "sense_id": "1ea76a20-742b-32ba-9178-64290ed6d0b4",
                                                "text": "The king gave us the arms of England to be borne in a canton in our arms."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "canton",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d23f837-eb27-3eff-b7ad-2d71f495d135",
                                        "entry_id": "6e868ad1-1c66-3311-b963-de89c25391d5",
                                        "glosses": [
                                            "To delineate as a separate district."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bd03203d-947f-3ad0-a0bb-fb481efbc083",
                                        "entry_id": "6e868ad1-1c66-3311-b963-de89c25391d5",
                                        "glosses": [
                                            "To divide into cantons."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0afa9d7d-834b-371b-90f9-e556eccc5c82",
                                        "entry_id": "6e868ad1-1c66-3311-b963-de89c25391d5",
                                        "glosses": [
                                            "To quarter troops by requisitioning housing from the civilian population."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ed37b70-56ce-4530-870f-8fa4cb6da0b5",
                                                "sense_id": "0afa9d7d-834b-371b-90f9-e556eccc5c82",
                                                "text": "To the end of husbanding the supplies, he will cause to be cantoned in the cities and villages the greatest possible numbers of troops"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75beb953-5e31-3a6d-b956-b3d0a5be92a0",
                                        "entry_id": "6e868ad1-1c66-3311-b963-de89c25391d5",
                                        "glosses": [
                                            "To be allotted such quarters."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "647dd3cb-89a1-4719-bad8-93e9297e9193",
                                                "sense_id": "75beb953-5e31-3a6d-b956-b3d0a5be92a0",
                                                "text": "An army, falling back upon its lines of magazines, may … make its retreat with more security than one which has to canton, to subsist, and to extend itself to find cantonments."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "canton",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "71c47f04-2250-3a07-8252-64e09d1932f5",
                                        "entry_id": "74d773d8-89c7-3ec1-a4c8-18557633eb6b",
                                        "glosses": [
                                            "A song or canto."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb31807f-cad9-4a23-af30-20d399ae4086",
                                                "sense_id": "71c47f04-2250-3a07-8252-64e09d1932f5",
                                                "text": "Write loyal cantons of contemnèd love / And sing them loud even in the dead of night."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
