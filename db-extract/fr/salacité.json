        "fr-extract.jsonl": [
            {
                "entry_id": "e52fed3c-2cbd-34b4-9b63-5ea73e48a2b5",
                "word": "salacité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "420fae94-1e24-4cd1-b379-da032fb9d1bd",
                        "entry_id": "e52fed3c-2cbd-34b4-9b63-5ea73e48a2b5",
                        "tags": [
                            "plural"
                        ],
                        "form": "salacités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4b944dba-b9bf-3241-82ae-d990165e5e84",
                        "entry_id": "e52fed3c-2cbd-34b4-9b63-5ea73e48a2b5",
                        "glosses": [
                            "Penchant prononcé pour l’érotisme, l’obscénité, les rapports sexuels."
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "dcf3e63f-9dc0-48b1-a873-60340b04a041",
                                "sense_id": "4b944dba-b9bf-3241-82ae-d990165e5e84",
                                "text": "Le plus souvent, sans doute, c’est dans un moment d’ébriété ou plutôt de cette salacité irrésistible, que déchaîne dans le sang de l’Européen l’air balsamique et chaud des tropiques, que le baiser criminel aura rapproché du maître la sémillante esclave, aux formes exubérantes et gracieuses."
                            },
                            {
                                "example_id": "3f22c301-9672-44f5-9023-01366765d0b1",
                                "sense_id": "4b944dba-b9bf-3241-82ae-d990165e5e84",
                                "text": "Les couleurs tranchées de sa cotte hardie amusent l’œil, et elle peut découvrir jusqu’aux jarretières, ou peu s’en faut, une jambe fine moulée dans un bas rouge à coins d’or, perspective agréable aux jeunes comme aux vieux, aux vieux surtout dont elle réveille la salacité endormie."
                            },
                            {
                                "example_id": "f9f1b062-64fb-47f0-9a4f-3ab5a02d44bc",
                                "sense_id": "4b944dba-b9bf-3241-82ae-d990165e5e84",
                                "text": "La belle Nicaise était une veuve, fort riche, habitant non loin de la ville et dont la salacité faisait l’objet d’une chronique scandaleuse abondante comme un folklore."
                            }
                        ]
                    },
                    {
                        "sense_id": "f0a349b8-f027-3e0f-bd6d-1aa608c2b98c",
                        "entry_id": "e52fed3c-2cbd-34b4-9b63-5ea73e48a2b5",
                        "glosses": [
                            "Caractère érotique, lubrique, obscène de propos ou de comportements."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40b8b18e-0cdc-4004-bd66-c9449fe12768",
                                "sense_id": "f0a349b8-f027-3e0f-bd6d-1aa608c2b98c",
                                "text": "Dus en partie à une certaine excitation génésique, ces actes de salacité sont surtout le fait du défaut de conscience et de la perte absolue du sentiment de la pudeur, qui existe chez les déments."
                            },
                            {
                                "example_id": "a34656e1-b51c-4207-ac5f-5a63fffd1925",
                                "sense_id": "f0a349b8-f027-3e0f-bd6d-1aa608c2b98c",
                                "text": "Il semble que la nature se pervertisse devant lui et que ce soit sa présence même qui la déprave ; pour la première fois, il comprend l’immuable salacité des bois, découvre des priapées dans les futaies."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e148fb6e-7be2-49f0-9920-b230360555b1",
                        "source_entry_id": "e52fed3c-2cbd-34b4-9b63-5ea73e48a2b5",
                        "target_lang_word": "salaciousness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "salaciousness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb61fe33-2776-33bb-ac51-d3e9e77bf8a0",
                                        "entry_id": "735a9030-175c-3aeb-bd1c-b7041fa79a96",
                                        "glosses": [
                                            "The state or characteristic of being salacious."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb16af7b-db6c-4b32-91e8-68a9829c42b6",
                                                "sense_id": "fb61fe33-2776-33bb-ac51-d3e9e77bf8a0",
                                                "text": "The cock, from his salaciousness, is allowed to be a short lived animal; but how long these birds live, if left to themselves, is not yet well ascertained by any historian."
                                            },
                                            {
                                                "example_id": "a0233e17-3b41-481c-ab65-bcc479251b8a",
                                                "sense_id": "fb61fe33-2776-33bb-ac51-d3e9e77bf8a0",
                                                "text": "[…] he began a tale which cannot be retold here, but which delighted the boys as much by its salaciousness as by its vivacity."
                                            },
                                            {
                                                "example_id": "0acb2011-043c-4881-932e-fea2fdd45b3b",
                                                "sense_id": "fb61fe33-2776-33bb-ac51-d3e9e77bf8a0",
                                                "text": "I giggle with the most revolting salaciousness over La Vie Parisienne, when I get hold of one in Chicago, yet I shouldn’t even try to hold your hand."
                                            },
                                            {
                                                "example_id": "f20ce28c-c431-40e3-90a9-42d13e77d0e9",
                                                "sense_id": "fb61fe33-2776-33bb-ac51-d3e9e77bf8a0",
                                                "text": "Fokine did not mince words in describing the infamous closing moments of the ballet [L’Après-midi d’un faune], charging that Diaghilev used Nijinski as nothing more than a tool to shock his audience. He hinted that scandal was Diaghilev’s goal, for salaciousness would attract an audience."
                                            },
                                            {
                                                "example_id": "81b54703-d3b9-43b8-b3f0-198811380084",
                                                "sense_id": "fb61fe33-2776-33bb-ac51-d3e9e77bf8a0",
                                                "text": "[…] he actually used the word erotic, snagging his tongue on it as though the salaciousness of the syllables themselves was enough to arouse him […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36b2f35a-4672-441e-a5b0-b2ef06b68940",
                        "source_entry_id": "e52fed3c-2cbd-34b4-9b63-5ea73e48a2b5",
                        "target_lang_word": "lewdness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lewdness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad9ac499-a973-30e5-abaa-7a795ce62fdc",
                                        "entry_id": "b89fb53e-de65-3ae1-a481-b1294f08d26c",
                                        "glosses": [
                                            "The quality, state or instance of being lewd; promiscuous."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "356b9ea4-a0fc-420e-ac0c-a6df21ad40e2",
                                                "sense_id": "ad9ac499-a973-30e5-abaa-7a795ce62fdc",
                                                "text": "Thus thou calledst to remembrance the lewdnesse of thy youth, in bruising thy teates by the Egyptians, for the paps of thy youth."
                                            },
                                            {
                                                "example_id": "37b35cfa-1699-4ea4-b0c7-1c02181644c2",
                                                "sense_id": "ad9ac499-a973-30e5-abaa-7a795ce62fdc",
                                                "text": "Sir, Lord Hailes has forgot. There is nothing in Pryor that will excite to lewdness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
