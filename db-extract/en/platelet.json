                "senses": [
                    {
                        "sense_id": "f08eea83-ff44-3dab-ab06-afd6d616b3fc",
                        "entry_id": "3a384fc7-9da8-38eb-b801-fa4fd69d73a6",
                        "glosses": [
                            "Plaquette."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77701622-6239-4728-b592-d2d52c6db92e",
                                "sense_id": "f08eea83-ff44-3dab-ab06-afd6d616b3fc",
                                "text": "Resveratrol has been shown to induce apoptosis in platelets and smooth muscle.",
                                "translation": "On a montré que le Resvératrol pouvait induire une apoptose des plaquettes et des cellules musculaires lisses."
                            },
                            {
                                "example_id": "f3d7e1b8-01fa-48d1-9d0e-1c9f6b999844",
                                "sense_id": "f08eea83-ff44-3dab-ab06-afd6d616b3fc",
                                "text": "Our bodies still hold plenty of secrets, and scientists have just uncovered a doozy: the lungs play a key role in producing blood. Until now, this task was ascribed solely to bone marrow, but studies on mice … have found that, surprisingly, the majority of the body's platelets are produced in the lungs …"
                            }
                        ]
