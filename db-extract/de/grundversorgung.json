                ],
                "senses": [
                    {
                        "sense_id": "b2714872-81d9-3e13-98d7-c0927629340a",
                        "entry_id": "cd2c9436-fd67-390c-9e57-7cf28e6e8bc6",
                        "glosses": [
                            "Bereitstellung des Lebensnotwendigen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee53662b-2755-4d97-9108-a469cabac496",
                                "sense_id": "b2714872-81d9-3e13-98d7-c0927629340a",
                                "text": "Entwicklungsländer, wie beispielsweise Bangladesch oder Uganda, sind häufig nicht in der Lage, der gesamten Bevölkerung eine umfassende Grundversorgung zu sichern."
                            },
                            {
                                "example_id": "73d3e94d-b643-490c-8759-414d33932cc9",
                                "sense_id": "b2714872-81d9-3e13-98d7-c0927629340a",
                                "text": "„Die Länder, die der Minister in dieser Woche zuvor bereiste, Sierra Leone und Burkina Faso, haben vielfach noch mit Problemen der Grundversorgungen zu kämpfen: selten Strom, kein sauberes Wasser, schlechte Straßen und eine Jugendarbeitslosigkeit von bis zu siebzig Prozent.“"
                            },
                            {
                                "example_id": "dce07de0-a0b7-44af-8a01-8ea542f36827",
                                "sense_id": "b2714872-81d9-3e13-98d7-c0927629340a",
                                "text": "„Verbraucher in der sogenannten Grundversorgung zahlen jährlich rund 1,15 Milliarden Euro zu viel für ihre Energie.“"
                            },
                            {
                                "example_id": "6da6cf7d-f401-41df-b028-3d0706b8f53b",
                                "sense_id": "b2714872-81d9-3e13-98d7-c0927629340a",
                                "text": "„Jetzt gehe es darum, die medizinische Grundversorgung in den betroffenen Ländern durch die Ausbildung von Allgemeinpraktikern langfristig zu verbessern.“"
                            },
                            {
                                "example_id": "218e8a5f-a107-49be-a20a-ff7975657e04",
                                "sense_id": "b2714872-81d9-3e13-98d7-c0927629340a",
                                "text": "„Die Länder der Dritten Welt können sich Hightech-Medizin nicht leisten. Wie lässt sich trotzdem eine medizinische Grundversorgung sicherstellen?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
