                                "target_senses": [
                                    {
                                        "sense_id": "58691387-0b06-3b39-b198-700809b63867",
                                        "entry_id": "505783de-4b92-397a-b331-d37a19641582",
                                        "glosses": [
                                            "von geringer, meist gefühlter Temperatur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "72bd262b-7ab3-4386-91f5-dc7b6d0bdd8b",
                                                "sense_id": "58691387-0b06-3b39-b198-700809b63867",
                                                "text": "Es ist kühler geworden."
                                            },
