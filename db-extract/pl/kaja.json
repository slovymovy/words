                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e24798c-f88c-455d-bbc8-73c7cba97f33",
                                "sense_id": "236072e6-ac8f-33b3-83a5-575ada1e3119",
                                "text": "Miałem wyrzuty sumienia, że w domu zostawiam samą Kaję, ale wystarczył jej telefon… jej namawianie bym przyjechał… i rzucałem wszystko i gnałem"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
