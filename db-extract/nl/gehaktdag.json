                        "examples": [
                            {
                                "example_id": "99c1fe27-6e3e-48c1-8786-fbac14d47622",
                                "sense_id": "387b55f0-75fd-372f-9eae-14a7609a163b",
                                "text": "De Algemene Rekenkamer vindt dat niet duidelijk is wat er gebeurt met bijna anderhalf miljard euro aan uitkeringen van het rijk aan gemeenten en provincies. De Rekenkamer schrijft dat in het kader van Verantwoordingsdag, in Den Haag beter bekend als Gehaktdag."
                            },
                            {
                                "example_id": "d8c44870-6b9c-4ae3-9d42-77a3212cfe09",
                                "sense_id": "387b55f0-75fd-372f-9eae-14a7609a163b",
                                "text": "Morgen is het Verantwoordingsdag, in de volksmond: Gehaktdag. Dan biedt de president van de Algemene Rekenkamer de stukken aan aan de Tweede Kamer. Donderdag debatteert de Kamer met premier Rutte en minister De Jager van Financiën."
                            }
                        ]
