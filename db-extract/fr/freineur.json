                    {
                        "sense_id": "80a08162-3674-38a1-93b4-0d99844c9d43",
                        "entry_id": "053b2992-9b43-3104-b6b3-70835a868c91",
                        "glosses": [
                            "Ouvrier qui modère la vitesse du cayat en agissant sur un frein."
                        ],
                        "tags": [
                            "Industrie minière"
                        ],
                        "examples": [
                            {
                                "example_id": "0ab0a6f9-b7ac-45d8-a87b-36443ee1b834",
                                "sense_id": "80a08162-3674-38a1-93b4-0d99844c9d43",
                                "text": "Alors, dès qu’il y avait une berline vide à remonter, le receveur donnait le signal, la herscheuse emballait sa berline pleine, dont le poids faisait monter l’autre, quand le freineur desserrait son frein."
                            },
                            {
                                "example_id": "aa841a3c-3f41-4e59-9a1f-38c285f3701b",
                                "sense_id": "80a08162-3674-38a1-93b4-0d99844c9d43",
                                "text": "Il devenait successivement freineur, décrocheur, conducteur de treuil."
                            }
                        ]
                    }
                ],
