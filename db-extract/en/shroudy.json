                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c47013f1-60e6-4a9b-bf3c-6bda1d4f3f45",
                                "sense_id": "eeae91d9-e71d-3615-9fd3-4060a50e8feb",
                                "text": "[…] a shroudy mist, which gradually assumed an angel form, and revealed the features of my precious sister."
                            }
                        ]
                    },
                    {
                        "sense_id": "51e68276-f428-39f8-83d5-1da9a004e909",
                        "entry_id": "a1b0cd25-d322-3cba-a9d2-19b4cf8c05f5",
                        "glosses": [
                            "Affording shelter."
                        ],
                        "tags": [
                            "obsolete",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "e145cabf-11d0-4714-902f-8dbc65946b6c",
                                "sense_id": "51e68276-f428-39f8-83d5-1da9a004e909",
                                "text": "If your stray attendance be yet lodg'd\nWithin these shroudie limits.",
                                "translation": "Comus",
                                "english": "Comus"
                            },
                            {
                                "example_id": "7ed5ee1d-e0d4-4c31-8b4d-aa4bef9e91a1",
                                "sense_id": "51e68276-f428-39f8-83d5-1da9a004e909",
                                "text": "As when, within a shroudy pumice-rock / Ensconced, a shepherd hath [a swarm of] bees / Traced out, and filled it up with pungent smoke; […]"
                            },
                            {
                                "example_id": "9abcd6aa-f9cb-4a29-8852-8bf9fcfbd114",
                                "sense_id": "51e68276-f428-39f8-83d5-1da9a004e909",
                                "text": "Hence a shroudy tree is one with plenty of branches, affording shroud, or shelter."
                            }
                        ]
                    }
                ],
