                "senses": [
                    {
                        "sense_id": "773f71b5-0d69-3b91-925e-54206f1c8efd",
                        "entry_id": "ab57cd50-8e55-32cd-8940-660c364bfab5",
                        "glosses": [
                            "Fett, das bei Raumtemperatur streichfähig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1148c255-51b5-4e6d-86d0-8f6fe9ebed5e",
                                "sense_id": "773f71b5-0d69-3b91-925e-54206f1c8efd",
                                "text": "„Bei Milch, Käse und Joghurt gibt es längerfristige Verträge, nur beim Streichfett verhandeln Molkereien und Handel ihre Kontrakte monatlich neu.“"
                            },
                            {
                                "example_id": "de1ca86e-642f-42b0-8c9d-e62c3aed8856",
                                "sense_id": "773f71b5-0d69-3b91-925e-54206f1c8efd",
                                "text": "„Während die Butter als Naturprodukt immer weitgehend gleich ist, können die Hersteller in ihr Streichfett mal jenen Inhaltsstoff hineinrühren und mal andere Zusätze weglassen - ganz, wie es dem Zeitgeist entspricht.“"
                            },
                            {
                                "example_id": "afceaa6d-448b-4bd4-9354-dc8355f0731f",
                                "sense_id": "773f71b5-0d69-3b91-925e-54206f1c8efd",
                                "text": "„Die anderen schmieren sich bioaktives Streichfett unnötigerweise aufs Brot - und das, obwohl neuere Studien darauf hindeuten, dass zu viele der pflanzlichen Blutfettsenker die Arterien womöglich ähnlich verkalken lassen wie das Cholesterin selbst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
