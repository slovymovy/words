                "senses": [
                    {
                        "sense_id": "2deb8a35-8281-3b5d-bb4e-dec49e4f824b",
                        "entry_id": "be79858f-d457-33f7-a8de-4c7bda4b153e",
                        "glosses": [
                            "regelmäßiges Aufsuchen einer Schule, um unterrichtet zu werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caa1b9b1-91f7-47ce-aaa4-48ceb6a55930",
                                "sense_id": "2deb8a35-8281-3b5d-bb4e-dec49e4f824b",
                                "text": "„Sie traf auf die Schulleiterin, die Katjas Kindern erneut den Schulbesuch verweigerte.“"
                            },
                            {
                                "example_id": "e81d1469-648e-49df-8fd0-39b2fcd02822",
                                "sense_id": "2deb8a35-8281-3b5d-bb4e-dec49e4f824b",
                                "text": "„Bald wurde ich des Schulbesuchs überdrüssig, begann zu schwänzen und wanderte für gewöhnlich an den Kais entlang, um die Schiffe anzuschauen.“"
                            },
                            {
                                "example_id": "9b7c672f-b0d5-4151-8559-cd67dbd6d549",
                                "sense_id": "2deb8a35-8281-3b5d-bb4e-dec49e4f824b",
                                "text": "„Der Schulbesuch wurde abgebrochen, die deutsche Staatsangehörigkeit aufgegeben, die Verbindung zur israelischen Religionsgemeinschaft gelöst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
