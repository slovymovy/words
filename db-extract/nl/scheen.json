                                "target_senses": [
                                    {
                                        "sense_id": "8a320450-249e-3801-81be-042d7cc39925",
                                        "entry_id": "0b751563-b728-3846-b86d-448c2a1161f7",
                                        "glosses": [
                                            "Stahlträger mit speziellem Profil, der als paarig und parallel zueinander, in Spurbreite angeordneter Strang den Teil des Gleises bildet, auf dem die Räder der Schienenfahrzeuge laufen"
                                        ],
                                        "tags": [
                                            "Eisenbahntechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "510ddf32-a4ef-40b6-84d6-b6569286cd57",
                                                "sense_id": "8a320450-249e-3801-81be-042d7cc39925",
                                                "text": "Der entflohene Häftling legte seine Ketten auf die Schiene."
                                            },
                                            {
                                                "example_id": "30b4771c-22db-43bd-9d79-984258500d48",
                                                "sense_id": "8a320450-249e-3801-81be-042d7cc39925",
                                                "text": "„Die Schienen müssen mit riesigen Schraubenschlüsseln aus ihrer festgerosteten Verankerung an den Bahnschwellen gelöst, angehoben, getragen und auf die wartenden Güterwagen gewuchtet werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "582761fe-0fb1-32b0-8f6d-de8dbf7e8096",
                                        "entry_id": "0b751563-b728-3846-b86d-448c2a1161f7",
                                        "glosses": [
                                            "eine lang gestreckte Vorrichtung, die zum Beispiel der Führung von beweglichen Elementen dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca16a718-d56b-42c7-a185-f1a2b8bfbd2c",
                                                "sense_id": "582761fe-0fb1-32b0-8f6d-de8dbf7e8096",
                                                "text": "Die Gardine lässt sich über eine Schiene bewegen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "aa306bee-8b4b-3510-a9d2-f91a2d3e19b2",
                                        "entry_id": "0b751563-b728-3846-b86d-448c2a1161f7",
                                        "glosses": [
                                            "eine Vorrichtung zur Ruhigstellung von Gliedmaßen bei Knochenbrüchen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "610aa8a1-2018-4ea5-94a0-c641e0412def",
                                                "sense_id": "aa306bee-8b4b-3510-a9d2-f91a2d3e19b2",
                                                "text": "Eine Schiene musste angelegt werden, um den Knochen zu richten."
                                            },
                                            {
                                                "example_id": "27f7b188-2ba5-4ac7-aace-95c8e6473731",
                                                "sense_id": "aa306bee-8b4b-3510-a9d2-f91a2d3e19b2",
                                                "text": "„Sie umgeben eine Frau, die ihren rechten Arm in einer Schiene hochgebunden hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "15aaf520-d4c7-38b6-a02f-4c66334ff10f",
                                        "entry_id": "0b751563-b728-3846-b86d-448c2a1161f7",
                                        "glosses": [
                                            "nicht isolierte Stromleitung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1aed3710-d228-4234-a4bf-c547916ee7c8",
                                                "sense_id": "15aaf520-d4c7-38b6-a02f-4c66334ff10f",
                                                "text": "Diese Schiene wird an die Wand gedübelt und bildet später die Potentialausgleichsschiene."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
