        "fr-extract.jsonl": [
            {
                "entry_id": "7c8fe217-bfa0-3236-838d-e66837c0f5cc",
                "word": "négligemment",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9d44a7ba-d6e9-325a-8c3b-2b6fb1f376d9",
                        "entry_id": "7c8fe217-bfa0-3236-838d-e66837c0f5cc",
                        "glosses": [
                            "Avec négligence."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3acf9013-5f31-41b6-987a-e903755c39d7",
                                "sense_id": "9d44a7ba-d6e9-325a-8c3b-2b6fb1f376d9",
                                "text": "On dit qu’il [M. de Pompone] faisait un peu négligemment sa charge, que les courriers attendaient."
                            },
                            {
                                "example_id": "73be5c81-c764-466b-9593-005318a912ff",
                                "sense_id": "9d44a7ba-d6e9-325a-8c3b-2b6fb1f376d9",
                                "text": "Pendant que l’empereur Constance, occupé des affaires de l’arianisme, faisait négligemment celles de l’empire, les Perses remportèrent de grands avantages."
                            },
                            {
                                "example_id": "b8800e48-3abe-41b5-8220-ae46e329c6cf",
                                "sense_id": "9d44a7ba-d6e9-325a-8c3b-2b6fb1f376d9",
                                "text": "Il admirait l'éclat de sa beauté, la riche pourpre de sa robe longue et flottante, ses cheveux noués par-derrière négligemment mais avec grâce, le feu qui sortait de ses yeux et la douceur qui tempérait cette vivacité."
                            },
                            {
                                "example_id": "2e33a824-b5b6-49d2-a610-d0dff948ecde",
                                "sense_id": "9d44a7ba-d6e9-325a-8c3b-2b6fb1f376d9",
                                "text": "Une expérience que je proposerais à un homme de soixante-cinq ou soixante-six ans […] ce serait d’emporter avec lui dans la retraite Tacite, Suétone, Sénèque, de jeter négligemment sur le papier les choses qui l’intéresseraient […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "15de2630-2350-3527-b540-d75922257286",
                        "entry_id": "7c8fe217-bfa0-3236-838d-e66837c0f5cc",
                        "glosses": [
                            "D’un ton de négligence qui marque peu d’intérêt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4a813de-b6e0-41b6-84d2-946364dd164b",
                                "sense_id": "15de2630-2350-3527-b540-d75922257286",
                                "text": "Je lui répondrai négligemment que je crois que c’est pour supplier Sa Majesté de considérer les dépenses infinies que M. de Grignan […]"
                            },
                            {
                                "example_id": "a7826929-ca21-40a5-a05b-6707bf0c8aa5",
                                "sense_id": "15de2630-2350-3527-b540-d75922257286",
                                "text": "Puis elle ajouta négligemment : et vous, ne viendrez-vous pas aussi ?"
                            },
                            {
                                "example_id": "72f6e7b3-83c2-4896-9a8e-16d6eb6efe59",
                                "sense_id": "15de2630-2350-3527-b540-d75922257286",
                                "text": "Toutes les femmes semblent échappées d'un carême ; elles se jettent à la viande, goulues; et pleines, et repues, elles laissent négligemment échapper « qu'un rien les indigestionne. »"
                            },
                            {
                                "example_id": "4af61274-fdf1-42b0-8cd6-dc780f8bc461",
                                "sense_id": "15de2630-2350-3527-b540-d75922257286",
                                "text": "Mais Françoise ne l'écoutait plus, elle avait sorti le grand jeu : crinière rejetée en arrière, regard de serial fuckeuse, et doigt tapotant négligemment une joue fardée à la truelle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e3d40639-c201-4daf-a62a-fab56eff92ee",
                        "source_entry_id": "7c8fe217-bfa0-3236-838d-e66837c0f5cc",
                        "target_lang_word": "carelessly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carelessly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62a1532e-d3af-3548-aaf0-683c5e8d1aba",
                                        "entry_id": "1a6758ef-f5a8-3be1-98f2-60ca27a7467b",
                                        "glosses": [
                                            "Giving the appearance of carelessness; relaxedly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be8156b1-f80e-4106-a27e-65fb7b5b85c6",
                                                "sense_id": "62a1532e-d3af-3548-aaf0-683c5e8d1aba",
                                                "text": "The papers were carelessly strewn on the table."
                                            },
                                            {
                                                "example_id": "c1542fe3-8aa4-46b6-abb7-4b3840f404e0",
                                                "sense_id": "62a1532e-d3af-3548-aaf0-683c5e8d1aba",
                                                "text": "Let us try to imagine the qualms of some Fifth Avenue florist if he could but see so many potential boutonnières, at a dollar apiece, so carelessly heaped up in baskets, lining the dingy pavement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "933ce3df-1f32-3079-ac82-c5cbbba8d48e",
                                        "entry_id": "1a6758ef-f5a8-3be1-98f2-60ca27a7467b",
                                        "glosses": [
                                            "Done without care or attention; inattentively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4cd05c4-3647-4311-b5dc-962173fd5149",
                                                "sense_id": "933ce3df-1f32-3079-ac82-c5cbbba8d48e",
                                                "text": "Distracted by the salesperson, he carelessly read the contract."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d215114f-9a7d-4434-811d-dafc04b47b9e",
                        "source_entry_id": "7c8fe217-bfa0-3236-838d-e66837c0f5cc",
                        "target_lang_word": "casually",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "casually",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fea4d285-a983-3e23-9967-ec4e6d2705b2",
                                        "entry_id": "610a2907-2a61-3bfd-a20e-c7ecedcaa571",
                                        "glosses": [
                                            "In a casual manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "708e7548-5f42-4614-adf8-dab1f3d2ec1f",
                                                "sense_id": "fea4d285-a983-3e23-9967-ec4e6d2705b2",
                                                "text": "A small minority, mainly strangers, would look long at her in casually passing by, and grow momentarily fascinated by her freshness, and wonder if they would ever see her again: but to almost everybody she was a fine and picturesque country girl, and no more."
                                            },
                                            {
                                                "example_id": "8792bb94-145f-4c60-9127-c45234507751",
                                                "sense_id": "fea4d285-a983-3e23-9967-ec4e6d2705b2",
                                                "text": "\"A fine man, that Dunwody, yonder,\" commented the young captain, as they parted, and as he turned to his prisoner. \"We'll see him on in Washington some day.[…]A strong man—a strong one; and a heedless.\" ¶ \"Of what party is he?\" she inquired, as though casually."
                                            },
                                            {
                                                "example_id": "fd649d6e-0ee1-49f0-b2a3-a04cb9a53519",
                                                "sense_id": "fea4d285-a983-3e23-9967-ec4e6d2705b2",
                                                "text": "The detective kept them in view. He made his way casually along the inside of the shelter until he reached an open scuttle close to where the two men were standing talking. Eavesdropping was not a thing Larard would have practised from choice, but there were times when, in the public interest, he had to do it, and this was one of them."
                                            },
                                            {
                                                "example_id": "02902476-5026-4540-bbbf-63790e1a359b",
                                                "sense_id": "fea4d285-a983-3e23-9967-ec4e6d2705b2",
                                                "text": "He wore his strange and colourful clothes as if for inspection by a lesser being: condescendingly, casually."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ca23e73-932a-4360-a6d2-20a22bd2f33a",
                        "source_entry_id": "7c8fe217-bfa0-3236-838d-e66837c0f5cc",
                        "target_lang_word": "negligentemente",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "negligentemente",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "6fa5f9ef-0689-38d2-b063-3c6859c5198f",
                                        "entry_id": "1a279291-42de-3fff-986b-f690bcbeaf12",
                                        "glosses": [
                                            "in modo negligente, con negligenza"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08af0913-034b-4532-a5dd-796078998961",
                        "source_entry_id": "7c8fe217-bfa0-3236-838d-e66837c0f5cc",
                        "target_lang_word": "achteloos",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "achteloos",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8b3c2dcd-da56-37c8-9d68-50b3423c305a",
                                        "entry_id": "2bbc6485-5dfc-38b8-96fd-595979351e83",
                                        "glosses": [
                                            "zonder de vereiste belangstelling, zorg, achting, nadenkendheid of aandacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4cb35dd-087c-4281-943d-1be8351efd89",
                                                "sense_id": "8b3c2dcd-da56-37c8-9d68-50b3423c305a",
                                                "text": "Die achteloze jongen keek niet eens op toen hij het afval op straat gooide."
                                            },
                                            {
                                                "example_id": "a81b1bdd-ac89-4946-84b6-30f5a7951f4c",
                                                "sense_id": "8b3c2dcd-da56-37c8-9d68-50b3423c305a",
                                                "text": "De achteloze manier waarop hij zijn verlies nam was zeer bewonderenswaardig."
                                            },
                                            {
                                                "example_id": "a40560d6-ac38-477d-83b6-56da2e646c51",
                                                "sense_id": "8b3c2dcd-da56-37c8-9d68-50b3423c305a",
                                                "text": "Door een eigenaardige alchemie - misschien omdat ik me in zijn huis bevond - leek Gerry me te ontheffen van de onbewuste kleurenhiërarchie waarvan hij af en toe achteloos blijk had gegeven. Misschien was hij mijn huid wel aan het witwassen. Misschien vond hij het wel opwindend dat zijn koloniale verleden bij hem op de stoep stond. Of misschien mocht hij me gewoon. Wat het ook was, ik voelde me welkom."
                                            },
                                            {
                                                "example_id": "180303bb-a802-4934-a901-73a056b40cdf",
                                                "sense_id": "8b3c2dcd-da56-37c8-9d68-50b3423c305a",
                                                "text": "Vijf luidruchtige seconden later trok hij zijn shirt uit en achteloos wierp hij het kledingstuk in de schoot van zijn vriendin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
