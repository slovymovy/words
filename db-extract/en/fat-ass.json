                    {
                        "sense_id": "58e55a18-b4b8-3556-880e-14cf84f8e15c",
                        "entry_id": "84027d01-e745-3b25-8458-5b451af6b364",
                        "glosses": [
                            "A rotund, overweight, or obese person."
                        ],
                        "tags": [
                            "derogatory",
                            "slang",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "6fab50de-f4bb-4acf-9a8b-a5e0763341ac",
                                "sense_id": "58e55a18-b4b8-3556-880e-14cf84f8e15c",
                                "text": "He is such a fat-ass he can barely put his feet together."
                            }
                        ]
                    },
                    {
                        "sense_id": "4cd52776-7c78-39b0-808e-41bdfa83704c",
                        "entry_id": "84027d01-e745-3b25-8458-5b451af6b364",
                        "glosses": [
                            "A jibe used on someone disliked, frequently someone regarded as lazy."
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "8b291e9e-9477-479b-b204-ea2b91731064",
                                "sense_id": "4cd52776-7c78-39b0-808e-41bdfa83704c",
                                "text": "My boss is a fat-ass who doesn't know his job as well as I do."
                            },
                            {
                                "example_id": "47e68c94-aa4b-46db-a7d2-63f4fc21af9e",
                                "sense_id": "4cd52776-7c78-39b0-808e-41bdfa83704c",
                                "text": "Yes, your whole department is full of fat-asses."
                            }
                        ]
                    }
                ],
