                                        "entry_id": "08201797-4779-3f32-abae-c24d29f2c61a",
                                        "glosses": [
                                            "A document which gives details of and accompanies goods in transit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d10fe7c-fb3f-4ff8-9be7-3d73d4f0c2f2",
                                                "sense_id": "758b1ff8-7e5d-3e0f-a52c-cdc872090140",
                                                "text": "Consignment Notes should be legibly printed in type or written in ink, with the destination station shown in block letters and the responsibility for charges clearly indicated. This will help the Railways in their efforts to assist Traders."
                                            }
                                        ]
