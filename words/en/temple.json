                },
                {
                    "sense_id": "0b458048-74cc-3acd-8dfe-b160ee6a6851",
                    "sense_definition": "The flat part on each side of the forehead, between the eye and the ear.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He rubbed his <w>temples</w> to try and soothe the growing headache.",
                            "target_lang_translations": {
                                "ru": "Он потер <w>виски</w>, пытаясь унять нарастающую головную боль."
                            }
                        },
                        {
                            "text": "A thin vein was visible pulsing at his left <w>temple</w> as he spoke.",
                            "target_lang_translations": {
                                "ru": "На его левом <w>виске</w> была видна пульсирующая тонкая венка, когда он говорил."
                            }
                        }
