                ],
                "senses": [
                    {
                        "sense_id": "dc33584d-c497-3fca-a086-10e8a6158c7f",
                        "entry_id": "863886ed-ced1-3ee1-8d44-9c5c4484a405",
                        "glosses": [
                            "Nom donné aux oxydes qui contiennent la plus grande quantité possible d’oxygène."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe830120-7775-465b-bcdc-77a8ffe57c49",
                                "sense_id": "dc33584d-c497-3fca-a086-10e8a6158c7f",
                                "text": "Quant au fer, pour le doser dans le liquide contenant le l'hyposulfite et séparé de l'alumine et de l'acide phosphorique, on le peroxyde par l'acide azotique, on filtre, puis on précipite par l'ammoniac: ce qui fournit du peroxyde de fer."
                            },
                            {
                                "example_id": "19712f4c-c155-48c9-b37c-b07a9d6280cf",
                                "sense_id": "dc33584d-c497-3fca-a086-10e8a6158c7f",
                                "text": "Les produits chimiques employés pour obtenir ce résultat sont des dissolutions aqueuses de peroxydes alcalins et alcalino-terreux ; peroxyde de sodium, de potassium, de baryum, etc. …."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "223aa548-21ed-4df5-9e9d-5c0b491fa8dd",
                        "source_entry_id": "863886ed-ced1-3ee1-8d44-9c5c4484a405",
                        "source_sense_id": "dc33584d-c497-3fca-a086-10e8a6158c7f",
