                                "target_senses": [
                                    {
                                        "sense_id": "577f0733-ea22-3b1c-b5d4-57eab6a9f7e0",
                                        "entry_id": "8f14c494-11d2-3528-be6b-50ec7a48a1ad",
                                        "glosses": [
                                            "Vertreter einer zur Familie der Meerkatzenverwandten oder Hundskopfaffen gehörenden Tiergattung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a86b3e56-746c-4ab0-ac54-007a618c3b0f",
                                                "sense_id": "577f0733-ea22-3b1c-b5d4-57eab6a9f7e0",
                                                "text": "„Die Makaken […] waren früher einmal über große Teile Europas verbreitet, sogar in Süddeutschland zu Hause, und wagen sich noch heute am weitesten nach Norden sowie am höchsten in die Gebirge.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
