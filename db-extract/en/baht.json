                    {
                        "translation_id": "9227a6d5-e517-4902-bb3e-b12f6e67f364",
                        "source_entry_id": "9808ac9f-1ea2-31f3-aa63-0b42933532dc",
                        "source_sense_id": "ded347d1-a744-3c86-8c2a-96e8d6a4569c",
