                "senses": [
                    {
                        "sense_id": "c3b3d11c-3ab7-3c5d-b082-0dc41f05f397",
                        "entry_id": "e358bb71-9687-35c1-9ace-d5f300dca122",
                        "glosses": [
                            "Eigenschaft oder Handlung, die dazu führt, die Meinung, das Interesse, die Zuwendung auf sich zu ziehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92722936-ce31-43aa-805e-08a295045236",
                                "sense_id": "c3b3d11c-3ab7-3c5d-b082-0dc41f05f397",
                                "text": "„Die reizvollste Verlockung für den menschlichen Verstand stellt der Punkt am Ende des Horizonts dar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f961600e-a963-481f-9ef2-697215c18190",
                        "source_entry_id": "e358bb71-9687-35c1-9ace-d5f300dca122",
                        "source_sense_id": "c3b3d11c-3ab7-3c5d-b082-0dc41f05f397",
                        "source_sense_description": "das, was Interesse, Zuwendung auf sich zu zieht",
                        "target_lang_word": "enticement",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enticement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "11b18044-0b69-340a-9678-8dcfd5098749",
                                        "entry_id": "3c671e31-87c9-3239-93f4-a81a762a6e3c",
                                        "glosses": [
                                            "The act or practice of enticing, of alluring or tempting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b2b5ffc-da92-4e33-ae49-4fbaf2217881",
                                                "sense_id": "11b18044-0b69-340a-9678-8dcfd5098749",
                                                "text": "Suddenly on the far side of the street Rozsi and her sister passed, with little baskets on their arms. He started up, and at that moment Rozsi looked round--her face was the incarnation of enticement, the chin tilted, the lower lip thrust a little forward, her round neck curving back over her shoulder. Swithin muttered, \"Make your own arrangements--leave me out!\" and hurried from the room, leaving James beside himself with interest and alarm."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "598faa26-252c-3100-b227-23a72c219c22",
                                        "entry_id": "3c671e31-87c9-3239-93f4-a81a762a6e3c",
                                        "glosses": [
                                            "That which entices, or incites to evil; means of allurement; an alluring object."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d1f4a08-0cf0-47ef-bde9-d6071c6d8357",
                                                "sense_id": "598faa26-252c-3100-b227-23a72c219c22",
                                                "text": "None but those who have experienced them can conceive of the enticements of science."
                                            },
                                            {
                                                "example_id": "e01f17d4-7d69-4508-827e-e40433574d05",
                                                "sense_id": "598faa26-252c-3100-b227-23a72c219c22",
                                                "text": "In Persia, newly married couples were presented with sheep's trotters steeped in vinegar as a love enticement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
