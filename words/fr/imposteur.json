{
    "word_family": [
        "imposture"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "49d63548-6876-3db9-8eba-adb29cb6abd1",
                    "sense_definition": "Personne qui trompe délibérément les autres en se faisant passer pour quelqu'un d'autre ou en simulant des vertus et des compétences qu'elle n'a pas.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tromperie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La police a réussi à démasquer cet <w>imposteur</w> qui prétendait être médecin sans aucun diplôme."
                        },
                        {
                            "text": "Malgré sa brillante réussite professionnelle, elle souffre souvent du syndrome de l'<w>imposteur</w>."
                        }
                    ],
                    "synonyms": [
                        "usurpateur",
                        "hypocrite",
                        "menteur",
                        "tartufe"
                    ],
                    "common_phrases": [
                        "syndrome de l'imposteur",
                        "démasquer un imposteur"
                    ]
                },
                {
                    "sense_id": "b13eaf0a-56f9-3110-ae17-e233fa55c5e4",
                    "sense_definition": "Personne qui répand de fausses doctrines ou des croyances mensongères pour séduire le public et former une secte.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tromperie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce gourou est un dangereux <w>imposteur</w> qui manipule la crédulité de ses adeptes."
                        },
                        {
                            "text": "Le philosophe a réfuté les arguments de cet <w>imposteur</w> devant un public attentif."
                        }
                    ],
                    "synonyms": [
                        "menteur"
                    ]
                },
                {
                    "sense_id": "9dbd919d-58cb-3b18-b5e8-97ecf372418b",
                    "sense_definition": "Personne qui accuse faussement quelqu'un d'actes odieux ou préjudiciables.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "calomnie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le juge a rapidement compris que le témoin était un vil <w>imposteur</w> cherchant à nuire à son voisin."
                        },
                        {
                            "text": "Accusé à tort par cet <w>imposteur</w>, l'honnête citoyen a pu rétablir son honneur."
                        }
                    ],
                    "synonyms": [
                        "menteur"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Sens ancien équivalent à calomniateur"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c6b29ca1-5c3b-33d4-a813-e74a35e51501",
                    "sense_definition": "Qui relève de la tromperie, qui abuse par de fausses apparences.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tromperie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après l'enquête, le coupable a été dépouillé des derniers artifices de son déguisement <w>imposteur</w>."
                        },
                        {
                            "text": "Méfiez-vous de ses promesses <w>imposteuses</w> qui ne reposent sur aucun fondement sérieux."
                        }
                    ]
                }
            ]
        }
    ]
