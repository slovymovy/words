                "senses": [
                    {
                        "sense_id": "9bc44f54-c721-3626-965a-d445652dfc65",
                        "entry_id": "c71b4c61-e3a9-356f-bfa1-23b97c893463",
                        "glosses": [
                            "sicherungstechnische Ausrüstung einer zweigleisigen Strecke in einer oder beiden Richtungen, um Zugfahrten auf Hauptsignal auf beiden Streckengleisen zu ermöglichen"
                        ],
                        "tags": [
                            "Eisenbahn"
                        ],
                        "examples": [
                            {
                                "example_id": "8a3c5f23-c18a-4f84-85c5-dac15130f6b1",
                                "sense_id": "9bc44f54-c721-3626-965a-d445652dfc65",
                                "text": "„Die Strecke Ludwigsburg – Freiberg – Benningen ist in beiden Fahrtrichtungen mit Gleiswechselbetrieb ausgerüstet ….“"
                            },
                            {
                                "example_id": "b6f7fced-837e-42ca-bf82-57a92f79250f",
                                "sense_id": "9bc44f54-c721-3626-965a-d445652dfc65",
                                "text": "„Ein Signal Zs 6 – Gegengleisanzeiger am Hauptsignal, z.B. an einer Überleitstelle, zeigt dem Triebfahrzeugführer auf einer Strecke mit Gleiswechselbetrieb an, das die Fahrt ins Gegengleis führt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c634aec9-12c6-3a0d-904b-bd58b198f84b",
                        "entry_id": "c71b4c61-e3a9-356f-bfa1-23b97c893463",
                        "glosses": [
                            "Betriebsverfahren, um Züge auf Hauptsignal auf dem Gegengleis fahren zu lassen"
                        ],
                        "tags": [
                            "Eisenbahn"
                        ],
                        "examples": [
                            {
                                "example_id": "0b3c19c3-0376-4b37-a038-37aaea7eb1b6",
                                "sense_id": "c634aec9-12c6-3a0d-904b-bd58b198f84b",
                                "text": "„Ein Signal Zs 6 – Gegengleisanzeiger am Hauptsignal, z.B. an einer Überleitstelle, zeigt dem Triebfahrzeugführer auf einer Strecke mit Gleiswechselbetrieb an, das die Fahrt ins Gegengleis führt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "2b0895ae-f08d-353a-8ca1-c1f8b51168bf",
                        "entry_id": "c71b4c61-e3a9-356f-bfa1-23b97c893463",
                        "glosses": [
                            "zeitweiliger eingleisiger Betrieb auf einer zweigleisigen Strecke, wenn eines der beiden Gleise aufgrund von Bauarbeiten oder einer Störung nicht befahrbar ist"
                        ],
                        "tags": [
                            "Eisenbahn"
                        ],
                        "examples": [
                            {
