                "senses": [
                    {
                        "sense_id": "59a406ae-2dc7-3a42-8c07-183a509f18cd",
                        "entry_id": "7cec100b-df31-3c82-a801-454c53d3f567",
                        "glosses": [
                            "Faire des bisous à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a578baa-ca21-4bbb-83ad-7b9a447b5577",
                                "sense_id": "59a406ae-2dc7-3a42-8c07-183a509f18cd",
                                "text": "Il courait bisouter sa femme ou bêcher son jardin tandis que les chiens gardaient le troupeau."
                            },
                            {
                                "example_id": "e68fad70-9708-4b1c-b3c0-7963b95e6dd7",
                                "sense_id": "59a406ae-2dc7-3a42-8c07-183a509f18cd",
                                "text": "Ma femme a marié de ses élèves, et à ces mariages se fait bisouter par des moustachus qu’elle avait mis au coin."
                            }
                        ]
                    }
