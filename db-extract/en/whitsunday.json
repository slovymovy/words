                                        "examples": [
                                            {
                                                "example_id": "71c8955c-b51f-414f-9a0b-8e3047398212",
                                                "sense_id": "cf43f432-baf5-3d55-8102-15a331637f4b",
                                                "text": "Am Pfingstsonntag machten sie einen Spaziergang durch den Wald."
                                            },
                                            {
                                                "example_id": "a6218402-2a45-4873-9417-e59a38d20467",
                                                "sense_id": "cf43f432-baf5-3d55-8102-15a331637f4b",
                                                "text": "„Am Pfingstsonntag ging es hektisch zu.“"
                                            },
                                            {
                                                "example_id": "e8ebdf6f-1574-4007-b152-355965b059bd",
                                                "sense_id": "cf43f432-baf5-3d55-8102-15a331637f4b",
                                                "text": "„Da die Theater an diesem Tage, dem Pfingstsonntag, nicht geöffnet waren, bat er mich, ihn am nächsten Tag am gewohnten Ort zu treffen, wo er mir seine Schwester übergeben werde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
