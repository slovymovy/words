                    {
                        "sense_id": "b80fa3f1-dc62-37da-9fb0-f9dc150ca5b4",
                        "entry_id": "c64e6d39-9be7-33c1-bb97-e077d7e2f222",
                        "glosses": [
                            "na ja"
                        ],
                        "tags": [
