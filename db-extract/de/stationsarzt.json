                "senses": [
                    {
                        "sense_id": "0ddce95b-2ec6-306f-8d50-cba84ce39cd6",
                        "entry_id": "1bebde1c-f08d-37f6-9d08-e0029cc134f7",
                        "glosses": [
                            "Arzt, der für eine Station einer medizinischen Einrichtung zuständig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61db6013-ea60-4929-bf01-78a8b40a831c",
                                "sense_id": "0ddce95b-2ec6-306f-8d50-cba84ce39cd6",
                                "text": "Der Stationsarzt kommt heute zur Visite."
                            },
                            {
                                "example_id": "5f0ef404-19a9-4c18-8dba-fdb851a3ff21",
                                "sense_id": "0ddce95b-2ec6-306f-8d50-cba84ce39cd6",
                                "text": "Die Stationsärzte tragen eine gewisse Verantwortung."
                            },
                            {
                                "example_id": "4f64211c-79a9-4425-aa40-e87ff95167b1",
                                "sense_id": "0ddce95b-2ec6-306f-8d50-cba84ce39cd6",
                                "text": "Dem Stationsarzt sollte man immer alles gut erklären und die Wahrheit erzählen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5a776c20-e263-424d-b84d-256da3c7f9d1",
                        "source_entry_id": "1bebde1c-f08d-37f6-9d08-e0029cc134f7",
                        "source_sense_id": "0ddce95b-2ec6-306f-8d50-cba84ce39cd6",
                        "source_sense_description": "Arzt, der für eine Station einer medizinischen Einrichtung zuständig ist",
                        "target_lang_word": "ward physician",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a2892d11-3420-4dab-a6eb-a75520d2c1d2",
                        "source_entry_id": "1bebde1c-f08d-37f6-9d08-e0029cc134f7",
                        "source_sense_id": "0ddce95b-2ec6-306f-8d50-cba84ce39cd6",
                        "source_sense_description": "Arzt, der für eine Station einer medizinischen Einrichtung zuständig ist",
                        "target_lang_word": "chef de service",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chef de service",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e2375959-6693-3d25-b15e-d453d677d18e",
                                        "entry_id": "436064c7-3a6e-321e-9869-ed5993f0215a",
                                        "glosses": [
                                            "Personne chargée de la direction d’un service au sein d’une entreprise ou d’une administration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bdc821c-d20d-4540-92dc-2b3b63f32d86",
                                                "sense_id": "e2375959-6693-3d25-b15e-d453d677d18e",
                                                "text": "Non, tu ne saurais concevoir ce que la veuve d’un modeste fonctionnaire, chef de service à la Préfecture, peut donner de soins à un fils qui est tout ce qui lui reste au monde."
                                            },
                                            {
                                                "example_id": "4364101f-6f78-44d2-af76-c8ddfdb9c77c",
                                                "sense_id": "e2375959-6693-3d25-b15e-d453d677d18e",
                                                "text": "Cependant, soit par goût, soit parce qu’il avait trois enfants, il entra dans les bureaux de la Ville de Paris : il y fit une longue carrière, qu’il termina chef de service et décoré."
                                            },
                                            {
                                                "example_id": "08e0736c-5a93-4eb3-beec-79660ef6e08a",
                                                "sense_id": "e2375959-6693-3d25-b15e-d453d677d18e",
                                                "text": "Pour finir, la chef de service rappelle qu’il faut savoir prendre en compte les moyens dont on dispose dans une négociation."
                                            },
                                            {
                                                "example_id": "fd0de55b-7466-4fc1-91f1-3d6f9e355c19",
                                                "sense_id": "e2375959-6693-3d25-b15e-d453d677d18e",
                                                "text": "Le décret nᵒ 2012-32 du 9 janvier 2012 définit le statut d’emploi des emplois de chef de service et de sous-directeur des administrations de l’Etat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "362f7772-d945-49aa-aa1e-ae007f952a5c",
                        "source_entry_id": "1bebde1c-f08d-37f6-9d08-e0029cc134f7",
                        "source_sense_id": "0ddce95b-2ec6-306f-8d50-cba84ce39cd6",
                        "source_sense_description": "Arzt, der für eine Station einer medizinischen Einrichtung zuständig ist",
                        "target_lang_word": "médecin-chef",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "médecin-chef",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6dd9de8b-28ed-3b13-95ad-5955d89a7102",
                                        "entry_id": "cd96f9ac-646e-3e50-b00c-dc59963ab179",
                                        "glosses": [
                                            "Médecin homme ou femme placé à la tête du service de santé, d'un établissement, ou d'une unité militaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e306afb-9e25-4d94-80cd-45c7b8af1cd7",
                                                "sense_id": "6dd9de8b-28ed-3b13-95ad-5955d89a7102",
                                                "text": "Une médecin-chef a pris la tête du service."
                                            },
                                            {
                                                "example_id": "7749406b-696c-4a50-b293-1f35dce26b25",
                                                "sense_id": "6dd9de8b-28ed-3b13-95ad-5955d89a7102",
                                                "text": "Un médecin-chef est un médecin occupant un poste de direction dans un établissement de soins de santé, c’est-à-dire une clinique, un hôpital ou, par exemple, également dans un cabinet spécialisé ou un laboratoire. En règle générale, le médecin-chef est le médecin qui assume la responsabilité professionnelle et disciplinaire de toute une clinique. Il peut s’agir, par exemple, de la clinique chirurgicale ou de la clinique ophtalmologique d’un hôpital universitaire."
                                            },
                                            {
                                                "example_id": "132b9e94-ebd2-416e-a0ac-6ceefe4e2735",
                                                "sense_id": "6dd9de8b-28ed-3b13-95ad-5955d89a7102",
                                                "text": "Selon les médecins-chefs, il y a un lien entre l'augmentation des délais d'admission, des urgences vers les unités de soins."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "516c68cc-9a92-4812-9a64-03d35eb673b3",
                        "source_entry_id": "1bebde1c-f08d-37f6-9d08-e0029cc134f7",
                        "source_sense_id": "0ddce95b-2ec6-306f-8d50-cba84ce39cd6",
