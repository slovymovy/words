                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e239352-d2f0-4f67-9ffe-f90b5fb92d4a",
                                "sense_id": "ea407aa7-51f3-321a-8390-1e0a41326d9e",
                                "text": "W czasie II wojny światowej wprowadzono nowy typ nieśmiertelników, który z niewielkimi zmianami jest na wyposażeniu Sił Zbrojnych USA do dnia dzisiejszego"
                            }
                        ],
