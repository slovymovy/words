                                            {
                                                "example_id": "2b9e3882-3dc3-4574-a8e5-3001acc68938",
                                                "sense_id": "74bec8db-5ee2-3eb6-8278-2acbb50044d6",
                                                "text": "C’était pour lui qu’elle se limait les ongles avec un soin de ciseleur."
                                            },
                                            {
                                                "example_id": "46e1b3c4-626d-4de9-bb53-de92e21ac6b8",
                                                "sense_id": "74bec8db-5ee2-3eb6-8278-2acbb50044d6",
                                                "text": "Nous n'avons pas à faire ici la description du travail du ciseleur."
                                            },
                                            {
                                                "example_id": "740eb168-ba27-4814-b512-273b30d5f15f",
                                                "sense_id": "74bec8db-5ee2-3eb6-8278-2acbb50044d6",
                                                "text": "Le père Mabille est un ancien ciseleur qui a perdu le tour de main de son état dans l’oisiveté cruelle de la détention, et qui s’est fait marchand des rues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "332d2969-4631-3418-87dc-a9d2411b9323",
                                        "entry_id": "bd4a5e96-7194-3547-bf33-ee84b92d7f56",
                                        "glosses": [
