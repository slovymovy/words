                ],
                "senses": [
                    {
                        "sense_id": "5b1c6c55-9069-3b20-a248-acba1e0d30de",
                        "entry_id": "614f86ee-3af0-3677-b6eb-50c07e41487f",
                        "glosses": [
                            "Tee aus getrockneten Kamillenblüten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67d3f92a-1802-4905-a201-1b5f75d5ad8e",
                                "sense_id": "5b1c6c55-9069-3b20-a248-acba1e0d30de",
                                "text": "Kamillentee ist ein altes Heilmittel, das bei vielen Beschwerden Linderung verschafft."
                            },
                            {
                                "example_id": "ee43a9ac-6146-4e30-bcdc-d132c3c4a5ca",
                                "sense_id": "5b1c6c55-9069-3b20-a248-acba1e0d30de",
                                "text": "„Er kochte Kamillentee und setzte sich an den Tisch in seinem Küchenatelier.“"
                            },
                            {
                                "example_id": "c7b16eae-22e5-4d3d-bc51-f0f4b2282f9d",
                                "sense_id": "5b1c6c55-9069-3b20-a248-acba1e0d30de",
                                "text": "„Sylvia trank einen Schluck Kamillentee und meinte zu spüren, wie er die Asche von ihrer Zunge wusch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
