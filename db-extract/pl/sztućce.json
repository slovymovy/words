                                            "Küche",
                                            "Haushalt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e13205f-a7b7-42e3-b098-957cb4328075",
                                                "sense_id": "088114e2-5405-309e-be59-62b8f2accfc9",
                                                "text": "Mit sauberem Besteck schmeckt es besser."
                                            },
                                            {
                                                "example_id": "81462380-0ad9-4266-b683-6724c61c8a95",
                                                "sense_id": "088114e2-5405-309e-be59-62b8f2accfc9",
                                                "text": "„James B. Donovan legte sein Besteck fort.“"
                                            },
                                            {
                                                "example_id": "a3b8d91e-14d2-43c5-9662-1cc4ca8a05d3",
                                                "sense_id": "088114e2-5405-309e-be59-62b8f2accfc9",
                                                "text": "„Ihre Mutter hatte schon recht, sie brauchte einige Sachen, aber vor allem Kleinkram: Geschirr und Besteck.“"
                                            },
                                            {
                                                "example_id": "7d6973f8-f906-43c8-9e4a-6d304807b42c",
                                                "sense_id": "088114e2-5405-309e-be59-62b8f2accfc9",
                                                "text": "„Pétur wird auch bald kommen, sagt Ólafur, nachdem sie sich alle zu Tisch gesetzt haben, und Guđriđur dankt im Stillen der jungen Magd, als sie die dreifache Reihe von Besteck zu beiden Seiten ihres Tellers sieht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c67532fc-a6e7-311d-87eb-655c0306a361",
                                        "entry_id": "85fe83db-549e-33ea-9b9e-fa51a3dac0ac",
                                        "glosses": [
