                                    {
                                        "sense_id": "7a4f4505-8213-39a2-a2ef-115e291cfcb9",
                                        "entry_id": "f034cdf8-61c4-34ab-ad2f-f57f8075d9d6",
                                        "glosses": [
                                            "so, dass es bedurft wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7421098e-6fdc-44f0-9191-5518f6abc970",
                                                "sense_id": "7a4f4505-8213-39a2-a2ef-115e291cfcb9",
                                                "text": "Ziel dieser Aktion ist das Streben nach Hilfe für bedürftige Menschen."
                                            },
                                            {
                                                "example_id": "06da7b43-df10-4424-839f-b34d2487228c",
                                                "sense_id": "7a4f4505-8213-39a2-a2ef-115e291cfcb9",
                                                "text": "Bettlägerige Personen sind der Hilfe und Versorgung durch andere, zumeist auch der Pflege bedürftig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
