                    {
                        "sense_id": "807b9a8e-fbc0-3d7a-97df-b7aaf8126ac4",
                        "entry_id": "477cca06-66ea-3a9d-ac80-b52447714b78",
                        "glosses": [
                            "eine Person, die Angelegenheiten meist schlicht und einfach – mit minimalen Ansprüchen – erledigt"
                        ],
                        "tags": [
                            "generell"
                        ],
                        "examples": [
                            {
                                "example_id": "b914744e-2543-4ac2-a2c8-27b49c0cc521",
                                "sense_id": "807b9a8e-fbc0-3d7a-97df-b7aaf8126ac4",
                                "text": "Er behauptet von sich, er sei ein Minimalist. Ich sage er ist einfach nur faul."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f50383c0-758f-310d-85b6-fe9172e5bc6b",
                        "entry_id": "477cca06-66ea-3a9d-ac80-b52447714b78",
