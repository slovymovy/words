                                "target_lang_sense_clarification": "своими силами"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "indépendamment",
                                "target_lang_sense_clarification": "sans être soumis à une autorité"
                            },
                            {
                                "target_lang_word": "de manière autonome",
                                "target_lang_sense_clarification": "par ses propres moyens"
                            }
                        ]
                    }
