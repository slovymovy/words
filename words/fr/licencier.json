    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c6e0e047-914a-31cb-b48e-b1ffb5a4326b",
                    "sense_definition": "Résilier le contrat de travail d'un salarié ; renvoyer une personne de son emploi.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "travail",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La direction a dû <w>licencier</w> dix personnes à cause des difficultés financières."
                        },
                        {
                            "text": "L'employeur ne peut pas <w>licencier</w> un salarié sans respecter une procédure légale stricte."
                        }
                    ],
                    "synonyms": [
                        "congédier",
                        "renvoyer",
                        "limoger"
                    ],
                    "antonyms": [
                        "embaucher",
                        "recruter",
                        "engager"
                    ],
                    "common_phrases": [
                        "licencier un salarié",
                        "licencier pour motif économique",
                        "licencier pour faute grave"
                    ]
                },
                {
                    "sense_id": "e54bdf28-d1d1-3e44-86c8-ada1ced5d2fb",
                    "sense_definition": "S'inscrire et obtenir une licence auprès d'une fédération ou d'une association sportive ou culturelle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a décidé de se <w>licencier</w> dans le club de football de sa ville natale."
                        },
                        {
                            "text": "Chaque athlète doit se <w>licencier</w> avant de pouvoir participer aux compétitions régionales."
                        }
                    ],
                    "synonyms": [
                        "adhérer",
                        "s'inscrire"
                    ],
                    "common_phrases": [
                        "se licencier dans un club",
                        "se licencier auprès d'une fédération"
                    ]
                },
                {
                    "sense_id": "3e75fb23-ec1e-3521-9fe7-40a957add5be",
                    "sense_definition": "Accorder à un tiers une licence d'exploitation ou de commercialisation pour une marque, un brevet ou une technologie.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'inventeur a choisi de <w>licencier</w> son brevet à un fabricant international."
                        },
                        {
                            "text": "Le studio préfère <w>licencier</w> ses personnages pour la création de produits dérivés."
                        }
                    ],
                    "synonyms": [
                        "céder"
                    ],
                    "common_phrases": [
                        "licencier une marque",
                        "licencier un brevet",
                        "licencier une technologie"
                    ]
                },
                {
                    "sense_id": "80008933-a383-38bc-8100-891a8909820f",
                    "sense_definition": "Renvoyer ou dissoudre des troupes militaires.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après la signature du traité de paix, le général dut <w>licencier</w> l'armée irrégulière."
                        },
                        {
                            "text": "Le souverain décida de <w>licencier</w> les mercenaires devenus inutiles et trop coûteux."
                        }
                    ],
                    "synonyms": [
                        "démobiliser",
                        "dissoudre"
                    ],
                    "antonyms": [
                        "mobiliser",
                        "enrôler"
                    ],
                    "common_phrases": [
                        "licencier des troupes",
                        "licencier une armée"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "terme principalement historique dans le domaine militaire"
                        }
                    ]
                }
            ]
