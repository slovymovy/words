                                "text": "Nudyści opalają się nago."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "17d0d4bb-e0e3-3357-9990-708430d40208",
                        "entry_id": "9be394d6-a61a-3b53-ae30-5bed012941b5",
                        "glosses": [
                            "bez dekoracji, zdobień"
                        ],
