                    },
                    {
                        "translation_id": "a054a637-0b2a-4e42-b7a4-465327ebd51e",
                        "source_entry_id": "6f144bc0-95f4-3cbd-acb0-bdfdb9334789",
                        "source_sense_id": "a02ff97d-d10c-3842-84f1-4b5079609823",
                        "target_lang_word": "porridge",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "porridge",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bed208ac-0d27-3fec-9168-92f133792785",
                                        "entry_id": "2fcc94c6-92b8-3e88-a6f2-e6a8a6255b2c",
                                        "glosses": [
                                            "Bouillie de flocons d’avoine ou de maïs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0995ce90-59fb-4332-933a-109fea37020b",
                                                "sense_id": "bed208ac-0d27-3fec-9168-92f133792785",
                                                "text": "J’entrai sans frapper et le trouvai assis avec son Indien, devant un bol de porridge au maïs et au lait. L’intérieur de la maison était propre et nu ; quelques livres sur un rayon en faisaient le seul ornement."
                                            },
                                            {
                                                "example_id": "8539b9dd-9f2f-4496-9dc4-ebaeaa3cdc08",
                                                "sense_id": "bed208ac-0d27-3fec-9168-92f133792785",
                                                "text": "Au petit déjeuner, j’eus à nouveau du paprika, ainsi qu’une espèce de porridge fait de farine de maïs qu’on appelle mamaliga, et d’aubergines farcies — plat excellent qui porte le nom de impletata."
                                            },
                                            {
                                                "example_id": "e43f94ee-08d4-4288-889c-ad5380f395e4",
                                                "sense_id": "bed208ac-0d27-3fec-9168-92f133792785",
                                                "text": "J'essaie bien de cuire du porridge sur le réchaud à cadran^([sic : cardan]), mais une vague plus forte envoie le porridge se coller au plafond et aux parois du poste."
                                            },
                                            {
                                                "example_id": "88812f12-4614-4e93-beb1-046106e8a3ff",
                                                "sense_id": "bed208ac-0d27-3fec-9168-92f133792785",
                                                "text": "En attendant que le porridge refroidisse…"
                                            },
                                            {
                                                "example_id": "99bc6d1a-286a-465b-bb8d-a5a16f0501bf",
                                                "sense_id": "bed208ac-0d27-3fec-9168-92f133792785",
                                                "text": "Les jours de fête, il pouvait se régaler de beurre, de viande ou d’un porridge aux œufs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "585c324e-ede3-4527-8855-fa9f4de77bc4",
                        "source_entry_id": "6f144bc0-95f4-3cbd-acb0-bdfdb9334789",
                        "source_sense_id": "a02ff97d-d10c-3842-84f1-4b5079609823",
                        "target_lang_word": "bouillie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bouillie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8623665b-4286-3b66-8732-5e89569c9276",
                                        "entry_id": "5f130ba0-611c-36e5-a6bd-853e3b408b20",
                                        "glosses": [
                                            "Féminin singulier de bouilli."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bouillie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d6436626-aed8-3c8f-8703-d35b29866777",
                                        "entry_id": "433501e4-da3a-3de6-b172-659069a9605d",
                                        "glosses": [
                                            "Participe passé féminin singulier de bouillir."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3a0734c-b927-42ec-a552-eb99038d0c24",
                                                "sense_id": "d6436626-aed8-3c8f-8703-d35b29866777",
                                                "text": "Je ne vous donnerai pas de vin : nous n’en avons pas, mais de l’eau bouillie et rebouillie."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bouillie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "434d5cc7-6f22-3156-9446-bebc70f9d399",
                                        "entry_id": "125732b6-c25e-395a-957a-15e0977f8263",
                                        "glosses": [
                                            "Sorte d’aliment qui est fait de lait ou d’un autre liquide et de farine bouillis ensemble jusqu’à une certaine consistance et qu’on donne ordinairement aux petits enfants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ac51b99-7461-486f-8689-90c41562c238",
                                                "sense_id": "434d5cc7-6f22-3156-9446-bebc70f9d399",
                                                "text": "La laitière s’en va faire la bouillie à ses moutards, traire ses vaches, chercher de l’herbe pour ses lapins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e70a7ca5-1278-38a9-a165-5a75c92f65c5",
                                        "entry_id": "125732b6-c25e-395a-957a-15e0977f8263",
                                        "glosses": [
                                            "Façon de s'exprimer confuse et peu articulée."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63abb89b-c279-4f52-bc24-13af0beb4d9e",
                                                "sense_id": "e70a7ca5-1278-38a9-a165-5a75c92f65c5",
                                                "text": "Il avait dans la bouche, en parlant, une bouillie qui était adorable parce qu’on sentait qu’elle trahissait moins un défaut de la langue qu’une qualité de l’âme, comme un reste de l’innocence du premier âge qu’il n’avait jamais perdue."
                                            },
                                            {
                                                "example_id": "4232262b-6a2a-4c17-bdf4-32c5eb170c11",
                                                "sense_id": "e70a7ca5-1278-38a9-a165-5a75c92f65c5",
                                                "text": "— Consterné par la pénurie de ces désolantes rengaines, Durtal se jetait dans les monographies moins connues des Bienheureuses ; mais là encore, quelle barigoule de lieux communs, quelle colle d’onction, quelle bouillie de style !"
                                            },
                                            {
                                                "example_id": "59cb953f-764c-466b-aabd-dada2be48109",
                                                "sense_id": "e70a7ca5-1278-38a9-a165-5a75c92f65c5",
                                                "text": "Je peux penser à des choses assez clairement, mais quand faut que j'essaie de les dire ou de les écrire, c'est de la bouillie qui sort, ou un truc de ce genre"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6a0a9d7-6744-3305-80c2-712c606f7962",
                                        "entry_id": "125732b6-c25e-395a-957a-15e0977f8263",
                                        "glosses": [
                                            "Chiffons bouillis et réduits en pâte liquide avec lesquels se fabriquaient le papier et le carton."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8b3df991-5425-3d61-84ca-1beb83a401bc",
                                        "entry_id": "125732b6-c25e-395a-957a-15e0977f8263",
                                        "glosses": [
                                            "Tous mélanges pâteux même obtenus à froid."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a5056fa-5d03-4c4f-baba-8d63fcdf7677",
                                                "sense_id": "8b3df991-5425-3d61-84ca-1beb83a401bc",
                                                "text": "Les bouillies et les poudres à base de S.P.C. et de D.D.T. ont une action ovicide très nette et sont, de ce fait, utilisées dans la lutte contre de nombreux insectes et particulièrement contre l’anthonome du poirier et celui du pommier."
                                            },
                                            {
                                                "example_id": "f63020ef-1a43-4e05-a8a8-4aae81805d9e",
                                                "sense_id": "8b3df991-5425-3d61-84ca-1beb83a401bc",
                                                "text": "Les produits à base d’iodosulfuron et de mésosulfuron-méthyl-sodium sont également dégradés à pH acide. Il convient donc d’être prudent et de s’abstenir de modifier les caractéristiques de pH de la bouillie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbf846cf-aa60-31eb-aac3-98c8401890dc",
                                        "entry_id": "125732b6-c25e-395a-957a-15e0977f8263",
                                        "glosses": [
                                            "Bouillie bordelaise ou bouillie bourguignonne."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fee1a69-913e-4047-85dc-08999668f614",
