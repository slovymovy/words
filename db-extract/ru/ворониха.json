                "senses": [
                    {
                        "sense_id": "6a3a6e5a-150a-381e-b890-2109677c089e",
                        "entry_id": "1f32dc15-4d47-3598-8b1e-6fe4c9cbbe49",
                        "glosses": [
                            "разг. самка во́рона"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4909e155-6cdc-4ba4-8d04-db1e1f417627",
                                "sense_id": "6a3a6e5a-150a-381e-b890-2109677c089e",
                                "text": "На дубу сидел старый ворон и каркал протяжно. Этот ворон был в сущности ворониха .."
                            },
                            {
                                "example_id": "29746b8d-307a-42b9-a95c-5b65754bfc42",
                                "sense_id": "6a3a6e5a-150a-381e-b890-2109677c089e",
                                "text": "Самка во́рона первою из всех птиц снесла яйцо. Её гнездо — на высокой ели, густо засыпанной снегом. Чтобы яйцо не застыло и птенчик в нём не замёрз, ворониха не оставляет гнезда. Пищу ей приносит ворон."
                            }
                        ]
                    }
