                    {
                        "sense_id": "ad012fd6-9ed5-3614-8e93-8bd9ad5988a9",
                        "entry_id": "e6b381dd-85c1-36e1-ad58-dae32bcbd830",
                        "glosses": [
                            "jemand, der gemeinsam mit anderen Mitbewerbern zum Kreis der Favoriten gehört"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18e77d05-4dc9-4b31-9f01-4fa2090a1408",
                                "sense_id": "ad012fd6-9ed5-3614-8e93-8bd9ad5988a9",
                                "text": "„Der schwedische Mitfavorit Andre Myhrer wurde nach oberster erster Bestzeit und einem Ausflug in die finnischen Wälder disqualifiziert.“"
                            },
                            {
                                "example_id": "e3b77d21-c659-4729-9c96-9bf523ff149e",
                                "sense_id": "ad012fd6-9ed5-3614-8e93-8bd9ad5988a9",
                                "text": "„Fünf Tage nach seinem 32. Geburtstag könnte Abraham die 42,195 Kilometer mitten in der Zürcher Innenstadt als Mitfavorit in Angriff nehmen, denn 2013 lief kein Europäer schneller als der Eritreer, der im Frühling den Zürich-Marathon in 2:07:45 Stunden gewann (Röthlins Schweizer Rekord von 2:07:23 stammt von 2008).“"
                            },
                            {
                                "example_id": "42ef7ae6-bee3-456a-b031-1e7d14cae9e3",
                                "sense_id": "ad012fd6-9ed5-3614-8e93-8bd9ad5988a9",
                                "text": "„Seine Fußballer hatten soeben ein 2:2 gegen Mitfavorit Mexiko erkämpft, den Goldmedaillengewinner von London 2012.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
