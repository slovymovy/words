                "senses": [
                    {
                        "sense_id": "67b59922-b7a8-3bcb-961e-2ee8e49d715d",
                        "entry_id": "b98c3038-cb89-38be-8154-99f87ec6b287",
                        "glosses": [
                            "een brede, gekleurde band die vaak gedragen wordt als een waardigheidsteken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e56d08e-f667-4b51-ad94-5d63a702efd8",
                                "sense_id": "67b59922-b7a8-3bcb-961e-2ee8e49d715d",
                                "text": "Wordt Mathias De Clercq (Open VLD) burgemeester in 2018, dan stopt hij als parlementslid. Maar als hij de sjerp niet verovert, zal hij zich op de nationale politiek richten en Gent aan andere liberalen overlaten. De Clercq laat zijn lokale politieke carrière dus afhangen van de verkiezingsuitslag."
                            },
                            {
                                "example_id": "f8d79369-72a5-4cae-bb9d-9b9991244a39",
                                "sense_id": "67b59922-b7a8-3bcb-961e-2ee8e49d715d",
                                "text": "Fractievoorzitter Marianne Thieme (PvdD) koos voor een sjerp van het vrouwenkiesrecht en liet een afbeelding van Emmeline Pankhurst op haar strakke jurk printen. Pankhurst richtte in het verleden de Britse beweging voor vrouwenkiesrecht op."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc7e6a6f-be2d-4fa5-a803-fe99e9501029",
                        "source_entry_id": "b98c3038-cb89-38be-8154-99f87ec6b287",
                        "source_sense_id": "67b59922-b7a8-3bcb-961e-2ee8e49d715d",
