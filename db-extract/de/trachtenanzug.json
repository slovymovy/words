                            {
                                "example_id": "19800ddd-2df9-408e-8a8c-72106e52a5e6",
                                "sense_id": "bc814737-5bcd-3928-a29f-fb333fef80eb",
                                "text": "„Als junger Abgeordneter hielt ich in den Dörfern des westlichen Landkreises von Fürstenfeldbruck Bauernversammlungen im Trachtenanzug.“"
                            },
                            {
                                "example_id": "86db11cb-fccb-4170-b226-5637daef4d7e",
                                "sense_id": "bc814737-5bcd-3928-a29f-fb333fef80eb",
                                "text": "„Wer sieht sich auch schon gern einen Trachtenanzug an, bei dem immer nur das gleiche Kostüm in schlichtem Erdbraun zur Darbietung gelangt?“"
                            }
                        ],
