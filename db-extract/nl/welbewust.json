                                "target_senses": [
                                    {
                                        "sense_id": "bcc12e07-4516-3982-80e9-c46bb6940df2",
                                        "entry_id": "0117158a-114e-3b46-b1a2-d2c117d44364",
                                        "glosses": [
                                            "Vigilant or on one's guard against danger or difficulty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8441d68-1b3e-4e04-ade9-d9ad368287bb",
                                                "sense_id": "bcc12e07-4516-3982-80e9-c46bb6940df2",
                                                "text": "Stay aware! Don't let your guard down."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bf18e19-0b04-3ce1-9f7e-48b808d5ca92",
                                        "entry_id": "0117158a-114e-3b46-b1a2-d2c117d44364",
                                        "glosses": [
                                            "Conscious or having knowledge of something; awake."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ab60196-25b3-4fd3-9d1a-175ad94c0c7e",
                                                "sense_id": "7bf18e19-0b04-3ce1-9f7e-48b808d5ca92",
                                                "text": "Are you aware of what is being said about you?"
                                            },
                                            {
                                                "example_id": "2170fe08-3d9c-4165-92f2-53c5b39c20c3",
                                                "sense_id": "7bf18e19-0b04-3ce1-9f7e-48b808d5ca92",
                                                "text": "Gotta get going. I wasn’t aware that it was already so late."
                                            },
                                            {
                                                "example_id": "439c9305-d42e-4963-a1fe-16116f4f3125",
                                                "sense_id": "7bf18e19-0b04-3ce1-9f7e-48b808d5ca92",
                                                "text": "“[…] This is Mr. Churchill, who, as you are aware, is good enough to come to us for his diaconate, and, as we hope, for much longer; and being a gentleman of independent means, he declines to take any payment.” Saying this Walden rubbed his hands together and smiled contentedly."
                                            },
                                            {
                                                "example_id": "eced49ee-16b7-4369-b0a7-73468e153ce5",
                                                "sense_id": "7bf18e19-0b04-3ce1-9f7e-48b808d5ca92",
                                                "text": "The guard was paying no attention whatever to the running of his train, in total disregard of rules, and, as the recently-published report of a Ministry of Transport Inspecting Officer of Railways shows, there were other disquieting features in the case, such as ignorance on the part of responsible men of rules and appendix instructions and a lax attitude to regulations of which they professed to be aware, combined with failure to look at staff notice boards."
                                            },
                                            {
                                                "example_id": "2e59e536-8166-49f9-802e-442eeef54df7",
                                                "sense_id": "7bf18e19-0b04-3ce1-9f7e-48b808d5ca92",
                                                "text": "Americans are not libertarians in the Cato Institute sense of the word, but they are folk libertarians in this sense of impulsive behaviour, which is a feature of American life that anyone who wants to govern the United States, Democratic or Republican, has to be aware of."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aware",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c13b1c8-adb7-3288-a4ce-588551a617cc",
                                        "entry_id": "9218d671-6c0c-3c2f-bc43-3c4fb69e6b32",
                                        "glosses": [
                                            "To make (someone) aware of something."
                                        ],
                                        "tags": [
                                            "nonstandard",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3747b870-104d-4283-88f7-88ac87b32ac0",
                                                "sense_id": "2c13b1c8-adb7-3288-a4ce-588551a617cc",
                                                "text": "Conſcience is the director of all our actions, and diſcriminates them all, with the intentions of our hearts; awares us of the crime of the one, and the virtue of the other."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
