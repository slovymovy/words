                        "glosses": [
                            "Objet permettant de débrediner. En particulier on nomme ainsi une ouverture pratiquée dans le sarcophage d'un saint pour y passer la tête."
                        ],
                        "tags": [
                            "Bourbonnais"
                        ],
                        "examples": [
                            {
                                "example_id": "71c20494-4b49-4964-908b-1dfa0251463b",
                                "sense_id": "f67518ea-c414-3a38-9323-db704b9ad90b",
                                "text": "La débredinoire désigne le sarcophage de saint Menoux (ou saint Menulphe) situé en l’église Saint-Menoux de Saint-Menoux (Allier)"
                            },
                            {
                                "example_id": "b7b2adb7-9e99-4ae6-9916-78543c3dd944",
                                "sense_id": "f67518ea-c414-3a38-9323-db704b9ad90b",
                                "text": "Aux étrangers, baigneurs ou touristes, qui viennent en nos parages, on ne manque pas de proposer un voyage à Saint-Menoux et une visite à la débredinoire !"
                            }
                        ]
                    }
