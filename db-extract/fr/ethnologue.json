                                        "sense_id": "d028e491-958f-34b9-93cc-83e91e974f5e",
                                        "entry_id": "896c6bca-975d-3a79-8a84-0494c32ab42b",
                                        "glosses": [
                                            "Wissenschaftlerin, die sich mit der Ethnologie (Völkerkunde) beschäftigt"
                                        ],
                                        "tags": [],
