                ],
                "senses": [
                    {
                        "sense_id": "8989d8a0-6040-3d99-8206-27dfb6fd589d",
                        "entry_id": "f509849b-342b-3204-a707-cba2895bbdfd",
                        "glosses": [
                            "с.-х. длинная куча корнеплодов трапецеидального сечения, сложенная на земле и укрытая для длительного хранения; бурт"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "198a594e-f1ac-47ff-b4b6-98256de70db1",
                                "sense_id": "8989d8a0-6040-3d99-8206-27dfb6fd589d",
                                "text": "Угрюмый, в кирзачи обутый председатель сельского Совета встретил нас и проводил к кагатам — траншеям за селом, засыпанным картофелем, откуда мы быстренько и загрузили кузов машины…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b0e79c9-21fe-4be7-81ed-cd2959e3af22",
                        "source_entry_id": "f509849b-342b-3204-a707-cba2895bbdfd",
                        "source_sense_id": "8989d8a0-6040-3d99-8206-27dfb6fd589d",
                        "target_lang_word": "ammasso di tuberi",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2699c6eb-72ec-40ea-983d-16d694507981",
                        "source_entry_id": "f509849b-342b-3204-a707-cba2895bbdfd",
                        "source_sense_id": "8989d8a0-6040-3d99-8206-27dfb6fd589d",
                        "target_lang_word": "Miete",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Miete",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "30de5006-ef99-3caf-847a-2aa121edc7d4",
                                        "entry_id": "6e0cc6c1-ffa6-39db-9448-e96f7a9dae49",
                                        "glosses": [
                                            "das zu zahlende Entgelt für die (zeitweilige) Nutzung beziehungsweise Überlassung bestimmter Einrichtungen (vor allem Wohnungen oder Ähnlichem), Gegenständen oder (veraltet) Dienstleistungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e78b5a79-c415-4f67-839a-83d5b45fb9b3",
                                                "sense_id": "30de5006-ef99-3caf-847a-2aa121edc7d4",
                                                "text": "Wir zahlen monatlich 1200 Euro Miete."
                                            },
                                            {
                                                "example_id": "77a494e8-8d1d-4593-a720-280464ace2e3",
                                                "sense_id": "30de5006-ef99-3caf-847a-2aa121edc7d4",
                                                "text": "Die Miete für diese Wohnung beträgt 750 Euro."
                                            },
                                            {
                                                "example_id": "8e884400-1d89-456d-a9ba-8f2dffbd30d7",
                                                "sense_id": "30de5006-ef99-3caf-847a-2aa121edc7d4",
                                                "text": "„Der Grund und Boden der Großstädte, namentlich Londons, gehört einigen Lords, die aus den überfüllten Häusern der Lumpenviertel höhere Mieten herausschlagen als aus den Palästen der feinsten Stadtteile. Denn hier wohnen ja auf jedem Acre hundertmal mehr Menschen als in den vornehmen Gegenden, die Instandhaltung der jämmerlichen Baracken kostet fast nichts, und die Mieten sind unverschämt hoch. Was diese Elenden mit Kohlenladen, Lumpensammeln, Streichhölzchenverkauf, Stehlen und Huren mühselig zusammenkratzen, davon nimmt der Landlord den größten Teil hinweg als Miete für die Schmutzlöcher, in denen sie hausen.“"
                                            },
                                            {
                                                "example_id": "12e22500-6006-4a39-8e1c-3b4a77dc9036",
                                                "sense_id": "30de5006-ef99-3caf-847a-2aa121edc7d4",
                                                "text": "„So habe sie eine Bekannte gehabt, bei der hätten nur Huren gewohnt, doch die wären peinlich pünktlich mit der Miete gewesen und hätten die Möbel schon sehr geschont, sauber und akkurat.“"
                                            },
                                            {
                                                "example_id": "f47a23cb-c7fb-40ed-9703-6ad8cef705cf",
                                                "sense_id": "30de5006-ef99-3caf-847a-2aa121edc7d4",
                                                "text": "„Die Mieten steigen ständig.“"
                                            },
                                            {
                                                "example_id": "6488ab24-3e46-41ba-897b-de14c77ff213",
                                                "sense_id": "30de5006-ef99-3caf-847a-2aa121edc7d4",
                                                "text": "„Die Miete konnte er sich auch leisten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7c59092c-0737-3121-bb79-f60bd19c121f",
                                        "entry_id": "6e0cc6c1-ffa6-39db-9448-e96f7a9dae49",
                                        "glosses": [
                                            "entgeltliche (zeitweilige) Nutzung beziehungsweise Überlassung des Gebrauchs einer Einrichtung, eines Gegenstandes oder (veraltet) einer Dienstleistung"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08073665-9e78-4b6f-bc91-fb761f03f236",
                                                "sense_id": "7c59092c-0737-3121-bb79-f60bd19c121f",
                                                "text": "„Mir ist es oft lästig, daß ich Fräulein Montag in Miete habe, Fräulein Bürstner aber nimmt sie sogar zu sich ins Zimmer.“"
                                            },
                                            {
                                                "example_id": "ceaeb585-5979-428d-bb5e-f5e53deac355",
                                                "sense_id": "7c59092c-0737-3121-bb79-f60bd19c121f",
                                                "text": "„Bei der Abgrenzung von Miete und Pacht ist zu beachten, dass Gegenstand eines Mietvertrages allein bewegliche und unbewegliche Sachen, Sachteile und Sachgesamtheiten sein können, während Rechte als Gegenstand eines Mietvertrages ausscheiden […].“"
                                            },
                                            {
                                                "example_id": "530248fe-0d42-440d-b2e5-b89f5ed78df5",
                                                "sense_id": "7c59092c-0737-3121-bb79-f60bd19c121f",
                                                "text": "„Man ermittle anhand der Kapitalwerte, ob Kauf günstiger als Miete ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Miete",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e00d6256-26ee-3d9d-8657-312da026d6da",
                                        "entry_id": "02c3799f-16a9-3980-bcb8-6ae18aeba4b0",
                                        "glosses": [
                                            "eine Milbe"
                                        ],
                                        "tags": [
                                            "Insekten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b3d019c-406c-4dec-bb6d-3d43e3144314",
                                                "sense_id": "e00d6256-26ee-3d9d-8657-312da026d6da",
                                                "text": "Im Zimmer sind Mieten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Miete",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "62d9f4cc-4f51-3dbe-b38e-3a3c8994dc2e",
                                        "entry_id": "cdca6f0b-f1b7-3c9d-a852-48d40b42286f",
                                        "glosses": [
                                            "Stapel von Feldfrüchten oder dergleichen, der winters als Schutz vor ungünstiger Witterung, vor allem als Frostschutz, in einer flachen, hoch mit Erde und Stroh bedeckten Grube angelegt wird"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2193f6dc-c0ba-4429-83bb-f12c715adfb1",
                                                "sense_id": "62d9f4cc-4f51-3dbe-b38e-3a3c8994dc2e",
                                                "text": "„‚Ende November schon?‘ ‚Später kommt mir der Frost in die Mieten, wenn ich sie noch einmal öffne.‘“"
                                            },
                                            {
                                                "example_id": "1b33b3f6-3d86-4883-b511-64a7c7c7cf21",
                                                "sense_id": "62d9f4cc-4f51-3dbe-b38e-3a3c8994dc2e",
                                                "text": "„Nicht zu ersetzen sind demgegenüber",
                                                "translation": "– Schäden an Rüben- oder Kartoffelmieten, Rundballen, die auf dem Feld gelagert werden, oder an Silagehaufen, da mit der Einlagerung, z.B. in der Miete, die Früchte eingeerntet sind;[…]“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b7ba69c0-ac3f-3cf2-88e0-4a2611dcab1e",
                                        "entry_id": "cdca6f0b-f1b7-3c9d-a852-48d40b42286f",
                                        "glosses": [
                                            "großer Haufen von Heu, Stroh, Getreide oder Holz, der im Freien in Schichten übereinandergelegt wird"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e68f88c-4061-4908-957c-f65bf131b916",
                                                "sense_id": "b7ba69c0-ac3f-3cf2-88e0-4a2611dcab1e",
                                                "text": "„Die Grundherren haben sich geweigert, mehr als eine Scheune auf der Farm zu bauen, die Pächter gewannen allmählich reichere Ernten, — sie mußten das Getreide in Mieten setzen.“"
                                            },
                                            {
                                                "example_id": "a771edc0-b625-4ba6-87eb-86ce17c06ab5",
                                                "sense_id": "b7ba69c0-ac3f-3cf2-88e0-4a2611dcab1e",
                                                "text": "„Wir mußten lernen, den Torf in gleichmäßigen Stücken zu stechen, also gerade, nicht schräg, damit wir aus den Stücken nachher Mieten setzen konnten, die hielten, ähnlich Holzmieten aus gespaltenem Holz. Das Bauen der Mieten war ebenfalls eine komplizierte Arbeit, schwer zu lernen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3816788f-5e7e-3f18-8e25-16ae751208af",
                                        "entry_id": "cdca6f0b-f1b7-3c9d-a852-48d40b42286f",
                                        "glosses": [
                                            "zusammengerechter beziehungsweise aufgeschichteter Haufen von Heu"
                                        ],
                                        "tags": [
                                            "Südafrika"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
