                    "frequency": "High",
                    "semantic_group_id": "insistence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rodzice <w>nalegali</w>, żebym skończył studia prawnicze.",
                            "target_lang_translations": {
