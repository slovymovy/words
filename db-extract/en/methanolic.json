                "senses": [
                    {
                        "sense_id": "fc5cac6d-c2f7-3896-b66f-429dee4b6564",
                        "entry_id": "52c565cf-3e89-31ed-b880-71d817aeaff3",
                        "glosses": [
                            "Submersed or dissolved in, or obtained with the use of methanol."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "ff934c12-e22f-4c0c-a1ad-7c562e3b1ebd",
                                "sense_id": "fc5cac6d-c2f7-3896-b66f-429dee4b6564",
                                "text": "The catalyst solution (0.5M methanolic sodium methoxide) is made by dissolving dry sodium in anhydrous methanol and is stable for several months."
                            },
                            {
                                "example_id": "0c466b80-c105-4496-b07d-65b4bd316214",
                                "sense_id": "fc5cac6d-c2f7-3896-b66f-429dee4b6564",
                                "text": "In the case Anabaena fertilissima only two extracts i.e. methanolic and ethyl acetate extracts were found active as compared to previously studied Anabaena variabilis."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
