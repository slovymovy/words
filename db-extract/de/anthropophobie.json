                        ],
                        "examples": [
                            {
                                "example_id": "7455141d-1f37-4df0-b7f6-73c0892b74b0",
                                "sense_id": "abdec7fe-7bbd-398c-8e79-1a379c6900f1",
                                "text": "Anthropophobie kann die Betroffenen lebensuntüchtig machen."
