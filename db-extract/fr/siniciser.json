                        "tags": [],
                        "examples": [
                            {
                                "example_id": "127e5109-dd04-49f2-84c8-a6820e44614d",
                                "sense_id": "c07b6ebf-022f-35f1-80f0-37e57ef0cf1b",
                                "text": "Cette tribu appartenait au territoire du Pa, rattaché depuis plus d’un siècle à l’empire, et sans doute était-elle en grande partie sinicisée."
                            },
                            {
                                "example_id": "a184136f-e5a2-4063-a232-73acc5c6158d",
                                "sense_id": "c07b6ebf-022f-35f1-80f0-37e57ef0cf1b",
                                "text": "(Ces derniers provenaient tous de la relève du Delta. Les Nings sont des populations fortement sinicisées, à cheval sur la frontière sino-tonkinoise)."
                            }
                        ]
                    }
