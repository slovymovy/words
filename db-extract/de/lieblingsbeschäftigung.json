                ],
                "senses": [
                    {
                        "sense_id": "14754936-afdf-3e75-90a8-59a62d722d30",
                        "entry_id": "1ba390ff-222b-3384-9b67-704535e1a891",
                        "glosses": [
                            "Beschäftigung, die man allen anderen vorzieht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3a8b957-6593-41c6-8566-3d31d83a9bb6",
                                "sense_id": "14754936-afdf-3e75-90a8-59a62d722d30",
                                "text": "Was ist deine Lieblingsbeschäftigung?"
                            },
                            {
                                "example_id": "00b8fa7c-375b-4891-9908-a1c1e95ba3c5",
                                "sense_id": "14754936-afdf-3e75-90a8-59a62d722d30",
                                "text": "Meine Lieblingsbeschäftigung ist das Reisen."
                            },
                            {
                                "example_id": "3ddcfc60-9dea-4545-a202-23cc586e318c",
                                "sense_id": "14754936-afdf-3e75-90a8-59a62d722d30",
                                "text": "„Micky-Maus-Hefte zu lesen ist ihre Lieblingsbeschäftigung.“"
                            },
                            {
                                "example_id": "37007e2d-adaa-4b1b-8bfc-173c6e728e0f",
                                "sense_id": "14754936-afdf-3e75-90a8-59a62d722d30",
                                "text": "„Über Segun zu tratschen gehörte zu ihren Lieblingsbeschäftigungen.“"
                            },
                            {
                                "example_id": "7be0b4f3-4df6-4012-a5d0-a5c3bdc6cf04",
                                "sense_id": "14754936-afdf-3e75-90a8-59a62d722d30",
                                "text": "„Eine meiner Lieblingsbeschäftigungen damals bestand darin, meinen Namen mit einer Lupe in ein Stück Holz zu brennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
