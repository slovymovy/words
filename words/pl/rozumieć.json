                            {
                                "target_lang_word": "合得来",
                                "target_lang_sense_clarification": "彼此处得好、投缘"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58d6f25f-d6ce-3d27-8f46-3fab6e18dc50",
                    "sense_definition": "Interpretować fakty, słowa lub zdarzenia w określony sposób; nadawać czemuś konkretne znaczenie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cognitive_understanding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jak mam <w>rozumieć</w> twoje nagłe milczenie?",
                            "target_lang_translations": {
                                "ru": "Как мне <w>понимать</w> твое внезапное молчание?",
                                "en": "How am I supposed to <w>understand</w> your sudden silence?",
                                "zh": "你这突然的沉默让我该怎么<w>理解</w>？"
                            }
                        },
                        {
                            "text": "Ten przepis można <w>rozumieć</w> na dwa różne sposoby.",
                            "target_lang_translations": {
                                "ru": "Это правило можно <w>понимать</w> двояко.",
                                "en": "This rule can be <w>understood</w> in two different ways.",
                                "zh": "这条规定可以有两种不同的<w>解读</w>方式。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pojmować",
                        "interpretować"
                    ],
                    "common_phrases": [
                        "rozumieć opacznie",
                        "rozumieć dosłownie",
                        "przez to należy rozumieć"
                    ],
                    "target_lang_definitions": {
                        "ru": "Интерпретировать факты, слова или события определенным образом; придавать чему-то конкретное значение.",
                        "en": "To interpret facts, words, or events in a specific way; to assign a concrete meaning to something.",
                        "zh": "以特定方式解释事实、言语或事件；赋予某事物某种具体的含义。"
                    },
                    "translations": {
