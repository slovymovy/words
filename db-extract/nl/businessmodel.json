                            {
                                "example_id": "3c9acac5-3396-49c3-bbd7-b38e8096c40a",
                                "sense_id": "86228bea-537f-3c1b-89b9-f2fb63fb7d48",
                                "text": "De enige reden dat het IOC niet aan de noodrem trekt, nu het businessmodel van de Spelen op menselijk niveau zo overduidelijk failliet is, is het enorme financiële belang van een kleine groep."
                            },
                            {
                                "example_id": "3126185e-3246-4068-9635-faa69914db34",
                                "sense_id": "86228bea-537f-3c1b-89b9-f2fb63fb7d48",
                                "text": "Om echt locatie-onafhankelijk mijn geld te kunnen verdienen zou ik een radicaal ander businessmodel moeten zoeken."
                            },
                            {
                                "example_id": "d31cc2a6-a1b5-460d-a080-1765c85a81f7",
                                "sense_id": "86228bea-537f-3c1b-89b9-f2fb63fb7d48",
                                "text": "Schiphol heeft een hub-and-spoke-systeem (naaf-met-spaken) als businessmodel. In de luchtvaart is een hub een centrale luchthaven waar reizigers naar toe worden vervoerd om over te stappen op andere vluchten, zo mogelijk van dezelfde maatschappij."
                            }
                        ]
