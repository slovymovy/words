{
    "word_family": [
        "conviction",
        "convictable",
        "ex-convict"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7a3cd14d-3c5c-39b4-9ff1-87ecca6b86e9",
                    "sense_definition": "To officially find someone guilty of a crime in a court of law.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "legal judgment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The jury had enough evidence to <w>convict</w> the defendant of the robbery.",
                            "target_lang_translations": {
                                "ru": "У присяжных было достаточно улик, чтобы <w>осудить</w> подсудимого за ограбление."
                            }
                        },
                        {
                            "text": "If the police find the stolen goods, they will likely <w>convict</w> him quickly.",
                            "target_lang_translations": {
                                "ru": "Если полиция найдет украденные вещи, его, скорее всего, быстро <w>признают виновным</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "sentence"
                    ],
                    "antonyms": [
                        "acquit",
                        "exonerate"
                    ],
                    "common_phrases": [
                        "convict of a crime",
                        "convict a defendant"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально признать кого-либо виновным в совершении преступления в суде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осудить",
                                "target_lang_sense_clarification": "вынести обвинительный приговор"
                            },
                            {
                                "target_lang_word": "признать виновным",
                                "target_lang_sense_clarification": "официальное решение суда"
                            },
                            {
                                "target_lang_word": "вынести приговор",
                                "target_lang_sense_clarification": "назначить наказание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f1e9228-6225-3f90-a5a7-898de68bed6a",
                    "sense_definition": "To be firmly convinced or to have a very strong belief in a particular idea or course of action.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "belief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The CEO said he was <w>convicted</w> on this strategy despite the criticism from the board.",
                            "target_lang_translations": {
                                "ru": "Генеральный директор заявил, что он <w>убеждён</w> в правильности этой стратегии, несмотря на критику со стороны совета директоров."
                            }
                        },
                        {
                            "text": "She felt <w>convicted</w> that her decision to leave the company was the right one.",
                            "target_lang_translations": {
                                "ru": "Она была <w>уверена</w>, что её решение уйти из компании было правильным."
                            }
                        }
                    ],
                    "synonyms": [
                        "convince"
                    ],
                    "common_phrases": [
                        "deeply convicted",
                        "convicted on this"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть твердо убежденным или иметь очень сильную веру в определенную идею или план действий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убеждённый",
                                "target_lang_sense_clarification": "имеющий твердую уверенность"
                            },
                            {
                                "target_lang_word": "уверенный",
                                "target_lang_sense_clarification": "не сомневающийся в правоте"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3a08535c-1b09-3d6c-9079-831fbcdf30b5",
                    "sense_definition": "A person who has been found guilty of a crime and is serving a prison sentence.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "prisoner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The escaped <w>convict</w> was caught by the police two days after the breakout.",
                            "target_lang_translations": {
                                "ru": "Сбежавший <w>заключённый</w> был пойман полицией через два дня после побега."
                            }
                        },
                        {
                            "text": "He was a former <w>convict</w> who worked hard to rebuild his life after prison.",
                            "target_lang_translations": {
                                "ru": "Он был бывшим <w>осуждённым</w>, который упорно трудился, чтобы наладить свою жизнь после тюрьмы."
                            }
                        }
                    ],
                    "synonyms": [
                        "con"
                    ],
                    "common_phrases": [
                        "escaped convict",
                        "former convict"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, признанный виновным в преступлении и отбывающий наказание в виде лишения свободы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осуждённый",
                                "target_lang_sense_clarification": "лицо, в отношении которого вступил в силу приговор"
                            },
                            {
                                "target_lang_word": "заключённый",
                                "target_lang_sense_clarification": "человек, находящийся под стражей или в тюрьме"
                            },
                            {
                                "target_lang_word": "зэк",
                                "target_lang_sense_clarification": "разговорное обозначение заключенного"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae699b86-63f4-3173-9718-315ed81cdcab",
                    "sense_definition": "A person who was historically sent to a penal colony as punishment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "prisoner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many ancestors of modern Australians arrived in the country as a <w>convict</w> on a ship.",
                            "target_lang_translations": {
                                "ru": "Многие предки современных австралийцев прибыли в страну на корабле в качестве <w>каторжников</w>."
                            }
                        },
                        {
                            "text": "The museum displays the harsh conditions faced by every <w>convict</w> in the penal colony.",
                            "target_lang_translations": {
                                "ru": "В музее представлены суровые условия, с которыми сталкивался каждый <w>ссыльный</w> в исправительной колонии."
                            }
                        }
                    ],
                    "synonyms": [
                        "penal colonist"
                    ],
                    "common_phrases": [
                        "penal convict",
                        "transported convict"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to historical penal systems"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который в прошлом был отправлен в исправительную колонию в качестве наказания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "каторжник",
                                "target_lang_sense_clarification": "исторический термин для сосланных на каторгу"
                            },
                            {
                                "target_lang_word": "ссыльный",
                                "target_lang_sense_clarification": "человек, отправленный в ссылку"
                            },
                            {
                                "target_lang_word": "колодник",
                                "target_lang_sense_clarification": "устаревшее название арестанта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0cb9ba7f-593e-3e53-895b-5c84a9194bb5",
                    "sense_definition": "A type of freshwater fish with black and white stripes, often kept in aquariums.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>convict</w> cichlid is known for being quite aggressive toward other fish in the tank.",
                            "target_lang_translations": {
                                "ru": "Чернополосая <w>цихлазома</w> известна своей агрессивностью по отношению к другим рыбам в аквариуме."
                            }
                        },
                        {
                            "text": "I decided to buy a <w>convict</w> for my new aquarium because of its striking stripes.",
                            "target_lang_translations": {
                                "ru": "Я решил купить <w>цихлазому</w> для своего нового аквариума из-за её эффектных полос."
                            }
                        }
                    ],
                    "common_phrases": [
                        "convict cichlid"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вид пресноводных рыб с черно-белыми полосами, которых часто содержат в аквариумах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чернополосая цихлазома",
                                "target_lang_sense_clarification": "название аквариумной рыбки"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}