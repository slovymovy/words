                        "form": "die Unvollkommenheit"
                    },
                    {
                        "form_id": "04d6a648-2bc2-425e-baad-3b3d4d0da935",
                        "entry_id": "36309297-ed8a-3138-b43a-a361d8bc56c7",
                        "tags": [
                            "accusative",
