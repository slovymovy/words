                "senses": [
                    {
                        "sense_id": "3a266650-2604-3935-9203-4f7ea94233e1",
                        "entry_id": "848c1f4a-aac8-3074-9ab5-d50263e8a27c",
                        "glosses": [
                            "Herrscher bei einem germanischen Volksstamm"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "99abb186-6c7d-4814-a85b-ac6726e291ed",
                                "sense_id": "3a266650-2604-3935-9203-4f7ea94233e1",
                                "text": "„Ein epochales Ereignis war die Taufe Chlodwigs schon, obgleich auch andere Germanenkönige und ihre Völker der Faszination der christlichen Erlöserreligion erlegen waren.“"
                            },
                            {
                                "example_id": "1f36a6bb-4d2d-4315-8ef8-1c6f5d18b6ce",
                                "sense_id": "3a266650-2604-3935-9203-4f7ea94233e1",
                                "text": "„Daß der gerissene Cäsar seinen Gegner Ariovist, der wahrscheinlich Heerkönig der keltischen Triboker war, als einen Germanenkönig ausgab, hatte laut Hachmann politische Gründe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
