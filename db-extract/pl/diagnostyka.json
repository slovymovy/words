                "senses": [
                    {
                        "sense_id": "2e6e2e77-f9c8-3f9e-bd6a-6ba04e0f923a",
                        "entry_id": "8083bfb0-3dc6-334a-beec-9b7ec3e63d6b",
                        "glosses": [
                            "rozpoznawanie chorób na podstawie przeprowadzonych badań (zarówno u ludzi, jak i u zwierząt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50cc2f50-fad9-4957-81f3-620ec43d068e",
                                "sense_id": "2e6e2e77-f9c8-3f9e-bd6a-6ba04e0f923a",
                                "text": "Diagnostyka nadprodukcji hormonów obejmuje testy laboratoryjne mierzące poziom hormonów we krwi lub moczu, testy dynamiczne oceniające funkcję gruczołów oraz badania obrazowe (USG, TK, MRI) identyfikujące potencjalne zmiany anatomiczne."
                            },
                            {
                                "example_id": "25773db4-9c47-4634-a3d0-db40ad0ba907",
                                "sense_id": "2e6e2e77-f9c8-3f9e-bd6a-6ba04e0f923a",
                                "text": "TK obrazuje bardziej szczegółowo kości, natomiast MR tkanki miękkie, dzięki czemu jest on szczególnie przydatny w diagnostyce zapalenia szpiku kostnego, zapalenia mięśni i martwiczego zapalenia powięzi."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "cb0c1bf1-60af-3d14-86a0-ab8c848961a2",
                        "entry_id": "8083bfb0-3dc6-334a-beec-9b7ec3e63d6b",
                        "glosses": [
                            "proces oceny cech i stanów psychicznych człowieka dokonywany przez psychologa za pomocą metod psychologicznych, którymi najczęściej są testy psychologiczne, obserwacja psychologiczna i wywiad"
                        ],
                        "tags": [
                            "psychology"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
