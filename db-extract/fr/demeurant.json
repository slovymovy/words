                                "example_id": "1713d012-385f-4953-888f-d8cda3e23dd9",
                                "sense_id": "197f82ca-07ff-31fe-9964-ece5f151693b",
                                "text": "Il y a dans cette compagnie cinq ou six hommes de valeur : le demeurant ne compte pas."
                            },
                            {
                                "example_id": "79a44862-c0d6-4b60-ada6-0d1625844beb",
                                "sense_id": "197f82ca-07ff-31fe-9964-ece5f151693b",
                                "text": "Les demeurants d’un autre âge, ceux qui survivent à une génération, qui en représentent encore les sentiments et les idées."
                            }
                        ]
                    }
