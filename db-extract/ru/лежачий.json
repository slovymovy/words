                                "sense_id": "5075d034-0489-3071-8a58-c5da4f19cf4b",
                                "text": "лежа́чий больно́й",
                                "translation": "bed patient; cot case",
                                "english": "bed patient; cot case"
                            },
                            {
                                "example_id": "64eb5ba9-2a25-4373-ba40-75a0b5f11a25",
                                "sense_id": "5075d034-0489-3071-8a58-c5da4f19cf4b",
                                "text": "лежа́чее положе́ние",
                                "translation": "reclining position",
                                "english": "reclining position"
                            },
                            {
                                "example_id": "7b088869-5c4f-4293-a9ff-2bafe8bf111d",
                                "sense_id": "5075d034-0489-3071-8a58-c5da4f19cf4b",
                                "text": "под лежа́чий ка́мень вода́ не течёт",
                                "translation": "≈ no pains, no gains",
                                "english": "≈ no pains, no gains"
                            },
                            {
                                "example_id": "09f0897b-d38c-4691-9161-c75f8ee104fe",
                                "sense_id": "5075d034-0489-3071-8a58-c5da4f19cf4b",
                                "text": "лежа́чего не бьют",
                                "translation": "never hit a man when he is down",
                                "english": "never hit a man when he is down"
                            },
                            {
                                "example_id": "77802e7d-a49c-4a0d-8eb9-f10ec0539d3b",
                                "sense_id": "5075d034-0489-3071-8a58-c5da4f19cf4b",
                                "text": "не бей лежа́чего",
                                "translation": "≈ easy as a pie; a piece of cake",
                                "english": "≈ easy as a pie; a piece of cake"
                            },
                            {
                                "example_id": "dbb01fca-2025-4aa0-985b-46f0c482aba6",
                                "sense_id": "5075d034-0489-3071-8a58-c5da4f19cf4b",
                                "text": "рабо́та - не бей лежа́чего",
                                "translation": "a no-sweat job",
                                "english": "a no-sweat job"
                            },
                            {
                                "example_id": "2d99afcd-8312-49ef-b87b-e80e797ba46d",
                                "sense_id": "5075d034-0489-3071-8a58-c5da4f19cf4b",
                                "text": "лежа́чий полице́йский",
                                "translation": "sleeping policeman; speed bump",
                                "english": "sleeping policeman; speed bump"
                            }
                        ]
