                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ablation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9946de89-e51c-3b20-b186-2ac09d0e06b1",
                                        "entry_id": "8c40f66b-b8cf-3e1d-a893-6708fdeda753",
                                        "glosses": [
                                            "Action d’amputer un être vivant d’une partie de son corps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7060507-bded-429f-856e-99ccd425f940",
                                                "sense_id": "9946de89-e51c-3b20-b186-2ac09d0e06b1",
                                                "text": "On constate, en outre, que la chauve-souris peut voler malgré l’ablation d’une notable étendue de la membrane de ses ailes, pourvu que la partie restante corresponde aux espaces interdigitaux."
                                            },
                                            {
                                                "example_id": "b94f2692-45ed-43ea-a684-378a96365023",
                                                "sense_id": "9946de89-e51c-3b20-b186-2ac09d0e06b1",
                                                "text": "Le crapaud a la vie très dure. Il survit plusieurs heures à la décapitation, plusieurs jours à l’avulsion du cœur, quarante jours à l’ablation des poumons, plusieurs semaines à l’amputation du museau en arrière des yeux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96bfb892-134d-3647-b4c7-3f10bc414bfd",
                                        "entry_id": "8c40f66b-b8cf-3e1d-a893-6708fdeda753",
                                        "glosses": [
                                            "Action de retrancher du corps une partie morbide."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "note": "Les opérations chirurgicales ayant recours à l’incision et à l’ablation sont désignés par le suffixe -tomie",
                                        "examples": [
                                            {
                                                "example_id": "8fb3832b-5b86-4678-8e8b-50200a4c17fc",
                                                "sense_id": "96bfb892-134d-3647-b4c7-3f10bc414bfd",
                                                "text": "Je ne suis d’ailleurs pas amoureux véritablement, et lorsque j’apprends qu’elle doit subir une ablation de la rate, afin de guérir une anémie de Minkowski-Chauffard — ce qui me laisse fier d’avoir posé un diagnostic d’anémie même si ce n’est pas celui de la chlorose des pucelles —, je reporte mon trouble à plus tard."
                                            },
                                            {
                                                "example_id": "3afa206c-d4ac-4ca3-b8aa-f4242927c526",
                                                "sense_id": "96bfb892-134d-3647-b4c7-3f10bc414bfd",
                                                "text": "La tragédienne n’était pas plus poitrinaire que lui. Seulement, elle avait subi jadis une ablation des glandes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fbcfbbe4-dc8d-3ed8-ad73-be279f814d2c",
                                        "entry_id": "8c40f66b-b8cf-3e1d-a893-6708fdeda753",
                                        "glosses": [
                                            "Action d’un flux de matière ou de rayonnement sur la surface d’un corps, entraînant une perte de substance de celui-ci par décomposition chimique, changement d’état ou érosion mécanique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d3b9473e-665d-3089-9165-b688ac1a38d5",
                                        "entry_id": "8c40f66b-b8cf-3e1d-a893-6708fdeda753",
                                        "glosses": [
                                            "Action d’enlever, de retirer une chose de façon généralement brutale."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10665e96-a4ef-3c52-be7d-4e481926ff81",
                                        "entry_id": "8c40f66b-b8cf-3e1d-a893-6708fdeda753",
                                        "glosses": [
                                            "Suppression soit totale, soit partielle, d’une partie quelconque d’un végétal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8e9db78c-f67d-3a91-90a1-47575ff21066",
                                        "entry_id": "8c40f66b-b8cf-3e1d-a893-6708fdeda753",
                                        "glosses": [
                                            "Action d’érosion d’une surface, matière ; ou le phénomène en lui-même."
