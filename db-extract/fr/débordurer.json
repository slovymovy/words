                "senses": [
                    {
                        "sense_id": "1c285c7c-4695-38e2-9d74-1cadd1730478",
                        "entry_id": "f50442a6-4499-3740-ab69-28d9451b6487",
                        "glosses": [
                            "Enlever une bordure à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af11901b-6d64-45a2-89f3-8c7375ea1ba3",
                                "sense_id": "1c285c7c-4695-38e2-9d74-1cadd1730478",
                                "text": "Ça me rappelle quand on a un logo sur fond noir et qu’on utilise un outil pour débordurer, y’a toujours des pixels qui sautent car le prog reconnaît pas bien ce qu’il faut supprimer comme couleur de pixel."
                            },
                            {
                                "example_id": "d9949a67-09d7-4a96-a448-55e7db335390",
                                "sense_id": "1c285c7c-4695-38e2-9d74-1cadd1730478",
                                "text": "L’amincir pour l’assouplir, lui donner la forme du trou à boucher plus 3 centimètres qui seront débordurés."
                            },
                            {
                                "example_id": "056deb8b-dfd0-4586-883e-ccf310874c9f",
                                "sense_id": "1c285c7c-4695-38e2-9d74-1cadd1730478",
                                "text": "Machine à débordurer de renforts génériques."
                            }
                        ]
                    }
