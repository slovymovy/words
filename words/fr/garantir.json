{
    "word_family": [
        "garant",
        "garantie"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1e24c4e9-7018-3710-8f58-187d202e8123",
                    "sense_definition": "Donner l'assurance qu'une chose aura lieu, sera obtenue ou maintenue.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "assurance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle organisation du travail <w>garantit</w> une meilleure répartition des tâches quotidiennes."
                        },
                        {
                            "text": "Le maire a promis de tout faire pour <w>garantir</w> la sécurité des citoyens du quartier."
                        }
                    ],
                    "synonyms": [
                        "assurer",
                        "certifier"
                    ],
                    "common_phrases": [
                        "garantir le succès",
                        "garantir la sécurité"
                    ]
                },
                {
                    "sense_id": "4e07e148-47f4-389e-8282-cb0c132c4189",
                    "sense_definition": "S'engager formellement sur la conformité, la qualité ou le bon fonctionnement d'un produit.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le fabricant <w>garantit</w> cet appareil électroménager contre toute panne pendant deux ans."
                        },
                        {
                            "text": "Ce magasin répare gratuitement les pièces qu'il a <w>garanties</w> lors de la vente."
                        }
                    ],
                    "common_phrases": [
                        "garantir deux ans",
                        "garantir contre les défauts"
                    ]
                },
                {
                    "sense_id": "cc2e7a6f-04ea-311c-8dec-8ed20d43abef",
                    "sense_definition": "Affirmer avec certitude la réalité, la véracité ou l'existence d'un fait.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "assurance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je vous <w>garantis</w> que cette anecdote s'est réellement déroulée sous mes yeux."
                        },
                        {
                            "text": "Il m'a raconté cette histoire, mais personne ne peut en <w>garantir</w> l'exactitude."
                        }
                    ],
                    "synonyms": [
                        "attester",
                        "certifier"
                    ],
                    "common_phrases": [
                        "garantir l'exactitude",
                        "garantir sur l'honneur"
                    ]
                },
                {
                    "sense_id": "804eea47-3ea4-31e3-acd9-147551c95461",
                    "sense_definition": "Préserver, mettre à l'abri ou protéger contre un risque, un mal ou une intempérie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce manteau très épais le <w>garantit</w> efficacement contre le froid glacial de l'hiver."
                        },
                        {
                            "text": "Les promeneurs ont ouvert leurs parapluies pour se <w>garantir</w> de la pluie battante."
                        }
                    ],
                    "synonyms": [
                        "défendre",
                        "préserver",
                        "protéger"
                    ],
                    "antonyms": [
                        "exposer"
                    ],
                    "common_phrases": [
                        "se garantir du froid",
                        "garantir de la pluie"
                    ]
                },
                {
                    "sense_id": "88ed4d7e-fecb-3617-85d6-f9903e451cf8",
                    "sense_definition": "Se porter garant juridiquement ou financièrement de l'exécution d'un contrat ou d'une dette.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses parents ont accepté d'hypothéquer leur maison pour <w>garantir</w> son emprunt bancaire."
                        },
                        {
                            "text": "Cette clause contractuelle <w>garantit</w> le paiement intégral des créances en cas de litige."
                        }
                    ],
                    "synonyms": [
                        "cautionner",
                        "répondre de"
                    ],
                    "common_phrases": [
                        "garantir une dette",
                        "garantir un prêt"
                    ]
                },
                {
                    "sense_id": "a66c9866-d27e-393f-8521-f4ff047a33d2",
                    "sense_definition": "Défendre quelqu'un en justice ou l'indemniser d'un préjudice subi par suite d'une éviction ou d'un jugement.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "juridique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vendeur est tenu en droit de <w>garantir</w> l'acquéreur contre toute éviction ultérieure."
                        },
                        {
                            "text": "L'assureur doit <w>garantir</w> son client de toutes les condamnations civiles prononcées à son encontre."
                        }
                    ],
                    "synonyms": [
                        "indemniser"
                    ],
                    "common_phrases": [
                        "garantir d'une éviction",
                        "garantir des condamnations"
                    ]
                }
            ]
        }
    ]
}