                        "cross_references": [
                            {
                                "target_word": "glycosaminoglycan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ca16245-cfa2-34ab-a3b9-68d44816848f",
                                        "entry_id": "b3182189-32d3-3643-bcfb-37938deaeb19",
                                        "glosses": [
                                            "Any polysaccharide that is a polymer of amino sugars; they are the carbohydrate units of proteoglycans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57c55091-a6bd-49b8-b2e6-9bed7ad4d8ab",
                                                "sense_id": "6ca16245-cfa2-34ab-a3b9-68d44816848f",
                                                "text": "Subcellular fractionation techniques have indicated that the greatest percentage of these glycosaminoglycans that is not extracted with water is contained within the microsomal fraction (36-60%)."
                                            },
                                            {
                                                "example_id": "fcba8eda-c61b-4792-8a24-419078b8f841",
                                                "sense_id": "6ca16245-cfa2-34ab-a3b9-68d44816848f",
                                                "text": "1998, Christopher C. Rider, 9: Analysis of Glycosaminoglycans and Proteoglycans, Elizabeth F. Hounsell (editor), Glycoanalysis Protocols, 2nd Edition, page 131,\nThe biosynthesis of glycosaminoglycans (GAGs) and proteoglycans appears to be a ubiquitous function in mammalian cells."
                                            },
                                            {
                                                "example_id": "2e3250f7-359b-4f7c-914c-a1e26390e503",
                                                "sense_id": "6ca16245-cfa2-34ab-a3b9-68d44816848f",
                                                "text": "The mucopolysaccharidoses (MPSs) are a group of inherited disorders caused by specific enzyme deficiencies in the degradation of the glycosaminoglycans (mucopolysaccharides)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
