                        "entry_id": "132df7ee-cf89-30c2-aedb-7dee4d35007b",
                        "glosses": [
                            "das Prüfen, um eine mögliche Entscheidung zu treffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af012e5c-0b3e-468d-81ec-282f78e5e88b",
                                "sense_id": "6fe6609d-cd37-3e82-a68f-034254770159",
                                "text": "Bei der Sichtung des Schadens wurde schnell klar, daß es sich hier vermutlich um einen Totalschaden handelt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "eecce458-11fd-352c-8ff1-cf24ce4dfb10",
                        "entry_id": "132df7ee-cf89-30c2-aedb-7dee4d35007b",
                        "glosses": [
                            "das Auftauchen im Sichtbereich; das Sichten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a05869d3-2b51-4517-9b8a-e305561f3487",
                                "sense_id": "eecce458-11fd-352c-8ff1-cf24ce4dfb10",
                                "text": "Nach der Sichtung von Land wurde sofort der Kapitän benachrichtigt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "15d0d0e5-ce00-4928-a1e4-69902b67d515",
