                                            {
                                                "example_id": "a8741e49-122e-48e5-91bd-abad12edaed9",
                                                "sense_id": "a5dbc2fd-591c-3123-b5aa-6df2685183f0",
                                                "text": "Une populace séditieuse."
                                            },
                                            {
                                                "example_id": "58d8000f-9437-4361-acae-7f106623c403",
                                                "sense_id": "a5dbc2fd-591c-3123-b5aa-6df2685183f0",
                                                "text": "Un attroupement séditieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1deccf5e-fd6b-3562-a011-75275c9c027f",
                                        "entry_id": "41f3b662-eac3-3fa1-9dbe-fd705c685695",
                                        "glosses": [
                                            "Qui est enclin à faire sédition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e32f65b4-e2a3-4733-97f5-4870b2fe6dc2",
                                                "sense_id": "1deccf5e-fd6b-3562-a011-75275c9c027f",
                                                "text": "Un esprit séditieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad776530-5b3f-3f0a-b5ea-f00f55c6c6aa",
                                        "entry_id": "41f3b662-eac3-3fa1-9dbe-fd705c685695",
                                        "glosses": [
                                            "Qui tend, qui provoque à la sédition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89dfdcc5-1ed9-4920-b995-c12b8b42e0fb",
                                                "sense_id": "ad776530-5b3f-3f0a-b5ea-f00f55c6c6aa",
                                                "text": "Dans chaque royaume le cri de « Vive le roi ! » devint un cri séditieux et fut défendu sous les peines les plus sévères, à l’exception de la peine de mort."
                                            },
                                            {
                                                "example_id": "ce89379b-512b-4522-923f-7b23ce07edb2",
                                                "sense_id": "ad776530-5b3f-3f0a-b5ea-f00f55c6c6aa",
                                                "text": "La Cour suprême a rejeté à l’unanimité la requête carrément séditieuse du procureur général du Texas demandant d’annuler les résultats des élections en Géorgie, en Pennsylvanie, au Wisconsin et au Michigan. Ces États avaient d’ailleurs répliqué qu’il s’agissait d’un « abus séditieux du processus judiciaire »."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "séditieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ae564f94-6575-3c1a-ac3a-ecebfa9c333e",
                                        "entry_id": "2f4dd33c-0476-373d-b652-bfaa1babc128",
                                        "glosses": [
                                            "Personne qui se révolte, qui participe à une émeute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6b645e3-a65b-44fb-b195-ecfcc9d88712",
                                                "sense_id": "ae564f94-6575-3c1a-ac3a-ecebfa9c333e",
                                                "text": "C’est un séditieux."
                                            },
                                            {
                                                "example_id": "cffb1902-c024-4494-a54c-081c8bff1cd4",
                                                "sense_id": "ae564f94-6575-3c1a-ac3a-ecebfa9c333e",
                                                "text": "On arrêta le chef des séditieux."
                                            },
                                            {
                                                "example_id": "1c39ef51-efd6-4c2d-8f6e-cb472377627f",
                                                "sense_id": "ae564f94-6575-3c1a-ac3a-ecebfa9c333e",
                                                "text": "Les séditieux firent des attroupements."
                                            }
                                        ]
