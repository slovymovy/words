                "senses": [
                    {
                        "sense_id": "e0d6591f-3201-3594-92b6-234ef93eba40",
                        "entry_id": "400db2d1-6b2f-30ad-b2f2-dbad7ad7f89e",
                        "glosses": [
                            "ein an ein Haus nach hinten anschließender Gebäudeteil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "268a7493-e13b-4ff5-b5f5-710efb6b828c",
                                "sense_id": "e0d6591f-3201-3594-92b6-234ef93eba40",
                                "text": "„»[…] Von dem Häuschen aus kommt man eigentlich über eine Treppe runter ins Hinterhaus.«“"
                            },
                            {
                                "example_id": "2192b325-d0f4-4cc9-8b17-357937eb6858",
                                "sense_id": "e0d6591f-3201-3594-92b6-234ef93eba40",
                                "text": "„Diese Tür führte in das Vorzimmer des Hinterhauses.“"
                            },
                            {
                                "example_id": "15a61122-3164-40b3-b6cf-077f87980759",
                                "sense_id": "e0d6591f-3201-3594-92b6-234ef93eba40",
                                "text": "„Frau N. wohnt in einem Hinterhaus einer Arbeitersiedlung, die zufällig nicht von Bomben zerstört war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6dd94fce-be33-322a-bb16-992160a72dc0",
                        "entry_id": "400db2d1-6b2f-30ad-b2f2-dbad7ad7f89e",
                        "glosses": [
                            "ein hinter einem Haus und dem anschließenden Hof/Garten gelegenes Haus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22df5aa6-0df2-40b8-863b-b29f81ce35a1",
                                "sense_id": "6dd94fce-be33-322a-bb16-992160a72dc0",
                                "text": "„Frau N. wohnt in einem Hinterhaus einer Arbeitersiedlung, die zufällig nicht von Bomben zerstört war.“"
                            },
                            {
                                "example_id": "73f0ac8c-287f-4962-8079-6de139625516",
                                "sense_id": "6dd94fce-be33-322a-bb16-992160a72dc0",
                                "text": "„Kufalt ist polizeilich gemeldet, und die Hinterhäuser in den Raboisen kümmern sich nicht viel darum, ob gerade mal einer schreit.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
