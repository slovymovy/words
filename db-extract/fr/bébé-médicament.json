                            {
                                "target_word": "saviour sibling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3dbb086c-3241-37b6-9481-d7508e833764",
                                        "entry_id": "a40b596d-62d4-3585-9dd1-cd8dee659798",
                                        "glosses": [
                                            "A child, conceived by selected IVF treatment, so as to have compatible tissue that could be used to treat an existing sick sibling"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d765836f-b32b-4557-b567-9fb10dcbd1e3",
                                                "sense_id": "3dbb086c-3241-37b6-9481-d7508e833764",
                                                "text": "MPs pushed back the boundaries of science last night when they voted to allow the creation of hybrid embryos, which have a combination of human and animal DNA, as well as \"saviour siblings\" to save sick children."
                                            }
                                        ]
                                    }
                                ]
                            }
