        "fr-extract.jsonl": [
            {
                "entry_id": "15d27410-7bda-3726-8b96-045877044c86",
                "word": "perfidie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4c21e02e-044c-4d27-a0e9-e370ab1bdf81",
                        "entry_id": "15d27410-7bda-3726-8b96-045877044c86",
                        "tags": [
                            "plural"
                        ],
                        "form": "perfidies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "369e6eec-5c6f-3bd4-9551-275763b2bb52",
                        "entry_id": "15d27410-7bda-3726-8b96-045877044c86",
                        "glosses": [
                            "Déloyauté, manquement de foi, abus de confiance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "738794c1-6f6d-4881-b9be-ca2ab119ff06",
                                "sense_id": "369e6eec-5c6f-3bd4-9551-275763b2bb52",
                                "text": "Comparez le prince de Fénelon avec celui de Machiavel; […]. Vous verrez dans l'autre la scélératesse, la perfidie, et tous les crimes."
                            },
                            {
                                "example_id": "60aa25c0-a262-4b4e-9edb-41a4ac20eb55",
                                "sense_id": "369e6eec-5c6f-3bd4-9551-275763b2bb52",
                                "text": "…c'est lui qui, dans tous les temps, démentira tous les vains subterfuges inventés par la perfidie pour violer impunément les droits de l'humanité."
                            }
                        ]
                    },
                    {
                        "sense_id": "8c1e6446-6369-3c78-8449-3d7e791166da",
                        "entry_id": "15d27410-7bda-3726-8b96-045877044c86",
                        "glosses": [
                            "Action perfide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77746a2a-fd69-47e0-85ef-5cf1b08761ae",
                                "sense_id": "8c1e6446-6369-3c78-8449-3d7e791166da",
                                "text": "Pour sauver sa fille, elle devina tout à coup les perfidies, les mensonges des créatures qui n'aiment pas, les tromperies de la coquetterie."
                            },
                            {
                                "example_id": "c001ea5f-38a8-4266-b6b4-7afedbfb0a90",
                                "sense_id": "8c1e6446-6369-3c78-8449-3d7e791166da",
                                "text": "Lubies antiécologistes, goûts alimentaires baroques, petites perfidies du quotidien…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e51cb0ae-b270-4e38-b30b-016904570a39",
                        "source_entry_id": "15d27410-7bda-3726-8b96-045877044c86",
                        "target_lang_word": "Perfidie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Perfidie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cd9a4154-6061-37ea-893a-8d1b7401ca4e",
                                        "entry_id": "49548f96-444e-34fb-a67f-d9abb2790187",
                                        "glosses": [
                                            "perfide, heimtückische Art"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5299384b-1d22-4aab-ba2c-b842269fc788",
                                                "sense_id": "cd9a4154-6061-37ea-893a-8d1b7401ca4e",
                                                "text": "Gipfel der Perfidie in afrikanischer Sicht: Jetzt sollen Schwarzafrikaner vor der Einreise nach Großbritannien einen Aids-Test passieren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0936c9b9-f95b-377b-9195-9f56cc4b0eb0",
                                        "entry_id": "49548f96-444e-34fb-a67f-d9abb2790187",
                                        "glosses": [
                                            "gemeine, heimtückische Tat/Handlung"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "020647a2-b0da-485e-8784-0fdd3c1b6fa2",
                                                "sense_id": "0936c9b9-f95b-377b-9195-9f56cc4b0eb0",
                                                "text": "„Es hätte dieser protektorischen Perfidie nicht bedurft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fe8e7aa9-29bb-4456-b53d-320e541e4176",
                        "source_entry_id": "15d27410-7bda-3726-8b96-045877044c86",
                        "target_lang_word": "Hinterlist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hinterlist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e9321d4e-ead3-3c5b-b72a-406937bac25c",
                                        "entry_id": "e6a96f45-480d-366c-a8e5-7a206dfbffa6",
                                        "glosses": [
                                            "Verhalten, bei dem die eigentliche, negative Absicht verborgen wird"
                                        ],
                                        "tags": [
                                            "meist Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20a22048-9ee0-4110-ba01-4dd0ee6ce46f",
                                                "sense_id": "e9321d4e-ead3-3c5b-b72a-406937bac25c",
                                                "text": "„Die Vorsitzende Richterin ging in der Urteilsbegründung auf die Hinterlist der Tat ein.“"
                                            },
                                            {
                                                "example_id": "38558b56-59c6-4b6f-9cb5-0e3094e5bba2",
                                                "sense_id": "e9321d4e-ead3-3c5b-b72a-406937bac25c",
                                                "text": "„Getreu der konfuzianischen Überzeugung, daß man die Hinterlist des Feindes mit eigener Tugend ausgleichen müsse, befahl er, alle Japaner -- Soldaten wie Zivilisten -- gerecht und human zu behandeln, sie schnellstmöglich auch in ihre Heimat zu schicken.“"
                                            },
                                            {
                                                "example_id": "7142abe7-65e1-49d3-bd34-4ea96cad57fb",
                                                "sense_id": "e9321d4e-ead3-3c5b-b72a-406937bac25c",
                                                "text": "„Eure Aufgabe ist in einem Landstreifen durchzuführen, in dem 1914 Ströme deutschen Blutes durch die Hinterlist der Serben, Männer und Frauen, geflossen sind.“"
                                            },
                                            {
                                                "example_id": "52a89684-8d35-474f-9179-42713cc4d87f",
                                                "sense_id": "e9321d4e-ead3-3c5b-b72a-406937bac25c",
                                                "text": "„In Perpignan verabschiedete ich meinen Diener mit einer guten Entlohnung und berichtete meinem Bruder nach Paris von meinem Glück, der Hinterlist dreier Meuchelmörder entronnen zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b32f56c6-72b3-4c06-99a6-803a1bb21def",
                        "source_entry_id": "15d27410-7bda-3726-8b96-045877044c86",
                        "target_lang_word": "Arglist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arglist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "667d521f-4252-3b60-a150-991ee707472f",
                                        "entry_id": "81d04fa3-26cf-362b-a6e5-c624b1f4b223",
                                        "glosses": [
                                            "Hinterlist und Boshaftigkeit, die darauf abzielen, anderen Nachteile zuzufügen"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ae4f3c6-e7f2-4c83-a2bc-a2d8665c0c8e",
                                                "sense_id": "667d521f-4252-3b60-a150-991ee707472f",
                                                "text": "Um seine Opfer zur Zahlung zu bewegen, ging Hubert N. mit besonderer Arglist zu Werke."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8e59193a-6f23-3530-82d1-f97e68aa0543",
                                        "entry_id": "81d04fa3-26cf-362b-a6e5-c624b1f4b223",
                                        "glosses": [
                                            "(mindestens bedingter) Vorsatz bezüglich einer Täuschungshandlung, der Erregung eines Irrtums und der daraus resultierenden Abgabe einer Willenserklärung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9afd0e30-1b78-465d-9724-bf665526fbb4",
                                                "sense_id": "8e59193a-6f23-3530-82d1-f97e68aa0543",
                                                "text": "Arglist wird auch bei Erklärungen „ins Blaue hinein“ bejaht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa75c3f2-e397-41af-a8a9-807f73c6c1c1",
                        "source_entry_id": "15d27410-7bda-3726-8b96-045877044c86",
                        "target_lang_word": "Tücke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tücke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "03f2ef3e-2a08-3a97-9377-8696e37b94e5",
                                        "entry_id": "ced3fec6-c176-36bd-97e1-8feb875bfc19",
                                        "glosses": [
                                            "eine nicht auf den ersten Blick erkennbare, verborgen feindselige Absicht, die sich erst bei scharfem Durchblick offenbart"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5eda6c2d-b9fb-4435-92e6-fa9136141470",
                                                "sense_id": "03f2ef3e-2a08-3a97-9377-8696e37b94e5",
                                                "text": "Man kommt erst nach einer Weile hinter all seine Tücken."
                                            },
                                            {
                                                "example_id": "690428fa-8615-4968-b0cb-e8c1c0c6a614",
                                                "sense_id": "03f2ef3e-2a08-3a97-9377-8696e37b94e5",
                                                "text": "„Nein, nicht länger kann ich‘s lassen; will ihn fassen. Das ist Tücke! Ach! nun wird mir immer bänger! Welche Mine! Welche Blicke!“ (Aus „Der Zauberlehrling“ von J.W.v. Goethe)"
                                            },
                                            {
                                                "example_id": "96507067-7f32-41c6-889f-7cb44b1756d7",
                                                "sense_id": "03f2ef3e-2a08-3a97-9377-8696e37b94e5",
                                                "text": "„Ein anderer Stottererwitz handelt von der Tücke des falschen Helfers.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e57347a7-6270-3738-b460-d5deaf93c271",
                                        "entry_id": "ced3fec6-c176-36bd-97e1-8feb875bfc19",
                                        "glosses": [
                                            "verborgene, nicht sofort erkennbare erschwerende Eigenschaft eines Objekts oder Vorgangs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b50eeea-fcc3-49e8-8604-2e417abe19a5",
                                                "sense_id": "e57347a7-6270-3738-b460-d5deaf93c271",
                                                "text": "Das sind mal wieder die berühmten Tücken des Objekts."
                                            },
                                            {
                                                "example_id": "57c545f7-264e-44c6-8cd9-ba36af23696a",
                                                "sense_id": "e57347a7-6270-3738-b460-d5deaf93c271",
                                                "text": "Der Parcours hat seine Tücken, die man erst beim Wettkampf wirklich erkennt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Tücke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ebb3ca14-3a5a-3702-863f-1f93f9d3c26a",
                                        "entry_id": "618215ea-f475-3dd5-8636-940774795fc5",
