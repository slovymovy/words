                "senses": [
                    {
                        "sense_id": "10b4b012-8539-37eb-8265-d732fbd812b1",
                        "entry_id": "0e12eb17-750d-30da-9f1b-2e9e992bacae",
                        "glosses": [
                            "Gebäude, in dem sich eine Schule^([1]) befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0cef1ea-f865-4add-a92d-a1e3565be56f",
                                "sense_id": "10b4b012-8539-37eb-8265-d732fbd812b1",
                                "text": "Das Schulgebäude ist schon ziemlich alt."
                            },
                            {
                                "example_id": "72025d2c-7440-4f36-9279-72ce8dc04da2",
                                "sense_id": "10b4b012-8539-37eb-8265-d732fbd812b1",
                                "text": "„Das Schulgebäude befand sich nur wenige Meter von unserem Haus entfernt.“"
                            },
                            {
                                "example_id": "1348d4b9-558e-4a5f-8331-cbd325356e0b",
                                "sense_id": "10b4b012-8539-37eb-8265-d732fbd812b1",
                                "text": "„In einem Schulgebäude in der Provinz Oranje-Freistaat versammeln sich mehr als 60 Schwarze aus der gesamten Union.“"
                            },
                            {
                                "example_id": "1cb08db8-ebc1-4e86-82de-ce00a2d158c7",
                                "sense_id": "10b4b012-8539-37eb-8265-d732fbd812b1",
                                "text": "„Die Schulgebäude von Kouroussa stammten teilweise noch aus der Kolonialzeit.“"
                            },
                            {
                                "example_id": "129f1e53-4157-4fdc-8680-4d6bce40a1d4",
                                "sense_id": "10b4b012-8539-37eb-8265-d732fbd812b1",
                                "text": "„Sie mussten Holz oder Briketts mitbringen, damit das Schulgebäude wenigstens angewärmt werden konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
