                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d633079d-7426-4b5b-846a-922fadd77563",
                                                "sense_id": "36518acb-489c-3218-84e5-2c4ac307c627",
                                                "text": "With much of the world having become aware of Lithuanian basketball thanks to the Grateful Dead, I wondered if shrines to other rock acts were in the offing—to Led Zeppelin, perhaps, in honor of what a cepelinas feels like in the pit of the stomach."
                                            },
                                            {
                                                "example_id": "71cba37a-1eed-4fcc-8c67-78df19b00125",
                                                "sense_id": "36518acb-489c-3218-84e5-2c4ac307c627",
                                                "text": "Cepelinai are giant dumplings named for Zeppelin air ships. They are a Lithuanian specialty, served as a main dish."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
