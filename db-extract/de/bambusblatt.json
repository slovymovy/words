                        "examples": [
                            {
                                "example_id": "cae6fd59-b25c-42b0-82f0-bbe4cb468c8f",
                                "sense_id": "748c2768-e92b-33e4-b25e-670404aa82a1",
                                "text": "„Er war halb unter Bambusblättern begraben, sodass der aufgeschlitzte Bauch nur teilweise zu sehen war, doch war selbst dieses Wenige noch zu viel.“"
                            },
                            {
                                "example_id": "17ff50be-09ee-45ea-a016-5fc570cacb9f",
                                "sense_id": "748c2768-e92b-33e4-b25e-670404aa82a1",
                                "text": "„Die Wände waren erst kürzlich weiß gestrichen worden und es waren mehrere Kohlezeichnungen von Bambusblättern und Hibiskusblüten auf gerahmtem Reispapier aufgehängt.“"
                            }
                        ],
