                    {
                        "sense_id": "f2990cae-03a7-391c-935b-f80fbd7eaeb0",
                        "entry_id": "56b65d6a-7309-3824-aeb8-2ac3a3f1789b",
                        "glosses": [
                            "Automatikgetriebe mit sechs Gängen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7be1ce1-a02c-4021-8eeb-fcce7e2b00e6",
                                "sense_id": "f2990cae-03a7-391c-935b-f80fbd7eaeb0",
                                "text": "„Als Getriebe steht eine Fünfgang-Handschaltung oder eine Sechsgang-Automatik zur Wahl.“"
                            },
                            {
                                "example_id": "2519ab73-598f-47a7-a7c1-67909c44c889",
                                "sense_id": "f2990cae-03a7-391c-935b-f80fbd7eaeb0",
                                "text": "„Serienmäßig ist ein Sechsgang-Schaltgetriebe verbaut, optional gibt es eine Sechsgang-Automatik.“"
                            },
                            {
                                "example_id": "1cdeaa85-7604-40d6-a6e2-97014699a188",
                                "sense_id": "f2990cae-03a7-391c-935b-f80fbd7eaeb0",
                                "text": "„Neben einem manuellen Sechsganggetriebe bietet Ford eine Sechsgang-Automatik an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
