            {
                "entry_id": "9165a24b-2451-3683-a64e-449d78b86e22",
                "word": "malle-poste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "57030099-d74b-4ee8-b9f5-f735afcb6480",
                        "entry_id": "9165a24b-2451-3683-a64e-449d78b86e22",
                        "tags": [
                            "plural"
                        ],
                        "form": "malles-postes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "abd41924-d48e-3e7a-a24f-e1ffd6672aed",
                        "entry_id": "9165a24b-2451-3683-a64e-449d78b86e22",
                        "glosses": [
                            "Véhicule hippomobile qui assurait les liaisons régulières entre les villes par laquelle l’administration des postes envoyait les lettres aux bureaux de destination et dans laquelle on recevait des voyageurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e37069c7-31cc-43ca-ae72-53c5687294a3",
                                "sense_id": "abd41924-d48e-3e7a-a24f-e1ffd6672aed",
                                "text": "M. l’évêque avait fait venir par la malle-poste quatre tapissiers de Paris, mais ces Messieurs ne pouvaient suffire à tout, et loin d’encourager la maladresse de leurs camarades bisontins, ils la redoublent en se moquant d’eux."
                            },
                            {
                                "example_id": "3c427acb-45fc-405a-a823-06e5f1c25079",
                                "sense_id": "abd41924-d48e-3e7a-a24f-e1ffd6672aed",
                                "text": "Je pris la malle-poste en sortant du château, et j’arrivai le soir à Tours."
                            },
                            {
                                "example_id": "96612353-759a-4629-a398-8479bef9002b",
                                "sense_id": "abd41924-d48e-3e7a-a24f-e1ffd6672aed",
                                "text": "[…] , le jeune Référendaire retint une place dans la malle-poste du Havre, après avoir écrit une lettre où il annonçait une réponse pour un jour déterminé, se rejetant sur l’importance de la confession demandée, […] ."
                            },
                            {
                                "example_id": "945129d4-0593-4e73-b7b2-19c87cfbacf3",
                                "sense_id": "abd41924-d48e-3e7a-a24f-e1ffd6672aed",
                                "text": "Derrière elle, dans un nuage de poussière et emportée par la descente, une malle-poste au grand galop se précipitait comme une trombe."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b5b33adf-0507-4fff-acd8-9c55e7fc4431",
                        "source_entry_id": "9165a24b-2451-3683-a64e-449d78b86e22",
                        "source_sense_id": "abd41924-d48e-3e7a-a24f-e1ffd6672aed",
                        "target_lang_word": "Postkutsche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Postkutsche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b5388639-2c73-3100-81b9-44fe469c8344",
                                        "entry_id": "bea414be-fdd0-3abf-81f0-79279f2a129f",
                                        "glosses": [
                                            "Kutsche, mit der man früher Personen und Postsendungen beförderte"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1ce4f55-5cb7-4e2f-aff5-c8d67b8b78bf",
                                                "sense_id": "b5388639-2c73-3100-81b9-44fe469c8344",
                                                "text": "„In Postkutschen mit blauseidenen Vorhängen fährt man im Schritt steile Landstraßen hinauf und lauscht dem Lied des Postillions, […].“"
                                            },
                                            {
                                                "example_id": "aa3e36ae-58c6-4a75-ab45-bc02641d95c4",
                                                "sense_id": "b5388639-2c73-3100-81b9-44fe469c8344",
                                                "text": "Die Wachauorte waren bis 1909 nur mit der Postkutsche zu erreichen."
                                            },
                                            {
                                                "example_id": "fa450b99-b775-4e79-a951-8cf7a62064b9",
                                                "sense_id": "b5388639-2c73-3100-81b9-44fe469c8344",
                                                "text": "Schon vor hundert Jahren wusste jedes Kind aus seinen Bilderbüchern: Die Schnecke bringt den Waldtieren die Post. Ein Bild, das noch viel weiter zurückreicht, in die Zeit der Postkutschen."
                                            },
                                            {
                                                "example_id": "5351e0fe-14ec-4e87-a227-be692106b53f",
                                                "sense_id": "b5388639-2c73-3100-81b9-44fe469c8344",
                                                "text": "Eine alte Postkutsche aus dem 18. Jahrhundert ist am Sonntag von Triest in Richtung Wien abgefahren."
                                            },
                                            {
                                                "example_id": "7742406d-34e9-4c75-b9ec-ff27f01bb266",
                                                "sense_id": "b5388639-2c73-3100-81b9-44fe469c8344",
                                                "text": "„Die Einführung der Postkutschen stellte eine epochale Neuerung im Verkehrs- und Postwesen dar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
