                "translations": [
                    {
                        "translation_id": "8b6d7cfc-b328-46c5-80b8-8b7cddafa753",
                        "source_entry_id": "1eb5231c-3fe4-3aa3-b66e-223abff18921",
                        "source_sense_id": "2eea8830-202a-308e-97d3-c071c0527a8b",
                        "target_lang_word": "stapfen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stapfen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d752d2c0-390f-36ac-89aa-9cd023302243",
                                        "entry_id": "005bd1d0-47d6-353f-8771-131f8757db98",
                                        "glosses": [
                                            "gehen und dabei die Füße höher als normal anheben, zum Beispiel auf weichem Untergrund, in den man geräuschvoll einsinkt"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b22ed98-7861-4888-b147-534b27f45bd4",
                                                "sense_id": "d752d2c0-390f-36ac-89aa-9cd023302243",
                                                "text": "Wir stapfen durch den Wald und genießen das Vogelgezwitscher und die frische Luft."
                                            },
                                            {
                                                "example_id": "378cfc45-11fd-4413-bb8d-59f17713dbdd",
                                                "sense_id": "d752d2c0-390f-36ac-89aa-9cd023302243",
                                                "text": "Ich hatte Gummistiefel angezogen und stapfte durch die milchige Brühe in unserem Keller."
                                            },
                                            {
                                                "example_id": "52ddf4ec-bee0-47f3-a8e4-934ebd67ac16",
                                                "sense_id": "d752d2c0-390f-36ac-89aa-9cd023302243",
                                                "text": "Mit Riesenschritten stapft Bayern München auf die Meisterschaft zu."
                                            },
                                            {
                                                "example_id": "4aa74588-7050-4f0e-9869-581dca0ccf8a",
                                                "sense_id": "d752d2c0-390f-36ac-89aa-9cd023302243",
                                                "text": "Die Spaziergänger stapfen durch den hohen Neuschnee."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "511cdab8-adb1-45d9-8fd9-3dfd135e30fb",
                        "source_entry_id": "1eb5231c-3fe4-3aa3-b66e-223abff18921",
                        "source_sense_id": "2eea8830-202a-308e-97d3-c071c0527a8b",
                        "target_lang_word": "waten",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "waten",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f666524-825c-3a4c-bedb-f1cd9be88a9f",
                                        "entry_id": "0e6e39e2-fa51-3136-8afe-5e5a74144331",
                                        "glosses": [
                                            "im Wasser oder auf nachgebendem Untergrund langsam gehen, wobei die Beine bei jedem Schritt nacheinander angehoben werden"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a6ac4f5-eb66-496d-81c5-5761667d6b22",
                                                "sense_id": "1f666524-825c-3a4c-bedb-f1cd9be88a9f",
                                                "text": "Huett watet in Gummistiefeln durch den tiefen Matsch eines Reisfeldes."
                                            },
                                            {
                                                "example_id": "753ac1ff-d3f7-44a5-a579-7c4ed11f87ce",
                                                "sense_id": "1f666524-825c-3a4c-bedb-f1cd9be88a9f",
                                                "text": "…; und während sie herumlärmen und übereinanderstolpern, wie sie es immer machen, schleichen wir uns in den Bach, der hinter dem Hause läuft, und waten in ihm fort, bis wir der Hintertür gegenüber kommen."
                                            },
                                            {
                                                "example_id": "e15a0961-423b-402f-8174-fada8bf6dc18",
                                                "sense_id": "1f666524-825c-3a4c-bedb-f1cd9be88a9f",
                                                "text": "Die Rangers nehmen mich in die Mitte, wir marschieren los, waten durch Gebirgsflüsse, klettern auf einen Berg, dann noch einen, immer querfeldein."
                                            },
                                            {
                                                "example_id": "ef97cfbc-553f-4a90-936e-2c667ef6cbb2",
                                                "sense_id": "1f666524-825c-3a4c-bedb-f1cd9be88a9f",
                                                "text": "Auch in Hamburg waten wir nun durch Feuersbrünste, Konfettiregen, Nebelschwaden und grelles Gegenlicht und türmt sich hinter den Heroen dunkles Granit-Imitat."
                                            },
                                            {
                                                "example_id": "5e0a934e-66e8-4e22-b519-491c2f6afa59",
                                                "sense_id": "1f666524-825c-3a4c-bedb-f1cd9be88a9f",
                                                "text": "In Fernsehen waren hunderte Menschen zu sehen, die durch hüfttiefes Wasser waten mussten, um die Pakete aufzusammeln."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
