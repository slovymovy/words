                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0ae6a11-118e-441b-a691-7b3a581446d8",
                                                "sense_id": "8452faa9-18f0-32a5-a7f0-f4a68f97581b",
                                                "text": "Zijn dunne, maar pezige benen waren in een paar prachtige gespikkelde katoenen kousen gestoken, die een uur in de wind roken naar Engelse smokkelwaar."
                                            }
                                        ]
                                    }
                                ]
