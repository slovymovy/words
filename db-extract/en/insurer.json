            {
                "entry_id": "13afc843-730e-3e89-bbd2-e5b19e862cf7",
                "word": "insurer",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "eaae85c1-0a1b-4268-b7bd-b8c9fd0f12fb",
                        "entry_id": "13afc843-730e-3e89-bbd2-e5b19e862cf7",
                        "tags": [
