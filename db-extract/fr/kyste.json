                "entry_id": "0c4ee1d0-ccc8-346b-814d-584d9afa9110",
                "word": "kyste",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8e98da4c-bd4c-45e9-ba5e-6351807aa83a",
                        "entry_id": "0c4ee1d0-ccc8-346b-814d-584d9afa9110",
