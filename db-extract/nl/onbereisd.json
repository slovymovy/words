                "senses": [
                    {
                        "sense_id": "0b232192-cc13-360e-b716-bf6d760b1e49",
                        "entry_id": "4bad3618-39b7-38fa-ab9a-d06ccee7f657",
                        "glosses": [
                            "van een persoon dat deze weinig reizen heeft gemaakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e345b95-d490-40c0-bdf1-6d23d1e95217",
                                "sense_id": "0b232192-cc13-360e-b716-bf6d760b1e49",
                                "text": "In het begin van zijn leven, onbereisd en onervaren, zou London misschien ook die stereotype beeldvorming hebben gekozen."
                            },
                            {
                                "example_id": "716cde81-f96d-4591-8526-110fe125a825",
                                "sense_id": "0b232192-cc13-360e-b716-bf6d760b1e49",
                                "text": "Mijn onbereisde gastheer heeft de klok wel horen luiden. Bijvoorbeeld dat hoeren bij ons legaal zijn en moordenaars na vijftien jaar weer vrij rondlopen. Wat dat betreft is onze reputatie in het buitenland van een bijzondere soort."
                            }
                        ]
                    },
