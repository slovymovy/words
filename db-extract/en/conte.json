                        "entry_id": "5387abee-97d2-32fd-b72d-3210fb8f6905",
                        "glosses": [
                            "An Italian count."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a310dbb4-9653-4124-9370-98f12ea948e2",
                                "sense_id": "7e856468-19cd-359c-bbac-b2a7dbb9097c",
                                "text": "So she led the way through a marble hall, pillared in different colors, rich and rare, with portraits of ancient contes and contessas on the walls, up a magnificent stone stair with a carved balustrade, to a suite indeed, where, at the entrance, Sibby was found very happy at her welcome from Mrs. Mount, who was equally glad to receive a countrywoman."
                            },
                            {
                                "example_id": "7156d95d-817f-4fac-baa7-4a810f45678d",
                                "sense_id": "7e856468-19cd-359c-bbac-b2a7dbb9097c",
                                "text": "“Aspirin. It will help you to sleep tonight if you have aches and pains, or cold clammy dreams about dead contes and contessas,” he teased."
                            },
                            {
                                "example_id": "370acb6c-ee40-4bb7-ba56-206840e8bc91",
                                "sense_id": "7e856468-19cd-359c-bbac-b2a7dbb9097c",
                                "text": "The announcement of the game had put Florentine society “in a flurry,” and two thousand spectators—including enough contes and contessas to fill half the palaces of Florence—made the trip beyond the city limits to view the match."
                            }
                        ]
                    }
