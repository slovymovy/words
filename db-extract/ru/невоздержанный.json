                        "cross_references": [
                            {
                                "target_word": "incontinent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0da583c4-fa36-3270-9570-eed827548c52",
                                        "entry_id": "a2c150f0-20a5-3ed3-9f91-85ec5314e12b",
                                        "glosses": [
                                            "Unable to contain or retain."
                                        ],
                                        "tags": [
                                            "often"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79017706-3122-3358-aad1-21321c7d50bb",
                                        "entry_id": "a2c150f0-20a5-3ed3-9f91-85ec5314e12b",
                                        "glosses": [
                                            "Plagued by incontinence; unable to retain natural discharges or evacuations, most commonly of urine or feces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de5ba988-f2fb-4a89-aa29-5feb4d1036b4",
                                                "sense_id": "79017706-3122-3358-aad1-21321c7d50bb",
                                                "text": "About 90% of all koalas have chlamydia... which makes them incontinent, so they spend all day pissing themselves."
                                            },
                                            {
                                                "example_id": "f6f2f6c1-a808-4810-b55a-50318a8128f8",
                                                "sense_id": "79017706-3122-3358-aad1-21321c7d50bb",
                                                "text": "The male body, opened and bleeding, can assume the shameful attributes of the incontinent female body as both cause of and justification for its evident vulnerability and defeat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d14e8d1e-3b76-3624-8000-2c0a5a9b725b",
                                        "entry_id": "a2c150f0-20a5-3ed3-9f91-85ec5314e12b",
                                        "glosses": [
                                            "Lacking moral or sexual restraint, moderation or self-control, especially of sexual desire."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "959f8dd8-f57d-333f-a457-92a5ec9a7459",
                                        "entry_id": "a2c150f0-20a5-3ed3-9f91-85ec5314e12b",
                                        "glosses": [
                                            "Unrestrained or unceasing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecfda23a-0ff7-4a37-8c62-0ada36f07a46",
                                                "sense_id": "959f8dd8-f57d-333f-a457-92a5ec9a7459",
                                                "text": "an incontinent river of pure water"
                                            },
                                            {
                                                "example_id": "1e553c28-60af-4787-90e5-658e1d63666d",
                                                "sense_id": "959f8dd8-f57d-333f-a457-92a5ec9a7459",
                                                "text": "[Jesus] was borne in Bethlem a City of Juda: where incontinent by the glorification of the Angels, the agnition of the Shepeherds, the veneration of the wiſe men, the prophecy of holy Simeon, and the admiration of the Doctours, he was had in honour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e82542f2-3aa2-3916-a5c0-f28808258d69",
                                        "entry_id": "a2c150f0-20a5-3ed3-9f91-85ec5314e12b",
                                        "glosses": [
                                            "Immediate; without delay."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "incontinent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d69a2678-f229-3db5-a34f-507745039a96",
                                        "entry_id": "6bddc57b-3589-3857-9ccb-670eac5c5c10",
                                        "glosses": [
                                            "Immediately, forthwith."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3baee528-9979-4fd9-84a7-e7fe082c146b",
                                                "sense_id": "d69a2678-f229-3db5-a34f-507745039a96",
                                                "text": "\"As how, my lambkin,\" blushing, she replide, / \"Because I in this dancing schoole abide? / If that it be, that breede's this discontent, / We will remoue the camp incontinent: / For shelter onelie, sweete heart, came I hither, / And to auoide the troblous stormie weather; / But now the coaste is cleare, we will be gonne, / Since, but thy self, true louer I haue none.\""
                                            },
                                            {
                                                "example_id": "1d584c9c-fa05-4a55-82a7-3152af8d470f",
                                                "sense_id": "d69a2678-f229-3db5-a34f-507745039a96",
                                                "text": "He says he will return incontinent:"
                                            }
                                        ]
                                    }
                                ]
                            },
