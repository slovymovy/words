                                "target_senses": [
                                    {
                                        "sense_id": "9fc3fe9a-4cb4-31f8-a34e-f970f5562bcc",
                                        "entry_id": "cac824f6-d612-36ea-854d-10fc64385f5b",
                                        "glosses": [
                                            "The sound of a heavy strike."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "60757490-e720-35db-8442-1e9c021d7ddb",
                                        "entry_id": "cac824f6-d612-36ea-854d-10fc64385f5b",
                                        "glosses": [
                                            "The strike itself."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51dcf23a-2ac9-4b5a-b08d-25e011ff87be",
                                                "sense_id": "60757490-e720-35db-8442-1e9c021d7ddb",
                                                "text": "Saka was a threat from the first whistle; Ukraine rightly wary of him and dishing out the usual whacks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7802fd3e-cbd3-3cd7-a97f-4f37e1898510",
                                        "entry_id": "cac824f6-d612-36ea-854d-10fc64385f5b",
                                        "glosses": [
                                            "The stroke itself, regardless of its successful impact."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fcaa492a-715b-3430-a78d-6cfaccdbe861",
                                        "entry_id": "cac824f6-d612-36ea-854d-10fc64385f5b",
                                        "glosses": [
                                            "An attempt, a chance, a turn, a go, originally an attempt to beat someone or something."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "834e843a-f9fd-489a-bf43-192ac2788ab2",
                                                "sense_id": "fcaa492a-715b-3430-a78d-6cfaccdbe861",
                                                "text": "C'mon. Take a whack at it."
                                            },
                                            {
                                                "example_id": "4af9099a-7382-4f6d-a983-94026e07b8a2",
                                                "sense_id": "fcaa492a-715b-3430-a78d-6cfaccdbe861",
                                                "text": "40 bucks a whack."
                                            },
                                            {
                                                "example_id": "446f2d91-e5d4-4164-9fa8-13c16ec1ab73",
                                                "sense_id": "fcaa492a-715b-3430-a78d-6cfaccdbe861",
                                                "text": "The number arrested is not over 600 — at $805 a whack, New Jersey has made half-a-million dollars arresting gay men."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0dcec2cc-6584-3aa4-8d44-38f9a4f7db8b",
                                        "entry_id": "cac824f6-d612-36ea-854d-10fc64385f5b",
                                        "glosses": [
                                            "A share, a portion, especially a full share or large portion."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98eaef46-0c6f-43f4-b523-90ee0dd16ba1",
                                                "sense_id": "0dcec2cc-6584-3aa4-8d44-38f9a4f7db8b",
                                                "text": "I don’t care about much wine afterwards—I take my whack at dinner—I mean my share, you know; and when I have had as much as I want I toddle up to tea."
                                            },
                                            {
                                                "example_id": "33a9facf-a8e6-40d3-b803-1a2fbee9edaf",
                                                "sense_id": "0dcec2cc-6584-3aa4-8d44-38f9a4f7db8b",
                                                "text": "“It’s damned tame, whatever it is, comin’ in here at feedin’ time an’ gettin’ its whack of fish.”"
                                            },
                                            {
                                                "example_id": "a70e3081-6adb-4863-8d14-a2135b1cd260",
                                                "sense_id": "0dcec2cc-6584-3aa4-8d44-38f9a4f7db8b",
                                                "text": "“[…] O'Cannon's a taxpayer. He pays his whack towards the upkeep of the State School up in town—”"
                                            },
                                            {
                                                "example_id": "dc44729c-cda9-4ae1-ae0e-ec226bb4eaae",
                                                "sense_id": "0dcec2cc-6584-3aa4-8d44-38f9a4f7db8b",
                                                "text": "For one thing I had a splendid supper when I got on board—a whack of cold, lean beef and pighells, bread, butter ad lib., tea, and plenty of good bread."
                                            },
                                            {
                                                "example_id": "513b2f37-b528-4b3d-866a-2f8bc83becda",
                                                "sense_id": "0dcec2cc-6584-3aa4-8d44-38f9a4f7db8b",
                                                "text": "There were problems over the installation of the engine and the handling. The team had paid top whack for the two Coopers, but the company gave them no help at all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5cea307-52e5-36fb-95b1-c84fda5adb64",
                                        "entry_id": "cac824f6-d612-36ea-854d-10fc64385f5b",
                                        "glosses": [
                                            "A whack-up: a division of an amount into separate whacks, a divvying up."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f877f988-67cd-3d56-8a7e-06b750e02bf1",
                                        "entry_id": "cac824f6-d612-36ea-854d-10fc64385f5b",
                                        "glosses": [
                                            "A deal, an agreement."
                                        ],
                                        "tags": [
                                            "US",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23b057bc-4583-46ec-9222-69bdb0336352",
                                                "sense_id": "f877f988-67cd-3d56-8a7e-06b750e02bf1",
                                                "text": "\"I'll stay if you will.\"\n\"Good—that's a whack.\""
                                            },
                                            {
                                                "example_id": "fe5542b6-f2a7-4440-bb3d-4cc37eec2d9d",
                                                "sense_id": "f877f988-67cd-3d56-8a7e-06b750e02bf1",
                                                "text": "It's a whack!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a611079-f0a9-3617-bcfb-8b81695859c7",
                                        "entry_id": "cac824f6-d612-36ea-854d-10fc64385f5b",
                                        "glosses": [
                                            "PCP, phencyclidine (as also wack)."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c1aa8c0e-7d93-300d-9e5d-ecec5f240f80",
                                        "entry_id": "cac824f6-d612-36ea-854d-10fc64385f5b",
                                        "glosses": [
