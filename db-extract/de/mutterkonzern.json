                ],
                "senses": [
                    {
                        "sense_id": "da67a781-7108-3ca1-9528-2e73e2025bf6",
                        "entry_id": "eb0f2d3a-6661-34e2-828a-77a00a53cee3",
                        "glosses": [
                            "Unternehmen in einem Unternehmensverbund, das beherrschenden Einfluss auf seine Tochterfirmen ausübt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5de31f56-07de-4be5-afcc-c050a2d21f06",
                                "sense_id": "da67a781-7108-3ca1-9528-2e73e2025bf6",
                                "text": "„Wenn Tochtergesellschaften in anderen Ländern aktiv sind, muss der Mutterkonzern eine Strategie erstellen und dokumentieren, welche Auswirkungen die Projekte auf die Umwelt, die lokale Bevölkerung und die Menschenrechte haben.“"
                            },
                            {
                                "example_id": "519c22f5-4d8f-4b43-a5c5-52a47a9e1494",
                                "sense_id": "da67a781-7108-3ca1-9528-2e73e2025bf6",
                                "text": "„In der Pandemie gingen jedoch zunächst die MV-Werften und später auch der Mutterkonzern insolvent.“"
                            },
                            {
                                "example_id": "c3efe23e-0636-4cb3-9c75-e4e1a30e9818",
                                "sense_id": "da67a781-7108-3ca1-9528-2e73e2025bf6",
                                "text": "„Am Sonntag schließt die Sana-Klinik in Bad Wildbad (Kreis Calw) endgültig ihre Pforten. Der Mutterkonzern hatte die Schließung im April angekündigt.“"
                            },
                            {
                                "example_id": "364064d8-e991-4d05-89f2-1b08ea761c0f",
                                "sense_id": "da67a781-7108-3ca1-9528-2e73e2025bf6",
                                "text": "„Der Sportwagenbauer hat den Mutterkonzern Volkswagen deutlich abgehängt, der seit Ende 2021 rund 44 Prozent seines Börsenwertes verloren hat.“"
                            },
                            {
                                "example_id": "e7edfcca-d8ef-48aa-8d9c-44ff59232fd3",
                                "sense_id": "da67a781-7108-3ca1-9528-2e73e2025bf6",
                                "text": "„Die V-Zug will flexibler werden und sich vom Mutterkonzern abspalten“"
                            },
                            {
                                "example_id": "28a725a6-8ebf-4909-8ddd-79d7cdf14a67",
                                "sense_id": "da67a781-7108-3ca1-9528-2e73e2025bf6",
                                "text": "„Am 15. Oktober 2018 beantragte der Mutterkonzern Sears Holdings Corporation Gläubigerschutz nach Chapter 11.“"
                            },
                            {
                                "example_id": "d9a56504-5da1-40dc-b568-98ec4f034eaa",
                                "sense_id": "da67a781-7108-3ca1-9528-2e73e2025bf6",
                                "text": "[…] „erst gestern hat Inditex, der Mutterkonzern von Zara und Bershka, einen Rekordgewinn für das dritte Quartal bekannt gegeben.“"
                            },
                            {
                                "example_id": "fd991ba8-cc2d-4cb7-8987-0a33e26e5ccd",
                                "sense_id": "da67a781-7108-3ca1-9528-2e73e2025bf6",
                                "text": "„Trotz der Rekordstrafe der EU-Kommission hat der Google-Mutterkonzern Alphabet im zweiten Quartal einen Milliardengewinn erzielt.“"
                            },
                            {
                                "example_id": "95af171b-478b-4189-979d-8320b92dbc52",
                                "sense_id": "da67a781-7108-3ca1-9528-2e73e2025bf6",
                                "text": "„Die Pilotengewerkschaft VC hat für Donnerstag einen 24-stündigen Streik bei Eurowings angekündigt.“ […] „Anfang September hatte bereits ein Pilotenstreik beim Mutterkonzern Lufthansa dessen Flugbetrieb fast vollständig lahmgelegt.“"
                            },
                            {
                                "example_id": "acedb03e-bb19-46a1-b0e7-892d751d5b97",
                                "sense_id": "da67a781-7108-3ca1-9528-2e73e2025bf6",
                                "text": "„Nach fünf Jahren bei der Financial Times Deutschland wechselte Jäkel 2004 wieder zum Mutterkonzern an den Baumwall und stieg zur Verlagsleiterin der Brigitte-Gruppe auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
