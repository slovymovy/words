                "senses": [
                    {
                        "sense_id": "7737b91f-a655-3b54-81de-86a28d798f8a",
                        "entry_id": "e95df86e-15c4-3c3b-a688-079f9a7731a4",
                        "glosses": [
                            "книжн., неодобр. пообещать что-либо в качестве побуждения к совершению неких действий, обычно недобропорядочных"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55860aaf-232a-472c-a835-d3298871844f",
                                "sense_id": "7737b91f-a655-3b54-81de-86a28d798f8a",
                                "text": "Стоило мне посулить вам деньги, как лечение пошло по-настоящему."
                            },
                            {
                                "example_id": "83ea8927-f63b-46c9-918b-3dd7838dde19",
                                "sense_id": "7737b91f-a655-3b54-81de-86a28d798f8a",
                                "text": "Предлагаю пойти им на уступки и посулить, что примем полк целиком и даже обезоруживать не будем."
                            }
                        ]
                    }
