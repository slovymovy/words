                        "entry_id": "36d84486-9c5f-3bf1-9dd8-7f15a5508b66",
                        "glosses": [
                            "komplexer Satz mit mehreren Teilsätzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d5a88eb-2bd1-43f5-9ee0-66dd9aa6fe4d",
                                "sense_id": "82b087e1-f702-375b-ab31-180fdd084ac6",
                                "text": "Heinrich von Kleist und Thomas Mann sind für ihre Satzperioden bekannt."
                            },
                            {
                                "example_id": "e9882ca3-1957-4793-ae36-c20c8629aaa6",
                                "sense_id": "82b087e1-f702-375b-ab31-180fdd084ac6",
                                "text": "„Unter einer Satzperiode wird ein mehrfach zusammengesetzter Satz verstanden, der durch die Nebenordnung mehrerer Satzgefüge oder durch Unterordnung mehrerer Nebensätze unter einen Hauptsatz entsteht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
