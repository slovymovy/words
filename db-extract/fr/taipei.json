                    },
                    {
                        "sense_id": "ba4d673a-85f8-334a-b362-422192148f7a",
                        "entry_id": "b38fb52e-9b2f-35c6-929e-ef7df5df422f",
                        "glosses": [
                            "Gouvernement de Taïwan (République de Chine)."
                        ],
