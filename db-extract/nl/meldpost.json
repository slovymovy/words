                        "sense_id": "deaade34-745e-3960-934f-a48b0715ecaf",
                        "entry_id": "c03007a3-41f0-32cd-95b1-9824e5634030",
                        "glosses": [
                            "een plaats waar men zich moet melden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec1509ba-6413-41d5-bba2-222f66c2f3ed",
                                "sense_id": "deaade34-745e-3960-934f-a48b0715ecaf",
                                "text": "Ten Brinke vertelde na de etappe dat hij vooral achterstand had opgelopen door het verwisselen van banden en het zoeken naar een meldpost. \"Het was erg zwaar in duinen en ik heb helaas wel tijd verloren, maar het goede nieuws is dat ik ben gestegen naar de vijfde plaats en daar ben ik blij mee.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "1ce1b304-b9d5-3dd4-8490-81846f34e219",
                        "entry_id": "c03007a3-41f0-32cd-95b1-9824e5634030",
                        "glosses": [
                            "een plaats van waaruit mededelingen worden gedaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54398157-de16-4996-a317-81c02586fee2",
                                "sense_id": "1ce1b304-b9d5-3dd4-8490-81846f34e219",
                                "text": "Rijkswaterstaat adviseert schippers van vaartuigen hoger dan 12 meter te luisteren naar de berichtgeving van de Centrale Meldpost IJsselmeergebied of te kijken naar teletekst pagina 721."
                            },
                            {
                                "example_id": "5a9b6055-e998-4602-8611-cd82537d1b15",
                                "sense_id": "1ce1b304-b9d5-3dd4-8490-81846f34e219",
                                "text": "Op Terschelling, en niet op de vaste wal zoals de minister oorspronkelijk voorstelde, komt een centrale verkeerspost voor de scheepvaart. Op vier torens, en mogelijk ook op die van Vlieland, wordt infraroodapparatuur geïnstalleerd, waarmee de scheepvaart op de Waddenzee in de gaten kan worden gehouden. De beelden worden permanent bekeken in de centrale meldpost. Het voordeel is dat ook 's nachts en bij mist waarnemingen kunnen worden gedaan."
                            }
                        ]
                    }
