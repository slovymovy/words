    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cedb3fb8-34fc-3e77-9bfd-f76bc82d72e0",
                    "sense_definition": "stoppen met een handeling of activiteit",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "stoppen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet nu echt <w>ophouden</w> met dat lawaai.",
                            "target_lang_translations": {
                                "en": "You really need to <w>stop</w> that noise now."
                            }
                        },
                        {
                            "text": "Hij <w>hield op</w> met praten toen de leraar binnenkwam.",
                            "target_lang_translations": {
                                "en": "He <w>stopped</w> talking when the teacher came in."
                            }
                        }
                    ],
                    "synonyms": [
                        "stoppen",
                        "uitscheiden"
                    ],
                    "antonyms": [
                        "beginnen"
                    ],
                    "common_phrases": [
                        "ophouden met",
                        "schei uit en hou op"
                    ],
                    "target_lang_definitions": {
                        "en": "to stop an action or activity"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stop",
                                "target_lang_sense_clarification": "to cease an activity"
                            },
                            {
                                "target_lang_word": "quit",
                                "target_lang_sense_clarification": "to stop doing something, often annoying"
                            },
                            {
                                "target_lang_word": "cease",
                                "target_lang_sense_clarification": "to bring to an end (formal)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb5432e8-691e-3893-addc-ded1126c887a",
                    "sense_definition": "tot een einde komen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "stoppen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De regen is eindelijk <w>opgehouden</w> na een lange dag.",
                            "target_lang_translations": {
                                "en": "The rain has finally <w>stopped</w> after a long day."
                            }
                        },
                        {
                            "text": "Waar de weg <w>ophoudt</w>, begint het bos.",
                            "target_lang_translations": {
                                "en": "Where the road <w>ends</w>, the forest begins."
                            }
                        }
                    ],
                    "synonyms": [
                        "stoppen",
                        "eindigen"
                    ],
                    "antonyms": [
                        "beginnen"
                    ],
                    "common_phrases": [
                        "zonder ophouden"
                    ],
                    "target_lang_definitions": {
                        "en": "to come to an end"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stop",
                                "target_lang_sense_clarification": "to come to a halt, like rain"
                            },
                            {
                                "target_lang_word": "end",
                                "target_lang_sense_clarification": "to finish or terminate"
                            },
                            {
                                "target_lang_word": "cease",
                                "target_lang_sense_clarification": "to stop existing or happening"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44f643fa-bc74-33f3-b8ff-8ea883ce2f01",
                    "sense_definition": "iemand of iets vertragen of belemmeren in de voortgang",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vertragen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sorry dat ik laat ben, ik werd even <w>opgehouden</w> op het werk.",
                            "target_lang_translations": {
                                "en": "Sorry I'm late, I was <w>held up</w> at work for a moment."
                            }
                        },
                        {
                            "text": "Je moet me niet langer <w>ophouden</w>, want ik heb haast.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>delay</w> me any longer, because I'm in a hurry."
                            }
                        }
                    ],
                    "synonyms": [
                        "hinderen",
                        "blokkeren"
                    ],
                    "common_phrases": [
                        "iemand ophouden"
                    ],
                    "target_lang_definitions": {
                        "en": "to delay or hinder someone or something in their progress"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hold up",
                                "target_lang_sense_clarification": "to delay someone"
                            },
                            {
                                "target_lang_word": "delay",
                                "target_lang_sense_clarification": "to make someone late"
                            },
                            {
                                "target_lang_word": "detain",
                                "target_lang_sense_clarification": "to keep someone from proceeding"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "941c4b3d-deec-3354-9ea9-c64d0c2099a0",
