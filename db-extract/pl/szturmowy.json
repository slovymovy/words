                ],
                "senses": [
                    {
                        "sense_id": "e31ee730-7f0a-3525-9359-b476ae0a3034",
                        "entry_id": "bd67f949-fc8d-361e-a929-6542cd71a283",
                        "glosses": [
                            "związany z szturmem, dotyczący szturmu, służący do szturmu, szturmowania"
                        ],
                        "tags": [],
