                        "sense_id": "19046551-1ce5-3656-b86e-fb1280673484",
                        "entry_id": "6c7661ae-5c39-3dc6-b7b1-38fa94a606ba",
                        "glosses": [
                            "een muziekinstrument met doorslaande tongen waarbij door trekken en duwen dezelfde toon wordt geproduceerd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a9df226-6fba-4bd6-a5d8-676b4b904111",
                                "sense_id": "19046551-1ce5-3656-b86e-fb1280673484",
                                "text": "De straatmuzikant speelde op zijn accordeon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ea4a6f64-dea2-41d7-beb7-25490094d0a6",
                        "source_entry_id": "6c7661ae-5c39-3dc6-b7b1-38fa94a606ba",
                        "source_sense_id": "19046551-1ce5-3656-b86e-fb1280673484",
                        "source_sense_description": "een muziekinstrument waarbij door trekken en duwen een toon wordt geproduceerd",
                        "target_lang_word": "Akkordeon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Akkordeon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "44577519-95ef-3a8b-9cf5-7dd3c406185b",
                                        "entry_id": "a1418b4c-1b48-3cb6-b21f-530b3f998ec3",
                                        "glosses": [
                                            "Musikinstrument mit Tasten oder Knöpfen, bei welchem der Ton durch eine Zunge, welche auf einer Grundplatte befestigt ist und durch einen Luftstrom, welcher mit einem Blasebalg erzeugt wird, in Schwingung versetzt, erzeugt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f918b735-eedf-46d7-b814-48b54e6f5a5b",
                                                "sense_id": "44577519-95ef-3a8b-9cf5-7dd3c406185b",
                                                "text": "Das Akkordeon gehört nicht zu den beliebtesten Instrumenten."
                                            },
                                            {
                                                "example_id": "535d24fc-93c7-46de-986e-460ad1d34295",
                                                "sense_id": "44577519-95ef-3a8b-9cf5-7dd3c406185b",
                                                "text": "Mike möchte lieber Gitarre als Akkordeon spielen lernen."
                                            },
                                            {
                                                "example_id": "6eef8d02-4a37-4171-a086-15ee6c5d51ba",
                                                "sense_id": "44577519-95ef-3a8b-9cf5-7dd3c406185b",
                                                "text": "„Ja, ich hatte das Akkordeon gehasst.“"
                                            },
                                            {
                                                "example_id": "81b0a140-14d6-4e4b-843c-f0d78e390432",
                                                "sense_id": "44577519-95ef-3a8b-9cf5-7dd3c406185b",
                                                "text": "„Folger mit seinem Akkordeon gab eigentlich die Melodie an, aber Hewlitt hatte die Gruppe zusammengestellt und bestand darauf, als Bandleader aufzutreten.“"
                                            },
                                            {
                                                "example_id": "d0b86f8d-3aa4-479f-a2d5-e02c935bab0a",
                                                "sense_id": "44577519-95ef-3a8b-9cf5-7dd3c406185b",
                                                "text": "„Sie komponierte zu den Versen ihres Mannes oder anderer Autoren ihre eigenen kleinen Weisen und Melodien, sang sie und begleitete sich dabei auf einem riesigen Akkordeon, das für ihre kleine Statur viel zu groß zu sein schien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1fd97427-6977-4e45-8afd-26dacf194fed",
                        "source_entry_id": "6c7661ae-5c39-3dc6-b7b1-38fa94a606ba",
                        "source_sense_id": "19046551-1ce5-3656-b86e-fb1280673484",
                        "source_sense_description": "een muziekinstrument waarbij door trekken en duwen een toon wordt geproduceerd",
                        "target_lang_word": "accordion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accordion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a038f493-87d2-339a-8e1e-b8d690169b1b",
                                        "entry_id": "4f0431be-6922-3bd2-92fc-ac236da96c32",
                                        "glosses": [
                                            "A box-shaped musical instrument played by compressing or expanding its bellows while pressing its buttons or its keys, causing pallets to open, which allow air to flow across strips of brass or steel (reeds)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "080b867e-63f5-4a16-9bab-eee37e6b75d9",
                                                "sense_id": "a038f493-87d2-339a-8e1e-b8d690169b1b",
                                                "text": "A disreputable accordion that had a leak somewhere and breathed louder than it squawked."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a88e169-b4dd-3ff9-a1a8-5d24e9afd8c8",
                                        "entry_id": "4f0431be-6922-3bd2-92fc-ac236da96c32",
                                        "glosses": [
                                            "A vertical list of items that can be individually expanded and collapsed to reveal their contents."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5a3f847b-bc1e-3509-abe8-74f173f51cc7",
                                        "entry_id": "4f0431be-6922-3bd2-92fc-ac236da96c32",
                                        "glosses": [
                                            "Something, or set of things (concepts, etc), which can be expanded (or extended) and collapsed, like the musical instrument's pleated, folding bellows."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85c50159-bd4f-4b70-9da7-a919ae9b9211",
                                                "sense_id": "5a3f847b-bc1e-3509-abe8-74f173f51cc7",
                                                "text": "See also: telescoping"
                                            },
                                            {
                                                "example_id": "7adb4b18-aa0b-4fdc-9ef3-e3d919e983f1",
                                                "sense_id": "5a3f847b-bc1e-3509-abe8-74f173f51cc7",
                                                "text": "\"Accordion\" skirts are named from the musical instrument of that title, because the peculiar plaiting draws out and falls together again, in the same kind of folds, and with the same effect."
                                            },
                                            {
                                                "example_id": "e9b47154-01a7-4931-aa03-1e901a3de2ff",
                                                "sense_id": "5a3f847b-bc1e-3509-abe8-74f173f51cc7",
                                                "text": "During the 1980s, accordion skirts became a popular style. Near the end of one winter season, I found a suit with a blazer-style jacket and an accordion-pleated skirt on sale at one of Birmingham's better department stores and placed it on layaway[…]"
                                            },
                                            {
                                                "example_id": "fe4efd87-5676-470a-9259-bba728d994f9",
                                                "sense_id": "5a3f847b-bc1e-3509-abe8-74f173f51cc7",
                                                "text": "[…] lugging their accordion cameras and bulky tripods from platform to hillock to ladder—even to the rooftop of a moving supply train—seeking to claim the most advantageous site for recording tomorrow's event."
                                            },
                                            {
                                                "example_id": "6e10fb18-afa8-4600-b07f-79f5beebba33",
                                                "sense_id": "5a3f847b-bc1e-3509-abe8-74f173f51cc7",
                                                "text": "I see myself losing you when the truth is we've just planted the pink bud of a love affair. There is no relationship here, and yet I look around this place and I have the disorienting sensation that I've been here for years. As if it's an intimate cove of my history and an accordion of memories lives here, only just beginning to unfold."
                                            },
                                            {
                                                "example_id": "716acfe2-f3ec-4d3a-b293-f4b9ad921c3d",
                                                "sense_id": "5a3f847b-bc1e-3509-abe8-74f173f51cc7",
                                                "text": "[…] her mind leaped forward many decades to a vision of her adult children […] This whole exchange would come to pass, subtracting the part about the sunporch and adding the latent disgust they eventually extended to her too, ducking her embrace whenever she reached for them, which was often. She'd remember this night in the yard and her vague premonition […] The accordion of memories would leave her feeling fated and alive and connected to every detail—the sharpening rod on the stoop, the red chiggers swarming on the well, the bark peeling off the birches, the crowded nettles. Of the moment in the country when everything fell apart."
                                            },
                                            {
                                                "example_id": "ec21d524-5d94-4072-bd86-dde533106591",
                                                "sense_id": "5a3f847b-bc1e-3509-abe8-74f173f51cc7",
                                                "text": "He'd walked to pick up Matty, every other step filled with hope and relief and the others weighed down by disappointment and what-ifs. It was with this strange accordion of feelings, sandwiched somewhere between catharsis and fresh hurt, that he'd gotten to school five minutes early."
                                            },
                                            {
                                                "example_id": "9e343f1b-6cf8-4160-8a50-49f838f7be5f",
                                                "sense_id": "5a3f847b-bc1e-3509-abe8-74f173f51cc7",
                                                "text": "The accordion of \"likeness\" stretches and squeezes in different places as different provisions of the WTO Agreement are applied. The width of the accordion in any one of those places must be determined by the particular provision[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "accordion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ba798fb2-4949-3c78-9179-1aae341b8762",
                                        "entry_id": "629c620f-ba20-361a-9b0d-b5d534f77ab1",
                                        "glosses": [
                                            "To fold up, in the manner of an accordion"
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e043225-4890-41c4-99ab-08426891921a",
                                                "sense_id": "ba798fb2-4949-3c78-9179-1aae341b8762",
                                                "text": "I slit the wrapping with my pocketknife and the clothesline accordioned out in stiff loops."
                                            },
                                            {
                                                "example_id": "c81c0690-b03f-4dee-8d11-26093241a89e",
                                                "sense_id": "ba798fb2-4949-3c78-9179-1aae341b8762",
                                                "text": "Still in reverse, she goosed the gas and accordioned the running board a fraction of an inch more."
                                            },
                                            {
                                                "example_id": "f37515ab-4ba3-4f86-94f8-6d6674fa97a7",
                                                "sense_id": "ba798fb2-4949-3c78-9179-1aae341b8762",
                                                "text": "It accordioned down and he tugged the shirt around it so that it came free[…]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98c2b110-140c-406d-8b19-f08035506662",
                        "source_entry_id": "6c7661ae-5c39-3dc6-b7b1-38fa94a606ba",
                        "source_sense_id": "19046551-1ce5-3656-b86e-fb1280673484",
                        "source_sense_description": "een muziekinstrument waarbij door trekken en duwen een toon wordt geproduceerd",
                        "target_lang_word": "accordéon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accordéon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b3168550-8990-3029-a4b0-89906f3d9125",
                                        "entry_id": "46f72ac5-06bf-36c9-9fec-641b7876f552",
                                        "glosses": [
                                            "Instrument à vent, composé d’un soufflet permettant le déplacement de l’air et de touches permettant des changements de tonalité, le son est produit par un système d’anches libres. Il dispose de deux claviers : l’un pour le chant à main droite, l’autre pour l’accompagnement à main gauche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23ab3046-6124-4b93-935b-e55e1d3c8f94",
                                                "sense_id": "b3168550-8990-3029-a4b0-89906f3d9125",
                                                "text": "Godefroid put arriver assez à temps au passage Vivienne pour acheter, avant que la boutique ne fermât, un magnifique accordéon qu’il fit partir devant lui pour M. Bernard, en en indiquant l’adresse."
                                            },
                                            {
                                                "example_id": "4217bd9d-996a-4202-8cc7-ef266e368353",
                                                "sense_id": "b3168550-8990-3029-a4b0-89906f3d9125",
                                                "text": "Un seul esquimau, Émile, dont j’ai pris la photographie en 1926 jouant de l’accordéon aux côtés de sa jeune femme, est mort d’un accident de chasse."
                                            },
                                            {
                                                "example_id": "28c4d42b-d2cf-49e1-aecc-6c437f86c6cf",
                                                "sense_id": "b3168550-8990-3029-a4b0-89906f3d9125",
                                                "text": "Les Mangaréviens, qui chantaient harmonieusement, se servaient fort mal de la mandoline et de l’accordéon, et jadis leurs instruments préférés pour les danses étaient les tambours en bois."
                                            },
                                            {
                                                "example_id": "688b9b16-443f-4fac-8227-05b0ea9da6c6",
                                                "sense_id": "b3168550-8990-3029-a4b0-89906f3d9125",
                                                "text": "Il y avait de la fesse ; le patron jouait de l’accordéon comme s’il tirait sur de la pâte à berlingot ; le litre de rouge, vingt sous : ça nous allait comme un gant."
                                            },
                                            {
                                                "example_id": "6b267cff-a011-446e-8e9e-1e0abb778940",
                                                "sense_id": "b3168550-8990-3029-a4b0-89906f3d9125",
                                                "text": "Dans le Paris des Républiques\nL’accordéon nostalgique\nA semé bien des musiques\nDont il reste des échos."
                                            },
                                            {
                                                "example_id": "331b8acc-31b4-4594-b2f4-02d3b93dd977",
                                                "sense_id": "b3168550-8990-3029-a4b0-89906f3d9125",
                                                "text": "Le vrai roi du guinche, la coqueluche, le mieux placé pour lever les frangines, c’est l’accordéon. Il étire son éventail en sanglots infinis, te balance le sentiment à la benne basculante, ça te prend au bide, à la gorge, ça te dégouline les vertèbres, te hérisse le poil tout du long."
                                            },
                                            {
                                                "example_id": "9ce910c7-6713-47fc-9b62-b5a65b024780",
                                                "sense_id": "b3168550-8990-3029-a4b0-89906f3d9125",
                                                "text": "Il y avait un chanteur qui s’accompagnait d’un accordéon, un joueur de guitare et un mandoliniste le secondaient. Les airs que le trio interprétait étaient tantôt gais et entraînants, tantôt plus langoureux […]."
                                            },
                                            {
                                                "example_id": "9650189e-fe73-4e7a-9f05-92850c6b1b3b",
                                                "sense_id": "b3168550-8990-3029-a4b0-89906f3d9125",
                                                "text": "La syntaxe moderne nous a déjà habitués à considérer la proposition comme un nexus, un noyau, fonctionnant à la manière d’un accordéon dont les éléments sont extensibles ou comprimables à volonté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a45e2d68-464e-3951-8673-e7a35fbff224",
                                        "entry_id": "46f72ac5-06bf-36c9-9fec-641b7876f552",
                                        "glosses": [
                                            "Définition manquante ou à compléter. (Ajouter)"
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35b1c347-df0b-4b33-b680-f190cc7d4dc9",
                                                "sense_id": "a45e2d68-464e-3951-8673-e7a35fbff224",
                                                "text": "On avançait lentement, en titubant aux cahots du train. Au dernier coude du couloir, à l’instant que le professeur allait s’élancer dans cette sorte d’accordéon qui relie un wagon à l’autre, une secousse plus forte le chavira"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01464963-69ff-4ace-a4fe-4bda2efff7fd",
