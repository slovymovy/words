                    },
                    {
                        "translation_id": "e40a7fa4-80d6-4c26-8d1e-70f7f8b1b159",
                        "source_entry_id": "3b7f41c6-0ecf-313f-8ad4-b6b6dc80eb65",
                        "source_sense_id": "ff2aab8f-c959-3311-a489-c5c8d0850827",
                        "target_lang_word": "Taler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Taler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9f48867b-aac8-3814-8e7f-50d26ce7ea4d",
                                        "entry_id": "1b50c858-3128-35ea-8efd-5987e4c0cdea",
                                        "glosses": [
                                            "eine ab dem 16. Jahrhundert geprägte große Silbermünze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "848ed119-4d15-4db2-802b-5c39a63b5f68",
                                                "sense_id": "9f48867b-aac8-3814-8e7f-50d26ce7ea4d",
                                                "text": "Hier geht es um richtige Taler, also strenge dich an."
                                            },
                                            {
                                                "example_id": "e69caf15-04ec-4dfb-97f3-17ad4be060d9",
                                                "sense_id": "9f48867b-aac8-3814-8e7f-50d26ce7ea4d",
                                                "text": "„»Das Mädchen«, sagte mir jetzt der Onkel, »ist eine gute Partie, so wie Sie sie hier sehen; denn sie hat dreitausend Taler. […] “"
                                            },
                                            {
                                                "example_id": "23eac86f-c5f5-44ae-9063-1d5a53b271e9",
                                                "sense_id": "9f48867b-aac8-3814-8e7f-50d26ce7ea4d",
                                                "text": "„Und als er nach dem Gesang zu ihr trat, hatte sie die fünf Groschen, die sie für ihn zurechtgelegt hatte, in einen Taler verwandelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0f5b9c86-c979-389f-9010-733079e92f47",
                                        "entry_id": "1b50c858-3128-35ea-8efd-5987e4c0cdea",
                                        "glosses": [
                                            "historische Währungseinheit"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1efad277-1e97-4ee6-a49e-8f7fd45da8f7",
                        "source_entry_id": "3b7f41c6-0ecf-313f-8ad4-b6b6dc80eb65",
                        "source_sense_id": "ff2aab8f-c959-3311-a489-c5c8d0850827",
                        "target_lang_word": "талер",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
