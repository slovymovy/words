                ],
                "senses": [
                    {
                        "sense_id": "009f937f-cc75-39e3-9057-19b8ba6727da",
                        "entry_id": "96d0a781-07fe-3e4f-8fac-1abbd10169a3",
                        "glosses": [
                            "Technicien spécialisé en électromécanique, combinant l’électricité et la mécanique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a7ef1f8-8f88-465e-8fa1-5c65cf24842f",
                                "sense_id": "009f937f-cc75-39e3-9057-19b8ba6727da",
                                "text": "À 20 ans, cet électromécanicien a perdu en janvier sa jambe droite après avoir été blessé dans une manifestation."
                            },
                            {
                                "example_id": "f5a9ecab-04a8-408c-9ade-cd7045495fe9",
                                "sense_id": "009f937f-cc75-39e3-9057-19b8ba6727da",
                                "text": "Ingénieur électromécanicien de formation, il a pris le temps d’enrichir son cursus scolaire de sérieux atouts avant de se lancer dans la vie professionnelle."
                            },
                            {
                                "example_id": "2b3b36cc-8af3-49c9-bba7-67a8df4a8ca4",
                                "sense_id": "009f937f-cc75-39e3-9057-19b8ba6727da",
                                "text": "Ils montreront par exemple un électromécanicien et une électromécanicienne chargés de la maintenance dans une centrale solaire et sur une rame de tramway."
                            },
                            {
                                "example_id": "c6c9e2e3-1554-47ac-9f49-96ee787496e0",
                                "sense_id": "009f937f-cc75-39e3-9057-19b8ba6727da",
                                "text": "Onze élèves vont même suivre l’année prochaine un bac professionnel d’électromécanicien par e-learning."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
