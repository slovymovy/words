                    {
                        "translation_id": "75fa2ec7-c996-4fc7-91ff-ee07ae79275d",
                        "source_entry_id": "9874ae94-c600-3691-b0f3-bc327c6bd3b5",
                        "source_sense_id": "6b6b566a-bdad-33f4-86b5-54f49927bb7d",
                        "source_sense_description": "a plant",
                        "target_lang_word": "cresson",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
