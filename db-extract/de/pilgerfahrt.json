                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf81f83d-7e70-46e3-8d25-af70bb137f7a",
                                "sense_id": "a4ee665b-325e-3d0f-b65f-6a89920b71f6",
                                "text": "Alle Gläubigen sollen einmal im Leben eine Pilgerfahrt machen.",
                                "translation": "Tous les croyants doivent faire un pèlerinage une fois dans leur vie"
                            },
                            {
                                "example_id": "9711fe8f-3593-465a-b840-c205d96d3f1f",
                                "sense_id": "a4ee665b-325e-3d0f-b65f-6a89920b71f6",
                                "text": "In Saudi-Arabien sind während der diesjährigen Pilgerfahrt mindestens 1.300 Menschen hitzebedingt zu Tode gekommen."
                            }
                        ]
                    }
