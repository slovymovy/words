                        "source_sense_id": "4ee30443-8758-3879-b399-461717158646",
                        "source_sense_description": "tending to cause discomfort, uneasiness or alarm; unsettling; troubling; upsetting",
                        "target_lang_word": "verontrustend",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
