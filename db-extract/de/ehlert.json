                ],
                "senses": [
                    {
                        "sense_id": "c36d7365-458d-37ff-9a1c-cb3ab6197ab6",
                        "entry_id": "6491973e-4a0d-3ef8-9d6b-c5494c0863b0",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7b59de3-9d5c-4448-b9fd-5435dcb9b0a4",
                                "sense_id": "c36d7365-458d-37ff-9a1c-cb3ab6197ab6",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ehlert kommt, geht der Herr Ehlert.“"
                            },
                            {
                                "example_id": "611cb185-5d3b-4c48-a1b6-c0fe4468b083",
                                "sense_id": "c36d7365-458d-37ff-9a1c-cb3ab6197ab6",
                                "text": "Ehlert kommt und geht."
                            },
                            {
                                "example_id": "40526efc-19bb-414a-b3c3-c90cffa5e513",
                                "sense_id": "c36d7365-458d-37ff-9a1c-cb3ab6197ab6",
                                "text": "Ehlerts kamen, sahen und siegten."
                            },
                            {
                                "example_id": "3b49c89a-a691-46fd-a840-b59cb1380553",
                                "sense_id": "c36d7365-458d-37ff-9a1c-cb3ab6197ab6",
                                "text": "Frau Ehlert ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "b18fca78-91f8-410f-a5ac-15b2ca7fe2f5",
                                "sense_id": "c36d7365-458d-37ff-9a1c-cb3ab6197ab6",
                                "text": "Herr Ehlert wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "422d7be6-ecf3-4780-b09e-f2e253ea04f7",
                                "sense_id": "c36d7365-458d-37ff-9a1c-cb3ab6197ab6",
                                "text": "Die Ehlerts kommen heute aus dem Wendland."
                            },
                            {
                                "example_id": "ad1159f9-e3a5-4094-be8a-9904f06a67ea",
                                "sense_id": "c36d7365-458d-37ff-9a1c-cb3ab6197ab6",
                                "text": "Der Ehlert trägt nie die Schals, die die Ehlert ihm strickt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
