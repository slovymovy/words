                    "sense_id": "aa9100bb-3e35-362f-bc4b-54ed0518b90c",
                    "sense_definition": "Een informele en liefkozende benaming voor een moeder.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "family_members",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn <w>mamma</w> leest mij elke avond een verhaaltje voor voor het slapengaan.",
                            "target_lang_translations": {
                                "ru": "Моя <w>мама</w> читает мне сказку каждый вечер перед сном.",
                                "en": "My <w>mommy</w> reads me a story every night before bedtime.",
                                "pl": "Moja <w>mama</w> czyta mi co wieczór bajkę przed snem.",
                                "de": "Meine <w>Mama</w> liest mir jeden Abend vor dem Schlafengehen eine Geschichte vor.",
                                "fr": "Ma <w>maman</w> me lit une histoire chaque soir avant de dormir.",
                                "it": "La mia <w>mamma</w> mi legge una storia ogni sera prima di andare a dormire.",
                                "cs": "Moje <w>máma</w> mi každý večer před spaním čte pohádku.",
                                "tr": "<w>Anneciğim</w> her akşam yatmadan önce bana bir masal okur.",
                                "es": "Mi <w>mamá</w> me lee un cuento cada noche antes de dormir.",
                                "zh": "我<w>妈妈</w>每天晚上睡觉前都会给我读故事。"
                            }
                        },
                        {
                            "text": "Toen ik viel, riep ik meteen om mijn <w>mamma</w>.",
                            "target_lang_translations": {
                                "ru": "Когда я упал, я сразу позвал <w>маму</w>.",
                                "en": "When I fell, I immediately called for my <w>mommy</w>.",
                                "pl": "Kiedy upadłem, od razu zawołałem <w>mamę</w>.",
                                "de": "Als ich hinfiel, rief ich sofort nach meiner <w>Mama</w>.",
                                "fr": "Quand je suis tombé, j'ai tout de suite appelé ma <w>maman</w>.",
                                "it": "Quando sono caduto, ho chiamato subito la mia <w>mamma</w>.",
                                "cs": "Když jsem upadl, hned jsem volal svou <w>maminku</w>.",
                                "tr": "Düştüğümde hemen <w>annemi</w> çağırdım.",
                                "es": "Cuando me caí, llamé inmediatamente a mi <w>mamá</w>.",
                                "zh": "我摔倒时，立刻喊了<w>妈妈</w>。"
                            }
                        }
