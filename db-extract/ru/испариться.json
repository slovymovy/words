                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verdampfen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a0d00160-848b-3e04-a50c-d371d88dd0d8",
                                        "entry_id": "44ee3d12-a23f-3497-8d25-4c6afc441663",
                                        "glosses": [
                                            "in die Gasphase übertreten"
                                        ],
                                        "tags": [
                                            "auxiliary verb",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa4342fe-3c6e-4d34-84a5-e7bde4c228d7",
                                                "sense_id": "a0d00160-848b-3e04-a50c-d371d88dd0d8",
                                                "text": "Je größer die Oberfläche, desto mehr Wasser verdampft darauf."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "539494ae-4cdf-378d-b8a4-20414f54b40d",
                                        "entry_id": "44ee3d12-a23f-3497-8d25-4c6afc441663",
                                        "glosses": [
                                            "etwas in die Gasphase überführen"
                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc7465b6-83d8-44ef-95fa-93fc32a5e33b",
                                                "sense_id": "539494ae-4cdf-378d-b8a4-20414f54b40d",
                                                "text": "Wenn du das Meerwasser verdampfst, bleibt das Salz übrig."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
