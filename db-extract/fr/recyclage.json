        "fr-extract.jsonl": [
            {
                "entry_id": "27e202a6-a4f2-39ed-ab9e-332b29658122",
                "word": "recyclage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "71ec9ce1-8ecf-4f68-a41a-92cd0df0221d",
                        "entry_id": "27e202a6-a4f2-39ed-ab9e-332b29658122",
                        "tags": [
                            "plural"
                        ],
                        "form": "recyclages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e36baccf-fcb9-3382-aaa0-53c9b5bb5d0f",
                        "entry_id": "27e202a6-a4f2-39ed-ab9e-332b29658122",
                        "glosses": [
                            "Action de recycler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b64856e4-8ea4-46bf-be77-4ab8362df437",
                                "sense_id": "e36baccf-fcb9-3382-aaa0-53c9b5bb5d0f",
                                "text": "Les activités du déchet pèsent pour une part importante dans ce chiffre, et leur part va croissant avec le développement du recyclage et de la revalorisation que l'on peut constater dans tous les pays et tous les domaines."
                            },
                            {
                                "example_id": "d466fdd1-2a47-4e8f-b43d-cd19b3585095",
                                "sense_id": "e36baccf-fcb9-3382-aaa0-53c9b5bb5d0f",
                                "text": "Il s’agit de M. Francis Malone, policier français qui dirige, à New York et à Paris, une enquête conjointe sur la corruption liée au trafic de drogue entre les deux pays et au recyclage de ses profits, ce qu’on appelle communément le blanchiment de l’argent sale."
                            },
                            {
                                "example_id": "232f1276-87b7-4e44-8e27-cfb93ee7a0fb",
                                "sense_id": "e36baccf-fcb9-3382-aaa0-53c9b5bb5d0f",
                                "text": "Les noms mêmes des petits métiers qui sont à la base de l'édifice du recyclage révèlent le côté dérisoire de ces occupations : plus spécialisés encore que le chiffonnier, il y a le ramasseur de crottes de chien, le ramasseur de bouts de cigare, etc."
                            },
                            {
                                "example_id": "c7270b7c-a039-4184-9cb1-59b6bdc6b272",
                                "sense_id": "e36baccf-fcb9-3382-aaa0-53c9b5bb5d0f",
                                "text": "\"Aller sur la Lune, c’est un peu une étape intermédiaire avant de pouvoir aller vers Mars\", illustre David Saint-Jacques. \"C’est vraiment des défis extrêmes. Avant de pouvoir aller sur Mars, il va falloir régler les questions de recyclage des ressources, de l’air et de l’eau. Ça va nous servir sur Terre.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "2060489d-c865-3062-90ff-7ad82f7d1323",
                        "entry_id": "27e202a6-a4f2-39ed-ab9e-332b29658122",
                        "glosses": [
                            "Renouvellement d’une formation dans le but de renouveler une habilitation."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "479ac616-2f48-4cfd-84a0-4397a6389c4a",
                        "source_entry_id": "27e202a6-a4f2-39ed-ab9e-332b29658122",
                        "target_lang_word": "Recycling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Recycling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fdd898a1-f3e0-357e-86bc-9901b093d5f1",
                                        "entry_id": "96bac6fe-3d17-3b12-8dfe-ef8e684a0a09",
                                        "glosses": [
                                            "Wiederverwertung von Abfallstoffen zur Herstellung von neuen Produkten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dde760a7-d7f4-439d-9e2c-2abdc35d852a",
                                                "sense_id": "fdd898a1-f3e0-357e-86bc-9901b093d5f1",
                                                "text": "Das Recycling dient der Müllreduzierung und zugleich der Schonung von Ressourcen."
                                            },
                                            {
                                                "example_id": "10048f33-4496-4c6e-b83f-3cdba2d681e6",
                                                "sense_id": "fdd898a1-f3e0-357e-86bc-9901b093d5f1",
                                                "text": "Recycling ist schon jetzt ein lukratives Geschäft."
                                            },
                                            {
                                                "example_id": "00709f30-7d92-4de5-9989-2106b28f9f43",
                                                "sense_id": "fdd898a1-f3e0-357e-86bc-9901b093d5f1",
                                                "text": "Früher wurde Müll in Deutschland einfach auf einer Müllkippe ins Feuer geworfen oder vergraben. Dann kamen die ersten Gesetze zur Mülltrennung. Heute ist das Recycling ein Milliardengeschäft"
                                            },
                                            {
                                                "example_id": "9bd4bff4-5011-40c4-a4f3-9ae8a5893cd1",
                                                "sense_id": "fdd898a1-f3e0-357e-86bc-9901b093d5f1",
                                                "text": "Die Bedeutung des Recyclings ist durch die Umweltbewegung in den 1970er und 1980er Jahren deutlich gestiegen."
                                            },
                                            {
                                                "example_id": "6afad1ed-a606-4c96-8117-7a346b891bb7",
                                                "sense_id": "fdd898a1-f3e0-357e-86bc-9901b093d5f1",
                                                "text": "„Im Zeichen des verheerenden Krieges erfanden Preußens Landwirtschaftsminister Clemens von Schorlemer und sein für Inneres zuständiger Kabinettskollege Wilhelm von Loebell das Recycling.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
