                                "example_id": "cf070294-f27f-42e3-b90d-352e1d3da663",
                                "sense_id": "06039d94-b308-33b0-98d2-92b1e63482fd",
                                "text": "Tijdens een hoorzitting gaf de Nucleaire Regulerende Commissie toestemming voor de bouw van een centrale met twee reactoren in de staat Georgia. De nieuwe installatie komt bij een bestaande kerncentrale te staan."
                            },
                            {
                                "example_id": "2c534c2c-ef30-4adb-ac6f-ae094ba8e940",
                                "sense_id": "06039d94-b308-33b0-98d2-92b1e63482fd",
                                "text": "De ITU, onderdeel van de Verenigde Naties, heeft plannen om een aantal regulerende taken over te nemen van de non-profitorganisatie ICANN (Internet Corporation for Assigned Names and Numbers)."
                            },
                            {
                                "example_id": "66ca97b9-de5f-470d-a880-76b395e863f6",
                                "sense_id": "06039d94-b308-33b0-98d2-92b1e63482fd",
                                "text": "Een woordvoerder van de Pakistaanse Elektronische Media Regulerende Autoriteiten (PEMRA) zegt dat de reclame over het algemeen werd gezien als 'niet-degelijk, immoreel en zonder enig respect voor onze sociaal-culturele en religieuze waarden'."
                            }
                        ]
