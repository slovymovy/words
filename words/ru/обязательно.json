                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Присутствие всех сотрудников на утреннем собрании <обязательно>.",
                            "target_lang_translations": {
                                "en": "The presence of all employees at the morning meeting is <mandatory>.",
                                "es": "La presencia de todos los empleados en la reunión matutina es <w>obligatoria</w>.",
                                "fr": "La présence de tous les employés à la réunion du matin est <obligatoire>."
                            }
                        },
                        {
                            "text": "Это правило строго и <обязательно> для исполнения всеми участниками.",
                            "target_lang_translations": {
                                "en": "This rule is strict and <binding> for all participants.",
                                "es": "Esta regla es estricta y de cumplimiento <w>obligatorio</w> para todos los participantes.",
                                "fr": "Cette règle est stricte et <obligatoire> pour tous les participants."
                            }
                        }
                    ],
