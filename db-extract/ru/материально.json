                    {
                        "translation_id": "18414845-bf3b-4a39-b37f-2f3292b8c16d",
                        "source_entry_id": "a5c10d4e-c291-3385-9e2d-32627ab269c5",
                        "source_sense_description": "через осязаемую форму, вещественно",
                        "target_lang_word": "materiell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "materiell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "57698ebc-c91e-3df5-8452-81cd625bb50b",
                                        "entry_id": "a9460629-3128-332f-92b2-87a98cd1b936",
                                        "glosses": [
                                            "auf Materie, das tatsächlich Vorhandene bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35d1d359-a9c8-4b5e-86d7-503fc24c67e5",
                                                "sense_id": "57698ebc-c91e-3df5-8452-81cd625bb50b",
                                                "text": "„Das Buch bleibt bis tief ins Hochmittelalter hinein ein Gegenstand der Verehrung und des Respekts, ein Numinosum als Wort- und Zeichenträger, ganz abgesehen von der Kostbarkeit im materiellen Sinn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "91e1baaa-6644-3ca8-be4c-f8f7338c3bad",
                                        "entry_id": "a9460629-3128-332f-92b2-87a98cd1b936",
                                        "glosses": [
                                            "auf das Eigentum bezogen, oft wirtschaftlich beziehungsweise finanziell"
                                        ],
                                        "tags": [
                                            "im übertragenen Sinne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "408274dc-2e3e-46a1-bdc7-ddbdf2452655",
                                                "sense_id": "91e1baaa-6644-3ca8-be4c-f8f7338c3bad",
                                                "text": "Der materielle Schaden ist nebensächlich; die Hauptsache ist, dass Du nicht verletzt bist."
                                            },
                                            {
                                                "example_id": "87768f03-948c-4351-8bdb-382c886d1f1e",
                                                "sense_id": "91e1baaa-6644-3ca8-be4c-f8f7338c3bad",
                                                "text": "Es wird beklagt, dass die Menschen heute nur noch ihre materiellen Interessen wahren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
