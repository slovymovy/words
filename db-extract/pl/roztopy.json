                                        "sense_id": "6895de58-1c59-3a57-bd76-423d2da8dded",
                                        "entry_id": "db411d77-3244-394f-a3e9-b488f97c5e41",
                                        "glosses": [
                                            "Vorgang der Verflüssigung eines Feststoffes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8c80a97-9df8-4265-9bc0-67b2d0c23b49",
                                                "sense_id": "6895de58-1c59-3a57-bd76-423d2da8dded",
                                                "text": "„Eine derart starke Schmelze an der Oberfläche des Grönlandeises haben Satelliten seit Beginn der Aufzeichnungen vor mehr als 30 Jahren noch nicht registriert.“"
                                            },
                                            {
                                                "example_id": "8e77e639-b9c6-47ba-babf-2bf325c1d795",
                                                "sense_id": "6895de58-1c59-3a57-bd76-423d2da8dded",
                                                "text": "„Grundlegend ausgelöst wurde die Schmelze durch den Klimawandel, der in den Höhenlagen für deutlich gestiegene Temperaturen sorgt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d65122b9-57f1-3849-addf-e629278a3d79",
                                        "entry_id": "db411d77-3244-394f-a3e9-b488f97c5e41",
                                        "glosses": [
                                            "flüssige Phase eines Feststoffes, die durch einen Schmelzvorgang entsteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "605ad760-400a-479d-b8c1-912118f6f9db",
                                                "sense_id": "d65122b9-57f1-3849-addf-e629278a3d79",
                                                "text": "„Beim Recycling von Schrott mit anhaftenden Fetten, Ölen und Lacken verbrennen diese zu Kohlendioxid und Wasser, das von der Schmelze zersetzt wird und sie mit Wasserstoff verunreinigt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
