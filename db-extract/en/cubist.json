                ],
                "senses": [
                    {
                        "sense_id": "7b9ddd52-c206-3d61-bb25-462a0c1043b6",
                        "entry_id": "ee5913ac-2279-312f-9696-dc27f4eca800",
                        "glosses": [
                            "An artist who works in the style of cubism."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecf0cecb-5b36-4a32-a2f9-eb5f4fe156ba",
                                "sense_id": "7b9ddd52-c206-3d61-bb25-462a0c1043b6",
                                "text": "To the world at large, relativity seemed to pull the rug out from under perceived reality. And for many advanced thinkers of the 1920s, from Dadaists to Cubists to Freudians, that was a fitting credo, reflecting what science historian David Cassidy calls \"the incomprehensiveness of the contemporary scene--the fall of monarchies, the upheaval of the social order, indeed, all the turbulence of the 20th century.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0fe7ff46-c52f-43de-9a85-502214eee177",
                        "source_entry_id": "ee5913ac-2279-312f-9696-dc27f4eca800",
                        "source_sense_id": "7b9ddd52-c206-3d61-bb25-462a0c1043b6",
                        "source_sense_description": "artist",
                        "target_lang_word": "Kubist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kubist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0dc1745e-171d-3233-aa2a-c23fa7be8e3c",
                                        "entry_id": "6acc982f-1ed9-3413-be46-045f14627347",
                                        "glosses": [
                                            "Vertreter des Kubismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8451039f-94f9-42eb-aafb-d555371ee447",
                                                "sense_id": "0dc1745e-171d-3233-aa2a-c23fa7be8e3c",
                                                "text": "„Im »Sturm« wurde die neue Kunst der Futuristen und Kubisten und vor allem der Expressionismus propagiert, der Aufstand gegen die wilhelminische Fassadenprotzerei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
