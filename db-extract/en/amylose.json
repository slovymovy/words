                                        "entry_id": "0ea674db-8f1e-3841-b597-ae2276d40be7",
                                        "glosses": [
                                            "Maladie caractérisée par la forte présence dans les tissus d'une matière appelée substance amyloïde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7ba170d-327e-4674-b385-552a63d772ef",
                                                "sense_id": "21050d8f-bc71-359a-ae49-905b657049a4",
                                                "text": "Les amyloses sont un ensemble de maladies rares provoquées par l'accumulation de dépôts de protéines insolubles dans les tissus."
                                            },
                                            {
                                                "example_id": "182a2df8-77c9-450f-aaf1-d03a97006800",
                                                "sense_id": "21050d8f-bc71-359a-ae49-905b657049a4",
                                                "text": "Lorsqu'il s'agit d'une amylose plus diffuse, les fibrilles amyloïdes sont constituées de transthyrétine."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "amylose",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f8bb57bd-ee37-385b-9854-dc552ccae74c",
                                        "entry_id": "e06db901-6fb1-342c-a982-cf22ab9d1a65",
                                        "glosses": [
                                            "Polyoside non ramifié constitué d’unités D-glucose liées par liaison α(1→4) et principal constituant de l’amidon avec l’amylopectine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d95491e-d6b7-4779-8d3f-a4acfd19b8db",
                                                "sense_id": "f8bb57bd-ee37-385b-9854-dc552ccae74c",
                                                "text": "Il est à noter que la gélification de l'amylose est un processus cinétique dont la rapidité va dépendre de la concentration en amidon ainsi que de la teneur en amylose de cet amidon."
                                            }
                                        ]
                                    }
                                ]
                            }
