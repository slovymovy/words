                ],
                "senses": [
                    {
                        "sense_id": "ce418f54-982f-36c7-bb69-63472c514288",
                        "entry_id": "ece7f1e5-2361-3045-85e0-44371537dcaf",
                        "glosses": [
                            "Einziehen der Luft in die Lunge"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98e85ae1-aa3b-46c6-a38f-80f34da32b0c",
                                "sense_id": "ce418f54-982f-36c7-bb69-63472c514288",
                                "text": "„Du konntest nachvollziehen, dass das Atemholen, also das ‚Sauerstofftanken‘, der elementarste Prozess unseres Organismus ist, ohne den alle anderen physiologischen und vegetativen Funktionen gar nicht denkbar sind.“"
                            },
                            {
                                "example_id": "22e76d80-35b9-4352-b096-233c72009958",
                                "sense_id": "ce418f54-982f-36c7-bb69-63472c514288",
                                "text": "„Mit einem heiseren Keuchen stieß er die Luft aus den Lungen. Zum Atemholen ließen ihm seine Gegner nicht genug Zeit. Ein weiterer Treffer erwischte ihn gegen die Brust.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d014107f-d5fa-3282-8059-167f9d837799",
                        "entry_id": "ece7f1e5-2361-3045-85e0-44371537dcaf",
                        "glosses": [
                            "(kurze) Unterbrechung einer Tätigkeit oder Handlung zur Erholung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5771a9f4-ebd4-4e5d-910c-904b397b2341",
                                "sense_id": "d014107f-d5fa-3282-8059-167f9d837799",
                                "text": "„Ich kam in letzter Zeit mal wieder kaum zum Atemholen.“"
                            },
                            {
                                "example_id": "78d9d985-f3cf-4087-9396-e5af2fb44562",
                                "sense_id": "d014107f-d5fa-3282-8059-167f9d837799",
                                "text": "„Zum Atemholen und Nachdenken, fuhr ich dann im Sommer allein in den Faistenhaarer Wald.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
