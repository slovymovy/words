                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee5c3983-77cf-483f-9e73-34b1a221f7aa",
                                "sense_id": "a3d835f4-a148-35ca-af9f-fb73174aa508",
                                "text": "They sent a pleasant and refreshing fragrance far around, and shook sorrowfully the leaves of their white flowers over the reflected picture of the landscape in the mirror of the lake, which on all sides was surrounded by pine trees and mossy cliffs."
                            },
                            {
                                "example_id": "36fa13fe-390f-41af-a7b0-89b73242876d",
                                "sense_id": "a3d835f4-a148-35ca-af9f-fb73174aa508",
                                "text": "Sorrowfully Dorothy left the Throne Room and went back where the Lion and the Scarecrow and the Tin Woodman were waiting to hear what Oz had said to her. \"There is no hope for me,\" she said sadly, \"for Oz will not send me home until I have killed the Wicked Witch of the West; and that I can never do.\""
                            }
                        ]
                    }
