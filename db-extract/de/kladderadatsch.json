                "senses": [
                    {
                        "sense_id": "5148336c-e3d9-31b9-91fa-9bd619c2a664",
                        "entry_id": "b5dbfcf3-3908-3742-8e05-a2c73a148d9a",
                        "glosses": [
                            "Chaos, désordre total."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "093263c0-53d5-4bff-962c-09411b5e7760",
                                "sense_id": "5148336c-e3d9-31b9-91fa-9bd619c2a664",
                                "text": "Das endete mit einem großen Kladderadatsch. - ça s'est terminé dans une grande confusion"
                            },
                            {
                                "example_id": "eee1787d-f3d2-493a-9bc3-c3ed1801790d",
                                "sense_id": "5148336c-e3d9-31b9-91fa-9bd619c2a664",
                                "text": "Ich habe den ganzen Kladderadatsch in den Müll geschmissen. - j'ai mis tout ce bazar à la poubelle"
                            }
                        ]
                    },
                    {
                        "sense_id": "75e04ffc-bb73-39bf-9e16-9cec539f3baa",
                        "entry_id": "b5dbfcf3-3908-3742-8e05-a2c73a148d9a",
                        "glosses": [
