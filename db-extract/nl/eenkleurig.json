                        "examples": [
                            {
                                "example_id": "3f50af31-3b49-4ebf-81d6-da5035962c14",
                                "sense_id": "982ac2ab-61aa-3ee2-8f44-21358a7e4526",
                                "text": "Let hier op het fijne contrast tussen de rij politiemannen links en de studenten rechts. De politie eenkleurig groen, stokstijf en nors. De studenten bont, beweeglijk en vrolijk. Links alle armen naar beneden, rechts alle armen omhoog."
                            },
                            {
                                "example_id": "aedd6f0b-7b7a-48d4-a915-6d80091205d9",
                                "sense_id": "982ac2ab-61aa-3ee2-8f44-21358a7e4526",
                                "text": "Politici die kledingstatements maken, zijn er al langere tijd. ,Denk maar aan Prinsjesdag waar veel vrouwen met hun hoedje willen laten zien waar ze voor staan’, zegt Van Veen. En meer internationaal is er Hillary Clinton in haar eenkleurige broekpakken, Margaret Thatcher in haar saffierblauwen outfits - met parelketting én zwarte handtas - en natuurlijk de Belgische premier Di Rupio met zijn flamboyante strikjes."
                            },
                            {
                                "example_id": "71f5531f-3c36-4ed4-9491-34275bdf162b",
                                "sense_id": "982ac2ab-61aa-3ee2-8f44-21358a7e4526",
                                "text": "Waren veertien jaar geleden minderheden nog minder zichtbaar, er is nu veel meer en agressiever weerstand tegen een minder eenkleurige samenleving."
                            }
                        ]
                    }
