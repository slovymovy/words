                "forms": [],
                "senses": [
                    {
                        "sense_id": "29605be7-309f-3515-91cb-0bf8597849e2",
                        "entry_id": "572f19c6-0bcf-3258-9b80-9733464fb1a3",
                        "glosses": [
                            "Portique fermé, élevé en avant de la nef, dans les anciennes basiliques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cc6aabc-345e-495c-ba6e-cb6fda777625",
                                "sense_id": "29605be7-309f-3515-91cb-0bf8597849e2",
                                "text": "Enfin, l’entrée principale, le portique d’honneur de certaines Églises, telles que celles de Vézelay, de Paray-le-Monial, de Saint-Germain l’Auxerrois, à Paris, est précédé d’un vestibule couvert, souvent profond et volontairement sombre, appelé narthex. Le baptistère était autrefois sous ce porche. C’était un lieu d’attente et de pardon, une figure du purgatoire ; c’était l’antichambre du ciel dans laquelle stationnaient, avant d’être admis à pénétrer dans le sanctuaire, les pénitents et les néophytes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f7a46f3-7132-4c96-97df-92b2a4d53c83",
                        "source_entry_id": "572f19c6-0bcf-3258-9b80-9733464fb1a3",
                        "source_sense_id": "29605be7-309f-3515-91cb-0bf8597849e2",
                        "target_lang_word": "Narthex",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Narthex",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "824392e7-3122-39e0-bda2-a16760388815",
                                        "entry_id": "1d5a6e16-64e2-3036-b98e-58c321ea41a4",
                                        "glosses": [
                                            "schmale Vorhalle im Inneren einer altchristlichen und byzantinischen Basilika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfaa54ea-b59c-4a28-8f35-0a6d5a2ba3af",
                                                "sense_id": "824392e7-3122-39e0-bda2-a16760388815",
                                                "text": "„Hier waren die vorderen Türen, die den Narthex verschlossen, aber Dunphy war vom hinteren Ende heruntergefallen, hinter dem Altarraum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e7c06515-834e-389f-bcb2-c41a0df16976",
                                        "entry_id": "1d5a6e16-64e2-3036-b98e-58c321ea41a4",
                                        "glosses": [
                                            "Pflanze, die zu den Doldenblütlern gehört und im Mittelmeerraum verbreitet ist"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d0ef484-d314-4fd4-8644-880c88266444",
                        "source_entry_id": "572f19c6-0bcf-3258-9b80-9733464fb1a3",
                        "source_sense_id": "29605be7-309f-3515-91cb-0bf8597849e2",
                        "target_lang_word": "Vorhalle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vorhalle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "475911cb-7e89-3f2b-a870-9e344b3f2df9",
                                        "entry_id": "eca10cc0-8e8f-3d7a-b687-957a963edff1",
                                        "glosses": [
                                            "großer Raum, der in einem Anwesen zuerst betreten wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8df24c4-5461-4390-883d-0210b4112f83",
                                                "sense_id": "475911cb-7e89-3f2b-a870-9e344b3f2df9",
                                                "text": "„Die Vorhalle mündete auf einen dunklen Gang, von dem eine steinerne Wendeltreppe nach oben führte.“"
                                            },
                                            {
                                                "example_id": "a22ba3aa-c3bc-4f1b-80c4-f03a3a86ccae",
                                                "sense_id": "475911cb-7e89-3f2b-a870-9e344b3f2df9",
                                                "text": "„Als wir die große Vorhalle betraten, roch es sehr merkwürdig und stark.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "783dba5a-2d06-3c12-93dd-e3bf5518c4cb",
                                        "entry_id": "eca10cc0-8e8f-3d7a-b687-957a963edff1",
                                        "glosses": [
                                            "vorgelagerte Halle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cab006d9-a0e1-4a86-80e8-7f0070763b6e",
                                                "sense_id": "783dba5a-2d06-3c12-93dd-e3bf5518c4cb",
                                                "text": "„Dort befand sich auf der Westseite eine dreiräumige Vorhalle, in der man die dort harrenden Leute mit Tee zu bewirten pflegte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
