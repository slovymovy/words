                "translations": [
                    {
                        "translation_id": "a8f51dfb-ad30-42c5-929b-60b50ceeaf29",
                        "source_entry_id": "a73e9567-e7d0-38c3-baae-d9930a1bc0ca",
                        "source_sense_description": "of, or relating to myths or mythology",
                        "target_lang_word": "mytologický",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mytologický",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "1d292f9a-4afe-36ce-949f-02f495ca0c73",
                                        "entry_id": "6302aa10-59d3-3e15-9763-dea770e6b95c",
                                        "glosses": [
                                            "související s mytologií"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb122d1e-2422-4a05-8feb-625f64770d25",
                                                "sense_id": "1d292f9a-4afe-36ce-949f-02f495ca0c73",
                                                "text": "Všude nalézáme stejné mytologické formy a stejné pohádkové motivy; pohádky vznikly všude na světě ze stejných náboženských předpokladů."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7198cbda-a896-42d7-b1f1-ef2d144e8bfb",
                        "source_entry_id": "a73e9567-e7d0-38c3-baae-d9930a1bc0ca",
                        "source_sense_description": "of, or relating to myths or mythology",
                        "target_lang_word": "mythologisch",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mythologisch",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2094cc90-8e4b-3059-99e8-f1d0c5b51425",
                                        "entry_id": "ee15cd1d-f84e-3cd9-8954-a04b5bec60f5",
                                        "glosses": [
                                            "betrekking hebbend of voorkomend in verzonnen verhalen over het verleden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97646c2e-84a1-4a66-ae1c-3dbb2fbcb042",
                                                "sense_id": "2094cc90-8e4b-3059-99e8-f1d0c5b51425",
                                                "text": "Een elf, een draak en een eenhoorn zijn mythologische wezens"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62d88985-4654-309c-b463-c697323dcca6",
                                        "entry_id": "ee15cd1d-f84e-3cd9-8954-a04b5bec60f5",
                                        "glosses": [
                                            "heel erg groot of bijzonder"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da84168b-a6cd-4046-80cb-f894ec4efc52",
                                                "sense_id": "62d88985-4654-309c-b463-c697323dcca6",
                                                "text": "De prestaties van de vroegere spits kregen steeds meer mythologische eigenschappen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64b93cf8-0ec4-496e-9f3e-e8a4b5e9e095",
                        "source_entry_id": "a73e9567-e7d0-38c3-baae-d9930a1bc0ca",
                        "source_sense_description": "of, or relating to myths or mythology",
                        "target_lang_word": "mythologique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mythologique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6f44d360-fc15-3de2-a305-adc611d6ed78",
                                        "entry_id": "54cc637c-fa20-38d5-9ee7-190ff1207274",
                                        "glosses": [
                                            "Relatif à la mythologie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb674b05-451c-463a-b4eb-5efb431adc54",
                                                "sense_id": "6f44d360-fc15-3de2-a305-adc611d6ed78",
                                                "text": "Des dynasties mythologiques à la sainte famille, parricide, yeux crevés, trahisons, péchés, remords, châtiments et martyre des victimes expiatoires, toute cette marmelade glaireuse et sanglante s’est prêtée à mille variations."
                                            },
                                            {
                                                "example_id": "3d5854a2-fa4e-444e-8675-c8eab7261ce8",
                                                "sense_id": "6f44d360-fc15-3de2-a305-adc611d6ed78",
                                                "text": "Ces lieux communs mythologiques et ce cliquetis de mots sonores, mais à peu près vides de sens, plurent au roi Sighebert et à ceux des seigneurs Francs qui, comme lui, comprenaient quelque peu la poésie latine."
                                            },
                                            {
                                                "example_id": "84a03274-f1cc-40f8-9c8e-214793a3c882",
                                                "sense_id": "6f44d360-fc15-3de2-a305-adc611d6ed78",
                                                "text": "Naît alors, nourri d’un voyage en Italie de 8 ans (1770-1778), une œuvre singulière : peintures mythologiques, sujets shakespeariens, représentations de songes, avec une esthétique nouvelle, qui tend vers le fantastique, des anatomies michelangelesques, une énergie, un mouvement et un souffle hors du commun."
                                            },
                                            {
                                                "example_id": "f1780fc4-27e0-43b0-abd7-26c2860fcaad",
                                                "sense_id": "6f44d360-fc15-3de2-a305-adc611d6ed78",
                                                "text": "Notre incompréhension devant l’inconnu a dressé aux quatre coins du monde un atlas mythologique. Des centaines d'endroits où la virginité et le merveilleux se sont mués en eldorados, en paradis perdus, en enfers verts, en mirages et en abîmes."
                                            },
                                            {
                                                "example_id": "2d1a9357-ba9c-4554-944c-9d36e16a9d0a",
                                                "sense_id": "6f44d360-fc15-3de2-a305-adc611d6ed78",
                                                "text": "Et c'est vrai qu'à la fois il mythologisait — du fait qu'il n'avait pas de relations courantes avec la population, disons, qu'il héroïsait les grandes figures mythologiques du peuple français, de l'ouvrier français."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "683f4f4b-0e1b-4c73-9110-2d4219ceb6d2",
                        "source_entry_id": "a73e9567-e7d0-38c3-baae-d9930a1bc0ca",
                        "source_sense_description": "of, or relating to myths or mythology",
                        "target_lang_word": "mythologisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mythologisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d6673bbd-eb9b-37cb-8033-f377ae9fb8cb",
                                        "entry_id": "7cb6b44c-4bd5-36d4-8f84-4dc5d68dc629",
                                        "glosses": [
                                            "die Mythologie betreffend; auf Mythologie beruhend; zur Mythologie gehörig; in der Art der Mythologie (seiend)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5df94011-b731-41e0-8fd2-97fc076b1675",
                                                "sense_id": "d6673bbd-eb9b-37cb-8033-f377ae9fb8cb",
                                                "text": "Von den mythologischen Gestalten sind die griechischen Götter die bekanntesten."
                                            },
                                            {
                                                "example_id": "4a52de21-188a-4513-8075-9b95914a8919",
                                                "sense_id": "d6673bbd-eb9b-37cb-8033-f377ae9fb8cb",
                                                "text": "„Wahrscheinlich flossen diese Knochenfunde auch in die mythologische Welt des indigenen Volkes ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7ae4de5-4d02-4bd5-b0ec-1ac4e5fc3908",
