                        "glosses": [
                            "Nom donné à celui qui prônait une grande latitude d’interprétation sur les points controversés de la théologie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "feeb4e74-16a2-40ed-b934-6def6f9a2284",
                                "sense_id": "862527f1-492f-3849-8c5e-7613db5a01c4",
                                "text": "En recommandant à Edward de conserver la pureté de sa vie et de ses mœurs, de soutenir avec fermeté les principes de la religion chrétienne, d’éviter la compagnie impie des railleurs et des latitudinaires, trop nombreux dans l'armée."
                            }
                        ]
