                ],
                "translations": [
                    {
                        "translation_id": "36aed9c2-0c8b-4b04-96d6-c750259ac046",
                        "source_entry_id": "82eda479-cbca-3278-9a97-d5059ac83758",
                        "source_sense_id": "6b37db30-64fc-388d-8b24-c664296afee6",
                        "target_lang_word": "complicate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "complicate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c53c3382-8299-3b0e-be52-8ab0b4e95a1e",
                                        "entry_id": "266f1889-558b-38ff-abfc-4989101dca12",
                                        "glosses": [
                                            "To make complex; to modify so as to make something intricate or difficult."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f05f4d0-312a-4b08-8b22-42c04671542b",
                                                "sense_id": "c53c3382-8299-3b0e-be52-8ab0b4e95a1e",
                                                "text": "Let us, however, put aside for the moment the mendacities and forgeries which complicate the question of Lucifer, and let us approach Palladism from an altogether different side."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c744b9f-26d0-3090-b6c3-7a5dd103f182",
                                        "entry_id": "266f1889-558b-38ff-abfc-4989101dca12",
                                        "glosses": [
                                            "To involve in a convoluted matter."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a21b11c-5871-4b40-b51c-986522d87f22",
                                                "sense_id": "3c744b9f-26d0-3090-b6c3-7a5dd103f182",
                                                "text": "Don't complicate yourself in issues that are beyond the scope of your understanding."
                                            },
                                            {
                                                "example_id": "5e46b91d-bb38-4bf1-89a1-53e1791062cc",
                                                "sense_id": "3c744b9f-26d0-3090-b6c3-7a5dd103f182",
                                                "text": "John has been complicated in the affair by new tapes that surfaced."
                                            },
                                            {
                                                "example_id": "19780f38-1e66-4a71-9045-3156662c5ded",
                                                "sense_id": "3c744b9f-26d0-3090-b6c3-7a5dd103f182",
                                                "text": "The DA has made every effort to complicate me in the scandal."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "complicate",
                                "target_lang_code": "en",
                                "target_senses": [
