                ],
                "senses": [
                    {
                        "sense_id": "aadfe597-3641-38b1-a448-d9403eb9c455",
                        "entry_id": "c7699c04-dd2b-392a-b9dd-7af55827c64a",
                        "glosses": [
                            "Relatif à l’adjectif, qui en a le caractère, la fonction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "216ba852-5db6-473b-a5e0-cae94dfe33b6",
                                "sense_id": "aadfe597-3641-38b1-a448-d9403eb9c455",
                                "text": "En effet, grâce à des rimes isosexuelles dont la morphologie nominale ou adjectivale est exclusivement féminine, elle s'affranchit de la règle séculaire d'alternance du sexe des rimes et consacre ainsi le sonnet à la féminité."
                            },
                            {
                                "example_id": "a3341a14-eab5-4107-8ed1-fa6e67ef194a",
                                "sense_id": "aadfe597-3641-38b1-a448-d9403eb9c455",
                                "text": "Un suffixe adjectival. Une locution adjectivale."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e2157035-e317-4944-b2a9-9aee34ce1b83",
                        "source_entry_id": "c7699c04-dd2b-392a-b9dd-7af55827c64a",
                        "source_sense_id": "aadfe597-3641-38b1-a448-d9403eb9c455",
                        "target_lang_word": "adjektivisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adjektivisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b73be33d-b28e-3953-a8b0-7b65d5d74e44",
                                        "entry_id": "d6d07b9b-ffef-33b7-8f58-e19f6643552d",
                                        "glosses": [
                                            "das Eigenschaftswort (Adjektiv) betreffend; so wie ein/als Adjektiv"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcd057ca-e4ad-4235-9411-6423356b9eda",
                                                "sense_id": "b73be33d-b28e-3953-a8b0-7b65d5d74e44",
                                                "text": "„Plücker entschied sich bei seinem neuen Substantiv für die adjektivische Deklination, also im Genitiv Singular und im Dativ Singular ‚der Chordalen‘.“"
                                            },
                                            {
                                                "example_id": "573db232-d775-45ff-9fc0-44f39693d3f6",
                                                "sense_id": "b73be33d-b28e-3953-a8b0-7b65d5d74e44",
                                                "text": "„Ich gab ihnen adjektivische Namen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9138e5b0-424d-48db-8ba7-ccf9da011fc3",
                        "source_entry_id": "c7699c04-dd2b-392a-b9dd-7af55827c64a",
                        "source_sense_id": "aadfe597-3641-38b1-a448-d9403eb9c455",
                        "target_lang_word": "adjectival",
