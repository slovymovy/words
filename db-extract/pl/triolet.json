                                            {
                                                "example_id": "b942afdd-49b6-4f6b-bc7b-3f925423fc6b",
                                                "sense_id": "cd53587e-bcfd-308e-a7f6-6261111a598f",
                                                "text": "The triolet, like the sestina and several other forms of French-derived poetry, is a form of rhyming poetry that has lines that repeat."
                                            }
