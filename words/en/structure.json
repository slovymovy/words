                    "sense_id": "93a786c8-f244-3b16-aa0d-08ee18376b62",
                    "sense_definition": "A building or other object constructed from several parts, especially a large or complex one.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient stone <w>structure</w> has survived for more than a thousand years.",
                            "target_lang_translations": {
                                "ru": "Древнее каменное <w>сооружение</w> сохранилось более тысячи лет.",
                                "tr": "Tarihi taş <w>yapı</w> bin yıldan fazla bir süredir varlığını sürdürmüştür.",
                                "pl": "Ta starożytna kamienna <w>budowla</w> przetrwała ponad tysiąc lat.",
                                "zh": "这座古老的石制<w>建筑物</w>已经存在了一千多年。"
                            }
                        },
                        {
                            "text": "They built a temporary wooden <w>structure</w> in the garden for the party.",
