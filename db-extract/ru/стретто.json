                                    {
                                        "sense_id": "5a7b8a34-051e-34da-86a1-4bc2ba20e90c",
                                        "entry_id": "39788694-42a5-3ee1-9a61-15fa8883ea04",
                                        "glosses": [
                                            "Partie d’une fugue, dans laquelle les différentes voix répètent un fragment du sujet, chacune commençant avant que l’autre ait fini, ce qui forme un dialogue vif et pressé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4776eed-c682-4125-a2ea-0a2f0fbcac67",
                                                "sense_id": "5a7b8a34-051e-34da-86a1-4bc2ba20e90c",
                                                "text": "Le diable musique, ce démon qui secoue un trousseau étincelant de strettes, de trilles et d’arpèges, se fut emparé du pauvre sourd."
                                            },
                                            {
                                                "example_id": "2c34bd7c-21ca-44a2-ae86-498d90b65483",
                                                "sense_id": "5a7b8a34-051e-34da-86a1-4bc2ba20e90c",
                                                "text": "La Stilla se laissait emporter alors à toute la fougue de cette enlevante strette du chant final…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37089975-90df-3073-be26-212392a82ee3",
                                        "entry_id": "39788694-42a5-3ee1-9a61-15fa8883ea04",
                                        "glosses": [
                                            "Partie d’un morceau d’un rythme plus vif et serré précédant souvent la conclusion."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
