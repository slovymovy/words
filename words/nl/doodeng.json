                        "angstaanjagend",
                        "huiveringwekkend"
                    ],
                    "antonyms": [
                        "geruststellend"
                    ],
                    "common_phrases": [
                        "echt doodeng",
                        "doodeng in het donker",
                        "doodeng gevoel"
                    ],
                    "traits": [
