                                "target_senses": [
                                    {
                                        "sense_id": "5a5b8c3d-c85e-3429-86f3-e05d77836cff",
                                        "entry_id": "431fcc9c-bb46-31c3-9f86-7c9dd65bcabb",
                                        "glosses": [
                                            "A numerical value after two and before four. Represented in Arabic digits as 3; this many dots (•••)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1cecbae-5974-41cd-960a-74be5c6ac304",
                                                "sense_id": "5a5b8c3d-c85e-3429-86f3-e05d77836cff",
                                                "text": "Venters began to count them—one—two—three—four—on up to sixteen."
                                            },
                                            {
                                                "example_id": "8350e9f2-1b56-4567-a5b6-5bddf658d17f",
                                                "sense_id": "5a5b8c3d-c85e-3429-86f3-e05d77836cff",
                                                "text": "There is a soft-mat seat (which originally had a palm fiber underwebbing) supported by three curved transverse braces."
                                            },
                                            {
                                                "example_id": "58ada4f9-7235-46b6-878e-6a66cae03354",
                                                "sense_id": "5a5b8c3d-c85e-3429-86f3-e05d77836cff",
                                                "text": "Okay, on three, we open the door and jump on the rope. One, two…\nWait, wait! Do we go on three? Or do we go on “go”?\nThree! Who said anything about “go”?"
                                            },
                                            {
                                                "example_id": "5c881285-4b7d-46ef-95ac-da249c9e4bd0",
                                                "sense_id": "5a5b8c3d-c85e-3429-86f3-e05d77836cff",
                                                "text": "Now we continue zooming-in in three different directions depending on the number of ones."
                                            },
                                            {
                                                "example_id": "767dbead-7ace-4c42-9b70-021e3d0a5cd4",
                                                "sense_id": "5a5b8c3d-c85e-3429-86f3-e05d77836cff",
                                                "text": "Why should she care? One…two…\nDo we shoot on three?\nYes on three. Like one, two, three, shoot."
                                            },
                                            {
                                                "example_id": "e4392da4-06f1-49d7-bdae-38225b199e43",
                                                "sense_id": "5a5b8c3d-c85e-3429-86f3-e05d77836cff",
                                                "text": "The beetles are named Binburrum articuno, Binburrum moltres and Binburrum zapdos after three rare Pokémon: Articuno, Moltres and Zapdos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38d89fe1-894c-3344-9e9f-420440d5c0a1",
                                        "entry_id": "431fcc9c-bb46-31c3-9f86-7c9dd65bcabb",
                                        "glosses": [
                                            "Describing a set or group with three elements."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "three",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0521b870-5e50-33f3-bc9d-acad887eddd9",
                                        "entry_id": "23ff49ee-61f9-326a-b894-34569d0fdcf0",
                                        "glosses": [
                                            "The digit/figure 3."
