                        "examples": [
                            {
                                "example_id": "de318b53-0345-4e44-a98e-3d0c142c7c3f",
                                "sense_id": "6bd709e7-b3f4-326f-948b-2c3dc7d94811",
                                "text": "Met de 2-3 overwinning houdt Groningen zicht op een terugkeer naar de eredivisie. Ook de periodetitel ligt nog binnen handbereik. FC Groningen speelt begin april een inhaalduel met FC Emmen en kan bij winst het bronzen kampioensschild in ontvangst nemen."
                            },
                            {
                                "example_id": "5a6ec9d0-f529-4594-892b-92f811675e69",
                                "sense_id": "6bd709e7-b3f4-326f-948b-2c3dc7d94811",
                                "text": "Ook de periodetitel ligt nog voor het grijpen. FC Groningen speelt begin april een inhaalduel tegen FC Emmen en mag bij winst in deze wedstrijd het bronzen kampioensschild in ontvangst nemen."
                            }
                        ]
