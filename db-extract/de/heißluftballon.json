                "senses": [
                    {
                        "sense_id": "8b04ed3d-388d-387a-a857-a2cc61ae8e6a",
                        "entry_id": "ae78943f-0e1d-3726-a4e5-d9a3962f87bf",
                        "glosses": [
                            "Montgolfière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eadf6075-935c-4996-ad01-b0ee9d861165",
                                "sense_id": "8b04ed3d-388d-387a-a857-a2cc61ae8e6a",
                                "text": "Ein Heißluftballon, erklärte der ältere. Pilâtre de Rozier, der Mitarbeiter der Montgolfiers, weile zur Zeit im nahen Braunschweig. Die ganze Stadt rede davon. Bald würden alle Menschen in die Luft steigen.",
                                "translation": "Un ballon à air chaud, expliqua l’aîné. Pilâtre de Rozier, le collaborateur des Montgolfier, était en ce moment tout près d’ici, à Brunswick. La ville entière en parlait. Bientôt, tous les hommes pourraient s’élever dans les airs."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
