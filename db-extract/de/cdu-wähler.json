                ],
                "senses": [
                    {
                        "sense_id": "0f376c44-ce55-38b7-a69d-e50ea2fc3fb3",
                        "entry_id": "d44ed545-a25c-3fb9-b475-4ee6593922e7",
                        "glosses": [
                            "Person, die bei einer Wahl für die Christlich Demokratische Union Deutschlands (CDU) gestimmt hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d5e4012-39b4-49df-a15d-d402df8c8db7",
                                "sense_id": "0f376c44-ce55-38b7-a69d-e50ea2fc3fb3",
                                "text": "„Das Gros der CDU-Wähler hat das Rentenalter erreicht.“"
                            },
                            {
                                "example_id": "16123955-d380-4b17-95b6-526b61a6cc11",
                                "sense_id": "0f376c44-ce55-38b7-a69d-e50ea2fc3fb3",
                                "text": "„Die Nachwahlanalysen zeigen: In den letzten vier Jahren sind mehr CDU-Wähler gestorben, nämlich zehntausend, als an irgendeine andere Partei abgewandert sind.“"
                            },
                            {
                                "example_id": "e8c2871a-54fd-4471-ae45-ed16f589c442",
                                "sense_id": "0f376c44-ce55-38b7-a69d-e50ea2fc3fb3",
                                "text": "„»Für viele CDU-Wähler haben Wahlen eine Art Pflichtcharakter […].«“"
                            },
                            {
                                "example_id": "382ab1d5-6dcf-4bd1-b05f-5e8f23ee783a",
                                "sense_id": "0f376c44-ce55-38b7-a69d-e50ea2fc3fb3",
                                "text": "„Die CDU-Wähler wollen eine konservative und nicht eine grüne CDU.“"
                            },
                            {
                                "example_id": "142c78fc-6a9d-423d-8608-6f127cada353",
                                "sense_id": "0f376c44-ce55-38b7-a69d-e50ea2fc3fb3",
                                "text": "„Der Weg zum Nichtwähler und vom Nichtwähler wieder zum CDU-Wähler ist nicht allzu weit.“"
                            },
                            {
                                "example_id": "7f1d6db0-7cc2-4a35-9ac5-df11102e57b8",
                                "sense_id": "0f376c44-ce55-38b7-a69d-e50ea2fc3fb3",
                                "text": "„Sogar die Mehrheit der CDU-Wähler (51 Prozent) würde Neuwahlen begrüßen.“"
                            },
                            {
                                "example_id": "10d5bc5c-2201-487e-8dfa-4a0c94907ebd",
                                "sense_id": "0f376c44-ce55-38b7-a69d-e50ea2fc3fb3",
                                "text": "„Der sogenannte Wanderungssaldo zeigt aber auch: Längst nicht nur enttäuschte CDU-Wähler machten diesmal ihr Kreuz bei der AfD.“"
                            },
                            {
                                "example_id": "1ea433d4-1b6f-4186-b961-334eec22a0a3",
                                "sense_id": "0f376c44-ce55-38b7-a69d-e50ea2fc3fb3",
                                "text": "Angela Merkel hat die Partei über viele Jahre nach links verschoben […] Doch das hat seinen Preis: Die Umfrageergebnisse gingen auf historisch schlechte Werte unter 30 Prozent zurück; CDU-Wähler wechselten zur AfD."
                            },
                            {
                                "example_id": "ee356ed3-657f-4214-b5b5-c04199a16d1a",
                                "sense_id": "0f376c44-ce55-38b7-a69d-e50ea2fc3fb3",
                                "text": "[Winfried Kretschmann:] „Auch bei den Wählern anderer Parteien kommt er auf extrem hohe Zustimmungswerte: 89 Prozent der SPD- und 81 Prozent der CDU-Wähler halten ihn für einen guten Ministerpräsidenten.“"
                            },
                            {
                                "example_id": "8f8ae218-b4b8-42f4-86b5-827f031c2c02",
                                "sense_id": "0f376c44-ce55-38b7-a69d-e50ea2fc3fb3",
                                "text": "„»Selbst CDU-Wähler in Thüringen halten Bodo Ramelow aber durchaus als geachteten Landesvater und jetzt nicht als sozialistischen Revolutionär.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
