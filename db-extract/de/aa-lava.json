                "senses": [
                    {
                        "sense_id": "c977e7ff-9e4b-30e2-b91c-25408c9d8232",
                        "entry_id": "20ec8cea-f3f3-352c-814e-125984f00e64",
                        "glosses": [
                            "sehr zähflüssige und langsam fließende Lava, die arm an Quarz ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd27b7ca-4797-4918-9e42-d1a469f01c90",
                                "sense_id": "c977e7ff-9e4b-30e2-b91c-25408c9d8232",
                                "text": "„Basaltische Lavaergüsse werden in Pahoehoe- und Aa-Lava differenziert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6dd60f37-cdc7-4a51-8f02-b4c57ed60267",
                        "source_entry_id": "20ec8cea-f3f3-352c-814e-125984f00e64",
                        "source_sense_id": "c977e7ff-9e4b-30e2-b91c-25408c9d8232",
                        "source_sense_description": "Geologie: sehr zähflüssige und langsam fließende Lava, die arm an Quarz ist",
                        "target_lang_word": "aa",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aa",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "101b5e63-fc46-39ea-8cd0-48fc8e7e3daf",
                                        "entry_id": "0b78ab37-9d3b-3920-b428-b910b1f53d8b",
                                        "glosses": [
                                            "A form of lava flow associated with Hawaiian-type volcanoes, consisting of basaltic rock, usually dark-colored with a jagged and loose, clinkery surface. Compare pahoehoe."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a71225b6-1874-4872-86c2-3959099b07b1",
                                                "sense_id": "101b5e63-fc46-39ea-8cd0-48fc8e7e3daf",
                                                "text": "We...saw ‘pahoihoi’ or solid lava forming, and also ‘aa’ or clinkers."
                                            },
                                            {
                                                "example_id": "9c1a91bf-8d6a-4b01-bfa7-b2424b2c8817",
                                                "sense_id": "101b5e63-fc46-39ea-8cd0-48fc8e7e3daf",
                                                "text": "Cooling and solidification frequently takes a different course [...] in lava flows, producing the clinker-like ‘aa’ lava."
                                            },
                                            {
                                                "example_id": "ea4846df-c11f-44d8-936b-8b49ee5f3aa1",
                                                "sense_id": "101b5e63-fc46-39ea-8cd0-48fc8e7e3daf",
                                                "text": "Both pahoehoe and aa lava flows are common on the upper slopes of Mauna Loa with a preponderance of aa flows found at the lower elevations."
                                            }
                                        ]
                                    }
                                ]
                            },
