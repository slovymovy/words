                        "entry_id": "1c3d184b-7eb8-337f-bb00-411399b0e0a4",
                        "glosses": [
                            "Relatif à l’Oregon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7d6bf90-ba4d-4661-a8a9-6ffa2705f70a",
                                "sense_id": "0667fef5-0afd-3f0b-94fd-e778721d5044",
                                "text": "Dans le même temps [2004], les dépenses des visiteurs orégonais au Canada ont augmenté de 16 %, pour se chiffrer à 105 millions de dollars."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "accdc5c3-c9e4-433b-bd18-9ccc9dda90e3",
                        "source_entry_id": "1c3d184b-7eb8-337f-bb00-411399b0e0a4",
                        "source_sense_id": "0667fef5-0afd-3f0b-94fd-e778721d5044",
                        "target_lang_word": "Oregonian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Oregonian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1258c36d-c574-396a-9ee7-5c4de757e1c7",
                                        "entry_id": "07886fb9-897a-3ad6-823e-a34168545412",
                                        "glosses": [
                                            "A native or resident of the state of Oregon in the United States of America."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f9bfcf6-78ba-4851-ab56-17dab80cf404",
                                                "sense_id": "1258c36d-c574-396a-9ee7-5c4de757e1c7",
                                                "text": "Born and raised in Salem, he was admittedly an Oregonian through and through, though he secretly hated it."
                                            },
                                            {
                                                "example_id": "b4b62e74-796f-483f-b8b4-71a646126ca3",
                                                "sense_id": "1258c36d-c574-396a-9ee7-5c4de757e1c7",
                                                "text": "The problems between where he currently lives and his old city, he said, begin with rural Oregonians living fundamentally different lifestyles than people in the city of Portland."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Oregonian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5877997-6179-301c-a78e-dc09ee594e42",
                                        "entry_id": "e59562f6-4bfe-342f-be13-b8c49e5edd95",
                                        "glosses": [
                                            "Of or pertaining to Oregon."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e033c92-3079-4ae7-b7a4-1834d58346fb",
                                                "sense_id": "f5877997-6179-301c-a78e-dc09ee594e42",
                                                "text": "His insistence on wearing thick wool scarves, even in the summertime, derived from his uniquely Oregonian sense of fashion."
                                            },
                                            {
                                                "example_id": "faf64796-4ae9-47fc-a21d-df6558ec6bf0",
                                                "sense_id": "f5877997-6179-301c-a78e-dc09ee594e42",
                                                "text": "But she sympathized most on the issue of government representation of the rural Oregonian region."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "0a464a98-d0a1-3814-bdc6-05a98c4e9d7e",
                "word": "Orégonais",
