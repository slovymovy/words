                "senses": [
                    {
                        "sense_id": "f4532c6e-8387-3d48-b2da-4747cf6df42c",
                        "entry_id": "b283e53f-9acc-39e8-9e2d-d863c98fa7b5",
                        "glosses": [
                            "Einrichtung, in der speziell für Studenten/Studentinnen Zimmer/Wohnungen zur Miete angeboten werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e19f554-ab3a-44c6-993b-95717e009ae4",
                                "sense_id": "f4532c6e-8387-3d48-b2da-4747cf6df42c",
                                "text": "Im Studentenheim wird am Freitag eine Party gefeiert."
                            },
                            {
                                "example_id": "1b2fc96e-44b0-4f18-9b6d-7fb71506f0f5",
                                "sense_id": "f4532c6e-8387-3d48-b2da-4747cf6df42c",
                                "text": "„Sie führte mich nach einer Premierenfeier in das Wäldchen, das neben ihrem (unbetretbaren) Studentenheim lag.“"
                            },
                            {
                                "example_id": "3bf49bf5-a190-40e9-aa94-82e0b9c69e8d",
                                "sense_id": "f4532c6e-8387-3d48-b2da-4747cf6df42c",
                                "text": "„Er wohnte in einem Studentenheim, und wir mussten uns hineinschmuggeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
