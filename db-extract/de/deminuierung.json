                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0174e3b8-184f-42df-b93f-881fac6c2dc7",
                                "sense_id": "a9f59ce6-f258-3514-8f83-50d37ad6f3e8",
                                "text": "„Die Deminuierung des Begriffes ‚jetzt‘ ist originell, doch nicht ohne Sinn.“"
                            },
                            {
                                "example_id": "f682e840-5441-448f-974a-fcb8ee73bce5",
                                "sense_id": "a9f59ce6-f258-3514-8f83-50d37ad6f3e8",
                                "text": "„Vor allem ist es der ironische und verächtliche Sinn des Deminutivums, dem ich den germanischen Ursprung absprechen möchte, nicht minder die Deminuierung der Abstracta.“"
                            },
                            {
                                "example_id": "216f90ee-054b-4406-a406-1edd626d5a1e",
                                "sense_id": "a9f59ce6-f258-3514-8f83-50d37ad6f3e8",
                                "text": "„Besonders gut gelungen ist meines Erachtens die Beschreibung der Deminuierung […].“"
                            },
                            {
                                "example_id": "39930ce0-621c-47ed-bbff-0d8375952c3a",
                                "sense_id": "a9f59ce6-f258-3514-8f83-50d37ad6f3e8",
                                "text": "„In Eroticis war die Deminuierung nicht selten […]“"
                            },
                            {
                                "example_id": "ee914a6d-3634-49ec-b79b-3e7b97d1ee66",
                                "sense_id": "a9f59ce6-f258-3514-8f83-50d37ad6f3e8",
                                "text": "„Die erste Entscheidung wird hier für korrekter gehalten, da im Ungarischen doppelte Deminuierung möglich ist: […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
