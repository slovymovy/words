                "senses": [
                    {
                        "sense_id": "e7c2a0cd-636e-34a7-a42e-91111a310a62",
                        "entry_id": "393a132f-3c93-3ee4-8731-3ae62426e0d0",
                        "glosses": [
                            "das Resultat, das man bei einem Test anstrebt, erreichen möchte; der Zustand oder Wert, der nachgewiesen werden soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c91f76e-fafc-4d9c-bdf7-3d1dcfd0beee",
                                "sense_id": "e7c2a0cd-636e-34a7-a42e-91111a310a62",
                                "text": "„Die Ergebnisabweichung zeigt, daß bei Berücksichtigung der tatsächlich ausgefallenen aperiodischen Posten das Sollergebnis (10% des betriebsbedingten Kapitals) nur bei dem Erzeugnis A erreicht wurde.“"
                            },
                            {
                                "example_id": "4d9a9fac-6688-4824-92f2-b0997d3b709c",
                                "sense_id": "e7c2a0cd-636e-34a7-a42e-91111a310a62",
                                "text": "„Wichtigste Anforderung im Rahmen der Testauswertung ist die automatische Prüfung der Testergebnisse gegen die definierten Sollergebnisse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
