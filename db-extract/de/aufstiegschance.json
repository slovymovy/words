                "senses": [
                    {
                        "sense_id": "93a8fba0-b482-3607-869e-803923b030d8",
                        "entry_id": "734825e0-718a-3343-8fd8-cab76376c386",
                        "glosses": [
                            "Möglichkeit auf (beruflichen) Aufstieg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5ab1b61-d28c-4f2b-996d-2400ebc226ff",
                                "sense_id": "93a8fba0-b482-3607-869e-803923b030d8",
                                "text": "„Wie bei allen afrikanischen Lehrern waren seine Aufstiegschancen begrenzt, denn «afrikanische Lehrer wurden gesellschaftlich diskriminiert und konnten niemals hoffen, in eine Leitungsfunktion befördert zu werden, egal, wie fähig sie dazu waren».“"
                            },
                            {
                                "example_id": "e153ffab-b86a-43ea-bd3b-1f134983258c",
                                "sense_id": "93a8fba0-b482-3607-869e-803923b030d8",
                                "text": "„Allerdings geht es nicht um den Notendurchschnitt von Kindern aus den oberen Schichten, sondern darum, Kindern aus niedrigeren Schichten die gleichen Aufstiegschancen zu geben wie den Erstgenannten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
