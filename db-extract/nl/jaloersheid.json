                    }
                ],
                "translations": [
                    {
                        "translation_id": "1fc1bfb1-e281-407e-af28-dab247d27437",
                        "source_entry_id": "3bff6d23-4ea7-3c0f-a043-327a1d818e73",
                        "source_sense_id": "0f7b3f9e-d54b-304c-9db3-28f82a2c80b4",
                        "source_sense_description": "een wrok die iemand koestert omdat men een ander niet gunt wat men zelf begeert",
                        "target_lang_word": "Eifersucht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Eifersucht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d7050716-3ccc-3935-aa42-893d54c97f71",
                                        "entry_id": "99e8c09c-c873-3604-955a-3ce1b94c4bd1",
                                        "glosses": [
                                            "krankhafter Neid, meist ausgelöst durch tatsächliche oder scheinbare Bevorzugung anderer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a71a073-7c84-4e73-a691-92b3756cd4d0",
                                                "sense_id": "d7050716-3ccc-3935-aa42-893d54c97f71",
                                                "text": "Sie leidet unter seiner ständigen Eifersucht."
                                            },
                                            {
                                                "example_id": "c6ac0d04-fa68-4c0e-aad4-8eeae73bcffb",
                                                "sense_id": "d7050716-3ccc-3935-aa42-893d54c97f71",
                                                "text": "Eifersucht ist ein Problem des mangelnden Vertrauens."
                                            },
                                            {
                                                "example_id": "acbd9f97-5fca-4f22-aeb8-55dae60afdbf",
                                                "sense_id": "d7050716-3ccc-3935-aa42-893d54c97f71",
                                                "text": "Er hat Angst sie zu verlieren und leidet selbst unter seiner Eifersucht, kann aber nichts dagegen tun."
                                            },
                                            {
                                                "example_id": "accc2a7d-1a6f-45b8-95f1-e333b3d9afa3",
                                                "sense_id": "d7050716-3ccc-3935-aa42-893d54c97f71",
                                                "text": "„Die Eifersucht schleicht sich ein.“"
                                            },
                                            {
                                                "example_id": "54ec9dcb-8136-4f13-9d2d-3659fcf5d471",
                                                "sense_id": "d7050716-3ccc-3935-aa42-893d54c97f71",
                                                "text": "„Ein Gran Eifersucht erhöht den Reiz, den der Betrachter empfindet.“"
                                            },
                                            {
                                                "example_id": "21f5cb9c-fa48-4550-8cd0-cd9fbefd33db",
                                                "sense_id": "d7050716-3ccc-3935-aa42-893d54c97f71",
                                                "text": "„Die Erzählung enthält jedoch keine Spur von Eifersucht, sie stellt vielmehr einige Kriegsfolgen und vor allem auf eine groteske Art die Vermieter dar.“"
                                            },
                                            {
                                                "example_id": "530c22bb-f91c-4518-b9ff-07e630e25ab4",
                                                "sense_id": "d7050716-3ccc-3935-aa42-893d54c97f71",
                                                "text": "„Bald empfand er Eifersucht auf Nataschas Vergangenheit, bald schalt er sich selbst deswegen, bald verzieh er es sich wieder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a352daf5-1847-4ffa-9147-03a57830f499",
                        "source_entry_id": "3bff6d23-4ea7-3c0f-a043-327a1d818e73",
                        "source_sense_id": "0f7b3f9e-d54b-304c-9db3-28f82a2c80b4",
                        "source_sense_description": "een wrok die iemand koestert omdat men een ander niet gunt wat men zelf begeert",
                        "target_lang_word": "jealousy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jealousy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "298d466f-57fd-3bd9-8166-fdd637deec62",
                                        "entry_id": "b6431a3a-2c2b-39a7-9246-68584b4961d7",
                                        "glosses": [
                                            "A state of being jealous; a jealous attitude."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d5b06f1-e898-464d-b040-d518aa12cb23",
                                                "sense_id": "298d466f-57fd-3bd9-8166-fdd637deec62",
                                                "text": "Jealousy was, however, aroused among the English nobility at the favouritism shown the Dutch newcomer."
                                            },
                                            {
                                                "example_id": "2cab928e-1730-4ec8-8ada-6b44722d590b",
                                                "sense_id": "298d466f-57fd-3bd9-8166-fdd637deec62",
                                                "text": "[…]the jealousy of his foes of each other's share in the booty[…]."
                                            },
                                            {
                                                "example_id": "b4b6dfa7-45b8-440c-aace-70550ffb3dee",
                                                "sense_id": "298d466f-57fd-3bd9-8166-fdd637deec62",
                                                "text": "He knew what it was like to feel jealousy over the possessions of others... he'd never thought he could make someone feel the same. He didn't want to make someone feel the same. [...] \"I want one for myself.\" Quentin's smile faded."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e6b09e2-c1a4-38c9-bad6-9692489aeeae",
                                        "entry_id": "b6431a3a-2c2b-39a7-9246-68584b4961d7",
                                        "glosses": [
                                            "A state of being jealous; a jealous attitude.",
                                            "A close concern for someone or something, solicitude, vigilance."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6ec5f67-cfb1-4864-9181-e1a7ba30c33a",
                                                "sense_id": "8e6b09e2-c1a4-38c9-bad6-9692489aeeae",
                                                "text": "For euer I supoosed that he had ben to yonge and to tendyr to take vpon hym these aduentures / And therfore by my wille I wold haue dryuen hym aweye for Ialousy that I had of his lyf / for it maye be no yong knyghtes dede that shal enchyeue this aduenture to the ende"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc57070d-5d50-4781-990c-da62f980f9b0",
                        "source_entry_id": "3bff6d23-4ea7-3c0f-a043-327a1d818e73",
                        "source_sense_id": "0f7b3f9e-d54b-304c-9db3-28f82a2c80b4",
                        "source_sense_description": "een wrok die iemand koestert omdat men een ander niet gunt wat men zelf begeert",
                        "target_lang_word": "jalousie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jalousie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "deed20a1-bde3-3d94-be26-341bcd3fd10a",
                                        "entry_id": "60ef03b9-ae3f-33aa-b46a-69157f469d60",
                                        "glosses": [
                                            "Dépit que l’on a de ne pas obtenir ou posséder ce qu’un autre obtient ou possède, comme la richesse, les succès, la gloire, les talents, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1ef4b72-b8c5-4ea8-ae31-2a0dab76cc64",
                                                "sense_id": "deed20a1-bde3-3d94-be26-341bcd3fd10a",
                                                "text": "La jalousie est un sentiment qui semble être surtout propre aux êtres passifs ; les chefs ont des sentiments actifs, et la jalousie se transforme chez eux en une soif d’arriver, coûte que coûte, aux positions les plus enviées, […]."
                                            },
                                            {
                                                "example_id": "9fb5c41b-a18a-4fb0-adc8-8821e3a02e6e",
                                                "sense_id": "deed20a1-bde3-3d94-be26-341bcd3fd10a",
                                                "text": "Cette jalousie lui procurait plutôt une excitation agréable comme au morne Parisien qui quitte Venise pour retrouver la France, un dernier moustique prouve que l’Italie et l’été ne sont pas encore bien loin."
                                            },
                                            {
                                                "example_id": "a13c0732-24e7-4564-a597-65c16702c03c",
                                                "sense_id": "deed20a1-bde3-3d94-be26-341bcd3fd10a",
                                                "text": "Ce qui détermina la chute de gros Zidore et de gros Léon ce fut tout simplement une petite jalousie de chasseurs provoquée par un malheureux renard, un vulgaire goupil, […]."
                                            },
                                            {
                                                "example_id": "47de5dc2-ffd3-43b8-bd32-bf7c6c095448",
                                                "sense_id": "deed20a1-bde3-3d94-be26-341bcd3fd10a",
                                                "text": "J’adore cette vie plus simple que tu mènes à la campagne, loin de nos potins et de nos jalousies."
                                            },
                                            {
                                                "example_id": "5143c844-73c8-4dd4-b785-5f9a546faf4e",
                                                "sense_id": "deed20a1-bde3-3d94-be26-341bcd3fd10a",
                                                "text": "Notre bonheur ne prend sa pleine saveur que dans la jalousie de l’autre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f90bddf2-090b-332a-af03-c898333abc6f",
                                        "entry_id": "60ef03b9-ae3f-33aa-b46a-69157f469d60",
                                        "glosses": [
                                            "Crainte que la personne aimée éprouve un sentiment de préférence pour quelqu’un d’autre ; crainte que la personne aimée soit infidèle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58211fd4-436a-4ade-a558-70889b7cf0ca",
                                                "sense_id": "f90bddf2-090b-332a-af03-c898333abc6f",
                                                "text": "Quant à l’autre femme dont tu parles, elle provoqua les propos de madame de Mi. par sa folle jalousie , et même par des insolences. Cela étoit d'autant plus bizarre et impardonnable , qu’elle avoit alors deux ou trois hommes , et que presque certainement elle ne m’a jamais aimé."
                                            },
                                            {
                                                "example_id": "45f03cc6-b95c-4fc0-ba26-55a6a1f1bc6d",
                                                "sense_id": "f90bddf2-090b-332a-af03-c898333abc6f",
                                                "text": "En voyant son amant si occupé de saisir les regards de Napoléon, Julie éprouva un moment de jalousie en pensant qu’il ne l’avait pas encore regardée."
                                            },
                                            {
                                                "example_id": "aec8f87e-8263-4903-a025-58a20a0b91ef",
                                                "sense_id": "f90bddf2-090b-332a-af03-c898333abc6f",
                                                "text": "Et si les sentiments de jalousie demeurent dans le cœur de chacun vis-à-vis de l’autre, ce n’est pas dans la douleur d’une affection déçue qu’ils résident ; c’est dans l’instinct de propriété."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8253ed3a-9d23-3be3-9590-1dc03c5e849b",
                                        "entry_id": "60ef03b9-ae3f-33aa-b46a-69157f469d60",
                                        "glosses": [
                                            "Humeur jalouse."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7c758b1-c87c-41e6-a4b4-f364c60b3ff1",
                                                "sense_id": "8253ed3a-9d23-3be3-9590-1dc03c5e849b",
                                                "text": "La fierté de Modeste, son dédain alarmèrent le poète, il revint à elle en donnant le spectacle d’une jalousie d’autant plus visible qu’elle était jouée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "jalousie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "377b40ac-a6d0-35da-b492-80808b4a4b55",
                                        "entry_id": "71b1a0f1-ffb8-34ca-b41d-3a02beaf64f6",
                                        "glosses": [
                                            "Treillis de bois ou de fer au travers duquel on voit sans être vu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "222ffa87-cebf-4758-83ad-bc8442d48010",
                                                "sense_id": "377b40ac-a6d0-35da-b492-80808b4a4b55",
                                                "text": "— Montons au second étage, dit-elle ; nous pourrons voir, à travers les jalousies, ce qui se passe dehors."
                                            },
                                            {
                                                "example_id": "dc95553a-5c8a-4051-bfff-3526e05556e4",
                                                "sense_id": "377b40ac-a6d0-35da-b492-80808b4a4b55",
                                                "text": "Chemin faisant, j'eus le plaisir de voir plusieurs Portugaises qui soulevaient leurs jalousies pour nous examiner. Il y en avait très peu de jolies ; mais une navigation de trois mois, et la difficulté de les voir, les rendaient charmantes à mes yeux."
                                            },
                                            {
                                                "example_id": "ed246889-fa51-45e4-bf3c-5fc6cafdf26c",
                                                "sense_id": "377b40ac-a6d0-35da-b492-80808b4a4b55",
                                                "text": "Madame Laure à son balcon, derrière une jalousie."
                                            },
                                            {
                                                "example_id": "44fa201b-7e31-47a5-a008-020231b539d7",
                                                "sense_id": "377b40ac-a6d0-35da-b492-80808b4a4b55",
                                                "text": "Ce fut au pied de la tour de l’ouest qu’il s’arrêta. Il était seul en avant de Grandchamp et de sa petite escorte et ne descendit point de cheval ; mais s’approchant du mur de manière à y coller sa botte, il souleva la jalousie d’une fenêtre du rez-de-chaussée, faite en forme de herse, comme on en voit encore dans quelques vieux bâtiments."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "751b78af-df90-30ef-94a8-3c168dabca5e",
                                        "entry_id": "71b1a0f1-ffb8-34ca-b41d-3a02beaf64f6",
                                        "glosses": [
                                            "Persienne formée de planchettes minces assemblées parallèlement, que l’on peut remonter et baisser à volonté au moyen d’un cordon, et qui servent à se garantir de l’action trop vive du soleil ou de la lumière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffcd0a9b-2368-4116-aac3-804074057e68",
                                                "sense_id": "751b78af-df90-30ef-94a8-3c168dabca5e",
                                                "text": "Chemin faisant, j’eus le plaisir de voir plusieurs Portugaises qui soulevaient leurs jalousies pour nous examiner."
                                            },
                                            {
                                                "example_id": "5c3b1082-088e-49cf-bc4e-e230ee3b8aa7",
                                                "sense_id": "751b78af-df90-30ef-94a8-3c168dabca5e",
                                                "text": "Enfin, je vis les premiers rayons du jour se glisser dans ma chambre à travers les interstices des jalousies."
                                            },
                                            {
                                                "example_id": "a9774266-0981-49b6-900c-d68abd670bc2",
                                                "sense_id": "751b78af-df90-30ef-94a8-3c168dabca5e",
                                                "text": "Les jeunes gens, presque nus, couraient les rues, une poignée de verges à la main, se fouettaient publiquement. Les femmes les regardaient à travers les jalousies des fenêtres, et se fouettaient entre elles."
                                            },
                                            {
                                                "example_id": "10b06dd7-79f7-464d-a402-27970bf97698",
                                                "sense_id": "751b78af-df90-30ef-94a8-3c168dabca5e",
                                                "text": "Un jour il vit apporter dans la loge du portier huit ou dix gros paquets de cordes, destinées à renouveler celles de toutes les jalousies de la prison."
                                            },
                                            {
                                                "example_id": "0c296f96-41c4-4b76-a0f9-11cc406dac0b",
                                                "sense_id": "751b78af-df90-30ef-94a8-3c168dabca5e",
                                                "text": "L’éblouissante clarté du dehors plaquait des barres de lumière entre les lames des jalousies."
                                            },
                                            {
                                                "example_id": "0b3674b8-a84f-498b-b02b-2cc7ed287efa",
                                                "sense_id": "751b78af-df90-30ef-94a8-3c168dabca5e",
                                                "text": "Couloir obscur où sur une moquette on marche à pas silencieux, et dans la chambre, ce jour mourant à travers la jalousie : on est en deçà du monde, en congé de la vie. Ou peut-être n’a-t-on été mis au monde que pour ces moments heureux, et le reste de la vie n’est-il qu’un mauvais rêve."
                                            },
                                            {
                                                "example_id": "fdd73d19-61c6-4912-ae13-1c47cc6c8274",
                                                "sense_id": "751b78af-df90-30ef-94a8-3c168dabca5e",
                                                "text": "La jalousie s'enroule dans sa partie supérieure autour d'un axe dissimulé sous une plaque de métal ou de bois, souvent ornée, appelée lambrequin. Cette jalousie s'intègre parfaitement à la morphologie des façades lyonnaises, filtrant la lumière chaleureuse du climat local tout en préservant l'intimité derrière les baies rapprochées et multiples."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efe83e8d-9c73-337d-8c3c-8328ac3edf6f",
                                        "entry_id": "71b1a0f1-ffb8-34ca-b41d-3a02beaf64f6",
                                        "glosses": [
                                            "Pâtisserie faite en pâte feuilletée, garnie frangipane ou de divers fruits et dont le dessus est recouvert d'un quadrillage fait de fines bandes de pâte ce qui la fait ressembler à un treillage en bois."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
