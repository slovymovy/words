                        "target_lang_word": "Niete",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Niete",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cc278092-6ce3-35f6-8d40-69e8f35d484a",
                                        "entry_id": "88cbd7eb-b1de-3235-b0dc-b3713310c85d",
                                        "glosses": [
                                            "Los ohne Gewinn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41dfb3c9-062c-4913-947a-070189c86ee2",
                                                "sense_id": "cc278092-6ce3-35f6-8d40-69e8f35d484a",
                                                "text": "Mist, schon wieder eine Niete!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4ae98a4e-82b5-388c-a003-577e080a5de1",
                                        "entry_id": "88cbd7eb-b1de-3235-b0dc-b3713310c85d",
                                        "glosses": [
                                            "unfähiger Mensch, Versager"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afea8886-77b4-488b-b3e1-c7b55969ddef",
                                                "sense_id": "4ae98a4e-82b5-388c-a003-577e080a5de1",
                                                "text": "Im Rechnen ist er eine Niete."
                                            },
                                            {
                                                "example_id": "109fcc41-bd57-4fef-9e11-9e9bf3d15886",
                                                "sense_id": "4ae98a4e-82b5-388c-a003-577e080a5de1",
                                                "text": "„Philip hatte mir klar gezeigt, was für eine Niete ich als Freundin gewesen war, weil ich seine Bedürfnisse nicht hatte sehen können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ba5e886f-9561-3b8c-8544-9ef31da04ff6",
                                        "entry_id": "88cbd7eb-b1de-3235-b0dc-b3713310c85d",
                                        "glosses": [
                                            "Verbindungsbolzen aus Metall"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58e879e1-058f-409f-8df4-9164b350cd7a",
                                                "sense_id": "ba5e886f-9561-3b8c-8544-9ef31da04ff6",
                                                "text": "Für alle genormten Nieten, ausgenommen Blindnieten und Nieten für den Bereich der Luft- und Raumfahrt, sind ihre technischen Lieferbedingungen festgelegt."
                                            },
                                            {
                                                "example_id": "b67c22ae-128a-4dc9-9619-6506bf237ab8",
                                                "sense_id": "ba5e886f-9561-3b8c-8544-9ef31da04ff6",
                                                "text": "„Auf dem Boden liegen Feilen, Meißel, Bohrer, Taue, Drähte, Drahtkisten, Rohre, Räder, Schrauben, Nieten, Töpfe mit Lacken, Kleistern und Fetten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4022840-0f39-42b3-87fb-24c115d9486d",
                        "source_entry_id": "6071d2ae-bf64-3d8f-adb6-840be3f16eb0",
                        "source_sense_description": "incompetent or clumsy person",
                        "target_lang_word": "недотёпа",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "недотёпа",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "821a605e-f7c9-3098-9d5a-f570a2b5c435",
                                        "entry_id": "145aacdb-d379-3d28-93f8-0e0fa17ac118",
                                        "glosses": [
                                            "разг. неуклюжий, неловкий человек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "447f5ba7-338c-4673-8f19-40e57146c776",
                                                "sense_id": "821a605e-f7c9-3098-9d5a-f570a2b5c435",
                                                "text": "Экая неловкая ворона! Экая недотёпа! Все у неё из клюва вываливается!"
                                            },
                                            {
                                                "example_id": "14258a8b-99e8-474b-993f-7bd9b394fe48",
                                                "sense_id": "821a605e-f7c9-3098-9d5a-f570a2b5c435",
                                                "text": "Я очень старался, но был недотепой: то под лед провалюсь, то ногу подверну, то ещё что…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91d4062e-d2d6-3716-b739-61ddb15b8383",
                                        "entry_id": "145aacdb-d379-3d28-93f8-0e0fa17ac118",
                                        "glosses": [
                                            "прост. недалёкий в умственном отношении человек; лопух"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49061d85-76bf-4aef-9406-725114be90d1",
                                                "sense_id": "91d4062e-d2d6-3716-b739-61ddb15b8383",
                                                "text": "Сволочи они, конечно, думал Петрок про полицаев, но и он не дурак, не какой-нибудь охламон, недотёпа, он тоже кое-что соображает в жизни и даже в войне, хотя он её, считай, и не видел."
                                            },
                                            {
                                                "example_id": "276b8391-dc4a-4e95-865b-9f8295a0aa9a",
                                                "sense_id": "91d4062e-d2d6-3716-b739-61ddb15b8383",
                                                "text": "Тут лучше прикинуться старательным и честным недотёпой, который дело делает, но для интриги простоват."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ccbb11f7-d43b-481c-9fe2-4477142b7510",
                        "source_entry_id": "6071d2ae-bf64-3d8f-adb6-840be3f16eb0",
                        "source_sense_description": "incompetent or clumsy person",
                        "target_lang_word": "неуме́ха",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "неуме́ха",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fdb48126-b5e4-3448-8e38-9ea8731a0daf",
                                        "entry_id": "383fd88d-760f-3176-af42-796a35549e06",
                                        "glosses": [
                                            "прост. тот, кто всё делает плохо или не умеет делать ничего"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0cf534a-0736-4364-9839-51a929c4b13a",
                                                "sense_id": "fdb48126-b5e4-3448-8e38-9ea8731a0daf",
                                                "text": "Она могла самозабвенно увлекаться делом, знала вкус к точной и сложной работе, не терпела неумех, и слово «недотёпа» было её худшим приговором."
                                            },
                                            {
                                                "example_id": "c25a1211-234b-4ce7-9826-c6c2b086a292",
                                                "sense_id": "fdb48126-b5e4-3448-8e38-9ea8731a0daf",
                                                "text": "— Ты лентяй, Витус, — хехекнув, объяснил Будкин. — Идеалист и неумеха. Только языком чесать и горазд."
                                            },
                                            {
                                                "example_id": "083320fe-01d6-4585-ac53-73984235b0f9",
                                                "sense_id": "fdb48126-b5e4-3448-8e38-9ea8731a0daf",
                                                "text": "— Ой, девочки, вы же такие замечательные хозяйки, просто любо-дорого посмотреть! А я полнейшая неумеха! Ну ничегошеньки не могу!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78f39560-1909-49c3-9208-0735aba16860",
                        "source_entry_id": "6071d2ae-bf64-3d8f-adb6-840be3f16eb0",
                        "source_sense_description": "incompetent or clumsy person",
                        "target_lang_word": "простофи́ля",
                        "target_lang_code": "ru",
