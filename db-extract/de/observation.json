                        "entry_id": "7a1571d7-d1e6-3cea-a350-4b80bd74fa7f",
                        "glosses": [
                            "geheime, systematische Beobachtung verdächtiger Personen oder bestimmter Orte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "759f2eee-7d0b-4df9-ba24-a3b1caf0bbbb",
                                "sense_id": "b57a4cea-3003-36b7-b68f-e32af3074f7a",
                                "text": "Es erfolgte zunächst eine polizeiliche Observation des Verdächtigen."
                            },
                            {
                                "example_id": "fa55228f-5755-4923-9310-c8c20e35ee53",
                                "sense_id": "b57a4cea-3003-36b7-b68f-e32af3074f7a",
                                "text": "Mithilfe einer staatlichen Observation wurde das Verhalten der mutmaßlichen Straftäter genau überprüft."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f65b5b68-e4b8-328d-963a-f56e03571f16",
                        "entry_id": "7a1571d7-d1e6-3cea-a350-4b80bd74fa7f",
                        "glosses": [
                            "Beobachtung des Sternenhimmels oder von Wetterverhältnissen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6503d884-2fda-4ed8-8ac2-d7c9ed4aa1cd",
                                "sense_id": "f65b5b68-e4b8-328d-963a-f56e03571f16",
                                "text": "An Bord des Eisbrechers fand eine Observation des vom Klimawandel stark betroffenen arktischen Klimas statt."
                            },
                            {
                                "example_id": "6a97b6b6-2d4c-40df-9174-b9fdeabddd1d",
                                "sense_id": "f65b5b68-e4b8-328d-963a-f56e03571f16",
                                "text": "Die Astronomen führten mehrere Observationen des Mondes durch."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
