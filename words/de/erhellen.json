                    "frequency": "Middle",
                    "semantic_group_id": "Verstaendnis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der neue Bericht konnte viele offene Fragen zu dem Vorfall endlich <w>erhellen</w>."
