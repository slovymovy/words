{
    "word_family": [
        "blacik"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0569696d-466f-3594-9a61-8a345ea0bbf9",
                    "sense_definition": "Górna, płaska powierzchnia mebla, np. stołu lub szafki kuchennej.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "meble",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na <w>blacie</w> kuchennym przygotowuję dzisiaj pyszny obiad dla całej rodziny.",
                            "target_lang_translations": {
                                "ru": "На кухонной <w>столешнице</w> я сегодня готовлю вкусный обед для всей семьи."
                            }
                        },
                        {
                            "text": "Wytarła mokry <w>blat</w> stołu czystą ściereczką po skończonym posiłku.",
                            "target_lang_translations": {
                                "ru": "Она вытерла мокрую <w>столешницу</w> стола чистой тряпкой после окончания еды."
                            }
                        }
                    ],
                    "common_phrases": [
                        "blat kuchenny",
                        "blat stołu"
                    ],
                    "target_lang_definitions": {
                        "ru": "Верхняя плоская поверхность мебели, например, стола или кухонной тумбы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "столешница",
                                "target_lang_sense_clarification": "верхняя горизонтальная поверхность стола или кухонного гарнитура"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a212a92a-f42a-3319-a9aa-91670e7c7224",
                    "sense_definition": "Pieniądze wręczane nielegalnie w celu uzyskania korzyści lub uniknięcia kary.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "przestępczość",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Został aresztowany, ponieważ próbował wręczyć policjantowi <w>blat</w> podczas kontroli drogowej.",
                            "target_lang_translations": {
                                "ru": "Он был арестован, так как пытался дать полицейскому <w>взятку</w> во время дорожной проверки."
                            }
                        },
                        {
                            "text": "W tym środowisku każdy urzędnik oczekuje na <w>blat</w> za podpisanie dokumentów.",
                            "target_lang_translations": {
                                "ru": "В этой среде каждый чиновник ожидает <w>взятку</w> за подписание документов."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "używane w żargonie przestępczym"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Деньги, передаваемые незаконно для получения выгоды или избежания наказания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взятка",
                                "target_lang_sense_clarification": "незаконное вознаграждение должностному лицу"
                            },
                            {
                                "target_lang_word": "откат",
                                "target_lang_sense_clarification": "незаконный возврат части суммы, полученной в результате сделки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "deb49fde-339f-35ed-9931-3291ac01c7c6",
                    "sense_definition": "Nieformalne porozumienie z organami ścigania.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "przestępczość",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Złodziej poszedł na <w>blat</w> z policją, aby uniknąć surowego wyroku w sądzie.",
                            "target_lang_translations": {
                                "ru": "Вор пошел на <w>сделку</w> с полицией, чтобы избежать сурового приговора в суде."
                            }
                        },
                        {
                            "text": "Dzięki zawartemu <w>blatowi</w> uniknął długoletniego pobytu w więzieniu.",
                            "target_lang_translations": {
                                "ru": "Благодаря заключенной <w>сделке</w> он избежал длительного тюремного заключения."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "używane w żargonie przestępczym"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неформальная договоренность с правоохранительными органами."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сделка со следствием",
                                "target_lang_sense_clarification": "официальное или неформальное соглашение о сотрудничестве с полицией"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd4d0a74-7612-33b1-b3f7-a1fb57f38bfe",
                    "sense_definition": "Dawna rosyjska jednostka monetarna.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pieniądze",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W dawnej Warszawie za towar płacono często w <w>blatach</w>.",
                            "target_lang_translations": {
                                "ru": "В старой Варшаве за товар часто платили <w>деньгами</w>."
                            }
                        },
                        {
                            "text": "Kieszeń pełna <w>blatów</w> nie wystarczyła na zakup drogiego zegarka.",
                            "target_lang_translations": {
                                "ru": "Карман, полный <w>денег</w>, не хватил на покупку дорогих часов."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "dawna gwara warszawska"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Устаревшая российская денежная единица."
                    },
                    "translations": {
                        "ru": []
                    }
                },
                {
                    "sense_id": "8db67cc2-7c92-3424-b5c1-217bbb263e3d",
                    "sense_definition": "Uderzenie kogoś w czoło.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "przemoc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dostał mocny <w>blat</w> w czoło za swoje niewłaściwe zachowanie.",
                            "target_lang_translations": {
                                "ru": "Он получил сильный <w>щелбан</w> в лоб за свое неподобающее поведение."
                            }
                        },
                        {
                            "text": "W bójce na podwórku wymierzono mu szybki <w>blat</w>.",
                            "target_lang_translations": {
                                "ru": "В драке во дворе ему отвесили быстрый <w>щелбан</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "używane w żargonie przestępczym"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Удар кого-либо по лбу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щелбан",
                                "target_lang_sense_clarification": "удар пальцем по лбу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e72b1c03-effa-3c3d-9787-f4ac1693d86b",
                    "sense_definition": "Element krosna tkackiego.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technika",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tkaczka starannie wyregulowała <w>blat</w> w starym krośnie.",
                            "target_lang_translations": {
                                "ru": "Ткачиха тщательно отрегулировала <w>деталь</w> в старом станке."
                            }
                        },
                        {
                            "text": "Uszkodzony <w>blat</w> uniemożliwiał dalszą pracę przy tkaniu materiału.",
                            "target_lang_translations": {
                                "ru": "Поврежденная <w>деталь</w> делала невозможной дальнейшую работу над тканью."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "termin techniczny"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Элемент ткацкого станка."
                    },
                    "translations": {
                        "ru": []
                    }
                }
            ]
        }
    ]
}