                                    },
                                    {
                                        "sense_id": "8f488895-6c03-34a0-ac8b-906eaf8ae710",
                                        "entry_id": "e0344f47-e364-3880-8e2b-4a5d079c1612",
                                        "glosses": [
                                            "The jurisdiction of an archbishop."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c001903-2e53-4f87-b911-43c344b8a7da",
                                                "sense_id": "8f488895-6c03-34a0-ac8b-906eaf8ae710",
                                                "text": "St. Salvadore in the Bahia los todos Santos, is an Archbishoprick and Seat of the Viceroy, the chief Port of Trade for Importation […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
