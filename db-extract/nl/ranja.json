                "senses": [
                    {
                        "sense_id": "dc1e029d-da78-354c-95bc-2556e599948f",
                        "entry_id": "a21f596c-8b1c-33c9-af56-8d31b5c995d8",
                        "glosses": [
                            "sinaasappellimonade(siroop)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2d88331-a546-445b-b6a0-66299c3d8ea4",
                                "sense_id": "dc1e029d-da78-354c-95bc-2556e599948f",
                                "text": "Ranja was oorspronkelijk een merk voor sinaasappellimonade later werd het ranja (zonder hoofdletter) voor alle soorten limonade zonder prik."
                            }
                        ]
                    },
                    {
                        "sense_id": "68720d83-829d-3ba7-82b4-ddeda3f57a28",
                        "entry_id": "a21f596c-8b1c-33c9-af56-8d31b5c995d8",
                        "glosses": [
                            "limonade(siroop) in het algemeen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92b4705a-b5c6-4bb7-9346-791d5989bfa8",
                                "sense_id": "68720d83-829d-3ba7-82b4-ddeda3f57a28",
                                "text": "Het bleef niet bij kijken, de leerlingen proefden ook enge hapjes. Zoals chocolade waar meelwormen in zaten of groene ranja met vleermuissnoepjes."
                            },
                            {
                                "example_id": "eb4e9e1d-9f3d-4a78-9e82-ae1db1191978",
                                "sense_id": "68720d83-829d-3ba7-82b4-ddeda3f57a28",
                                "text": "‘Zij dronk ranja met een rietje, mijn Sophietje’."
                            },
                            {
                                "example_id": "0979149a-b0c1-4b81-8b0c-f170fead7407",
                                "sense_id": "68720d83-829d-3ba7-82b4-ddeda3f57a28",
                                "text": "'Wij namen de kinderen vroeger mee naar de speeltuin bij dit café, nu komen mijn kinderen met hún kinderen. Zelf heb ik mijn jeugd gesleten in de Loonse en Drunense Duinen, ranja en boterhammetjes mee. Het plezier was in de natuur te vinden, niet in lokalen waar het geld ging kosten."
                            }
                        ]
                    }
                ],
