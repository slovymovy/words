                                    {
                                        "sense_id": "73d84847-52cf-3351-bdc9-34cbb9687631",
                                        "entry_id": "ae885b1e-3665-3a40-aa9e-3c1cbe49830f",
                                        "glosses": [
                                            "The core, central part of something, around which other elements are assembled."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff54baa3-51c4-41f2-bc74-6be5857e62c8",
                                                "sense_id": "73d84847-52cf-3351-bdc9-34cbb9687631",
                                                "text": "Situated in the centre of the largest agricultural basin in northern Formosa, T’ai-pei (population in 1964 was estimated to be 1,117,000) forms the nucleus of a major industrial area. The T’ai-pei industrial complex includes light and heavy industies within the urbanized area and also in several industrial suburbs, including Pan-ch’iao and Nan-chiang."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd532145-1e0c-3361-b339-0e1caa52f827",
                                        "entry_id": "ae885b1e-3665-3a40-aa9e-3c1cbe49830f",
                                        "glosses": [
                                            "An initial part or version that will receive additions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "356fead2-886f-4098-856d-f316115749f8",
                                                "sense_id": "bd532145-1e0c-3361-b339-0e1caa52f827",
                                                "text": "This collection will form the nucleus of a new library."
                                            },
                                            {
                                                "example_id": "9b89a98f-0f28-444b-9985-69f7b159360d",
                                                "sense_id": "bd532145-1e0c-3361-b339-0e1caa52f827",
                                                "text": "This publishing project and the experience Power gained from wartime activities formed the nucleus for the development of the giant enterprise that today is University Microfilms, subsidiary of the Xerox Education Group, Xerox Corporation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9788f31e-3fc8-3bb8-86f0-681fdf6b34fb",
                                        "entry_id": "ae885b1e-3665-3a40-aa9e-3c1cbe49830f",
                                        "glosses": [
                                            "The massive, positively charged central part of an atom, made up of protons and neutrons."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "84ff17c6-a1f8-3b8e-bf16-26b3186d9efe",
                                        "entry_id": "ae885b1e-3665-3a40-aa9e-3c1cbe49830f",
                                        "glosses": [
                                            "A large membrane-enclosed organelle found in eukaryotic cells which contains genetic material."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b9a32593-58be-3a86-9b5a-daeb74b29280",
                                        "entry_id": "ae885b1e-3665-3a40-aa9e-3c1cbe49830f",
