                        ]
                    },
                    {
                        "sense_id": "4dfcaf1d-7d86-37ca-8804-2721edc4538a",
                        "entry_id": "af19ebd0-7917-34da-8afd-2084d710ed5e",
                        "glosses": [
                            "Se comprimer par soi-même."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "fc5f034e-efc8-464c-a12f-376c3ca6d51b",
                                "sense_id": "4dfcaf1d-7d86-37ca-8804-2721edc4538a",
                                "text": "C’est ici une règle fondamentale de statique qui a été trouvée, grâce à l’obliquité des plans de contacts entre les enveloppes : le principe de la maçonnerie dynamique qui s’autocomprime et trouve sa stabilité sous l’effet de son poids."
                            }
                        ]
