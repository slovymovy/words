                "senses": [
                    {
                        "sense_id": "4c093a0f-6edb-3833-bb8e-50c24e49834b",
                        "entry_id": "11c14336-be9f-3edc-923a-8dc2e46ee8ba",
                        "glosses": [
                            "Tangenter à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d65484ac-fd30-4cd5-a684-80dfe121d65b",
                                "sense_id": "4c093a0f-6edb-3833-bb8e-50c24e49834b",
                                "text": "[…] on est déporté vers l’extérieur et on réaccellère (2–3) en visant à droite afin de retangenter vers l’intérieur pour prendre (après un freinage permettant le transfert des masses) un simple gauche nommé RIVAGE."
                            },
                            {
                                "example_id": "da89f144-5a97-4dad-9d73-9cb408a5f924",
                                "sense_id": "4c093a0f-6edb-3833-bb8e-50c24e49834b",
                                "text": "Mais tout a une fin, et comme il n’y a pas d’exemple connu d’avion qui ne se soit pas reposé tôt ou tard, il faut bien envisager de retangenter la planète."
                            },
                            {
                                "example_id": "37847d1f-e1dd-49c6-b2e1-f2eed9ab862d",
                                "sense_id": "4c093a0f-6edb-3833-bb8e-50c24e49834b",
                                "text": "Vérifier que l’outil dépasse suffisamment, sinon retirer le bol et redescendre l’outil, retangenter l’outil sur le plateau avant de remettre le bol en place."
                            }
                        ]
                    }
