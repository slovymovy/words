                    },
                    {
                        "translation_id": "328e64d0-df3f-423a-885b-efab56adaef3",
                        "source_entry_id": "ee600423-d5f4-34bb-96c2-679e59d8a56b",
                        "source_sense_description": "firearm",
                        "target_lang_word": "Steinschlossgewehr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Steinschlossgewehr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "14b30b96-311a-3f73-9743-7b86f737028e",
                                        "entry_id": "c4808d76-578e-3224-a371-0ac94ad220a1",
                                        "glosses": [
                                            "Gewehr mit einem Steinschloss als Zündmechanismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3787e693-b51f-47ee-9a96-b6d66fc063a7",
                                                "sense_id": "14b30b96-311a-3f73-9743-7b86f737028e",
                                                "text": "„Als die Krieger zur Rettung geeilt waren, hatten die Soldaten aus Dunwich schon mit Steinschlossgewehren, Pechfackeln und Donnerbüchsen auf sie gewartet.“"
                                            },
                                            {
                                                "example_id": "be316229-efba-4cf4-8840-7cd9ee7662bc",
                                                "sense_id": "14b30b96-311a-3f73-9743-7b86f737028e",
                                                "text": "„In der Zeit zwischen dem 15. und 17. Jahrhundert kauften die königlichen Händler vor allem folgende Güter von den Europäern: Kupfer- und Bronzeringe als Rohstoffe für das Kunsthandwerk, Kauri-Muscheln als Währung, Eisenbarren zur Weiterverarbeitung zu Waffen, Messern und anderem Gerät, Armreifen aus Bronze, Trinkgefäße, Kleidungsstücke mit Gold- und Silberbesatz für die Reicheren, rote Samtstoffe, rote Münzen, buntbedruckte Baumwollstoffe für die Herrschenden, derbe Wollstoffe, feine Baumwollstoffe, Leinenstoffe, bestickte Seidenstoffe, derbe Flanellstoffe, geblümte und gestärkte Gewebe aus Haarlem, Spiegel, kandierte Orangen, Zitronen und andere Grünfrüchte, Lavendel, Perlen (aus Glas und Kristall), rote Ohrringe aus Glas sowie Feuerwaffen, vor allem Steinschlossgewehre.“"
                                            },
                                            {
                                                "example_id": "0cb1a793-6d6b-4979-b389-fe9c412feaca",
                                                "sense_id": "14b30b96-311a-3f73-9743-7b86f737028e",
                                                "text": "„Die Kunde von ihrer Ankunft war den Reitern vorausgeeilt; Einwohner säumten die Straße und blickten den Freischärlern stumpfsinnig nach, die alten Frauen in schwarzen Rebozos, die Männer bewaffnet mit alten Musketen, Steinschlossgewehren oder Büchsen, die aus Gewehrteilen und grob zurechtgehauenen Pappelholzschäften gefertigt waren und wie Spielzeugwaffen wirkten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95337a71-e089-48eb-8ca0-6af86cb2d393",
                        "source_entry_id": "ee600423-d5f4-34bb-96c2-679e59d8a56b",
