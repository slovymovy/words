        "fr-extract.jsonl": [
            {
                "entry_id": "b523bbef-3d47-3887-b140-a576f68c7d5f",
                "word": "fortitude",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "51a43eb7-afe9-4941-a810-1d48b89bfc33",
                        "entry_id": "b523bbef-3d47-3887-b140-a576f68c7d5f",
                        "tags": [
                            "plural"
                        ],
                        "form": "fortitudes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2729bfe8-6dd4-37d8-96e1-5d589d4b48c9",
                        "entry_id": "b523bbef-3d47-3887-b140-a576f68c7d5f",
                        "glosses": [
                            "Énergie morale devant le danger ou dans la souffrance ; courage en endurant ou en subissant (par opposition au courage d’entreprendre des actions périlleuses)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30acfafe-0e52-40c3-864c-3399bffc4625",
                                "sense_id": "2729bfe8-6dd4-37d8-96e1-5d589d4b48c9",
                                "text": "On a vu des Français supporter les tourments du cadre de feu avec la fortitude des Indiens mêmes."
                            },
                            {
                                "example_id": "443f455c-bca8-41f0-bc57-ab86663e0403",
                                "sense_id": "2729bfe8-6dd4-37d8-96e1-5d589d4b48c9",
                                "text": "Pour le bénéfice du secrétaire qui ramassait ses papiers avant d’aller copier dans la pièce voisine, le gros Philibert observa révérencieusement qu’on parlait beaucoup du courage des rebelles exécutés par ordre du duc (on en doublait d’ailleurs le nombre), mais pas assez de la fortitude de cet homme d’État et de guerre mourant sous le harnois de son maître."
                            },
                            {
                                "example_id": "bfd641a5-86a8-4af8-b73a-b3b0f743d5fc",
                                "sense_id": "2729bfe8-6dd4-37d8-96e1-5d589d4b48c9",
                                "text": "Nous sommes tous à bord du “Titanic”. La fortitude des uns et la lâcheté des autres."
                            },
                            {
                                "example_id": "705253d5-6ab0-40b0-99a4-04636017824e",
                                "sense_id": "2729bfe8-6dd4-37d8-96e1-5d589d4b48c9",
                                "text": "… à Milan surtout presque tout le peuple témoigna une grande constance et beaucoup de fortitude …"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "403d7496-1c53-493d-9d7c-6cc6bb25675e",
                        "source_entry_id": "b523bbef-3d47-3887-b140-a576f68c7d5f",
                        "source_sense_id": "2729bfe8-6dd4-37d8-96e1-5d589d4b48c9",
                        "target_lang_word": "fortitude",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fortitude",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3d9746e7-f0b4-3bd3-88ab-0f1959a18f3c",
                                        "entry_id": "bce157a7-29fe-3dcc-8100-46ff55721e8a",
                                        "glosses": [
                                            "Mental or emotional strength that enables courage in the face of adversity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b61d6bb1-230f-43e8-96de-694bfc123407",
                                                "sense_id": "3d9746e7-f0b4-3bd3-88ab-0f1959a18f3c",
                                                "text": "I am able now (me thinkes) / (Out of a Fortitude of Soule, I feele) / To endure more Miſeries, […]"
                                            },
                                            {
                                                "example_id": "89808fbf-5a34-48bf-9fa8-61d589721853",
                                                "sense_id": "3d9746e7-f0b4-3bd3-88ab-0f1959a18f3c",
                                                "text": "I shall soon have need for all my fortitude, as I am on the point of separation from my own daughter."
                                            },
                                            {
                                                "example_id": "43f66603-68f1-4bec-9cff-662e9c9c1455",
                                                "sense_id": "3d9746e7-f0b4-3bd3-88ab-0f1959a18f3c",
                                                "text": "She [the ship] may be saved by your efforts, by your resource and fortitude bearing up against the heavy weight of guilt and failure."
                                            },
                                            {
                                                "example_id": "447771ce-6bcc-4596-9e55-657d4a8dc72c",
                                                "sense_id": "3d9746e7-f0b4-3bd3-88ab-0f1959a18f3c",
                                                "text": "Mitt Romney […] charges that [Barack] Obama is an appeaser who apologizes for America, lacks fortitude and is \"tentative, indecisive, timid and nuanced.\""
                                            },
                                            {
                                                "example_id": "3700f0aa-47f1-4a49-8ca8-cb71e9bf549d",
                                                "sense_id": "3d9746e7-f0b4-3bd3-88ab-0f1959a18f3c",
                                                "text": "The proper fans might also expend time—about twenty hours—trying to visit every Tube station as quickly as possible. […] But to visit every station in record time—which people have been attempting since at least 1960—requires real fortitude. You must get up before dawn, you must drink or eat almost nothing, so niggardly is the Underground with toilet provision."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf7d253d-d4a0-353f-9d5d-85438bacc39c",
                                        "entry_id": "bce157a7-29fe-3dcc-8100-46ff55721e8a",
                                        "glosses": [
                                            "Physical strength."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f890a459-b9ac-4b36-94c9-2bfbe8927190",
                                                "sense_id": "bf7d253d-d4a0-353f-9d5d-85438bacc39c",
                                                "text": "The Turke with moſt mighty preparation makes for Cipres. Othello, the fortitude of the place, is beſt knowne to you, […]"
                                            },
                                            {
                                                "example_id": "3b1a1867-51d7-4c7e-93e6-0297d98dfcad",
                                                "sense_id": "bf7d253d-d4a0-353f-9d5d-85438bacc39c",
                                                "text": "Hey day! VVhat are all the VVomen of my Family abroad? Is not my Wife come home? Nor my Siſter, nor my Daughter? […] Mercy on us, what can be the meaning of it? Sure the Moon is in all her Fortitudes; […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
