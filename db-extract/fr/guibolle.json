                    }
                ],
                "senses": [
                    {
                        "sense_id": "7cdaa305-bdbf-3e5e-85d4-7b07e5a09127",
                        "entry_id": "ac1b2a8a-fb5a-3025-82b6-89a201a9dcfa",
                        "glosses": [
                            "Variante, dans l’orthographe traditionnelle, de guibole."
                        ],
                        "tags": [
                            "orthographe rectifiée de 1990"
                        ],
                        "examples": [
                            {
                                "example_id": "527b8c65-8705-4836-b4e9-f9433e4dce88",
                                "sense_id": "7cdaa305-bdbf-3e5e-85d4-7b07e5a09127",
                                "text": "Il essaya tout d’abord de courir en sens inverse des fuyards. Mais ses pauvres guibolles de tortillon, surmenées déjà, le trahirent."
                            },
                            {
                                "example_id": "825a6b7a-3d61-4984-8a48-802f03c832e2",
                                "sense_id": "7cdaa305-bdbf-3e5e-85d4-7b07e5a09127",
                                "text": "Une fois, je me suis emmêlé les guibolles, je me suis ramassé la gueule sur le trottoir, mais je me suis pas fait mal, c’est Piérine qu’a tout pris, il a amorti, il avait la gueule en sang, là il chialait pour quelque chose."
                            },
                            {
                                "example_id": "67a2fbf9-90d8-4f01-b3cf-80912e5d81d9",
                                "sense_id": "7cdaa305-bdbf-3e5e-85d4-7b07e5a09127",
                                "text": "Je lance mes guibolles en l'air et il les stoppe en plein buffet. Il se plie en deux et recule. Je me mets debout et lui saute dessus."
                            },
                            {
                                "example_id": "d2480788-51f9-4077-ad3b-5b4c49fcdcfb",
                                "sense_id": "7cdaa305-bdbf-3e5e-85d4-7b07e5a09127",
                                "text": "Et cette fois-ci, je n'ai eu qu'à lui casser une guibolle, pour qu’il se montre raisonnable."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
