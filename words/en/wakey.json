                            }
                        }
                    ],
                    "common_phrases": [
                        "and a wakey"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used primarily in military contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Ostatni dzień służby lub okresu pracy przed powrotem do domu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ostatni dzień",
                                "target_lang_sense_clarification": "w kontekście wojskowym lub służbowym"
                            }
                        ]
                    }
                }
            ]
        },
