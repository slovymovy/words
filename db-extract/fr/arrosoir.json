        "fr-extract.jsonl": [
            {
                "entry_id": "dfaf3c4d-5cee-32c2-9d5f-b8f8d69444e0",
                "word": "arrosoir",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "df3e35b9-d154-4a67-aa33-fa6e5b9f8b4a",
                        "entry_id": "dfaf3c4d-5cee-32c2-9d5f-b8f8d69444e0",
                        "tags": [
                            "plural"
                        ],
                        "form": "arrosoirs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3fcf007b-44a2-3224-b7ae-35e4db012d86",
                        "entry_id": "dfaf3c4d-5cee-32c2-9d5f-b8f8d69444e0",
                        "glosses": [
                            "Outil utilisé pour l’arrosage et qui se compose d’un récipient muni d'une anse et d’un long col (ou queue) qui peut être terminé par une plaque percée de petits trous (pomme)."
                        ],
                        "tags": [
                            "Jardinage"
                        ],
                        "examples": [
                            {
                                "example_id": "8b3f2e78-5456-4466-9aa3-875f86295e80",
                                "sense_id": "3fcf007b-44a2-3224-b7ae-35e4db012d86",
                                "text": "Or, au moment dont nous parlons, il y avait seize ans que le terrain de La Pinède n’avait senti des bras ni bu l’eau bienfaisante d’un arrosoir."
                            },
                            {
                                "example_id": "9625c390-e8ee-408b-9405-547f0b44f456",
                                "sense_id": "3fcf007b-44a2-3224-b7ae-35e4db012d86",
                                "text": "— Je n’ai rien fait. Pas un mètre de tuyau. Pas même un arrosoir : rien ! répétait Mitoine."
                            },
                            {
                                "example_id": "94b153d6-0bba-4d7f-8483-05f30a083e94",
                                "sense_id": "3fcf007b-44a2-3224-b7ae-35e4db012d86",
                                "text": "Elle a éprouvé cela, jadis, lorsqu’elle s’amusait avec sa maison de poupées et qu’elle empruntait l’arrosoir du jardin pour faire pleuvoir des averses sur le toit de la bicoque."
                            }
                        ]
                    },
                    {
                        "sense_id": "5d927685-ccd3-39a5-9737-a2dfc1bfebe3",
                        "entry_id": "dfaf3c4d-5cee-32c2-9d5f-b8f8d69444e0",
                        "glosses": [
                            "Contenu d’un arrosoir (sens 1)."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "71d17aa6-5cd6-4975-bf7b-95125e9b4a00",
                                "sense_id": "5d927685-ccd3-39a5-9737-a2dfc1bfebe3",
                                "text": "Vous devez verser deux arrosoirs de 20 litres au moment de la plantation."
                            }
                        ]
                    },
                    {
                        "sense_id": "8633c2a7-abb0-3114-a3ae-ec1592381f1f",
                        "entry_id": "dfaf3c4d-5cee-32c2-9d5f-b8f8d69444e0",
                        "glosses": [
                            "Sonde perforée pour effectuer des lavages de la région prostatique."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6d1f19ca-d5a0-3ee0-93e1-c22d3c555107",
                        "entry_id": "dfaf3c4d-5cee-32c2-9d5f-b8f8d69444e0",
                        "glosses": [
                            "Mollusque acéphale (Aspergillum) dont la coquille évoque une pomme d’arrosoir."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc3ab48f-ba20-4e40-bb77-9e5fa0d8472a",
                        "source_entry_id": "dfaf3c4d-5cee-32c2-9d5f-b8f8d69444e0",
                        "source_sense_description": "Outil pour arroser",
                        "target_lang_word": "Gießkanne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gießkanne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d16e99f8-99c5-3e73-83db-dd794b960634",
                                        "entry_id": "7385e156-e86f-3523-9913-05bc33e3faf6",
                                        "glosses": [
                                            "Wasserbehälter, der zum Gießen von Blumen verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c0af6e09-df50-41b7-b51a-f493c0e2181c",
                                                "sense_id": "d16e99f8-99c5-3e73-83db-dd794b960634",
                                                "text": "Manche Blumen müssen jeden Tag mit der Gießkanne bewässert werden."
                                            },
                                            {
                                                "example_id": "11754eff-3877-4ce5-841c-71945231ec78",
                                                "sense_id": "d16e99f8-99c5-3e73-83db-dd794b960634",
                                                "text": "„Andere kommen mit Gießkannen, um ihr Bollwerk zu festigen.“"
                                            },
                                            {
                                                "example_id": "6395d287-5a70-4edd-89bd-a202c404b192",
                                                "sense_id": "d16e99f8-99c5-3e73-83db-dd794b960634",
                                                "text": "„Empört ließ eine Frau ihre Gießkanne fallen und schrie etwas von Totenruhe, Krähen flatterten krächzend von einem zerfledderten Kranz auseinander, ich hätte am liebsten mitgeschrien.“"
                                            },
                                            {
                                                "example_id": "97e53472-b803-44a1-808f-24de2c9a74c4",
                                                "sense_id": "d16e99f8-99c5-3e73-83db-dd794b960634",
                                                "text": "„Sie ließ die Gießkanne fallen und rannte in die Küche.“"
                                            },
                                            {
                                                "example_id": "95fa27f5-937c-4e96-befc-bf74a1e241be",
                                                "sense_id": "d16e99f8-99c5-3e73-83db-dd794b960634",
                                                "text": "„Ältere Frauen gingen gebückt vorüber, den Kopf gesenkt, eine Gießkanne in der Hand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
