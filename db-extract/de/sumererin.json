                "senses": [
                    {
                        "sense_id": "5993d5e7-db4b-3f36-a519-e0e6cbe478d0",
                        "entry_id": "9a1da772-2b4d-37c8-8f0b-eb4943f0e13a",
                        "glosses": [
                            "Angehörige des Volkes der Sumerer beziehungsweise im Gebiet des damaligen Landes Sumer lebende Frau"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a60a531c-078a-4e89-92d2-ed04a50c39a3",
                                "sense_id": "5993d5e7-db4b-3f36-a519-e0e6cbe478d0",
                                "text": "„Vor 6000 Jahren entdeckten sumerische Frauen, dass nasses Brot anfängt zu gären. Die Sumererinnen lernten die berauschende Wirkung des Breis schnell zu schätzen und gezielt einzusetzen – damit war die Brauereitechnik geboren, […]“"
                            },
                            {
                                "example_id": "ec73f910-5de0-4cfa-a902-f8bfdc4c56b1",
                                "sense_id": "5993d5e7-db4b-3f36-a519-e0e6cbe478d0",
                                "text": "„Die Sumererinnen bekunden wie mit ihrer Haarfrisur, so auch mit diesem Gewande vortrefflichen Geschmack.“"
                            },
                            {
                                "example_id": "3b030862-8a80-4d9c-af1a-96ab16c13ea1",
                                "sense_id": "5993d5e7-db4b-3f36-a519-e0e6cbe478d0",
                                "text": "„Sumererinnen benutzten eine Paste aus zerstoßenen Halbedelsteinen, um ihre Lippen zu färben.“"
                            },
                            {
                                "example_id": "2f876394-adf5-4659-bef6-fa59694f1c43",
                                "sense_id": "5993d5e7-db4b-3f36-a519-e0e6cbe478d0",
                                "text": "Eine Sumererin war voll geschäftsfähig, wie wir aus zeitgenössischen Urkunden wissen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
