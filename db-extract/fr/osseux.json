                "senses": [
                    {
                        "sense_id": "f2bd05d6-e63e-3d08-9cf7-63104c6bc35f",
                        "entry_id": "30e0da5d-128b-308a-9fdf-df80923eed84",
                        "glosses": [
                            "Qui est de la nature des os ; qui est relatif aux os."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "849f6251-1441-4c9e-b2fe-70f551224f70",
                                "sense_id": "f2bd05d6-e63e-3d08-9cf7-63104c6bc35f",
                                "text": "Cette fragilité est-elle propre aux os des cancéreux, ou tient-elle au développement des cancers multiples dans le système osseux ?"
                            },
                            {
                                "example_id": "1299415c-aff5-4d13-829d-6cdc9c44c957",
                                "sense_id": "f2bd05d6-e63e-3d08-9cf7-63104c6bc35f",
                                "text": "L’hyperdensification globale d’une pièce osseuse est un phénomène assez rare ; le paléopathologiste pourra l’avoir soupçonné d’après un poids anormal de la pièce ou constaté sur un cliché radiographique."
                            },
                            {
                                "example_id": "11e70581-100b-47a5-bd0d-8e190ad7f084",
                                "sense_id": "f2bd05d6-e63e-3d08-9cf7-63104c6bc35f",
                                "text": "« Les femmes dont les mères sont ostéoporotiques ont en moyenne des densités osseuses plus faibles que celles dont les mères sont indemnes d’ostéoporose », indique le Dr Lespessailles."
                            }
                        ]
                    },
                    {
                        "sense_id": "af199607-1495-3bc8-95cc-5cfdc1744091",
                        "entry_id": "30e0da5d-128b-308a-9fdf-df80923eed84",
                        "glosses": [
                            "Qui a les os apparents, saillants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a2dc96d-8ce2-404c-a137-c3f4154ebf88",
                                "sense_id": "af199607-1495-3bc8-95cc-5cfdc1744091",
                                "text": "Une main osseuse."
                            },
                            {
                                "example_id": "4ce56ce1-b049-41d1-9a36-6957449dc26b",
                                "sense_id": "af199607-1495-3bc8-95cc-5cfdc1744091",
                                "text": "L’un, grand, élancé, avait des cheveux presque blanc, les sourcils et les favoris noirs, une figure osseuse et brune, l’air dur, sévère."
                            }
                        ]
                    }
                ],
