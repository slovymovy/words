            "senses": [
                {
                    "sense_id": "4299b10b-1936-3f13-880b-e0163510f76e",
                    "sense_definition": "Ouvrir involontairement et largement la bouche par fatigue, sommeil ou ennui, en inspirant profondément.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "yawn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il était tellement fatigué pendant la réunion qu'il n'arrêtait pas de <w>bâiller</w>."
                        },
                        {
                            "text": "L'enfant met poliment la main devant sa bouche quand il commence à <w>bâiller</w> d'ennui."
                        }
                    ],
                    "common_phrases": [
                        "bâiller d'ennui",
                        "bâiller de fatigue",
                        "faire bâiller"
                    ]
                },
                {
                    "sense_id": "53b47e0a-f064-3c09-9a8d-f0c71d14e290",
                    "sense_definition": "Être mal fermé ou entrouvert, en parlant d'un vêtement, d'une ouverture ou d'un interstice.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "gape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tissu est trop ajusté et la chemise <w>bâille</w> entre deux boutons."
                        },
                        {
                            "text": "Dans la vieille grange, la porte déformée par l'humidité <w>bâillait</w> légèrement au vent."
                        }
                    ],
                    "synonyms": [
                        "béer"
                    ],
                    "common_phrases": [
