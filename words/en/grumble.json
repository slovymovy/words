{
    "word_family": [
        "grumbler",
        "grumbling"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "25025054-a5e3-3912-a688-1fae0ca61b3d",
                    "sense_definition": "To complain in a low, unhappy, or surly voice.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "complain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>grumbles</w> about the weather every single morning.",
                            "target_lang_translations": {
                                "cs": "Každé ráno si <w>brblá</w> o počasí."
                            }
                        },
                        {
                            "text": "Employees often <w>grumble</w> when they have to work late.",
                            "target_lang_translations": {
                                "cs": "Zaměstnanci často <w>reptají</w>, když musí pracovat přesčas."
                            }
                        }
                    ],
                    "synonyms": [
                        "complain",
                        "mutter",
                        "grouse"
                    ],
                    "common_phrases": [
                        "grumble about"
                    ],
                    "target_lang_definitions": {
                        "cs": "Stěžovat si tichým, nespokojeným nebo nevrlým hlasem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "brblat",
                                "target_lang_sense_clarification": "vyjadřovat nespokojenost tichým mumláním"
                            },
                            {
                                "target_lang_word": "reptat",
                                "target_lang_sense_clarification": "vyjadřovat nesouhlas nebo nespokojenost"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12762797-e322-335e-9eb3-0315ca7ba47b",
                    "sense_definition": "To make a low, rumbling sound like thunder or a hungry stomach.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The distant thunder began to <w>grumble</w> across the dark sky.",
                            "target_lang_translations": {
                                "cs": "Vzdálený hrom začal <w>dunět</w> po temné obloze."
                            }
                        },
                        {
                            "text": "I could hear my stomach <w>grumble</w> because I skipped lunch.",
                            "target_lang_translations": {
                                "cs": "Slyšel jsem, jak mi <w>kručí</w> v žaludku, protože jsem vynechal oběd."
                            }
                        }
                    ],
                    "synonyms": [
                        "rumble",
                        "growl"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vydávat hluboký, dunivý zvuk jako hrom nebo hladový žaludek."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "dunět",
                                "target_lang_sense_clarification": "vydávat hluboký zvuk (např. hrom)"
                            },
                            {
                                "target_lang_word": "kručet",
                                "target_lang_sense_clarification": "vydávat zvuk hladového žaludku"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f2ae2259-d693-3c34-9150-3dc4344be32e",
                    "sense_definition": "To say something in a low, unhappy, or complaining voice.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "complain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>grumbled</w> that the meeting was a complete waste of time.",
                            "target_lang_translations": {
                                "cs": "Nespokojeně <w>zamumlal</w>, že ta schůzka byla naprostá ztráta času."
                            }
                        },
                        {
                            "text": "She <w>grumbled</w> a quiet apology before leaving the room.",
                            "target_lang_translations": {
                                "cs": "Před odchodem z místnosti tiše <w>zamumlala</w> omluvu."
                            }
                        }
                    ],
                    "synonyms": [
                        "mutter",
                        "mumble"
                    ],
                    "target_lang_definitions": {
                        "cs": "Říci něco tichým, nespokojeným nebo stěžujícím si hlasem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zamumlat",
                                "target_lang_sense_clarification": "říci něco nesrozumitelně nebo potichu"
                            },
                            {
                                "target_lang_word": "zavrčet",
                                "target_lang_sense_clarification": "říci něco nevrlým tónem"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "77fe03ab-39c2-3253-a2f5-6baf5aedbfcd",
                    "sense_definition": "A surly or unhappy complaint.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "complain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had a constant <w>grumble</w> about the new office rules.",
                            "target_lang_translations": {
                                "cs": "Neustále měl nějaké <w>brblání</w> k novým kancelářským pravidlům."
                            }
                        },
                        {
                            "text": "Ignore his <w>grumbles</w> and just focus on your work.",
                            "target_lang_translations": {
                                "cs": "Ignoruj jeho <w>reptání</w> a prostě se soustřeď na svou práci."
                            }
                        }
                    ],
                    "synonyms": [
                        "complaint",
                        "grievance"
                    ],
                    "target_lang_definitions": {
                        "cs": "Nevrlá nebo nespokojená stížnost."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "brblání",
                                "target_lang_sense_clarification": "projev nespokojenosti"
                            },
                            {
                                "target_lang_word": "reptání",
                                "target_lang_sense_clarification": "vyjádření nesouhlasu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d167cae7-2916-3ea2-af26-1f8502b90bdd",
                    "sense_definition": "A low, rumbling, or growling sound.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A low <w>grumble</w> of thunder echoed in the distance.",
                            "target_lang_translations": {
                                "cs": "V dálce se ozvalo hluboké <w>dunění</w> hromu."
                            }
                        },
                        {
                            "text": "The engine made a strange <w>grumble</w> before it finally stopped.",
                            "target_lang_translations": {
                                "cs": "Motor vydal podivné <w>vrčení</w>, než se konečně zastavil."
                            }
                        }
                    ],
                    "synonyms": [
                        "rumble",
                        "growl"
                    ],
                    "target_lang_definitions": {
                        "cs": "Hluboký, dunivý nebo vrčivý zvuk."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "dunění",
                                "target_lang_sense_clarification": "hluboký zvuk"
                            },
                            {
                                "target_lang_word": "vrčení",
                                "target_lang_sense_clarification": "zvuk motoru nebo zvířete"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "160e0d2f-c382-3ccd-a9c7-dfc53565bb00",
                    "sense_definition": "The sound made by a hungry stomach.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The loud <w>grumble</w> of my stomach embarrassed me during the lecture.",
                            "target_lang_translations": {
                                "cs": "Hlasité <w>kručení</w> v mém žaludku mě během přednášky uvedlo do rozpaků."
                            }
                        },
                        {
                            "text": "I could hear the <w>grumble</w> of his stomach from across the table.",
                            "target_lang_translations": {
                                "cs": "Slyšel jsem <w>kručení</w> jeho žaludku přes celý stůl."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Zvuk vydávaný hladovým žaludkem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "kručení",
                                "target_lang_sense_clarification": "zvuk hladového žaludku"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}