                        "sense_id": "fde6c682-7e99-374e-81fb-6cf81fc84e73",
                        "entry_id": "07b40618-545d-3645-ba09-d5fb60b394d0",
                        "glosses": [
                            "Voiture-cage servant à l'exhibition de fauves présentés par un dompteur, dans un cirque ou une ménagerie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40d6602d-5b87-4c6f-9f67-9791ea106268",
                                "sense_id": "fde6c682-7e99-374e-81fb-6cf81fc84e73",
                                "text": "Enfin, comme apothéose, les lions disparus, on introduisait dans la cage-théâtre un énorme ours blanc « dont la férocité, disaient les affiches, ne laissait rien à désirer »."
                            },
                            {
                                "example_id": "85aeb696-cffa-49c2-8d5d-c2c820e4c111",
                                "sense_id": "fde6c682-7e99-374e-81fb-6cf81fc84e73",
                                "text": "Les voitures-cages s'alignent tout le long d'un des grands côtés de la baraque avec, au milieu d'elles, la cage centrale ou cage-théâtre où les animaux travaillent."
                            }
                        ]
                    }
