                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "62d0202c-0a29-38aa-9d9e-41a81bb82aa3",
                                        "entry_id": "f8e4ea23-e51a-3293-b3c1-50cf3780b453",
                                        "glosses": [
                                            "aardappel"
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33fd462d-9fed-409f-acfd-a2067af27297",
                                                "sense_id": "62d0202c-0a29-38aa-9d9e-41a81bb82aa3",
                                                "text": "Staan de piepers al op?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "517e1d9e-a247-3d49-bd0e-ace45fee2c1f",
                                        "entry_id": "f8e4ea23-e51a-3293-b3c1-50cf3780b453",
                                        "glosses": [
                                            "apparaat dat een piepend geluid voortbrengt, bijv. om te waarschuwen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b5d1a03-b390-448e-be20-5e4676509f78",
                                                "sense_id": "517e1d9e-a247-3d49-bd0e-ace45fee2c1f",
                                                "text": "De piepers geven een signaaltje af dat je locatie verraadt als je onder de sneeuw bedolven ligt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc7c2146-4a64-344a-b188-ff474e617b8d",
                                        "entry_id": "f8e4ea23-e51a-3293-b3c1-50cf3780b453",
                                        "glosses": [
                                            "zoen"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5149f37d-39d5-43ca-a21f-ac4a2d7d5be7",
                                                "sense_id": "fc7c2146-4a64-344a-b188-ff474e617b8d",
                                                "text": "Hij greep haar bij een roksplooi en lonkte smachtend in haar gezicht.\"Geef mij een pieper, Leentje,\" fluisterde hij."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
