        "fr-extract.jsonl": [
            {
                "entry_id": "06ba6b3e-70b8-3aea-92be-c660bb7066af",
                "word": "monnayage",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "eaf20c2a-9899-4281-b123-27f5a6d717ab",
                        "entry_id": "06ba6b3e-70b8-3aea-92be-c660bb7066af",
                        "tags": [
                            "plural"
                        ],
                        "form": "monnayages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "84930c3b-efff-32ab-8f45-854d25dfe5cc",
                        "entry_id": "06ba6b3e-70b8-3aea-92be-c660bb7066af",
                        "glosses": [
                            "Fabrication de la monnaie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18c8e628-a073-480e-bfe8-c3ccee1d87a1",
                                "sense_id": "84930c3b-efff-32ab-8f45-854d25dfe5cc",
                                "text": "Le monnayage attribué aux Aulerques Diablintes, tout d’abord, appartient stylistiquement à un ensemble armoricain, notamment par la présence au revers d’un cheval androcéphale."
                            },
                            {
                                "example_id": "e5048fcf-2c86-4c6d-9a20-a11627a47131",
                                "sense_id": "84930c3b-efff-32ab-8f45-854d25dfe5cc",
                                "text": "En 1922, l’Égypte a été proclamée royaume et Ahmed Fouad Ier proclamé roi; les monnaies ont été alors frappées avec son nom dans les monnayages britanniques."
                            },
                            {
                                "example_id": "269a9f81-f2ae-4237-b831-9cdb15ac849a",
                                "sense_id": "84930c3b-efff-32ab-8f45-854d25dfe5cc",
                                "text": "Monnayage au marteau, au balancier."
                            },
                            {
                                "example_id": "d4d72edd-0dc4-4393-8d94-fbfa068d4593",
                                "sense_id": "84930c3b-efff-32ab-8f45-854d25dfe5cc",
                                "text": "L’état seul a le droit de monnayage."
                            },
                            {
                                "example_id": "cef4b474-1196-4185-8287-c97898511a92",
                                "sense_id": "84930c3b-efff-32ab-8f45-854d25dfe5cc",
                                "text": "Faux-monnayage, fabrication de fausse monnaie."
                            },
                            {
                                "example_id": "8de02f7d-7d8b-441f-aa3d-4956ce72ca74",
                                "sense_id": "84930c3b-efff-32ab-8f45-854d25dfe5cc",
                                "text": "Il a présenté des considérations générales sur les alliages, et a terminé par la fonte des médailles le monnayage des médailles en bronze et le bronzage."
                            }
                        ]
                    },
                    {
                        "sense_id": "5cd6a657-baa2-3bb2-9bcf-7c675a1f9c38",
                        "entry_id": "06ba6b3e-70b8-3aea-92be-c660bb7066af",
                        "glosses": [
                            "Remplacement d'une durée par plusieurs plus brèves et de durée globale équivalente."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
