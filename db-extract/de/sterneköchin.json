                "senses": [
                    {
                        "sense_id": "3e6b6421-2a3e-3d08-a63f-4a5e871d7eff",
                        "entry_id": "01c1614f-c5ba-389e-b66f-f489f0aadc6c",
                        "glosses": [
                            "Köchin, die mit einem oder mehreren Sternen ausgezeichnet wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29be1818-fd4d-4a63-a0d6-d300b4327fae",
                                "sense_id": "3e6b6421-2a3e-3d08-a63f-4a5e871d7eff",
                                "text": "„Vergangenes Jahr war Gilles Goujon zum \"Koch des Jahres\" gewählt worden, im Jahr 2007 die Sterneköchin Anne-Sophie Pic.“"
                            },
                            {
                                "example_id": "ec6bcb16-906e-4e69-82d8-d79e28c427cf",
                                "sense_id": "3e6b6421-2a3e-3d08-a63f-4a5e871d7eff",
                                "text": "„Ein Strahlen breitet sich in Cornelia Polettos Gesicht aus, wenn sie von \"früher\" spricht, von den schönsten Augenblicken in ihrem Leben als Sterneköchin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
