                                "target_senses": [
                                    {
                                        "sense_id": "820f57f9-814d-3c54-8b8f-a522866e8b9d",
                                        "entry_id": "b3042b54-ec5b-39b2-8d74-1c0368427f2b",
                                        "glosses": [
                                            "A female leader of a family, a tribe or an ethnic or religious group.",
                                            "The dominant female in a family group of elephants"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79ea3276-1de8-3956-aebd-3f78832efe39",
                                        "entry_id": "b3042b54-ec5b-39b2-8d74-1c0368427f2b",
                                        "glosses": [
                                            "A female leader of a family, a tribe or an ethnic or religious group.",
                                            "A strong and domineering older woman; a battle axe."
                                        ],
                                        "tags": [
                                            "Northern-England"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60cfb594-8aa0-4c24-b844-ea829400b210",
                                                "sense_id": "79ea3276-1de8-3956-aebd-3f78832efe39",
                                                "text": "A typical Lancashire matriarch ushers the reassured townsfolk off the premises, confident that her money is safe: 'You don't deserve any business doubting t' Co-op. It's sound enough, and them that doubt it ought to be ashamed of themselves.'"
                                            },
                                            {
                                                "example_id": "2fcd13d7-3533-4a5e-92a9-b5d25f60dba0",
                                                "sense_id": "79ea3276-1de8-3956-aebd-3f78832efe39",
                                                "text": "Although the drummer has no musical segments in the film, he remains a central visual presence, inevitably accompanied—and visually framed—by his aunt, the stereotypically loud, forceful, and domineering northern matriarch."
                                            },
                                            {
                                                "example_id": "07b17caa-be10-489c-b80a-e6ca05563041",
                                                "sense_id": "79ea3276-1de8-3956-aebd-3f78832efe39",
                                                "text": "Cornelius Hazelwood – naturally I gave him a name – saw to it that Felix could tell his prime numbers from his square roots. Then Beryl Swinehodge, an imperious Yorkshire matriarch, rolled up to test him on food pyramids."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a90f4ee-08ca-32d6-a847-9efd195df974",
                                        "entry_id": "b3042b54-ec5b-39b2-8d74-1c0368427f2b",
                                        "glosses": [
                                            "A female founder of a political or religious movement, an organization or an enterprise."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
