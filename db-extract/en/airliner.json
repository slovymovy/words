                        "target_lang_word": "Passagierflugzeug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Passagierflugzeug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b5dc19ed-9ad2-3a93-8921-af7079a0be65",
                                        "entry_id": "898af55d-2688-37a8-8a90-57cb26c899a8",
                                        "glosses": [
                                            "Flugzeug, das ausschließlich für den Transport von Passagieren bestimmt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e11a4ed-a58a-474e-b0a0-3ea9efec9255",
                                                "sense_id": "b5dc19ed-9ad2-3a93-8921-af7079a0be65",
                                                "text": "Der Superjumbo Airbus A380 ist das größte Passagierflugzeug der Welt."
                                            },
                                            {
                                                "example_id": "c6f2f457-33c0-4dc0-8ec7-63004dac74b4",
                                                "sense_id": "b5dc19ed-9ad2-3a93-8921-af7079a0be65",
                                                "text": "„Die Bewaffneten wollten ukrainische Militärflugzeuge abschießen. Sie trafen ein internationales Passagierflugzeug.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3384c33-7bd5-4c5a-bff8-c6a99476ce06",
                        "source_entry_id": "540461ac-df53-307e-90dd-a6c18d0d1ca3",
                        "source_sense_id": "b163c6ee-19b4-3dfd-94ed-af602c2ab4fe",
                        "source_sense_description": "passenger aircraft",
                        "target_lang_word": "Verkehrsflugzeug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verkehrsflugzeug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cc1c4448-e148-3444-b4aa-2395856d535d",
                                        "entry_id": "571a94f8-09f8-39f7-93de-066e75234029",
                                        "glosses": [
                                            "Flugzeug, mit dem öffentliche Flüge durchgeführt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c724e039-acf6-4a5f-bf7b-6a80d8c30bc8",
                                                "sense_id": "cc1c4448-e148-3444-b4aa-2395856d535d",
                                                "text": "„Eine pakistanische Kommandoeinheit stürmt ein nach Lahore entführtes indisches Verkehrsflugzeug und befreit die verbliebenen 45 Passagiere.“"
                                            },
                                            {
                                                "example_id": "88f8727c-4632-43dc-b15d-ab7de994c77d",
                                                "sense_id": "cc1c4448-e148-3444-b4aa-2395856d535d",
                                                "text": "„Während man früher nur Propellerantriebe baute, fliegen die Verkehrsflugzeuge heute hauptsächlich mit dem modernen Strahl- oder Düsenantrieb.“"
                                            },
                                            {
                                                "example_id": "7b3dc9ab-640d-4512-825b-3a23972eaa1b",
                                                "sense_id": "cc1c4448-e148-3444-b4aa-2395856d535d",
                                                "text": "„Die Dienstgipfelhöhe moderner Verkehrsflugzeuge liegt über 12 000 m.“"
                                            },
                                            {
                                                "example_id": "ea2a6313-f1de-4632-b3f7-e9ed85a9a095",
                                                "sense_id": "cc1c4448-e148-3444-b4aa-2395856d535d",
                                                "text": "„Aus Sicherheitsgründen werden Verkehrsflugzeuge meist von zwei Piloten geführt (Flugkapitän und Co-Pilot).“"
                                            },
                                            {
                                                "example_id": "7fd3da1e-3ffb-4e31-8058-9e1574ecec7e",
                                                "sense_id": "cc1c4448-e148-3444-b4aa-2395856d535d",
                                                "text": "„In einer Zeit, da ein Mittelklassewagen wie der andere aussieht und sich auch moderne Verkehrsflugzeuge im Design nur unwesentlich voneinander unterscheiden, ist der Airbus A 380 eben ein besonderes Fluggerät.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81d37dc6-2fe4-4575-9db1-a21350fe5bb9",
                        "source_entry_id": "540461ac-df53-307e-90dd-a6c18d0d1ca3",
                        "source_sense_id": "b163c6ee-19b4-3dfd-94ed-af602c2ab4fe",
