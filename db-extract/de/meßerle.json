                "senses": [
                    {
                        "sense_id": "3bf12220-11aa-3fad-9b22-41a938809452",
                        "entry_id": "c21f1f82-5c35-3ceb-87e0-54c89a252978",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a290cde6-0666-454a-b926-f54b9f99b9ae",
                                "sense_id": "3bf12220-11aa-3fad-9b22-41a938809452",
                                "text": "Die Meßerles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "a56c2872-adea-4971-a7a4-823e1f695feb",
                                "sense_id": "3bf12220-11aa-3fad-9b22-41a938809452",
                                "text": "Frau Meßerle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7b8c3f11-d007-4804-9b4a-ffe47033a1b9",
                                "sense_id": "3bf12220-11aa-3fad-9b22-41a938809452",
                                "text": "Herr Meßerle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ed983801-a6a2-4814-bfb8-7111e6c06a10",
                                "sense_id": "3bf12220-11aa-3fad-9b22-41a938809452",
                                "text": "Der Meßerle trägt nie die Pullover, die die Meßerle ihm strickt."
                            },
                            {
                                "example_id": "d3c52a04-9ab9-4eb6-98c2-70c1223e7a5d",
                                "sense_id": "3bf12220-11aa-3fad-9b22-41a938809452",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Meßerle kommt, geht der Herr Meßerle.“"
                            },
                            {
                                "example_id": "ddda9619-6203-4797-baf3-8a6d52414a51",
                                "sense_id": "3bf12220-11aa-3fad-9b22-41a938809452",
                                "text": "Meßerle kommt und geht."
                            },
                            {
                                "example_id": "76d540d3-e8f0-4bed-995f-2e34f14f1569",
                                "sense_id": "3bf12220-11aa-3fad-9b22-41a938809452",
                                "text": "Meßerles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
