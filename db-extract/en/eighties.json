                    {
                        "translation_id": "5c6471af-59af-4291-8bfc-c406c8b1c7e3",
                        "source_entry_id": "8a34963e-7457-370e-9fdb-0268d9c15cb3",
                        "source_sense_description": "the decade of the 1980s",
                        "target_lang_word": "Achtzigerjahre",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Achtzigerjahre",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8d1e9ecf-7799-3736-b4b5-656fd67e0851",
                                        "entry_id": "249d3766-432b-31fd-b207-024c1f1d6de3",
                                        "glosses": [
                                            "die Jahre 80 bis 89 des gegenwärtigen oder besagten Jahrhunderts"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f99a14d-61ea-4344-a3ee-25965f32f5aa",
                                                "sense_id": "8d1e9ecf-7799-3736-b4b5-656fd67e0851",
                                                "text": "„Mein Vater landete Anfang der Achtzigerjahre mit einer kleinen Reisetasche am Flughafen Köln-Bonn.“"
                                            },
                                            {
                                                "example_id": "c0cab6ae-8adc-46f6-9fcd-1cf1d5bdc395",
                                                "sense_id": "8d1e9ecf-7799-3736-b4b5-656fd67e0851",
                                                "text": "„In den Achtzigerjahren ereignete sich auch die Kießling-Affäre, die fast eine Regierung zum Sturz brachte, zumindest Kohls Verteidigungsminister Wörner bedrohlich wurde.“"
                                            },
                                            {
                                                "example_id": "3874b4ee-669b-4c5c-9349-35ccc24a83a9",
                                                "sense_id": "8d1e9ecf-7799-3736-b4b5-656fd67e0851",
                                                "text": "„Knapp eine Generation jünger als der Erfinder des Mendele, reift Scholem Alejchem in den Achtzigerjahren zum Künstler, während der Antisemitismus im zaristischen Russland virulent zunimmt.“"
                                            },
                                            {
                                                "example_id": "75e62ca7-2172-48cd-8da2-60428d450a56",
                                                "sense_id": "8d1e9ecf-7799-3736-b4b5-656fd67e0851",
                                                "text": "„Anfang der Achtzigerjahre beauftragte er einen Privatdetektiv, das Schicksal der damaligen Heimbewohnerin Regine zu klären.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
