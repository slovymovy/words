                                    },
                                    {
                                        "sense_id": "a284d531-2866-310d-8fba-fc9809421298",
                                        "entry_id": "8ec669d6-da39-3978-8f85-4119eec8bd65",
                                        "glosses": [
                                            "Zellkern"
                                        ],
                                        "tags": [
