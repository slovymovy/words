                "senses": [
                    {
                        "sense_id": "ba88c696-3ad4-3caf-8ec9-0769cca2c6c6",
                        "entry_id": "20e62c7b-6589-36f0-81e8-7e443b6ad128",
                        "glosses": [
                            "dat wat in een (rang)ordening met 53 is aangeduid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe327de2-9a1f-483a-91a9-b2388465eb43",
                                "sense_id": "ba88c696-3ad4-3caf-8ec9-0769cca2c6c6",
                                "text": "Het is weer de drieënvijftig die het niet doet, kunnen we die niet simpel vervangen?"
                            },
                            {
                                "example_id": "933f01a3-35f3-474c-82d9-06d4e16fcbd8",
                                "sense_id": "ba88c696-3ad4-3caf-8ec9-0769cca2c6c6",
                                "text": "Haar vierenvijftigste verjaardag was een belangrijk moment, want haar leven werd heel anders toen ze de drieënvijftig eenmaal voorbij was."
                            }
                        ]
                    },
                    {
                        "sense_id": "3c79bdd6-949b-347b-aeee-1aa5a8d4237e",
                        "entry_id": "20e62c7b-6589-36f0-81e8-7e443b6ad128",
                        "glosses": [
                            "groep van 53 eenheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6aaee67d-0d6b-4c7d-ba52-02db02b361a6",
                                "sense_id": "3c79bdd6-949b-347b-aeee-1aa5a8d4237e",
                                "text": "De drieënvijftig zijn natuurlijk blij, maar laten we ook denken aan het verdriet van de vier die zijn afgewezen."
                            }
                        ]
                    }
                ],
