        "fr-extract.jsonl": [
            {
                "entry_id": "719ce59c-11ad-3553-8f5e-1ec016eb5db8",
                "word": "Bételgeuse",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "71bab4e1-0817-335d-9b21-191dcec544b3",
                        "entry_id": "719ce59c-11ad-3553-8f5e-1ec016eb5db8",
                        "glosses": [
                            "α Ori, étoile alpha de la constellation d’Orion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee8b05a1-5ff3-4805-9baa-55bab6daad9b",
                                "sense_id": "71bab4e1-0817-335d-9b21-191dcec544b3",
                                "text": "La fin de la journée se passa sans incident ; mais, vers le soir, après avoir admiré le fantastique coucher de Bételgeuse, dilatée à l'horizon au-delà de toute imagination humaine, nous eûmes l'impression d'un changement autour de nous."
                            },
                            {
                                "example_id": "dc3bc51d-ae13-400b-9c61-e7af215294d8",
                                "sense_id": "71bab4e1-0817-335d-9b21-191dcec544b3",
                                "text": "J'ai dû lui donner l'impression de revenir de très loin, de Bételgeuse ou d'Alpha du Centaure."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "910e3ec0-573b-4657-9f89-6f07924401dd",
                        "source_entry_id": "719ce59c-11ad-3553-8f5e-1ec016eb5db8",
                        "source_sense_id": "71bab4e1-0817-335d-9b21-191dcec544b3",
                        "target_lang_word": "Beteigeuze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beteigeuze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "da70633f-3bd3-386c-a810-c8a1b5f65a10",
                                        "entry_id": "8b860f1f-7e8f-3175-bcc5-318dd5597070",
                                        "glosses": [
                                            "roter Riesenstern und Hauptstern im Sternbild des Orion mit rund einer Milliarde Kilometer im Durchmesser"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fa5c616-0fa1-446a-b12d-0c93fdad0db5",
                                                "sense_id": "da70633f-3bd3-386c-a810-c8a1b5f65a10",
                                                "text": "Beteigeuze ist der zweithellste Stern im Sternbild Orion und fällt überdies durch seine rötliche Färbung auf."
                                            },
                                            {
                                                "example_id": "db215001-3900-4a4f-b904-e8a048de3291",
                                                "sense_id": "da70633f-3bd3-386c-a810-c8a1b5f65a10",
                                                "text": "„Nach gängiger Meinung der Astronomen wird Beteigeuze als Supernova enden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ef1fffa-8564-45ed-a0a8-f383ba255094",
                        "source_entry_id": "719ce59c-11ad-3553-8f5e-1ec016eb5db8",
                        "source_sense_id": "71bab4e1-0817-335d-9b21-191dcec544b3",
                        "target_lang_word": "Betelgeuse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Betelgeuse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "88a6058e-a382-3bd3-8a4c-2a6dab3f0699",
                                        "entry_id": "8f809c90-9942-3017-a3ee-969fa9bc11f7",
                                        "glosses": [
                                            "A bright-red supergiant intrinsic variable star, the second brightest star in the constellation Orion; Alpha (α) Orionis. It is the tenth brightest star in the nighttime, and one of the largest stars known."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65e21373-f490-453e-8568-7faca86b711b",
                                                "sense_id": "88a6058e-a382-3bd3-8a4c-2a6dab3f0699",
                                                "text": "Even if you don’t know it by name, the red supergiant star Betelgeuse is one of the most familiar sights in the heavens above—a gleaming ruddy dot at the shoulder of the constellation Orion. Although already quite difficult to overlook, Betelgeuse has become even more eye-catching across the past few years because of major changes in its appearance—unexpected fluctuations in its brightness that remain poorly understood."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
