                    },
                    {
                        "translation_id": "72b46f6b-b1ca-47cf-82b7-4f3ee754cbdc",
                        "source_entry_id": "16a9488f-8659-3ea2-8806-fa8c735dbe58",
                        "target_lang_word": "Radiosendung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Radiosendung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c42bde4a-4619-3510-bbe8-a5f004410524",
                                        "entry_id": "31e20396-6e54-3d1b-b9db-9c1e2522712e",
                                        "glosses": [
                                            "ein in sich abgeschlossener, im Radio ausgestrahlter Programmbeitrag"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64495c9f-25cd-4cb7-9477-8086f6ce7671",
                                                "sense_id": "c42bde4a-4619-3510-bbe8-a5f004410524",
                                                "text": "›Club aktuell‹ ist eine Radiosendung, die immer Freitag abends gesendet wird."
                                            },
                                            {
                                                "example_id": "fcc98863-2065-4dd2-9eb1-216f336338e6",
                                                "sense_id": "c42bde4a-4619-3510-bbe8-a5f004410524",
                                                "text": "„Ich habe auch an einer deutschen Radiosendung teilgenommen, die eine improvisierte Diskussion am runden Tisch über das Thema Vorurteil und Toleranz war.“"
                                            },
                                            {
                                                "example_id": "cb36e5de-7c20-4ae5-bb5a-6cf91209e31c",
                                                "sense_id": "c42bde4a-4619-3510-bbe8-a5f004410524",
                                                "text": "„In Radiosendungen, Filmen, Büchern, Broschüren und öffentlichen Gerichtsverhandlungen soll dem Volk der Täter bewußt werden, welchen Weg es beschritten hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c363910a-d569-4596-8556-33ab21c6593b",
                        "source_entry_id": "16a9488f-8659-3ea2-8806-fa8c735dbe58",
                        "target_lang_word": "radiodiffusion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "radiodiffusion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "91722aa5-9f0e-3011-b7a7-ba7da06bf00e",
                                        "entry_id": "62b8a372-8d68-315b-ace6-daf75f3a47ea",
                                        "glosses": [
                                            "Diffusion par les ondes électromagnétiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "397b2abf-17f0-44df-b0dd-7904fbcf2b8d",
                                                "sense_id": "91722aa5-9f0e-3011-b7a7-ba7da06bf00e",
                                                "text": "L’Assemblée nationale demandait à Québec « d’exiger du gouvernement du Canada qu’il détermine des quotas justes et équitables en matière de contenu original québécois et francophone, et qu’il les inscrive dans la Loi sur la radiodiffusion »."
                                            },
                                            {
                                                "example_id": "8d74819d-49c9-410d-b86c-533e48c9270f",
                                                "sense_id": "91722aa5-9f0e-3011-b7a7-ba7da06bf00e",
                                                "text": "La Table demande aussi que les licences soient renouvelées, mais seulement pour un an ou deux, notamment parce que le gouvernement va bientôt modifier la Loi sur la radiodiffusion, ce qui va donner plus de pouvoir au CRTC pour réglementer les plateformes en ligne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1643ff68-e2bf-4cd1-87f0-f264b92ea2de",
                        "source_entry_id": "16a9488f-8659-3ea2-8806-fa8c735dbe58",
                        "target_lang_word": "émission radiophonique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a4a9e6ec-9c81-4863-8eab-14d837928168",
                        "source_entry_id": "16a9488f-8659-3ea2-8806-fa8c735dbe58",
                        "target_lang_word": "diffusion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diffusion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4a027ab2-ade0-3db7-8763-10a3c440fe15",
                                        "entry_id": "74a26b0d-bd6c-3c74-93a1-0a11157952e0",
                                        "glosses": [
                                            "Action de répandre dans tous les sens."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ac21343-7e6a-4f17-b222-f7aecfa6360c",
                                                "sense_id": "4a027ab2-ade0-3db7-8763-10a3c440fe15",
                                                "text": "Eh! bien, ne reculant devant aucune tâche si fastidieuse fût-elle, ils pourvoiront, d’eux-mêmes, à la diffusion de ces ouvrages, en s’en faisant les traducteurs."
                                            },
                                            {
                                                "example_id": "dfe2447a-2438-4e2f-8ae5-7acbdf6aa14d",
                                                "sense_id": "4a027ab2-ade0-3db7-8763-10a3c440fe15",
                                                "text": "La ferme-école du Petit-Chêne, créée en 1849 à Mazières-en-Gâtine, joua un rôle important auprès des Gâtineaux dans la diffusion de ces techniques nouvelles."
                                            },
                                            {
                                                "example_id": "c7ea5d51-c74e-49ca-acef-bb2781c0c9dc",
                                                "sense_id": "4a027ab2-ade0-3db7-8763-10a3c440fe15",
                                                "text": "Une bâche de 1000 m² qui la recouvre et un dispositif d’aspersion de gouttes d’eau contribuent à éviter les projections alentour et à limiter la diffusion des poussières."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "308f3555-751e-3030-8935-d4875f286bf3",
                                        "entry_id": "74a26b0d-bd6c-3c74-93a1-0a11157952e0",
                                        "glosses": [
                                            "Pénétration ou migration d'espèces chimiques dans un milieu liquide ou gazeux."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bcd718a-6fab-43d5-8341-48e8c445942c",
                                                "sense_id": "308f3555-751e-3030-8935-d4875f286bf3",
                                                "text": "Dans les sucreries, le jus de la betterave se mêle à l’eau par diffusion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3e07334-4c02-32aa-88fd-a0963a3b99ac",
                                        "entry_id": "74a26b0d-bd6c-3c74-93a1-0a11157952e0",
                                        "glosses": [
                                            "Action de se répandre ou état de ce qui est répandu en parlant des gaz, de la chaleur, de la lumière, du son."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5d2fa52f-4fb9-30f7-b1f4-7e2b892f1ad0",
                                        "entry_id": "74a26b0d-bd6c-3c74-93a1-0a11157952e0",
                                        "glosses": [
                                            "Propagation des ondes (notamment de la lumière) lorsque celles-ci rencontrent un obstacle."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8f96447-4f10-4a27-a99b-1e1aec621370",
                                                "sense_id": "5d2fa52f-4fb9-30f7-b1f4-7e2b892f1ad0",
                                                "text": "Diffusion des ondes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97cee1a5-43f9-3b1b-8d10-77c021756eb1",
                                        "entry_id": "74a26b0d-bd6c-3c74-93a1-0a11157952e0",
                                        "glosses": [
                                            "Conduction thermique entre deux régions d’un même milieu ou entre deux milieux en contact sans déplacement appréciable de matière."
                                        ],
                                        "tags": [
                                            "Thermophysique"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "76ed391a-276a-3abf-b19a-f628fad33590",
                                        "entry_id": "74a26b0d-bd6c-3c74-93a1-0a11157952e0",
                                        "glosses": [
                                            "Caractère d'un style qui manque de concision, où les idées sont diffuses."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "849de078-9b45-41e7-8a43-35cef02c37da",
                                                "sense_id": "76ed391a-276a-3abf-b19a-f628fad33590",
                                                "text": "Certains styles manquent d'éloquence à cause de ce malheureux défaut de diffusion. Les mêmes choses seraient saisissantes si elles étaient ramassées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cb727c9-640c-3291-a8e0-20d1b9796c18",
                                        "entry_id": "74a26b0d-bd6c-3c74-93a1-0a11157952e0",
                                        "glosses": [
                                            "Processus dans lequel un changement de direction et d’énergie d’une particule incidente ou d’un rayonnement incident est provoqué par une collision avec une autre particule ou un système de particules."
                                        ],
                                        "tags": [
                                            "Physique des réacteurs nucléaires"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4fca8a29-3029-31af-a87f-f552d8ea4727",
                                        "entry_id": "74a26b0d-bd6c-3c74-93a1-0a11157952e0",
                                        "glosses": [
                                            "Distribution."
                                        ],
