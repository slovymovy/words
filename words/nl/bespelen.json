                                "ru": "Моя бабушка каждый день <w>играет</w> на пианино в гостиной."
                            }
                        },
                        {
                            "text": "Het is niet makkelijk om een <w>instrument te bespelen</w> zonder lessen.",
                            "target_lang_translations": {
                                "en": "It is not easy to <w>play</w> an instrument without lessons.",
                                "ru": "Нелегко <w>играть на инструменте</w> без уроков."
                            }
                        }
                    ],
                    "synonyms": [
                        "spelen"
                    ],
                    "common_phrases": [
