                                "target_senses": [
                                    {
                                        "sense_id": "b1e1097d-5523-3a98-b7ea-8215487638df",
                                        "entry_id": "d247e2c7-1382-3ddd-9ea1-77ab6429d7f4",
                                        "glosses": [
                                            "An ethnic or racial slur, typically caricaturing some identifiable (often physical) feature of the group being derided."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "963f50d5-578f-4e6f-bea8-218ded5e3217",
                                                "sense_id": "b1e1097d-5523-3a98-b7ea-8215487638df",
                                                "text": "It is unlikely that over the course of history white trash has inflicted as much suffering and anguish as nigger—few ethnophaulisms in the American lexicon have. Yet the term white trash has performed much of the same symbolic violence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfee8057-773a-30cd-a439-a53128b1bdbd",
                                        "entry_id": "d247e2c7-1382-3ddd-9ea1-77ab6429d7f4",
                                        "glosses": [
                                            "The use of such slurs."
