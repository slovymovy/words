                        "glosses": [
                            "Procédé par lequel on reporte sur une pierre lithographique une épreuve photographique."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e494479d-cc26-35cb-b9cc-655441102163",
                        "entry_id": "3a7049d0-50b1-39b7-b8fc-47ae6f24dce3",
                        "glosses": [
                            "Ensemble des opérations chimiques et optiques pour former des structures microscopiques sur la surface d’un substrat."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": [
                            {
                                "example_id": "462f612f-7315-48b3-8847-d46e96df94b9",
                                "sense_id": "e494479d-cc26-35cb-b9cc-655441102163",
                                "text": "La photolithographie est le procédé qui permet le transfert de motifs géométriques d’un masque vers une fine couche de résine photosensible qui recouvre une tranche de semi-conducteur."
                            }
                        ]
                    }
