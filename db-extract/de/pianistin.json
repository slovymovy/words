                ],
                "senses": [
                    {
                        "sense_id": "b7392d1a-454a-310d-a943-98019dad9404",
                        "entry_id": "5e933796-7978-3d15-b821-c7f9f6067eac",
                        "glosses": [
                            "eine weibliche Person, die (beruflich) Klavier spielt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "311d0368-1c16-4bd8-8475-bc76e99008c0",
                                "sense_id": "b7392d1a-454a-310d-a943-98019dad9404",
                                "text": "Sabina Hank ist eine österreichische Pianistin."
                            },
                            {
                                "example_id": "3d774942-aeec-42d9-a773-cfb6faeeb1e6",
                                "sense_id": "b7392d1a-454a-310d-a943-98019dad9404",
                                "text": "„Fachleute prophezeiten ihr eine sichere Zukunft als Pianistin von internationalem Rang.“"
                            },
                            {
                                "example_id": "ed27a6cd-644d-4b12-9e79-8fe9283909d0",
                                "sense_id": "b7392d1a-454a-310d-a943-98019dad9404",
                                "text": "„Die Pianistin und Komponistin Clara Schumann bat sie, das Libretto für eine Oper ihres Mannes Robert zu schreiben.“"
                            },
                            {
                                "example_id": "88f1079b-9af5-44d3-b24d-15ca2181826f",
                                "sense_id": "b7392d1a-454a-310d-a943-98019dad9404",
                                "text": "„Da fiel Sabina ein, daß Jay diese Geschichte kannte und wußte, daß dies von Lillian erzählt wurde; und Lillian hatte nicht als Harfenistin, sondern als Pianistin weitergespielt.“"
                            },
                            {
                                "example_id": "07045105-0ce4-48fc-9a26-eb1c4cf9fc48",
                                "sense_id": "b7392d1a-454a-310d-a943-98019dad9404",
                                "text": "„Das zeigte ihm endgültig, dass sie eine professionelle Pianistin war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b90f03ce-00f1-4edd-8e41-3fc380679d9e",
                        "source_entry_id": "5e933796-7978-3d15-b821-c7f9f6067eac",
                        "source_sense_id": "b7392d1a-454a-310d-a943-98019dad9404",
                        "source_sense_description": "eine weibliche Person, die (beruflich) Klavier spielt",
                        "target_lang_word": "pianist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pianist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d6779f9-a41d-3447-a44d-b5bc35443840",
                                        "entry_id": "a76cd033-c191-388c-8c93-bedd969c207b",
                                        "glosses": [
                                            "A person who plays the piano, particularly with skill or as part of an orchestra."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2bc4df5c-b31d-4fc0-be89-4401c335d124",
                                                "sense_id": "0d6779f9-a41d-3447-a44d-b5bc35443840",
                                                "text": "By the time she became the world's greatest pianist, she had already practised for thousands of hours on her prized piano."
                                            },
                                            {
                                                "example_id": "dd939a5c-e068-4009-a6c7-756028df8914",
                                                "sense_id": "0d6779f9-a41d-3447-a44d-b5bc35443840",
                                                "text": "Table IV shows that the pianists were significantly better on both motor and perceptual timing than the nonpianists."
                                            },
                                            {
                                                "example_id": "9cfeebfc-cfdc-4c7d-84f4-bcc351db338f",
                                                "sense_id": "0d6779f9-a41d-3447-a44d-b5bc35443840",
                                                "text": "The pianist was Jason Moran, another Houstonian, for whom the past converges with the present: he sometimes likes to find an unobtrusive sequence inside an old standard and turn it into fresh headlines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be6a82f5-1234-33a8-9fe7-a5664c3535d5",
                                        "entry_id": "a76cd033-c191-388c-8c93-bedd969c207b",
                                        "glosses": [
                                            "A spy using radio or wireless telegraphy to keep in touch with headquarters during the Second World War."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
