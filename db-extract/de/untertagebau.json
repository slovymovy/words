                ],
                "senses": [
                    {
                        "sense_id": "82c4cb58-281a-33b0-b94a-e4a6fbd22711",
                        "entry_id": "8494f180-acbe-304a-888c-6e349e6f048b",
                        "glosses": [
                            "Abbau, Förderung und Gewinnung von mineralischen Rohstoffen unter Tage (unter der Erdoberfläche)"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "a005014f-60e6-42ee-8e52-7671db7aa923",
                                "sense_id": "82c4cb58-281a-33b0-b94a-e4a6fbd22711",
                                "text": "„Wie die meisten der Tunnelarbeiter fand Antonio de Matos über einen Landsmann eine Stelle in der Schweiz und wurde in das Spezialkontingent für Arbeitskräfte im Untertagebau aufgenommen.“"
                            },
                            {
                                "example_id": "f4edded1-977b-454f-90b2-1bb1f2d3aa06",
                                "sense_id": "82c4cb58-281a-33b0-b94a-e4a6fbd22711",
                                "text": "„Nur von 1919 bis 1922 währte der Untertagebau in den Harburger Bergen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d2592f5c-dae2-387f-abe7-a8368d756de9",
                        "entry_id": "8494f180-acbe-304a-888c-6e349e6f048b",
                        "glosses": [
                            "technische Anlage zum Abbau, Förderung und Gewinnung von mineralischen Rohstoffen unter Tage"
                        ],
                        "tags": [
                            "Bergbau"
                        ],
                        "examples": [
                            {
                                "example_id": "3f8ef145-3bf8-437d-9e48-f6e7325df0f8",
                                "sense_id": "d2592f5c-dae2-387f-abe7-a8368d756de9",
                                "text": "„Die Geschichte der Kohleförderung in Nachterstedt reicht bis ins 19. Jahrhundert zurück, damals noch im Untertagebau.“"
                            },
                            {
                                "example_id": "649c875c-1035-4842-920b-3968d2917cdd",
                                "sense_id": "d2592f5c-dae2-387f-abe7-a8368d756de9",
                                "text": "„Mein Vater verdiente damals als Bergbauer im Untertagebau, später als Walzenbauer am Hochofen, relativ gut.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
