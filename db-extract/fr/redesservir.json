                "senses": [
                    {
                        "sense_id": "6d997d4b-c797-3956-9dd3-15d40da55c6d",
                        "entry_id": "5cae0edc-f58e-308e-b811-d7a551bb2bab",
                        "glosses": [
                            "Desservir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6223466a-77f0-4e89-96f5-4ec70c6ec113",
                                "sense_id": "6d997d4b-c797-3956-9dd3-15d40da55c6d",
                                "text": "La navette Joliot-Curie a été créée dans le but de redesservir les quartiers de Saint Jacques et du Douet, abandonnés lors de la restructuration du réseau autour de la ligne 4."
                            },
                            {
                                "example_id": "5d6731e4-b217-4b7a-bb6d-d2cfdfa5677e",
                                "sense_id": "6d997d4b-c797-3956-9dd3-15d40da55c6d",
                                "text": "Nous espérons que l'entreprise sera capable de surmonter les problèmes de trésorerie auxquels elle se trouve confrontée et qu'elle pourra reprendre ses vols et pourquoi pas, redesservir Mayotte et l' Océan Indien."
                            },
                            {
                                "example_id": "4323186c-1e8f-4679-a5b5-ca5af5384031",
                                "sense_id": "6d997d4b-c797-3956-9dd3-15d40da55c6d",
                                "text": "Impossible de redesservir la gare des Gobelins ? Quelle connerie !"
                            }
                        ]
                    }
