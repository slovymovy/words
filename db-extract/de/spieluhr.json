                    }
                ],
                "senses": [
                    {
                        "sense_id": "b7e3ade6-54ee-35f9-b64e-3e75720a32ef",
                        "entry_id": "471c6c39-64e9-3cb9-91db-f221efb67586",
                        "glosses": [
                            "mechanische Uhr mit einem Spielwerk, die die Zeit akustisch mit einer kleinen Melodie anzeigt; Spieldose mit Uhrwerk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70808094-6d5f-45f0-8fcb-a5a371c72cae",
                                "sense_id": "b7e3ade6-54ee-35f9-b64e-3e75720a32ef",
                                "text": "„Charlotte lacht, stößt die Spieluhr an.“"
                            },
                            {
                                "example_id": "18e13563-a415-4e43-a01e-046f840fee75",
                                "sense_id": "b7e3ade6-54ee-35f9-b64e-3e75720a32ef",
                                "text": "Seine Spieluhr war schon alt und museumsreif."
                            },
                            {
                                "example_id": "46c8b208-8e58-4398-a4cb-73beb0bdbff6",
                                "sense_id": "b7e3ade6-54ee-35f9-b64e-3e75720a32ef",
                                "text": "„Ich kenne diese Leidenschaft von ihm, er hat sie früher an Kindereisenbahnen und Spieluhren betätigt.“"
                            },
                            {
                                "example_id": "92ffb489-4516-48c0-96a3-61c657158846",
                                "sense_id": "b7e3ade6-54ee-35f9-b64e-3e75720a32ef",
                                "text": "„Papiere und Fotos liegen herum, das hölzerne Gehäuse einer alten Spieluhr ist beim gewaltsamen Öffnen zerbrochen.“"
                            },
                            {
                                "example_id": "59c5f29d-a3b2-4b65-b509-17aa1c43e3ea",
                                "sense_id": "b7e3ade6-54ee-35f9-b64e-3e75720a32ef",
                                "text": "„Die Spieluhr entstand im ersten Jahrzehnt des 16. Jahrhunderts, in einer Epoche, als Nürnberg das deutsche und europäische Zentrum der Feinmechanik war und Peter Henlein seine Taschenuhren montierte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
