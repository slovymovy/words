                                    {
                                        "sense_id": "6d0936bf-ea14-397c-9bf1-2f31b169670d",
                                        "entry_id": "1195af94-3d24-30d8-8890-08c986664f4e",
                                        "glosses": [
                                            "A female given name from Ancient Greek."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff3cb560-2383-48a8-8694-480240df17d8",
                                                "sense_id": "6d0936bf-ea14-397c-9bf1-2f31b169670d",
                                                "text": "Sea-king's daughter from over the sea, / Alexandra! / Saxon and Norman and Dane are we, / But all of us Danes in our welcome of thee, / Alexandra!"
                                            },
                                            {
                                                "example_id": "af4e44d3-8ce6-41df-9f7a-0bd25d50d7a7",
                                                "sense_id": "6d0936bf-ea14-397c-9bf1-2f31b169670d",
                                                "text": "'I had a Christmas card from someone calling herself Alex the year before last,' Daniel said. 'I couldn't think who it was.'\n'Oh, yes, she's changed again,' Alice said. 'I never got used to Alexandra, either. It never occurred to me that Sandra was short for Alexandra - anyway, she's Sandra on her birth certificate.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c056f6d6-73f0-3944-99aa-a3a5d84f743b",
                                        "entry_id": "1195af94-3d24-30d8-8890-08c986664f4e",
                                        "glosses": [
                                            "54 Alexandra, a main belt asteroid; named for German explorer Alexander von Humboldt."
                                        ],
