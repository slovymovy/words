                                "target_senses": [
                                    {
                                        "sense_id": "8a8d068c-cbce-3162-b688-4667ee534cf9",
                                        "entry_id": "7eef9b8e-e0a6-3dcf-a222-a826f47d61c1",
                                        "glosses": [
                                            "Commonwealth standard spelling of parlor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1078fc0-1528-479f-8bdc-5d27196801ca",
                                                "sense_id": "8a8d068c-cbce-3162-b688-4667ee534cf9",
                                                "text": "Will you walk into my parlour, said a Spider to a Fly; / 'Tis the prettiest little parlour that ever you did spy."
                                            },
                                            {
                                                "example_id": "f1be898e-3154-4418-a51f-fee23d3a2393",
                                                "sense_id": "8a8d068c-cbce-3162-b688-4667ee534cf9",
                                                "text": "At half-past nine on this Saturday evening, the parlour of the Salutation Inn, High Holborn, contained most of its customary visitors.[…]In former days every tavern of repute kept such a room for its own select circle, a club, or society, of habitués, who met every evening, for a pipe and a cheerful glass."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
