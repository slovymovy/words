                    {
                        "sense_id": "fa5c727f-6133-3647-9ec1-8af61422e4c0",
                        "entry_id": "22897fb1-989a-3184-874e-39e69c2a493f",
                        "glosses": [
                            "Skelett eines Mammuts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ad900ae-c284-4772-8fbb-2df73cc72641",
                                "sense_id": "fa5c727f-6133-3647-9ec1-8af61422e4c0",
                                "text": "„Es ist nicht der erste Aufsehen erregende Mammut-Fund in Mexiko. In den 1970er Jahren stießen Bauarbeiter beim U-Bahn-Bau im Norden von Mexiko-Stadt auf ein Mammutskelett.“"
                            },
                            {
                                "example_id": "540a6d41-c805-474b-a982-6537936cb1fb",
                                "sense_id": "fa5c727f-6133-3647-9ec1-8af61422e4c0",
                                "text": "„Dieser grub im Zeitraum von 1930 bis 1933 gemeinsam mit seinem Sohn in der Kiesgrube bei Edersleben auch das erwähnte Mammutskelett aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
