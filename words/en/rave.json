                },
                {
                    "sense_id": "ff88527d-236c-3032-a5f0-6f5580c67a94",
                    "sense_definition": "Simple past of <w>rive</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lightning <w>rave</w> the ancient oak tree in two during the storm.",
                            "target_lang_translations": {
                                "ru": "Молния <w>расколола</w> древний дуб надвое во время грозы."
                            }
                        },
                        {
                            "text": "He <w>rave</w> the document into pieces in a moment of pure frustration.",
                            "target_lang_translations": {
                                "ru": "Он <w>разорвал</w> документ в клочья в момент полного отчаяния."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "The past tense 'rived' or 'riven' is more common today"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время глагола 'rive' (раскалывать, раздирать)."
