                                            {
                                                "example_id": "a298a3b3-9499-4300-9123-dfddf3ab4cd8",
                                                "sense_id": "8db235d7-5e77-3aa4-8cd8-3c3273a62c44",
                                                "text": "Zoiets is nog nooit vertoond."
                                            },
                                            {
                                                "example_id": "2cd97c7d-c4fa-4ab6-9622-b631b6893843",
                                                "sense_id": "8db235d7-5e77-3aa4-8cd8-3c3273a62c44",
                                                "text": "Wij vonden 25 kilometer per dag al prima, terwijl jullie nu ruim 40 kilometer per dag doorjakkeren. Neem toch de tijd, zoiets maak je maar een keer in je leven mee. Het heeft me nooit losgelaten na al die jaren.’"
                                            },
                                            {
                                                "example_id": "39cdb995-6807-4905-9ba7-2540d0fb385a",
                                                "sense_id": "8db235d7-5e77-3aa4-8cd8-3c3273a62c44",
                                                "text": "Zoiets heeft Jos nog nooit tegen me gezegd."
                                            },
                                            {
                                                "example_id": "6c0ef3c6-1080-4624-8136-33771a4a523c",
                                                "sense_id": "8db235d7-5e77-3aa4-8cd8-3c3273a62c44",
                                                "text": "'Je mag het misschien wel denken, en dóén voor mijn part, maar waarom zou je zoiets aan een collega vertellen?' Jaap haalt zuchtend zijn schouders op."
                                            }
