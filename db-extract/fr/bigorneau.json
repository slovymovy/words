                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "80d1403d-77a6-4b5f-b6cf-5579817abe71",
                        "source_entry_id": "c3ccb355-c66d-36fb-8251-b32604cbca45",
                        "source_sense_description": "littorine",
                        "target_lang_word": "periwinkle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "periwinkle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "670d61da-6bd6-3ed0-9b44-84e49ca29c7d",
                                        "entry_id": "07f3f004-1129-3d7c-a6e4-50d7358aeb50",
                                        "glosses": [
                                            "Any of several evergreen plants of the genus Vinca with blue or white flowers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d10ef679-56f8-47c8-adce-3bb2b811424a",
                                                "sense_id": "670d61da-6bd6-3ed0-9b44-84e49ca29c7d",
                                                "text": "The Periwinkle is a great binder, staying bleeding both at mouth and nose if some of the leaves be chewed."
                                            },
                                            {
                                                "example_id": "e7d628da-b474-4cb2-9708-c3e25dc50c01",
                                                "sense_id": "670d61da-6bd6-3ed0-9b44-84e49ca29c7d",
                                                "text": "He that vvould diſcern the rudimentall ſtroak of a plant, may behold it in the Originall of Duckvveed, at the bigneſſe of a pins point, from convenient vvater in glaſſes, vvherein a vvatchfull eye may alſo diſcover the puncticular Originals of Perivvincles and Gnats."
                                            },
                                            {
                                                "example_id": "6f5a5040-7347-4d96-9bb0-8edd67cc38e6",
                                                "sense_id": "670d61da-6bd6-3ed0-9b44-84e49ca29c7d",
                                                "text": "Among herbs that have traditionally been considered to possess aphrodisiac virtue are, maidenhair, navelwort, anemone, wild poppy, valerian, cyclamen, male fern, pansy, periwinkle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5a47403-3c6a-3480-a256-0e43d79c6d8e",
                                        "entry_id": "07f3f004-1129-3d7c-a6e4-50d7358aeb50",
                                        "glosses": [
                                            "Similar plants of genus Catharanthus."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c10e7ea7-bb7b-396e-8d4d-2f083fede677",
                                        "entry_id": "07f3f004-1129-3d7c-a6e4-50d7358aeb50",
                                        "glosses": [
                                            "A color with bluish and purplish hues, somewhat light."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d196039-7a7f-4cd3-b824-8beb176b0344",
                                                "sense_id": "c10e7ea7-bb7b-396e-8d4d-2f083fede677",
                                                "text": "And although we’ve certainly seen a variety of blue shades — from periwinkle to cobalt and even Dean Cain’s indigo-washed costume from the 1990’s TV show “Lois & Clark” — Superman’s uniform is still instantly recognizable across generations. In fact, there is only one film — Zack Snyder’s 2013 “Man of Steel” — in which Superman does not wear his iconic red belted trunks."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "periwinkle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5cb750e0-55e2-3060-a550-fcacfec18410",
                                        "entry_id": "f2f70b35-caff-3823-a5f0-b38faaf8f04a",
                                        "glosses": [
                                            "Of pale bluish purple colour."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "periwinkle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93630a18-a250-341c-87a4-dfa83a67b6e0",
                                        "entry_id": "eaec4396-73de-3e5e-97f4-3a15c5de2bf4",
                                        "glosses": [
                                            "A mollusk of family Littorinidae."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2162a6f2-4b34-43ce-b50f-daf16d4920e2",
                                                "sense_id": "93630a18-a250-341c-87a4-dfa83a67b6e0",
                                                "text": "He was working a pin into a periwinkle shell, turning it to extract the toothsome morsel of meat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06c4653d-6cea-466e-a1d6-1aeea6f6d350",
                        "source_entry_id": "c3ccb355-c66d-36fb-8251-b32604cbca45",
                        "source_sense_description": "littorine",
                        "target_lang_word": "winkle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "winkle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "75f03d84-5df4-3d37-bff9-7f589fe40eb6",
                                        "entry_id": "50f24340-5065-39e3-856d-6bcd25a1f402",
                                        "glosses": [
                                            "A periwinkle or its shell, of family Littorinidae."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "059b78d3-13f5-4f98-9979-bbcc62c042b4",
                                                "sense_id": "75f03d84-5df4-3d37-bff9-7f589fe40eb6",
                                                "text": "[…] because the inward Eare is intorted like a winkle-shell, and hangeth as a bell in thee steeple of the body, it easily perceiueth all appulsions of the Ayre."
                                            },
                                            {
                                                "example_id": "c6ae87ed-0d4b-4405-9799-ee0a8dd74ec7",
                                                "sense_id": "75f03d84-5df4-3d37-bff9-7f589fe40eb6",
                                                "text": "Shrimps and winkles are the staple commodities of the afternoon trade, which lasts from three to half-past five in the evening. These articles are generally bought by the working-classes for their tea."
                                            },
                                            {
                                                "example_id": "a3ce583a-0046-4736-84e8-59e25810e8bf",
                                                "sense_id": "75f03d84-5df4-3d37-bff9-7f589fe40eb6",
                                                "text": "Sometimes late at night men would come in with a pail of winkles they had bought cheap, and share them out."
                                            },
                                            {
                                                "example_id": "2e9e0d7d-d644-4118-a2f2-9e2731a5a2b7",
                                                "sense_id": "75f03d84-5df4-3d37-bff9-7f589fe40eb6",
                                                "text": "Briony was on her knees, trying to put her arms round Lola and gather her to her, but the body was bony and unyielding, wrapped tight about itself like a seashell. A winkle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8dd47fe0-2700-3ef9-b9bc-18121d2a67f9",
                                        "entry_id": "50f24340-5065-39e3-856d-6bcd25a1f402",
                                        "glosses": [
                                            "Any one of various marine spiral gastropods, especially, in the United States, either of two species Busycotypus canaliculatus or Busycon carica."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b23308a5-93ac-4c94-b9ec-61f4df251f44",
                                                "sense_id": "8dd47fe0-2700-3ef9-b9bc-18121d2a67f9",
                                                "text": "There were also found fragments of the winkle (Fulgar carica)."
                                            },
                                            {
                                                "example_id": "e7c1bd97-aff1-47b3-b72a-f025984a6321",
                                                "sense_id": "8dd47fe0-2700-3ef9-b9bc-18121d2a67f9",
                                                "text": "The conchs or winkles, Busycon carica (fig. 204, opp. p. 216) and B. canaliculata, ... He gave the estimate of one planter who believed that one winkle was able to destroy a bushel of oysters in a single hour."
                                            },
                                            {
                                                "example_id": "6cd01eb6-9b6b-4610-b46e-16897d24b059",
                                                "sense_id": "8dd47fe0-2700-3ef9-b9bc-18121d2a67f9",
                                                "text": "In Connecticut, the so-called \"winkle\" chowder is made from B. [Busycon] canaliculatum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2872120-46b4-3c65-975b-bbdb3c51ea9d",
                                        "entry_id": "50f24340-5065-39e3-856d-6bcd25a1f402",
                                        "glosses": [
                                            "The penis, especially that of a child rather than that of an adult."
                                        ],
                                        "tags": [
                                            "childish",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e370365-ff0f-48d3-b34c-29458e3e1282",
                                                "sense_id": "b2872120-46b4-3c65-975b-bbdb3c51ea9d",
                                                "text": "After all, he didn't want his winkle to get so big it became unruly and unnatural."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "winkle",
