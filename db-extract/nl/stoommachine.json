                        "source_sense_id": "3595e9b1-624a-30ab-a317-793ee52ae35b",
                        "source_sense_description": "een machine die door middel van stoom drijfkracht ontwikkelt",
                        "target_lang_word": "machine à vapeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "machine à vapeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c278b471-c57d-3a15-be9b-4e5a240f2ac2",
                                        "entry_id": "ffef0c1b-5938-3cc7-a511-687106997347",
                                        "glosses": [
                                            "Moteur thermique à combustion externe qui transforme l’énergie thermique de la vapeur d’eau en énergie mécanique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3423b10-a53d-4dec-b329-31bb1345f655",
                                                "sense_id": "c278b471-c57d-3a15-be9b-4e5a240f2ac2",
                                                "text": "De nos jours, on a appliqué les machines à vapeur à la mouture du blé comme à toutes les autres industries."
                                            },
                                            {
                                                "example_id": "db6cd456-32b2-47f7-b1e5-f4d880607956",
                                                "sense_id": "c278b471-c57d-3a15-be9b-4e5a240f2ac2",
                                                "text": "Si l’on a trouvé le moyen d’arrêter les machines à vapeur, celui de stoper la langue d’une portière épuisera le génie des inventeurs."
                                            },
                                            {
                                                "example_id": "0872a3da-0a28-419b-ad2d-d4b4306cd1e3",
                                                "sense_id": "c278b471-c57d-3a15-be9b-4e5a240f2ac2",
                                                "text": "Le charbon n’a pas pour fonction de faire tourner une machine à vapeur qui ne sera inventée par James Watt qu’en 1784, mais de servir de moyen de chauffage domestique, notamment aux paysans expropriés devenus ouvriers en ville."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
