                                "sense_id": "553a35a2-57c2-3832-a23e-37abd033815a",
                                "text": "Het voetpad was bedekt met herfstbladeren.",
                                "translation": "The footpath was covered with autumn leaves.",
                                "english": "The footpath was covered with autumn leaves."
                            },
                            {
                                "example_id": "73251e67-f5e3-4a0e-936a-b8e11c710dae",
                                "sense_id": "553a35a2-57c2-3832-a23e-37abd033815a",
                                "text": "We liepen over het voetpad naast de rivier.",
                                "translation": "We walked on the footpath beside the river.",
                                "english": "We walked on the footpath beside the river."
                            },
                            {
                                "example_id": "20c76c39-f0af-4c38-91c6-da9507eb4084",
                                "sense_id": "553a35a2-57c2-3832-a23e-37abd033815a",
                                "text": "Het voetpad leidt je naar het oude kasteel.",
                                "translation": "The footpath will lead you to the old castle.",
