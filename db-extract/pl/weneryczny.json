                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5476df0e-5725-421a-a3bb-226e4846e9a8",
                        "source_entry_id": "fd4417df-64b7-38e0-9bb5-708c5c070bd7",
                        "source_sense_id": "1960c9c0-bad9-370b-ba1e-0aabdfd8839a",
                        "target_lang_word": "venereal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "venereal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c009830f-13a2-3e70-b4ef-cef9ff60a96e",
                                        "entry_id": "82dd4212-e50f-3078-b831-abddfaa0fa7f",
                                        "glosses": [
                                            "Of or relating to the genitals or sexual intercourse."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7f8a05c-13d1-4413-8c7c-790ae9f4fbcd",
                                                "sense_id": "c009830f-13a2-3e70-b4ef-cef9ff60a96e",
                                                "text": "Wouldſt thou not haue ſome Bulchin from the herd / To phyſicke thee of this venereall itch?"
                                            },
                                            {
                                                "example_id": "b3a2a643-8abe-4df4-b51c-061f96da0ba1",
                                                "sense_id": "c009830f-13a2-3e70-b4ef-cef9ff60a96e",
                                                "text": "[B]ecauſe ſuch hot temperaments are prone to Venerie, hence the Poets feigned, that Mars lay with Venus; and withall to ſhew, how much ſouldiers are given to Venereall luſts; [...]"
                                            },
                                            {
                                                "example_id": "8e8fd20c-c2f2-4398-97dd-aad05bcbec36",
                                                "sense_id": "c009830f-13a2-3e70-b4ef-cef9ff60a96e",
                                                "text": "Then ſwoll'n with pride into the ſnare I fell / Of fair, fallacious looks, venereal trains, / Softn'd with pleaſure and voluptuous life; [...]"
                                            },
                                            {
                                                "example_id": "6d04cabf-699f-4e6a-968b-8fbf88c98c02",
                                                "sense_id": "c009830f-13a2-3e70-b4ef-cef9ff60a96e",
                                                "text": "And so, while husbands are worshiping at their boyhood shrines, being the lawyers, merchants, or masterminds their parents wanted them to be, their wives, even after fourteen years of marriage and two fine children produced and raised, are still on the search for love - which can come to them only from the centaurs, sileni, satyrs, and other concupiscent incubi of the rout of Pan [...] as in our popular, vanilla-frosted temples of the venereal goddess, under the make-up of the latest heroes of the screen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26c106e3-a382-3c80-83be-2d3fb9c65f80",
                                        "entry_id": "82dd4212-e50f-3078-b831-abddfaa0fa7f",
                                        "glosses": [
                                            "Of a disease: sexually transmitted; of or relating to, or adapted to the cure of, a venereal disease."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c10253f7-96ad-4b0c-a0e2-293bde5fd2a7",
                                                "sense_id": "26c106e3-a382-3c80-83be-2d3fb9c65f80",
                                                "text": "a venereal medicine"
                                            },
                                            {
                                                "example_id": "3c51f952-2187-49d5-8498-fbff1a4c0cc2",
                                                "sense_id": "26c106e3-a382-3c80-83be-2d3fb9c65f80",
                                                "text": "[...] I like not his countenance; I am afraid he labours of the venereall murre."
                                            },
                                            {
                                                "example_id": "e6b2a3d6-6aba-4c35-a4f6-f00cb1b282b5",
                                                "sense_id": "26c106e3-a382-3c80-83be-2d3fb9c65f80",
                                                "text": "[...] Who can imagine that in a venereall ulcer, wherein there is corruption of the bone, there ſhould be two ſorts of ulcers ſpecifically differing? to wit, one in the fleſhy part, and another in the bone, the ſame humor cauſing both."
                                            },
                                            {
                                                "example_id": "4f20e40d-0612-4f10-a529-c2a4b4e2641a",
                                                "sense_id": "26c106e3-a382-3c80-83be-2d3fb9c65f80",
                                                "text": "Venereal diseases were responsible for four deaths and 141 final invalidings, [...]"
                                            },
                                            {
                                                "example_id": "cd4f95b3-d050-4bff-b8b2-e7326721a609",
                                                "sense_id": "26c106e3-a382-3c80-83be-2d3fb9c65f80",
                                                "text": "[I]t must be recognized that there are two distinct and separate phases of venereal disease education: (1) the imparting to the individual of adequate technical knowledge of the venereal diseases and their prevention, and (2) the motivation of the individual with the will to avoid either illicit sexual intercourse or unprotected sexual exposure."
                                            },
                                            {
                                                "example_id": "5688800f-ada0-4e28-a6de-d897ac14ba84",
                                                "sense_id": "26c106e3-a382-3c80-83be-2d3fb9c65f80",
                                                "text": "Within a fortnight of their arrival 'a startling outburst' of venereal disease occurred among the troops. Over the next four months more than 2000 Australian soldiers were infected."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8fb3e3b-6ffe-3ee0-a564-51083a5346ff",
                                        "entry_id": "82dd4212-e50f-3078-b831-abddfaa0fa7f",
                                        "glosses": [
                                            "Pertaining to the astrological influence of the planet Venus; lascivious, lustful."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e34687f1-85c7-4da0-ac3e-4c49ee782d40",
                                                "sense_id": "a8fb3e3b-6ffe-3ee0-a564-51083a5346ff",
                                                "text": "The Venereall, are the delitious, laſcivious, mild, kinde, pleaſant, and tame; as the Calfe, cony, dog, goat, and ſcinck."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13ef9bc2-6098-37ad-9bc8-f6ef2e94519a",
                                        "entry_id": "82dd4212-e50f-3078-b831-abddfaa0fa7f",
                                        "glosses": [
                                            "Of or relating to copper (formerly called Venus by alchemists)."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7390777d-841f-46d0-a004-79c47052ae82",
                                                "sense_id": "13ef9bc2-6098-37ad-9bc8-f6ef2e94519a",
                                                "text": "When after their beaſtly ſport and pleaſure Mounſieur Libid[inoſo] heat of luſt was ſomewhat aſſwaged, and ready to goe, féeling his pocket for a venereall remuneration [i.e., a copper coin] finds nothing but a Teſter, or at leaſt ſo little, that it was not ſufficient to pleaſe dame Pleaſure for her hire. [...] My Ladie would not beléeue Monſ. Libid. a great while, but ſearched and féeled for more coine, [...]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
