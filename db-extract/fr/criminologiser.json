                ],
                "senses": [
                    {
                        "sense_id": "722da64a-c166-3c4b-8f71-b2563875f2f3",
                        "entry_id": "804a3346-4a11-3e25-a584-a9ec06aa40c7",
                        "glosses": [
                            "Donner un caractère criminologique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f1f09b5-7629-42b7-8f03-3e682586292a",
                                "sense_id": "722da64a-c166-3c4b-8f71-b2563875f2f3",
                                "text": "Sept regards et demi, la criminologie se refusant ici à « criminologiser » cet objet, un choix sur lequel son représentant s'explique."
                            },
                            {
                                "example_id": "12986eec-673d-4096-b9c8-2ea41b39c94b",
                                "sense_id": "722da64a-c166-3c4b-8f71-b2563875f2f3",
                                "text": "Il faut « criminologiser » la procédure pénale."
                            },
                            {
                                "example_id": "217e7698-9537-41f0-9c91-4729b1c1009f",
                                "sense_id": "722da64a-c166-3c4b-8f71-b2563875f2f3",
                                "text": "Peur de « criminologiser » comme il y a 40 ans, la peur de. « psychologiser », de. « pathologiser », de « médicaliser »."
                            }
                        ]
                    }
                ],
