                "senses": [
                    {
                        "sense_id": "5ecc4d51-30d5-3b22-8937-fbaea5b6743c",
                        "entry_id": "fe387a88-fc07-3a84-8900-99ed13bfcec3",
                        "glosses": [
                            "Einwohner des Burgenlandes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26a70984-48f6-4834-8db1-d86d23fa829c",
                                "sense_id": "5ecc4d51-30d5-3b22-8937-fbaea5b6743c",
                                "text": "„Die Burgenländerinnen und Burgenländer wissen durchaus, wofür ihr Land steht.“"
                            },
                            {
                                "example_id": "34f03b95-387d-4acb-b9b3-5807b4b77869",
                                "sense_id": "5ecc4d51-30d5-3b22-8937-fbaea5b6743c",
                                "text": "„Der 39-jährige Burgenländer, der im Zusammenhang mit an Firmen verschickten Briefsendungen mit verdächtigen Substanzen ausgeforscht worden war, legte am Donnerstag ein Geständnis ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fbb21aa8-5988-32c9-b1f3-1311d016f12b",
                        "entry_id": "fe387a88-fc07-3a84-8900-99ed13bfcec3",
                        "glosses": [
                            "Einwohner des Burgenlandkreises"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac30dffd-5a2d-4ee3-88bf-5298d82b56cd",
                                "sense_id": "fbb21aa8-5988-32c9-b1f3-1311d016f12b",
                                "text": "„Die Burgenländer sind im Bundesvergleich sogar besonders häufig krankgeschrieben.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
