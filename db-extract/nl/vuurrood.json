                                        "entry_id": "d5a144f5-f613-315d-a7c3-54f5a2a0be32",
                                        "glosses": [
                                            "Couleur d’un rouge vif et clair #fe1b00, tirant parfois sur l’orangé #ff4901."
                                        ],
                                        "tags": [],
