                                    {
                                        "sense_id": "11f81815-5625-3b9b-943e-baad5221cf92",
                                        "entry_id": "6f62b4aa-d358-3a1a-950f-6e0a870a07dc",
                                        "glosses": [
                                            "Person oder Institution, die etwas Neues als erste tut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb77ea91-22df-4b75-a32a-e15a947484ab",
                                                "sense_id": "11f81815-5625-3b9b-943e-baad5221cf92",
                                                "text": "Deutschland möchte sich als Vorreiter im Klimaschutz bewähren."
                                            },
                                            {
                                                "example_id": "e2897893-a66a-495e-b6e3-1d7ec6a23469",
                                                "sense_id": "11f81815-5625-3b9b-943e-baad5221cf92",
                                                "text": "Er wollte gern immer Vorreiter sein, tatsächlich hinkte er meistens hinter der Entwicklung her."
                                            },
                                            {
                                                "example_id": "c20e0e4e-fdf7-48af-9d59-1cb9b8ee4055",
                                                "sense_id": "11f81815-5625-3b9b-943e-baad5221cf92",
                                                "text": "„In Shenzhen werden seit 2007 bereits 100 Prozent des öffentlichen Personentransfers elektrisch durchgeführt. Damit ist die Stadt weltweit Vorreiter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
