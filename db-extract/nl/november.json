                                "target_senses": [
                                    {
                                        "sense_id": "ac8c5aec-6887-3ed0-86e9-0b34b0ba2c0c",
                                        "entry_id": "bfcadcbb-0608-308e-b821-18f3c0ba5059",
                                        "glosses": [
                                            "одиннадцатый месяц года в юлианском и григорианском календарях"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da163a49-570e-41e6-846b-0fbc07042a8a",
                                                "sense_id": "ac8c5aec-6887-3ed0-86e9-0b34b0ba2c0c",
                                                "text": "До сих пор мы вас считали хорошим соседом, другом, в прошлом году давали вам свою молотилку, и через это самим нам пришлось домолачивать свой хлеб в ноябре, а вы поступаете с нами, как с цыганами."
                                            },
                                            {
                                                "example_id": "a9cf7908-4279-4e37-9fdc-1bceb120d540",
                                                "sense_id": "ac8c5aec-6887-3ed0-86e9-0b34b0ba2c0c",
                                                "text": "Но зато и осень затягивается до половины или конца ноября."
                                            },
                                            {
                                                "example_id": "0247311b-db13-4082-91f9-16e3014930bc",
                                                "sense_id": "ac8c5aec-6887-3ed0-86e9-0b34b0ba2c0c",
                                                "text": "Третьего июня ― месяц опять сентябрь, но уже немного ноябрь."
                                            },
                                            {
                                                "example_id": "7b53f747-b65d-42b5-99a9-a1125f4882e9",
                                                "sense_id": "ac8c5aec-6887-3ed0-86e9-0b34b0ba2c0c",
                                                "text": "На дворе ноябрь, серо, снег идёт ― а они зайчики пускают, во как!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
