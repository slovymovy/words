                "senses": [
                    {
                        "sense_id": "c6a83ee9-c2fd-3f8e-947c-abbce2c5d940",
                        "entry_id": "a7eb3d17-678b-3707-9de3-ddf5b6b3fd5d",
                        "glosses": [
                            "weibliche Person, die an Dystrophie leidet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7c5a0b3-c1c0-42b6-8843-21540df69222",
                                "sense_id": "c6a83ee9-c2fd-3f8e-947c-abbce2c5d940",
                                "text": "Meine Cousine ist Dystrophikerin."
                            },
                            {
                                "example_id": "15f1012c-678d-4b68-a264-5809aec4a2eb",
                                "sense_id": "c6a83ee9-c2fd-3f8e-947c-abbce2c5d940",
                                "text": "„Meine ältere Schwester Ester war eine sehr schöne Frau. Gegen Ende des Ghettos war sie eine Dystrophikerin. Sie war nur noch Haut und Knochen.“"
                            },
                            {
                                "example_id": "6b8f91d9-6563-4532-b0b1-8b887209d687",
                                "sense_id": "c6a83ee9-c2fd-3f8e-947c-abbce2c5d940",
                                "text": "„Bruder und Schwester zeigen die Zeichen einer kompletten myotonischen Dystrophie, zwei weitere Geschwister Teilsymptome der Erkrankung, ein Sohn der Dystrophikerin eine gröbere intellektuelle Störung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
