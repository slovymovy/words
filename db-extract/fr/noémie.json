                "senses": [
                    {
                        "sense_id": "d13e701c-8651-36f5-9c2b-a2108c562a05",
                        "entry_id": "7a86dd06-a7f7-34d1-a680-8eb399891499",
                        "glosses": [
                            "Début du mois lunaire, nouvelle lune."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "ad778dad-f3f9-417a-8908-c989af4f363d",
                                "sense_id": "d13e701c-8651-36f5-9c2b-a2108c562a05",
                                "text": "Les années de l’hégyre durent douze mois lunaires et commencent avec le coucher du Soleil ; l’année 1285 a commencé à la noémie (nouvelle lune) le 24 avril 1868 et finira le 12 avril 1869, époque de la fin de la douzième lunaison."
                            },
                            {
                                "example_id": "705191de-56a7-41b0-b81b-f7c807547644",
                                "sense_id": "d13e701c-8651-36f5-9c2b-a2108c562a05",
                                "text": "Le terme employé pour désigner le concept de mois est hodesh, que l’on peut traduire par nouvelle lune, noémie."
                            }
                        ]
                    }
                ],
