                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "golem",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a12b3eb4-210c-3a5e-b4b8-e7c869a12755",
                                        "entry_id": "b0ffa2db-6158-335f-af12-102588de6a97",
                                        "glosses": [
                                            "A humanoid creature made from clay, animated by magic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "81df8c63-2a1d-3c80-9a4a-8c865bde583c",
                                        "entry_id": "b0ffa2db-6158-335f-af12-102588de6a97",
                                        "glosses": [
                                            "A humanoid creature made from any previously inanimate matter, such as wood or stone, animated by magic."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40632181-4f7a-4a0f-86ba-a1ddcd5fc52a",
                                                "sense_id": "81df8c63-2a1d-3c80-9a4a-8c865bde583c",
                                                "text": "She is elected mayor through the help of a golem she creates out of the soil of the potted plants she keeps in her apartment."
                                            },
                                            {
                                                "example_id": "4bd308da-ca27-42ef-aad9-adcba3facbd2",
                                                "sense_id": "81df8c63-2a1d-3c80-9a4a-8c865bde583c",
                                                "text": "“There was also stuff that we actually had to take out which would have ruined the plot of the movie,” he said of his favorite details. “Getting the angry old man in there was very important, and the woodland mansion. But also things like the iron golems turned out so well.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "307e104f-4945-46e6-989a-dfecf8ade85c",
                        "source_entry_id": "750c602c-9a8d-37e2-a810-121516d714b3",
                        "source_sense_id": "aee46d61-7fff-3592-8b7f-29b9e5078677",
                        "target_lang_word": "голем",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "голем",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "07476cc3-4ef1-3b66-a10d-25836f9320a4",
                                        "entry_id": "8fc3555e-10f0-3994-bd4d-610d46a63f50",
                                        "glosses": [
                                            "мифол. персонаж еврейской мифологии; человекоподобное существо, созданное из глины и оживлённое с помощью магии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dd36da9-eb7f-4ae0-bbbe-778467fb84e8",
                                                "sense_id": "07476cc3-4ef1-3b66-a10d-25836f9320a4",
                                                "text": "Этой же ночью Леви ибн Бецалел призвал к себе голема и велел глиняному истукану отправиться на кладбище и поймать там душу недавно умершего ребёнка."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
