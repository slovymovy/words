                ],
                "senses": [
                    {
                        "sense_id": "03594335-ee3c-327d-967e-886444cff521",
                        "entry_id": "84cacae0-0d82-3d9f-aed1-3f077096104d",
                        "glosses": [
                            "kleiner Brief"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "982660fb-910b-4939-8432-b9d76fb9abac",
                                "sense_id": "03594335-ee3c-327d-967e-886444cff521",
                                "text": "„Ich ließ Ihnen ein Briefchen zukommen, in dem ich eine Pause vorschlug, das heißt ein Unterbrechen der Sitzung.“"
                            },
                            {
                                "example_id": "a63c3c7c-b3a1-4010-b75b-96c12b6840d4",
                                "sense_id": "03594335-ee3c-327d-967e-886444cff521",
                                "text": "„Es war am Nachmittag um fünf Uhr, als ich das Briefchen erhielt, und da die Sonne zu dieser Jahreszeit um neun Uhr unterging, blieben mir vier Stunden, mit denen ich nichts anzufangen wußte.“"
                            },
                            {
                                "example_id": "f455ae05-5f75-4138-8d6b-efa30ac86baa",
                                "sense_id": "03594335-ee3c-327d-967e-886444cff521",
                                "text": "„Am nächsten Morgen kam sie in aller Frühe an mein Bett, um mir einen Kragen zu bringen, und steckte mir heimlich das nachstehende Briefchen zu.“"
                            },
                            {
                                "example_id": "7e4629e2-3e9b-4087-9076-8857ce97cfac",
                                "sense_id": "03594335-ee3c-327d-967e-886444cff521",
                                "text": "„Er stand immer noch da, als ein kleiner Junge auf ihn zutrat und ihm ein locker zusammengefaltetes, aber mit vielen Siegeln fest verklebtes Briefchen gab, das er las und zu sich steckte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "84b86355-6dde-3ccd-876e-cee383982640",
                        "entry_id": "84cacae0-0d82-3d9f-aed1-3f077096104d",
                        "glosses": [
                            "kleiner, schmaler Behälter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "732acc4c-71d0-4d89-b430-681b034d4cca",
                                "sense_id": "84b86355-6dde-3ccd-876e-cee383982640",
                                "text": "„Alvira – seinen echten Namen wollte er keinesfalls für diesen Beitrag preisgeben – hat sich wie jedes Wochenende am Drogenumschlagplatz im Herzen der Favela, in der boca de fumo, ein paar Briefchen Kokain besorgt, das Stück für gut 10 Real (etwa 3,15 Euro).“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
