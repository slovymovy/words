                                        "sense_id": "bc9d0750-aa22-34e7-9e14-acebd84644b6",
                                        "entry_id": "18a4bbd2-b85c-308d-ac6c-4535f7160a89",
                                        "glosses": [
                                            "A coin and unit of currency, originally a Spanish or Spanish-American one worth eight real, later also used (with various values) in the Ottoman Empire and in Cyprus, in the French-speaking parts of Canada, and in French Indochina."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0f8b4cf-a097-4607-bf37-058ab124a47a",
                                                "sense_id": "bc9d0750-aa22-34e7-9e14-acebd84644b6",
                                                "text": "The Silkes, Velvets, Cloth of gold, and Tissue, Pyasters, Chicqueenes and Sultanies, which is gold and silver, they unloaded in foure and twentie houres, was wonderfull [...]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5769b10c-992b-3229-9a06-ba6f4a1403f2",
                                        "entry_id": "18a4bbd2-b85c-308d-ac6c-4535f7160a89",
                                        "glosses": [
                                            "A form of currency currently used as a subunit in the Middle Eastern and East African countries of Egypt, Jordan (partly including Palestine), Lebanon, South Sudan, Sudan, and Syria."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
