                ],
                "senses": [
                    {
                        "sense_id": "5ed22880-58e3-321c-8acb-5e0c0e072f81",
                        "entry_id": "62940dc5-fd3a-3531-a526-dae5bbcd90f9",
                        "glosses": [
                            "Donner à une manifestation un caractère rappelant le mouvement de contestation français des gilets jaunes."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "6683ffd5-ff04-4875-ba82-5396668f5c70",
                                "sense_id": "5ed22880-58e3-321c-8acb-5e0c0e072f81",
                                "text": "Les GJ ont en tête de giletjauniser (J’utilise leur propre terme) d’autres manifestations, dont des prides."
                            },
                            {
                                "example_id": "d1f99e5f-b6ee-478c-a75c-663c5b3ba210",
                                "sense_id": "5ed22880-58e3-321c-8acb-5e0c0e072f81",
                                "text": "La révolution s’allonge dans le temps, risque de se « giletjauniser », se radicalise dans sa demande et ne faiblit pas pour demander un départ total du régime et de son tutorat."
                            },
                            {
                                "example_id": "ad8b3e28-1ba2-4d0e-b04c-71bd8091dab6",
                                "sense_id": "5ed22880-58e3-321c-8acb-5e0c0e072f81",
                                "text": "C’est sûr, il faudrait qu’on arrive à se giletjauniser.'"
                            }
                        ]
                    }
                ],
