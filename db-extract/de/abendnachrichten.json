                        "sense_id": "83ba2754-4725-3b0b-acc4-9a2da9569b57",
                        "entry_id": "0ed78374-14e9-3473-a8cb-7766d5678103",
                        "glosses": [
                            "Sendung, die abends ausgestrahlt wird und in der aktuelle Ereignisse sowie Neuigkeiten vermittelt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48ed73f1-cb99-4d6e-b33c-8ec58ee1fceb",
                                "sense_id": "83ba2754-4725-3b0b-acc4-9a2da9569b57",
                                "text": "„Zurück bleiben Mütter und Väter, die während der Abendnachrichten auf dem Sofa einschlafen.“"
                            },
                            {
                                "example_id": "e46a889c-8428-425a-8803-fa962d431a98",
                                "sense_id": "83ba2754-4725-3b0b-acc4-9a2da9569b57",
                                "text": "„In der Zwischenzeit hatten die Medien erneut angerufen, und der Todesfall war in den Abendnachrichten gemeldet worden, jedoch ohne nähere Details.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
