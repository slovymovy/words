                        "sense_id": "7827c0e7-a3c3-39e7-9f7f-aaa2a8f4ca69",
                        "entry_id": "e6a168f8-e2b9-3052-9b65-b442846ec932",
                        "glosses": [
                            "Outrepassement sous une valeur minimale, sous la borne inférieure admissible."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "472b0089-cf4b-4c76-95c6-e0f73d8c4445",
                                "sense_id": "7827c0e7-a3c3-39e7-9f7f-aaa2a8f4ca69",
                                "text": "Si le résultat attendu est positif, cₖ signifie un soupassement (underflow) ou dépassement de capacité par valeurs inférieures."
                            },
                            {
                                "example_id": "26fcd87e-4745-4288-9436-a66d823314e3",
                                "sense_id": "7827c0e7-a3c3-39e7-9f7f-aaa2a8f4ca69",
                                "text": "Cette exception est provoquée lorsque le résultat réel est trop petit en valeur absolue pour être représenté dans le format choisi. Le résultat d’une telle exception est le plus petit nombre dénormalisé ou 0 en fonction du mode d’arrondi. Exemple : 10⁻⁴⁵ ⊘ 3 dans un format simple précision, provoque un soupassement de capacité et retourne +0."
                            }
                        ]
                    }
