                                        "entry_id": "8069caaa-38b0-3df0-b3bb-da86b5def1c8",
                                        "glosses": [
                                            "Peuple d'Afrique australe occidentale."
                                        ],
                                        "tags": [
                                            "collectively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f69e4785-71d1-497c-9195-1bccb113beff",
                                                "sense_id": "322c2d6b-fd1f-30ce-9b2c-2e78e754b3dc",
                                                "text": "Seuls les Khoisans sont différents, comme notre pauvre Esther. Eux, ce sont les tout premiers habitants de cette terre d’Afrique méridionale."
                                            }
