                                    {
                                        "sense_id": "a1d59619-9921-34d0-9167-68ecf8fc1e7b",
                                        "entry_id": "b6eb02b2-3435-3b74-a04f-721e2a728438",
                                        "glosses": [
                                            "A small flat case containing magnetic tape on two reels, used to record and play back audio and video material."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7eba574a-14c2-4e20-baaa-6552d9696ea0",
                                                "sense_id": "a1d59619-9921-34d0-9167-68ecf8fc1e7b",
                                                "text": "If you need to reload film, the cassette can be rewound slightly by turning the hub located on one end of its spool."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b32dfd4-a3c3-3f3f-ba08-4baa074b48dc",
                                        "entry_id": "b6eb02b2-3435-3b74-a04f-721e2a728438",
                                        "glosses": [
                                            "Any similar small cartridge, such as for a computer disk or cassette air conditioner"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "896cb09c-a2f9-37c7-8f13-041d0e1f8f04",
                                        "entry_id": "b6eb02b2-3435-3b74-a04f-721e2a728438",
                                        "glosses": [
                                            "A lightproof container for photographic film."
                                        ],
