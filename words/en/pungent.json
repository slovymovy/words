{
    "word_family": [
        "pungency",
        "pungently"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3012ef00-9601-3f66-8a6b-c4ac63ce0a8d",
                    "sense_definition": "Having a strong, sharp, or stinging smell.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sensory_perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>pungent</w> smell of onions filled the entire kitchen while I was cooking.",
                            "target_lang_translations": {
                                "ru": "<w>Едкий</w> запах лука заполнил всю кухню, пока я готовил."
                            }
                        },
                        {
                            "text": "Cleaning products often have a <w>pungent</w> odor that can irritate your nose.",
                            "target_lang_translations": {
                                "ru": "Чистящие средства часто имеют <w>резкий</w> запах, который может раздражать слизистую носа."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pungent odor",
                        "pungent smell"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий сильный, резкий или раздражающий запах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "едкий",
                                "target_lang_sense_clarification": "о запахе, раздражающем глаза или нос"
                            },
                            {
                                "target_lang_word": "резкий",
                                "target_lang_sense_clarification": "о сильном, бьющем в нос запахе"
                            },
                            {
                                "target_lang_word": "острый",
                                "target_lang_sense_clarification": "о пронзительном запахе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f77b07e-e149-34ea-92b4-5d17ac40d409",
                    "sense_definition": "Having a sharp, biting, or spicy taste.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sensory_perception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sauce had a <w>pungent</w> flavor that lingered on my tongue for a long time.",
                            "target_lang_translations": {
                                "ru": "У соуса был <w>острый</w> вкус, который долго оставался на языке."
                            }
                        },
                        {
                            "text": "Some people love the <w>pungent</w> taste of raw garlic in their salad dressing.",
                            "target_lang_translations": {
                                "ru": "Некоторые люди любят <w>пряный</w> вкус сырого чеснока в заправке для салата."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pungent taste",
                        "pungent flavor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий резкий, жгучий или пряный вкус."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "острый",
                                "target_lang_sense_clarification": "о пряном или жгучем вкусе"
                            },
                            {
                                "target_lang_word": "едкий",
                                "target_lang_sense_clarification": "о щиплющем, терпком вкусе"
                            },
                            {
                                "target_lang_word": "пряный",
                                "target_lang_sense_clarification": "насыщенный специями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e1a98e2-005c-37c7-a48c-2a16f3464abf",
                    "sense_definition": "Sharp, biting, or critical in tone or expression.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The journalist wrote a <w>pungent</w> critique of the government's new economic policy.",
                            "target_lang_translations": {
                                "ru": "Журналист написал <w>язвительную</w> критику новой экономической политики правительства."
                            }
                        },
                        {
                            "text": "Her <w>pungent</w> remarks during the meeting left everyone feeling quite uncomfortable.",
                            "target_lang_translations": {
                                "ru": "Её <w>едкие</w> замечания во время встречи заставили всех почувствовать себя неловко."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pungent criticism",
                        "pungent remark"
                    ],
                    "target_lang_definitions": {
                        "ru": "Резкий, язвительный или критический по тону или выражению."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "язвительный",
                                "target_lang_sense_clarification": "о колких высказываниях или критике"
                            },
                            {
                                "target_lang_word": "едкий",
                                "target_lang_sense_clarification": "о саркастичных замечаниях"
                            },
                            {
                                "target_lang_word": "острый",
                                "target_lang_sense_clarification": "о метком и колком слове"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36e9331b-4bc7-3506-a722-31900ff599ca",
                    "sense_definition": "Having a sharp, stiff, or pointed end.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The plant has <w>pungent</w> leaves that can easily scratch your skin if you touch them.",
                            "target_lang_translations": {
                                "ru": "У растения <w>колючие</w> листья, которые легко могут поцарапать кожу при прикосновении."
                            }
                        },
                        {
                            "text": "The insect uses its <w>pungent</w> stinger to defend itself against predators.",
                            "target_lang_translations": {
                                "ru": "Насекомое использует свое <w>острое</w> жало для защиты от хищников."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий острый, жесткий или колющий кончик."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "острый",
                                "target_lang_sense_clarification": "способный уколоть или поцарапать"
                            },
                            {
                                "target_lang_word": "колючий",
                                "target_lang_sense_clarification": "о растениях или шипах"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}