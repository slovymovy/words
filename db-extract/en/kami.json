                        "examples": [
                            {
                                "example_id": "81190dd7-940d-4d97-99fd-cd5e2f83df16",
                                "sense_id": "d225bb04-afff-316f-bfaf-04ef4ef9974e",
                                "text": "Chanting the mantra of the fire kami, they called to the blaze, summoning the heart of each flickering flame to life."
                            },
                            {
                                "example_id": "f96be7df-f58b-4040-8270-0c9d456c64df",
                                "sense_id": "d225bb04-afff-316f-bfaf-04ef4ef9974e",
                                "text": "But Ryōtora had definitely moved a shintai during the makeshift festival – and it must have been Saiun-nushi’s, because Sekken couldn’t imagine the shugenja could call a kami into a foreign vessel without noticing."
                            }
                        ]
                    },
