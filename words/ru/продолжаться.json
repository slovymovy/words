{
    "word_family": [
        "продолжение",
        "продолжительный",
        "продолжить"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a2669d5d-3811-306f-986d-ebcda51c3acb",
                    "sense_definition": "Длиться, происходить в течение какого-либо времени, не прекращаясь.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Интересный фильм <w>продолжается</w> два часа.",
                            "target_lang_translations": {
                                "en": "The interesting movie <w>lasts</w> for two hours."
                            }
                        },
                        {
                            "text": "Наш разговор <w>продолжался</w> до самой ночи.",
                            "target_lang_translations": {
                                "en": "Our conversation <w>continued</w> until late at night."
                            }
                        }
                    ],
                    "synonyms": [
                        "длиться"
                    ],
                    "antonyms": [
                        "останавливаться"
                    ],
                    "common_phrases": [
                        "дождь продолжается",
                        "урок продолжается"
                    ],
                    "target_lang_definitions": {
                        "en": "To last or continue to happen over a period of time without stopping."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to continue",
                                "target_lang_sense_clarification": "general term for an action or state persisting"
                            },
                            {
                                "target_lang_word": "to last",
                                "target_lang_sense_clarification": "specifically regarding duration or time"
                            },
                            {
                                "target_lang_word": "to go on",
                                "target_lang_sense_clarification": "informal way to describe an ongoing event"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12957141-9353-36e0-a253-5757732c2ddf",
                    "sense_definition": "Простираться на какое-либо расстояние, не кончаясь.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "extension",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Эта дорога <w>продолжается</w> далеко за лесом.",
                            "target_lang_translations": {
                                "en": "This road <w>continues</w> far beyond the forest."
                            }
                        },
                        {
                            "text": "Лес <w>продолжался</w> на многие километры вокруг.",
                            "target_lang_translations": {
                                "en": "The forest <w>stretched</w> for many kilometers around."
                            }
                        }
                    ],
                    "common_phrases": [
                        "дорога продолжается"
                    ],
                    "target_lang_definitions": {
                        "en": "To extend or stretch over a certain distance without ending."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to extend",
                                "target_lang_sense_clarification": "to cover a physical area or distance"
                            },
                            {
                                "target_lang_word": "to continue",
                                "target_lang_sense_clarification": "to stretch further in a specific direction"
                            },
                            {
                                "target_lang_word": "to stretch",
                                "target_lang_sense_clarification": "to reach across a space or distance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e2eb2dfe-cc64-327b-a932-d66e72204e33",
                    "sense_definition": "Быть объектом действия, выраженного глаголом <w>продолжать</w> (страдательный залог).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "passive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Строительство моста <w>продолжается</w> рабочими даже в выходные.",
                            "target_lang_translations": {
                                "en": "The construction of the bridge <w>is being continued</w> by workers even on weekends."
                            }
                        },
                        {
                            "text": "Исследование <w>продолжалось</w> учеными в течение года.",
                            "target_lang_translations": {
                                "en": "The research <w>was continued</w> by the scientists for a year."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To be the object of an action, indicating that an activity is being carried on by someone."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to be continued",
                                "target_lang_sense_clarification": "passive construction for ongoing work or projects"
                            },
                            {
                                "target_lang_word": "to be carried on",
                                "target_lang_sense_clarification": "formal way to describe an activity being maintained"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}