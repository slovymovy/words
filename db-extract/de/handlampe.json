                            {
                                "example_id": "c909af8d-380f-44a5-92c5-308856b08eee",
                                "sense_id": "59c4074b-a4ca-39e9-889e-21a956c15f2f",
                                "text": "„Sie half uns in die Überröcke und nahm dann eine kleine Handlampe, um uns über die Treppe zu leuchten.“"
                            }
