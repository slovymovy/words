                    "synonyms": [
                        "stelen",
                        "plunderen",
                        "ontvreemden",
                        "beroven"
                    ],
                    "antonyms": [
                        "geven",
                        "schenken"
                    ],
                    "common_phrases": [
                        "schatten te roven",
                        "met geweld roven"
                    ],
                    "target_lang_definitions": {
