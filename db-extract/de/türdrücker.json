                ],
                "senses": [
                    {
                        "sense_id": "5faec10b-e0bc-3ad4-9040-91a7f969799d",
                        "entry_id": "fc643c41-347f-3041-9a25-85502869f96a",
                        "glosses": [
                            "an implement at a door to open it",
                            "by pressing it down or perhaps into the door, door handle"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7ff94668-9747-3378-979b-8fdbc52f5ea7",
                        "entry_id": "fc643c41-347f-3041-9a25-85502869f96a",
                        "glosses": [
                            "an implement at a door to open it",
                            "by pressing a button and talking, a common type of Türöffner, synonym of Türsprechanlage"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "12c07b6f-008e-4730-ac4e-aaceaa2e738e",
                                "sense_id": "7ff94668-9747-3378-979b-8fdbc52f5ea7",
                                "text": "Das Etablissement, in das ihn ein kundiger Taxifahrer brachte, befand sich in einem großen alten Bürgerhaus aus der Jahrhundertwende. Es lag etwas abgerückt von der Straße hinter einem düsteren Vorgarten. An der Haustür, über der eine Lampe brannte, befand sich ein Metallschild, auf dem in schnörkelhafter Schrift »Chez Helene. Privatclub« stand. Man mußte zweimal klingeln. Wahrscheinlich wurde man aus einem Fenster beobachtet. Im Türlautsprecher sagte eine gequetschte Frauenstimme: »Guten Abend. Kommen Sie bitten in den ersten Stock.« Dann summte der Türdrücker."
                            }
                        ]
                    },
                    {
                        "sense_id": "0f132bca-42c0-36e4-ad1f-2e2b212b59d7",
                        "entry_id": "fc643c41-347f-3041-9a25-85502869f96a",
                        "glosses": [
                            "someone who slings stuff at people’s doors, a tranter"
                        ],
                        "tags": [
                            "masculine",
                            "rare",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "ab51a5b9-860e-4688-862f-644df8b550c8",
                                "sense_id": "0f132bca-42c0-36e4-ad1f-2e2b212b59d7",
                                "text": "Wenn das zutrifft, hat der Verlagsvertrieb bereits in der Frühdruckzeit den »Türdrücker« gekannt.",
                                "translation": "If this comes out true, the publishing business even in incunabular time knew the colporteur.",
                                "english": "If this comes out true, the publishing business even in incunabular time knew the colporteur."
                            }
                        ]
                    }
                ],
