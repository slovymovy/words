                    "sense_definition": "Iemand dank betuigen of erkentelijkheid tonen voor iets.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik wil jullie <w>bedanken</w> voor jullie gastvrijheid.",
                            "target_lang_translations": {
                                "ru": "Я хочу <w>поблагодарить</w> вас за ваше гостеприимство.",
                                "en": "I want to <w>thank</w> you for your hospitality.",
                                "it": "Voglio <w>ringraziarvi</w> per la vostra ospitalità.",
                                "pl": "Chcę wam <w>podziękować</w> za waszą gościnność.",
                                "de": "Ich möchte euch für eure Gastfreundschaft <w>danken</w>.",
                                "fr": "Je tiens à vous <w>remercier</w> pour votre hospitalité.",
                                "cs": "Chci vám <w>poděkovat</w> za vaši pohostinnost.",
                                "tr": "Misafirperverliğiniz için size <w>teşekkür etmek</w> istiyorum.",
                                "es": "Quiero <w>agradecerles</w> por su hospitalidad.",
                                "zh": "我想为你们的热情款待向你们<w>致谢</w>。"
                            }
                        },
                        {
                            "text": "Zij <w>bedankte</w> haar collega's hartelijk voor de fijne samenwerking.",
                            "target_lang_translations": {
                                "ru": "Она сердечно <w>поблагодарила</w> своих коллег за приятное сотрудничество.",
                                "en": "She heartily <w>thanked</w> her colleagues for the pleasant cooperation.",
                                "it": "Ha <w>ringraziato</w> calorosamente i suoi colleghi per la piacevole collaborazione.",
                                "pl": "Serdecznie <w>podziękowała</w> swoim współpracownikom za miłą współpracę.",
                                "de": "Sie <w>dankte</w> ihren Kollegen herzlich für die angenehme Zusammenarbeit.",
                                "fr": "Elle a chaleureusement <w>remercié</w> ses collègues pour l'agréable collaboration.",
                                "cs": "Srdečně svým kolegům <w>poděkovala</w> za skvělou spolupráci.",
                                "tr": "Güzel iş birliği için meslektaşlarına içtenlikle <w>teşekkür etti</w>.",
                                "es": "Ella <w>agradeció</w> cordialmente a sus colegas por la agradable colaboración.",
                                "zh": "她衷心地<w>感谢</w>同事们愉快的合作。"
                            }
                        }
