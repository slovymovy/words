                ],
                "senses": [
                    {
                        "sense_id": "f82cb4fb-b9ad-394f-b8c3-e218920905ed",
                        "entry_id": "8d6d5009-d3e8-36c8-a5db-1e8c1e2cdbe3",
                        "glosses": [
                            "Voile laissant découvert le haut du visage, que portaient les femmes turques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36cc7cfa-5042-4921-bb63-47f5c6bd4550",
                                "sense_id": "f82cb4fb-b9ad-394f-b8c3-e218920905ed",
                                "text": "Tous ces corps de femmes, enveloppés chacun jusqu’aux pieds de pièces de soie de couleurs éclatantes, toutes ces têtes blanches cachées sous les plis des yachmaks d’où sortaient des yeux noirs, se confondaient sous les cyprès avec les pierres peintes et historiées des tombes."
                            },
                            {
                                "example_id": "a2ccf5ef-6137-4ee9-85fb-eafdc5150e21",
                                "sense_id": "f82cb4fb-b9ad-394f-b8c3-e218920905ed",
                                "text": "Elles étaient assises sur leurs montures, enveloppées de leurs yachmaks : on ne pouvait rien voir d'autre que leurs yeux et les talons de leurs chaussures."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38f7b2ed-75bc-4d04-8c99-6fbb9be75afb",
                        "source_entry_id": "8d6d5009-d3e8-36c8-a5db-1e8c1e2cdbe3",
                        "source_sense_id": "f82cb4fb-b9ad-394f-b8c3-e218920905ed",
                        "target_lang_word": "yashmak",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yashmak",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c527f3d7-12d6-3408-826f-16b4a047bdd5",
                                        "entry_id": "66578bc8-a8fa-3818-8341-56482b185136",
                                        "glosses": [
                                            "A veil worn by Muslim women to cover parts of the face when they are in public."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbe7260d-0b42-41b8-8b4d-774fad345dc8",
                                                "sense_id": "c527f3d7-12d6-3408-826f-16b4a047bdd5",
                                                "text": "Through her gauzy yashmak I could see that she was smiling."
                                            },
                                            {
                                                "example_id": "67ef6638-cf51-49ba-912e-b0e7578821fa",
                                                "sense_id": "c527f3d7-12d6-3408-826f-16b4a047bdd5",
                                                "text": "Mungo cannot make out her face, which is concealed behind a yashmak – the double horsehair veil worn by Muslim women in public – but he is immediately struck by her feet and hands."
                                            }
                                        ]
                                    }
                                ]
                            }
