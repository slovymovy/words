                        "glosses": [
                            "Pisser, faire pipi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6da2e43a-47cc-471f-93ed-3ece0bbb60af",
                                "sense_id": "12aa861d-58a2-3588-a57e-d55ebd96407a",
                                "text": "Zooam (excédé) : Accorde-leur le loisir de \"pipiter\"."
                            },
                            {
                                "example_id": "dc76ee60-e983-486c-beb9-91c04ab3034b",
                                "sense_id": "12aa861d-58a2-3588-a57e-d55ebd96407a",
                                "text": "Jeeeee te crott-euh, je pipite sur toi, je pipite, je pipite ! chantait Armelle sur l’air d’Alouette, gentille alouette."
                            },
                            {
                                "example_id": "adfcd24a-3da3-447b-b282-91b780a94a1c",
                                "sense_id": "12aa861d-58a2-3588-a57e-d55ebd96407a",
                                "text": "Bon je pipite quand même et sonne l’infirmière de nuit."
                            },
                            {
                                "example_id": "eed17b37-10a0-40ad-8d2f-142aff0af9c5",
                                "sense_id": "12aa861d-58a2-3588-a57e-d55ebd96407a",
                                "text": "Ca ne vous dérange pas si je pipite, hein ?"
                            }
                        ]
                    }
