                "senses": [
                    {
                        "sense_id": "c1da9297-587f-3f40-93fb-65986dba6aeb",
                        "entry_id": "46203406-38d1-365d-b49e-6fe1b2404ad3",
                        "glosses": [
                            "der achte Monat im Jahr; August"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "679568ef-07b7-4db4-a129-52fc3d5d08f8",
                                "sense_id": "c1da9297-587f-3f40-93fb-65986dba6aeb",
                                "text": "Im Ernting ist die Ernte in vollem Gang."
                            },
                            {
                                "example_id": "902eced4-345e-46d0-a0a6-5c6651989261",
                                "sense_id": "c1da9297-587f-3f40-93fb-65986dba6aeb",
                                "text": "„Am Vollmond im Ernting wird Lughnasad (Lammas), ein frühes Erntedankfest, gefeiert oder aber bereits am 27ten Heuert (früher: 1.August). Der Sommer hat seinen Höhepunkt bereits überschritten.“"
                            },
                            {
                                "example_id": "50596708-36b2-4db4-96ac-0f8e963b2e44",
                                "sense_id": "c1da9297-587f-3f40-93fb-65986dba6aeb",
                                "text": "„Natürlich ist dieser Monat nach dem römischen Kaiser Augustus benannt. Alte deutsche Namen verweisen auf den Beginn der Kornernte (Ernting, Erntemonat, Ährenmonat, Wärmemonat).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
