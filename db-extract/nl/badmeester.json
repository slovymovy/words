                "senses": [
                    {
                        "sense_id": "e99f41e2-fa3b-3e80-9973-03454780709b",
                        "entry_id": "282496ff-c6c6-390b-84a3-fc84162b5728",
                        "glosses": [
                            "iemand die toezicht houdt bij zwembaden en vaak ook zwemles geeft"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "a17b649a-8438-40d3-a275-f77217592ebf",
                                "sense_id": "e99f41e2-fa3b-3e80-9973-03454780709b",
                                "text": "Iedereen die niet in het diepe durft te springen wordt door de badmeester ferm in het water gesmeten."
                            },
                            {
                                "example_id": "e8d0bd78-c5e8-4a50-b7ea-3c32cac974b6",
                                "sense_id": "e99f41e2-fa3b-3e80-9973-03454780709b",
                                "text": "Wat ik me het best herinner van dat eerste schooljaar in Norrkôping was het zwembad, hoe ik voor het eerst van de driemeterplank durfde te springen, hoe een van de badmeesters me onder zijn hoede nam terwijl mijn klasgenootjes nog bezig waren met hun kurkgordels en me veel beter leerde borstcrawlen, met rechtere armen en mijn hoofd stil."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "404e8ef9-9b04-44ac-9562-34fee188bdda",
                        "source_entry_id": "282496ff-c6c6-390b-84a3-fc84162b5728",
                        "source_sense_id": "e99f41e2-fa3b-3e80-9973-03454780709b",
                        "target_lang_word": "Bademeister",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bademeister",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dfd262cf-1837-3be8-9397-b6c215b58297",
                                        "entry_id": "9d2e0967-a3d6-35eb-94ad-516fdbe10193",
                                        "glosses": [
                                            "Person, die im Schwimmbad den Badebetrieb überwacht und Badeunfälle zu verhindern sucht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39cccb43-af19-4afc-98b7-e729acd8c340",
                                                "sense_id": "dfd262cf-1837-3be8-9397-b6c215b58297",
                                                "text": "Bademeister müssen ein Rettungsschwimmabzeichen besitzen."
                                            },
                                            {
                                                "example_id": "e55b37f5-5686-4ef5-8332-71af9b0157ca",
                                                "sense_id": "dfd262cf-1837-3be8-9397-b6c215b58297",
                                                "text": "„Die Bademeister, die freundlichen Engel unseres Paradieses, kenne ich seit der Eröffnung.“"
                                            },
                                            {
                                                "example_id": "6897444e-76c1-4f48-9f61-6e2601b334e1",
                                                "sense_id": "dfd262cf-1837-3be8-9397-b6c215b58297",
                                                "text": "„Mit seiner Arbeit als Bademeister war er zufrieden gewesen, doch nach der Hochzeit wies die blinde Bettlerin ihm einen Platz in der Stadt an, und auch er musste betteln.“"
                                            },
                                            {
                                                "example_id": "3a9743fe-afcf-431d-a38b-0430a829142f",
                                                "sense_id": "dfd262cf-1837-3be8-9397-b6c215b58297",
                                                "text": "„Sein Vater war Bademeister, später Platzwart auf dem Sportgelände in der Nähe unseres Hauses.“"
                                            },
                                            {
                                                "example_id": "4b59301d-cfd2-4986-a490-0f26294e9620",
                                                "sense_id": "dfd262cf-1837-3be8-9397-b6c215b58297",
                                                "text": "[Beim Wuppertaler SV konnte Horst Szymaniak] in der Oberliga spielen und hatte als Bademeister einen angenehmeren Job als die harte Arbeit unter Tage."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "90d634f9-4cb7-30f2-b4b3-5ad588923bf7",
                                        "entry_id": "9d2e0967-a3d6-35eb-94ad-516fdbe10193",
                                        "glosses": [
                                            "Person, die Heilbäder verabreicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5f004c7-f1a3-46c5-9773-524f35995b03",
                                                "sense_id": "90d634f9-4cb7-30f2-b4b3-5ad588923bf7",
                                                "text": "Mein Bruder arbeitet als medizinischer Bademeister."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd3afdb3-e955-40b5-abb8-5beefb861e24",
                        "source_entry_id": "282496ff-c6c6-390b-84a3-fc84162b5728",
                        "source_sense_id": "e99f41e2-fa3b-3e80-9973-03454780709b",
                        "target_lang_word": "lifeguard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lifeguard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c76c8ee-243e-3edc-8381-ce230d3e8c18",
                                        "entry_id": "3a10748f-3e67-335b-8c70-cd002d2e9b12",
                                        "glosses": [
                                            "A lifesaver: a rescuer, usually an expert swimmer, employed to save swimmers in trouble or near drowning at a body of water."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "591eaf41-5bd9-3175-b882-6c2deeb24c99",
                                        "entry_id": "3a10748f-3e67-335b-8c70-cd002d2e9b12",
                                        "glosses": [
                                            "A bodyguard or unit of bodyguards, a guard of someone's (especially a king's) life or person."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0595e318-06a4-43da-8c7e-1ba4f9099bc6",
                                                "sense_id": "591eaf41-5bd9-3175-b882-6c2deeb24c99",
                                                "text": "\"The people's love is the king's lifeguard.\""
                                            },
                                            {
                                                "example_id": "efe2831a-c8a5-4896-bbf4-005a86ccafaa",
                                                "sense_id": "591eaf41-5bd9-3175-b882-6c2deeb24c99",
                                                "text": "[I]n the reserve were the king's lifeguard, commanded by the earl of Lindsey, and prince Rupert's regiment of foot[.]"
                                            },
                                            {
                                                "example_id": "34672baa-0850-41fe-a068-5e36c6550e47",
                                                "sense_id": "591eaf41-5bd9-3175-b882-6c2deeb24c99",
                                                "text": "Constantine the Great is known to have raised the five scholae of horsemen who formed the actual lifeguard of the prince, and followed his person whenever he went out to war."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1c2ef37-8306-3c4a-9599-ded01ed3e974",
                                        "entry_id": "3a10748f-3e67-335b-8c70-cd002d2e9b12",
                                        "glosses": [
                                            "A sturdy metal bracket fixed in front of each of the leading wheels of a train to deflect small objects away from the wheels to prevent derailment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b787a09c-6730-4f6f-a6c9-2e8cc6d2cee3",
                                                "sense_id": "d1c2ef37-8306-3c4a-9599-ded01ed3e974",
                                                "text": "It also looked at what effect stronger lifeguards might have had. They protect the leading wheels from small obstacles and in modern trains have coped with hitting landslip debris."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24405428-a783-4f65-b18c-ad463e4e8e18",
                        "source_entry_id": "282496ff-c6c6-390b-84a3-fc84162b5728",
