                                                "example_id": "3ac4e9ca-6ed8-45da-a6c1-09f007b0edc9",
                                                "sense_id": "51291500-9c2d-3323-92e9-578c970bb0ea",
                                                "text": "Beim Laufen auf sehr steinigem Untergrund rate ich von diesen Schuhen ab."
                                            }
                                        ],
