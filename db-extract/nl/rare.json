            {
                "entry_id": "075957ed-209e-30e3-9778-ca4fb4f97ca5",
                "word": "rare",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "42f1cf6e-9bad-3a1f-ac4a-5064d4677d1b",
                        "entry_id": "075957ed-209e-30e3-9778-ca4fb4f97ca5",
                        "glosses": [
                            "licht iemand die vreemd gedrag vertoont"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "06482555-dff9-43ad-82da-bf8d9bc96e25",
                                "sense_id": "42f1cf6e-9bad-3a1f-ac4a-5064d4677d1b",
                                "text": "De tijd dat mensen die er anders uitzagen of anders tegen de wereld aankeken door de goegemeente beschouwd werden als outcasts of ‘die rare’, is voorgoed voorbij."
                            },
                            {
                                "example_id": "481b4d6b-d422-45c4-bb3e-8f957535a926",
                                "sense_id": "42f1cf6e-9bad-3a1f-ac4a-5064d4677d1b",
                                "text": "'Jullie zijn een stelletje raren geworden hier op IJsland ... iedereen heeft het maar over “onrechtvaardigheid” en “maatschappij”. Het zou geen kwaad kunnen als je uitlegt wat je bedoeld."
                            }
                        ]
                    }
                ],
