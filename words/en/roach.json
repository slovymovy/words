                {
                    "sense_id": "9385749c-c9cf-355b-a32f-67792e3935da",
                    "sense_definition": "A common freshwater fish of Europe and western Asia (Rutilus rutilus) belonging to the carp family.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the calm morning by the riverbank catching small <w>roach</w> with sweetcorn.",
                            "target_lang_translations": {
                                "ru": "Тихим утром он сидел на берегу реки и ловил на кукурузу небольшую <w>плотву</w>."
