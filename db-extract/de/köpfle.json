                ],
                "senses": [
                    {
                        "sense_id": "77b51389-9ca8-3eca-ac43-87fc60cf3ae1",
                        "entry_id": "9b300062-0604-34a0-b3ed-e2e4d8baeb01",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e802c684-4292-4d0a-bb66-6e484adeb541",
                                "sense_id": "77b51389-9ca8-3eca-ac43-87fc60cf3ae1",
                                "text": "Frau Köpfle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6b92805a-b263-4c5a-821a-352bc5c2f1de",
                                "sense_id": "77b51389-9ca8-3eca-ac43-87fc60cf3ae1",
                                "text": "Herr Köpfle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a32ce89e-ed5a-4a03-bcd5-f1cf596e6780",
                                "sense_id": "77b51389-9ca8-3eca-ac43-87fc60cf3ae1",
                                "text": "Die Köpfles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "caf0583e-75dc-415b-a0da-e74e8f025332",
                                "sense_id": "77b51389-9ca8-3eca-ac43-87fc60cf3ae1",
                                "text": "Der Köpfle trägt nie die Pullover, die die Köpfle ihm strickt."
                            },
                            {
                                "example_id": "134248fe-ffe2-4fce-900c-091ec395fffc",
                                "sense_id": "77b51389-9ca8-3eca-ac43-87fc60cf3ae1",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Köpfle kommt, geht der Herr Köpfle.“"
                            },
                            {
                                "example_id": "99c516d6-778b-4da0-b476-1f9dc6d0cdcc",
                                "sense_id": "77b51389-9ca8-3eca-ac43-87fc60cf3ae1",
                                "text": "Köpfle kommt und geht."
                            },
                            {
                                "example_id": "7d745aad-6951-480c-ab40-462f8e4d392e",
                                "sense_id": "77b51389-9ca8-3eca-ac43-87fc60cf3ae1",
                                "text": "Köpfles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
