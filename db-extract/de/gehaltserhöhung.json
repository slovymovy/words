                        "form": "die Gehaltserhöhungen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "25dcfe09-68e1-3f2f-912e-1aa3336f63c0",
                        "entry_id": "8162b408-3702-3a4b-ac06-8b3bb5d60dd3",
                        "glosses": [
                            "Erhöhung des Gehaltes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cab695f8-6b96-4f84-9a3d-1c6f16ecaef4",
                                "sense_id": "25dcfe09-68e1-3f2f-912e-1aa3336f63c0",
                                "text": "Er wartete schon lange auf eine Gehaltserhöhung."
                            },
                            {
                                "example_id": "070d0ead-ac12-46ad-9757-3b77032579e9",
                                "sense_id": "25dcfe09-68e1-3f2f-912e-1aa3336f63c0",
                                "text": "Auf den Einkommenszuwachs von 3.000 € entfallen also eine Einkommensteuer von 1.176 € und Sozialversicherungsbeiträge von 390 €, zusammen 1.566 €, das sind 52,2 % der Gehaltserhöhung."
                            },
                            {
                                "example_id": "ee04f39c-451e-4853-9ba6-1a8d65d82cd0",
                                "sense_id": "25dcfe09-68e1-3f2f-912e-1aa3336f63c0",
                                "text": "So wollen sich die Arbeitnehmervertretungen der Beschäftigten in diesem Gewerbe nicht mit einem Vorschlag der Arbeitgeber bezüglich einer Gehaltserhöhung zufrieden geben."
                            },
                            {
                                "example_id": "a90bb470-efcb-413a-ad77-2b4d10099625",
                                "sense_id": "25dcfe09-68e1-3f2f-912e-1aa3336f63c0",
                                "text": "Die Gewerkschaft deutscher Lokomotivführer fordert für ihre Mitglieder einen eigenen Tarifvertrag und Gehaltserhöhungen von bis zu 30 Prozent."
                            },
                            {
                                "example_id": "2c3512da-58da-4a13-b240-267b2e023242",
                                "sense_id": "25dcfe09-68e1-3f2f-912e-1aa3336f63c0",
                                "text": "„Über eine Gehaltserhöhung von zwei Prozent sind Sie völlig aus dem Häuschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
