                "forms": [],
                "senses": [
                    {
                        "sense_id": "f7111079-a89c-33c5-a493-e4278b2c0534",
                        "entry_id": "0752cceb-aa11-35d5-86fb-732418c761f5",
                        "glosses": [
                            "luidt een zin in die een onverwachte tegenstelling uitdrukt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dd76ad5-438a-49a4-867a-a9f1f28957a2",
                                "sense_id": "f7111079-a89c-33c5-a493-e4278b2c0534",
                                "text": "Het mag dan door sommigen als een archaïsme beschouwd worden, nochtans vind ik \"nochtans\" een erg mooi woord."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "47adbffa-7a19-46fb-8adb-b8a01e760e3d",
                        "source_entry_id": "0752cceb-aa11-35d5-86fb-732418c761f5",
                        "source_sense_id": "f7111079-a89c-33c5-a493-e4278b2c0534",
                        "source_sense_description": "luidt een zin in die een onverwachte tegenstelling uitdrukt",
                        "target_lang_word": "dennoch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dennoch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "59882d94-2433-3ce2-be0b-a62c113e4500",
                                        "entry_id": "6a4fa123-d48a-3c06-be23-a251e2672e9d",
                                        "glosses": [
                                            "trotzdem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bcafea0-2b20-4c01-bcfd-5ea7182ca67c",
                                                "sense_id": "59882d94-2433-3ce2-be0b-a62c113e4500",
                                                "text": "„Dennoch stattfindende Demonstrationen wurden gewaltsam oder unter Androhung von Gewalt aufgelöst.“"
                                            },
                                            {
                                                "example_id": "f6d58cab-6da4-41ae-8dca-609eb4e5ea18",
                                                "sense_id": "59882d94-2433-3ce2-be0b-a62c113e4500",
                                                "text": "„Dennoch liest man jene alten Reiseberichte heute mit gemischten Gefühlen.“"
                                            },
                                            {
                                                "example_id": "9997b190-da46-4852-86c7-62e3276c358e",
                                                "sense_id": "59882d94-2433-3ce2-be0b-a62c113e4500",
                                                "text": "Wir hatten viele Befürchtungen, dennoch ging alles gut."
                                            },
                                            {
                                                "example_id": "df113fc2-1c25-41e1-9abc-a45656b68e95",
                                                "sense_id": "59882d94-2433-3ce2-be0b-a62c113e4500",
                                                "text": "Ich war zwar nicht müde, legte mich aber dennoch schlafen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a2dff869-ff72-42c5-a864-b99d3088f98d",
                        "source_entry_id": "0752cceb-aa11-35d5-86fb-732418c761f5",
                        "source_sense_id": "f7111079-a89c-33c5-a493-e4278b2c0534",
                        "source_sense_description": "luidt een zin in die een onverwachte tegenstelling uitdrukt",
                        "target_lang_word": "trotzdem",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trotzdem",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7682c887-4bc0-3730-b741-a15681602915",
                                        "entry_id": "b9f0c8af-0c89-387b-bb33-ccb23e6563df",
                                        "glosses": [
                                            "dennoch; trotz dieses Umstandes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5a9fcae-cc3f-4944-bff6-2329ba8c7b56",
                                                "sense_id": "7682c887-4bc0-3730-b741-a15681602915",
                                                "text": "Es regnete draußen. Trotzdem habe ich das Fahrrad genommen."
                                            },
                                            {
                                                "example_id": "b046b798-7f0d-4372-a55a-92b4dfab7083",
                                                "sense_id": "7682c887-4bc0-3730-b741-a15681602915",
                                                "text": "„Wandern ist Volkssport in Makedonien. Wanderkarten gibt es trotzdem nicht.“"
                                            },
                                            {
                                                "example_id": "00cce0de-8278-42c2-bd55-b117df0402f8",
                                                "sense_id": "7682c887-4bc0-3730-b741-a15681602915",
                                                "text": "„Flugzeuge, die mit Agrokerosin fliegen, stoßen trotzdem das klimaschädliche Treibhausgas Kohlendioxid aus – aber eben nur so viel, wie die Pflanzen der Atmosphäre zu Lebzeiten entzogen haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "trotzdem",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a39c4579-a4c8-3ed7-bc49-0fc5adc6b9cc",
                                        "entry_id": "37cf61f7-51a8-3a73-a5e7-eaccd1525b55",
                                        "glosses": [
                                            "obwohl; trotz des Umstandes, dass"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73a618df-19a5-4d9e-93e6-ad68da3a6223",
                                                "sense_id": "a39c4579-a4c8-3ed7-bc49-0fc5adc6b9cc",
                                                "text": "Dubslav lachte. »[…] es hat manches für sich, trotzdem es mir nicht recht paßt. […]«"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9a93817a-2375-3b1e-af1d-8693d5e8365c",
                                        "entry_id": "37cf61f7-51a8-3a73-a5e7-eaccd1525b55",
                                        "glosses": [
                                            "No glosses available"
                                        ],
                                        "tags": [
                                            "no-gloss"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d473801-e647-4cd1-950c-6bb23c8b1289",
                                                "sense_id": "9a93817a-2375-3b1e-af1d-8693d5e8365c",
                                                "text": "Trotzdem es draußen regnete, habe ich das Fahrrad genommen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a03dde4a-a712-4991-8d88-5c0f3bfadaf6",
                        "source_entry_id": "0752cceb-aa11-35d5-86fb-732418c761f5",
                        "source_sense_id": "f7111079-a89c-33c5-a493-e4278b2c0534",
                        "source_sense_description": "luidt een zin in die een onverwachte tegenstelling uitdrukt",
                        "target_lang_word": "nichtsdestoweniger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nichtsdestoweniger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5aa4b04b-aa91-3775-b4f0-f8b65d9d47aa",
                                        "entry_id": "cb0998e5-3fd6-3f27-9e72-157d768863f0",
                                        "glosses": [
                                            "dessen ungeachtet, trotz alledem, obwohl das vorher Genannte dagegenspricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c024129e-1ea8-4d4d-9f79-b61a8813ca25",
                                                "sense_id": "5aa4b04b-aa91-3775-b4f0-f8b65d9d47aa",
                                                "text": "„Schon immer wollen die Technischen Universitäten in Deutschland die weltbesten Talente ausbilden und müssen dementsprechend auch die besten Ausbilder gewinnen. Die sind zum Teil Migranten und nichtsdestoweniger akademische ‚Eigengewächse‘.“"
                                            },
                                            {
                                                "example_id": "09dbb3f2-e5dc-4747-950f-96c27db3eb73",
                                                "sense_id": "5aa4b04b-aa91-3775-b4f0-f8b65d9d47aa",
                                                "text": "„Beiden gegenüber, an der der Mitte des Zimmers zugekehrten Tischseite saßen zwei Herren in Zivil, die, seit wenigen Wochen erst heimisch in diesem Kreise, sich nichtsdestoweniger bereits eine dominierende Stellung innerhalb desselben errungen hatten.“"
                                            },
                                            {
                                                "example_id": "9a7bdd43-18b8-4e55-8a71-941df47fd3dd",
                                                "sense_id": "5aa4b04b-aa91-3775-b4f0-f8b65d9d47aa",
                                                "text": "„Das mag leichtsinnig erscheinen, aber nichtsdestoweniger kann ich es nicht dafür halten.“"
                                            },
                                            {
                                                "example_id": "03565a06-5c6e-4ee7-995f-b26c2bba58a6",
                                                "sense_id": "5aa4b04b-aa91-3775-b4f0-f8b65d9d47aa",
                                                "text": "„Auch sie hatte verweinte Augen, doch sah sie nichtsdestoweniger sehr grimmig aus.“"
                                            },
                                            {
                                                "example_id": "74b8590a-ff54-4268-8c85-ed81ea184488",
                                                "sense_id": "5aa4b04b-aa91-3775-b4f0-f8b65d9d47aa",
                                                "text": "„Wie sich's nun herausgestellt hat, würde Ihre Gegenwart nicht nötig gewesen sein, und ich würde den Fall auch ohne Sie zu diesem gedeihlichen Ende geführt haben; aber nichtsdestoweniger bin ich Ihnen dankbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0056757a-27f4-4e02-88c8-940fe5db18a9",
                        "source_entry_id": "0752cceb-aa11-35d5-86fb-732418c761f5",
                        "source_sense_id": "f7111079-a89c-33c5-a493-e4278b2c0534",
                        "source_sense_description": "luidt een zin in die een onverwachte tegenstelling uitdrukt",
                        "target_lang_word": "however",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "however",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47a0b8ef-8fe7-3946-bcf4-306f526ae437",
                                        "entry_id": "5859850b-df2c-3263-b3ed-e8031aa303c2",
                                        "glosses": [
                                            "Nevertheless; yet, still; in spite of that."
                                        ],
                                        "tags": [
                                            "conjunctive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9842e0af-dba3-4f64-8567-5a02592dfce0",
                                                "sense_id": "47a0b8ef-8fe7-3946-bcf4-306f526ae437",
                                                "text": "He told me not to do it. However, I did it anyway. / I did it anyway, however. / I, however, did it anyway."
                                            },
                                            {
                                                "example_id": "43aa4524-465d-4f89-8494-b4d7a2c63d3f",
                                                "sense_id": "47a0b8ef-8fe7-3946-bcf4-306f526ae437",
                                                "text": "She wanted to go; however, she decided against it."
                                            },
                                            {
                                                "example_id": "029f8b54-b5c1-4dc6-83c1-de396aa748df",
                                                "sense_id": "47a0b8ef-8fe7-3946-bcf4-306f526ae437",
                                                "text": "I didn't argue with him; I still think, however, that he is wrong."
                                            },
                                            {
                                                "example_id": "0ae5f610-4511-4b9c-8938-342668c51040",
                                                "sense_id": "47a0b8ef-8fe7-3946-bcf4-306f526ae437",
                                                "text": "Thus, when he drew up instructions in lawyer language, he expressed the important words by an initial, a medial, or a final consonant, and made scratches for all the words between; his clerks, however, understood him very well."
                                            },
                                            {
                                                "example_id": "46d62d2c-69a6-4434-928b-51bc3c68a981",
                                                "sense_id": "47a0b8ef-8fe7-3946-bcf4-306f526ae437",
                                                "text": "That the young Mr. Churchills liked—but they did not like him coming round of an evening and drinking weak whisky-and-water while he held forth on railway debentures and corporation loans. Mr. Barrett, however, by fawning and flattery, seemed to be able to make not only Mrs. Churchill but everyone else do what he desired."
                                            },
                                            {
                                                "example_id": "ada64f56-64d1-43f5-b701-a6cdff89794a",
                                                "sense_id": "47a0b8ef-8fe7-3946-bcf4-306f526ae437",
                                                "text": "Mostly, the microbiome is beneficial. It helps with digestion and enables people to extract a lot more calories from their food than would otherwise be possible. Research over the past few years, however, has implicated it in diseases from atherosclerosis to asthma to autism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d672c929-71c3-3274-a750-95e68c9d1608",
                                        "entry_id": "5859850b-df2c-3263-b3ed-e8031aa303c2",
                                        "glosses": [
                                            "In contrast."
                                        ],
                                        "tags": [
                                            "conjunctive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c42b15d-b5ca-4339-be4d-6ea1ed035d0b",
                                                "sense_id": "d672c929-71c3-3274-a750-95e68c9d1608",
                                                "text": "The conference itself went very well. The party afterwards, however, was a disaster."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02244371-47c7-387b-8e80-1cb1764f5593",
                                        "entry_id": "5859850b-df2c-3263-b3ed-e8031aa303c2",
                                        "glosses": [
                                            "To whatever degree or extent."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65104bbd-f69b-4358-8b44-a97d8acf36cf",
                                                "sense_id": "02244371-47c7-387b-8e80-1cb1764f5593",
                                                "text": "However clear you think you've been, and however many questions you may've answered, there'll always remain some doubts."
                                            },
                                            {
                                                "example_id": "fdcd3e8e-f3c0-4b7c-a4ab-97231a830b6e",
                                                "sense_id": "02244371-47c7-387b-8e80-1cb1764f5593",
                                                "text": "Any rule of thumb, however true (it is), is useless unless you understand its underlying logic."
                                            },
                                            {
                                                "example_id": "a3fa085c-080e-44f7-8870-51201638303c",
                                                "sense_id": "02244371-47c7-387b-8e80-1cb1764f5593",
                                                "text": "However much I study, I never get good grades."
                                            },
                                            {
                                                "example_id": "351e2815-1557-433e-a71b-d76118130e63",
                                                "sense_id": "02244371-47c7-387b-8e80-1cb1764f5593",
                                                "text": "Elinor, however little concerned in it, joined in their discourse; and Marianne, who had the knack of finding her way in every house to the library, however it might be avoided by the family in general, soon procured herself a book."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed8c9055-bb3d-3910-8e73-00141b301b81",
                                        "entry_id": "5859850b-df2c-3263-b3ed-e8031aa303c2",
                                        "glosses": [
                                            "In any way that one likes or chooses; in a haphazard or spontaneous way."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d89a1a62-9ab8-4de8-99ce-abdd5c326f2c",
                                                "sense_id": "ed8c9055-bb3d-3910-8e73-00141b301b81",
                                                "text": "I don't care; just do it however."
                                            },
                                            {
                                                "example_id": "dd07ae07-560f-457e-84d9-57b9d17861fc",
                                                "sense_id": "ed8c9055-bb3d-3910-8e73-00141b301b81",
                                                "text": "Nothing was really planned; things just happened however."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fd22065-49be-39a8-842e-bcd2e1c0cc52",
                                        "entry_id": "5859850b-df2c-3263-b3ed-e8031aa303c2",
                                        "glosses": [
                                            "How ever: an emphatic form of how, used to ask in what manner."
                                        ],
                                        "tags": [
                                            "interrogative",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5607c738-35c1-41c1-98f9-31a2da2199f1",
                                                "sense_id": "6fd22065-49be-39a8-842e-bcd2e1c0cc52",
                                                "text": "I thought it was impossible. However were you able to do it?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce35f69c-50c0-3921-ad67-dd03fd1718fd",
                                        "entry_id": "5859850b-df2c-3263-b3ed-e8031aa303c2",
                                        "glosses": [
                                            "In any case, at any rate, at all events."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b303ede-475b-4d5c-a35d-5912c4d8776f",
                                                "sense_id": "ce35f69c-50c0-3921-ad67-dd03fd1718fd",
                                                "text": "Our chief end and highest interest is happiness : And this is happiness to be freed from all (if it may) [or] however from the greatest evils."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "however",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6bdcabc-4f73-31d7-b44e-a8fe0124cd5c",
                                        "entry_id": "7ccdb0de-b8df-37ac-a816-125539505cd3",
                                        "glosses": [
                                            "Regardless of the way in which."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ce61261-232b-4c64-a7b2-208cce0fe914",
                                                "sense_id": "d6bdcabc-4f73-31d7-b44e-a8fe0124cd5c",
                                                "text": "Let me know when you've had your interview, however it goes."
                                            },
                                            {
                                                "example_id": "7a0c9f3c-33f4-4cf2-964b-781a7b39ddb9",
                                                "sense_id": "d6bdcabc-4f73-31d7-b44e-a8fe0124cd5c",
                                                "text": "However we do this, it isn't going to work."
                                            },
                                            {
                                                "example_id": "87b0afe6-8686-4a22-a82e-71e2f8d20078",
                                                "sense_id": "d6bdcabc-4f73-31d7-b44e-a8fe0124cd5c",
                                                "text": "But the real way to build a successful online business is to be better than your rivals at undermining people's control of their own attention. Partly, this is a result of how online advertising has traditionally worked: advertisers pay for clicks, and a click is a click, however it's obtained."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bdaf2dd-6400-3513-ba19-90e4baa70a2f",
                                        "entry_id": "7ccdb0de-b8df-37ac-a816-125539505cd3",
                                        "glosses": [
                                            "In any way in which."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1715e83-218c-45e3-9d65-2e949cf77b62",
                                                "sense_id": "5bdaf2dd-6400-3513-ba19-90e4baa70a2f",
                                                "text": "She offered to help however she could."
                                            },
                                            {
                                                "example_id": "88cacb4d-12a6-473a-952b-21427d813b22",
                                                "sense_id": "5bdaf2dd-6400-3513-ba19-90e4baa70a2f",
                                                "text": "Wear your hair however you want."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "316e6dc9-06ce-3fd3-bb00-dc0bd729ea18",
                                        "entry_id": "7ccdb0de-b8df-37ac-a816-125539505cd3",
                                        "glosses": [
                                            "But, yet, though, although."
                                        ],
                                        "tags": [
                                            "proscribed"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5cdb501-6ea0-408a-97da-173a1b8bd52d",
                                                "sense_id": "316e6dc9-06ce-3fd3-bb00-dc0bd729ea18",
                                                "text": "She wanted to go, however she decided against it. (proscribed)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78503b4a-6e4f-46b4-9d32-0e027be6c6e1",
                        "source_entry_id": "0752cceb-aa11-35d5-86fb-732418c761f5",
                        "source_sense_id": "f7111079-a89c-33c5-a493-e4278b2c0534",
                        "source_sense_description": "luidt een zin in die een onverwachte tegenstelling uitdrukt",
                        "target_lang_word": "nonetheless",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nonetheless",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d12b6dde-e3cd-30cf-a72f-982a254b6126",
                                        "entry_id": "724ef01f-9a1d-3a37-b269-e9ccb2db5c14",
                                        "glosses": [
                                            "Nevertheless."
                                        ],
                                        "tags": [
                                            "conjunctive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d0eece7-8c90-4919-9dd3-a2c325db0be1",
                                                "sense_id": "d12b6dde-e3cd-30cf-a72f-982a254b6126",
                                                "text": "And \"Juno\" is the kind of movie all indie comedies wish they could be: light and lovable, perhaps a bit too pleased with the cleverness of its dialogue, but a small charmer nonetheless."
                                            },
                                            {
                                                "example_id": "8a94a324-1e21-4806-a662-f96b45bf6a3d",
                                                "sense_id": "d12b6dde-e3cd-30cf-a72f-982a254b6126",
                                                "text": "Nonetheless, some insect prey take advantage of clutter by hiding in it. Earless ghost swift moths become “invisible” to echolocating bats by forming mating clusters close (less than half a meter) above vegetation and effectively blending into the clutter of echoes that the bat receives from the leaves and stems around them."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ebdabd9-ffdd-4208-bac9-79c8d09c2026",
                        "source_entry_id": "0752cceb-aa11-35d5-86fb-732418c761f5",
                        "source_sense_id": "f7111079-a89c-33c5-a493-e4278b2c0534",
                        "source_sense_description": "luidt een zin in die een onverwachte tegenstelling uitdrukt",
                        "target_lang_word": "cependant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cependant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7ae212e4-dca3-3073-87a7-caf8e4e8b833",
                                        "entry_id": "21678227-9969-3e52-b9d0-3a6fc6574853",
                                        "glosses": [
                                            "Pendant ce temps ; entretemps."
                                        ],
                                        "tags": [],
                                        "note": "Désigne, dans ce sens, une action parallèle",
                                        "examples": [
                                            {
                                                "example_id": "94d13b3b-49b0-4dfa-a56c-930924e67b97",
                                                "sense_id": "7ae212e4-dca3-3073-87a7-caf8e4e8b833",
                                                "text": "Nous nous amusons, et cependant la nuit vient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d154339e-3523-38e1-bb8c-75e312bde260",
                                        "entry_id": "21678227-9969-3e52-b9d0-3a6fc6574853",
                                        "glosses": [
                                            "Néanmoins ; toutefois ; nonobstant cela."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02450159-20ec-459e-b25c-9ec740602817",
                                                "sense_id": "d154339e-3523-38e1-bb8c-75e312bde260",
                                                "text": "Admettant ce que nous avons dit plus haut, que les rayons émanés d'un corps lumineux se dirigent à 45 degrés et sont parallèles, il résulte que dans les dessins d'architecture, l’ombre portée d'une saillie est égale à cette même saillie, toutefois cependant que les faces du corps sont parallèles et perpendiculaires entre elles."
                                            },
                                            {
                                                "example_id": "5ef3723c-e35b-444d-8b6d-eab0afbd7b4b",
                                                "sense_id": "d154339e-3523-38e1-bb8c-75e312bde260",
                                                "text": "Depuis ce moment, je fus traité avec un intérêt et des attentions infinis; j'eus cependant beaucoup de peine à me rétablir, et l'on dut me transporter à une annexe de l’hospice, dans l'intérieur de l'île, au quartier de Flic-en—Flac, pour y achever ma longue convalescence."
                                            },
                                            {
                                                "example_id": "a8d2dd8a-5a36-4d89-b119-57bcabfa445e",
                                                "sense_id": "d154339e-3523-38e1-bb8c-75e312bde260",
                                                "text": "Les hybrides Bouschet sont encore anthracnosés dans ce terrain, cependant très sec."
                                            },
                                            {
                                                "example_id": "2e043999-a6ae-40df-b254-a0b2fefe333a",
                                                "sense_id": "d154339e-3523-38e1-bb8c-75e312bde260",
                                                "text": "La Nouvelle Cuisine, c'était un espoir, un dépoussiérage pour une gastronomie qui était rétrograde et cependant leader dans le monde."
                                            },
                                            {
                                                "example_id": "50138ced-6ff0-4d37-9fc4-c1ed19819a14",
                                                "sense_id": "d154339e-3523-38e1-bb8c-75e312bde260",
                                                "text": "Contre toute attente, cette proposition n'est pas du goût du shah qui préfère s'en aller cette fois encore, après avoir cependant offert un plateau de fruits aux tentatrices. Autre pays, autres mœurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3a3378d-182f-4296-9b6a-6c62646e19f7",
                        "source_entry_id": "0752cceb-aa11-35d5-86fb-732418c761f5",
                        "source_sense_id": "f7111079-a89c-33c5-a493-e4278b2c0534",
                        "source_sense_description": "luidt een zin in die een onverwachte tegenstelling uitdrukt",
                        "target_lang_word": "néanmoins",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "néanmoins",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "744d4c37-7753-36d8-9b03-6654ae453861",
                                        "entry_id": "d0b66642-e6ca-3155-80f5-c3221add266d",
                                        "glosses": [
                                            "Malgré cela ; en dépit de cela."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d42b9d00-cb9d-48e6-ac66-05ef5648a8f8",
                                                "sense_id": "744d4c37-7753-36d8-9b03-6654ae453861",
                                                "text": "Le Président a qualifié d’« hypothétique » la possibilité de démilitariser Quemoy et Matsu en échange d'un cessez-le-feu, néanmoins il a reconnu que c'était théoriquement envisagé par la diplomatie américaine."
                                            },
                                            {
                                                "example_id": "0e810fe2-7608-44aa-a700-dc768f9596ea",
                                                "sense_id": "744d4c37-7753-36d8-9b03-6654ae453861",
                                                "text": "Le théâtre pouvant accueillir 1 400 personnes à la fois, les foules ne constituent pas un problème en soi. Néanmoins, comme il s'agit d'un spectacle très couru, et qu'il peut parfois être présenté à guichets fermés, arrivez 30 min à l’avance."
                                            },
                                            {
                                                "example_id": "888d9b76-e45c-49b7-bfa6-70f7c0d1fd78",
                                                "sense_id": "744d4c37-7753-36d8-9b03-6654ae453861",
                                                "text": "Par régulation thermostatique, la chaudière se déclenche seulement si la chaleur solaire est insuffisante; néanmoins l’eau caloporteuse est préchauffée et réduit l’augmentation de température nécessaire."
                                            },
                                            {
                                                "example_id": "6c59a67f-712d-435a-8331-fed783e76c9a",
                                                "sense_id": "744d4c37-7753-36d8-9b03-6654ae453861",
                                                "text": "Lorsqu'un écrivain « de sf » subit une crise d’agraphie non lésionnelle (parfois appelée flemmingite, mélancolie, coma éthylique, etc.) mais désire néanmoins assurer ses fins de mois — c'est-à-dire obtenir à peu près l'équivalent du S.M.I.C. — plusieurs possibilités s'offrent à lui."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
