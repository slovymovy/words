                                "example_id": "97cfda79-6fbb-474e-a40e-ec3536289bc8",
                                "sense_id": "74a5b175-aa39-3d28-96ac-83496d8cecd6",
                                "text": "Heinz Erhardt war ein Unikum."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "7c78a3fe-388c-3956-bf44-fec2858628be",
