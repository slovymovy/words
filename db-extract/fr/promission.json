                ],
                "senses": [
                    {
                        "sense_id": "bc12626e-8669-3cfc-ade5-4035788c8bdb",
                        "entry_id": "d754fed2-6135-3d64-b0e1-226ccb5a78a7",
                        "glosses": [
                            "Promesse, chose promise."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "5a34898c-ee26-4c8b-90cd-f26c76102318",
                                "sense_id": "bc12626e-8669-3cfc-ade5-4035788c8bdb",
                                "text": "Quoi ! Il fallait tout perdre quand j’allais toucher la terre de promission, quand déjà dans le vent je respirais la liberté nouvelle !"
                            },
                            {
                                "example_id": "98753fe5-443b-492c-85ab-47bdbe8d322f",
                                "sense_id": "bc12626e-8669-3cfc-ade5-4035788c8bdb",
                                "text": "…cependant que les intègres moutons du Bon Pasteur brouteraient, en bénissant Dieu, les quintefeuilles et les trèfles d’or dans les pâturages enviés de la Terre de promission."
                            },
                            {
                                "example_id": "6b6a1b4b-ff66-4a9c-b8f7-b395adbf7e30",
                                "sense_id": "bc12626e-8669-3cfc-ade5-4035788c8bdb",
                                "text": "En ce temps-là j'étais crédule\nUn mot m'était promission\nEt je prenais les campanules\nPour les fleurs de la passion."
                            },
                            {
                                "example_id": "c45514e1-8ae3-4f96-9992-24de6b1f3092",
                                "sense_id": "bc12626e-8669-3cfc-ade5-4035788c8bdb",
                                "text": "Terre de promission, terre promise, la terre de Chanaan, que Dieu avait promise, selon la Bible, au peuple hébreu. Pays très fertile."
                            }
                        ]
                    }
                ],
