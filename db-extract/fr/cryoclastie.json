                "senses": [
                    {
                        "sense_id": "2b6df5ac-fc61-3e77-b26a-d28850a1d886",
                        "entry_id": "dfffa7ce-4958-3be7-8321-5cf3734727ae",
                        "glosses": [
                            "Érosion du sol rocheux, causée par les cycles de gel et de dégel de l’eau à l’intérieur du sol."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d68ab19-4d80-485b-b8e1-565cd208ee58",
                                "sense_id": "2b6df5ac-fc61-3e77-b26a-d28850a1d886",
                                "text": "Quand l’eau s’infiltre dans une roche puis gèle, elle peut faire éclater cette dernière, et on appelle cela la cryoclastie."
                            },
                            {
                                "example_id": "273046d1-62f4-4c0d-a21e-cdd231a79aa4",
                                "sense_id": "2b6df5ac-fc61-3e77-b26a-d28850a1d886",
                                "text": "L’efficacité de la cryoclastie dans les domaines à gel modéré résulte de la fréquence des cycles gel-dégel."
                            },
                            {
                                "example_id": "79e90ef1-cf53-4024-b617-00e34a89f515",
                                "sense_id": "2b6df5ac-fc61-3e77-b26a-d28850a1d886",
                                "text": "Un problème m’a retenu instinctivement : le mystère du gel de l’eau incluse dans les microcanalicules des pierres et subissant, du fait de la pression, des changements de structure moléculaire aboutissant à un comportement inverse au titre de la cryoclastie, le gel dans les canalicules se réalisant à + 30° C et le dégel à – 30° C."
                            }
                        ]
                    }
