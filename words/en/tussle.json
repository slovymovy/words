{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2871d37e-41cc-3640-a5e4-a8b35e6097b7",
                    "sense_definition": "A vigorous physical struggle, fight, or scuffle, often disorderly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fight_struggle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The officer suffered minor injuries during a brief <w>tussle</w> with the suspect.",
                            "target_lang_translations": {
                                "de": "Der Beamte erlitt bei einem kurzen <w>Handgemenge</w> mit dem Verdächtigen leichte Verletzungen."
                            }
                        },
                        {
                            "text": "The children had a brief <w>tussle</w> over who got to play with the toy first.",
                            "target_lang_translations": {
                                "de": "Die Kinder hatten eine kurze <w>Rauferei</w> darum, wer zuerst mit dem Spielzeug spielen durfte."
                            }
                        }
                    ],
                    "synonyms": [
                        "scuffle",
                        "struggle",
                        "skirmish",
                        "grapple"
                    ],
                    "common_phrases": [
                        "brief tussle",
                        "physical tussle"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein heftiger, oft ungeordneter körperlicher Kampf oder ein Handgemenge."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Gerangel",
                                "target_lang_sense_clarification": "körperliches Gedränge oder Gerangel"
                            },
                            {
                                "target_lang_word": "Rauferei",
                                "target_lang_sense_clarification": "körperliche Auseinandersetzung, Schlägerei"
                            },
                            {
                                "target_lang_word": "Handgemenge",
                                "target_lang_sense_clarification": "kurzer körperlicher Zusammenstoß"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54f413f7-f3b1-32d0-8c79-d65ad39a2cb4",
                    "sense_definition": "A difficult disagreement, conflict, or contest of wills.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fight_struggle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politicians are locked in a political <w>tussle</w> over healthcare reform.",
                            "target_lang_translations": {
                                "de": "Die Politiker stecken in einem politischen <w>Machtkampf</w> um die Gesundheitsreform fest."
                            }
                        },
                        {
                            "text": "A legal <w>tussle</w> over ownership of the company delayed the merger.",
                            "target_lang_translations": {
                                "de": "Ein juristischer <w>Streit</w> über die Eigentumsverhältnisse des Unternehmens verzögerte die Fusion."
                            }
                        }
                    ],
                    "synonyms": [
                        "dispute",
                        "clash",
                        "quarrel",
                        "conflict"
                    ],
                    "antonyms": [
                        "agreement",
                        "concord"
                    ],
                    "common_phrases": [
                        "power tussle",
                        "legal tussle",
                        "political tussle"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine schwierige Meinungsverschiedenheit, ein Machtkampf oder ein zäher Konflikt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Gerangel",
                                "target_lang_sense_clarification": "Auseinandersetzung um Einfluss oder Positionen"
                            },
                            {
                                "target_lang_word": "Machtkampf",
                                "target_lang_sense_clarification": "politischer oder strategischer Konflikt"
                            },
                            {
                                "target_lang_word": "Tauziehen",
                                "target_lang_sense_clarification": "zähes Hin und Her bei Meinungsverschiedenheiten"
                            },
                            {
                                "target_lang_word": "Streit",
                                "target_lang_sense_clarification": "Meinungsverschiedenheit oder rechtliche Auseinandersetzung"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8c3ffdd9-3ff0-32a2-a174-64d3e45e933e",
                    "sense_definition": "To struggle or fight roughly; to grapple or engage in a contest.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fight_struggle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two forwards continued to <w>tussle</w> for the ball near the goal.",
                            "target_lang_translations": {
                                "de": "Die beiden Stürmer fuhren fort, in Tornähe um den Ball zu <w>rangeln</w>."
                            }
                        },
                        {
                            "text": "Rival groups began to <w>tussle</w> outside the stadium before security intervened.",
                            "target_lang_translations": {
                                "de": "Rivalisierende Gruppen begannen sich vor dem Stadion zu <w>raufen</w>, bevor das Sicherheitspersonal eingriff."
                            }
                        }
                    ],
                    "synonyms": [
                        "scuffle",
                        "grapple",
                        "wrestle",
                        "struggle"
                    ],
                    "common_phrases": [
                        "tussle for the ball",
                        "tussle over control"
                    ],
                    "target_lang_definitions": {
                        "de": "Körperlich rangeln oder raufen; um etwas kämpfen oder ringen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "rangeln",
                                "target_lang_sense_clarification": "körperlich um etwas kämpfen oder sich balgen"
                            },
                            {
                                "target_lang_word": "raufen",
                                "target_lang_sense_clarification": "sich ohne Waffen handgreiflich auseinandersetzen"
                            },
                            {
                                "target_lang_word": "kämpfen",
                                "target_lang_sense_clarification": "körperlich oder im übertragenen Sinne ringen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}