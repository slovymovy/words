                "senses": [
                    {
                        "sense_id": "25301d7a-ad32-37db-90b8-84a4ca767fae",
                        "entry_id": "98c4ea71-e777-32a3-a2ce-06faf1ded0f9",
                        "glosses": [
                            "делать что-либо горьким"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00828e03-74f0-4b90-938a-534f76001ff7",
                                "sense_id": "25301d7a-ad32-37db-90b8-84a4ca767fae",
                                "text": "Тараска не понимал, зачем он хочет горчить себе во рту."
                            }
                        ]
                    },
                    {
                        "sense_id": "4f012332-75e0-3b21-966b-aadbc0ee1721",
                        "entry_id": "98c4ea71-e777-32a3-a2ce-06faf1ded0f9",
                        "glosses": [
                            "разг. перен. делать более горестным, тяжёлым (о жизни, судьбе и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a803da0-e60c-4b00-adaf-8941e56c6eb0",
                                "sense_id": "4f012332-75e0-3b21-966b-aadbc0ee1721",
                                "text": "Мне легко и отрадно дышать и жить в этом тихом свете святой славы, который не грозит, не проклинает, не горчит радости мира."
                            }
                        ]
                    }
                ],
