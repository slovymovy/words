                    {
                        "form_id": "c030923d-f65d-44a8-89d3-109f5e69742a",
                        "entry_id": "753b6a9c-d100-3527-a8f9-0f9ccce0708f",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Bundespräsidenten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b0f95c41-1cd6-37e2-9304-d56270d03504",
                        "entry_id": "753b6a9c-d100-3527-a8f9-0f9ccce0708f",
                        "glosses": [
                            "das Staatsoberhaupt der Bundesrepublik Deutschland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22ae8b82-971c-424e-96d4-bb180af9cd63",
                                "sense_id": "b0f95c41-1cd6-37e2-9304-d56270d03504",
                                "text": "Die Väter des Grundgesetz haben das Amt des Bundespräsidenten in bewusster Abkehr von der Rolle des Reichspräsidenten während der Weimarer Republik gestaltet."
                            },
                            {
                                "example_id": "5d5d3bd9-c60a-4cc2-984a-1f1f1226baaa",
                                "sense_id": "b0f95c41-1cd6-37e2-9304-d56270d03504",
                                "text": "„Mit dem linken Handrücken wischte der Bundespräsident sich den Mund ab.“"
                            },
                            {
                                "example_id": "816bbda9-a446-4927-a6cb-990be2258795",
                                "sense_id": "b0f95c41-1cd6-37e2-9304-d56270d03504",
                                "text": "„Die Gründe für das ablehnende Verhalten des Bundespräsidenten dürften in den Maßnahmen des Postministers zu suchen sein, der sich kürzlich anhand des Telefonbuches als Raumspargenie erwiesen hat.“"
                            },
                            {
                                "example_id": "e46df046-3408-44be-aebf-f54378100a89",
                                "sense_id": "b0f95c41-1cd6-37e2-9304-d56270d03504",
                                "text": "„Eine Hamburger Deern, Tochter griechischer Gastarbeiter, steht nun in Athen und begleitet den deutschen Bundespräsidenten bei seinem Staatsbesuch in der griechischen Hauptstadt.“"
                            },
                            {
                                "example_id": "0c5e6088-348a-471e-8c3e-6d682c187cde",
                                "sense_id": "b0f95c41-1cd6-37e2-9304-d56270d03504",
                                "text": "„Elf Jahre später versagte Bundespräsident Horst Köhler fast die Stimme, als er sich vor der Knesset zur deutschen Verantwortung für den Holocaust bekannte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2d14eaa4-ac7f-32d2-8bf4-8ab9d8eeeaf6",
                        "entry_id": "753b6a9c-d100-3527-a8f9-0f9ccce0708f",
                        "glosses": [
                            "das Staatsoberhaupt der Republik Österreich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03486551-a682-4b0b-85c4-6912c21b9ae1",
                                "sense_id": "2d14eaa4-ac7f-32d2-8bf4-8ab9d8eeeaf6",
                                "text": "In Österreich wird der Bundespräsident direkt vom sogenannten Bundesvolk gewählt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "e45399bf-ca5a-38f7-9a75-737c3488f03c",
                        "entry_id": "753b6a9c-d100-3527-a8f9-0f9ccce0708f",
                        "glosses": [
                            "der Vorsitzende des Schweizerischen Bundesrates"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1857fdc2-09c5-4281-abd0-53e3e4c52c48",
                                "sense_id": "e45399bf-ca5a-38f7-9a75-737c3488f03c",
                                "text": "„Anders als der Bundespräsident in den Nachbarländern Österreich oder Deutschland ist der Schweizer Bundespräsident kein Staatsoberhaupt.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
