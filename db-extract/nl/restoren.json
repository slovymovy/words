                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0146b4da-eeea-4991-b57f-d16e2e522d48",
                                                "sense_id": "b33f365e-3d17-3f7b-8bb1-ccc90627d4fc",
                                                "text": "to restore harmony among those who are at variance"
                                            },
                                            {
                                                "example_id": "07620b93-4012-43e5-bb3b-8c6c82aa7724",
                                                "sense_id": "b33f365e-3d17-3f7b-8bb1-ccc90627d4fc",
                                                "text": "He restored my lost faith in him by doing a good deed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9445434-f5b2-377c-a7e3-9fc913a365db",
                                        "entry_id": "9154776b-2103-365b-a594-3cede89486a2",
                                        "glosses": [
                                            "To bring back to good condition from a state of decay or ruin."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61540d57-0d61-45e5-844a-16253e64a467",
                                                "sense_id": "e9445434-f5b2-377c-a7e3-9fc913a365db",
                                                "text": "and his hand was restored whole as the other"
                                            },
                                            {
                                                "example_id": "e10f4894-87c9-4836-8de8-a67ef71d9699",
                                                "sense_id": "e9445434-f5b2-377c-a7e3-9fc913a365db",
                                                "text": "our fortune restored after the severest afflictions"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03424640-e041-3c05-bb24-47de5c72a466",
                                        "entry_id": "9154776b-2103-365b-a594-3cede89486a2",
                                        "glosses": [
                                            "To give or bring back (that which has been lost or taken); to bring back to the owner; to replace."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f189e2f-5974-4e8d-baf1-48bd151775b7",
                                                "sense_id": "03424640-e041-3c05-bb24-47de5c72a466",
                                                "text": "Now therefore restore the man his wife."
                                            },
                                            {
                                                "example_id": "d61ec4f4-eab9-476d-8a24-6fc0dda50011",
                                                "sense_id": "03424640-e041-3c05-bb24-47de5c72a466",
                                                "text": "Loss of Eden, till one greater man / Restore us, and regain the blissful seat."
                                            },
                                            {
                                                "example_id": "9aa62f72-a1da-452e-8517-b56d214b2404",
                                                "sense_id": "03424640-e041-3c05-bb24-47de5c72a466",
                                                "text": "The father banish;d virtue shall restore."
                                            },
                                            {
                                                "example_id": "5a8e40b0-d26d-49e2-96ea-ad360322fcd2",
                                                "sense_id": "03424640-e041-3c05-bb24-47de5c72a466",
                                                "text": "The plain appears like paradiſe reſtored, where the proud cypreſs and tall arreca ſeem walking by the margin of the paſſing ſtream."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d38d4638-ff65-3805-986f-323d627eb868",
                                        "entry_id": "9154776b-2103-365b-a594-3cede89486a2",
                                        "glosses": [
                                            "To give in place of, or as restitution for."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "431a9004-6c4a-4f6b-871c-5d63765d3585",
                                                "sense_id": "d38d4638-ff65-3805-986f-323d627eb868",
                                                "text": "He shall restore five oxen for an ox, and four sheep for a sheep."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e29e1ba9-6dae-31a7-9c15-d2cfbea7709a",
                                        "entry_id": "9154776b-2103-365b-a594-3cede89486a2",
                                        "glosses": [
                                            "To recover (data, etc.) from a backup."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2bdb4af8-e5dc-466f-ab83-7391a9b2aa0c",
                                                "sense_id": "e29e1ba9-6dae-31a7-9c15-d2cfbea7709a",
                                                "text": "There was a crash last night, and we're still restoring the file system."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b93ed1a-0198-3014-ad15-87260212ec17",
                                        "entry_id": "9154776b-2103-365b-a594-3cede89486a2",
                                        "glosses": [
                                            "To bring (a note) back to its original signification."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bac08c7d-a797-366e-be56-6f8f7108e012",
                                        "entry_id": "9154776b-2103-365b-a594-3cede89486a2",
                                        "glosses": [
                                            "To make good; to make amends for."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f1e26a3-da93-422c-bbb1-69f3f068d836",
                                                "sense_id": "bac08c7d-a797-366e-be56-6f8f7108e012",
                                                "text": "But if the while I think on thee, dear friend, / All losses are restored, and sorrows end."
                                            }
                                        ]
                                    }
