{
    "word_family": [
        "oral"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a2d03665-ff52-3d5d-8e10-6fbe177dd9c1",
                    "sense_definition": "By means of spoken words rather than in writing",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The students presented their final projects <w>orally</w> to the rest of the class.",
                            "target_lang_translations": {
                                "ru": "Студенты защищали свои итоговые проекты перед остальной группой <w>устно</w>."
                            }
                        },
                        {
                            "text": "He chose to deliver his testimony <w>orally</w> instead of submitting a written report.",
                            "target_lang_translations": {
                                "ru": "Он решил дать показания <w>устно</w>, вместо того чтобы подавать письменный отчёт."
                            }
                        }
                    ],
                    "synonyms": [
                        "verbally"
                    ],
                    "antonyms": [
                        "in writing"
                    ],
                    "common_phrases": [
                        "presented orally",
                        "delivered orally",
                        "examined orally"
                    ],
                    "target_lang_definitions": {
                        "ru": "При помощи устной речи, на словах, а не в письменном виде"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "устно",
                                "target_lang_sense_clarification": "словами, в устной форме"
                            },
                            {
                                "target_lang_word": "на словах",
                                "target_lang_sense_clarification": "не письменно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d0aca7c-b861-315f-8412-24d9437a1a50",
                    "sense_definition": "Through or by way of the mouth, especially relating to taking medication",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This medication should be taken <w>orally</w> once a day with food.",
                            "target_lang_translations": {
                                "ru": "Это лекарство следует принимать <w>внутрь</w> один раз в день во время еды."
                            }
                        },
                        {
                            "text": "The vaccine can be administered <w>orally</w> rather than by an injection.",
                            "target_lang_translations": {
                                "ru": "Вакцину можно вводить <w>перорально</w>, а не в виде инъекции."
                            }
                        }
                    ],
                    "common_phrases": [
                        "taken orally",
                        "administered orally"
                    ],
                    "target_lang_definitions": {
                        "ru": "Через рот, путём проглатывания (особенно при приёме лекарств)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "орально",
                                "target_lang_sense_clarification": "через рот, внутрь (медицинский термин)"
                            },
                            {
                                "target_lang_word": "внутрь",
                                "target_lang_sense_clarification": "о способе приёма лекарств через рот"
                            },
                            {
                                "target_lang_word": "через рот",
                                "target_lang_sense_clarification": "путём проглатывания"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}