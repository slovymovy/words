{
    "word_family": [
        "acuminate",
        "acumination"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "83633bdb-a27c-3e78-b433-79e7648970aa",
                    "sense_definition": "The ability to make good judgments and quick decisions, typically in a particular domain.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mental ability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her remarkable business <w>acumen</w> helped the small startup grow into a global corporation within five years.",
                            "target_lang_translations": {
                                "ru": "Ее недюжинная деловая <w>хватка</w> помогла небольшому стартапу вырасти в глобальную корпорацию за пять лет."
                            }
                        },
                        {
                            "text": "The lawyer's legal <w>acumen</w> was evident as he navigated the complex regulations of the new trade agreement.",
                            "target_lang_translations": {
                                "ru": "Юридическая <w>проницательность</w> адвоката была очевидна, когда он разбирался в сложных правилах нового торгового соглашения."
                            }
                        }
                    ],
                    "synonyms": [
                        "shrewdness",
                        "acuity",
                        "keenness",
                        "sharpness",
                        "canniness",
                        "intelligence"
                    ],
                    "antonyms": [
                        "ignorance",
                        "stupidity",
                        "insensitivity"
                    ],
                    "common_phrases": [
                        "business acumen",
                        "legal acumen",
                        "financial acumen",
                        "political acumen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность выносить правильные суждения и быстро принимать решения, как правило, в определенной области."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проницательность",
                                "target_lang_sense_clarification": "способность быстро и верно понимать сущность чего-либо"
                            },
                            {
                                "target_lang_word": "хватка",
                                "target_lang_sense_clarification": "деловая или практическая сметливость"
                            },
                            {
                                "target_lang_word": "сообразительность",
                                "target_lang_sense_clarification": "способность быстро и правильно соображать"
                            },
                            {
                                "target_lang_word": "прозорливость",
                                "target_lang_sense_clarification": "способность предвидеть развитие событий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a648dce-e5f6-377b-a9e2-49260c91f2f3",
                    "sense_definition": "A sharp, tapering point, especially one extending from a plant part like a leaf or calyx.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The botanist noted that the <w>acumen</w> of the leaf was significantly longer in this specific variety.",
                            "target_lang_translations": {
                                "ru": "Ботаник отметил, что <w>острие</w> листа у этого конкретного сорта было значительно длиннее."
                            }
                        },
                        {
                            "text": "The sharp <w>acumina</w> of the calyx help protect the flower before it fully blooms.",
                            "target_lang_translations": {
                                "ru": "Острые <w>верхушки</w> чашечки помогают защитить цветок до его полного распускания."
                            }
                        }
                    ],
                    "common_phrases": [
                        "leaf acumen",
                        "calyx acumen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical botanical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Острое, сужающееся острие, особенно на части растения, такой как лист или чашечка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "острие",
                                "target_lang_sense_clarification": "заостренный кончик"
                            },
                            {
                                "target_lang_word": "верхушка",
                                "target_lang_sense_clarification": "заостренный конец листа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a06d6823-95d6-3f72-b6ec-1cce13754500",
                    "sense_definition": "A bony, often sharp, protuberance or extension, such as that found on the carapace of a crustacean.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rostrum of the crayfish ends in a distinct <w>acumen</w> that serves as a diagnostic feature for the species.",
                            "target_lang_translations": {
                                "ru": "Рострум рака заканчивается отчетливым <w>острием</w>, которое служит диагностическим признаком вида."
                            }
                        },
                        {
                            "text": "Researchers measured the length of the <w>acumen</w> to determine the age and health of the specimen.",
                            "target_lang_translations": {
                                "ru": "Исследователи измерили длину <w>шипа</w>, чтобы определить возраст и состояние здоровья особи."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific anatomical term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Костный, часто острый выступ или отросток, например, на панцире ракообразных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "острие",
                                "target_lang_sense_clarification": "острый выступ на панцире"
                            },
                            {
                                "target_lang_word": "шип",
                                "target_lang_sense_clarification": "костный вырост"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}