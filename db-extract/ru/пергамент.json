                    {
                        "sense_id": "4d153682-a55c-3e27-8b1b-75926f7b12e3",
                        "entry_id": "a9edb8a6-3d1b-3e89-be59-247f896f7422",
                        "glosses": [
                            "истор. писчий или поделочный материал из телячьей кожи, а также документы, написанные на таком материале"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f9013bc-4f69-4452-9473-8e6da46eb474",
                                "sense_id": "4d153682-a55c-3e27-8b1b-75926f7b12e3",
                                "text": "Трудно было понять эти корявые строчки, и Пилат морщился и склонялся к самому пергаменту, водил пальцем по строчкам."
                            }
                        ]
                    },
                    {
                        "sense_id": "db9d9251-9158-3fe7-939e-08f73847066c",
                        "entry_id": "a9edb8a6-3d1b-3e89-be59-247f896f7422",
                        "glosses": [
                            "специально обработанная бумага, не пропускающая воды"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1594bfe1-4e59-43f2-898a-e52eeb147ad3",
                        "source_entry_id": "a9edb8a6-3d1b-3e89-be59-247f896f7422",
