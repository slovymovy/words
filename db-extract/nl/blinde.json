                    }
                ],
                "senses": [
                    {
                        "sense_id": "15f0c9fe-f7b8-3532-8747-49620884ca82",
                        "entry_id": "47356707-29b2-362d-bb9f-44a134d1718a",
                        "glosses": [
                            "iemand die niet kan zien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3900394-3665-4a6e-9830-1208d0b1c1f6",
                                "sense_id": "15f0c9fe-f7b8-3532-8747-49620884ca82",
                                "text": "De blinde had een blindengeleidehond nodig om naar zijn werk te kunnen gaan."
                            },
                            {
                                "example_id": "b10dc3f4-60d5-4d5b-9b31-8971c9a713c0",
                                "sense_id": "15f0c9fe-f7b8-3532-8747-49620884ca82",
                                "text": "„Maar ik vroeg me af: wat missen blinden nog?”, zegt Dylan Verburg, student aan de Universiteit Twente. Daarom interviewde Dylan een blinde persoon en deed hij een kleine enquête onder blinden. De uitkomst: blinden willen heel graag de gezichtsuitdrukking ‘zien’ van de persoon met wie ze praten."
                            },
                            {
                                "example_id": "ec8e36a7-4550-4bbd-becb-e5781c80663d",
                                "sense_id": "15f0c9fe-f7b8-3532-8747-49620884ca82",
                                "text": "'Zelfs een blinde kon zien dat het een overtreding was, idioot,' becommentarieerde de man met de harde stem."
                            }
                        ]
                    },
                    {
                        "sense_id": "9860ad6f-e3f0-3d27-91ec-b5762f989a26",
                        "entry_id": "47356707-29b2-362d-bb9f-44a134d1718a",
                        "glosses": [
                            "vensterluik, blind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76887c65-9687-4cfc-beb8-8fe633310636",
                                "sense_id": "9860ad6f-e3f0-3d27-91ec-b5762f989a26",
                                "text": "Voor de nacht moesten we eerste de blinden sluiten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95005865-7c7b-4f4d-94d6-e4835231a57d",
                        "source_entry_id": "47356707-29b2-362d-bb9f-44a134d1718a",
                        "source_sense_id": "15f0c9fe-f7b8-3532-8747-49620884ca82",
                        "source_sense_description": "iemand die niet kan zien",
                        "target_lang_word": "Blinder",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Blinder",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d800af8a-330f-3375-b11f-d61787cfa322",
                                        "entry_id": "8f53725a-8b6d-33d6-a6ae-8b43a4913e7c",
                                        "glosses": [
                                            "Person, die nicht sehen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71637474-0d7f-4930-b380-904ad0c56a9e",
                                                "sense_id": "d800af8a-330f-3375-b11f-d61787cfa322",
                                                "text": "Es ist unmöglich einem Blinden zu erklären, was rot ist."
                                            },
                                            {
                                                "example_id": "15d13bb8-ca20-46e6-9f89-5dd05596ec77",
                                                "sense_id": "d800af8a-330f-3375-b11f-d61787cfa322",
                                                "text": "„Ich betastete ihr Gesicht wie ein Blinder.“"
                                            },
                                            {
                                                "example_id": "52713360-f65e-4006-b576-554fd45531be",
                                                "sense_id": "d800af8a-330f-3375-b11f-d61787cfa322",
                                                "text": "„Die vier Evangelisten berichten, wie Christus unter anderem Gelähmte und Blinde durch seine Anwesenheit oder durch Berührung von ihren Leiden befreit hat.“"
                                            },
                                            {
                                                "example_id": "09fe74dd-e8dd-4278-9d8c-7f30c0e94a24",
                                                "sense_id": "d800af8a-330f-3375-b11f-d61787cfa322",
                                                "text": "„Während die Blinden Platz nahmen und ihre Instrumente stimmten, versetzten sich die Schönen und der fünfundzwanzigjährige Athlet in den Naturzustand, und das Schauspiel begann.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
