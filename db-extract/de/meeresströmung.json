                    {
                        "sense_id": "87cf4f6e-2573-3188-bafb-e9f59a374806",
                        "entry_id": "1c2ec5c7-3b58-37c4-b332-3640afbb57bc",
                        "glosses": [
                            "Courant marin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ef7461e-217d-47bd-894e-34ece90261e4",
                                "sense_id": "87cf4f6e-2573-3188-bafb-e9f59a374806",
                                "text": "Die Meeresströmungen transportieren Wärme und Nährstoffe in verschiedene Gebiete der Erde und tragen entscheidend dazu bei, dass das Klima in großen Teilen der nördlichen Hemisphäre relativ mild bleibt.",
                                "translation": "Les courants marins transportent la chaleur et les nutriments dans différentes régions du monde et contribuent de manière décisive à ce que le climat reste relativement doux dans une grande partie de l'hémisphère nord."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
