                ],
                "senses": [
                    {
                        "sense_id": "a32188fc-e416-358a-8de7-49ef3c67e1f7",
                        "entry_id": "447977f4-4192-3314-90ec-5e30233813b4",
                        "glosses": [
                            "digitales oder ausgedrucktes Bild des aktuellen Bildschirminhalts oder eines Teiles davon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "380c00e0-fa47-4cfb-a72e-bae12a908e50",
                                "sense_id": "a32188fc-e416-358a-8de7-49ef3c67e1f7",
                                "text": "„Er veröffentlicht in einer Facebook-Diskussion mit Nutzern ein Bildschirmfoto eines Wikipedia-Eintrages über das Grundgesetz, den er in der Diskussion präsentieren wollte.“"
                            },
                            {
                                "example_id": "e3ab7112-d121-42bc-bc62-c70c20bee5c3",
                                "sense_id": "a32188fc-e416-358a-8de7-49ef3c67e1f7",
                                "text": "„Ob das Speichern von Bildern, die man sonst nicht sichern kann, oder das Erklären von Funktionen: Bildschirmfotos sind ein nützliches Werkzeug vieler Computernutzer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2641a101-b0c2-45c8-bd02-61955feed5fa",
                        "source_entry_id": "447977f4-4192-3314-90ec-5e30233813b4",
                        "source_sense_id": "a32188fc-e416-358a-8de7-49ef3c67e1f7",
                        "source_sense_description": "digitales oder ausgedrucktes Bild des aktuellen Bildschirminhalts oder eines Teiles davon",
                        "target_lang_word": "screenshot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "screenshot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f09a1ae-7769-315c-8fa0-5c83a36f918a",
                                        "entry_id": "b2cecd44-d3a5-3633-8e2e-dd4b12827484",
                                        "glosses": [
                                            "An image of computer or smartphone screen output at a given moment in time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e753cab-b860-4ab6-bbe2-b5d43175f473",
                                                "sense_id": "4f09a1ae-7769-315c-8fa0-5c83a36f918a",
                                                "text": "I grabbed a screenshot of my desktop."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "screenshot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c57c590-e0da-37be-b37f-8eddff7cdcc3",
                                        "entry_id": "3e32e7b2-1b06-3993-9e9a-2e9e03688a06",
                                        "glosses": [
                                            "To take a screenshot of something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c79fe0f1-acbe-4dae-98d9-9c529ce18bdb",
                                                "sense_id": "3c57c590-e0da-37be-b37f-8eddff7cdcc3",
                                                "text": "To help to improve the software, make sure to screenshot any bugs you find."
                                            },
                                            {
                                                "example_id": "c1a559d4-bcdb-4866-a727-35c8bd6226bd",
                                                "sense_id": "3c57c590-e0da-37be-b37f-8eddff7cdcc3",
                                                "text": "Northern has made it harder for fraudsters to cheat checks on barcode season tickets. The operator has made it impossible for people to screenshot tickets from within the Northern app and then share the tickets for others to use."
                                            },
                                            {
                                                "example_id": "5e77a8ae-01af-46e6-8bd0-f16b969cef9b",
                                                "sense_id": "3c57c590-e0da-37be-b37f-8eddff7cdcc3",
                                                "text": "It was one of the funnier, somewhat surprising screw-ups we’d seen from Gemini, which like all publicly available artificial intelligence tools is prone to what the tech industry calls “hallucinations.” He screenshot the answer so that we could have a laugh about it, and then scrolled down to find the first non-sponsored, non-AI search result: an entry from one of the most reliable places on the internet, Wikipedia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "620f241d-fb81-4b62-8ed7-6c9edcabd712",
                        "source_entry_id": "447977f4-4192-3314-90ec-5e30233813b4",
                        "source_sense_id": "a32188fc-e416-358a-8de7-49ef3c67e1f7",
