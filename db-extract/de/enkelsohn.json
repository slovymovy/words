                "senses": [
                    {
                        "sense_id": "6a147e43-10c7-3d9f-951f-37854768f0b8",
                        "entry_id": "03752f30-7be2-32a5-993a-ba2a3d53eb00",
                        "glosses": [
                            "männliches Kind des eigenen Sohnes oder der eigenen Tochter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a54d016-95d1-43b9-9ced-a45488d8e527",
                                "sense_id": "6a147e43-10c7-3d9f-951f-37854768f0b8",
                                "text": "Mein Enkelsohn geht noch zur Schule."
                            },
                            {
                                "example_id": "3040c0e1-0a16-4bcb-9b79-34f8260a4fc2",
                                "sense_id": "6a147e43-10c7-3d9f-951f-37854768f0b8",
                                "text": "„Denn Großmutter und Enkelsohn nahmen ihren Weg nicht durch den Laden, sondern über den Hinterhof.“"
                            },
                            {
                                "example_id": "c9f1ec79-9777-4ac1-aef1-fcefffb857bb",
                                "sense_id": "6a147e43-10c7-3d9f-951f-37854768f0b8",
                                "text": "„Ihr Enkelsohn spielt im Wohnzimmer Playstation und rückt ein wenig zur Seite, als wir uns zu ihm auf das Sofa setzen.“"
                            },
                            {
                                "example_id": "54699043-f127-41ea-824c-b5091c813ca2",
                                "sense_id": "6a147e43-10c7-3d9f-951f-37854768f0b8",
                                "text": "„Eine jüdische Großmutter und ihr kleiner Enkelsohn sind am Strand.“"
                            },
                            {
                                "example_id": "085ab471-baa5-42cf-83eb-c6ba0faa3712",
                                "sense_id": "6a147e43-10c7-3d9f-951f-37854768f0b8",
                                "text": "„Islamistische Autoren besinnen sich dagegen eher auf Akbars Enkelsohn Aurangzeb, der für die Rückbesinnung auf islamische Tradition und für die Säuberung der herrschaftlichen Praxis von «heidnischen» Riten steht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a2fab68-0e84-4603-b683-6a41f52047ae",
                        "source_entry_id": "03752f30-7be2-32a5-993a-ba2a3d53eb00",
                        "source_sense_id": "6a147e43-10c7-3d9f-951f-37854768f0b8",
                        "source_sense_description": "männliches Kind des eigenen Sohnes oder der eigenen Tochter",
                        "target_lang_word": "grandson",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grandson",
