{
    "word_family": [
        "enrichment",
        "rich",
        "richly",
        "richness"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6a8ca129-c974-3008-bf40-c877a557df38",
                    "sense_definition": "To make someone or something wealthy or more prosperous.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "wealth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The discovery of oil in the region will <w>enrich</w> the local community for generations.",
                            "target_lang_translations": {
                                "ru": "Открытие нефти в регионе будет <w>обогащать</w> местное сообщество на протяжении многих поколений."
                            }
                        },
                        {
                            "text": "Many people believe that travel can <w>enrich</w> lives by providing new perspectives.",
                            "target_lang_translations": {
                                "ru": "Многие люди верят, что путешествия могут <w>обогатить</w> жизнь, открывая новые перспективы."
                            }
                        }
                    ],
                    "synonyms": [
                        "endow"
                    ],
                    "antonyms": [
                        "impoverish"
                    ],
                    "common_phrases": [
                        "enrich lives",
                        "enrich the community"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать кого-либо или что-либо богатым или более процветающим."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обогащать",
                                "target_lang_sense_clarification": "делать богатым или состоятельным"
                            },
                            {
                                "target_lang_word": "делать богаче",
                                "target_lang_sense_clarification": "увеличивать благосостояние"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f21a6e5-e974-376d-a879-0e8bae316e43",
                    "sense_definition": "To improve or enhance the quality or value of something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "improvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can <w>enrich</w> your vocabulary by reading a wide variety of books every day.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>обогатить</w> свой словарный запас, ежедневно читая самые разные книги."
                            }
                        },
                        {
                            "text": "Adding fresh herbs will <w>enrich</w> the flavor of the soup significantly.",
                            "target_lang_translations": {
                                "ru": "Добавление свежей зелени значительно <w>улучшит</w> вкус супа."
                            }
                        }
                    ],
                    "antonyms": [
                        "deplete"
                    ],
                    "common_phrases": [
                        "enrich the flavor",
                        "enrich your vocabulary"
                    ],
                    "target_lang_definitions": {
                        "ru": "Улучшить или повысить качество или ценность чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обогащать",
                                "target_lang_sense_clarification": "делать более значительным по содержанию"
                            },
                            {
                                "target_lang_word": "развивать",
                                "target_lang_sense_clarification": "увеличивать запас знаний или опыт"
                            },
                            {
                                "target_lang_word": "улучшать",
                                "target_lang_sense_clarification": "повышать качество"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f63b169f-5d46-30da-a9d5-edf6a8ad023e",
                    "sense_definition": "To add nutrients or vitamins to food to make it more nutritious.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nutrition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government decided to <w>enrich</w> white bread with essential vitamins and minerals.",
                            "target_lang_translations": {
                                "ru": "Правительство решило <w>обогащать</w> белый хлеб необходимыми витаминами и минералами."
                            }
                        },
                        {
                            "text": "Manufacturers often <w>enrich</w> breakfast cereals to help children get enough iron.",
                            "target_lang_translations": {
                                "ru": "Производители часто <w>обогащают</w> сухие завтраки, чтобы помочь детям получать достаточное количество железа."
                            }
                        }
                    ],
                    "common_phrases": [
                        "enrich with vitamins",
                        "enrich breakfast cereals"
                    ],
                    "target_lang_definitions": {
                        "ru": "Добавлять питательные вещества или витамины в пищу, чтобы сделать её более полезной."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обогащать",
                                "target_lang_sense_clarification": "насыщать витаминами или минералами"
                            },
                            {
                                "target_lang_word": "витаминизировать",
                                "target_lang_sense_clarification": "добавлять витамины"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbe27d9a-cf6a-3469-b010-63c9221da5c0",
                    "sense_definition": "To improve the fertility of soil by adding nutrients or fertilizer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Farmers use organic compost to <w>enrich</w> the soil before the planting season begins.",
                            "target_lang_translations": {
                                "ru": "Фермеры используют органический компост, чтобы <w>обогатить</w> почву перед началом посевного сезона."
                            }
                        },
                        {
                            "text": "The floodwaters would <w>enrich</w> the soil with silt, making the valley very productive.",
                            "target_lang_translations": {
                                "ru": "Паводковые воды <w>насыщали</w> почву илом, делая долину очень плодородной."
                            }
                        }
                    ],
                    "antonyms": [
                        "deplete"
                    ],
                    "common_phrases": [
                        "enrich the soil"
                    ],
                    "target_lang_definitions": {
                        "ru": "Повышать плодородие почвы путем добавления питательных веществ или удобрений."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обогащать",
                                "target_lang_sense_clarification": "насыщать почву полезными веществами"
                            },
                            {
                                "target_lang_word": "удобрять",
                                "target_lang_sense_clarification": "вносить удобрения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e6bd2ff-b1f8-328f-89de-ee477f7c1a2b",
                    "sense_definition": "To increase the proportion of a specific isotope in a mixture, particularly for nuclear fuel.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The facility was designed to <w>enrich</w> uranium for use in nuclear power plants.",
                            "target_lang_translations": {
                                "ru": "Предприятие было спроектировано для того, чтобы <w>обогащать</w> уран для использования на атомных электростанциях."
                            }
                        },
                        {
                            "text": "International inspectors monitored the process used to <w>enrich</w> the fuel mixture.",
                            "target_lang_translations": {
                                "ru": "Международные инспекторы следили за процессом, используемым для того, чтобы <w>обогащать</w> топливную смесь."
                            }
                        }
                    ],
                    "antonyms": [
                        "downblend"
                    ],
                    "common_phrases": [
                        "enrich uranium",
                        "enrich fuel mixture"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Увеличивать долю определенного изотопа в смеси, особенно для ядерного топлива."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обогащать",
                                "target_lang_sense_clarification": "увеличивать концентрацию изотопа"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}