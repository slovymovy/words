                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1551b1c9-bbf4-4a49-9521-5d65d08efe48",
                                "sense_id": "49717d81-82c4-31d9-9409-6328a7f8afe3",
                                "text": "On détruit, on nettoie, on re-détruit, on re-nettoie."
                            },
                            {
                                "example_id": "60857fb9-3168-47a5-8a7c-83972011a9d0",
                                "sense_id": "49717d81-82c4-31d9-9409-6328a7f8afe3",
                                "text": "C’est propre, c’est huilé, c’est propre et tout, et il faut re-nettoyer, tout enlever la graisse pour remettre de la graisse."
