                                        "entry_id": "5dbec042-72be-39aa-89ee-4194d5fe06a4",
                                        "glosses": [
                                            "fünfundzwanzig Arten einer Gattung (Tamias) der Hörnchen (Sciuridae), die der Ordnung der Nagetiere (Rodentia) angehören"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44e0ab6c-c471-494d-98bf-b9b15cc19b87",
                                                "sense_id": "a9e59b13-41f3-3e8e-ae57-6df7f5bd0604",
                                                "text": "Nur eine der 25 Arten des Streifenhörnchens lebt außerhalb Nord- bzw. Zentralamerikas; der in Eurasien beheimatete Burunduk."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
