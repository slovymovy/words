                "senses": [
                    {
                        "sense_id": "f1a5ecf4-db3a-3891-92da-2fb80a2f9bf7",
                        "entry_id": "7ab4bf01-7cf6-32c1-a443-3c46534f99ff",
                        "glosses": [
                            "The quality of being slow of understanding things; stupidity."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "230fa280-ce7d-3cf5-943e-1446e12bd546",
                        "entry_id": "7ab4bf01-7cf6-32c1-a443-3c46534f99ff",
                        "glosses": [
                            "The quality of being uninteresting; boring; humorless or irksome."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "f9eae842-3b2a-4dde-9451-0191c4d27b66",
                                "sense_id": "230fa280-ce7d-3cf5-943e-1446e12bd546",
                                "text": "If to raise malicious smiles at the infirmities or misfortunes of those who have never injured us be the province of wit or Humour, Heaven grant me a double Portion of Dullness—"
                            }
                        ]
                    },
                    {
                        "sense_id": "b94769bf-51cb-3f2f-af31-15a21321f48c",
                        "entry_id": "7ab4bf01-7cf6-32c1-a443-3c46534f99ff",
                        "glosses": [
                            "Lack of interest or excitement."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a7f70f71-2bb7-392a-9ddb-1a273dbbf141",
                        "entry_id": "7ab4bf01-7cf6-32c1-a443-3c46534f99ff",
                        "glosses": [
                            "The lack of visual brilliance; want of sheen."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "5ad8e207-7d45-47e3-8180-59e2a5d5e6eb",
                                "sense_id": "a7f70f71-2bb7-392a-9ddb-1a273dbbf141",
                                "text": "dullness of autumn"
                            }
                        ]
                    },
                    {
                        "sense_id": "2d666009-b4a3-32a2-b985-e9eee4c3335a",
                        "entry_id": "7ab4bf01-7cf6-32c1-a443-3c46534f99ff",
                        "glosses": [
                            "bluntness."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f409a5a0-b913-30f7-a144-e2aa94056048",
                        "entry_id": "7ab4bf01-7cf6-32c1-a443-3c46534f99ff",
                        "glosses": [
                            "The quality of not perceiving or kenning things distinctly."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "3f2e0863-2cbb-4687-a6d8-79fb0a569c39",
                                "sense_id": "f409a5a0-b913-30f7-a144-e2aa94056048",
                                "text": "dullness of sight, or of hearing"
                            }
                        ]
                    },
                    {
                        "sense_id": "572b30c9-72f3-3661-9606-15b65cfc82f3",
                        "entry_id": "7ab4bf01-7cf6-32c1-a443-3c46534f99ff",
                        "glosses": [
                            "Drowsiness."
                        ],
                        "tags": [
                            "archaic",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "b8f2ca56-8d54-4dba-a99d-30c018943622",
                                "sense_id": "572b30c9-72f3-3661-9606-15b65cfc82f3",
                                "text": "Prospero: […]Thou art inclin'd to sleep. 'Tis a good dulness, / And give it way— I know thou canst not choose."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f7e5355-e107-43ea-aaa8-33505501ba88",
                        "source_entry_id": "7ab4bf01-7cf6-32c1-a443-3c46534f99ff",
                        "source_sense_description": "quality of being slow to understand",
                        "target_lang_word": "obtusité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obtusité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6a1b6de5-2f20-3ef2-ac9e-8c2440cab72b",
                                        "entry_id": "81b5cd45-d2d3-37e4-b662-444b4f106db0",
                                        "glosses": [
                                            "Caractéristique d’un esprit borné."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eaa4f9fb-73c2-43ef-b843-aa2221bcf884",
                                                "sense_id": "6a1b6de5-2f20-3ef2-ac9e-8c2440cab72b",
                                                "text": "D’abord à l’encontre de son père, qui symbolise toutes les valeurs agrestes qu’il a en horreur : la bassesse, la brutalité, la rusticité, l’ignorance, l’obtusité, la dévotion , le philistinisme, forcément dirigé contre lui."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d298c5c2-af17-438a-b17f-a5718b1959fe",
                        "source_entry_id": "7ab4bf01-7cf6-32c1-a443-3c46534f99ff",
                        "source_sense_description": "quality of being slow to understand",
                        "target_lang_word": "тупоумие",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "тупоумие",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e7220d51-2627-3708-a4ec-7cdd2bbe3248",
                                        "entry_id": "1be99921-abc9-3d8d-910c-cdcc467fd1c2",
                                        "glosses": [
                                            "ограниченность умственных способностей; несообразительность, невосприимчивость"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1bfe6ab-7105-4071-891b-1c36ba0fb220",
                                                "sense_id": "e7220d51-2627-3708-a4ec-7cdd2bbe3248",
                                                "text": "Эгоизм, тщеславие, тупоумие, ничтожество во всем — вот женщины, когда они показываются так, как они есть."
                                            },
                                            {
                                                "example_id": "74e55171-071d-4f17-aa68-9db956d9aae9",
                                                "sense_id": "e7220d51-2627-3708-a4ec-7cdd2bbe3248",
                                                "text": "Елпидифор молчал, но по его физиономии распространялось подозрительное выражение слишком уж откровенного, тугодумающего дурака, который уже и сам знает, что он полный осел, и даже уже и не пытается скрыть свое тупоумие, потому что смирился с ним и даже полюбил его."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7ed69edb-3e15-482f-931e-7c4f8eea74e3",
                        "source_entry_id": "7ab4bf01-7cf6-32c1-a443-3c46534f99ff",
                        "source_sense_description": "quality of being slow to understand",
                        "target_lang_word": "ту́пость",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ту́пость",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "be0b1af8-0f46-32e0-a22d-114959dc3396",
                                        "entry_id": "6a672ca1-550e-3ade-8ba8-816150d4eb91",
                                        "glosses": [
                                            "свойство по значению прилагательного тупой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f883813d-9913-4dc4-8bd2-80420923beb2",
                                                "sense_id": "be0b1af8-0f46-32e0-a22d-114959dc3396",
                                                "text": "При исследованиях расстройств аффективной сферы выделяется также «эмоциональная тупость» как расстройство с крайней слабостью эмоциональных реакций (либо полным отсутствием) и эмоциональной холодностью."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b35cc023-0c6a-3068-a194-11342afdb2d5",
                                        "entry_id": "6a672ca1-550e-3ade-8ba8-816150d4eb91",
                                        "glosses": [
                                            "перен., разг. то же, что глупость; неспособность понять, сообразить что-либо; также проявление такого свойства"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53c19168-8a14-4f85-b33c-e2fa764a6c06",
                                                "sense_id": "b35cc023-0c6a-3068-a194-11342afdb2d5",
                                                "text": "А эта комичная надзирательница доводила нас до смеха и видом своим несуразным, и неумелой суровостью, и удивительной тупостью."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
