                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "affe6e77-888e-4199-839d-3a4e67ad2534",
                        "source_entry_id": "bafe5a05-2cc2-3d08-a2af-09699e0c0336",
                        "source_sense_id": "b7ea32fa-97d9-3c08-8b93-3132284f9c5a",
                        "target_lang_word": "desk jockey",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "desk jockey",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f4347ac-9a69-3dde-a3c3-afa7f0757769",
                                        "entry_id": "14fe59c9-1bed-3bc5-a68e-f101e2b5f09c",
                                        "glosses": [
                                            "One who spends his or her time seated at a desk; especially one who is more concerned with procedure, paperwork, or administration than with its ultimate goal or practical consequence."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5117b7f3-ca43-4637-9902-173ad072b673",
                                                "sense_id": "3f4347ac-9a69-3dde-a3c3-afa7f0757769",
                                                "text": "The production manager was annoyed because some desk jockey in the main office reassigned her staff without even consulting her."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf12a3d9-3cdd-4983-bd8e-54301ab5d1b7",
                        "source_entry_id": "bafe5a05-2cc2-3d08-a2af-09699e0c0336",
                        "source_sense_id": "b7ea32fa-97d9-3c08-8b93-3132284f9c5a",
                        "target_lang_word": "paper pusher",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b700a8a0-817f-4bba-b847-c48ea41e84a3",
                        "source_entry_id": "bafe5a05-2cc2-3d08-a2af-09699e0c0336",
                        "source_sense_id": "b7ea32fa-97d9-3c08-8b93-3132284f9c5a",
                        "target_lang_word": "чинуша",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "чинуша",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7b76867d-f3d7-384c-9566-eff6ddb03dce",
                                        "entry_id": "c8ee36ec-e554-30fc-a31a-71c2b14240ea",
                                        "glosses": [
                                            "разг., презр. чиновник"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8c80a5b-cc2c-4d88-ab1c-9a5493378ea1",
                                                "sense_id": "7b76867d-f3d7-384c-9566-eff6ddb03dce",
                                                "text": "И взятки хапают, как прежние чинуши хапали, и людей стадами загоняют в тюрьмы."
                                            },
                                            {
                                                "example_id": "e0f2715a-5bd0-4291-af10-b2d3f13769bc",
                                                "sense_id": "7b76867d-f3d7-384c-9566-eff6ddb03dce",
                                                "text": "Детишкам, которые играли и шумели под его окнами, этот мелкий чинуша, покраснев как клюква, кричал: «Я вас выселю в 24 часа!»"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53388a1f-a974-429a-815a-4025508621f9",
                        "source_entry_id": "bafe5a05-2cc2-3d08-a2af-09699e0c0336",
                        "source_sense_id": "b7ea32fa-97d9-3c08-8b93-3132284f9c5a",
                        "target_lang_word": "чинодрал",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "чинодрал",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7991ed36-4079-30ce-90c9-a32dcd714dbb",
                                        "entry_id": "4bb3167d-a202-3a3c-9a74-d9693036a557",
                                        "glosses": [
                                            "разг.-сниж. презр. бюрократ, чиновник-формалист"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccc2d0c9-a58d-443e-88d4-ffe2d2085340",
                                                "sense_id": "7991ed36-4079-30ce-90c9-a32dcd714dbb",
                                                "text": "«Скотина-чинодрал!», чуть было вслух не проговорил оскорбленный и взбешенный Иволгин"
                                            },
                                            {
                                                "example_id": "31aa3092-b29c-4de7-8dca-8ac4bfc15837",
                                                "sense_id": "7991ed36-4079-30ce-90c9-a32dcd714dbb",
                                                "text": "— Разве вы педагоги, учителя? Вы чинодралы, у вас не храм науки, а управа благочиния"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
