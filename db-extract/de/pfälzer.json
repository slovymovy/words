                ],
                "senses": [
                    {
                        "sense_id": "7f87819e-9933-3bb3-8a3b-82532533f8bd",
                        "entry_id": "cb9600a5-c136-30a6-a340-ae2c4d570b3d",
                        "glosses": [
                            "aus der Pfalz stammend, zu ihr gehörend, sie betreffend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3dd9972-6e12-4a37-8c30-ba82da061b38",
                                "sense_id": "7f87819e-9933-3bb3-8a3b-82532533f8bd",
                                "text": "„Susanne Winterling strampelt die Pfälzer Weinorte mit dem Fahrrad ab - Deidesheim, Forst, Wachenheim.“"
                            },
                            {
                                "example_id": "89c14766-9c8b-4a03-a97b-58d46ff4f1ab",
                                "sense_id": "7f87819e-9933-3bb3-8a3b-82532533f8bd",
                                "text": "„Der Betrachter wird angeregt vor den Pfälzer Landschaften mit ihren weiten Blicken ins Land über Höhen und Täler, über Weinberge, Wälderund Wiesen, mit ihren großgespannten Himmeln, einen Vers zu zitieren.“"
                            },
                            {
                                "example_id": "d014ea8a-026c-4f51-a2f8-05df938bcf79",
                                "sense_id": "7f87819e-9933-3bb3-8a3b-82532533f8bd",
                                "text": "„Nach dem Krisenjahr 1770 erreichten die Pfälzer Städte ihr Ziel, den gesamten Getreidehandel in den Städten zu zentralisieren[.]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
