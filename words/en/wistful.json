{
    "word_family": [
        "wistfully",
        "wistfulness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1e45a521-ee14-374f-a8c6-84e7801b5e63",
                    "sense_definition": "Full of longing, yearning, or quiet desire, especially for something in the past.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wistful_longing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave a <w>wistful</w> smile as she looked through her old childhood photo album. ",
                            "target_lang_translations": {
                                "de": "Sie lächelte <w>wehmütig</w>, als sie ihr altes Kindheitsfotoalbum durchblätterte."
                            }
                        },
                        {
                            "text": "He had a <w>wistful</w> look on his face while talking about his hometown.",
                            "target_lang_translations": {
                                "de": "Er hatte einen <w>wehmütigen</w> Blick im Gesicht, als er über seine Heimatstadt sprach."
                            }
                        }
                    ],
                    "synonyms": [
                        "yearning"
                    ],
                    "common_phrases": [
                        "wistful smile",
                        "wistful look",
                        "wistful expression"
                    ],
                    "target_lang_definitions": {
                        "de": "Voll von Sehnsucht, Verlangen oder stillem Wunsch, besonders nach etwas aus der Vergangenheit."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "wehmütig",
                                "target_lang_sense_clarification": "von Wehmut und sanfter Trauer um Vergangenes geprägt"
                            },
                            {
                                "target_lang_word": "sehnsuchtsvoll",
                                "target_lang_sense_clarification": "voller starker Sehnsucht oder Verlangen"
                            },
                            {
                                "target_lang_word": "nostalgisch",
                                "target_lang_sense_clarification": "sentimental der Vergangenheit zugewandt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5b3f9b9-576c-3842-ad92-515ff2029a47",
                    "sense_definition": "Characterized by a sad, gentle, and pensive melancholy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wistful_longing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The quiet music put her in a <w>wistful</w> mood late in the evening.",
                            "target_lang_translations": {
                                "de": "Die ruhige Musik versetzte sie spät am Abend in eine <w>melancholische</w> Stimmung."
                            }
                        },
                        {
                            "text": "There was a <w>wistful</w> tone in his voice when he mentioned his past regrets.",
                            "target_lang_translations": {
                                "de": "In seiner Stimme lag ein <w>wehmütiger</w> Ton, als er sein Bedauern über die Vergangenheit erwähnte."
                            }
                        }
                    ],
                    "synonyms": [
                        "melancholy",
                        "pensive",
                        "plaintive"
                    ],
                    "common_phrases": [
                        "wistful mood",
                        "wistful tone"
                    ],
                    "target_lang_definitions": {
                        "de": "Gekennzeichnet durch eine traurige, sanfte und nachdenkliche Melancholie."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "melancholisch",
                                "target_lang_sense_clarification": "von sanfter Schwermut oder Nachdenklichkeit geprägt"
                            },
                            {
                                "target_lang_word": "schwermütig",
                                "target_lang_sense_clarification": "tiefer traurig oder nachdenklich gestimmt"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}