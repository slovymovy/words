                ],
                "senses": [
                    {
                        "sense_id": "effaae20-49dd-3379-b5fb-8c28093ea3e3",
                        "entry_id": "8b04afd6-324f-3a3f-aae3-2c8ec0b3187a",
                        "glosses": [
                            "ein König, der über kein großes Land verfügt, aber ein großes Heer. Zumeist im Zusammenhang mit Wikingern gebraucht."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5c61a16-0cfe-4ceb-9aaa-9ba610688509",
                                "sense_id": "effaae20-49dd-3379-b5fb-8c28093ea3e3",
                                "text": "„Trompeten und Pauken verkündeten den Seekönig Ingolf dreimal als Sieger, und darauf schritt dieser unter dem Jauchzen der Menge ernst und feierlich den Balkon hinauf […]“"
                            },
                            {
                                "example_id": "0518fe2c-e0bf-4bef-9e35-4f6ba48cd8bb",
                                "sense_id": "effaae20-49dd-3379-b5fb-8c28093ea3e3",
                                "text": "„Der wollte Jarl Eirik nichts von hören, und der Seekönig Arinbiörn sagte zuletzt, nun wolle er es nimmermehr zugeben, daß man das Eiland Chios verwüste […]“"
                            },
                            {
                                "example_id": "ac130b51-dfa6-4dd5-abdc-bfdc19a47138",
                                "sense_id": "effaae20-49dd-3379-b5fb-8c28093ea3e3",
                                "text": "„Die Göttin der Fruchtbarkeit, Seekönig und Meerjungfrau blicken ebenfalls auf die Kundschaft herab.“"
                            },
                            {
                                "example_id": "6aae03ce-9bb9-467a-b8f6-779d786dc33b",
                                "sense_id": "effaae20-49dd-3379-b5fb-8c28093ea3e3",
                                "text": "„So stehen 'der Töter des Riesensohnes' für den Gott Thor, 'der Hüter der Glocke' für den Priester und 'das Rentier des Seekönigs' für das Schiff.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
