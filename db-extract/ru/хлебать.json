                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2f80777b-f624-3306-bf89-20374453bcee",
                                        "entry_id": "e7dfeca5-3016-3ed5-84f8-ee55463861a7",
