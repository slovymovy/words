                ],
                "senses": [
                    {
                        "sense_id": "5afe16b6-4367-35cb-ac29-4e902565f437",
                        "entry_id": "7612161a-776e-3c8f-bd02-35833f859988",
                        "glosses": [
                            "Person, die eine Verwundung erlitten hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3dd94a9-dfd6-47ad-885c-18e024b0fd0b",
                                "sense_id": "5afe16b6-4367-35cb-ac29-4e902565f437",
                                "text": "Verwundete müssen möglichst schnell ärztlich versorgt werden."
                            },
                            {
                                "example_id": "20adfcb0-1984-413d-9f97-1114337bcc5b",
                                "sense_id": "5afe16b6-4367-35cb-ac29-4e902565f437",
                                "text": "„Allein an der Westfront forderte der Gaskrieg etwa 20 000 Tote und 500 000 Verwundete.“"
                            },
                            {
                                "example_id": "7a546dc2-4498-48ee-a278-9d699aa2edf1",
                                "sense_id": "5afe16b6-4367-35cb-ac29-4e902565f437",
                                "text": "„Bei ihrem eiligen Aufbruch hatten die Russen es versäumt, an die zweitausend Verwundete mitzunehmen, die in Fabrikhallen und Hinterhöfen lagen, Hinterbliebene der Schlacht von Borodino.“"
                            },
                            {
                                "example_id": "21a3fecf-ffba-4466-9cdc-87a0c9b58b65",
                                "sense_id": "5afe16b6-4367-35cb-ac29-4e902565f437",
                                "text": "„Auf der Strasse hielt ein unendlich langer Wagenzug mit Verwundeten.“"
                            },
                            {
                                "example_id": "f9c4892f-e04d-4212-8d06-619d9db767d5",
                                "sense_id": "5afe16b6-4367-35cb-ac29-4e902565f437",
                                "text": "„Die Verwundeten wurden eingeladen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
