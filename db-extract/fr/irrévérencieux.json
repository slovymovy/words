                                        "sense_id": "a10ad79d-0cca-3fb1-a686-16c9c2836126",
                                        "entry_id": "64f46792-139f-3085-a6a8-65281282ee7c",
                                        "glosses": [
                                            "Lacking respect; not having or not showing respect for or seriousness towards something that is usually treated with respect; going against conventional precepts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac00a82f-5c84-4c46-b5eb-b9a2e7b313eb",
                                                "sense_id": "a10ad79d-0cca-3fb1-a686-16c9c2836126",
                                                "text": "an irreverent new work"
                                            },
                                            {
                                                "example_id": "8e8a064b-6c69-4826-8447-655f51cc5d46",
                                                "sense_id": "a10ad79d-0cca-3fb1-a686-16c9c2836126",
                                                "text": "an irreverent examination of reviewing"
                                            },
                                            {
                                                "example_id": "56d18e2e-6c0a-411f-8c08-219ae7634664",
                                                "sense_id": "a10ad79d-0cca-3fb1-a686-16c9c2836126",
                                                "text": "Beyond the hut a clump of myalls loomed spectral and wraith-like, and round them a gang of crows cawed noisily, irreverent of the great silence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
