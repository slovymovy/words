                ],
                "senses": [
                    {
                        "sense_id": "25dbdb27-6cb1-3729-9d63-fe0dd5279094",
                        "entry_id": "bb911375-71d6-3144-b9ee-2ba4c5f8c1a6",
                        "glosses": [
                            "Berufserlaubnis für einen Arzt, Zahnarzt, Tierarzt, Psychotherapeuten oder Apotheker nach erfolgreicher Ausbildung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "597c5935-62f6-4155-993a-ab76590ee326",
                                "sense_id": "25dbdb27-6cb1-3729-9d63-fe0dd5279094",
                                "text": "„Personen die im Land Berlin die Ärztliche Prüfung bestanden haben,haben grundsätzlich Anspruch auf die Approbation.“"
                            },
                            {
                                "example_id": "213d25bf-3f4b-42fe-a317-0b3de052445f",
                                "sense_id": "25dbdb27-6cb1-3729-9d63-fe0dd5279094",
                                "text": "Seit dem Arzt Duca Lamberti wegen geleisteter Sterbehilfe die Approbation entzogen wurde, arbeitet er für die Polizei."
                            },
                            {
                                "example_id": "a296c57f-6ccd-4a74-b68e-9ad6a190d496",
                                "sense_id": "25dbdb27-6cb1-3729-9d63-fe0dd5279094",
                                "text": "Fani Iakovou konnte nicht mehr als \"Hallo\" und \"Guten Tag\" sagen, als sie im Oktober 2013 nach Deutschland reiste. Innerhalb von acht Monaten lernte sie so gut deutsch, dass sie am Goethe-Institut das B2-Diplom ablegen konnte, das sie für die Anerkennung ihrer Approbation braucht."
                            },
                            {
                                "example_id": "0f6484ef-baf7-4e81-9ef1-968d25f5e4d1",
                                "sense_id": "25dbdb27-6cb1-3729-9d63-fe0dd5279094",
                                "text": "Schweden umwirbt deutsche Ärzte: […] Die Ärzte müssen natürlich Nachweise, also beglaubigte Kopien von der Approbation, das Facharzt-Zeugnis und - je nachdem - das Examens-Zeugnis mitbringen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1790a828-f04b-3c8c-8711-90f3d0abaa41",
                        "entry_id": "bb911375-71d6-3144-b9ee-2ba4c5f8c1a6",
                        "glosses": [
                            "Zustimmung des Papstes zu einem Erlass"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4cfccb2-454e-48f3-ab6e-b36f2ad8b9b2",
                                "sense_id": "1790a828-f04b-3c8c-8711-90f3d0abaa41",
                                "text": "Die päpstliche Approbation erhebt Konzilsentscheide zu einer sicheren Glaubensregel."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "66653a0c-af73-3ca1-b409-270e45ea2553",
                        "entry_id": "bb911375-71d6-3144-b9ee-2ba4c5f8c1a6",
                        "glosses": [
                            "die Bestätigung eines Geistlichen in seinem Amt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9714cbfc-118a-478e-8bde-be432906e10b",
                                "sense_id": "66653a0c-af73-3ca1-b409-270e45ea2553",
                                "text": "„Priester, welche kein eigentliches Seelsorgeramt bekleiden, erlangen nur durch bischöfliche Approbation die Bußgerichtsbarkeit.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "c506a7c4-1a98-31d6-8d04-a5cb650f39bd",
                        "entry_id": "bb911375-71d6-3144-b9ee-2ba4c5f8c1a6",
                        "glosses": [
                            "Genehmigung von Verwaltungsvorgängen durch den Vorgesetzten"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "b153eaf6-52c1-4c39-8f2e-e425ae75522b",
                                "sense_id": "c506a7c4-1a98-31d6-8d04-a5cb650f39bd",
                                "text": "„Im Rahmen der primär erhobenen Rechtsrüge meint der Beschwerdeführer, in dem betreffenden Belange wäre der Amtsmißbrauch erst mit der erfolgten Approbation durch seinen Chef vollendet worden.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "9a3d234b-f602-3630-9ab4-e525d2fa64d8",
                        "entry_id": "bb911375-71d6-3144-b9ee-2ba4c5f8c1a6",
                        "glosses": [
                            "behördliche Zulassung eines Schulbuches"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "be3fbbf9-d43f-4437-9b96-eaa7163fe177",
                                "sense_id": "9a3d234b-f602-3630-9ab4-e525d2fa64d8",
                                "text": "„Am 15. Oktober müssen die Schulbücher dem Bundesministerium zur Approbation vorgelegt werden.“"
                            }
                        ],
                        "sense_index_json": "\"5\""
                    }
                ],
