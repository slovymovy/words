                                                "text": "Болел, но теперь поправился."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9b77b26-8258-3377-9313-10fe5554d0d5",
                                        "entry_id": "795e4c55-609c-37bf-a8c5-ac2ffb2044d9",
                                        "glosses": [
                                            "перен., разг. потолстеть, набрать вес, стать полнее"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fcda9db-9163-4623-b272-7419cffacbac",
                                                "sense_id": "d9b77b26-8258-3377-9313-10fe5554d0d5",
                                                "text": "Поправиться на два килограмма."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "673b6b33-7856-3c78-b5b1-1cea65d4a30a",
                                        "entry_id": "795e4c55-609c-37bf-a8c5-ac2ffb2044d9",
                                        "glosses": [
                                            "перен., разг. измениться к лучшему, улучшиться; исправиться и стать лучше в моральном плане; восстановить своё благосостояние (хозяйство, дела)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0fa4386-cfd2-460a-a9dc-b8842eb20ca6",
                                                "sense_id": "673b6b33-7856-3c78-b5b1-1cea65d4a30a",
                                                "text": "Дела поправились."
                                            },
                                            {
                                                "example_id": "5617509d-4ba9-4f51-8690-e6a29f580b90",
                                                "sense_id": "673b6b33-7856-3c78-b5b1-1cea65d4a30a",
                                                "text": "Здоровье поправилось."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd897140-a472-3994-a9d2-99ffae8b8858",
