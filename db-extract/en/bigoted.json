                                        "entry_id": "8446d73b-e8de-3330-823a-f026f4c7c42f",
                                        "glosses": [
                                            "übertrieben glaubenseifrig, frömmelnd, seine Frömmigkeit überzogen präsentierend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b0e5af9-839c-4cb8-81b3-f21f38dfc812",
                                                "sense_id": "f08a5137-1c7d-3a25-822b-ace6208cd86e",
                                                "text": "Manche Menschen neigen dazu, mit höherem Alter bigott zu werden."
                                            },
                                            {
                                                "example_id": "db2cfe0f-9c20-4c91-a558-f229e1a10256",
                                                "sense_id": "f08a5137-1c7d-3a25-822b-ace6208cd86e",
                                                "text": "„Auch zwang er sie, gemeinsam mit ihm eine bigotte Frömmigkeit an den Tag zu legen.“"
                                            },
                                            {
                                                "example_id": "b40d0192-d6a9-4ee9-bbc5-a8bd3b080b63",
                                                "sense_id": "f08a5137-1c7d-3a25-822b-ace6208cd86e",
                                                "text": "„Da er nicht bigott sein wollte, war er anstößig; um seine Zuhörer zum Lachen zu bringen, erzählte er die unflätigsten Zoten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "984cb743-9a6b-3bac-8c72-cb60a8831dc7",
                                        "entry_id": "8446d73b-e8de-3330-823a-f026f4c7c42f",
                                        "glosses": [
                                            "scheinheilig, heuchlerisch"
                                        ],
                                        "tags": [],
                                        "examples": [
