                    },
                    {
                        "translation_id": "693c0397-d4cc-4b33-bd6f-0072fe3718df",
                        "source_entry_id": "1498e831-94ca-3741-9591-c43f7ac0caba",
                        "source_sense_id": "09a7e47c-46cd-3ee8-ad20-6392dc942baa",
