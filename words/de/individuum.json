                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Polizei sucht nach einem verdächtigen <w>Individuum</w>, das gestern Abend am Bahnhof gesehen wurde."
