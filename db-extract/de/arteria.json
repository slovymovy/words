                "senses": [
                    {
                        "sense_id": "9208d9e6-2ad5-3452-971d-034888d2fd29",
                        "entry_id": "8ddcf4fb-598d-3e75-8ff1-6ad38469570b",
                        "glosses": [
                            "diejenige Schlagader, die das Blut vom Herzen zu den Organen oder Geweben transportiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b166e6a1-d70d-4734-8dd1-11c7f54f9ba7",
                                "sense_id": "9208d9e6-2ad5-3452-971d-034888d2fd29",
                                "text": "Die Arteriae sind diejenigen Adern, die vom Herzen wegführen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "592f54b8-1161-43a9-bfd4-ce9829aee43c",
                        "source_entry_id": "8ddcf4fb-598d-3e75-8ff1-6ad38469570b",
                        "source_sense_id": "9208d9e6-2ad5-3452-971d-034888d2fd29",
                        "source_sense_description": "Schlagader, die das Blut vom Herzen zu den Organen oder Geweben transportiert",
                        "target_lang_word": "Arterie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Arterie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d9820d0e-a487-38bf-930b-46fa463fabad",
                                        "entry_id": "3cf4e3b1-7309-3024-9478-2b278e163060",
                                        "glosses": [
                                            "Schlagader; Blutgefäß, das das Blut vom Herzen in den Körper führt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e669680-fab7-431b-b5a6-ace9fac2ed28",
                                                "sense_id": "d9820d0e-a487-38bf-930b-46fa463fabad",
                                                "text": "Die Aorta ist die größte Arterie."
                                            },
                                            {
                                                "example_id": "cd461736-b16c-4c99-b673-a08770fc0e6b",
                                                "sense_id": "d9820d0e-a487-38bf-930b-46fa463fabad",
                                                "text": "„Die anderen schmieren sich bioaktives Streichfett unnötigerweise aufs Brot - und das, obwohl neuere Studien darauf hindeuten, dass zu viele der pflanzlichen Blutfettsenker die Arterien womöglich ähnlich verkalken lassen wie das Cholesterin selbst.“"
                                            },
                                            {
                                                "example_id": "d99ef9e0-8a0a-49f0-9235-61b6fece8925",
                                                "sense_id": "d9820d0e-a487-38bf-930b-46fa463fabad",
                                                "text": "„In seinem Ungeschick verletzte er eine Arterie; das führte zu einer Blutung, die er nur mit vieler Mühe stillte, und die mir ohne das Einschreiten des Bologneser Arztes Algardi, der im Dienst des Fürstbischofs von Augsburg stand, den Tod gebracht hätte.“"
                                            },
                                            {
                                                "example_id": "3c62431b-ab0c-499c-a5f4-da313a4d83e5",
                                                "sense_id": "d9820d0e-a487-38bf-930b-46fa463fabad",
                                                "text": "„Ravic drückte die Arterie ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c3daefe-2330-4be9-9b1e-bab9af3aacef",
                        "source_entry_id": "8ddcf4fb-598d-3e75-8ff1-6ad38469570b",
                        "source_sense_id": "9208d9e6-2ad5-3452-971d-034888d2fd29",
                        "source_sense_description": "Schlagader, die das Blut vom Herzen zu den Organen oder Geweben transportiert",
                        "target_lang_word": "артерия",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "артерия",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ea820714-6488-356b-8307-74ba04f0ceee",
                                        "entry_id": "9bffc39d-4fd0-3204-91b2-c049f1b0bfad",
                                        "glosses": [
                                            "анат. кровеносный сосуд, проводящий кровь от сердца к различным органам тела"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53e72657-80ef-47e0-b7c7-59a1b9292c59",
                                                "sense_id": "ea820714-6488-356b-8307-74ba04f0ceee",
                                                "text": "Это был выстрел прямо в сердце пленнику; лигатура на главной артерии лопнула от прилива, и кровь хлынула сквозь перевязки…"
                                            },
                                            {
                                                "example_id": "afac23b7-21ec-4d62-b84c-805107d2906b",
                                                "sense_id": "ea820714-6488-356b-8307-74ba04f0ceee",
                                                "text": "Кровь фонтанами из разорванных артерий на шее ударила вверх и залила и манишку и фрак."
                                            },
                                            {
                                                "example_id": "479a70e5-923a-4e63-af75-525fd87b0f80",
                                                "sense_id": "ea820714-6488-356b-8307-74ba04f0ceee",
                                                "text": "Обычно удара в лоб кувалдой хватало, чтобы оглушить даже быка; за следующие несколько секунд опытный убойщик успевал нащупать на шее артерию и перерезать её."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0121ab4b-26f1-3920-9ff4-9c9b4ce49b1c",
                                        "entry_id": "9bffc39d-4fd0-3204-91b2-c049f1b0bfad",
                                        "glosses": [
                                            "перен., книжн. путь сообщения, имеющий важное значение для страны"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98994797-09da-4d46-9899-9a53bdb9168a",
                                                "sense_id": "0121ab4b-26f1-3920-9ff4-9c9b4ce49b1c",
                                                "text": "Главными артериями движения служат те дороги, которые ведут от провинций к столице."
                                            },
                                            {
                                                "example_id": "45e4df5b-2c24-4674-b733-b0e745aca390",
                                                "sense_id": "0121ab4b-26f1-3920-9ff4-9c9b4ce49b1c",
                                                "text": "Сабейцы установили контроль над главной торговой артерией Аравийского полуострова ― «путем благовоний»."
                                            },
                                            {
                                                "example_id": "2de04af1-f97c-449a-b3a6-7ecb392f86e8",
                                                "sense_id": "0121ab4b-26f1-3920-9ff4-9c9b4ce49b1c",
                                                "text": "Поднятые по тревоге подразделения внутренних войск, а также группы дагестанского спецназа перекрыли транспортные артерии, вынудили в конце концов боевиков оставить автобус и отпустить женщин."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
