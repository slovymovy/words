                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Profesjonalne <w>kręgle</w> wymagają dużej precyzji i odpowiedniej techniki rzutu.",
                            "target_lang_translations": {
                                "ru": "Профессиональный <w>боулинг</w> требует большой точности и правильной техники броска."
                            }
                        },
                        {
                            "text": "W naszym mieście otwarto nowoczesny klub, w którym można trenować <w>kręgle</w>.",
                            "target_lang_translations": {
                                "ru": "В нашем городе открыли современный клуб, где можно заниматься <w>боулингом</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
