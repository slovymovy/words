                "senses": [
                    {
                        "sense_id": "9aabce26-cb81-370f-b0a0-f1b6d74353ab",
                        "entry_id": "c92ec86c-3488-3730-aec4-614d1e5d1899",
                        "glosses": [
                            "Plante crucifère, (Brassica nigra), dont la graine sert à faire la moutarde."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8ed898f-4193-4122-a880-d05cf7d286d8",
                                "sense_id": "9aabce26-cb81-370f-b0a0-f1b6d74353ab",
                                "text": "Bien sûr, il n’attendait pas un miracle de cette longue feuille rugueuse couverte d’un duvet blanchâtre, mais il eut soudain une envie désespérée de chercher, dans cette prairie aux couleurs chatoyantes et aux odeurs capiteuses, les plantes médicinales dont le nom lui revenait à la mémoire : l’aconit, la belladone, l’ergot de seigle, la stramoine, la jusquiame, le colchique, la digitale, l’adonis, le sénevé, le raisin d’ours, la gentiane, le muguet, la saponaire, la prêle, la potentille, la quintefeuille, le tussilage, le millepertuis, le genévrier, la mille-feuille, l’orchidée, l’aunée, le mélilot et la myrtille."
                            },
                            {
                                "example_id": "2e154f41-ec65-4951-bddd-3f9977d75869",
                                "sense_id": "9aabce26-cb81-370f-b0a0-f1b6d74353ab",
                                "text": "Un grain de sénevé. Broyer du sénevé pour faire de la moutarde."
                            },
                            {
                                "example_id": "69a9fcbc-0553-4431-a77f-c913a012b47b",
                                "sense_id": "9aabce26-cb81-370f-b0a0-f1b6d74353ab",
                                "text": "Le sénevé noir ou moutarde noire (Sinapis nigra ou Brassica nigra) tient son nom de la couleur de ses graines."
                            }
                        ]
                    },
                    {
                        "sense_id": "27fa1415-dcc2-37f3-9553-ccf9568d6721",
                        "entry_id": "c92ec86c-3488-3730-aec4-614d1e5d1899",
                        "glosses": [
                            "Désigne aussi la moutarde des champs ou sanve, (Sinapis arvensis), voire la moutarde brune (Sinapis juncea)."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "168b9b95-bbbd-394a-9ac8-5ba0afaef338",
                        "entry_id": "c92ec86c-3488-3730-aec4-614d1e5d1899",
                        "glosses": [
                            "Autre nom de la moutarde blanche (Sinapis alba ou Brassica alba) qui est une plante fourragère et mellifère, elle sert aussi à préparer de la moutarde."
                        ],
                        "tags": [],
                        "examples": []
