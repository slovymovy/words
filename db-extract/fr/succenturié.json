                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ecd04413-6cc5-4eef-ac38-1c62419bf47a",
                                "sense_id": "5fdd0fc8-2f8a-3fc1-8120-7841fc0201fa",
                                "text": "L'estomac des oiseaux est formé par deux poches : l'estomac chimique, ventricule succenturié ou proventricule, qui sécréte du suc gastrique acide et l'estomac mécanique, le gésier."
                            },
                            {
                                "example_id": "b1aa967c-8cf5-44de-9ce3-fe9797ed215c",
                                "sense_id": "5fdd0fc8-2f8a-3fc1-8120-7841fc0201fa",
                                "text": "Le placenta succenturié présente de petits lobes placentaires accessoires complètement séparés du corps principal du placenta."
                            }
                        ]
                    }
