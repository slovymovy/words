                "senses": [
                    {
                        "sense_id": "e475830a-fc8a-350b-ac1f-d9c9feb9c27a",
                        "entry_id": "f4429438-039a-3e39-90a9-f3c344bd50b1",
                        "glosses": [
                            "seit dem Jahre 2000 eine Stadt im ungarischen Komitat Pest, die ca. 40 Kilometer nördlich von Budapest an der Donau liegt"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "141dd9d2-732c-4e0b-b94e-8b09b77aa11b",
                                "sense_id": "e475830a-fc8a-350b-ac1f-d9c9feb9c27a",
                                "text": "„Am nächsten Tag stand ein Ausflug in die Puszta nach Varqa Tanya an. Reiterprogramm, Kutschenfahrt, Pferdeschau und Zigeunermusik in der dortigen Csárda begeisterte alle. Ein Ausflug in die Donauknielandschaft mit Besichtigung der Kathedrale und Schatzkammer in Esztergom, Visegrad mit herrlichem Blick zur Burg und Ausblick auf die Donau und ein Aufenthalt in Szentendre waren die Höhepunkte des letzten Tages. Zum Abschluss bei einem Folkloreabend waren sich die Teilnehmer einig, schöne Tage in Ungarn verbracht zu haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
