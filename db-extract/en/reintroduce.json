        "fr-extract.jsonl": [
            {
                "entry_id": "dc9b6409-03df-3b1f-bdee-7400b7eb7313",
                "word": "reintroduce",
                "pos": "verb",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b027a694-df96-3b8f-8273-28133b8b00f3",
                        "entry_id": "dc9b6409-03df-3b1f-bdee-7400b7eb7313",
                        "glosses": [
                            "Présenter à nouveau (une personne ou une chose)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e1fae0f-63a6-4b66-a286-b9585fbd8e3f",
                                "sense_id": "b027a694-df96-3b8f-8273-28133b8b00f3",
                                "text": "A bill was presented to the General Assembly asking for $100,000 for a hospital for the insane. It was defeated. Shortly after its defeat, the bill was reintroduced by James C. Dibbin, a prominent legislator."
                            },
                            {
                                "example_id": "637558b8-9099-4c08-b1ee-08debee60c39",
                                "sense_id": "b027a694-df96-3b8f-8273-28133b8b00f3",
                                "text": "Next, the holiday, where they can reintroduce themselves to the spouses and children whom they have barely seen since they were elected."
                            }
                        ]
                    },
                    {
                        "sense_id": "e3ae0d0b-f3e0-3d03-a350-9361fd5957db",
                        "entry_id": "dc9b6409-03df-3b1f-bdee-7400b7eb7313",
                        "glosses": [
                            "Réintroduire (une espèce animale, par exemple)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a148d645-be94-424b-9631-82f6ede2374f",
                                "sense_id": "e3ae0d0b-f3e0-3d03-a350-9361fd5957db",
                                "text": "There are plans to reintroduce tigers, Panthera tigris, to Sariska, India … and a second population of Asiatic lions, Panthera leo persica, may soon be reintroduced to Madhya Pradesh …."
                            }
                        ]
                    },
                    {
                        "sense_id": "5d5c5f27-1bdd-3568-a741-4b4955512bb6",
                        "entry_id": "dc9b6409-03df-3b1f-bdee-7400b7eb7313",
                        "glosses": [
                            "Remettre en service."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7a69ded-2d44-4d79-a28a-049fd9834bb0",
                                "sense_id": "5d5c5f27-1bdd-3568-a741-4b4955512bb6",
                                "text": "In 2014, trams were reintroduced to the capital, at a cost of £776 million (plus interest), which was double the earmarked figure."
                            }
                        ]
                    }
                ],
