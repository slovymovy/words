                    {
                        "sense_id": "55be71d3-11d1-33cc-a532-520c031657ef",
                        "entry_id": "70f614bf-27d8-3f26-9bf4-5e7e2c2a860c",
                        "glosses": [
                            "lekarz, który kieruje oddziałem szpitala"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "014dfc9e-0ff7-45d0-b1f1-65784e8c4c47",
                                "sense_id": "55be71d3-11d1-33cc-a532-520c031657ef",
                                "text": "Są szpitale, w których ordynatorzy są zatrudnieni na podstawie umów cywilnoprawnych i oficjalnie są koordynatorami oddziałów."
                            },
                            {
                                "example_id": "5d18f668-3c52-4ea3-a86a-5de34a082bc8",
                                "sense_id": "55be71d3-11d1-33cc-a532-520c031657ef",
                                "text": "W czasie obchodu trzeba było przy setce pacjentów opowiadać ordynatorowi o swoich problemach."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
