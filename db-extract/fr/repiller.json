                "senses": [
                    {
                        "sense_id": "dc02007e-818a-3108-ae2a-80fb40fbad91",
                        "entry_id": "30e55f06-d507-3e8b-b65e-465e7c05e343",
                        "glosses": [
                            "Piller à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eeb99f20-312c-487e-a1ad-36a253a9278f",
                                "sense_id": "dc02007e-818a-3108-ae2a-80fb40fbad91",
                                "text": "Bailleul est aux trois quarts détruit la même année par les soudards d’Alexandre Farnèse ; relevé en partie par ses habitants, il est repillé et rebrûlé en 1589 ; la famine suit de près la guerre ; la ville perd par la mort ou le départ les deux tiers de ses habitants."
                            },
                            {
                                "example_id": "b554c881-dd57-491e-909e-0d45ccc60e6e",
                                "sense_id": "dc02007e-818a-3108-ae2a-80fb40fbad91",
                                "text": "Ils ne peuvent repiller la même colonie avant d'être repassés décharger à leur île de départ."
                            }
                        ]
                    }
                ],
