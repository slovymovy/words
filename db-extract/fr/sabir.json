                                "target_senses": [
                                    {
                                        "sense_id": "36f9f6dc-3b5d-352a-866e-5e91a110496f",
                                        "entry_id": "9fc476fe-fa36-3536-8ef1-dcb4c6d51b55",
                                        "glosses": [
                                            "a lingua franca"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36865112-e364-406b-a6bc-b7ac2f2c26eb",
                                                "sense_id": "36f9f6dc-3b5d-352a-866e-5e91a110496f",
                                                "text": "My Greek is not the tongue of Homer or Aeschylus but a sloppy ungrammatical sabir lacking Attic salt and tending to a saccharinity which sets my teeth on edge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2368e838-0d1f-427b-9891-1f2d0cfcf86a",
                        "source_entry_id": "4f5c6420-3c9b-30e7-bff5-92bd8a042771",
                        "source_sense_description": "Charabia.",
                        "target_lang_word": "lingua franca",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lingua franca",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a5ea287-7fc3-3a70-96b1-9e62aedc5912",
                                        "entry_id": "44c2d19a-0692-38ca-b6cf-eb50d7a7ba01",
                                        "glosses": [
                                            "A common language used by people of diverse backgrounds to communicate with one another, often a basic form of speech with simplified grammar, particularly, one that is not the first language of any of its speakers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69f4f225-b567-4783-9660-57ba41b3233e",
                                                "sense_id": "5a5ea287-7fc3-3a70-96b1-9e62aedc5912",
                                                "text": "Taking these cues, I rewrote and rewrote the proposal couching my problem in the bland, euphemistic language that I was rapidly learning is the lingua franca of the corporate world."
                                            },
                                            {
                                                "example_id": "f1a64b7c-b67f-41e9-87da-b649b0e589fd",
                                                "sense_id": "5a5ea287-7fc3-3a70-96b1-9e62aedc5912",
                                                "text": "The language used by most angara across the Heleus Cluster is Shelesh, a lingua franca that was commonly used in the early days of angaran spaceflight before fading into obscurity. New connections between angaran settlements, and constant evolution of languages since their separation, means it has now seen a revival."
                                            },
                                            {
                                                "example_id": "409e9914-555b-4882-8949-48f601c7f802",
                                                "sense_id": "5a5ea287-7fc3-3a70-96b1-9e62aedc5912",
                                                "text": "Malay is the lingua franca of several Southeast Asia countries and has been simplified by its use as a second language by non-native speakers.\nFor example, the Malay plural is formed by repeating a word twice – buku means book and buku-buku means books."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d78ad393-6f46-4d58-b739-b7693b280a51",
                        "source_entry_id": "4f5c6420-3c9b-30e7-bff5-92bd8a042771",
