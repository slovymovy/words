                "senses": [
                    {
                        "sense_id": "3116fc96-9dde-3656-84b0-fe6729387c04",
                        "entry_id": "4a92604d-92ca-37be-b56d-f1f32107f234",
                        "glosses": [
                            "durch Narren zeremoniell ausgeführte Besetzung des Rathauses"
                        ],
                        "tags": [
                            "Karneval",
                            "Fasching",
                            "Fastnacht"
                        ],
                        "examples": [
                            {
                                "example_id": "1cf64be0-4fc9-4180-82b4-48299544dce0",
                                "sense_id": "3116fc96-9dde-3656-84b0-fe6729387c04",
                                "text": "„Wenn die Karnevalisten gegen 11.30 Uhr am Rathaus eintreffen, beginnt der Rathaussturm.“"
                            },
                            {
                                "example_id": "f018d0ee-610a-40d1-959f-7022aff2492e",
                                "sense_id": "3116fc96-9dde-3656-84b0-fe6729387c04",
                                "text": "„Am Rosenmontag wagen die Tollitäten in Mönchengladbach den traditionellen Rathaussturm.“"
                            },
                            {
                                "example_id": "7fb303a5-3233-480f-9d63-b71c3911a741",
                                "sense_id": "3116fc96-9dde-3656-84b0-fe6729387c04",
                                "text": "„Der traditionelle Rathaussturm soll für alle jecken Wermelskirchener ein bunter Altweibertag werden, um schon morgens in der Innenstadt gemeinsam Karneval zu feiern.“"
                            },
                            {
                                "example_id": "54229631-708a-45c8-a49a-60eaebd45d30",
                                "sense_id": "3116fc96-9dde-3656-84b0-fe6729387c04",
                                "text": "„Närrinnen und Narren vom Carneval Club Lichtenberg e.V. (CCL) organisieren den berlinweit einzigen Rathaussturm.“"
                            },
                            {
                                "example_id": "cbf40660-ac43-41df-8204-c250a9382eb1",
                                "sense_id": "3116fc96-9dde-3656-84b0-fe6729387c04",
                                "text": "„Staufens Schelmenzunft hat sich beim Rathaussturm mal wieder selbst übertroffen, den Bürgermeister mit der Gondel vom Hof gejagt und für ein volles Städtli gesorgt“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
