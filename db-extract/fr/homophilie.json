                                        "sense_id": "3b1df65c-c693-3641-8889-6213aa81c1b6",
                                        "entry_id": "4febaacf-7e5e-38e3-8568-68904df7bdf0",
                                        "glosses": [
                                            "The tendency of individuals to associate with others of the same kind."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef306ab8-3ada-48d1-91af-df5ab9334d75",
                                                "sense_id": "3b1df65c-c693-3641-8889-6213aa81c1b6",
                                                "text": "In this research we explore whether homophily as an organizing principle affects the performance of immigrant entrepreneurs in Germany."
                                            },
                                            {
                                                "example_id": "f89c14c8-1002-4f37-94e8-d99d87a7757a",
                                                "sense_id": "3b1df65c-c693-3641-8889-6213aa81c1b6",
                                                "text": "Homophily is the tendency for there to be higher rates of contact between similar people than between dissimilar people. It is the social process reflected in that old bit of folk wisdom: “Birds of a feather flock together.”"
                                            }
                                        ]
                                    }
                                ]
                            }
