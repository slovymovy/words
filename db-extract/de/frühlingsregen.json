                "senses": [
                    {
                        "sense_id": "636b8c56-e8f1-3bf6-9d14-d4e32a2b7661",
                        "entry_id": "394073eb-339a-3d1e-a74f-3a1ee7f80519",
                        "glosses": [
                            "Regen in der Jahreszeit Frühling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93860ea9-1f86-47a1-b79e-4bb8f7e94ab8",
                                "sense_id": "636b8c56-e8f1-3bf6-9d14-d4e32a2b7661",
                                "text": "„Bei ihrer Expedition im Mai 2019 hatte Frühlingsregen den Waldboden in einen Sumpf verwandelt.“"
                            },
                            {
                                "example_id": "cebf6cda-afe6-497d-a6f9-1d8f9aba94e0",
                                "sense_id": "636b8c56-e8f1-3bf6-9d14-d4e32a2b7661",
                                "text": "„Mit Gukurahundi wird der Frühlingsregen bezeichnet, der die Streu vom Vorjahr beseitigt.“"
                            },
                            {
                                "example_id": "305a0263-a086-4fb4-9967-30586bff6d6f",
                                "sense_id": "636b8c56-e8f1-3bf6-9d14-d4e32a2b7661",
                                "text": "„Sintflutartiger Frühlingsregen ergoss sich über die Stadt.“"
                            },
                            {
                                "example_id": "b9e4d784-e227-4926-9d65-875d0521a00a",
                                "sense_id": "636b8c56-e8f1-3bf6-9d14-d4e32a2b7661",
                                "text": "„Hätten wir wasserdichte Regenmäntel gehabt, wäre es ganz angenehm gewesen, in diesem Frühlingsregen zu fahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
