                                        "entry_id": "fe37eb4e-8302-33dd-a68f-bd961b73d294",
                                        "glosses": [
                                            "Discipline académique ayant pour objet le social : anthropologie, démographie, économie, ethnologie, géographie, histoire, sociologie, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5268f458-410a-490e-abcf-2577d2e6a8cd",
                                                "sense_id": "2ac87d24-aa35-3e37-8438-b7a2b546b3e5",
                                                "text": "L’épistémologue Ernest Gellner s’est attaché à montrer la faiblesse des arguments visant à exclure les sciences sociales du champ scientifique."
                                            },
                                            {
                                                "example_id": "4d78e436-b312-489a-a845-4c9d2489a106",
                                                "sense_id": "2ac87d24-aa35-3e37-8438-b7a2b546b3e5",
                                                "text": "L’EHESS (École des hautes études en sciences sociales) a pour mission l’enseignement supérieur et la recherche en sciences sociales."
                                            }
