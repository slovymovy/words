                                                "sense_id": "ec05a6cf-7c78-3b26-9587-ad8d49707cd8",
                                                "text": "„Am 14. Juli 1982 stellte ein Monteur […] in der Wohnung top.Nr. 7 der Stiege 2 des genannten Hauses fest, daß die Gasinnenleitungen dieser Wohnung undicht sind.“"
                                            },
                                            {
                                                "example_id": "429c03f0-223e-46f0-ac5a-e982da685b98",
                                                "sense_id": "ec05a6cf-7c78-3b26-9587-ad8d49707cd8",
                                                "text": "„An der Bootshalle mussten durch eine Dachdeckerfirma die undichten Stellen im Dach instand gesetzt werden.“"
                                            },
                                            {
                                                "example_id": "6c775d8c-2087-4f21-96af-cc42342768ed",
                                                "sense_id": "ec05a6cf-7c78-3b26-9587-ad8d49707cd8",
                                                "text": "„»Wenn eine Gas-Pipeline undicht ist, tritt meistens Methan aus.«“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
