                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "bc7a7005-636c-4b13-afdb-be1d027c672b",
                        "entry_id": "a336c24a-ddec-34b3-8959-cd9d313f0a1b",
                        "tags": [
                            "plural"
                        ],
                        "form": "lipsticks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4fb1176c-764a-3813-b9c0-ecd63750aaa7",
                        "entry_id": "a336c24a-ddec-34b3-8959-cd9d313f0a1b",
                        "glosses": [
                            "Lesbienne d'apparence féminine."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "a21b5aca-ac34-402b-8d36-6e7e06df3b03",
                                "sense_id": "4fb1176c-764a-3813-b9c0-ecd63750aaa7",
                                "text": "La lipstick, associée souvent à la \"lesbienne chic\" des magazines de mode, ne doit pourtant pas être confondue avec la fem. La fem est la compagne de la butch, tandis que la lipstick peut très bien s’acoquiner avec une de ses consœurs lipsticks."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ce68dac0-0eab-44a7-89c6-0caf4d888801",
                        "source_entry_id": "a336c24a-ddec-34b3-8959-cd9d313f0a1b",
                        "source_sense_id": "4fb1176c-764a-3813-b9c0-ecd63750aaa7",
                        "target_lang_word": "Lippenstiftlesbe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lippenstiftlesbe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "324f1791-461d-32f9-a963-37c61c594ff1",
                                        "entry_id": "4e5c7c25-631e-3cef-a974-9a05d0f632d6",
                                        "glosses": [
                                            "Lesbe mit sehr betont – bisweilen glamourös – femininem Stil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64aceb60-a6ce-4936-89ba-e4ae4666593b",
                                                "sense_id": "324f1791-461d-32f9-a963-37c61c594ff1",
                                                "text": "„Maria ist eine Leckschwester, eine Lippenstiftlesbe, eine Fotzenleckerin, eine Büchsenmasseuse. Findet jedenfalls Manfred, und Manfred ist ein richtiger Mann.“"
                                            },
                                            {
                                                "example_id": "9f076ec9-5ed8-443b-bf5b-c4b65b1b86c8",
                                                "sense_id": "324f1791-461d-32f9-a963-37c61c594ff1",
                                                "text": "„Neben der herben Lippenstiftlesbe wirkt sie wie die personifizierte Portion Müsli.“"
                                            },
                                            {
                                                "example_id": "9bc6a00f-57eb-4199-a26c-f76fd262c1a7",
                                                "sense_id": "324f1791-461d-32f9-a963-37c61c594ff1",
                                                "text": "„Unten vor dem Eingang stand eine elegant gekleidete Brünette, die ganz danach aussah, als könnte sie eine Freundin von Serra sein. Die Lippenstiftlesben waren auf dem Vormarsch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a380ba08-bd90-49a4-bede-f66095ac160d",
                        "source_entry_id": "a336c24a-ddec-34b3-8959-cd9d313f0a1b",
                        "source_sense_id": "4fb1176c-764a-3813-b9c0-ecd63750aaa7",
                        "target_lang_word": "Lipsticklesbe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lipsticklesbe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4d1b2278-c9bf-3853-bd07-fe8d19f9b756",
                                        "entry_id": "8657a6d7-319a-3c33-9b3d-e8a715faee68",
                                        "glosses": [
                                            "Lesbe mit sehr betont – bisweilen glamourös – femininem Stil"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2786df0-e6b3-450d-b9cc-fd21841c0288",
                                                "sense_id": "4d1b2278-c9bf-3853-bd07-fe8d19f9b756",
                                                "text": "„Außer sie bekennt sich trotzig und offen dazu, eine Lipsticklesbe oder Femme zu sein. Dann darf sie nicht nur lange Haare haben, sondern muss sich auch schminken und Röcke tragen. Und nicht zu vergessen: Stöckelschuhe!“"
                                            },
                                            {
                                                "example_id": "642604ee-9391-443e-ba7b-4bd5f52c6700",
                                                "sense_id": "4d1b2278-c9bf-3853-bd07-fe8d19f9b756",
                                                "text": "„Die Genres Tomboy (Butch) und Lipsticklesbe (Femme) sind so stark verkürzt im Mainstream angekommen.“"
                                            },
                                            {
                                                "example_id": "c7fb40a4-0d1a-405d-98b1-a5a1cf68c5bf",
                                                "sense_id": "4d1b2278-c9bf-3853-bd07-fe8d19f9b756",
                                                "text": "„Die Lipsticklesbe weiss es gekonnt, ihre Kleider, Accessoires, Schuhe und das Make-Up perfekt aufeinander abzustimmen.“"
                                            },
                                            {
                                                "example_id": "ecfb7a04-0cde-41e6-b0bd-8fbde81bd793",
                                                "sense_id": "4d1b2278-c9bf-3853-bd07-fe8d19f9b756",
                                                "text": "„Das kennt die Lipsticklesbe und auch die Femme wohl zur Genüge […]“"
                                            },
                                            {
                                                "example_id": "cbd644e1-e9e4-4875-97b4-d9bc8cdac9e7",
                                                "sense_id": "4d1b2278-c9bf-3853-bd07-fe8d19f9b756",
                                                "text": "„Allerdings ist die Vielfalt an gezeigten Lesbentypen – vor allem den damals in Deutschland als Phänomen eher unbekannten ‚Lipsticklesben‘ sowie den vielen femininen und langhaarigen Frauen – bemerkenswert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6643b80e-db10-44c6-9ae5-bf1d49ed1b01",
                        "source_entry_id": "a336c24a-ddec-34b3-8959-cd9d313f0a1b",
                        "source_sense_id": "4fb1176c-764a-3813-b9c0-ecd63750aaa7",
                        "target_lang_word": "lipstick",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lipstick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1823a806-6b27-3236-bcfa-617d05055ff1",
                                        "entry_id": "0db0337c-a5ed-3277-9037-5975abddfe6b",
                                        "glosses": [
                                            "Makeup for the lips."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4eb79f71-9990-45cb-bbfb-169ee8ed5b18",
                                                "sense_id": "1823a806-6b27-3236-bcfa-617d05055ff1",
                                                "text": "Are you wearing any lipstick today?"
                                            },
                                            {
                                                "example_id": "dddbe88c-9dee-48e5-963c-6628abac8ff4",
                                                "sense_id": "1823a806-6b27-3236-bcfa-617d05055ff1",
                                                "text": "In fact, I just saw the movie Shirley Valentine (for the umpteenth time!), and couldn't even look at the adult Marjorie Majors without seeing Patsy and her boofed up hair and red lipstick and long cigarette holder."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5338ea4-1828-3530-8dbe-f8a016e71ed9",
                                        "entry_id": "0db0337c-a5ed-3277-9037-5975abddfe6b",
                                        "glosses": [
                                            "A stick of this makeup."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "902ede44-265d-4494-86b7-497cbe6b18b1",
                                                "sense_id": "b5338ea4-1828-3530-8dbe-f8a016e71ed9",
                                                "text": "I'd like three lipsticks in this shade."
                                            },
                                            {
                                                "example_id": "7db86f9c-4a71-40de-8b7d-ffa01e55bbec",
                                                "sense_id": "b5338ea4-1828-3530-8dbe-f8a016e71ed9",
                                                "text": "She darkens up her eyebrows with it and then runs a tube of pink lipstick over her mouth. She immediately wipes it off with the palm of her hand. She should have black lipstick. A true ninja woman would wear black lipstick."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e5d391b-e6d5-3286-a216-15772a9d3033",
                                        "entry_id": "0db0337c-a5ed-3277-9037-5975abddfe6b",
                                        "glosses": [
                                            "A dog's penis."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "750bbef4-232a-4328-bad7-8e4852065f8b",
                                                "sense_id": "2e5d391b-e6d5-3286-a216-15772a9d3033",
                                                "text": "“So she storms off, yelling at me, ‘Tell your dog to put his lipstick back in its case!’ and that dog and I just stared after them. Both of us were totally smitten.”"
                                            },
                                            {
                                                "example_id": "ce626c06-bf5d-4efe-99af-9e5a6d0855ab",
                                                "sense_id": "2e5d391b-e6d5-3286-a216-15772a9d3033",
                                                "text": "I looked over at our new house-wolf, hoping for a connection, but it was too soon. I felt nothing but resentment. What I saw, however, was something I would have to look away from regularly. He had his lipstick out."
                                            },
                                            {
                                                "example_id": "03a555e8-751c-463b-8026-00cbf2102876",
                                                "sense_id": "2e5d391b-e6d5-3286-a216-15772a9d3033",
                                                "text": "“Speaking of loyalty…” I give Shit a nasty side-eye but he only pants at me, eyes slightly glazed. That’s when I realize his lipstick is all the way out.\n “Hey, stop turning my dog on,” I tell Mac."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18419f15-eea2-3c31-8f0f-5fc9f8df8f53",
                                        "entry_id": "0db0337c-a5ed-3277-9037-5975abddfe6b",
                                        "glosses": [
                                            "Ellipsis of lipstick lesbian."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "slang",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe2f3beb-f6f4-49aa-a2b4-f805848819a0",
                                                "sense_id": "18419f15-eea2-3c31-8f0f-5fc9f8df8f53",
                                                "text": "Joya was what they called a Lipstick Lesbian. Without wandering too far through the minefield that gay culture can be for the moderately indoctrinated, let stand the observation that this thriving local fauna (The Lipsticks, that is) struck some observers as representing a step up (or forward) in the social evolution of female homosexuality."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lipstick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "13df0c6b-5357-3863-9cab-918326863b88",
                                        "entry_id": "1ad1a139-dc79-3ccb-a035-43c9d2065346",
                                        "glosses": [
                                            "To apply lipstick to; to paint with lipstick."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6073afc-23e6-4d05-ab8c-050dc0861651",
                                                "sense_id": "13df0c6b-5357-3863-9cab-918326863b88",
                                                "text": "She had even white teeth and a mouth that needed no lipsticking."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ebc25f9e-e97a-4382-ab1f-0762726d98fb",
                        "source_entry_id": "a336c24a-ddec-34b3-8959-cd9d313f0a1b",
                        "source_sense_id": "4fb1176c-764a-3813-b9c0-ecd63750aaa7",
                        "target_lang_word": "lipstick lesbian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lipstick lesbian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ae3b2e6-7e9e-3460-a97a-2652742d558f",
                                        "entry_id": "9d056e82-9a26-37ad-95a3-ab5323f0d750",
                                        "glosses": [
                                            "A lesbian who has glamorously feminine characteristics, as opposed to a butch lesbian."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3109327b-e29e-4241-990d-cd6babdae8c9",
                                                "sense_id": "9ae3b2e6-7e9e-3460-a97a-2652742d558f",
                                                "text": "Mona dashed to the window and peeped down at an elegantly dressed brunette waiting in the entrance alcove. She certainly looked like a friend of Serra's. The lipstick lesbians were everywhere."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
