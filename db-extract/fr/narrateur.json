        "fr-extract.jsonl": [
            {
                "entry_id": "3aeeb95f-ce55-3a18-b429-a530f7c2988d",
                "word": "narrateur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cf0073b8-8d79-40fc-8b28-4580e5cfdf2a",
                        "entry_id": "3aeeb95f-ce55-3a18-b429-a530f7c2988d",
                        "tags": [
                            "plural"
                        ],
                        "form": "narrateurs"
                    },
                    {
                        "form_id": "ee1e379d-e04f-4a13-8d8a-2e941a43e7f6",
                        "entry_id": "3aeeb95f-ce55-3a18-b429-a530f7c2988d",
                        "tags": [
                            "feminine"
                        ],
                        "form": "narratrice"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cfc161be-cd61-3b86-a6f2-4677a8a8a893",
                        "entry_id": "3aeeb95f-ce55-3a18-b429-a530f7c2988d",
                        "glosses": [
                            "Personne qui narre, qui raconte quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72591428-7040-4729-947a-6aedaa0755f2",
                                "sense_id": "cfc161be-cd61-3b86-a6f2-4677a8a8a893",
                                "text": "Entre ces deux romans, Maupassant se « déflaubertise » pour tenter le néologisme, se libère des dogmes énoncés par le maître sur l’impersonnalité du narrateur et sur la technique de l’objectivité."
                            },
                            {
                                "example_id": "e98b5703-5f48-486e-b5be-39e4293a2bc3",
                                "sense_id": "cfc161be-cd61-3b86-a6f2-4677a8a8a893",
                                "text": "… ; mais, comme à chaque fois il était revenu prendre sa place, le narrateur, momentanément interrompu, n’en avait pas moins continué son récit…"
                            }
                        ]
                    },
                    {
                        "sense_id": "8d1de2bd-f23c-3dea-8047-de78dab0126c",
                        "entry_id": "3aeeb95f-ce55-3a18-b429-a530f7c2988d",
                        "glosses": [
                            "Dans une œuvre de fiction, personnage qui raconte l’histoire."
                        ],
                        "tags": [],
                        "note": "L’habitude est de mettre une majuscule dans les commentaires philologiques pour bien indiquer qu’il s'agit d’un personnage",
                        "examples": [
                            {
                                "example_id": "be6dddd3-ed8f-41b1-9264-21afb986235d",
                                "sense_id": "8d1de2bd-f23c-3dea-8047-de78dab0126c",
                                "text": "Certes, la « vraie vie », comme l’exprime le Narrateur d’À la recherche du temps perdu, « habite à chaque instant chez tous les hommes aussi bien que chez l’artiste ». Or, seul l’artiste parvient à la vivre « pleinement », c’est-à-dire à en exploiter artistiquement la matière, sans se contenter de la jouissance immédiate et stérile."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7658f585-12e4-406f-a2b4-0dab5485e8ca",
                        "source_entry_id": "3aeeb95f-ce55-3a18-b429-a530f7c2988d",
                        "target_lang_word": "Erzähler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erzähler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "01c38f53-932f-3951-9f67-7ded7dbcd518",
                                        "entry_id": "79527081-2f2d-36a0-8a42-badbfb5dd801",
                                        "glosses": [
                                            "Person, die etwas erzählt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4db6366-5138-4f6b-a03e-44c13855dd79",
                                                "sense_id": "01c38f53-932f-3951-9f67-7ded7dbcd518",
                                                "text": "„Er glänzte bei geselligen Anlässen gerne mit haarsträubenden Anekdoten und hatte schon bald den Ruf weg, ein vorzüglicher Erzähler und großartiger Spaßvogel zu sein.“"
                                            },
                                            {
                                                "example_id": "a6a80e7c-7b0e-4fbb-9ed0-d5267a658d74",
                                                "sense_id": "01c38f53-932f-3951-9f67-7ded7dbcd518",
                                                "text": "„Kein Wort wird in Benin zu dieser Zeit niedergeschrieben, alles mündlich aufbewahrt, fortgetragen von Erzähler zu Erzähler, umgeformt über Generationen.“"
                                            },
                                            {
                                                "example_id": "8aa0abd4-9453-462f-a272-714be16b0692",
                                                "sense_id": "01c38f53-932f-3951-9f67-7ded7dbcd518",
                                                "text": "„Und dann wandte er sich wieder dem Erzähler zu und lachte abermals.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dd353a1a-01b3-31b0-92a6-5501711fafc3",
                                        "entry_id": "79527081-2f2d-36a0-8a42-badbfb5dd801",
                                        "glosses": [
                                            "Verfasser einer Erzählung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3993957c-5483-434c-8ee1-17f99e2d5496",
                                                "sense_id": "dd353a1a-01b3-31b0-92a6-5501711fafc3",
                                                "text": "„Der sprachgewandte Erzähler aus langobardischem Dienstadel wurde etwa 160 Jahre nach diesem Ereignis geboren - um 725, wahrscheinlich in Forum Iulii; jedenfalls wuchs er hier auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c16ecb70-aa53-3581-8f5b-b234980df71d",
                                        "entry_id": "79527081-2f2d-36a0-8a42-badbfb5dd801",
                                        "glosses": [
                                            "abstrakte Instanz in einem epischen Werk, aus deren Sichtweise erzählt wird"
                                        ],
                                        "tags": [
                                            "Literaturwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92a8a2b5-15e0-4011-b488-d06c25383b14",
                                                "sense_id": "c16ecb70-aa53-3581-8f5b-b234980df71d",
                                                "text": "„Ich machte mich zum Erzähler und erzählte die Geschichte meiner Großmutter auch aus eigenem Recht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af294d78-085e-4425-9e65-9de236259fcc",
                        "source_entry_id": "3aeeb95f-ce55-3a18-b429-a530f7c2988d",
                        "target_lang_word": "Erzählerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
