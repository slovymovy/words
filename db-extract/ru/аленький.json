                            "short-form"
                        ],
                        "form": "*"
                    },
                    {
                        "form_id": "251ff9e4-c47b-406d-ba34-9f52e937abe9",
                        "entry_id": "2bb45cbe-ff74-3590-8853-a1470085c9e1",
                        "tags": [
                            "plural",
                            "short-form"
                        ],
                        "form": "а́леньки"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0f9889b6-c0e2-37c8-91b4-2bd429fd7608",
                        "entry_id": "2bb45cbe-ff74-3590-8853-a1470085c9e1",
                        "glosses": [
                            "разг. ласк. к алый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "416154c4-be95-42ca-af7e-0b9a0216113c",
                                "sense_id": "0f9889b6-c0e2-37c8-91b4-2bd429fd7608",
                                "text": "― Да тут у нас, маменька, и сыро, и тесно, и темно, а там, наверху, аленькие цветочки цветут, пёстренькие птички поют, ветерочки тёплые дуют и светит ясное солнышко!"
                            },
                            {
                                "example_id": "92c07a8d-65c4-4b0c-9d11-3bc1aa8797c1",
                                "sense_id": "0f9889b6-c0e2-37c8-91b4-2bd429fd7608",
                                "text": "Светленькие волосики, в маленькие локончики барашком взбитые, губки пухленькие, аленькие, ножки ― прелесть!.."
                            },
                            {
                                "example_id": "70590188-6b13-4d5e-a851-34b6d438800d",
                                "sense_id": "0f9889b6-c0e2-37c8-91b4-2bd429fd7608",
                                "text": "Эх, мороз-морозец, аленькие щёчки!.."
                            }
                        ]
                    },
                    {
                        "sense_id": "fc70f51f-c2d8-3749-a1d9-717bc8c4afd5",
                        "entry_id": "2bb45cbe-ff74-3590-8853-a1470085c9e1",
                        "glosses": [
                            "разг. усилит. к алый"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1815533f-4478-453c-babe-fb8ec32a8fa1",
                                "sense_id": "fc70f51f-c2d8-3749-a1d9-717bc8c4afd5",
                                "text": "Граф Лорис-Меликов, даже в мелочах желавший щеголять популярностью, избрал своим кабинетом грязненький и аленький кабинет вице-директора департамента общих дел, у двери которого величественными аргусами стояли чуть ли не полдюжины курьеров и чиновников."
                            },
                            {
                                "example_id": "1b75491b-c3b3-429a-9291-89fd7ddab4af",
                                "sense_id": "fc70f51f-c2d8-3749-a1d9-717bc8c4afd5",
                                "text": "Яблочки золотенькие! // Яблочки аленькие, // Наливные, сахарные!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "37c799b1-d69e-4e94-aa2b-b62d234c42b5",
                        "source_entry_id": "2bb45cbe-ff74-3590-8853-a1470085c9e1",
                        "target_lang_word": "vermeil",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vermeil",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2182761c-718e-3609-9501-090ca16742bf",
                                        "entry_id": "a81dbbcd-ea06-3f80-916c-90ce7690ba64",
                                        "glosses": [
                                            "D’une couleur rouge vif plus foncé que l’incarnat. #FF0921"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94eaa4e9-4ce7-4b55-816a-69e830e8fb4b",
                                                "sense_id": "2182761c-718e-3609-9501-090ca16742bf",
                                                "text": "Buvez donc, dit la jeune fille en lui versant un verre de vin vermeil comme du sang."
                                            },
                                            {
                                                "example_id": "c5559302-0c4d-4b09-b8b1-2fefc98e38ee",
                                                "sense_id": "2182761c-718e-3609-9501-090ca16742bf",
                                                "text": "Elle revient du cabinet de toilette, […], une brosse à dents à la main, la bouche toute mouillée et vermeille, les cheveux épars."
                                            },
                                            {
                                                "example_id": "d46876b5-1595-44c5-bbac-fd314a0eb990",
                                                "sense_id": "2182761c-718e-3609-9501-090ca16742bf",
                                                "text": "Zariffa et ses compagnes dépouillaient les orangers de leurs fruits vermeils, que les hommes alignaient dans des caissettes de bois."
                                            },
                                            {
                                                "example_id": "0b873b9b-2593-41f0-88f5-198fa623a242",
                                                "sense_id": "2182761c-718e-3609-9501-090ca16742bf",
                                                "text": "Les joues vermeilles, les yeux qui brillent\nChavirés par de doux émois\nLe vin réjouit le cœur des filles\nEt des garçons, ça va de soi."
                                            },
                                            {
                                                "example_id": "eb3126b1-e8d4-4962-b401-fe0b78dab572",
                                                "sense_id": "2182761c-718e-3609-9501-090ca16742bf",
                                                "text": "Elle avait un teint d’un blanc de coton, une mine très intelligente, des lèvres vermeilles, des cheveux très abondants et d’un noir luisant. Mais, ses membres étaient mous et elle était incapable de se déplacer."
                                            },
                                            {
                                                "example_id": "691198af-c852-4277-ad2b-12e5853d242c",
                                                "sense_id": "2182761c-718e-3609-9501-090ca16742bf",
                                                "text": "Petit-Pierre paraissait plus avisé que ses frères ; mais autant ceux-ci étaient gros, joufflus et vermeils, autant il avait l’air maigre, chétif et pâlot."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vermeil",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bb8d83e3-874a-300e-a244-b785385e0f6d",
                                        "entry_id": "b8d75f11-ad01-3e6a-bc38-d67913abbd44",
                                        "glosses": [
                                            "Argent doré dont la dorure tire sur le rouge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6345ce6-cfab-400a-8ff8-a4ba9ef59ca2",
                                                "sense_id": "bb8d83e3-874a-300e-a244-b785385e0f6d",
                                                "text": "À l’aide d’un de ces instruments, il ouvrit le tabernacle, en tirant d’abord le saint-ciboire, […], puis un ostensoir massif, […], puis enfin deux burettes de vermeil."
                                            },
                                            {
                                                "example_id": "46ad08c3-122a-47ca-9f18-da152e046316",
                                                "sense_id": "bb8d83e3-874a-300e-a244-b785385e0f6d",
                                                "text": "Gillonne obéit et rentra, tenant d’une main la cassette, et de l’autre une aiguière de vermeil et du linge de fine toile de Hollande."
                                            },
                                            {
                                                "example_id": "6988f158-a14d-4163-9612-2882ca838db6",
                                                "sense_id": "bb8d83e3-874a-300e-a244-b785385e0f6d",
                                                "text": "Au bout d’un moment il revint, lui tendant une petite cuiller de vermeil à demi dépouillé par le temps, et dont le manche se terminait par le lys de Florence, au calice émaillé de rouge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73cc3cfc-8ba1-4b24-aa6d-396a9cdd60be",
                        "source_entry_id": "2bb45cbe-ff74-3590-8853-a1470085c9e1",
                        "target_lang_word": "écarlate",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "écarlate",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b0736f98-831a-3073-be1c-b85601cbdcb9",
                                        "entry_id": "5d99d6c7-b6a2-3a92-b6be-316ae8cd0069",
                                        "glosses": [
                                            "Colorant de couleur rouge vif, tiré du kermès, l'insecte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4eff2887-4145-4faf-8edc-19d03ee2ff3e",
                                                "sense_id": "b0736f98-831a-3073-be1c-b85601cbdcb9",
                                                "text": "Je vis un jour plusieurs magistrats nommés lexiarques, qui marchoient dans les rues, tenant une corde teinte d’écarlate, tendue d’une maison à l’autre. Ils poussaient le peuple devant eux, pour l’obliger de se rendre à l’assemblée. Si la corde marquoit de rouge quelque traîneur, il étoit condamné à l’amende."
                                            },
                                            {
                                                "example_id": "31dcd7eb-558b-418c-afd2-ecbf7af9c41e",
                                                "sense_id": "b0736f98-831a-3073-be1c-b85601cbdcb9",
                                                "text": "À Arles, l’archevêque, qui avait le monopole de l’exploitation de la graine d’écarlate, avec laquelle on fabriquait la teinture rouge, ne traitait, pour la vente de ses récoltes, qu’avec les juifs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0268494b-3822-3c45-96bd-f86ba0d1e317",
                                        "entry_id": "5d99d6c7-b6a2-3a92-b6be-316ae8cd0069",
                                        "glosses": [
                                            "Étoffe de cette couleur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f16ca79c-530a-426d-8d9c-61aabe22b9f8",
                                                "sense_id": "0268494b-3822-3c45-96bd-f86ba0d1e317",
                                                "text": "Manteau d’écarlate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f27f311b-a23f-3023-81f6-8ada2cf6fe67",
                                        "entry_id": "5d99d6c7-b6a2-3a92-b6be-316ae8cd0069",
                                        "glosses": [
                                            "Couleur correspondante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de0bf6e7-78fd-489d-844a-a969ea4b90ae",
                                                "sense_id": "f27f311b-a23f-3023-81f6-8ada2cf6fe67",
                                                "text": "Le rousset doré. Ch. D’abord d’un beau jonquille mêlé de pourpre; ensuite brouillé d’un rouge indécis entre le pourpre et l’écarlate et d’un jaune jonquille plus ou moins foncé; […]."
                                            },
                                            {
                                                "example_id": "e17d5fba-947b-4db2-a31d-24eb6e1b2720",
                                                "sense_id": "f27f311b-a23f-3023-81f6-8ada2cf6fe67",
                                                "text": "Écarlate ! Quel beau mot ! Il éclabousse les lèvres et les dents."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "écarlate",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "23507b86-ad6f-3f81-a690-688014264a35",
                                        "entry_id": "6a9b5244-b114-3799-800d-df32edd333a8",
                                        "glosses": [
                                            "De la couleur du colorant du même nom, rouge vif. #ED0000"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd5cbdf1-7e75-4418-bd73-40f568ebc4ea",
                                                "sense_id": "23507b86-ad6f-3f81-a690-688014264a35",
                                                "text": "Quatorze colonnes de bois, hautes de vingt-trois pieds, tendaient au-dessus de la salle un ciel d’étoffe écarlate."
                                            },
                                            {
                                                "example_id": "47827383-6389-4ce3-a99b-48903e39368b",
                                                "sense_id": "23507b86-ad6f-3f81-a690-688014264a35",
                                                "text": "On patinait autour de lui. Des enfants, le col entouré de cache-nez écarlates, blancs, verts, bleus, glissaient et tournoyaient."
                                            },
                                            {
                                                "example_id": "8d36cb6e-38cf-4e3f-b072-cf80c46668e2",
                                                "sense_id": "23507b86-ad6f-3f81-a690-688014264a35",
                                                "text": "Un soir, à l’insu du brigadier, sa fille est entrée chez l’instituteur, le sourire aux yeux, les lèvres plus rouges que ces tablettes de sucre écarlate — des coquelicots — qu’on suce contre les enrouements; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "328fea89-4ae4-3e28-aaf7-f97ac952f339",
                                        "entry_id": "6a9b5244-b114-3799-800d-df32edd333a8",
                                        "glosses": [
                                            "Qui rougit par timidité ou par honte."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb802e18-b521-4a79-ba32-9d93c78ad5c1",
                                                "sense_id": "328fea89-4ae4-3e28-aaf7-f97ac952f339",
                                                "text": "Elle en devint tout écarlate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
