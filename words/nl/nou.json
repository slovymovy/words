                        "ru": [
                            {
                                "target_lang_word": "ну",
                                "target_lang_sense_clarification": "протяжное, выражающее раздумье"
                            },
                            {
                                "target_lang_word": "гм",
                                "target_lang_sense_clarification": "междометие сомнения"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "beh",
                                "target_lang_sense_clarification": "esprime esitazione o incertezza"
                            },
                            {
                                "target_lang_word": "mah",
                                "target_lang_sense_clarification": "esprime forte dubbio o scetticismo"
                            }
                        ]
                    }
                }
            ]
        }
    ]
