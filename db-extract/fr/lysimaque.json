                    {
                        "sense_id": "a4c9f4ee-2dba-3443-996a-659917ad5344",
                        "entry_id": "de4357f2-63e1-3bc5-b911-eebb5f3fee05",
                        "glosses": [
                            "Plante herbacée vivace à cinq pétales et à cinq étamines, surtout jaunes et quelquefois blanches, croissant dans les régions tempérées et subtropicales et dans les sols argileux humides, appréciée pour son caractère ornemental et ses propriétés curatives."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f05800b-5e47-4d63-8d19-195bc3dec27a",
                                "sense_id": "a4c9f4ee-2dba-3443-996a-659917ad5344",
                                "text": "Dans l’Antiquité, la salicaire était confondue avec la lysimaque (Lysimachia vulgaris), une plante herbacée vivace de la famille des Primulacées."
                            }
                        ]
                    }
                ],
