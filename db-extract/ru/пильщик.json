                "senses": [
                    {
                        "sense_id": "7176df59-e36a-30ba-baf1-6044f8516278",
                        "entry_id": "b4ae924b-93c0-3cb7-9d23-8ca2a2704d4a",
                        "glosses": [
                            "рабочий, занимающийся пилкой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d312d3f-5da9-425d-90f0-af38932029d2",
                                "sense_id": "7176df59-e36a-30ba-baf1-6044f8516278",
                                "text": "Плотник ставит сруб, печник мажет печь, пильщики готовят доски."
                            },
                            {
                                "example_id": "ff1e01f8-cc31-4c57-9240-39828375b3da",
                                "sense_id": "7176df59-e36a-30ba-baf1-6044f8516278",
                                "text": "Шестеро пильщиков, дружно вскрикивая, заваливали на козлы тяжёлое, еще сырое бревно."
                            }
                        ]
                    }
                ],
