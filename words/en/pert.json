                {
                    "sense_id": "3f5134cf-906b-310b-81b7-c3d4de3673e5",
                    "sense_definition": "Showing a lack of respect, especially in a cheeky or bold way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student was punished for giving a <w>pert</w> answer to the teacher.",
