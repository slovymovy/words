                "senses": [
                    {
                        "sense_id": "d17bb7c7-2549-3c8e-a855-5c02d76bbe35",
                        "entry_id": "c1851dc3-1809-3c95-b037-c7b47a7aefdf",
                        "glosses": [
                            "Sturm, der in der Frühlingszeit auftritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa1c39c0-5540-456b-9e07-cefae8b6e6d4",
                                "sense_id": "d17bb7c7-2549-3c8e-a855-5c02d76bbe35",
                                "text": "„Ein heftiger Frühlingssturm peitschte Regentropfen die Fensterläden, und es hörte sich so an, als würde jemand kleine Steine dagegen schleudern.“"
                            },
                            {
                                "example_id": "a0aa860b-8022-4f82-aacb-dcc2732aad3b",
                                "sense_id": "d17bb7c7-2549-3c8e-a855-5c02d76bbe35",
                                "text": "„In den Wipfeln rauschte der Frühlingssturm; der Frühlingssturm sang um das Grab, und der Frühlingsregen sprühte hinein.“"
                            },
                            {
                                "example_id": "8034188c-6390-42c9-9341-23a2b42a5d33",
                                "sense_id": "d17bb7c7-2549-3c8e-a855-5c02d76bbe35",
                                "text": "„Dem freundlichen Mai waren die wilden Frühlingsstürme gewichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
