                ],
                "senses": [
                    {
                        "sense_id": "0e5dab92-e6bd-3a29-afab-59a904182184",
                        "entry_id": "585794be-4449-3983-9f95-5d6e5fef44a0",
                        "glosses": [
                            "Menge an Abgas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66b212c6-26b7-4066-9f82-e7475a36784a",
                                "sense_id": "0e5dab92-e6bd-3a29-afab-59a904182184",
                                "text": "„Ein traditionelles Manko des Turbomotors ist eine gewisse Schwerfälligkeit im niedrigen Drehzahlbereich, wenn die Abgasmenge noch nicht für den Antrieb der Turbine ausreicht.“"
                            },
                            {
                                "example_id": "45f1fff4-e949-4040-b176-8666e4a7a47e",
                                "sense_id": "0e5dab92-e6bd-3a29-afab-59a904182184",
                                "text": "„So erreicht eine freistehende 100jährige Rotbuche eine Höhe von 20 Metern und einen Kronendurchmesser von 10 Metern. Ihre 250000 Blätter mit mehr als 2500 Quadratmeter Oberfläche binden an einem Sommertag 9500 Liter (oder 19 Kilogramm) Kohlendioxid – die Abgasmenge von 100 Kilometern Autofahrt.“"
                            },
                            {
                                "example_id": "46b126ce-6d55-467f-9500-d84c08e724ef",
                                "sense_id": "0e5dab92-e6bd-3a29-afab-59a904182184",
                                "text": "„Der Führer des Fahrzeugs sollte bereits bei niedrigen Drehzahlen in den nächst höheren Gang schalten, damit der Kraftstoffverbrauch und somit die Abgasmengen reduziert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
