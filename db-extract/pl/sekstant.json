                    },
                    {
                        "translation_id": "512f692f-8d11-4c00-a1f0-d31b475779ab",
                        "source_entry_id": "488f9b9a-a5b6-379f-8774-3f5ab61dc339",
                        "source_sense_id": "a16f037a-cadf-3eaa-832c-9ff54a7323e5",
                        "target_lang_word": "Sextant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sextant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "330c5c98-0d9f-346b-9421-c51eb6b64ed1",
                                        "entry_id": "de518d9a-1942-3045-aa89-09b94b7420fe",
                                        "glosses": [
                                            "optisches Messinstrument zur Messung von Winkeln anhand von fixierten Punkten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e376654-db00-4249-9c75-f1bb0e395744",
                                                "sense_id": "330c5c98-0d9f-346b-9421-c51eb6b64ed1",
                                                "text": "Unter Zuhilfenahme eines Sextanten konnten Seefahrer früher die Position ihres Schiffes auf offenem Meer relativ genau bestimmen."
                                            },
                                            {
                                                "example_id": "bd957352-ed15-492d-8bfa-ce35ec9570cc",
                                                "sense_id": "330c5c98-0d9f-346b-9421-c51eb6b64ed1",
                                                "text": "„Daher haben sie wohl auch den Sextanten im Gegensatz zu anderen Seefahrervölkern jahrzehntelang ungebraucht im Schrank liegen lassen.“"
                                            },
                                            {
                                                "example_id": "d324d05b-d4fd-452e-bca2-8ca374a3cafc",
                                                "sense_id": "330c5c98-0d9f-346b-9421-c51eb6b64ed1",
                                                "text": "„Eine Nacht und einen Tag hatte sie allein im Zimmer gewartet, hatte vor Langeweile den Sextanten auseinandergenommen, die gesammelten Pflanzen durcheinander gebracht, von dem für Präparate vorgesehenen Spiritus getrunken und ihren Rausch ausgeschlafen.“"
                                            },
                                            {
                                                "example_id": "7d694b2e-400d-4057-9539-b41395a07408",
                                                "sense_id": "330c5c98-0d9f-346b-9421-c51eb6b64ed1",
                                                "text": "„Ein Seetag dauerte von Mittag zu Mittag, da man mittags, wenn die Sonne am höchsten stand, mit dem Sextanten die geografische Breite bestimmen konnte.“"
                                            },
                                            {
                                                "example_id": "89372784-3c2a-440e-a325-7dbfa9fbbd81",
                                                "sense_id": "330c5c98-0d9f-346b-9421-c51eb6b64ed1",
                                                "text": "„Silver besaß einen Kompaß, einen Sextanten und eine Seekarte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "74dfc76f-9280-32de-84e3-a84a0142fa8b",
                                        "entry_id": "de518d9a-1942-3045-aa89-09b94b7420fe",
                                        "glosses": [
                                            "Sternbild in der Nähe des Himmelsäquators"
