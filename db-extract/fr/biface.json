                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "62c66248-c8a2-4fc1-984f-8946b809cfdb",
                        "entry_id": "0c59e698-d859-394b-8d62-5986d50f1730",
                        "tags": [
                            "plural"
                        ],
                        "form": "bifaces"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "02863c0b-05be-351c-9a83-82bff07ee59f",
                        "entry_id": "0c59e698-d859-394b-8d62-5986d50f1730",
                        "glosses": [
                            "Outil de pierre taillée caractéristique de la préhistoire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5082e91-44c3-42d3-b38e-14781977255f",
                                "sense_id": "02863c0b-05be-351c-9a83-82bff07ee59f",
                                "text": "Jusqu'en 1907 (…) l'homme chelléen n'était connu que par ses bifaces, ou « coups de poing », laissés dans tous les endroits où il avait séjourné."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f5bac1ae-42d9-4ffe-a575-4e73d68e0df5",
                        "source_entry_id": "0c59e698-d859-394b-8d62-5986d50f1730",
                        "source_sense_id": "02863c0b-05be-351c-9a83-82bff07ee59f",
                        "target_lang_word": "Faustkeil",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Faustkeil",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "33c36821-b508-3807-96ad-2bec8381c4f3",
                                        "entry_id": "fb2fd2e8-fd9d-3223-a3db-e8e4ff16d531",
                                        "glosses": [
                                            "keilförmiges, handgerechtes vorgeschichtliches Werkzeug aus bearbeitetem Gestein mit unterschiedlichen Verwendungsmöglichkeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12fb1991-c73a-4a15-9f33-f24015e522f8",
                                                "sense_id": "33c36821-b508-3807-96ad-2bec8381c4f3",
                                                "text": "Ihrer vielseitigen Funktionsweise als „Schweizer Messer“ der Steinzeit ist es wohl zu verdanken, dass es Faustkeile bis ins späte Mittelpaläolithikum gibt. Wahrscheinlich erfüllten sie zahlreiche Funktionen wie Hacken, Schneiden, Schaben, Schlagen und sogar Werfen."
                                            },
                                            {
                                                "example_id": "28cdaf2f-6347-4008-9b2b-7ff43f952846",
                                                "sense_id": "33c36821-b508-3807-96ad-2bec8381c4f3",
                                                "text": "„Typisch für die meist aus Feuerstein und anderen feinkörnigen Gesteinsarten hergestellten Faustkeile ist die durch beiderseitige Abschläge hergestellte dreieckige bis birnenförmige Form.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
