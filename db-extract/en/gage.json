            {
                "entry_id": "31364008-f9c8-395a-888c-5c8ebc586ede",
                "word": "gage",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "cee8ec7b-a19e-46a2-bbb2-2433a7201b19",
                        "entry_id": "31364008-f9c8-395a-888c-5c8ebc586ede",
                        "tags": [
                            "plural"
                        ],
                        "form": "gages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "19ec32a2-9c2a-321b-927e-062b621e7e00",
                        "entry_id": "31364008-f9c8-395a-888c-5c8ebc586ede",
                        "glosses": [
                            "Something, such as a glove or other pledge, thrown down as a challenge to combat (now usually figurative)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ebfcf756-5820-4fbf-923e-6471dbf97ff1",
                                "sense_id": "19ec32a2-9c2a-321b-927e-062b621e7e00",
                                "text": "“But it is enough that I challenge the trial by combat — there lies my gage.” She took her embroidered glove from her hand, and flung it down before the Grand Master with an air of mingled simplicity and dignity…"
                            },
                            {
                                "example_id": "d3ca44b2-832e-41e7-a1ef-4d61bfc1a1b0",
                                "sense_id": "19ec32a2-9c2a-321b-927e-062b621e7e00",
                                "text": "The gage was down for a duel that would split the Democratic party and ensure the election of a Republican president in 1860."
                            }
                        ]
                    },
                    {
                        "sense_id": "b55b4bd2-7c19-3400-8f05-5405776ec7da",
                        "entry_id": "31364008-f9c8-395a-888c-5c8ebc586ede",
                        "glosses": [
                            "Something valuable deposited as a guarantee or pledge; security, ransom."
                        ],
                        "tags": [
                            "obsolete",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "49dc257e-71cb-418b-bc07-8a28dcd36da9",
                                "sense_id": "b55b4bd2-7c19-3400-8f05-5405776ec7da",
                                "text": "[I]t seemed to create a sort of material link between the Princess and himself, and at the end of three months it almost appeared to him, not that the exquisite book was an intended present from his own hand, but that it had been placed in that hand by the most remarkable woman in Europe.... [T]he superior piece of work he had done after seeing her last, in the immediate heat of his emotion, turned into a kind of proof and gage, as if a ghost, in vanishing from sight, had left a palpable relic."
                            }
                        ]
                    }
                ],
