                        "glosses": [
                            "A profane, vulgar term, notably a curse or obscene oath."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da55309f-8e1f-4d17-bb90-187acdce9600",
                                "sense_id": "85d11f37-a690-32f9-8e95-86aed7f67971",
                                "text": "If we don't take advantage of any [expletive] in any way, then it's our loss."
