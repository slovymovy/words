                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f8f9e77-89d2-4297-84b1-8596ad4a3210",
                                "sense_id": "33e1066f-e824-318d-8e1b-821f698ccc9c",
                                "text": "„Er wird von seinem Finanzberater beispielsweise gefragt, ob er bevorzugt Bio-Lebensmittel kauft und Ökostrom bezieht.“"
                            },
                            {
                                "example_id": "5a20cee9-36db-4293-83b3-c77a7a06b0c8",
                                "sense_id": "33e1066f-e824-318d-8e1b-821f698ccc9c",
                                "text": "„Er hatte sie dem dänischen König abgekauft, dem er als Finanzberater und Schatzmeister diente.“"
                            }
                        ],
