                ],
                "senses": [
                    {
                        "sense_id": "ac790bfd-7b9c-3491-b135-c5cd54f1f0f9",
                        "entry_id": "e8830df5-8f24-3148-b64d-6bbf52a1a79c",
                        "glosses": [
                            "iets wat gedaan kan worden of kan gebeuren,"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70e1ddee-899f-41bf-9328-ef00cb969b48",
                                "sense_id": "ac790bfd-7b9c-3491-b135-c5cd54f1f0f9",
                                "text": "Net als de mogelijkheid om tijdelijk afstand te nemen van de constante druk in Amsterdam en even helemaal te doen waar ik zelf zin in had."
                            },
                            {
                                "example_id": "24158838-5b96-455e-b7bc-a7e1d4358553",
                                "sense_id": "ac790bfd-7b9c-3491-b135-c5cd54f1f0f9",
                                "text": "Bijna een half miljoen Engelsen zaten opeengepakt op een kleine kuststrook, zonder mogelijkheid om zich te verdedigen."
                            }
                        ]
                    },
                    {
                        "sense_id": "b4cf50ee-2cef-3a0a-af18-3e22dcabd1bc",
                        "entry_id": "e8830df5-8f24-3148-b64d-6bbf52a1a79c",
                        "glosses": [
                            "kans"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93abb337-9636-4758-9b07-d608e9216af1",
                                "sense_id": "b4cf50ee-2cef-3a0a-af18-3e22dcabd1bc",
                                "text": "Duidelijk blijkt dat de diepere betekenis voor ons nog even waardevol is. Voor de viering zullen wij, terugdenkend aan vroeger, zeker veel mogelijkheden vinden."
                            },
                            {
                                "example_id": "b86724bd-d2a5-4ca8-b749-0127ca4f1a3d",
                                "sense_id": "b4cf50ee-2cef-3a0a-af18-3e22dcabd1bc",
                                "text": "Ik begon langzaam in te zien dat leven met minder spullen en uitgaven juist heel creatief kon zijn en ook veel nieuwe mogelijkheden kon creëren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c01f012c-e096-4ef7-897b-04863e2c7cd3",
                        "source_entry_id": "e8830df5-8f24-3148-b64d-6bbf52a1a79c",
                        "source_sense_id": "ac790bfd-7b9c-3491-b135-c5cd54f1f0f9",
                        "source_sense_description": "iets wat gedaan kan worden of kan gebeuren",
                        "target_lang_word": "Möglichkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Möglichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8175dd97-cada-3b36-bbc6-50e14fcc55a5",
                                        "entry_id": "c4531619-8f65-3282-b0b3-f33c72333b06",
                                        "glosses": [
                                            "zur Wahl stehende Entscheidungsvariante"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2981fd0e-1fab-4113-bd80-754d1192465f",
                                                "sense_id": "8175dd97-cada-3b36-bbc6-50e14fcc55a5",
                                                "text": "Als der Wanderer dem Räuber gegenüberstand, sah er drei Möglichkeiten: Kämpfen, Verhandeln oder Flüchten."
                                            },
                                            {
                                                "example_id": "c87c4b87-9df3-492c-9907-7c6b61d500f2",
                                                "sense_id": "8175dd97-cada-3b36-bbc6-50e14fcc55a5",
                                                "text": "„Der Gleitschirmflieger spielt mit den technischen Möglichkeiten seines Fluggeräts und mit seinen Fertigkeiten: […] Er spielt mit den Leinen, den Bremsen, den Kräften des Windes in seinem Gleitschirm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aa910263-d8ff-32de-88a8-bcdc95de47d1",
                                        "entry_id": "c4531619-8f65-3282-b0b3-f33c72333b06",
                                        "glosses": [
                                            "Vermögen oder Fähigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c292d13-ee8a-4ec4-8769-808debf15e88",
                                                "sense_id": "aa910263-d8ff-32de-88a8-bcdc95de47d1",
                                                "text": "Nur noch der Präsident hat die Möglichkeit, das Urteil aufzuheben."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "aeeb98af-7a00-38ec-b4ee-21727a510146",
                                        "entry_id": "c4531619-8f65-3282-b0b3-f33c72333b06",
                                        "glosses": [
                                            "(geringe) Wahrscheinlichkeit von etwas (eines bestimmten Ereignisses)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "598ed83d-235d-4ea5-bbe6-2b631f1d7c26",
                                                "sense_id": "aeeb98af-7a00-38ec-b4ee-21727a510146",
                                                "text": "Wahrscheinlich wird heute den ganzen Tag die Sonne scheinen, aber es besteht die Möglichkeit, dass es gewittert."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff1275a2-31ab-4570-bdb7-d6780c6e2827",
                        "source_entry_id": "e8830df5-8f24-3148-b64d-6bbf52a1a79c",
                        "source_sense_id": "ac790bfd-7b9c-3491-b135-c5cd54f1f0f9",
