                    },
                    {
                        "translation_id": "0a99628c-bf8b-43bb-9444-664c25e966c8",
                        "source_entry_id": "0c415d10-afa6-34e3-9b47-197343fe820f",
                        "source_sense_id": "9f8e1c55-1136-3808-a18a-7d6cac94eeef",
                        "source_sense_description": "Celle qui fait des affaires de finance",
                        "target_lang_word": "financier",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "financier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c52cf739-5190-3d23-8bf5-d8af0584e317",
                                        "entry_id": "947fcbee-8220-34bc-a02b-170334bd550f",
                                        "glosses": [
                                            "A person who, as a profession, profits from large financial transactions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fbc9331-61a5-4d24-979a-186a012eed76",
                                                "sense_id": "c52cf739-5190-3d23-8bf5-d8af0584e317",
                                                "text": "Private-equity nabobs bristle at being dubbed mere financiers. Piling debt onto companies’ balance-sheets is only a small part of what leveraged buy-outs are about, they insist. Improving the workings of the businesses they take over is just as core to their calling, if not more so. Much of their pleading is public-relations bluster."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d5245e1-7892-3a47-adcc-b1f41d6fd063",
                                        "entry_id": "947fcbee-8220-34bc-a02b-170334bd550f",
                                        "glosses": [
                                            "A company that does the same."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f05c0ac0-33e2-36b9-b016-e430aa5a25c8",
                                        "entry_id": "947fcbee-8220-34bc-a02b-170334bd550f",
                                        "glosses": [
                                            "One charged with the administration of finance; an officer who administers the public revenue; a treasurer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53dc5e1b-f538-45ce-a621-df0ed4efbfaa",
                                                "sense_id": "f05c0ac0-33e2-36b9-b016-e430aa5a25c8",
                                                "text": "The English financier was obliged to raise new taxes to pay the interest of this immense sum ; the financier of France did no such thing"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23ea586b-df73-3404-9e77-50598f50bf14",
                                        "entry_id": "947fcbee-8220-34bc-a02b-170334bd550f",
                                        "glosses": [
                                            "A light, spongy teacake, usually based on almond flour or flavoring."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2420e008-a143-4698-89eb-1f34639cba25",
                                                "sense_id": "23ea586b-df73-3404-9e77-50598f50bf14",
                                                "text": "‘Excuse me, can we order some fresh financiers? I know we haven’t finished our mains yet but we’re in rather a hurry.’"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "768c8767-7a33-39c4-9dc4-1e8200e366be",
                                        "entry_id": "947fcbee-8220-34bc-a02b-170334bd550f",
                                        "glosses": [
                                            "A traditional French (Ragoût à la Financière) or Piemontese (Finanziera alla piemontese) rich sauce or ragout, made with coxcomb, wattles, cock's testicles, chicken livers and a variety of other ingredients."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "financier",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1a5cd56-d0fd-3166-9981-db3407a1de02",
                                        "entry_id": "3d7d57d1-4c6b-3a71-84c5-3d0bc1c6426e",
                                        "glosses": [
                                            "To carry out financial transactions; to finance something."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "678c4ce2-033e-4ff8-9c90-448adb130cf1",
                                                "sense_id": "d1a5cd56-d0fd-3166-9981-db3407a1de02",
                                                "text": "So time crept on, and the day arrived when Sturk must pay his rent, or take the ugly consequences. The day before he spent in Dublin financiering. It was galling and barren work."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54d91d32-8ee0-4011-ac21-9b41e845f4ae",
                        "source_entry_id": "0c415d10-afa6-34e3-9b47-197343fe820f",
                        "source_sense_id": "9f8e1c55-1136-3808-a18a-7d6cac94eeef",
                        "source_sense_description": "Celle qui fait des affaires de finance",
                        "target_lang_word": "financieress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "financieress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "451ad4e1-ad57-3517-a15b-165c1e97b55a",
                                        "entry_id": "73b1ec86-e53a-3f0a-848a-1934d10a34d1",
                                        "glosses": [
                                            "A female financier."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "171e4b77-def9-4c04-844c-f408b53e99bf",
                                                "sense_id": "451ad4e1-ad57-3517-a15b-165c1e97b55a",
                                                "text": "Secretary Boutwell’s Financial Wife—Mrs. Tennie C. Claflin as a Financieress—Paper Money Worthless – A Common Currency for the World."
                                            },
                                            {
                                                "example_id": "bd5c49a7-29f8-42e3-9d83-08b650d42e68",
                                                "sense_id": "451ad4e1-ad57-3517-a15b-165c1e97b55a",
                                                "text": "Fran Spitzeder, the beautiful and benevolent Munich financieress, is said to be under arrest on account of certain arithmetical peculiarities in her method of book-keeping."
                                            },
                                            {
                                                "example_id": "9ce73b70-cb62-4873-8873-4548596803a7",
                                                "sense_id": "451ad4e1-ad57-3517-a15b-165c1e97b55a",
                                                "text": "Although this society has been organized but a short time, they seem to be very good financieresses, and in their administration of affairs will undoubtedly put a high tariff on everything in the edible line."
                                            },
                                            {
                                                "example_id": "613d2989-3af6-40e1-9011-0ccb40861371",
                                                "sense_id": "451ad4e1-ad57-3517-a15b-165c1e97b55a",
                                                "text": "Mrs. Duke seems to be another of those high financieresses."
                                            },
                                            {
                                                "example_id": "ce276668-5140-400b-9356-bf151d76d245",
                                                "sense_id": "451ad4e1-ad57-3517-a15b-165c1e97b55a",
                                                "text": "“All the potentatoes, Mexican generalissimos and hefty financieresses have simply had me doing the monkey slide down the slideway of real work in their desire to have me to get busy and straighten out the kinks in their misunderstandings.”"
                                            },
                                            {
                                                "example_id": "1e57ae84-7c4b-44f2-a01b-a85fb2c6281a",
                                                "sense_id": "451ad4e1-ad57-3517-a15b-165c1e97b55a",
                                                "text": "From Lathrop hall, Madison’s steel tired locomobiles will take the picnickers out to the suburb of South Madison. From there, the future financiers and financieresses will trip the light fantastic a short distance over to Monona park."
                                            },
                                            {
                                                "example_id": "92c514c3-5c9f-4e13-be45-157ad52bab6f",
                                                "sense_id": "451ad4e1-ad57-3517-a15b-165c1e97b55a",
                                                "text": "It develops, from the police version, that there was little else behind this venture of the frenzied financieress than an idea and an effective personality devoted to salesmanship."
                                            },
                                            {
                                                "example_id": "954d3a27-b92b-4e00-ae70-db0e1dd17672",
                                                "sense_id": "451ad4e1-ad57-3517-a15b-165c1e97b55a",
                                                "text": "Judge Cluer at Shoreditch: I see that she describes herself not as a moneylender, but as a financier. It ought to be financieress."
                                            },
                                            {
                                                "example_id": "1779cf26-4760-47e5-ae04-736f969119c0",
                                                "sense_id": "451ad4e1-ad57-3517-a15b-165c1e97b55a",
                                                "text": "But the point is, Janie puss, I’ve got a vacation coming. Beginning tomorrow after work. A week. In which I shall do nothing but snore in the sun and call on Miss Janie Drumm, the rising young financieress from the East."
                                            },
                                            {
                                                "example_id": "1a87c62d-923c-4c9c-a5fc-512c068c081b",
                                                "sense_id": "451ad4e1-ad57-3517-a15b-165c1e97b55a",
                                                "text": "By my financial sabre, horn of my gibolets, Madame the financieress, I have earens to speak with and you have a mouth to hear me with."
                                            },
                                            {
                                                "example_id": "8716b885-e7ab-42c8-8e95-eed90ae193df",
                                                "sense_id": "451ad4e1-ad57-3517-a15b-165c1e97b55a",
                                                "text": "Mary Coyle Chase, whose millions in royalties from “Harvey” turned her into a financieress instead of a writer, finally has finished another play."
                                            },
                                            {
                                                "example_id": "2ca1eeec-cd23-4b42-91f0-0a9100c7c5a6",
                                                "sense_id": "451ad4e1-ad57-3517-a15b-165c1e97b55a",
                                                "text": "Trapdoor egresses at the end of a series of ladders, one on top of the other. Egresses that are never used, for the financieress refuses to underwrite the expense of top-grade preservatives for the butterbeans."
                                            },
                                            {
                                                "example_id": "9cfc162e-a46d-4efa-a479-2c16095605f6",
                                                "sense_id": "451ad4e1-ad57-3517-a15b-165c1e97b55a",
                                                "text": "One woman financier (financieress), who would have applied for admission had the voting been different, said yesterday that there was absolutely no logical reason why women should not be admitted."
                                            },
                                            {
                                                "example_id": "42cbe405-dbd4-4ecf-acda-30ff06b8687a",
                                                "sense_id": "451ad4e1-ad57-3517-a15b-165c1e97b55a",
                                                "text": "She rubs my palm, for the financieress, like her senile husband, rubs everything to make it move."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
