                                    {
                                        "sense_id": "6e3343b8-6a52-3d80-af31-c1053e36bca2",
                                        "entry_id": "38061c59-1dc1-3c16-aa51-6e7548ba8f58",
                                        "glosses": [
                                            "Berufsbezeichnung; Menschen, die zur Arbeit unter Wasser ausgebildet sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dfc2a04-cd2a-426f-8417-193c2f46e617",
                                                "sense_id": "6e3343b8-6a52-3d80-af31-c1053e36bca2",
                                                "text": "Die Tatwaffe liegt in einem See. Wir brauchen einen Taucher, um sie zu bergen."
                                            },
                                            {
                                                "example_id": "88704858-40fa-4ad1-95bb-60a713e80706",
                                                "sense_id": "6e3343b8-6a52-3d80-af31-c1053e36bca2",
                                                "text": "„In Europa gab es erste Anzeichen für das professionelle Tauchen ab zirka 2500 vor Christus, als griechische Taucher Schwämme in großen Mengen ernteten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
